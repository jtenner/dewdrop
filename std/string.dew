impl Eq for String {
  fn eq(self, right: String) -> Bool {
    string_equals(self, right)
  }
}

impl Ne for String {
  fn ne(self, right: String) -> Bool {
    !string_equals(self, right)
  }
}

impl Eq for StringView {
  fn eq(self, right: StringView) -> Bool {
    string_view_equals(self, right)
  }
}

impl Ne for StringView {
  fn ne(self, right: StringView) -> Bool {
    !string_view_equals(self, right)
  }
}

impl Hash for String {
  fn hash(self) -> U64 {
    string_hash(self)
  }
  fn hash_eq(self, right: String) -> Bool {
    string_equals(self, right)
  }
}

impl Hash for StringView {
  fn hash(self) -> U64 {
    string_view_hash(self)
  }
  fn hash_eq(self, right: StringView) -> Bool {
    string_view_equals(self, right)
  }
}

impl String {
  fn byte_length(self) -> U32 {
    string_byte_length(self)
  }
  fn as_bytes(self) -> Bytes {
    string_as_bytes(self)
  }
  fn utf16_length(self) -> U32 {
    string_utf16_length(self)
  }
  fn equals(self, other: String) -> Bool {
    string_equals(self, other)
  }
  fn byte_at(self, index: U32) -> U8 {
    string_byte_at(self, index)
  }
  fn view(self, start: U32, length: U32) -> StringView {
    string_view(self, start, length)
  }
  fn subarray(self, start: U32, end: U32) -> StringView {
    string_view(self, start, end - start)
  }
  fn slice(self, start: U32, end: U32) -> String {
    let view = string_view(self, start, end - start)
    let builder = string_builder_with_capacity_raw(view.byte_length())
    string_builder_append_view(builder, view)
    string_builder_finish(builder)
  }
  fn compact(self) -> String {
    let builder = string_builder_with_capacity_raw(self.byte_length())
    string_builder_append(builder, self)
    string_builder_finish(builder)
  }
  fn concat(self, other: String) -> String {
    string_concat(self, other)
  }
  fn concat_view(self, other: StringView) -> String {
    string_concat_view(self, other)
  }
  fn find(self, needle: String) -> Option<U32> {
    dew_option_u32_from_raw(string_find_raw(self, needle))
  }
  fn find_view(self, needle: StringView) -> Option<U32> {
    dew_option_u32_from_raw(string_find_view_raw(self, needle))
  }
  fn contains(self, needle: String) -> Bool {
    string_find_raw(self, needle) != 4294967295u32
  }
  fn contains_view(self, needle: StringView) -> Bool {
    string_find_view_raw(self, needle) != 4294967295u32
  }
  fn starts_with(self, prefix: String) -> Bool {
    string_starts_with(self, prefix)
  }
  fn starts_with_view(self, prefix: StringView) -> Bool {
    string_starts_with_view(self, prefix)
  }
  fn ends_with(self, suffix: String) -> Bool {
    string_ends_with(self, suffix)
  }
  fn ends_with_view(self, suffix: StringView) -> Bool {
    string_ends_with_view(self, suffix)
  }
}

impl StringView {
  fn byte_length(self) -> U32 {
    string_view_byte_length(self)
  }
  fn byte_at(self, index: U32) -> U8 {
    string_view_byte_at(self, index)
  }
  fn to_string(self) -> String {
    string_view_to_string(self)
  }
  fn as_bytes(self) -> Bytes {
    string_view_as_bytes(self)
  }
  fn utf16_length(self) -> U32 {
    string_view_utf16_length(self)
  }
  fn equals(self, other: StringView) -> Bool {
    string_view_equals(self, other)
  }
  fn view(self, start: U32, length: U32) -> StringView {
    string_view_view(self, start, length)
  }
  fn subarray(self, start: U32, end: U32) -> StringView {
    string_view_view(self, start, end - start)
  }
  fn slice(self, start: U32, end: U32) -> String {
    let view = string_view_view(self, start, end - start)
    let builder = string_builder_with_capacity_raw(view.byte_length())
    string_builder_append_view(builder, view)
    string_builder_finish(builder)
  }
  fn compact(self) -> String {
    let builder = string_builder_with_capacity_raw(self.byte_length())
    string_builder_append_view(builder, self)
    string_builder_finish(builder)
  }
  fn find(self, needle: StringView) -> Option<U32> {
    dew_option_u32_from_raw(string_view_find_raw(self, needle))
  }
  fn find_string(self, needle: String) -> Option<U32> {
    dew_option_u32_from_raw(string_view_find_string_raw(self, needle))
  }
  fn contains(self, needle: StringView) -> Bool {
    string_view_find_raw(self, needle) != 4294967295u32
  }
  fn contains_string(self, needle: String) -> Bool {
    string_view_find_string_raw(self, needle) != 4294967295u32
  }
  fn starts_with(self, prefix: StringView) -> Bool {
    string_view_starts_with(self, prefix)
  }
  fn starts_with_string(self, prefix: String) -> Bool {
    string_view_starts_with_string(self, prefix)
  }
  fn ends_with(self, suffix: StringView) -> Bool {
    string_view_ends_with(self, suffix)
  }
  fn ends_with_string(self, suffix: String) -> Bool {
    string_view_ends_with_string(self, suffix)
  }
}

pub fn iter_unit() -> Unit {}

pub fn iter_for_each<t, i: Iter<t>>(
  iter: i,
  action: fn(t) -> Unit,
) -> Unit {
  while iter.next() {
    Option::Some(value) => {
      action(value)
      continue iter.next()
    }
    Option::None => break iter_unit()
  }
}

pub fn iter_fold<t, state, i: Iter<t>>(
  iter: i,
  initial: state,
  folder: fn(state, t) -> state,
) -> state {
  let mut value = initial
  while iter.next() {
    Option::Some(item) => {
      value = folder(value, item)
      continue iter.next()
    }
    Option::None => break value
  }
}

pub fn iter_any<t, i: Iter<t>>(
  iter: i,
  predicate: fn(t) -> Bool,
) -> Bool {
  while iter.next() {
    Option::Some(value) => {
      if predicate(value) {
        break true
      } else {
        continue iter.next()
      }
    }
    Option::None => break false
  }
}

pub fn iter_all<t, i: Iter<t>>(
  iter: i,
  predicate: fn(t) -> Bool,
) -> Bool {
  while iter.next() {
    Option::Some(value) => {
      if predicate(value) {
        continue iter.next()
      } else {
        break false
      }
    }
    Option::None => break true
  }
}

pub fn iter_find<t, i: Iter<t>>(
  iter: i,
  predicate: fn(t) -> Bool,
) -> Option<t> {
  while iter.next() {
    Option::Some(value) => {
      if predicate(value) {
        break Option::Some(value)
      } else {
        continue iter.next()
      }
    }
    Option::None => break Option::None
  }
}

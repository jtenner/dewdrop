open dew.std.map
open dew.std.option

pub struct Set<key> {
  values: Map<key, Unit>
}

pub struct SetIter<key> {
  inner: MapKeyIter<key, Unit>
}

fn set_empty<key>() -> Set<key> {
  Set::{
    values: Map::empty()
  }
}
fn set_singleton<key>(key: key) -> Set<key> {
  Set::{
    values: Map::singleton(key, ())
  }
}
fn set_length<key>(set: Set<key>) -> U32 {
  set.values.length()
}
fn set_is_empty<key>(set: Set<key>) -> Bool {
  set.values.length() == 0u32
}
fn set_contains<key>(set: Set<key>, key: key) -> Bool {
  set.values.contains_key(key)
}
fn set_insert<key>(set: Set<key>, key: key) -> Bool {
  let before = set.values.length()
  set.values.insert(key, ())
  set.values.length() != before
}
fn set_remove<key>(set: Set<key>, key: key) -> Bool {
  set.values.remove(key)
}
fn set_clear<key>(set: Set<key>) -> Unit {
  set.values.clear()
}

impl<key> Set<key> {
  fn empty() -> Set<key> {
    set_empty()
  }
  fn singleton(key: key) -> Set<key> {
    set_singleton(key)
  }
  fn length(self) -> U32 {
    set_length(self)
  }
  fn is_empty(self) -> Bool {
    set_is_empty(self)
  }
  fn contains(self, key: key) -> Bool {
    set_contains(self, key)
  }
  fn insert(self, key: key) -> Bool {
    set_insert(self, key)
  }
  fn remove(self, key: key) -> Bool {
    set_remove(self, key)
  }
  fn clear(self) -> Unit {
    set_clear(self)
  }
}

fn set_iter<key>(set: Set<key>) -> SetIter<key> {
  SetIter::{
    inner: set.values.keys()
  }
}
fn set_iter_has_next<key>(iter: SetIter<key>) -> Bool {
  iter.inner.has_next()
}
fn set_iter_next<key>(iter: SetIter<key>) -> key {
  match iter.inner.next() {
    Option::Some(key) => key
    Option::None => unreachable()
  }
}

impl<key> Set<key> {
  fn iter(self) -> SetIter<key> {
    set_iter(self)
  }
}

impl<key> Iter<key> for SetIter<key> {
  fn next(self) -> Option<key> {
    set_iter_next_option(self)
  }
}

impl<key> SetIter<key> {
  fn has_next(self) -> Bool {
    set_iter_has_next(self)
  }
}

fn set_iter_next_option<key>(iter: SetIter<key>) -> Option<key> {
  iter.inner.next()
}

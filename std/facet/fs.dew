pub fn dir_iter_next_array_i8(
  iterator: U32,
  wtf: U32,
) -> Result<Option<FacetDirectoryEntryI8>, FacetErrno> {
  let result = @raw.dir_iter_next_array_i8(iterator, wtf)
  let error = @raw.dir_array_i8_result_error(result)
  if error != 0u32 {
    Result::Err(error)
  } else if @raw.dir_array_i8_result_done(result) != 0u32 {
    Result::Ok(Option::None)
  } else {
    Result::Ok(Option::Some(FacetDirectoryEntryI8::{
      name: @raw.dir_array_i8_result_value(result)
      file_type: @raw.dir_array_i8_result_file_type(result)
      inode: @raw.dir_array_i8_result_inode(result)
    }))
  }
}


open dew.std.array

pub type Stack<t> = Array<t>
pub type StackIter<t> = ArrayIter<t>

pub builtin stack_new<t>() -> Stack<t> = "dew_stack_new"
pub builtin stack_with_capacity<t>(capacity: U32) -> Stack<t> = "dew_stack_with_capacity"
pub builtin stack_length<t>(stack: Stack<t>) -> U32 = "dew_stack_length"

pub builtin stack_is_empty<t>(stack: Stack<t>) -> Bool = "dew_stack_is_empty"

pub builtin stack_push<t>(stack: Stack<t>, value: t) -> Unit = "dew_stack_push"
pub builtin stack_pop<t>(stack: Stack<t>) -> Option<t> = "dew_stack_pop"

pub builtin stack_peek<t>(stack: Stack<t>) -> Option<t> = "dew_stack_peek"

pub builtin stack_clear<t>(stack: Stack<t>) -> Unit = "dew_stack_clear"
pub builtin stack_iter<t>(stack: Stack<t>) -> StackIter<t> = "dew_stack_iter"
pub builtin stack_iter_has_next<t>(iter: StackIter<t>) -> Bool = "dew_stack_iter_has_next"
pub builtin stack_iter_next<t>(iter: StackIter<t>) -> t = "dew_stack_iter_next"

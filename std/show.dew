open dew.std.string
open dew.std.string_builder

pub struct ShowFormatter {
  builder: StringBuilder
  depth: U32
}

pub trait Show {
  fn append_show(self, formatter: ShowFormatter) -> Unit
}

fn show_max_depth() -> U32 {
  64u32
}

fn show_max_bytes() -> U32 {
  1048576u32
}

fn show_require_bytes(formatter: ShowFormatter, added: U32) -> Unit {
  let used = formatter.builder.byte_length()
  if used > show_max_bytes() || added > show_max_bytes() - used {
    unreachable()
  } else {
  }
}

pub fn show<t: Show>(value: t) -> String {
  let builder = StringBuilder::new()
  show_append(ShowFormatter::{
    builder: builder
    depth: 0u32
  }, value)
  builder.finish()
}

fn show_require_depth(formatter: ShowFormatter) -> Unit {
  if formatter.depth >= show_max_depth() {
    unreachable()
  } else {
  }
}

pub fn show_append<t: Show>(formatter: ShowFormatter, value: t) -> Unit {
  show_require_depth(formatter)
  value.append_show(ShowFormatter::{
    builder: formatter.builder
    depth: formatter.depth + 1u32
  })
}

pub fn show_append_text(formatter: ShowFormatter, value: String) -> Unit {
  show_require_bytes(formatter, value.byte_length())
  formatter.builder.append(value)
}

pub fn show_append_view(formatter: ShowFormatter, value: StringView) -> Unit {
  show_require_bytes(formatter, value.byte_length())
  formatter.builder.append_view(value)
}

pub fn show_append_ascii(formatter: ShowFormatter, value: U8) -> Unit {
  show_require_bytes(formatter, 1u32)
  formatter.builder.append_ascii(value)
}

fn show_u64_to_u8(value: U64) -> U8 {
  value.into()
}

fn show_i8_to_i64(value: I8) -> I64 {
  value.into()
}

fn show_i16_to_i64(value: I16) -> I64 {
  value.into()
}

fn show_i32_to_i64(value: I32) -> I64 {
  value.into()
}

fn show_u8_to_u64(value: U8) -> U64 {
  value.into()
}

fn show_u16_to_u64(value: U16) -> U64 {
  value.into()
}

fn show_u32_to_u64(value: U32) -> U64 {
  value.into()
}

fn show_i64_to_u64(value: I64) -> U64 {
  value.into()
}

fn show_append_u64_digits(formatter: ShowFormatter, value: U64) -> Unit {
  if value >= 10u64 {
    show_append_u64_digits(formatter, value / 10u64)
  } else {
  }
  show_append_ascii(formatter, show_u64_to_u8(value % 10u64) + 48u8)
}

fn show_append_i64(formatter: ShowFormatter, value: I64) -> Unit {
  if value < 0i64 {
    show_append_ascii(formatter, 45u8)
    let magnitude = show_i64_to_u64(-(value + 1i64)) + 1u64
    show_append_u64_digits(formatter, magnitude)
  } else {
    show_append_u64_digits(formatter, show_i64_to_u64(value))
  }
}

impl Show for Unit {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_text(formatter, "()")
  }
}

impl Show for Bool {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    if self {
      show_append_text(formatter, "true")
    } else {
      show_append_text(formatter, "false")
    }
  }
}

impl Show for I8 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i8_to_i64(self))
  }
}

impl Show for I16 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i16_to_i64(self))
  }
}

impl Show for I32 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i32_to_i64(self))
  }
}

impl Show for I64 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, self)
  }
}

impl Show for U8 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64_digits(formatter, show_u8_to_u64(self))
  }
}

impl Show for U16 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64_digits(formatter, show_u16_to_u64(self))
  }
}

impl Show for U32 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64_digits(formatter, show_u32_to_u64(self))
  }
}

impl Show for U64 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64_digits(formatter, self)
  }
}

impl Show for String {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_text(formatter, self)
  }
}

impl Show for StringView {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_view(formatter, self)
  }
}

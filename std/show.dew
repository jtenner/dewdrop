open dew.std.fixed_array
open dew.std.array
open dew.std.string
open dew.std.string_builder

pub struct ShowFormatter {
  builder: StringBuilder
  depth: U32
}

pub trait Show {
  fn append_show(self, formatter: ShowFormatter) -> Unit
}

pub fn show_unit() -> Unit {
}

pub fn show_max_depth() -> U32 {
  64u32
}

pub fn show_max_bytes() -> U32 {
  1048576u32
}

pub fn show_require_bytes(formatter: ShowFormatter, added: U32) -> Unit {
  let used = formatter.builder.byte_length()
  if used > show_max_bytes() || added > show_max_bytes() - used {
    unreachable()
  } else {
  }
}

pub fn show<t: Show>(value: t) -> String {
  let builder = StringBuilder::new()
  show_append(ShowFormatter::{
    builder: builder
    depth: 0u32
  }, value)
  builder.finish()
}

pub fn show_require_depth(formatter: ShowFormatter) -> Unit {
  if formatter.depth >= show_max_depth() {
    unreachable()
  } else {
  }
}

pub fn show_append<t: Show>(formatter: ShowFormatter, value: t) -> Unit {
  show_require_depth(formatter)
  value.append_show(ShowFormatter::{
    builder: formatter.builder
    depth: formatter.depth + 1u32
  })
}

pub fn show_append_text(formatter: ShowFormatter, value: String) -> Unit {
  show_require_bytes(formatter, value.byte_length())
  formatter.builder.append(value)
}

pub fn show_append_view(formatter: ShowFormatter, value: StringView) -> Unit {
  show_require_bytes(formatter, value.byte_length())
  formatter.builder.append_view(value)
}

pub fn show_append_ascii(formatter: ShowFormatter, value: U8) -> Unit {
  show_require_bytes(formatter, 1u32)
  formatter.builder.append_ascii(value)
}

pub fn show_i8_to_i64(value: I8) -> I64 {
  value.into()
}

pub fn show_i16_to_i64(value: I16) -> I64 {
  value.into()
}

pub fn show_i32_to_i64(value: I32) -> I64 {
  value.into()
}

pub fn show_u8_to_u64(value: U8) -> U64 {
  value.into()
}

pub fn show_u16_to_u64(value: U16) -> U64 {
  value.into()
}

pub fn show_u32_to_u64(value: U32) -> U64 {
  value.into()
}

pub fn show_i64_to_u64(value: I64) -> U64 {
  value.into()
}

pub fn show_u64_digit_count(value: U64) -> U32 {
  if value < 10u64 {
    1u32
  } else {
    1u32 + show_u64_digit_count(value / 10u64)
  }
}

pub fn show_i64_byte_count(value: I64) -> U32 {
  if value < 0i64 {
    1u32 + show_u64_digit_count(show_i64_to_u64(-(value + 1i64)) + 1u64)
  } else {
    show_u64_digit_count(show_i64_to_u64(value))
  }
}

pub fn show_append_i64(formatter: ShowFormatter, value: I64) -> Unit {
  show_require_bytes(formatter, show_i64_byte_count(value))
  formatter.builder.append_i64(value)
}

pub fn show_append_u64(formatter: ShowFormatter, value: U64) -> Unit {
  show_require_bytes(formatter, show_u64_digit_count(value))
  formatter.builder.append_u64(value)
}

impl Show for Unit {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_text(formatter, "()")
  }
}

impl Show for Bool {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    if self {
      show_append_text(formatter, "true")
    } else {
      show_append_text(formatter, "false")
    }
  }
}

impl Show for I8 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i8_to_i64(self))
  }
}

impl Show for I16 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i16_to_i64(self))
  }
}

impl Show for I32 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, show_i32_to_i64(self))
  }
}

impl Show for I64 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_i64(formatter, self)
  }
}

impl Show for U8 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64(formatter, show_u8_to_u64(self))
  }
}

impl Show for U16 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64(formatter, show_u16_to_u64(self))
  }
}

impl Show for U32 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64(formatter, show_u32_to_u64(self))
  }
}

impl Show for U64 {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_u64(formatter, self)
  }
}

impl Show for String {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_text(formatter, self)
  }
}

impl Show for StringView {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_view(formatter, self)
  }
}

impl<t: Show> Show for FixedArray<t> {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_ascii(formatter, 91u8)
    let length = self.length()
    while 0u32 {
      index if index < length => {
        if index > 0u32 {
          show_append_text(formatter, ", ")
        } else {
        }
        show_append(formatter, self.get_unchecked(index))
        continue index + 1u32
      }
      _ => break show_unit()
    }
    show_append_ascii(formatter, 93u8)
  }
}

impl<t: Show> Show for Array<t> {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    show_append_ascii(formatter, 91u8)
    let length = self.length()
    while 0u32 {
      index if index < length => {
        if index > 0u32 {
          show_append_text(formatter, ", ")
        } else {
        }
        show_append(formatter, self.get_unchecked(index))
        continue index + 1u32
      }
      _ => break show_unit()
    }
    show_append_ascii(formatter, 93u8)
  }
}

impl<t: Show> Show for Option<t> {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    match self {
      None => show_append_text(formatter, "None")
      Some(value) => {
        show_append_text(formatter, "Some(")
        show_append(formatter, value)
        show_append_ascii(formatter, 41u8)
      }
    }
  }
}

impl<t: Show, e: Show> Show for Result<t, e> {
  fn append_show(self, formatter: ShowFormatter) -> Unit {
    match self {
      Ok(value) => {
        show_append_text(formatter, "Ok(")
        show_append(formatter, value)
        show_append_ascii(formatter, 41u8)
      }
      Err(error) => {
        show_append_text(formatter, "Err(")
        show_append(formatter, error)
        show_append_ascii(formatter, 41u8)
      }
    }
  }
}

pub enum CompilerDiagnosticLevel {
  Error
  Warning
  Info
  Hint
}

pub struct CompilerDiagnostic {
  path: String
  line: U32
  column: U32
  byte_offset: U32
  level: CompilerDiagnosticLevel
  code: String
  message: String
}

pub enum CompilerDiagnosticRenderError {
  LimitExceeded(U64, U32)
}

pub fn compiler_diagnostic_u32_to_u64(value: U32) -> U64 {
  value.into()
}

pub fn compiler_diagnostic_level_text(level: CompilerDiagnosticLevel) -> String {
  match level {
    Error => "error"
    Warning => "warning"
    Info => "info"
    Hint => "hint"
  }
}

pub fn compiler_diagnostic_render_size(
  diagnostic: CompilerDiagnostic,
  level: String,
) -> U64 {
  compiler_diagnostic_u32_to_u64(diagnostic.path.byte_length()) +
  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.line))) +
  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.column))) +
  compiler_diagnostic_u32_to_u64(level.byte_length()) +
  compiler_diagnostic_u32_to_u64(diagnostic.code.byte_length()) +
  compiler_diagnostic_u32_to_u64(diagnostic.message.byte_length()) +
  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.byte_offset))) +
  16u64
}

pub fn render_compiler_diagnostic(
  diagnostic: CompilerDiagnostic,
  max_bytes: U32,
) -> Result<String, CompilerDiagnosticRenderError> {
  let level = compiler_diagnostic_level_text(diagnostic.level)
  let required = compiler_diagnostic_render_size(diagnostic, level)
  if required > compiler_diagnostic_u32_to_u64(max_bytes) {
    Result::Err(CompilerDiagnosticRenderError::LimitExceeded(required, max_bytes))
  } else {
    let builder = StringBuilder::with_capacity(required.into())
    builder.append(diagnostic.path)
    builder.append_ascii(58u8)
    builder.append_u32(diagnostic.line)
    builder.append_ascii(58u8)
    builder.append_u32(diagnostic.column)
    builder.append(": ")
    builder.append(level)
    builder.append_ascii(91u8)
    builder.append(diagnostic.code)
    builder.append("]: ")
    builder.append(diagnostic.message)
    builder.append(" (byte ")
    builder.append_u32(diagnostic.byte_offset)
    builder.append_ascii(41u8)
    Result::Ok(builder.finish())
  }
}

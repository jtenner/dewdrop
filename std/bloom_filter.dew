pub type BloomFilter = U64

pub fn bloom_filter_hash_mask(hash: U64) -> U64 {
  (1u64 << (hash & 63u64)) | (1u64 << ((hash >> 32u64) & 63u64))
}

impl BloomFilter {
  fn empty() -> BloomFilter {
    0u64
  }
  fn is_empty(self) -> Bool {
    self == 0u64
  }
  fn add_hash(self, hash: U64) -> BloomFilter {
    self | bloom_filter_hash_mask(hash)
  }
  fn maybe_contains_hash(self, hash: U64) -> Bool {
    let mask = bloom_filter_hash_mask(hash)
    (self & mask) == mask
  }
  fn add<t: Hash>(self, value: t) -> BloomFilter {
    self.add_hash(value.hash())
  }
  fn maybe_contains<t: Hash>(self, value: t) -> Bool {
    self.maybe_contains_hash(value.hash())
  }
}

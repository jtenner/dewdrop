open dew.std.string
open dew.std.fixed_array

pub enum DecimalParseError {
  Empty
  InvalidDigit(U32)
  Overflow(U32)
}

fn parse_decimal_magnitude(
  value: StringView,
  start: U32,
  limit: U32,
) -> Result<U32, DecimalParseError> {
  let length = value.byte_length()
  let quotient = limit / 10u32
  let remainder = limit % 10u32
  let mut number = 0u32
  while start {
    index if index < length => {
      let byte = value.byte_at(index)
      if byte < 48u8 || byte > 57u8 {
        break Result::Err(DecimalParseError::InvalidDigit(index))
      } else {
        let digit = code_point_u8_to_u32(byte - 48u8)
        if number > quotient || (number == quotient && digit > remainder) {
          break Result::Err(DecimalParseError::Overflow(index))
        } else {
          number = number * 10u32 + digit
          continue index + 1u32
        }
      }
    }
    _ => break Result::Ok(number)
  }
}

pub fn parse_u32_decimal(value: StringView) -> Result<U32, DecimalParseError> {
  if value.byte_length() == 0u32 {
    Result::Err(DecimalParseError::Empty)
  } else {
    parse_decimal_magnitude(value, 0u32, 4294967295u32)
  }
}

pub fn parse_i32_decimal(value: StringView) -> Result<I32, DecimalParseError> {
  let length = value.byte_length()
  if length == 0u32 {
    Result::Err(DecimalParseError::Empty)
  } else {
    let negative = value.byte_at(0u32) == 45u8
    let start = if negative {
      1u32
    } else {
      0u32
    }
    if start == length {
      Result::Err(DecimalParseError::InvalidDigit(0u32))
    } else {
      let limit = if negative {
        2147483648u32
      } else {
        2147483647u32
      }
      match parse_decimal_magnitude(value, start, limit) {
        Result::Err(error) => Result::Err(error)
        Result::Ok(magnitude) => {
          if negative && magnitude == 2147483648u32 {
            Result::Ok(-2147483648i32)
          } else {
            let signed = decimal_magnitude_to_i32(magnitude)
            Result::Ok(if negative {
              -signed
            } else {
              signed
            })
          }
        }
      }
    }
  }
}

fn decimal_magnitude_to_i32(value: U32) -> I32 {
  value.into()
}

pub struct StringCodePoints {
  value: String
  state: FixedArray<U32>
}

pub struct StringViewCodePoints {
  value: StringView
  state: FixedArray<U32>
}

pub fn text_code_points_string_byte_length(value: String) -> U32 {
  value.byte_length()
}
pub fn text_code_points_string_byte_at(value: String, index: U32) -> U8 {
  value.byte_at(index)
}
pub fn text_code_points_string_view_byte_length(value: StringView) -> U32 {
  value.byte_length()
}
pub fn text_code_points_string_view_byte_at(value: StringView, index: U32) -> U8 {
  value.byte_at(index)
}

pub fn code_point_continuation(byte: U8) -> Bool {
  byte >= 128u8 && byte <= 191u8
}

pub fn code_point_u8_to_u32(value: U8) -> U32 {
  value.into()
}

pub fn code_point_u32_to_u64(value: U32) -> U64 {
  value.into()
}

pub fn code_point_u64_to_u32(value: U64) -> U32 {
  value.into()
}

pub fn code_point_pack(scalar: U32, width: U32) -> U64 {
  code_point_u32_to_u64(scalar) |
  (code_point_u32_to_u64(width) << 32u64)
}

pub fn decode_code_point(
  first: U8,
  second: U8,
  third: U8,
  fourth: U8,
  remaining: U32,
) -> U64 {
  let first_bits = code_point_u8_to_u32(first)
  let second_bits = code_point_u8_to_u32(second)
  let third_bits = code_point_u8_to_u32(third)
  let fourth_bits = code_point_u8_to_u32(fourth)
  if first <= 127u8 {
    code_point_pack(first_bits, 1u32)
  } else if first >= 194u8 && first <= 223u8 && remaining >= 2u32 && code_point_continuation(second) {
    code_point_pack(
      ((first_bits & 31u32) << 6u32) | (second_bits & 63u32),
      2u32,
    )
  } else if first >= 224u8 && first <= 239u8 && remaining >= 3u32 && code_point_continuation(second) && code_point_continuation(third) && (first != 224u8 || second >= 160u8) && (first != 237u8 || second < 160u8) {
    code_point_pack(
      ((first_bits & 15u32) << 12u32) |
      ((second_bits & 63u32) << 6u32) |
      (third_bits & 63u32),
      3u32,
    )
  } else if first >= 240u8 && first <= 244u8 && remaining >= 4u32 && code_point_continuation(second) && code_point_continuation(third) && code_point_continuation(fourth) && (first != 240u8 || second >= 144u8) && (first != 244u8 || second < 144u8) {
    code_point_pack(
      ((first_bits & 7u32) << 18u32) |
      ((second_bits & 63u32) << 12u32) |
      ((third_bits & 63u32) << 6u32) |
      (fourth_bits & 63u32),
      4u32,
    )
  } else {
    unreachable()
  }
}

pub fn code_point_state() -> FixedArray<U32> {
  FixedArray::make(1u32, 0u32)
}

pub fn string_code_points(value: String) -> StringCodePoints {
  StringCodePoints::{
    value: value
    state: code_point_state()
  }
}

pub fn string_view_code_points(value: StringView) -> StringViewCodePoints {
  StringViewCodePoints::{
    value: value
    state: code_point_state()
  }
}

pub fn string_code_points_has_next(iterator: StringCodePoints) -> Bool {
  iterator.state.get_unchecked(0u32) < text_code_points_string_byte_length(iterator.value)
}

pub fn string_view_code_points_has_next(iterator: StringViewCodePoints) -> Bool {
  iterator.state.get_unchecked(0u32) < text_code_points_string_view_byte_length(iterator.value)
}

pub fn string_code_points_next(iterator: StringCodePoints) -> U32 {
  let index = iterator.state.get_unchecked(0u32)
  let length = text_code_points_string_byte_length(iterator.value)
  if index >= length {
    unreachable()
  } else {
    let remaining = length - index
    let first = text_code_points_string_byte_at(iterator.value, index)
    let second = if remaining >= 2u32 {
      text_code_points_string_byte_at(iterator.value, index + 1u32)
    } else {
      0u8
    }
    let third = if remaining >= 3u32 {
      text_code_points_string_byte_at(iterator.value, index + 2u32)
    } else {
      0u8
    }
    let fourth = if remaining >= 4u32 {
      text_code_points_string_byte_at(iterator.value, index + 3u32)
    } else {
      0u8
    }
    let decoded = decode_code_point(first, second, third, fourth, remaining)
    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)
    let width = code_point_u64_to_u32(decoded >> 32u64)
    iterator.state.set_unchecked(0u32, index + width)
    scalar
  }
}

pub fn string_view_code_points_next(iterator: StringViewCodePoints) -> U32 {
  let index = iterator.state.get_unchecked(0u32)
  let length = text_code_points_string_view_byte_length(iterator.value)
  if index >= length {
    unreachable()
  } else {
    let remaining = length - index
    let first = text_code_points_string_view_byte_at(iterator.value, index)
    let second = if remaining >= 2u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 1u32)
    } else {
      0u8
    }
    let third = if remaining >= 3u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 2u32)
    } else {
      0u8
    }
    let fourth = if remaining >= 4u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 3u32)
    } else {
      0u8
    }
    let decoded = decode_code_point(first, second, third, fourth, remaining)
    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)
    let width = code_point_u64_to_u32(decoded >> 32u64)
    iterator.state.set_unchecked(0u32, index + width)
    scalar
  }
}

impl String {
  fn code_points(self) -> StringCodePoints {
    string_code_points(self)
  }
  fn iter(self) -> StringCodePoints {
    string_code_points(self)
  }
}

impl StringView {
  fn code_points(self) -> StringViewCodePoints {
    string_view_code_points(self)
  }
  fn iter(self) -> StringViewCodePoints {
    string_view_code_points(self)
  }
}

impl Iter<U32> for StringCodePoints {
  fn next(self) -> Option<U32> {
    if string_code_points_has_next(self) {
      Option::Some(string_code_points_next(self))
    } else {
      Option::None
    }
  }
}

impl Iter<U32> for StringViewCodePoints {
  fn next(self) -> Option<U32> {
    if string_view_code_points_has_next(self) {
      Option::Some(string_view_code_points_next(self))
    } else {
      Option::None
    }
  }
}

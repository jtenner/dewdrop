open dew.std.string
open dew.std.fixed_array

pub struct StringCodePoints {
  value: String
  state: FixedArray<U32>
}

pub struct StringViewCodePoints {
  value: StringView
  state: FixedArray<U32>
}

builtin text_code_points_string_byte_length(value: String) -> U32 = "dew_string_byte_length"
builtin text_code_points_string_byte_at(value: String, index: U32) -> U8 = "dew_string_byte_at"
builtin text_code_points_string_view_byte_length(value: StringView) -> U32 = "dew_string_view_byte_length"
builtin text_code_points_string_view_byte_at(value: StringView, index: U32) -> U8 = "dew_string_view_byte_at"

fn code_point_continuation(byte: U8) -> Bool {
  byte >= 128u8 && byte <= 191u8
}

fn code_point_u8_to_u32(value: U8) -> U32 {
  value.into()
}

fn code_point_u32_to_u64(value: U32) -> U64 {
  value.into()
}

fn code_point_u64_to_u32(value: U64) -> U32 {
  value.into()
}

fn code_point_pack(scalar: U32, width: U32) -> U64 {
  code_point_u32_to_u64(scalar) |
  (code_point_u32_to_u64(width) << 32u64)
}

fn decode_code_point(
  first: U8,
  second: U8,
  third: U8,
  fourth: U8,
  remaining: U32,
) -> U64 {
  let first_bits = code_point_u8_to_u32(first)
  let second_bits = code_point_u8_to_u32(second)
  let third_bits = code_point_u8_to_u32(third)
  let fourth_bits = code_point_u8_to_u32(fourth)
  if first <= 127u8 {
    code_point_pack(first_bits, 1u32)
  } else if first >= 194u8 && first <= 223u8 && remaining >= 2u32 && code_point_continuation(second) {
    code_point_pack(
      ((first_bits & 31u32) << 6u32) | (second_bits & 63u32),
      2u32,
    )
  } else if first >= 224u8 && first <= 239u8 && remaining >= 3u32 && code_point_continuation(second) && code_point_continuation(third) && (first != 224u8 || second >= 160u8) && (first != 237u8 || second < 160u8) {
    code_point_pack(
      ((first_bits & 15u32) << 12u32) |
      ((second_bits & 63u32) << 6u32) |
      (third_bits & 63u32),
      3u32,
    )
  } else if first >= 240u8 && first <= 244u8 && remaining >= 4u32 && code_point_continuation(second) && code_point_continuation(third) && code_point_continuation(fourth) && (first != 240u8 || second >= 144u8) && (first != 244u8 || second < 144u8) {
    code_point_pack(
      ((first_bits & 7u32) << 18u32) |
      ((second_bits & 63u32) << 12u32) |
      ((third_bits & 63u32) << 6u32) |
      (fourth_bits & 63u32),
      4u32,
    )
  } else {
    unreachable()
  }
}

fn code_point_state() -> FixedArray<U32> {
  FixedArray::make(1u32, 0u32)
}

pub fn string_code_points(value: String) -> StringCodePoints {
  StringCodePoints::{
    value: value
    state: code_point_state()
  }
}

pub fn string_view_code_points(value: StringView) -> StringViewCodePoints {
  StringViewCodePoints::{
    value: value
    state: code_point_state()
  }
}

fn string_code_points_has_next(iterator: StringCodePoints) -> Bool {
  iterator.state.get_unchecked(0u32) < text_code_points_string_byte_length(iterator.value)
}

fn string_view_code_points_has_next(iterator: StringViewCodePoints) -> Bool {
  iterator.state.get_unchecked(0u32) < text_code_points_string_view_byte_length(iterator.value)
}

fn string_code_points_next(iterator: StringCodePoints) -> U32 {
  let index = iterator.state.get_unchecked(0u32)
  let length = text_code_points_string_byte_length(iterator.value)
  if index >= length {
    unreachable()
  } else {
    let remaining = length - index
    let first = text_code_points_string_byte_at(iterator.value, index)
    let second = if remaining >= 2u32 {
      text_code_points_string_byte_at(iterator.value, index + 1u32)
    } else {
      0u8
    }
    let third = if remaining >= 3u32 {
      text_code_points_string_byte_at(iterator.value, index + 2u32)
    } else {
      0u8
    }
    let fourth = if remaining >= 4u32 {
      text_code_points_string_byte_at(iterator.value, index + 3u32)
    } else {
      0u8
    }
    let decoded = decode_code_point(first, second, third, fourth, remaining)
    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)
    let width = code_point_u64_to_u32(decoded >> 32u64)
    iterator.state.set_unchecked(0u32, index + width)
    scalar
  }
}

fn string_view_code_points_next(iterator: StringViewCodePoints) -> U32 {
  let index = iterator.state.get_unchecked(0u32)
  let length = text_code_points_string_view_byte_length(iterator.value)
  if index >= length {
    unreachable()
  } else {
    let remaining = length - index
    let first = text_code_points_string_view_byte_at(iterator.value, index)
    let second = if remaining >= 2u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 1u32)
    } else {
      0u8
    }
    let third = if remaining >= 3u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 2u32)
    } else {
      0u8
    }
    let fourth = if remaining >= 4u32 {
      text_code_points_string_view_byte_at(iterator.value, index + 3u32)
    } else {
      0u8
    }
    let decoded = decode_code_point(first, second, third, fourth, remaining)
    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)
    let width = code_point_u64_to_u32(decoded >> 32u64)
    iterator.state.set_unchecked(0u32, index + width)
    scalar
  }
}

impl String {
  fn code_points(self) -> StringCodePoints {
    string_code_points(self)
  }
}

impl StringView {
  fn code_points(self) -> StringViewCodePoints {
    string_view_code_points(self)
  }
}

impl Iter<U32> for StringCodePoints {
  fn has_next(self) -> Bool {
    string_code_points_has_next(self)
  }

  fn next(self) -> U32 {
    string_code_points_next(self)
  }
}

impl Iter<U32> for StringViewCodePoints {
  fn has_next(self) -> Bool {
    string_view_code_points_has_next(self)
  }

  fn next(self) -> U32 {
    string_view_code_points_next(self)
  }
}

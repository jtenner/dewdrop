pub type WasiErrno = U32
pub type WasiFd = U32
pub type WasiSize = U32
pub type WasiPointer = U32
pub type WasiTimestamp = U64
pub type WasiFilesize = U64
pub type WasiFiledelta = I64
pub type WasiRights = U64
pub type WasiDircookie = U64

foreign import "wasi_snapshot_preview1" as WasiPreview1 {
  pub fn args_get(argv: WasiPointer, argv_buffer: WasiPointer) -> WasiErrno = "args_get"
  pub fn args_sizes_get(argc: WasiPointer, argv_buffer_size: WasiPointer) -> WasiErrno = "args_sizes_get"
  pub fn environ_get(environ: WasiPointer, environ_buffer: WasiPointer) -> WasiErrno = "environ_get"
  pub fn environ_sizes_get(environ_count: WasiPointer, environ_buffer_size: WasiPointer) -> WasiErrno = "environ_sizes_get"
  pub fn clock_res_get(clock_id: U32, resolution: WasiPointer) -> WasiErrno = "clock_res_get"
  pub fn clock_time_get(clock_id: U32, precision: WasiTimestamp, time: WasiPointer) -> WasiErrno = "clock_time_get"
  pub fn fd_advise(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize, advice: U32) -> WasiErrno = "fd_advise"
  pub fn fd_allocate(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize) -> WasiErrno = "fd_allocate"
  pub fn fd_close(fd: WasiFd) -> WasiErrno = "fd_close"
  pub fn fd_datasync(fd: WasiFd) -> WasiErrno = "fd_datasync"
  pub fn fd_fdstat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "fd_fdstat_get"
  pub fn fd_fdstat_set_flags(fd: WasiFd, flags: U32) -> WasiErrno = "fd_fdstat_set_flags"
  pub fn fd_fdstat_set_rights(fd: WasiFd, rights_base: WasiRights, rights_inheriting: WasiRights) -> WasiErrno = "fd_fdstat_set_rights"
  pub fn fd_filestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "fd_filestat_get"
  pub fn fd_filestat_set_size(fd: WasiFd, size: WasiFilesize) -> WasiErrno = "fd_filestat_set_size"
  pub fn fd_filestat_set_times(fd: WasiFd, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = "fd_filestat_set_times"
  pub fn fd_pread(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, read: WasiPointer) -> WasiErrno = "fd_pread"
  pub fn fd_prestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "fd_prestat_get"
  pub fn fd_prestat_dir_name(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "fd_prestat_dir_name"
  pub fn fd_pwrite(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, written: WasiPointer) -> WasiErrno = "fd_pwrite"
  pub fn fd_write(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, written: WasiPointer) -> WasiErrno = "fd_write"
  pub fn fd_read(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, read: WasiPointer) -> WasiErrno = "fd_read"
  pub fn fd_readdir(fd: WasiFd, buffer: WasiPointer, buffer_length: WasiSize, cookie: WasiDircookie, used: WasiPointer) -> WasiErrno = "fd_readdir"
  pub fn fd_renumber(from: WasiFd, to: WasiFd) -> WasiErrno = "fd_renumber"
  pub fn fd_seek(fd: WasiFd, offset: WasiFiledelta, whence: U32, new_offset: WasiPointer) -> WasiErrno = "fd_seek"
  pub fn fd_sync(fd: WasiFd) -> WasiErrno = "fd_sync"
  pub fn fd_tell(fd: WasiFd, offset: WasiPointer) -> WasiErrno = "fd_tell"
  pub fn path_create_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "path_create_directory"
  pub fn path_filestat_get(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, status: WasiPointer) -> WasiErrno = "path_filestat_get"
  pub fn path_filestat_set_times(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = "path_filestat_set_times"
  pub fn path_link(old_fd: WasiFd, old_flags: U32, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "path_link"
  pub fn path_open(fd: WasiFd, directory_flags: U32, path: WasiPointer, path_length: WasiSize, open_flags: U32, rights_base: WasiRights, rights_inheriting: WasiRights, fd_flags: U32, opened_fd: WasiPointer) -> WasiErrno = "path_open"
  pub fn path_readlink(fd: WasiFd, path: WasiPointer, path_length: WasiSize, buffer: WasiPointer, buffer_length: WasiSize, used: WasiPointer) -> WasiErrno = "path_readlink"
  pub fn path_remove_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "path_remove_directory"
  pub fn path_rename(old_fd: WasiFd, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "path_rename"
  pub fn path_symlink(old_path: WasiPointer, old_path_length: WasiSize, fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "path_symlink"
  pub fn path_unlink_file(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "path_unlink_file"
  pub fn poll_oneoff(input: WasiPointer, output: WasiPointer, subscriptions: WasiSize, events: WasiPointer) -> WasiErrno = "poll_oneoff"
  pub fn proc_exit(code: U32) -> Unit = "proc_exit"
  pub fn proc_raise(signal: U32) -> WasiErrno = "proc_raise"
  pub fn sched_yield() -> WasiErrno = "sched_yield"
  pub fn random_get(buffer: WasiPointer, buffer_length: WasiSize) -> WasiErrno = "random_get"
  pub fn sock_accept(fd: WasiFd, fd_flags: U32, accepted_fd: WasiPointer) -> WasiErrno = "sock_accept"
  pub fn sock_recv(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, received: WasiPointer, output_flags: WasiPointer) -> WasiErrno = "sock_recv"
  pub fn sock_send(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, sent: WasiPointer) -> WasiErrno = "sock_send"
  pub fn sock_shutdown(fd: WasiFd, how: U32) -> WasiErrno = "sock_shutdown"
}

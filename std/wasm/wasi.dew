pub type WasiErrno = U32
pub type WasiFd = U32
pub type WasiSize = U32
pub type WasiPointer = U32
pub type WasiTimestamp = U64
pub type WasiFilesize = U64
pub type WasiFiledelta = I64
pub type WasiRights = U64
pub type WasiDircookie = U64

pub builtin args_get(argv: WasiPointer, argv_buffer: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.args_get"
pub builtin args_sizes_get(argc: WasiPointer, argv_buffer_size: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.args_sizes_get"
pub builtin environ_get(environ: WasiPointer, environ_buffer: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.environ_get"
pub builtin environ_sizes_get(environ_count: WasiPointer, environ_buffer_size: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.environ_sizes_get"
pub builtin clock_res_get(clock_id: U32, resolution: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.clock_res_get"
pub builtin clock_time_get(clock_id: U32, precision: WasiTimestamp, time: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.clock_time_get"
pub builtin fd_advise(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize, advice: U32) -> WasiErrno = "wasi_snapshot_preview1.fd_advise"
pub builtin fd_allocate(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize) -> WasiErrno = "wasi_snapshot_preview1.fd_allocate"
pub builtin fd_close(fd: WasiFd) -> WasiErrno = "wasi_snapshot_preview1.fd_close"
pub builtin fd_datasync(fd: WasiFd) -> WasiErrno = "wasi_snapshot_preview1.fd_datasync"
pub builtin fd_fdstat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_fdstat_get"
pub builtin fd_fdstat_set_flags(fd: WasiFd, flags: U32) -> WasiErrno = "wasi_snapshot_preview1.fd_fdstat_set_flags"
pub builtin fd_fdstat_set_rights(fd: WasiFd, rights_base: WasiRights, rights_inheriting: WasiRights) -> WasiErrno = "wasi_snapshot_preview1.fd_fdstat_set_rights"
pub builtin fd_filestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_filestat_get"
pub builtin fd_filestat_set_size(fd: WasiFd, size: WasiFilesize) -> WasiErrno = "wasi_snapshot_preview1.fd_filestat_set_size"
pub builtin fd_filestat_set_times(fd: WasiFd, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = "wasi_snapshot_preview1.fd_filestat_set_times"
pub builtin fd_pread(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, read: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_pread"
pub builtin fd_prestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_prestat_get"
pub builtin fd_prestat_dir_name(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.fd_prestat_dir_name"
pub builtin fd_pwrite(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, written: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_pwrite"
pub builtin fd_write(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, written: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_write"
pub builtin fd_read(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, read: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_read"
pub builtin fd_readdir(fd: WasiFd, buffer: WasiPointer, buffer_length: WasiSize, cookie: WasiDircookie, used: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_readdir"
pub builtin fd_renumber(from: WasiFd, to: WasiFd) -> WasiErrno = "wasi_snapshot_preview1.fd_renumber"
pub builtin fd_seek(fd: WasiFd, offset: WasiFiledelta, whence: U32, new_offset: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_seek"
pub builtin fd_sync(fd: WasiFd) -> WasiErrno = "wasi_snapshot_preview1.fd_sync"
pub builtin fd_tell(fd: WasiFd, offset: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.fd_tell"
pub builtin path_create_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_create_directory"
pub builtin path_filestat_get(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, status: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.path_filestat_get"
pub builtin path_filestat_set_times(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = "wasi_snapshot_preview1.path_filestat_set_times"
pub builtin path_link(old_fd: WasiFd, old_flags: U32, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_link"
pub builtin path_open(fd: WasiFd, directory_flags: U32, path: WasiPointer, path_length: WasiSize, open_flags: U32, rights_base: WasiRights, rights_inheriting: WasiRights, fd_flags: U32, opened_fd: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.path_open"
pub builtin path_readlink(fd: WasiFd, path: WasiPointer, path_length: WasiSize, buffer: WasiPointer, buffer_length: WasiSize, used: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.path_readlink"
pub builtin path_remove_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_remove_directory"
pub builtin path_rename(old_fd: WasiFd, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_rename"
pub builtin path_symlink(old_path: WasiPointer, old_path_length: WasiSize, fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_symlink"
pub builtin path_unlink_file(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.path_unlink_file"
pub builtin poll_oneoff(input: WasiPointer, output: WasiPointer, subscriptions: WasiSize, events: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.poll_oneoff"
pub builtin proc_exit(code: U32) -> Unit = "wasi_snapshot_preview1.proc_exit"
pub builtin proc_raise(signal: U32) -> WasiErrno = "wasi_snapshot_preview1.proc_raise"
pub builtin sched_yield() -> WasiErrno = "wasi_snapshot_preview1.sched_yield"
pub builtin random_get(buffer: WasiPointer, buffer_length: WasiSize) -> WasiErrno = "wasi_snapshot_preview1.random_get"
pub builtin sock_accept(fd: WasiFd, fd_flags: U32, accepted_fd: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.sock_accept"
pub builtin sock_recv(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, received: WasiPointer, output_flags: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.sock_recv"
pub builtin sock_send(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, sent: WasiPointer) -> WasiErrno = "wasi_snapshot_preview1.sock_send"
pub builtin sock_shutdown(fd: WasiFd, how: U32) -> WasiErrno = "wasi_snapshot_preview1.sock_shutdown"

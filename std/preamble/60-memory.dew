pub builtin i8_load(address: U32) -> I8 = "i32.load8_s"
pub builtin i8_store(address: U32, value: I8) -> Unit = "i32.store8"
pub builtin i16_load(address: U32) -> I16 = "i32.load16_s"
pub builtin i16_store(address: U32, value: I16) -> Unit = "i32.store16"
pub builtin i32_load(address: U32) -> I32 = "i32.load"
pub builtin i32_store(address: U32, value: I32) -> Unit = "i32.store"
pub builtin i64_load(address: U32) -> I64 = "i64.load"
pub builtin i64_store(address: U32, value: I64) -> Unit = "i64.store"
pub builtin u8_load(address: U32) -> U8 = "i32.load8_u"
pub builtin u8_store(address: U32, value: U8) -> Unit = "i32.store8"
pub builtin u16_load(address: U32) -> U16 = "i32.load16_u"
pub builtin u16_store(address: U32, value: U16) -> Unit = "i32.store16"
pub builtin u32_load(address: U32) -> U32 = "i32.load"
pub builtin u32_store(address: U32, value: U32) -> Unit = "i32.store"
pub builtin u64_load(address: U32) -> U64 = "i64.load"
pub builtin u64_store(address: U32, value: U64) -> Unit = "i64.store"
pub builtin f32_load(address: U32) -> F32 = "f32.load"
pub builtin f32_store(address: U32, value: F32) -> Unit = "f32.store"
pub builtin f64_load(address: U32) -> F64 = "f64.load"
pub builtin f64_store(address: U32, value: F64) -> Unit = "f64.store"
pub fn swar32_load(address: U32) -> Swar32 {
  unsafe_bitcast(u32_load(address))
}
pub fn swar32_store(address: U32, value: Swar32) -> Unit {
  u32_store(address, unsafe_bitcast(value))
}
pub fn swar64_load(address: U32) -> Swar64 {
  unsafe_bitcast(u64_load(address))
}
pub fn swar64_store(address: U32, value: Swar64) -> Unit {
  u64_store(address, unsafe_bitcast(value))
}
pub builtin v128_load(address: U32) -> V128 = "v128.load"
pub builtin v128_store(address: U32, value: V128) -> Unit = "v128.store"

pub trait Debug {
  fn debug(self) -> Unit
}

builtin __dew_debug_write(fd: U32, value: Bytes) -> U32 = "dew_wasi_fd_write"
fn __dew_debug_ignore(value: U32) -> Unit {}
// The synchronous host call owns this scratch range until it returns.
// No host callback may re-enter Debug while its bytes are pending.
fn __dew_debug_write_scratch(start: U32, length: U32) -> U32 {
  if start < 16u32 || start > 65536u32 || length > 65536u32 - start {
    unreachable()
  }
  while 0u32 {
    written if written < length => {
      let remaining = length - written
      u32_store(0u32, start + written)
      u32_store(4u32, remaining)
      u32_store(8u32, 0u32)
      if DebugOutput.__dew_debug_fd_write(1u32, 0u32, 1u32, 8u32) != 0u32 {
        unreachable()
      } else {
        let count = u32_load(8u32)
        if count == 0u32 || count > remaining {
          unreachable()
        } else {
          continue written + count
        }
      }
    }
    _ => break length
  }
}

fn __dew_debug_integer(value: U64, negative: Bool) -> U32 {
  // A U64 needs at most 20 decimal digits. Reserve 32 bytes, including sign.
  let mut cursor = 48u32
  let _ = while value {
    magnitude => {
      cursor = cursor - 1u32
      u8_store(cursor, u64_into_u8(magnitude % 10u64 + 48u64))
      let next = magnitude / 10u64
      if next == 0u64 {
        break 0u32
      } else {
        continue next
      }
    }
  }
  if negative {
    cursor = cursor - 1u32
    u8_store(cursor, 45u8)
  }
  __dew_debug_write_scratch(cursor, 48u32 - cursor)
}

fn __dew_debug_i8(value: I8) -> U32 {
  __dew_debug_i64(i8_into_i64(i8_into_i8(value)))
}
fn __dew_debug_i16(value: I16) -> U32 {
  __dew_debug_i64(i16_into_i64(i16_into_i16(value)))
}
fn __dew_debug_i32(value: I32) -> U32 {
  __dew_debug_i64(value.into())
}
fn __dew_debug_i64(value: I64) -> U32 {
  let bits = unsafe_bitcast::<I64, U64>(value)
  if value < 0i64 {
    // Unsigned subtraction also handles the signed minimum exactly.
    __dew_debug_integer(0u64 - bits, true)
  } else {
    __dew_debug_integer(bits, false)
  }
}
fn __dew_debug_u8(value: U8) -> U32 {
  __dew_debug_u64(u8_into_u64(u8_into_u8(value)))
}
fn __dew_debug_u16(value: U16) -> U32 {
  __dew_debug_u64(u16_into_u64(u16_into_u16(value)))
}
fn __dew_debug_u32(value: U32) -> U32 {
  __dew_debug_u64(value.into())
}
fn __dew_debug_u64(value: U64) -> U32 {
  __dew_debug_integer(value, false)
}
builtin __dew_debug_f32(value: F32) -> U32 = "dew_debug_f32"
builtin __dew_debug_f64(value: F64) -> U32 = "dew_debug_f64"
builtin __dew_debug_string(value: String) -> U32 = "dew_debug_string"
builtin __dew_debug_bytes(value: Bytes) -> U32 = "dew_debug_bytes"
builtin __dew_debug_v128(value: V128) -> U32 = "dew_debug_v128"
pub fn debug<t: Debug>(value: t) -> Unit {
  value.debug()
}

foreign import "wasi_snapshot_preview1" as DebugOutput {
  fn __dew_debug_fd_write(fd: U32, iovs: U32, count: U32, written: U32) -> U32 = "fd_write"
}

impl Debug for Unit {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_write(1u32, b"()"))
  }
}

impl Debug for Bool {
  fn debug(self) -> Unit {
    __dew_debug_ignore(if self {
      __dew_debug_write(1u32, b"true")
    } else {
      __dew_debug_write(1u32, b"false")
    })
  }
}

impl Debug for I8 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i8(self))
  }
}

impl Debug for I16 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i16(self))
  }
}

impl Debug for I32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i32(self))
  }
}

impl Debug for I64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i64(self))
  }
}

impl Debug for U8 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u8(self))
  }
}

impl Debug for U16 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u16(self))
  }
}

impl Debug for U32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u32(self))
  }
}

impl Debug for U64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u64(self))
  }
}

impl Debug for F32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_f32(self))
  }
}

impl Debug for F64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_f64(self))
  }
}

impl Debug for String {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_string(self))
  }
}

impl Debug for Bytes {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_bytes(self))
  }
}

impl Debug for Swar32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_write(1u32, b"Swar32("))
    debug(swar32_to_bits(self))
    __dew_debug_ignore(__dew_debug_write(1u32, b")"))
  }
}

impl Debug for Swar64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_write(1u32, b"Swar64("))
    debug(swar64_to_bits(self))
    __dew_debug_ignore(__dew_debug_write(1u32, b")"))
  }
}

impl Debug for V128 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_v128(self))
  }
}

pub trait Debug {
  fn debug(self) -> Unit
}

pub fn __dew_debug_ignore(value: U32) -> Unit {}
// The synchronous host call owns this scratch range until it returns.
// No host callback may re-enter Debug while its bytes are pending.
pub fn __dew_debug_write_scratch(start: U32, length: U32) -> U32 {
  if start < 16u32 || start > 65536u32 || length > 65536u32 - start {
    unreachable()
  }
  while 0u32 {
    written if written < length => {
      let remaining = length - written
      u32_store(0u32, start + written)
      u32_store(4u32, remaining)
      u32_store(8u32, 0u32)
      if DebugOutput.__dew_debug_fd_write(1u32, 0u32, 1u32, 8u32) != 0u32 {
        unreachable()
      } else {
        let count = u32_load(8u32)
        if count == 0u32 || count > remaining {
          unreachable()
        } else {
          continue written + count
        }
      }
    }
    _ => break length
  }
}

pub fn __dew_debug_integer(value: U64, negative: Bool) -> U32 {
  // A U64 needs at most 20 decimal digits. Reserve 32 bytes, including sign.
  let mut cursor = 48u32
  let _ = while value {
    magnitude => {
      cursor = cursor - 1u32
      u8_store(cursor, u64_into_u8(magnitude % 10u64 + 48u64))
      let next = magnitude / 10u64
      if next == 0u64 {
        break 0u32
      } else {
        continue next
      }
    }
  }
  if negative {
    cursor = cursor - 1u32
    u8_store(cursor, 45u8)
  }
  __dew_debug_write_scratch(cursor, 48u32 - cursor)
}

pub fn __dew_debug_i8(value: I8) -> U32 {
  __dew_debug_i64(i8_into_i64(i8_into_i8(value)))
}
pub fn __dew_debug_i16(value: I16) -> U32 {
  __dew_debug_i64(i16_into_i64(i16_into_i16(value)))
}
pub fn __dew_debug_i32(value: I32) -> U32 {
  __dew_debug_i64(value.into())
}
pub fn __dew_debug_i64(value: I64) -> U32 {
  let bits = unsafe_bitcast::<I64, U64>(value)
  if value < 0i64 {
    // Unsigned subtraction also handles the signed minimum exactly.
    __dew_debug_integer(0u64 - bits, true)
  } else {
    __dew_debug_integer(bits, false)
  }
}
pub fn __dew_debug_u8(value: U8) -> U32 {
  __dew_debug_u64(u8_into_u64(u8_into_u8(value)))
}
pub fn __dew_debug_u16(value: U16) -> U32 {
  __dew_debug_u64(u16_into_u64(u16_into_u16(value)))
}
pub fn __dew_debug_u32(value: U32) -> U32 {
  __dew_debug_u64(value.into())
}
pub fn __dew_debug_u64(value: U64) -> U32 {
  __dew_debug_integer(value, false)
}
pub builtin __dew_debug_f32_bits(value: F32) -> U32 = "i32.reinterpret_f32"
pub builtin __dew_debug_f64_bits(value: F64) -> U64 = "i64.reinterpret_f64"

pub fn __dew_debug_hex_digits(value: U64, start: U32, digits: U32) -> U32 {
  if digits > 16u32 || start < 16u32 || start > 65536u32 || digits > 65536u32 - start {
    unreachable()
  }
  let mut bits = value
  while digits {
    left if left > 0u32 => {
      let nibble = bits & 15u64
      let byte = if nibble < 10u64 {
        u64_into_u8(nibble + 48u64)
      } else {
        u64_into_u8(nibble + 87u64)
      }
      u8_store(start + left - 1u32, byte)
      bits = bits >> 4u64
      continue left - 1u32
    }
    _ => break start + digits
  }
}

pub fn __dew_debug_float_bits(bits: U64, wide: Bool) -> U32 {
  u8_store(16u32, 102u8)
  u8_store(17u32, if wide {
    54u8
  } else {
    51u8
  })
  u8_store(18u32, if wide {
    52u8
  } else {
    50u8
  })
  u8_store(19u32, 40u8)
  u8_store(20u32, 48u8)
  u8_store(21u32, 120u8)
  let digits = if wide {
    16u32
  } else {
    8u32
  }
  let end = __dew_debug_hex_digits(bits, 22u32, digits)
  u8_store(end, 41u8)
  __dew_debug_write_scratch(16u32, end + 1u32 - 16u32)
}

pub fn __dew_debug_f32(value: F32) -> U32 {
  __dew_debug_float_bits(u32_into_u64(__dew_debug_f32_bits(value)), false)
}
pub fn __dew_debug_f64(value: F64) -> U32 {
  __dew_debug_float_bits(__dew_debug_f64_bits(value), true)
}
// These are the existing text storage contracts. Keep one declaration of each
// operation; dew.std.text_runtime exposes ordinary forwarding functions.
pub builtin __dew_text_bytes(value: String) -> Bytes = "dew_string_as_bytes"
pub builtin __dew_text_byte_length(value: Bytes) -> U32 = "struct.get 2"
pub builtin __dew_text_byte_at(value: Bytes, index: U32) -> U8 = "dew_bytes_byte_at"

pub fn __dew_debug_count(total: U32, extra: U32) -> U32 {
  if extra > 4294967295u32 - total {
    unreachable()
  }
  total + extra
}

pub fn __dew_debug_quoted_text(value: Bytes, bytes: Bool) -> U32 {
  let length = __dew_text_byte_length(value)
  let mut cursor = 16u32
  let mut total = 0u32
  if bytes {
    u8_store(cursor, 98u8)
    cursor = cursor + 1u32
  }
  u8_store(cursor, 34u8)
  cursor = cursor + 1u32
  let _ = while 0u32 {
    index if index < length => {
      // A byte expands to at most four ASCII bytes. Flush before that write.
      if cursor > 65532u32 {
        total = __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor - 16u32))
        cursor = 16u32
      }
      let byte = __dew_text_byte_at(value, index)
      let escape = match byte {
        34u8 => 34u8
        92u8 => 92u8
        10u8 => 110u8
        13u8 => 114u8
        9u8 => 116u8
        _ => 0u8
      }
      if escape != 0u8 {
        u8_store(cursor, 92u8)
        u8_store(cursor + 1u32, escape)
        cursor = cursor + 2u32
      } else if byte < 32u8 || byte == 127u8 || (bytes && byte > 126u8) {
        u8_store(cursor, 92u8)
        u8_store(cursor + 1u32, 120u8)
        cursor = __dew_debug_hex_digits(u8_into_u64(byte), cursor + 2u32, 2u32)
      } else {
        u8_store(cursor, byte)
        cursor = cursor + 1u32
      }
      continue index + 1u32
    }
    _ => break ()
  }
  if cursor == 65536u32 {
    total = __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor - 16u32))
    cursor = 16u32
  }
  u8_store(cursor, 34u8)
  __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor + 1u32 - 16u32))
}

pub fn __dew_debug_string(value: String) -> U32 {
  __dew_debug_quoted_text(__dew_text_bytes(value), false)
}
pub fn __dew_debug_bytes(value: Bytes) -> U32 {
  __dew_debug_quoted_text(value, true)
}
pub builtin __dew_debug_v128_low(value: V128) -> U64 = "i64x2.extract_lane 0"
pub builtin __dew_debug_v128_high(value: V128) -> U64 = "i64x2.extract_lane 1"

pub fn __dew_debug_v128(value: V128) -> U32 {
  u8_store(16u32, 118u8)
  u8_store(17u32, 49u8)
  u8_store(18u32, 50u8)
  u8_store(19u32, 56u8)
  u8_store(20u32, 40u8)
  u8_store(21u32, 48u8)
  u8_store(22u32, 120u8)
  let middle = __dew_debug_hex_digits(__dew_debug_v128_high(value), 23u32, 16u32)
  let end = __dew_debug_hex_digits(__dew_debug_v128_low(value), middle, 16u32)
  u8_store(end, 41u8)
  __dew_debug_write_scratch(16u32, end + 1u32 - 16u32)
}
pub fn debug<t: Debug>(value: t) -> Unit {
  value.debug()
}

foreign import "wasi_snapshot_preview1" as DebugOutput {
  fn __dew_debug_fd_write(fd: U32, iovs: U32, count: U32, written: U32) -> U32 = "fd_write"
}

impl Debug for Unit {
  fn debug(self) -> Unit {
    u8_store(16u32, 40u8)
    u8_store(17u32, 41u8)
    __dew_debug_ignore(__dew_debug_write_scratch(16u32, 2u32))
  }
}

impl Debug for Bool {
  fn debug(self) -> Unit {
    let length = if self {
      u8_store(16u32, 116u8)
      u8_store(17u32, 114u8)
      u8_store(18u32, 117u8)
      u8_store(19u32, 101u8)
      4u32
    } else {
      u8_store(16u32, 102u8)
      u8_store(17u32, 97u8)
      u8_store(18u32, 108u8)
      u8_store(19u32, 115u8)
      u8_store(20u32, 101u8)
      5u32
    }
    __dew_debug_ignore(__dew_debug_write_scratch(16u32, length))
  }
}

impl Debug for I8 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i8(self))
  }
}

impl Debug for I16 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i16(self))
  }
}

impl Debug for I32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i32(self))
  }
}

impl Debug for I64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_i64(self))
  }
}

impl Debug for U8 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u8(self))
  }
}

impl Debug for U16 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u16(self))
  }
}

impl Debug for U32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u32(self))
  }
}

impl Debug for U64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_u64(self))
  }
}

impl Debug for F32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_f32(self))
  }
}

impl Debug for F64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_f64(self))
  }
}

impl Debug for String {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_string(self))
  }
}

impl Debug for Bytes {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_bytes(self))
  }
}

pub fn __dew_debug_swar(value: U64, wide: Bool) -> U32 {
  u8_store(16u32, 83u8)
  u8_store(17u32, 119u8)
  u8_store(18u32, 97u8)
  u8_store(19u32, 114u8)
  u8_store(20u32, if wide {
    54u8
  } else {
    51u8
  })
  u8_store(21u32, if wide {
    52u8
  } else {
    50u8
  })
  u8_store(22u32, 40u8)
  let _ = __dew_debug_write_scratch(16u32, 7u32)
  let digits = __dew_debug_integer(value, false)
  u8_store(16u32, 41u8)
  let _ = __dew_debug_write_scratch(16u32, 1u32)
  8u32 + digits
}

impl Debug for Swar32 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_swar(u32_into_u64(swar32_to_bits(self)), false))
  }
}

impl Debug for Swar64 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_swar(swar64_to_bits(self), true))
  }
}

impl Debug for V128 {
  fn debug(self) -> Unit {
    __dew_debug_ignore(__dew_debug_v128(self))
  }
}

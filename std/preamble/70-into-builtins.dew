// Each raw target below is one Wasm instruction. Conversion policy stays in Dew.
pub builtin raw_i32_extend8_s(value: I32) -> I32 = "i32.extend8_s"
pub builtin raw_i32_extend16_s(value: I32) -> I32 = "i32.extend16_s"

pub builtin raw_f64_promote_f32(value: F32) -> F64 = "f64.promote_f32"

pub fn i8_into_i8(value: I8) -> I8 {
  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(unsafe_bitcast::<I8, I32>(value)))
}
pub fn i8_into_i16(value: I8) -> I16 {
  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(unsafe_bitcast::<I8, I32>(value)))
}
pub fn i8_into_i32(value: I8) -> I32 {
  unsafe_bitcast::<I8, I32>(value)
}
pub fn i8_into_i64(value: I8) -> I64 {
  raw_i64_extend_i32_s(unsafe_bitcast::<I8, I32>(value))
}
pub fn i8_into_u8(value: I8) -> U8 {
  unsafe_bitcast::<I32, U8>((unsafe_bitcast::<I8, I32>(value) & 255i32))
}
pub fn i8_into_u16(value: I8) -> U16 {
  unsafe_bitcast::<I32, U16>((unsafe_bitcast::<I8, I32>(value) & 65535i32))
}
pub fn i8_into_u32(value: I8) -> U32 {
  unsafe_bitcast::<I32, U32>(unsafe_bitcast::<I8, I32>(value))
}
pub fn i8_into_u64(value: I8) -> U64 {

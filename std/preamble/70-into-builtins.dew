pub fn f32_into_i8(value: F32) -> I8 {
  let integer = f32_into_i32(value)
  if integer < -128i32 || integer > 127i32 {
    unreachable()
  } else {
    unsafe_bitcast::<I32, I8>(integer)
  }
}
pub fn f32_into_i16(value: F32) -> I16 {
  let integer = f32_into_i32(value)
  if integer < -32768i32 || integer > 32767i32 {
    unreachable()
  } else {
    unsafe_bitcast::<I32, I16>(integer)
  }
}

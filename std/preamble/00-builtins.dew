pub builtin assert(condition: Bool, message: String) -> Unit = "dew_assert"
pub builtin unreachable() -> Never = "dew_unreachable"
pub builtin i32_add(left: I32, right: I32) -> I32 = "i32_add"
pub builtin i32_sub(left: I32, right: I32) -> I32 = "i32_sub"
pub builtin i32_lte(left: I32, right: I32) -> Bool = "i32_lte"
pub builtin swar32_from_bits(value: U32) -> Swar32 = "swar32_from_bits"
pub builtin swar32_to_bits(value: Swar32) -> U32 = "swar32_to_bits"
pub builtin swar32_and(left: Swar32, right: Swar32) -> Swar32 = "swar32_and"
pub builtin swar32_or(left: Swar32, right: Swar32) -> Swar32 = "swar32_or"
pub builtin swar32_xor(left: Swar32, right: Swar32) -> Swar32 = "swar32_xor"
pub builtin swar64_from_bits(value: U64) -> Swar64 = "swar64_from_bits"
pub builtin swar64_to_bits(value: Swar64) -> U64 = "swar64_to_bits"
pub builtin swar64_and(left: Swar64, right: Swar64) -> Swar64 = "swar64_and"
pub builtin swar64_or(left: Swar64, right: Swar64) -> Swar64 = "swar64_or"
pub builtin swar64_xor(left: Swar64, right: Swar64) -> Swar64 = "swar64_xor"
pub builtin v128_and(left: V128, right: V128) -> V128 = "v128_and"
pub builtin v128_or(left: V128, right: V128) -> V128 = "v128_or"
pub builtin v128_xor(left: V128, right: V128) -> V128 = "v128_xor"

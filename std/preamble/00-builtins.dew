pub builtin assert(condition: Bool, message: String) -> Unit = "dew_assert"
pub builtin unreachable() -> Never = "dew_unreachable"
pub builtin i32_add(left: I32, right: I32) -> I32 = "i32.add"
pub builtin i32_sub(left: I32, right: I32) -> I32 = "i32.sub"
pub builtin i32_lte(left: I32, right: I32) -> Bool = "i32.le_s"
pub fn swar32_from_bits(value: U32) -> Swar32 {
  unsafe_bitcast(value)
}
pub fn swar32_to_bits(value: Swar32) -> U32 {
  unsafe_bitcast(value)
}
pub fn swar32_and(left: Swar32, right: Swar32) -> Swar32 {
  unsafe_bitcast(u32_and(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub fn swar32_or(left: Swar32, right: Swar32) -> Swar32 {
  unsafe_bitcast(u32_or(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub fn swar32_xor(left: Swar32, right: Swar32) -> Swar32 {
  unsafe_bitcast(u32_xor(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub fn swar64_from_bits(value: U64) -> Swar64 {
  unsafe_bitcast(value)
}
pub fn swar64_to_bits(value: Swar64) -> U64 {
  unsafe_bitcast(value)
}
pub fn swar64_and(left: Swar64, right: Swar64) -> Swar64 {
  unsafe_bitcast(u64_and(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub fn swar64_or(left: Swar64, right: Swar64) -> Swar64 {
  unsafe_bitcast(u64_or(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub fn swar64_xor(left: Swar64, right: Swar64) -> Swar64 {
  unsafe_bitcast(u64_xor(unsafe_bitcast(left), unsafe_bitcast(right)))
}
pub builtin v128_and(left: V128, right: V128) -> V128 = "v128.and"
pub builtin v128_or(left: V128, right: V128) -> V128 = "v128.or"
pub builtin v128_xor(left: V128, right: V128) -> V128 = "v128.xor"

pub struct Map<key, value> {}

builtin map_singleton<key, value>(key: key, value: value) -> Map<key, value> = "dew_map_singleton"
builtin map_length<key, value>(map: Map<key, value>) -> U32 = "dew_map_length"
builtin map_get<key, value>(map: Map<key, value>, key: key) -> Option<value> = "dew_map_get"
builtin map_get_unchecked<key, value>(map: Map<key, value>, key: key) -> value = "dew_map_get_unchecked"
builtin map_insert<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = "dew_map_insert"
builtin map_set<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = "dew_map_set"
builtin map_contains_key<key, value>(map: Map<key, value>, key: key) -> Bool = "dew_map_contains_key"

impl<key, value> Map<key, value> {
  fn singleton(key: key, value: value) -> Map<key, value> {
    map_singleton(key, value)
  }
  fn length(self) -> U32 {
    map_length(self)
  }
  fn get(self, key: key) -> Option<value> {
    map_get(self, key)
  }
  fn get_unchecked(self, key: key) -> value {
    map_get_unchecked(self, key)
  }
  fn insert(self, key: key, value: value) -> Unit {
    map_insert(self, key, value)
  }
  fn set(self, key: key, value: value) -> Unit {
    map_set(self, key, value)
  }
  fn contains_key(self, key: key) -> Bool {
    map_contains_key(self, key)
  }
  fn empty() -> Map<key, value> {
    map_empty()
  }
  fn remove(self, key: key) -> Bool {
    map_remove(self, key)
  }
  fn clear(self) -> Unit {
    map_clear(self)
  }
  fn iter(self) -> MapEntryIter<key, value> {
    map_entries(self)
  }
}

impl<key, value> IndexedGet<key, value> for Map<key, value> {
  fn indexed_get(self, key: key) -> value {
    map_get_unchecked(self, key)
  }
}

impl<key, value> IndexedSet<key, value> for Map<key, value> {
  fn indexed_set(self, key: key, value: value) -> Unit {
    map_set(self, key, value)
  }
}

builtin map_empty<key, value>() -> Map<key, value> = "dew_map_empty"
builtin map_remove<key, value>(map: Map<key, value>, key: key) -> Bool = "dew_map_remove"
builtin map_clear<key, value>(map: Map<key, value>) -> Unit = "dew_map_clear"

pub struct MapEntry<key, value> {}
pub struct MapKeyIter<key, value> {}
pub struct MapValueIter<key, value> {}
pub struct MapEntryIter<key, value> {}

builtin map_keys<key, value>(map: Map<key, value>) -> MapKeyIter<key, value> = "dew_map_keys"
builtin map_values<key, value>(map: Map<key, value>) -> MapValueIter<key, value> = "dew_map_values"
builtin map_entries<key, value>(map: Map<key, value>) -> MapEntryIter<key, value> = "dew_map_entries"
builtin map_key_iter_has_next<key, value>(iter: MapKeyIter<key, value>) -> Bool = "dew_map_key_iter_has_next"
builtin map_key_iter_next<key, value>(iter: MapKeyIter<key, value>) -> key = "dew_map_key_iter_next"
builtin map_value_iter_has_next<key, value>(iter: MapValueIter<key, value>) -> Bool = "dew_map_value_iter_has_next"
builtin map_value_iter_next<key, value>(iter: MapValueIter<key, value>) -> value = "dew_map_value_iter_next"
builtin map_entry_iter_has_next<key, value>(iter: MapEntryIter<key, value>) -> Bool = "dew_map_entry_iter_has_next"
builtin map_entry_iter_next<key, value>(iter: MapEntryIter<key, value>) -> MapEntry<key, value> = "dew_map_entry_iter_next"
builtin map_entry_key<key, value>(entry: MapEntry<key, value>) -> key = "dew_map_entry_key"
builtin map_entry_value<key, value>(entry: MapEntry<key, value>) -> value = "dew_map_entry_value"

impl<key, value> Map<key, value> {
  fn keys(self) -> MapKeyIter<key, value> {
    map_keys(self)
  }
  fn values(self) -> MapValueIter<key, value> {
    map_values(self)
  }
  fn entries(self) -> MapEntryIter<key, value> {
    map_entries(self)
  }
}

impl<key, value> MapEntry<key, value> {
  fn key(self) -> key {
    map_entry_key(self)
  }
  fn value(self) -> value {
    map_entry_value(self)
  }
}

impl<key, value> Iter<key> for MapKeyIter<key, value> {
  fn next(self) -> Option<key> {
    map_key_iter_next_option(self)
  }
}

impl<key, value> Iter<value> for MapValueIter<key, value> {
  fn next(self) -> Option<value> {
    map_value_iter_next_option(self)
  }
}

impl<key, value> Iter<MapEntry<key, value>> for MapEntryIter<key, value> {
  fn next(self) -> Option<MapEntry<key, value>> {
    map_entry_iter_next_option(self)
  }
}

builtin map_key_iter_next_option<key, value>(iter: MapKeyIter<key, value>) -> Option<key> = "dew_map_key_iter_next_option"
builtin map_value_iter_next_option<key, value>(iter: MapValueIter<key, value>) -> Option<value> = "dew_map_value_iter_next_option"
builtin map_entry_iter_next_option<key, value>(iter: MapEntryIter<key, value>) -> Option<MapEntry<key, value>> = "dew_map_entry_iter_next_option"

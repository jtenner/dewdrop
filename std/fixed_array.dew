open dew.std.wasm.intrinsics

pub type FixedArray<t> = WasmArray<t>

impl<t> FixedArray<t> {
  fn make(length: U32, value: t) -> FixedArray<t> {
    wasm_array_new(length, value)
  }
  fn length(self) -> U32 {
    wasm_array_len(self)
  }
  fn get(self, index: U32) -> Option<t> {
    if index < wasm_array_len(self) {
      Option::Some(wasm_array_get(self, index))
    } else {
      Option::None
    }
  }
  fn get_unchecked(self, index: U32) -> t {
    wasm_array_get(self, index)
  }
  fn set(self, index: U32, value: t) -> Unit {
    wasm_array_set(self, index, value)
  }
  fn set_unchecked(self, index: U32, value: t) -> Unit {
    wasm_array_set(self, index, value)
  }
}

impl<t> IndexedGet<U32, t> for FixedArray<t> {
  fn indexed_get(self, index: U32) -> t {
    wasm_array_get(self, index)
  }
}

impl<t> IndexedSet<U32, t> for FixedArray<t> {
  fn indexed_set(self, index: U32, value: t) -> Unit {
    wasm_array_set(self, index, value)
  }
}

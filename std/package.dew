open dew.std.array
open dew.std.bytes
open dew.std.decode
open dew.std.encode
open dew.std.format
open dew.std.json
open dew.std.ordering
open dew.std.semver
open dew.std.string

pub enum PackageRequirement {
  Any
  Exact(SemVer)
  Caret(SemVer)
  Tilde(SemVer)
  Git(String)
}

pub struct PackageDependency {
  name: String
  requirement: PackageRequirement
}

pub struct PackageManifest {
  name: String
  version: SemVer
  dependencies: Array<PackageDependency>
}

pub struct LockedPackage {
  name: String
  version: SemVer
  source: String
  path: String
  integrity: String
  interface_fingerprint: String
}

pub struct PackageLock {
  packages: Array<LockedPackage>
}

pub struct ModuleManifestEntry {
  name: String
  files: Array<String>
}

pub struct ModuleManifest {
  root: String
  modules: Array<ModuleManifestEntry>
}

pub fn package_manifest_max_bytes() -> U32 {
  1048576u32
}

pub fn package_lock_max_bytes() -> U32 {
  8388608u32
}

pub fn module_manifest_max_bytes() -> U32 {
  4194304u32
}

pub fn package_max_dependencies() -> U32 {
  256u32
}

pub fn package_lock_max_packages() -> U32 {
  4096u32
}

pub fn module_manifest_max_modules() -> U32 {
  1024u32
}

pub fn module_manifest_max_files_per_module() -> U32 {
  4096u32
}

pub fn package_name_max_bytes() -> U32 {
  255u32
}

pub fn package_requirement_max_bytes() -> U32 {
  2048u32
}

pub fn package_path_max_bytes() -> U32 {
  4096u32
}

fn package_unit() -> Unit {
}

fn package_is_name_byte(byte: U8) -> Bool {
  (byte >= 97u8 && byte <= 122u8) ||
  (byte >= 48u8 && byte <= 57u8) ||
  byte == 45u8 || byte == 95u8 || byte == 46u8
}

pub fn package_name_is_valid(name: String) -> Bool {
  let length = name.byte_length()
  if length < 4u32 || length > package_name_max_bytes() || name.byte_at(0u32) != 64u8 {
    false
  } else {
    let mut slash = 4294967295u32
    let valid = while 1u32 {
      index if index < length => {
        let byte = name.byte_at(index)
        if byte == 47u8 {
          if slash != 4294967295u32 || index == 1u32 || index + 1u32 == length {
            break false
          } else {
            slash = index
            continue index + 1u32
          }
        } else if !package_is_name_byte(byte) {
          break false
        } else {
          continue index + 1u32
        }
      }
      _ => break true
    }
    valid && slash != 4294967295u32
  }
}

fn package_string_has_nul(value: String) -> Bool {
  while 0u32 {
    index if index < value.byte_length() => if value.byte_at(index) == 0u8 {
      break true
    } else {
      continue index + 1u32
    }
    _ => break false
  }
}

pub fn package_requirement_parse(value: String) -> Result<PackageRequirement, FormatValidationErr> {
  if value.byte_length() == 0u32 || value.byte_length() > package_requirement_max_bytes() {
    Result::Err(FormatValidationErr::InvalidField("dependency requirement"))
  } else if value.equals("*") {
    Result::Ok(PackageRequirement::Any)
  } else if value.starts_with("git+") {
    match value.find("#") {
      Option::Some(index) if index > 4u32 && index + 1u32 < value.byte_length() && !package_string_has_nul(value) =>
        Result::Ok(PackageRequirement::Git(value))
      _ => Result::Err(FormatValidationErr::InvalidField("Git dependency requirement"))
    }
  } else if value.byte_at(0u32) == 94u8 {
    match semver_parse(value.slice(1u32, value.byte_length())) {
      Result::Ok(version) => Result::Ok(PackageRequirement::Caret(version))
      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField("caret dependency requirement"))
    }
  } else if value.byte_at(0u32) == 126u8 {
    match semver_parse(value.slice(1u32, value.byte_length())) {
      Result::Ok(version) => Result::Ok(PackageRequirement::Tilde(version))
      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField("tilde dependency requirement"))
    }
  } else {
    match semver_parse(value) {
      Result::Ok(version) => Result::Ok(PackageRequirement::Exact(version))
      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField("exact dependency requirement"))
    }
  }
}

pub fn package_requirement_to_string(value: PackageRequirement) -> String {
  match value {
    PackageRequirement::Any => "*"
    PackageRequirement::Exact(version) => version.to_string()
    PackageRequirement::Caret(version) => "^".concat(version.to_string())
    PackageRequirement::Tilde(version) => "~".concat(version.to_string())
    PackageRequirement::Git(source) => source
  }
}

pub fn package_requirement_matches(requirement: PackageRequirement, version: SemVer) -> Bool {
  match requirement {
    PackageRequirement::Any => !version.is_prerelease()
    PackageRequirement::Exact(expected) => semver_same_precedence(expected, version)
    PackageRequirement::Caret(base) => semver_caret_matches(base, version)
    PackageRequirement::Tilde(base) => semver_tilde_matches(base, version)
    PackageRequirement::Git(_) => true
  }
}

pub fn package_dependency(name: String, requirement: PackageRequirement) -> PackageDependency {
  PackageDependency::{
    name: name
    requirement: requirement
  }
}

impl PackageDependency {
  fn name(self) -> String {
    self.name
  }
  fn requirement(self) -> PackageRequirement {
    self.requirement
  }
}


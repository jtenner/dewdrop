  name: String,
  version: SemVer,
  dependencies: Array<PackageDependency>,
) -> PackageManifest {
  PackageManifest::{
    name: name
    version: version
    dependencies: dependencies
  }
}

impl PackageManifest {
  fn name(self) -> String {
    self.name
  }
  fn version(self) -> SemVer {
    self.version
  }
  fn dependencies(self) -> Array<PackageDependency> {
    self.dependencies
  }
}


open dew.std.fixed_array
open dew.std.bytes
open dew.std.bytes_builder

pub enum IoError {
  UnexpectedEnd
  ZeroProgress
  InvalidProgress
  Closed
  LimitExceeded
  Backend(U32)
}

pub trait Reader {
  fn read(self, limit: U32) -> Result<Bytes, IoError>
}

pub trait Writer {
  fn write(self, value: Bytes) -> Result<U32, IoError>
}

pub fn io_read<r: Reader>(
  reader: r,
  limit: U32,
) -> Result<Bytes, IoError> {
  reader.read(limit)
}

pub fn io_write<w: Writer>(
  writer: w,
  value: Bytes,
) -> Result<U32, IoError> {
  writer.write(value)
}

pub fn io_read_exact<r: Reader>(
  reader: r,
  length: U32,
) -> Result<Bytes, IoError> {
  let builder = BytesBuilder::with_capacity(length)
  while 0u32 {
    total if total < length => {
      match reader.read(length - total) {
        Result::Ok(chunk) => {
          let count = chunk.byte_length()
          if count == 0u32 {
            break Result::Err(IoError::UnexpectedEnd)
          } else if count > length - total {
            break Result::Err(IoError::InvalidProgress)
          } else {
            builder.append(chunk)
            continue total + count
          }
        }
        Result::Err(error) => break Result::Err(error)
      }
    }
    _ => break Result::Ok(builder.finish())
  }
}

pub fn io_write_all<w: Writer>(
  writer: w,
  value: Bytes,
) -> Result<U32, IoError> {
  let length = value.byte_length()
  while 0u32 {
    total if total < length => {
      let remaining = value.view(total, length - total)
      match writer.write(remaining) {
        Result::Ok(written) => {
          if written == 0u32 {
            break Result::Err(IoError::ZeroProgress)
          } else if written > length - total {
            break Result::Err(IoError::InvalidProgress)
          } else {
            continue total + written
          }
        }
        Result::Err(error) => break Result::Err(error)
      }
    }
    _ => break Result::Ok(length)
  }
}

pub fn io_read_to_end<r: Reader>(
  reader: r,
  chunk_limit: U32,
  max_bytes: U32,
) -> Result<Bytes, IoError> {
  if chunk_limit == 0u32 {
    Result::Err(IoError::ZeroProgress)
  } else {
    let builder = BytesBuilder::new()
    while 0u32 {
      total => {
        match reader.read(chunk_limit) {
          Result::Ok(chunk) => {
            let count = chunk.byte_length()
            if count == 0u32 {
              break Result::Ok(builder.finish())
            } else if count > chunk_limit {
              break Result::Err(IoError::InvalidProgress)
            } else if total > max_bytes || count > max_bytes - total {
              break Result::Err(IoError::LimitExceeded)
            } else {
              builder.append(chunk)
              continue total + count
            }
          }
          Result::Err(error) => break Result::Err(error)
        }
      }
    }
  }
}

pub fn io_copy<r: Reader, w: Writer>(
  reader: r,
  writer: w,
  chunk_limit: U32,
) -> Result<U32, IoError> {
  if chunk_limit == 0u32 {
    Result::Err(IoError::ZeroProgress)
  } else {
    while 0u32 {
      total => {
        match reader.read(chunk_limit) {
          Result::Ok(chunk) => {
            let count = chunk.byte_length()
            if count == 0u32 {
              break Result::Ok(total)
            } else if count > chunk_limit {
              break Result::Err(IoError::InvalidProgress)
            } else if count > 4294967295u32 - total {
              break Result::Err(IoError::LimitExceeded)
            } else {
              match io_write_all(writer, chunk) {
                Result::Ok(written) => {
                  if written == count {
                    continue total + count
                  } else {
                    break Result::Err(IoError::InvalidProgress)
                  }
                }
                Result::Err(error) => break Result::Err(error)
              }
            }
          }
          Result::Err(error) => break Result::Err(error)
        }
      }
    }
  }
}

pub struct BytesInput {
  value: Bytes
  offset: FixedArray<U32>
}

impl BytesInput {
  fn new(value: Bytes) -> BytesInput {
    BytesInput::{
      value: value
      offset: FixedArray::make(1u32, 0u32)
    }
  }
  fn remaining(self) -> U32 {
    let offset = self.offset.get_unchecked(0u32)
    let length = self.value.byte_length()
    if offset > length {
      0u32
    } else {
      length - offset
    }
  }
  fn is_empty(self) -> Bool {
    self.remaining() == 0u32
  }
}

impl Reader for BytesInput {
  fn read(self, limit: U32) -> Result<Bytes, IoError> {
    let offset = self.offset.get_unchecked(0u32)
    let length = self.value.byte_length()
    if offset > length {
      Result::Err(IoError::InvalidProgress)
    } else if limit == 0u32 || offset == length {
      Result::Ok(b"")
    } else {
      let available = length - offset
      let count = if limit < available {
        limit
      } else {
        available
      }
      self.offset.set_unchecked(0u32, offset + count)
      Result::Ok(self.value.view(offset, count))
    }
  }
}

pub struct BytesOutput {
  builder: BytesBuilder
  state: FixedArray<U32>
}

impl BytesOutput {
  fn new() -> BytesOutput {
    BytesOutput::with_capacity(0u32)
  }
  fn with_capacity(capacity: U32) -> BytesOutput {
    BytesOutput::{
      builder: BytesBuilder::with_capacity(capacity)
      state: FixedArray::make(2u32, 0u32)
    }
  }
  fn byte_length(self) -> U32 {
    self.state.get_unchecked(1u32)
  }
  fn is_closed(self) -> Bool {
    self.state.get_unchecked(0u32) != 0u32
  }
  fn finish(self) -> Result<Bytes, IoError> {
    if self.is_closed() {
      Result::Err(IoError::Closed)
    } else {
      self.state.set_unchecked(0u32, 1u32)
      Result::Ok(self.builder.finish())
    }
  }
}

impl Writer for BytesOutput {
  fn write(self, value: Bytes) -> Result<U32, IoError> {
    if self.is_closed() {
      Result::Err(IoError::Closed)
    } else {
      let added = value.byte_length()
      let length = self.byte_length()
      if added > 4294967295u32 - length {
        Result::Err(IoError::LimitExceeded)
      } else {
        self.builder.append(value)
        self.state.set_unchecked(1u32, length + added)
        Result::Ok(added)
      }
    }
  }
}

// State slots: chunk offset, EOF, backend reads, record bytes copied.
pub struct BufferedReader<r> {
  reader: r
  chunk_limit: U32
  max_buffer: U32
  chunk: FixedArray<Bytes>
  state: FixedArray<U32>
}

pub fn buffered_reader_new<r: Reader>(
  reader: r,
  chunk_limit: U32,
  max_buffer: U32,
) -> BufferedReader<r> {
  BufferedReader::{
    reader: reader
    chunk_limit: chunk_limit
    max_buffer: max_buffer
    chunk: FixedArray::make(1u32, b"")
    state: FixedArray::make(4u32, 0u32)
  }
}

impl<r: Reader> BufferedReader<r> {
  fn read_count(self) -> U32 {
    self.state.get_unchecked(2u32)
  }
  fn copied_bytes(self) -> U32 {
    self.state.get_unchecked(3u32)
  }
  fn buffered_bytes(self) -> U32 {
    self.chunk.get_unchecked(0u32).byte_length() - self.state.get_unchecked(0u32)
  }
  fn consume(self, offset: U32) -> Unit {
    if offset == self.chunk.get_unchecked(0u32).byte_length() {
      self.chunk.set_unchecked(0u32, b"")
      self.state.set_unchecked(0u32, 0u32)
    } else {
      self.state.set_unchecked(0u32, offset)
    }
  }
  fn read_until(self, delimiter: Bytes, max_bytes: U32) -> Result<Option<Bytes>, IoError> {
    let delimiter_length = delimiter.byte_length()
    if self.chunk_limit == 0u32 || delimiter_length == 0u32 {
      Result::Err(IoError::ZeroProgress)
    } else if max_bytes == 0u32 || self.max_buffer == 0u32 || delimiter_length > max_bytes || delimiter_length > self.max_buffer {
      Result::Err(IoError::LimitExceeded)
    } else {
      let prefix = io_delimiter_prefix(delimiter)
      let builder = BytesBuilder::new()
      while 0u32 {
        matched => {
          let total = builder.byte_length()
          let chunk = self.chunk.get_unchecked(0u32)
          let offset = self.state.get_unchecked(0u32)
          if offset < chunk.byte_length() {
            if total >= max_bytes {
              break Result::Err(IoError::LimitExceeded)
            } else {
              let byte = chunk.byte_at(offset)
              let next = while matched {
                candidate => {
                  if candidate > 0u32 && delimiter.byte_at(candidate) != byte {
                    continue prefix.get_unchecked(candidate - 1u32)
                  } else if delimiter.byte_at(candidate) == byte {
                    break candidate + 1u32
                  } else {
                    break 0u32
                  }
                }
              }
              builder.append_byte(byte)
              self.state.set_unchecked(3u32, self.copied_bytes() + 1u32)
              self.consume(offset + 1u32)
              if next == delimiter_length {
                break Result::Ok(Option::Some(builder.finish()))
              } else {
                continue next
              }
            }
          } else if self.state.get_unchecked(1u32) != 0u32 {
            if total == 0u32 {
              break Result::Ok(Option::None)
            } else {
              break Result::Ok(Option::Some(builder.finish()))
            }
          } else if total >= self.max_buffer {
            break Result::Err(IoError::LimitExceeded)
          } else {
            let budget = self.max_buffer - total
            let limit = if self.chunk_limit < budget {
              self.chunk_limit
            } else {
              budget
            }
            self.state.set_unchecked(2u32, self.read_count() + 1u32)
            match self.reader.read(limit) {
              Result::Err(error) => break Result::Err(error)
              Result::Ok(next) => {
                if next.byte_length() > limit {
                  break Result::Err(IoError::InvalidProgress)
                } else {
                  self.chunk.set_unchecked(0u32, next)
                  self.state.set_unchecked(0u32, 0u32)
                  if next.byte_length() == 0u32 {
                    self.state.set_unchecked(1u32, 1u32)
                  }
                  continue matched
                }
              }
            }
          }
        }
      }
    }
  }
  fn read_line(self, max_bytes: U32) -> Result<Option<Bytes>, IoError> {
    match self.read_until(b"\n", max_bytes) {
      Result::Ok(Option::Some(value)) => {
        let length = value.byte_length()
        if length > 0u32 && value.byte_at(length - 1u32) == 10u8 {
          Result::Ok(Option::Some(value.view(0u32, length - 1u32)))
        } else {
          Result::Ok(Option::Some(value))
        }
      }
      Result::Ok(Option::None) => Result::Ok(Option::None)
      Result::Err(error) => Result::Err(error)
    }
  }
}

impl<r: Reader> Reader for BufferedReader<r> {
  fn read(self, limit: U32) -> Result<Bytes, IoError> {
    if limit == 0u32 {
      Result::Ok(b"")
    } else if self.buffered_bytes() > 0u32 {
      let chunk = self.chunk.get_unchecked(0u32)
      let offset = self.state.get_unchecked(0u32)
      let remaining = chunk.byte_length() - offset
      let count = if limit < remaining {
        limit
      } else {
        remaining
      }
      self.consume(offset + count)
      Result::Ok(chunk.view(offset, count))
    } else if self.state.get_unchecked(1u32) != 0u32 {
      Result::Ok(b"")
    } else if self.chunk_limit == 0u32 {
      Result::Err(IoError::ZeroProgress)
    } else if self.max_buffer == 0u32 {
      Result::Err(IoError::LimitExceeded)
    } else {
      let requested = if self.chunk_limit < self.max_buffer {
        self.chunk_limit
      } else {
        self.max_buffer
      }
      self.state.set_unchecked(2u32, self.read_count() + 1u32)
      match self.reader.read(requested) {
        Result::Err(error) => Result::Err(error)
        Result::Ok(chunk) => {
          let length = chunk.byte_length()
          if length > requested {
            Result::Err(IoError::InvalidProgress)
          } else {
            let count = if limit < length {
              limit
            } else {
              length
            }
            self.chunk.set_unchecked(0u32, chunk)
            self.consume(count)
            if length == 0u32 {
              self.state.set_unchecked(1u32, 1u32)
            }
            Result::Ok(chunk.view(0u32, count))
          }
        }
      }
    }
  }
}


fn io_delimiter_prefix(delimiter: Bytes) -> FixedArray<U32> {
  let prefix = FixedArray::make(delimiter.byte_length(), 0u32)
  while 1u32 {
    index if index < delimiter.byte_length() => {
      let byte = delimiter.byte_at(index)
      let matched = while prefix.get_unchecked(index - 1u32) {
        candidate => {
          if candidate > 0u32 && delimiter.byte_at(candidate) != byte {
            continue prefix.get_unchecked(candidate - 1u32)
          } else if delimiter.byte_at(candidate) == byte {
            break candidate + 1u32
          } else {
            break 0u32
          }
        }
      }
      prefix.set_unchecked(index, matched)
      continue index + 1u32
    }
    _ => break ()
  }
  prefix
}

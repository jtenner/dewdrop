  } else if left == 0.0f64 && right == 0.0f64 {
    if f64_is_sign_negative(left) {
      right
    } else {
      left
    }
  } else {
    left
  }
}

pub fn f64_clamp(value: F64, lower: F64, upper: F64) -> F64 {
  if f64_is_nan(lower) || f64_is_nan(upper) || lower > upper {
    unreachable()
  } else if f64_is_nan(value) {
    value
  } else if value < lower {
    lower
  } else if value > upper {
    upper
  } else {
    value
  }
}

impl<t: Lt> Array<t> {
  fn sort(self) -> Unit {
    let length = array_length(self)
    if length < 2u32 {
    } else {
      let scratch = array_copy_raw(self)
      let mut width = 1u32
      let mut read_self = true
      while true {
        true if width < length => {
          if read_self {
            array_merge_pass_natural(self, scratch, width, length)
          } else {
            array_merge_pass_natural(scratch, self, width, length)
          }
          read_self = !read_self
          if width > length / 2u32 {
            width = length
          } else {
            width = width * 2u32
          }
          continue true
        }
        _ => break array_unit()
      }
      if !read_self {
        while 0u32 {
          index if index < length => {
            let value = array_get_unchecked(scratch, index)
            array_set_unchecked(self, index, value)
            continue index + 1u32
          }
          _ => break array_unit()
        }
      } else {
      }
    }
  }
  fn to_sorted(self) -> Array<t> {
    let output = array_copy_raw(self)
    output.sort()
    output
  }
}

impl<t: Eq> Array<t> {
  fn includes(self, value: t) -> Bool {
    self.index_of(value) is Option::Some(_)
  }
  fn index_of(self, value: t) -> Option<U32> {
    self.index_of_from(value, 0u32)
  }
  fn index_of_from(self, value: t, start: U32) -> Option<U32> {
    let length = array_length(self)
    if start > length {
      Option::None
    } else {
      while start {
        index if index < length => {
          if array_get_unchecked(self, index) == value {
            break Option::Some(index)
          } else {
            continue index + 1u32
          }
        }
        _ => break Option::None
      }
    }
  }
  fn last_index_of(self, value: t) -> Option<U32> {
    self.last_index_of_before(value, array_length(self))
  }
  fn last_index_of_before(self, value: t, end: U32) -> Option<U32> {
    let length = array_length(self)
    if end > length {
      Option::None
    } else {
      while end {
        0u32 => break Option::None
        remaining => {
          let index = remaining - 1u32
          if array_get_unchecked(self, index) == value {
            break Option::Some(index)
          } else {
            continue index
          }
        }
      }
    }
  }
  fn equals(self, other: Array<t>) -> Bool {
    let length = array_length(self)
    if length != array_length(other) {
      false
    } else {
      while 0u32 {
        index if index < length => {
          if array_get_unchecked(self, index) == array_get_unchecked(other, index) {
            continue index + 1u32
          } else {
            break false
          }
        }
        _ => break true
      }
    }
  }
}

impl<t: Eq> Eq for Array<t> {
  fn eq(self, right: Array<t>) -> Bool {
    self.equals(right)
  }
}

impl<t: Eq> Ne for Array<t> {
  fn ne(self, right: Array<t>) -> Bool {
    !self.equals(right)
  }
}

impl<t> Array<Array<t>> {
  fn flat(self) -> Array<t> {
    let output = Array::new()
    let length = array_length(self)
    while 0u32 {
      index if index < length => {
        array_extend_values(output, array_get_unchecked(self, index))
        continue index + 1u32
      }
      _ => break output
    }
  }
}

impl<t> ArrayEntry<t> {
  fn index(self) -> U32 {
    self.index
  }
  fn value(self) -> t {
    self.value
  }
}

impl<t> Iter<U32> for ArrayKeyIter<t> {
  fn next(self) -> Option<U32> {
    if self.index >= array_length(self.values) {
      Option::None
    } else {
      let index = self.index
      self.index = index + 1u32
      Option::Some(index)
    }
  }
}

impl<t> Iter<ArrayEntry<t>> for ArrayEntryIter<t> {
  fn next(self) -> Option<ArrayEntry<t>> {
    if self.index >= array_length(self.values) {
      Option::None
    } else {
      let index = self.index
      let value = array_get_unchecked(self.values, index)
      self.index = index + 1u32
      Option::Some(ArrayEntry::{
        index: index
        value: value
      })
    }
  }
}

fn arena_index_to_id(index: U32) -> I32 {
  if index > 2147483647u32 {
    unreachable()
  } else {
    index.into()
  }
}

fn arena_id_to_index(id: I32) -> U32 {
  if id < 0i32 {
    unreachable()
  } else {
    id.into()
  }
}

pub fn arena_missing_id() -> I32 {
  -1i32
}

pub struct ArenaSpan {
  start: I32
  length: I32
}

impl ArenaSpan {
  fn end(self) -> I32 {
    self.start + self.length
  }
  fn is_empty(self) -> Bool {
    self.length == 0i32
  }
  fn contains(self, id: I32) -> Bool {
    id >= self.start && id < self.end()
  }
}

pub struct Arena<t> {
  values: Array<t>
}

impl<t> Arena<t> {
  fn new() -> Arena<t> {
    Arena::{
      values: Array::new()
    }
  }
  fn with_capacity(capacity: I32) -> Arena<t> {
    Arena::{
      values: Array::with_capacity(arena_id_to_index(capacity))
    }
  }
  fn make(length: I32, value: t) -> Arena<t> {
    Arena::{
      values: Array::make(arena_id_to_index(length), value)
    }
  }
  fn length(self) -> I32 {
    arena_index_to_id(self.values.length())
  }
  fn is_empty(self) -> Bool {
    self.values.is_empty()
  }
  fn push(self, value: t) -> I32 {
    let id = arena_index_to_id(self.values.length())
    self.values.push(value)
    id
  }
  fn pop(self) -> Option<t> {
    self.values.pop()
  }
  fn get(self, id: I32) -> Option<t> {
    if id == -1i32 {
      Option::None
    } else {
      self.values.get(arena_id_to_index(id))
    }
  }
  fn get_unchecked(self, id: I32) -> t {
    self.values.get_unchecked(arena_id_to_index(id))
  }
  fn set(self, id: I32, value: t) -> Bool {
    if id == -1i32 {
      false
    } else {
      self.values.set(arena_id_to_index(id), value)
    }
  }
  fn set_unchecked(self, id: I32, value: t) -> Unit {
    self.values.set_unchecked(arena_id_to_index(id), value)
  }
  fn checkpoint(self) -> I32 {
    self.length()
  }
  fn truncate(self, length: I32) -> Unit {
    self.values.truncate(arena_id_to_index(length))
  }
  fn rollback(self, checkpoint: I32) -> Unit {
    self.truncate(checkpoint)
  }
  fn clear(self) -> Unit {
    self.values.clear()
  }
  fn reserve(self, additional: I32) -> Unit {
    self.values.reserve(arena_id_to_index(additional))
  }
  fn copy(self) -> Arena<t> {
    Arena::{
      values: self.values.copy()
    }
  }
  fn fill(self, value: t, start: I32, end: I32) -> Unit {
    self.values.fill(value, arena_id_to_index(start), arena_id_to_index(end))
  }
  fn span(self, start: I32, length: I32) -> ArenaSpan {
    let start_index = arena_id_to_index(start)
    let span_length = arena_id_to_index(length)
    let total = self.values.length()
    if start_index > total || span_length > total - start_index {
      unreachable()
    } else {
      ArenaSpan::{
        start: start
        length: length
      }
    }
  }
  fn span_from(self, start: I32) -> ArenaSpan {
    let start_index = arena_id_to_index(start)
    let total = self.values.length()
    if start_index > total {
      unreachable()
    } else {
      ArenaSpan::{
        start: start
        length: arena_index_to_id(total - start_index)
      }
    }
  }
  fn slice(self, span: ArenaSpan) -> Array<t> {
    let start = arena_id_to_index(span.start)
    let length = arena_id_to_index(span.length)
    let total = self.values.length()
    if start > total || length > total - start {
      unreachable()
    } else {
      self.values.slice(start, start + length)
    }
  }
  fn raw_values(self) -> Array<t> {
    self.values
  }
}

builtin array_iter_next_option<t>(value: ArrayIter<t>) -> Option<t> = "dew_array_iter_next_option"

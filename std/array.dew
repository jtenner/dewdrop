  fn reduce(self, initial: t, reducer: fn(t, t) -> t) -> t {
    let limit = array_length(self)
    let mut state_value = initial
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          state_value = reducer(state_value, array_get_unchecked(self, index))
        } else {

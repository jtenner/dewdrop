pub struct Array<t> {}
pub struct ArrayIter<t> {}

pub builtin array_new<t>() -> Array<t> = "dew_array_new"
pub builtin array_with_capacity<t>(capacity: U32) -> Array<t> = "dew_array_with_capacity"
pub builtin array_length<t>(value: Array<t>) -> U32 = "dew_array_length"
pub builtin array_capacity<t>(value: Array<t>) -> U32 = "dew_array_capacity"
pub builtin array_get<t>(value: Array<t>, index: U32) -> Option<t> = "dew_array_get"
pub builtin array_get_unchecked<t>(value: Array<t>, index: U32) -> t = "dew_array_get_unchecked"
pub builtin array_set<t>(value: Array<t>, index: U32, item: t) -> Bool = "dew_array_set"
pub builtin array_set_unchecked<t>(value: Array<t>, index: U32, item: t) -> Unit = "dew_array_set_unchecked"
pub builtin array_push<t>(value: Array<t>, item: t) -> Unit = "dew_array_push"
pub builtin array_pop<t>(value: Array<t>) -> Option<t> = "dew_array_pop"
pub builtin array_clear<t>(value: Array<t>) -> Unit = "dew_array_clear"
pub builtin array_iter<t>(value: Array<t>) -> ArrayIter<t> = "dew_array_iter"
pub builtin array_iter_has_next<t>(value: ArrayIter<t>) -> Bool = "dew_array_iter_has_next"
pub builtin array_iter_next<t>(value: ArrayIter<t>) -> t = "dew_array_iter_next"

impl<t> Array<t> {
  fn new() -> Array<t> {
    array_new()
  }
  fn with_capacity(capacity: U32) -> Array<t> {
    array_with_capacity(capacity)
  }
  fn length(self) -> U32 {
    array_length(self)
  }
  fn capacity(self) -> U32 {
    array_capacity(self)
  }
  fn is_empty(self) -> Bool {
    array_length(self) == 0u32
  }
  fn push(self, value: t) -> Unit {
    array_push(self, value)
  }
  fn pop(self) -> Option<t> {
    array_pop(self)
  }
  fn get(self, index: U32) -> Option<t> {
    array_get(self, index)
  }
  fn get_unchecked(self, index: U32) -> t {
    array_get_unchecked(self, index)
  }
  fn set(self, index: U32, value: t) -> Bool {
    array_set(self, index, value)
  }
  fn set_unchecked(self, index: U32, value: t) -> Unit {
    array_set_unchecked(self, index, value)
  }
  fn clear(self) -> Unit {
    array_clear(self)
  }
  fn iter(self) -> ArrayIter<t> {
    array_iter(self)
  }
}

impl<t> IndexedGet<U32, t> for Array<t> {
  fn indexed_get(self, index: U32) -> t {
    array_get_unchecked(self, index)
  }
}

impl<t> IndexedSet<U32, t> for Array<t> {
  fn indexed_set(self, index: U32, value: t) -> Unit {
    array_set_unchecked(self, index, value)
  }
}

impl<t> Iter<t> for ArrayIter<t> {
  fn next(self) -> Option<t> {
    array_iter_next_option(self)
  }
}

builtin array_make_raw<t>(length: U32, value: t) -> Array<t> = "dew_array_make"
builtin array_reserve_raw<t>(value: Array<t>, additional: U32) -> Unit = "dew_array_reserve"
builtin array_shrink_to_fit_raw<t>(value: Array<t>) -> Unit = "dew_array_shrink_to_fit"
builtin array_truncate_raw<t>(value: Array<t>, length: U32) -> Unit = "dew_array_truncate"
builtin array_copy_raw<t>(value: Array<t>) -> Array<t> = "dew_array_copy"
builtin array_copy_within_raw<t>(value: Array<t>, target: U32, start: U32, end: U32) -> Unit = "dew_array_copy_within"
builtin array_fill_raw<t>(value: Array<t>, item: t, start: U32, end: U32) -> Unit = "dew_array_fill"
builtin array_slice_raw<t>(value: Array<t>, start: U32, end: U32) -> Array<t> = "dew_array_slice"
builtin array_extend_raw<t>(value: Array<t>, source: Array<t>) -> Unit = "dew_array_extend"

pub trait ArrayComparator<t> {
  fn before(self, left: t, right: t) -> Bool
}

pub struct NaturalArrayComparator {}

pub fn natural_array_comparator() -> NaturalArrayComparator {
  NaturalArrayComparator::{
  }
}

impl<t: Lt> ArrayComparator<t> for NaturalArrayComparator {
  fn before(self, left: t, right: t) -> Bool {
    left < right
  }
}

pub struct ArrayEntry<t> {
  index: U32
  value: t
}

pub struct ArrayKeyIter<t> {
  values: Array<t>
  mut index: U32
}

pub struct ArrayEntryIter<t> {
  values: Array<t>
  mut index: U32
}

fn array_unit() -> Unit {}

fn array_min(left: U32, right: U32) -> U32 {
  if left < right {
    left
  } else {
    right
  }
}

fn array_require_range(length: U32, start: U32, end: U32) -> Unit {
  if start > end || end > length {
    unreachable()
  } else {
  }
}

fn array_extend_values<t>(value: Array<t>, source: Array<t>) -> Unit {
  array_extend_raw(value, source)
}

fn array_at_index(length: U32, index: I32) -> Option<U32> {
  let wide_length = u32_into_i64(length)
  let wide_index = i32_into_i64(index)
  let resolved = if wide_index < 0i64 {
    wide_length + wide_index
  } else {
    wide_index
  }
  if resolved < 0i64 || resolved >= wide_length {
    Option::None
  } else {
    Option::Some(i64_into_u32(resolved))
  }
}

fn array_merge_pass_natural<t: Lt>(
  source: Array<t>,
  target: Array<t>,
  width: U32,
  length: U32,
) -> Unit {
  while 0u32 {
    left if left < length => {
      let middle = if width > length - left {
        length
      } else {
        left + width
      }
      let end = if width > length - middle {
        length
      } else {
        middle + width
      }
      let mut first = left
      let mut second = middle
      let mut output = left
      while true {
        true if first < middle && second < end => {
          let left_value = array_get_unchecked(source, first)
          let right_value = array_get_unchecked(source, second)
          if right_value < left_value {
            array_set_unchecked(target, output, right_value)
            second = second + 1u32
          } else {
            array_set_unchecked(target, output, left_value)
            first = first + 1u32
          }
          output = output + 1u32
          continue true
        }
        _ => break array_unit()
      }
      while first {
        index if index < middle => {
          let value = array_get_unchecked(source, index)
          array_set_unchecked(target, output, value)
          output = output + 1u32
          continue index + 1u32
        }
        _ => break array_unit()
      }
      while second {
        index if index < end => {
          let value = array_get_unchecked(source, index)
          array_set_unchecked(target, output, value)
          output = output + 1u32
          continue index + 1u32
        }
        _ => break array_unit()
      }
      continue end
    }
    _ => break array_unit()
  }
}

fn array_merge_pass<t, c: ArrayComparator<t>>(
  source: Array<t>,
  target: Array<t>,
  width: U32,
  length: U32,
  comparator: c,
) -> Unit {
  while 0u32 {
    left if left < length => {
      let middle = if width > length - left {
        length
      } else {
        left + width
      }
      let end = if width > length - middle {
        length
      } else {
        middle + width
      }
      let mut first = left
      let mut second = middle
      let mut output = left
      while true {
        true if first < middle && second < end => {
          let left_value = array_get_unchecked(source, first)
          let right_value = array_get_unchecked(source, second)
          if comparator.before(right_value, left_value) {
            array_set_unchecked(target, output, right_value)
            second = second + 1u32
          } else {
            array_set_unchecked(target, output, left_value)
            first = first + 1u32
          }
          output = output + 1u32
          continue true
        }
        _ => break array_unit()
      }
      while first {
        index if index < middle => {
          let value = array_get_unchecked(source, index)
          array_set_unchecked(target, output, value)
          output = output + 1u32
          continue index + 1u32
        }
        _ => break array_unit()
      }
      while second {
        index if index < end => {
          let value = array_get_unchecked(source, index)
          array_set_unchecked(target, output, value)
          output = output + 1u32
          continue index + 1u32
        }
        _ => break array_unit()
      }
      continue end
    }
    _ => break array_unit()
  }
}

pub fn array_map_to<t, u>(values: Array<t>, mapper: fn(t) -> u) -> Array<u> {
  let limit = array_length(values)
  let output = Array::with_capacity(limit)
  while 0u32 {
    index if index < limit => {
      if index < array_length(values) {
        array_push(output, mapper(array_get_unchecked(values, index)))
      } else {
      }
      continue index + 1u32
    }
    _ => break output
  }
}

pub fn array_map_to_indexed<t, u>(
  values: Array<t>,
  mapper: fn(t, U32) -> u,
) -> Array<u> {
  let limit = array_length(values)
  let output = Array::with_capacity(limit)
  while 0u32 {
    index if index < limit => {
      if index < array_length(values) {
        array_push(output, mapper(array_get_unchecked(values, index), index))
      } else {
      }
      continue index + 1u32
    }
    _ => break output
  }
}

pub fn array_flat_map_to<t, u>(
  values: Array<t>,
  mapper: fn(t) -> Array<u>,
) -> Array<u> {
  let limit = array_length(values)
  let output = Array::new()
  while 0u32 {
    index if index < limit => {
      if index < array_length(values) {
        array_extend_values(output, mapper(array_get_unchecked(values, index)))
      } else {
      }
      continue index + 1u32
    }
    _ => break output
  }
}

pub fn array_reduce_into<t, state>(
  values: Array<t>,
  initial: state,
  reducer: fn(state, t) -> state,
) -> state {
  let limit = array_length(values)
  let mut state_value = initial
  while 0u32 {
    index if index < limit => {
      if index < array_length(values) {
        state_value = reducer(
          state_value,
          array_get_unchecked(values, index),
        )
      } else {
      }
      continue index + 1u32
    }
    _ => break state_value
  }
}

pub fn array_reduce_right_into<t, state>(
  values: Array<t>,
  initial: state,
  reducer: fn(state, t) -> state,
) -> state {
  let mut state_value = initial
  while array_length(values) {
    0u32 => break state_value
    remaining => {
      let index = remaining - 1u32
      if index < array_length(values) {
        state_value = reducer(
          state_value,
          array_get_unchecked(values, index),
        )
      } else {
      }
      continue index
    }
  }
}

pub fn array_sort_by<t, c: ArrayComparator<t>>(
  values: Array<t>,
  comparator: c,
) -> Unit {
  let length = array_length(values)
  if length < 2u32 {
  } else {
    let scratch = array_copy_raw(values)
    let mut width = 1u32
    let mut read_values = true
    while true {
      true if width < length => {
        if read_values {
          array_merge_pass(values, scratch, width, length, comparator)
        } else {
          array_merge_pass(scratch, values, width, length, comparator)
        }
        read_values = !read_values
        if width > length / 2u32 {
          width = length
        } else {
          width = width * 2u32
        }
        continue true
      }
      _ => break array_unit()
    }
    if !read_values {
      while 0u32 {
        index if index < length => {
          let value = array_get_unchecked(scratch, index)
          array_set_unchecked(values, index, value)
          continue index + 1u32
        }
        _ => break array_unit()
      }
    } else {
    }
  }
}

pub fn array_to_sorted_by<t, c: ArrayComparator<t>>(
  values: Array<t>,
  comparator: c,
) -> Array<t> {
  let output = array_copy_raw(values)
  array_sort_by(output, comparator)
  output
}

impl<t> Array<t> {
  fn make(length: U32, value: t) -> Array<t> {
    array_make_raw(length, value)
  }
  fn reserve(self, additional: U32) -> Unit {
    array_reserve_raw(self, additional)
  }
  fn shrink_to_fit(self) -> Unit {
    array_shrink_to_fit_raw(self)
  }
  fn truncate(self, length: U32) -> Unit {
    array_truncate_raw(self, length)
  }
  fn copy(self) -> Array<t> {
    array_copy_raw(self)
  }
  fn clone(self) -> Array<t> {
    array_copy_raw(self)
  }
  fn extend(self, source: Array<t>) -> Unit {
    array_extend_values(self, source)
  }
  fn push_all(self, source: Array<t>) -> Unit {
    array_extend_values(self, source)
  }
  fn first(self) -> Option<t> {
    array_get(self, 0u32)
  }
  fn last(self) -> Option<t> {
    let length = array_length(self)
    if length == 0u32 {
      Option::None
    } else {
      array_get(self, length - 1u32)
    }
  }
  fn at(self, index: I32) -> Option<t> {
    match array_at_index(array_length(self), index) {
      Option::Some(resolved) => array_get(self, resolved)
      Option::None => Option::None
    }
  }
  fn swap(self, left: U32, right: U32) -> Unit {
    let length = array_length(self)
    if left >= length || right >= length {
      unreachable()
    } else if left == right {
    } else {
      let left_value = array_get_unchecked(self, left)
      let right_value = array_get_unchecked(self, right)
      array_set_unchecked(self, left, right_value)
      array_set_unchecked(self, right, left_value)
    }
  }
  fn shift(self) -> Option<t> {
    let length = array_length(self)
    if length == 0u32 {
      Option::None
    } else {
      let value = array_get_unchecked(self, 0u32)
      if length > 1u32 {
        array_copy_within_raw(self, 0u32, 1u32, length)
      } else {
      }
      array_truncate_raw(self, length - 1u32)
      Option::Some(value)
    }
  }
  fn unshift(self, value: t) -> Unit {
    let length = array_length(self)
    array_reserve_raw(self, 1u32)
    array_push(self, value)
    if length > 0u32 {
      array_copy_within_raw(self, 1u32, 0u32, length)
      array_set_unchecked(self, 0u32, value)
    } else {
    }
  }
  fn insert(self, index: U32, value: t) -> Bool {
    let length = array_length(self)
    if index > length {
      false
    } else {
      array_reserve_raw(self, 1u32)
      array_push(self, value)
      if index < length {
        array_copy_within_raw(self, index + 1u32, index, length)
        array_set_unchecked(self, index, value)
      } else {
      }
      true
    }
  }
  fn remove(self, index: U32) -> Option<t> {
    let length = array_length(self)
    if index >= length {
      Option::None
    } else {
      let value = array_get_unchecked(self, index)
      if index + 1u32 < length {
        array_copy_within_raw(self, index, index + 1u32, length)
      } else {
      }
      array_truncate_raw(self, length - 1u32)
      Option::Some(value)
    }
  }
  fn fill(self, value: t, start: U32, end: U32) -> Unit {
    array_require_range(array_length(self), start, end)
    array_fill_raw(self, value, start, end)
  }
  fn copy_within(self, target: U32, start: U32, end: U32) -> Unit {
    let length = array_length(self)
    array_require_range(length, start, end)
    let count = end - start
    if target > length || count > length - target {
      unreachable()
    } else {
      array_copy_within_raw(self, target, start, end)
    }
  }
  fn slice(self, start: U32, end: U32) -> Array<t> {
    array_require_range(array_length(self), start, end)
    array_slice_raw(self, start, end)
  }
  fn concat(self, other: Array<t>) -> Array<t> {
    let output = array_copy_raw(self)
    array_extend_values(output, other)
    output
  }
  fn reverse(self) -> Unit {
    let length = array_length(self)
    if length > 1u32 {
      let mut left = 0u32
      let mut right = length - 1u32
      while true {
        true if left < right => {
          let left_value = array_get_unchecked(self, left)
          let right_value = array_get_unchecked(self, right)
          array_set_unchecked(self, left, right_value)
          array_set_unchecked(self, right, left_value)
          left = left + 1u32
          right = right - 1u32
          continue true
        }
        _ => break array_unit()
      }
    } else {
    }
  }
  fn to_reversed(self) -> Array<t> {
    let output = array_copy_raw(self)
    output.reverse()
    output
  }
  fn splice(self, start: U32, delete_count: U32, items: Array<t>) -> Array<t> {
    let length = array_length(self)
    if start > length {
      unreachable()
    } else {
    }
    let deleted = array_min(delete_count, length - start)
    let removed = array_slice_raw(self, start, start + deleted)
    let additions = array_copy_raw(items)
    let added = array_length(additions)
    let tail = start + deleted
    if added > deleted {
      let extra = added - deleted
      array_reserve_raw(self, extra)
      while 0u32 {
        index if index < extra => {
          let value = array_get_unchecked(additions, index)
          array_push(self, value)
          continue index + 1u32
        }
        _ => break array_unit()
      }
      if tail < length {
        array_copy_within_raw(self, start + added, tail, length)
      } else {
      }
    } else if added < deleted {
      if tail < length {
        array_copy_within_raw(self, start + added, tail, length)
      } else {
      }
      array_truncate_raw(self, length - (deleted - added))
    } else {
    }
    while 0u32 {
      index if index < added => {
        let value = array_get_unchecked(additions, index)
        array_set_unchecked(self, start + index, value)
        continue index + 1u32
      }
      _ => break array_unit()
    }
    removed
  }
  fn to_spliced(self, start: U32, delete_count: U32, items: Array<t>) -> Array<t> {
    let output = array_copy_raw(self)
    output.splice(start, delete_count, items)
    output
  }
  fn keys(self) -> ArrayKeyIter<t> {
    ArrayKeyIter::{
      values: self
      index: 0u32
    }
  }
  fn entries(self) -> ArrayEntryIter<t> {
    ArrayEntryIter::{
      values: self
      index: 0u32
    }
  }
  fn for_each(self, action: fn(t) -> Unit) -> Unit {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          action(array_get_unchecked(self, index))
        } else {
        }
        continue index + 1u32
      }
      _ => break array_unit()
    }
  }
  fn for_each_indexed(self, action: fn(t, U32) -> Unit) -> Unit {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          action(array_get_unchecked(self, index), index)
        } else {
        }
        continue index + 1u32
      }
      _ => break array_unit()
    }
  }
  fn map(self, mapper: fn(t) -> t) -> Array<t> {
    let limit = array_length(self)
    let output = Array::with_capacity(limit)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          array_push(output, mapper(array_get_unchecked(self, index)))
        } else {
        }
        continue index + 1u32
      }
      _ => break output
    }
  }
  fn map_indexed(self, mapper: fn(t, U32) -> t) -> Array<t> {
    let limit = array_length(self)
    let output = Array::with_capacity(limit)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          array_push(output, mapper(array_get_unchecked(self, index), index))
        } else {
        }
        continue index + 1u32
      }
      _ => break output
    }
  }
  fn filter(self, predicate: fn(t) -> Bool) -> Array<t> {
    let limit = array_length(self)
    let output = Array::with_capacity(limit)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          let value = array_get_unchecked(self, index)
          if predicate(value) {
            array_push(output, value)
          } else {
          }
        } else {
        }
        continue index + 1u32
      }
      _ => break output
    }
  }
  fn filter_indexed(self, predicate: fn(t, U32) -> Bool) -> Array<t> {
    let limit = array_length(self)
    let output = Array::with_capacity(limit)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          let value = array_get_unchecked(self, index)
          if predicate(value, index) {
            array_push(output, value)
          } else {
          }
        } else {
        }
        continue index + 1u32
      }
      _ => break output
    }
  }
  fn flat_map(self, mapper: fn(t) -> Array<t>) -> Array<t> {
    let limit = array_length(self)
    let output = Array::new()
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) {
          array_extend_values(output, mapper(array_get_unchecked(self, index)))
        } else {
        }
        continue index + 1u32
      }
      _ => break output
    }
  }
  fn every(self, predicate: fn(t) -> Bool) -> Bool {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) && !predicate(array_get_unchecked(self, index)) {
          break false
        } else {
          continue index + 1u32
        }
      }
      _ => break true
    }
  }
  fn every_indexed(self, predicate: fn(t, U32) -> Bool) -> Bool {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) && !predicate(array_get_unchecked(self, index), index) {
          break false
        } else {
          continue index + 1u32
        }
      }
      _ => break true
    }
  }
  fn some(self, predicate: fn(t) -> Bool) -> Bool {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) && predicate(array_get_unchecked(self, index)) {
          break true
        } else {
          continue index + 1u32
        }
      }
      _ => break false
    }
  }
  fn some_indexed(self, predicate: fn(t, U32) -> Bool) -> Bool {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) && predicate(array_get_unchecked(self, index), index) {
          break true
        } else {
          continue index + 1u32
        }
      }
      _ => break false
    }
  }
  fn find(self, predicate: fn(t) -> Bool) -> Option<t> {

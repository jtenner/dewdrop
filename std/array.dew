          let value = array_get_unchecked(self, index)
          if predicate(value) {
            break Option::Some(value)
          } else {
          }
        } else {
        }
        continue index + 1u32
      }
      _ => break Option::None
    }
  }
  fn find_index(self, predicate: fn(t) -> Bool) -> Option<U32> {
    let limit = array_length(self)
    while 0u32 {
      index if index < limit => {
        if index < array_length(self) && predicate(array_get_unchecked(self, index)) {
          break Option::Some(index)
        } else {

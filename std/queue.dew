open dew.std.collections.circular_buffer

pub type Queue<t> = CircularBuffer<t>
pub type QueueIter<t> = CircularBufferIter<t>

pub fn queue_new<t>() -> Queue<t> {
  queue_with_capacity(0u32)
}
pub fn queue_with_capacity<t>(capacity: U32) -> Queue<t> {
  circular_buffer_growable(capacity)
}
pub fn queue_length<t>(queue: Queue<t>) -> U32 {
  circular_buffer_length(queue)
}
pub fn queue_is_empty<t>(queue: Queue<t>) -> Bool {
  circular_buffer_is_empty(queue)
}
pub fn queue_enqueue<t>(queue: Queue<t>, value: t) -> Unit {
  if !circular_buffer_push_back(queue, value) {
    unreachable()
  }
}
pub fn queue_dequeue<t>(queue: Queue<t>) -> Option<t> {
  circular_buffer_pop_front(queue)
}
pub fn queue_peek<t>(queue: Queue<t>) -> Option<t> {
  circular_buffer_peek_front(queue)
}
pub fn queue_clear<t>(queue: Queue<t>) -> Unit {
  circular_buffer_clear(queue)
}
pub fn queue_iter<t>(queue: Queue<t>) -> QueueIter<t> {
  circular_buffer_iter(queue)
}
pub fn queue_iter_has_next<t>(iter: QueueIter<t>) -> Bool {
  circular_buffer_iter_has_next(iter)
}
pub fn queue_iter_next<t>(iter: QueueIter<t>) -> t {
  circular_buffer_iter_next(iter)
}

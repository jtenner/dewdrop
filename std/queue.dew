open dew.std.array

pub type Queue<t> = Array<t>
pub type QueueIter<t> = ArrayIter<t>

pub builtin queue_new<t>() -> Queue<t> = "dew_queue_new"
pub builtin queue_with_capacity<t>(capacity: U32) -> Queue<t> = "dew_queue_with_capacity"
pub builtin queue_length<t>(queue: Queue<t>) -> U32 = "dew_queue_length"
pub builtin queue_is_empty<t>(queue: Queue<t>) -> Bool = "dew_queue_is_empty"
pub builtin queue_enqueue<t>(queue: Queue<t>, value: t) -> Unit = "dew_queue_enqueue"
pub builtin queue_dequeue<t>(queue: Queue<t>) -> Option<t> = "dew_queue_dequeue"
pub builtin queue_peek<t>(queue: Queue<t>) -> Option<t> = "dew_queue_peek"
pub builtin queue_clear<t>(queue: Queue<t>) -> Unit = "dew_queue_clear"
pub builtin queue_iter<t>(queue: Queue<t>) -> QueueIter<t> = "dew_queue_iter"
pub builtin queue_iter_has_next<t>(iter: QueueIter<t>) -> Bool = "dew_queue_iter_has_next"
pub builtin queue_iter_next<t>(iter: QueueIter<t>) -> t = "dew_queue_iter_next"

open dew.std.ordering
open dew.std.types
fn btree_check_plan<k, v>(width: BTreeInlineWidth, leaf: U32, branch: U32, pair: U32, tags: Bool, label: String) -> Unit {
  let plan = btree_plan::<k, v, BTreeTestWidth>(BTreeTestWidth::{
    width: width
  }, btree_default_config())
  assert(plan.leaf_capacity() == leaf, label)
  assert(plan.branch_capacity() == branch, label)
  assert(plan.pair_bytes() == pair && plan.has_tags() == tags, label)
}
test "B-tree carrier width capacity matrix uses the payload formulas" {
  btree_check_plan::<I32, I32>(BTreeInlineWidth::Two, 98u32, 48u32, 8u32, false, "I32, I32 Two expected 98u32, 48u32, 8u32, false")
  btree_check_plan::<I64, I64>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "I64, I64 Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<F32, F32>(BTreeInlineWidth::Two, 98u32, 48u32, 8u32, false, "F32, F32 Two expected 98u32, 48u32, 8u32, false")
  btree_check_plan::<F64, F64>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "F64, F64 Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<V128, V128>(BTreeInlineWidth::Two, 26u32, 48u32, 32u32, true, "V128, V128 Two expected 26u32, 48u32, 32u32, true")
  btree_check_plan::<String, String>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "String, String Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<I32, U32>(BTreeInlineWidth::Two, 98u32, 48u32, 8u32, false, "I32, U32 Two expected 98u32, 48u32, 8u32, false")
  btree_check_plan::<I64, U64>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "I64, U64 Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<I32, F32>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "I32, F32 Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<U32, F64>(BTreeInlineWidth::Two, 54u32, 48u32, 16u32, false, "U32, F64 Two expected 54u32, 48u32, 16u32, false")
  btree_check_plan::<V128, U64>(BTreeInlineWidth::Two, 26u32, 48u32, 32u32, true, "V128, U64 Two expected 26u32, 48u32, 32u32, true")
  btree_check_plan::<Bool, U8>(BTreeInlineWidth::Two, 98u32, 48u32, 8u32, false, "Bool, U8 Two exact U32 carrier plan")
  btree_check_plan::<I16, U8>(BTreeInlineWidth::Two, 98u32, 48u32, 8u32, false, "I16, U8 Two expected 98u32, 48u32, 8u32, false")
  btree_check_plan::<String, U64>(BTreeInlineWidth::Two, 54u32, 48u32, 0u32, false, "String, U64 Two expected 54u32, 48u32, 0u32, false")
  btree_check_plan::<String, Option<I64>>(BTreeInlineWidth::Two, 54u32, 48u32, 0u32, false, "String, Option<I64> Two expected 54u32, 48u32, 0u32, false")
  btree_check_plan::<String, Option<Option<I64>>>(BTreeInlineWidth::Two, 54u32, 48u32, 0u32, false, "String, Option<Option<I64>> Two expected 54u32, 48u32, 0u32, false")
  btree_check_plan::<String, Unit>(BTreeInlineWidth::Two, 98u32, 48u32, 0u32, false, "String, Unit Two expected 98u32, 48u32, 0u32, false")
  btree_check_plan::<Unit, Unit>(BTreeInlineWidth::Two, 166u32, 48u32, 0u32, false, "Unit, Unit Two expected 166u32, 48u32, 0u32, false")
  btree_check_plan::<I32, I32>(BTreeInlineWidth::Four, 82u32, 40u32, 8u32, false, "I32, I32 Four expected 82u32, 40u32, 8u32, false")
  btree_check_plan::<I64, I64>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "I64, I64 Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<F32, F32>(BTreeInlineWidth::Four, 82u32, 40u32, 8u32, false, "F32, F32 Four expected 82u32, 40u32, 8u32, false")
  btree_check_plan::<F64, F64>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "F64, F64 Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<V128, V128>(BTreeInlineWidth::Four, 25u32, 40u32, 32u32, true, "V128, V128 Four expected 25u32, 40u32, 32u32, true")
  btree_check_plan::<String, String>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "String, String Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<I32, U32>(BTreeInlineWidth::Four, 82u32, 40u32, 8u32, false, "I32, U32 Four expected 82u32, 40u32, 8u32, false")
  btree_check_plan::<I64, U64>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "I64, U64 Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<I32, F32>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "I32, F32 Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<U32, F64>(BTreeInlineWidth::Four, 48u32, 40u32, 16u32, false, "U32, F64 Four expected 48u32, 40u32, 16u32, false")
  btree_check_plan::<V128, U64>(BTreeInlineWidth::Four, 25u32, 40u32, 32u32, true, "V128, U64 Four expected 25u32, 40u32, 32u32, true")
  btree_check_plan::<Bool, U8>(BTreeInlineWidth::Four, 82u32, 40u32, 8u32, false, "Bool, U8 Four exact U32 carrier plan")
  btree_check_plan::<I16, U8>(BTreeInlineWidth::Four, 82u32, 40u32, 8u32, false, "I16, U8 Four expected 82u32, 40u32, 8u32, false")
  btree_check_plan::<String, U64>(BTreeInlineWidth::Four, 48u32, 40u32, 0u32, false, "String, U64 Four expected 48u32, 40u32, 0u32, false")
  btree_check_plan::<String, Option<I64>>(BTreeInlineWidth::Four, 48u32, 40u32, 0u32, false, "String, Option<I64> Four expected 48u32, 40u32, 0u32, false")
  btree_check_plan::<String, Option<Option<I64>>>(BTreeInlineWidth::Four, 48u32, 40u32, 0u32, false, "String, Option<Option<I64>> Four expected 48u32, 40u32, 0u32, false")
  btree_check_plan::<String, Unit>(BTreeInlineWidth::Four, 82u32, 40u32, 0u32, false, "String, Unit Four expected 82u32, 40u32, 0u32, false")
  btree_check_plan::<Unit, Unit>(BTreeInlineWidth::Four, 124u32, 40u32, 0u32, false, "Unit, Unit Four expected 124u32, 40u32, 0u32, false")
  btree_check_plan::<I32, I32>(BTreeInlineWidth::Eight, 62u32, 30u32, 8u32, false, "I32, I32 Eight expected 62u32, 30u32, 8u32, false")
  btree_check_plan::<I64, I64>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "I64, I64 Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<F32, F32>(BTreeInlineWidth::Eight, 62u32, 30u32, 8u32, false, "F32, F32 Eight expected 62u32, 30u32, 8u32, false")
  btree_check_plan::<F64, F64>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "F64, F64 Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<V128, V128>(BTreeInlineWidth::Eight, 23u32, 30u32, 32u32, true, "V128, V128 Eight expected 23u32, 30u32, 32u32, true")
  btree_check_plan::<String, String>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "String, String Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<I32, U32>(BTreeInlineWidth::Eight, 62u32, 30u32, 8u32, false, "I32, U32 Eight expected 62u32, 30u32, 8u32, false")
  btree_check_plan::<I64, U64>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "I64, U64 Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<I32, F32>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "I32, F32 Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<U32, F64>(BTreeInlineWidth::Eight, 39u32, 30u32, 16u32, true, "U32, F64 Eight expected 39u32, 30u32, 16u32, true")
  btree_check_plan::<V128, U64>(BTreeInlineWidth::Eight, 23u32, 30u32, 32u32, true, "V128, U64 Eight expected 23u32, 30u32, 32u32, true")
  btree_check_plan::<Bool, U8>(BTreeInlineWidth::Eight, 62u32, 30u32, 8u32, false, "Bool, U8 Eight exact U32 carrier plan")
  btree_check_plan::<I16, U8>(BTreeInlineWidth::Eight, 62u32, 30u32, 8u32, false, "I16, U8 Eight expected 62u32, 30u32, 8u32, false")
  btree_check_plan::<String, U64>(BTreeInlineWidth::Eight, 39u32, 30u32, 0u32, true, "String, U64 Eight expected 39u32, 30u32, 0u32, true")
  btree_check_plan::<String, Option<I64>>(BTreeInlineWidth::Eight, 39u32, 30u32, 0u32, true, "String, Option<I64> Eight expected 39u32, 30u32, 0u32, true")
  btree_check_plan::<String, Option<Option<I64>>>(BTreeInlineWidth::Eight, 39u32, 30u32, 0u32, true, "String, Option<Option<I64>> Eight expected 39u32, 30u32, 0u32, true")
  btree_check_plan::<String, Unit>(BTreeInlineWidth::Eight, 62u32, 30u32, 0u32, false, "String, Unit Eight expected 62u32, 30u32, 0u32, false")
  btree_check_plan::<Unit, Unit>(BTreeInlineWidth::Eight, 82u32, 30u32, 0u32, false, "Unit, Unit Eight expected 82u32, 30u32, 0u32, false")
}

test "signed narrow arithmetic canonicalizes" {
  assert(127i8 + 1i8 == -128i8, "I8 wrapping add failed")
  assert(32767i16 + 1i16 == -32768i16, "I16 wrapping add failed")
}

test "unsigned narrow arithmetic canonicalizes" {
  assert(255u8 + 1u8 == 0u8, "U8 wrapping add failed")
  assert(65535u16 + 1u16 == 0u16, "U16 wrapping add failed")
}

test "I32 and U32 arithmetic works" {
  assert(21i32 * 2i32 == 42i32, "I32 multiply failed")
  assert(84u32 / 2u32 == 42u32, "U32 divide failed")
}

test "I64 and U64 arithmetic works" {
  assert(40i64 + 2i64 == 42i64, "I64 add failed")
  assert(84u64 / 2u64 == 42u64, "U64 divide failed")
}

test "floating arithmetic works" {
  assert(1.5f32 + 2.5f32 == 4.0f32, "F32 add failed")
  assert(9.0f64 / 2.0f64 == 4.5f64, "F64 divide failed")
}

fn test_i8_to_u64(value: I8) -> U64 {
  value.into()
}

fn test_u64_to_i16(value: U64) -> I16 {
  value.into()
}

fn test_i64_to_f64(value: I64) -> F64 {
  value.into()
}

fn test_f64_to_i32(value: F64) -> I32 {
  value.into()
}

test "scalar Into conversions use frozen target types" {
  assert(test_i8_to_u64(-1i8) == 18446744073709551615u64, "signed widening failed")
  assert(test_u64_to_i16(65535u64) == -1i16, "integer narrowing failed")
  assert(test_i64_to_f64(42i64) == 42.0f64, "integer to float failed")
  assert(test_f64_to_i32(42.9f64) == 42i32, "float truncation failed")
}

test "binary U64 le vectors and short widths" {
  let input = b"x\x01\x02\x03\x04\x05\x06\x07\x08y".view(1u32, 8u32)
  let cursor = binary_cursor(input)
  assert(read_u64_le(cursor) is Result::Ok(578437695752307201u64), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u64_le(builder, 578437695752307201u64)
  assert(builder.finish().equals(input), "writer vector")
  let maximum = BytesBuilder::new()
  write_u64_le(maximum, 18446744073709551615u64)
  assert(read_u64_le(binary_cursor(maximum.finish())) is Result::Ok(18446744073709551615u64), "maximum")
  while 0u32 {
    length if length < 8u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u64_le(short) is Result::Err(BinaryError::ShortInput(0u32, 8u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break
  }
}


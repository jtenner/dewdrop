open dew.std.encoding.binary
open dew.std.bytes
open dew.std.bytes_builder

fn assert_binary_bytes(result: Result<Bytes, BinaryError>, expected: Bytes, message: String) -> Unit {
  match result {
    Result::Ok(value) => assert(value.equals(expected), message)
    Result::Err(_) => assert(false, message)
  }
}

test "binary U16 le vectors and short widths" {
  let input = b"x\x01\x02y".view(1u32, 2u32)
  let cursor = binary_cursor(input)
  assert(read_u16_le(cursor) is Result::Ok(513u16), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u16_le(builder, 513u16)
  assert(builder.finish().equals(input), "writer vector")
  let zero = BytesBuilder::new()
  write_u16_le(zero, 0u16)
  assert(read_u16_le(binary_cursor(zero.finish())) is Result::Ok(0u16), "zero")
  let offset = binary_cursor(input)
  let _ = read_bytes(offset, 1u32)
  assert(read_u16_le(offset) is Result::Err(BinaryError::ShortInput(1u32, 2u32, 1u32)), "offset error")
  assert(binary_position(offset) == 1u32, "offset error advanced")
  assert(binary_remaining(offset) == 1u32, "offset remaining")
  let maximum = BytesBuilder::new()
  write_u16_le(maximum, 65535u16)
  assert(read_u16_le(binary_cursor(maximum.finish())) is Result::Ok(65535u16), "maximum")
  while 0u32 {
    length if length < 2u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u16_le(short) is Result::Err(BinaryError::ShortInput(0u32, 2u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break ()
  }
}

test "binary U16 be vectors and short widths" {
  let input = b"x\x01\x02y".view(1u32, 2u32)
  let cursor = binary_cursor(input)
  assert(read_u16_be(cursor) is Result::Ok(258u16), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u16_be(builder, 258u16)
  assert(builder.finish().equals(input), "writer vector")
  let zero = BytesBuilder::new()
  write_u16_be(zero, 0u16)
  assert(read_u16_be(binary_cursor(zero.finish())) is Result::Ok(0u16), "zero")
  let offset = binary_cursor(input)
  let _ = read_bytes(offset, 1u32)
  assert(read_u16_be(offset) is Result::Err(BinaryError::ShortInput(1u32, 2u32, 1u32)), "offset error")
  assert(binary_position(offset) == 1u32, "offset error advanced")
  assert(binary_remaining(offset) == 1u32, "offset remaining")
  let maximum = BytesBuilder::new()
  write_u16_be(maximum, 65535u16)
  assert(read_u16_be(binary_cursor(maximum.finish())) is Result::Ok(65535u16), "maximum")
  while 0u32 {
    length if length < 2u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u16_be(short) is Result::Err(BinaryError::ShortInput(0u32, 2u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break ()
  }
}

test "binary U32 le vectors and short widths" {
  let input = b"x\x01\x02\x03\x04y".view(1u32, 4u32)
  let cursor = binary_cursor(input)
  assert(read_u32_le(cursor) is Result::Ok(67305985u32), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u32_le(builder, 67305985u32)
  assert(builder.finish().equals(input), "writer vector")
  let zero = BytesBuilder::new()
  write_u32_le(zero, 0u32)
  assert(read_u32_le(binary_cursor(zero.finish())) is Result::Ok(0u32), "zero")
  let offset = binary_cursor(input)
  let _ = read_bytes(offset, 1u32)
  assert(read_u32_le(offset) is Result::Err(BinaryError::ShortInput(1u32, 4u32, 3u32)), "offset error")
  assert(binary_position(offset) == 1u32, "offset error advanced")
  assert(binary_remaining(offset) == 3u32, "offset remaining")
  let maximum = BytesBuilder::new()
  write_u32_le(maximum, 4294967295u32)
  assert(read_u32_le(binary_cursor(maximum.finish())) is Result::Ok(4294967295u32), "maximum")
  while 0u32 {
    length if length < 4u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u32_le(short) is Result::Err(BinaryError::ShortInput(0u32, 4u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break ()
  }
}

test "binary U32 be vectors and short widths" {
  let input = b"x\x01\x02\x03\x04y".view(1u32, 4u32)
  let cursor = binary_cursor(input)
  assert(read_u32_be(cursor) is Result::Ok(16909060u32), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u32_be(builder, 16909060u32)
  assert(builder.finish().equals(input), "writer vector")
  let zero = BytesBuilder::new()
  write_u32_be(zero, 0u32)
  assert(read_u32_be(binary_cursor(zero.finish())) is Result::Ok(0u32), "zero")
  let offset = binary_cursor(input)
  let _ = read_bytes(offset, 1u32)
  assert(read_u32_be(offset) is Result::Err(BinaryError::ShortInput(1u32, 4u32, 3u32)), "offset error")
  assert(binary_position(offset) == 1u32, "offset error advanced")
  assert(binary_remaining(offset) == 3u32, "offset remaining")
  let maximum = BytesBuilder::new()
  write_u32_be(maximum, 4294967295u32)
  assert(read_u32_be(binary_cursor(maximum.finish())) is Result::Ok(4294967295u32), "maximum")
  while 0u32 {
    length if length < 4u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u32_be(short) is Result::Err(BinaryError::ShortInput(0u32, 4u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break ()
  }
}

test "binary U64 le vectors and short widths" {
  let input = b"x\x01\x02\x03\x04\x05\x06\x07\x08y".view(1u32, 8u32)
  let cursor = binary_cursor(input)
  assert(read_u64_le(cursor) is Result::Ok(578437695752307201u64), "endian vector")
  assert(binary_remaining(cursor) == 0u32, "consumed width")
  let builder = BytesBuilder::new()
  write_u64_le(builder, 578437695752307201u64)
  assert(builder.finish().equals(input), "writer vector")
  let zero = BytesBuilder::new()
  write_u64_le(zero, 0u64)
  assert(read_u64_le(binary_cursor(zero.finish())) is Result::Ok(0u64), "zero")
  let offset = binary_cursor(input)
  let _ = read_bytes(offset, 1u32)
  assert(read_u64_le(offset) is Result::Err(BinaryError::ShortInput(1u32, 8u32, 7u32)), "offset error")
  assert(binary_position(offset) == 1u32, "offset error advanced")
  assert(binary_remaining(offset) == 7u32, "offset remaining")
  let maximum = BytesBuilder::new()
  write_u64_le(maximum, 18446744073709551615u64)
  assert(read_u64_le(binary_cursor(maximum.finish())) is Result::Ok(18446744073709551615u64), "maximum")
  while 0u32 {
    length if length < 8u32 => {
      let short = binary_cursor(input.view(0u32, length))
      assert(read_u64_le(short) is Result::Err(BinaryError::ShortInput(0u32, 8u32, length)), "short error")
      assert(binary_position(short) == 0u32, "failed read advanced")
      continue length + 1u32
    }
    _ => break ()
  }
}


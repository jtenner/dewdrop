test "binary slices and arithmetic bounds" {
  let cursor = binary_cursor(b"abc")
  let alias = cursor
  assert_binary_bytes(read_bytes(cursor, 1u32), b"a", "slice")
  assert(binary_position(alias) == 1u32, "aliases share position")
  assert(read_bytes(cursor, 4294967295u32) is Result::Err(BinaryError::ShortInput(1u32, 4294967295u32, 2u32)), "overflow bound")
  assert(binary_position(cursor) == 1u32, "error position")
  assert(binary_remaining_bytes(cursor).equals(b"bc"), "remaining view")
  assert_binary_bytes(read_bytes(cursor, 2u32), b"bc", "exact slice")
  assert_binary_bytes(read_bytes(cursor, 0u32), b"", "empty at end")
  assert(read_u16_le(cursor) is Result::Err(BinaryError::ShortInput(3u32, 2u32, 0u32)), "end error")
}

test "binary version one capsule shaped request" {
  let builder = BytesBuilder::new()
  write_u16_le(builder, 1u16)
  write_u32_be(builder, 3u32)
  builder.append(b"req")
  let cursor = binary_cursor(builder.finish())
  assert(read_u16_le(cursor) is Result::Ok(1u16), "version")
  assert(read_u32_be(cursor) is Result::Ok(3u32), "payload length")
  assert_binary_bytes(read_bytes(cursor, 3u32), b"req", "payload")
  assert(binary_remaining(cursor) == 0u32, "capsule end")
}

open dew.std.text
open dew.std.string
open dew.std.string_builder

fn split_expect(parts: StringViewSplit, expected: String) -> Unit {
  match parts.next() {
    Option::Some(value) => {
      assert(value.equals(expected.view(0u32, expected.byte_length())), "wrong split field")
      assert(value.compact() == expected, "wrong compact copy")
    }
    Option::None => assert(false, "missing split field")
  }
}

fn split_end(parts: StringViewSplit) -> Unit {
  assert(parts.next().is_none(), "split did not terminate")
  assert(parts.next().is_none(), "split restarted")
}

test "split keeps repeated trailing and leading empty fields" {
  let parts = ",a,,".view(0u32, 4u32).split(",".view(0u32, 1u32))
  split_expect(parts, "")
  split_expect(parts, "a")
  split_expect(parts, "")
  split_expect(parts, "")
  split_end(parts)
}

test "split empty input and empty delimiter yield one field" {
  let empty = "".view(0u32, 0u32)
  let parts = empty.split(",".view(0u32, 1u32))
  split_expect(parts, "")
  split_end(parts)
  let whole = "λ🌍".view(0u32, 6u32).split(empty)
  split_expect(whole, "λ🌍")
  split_end(whole)
  let both = empty.split(empty)
  split_expect(both, "")
  split_end(both)
}

test "split multibyte delimiter and nonzero source and delimiter offsets" {
  let source = "!λaλλbλ?".view(1u32, 10u32)
  let parts = source.split("!λ?".view(1u32, 2u32))
  split_expect(parts, "")
  split_expect(parts, "a")
  split_expect(parts, "")
  split_expect(parts, "b")
  split_expect(parts, "")
  split_end(parts)
}

test "lines strips CRLF keeps lone CR and final empty line" {
  let parts = "!a\r\nb\rc\n\n?".view(1u32, 8u32).lines()
  split_expect(parts, "a")
  split_expect(parts, "b\rc")
  split_expect(parts, "")
  split_expect(parts, "")
  split_end(parts)
  let empty = "".view(0u32, 0u32).lines()
  split_expect(empty, "")
  split_end(empty)
  let lone = "\r".view(0u32, 1u32).lines()
  split_expect(lone, "\r")
  split_end(lone)
}

test "split nonoverlap and delimiter longer than source" {
  let parts = "aaaaa".view(0u32, 5u32).split("aa".view(0u32, 2u32))
  split_expect(parts, "")
  split_expect(parts, "")
  split_expect(parts, "a")
  split_end(parts)
  let short = "a".view(0u32, 1u32).split("abc".view(0u32, 3u32))
  split_expect(short, "a")
  split_end(short)
}

test "split scans repetitive source once and bounds comparisons" {
  let builder = StringBuilder::new()
  for _ in 0u32..<8192u32 {
    builder.append("a")
  }
  let source = builder.finish()
  let parts = source.view(0u32, source.byte_length()).split("aaaaab".view(0u32, 6u32))
  assert(parts.source_scans() == 0u32, "constructor scanned source")
  split_expect(parts, source)
  split_end(parts)
  assert(parts.source_scans() == 8192u32, "source was scanned again")
  assert(parts.comparisons() <= 16384u32, "quadratic delimiter search")
}

open dew.std.bloom_filter
open dew.std.string

test "Bloom filter reports inserted values and definite misses" {
  let empty = bloom_filter_empty()
  assert(bloom_filter_is_empty(empty), "new Bloom filter was not empty")
  assert(
    !bloom_filter_maybe_contains(empty, "dew"),
    "empty Bloom filter reported a possible member",
  )
  let with_dew = bloom_filter_add(empty, "dew")
  assert(!bloom_filter_is_empty(with_dew), "Bloom filter add kept empty bits")
  assert(
    bloom_filter_maybe_contains(with_dew, "dew"),
    "Bloom filter rejected an inserted value",
  )
  assert(
    !bloom_filter_maybe_contains(with_dew, "starshine"),
    "Bloom filter lost a definite miss",
  )
  assert(bloom_filter_is_empty(empty), "Bloom filter mutation changed the input value")
}

test "Bloom filter hash operations match Hash-based operations" {
  let hash = "dew".hash()
  let from_hash = bloom_filter_add_hash(bloom_filter_empty(), hash)
  let from_value = bloom_filter_add(bloom_filter_empty(), "dew")
  assert(from_hash == from_value, "Bloom filter hash and value insertion diverged")
  assert(
    bloom_filter_maybe_contains_hash(from_hash, hash),
    "Bloom filter hash query rejected an inserted hash",
  )
}

test "Bloom filter positives remain explicitly probabilistic" {
  let filter = bloom_filter_add(bloom_filter_empty(), "p")
  assert(
    bloom_filter_maybe_contains(filter, "0"),
    "expected deterministic two-probe Bloom collision changed",
  )
  assert(!"p".equals("0"), "Bloom collision fixture is not distinct")
}

test "Bloom filter accepts any value with Hash evidence" {
  let filter = bloom_filter_add(bloom_filter_empty(), 42u64)
  assert(bloom_filter_maybe_contains(filter, 42u64), "U64 Hash value was absent")
  assert(!bloom_filter_maybe_contains(filter, 43u64), "distinct U64 was not a definite miss")
}

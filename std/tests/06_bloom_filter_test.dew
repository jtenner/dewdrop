open dew.std.bloom_filter
open dew.std.string

test "Bloom filter reports inserted values and definite misses" {
  let empty = BloomFilter::empty()
  assert(empty.is_empty(), "new Bloom filter was not empty")
  assert(
    !empty.maybe_contains("dew"),
    "empty Bloom filter reported a possible member",
  )
  let with_dew = empty.add("dew")
  assert(!with_dew.is_empty(), "Bloom filter add kept empty bits")
  assert(
    with_dew.maybe_contains("dew"),
    "Bloom filter rejected an inserted value",
  )
  assert(
    !with_dew.maybe_contains("starshine"),
    "Bloom filter lost a definite miss",
  )
  assert(empty.is_empty(), "Bloom filter mutation changed the input value")
}

test "Bloom filter hash methods match Hash-based methods" {
  let hash = "dew".hash()
  let from_hash = BloomFilter::empty().add_hash(hash)
  let from_value = BloomFilter::empty().add("dew")
  assert(from_hash == from_value, "Bloom filter hash and value insertion diverged")
  assert(
    from_hash.maybe_contains_hash(hash),
    "Bloom filter hash query rejected an inserted hash",
  )
}

test "Bloom filter positives remain explicitly probabilistic" {
  let filter = BloomFilter::empty().add("p")
  assert(
    filter.maybe_contains("0"),
    "expected deterministic two-probe Bloom collision changed",
  )
  assert(!"p".equals("0"), "Bloom collision fixture is not distinct")
}

test "Bloom filter accepts any value with Hash evidence" {
  let filter = BloomFilter::empty().add(42u64)
  assert(filter.maybe_contains(42u64), "U64 Hash value was absent")
  assert(!filter.maybe_contains(43u64), "distinct U64 was not a definite miss")
}

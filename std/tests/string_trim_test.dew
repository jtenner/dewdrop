open dew.std.string

test "ASCII trim empty and all whitespace" {
  assert("".trim_ascii().byte_length() == 0u32, "empty both")
  assert("".trim_ascii_start().byte_length() == 0u32, "empty start")
  assert("".trim_ascii_end().byte_length() == 0u32, "empty end")
  let spaces = " \t\n\x0B\x0C\r"
  assert(spaces.trim_ascii().byte_length() == 0u32, "all both")
  assert(spaces.trim_ascii_start().byte_length() == 0u32, "all start")
  assert(spaces.trim_ascii_end().byte_length() == 0u32, "all end")
}

test "ASCII trim preserves interior and NUL" {
  assert("  a b  ".trim_ascii().to_string().equals("a b"), "interior space")
  assert(" \x00 ".trim_ascii().to_string().equals("\x00"), "NUL preserved")
  assert("\x00 x \x00".trim_ascii().to_string().equals("\x00 x \x00"), "NUL stops scan")
}

test "ASCII trim preserves non ASCII spaces" {
  let text = "    　"
  assert(text.trim_ascii().to_string().equals(text), "non ASCII spaces changed")
  assert("     　 ".trim_ascii().to_string().equals(text), "outer ASCII only")
}

test "ASCII trim views use relative bounds" {
  let view = "xx  λ🌍  yy".view(2u32, 10u32)
  assert(view.trim_ascii().to_string().equals("λ🌍"), "nonzero both")
  assert(view.trim_ascii_start().to_string().equals("λ🌍  "), "nonzero start")
  assert(view.trim_ascii_end().to_string().equals("  λ🌍"), "nonzero end")
  assert(view.trim_ascii().trim_ascii().to_string().equals("λ🌍"), "idempotent")
}


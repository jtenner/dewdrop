open dew.std.array

struct SearchOrder {
  reverse: Bool
  mut calls: U32
}
impl ArrayComparator<U32> for SearchOrder {
  fn before(self, left: U32, right: U32) -> Bool {
    self.calls = self.calls + 1u32
    if self.reverse { left > right } else { left < right }
  }
}

fn search_oracle(values: Array<U32>, key: U32, start: U32, end: U32, order: SearchOrder, upper: Bool) -> U32 {
  while start {
    i if i < end => {
      let advance = if upper { !order.before(key, values[i]) } else { order.before(values[i], key) }
      if advance { continue i + 1u32 } else { break i }
    }
    _ => break end
  }
}

test "sorted bounds match linear oracle for all small ranges in both orders" {
  let order = SearchOrder::{ reverse: false, calls: 0u32 }
  let descending = SearchOrder::{ reverse: true, calls: 0u32 }
  let values = [2u32, 4u32, 4u32, 4u32, 8u32]
  let reversed = [8u32, 4u32, 4u32, 4u32, 2u32]
  for start in 0u32..<6u32 {
    for end in start..<6u32 {
      for key in 0u32..<11u32 {
        let lo = search_oracle(values, key, start, end, order, false)
        let hi = search_oracle(values, key, start, end, order, true)
        assert(array_lower_bound_range(values, key, start, end, order) == lo, "lower oracle")
        assert(array_upper_bound_range(values, key, start, end, order) == hi, "upper oracle")
        let found = array_binary_search_range(values, key, start, end, order)
        if lo < hi { assert(found == Option::Some(lo), "first equal") }
        else { assert(found == Option::None, "missing key") }
        assert(array_lower_bound_range(reversed, key, start, end, descending) == search_oracle(reversed, key, start, end, descending, false), "reverse lower")
        assert(array_upper_bound_range(reversed, key, start, end, descending) == search_oracle(reversed, key, start, end, descending, true), "reverse upper")
        let rlo = search_oracle(reversed, key, start, end, descending, false)
        let rhi = search_oracle(reversed, key, start, end, descending, true)
        assert(array_binary_search_range(reversed, key, start, end, descending) == (if rlo < rhi { Option::Some(rlo) } else { Option::None }), "reverse search")
      }
    }
  }
}

test "empty singleton and full array helpers" {
  let empty: Array<U32> = Array::new()
  assert(empty.lower_bound(4u32) == 0u32 && empty.upper_bound(4u32) == 0u32, "empty bounds")
  assert(empty.binary_search(4u32) == Option::None, "empty search")
  let one = [4u32]
  assert(one.lower_bound(4u32) == 0u32 && one.upper_bound(4u32) == 1u32, "singleton equal")
  assert(one.binary_search(4u32) == Option::Some(0u32), "singleton found")
  assert(one.lower_bound(0u32) == 0u32 && one.upper_bound(9u32) == 1u32, "singleton outside")
  let values = [2u32, 4u32, 4u32, 8u32]
  let order = SearchOrder::{ reverse: false, calls: 0u32 }
  assert(array_lower_bound(values, 4u32, order) == 1u32, "full lower")
  assert(array_upper_bound(values, 4u32, order) == 3u32, "full upper")
  assert(array_binary_search(values, 4u32, order) == Option::Some(1u32), "full first")
}

struct SearchKey { value: U32 }
struct SearchKeyOrder {}
impl ArrayComparator<SearchKey> for SearchKeyOrder {
  fn before(self, left: SearchKey, right: SearchKey) -> Bool { left.value < right.value }
}
test "reference keys use comparator equivalence" {
  let values = [SearchKey::{value: 2u32}, SearchKey::{value: 4u32}, SearchKey::{value: 4u32}]
  let key = SearchKey::{value: 4u32}
  let order = SearchKeyOrder::{}
  assert(array_lower_bound(values, key, order) == 1u32, "reference lower")
  assert(array_upper_bound(values, key, order) == 3u32, "reference upper")
  assert(array_binary_search(values, key, order) == Option::Some(1u32), "reference first")
}

test "comparison counts grow logarithmically with duplicate runs" {
  for power in 0u32..<15u32 {
    let length = 1u32 << power
    let values = Array::make(length, 4u32)
    let order = SearchOrder::{reverse: false, calls: 0u32}
    for key in 3u32..<6u32 {
      order.calls = 0u32
      let lo = array_lower_bound(values, key, order)
      assert(order.calls <= power + 1u32, "lower comparison bound")
      order.calls = 0u32
      let hi = array_upper_bound(values, key, order)
      assert(order.calls <= power + 1u32, "upper comparison bound")
      order.calls = 0u32
      let found = array_binary_search(values, key, order)
      assert(order.calls <= power + 2u32, "search comparison bound")
      assert(lo == search_oracle(values, key, 0u32, length, order, false), "large lower oracle")
      assert(hi == search_oracle(values, key, 0u32, length, order, true), "large upper oracle")
      assert(found == (if key == 4u32 { Option::Some(0u32) } else { Option::None }), "large search")
    }
  }
}

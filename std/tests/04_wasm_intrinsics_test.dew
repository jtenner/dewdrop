import dew.std.wasm.intrinsics as @wasm

test "U32 popcnt counts all 32 bits" {
  assert(@wasm.wasm_u32_popcnt(0u32) == 0u32, "zero has no set bits")
  assert(@wasm.wasm_u32_popcnt(4294967295u32) == 32u32, "all bits are set")
  assert(@wasm.wasm_u32_popcnt(2147483648u32) == 1u32, "the high bit counts once")
  assert(@wasm.wasm_u32_popcnt(2147483649u32) == 2u32, "both edge bits count")
  assert(@wasm.wasm_u32_popcnt(2863311530u32) == 16u32, "alternating bits count")
}

test "generated scalar Wasm intrinsics execute directly" {
  assert(@wasm.wasm_i32_add(19i32, 23i32) == 42i32, "i32 add intrinsic failed")
  assert(@wasm.wasm_u32_ctz(0u32) == 32u32, "u32 ctz zero failed")
  assert(@wasm.wasm_u32_ctz(72u32) == 3u32, "u32 ctz nonzero failed")
  assert(@wasm.wasm_core_i32_lt(1i32, 2i32), "backend-only i32 lt intrinsic failed")
  assert(@wasm.i64_trunc_i32(4294967297i64) == 1i32, "i64 truncation intrinsic failed")
  assert(@wasm.wasm_f32_sqrt(81.0f32) == 9.0f32, "f32 sqrt intrinsic failed")
}

test "generated memory and SIMD Wasm intrinsics execute directly" {
  @wasm.wasm_u32_store(3u32, 305419896u32)
  assert(@wasm.wasm_u32_load(3u32) == 305419896u32, "u32 memory intrinsic failed")
  let vector = @wasm.wasm_v128_splat_i32(7i32)
  let difference = @wasm.wasm_v128_xor(vector, @wasm.wasm_v128_splat_i32(7i32))
  assert(!@wasm.wasm_v128_any_true(difference), "v128 intrinsic failed")
}

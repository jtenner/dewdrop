open dew.std.fixed_array
open dew.std.array
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.process
open dew.std.string

foreign type WpsiProcessI32Result
foreign type WpsiProcessI64Result
foreign type WpsiProcessEnvResult

foreign impl "wpsi" as WpsiProcessHost {
  fn i32_value(value: WpsiProcessI32Result) -> U32 = "i32_result_value"
  fn i32_error(value: WpsiProcessI32Result) -> U32 = "i32_result_error"
  fn i64_value(value: WpsiProcessI64Result) -> U64 = "i64_result_value"
  fn i64_error(value: WpsiProcessI64Result) -> U32 = "i64_result_error"
  fn env_name(value: WpsiProcessEnvResult) -> U32 = "env_result_name"
  fn env_value(value: WpsiProcessEnvResult) -> U32 = "env_result_value"
  fn env_error(value: WpsiProcessEnvResult) -> U32 = "env_result_error"
  fn handle_close(handle: U32) -> U32 = "handle_close"
  fn args_count() -> WpsiProcessI32Result = "args_count"
  fn args_get(index: U32) -> WpsiProcessI32Result = "args_get"
  fn env_count() -> WpsiProcessI32Result = "env_count"
  fn env_get(index: U32) -> WpsiProcessEnvResult = "env_get"
  fn sysstr_len(value: U32) -> WpsiProcessI64Result = "sysstr_len_utf8"
  fn sysstr_read(value: U32, destination: FixedArray<U8>, capacity: U32) -> WpsiProcessI64Result = "sysstr_read_array_i8"
  fn stdio_stdout() -> WpsiProcessI32Result = "stdio_stdout"
  fn stdio_stderr() -> WpsiProcessI32Result = "stdio_stderr"
  fn fd_write(fd: U32, source: FixedArray<U8>, offset: U64, length: U64) -> WpsiProcessI64Result = "fd_write_array_i8"
  fn proc_exit(status: U32) -> Unit = "proc_exit"
}

pub struct WpsiProcess {
}

pub fn wpsi_process() -> WpsiProcess {
  WpsiProcess::{}
}

fn wpsi_process_u32_to_u64(value: U32) -> U64 {
  value.into()
}

fn wpsi_process_u64_to_u32(value: U64) -> U32 {
  value.into()
}

fn wpsi_process_error(
  operation: ProcessOperation,
  kind: ProcessErrorKind,
  code: U32,
) -> ProcessError {
  ProcessError::{
    operation: operation
    kind: kind
    code: code
  }
}

fn wpsi_process_backend_error(operation: ProcessOperation, code: U32) -> ProcessError {
  wpsi_process_error(operation, ProcessErrorKind::Backend, code)
}

fn wpsi_process_buffer(value: Bytes) -> FixedArray<U8> {
  let output = FixedArray::make(value.byte_length(), 0u8)
  while 0u32 {
    index if index < value.byte_length() => {
      output.set_unchecked(index, value.byte_at(index))
      continue index + 1u32
    }
    _ => break output
  }
}

fn wpsi_sysstr(
  handle: U32,
  operation: ProcessOperation,
  max_bytes: U32,
) -> Result<String, ProcessError> {
  let length_result = WpsiProcessHost.sysstr_len(handle)
  let length_error = WpsiProcessHost.i64_error(length_result)
  if length_error != 0u32 {
    WpsiProcessHost.handle_close(handle)
    Result::Err(wpsi_process_backend_error(operation, length_error))
  } else {
    let length = WpsiProcessHost.i64_value(length_result)
    if length > wpsi_process_u32_to_u64(max_bytes) {
      WpsiProcessHost.handle_close(handle)
      Result::Err(wpsi_process_error(operation, ProcessErrorKind::LimitExceeded, 17u32))
    } else {
      let count = wpsi_process_u64_to_u32(length)
      let buffer = FixedArray::make(count, 0u8)
      let read = WpsiProcessHost.sysstr_read(handle, buffer, count)
      let read_error = WpsiProcessHost.i64_error(read)
      let written = WpsiProcessHost.i64_value(read)
      WpsiProcessHost.handle_close(handle)
      if read_error != 0u32 {
        Result::Err(wpsi_process_backend_error(operation, read_error))
      } else if written != length {
        Result::Err(wpsi_process_backend_error(operation, 17u32))
      } else {
        let builder = BytesBuilder::with_capacity(count)
        while 0u32 {
          index if index < count => {
            builder.append_byte(buffer.get_unchecked(index))
            continue index + 1u32
          }
          _ => {
            let bytes = builder.finish()
            if bytes.is_valid_utf8() {
              break Result::Ok(bytes.to_string())
            } else {
              break Result::Err(
                wpsi_process_error(operation, ProcessErrorKind::InvalidUtf8, 23u32),
              )
            }
          }
        }
      }
    }
  }
}

fn wpsi_write_stream(
  descriptor: WpsiProcessI32Result,
  operation: ProcessOperation,
  value: Bytes,
) -> Result<U32, ProcessError> {
  let descriptor_error = WpsiProcessHost.i32_error(descriptor)
  if descriptor_error != 0u32 {
    Result::Err(wpsi_process_backend_error(operation, descriptor_error))
  } else {
    let fd = WpsiProcessHost.i32_value(descriptor)
    let buffer = wpsi_process_buffer(value)
    let length = wpsi_process_u32_to_u64(buffer.length())
    while 0u64 {
      total if total < length => {
        let write = WpsiProcessHost.fd_write(fd, buffer, total, length - total)
        let error = WpsiProcessHost.i64_error(write)
        let count = WpsiProcessHost.i64_value(write)
        if error != 0u32 || count == 0u64 {
          let reported_error = if error == 0u32 {
            3u32
          } else {
            error
          }
          break Result::Err(
            wpsi_process_backend_error(operation, reported_error),
          )
        } else {
          continue total + count
        }
      }
      _ => break Result::Ok(buffer.length())
    }
  }
}

impl Process for WpsiProcess {
  fn arguments(self, max_count: U32, max_bytes: U32) -> Result<Array<String>, ProcessError> {
    let count_result = WpsiProcessHost.args_count()
    let error = WpsiProcessHost.i32_error(count_result)
    if error != 0u32 {
      Result::Err(wpsi_process_backend_error(ProcessOperation::Arguments, error))
    } else {
      let count = WpsiProcessHost.i32_value(count_result)
      if count > max_count {
        Result::Err(
          wpsi_process_error(ProcessOperation::Arguments, ProcessErrorKind::LimitExceeded, 17u32),
        )
      } else {
        let output = Array::with_capacity(count)
        let mut total_bytes = 0u32
        while 0u32 {
          index if index < count => {
            let item = WpsiProcessHost.args_get(index)
            let item_error = WpsiProcessHost.i32_error(item)
            if item_error != 0u32 {
              break Result::Err(
                wpsi_process_backend_error(ProcessOperation::Arguments, item_error),
              )
            } else {
              match wpsi_sysstr(
                WpsiProcessHost.i32_value(item),
                ProcessOperation::Arguments,
                max_bytes,
              ) {
                Result::Err(read_error) => break Result::Err(read_error)
                Result::Ok(value) => {
                  if total_bytes > max_bytes || value.byte_length() > max_bytes - total_bytes {
                    break Result::Err(
                      wpsi_process_error(
                        ProcessOperation::Arguments,
                        ProcessErrorKind::LimitExceeded,
                        17u32,
                      ),
                    )
                  } else {
                    total_bytes = total_bytes + value.byte_length()
                    output.push(value)
                    continue index + 1u32
                  }
                }
              }
            }
          }
          _ => break Result::Ok(output)
        }
      }
    }
  }

  fn environment(self, name: String, max_bytes: U32) -> Result<Option<String>, ProcessError> {
    let count_result = WpsiProcessHost.env_count()
    let count_error = WpsiProcessHost.i32_error(count_result)
    if count_error != 0u32 {
      Result::Err(wpsi_process_backend_error(ProcessOperation::Environment, count_error))
    } else {
      let count = WpsiProcessHost.i32_value(count_result)
      while 0u32 {
        index if index < count => {
          let entry = WpsiProcessHost.env_get(index)
          let entry_error = WpsiProcessHost.env_error(entry)
          if entry_error != 0u32 {
            break Result::Err(
              wpsi_process_backend_error(ProcessOperation::Environment, entry_error),
            )
          } else {
            match wpsi_sysstr(
              WpsiProcessHost.env_name(entry),
              ProcessOperation::Environment,
              max_bytes,
            ) {
              Result::Err(read_error) => {
                WpsiProcessHost.handle_close(WpsiProcessHost.env_value(entry))
                break Result::Err(read_error)
              }
              Result::Ok(entry_name) => {
                if entry_name.equals(name) {
                  match wpsi_sysstr(
                    WpsiProcessHost.env_value(entry),
                    ProcessOperation::Environment,
                    max_bytes,
                  ) {
                    Result::Err(read_error) => break Result::Err(read_error)
                    Result::Ok(value) => break Result::Ok(Option::Some(value))
                  }
                } else {
                  WpsiProcessHost.handle_close(WpsiProcessHost.env_value(entry))
                  continue index + 1u32
                }
              }
            }
          }
        }
        _ => break Result::Ok(Option::None)
      }
    }
  }

  fn write_stdout(self, value: Bytes) -> Result<U32, ProcessError> {
    wpsi_write_stream(
      WpsiProcessHost.stdio_stdout(),
      ProcessOperation::StandardOutput,
      value,
    )
  }

  fn write_stderr(self, value: Bytes) -> Result<U32, ProcessError> {
    wpsi_write_stream(
      WpsiProcessHost.stdio_stderr(),
      ProcessOperation::StandardError,
      value,
    )
  }

  fn exit(self, status: U32) -> Never {
    WpsiProcessHost.proc_exit(status)
    unreachable()
  }
}

open dew.std.fixed_array
open dew.std.array
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.process
open dew.std.string

foreign type FacetProcessI32Result
foreign type FacetProcessI64Result

foreign impl "facet" as FacetProcessHost {
  fn abi_version() -> U32 = "abi_version"
  fn i32_value(value: FacetProcessI32Result) -> U32 = "i32_result_value"
  fn i32_error(value: FacetProcessI32Result) -> U32 = "i32_result_error"
  fn i64_value(value: FacetProcessI64Result) -> U64 = "i64_result_value"
  fn i64_error(value: FacetProcessI64Result) -> U32 = "i64_result_error"
  fn args_count() -> FacetProcessI32Result = "args_count"
  fn args_len(index: U32) -> FacetProcessI64Result = "args_len_i8"
  fn args_read(index: U32, destination: FixedArray<U8>, capacity: U32) -> FacetProcessI64Result = "args_read_into_array_i8"
  fn env_count() -> FacetProcessI32Result = "env_count"
  fn env_len(index: U32, field: U32) -> FacetProcessI64Result = "env_len_i8"
  fn env_read(index: U32, field: U32, destination: FixedArray<U8>, capacity: U32) -> FacetProcessI64Result = "env_read_into_array_i8"
  fn stdio_stdout() -> FacetProcessI32Result = "stdio_stdout"
  fn stdio_stderr() -> FacetProcessI32Result = "stdio_stderr"
  fn fd_write(fd: U32, source: FixedArray<U8>, offset: U64, length: U64) -> FacetProcessI64Result = "fd_write_array_i8"
  fn proc_exit(status: U32) -> Unit = "proc_exit"
}

pub struct FacetProcess {
}

pub fn facet_process() -> FacetProcess {
  FacetProcess::{}
}

pub fn facet_process_abi_version() -> U32 {
  FacetProcessHost.abi_version()
}

fn facet_process_u32_to_u64(value: U32) -> U64 {
  value.into()
}

fn facet_process_u64_to_u32(value: U64) -> U32 {
  value.into()
}

fn facet_process_error(
  operation: ProcessOperation,
  kind: ProcessErrorKind,
  code: U32,
) -> ProcessError {
  ProcessError::{
    operation: operation
    kind: kind
    code: code
  }
}

fn facet_process_backend_error(operation: ProcessOperation, code: U32) -> ProcessError {
  facet_process_error(operation, ProcessErrorKind::Backend, code)
}

fn facet_process_buffer(value: Bytes) -> FixedArray<U8> {
  let output = FixedArray::make(value.byte_length(), 0u8)
  while 0u32 {
    index if index < value.byte_length() => {
      output.set_unchecked(index, value.byte_at(index))
      continue index + 1u32
    }
    _ => break output
  }
}

fn facet_text_from_buffer(
  buffer: FixedArray<U8>,
  count: U32,
  operation: ProcessOperation,
) -> Result<String, ProcessError> {
  let builder = BytesBuilder::with_capacity(count)
  while 0u32 {
    index if index < count => {
      builder.append_byte(buffer.get_unchecked(index))
      continue index + 1u32
    }
    _ => {
      let bytes = builder.finish()
      if bytes.is_valid_utf8() {
        break Result::Ok(bytes.to_string())
      } else {
        break Result::Err(
          facet_process_error(operation, ProcessErrorKind::InvalidUtf8, 23u32),
        )
      }
    }
  }
}

fn facet_argument(
  index: U32,
  max_bytes: U32,
) -> Result<String, ProcessError> {
  let operation = ProcessOperation::Arguments
  let length_result = FacetProcessHost.args_len(index)
  let length_error = FacetProcessHost.i64_error(length_result)
  if length_error != 0u32 {
    Result::Err(facet_process_backend_error(operation, length_error))
  } else {
    let length = FacetProcessHost.i64_value(length_result)
    if length > facet_process_u32_to_u64(max_bytes) {
      Result::Err(
        facet_process_error(operation, ProcessErrorKind::LimitExceeded, 17u32),
      )
    } else {
      let count = facet_process_u64_to_u32(length)
      let buffer = FixedArray::make(count, 0u8)
      let read = FacetProcessHost.args_read(index, buffer, count)
      let read_error = FacetProcessHost.i64_error(read)
      let written = FacetProcessHost.i64_value(read)
      if read_error != 0u32 {
        Result::Err(facet_process_backend_error(operation, read_error))
      } else if written != length {
        Result::Err(facet_process_backend_error(operation, 17u32))
      } else {
        facet_text_from_buffer(buffer, count, operation)
      }
    }
  }
}

fn facet_environment_field(
  index: U32,
  field: U32,
  max_bytes: U32,
) -> Result<String, ProcessError> {
  let operation = ProcessOperation::Environment
  let length_result = FacetProcessHost.env_len(index, field)
  let length_error = FacetProcessHost.i64_error(length_result)
  if length_error != 0u32 {
    Result::Err(facet_process_backend_error(operation, length_error))
  } else {
    let length = FacetProcessHost.i64_value(length_result)
    if length > facet_process_u32_to_u64(max_bytes) {
      Result::Err(
        facet_process_error(operation, ProcessErrorKind::LimitExceeded, 17u32),
      )
    } else {
      let count = facet_process_u64_to_u32(length)
      let buffer = FixedArray::make(count, 0u8)
      let read = FacetProcessHost.env_read(index, field, buffer, count)
      let read_error = FacetProcessHost.i64_error(read)
      let written = FacetProcessHost.i64_value(read)
      if read_error != 0u32 {
        Result::Err(facet_process_backend_error(operation, read_error))
      } else if written != length {
        Result::Err(facet_process_backend_error(operation, 17u32))
      } else {
        facet_text_from_buffer(buffer, count, operation)
      }
    }
  }
}

fn facet_write_stream(
  descriptor: FacetProcessI32Result,
  operation: ProcessOperation,
  value: Bytes,
) -> Result<U32, ProcessError> {
  let descriptor_error = FacetProcessHost.i32_error(descriptor)
  if descriptor_error != 0u32 {
    Result::Err(facet_process_backend_error(operation, descriptor_error))
  } else {
    let fd = FacetProcessHost.i32_value(descriptor)
    let buffer = facet_process_buffer(value)
    let length = facet_process_u32_to_u64(buffer.length())
    while 0u64 {
      total if total < length => {
        let write = FacetProcessHost.fd_write(fd, buffer, total, length - total)
        let error = FacetProcessHost.i64_error(write)
        let count = FacetProcessHost.i64_value(write)
        if error != 0u32 || count == 0u64 {
          let reported_error = if error == 0u32 {
            3u32
          } else {
            error
          }
          break Result::Err(
            facet_process_backend_error(operation, reported_error),
          )
        } else {
          continue total + count
        }
      }
      _ => break Result::Ok(buffer.length())
    }
  }
}

impl Process for FacetProcess {
  fn arguments(self, max_count: U32, max_bytes: U32) -> Result<Array<String>, ProcessError> {
    let count_result = FacetProcessHost.args_count()
    let error = FacetProcessHost.i32_error(count_result)
    if error != 0u32 {
      Result::Err(facet_process_backend_error(ProcessOperation::Arguments, error))
    } else {
      let count = FacetProcessHost.i32_value(count_result)
      if count > max_count {
        Result::Err(
          facet_process_error(ProcessOperation::Arguments, ProcessErrorKind::LimitExceeded, 17u32),
        )
      } else {
        let output = Array::with_capacity(count)
        let mut total_bytes = 0u32
        while 0u32 {
          index if index < count => {
            match facet_argument(index, max_bytes - total_bytes) {
              Result::Err(read_error) => break Result::Err(read_error)
              Result::Ok(value) => {
                total_bytes = total_bytes + value.byte_length()
                output.push(value)
                continue index + 1u32
              }
            }
          }
          _ => break Result::Ok(output)
        }
      }
    }
  }

  fn environment(self, name: String, max_bytes: U32) -> Result<Option<String>, ProcessError> {
    let count_result = FacetProcessHost.env_count()
    let count_error = FacetProcessHost.i32_error(count_result)
    if count_error != 0u32 {
      Result::Err(facet_process_backend_error(ProcessOperation::Environment, count_error))
    } else {
      let count = FacetProcessHost.i32_value(count_result)
      while 0u32 {
        index if index < count => {
          match facet_environment_field(index, 0u32, max_bytes) {
            Result::Err(read_error) => break Result::Err(read_error)
            Result::Ok(entry_name) => {
              if entry_name.equals(name) {
                match facet_environment_field(index, 1u32, max_bytes) {
                  Result::Err(read_error) => break Result::Err(read_error)
                  Result::Ok(value) => break Result::Ok(Option::Some(value))
                }
              } else {
                continue index + 1u32
              }
            }
          }
        }
        _ => break Result::Ok(Option::None)
      }
    }
  }

  fn write_stdout(self, value: Bytes) -> Result<U32, ProcessError> {
    facet_write_stream(
      FacetProcessHost.stdio_stdout(),
      ProcessOperation::StandardOutput,
      value,
    )
  }

  fn write_stderr(self, value: Bytes) -> Result<U32, ProcessError> {
    facet_write_stream(
      FacetProcessHost.stdio_stderr(),
      ProcessOperation::StandardError,
      value,
    )
  }

  fn exit(self, status: U32) -> Never {
    FacetProcessHost.proc_exit(status)
    unreachable()
  }
}

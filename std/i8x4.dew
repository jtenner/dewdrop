pub fn i8x4_sub_sat(left: I8x4, right: I8x4) -> I8x4 {
  let a = swar32_to_bits(i8x4_to_swar32(left))
  let b = swar32_to_bits(i8x4_to_swar32(right))
  let dlo = ((a | 8388736u32) - (b & 8323199u32)) ^ ((a ^ (b ^ 4294967295u32)) & 8388736u32)
  let dhi = ((a | 2147516416u32) - (b & 2130738944u32)) ^ ((a ^ (b ^ 4294967295u32)) & 2147516416u32)
  let diff = (dlo & 16711935u32) | (dhi & 4278255360u32)
  let overflow = ((a ^ b) & (a ^ diff) & 2155905152u32) >> 7u32
  let mask = overflow * 255u32

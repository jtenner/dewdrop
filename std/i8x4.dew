  let sum = ((a & 2139062143u32) + (b & 2139062143u32)) ^ ((a ^ b) & 2155905152u32)
  let overflow = (((a ^ b) ^ 4294967295u32) & (a ^ sum) & 2155905152u32) >> 7u32
  let mask = overflow * 255u32
  let limit = (((a & 2155905152u32) >> 7u32) * 255u32) ^ 2139062143u32

open dew.std.wasm.intrinsics

builtin string_as_bytes_unchecked(value: String) -> Bytes = "dew_string_as_bytes"
builtin string_view(value: String, start: U32, length: U32) -> StringView = "dew_string_view"
builtin string_view_as_bytes_unchecked(value: StringView) -> Bytes = "dew_string_view_as_bytes"
builtin string_view_view(value: StringView, start: U32, length: U32) -> StringView = "dew_string_view_view"
builtin string_builder_new() -> StringBuilder = "dew_string_builder_new"
builtin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = "dew_string_builder_with_capacity"
builtin string_builder_byte_length(value: StringBuilder) -> U32 = "dew_string_builder_byte_length"
builtin string_builder_append(value: StringBuilder, part: String) -> Unit = "dew_string_builder_append"
builtin string_builder_append_view(value: StringBuilder, part: StringView) -> Unit = "dew_string_builder_append_view"
builtin string_builder_append_ascii(value: StringBuilder, byte: U8) -> Unit = "dew_string_builder_append_ascii"
builtin string_builder_append_scalar(value: StringBuilder, scalar: U32) -> Unit = "dew_string_builder_append_scalar"
builtin string_builder_finish(value: StringBuilder) -> String = "dew_string_builder_finish"
builtin bytes_builder_new() -> BytesBuilder = "dew_bytes_builder_new"
builtin bytes_builder_with_capacity_raw(capacity: U32) -> BytesBuilder = "dew_bytes_builder_with_capacity"
builtin bytes_builder_byte_length(value: BytesBuilder) -> U32 = "dew_bytes_builder_byte_length"
builtin bytes_builder_append(value: BytesBuilder, part: Bytes) -> Unit = "dew_bytes_builder_append"
builtin bytes_builder_append_byte(value: BytesBuilder, byte: U8) -> Unit = "dew_bytes_builder_append_byte"
builtin bytes_builder_finish(value: BytesBuilder) -> Bytes = "dew_bytes_builder_finish"
builtin bytes_byte_length(value: Bytes) -> U32 = "dew_bytes_byte_length"
builtin bytes_to_string_unchecked(value: Bytes) -> String = "dew_bytes_to_string_unchecked"
builtin bytes_byte_at(value: Bytes, index: U32) -> U8 = "dew_bytes_byte_at"
builtin bytes_view(value: Bytes, start: U32, length: U32) -> Bytes = "dew_bytes_view"

fn bytes_concat(left: Bytes, right: Bytes) -> Bytes {
  let left_length = bytes_byte_length(left)
  let right_length = bytes_byte_length(right)
  if left_length == 0u32 {
    return right
  }
  if right_length == 0u32 {
    return left
  }
  if right_length > 4294967295u32 - left_length {
    unreachable()
  }
  let builder = bytes_builder_with_capacity_raw(left_length + right_length)
  bytes_builder_append(builder, left)
  bytes_builder_append(builder, right)
  bytes_builder_finish(builder)
}

fn string_as_bytes(value: String) -> Bytes {
  string_as_bytes_unchecked(value)
}

fn string_byte_length(value: String) -> U32 {
  bytes_byte_length(string_as_bytes(value))
}

fn string_byte_at(value: String, index: U32) -> U8 {
  bytes_byte_at(string_as_bytes(value), index)
}

fn string_equals(left: String, right: String) -> Bool {
  bytes_equals(string_as_bytes(left), string_as_bytes(right))
}

fn string_utf16_length(value: String) -> U32 {
  text_utf16_length(string_as_bytes(value))
}

fn string_hash(value: String) -> U64 {
  bytes_hash(string_as_bytes(value))
}

fn string_find_raw(value: String, needle: String) -> U32 {
  bytes_find_raw(string_as_bytes(value), string_as_bytes(needle))
}

fn string_find_view_raw(value: String, needle: StringView) -> U32 {
  bytes_find_raw(string_as_bytes(value), string_view_as_bytes(needle))
}

fn string_starts_with(value: String, prefix: String) -> Bool {
  bytes_starts_with(string_as_bytes(value), string_as_bytes(prefix))
}

fn string_starts_with_view(value: String, prefix: StringView) -> Bool {
  bytes_starts_with(string_as_bytes(value), string_view_as_bytes(prefix))
}

fn string_ends_with(value: String, suffix: String) -> Bool {
  bytes_ends_with(string_as_bytes(value), string_as_bytes(suffix))
}

fn string_ends_with_view(value: String, suffix: StringView) -> Bool {
  bytes_ends_with(string_as_bytes(value), string_view_as_bytes(suffix))
}

fn string_concat(left: String, right: String) -> String {
  // Concatenating two valid UTF-8 ranges preserves validity.
  bytes_to_string_unchecked(bytes_concat(string_as_bytes(left), string_as_bytes(right)))
}

fn string_concat_view(left: String, right: StringView) -> String {
  bytes_to_string_unchecked(bytes_concat(string_as_bytes(left), string_view_as_bytes(right)))
}

fn string_view_as_bytes(value: StringView) -> Bytes {
  string_view_as_bytes_unchecked(value)
}

fn string_view_byte_length(value: StringView) -> U32 {
  bytes_byte_length(string_view_as_bytes(value))
}

fn string_view_byte_at(value: StringView, index: U32) -> U8 {
  bytes_byte_at(string_view_as_bytes(value), index)
}

fn string_view_to_string(value: StringView) -> String {
  // A StringView is already a checked UTF-8 range. No copy is needed.
  bytes_to_string_unchecked(string_view_as_bytes(value))
}

// The caller supplies known-valid UTF-8 from a String or StringView.
fn text_utf16_length(value: Bytes) -> U32 {
  let length = bytes_byte_length(value)
  let mut continuations = 0u32
  let mut four_byte_leads = 0u32
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let chunk = wasm_bytes_load_u8x16(value, index)
      let continuation_mask = wasm_u8x16_eq(wasm_u8x16_and(chunk, wasm_u8x16_splat(192u8)), wasm_u8x16_splat(128u8))
      let four_byte_mask = wasm_u8x16_ge_u(chunk, wasm_u8x16_splat(240u8))
      continuations = continuations + wasm_u32_popcnt(wasm_u8x16_bitmask(continuation_mask))
      four_byte_leads = four_byte_leads + wasm_u32_popcnt(wasm_u8x16_bitmask(four_byte_mask))
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      let byte = bytes_byte_at(value, index)
      if byte >= 128u8 && byte < 192u8 {
        continuations = continuations + 1u32
      }
      if byte >= 240u8 {
        four_byte_leads = four_byte_leads + 1u32
      }
      continue index + 1u32
    }
    _ => break ()
  }
  length - continuations + four_byte_leads
}

fn string_view_utf16_length(value: StringView) -> U32 {
  text_utf16_length(string_view_as_bytes(value))
}

fn string_view_equals(left: StringView, right: StringView) -> Bool {
  bytes_equals(string_view_as_bytes(left), string_view_as_bytes(right))
}

fn string_view_hash(value: StringView) -> U64 {
  bytes_hash(string_view_as_bytes(value))
}

fn string_view_find_raw(value: StringView, needle: StringView) -> U32 {
  bytes_find_raw(string_view_as_bytes(value), string_view_as_bytes(needle))
}

fn string_view_find_string_raw(value: StringView, needle: String) -> U32 {
  bytes_find_raw(string_view_as_bytes(value), string_as_bytes(needle))
}

fn string_view_starts_with(value: StringView, prefix: StringView) -> Bool {
  bytes_starts_with(string_view_as_bytes(value), string_view_as_bytes(prefix))
}

fn string_view_starts_with_string(value: StringView, prefix: String) -> Bool {
  bytes_starts_with(string_view_as_bytes(value), string_as_bytes(prefix))
}

fn string_view_ends_with(value: StringView, suffix: StringView) -> Bool {
  bytes_ends_with(string_view_as_bytes(value), string_view_as_bytes(suffix))
}

fn string_view_ends_with_string(value: StringView, suffix: String) -> Bool {
  bytes_ends_with(string_view_as_bytes(value), string_as_bytes(suffix))
}

fn bytes_to_string(value: Bytes) -> String {
  if !bytes_is_valid_utf8(value) {
    unreachable()
  }
  bytes_to_string_unchecked(value)
}

// All callers prove both ranges before this allocation-free comparison.
fn bytes_range_equals(left: Bytes, left_start: U32, right: Bytes, right_start: U32, length: U32) -> Bool {
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let left_chunk = wasm_bytes_load_u8x16(left, left_start + index)
      let right_chunk = wasm_bytes_load_u8x16(right, right_start + index)
      if wasm_u8x16_bitmask(wasm_u8x16_eq(left_chunk, right_chunk)) != 65535u32 {
        return false
      }
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      if bytes_byte_at(left, left_start + index) != bytes_byte_at(right, right_start + index) {
        return false
      }
      continue index + 1u32
    }
    _ => break ()
  }
  true
}

fn bytes_equals(left: Bytes, right: Bytes) -> Bool {
  let length = bytes_byte_length(left)
  length == bytes_byte_length(right) && bytes_range_equals(left, 0u32, right, 0u32, length)
}

fn bytes_starts_with(left: Bytes, prefix: Bytes) -> Bool {
  let length = bytes_byte_length(prefix)
  length <= bytes_byte_length(left) && bytes_range_equals(left, 0u32, prefix, 0u32, length)
}

fn bytes_ends_with(left: Bytes, suffix: Bytes) -> Bool {
  let length = bytes_byte_length(left)
  let suffix_length = bytes_byte_length(suffix)
  suffix_length <= length && bytes_range_equals(left, length - suffix_length, suffix, 0u32, suffix_length)
}

fn bytes_widen_byte(value: U8) -> U64 {
  value.into()
}

fn bytes_hash_chunk(initial: U64, chunk: U8x16) -> U64 {
  let mut hash = initial
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_0(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_1(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_2(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_3(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_4(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_5(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_6(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_7(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_8(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_9(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_10(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_11(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_12(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_13(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_14(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_15(chunk))) * 1099511628211u64
  hash
}

fn bytes_hash(value: Bytes) -> U64 {
  let length = bytes_byte_length(value)
  let mut hash = 14695981039346656037u64
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      hash = bytes_hash_chunk(hash, wasm_bytes_load_u8x16(value, index))
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      hash = (hash ^ bytes_widen_byte(bytes_byte_at(value, index))) * 1099511628211u64
      continue index + 1u32
    }
    _ => break ()
  }
  hash
}

fn bytes_find_byte_raw(value: Bytes, byte: U8) -> U32 {
  let length = bytes_byte_length(value)
  let wanted = wasm_u8x16_splat(byte)
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let mask = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, index), wanted))
      if mask != 0u32 {
        return index + wasm_u32_ctz(mask)
      }
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      if bytes_byte_at(value, index) == byte {
        return index
      }
      continue index + 1u32
    }
    _ => break 4294967295u32
  }
}

fn bytes_find_short(value: Bytes, needle: Bytes, needle_length: U32, limit: U32) -> U32 {
  let first = wasm_u8x16_splat(bytes_byte_at(needle, 0u32))
  let last = wasm_u8x16_splat(bytes_byte_at(needle, needle_length - 1u32))
  while 0u32 {
    candidate if candidate <= limit => {
      if limit - candidate >= 15u32 {
        let heads = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate), first))
        let tails = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate + needle_length - 1u32), last))
        while heads & tails {
          mask if mask != 0u32 => {
            let index = candidate + wasm_u32_ctz(mask)
            if bytes_range_equals(value, index, needle, 0u32, needle_length) {
              return index
            }
            continue mask & (mask - 1u32)
          }
          _ => break ()
        }
        continue candidate + 16u32
      }
      if bytes_range_equals(value, candidate, needle, 0u32, needle_length) {
        return candidate
      }
      continue candidate + 1u32
    }
    _ => break 4294967295u32
  }
}

fn bytes_find_raw(value: Bytes, needle: Bytes) -> U32 {
  let length = bytes_byte_length(value)
  let needle_length = bytes_byte_length(needle)
  if needle_length == 0u32 {
    return 0u32
  }
  if needle_length > length {
    return 4294967295u32
  }
  if needle_length == 1u32 {
    return bytes_find_byte_raw(value, bytes_byte_at(needle, 0u32))
  }
  let limit = length - needle_length
  if needle_length <= 16u32 {
    return bytes_find_short(value, needle, needle_length, limit)
  }
  // Rolling hashes reject most long candidates in constant time. A hash match
  // is only a candidate: compare the bytes before reporting a match.
  let mut needle_hash = 0u64
  let mut window_hash = 0u64
  let mut power = 1u64
  while 0u32 {
    index if index < needle_length => {
      needle_hash = needle_hash * 257u64 + bytes_widen_byte(bytes_byte_at(needle, index))
      window_hash = window_hash * 257u64 + bytes_widen_byte(bytes_byte_at(value, index))
      if index < needle_length - 1u32 {
        power = power * 257u64
      }
      continue index + 1u32
    }
    _ => break ()
  }
  while 0u32 {
    candidate => {
      if window_hash == needle_hash && bytes_range_equals(value, candidate, needle, 0u32, needle_length) {
        return candidate
      }
      if candidate == limit {
        break 4294967295u32
      }
      window_hash = (window_hash - bytes_widen_byte(bytes_byte_at(value, candidate)) * power) * 257u64 + bytes_widen_byte(bytes_byte_at(value, candidate + needle_length))
      continue candidate + 1u32
    }
  }
}

fn bytes_utf8_continuation(byte: U8) -> Bool {
  byte >= 128u8 && byte <= 191u8
}

fn bytes_is_valid_utf8(value: Bytes) -> Bool {
  let length = bytes_byte_length(value)
  while 0u32 {
    index if index < length => {
      let remaining = length - index
      if remaining >= 16u32 && wasm_u8x16_bitmask(wasm_bytes_load_u8x16(value, index)) == 0u32 {
        continue index + 16u32
      }
      let first = bytes_byte_at(value, index)
      if first < 128u8 {
        continue index + 1u32
      }
      if first < 194u8 || first > 244u8 {
        return false
      }
      if first < 224u8 {
        if remaining < 2u32 || !bytes_utf8_continuation(bytes_byte_at(value, index + 1u32)) {
          return false
        }
        continue index + 2u32
      }
      if first < 240u8 {
        if remaining < 3u32 {
          return false
        }
        let second = bytes_byte_at(value, index + 1u32)
        if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) {
          return false
        }
        if (first == 224u8 && second < 160u8) || (first == 237u8 && second >= 160u8) {
          return false
        }
        continue index + 3u32
      }
      if remaining < 4u32 {
        return false
      }
      let second = bytes_byte_at(value, index + 1u32)
      if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) || !bytes_utf8_continuation(bytes_byte_at(value, index + 3u32)) {
        return false
      }
      if (first == 240u8 && second < 144u8) || (first == 244u8 && second >= 144u8) {
        return false
      }
      continue index + 4u32
    }
    _ => break true
  }
}

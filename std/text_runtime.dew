open dew.std.wasm.intrinsics

pub fn string_as_bytes_unchecked(value: String) -> Bytes {
  __dew_text_bytes(value)
}
pub fn string_view(value: String, start: U32, length: U32) -> StringView {
  string_view_range(string_as_bytes_unchecked(value), start, length)
}
pub builtin string_view_as_bytes_unchecked(value: StringView) -> Bytes = "ref.cast"
pub fn string_view_view(value: StringView, start: U32, length: U32) -> StringView {
  string_view_range(string_view_as_bytes_unchecked(value), start, length)
}

builtin string_view_range_value(value: Bytes) -> StringView = "ref.cast"

fn string_view_range(value: Bytes, start: U32, length: U32) -> StringView {
  let range = bytes_view(value, start, length)
  let source_length = bytes_byte_length(value)
  // The checked Bytes view proves start + length <= source_length.
  let end = start + length
  if start > 0u32 && start < source_length && (bytes_byte_at(value, start) & 192u8) == 128u8 {
    unreachable()
  }
  if end < source_length && (bytes_byte_at(value, end) & 192u8) == 128u8 {
    unreachable()
  }
  string_view_range_value(range)
}
pub fn string_builder_new() -> StringBuilder {
  string_builder_with_capacity_raw(64u32)
}
pub builtin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = "dew_string_builder_with_capacity"
builtin string_builder_length_raw(value: StringBuilder) -> U32 = "struct.get 1"
builtin string_builder_consumed_raw(value: StringBuilder) -> U32 = "struct.get 2"
pub fn string_builder_byte_length(value: StringBuilder) -> U32 {
  if string_builder_consumed_raw(value) != 0u32 {
    unreachable()
  }
  string_builder_length_raw(value)
}
builtin string_builder_bytes_raw(value: StringBuilder) -> BytesBuilder = "ref.cast"
pub fn string_builder_append(value: StringBuilder, part: String) -> Unit {
  bytes_builder_append(string_builder_bytes_raw(value), string_as_bytes_unchecked(part))
}
pub fn string_builder_append_view(value: StringBuilder, part: StringView) -> Unit {
  bytes_builder_append(string_builder_bytes_raw(value), string_view_as_bytes_unchecked(part))
}
pub fn string_builder_append_ascii(value: StringBuilder, byte: U8) -> Unit {
  if byte > 127u8 {
    unreachable()
  }
  bytes_builder_append_byte(string_builder_bytes_raw(value), byte)
}
pub builtin string_builder_append_scalar(value: StringBuilder, scalar: U32) -> Unit = "dew_string_builder_append_scalar"
pub builtin string_builder_finish(value: StringBuilder) -> String = "dew_string_builder_finish"
pub fn bytes_builder_new() -> BytesBuilder {
  bytes_builder_with_capacity_raw(64u32)
}
pub fn bytes_builder_with_capacity_raw(capacity: U32) -> BytesBuilder {
  bytes_builder_value(BytesBuilderStorage::{
    chunks: wasm_array_new_default::<V128>(bytes_storage_chunk_count(capacity))
    length: 0u32
    consumed: 0u32
  })
}
builtin bytes_builder_length_raw(value: BytesBuilder) -> U32 = "struct.get 1"
builtin bytes_builder_consumed_raw(value: BytesBuilder) -> U32 = "struct.get 2"
pub fn bytes_builder_byte_length(value: BytesBuilder) -> U32 {
  if bytes_builder_consumed_raw(value) != 0u32 {
    unreachable()
  }
  bytes_builder_length_raw(value)
}
pub fn bytes_builder_append(value: BytesBuilder, part: Bytes) -> Unit {
  let target = bytes_builder_storage(value)
  let source = bytes_view_storage(part)
  let old_length = target.length
  let required_length = bytes_builder_reserve(target, source.length)
  let tail = if (old_length & 15u32) == 0u32 && (source.start & 15u32) == 0u32 {
    let count = source.length >> 4u32
    wasm_array_copy(target.chunks, old_length >> 4u32, source.chunks, source.start >> 4u32, count)
    count << 4u32
  } else {
    while 0u32 {
      index if source.length - index >= 16u32 => {
        let vector = bytes_storage_read_vector(source.chunks, source.start + index)
        bytes_storage_write_vector(target.chunks, old_length + index, vector)
        continue index + 16u32
      }
      index => break index
    }
  }
  while tail {
    index if index < source.length => {
      bytes_storage_write_byte(target.chunks, old_length + index, bytes_byte_at(part, index))
      continue index + 1u32
    }
    _ => break ()
  }
  target.length = required_length
}
pub fn bytes_builder_append_byte(value: BytesBuilder, byte: U8) -> Unit {
  let target = bytes_builder_storage(value)
  let required_length = bytes_builder_reserve(target, 1u32)
  bytes_storage_write_byte(target.chunks, target.length, byte)
  target.length = required_length
}
pub fn bytes_builder_finish(value: BytesBuilder) -> Bytes {
  let source = bytes_builder_storage(value)
  if source.consumed != 0u32 {
    unreachable()
  }
  source.consumed = 1u32
  bytes_view_value(BytesViewStorage::{
    chunks: source.chunks
    start: 0u32
    length: source.length
  })
}

struct BytesBuilderStorage {
  mut chunks: WasmArray<V128>
  mut length: U32
  mut consumed: U32
}

builtin bytes_builder_storage(value: BytesBuilder) -> BytesBuilderStorage = "ref.cast"
builtin bytes_builder_value(value: BytesBuilderStorage) -> BytesBuilder = "ref.cast"

fn bytes_storage_chunk_count(length: U32) -> U32 {
  let whole = length >> 4u32
  if (length & 15u32) == 0u32 {
    whole
  } else {
    whole + 1u32
  }
}

// Check all logical length arithmetic before allocating or changing storage.
fn bytes_builder_reserve(value: BytesBuilderStorage, additional: U32) -> U32 {
  if value.consumed != 0u32 || additional > 4294967295u32 - value.length {
    unreachable()
  }
  let required_length = value.length + additional
  let required_chunks = bytes_storage_chunk_count(required_length)
  let capacity = wasm_array_len(value.chunks)
  if required_chunks > capacity {
    let doubled = if capacity > 134217728u32 {
      268435456u32
    } else {
      capacity * 2u32
    }
    let next_capacity = if doubled < required_chunks {
      required_chunks
    } else {
      doubled
    }
    let chunks = wasm_array_new_default::<V128>(next_capacity)
    wasm_array_copy(chunks, 0u32, value.chunks, 0u32, bytes_storage_chunk_count(value.length))
    value.chunks = chunks
  }
  required_length
}

fn bytes_storage_lane_indices() -> U8x16 {
  let low = wasm_u64x2_splat(506097522914230528u64)
  unsafe_bitcast::<U64x2, U8x16>(wasm_u64x2_replace_1(low, 1084818905618843912u64))
}

// The caller proves that sixteen logical bytes are available.
fn bytes_storage_read_vector(chunks: WasmArray<V128>, index: U32) -> U8x16 {
  let slot = index >> 4u32
  let first = unsafe_bitcast::<V128, U8x16>(wasm_array_get(chunks, slot))
  let offset = index & 15u32
  if offset == 0u32 {
    first
  } else {
    let indices = wasm_u8x16_add(bytes_storage_lane_indices(), wasm_u8x16_splat(offset.into()))
    let second = unsafe_bitcast::<V128, U8x16>(wasm_array_get(chunks, slot + 1u32))
    wasm_u8x16_or(wasm_u8x16_swizzle(first, indices), wasm_u8x16_swizzle(second, wasm_u8x16_sub(indices, wasm_u8x16_splat(16u8))))
  }
}

// Preserve bytes outside the logical write, including zero padding at the end.
fn bytes_storage_write_vector(chunks: WasmArray<V128>, index: U32, vector: U8x16) -> Unit {
  let slot = index >> 4u32
  let offset = index & 15u32
  if offset == 0u32 {
    wasm_array_set(chunks, slot, unsafe_bitcast::<U8x16, V128>(vector))
  } else {
    let lanes = bytes_storage_lane_indices()
    let shift = wasm_u8x16_splat(offset.into())
    let mask = wasm_u8x16_lt_u(lanes, shift)
    let first = unsafe_bitcast::<V128, U8x16>(wasm_array_get(chunks, slot))
    let low = wasm_u8x16_swizzle(vector, wasm_u8x16_sub(lanes, shift))
    wasm_array_set(chunks, slot, unsafe_bitcast::<U8x16, V128>(wasm_u8x16_bitselect(first, low, mask)))
    let second = unsafe_bitcast::<V128, U8x16>(wasm_array_get(chunks, slot + 1u32))
    let high = wasm_u8x16_swizzle(vector, wasm_u8x16_add(lanes, wasm_u8x16_splat((16u32 - offset).into())))
    wasm_array_set(chunks, slot + 1u32, unsafe_bitcast::<U8x16, V128>(wasm_u8x16_bitselect(high, second, mask)))
  }
}

fn bytes_storage_write_byte(chunks: WasmArray<V128>, index: U32, byte: U8) -> Unit {
  let slot = index >> 4u32
  let prior = unsafe_bitcast::<V128, U8x16>(wasm_array_get(chunks, slot))
  let mask = wasm_u8x16_eq(bytes_storage_lane_indices(), wasm_u8x16_splat((index & 15u32).into()))
  let vector = wasm_u8x16_bitselect(wasm_u8x16_splat(byte), prior, mask)
  wasm_array_set(chunks, slot, unsafe_bitcast::<U8x16, V128>(vector))
}
pub fn bytes_byte_length(value: Bytes) -> U32 {
  __dew_text_byte_length(value)
}
pub builtin bytes_to_string_unchecked(value: Bytes) -> String = "ref.cast"
pub fn bytes_byte_at(value: Bytes, index: U32) -> U8 {
  let source = bytes_view_storage(value)
  if index >= source.length || index > 4294967295u32 - source.start {
    unreachable()
  }
  let absolute = source.start + index
  let chunk = wasm_array_get(source.chunks, absolute >> 4u32)
  let indices = wasm_u8x16_splat((absolute & 15u32).into())
  let lanes = unsafe_bitcast::<V128, U8x16>(chunk)
  wasm_u8x16_extract_0(wasm_u8x16_swizzle(lanes, indices))
}
struct BytesViewStorage {
  chunks: WasmArray<V128>
  start: U32
  length: U32
}

builtin bytes_view_storage(value: Bytes) -> BytesViewStorage = "ref.cast"
builtin bytes_view_value(value: BytesViewStorage) -> Bytes = "ref.cast"

pub fn bytes_view(value: Bytes, start: U32, length: U32) -> Bytes {
  let source = bytes_view_storage(value)
  if start > source.length || length > source.length - start {
    unreachable()
  }
  if start > 4294967295u32 - source.start {
    unreachable()
  }
  bytes_view_value(BytesViewStorage::{
    chunks: source.chunks
    start: source.start + start
    length: length
  })
}

pub fn bytes_concat(left: Bytes, right: Bytes) -> Bytes {
  let left_length = bytes_byte_length(left)
  let right_length = bytes_byte_length(right)
  if left_length == 0u32 {
    return right
  }
  if right_length == 0u32 {
    return left
  }
  if right_length > 4294967295u32 - left_length {
    unreachable()
  }
  let builder = bytes_builder_with_capacity_raw(left_length + right_length)
  bytes_builder_append(builder, left)
  bytes_builder_append(builder, right)
  bytes_builder_finish(builder)
}

pub fn string_as_bytes(value: String) -> Bytes {
  string_as_bytes_unchecked(value)
}

pub fn string_byte_length(value: String) -> U32 {
  bytes_byte_length(string_as_bytes(value))
}

pub fn string_byte_at(value: String, index: U32) -> U8 {
  bytes_byte_at(string_as_bytes(value), index)
}

pub fn string_equals(left: String, right: String) -> Bool {
  bytes_equals(string_as_bytes(left), string_as_bytes(right))
}

pub fn string_utf16_length(value: String) -> U32 {
  text_utf16_length(string_as_bytes(value))
}

pub fn string_hash(value: String) -> U64 {
  bytes_hash(string_as_bytes(value))
}

pub fn string_find_raw(value: String, needle: String) -> U32 {
  bytes_find_raw(string_as_bytes(value), string_as_bytes(needle))
}

pub fn string_find_view_raw(value: String, needle: StringView) -> U32 {
  bytes_find_raw(string_as_bytes(value), string_view_as_bytes(needle))
}

pub fn string_starts_with(value: String, prefix: String) -> Bool {
  bytes_starts_with(string_as_bytes(value), string_as_bytes(prefix))
}

pub fn string_starts_with_view(value: String, prefix: StringView) -> Bool {
  bytes_starts_with(string_as_bytes(value), string_view_as_bytes(prefix))
}

pub fn string_ends_with(value: String, suffix: String) -> Bool {
  bytes_ends_with(string_as_bytes(value), string_as_bytes(suffix))
}

pub fn string_ends_with_view(value: String, suffix: StringView) -> Bool {
  bytes_ends_with(string_as_bytes(value), string_view_as_bytes(suffix))
}

pub fn string_concat(left: String, right: String) -> String {
  // Concatenating two valid UTF-8 ranges preserves validity.
  bytes_to_string_unchecked(bytes_concat(string_as_bytes(left), string_as_bytes(right)))
}

pub fn string_concat_view(left: String, right: StringView) -> String {
  bytes_to_string_unchecked(bytes_concat(string_as_bytes(left), string_view_as_bytes(right)))
}

pub fn string_view_as_bytes(value: StringView) -> Bytes {
  string_view_as_bytes_unchecked(value)
}

pub fn string_view_byte_length(value: StringView) -> U32 {
  bytes_byte_length(string_view_as_bytes(value))
}

pub fn string_view_byte_at(value: StringView, index: U32) -> U8 {
  bytes_byte_at(string_view_as_bytes(value), index)
}

pub fn string_view_to_string(value: StringView) -> String {
  // A StringView is already a checked UTF-8 range. No copy is needed.
  bytes_to_string_unchecked(string_view_as_bytes(value))
}

// The caller supplies known-valid UTF-8 from a String or StringView.
pub fn text_utf16_length(value: Bytes) -> U32 {
  let length = bytes_byte_length(value)
  let mut continuations = 0u32
  let mut four_byte_leads = 0u32
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let chunk = wasm_bytes_load_u8x16(value, index)
      let continuation_mask = wasm_u8x16_eq(wasm_u8x16_and(chunk, wasm_u8x16_splat(192u8)), wasm_u8x16_splat(128u8))
      let four_byte_mask = wasm_u8x16_ge_u(chunk, wasm_u8x16_splat(240u8))
      continuations = continuations + wasm_u32_popcnt(wasm_u8x16_bitmask(continuation_mask))
      four_byte_leads = four_byte_leads + wasm_u32_popcnt(wasm_u8x16_bitmask(four_byte_mask))
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      let byte = bytes_byte_at(value, index)
      if byte >= 128u8 && byte < 192u8 {
        continuations = continuations + 1u32
      }
      if byte >= 240u8 {
        four_byte_leads = four_byte_leads + 1u32
      }
      continue index + 1u32
    }
    _ => break ()
  }
  length - continuations + four_byte_leads
}

pub fn string_view_utf16_length(value: StringView) -> U32 {
  text_utf16_length(string_view_as_bytes(value))
}

pub fn string_view_equals(left: StringView, right: StringView) -> Bool {
  bytes_equals(string_view_as_bytes(left), string_view_as_bytes(right))
}

pub fn string_view_hash(value: StringView) -> U64 {
  bytes_hash(string_view_as_bytes(value))
}

pub fn string_view_find_raw(value: StringView, needle: StringView) -> U32 {
  bytes_find_raw(string_view_as_bytes(value), string_view_as_bytes(needle))
}

pub fn string_view_find_string_raw(value: StringView, needle: String) -> U32 {
  bytes_find_raw(string_view_as_bytes(value), string_as_bytes(needle))
}

pub fn string_view_starts_with(value: StringView, prefix: StringView) -> Bool {
  bytes_starts_with(string_view_as_bytes(value), string_view_as_bytes(prefix))
}

pub fn string_view_starts_with_string(value: StringView, prefix: String) -> Bool {
  bytes_starts_with(string_view_as_bytes(value), string_as_bytes(prefix))
}

pub fn string_view_ends_with(value: StringView, suffix: StringView) -> Bool {
  bytes_ends_with(string_view_as_bytes(value), string_view_as_bytes(suffix))
}

pub fn string_view_ends_with_string(value: StringView, suffix: String) -> Bool {
  bytes_ends_with(string_view_as_bytes(value), string_as_bytes(suffix))
}

pub fn bytes_to_string(value: Bytes) -> String {
  if !bytes_is_valid_utf8(value) {
    unreachable()
  }
  bytes_to_string_unchecked(value)
}

// All callers prove both ranges before this allocation-free comparison.
pub fn bytes_range_equals(left: Bytes, left_start: U32, right: Bytes, right_start: U32, length: U32) -> Bool {
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let left_chunk = wasm_bytes_load_u8x16(left, left_start + index)
      let right_chunk = wasm_bytes_load_u8x16(right, right_start + index)
      if wasm_u8x16_bitmask(wasm_u8x16_eq(left_chunk, right_chunk)) != 65535u32 {
        return false
      }
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      if bytes_byte_at(left, left_start + index) != bytes_byte_at(right, right_start + index) {
        return false
      }
      continue index + 1u32
    }
    _ => break ()
  }
  true
}

pub fn bytes_equals(left: Bytes, right: Bytes) -> Bool {
  let length = bytes_byte_length(left)
  length == bytes_byte_length(right) && bytes_range_equals(left, 0u32, right, 0u32, length)
}

pub fn bytes_starts_with(left: Bytes, prefix: Bytes) -> Bool {
  let length = bytes_byte_length(prefix)
  length <= bytes_byte_length(left) && bytes_range_equals(left, 0u32, prefix, 0u32, length)
}

pub fn bytes_ends_with(left: Bytes, suffix: Bytes) -> Bool {
  let length = bytes_byte_length(left)
  let suffix_length = bytes_byte_length(suffix)
  suffix_length <= length && bytes_range_equals(left, length - suffix_length, suffix, 0u32, suffix_length)
}

pub fn bytes_widen_byte(value: U8) -> U64 {
  value.into()
}

pub fn bytes_hash_chunk(initial: U64, chunk: U8x16) -> U64 {
  let mut hash = initial
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_0(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_1(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_2(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_3(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_4(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_5(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_6(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_7(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_8(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_9(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_10(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_11(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_12(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_13(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_14(chunk))) * 1099511628211u64
  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_15(chunk))) * 1099511628211u64
  hash
}

pub fn bytes_hash(value: Bytes) -> U64 {
  let length = bytes_byte_length(value)
  let mut hash = 14695981039346656037u64
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      hash = bytes_hash_chunk(hash, wasm_bytes_load_u8x16(value, index))
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      hash = (hash ^ bytes_widen_byte(bytes_byte_at(value, index))) * 1099511628211u64
      continue index + 1u32
    }
    _ => break ()
  }
  hash
}

pub fn bytes_find_byte_raw(value: Bytes, byte: U8) -> U32 {
  let length = bytes_byte_length(value)
  let wanted = wasm_u8x16_splat(byte)
  let tail = while 0u32 {
    index if length - index >= 16u32 => {
      let mask = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, index), wanted))
      if mask != 0u32 {
        return index + wasm_u32_ctz(mask)
      }
      continue index + 16u32
    }
    index => break index
  }
  while tail {
    index if index < length => {
      if bytes_byte_at(value, index) == byte {
        return index
      }
      continue index + 1u32
    }
    _ => break 4294967295u32
  }
}

pub fn bytes_find_short(value: Bytes, needle: Bytes, needle_length: U32, limit: U32) -> U32 {
  let first = wasm_u8x16_splat(bytes_byte_at(needle, 0u32))
  let last = wasm_u8x16_splat(bytes_byte_at(needle, needle_length - 1u32))
  while 0u32 {
    candidate if candidate <= limit => {
      if limit - candidate >= 15u32 {
        let heads = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate), first))
        let tails = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate + needle_length - 1u32), last))
        while heads & tails {
          mask if mask != 0u32 => {
            let index = candidate + wasm_u32_ctz(mask)
            if bytes_range_equals(value, index, needle, 0u32, needle_length) {
              return index
            }
            continue mask & (mask - 1u32)
          }
          _ => break ()
        }
        continue candidate + 16u32
      }
      if bytes_range_equals(value, candidate, needle, 0u32, needle_length) {
        return candidate
      }
      continue candidate + 1u32
    }
    _ => break 4294967295u32
  }
}

pub fn bytes_find_raw(value: Bytes, needle: Bytes) -> U32 {
  let length = bytes_byte_length(value)
  let needle_length = bytes_byte_length(needle)
  if needle_length == 0u32 {
    return 0u32
  }
  if needle_length > length {
    return 4294967295u32
  }
  if needle_length == 1u32 {
    return bytes_find_byte_raw(value, bytes_byte_at(needle, 0u32))
  }
  let limit = length - needle_length
  if needle_length <= 16u32 {
    return bytes_find_short(value, needle, needle_length, limit)
  }
  // Rolling hashes reject most long candidates in constant time. A hash match
  // is only a candidate: compare the bytes before reporting a match.
  let mut needle_hash = 0u64
  let mut window_hash = 0u64
  let mut power = 1u64
  while 0u32 {
    index if index < needle_length => {
      needle_hash = needle_hash * 257u64 + bytes_widen_byte(bytes_byte_at(needle, index))
      window_hash = window_hash * 257u64 + bytes_widen_byte(bytes_byte_at(value, index))
      if index < needle_length - 1u32 {
        power = power * 257u64
      }
      continue index + 1u32
    }
    _ => break ()
  }
  while 0u32 {
    candidate => {
      if window_hash == needle_hash && bytes_range_equals(value, candidate, needle, 0u32, needle_length) {
        return candidate
      }
      if candidate == limit {
        break 4294967295u32
      }
      window_hash = (window_hash - bytes_widen_byte(bytes_byte_at(value, candidate)) * power) * 257u64 + bytes_widen_byte(bytes_byte_at(value, candidate + needle_length))
      continue candidate + 1u32
    }
  }
}

pub fn bytes_utf8_continuation(byte: U8) -> Bool {
  byte >= 128u8 && byte <= 191u8
}

pub fn bytes_is_valid_utf8(value: Bytes) -> Bool {
  let length = bytes_byte_length(value)
  while 0u32 {
    index if index < length => {
      let remaining = length - index
      if remaining >= 16u32 && wasm_u8x16_bitmask(wasm_bytes_load_u8x16(value, index)) == 0u32 {
        continue index + 16u32
      }
      let first = bytes_byte_at(value, index)
      if first < 128u8 {
        continue index + 1u32
      }
      if first < 194u8 || first > 244u8 {
        return false
      }
      if first < 224u8 {
        if remaining < 2u32 || !bytes_utf8_continuation(bytes_byte_at(value, index + 1u32)) {
          return false
        }
        continue index + 2u32
      }
      if first < 240u8 {
        if remaining < 3u32 {
          return false
        }
        let second = bytes_byte_at(value, index + 1u32)
        if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) {
          return false
        }
        if (first == 224u8 && second < 160u8) || (first == 237u8 && second >= 160u8) {
          return false
        }
        continue index + 3u32
      }
      if remaining < 4u32 {
        return false
      }
      let second = bytes_byte_at(value, index + 1u32)
      if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) || !bytes_utf8_continuation(bytes_byte_at(value, index + 3u32)) {
        return false
      }
      if (first == 240u8 && second < 144u8) || (first == 244u8 && second >= 144u8) {
        return false
      }
      continue index + 4u32
    }
    _ => break true
  }
}

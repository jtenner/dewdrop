+									defer table.Close()
+									tableImport := append(append(wasmtest.Name("env"), wasmtest.Name("table")...), byte(wasm.ExternTable), 0x70, 1, 1, 1)
+									wantRelay := byte(7)
+									if relayObject {
+										wantRelay = 47

enum Bit {
  Zero
  One
}
enum Box {
  Wrap(Bit)
}
pub fn classify(flag: Bool) -> I32 {
  let value = if flag {
    Wrap(Zero)
  } else {
    Wrap(One)
  }
  match value {
    Wrap(Zero) => 0
    Wrap(One) => 1
  }
}
pub fn pair(a: Bool, b: Bool) -> I32 {
  match (a, b) {
    (true, _) => 10
    (false, true) => 20
    (false, false) => 30
  }
}
pub fn main() -> I32 {
  classify(false)
}

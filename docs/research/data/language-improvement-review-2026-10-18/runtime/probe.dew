open dew.std.json
open dew.std.map
open dew.std.string

pub fn raw_custom_limit() -> U32 {
  let source = "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[null]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
  let limits = JsonLimits::{
max_input_bytes: 1000u32
max_depth: 130u32
max_values: 1000u32
max_string_bytes: 1000u32
}
  match json_parse_raw_document_with_limits(source, limits) {
    Result::Err(_) => 1u32
    Result::Ok(document) => match document.materialize() {
      Result::Ok(_) => 0u32
      Result::Err(JsonParseError::DepthLimitExceeded(depth)) => depth
      Result::Err(_) => 2u32
    }
  }
}
pub fn map_saved_entry() -> U32 {
  let map = Map::singleton(1u32, 10u32)
  let iter = map.entries()
  match iter.next() {
    Option::None => 999u32
    Option::Some(entry) => {
      map.insert(1u32, 20u32)
      entry.value()
    }
  }
}
pub fn forged_number() -> U32 {
  let value = JsonValue::ValidatedNumber(JsonNumber::{
lexeme: "BAD"
})
  match json_stringify(value) {
    Result::Ok(text) => if text.equals("BAD") {
1u32
} else {
2u32
}
    Result::Err(_) => 0u32
  }
}
pub fn forged_string() -> U32 {
  let value = JsonValue::ValidatedString(JsonString::{
value: "a\"b"
needs_escape: false
})
  match json_stringify(value) {
    Result::Ok(text) => match json_validate(text) {
      Result::Ok(_) => 0u32
      Result::Err(_) => 1u32
    }
    Result::Err(_) => 2u32
  }
}

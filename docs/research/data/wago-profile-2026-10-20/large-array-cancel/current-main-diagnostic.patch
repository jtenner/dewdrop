+package diagnosticprofile
+import("encoding/binary";"encoding/json";"fmt";"os";"path/filepath";"runtime";"runtime/pprof";"sync";"time";wago "github.com/wago-org/wago")
+var once sync.Once
+var cpu *os.File
+var dir string
+var epoch=time.Now()
+func Event(name string, fields map[string]any) {if fields==nil {fields=map[string]any{}};fields["event"]=name;fields["elapsed_s"]=time.Since(epoch).Seconds();data,err:=json.Marshal(fields);if err!=nil {panic(err)};fmt.Fprintln(os.Stderr,"WAGO_DIAG "+string(data))}
+func Start(){dir=os.Getenv("DEW_WAGO_PROFILE_DIR");if dir=="" {return};if err:=os.MkdirAll(dir,0755);err!=nil {panic(err)};var err error;cpu,err=os.Create(filepath.Join(dir,"cpu.pprof"));if err!=nil {panic(err)};if err=pprof.StartCPUProfile(cpu);err!=nil {panic(err)};Event("start",map[string]any{"gomaxprocs":runtime.GOMAXPROCS(0)})}
+func Finish(){once.Do(func(){if cpu==nil{return};pprof.StopCPUProfile();if err:=cpu.Close();err!=nil{panic(err)};var mem runtime.MemStats;runtime.ReadMemStats(&mem);Event("go_memory",map[string]any{"heap_alloc":mem.HeapAlloc,"total_alloc":mem.TotalAlloc,"mallocs":mem.Mallocs,"num_gc":mem.NumGC,"pause_total_ns":mem.PauseTotalNs});for _,name:=range []string{"heap","allocs"}{f,err:=os.Create(filepath.Join(dir,name+".pprof"));if err!=nil{panic(err)};if err=pprof.Lookup(name).WriteTo(f,0);err!=nil{panic(err)};f.Close()}})}
+func Snapshot(in *wago.Instance){if in==nil{return};if data,ok:=in.Read(0,80);ok&&binary.LittleEndian.Uint64(data)==4919706420659244884 {Event("invariant",map[string]any{"version":binary.LittleEndian.Uint64(data[8:]),"code":binary.LittleEndian.Uint32(data[16:]),"phase":binary.LittleEndian.Uint32(data[20:]),"module_id":binary.LittleEndian.Uint64(data[24:]),"declaration":binary.LittleEndian.Uint64(data[32:]),"body":binary.LittleEndian.Uint64(data[40:]),"expression":binary.LittleEndian.Uint32(data[48:]),"expected":binary.LittleEndian.Uint64(data[56:]),"actual":binary.LittleEndian.Uint64(data[64:]),"detail":binary.LittleEndian.Uint64(data[72:])})}}

@@ -0,0 +1,5 @@
+package gc
+import "sync/atomic"
+var dewDistances [8][2]atomic.Uint64
+func dewRecordLargeCancelDistance(distance,scan int){bucket:=7;switch {case distance==0:bucket=0;case distance==1:bucket=1;case distance>=2&&distance<=16:bucket=2;case distance>16&&distance<=64:bucket=3;case distance>64&&distance<=512:bucket=4;case distance>512&&distance<=4096:bucket=5;case distance>4096:bucket=6};dewDistances[bucket][0].Add(1);dewDistances[bucket][1].Add(uint64(scan))}
+func DewLargeCancelDistances() [8][2]uint64{var out [8][2]uint64;for i:=range out {out[i]=[2]uint64{dewDistances[i][0].Load(),dewDistances[i][1].Load()}};return out}

@@ -0,0 +1,114 @@
+package diagnosticprofile
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	wago "github.com/wago-org/wago"
+	"os"
+	"path/filepath"
+	"runtime"
+	"runtime/pprof"
+	"sync"
+	"time"
+)
+
+var mu sync.Mutex
+var epoch = time.Now()
+var stopProfile func()
+var stopOnce sync.Once
+
+func Finish() {
+	stopOnce.Do(func() {
+		if stopProfile != nil {
+			stopProfile()
+		}
+	})
+}
+
+func Event(name string, fields map[string]any) {
+	if os.Getenv("DEW_WAGO_DIAG") == "" {
+		return
+	}
+	if fields == nil {
+		fields = map[string]any{}
+	}
+	fields["event"] = name
+	fields["since_start_s"] = time.Since(epoch).Seconds()
+	data, err := json.Marshal(fields)
+	if err != nil {
+		panic(err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	fmt.Fprintln(os.Stderr, "WAGO_DIAG "+string(data))
+}
+func Begin(name string) func() {
+	start := time.Now()
+	pprof.SetGoroutineLabels(pprof.WithLabels(context.Background(), pprof.Labels("phase", name)))
+	Event("begin", map[string]any{"phase": name})
+	return func() {
+		Event("end", map[string]any{"phase": name, "seconds": time.Since(start).Seconds()})
+		pprof.SetGoroutineLabels(context.Background())
+	}
+}
+func Snapshot(name string, in *wago.Instance) {
+	if data, ok := in.Read(0, 80); ok && binary.LittleEndian.Uint64(data) == 4919706420659244884 && binary.LittleEndian.Uint64(data[8:]) == 1 {
+		diagRecord := map[string]any{"code": binary.LittleEndian.Uint32(data[16:]), "phase": binary.LittleEndian.Uint32(data[20:]), "module_id": binary.LittleEndian.Uint64(data[24:]), "declaration": binary.LittleEndian.Uint64(data[32:]), "body": binary.LittleEndian.Uint64(data[40:]), "expression": binary.LittleEndian.Uint32(data[48:]), "expected": binary.LittleEndian.Uint64(data[56:]), "actual": binary.LittleEndian.Uint64(data[64:]), "detail": binary.LittleEndian.Uint64(data[72:])}
+		Event("invariant_record", diagRecord)
+	}
+
+	value, ok := in.GCTelemetrySnapshot()
+	Event("gc", map[string]any{"name": name, "available": ok, "snapshot": value, "helpers": in.GCHelperStats()})
+}
+func Start() func() {
+	epoch = time.Now()
+	dir := os.Getenv("DEW_WAGO_PROFILE_DIR")
+	if dir == "" {
+		return func() {}
+	}
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		panic(err)
+	}
+	cpu, err := os.Create(filepath.Join(dir, "cpu.pprof"))
+	if err != nil {
+		panic(err)
+	}
+	if os.Getenv("WAGO_NATIVE_SAMPLE")!="1" {
+if err = pprof.StartCPUProfile(cpu); err != nil {
+		panic(err)
+	}
+	}
+ runtime.SetMutexProfileFraction(20)
+	runtime.SetBlockProfileRate(1000000)
+	Event("start", map[string]any{"gomaxprocs": runtime.GOMAXPROCS(0), "gcstats": wago.GCTelemetryAvailable()})
+	stopProfile = func() {
+		if os.Getenv("WAGO_NATIVE_SAMPLE")!="1" {pprof.StopCPUProfile()}
+		cpu.Close()
+		var mem runtime.MemStats
+		runtime.ReadMemStats(&mem)
+		Event("go_memory", map[string]any{"heap_alloc": mem.HeapAlloc, "total_alloc": mem.TotalAlloc, "mallocs": mem.Mallocs, "num_gc": mem.NumGC, "pause_total_ns": mem.PauseTotalNs, "sys": mem.Sys})
+		for _, name := range []string{"allocs", "heap", "mutex", "block"} {
+			f, e := os.Create(filepath.Join(dir, name+".pprof"))
+			if e != nil {
+				panic(e)
+			}
+			if e = pprof.Lookup(name).WriteTo(f, 0); e != nil {
+				panic(e)
+			}
+			f.Close()
+		}
+	}
+	return Finish
+}
+
+func SaveCodeMap(c *wago.Compiled,in *wago.Instance) {
+ dir:=os.Getenv("DEW_WAGO_PROFILE_DIR");if dir=="" { return }
+ base,entries:=in.CodeBase()
+ names:=make([]string,len(entries));for i:=range names {names[i]=c.FuncDebugName(uint32(i+c.NumImports))}
+ data,err:=json.Marshal(map[string]any{"base":uint64(base),"size":c.CodeSize(),"entries":entries,"names":names});if err!=nil {panic(err)}
+ if err=os.WriteFile(filepath.Join(dir,"code-map.json"),data,0644);err!=nil{panic(err)}
+ f,err:=os.Create(filepath.Join(dir,"native-code.bin"));if err!=nil{panic(err)}
+ if _,err=c.WriteCodeTo(f);err!=nil{panic(err)};f.Close()
+}

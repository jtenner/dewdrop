diff --git a/src/core/compiler/backend/railshot/amd64/gc_loop_value_homes.go b/src/core/compiler/backend/railshot/amd64/gc_loop_value_homes.go
new file mode 100644
index 000000000..a57a29dc4
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/gc_loop_value_homes.go
@@ -0,0 +1,127 @@
+//go:build amd64
+
+package amd64
+
+import (
+	"fmt"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	gc "github.com/wago-org/wago/src/core/runtime/gc/native"
+	"math"
+)
+
+const gcLoopValueCapacity = 8
+
+type gcLoopValueHome struct {
+	typ, extent uint32
+	home        int
+}
+
+// Each fixed type/extent key has a full reference word and a successful raw
+// address. Neither home is a root. Address zero disables the entry; keys are
+// unread until an address is present. Go-capable boundaries clear all addresses
+// in the caller before entering any callee that may move/free/reuse objects.
+func (f *fn) reserveGCLoopValueHomes(code []byte) error {
+	if !f.hasLoop || !f.gcStructHelpers || f.moduleEH || len(f.customInstructions) != 0 || len(f.inlineTargets.gcReadOnly) == 0 {
+		return nil
+	}
+	var selected [gcLoopValueCapacity]gcLoopValueHome
+	count, depth := 0, 0
+	var loops []int
+	castType := uint32(0)
+	cast := false
+	r := wasm.ReaderFrom(code)
+	for r.BytesLeft() != 0 {
+		pc := r.Offset()
+		op, err := r.Byte()
+		if err != nil {
+			return err
+		}
+		var imm wasm.InstructionImmediate
+		if err = f.classifier.ClassifyInto(&r, op, &imm); err != nil {
+			return err
+		}
+		if cast && len(loops) != 0 && op == 0xfb && imm.Subopcode >= 2 && imm.Subopcode <= 4 && imm.Index == castType {
+			layout, final, ok := f.gcStructFieldLayout(imm.Index, imm.Index2)
+			extent := uint64(gc.PayloadOffset) + uint64(layout.Offset) + uint64(layout.Size)
+			if ok && final && extent <= math.MaxInt32 {
+				found := false
+				for i := 0; i < count; i++ {
+					found = found || selected[i].typ == castType && selected[i].extent == uint32(extent)
+				}
+				if !found && count < len(selected) {
+					selected[count] = gcLoopValueHome{typ: castType, extent: uint32(extent)}
+					count++
+				}
+			}
+		}
+		cast = false
+		if op == 0xfb && (imm.Subopcode == 22 || imm.Subopcode == 23) {
+			rr := wasm.ReaderFrom(code[pc+1:])
+			_, _ = rr.U32()
+			heap, exact, err := readRefHeapTypeImmediate(&rr)
+			if err == nil && !exact && heap >= 0 && heap <= math.MaxUint32 {
+				castType = uint32(heap)
+				cast = true
+			}
+		}
+		switch op {
+		case 0x02, 0x04:
+			depth++
+		case 0x03:
+			depth++
+			loops = append(loops, depth)
+		case 0x0b:
+			if len(loops) != 0 && loops[len(loops)-1] == depth {
+				loops = loops[:len(loops)-1]
+			}
+			if depth > 0 {
+				depth--
+			}
+		}
+	}
+	if count == 0 {
+		return nil
+	}
+	f.gcLoopValues = make([]gcLoopValueHome, count)
+	copy(f.gcLoopValues, selected[:count])
+	for i := range f.gcLoopValues {
+		f.gcLoopValues[i].home = len(f.localType)
+		for j := 0; j < 2; j++ {
+			home := len(f.localType)
+			for len(f.gcLocalTypes) <= home/64 {
+				f.gcLocalTypes = append(f.gcLocalTypes, 0)
+			}
+			f.gcLocalTypes[home/64] &^= uint64(1) << uint(home%64)
+			if uint64(f.nLocalSlots)*8 > uint64(localSlotOffsetMask) {
+				return fmt.Errorf("amd64: loop GC value homes exceed local frame range")
+			}
+			f.localType = append(f.localType, mtI64)
+			f.localSlot = append(f.localSlot, uint32(8*f.nLocalSlots))
+			f.locals = append(f.locals, localDef{reg: regNone, typ: mtI64, state: lsMem})
+			f.nLocalSlots++
+		}
+	}
+	f.skipFence = false
+	return nil
+}
+
+func (f *fn) gcLoopValueHome(typ, extent uint32) *gcLoopValueHome {
+	if f.inlineDepth != 0 || f.localBase != 0 || f.gcReadRegion != nil {
+		return nil
+	}
+	for i := range f.gcLoopValues {
+		e := &f.gcLoopValues[i]
+		if e.typ == typ && e.extent == extent {
+			return e
+		}
+	}
+	return nil
+}
+
+// MOV r/m64, imm32 sign-extends zero to all eight address bytes and preserves
+// registers and flags. Use absolute owner-frame offsets even inside inline code.
+func (f *fn) clearGCLoopValueHomes() {
+	for _, e := range f.gcLoopValues {
+		f.a.StoreImmIdx(RSP, RSP, f.localOff(e.home+1), 0, 8)
+	}
+}

+//go:build amd64
+
+package amd64
+
+import (
+	"bytes"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	enc "github.com/wago-org/wago/src/core/encoder/amd64"
+	"os"
+	"testing"
+)
+
+func TestGCLoopValueHomeClearWidthAndEntry(t *testing.T) {
+	f := fn{a: &enc.Asm{}, nLocals: 2, nParams: 2, compactFrameHeader: true, localSlot: []uint32{0, 8, 16, 24}, gcLoopValues: []gcLoopValueHome{{home: 2}}}
+	f.zeroDeclaredLocals(nil)
+	// mov qword ptr [rsp+24], 0. No register or flags are changed. This also
+	// verifies entry initialization before the parameter-only early return.
+	want := []byte{0x48, 0xc7, 0x44, 0x24, 0x18, 0, 0, 0, 0}
+	if !bytes.Equal(f.a.B, want) {
+		t.Fatalf("address clear=%x want full64bit MOV %x", f.a.B, want)
+	}
+}
+
+func TestGCLoopValueHomePlanBudget(t *testing.T) {
+	data, err := os.ReadFile("../../../../../../tests/fixtures/wasm/gc-loop-value-homes.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, err := wasm.DecodeModule(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	box := &m.Types[0].SubTypes[0]
+	for len(box.Comp.Fields) < 10 {
+		box.Comp.Fields = append(box.Comp.Fields, box.Comp.Fields[0])
+	}
+	body := []byte{3, 0x40}
+	for i := 0; i < 10; i++ {
+		body = append(body, 0x20, 0, 0xfb, 22, 0, 0xfb, 2, 0, byte(i), 0x1a)
+	}
+	body = append(body, 0x0b, 0x0b)
+	f := fn{m: m, hasLoop: true, classifier: wasm.NewModuleInstructionClassifier(m, true), inlineTargets: inlineTargetTable{gcReadOnly: []bool{false}}, gcLocalTypes: []uint64{^uint64(0)}}
+	f.gcStructHelpers = true
+	if err = f.reserveGCLoopValueHomes(body); err != nil {
+		t.Fatal(err)
+	}
+	if len(f.gcLoopValues) != 8 || f.nLocalSlots != 16 || f.nLocals != 0 || f.gcLocalTypes[0]&0xffff != 0 {
+		t.Fatalf("budget/roots: entries=%d slots=%d locals=%d roots=%x", len(f.gcLoopValues), f.nLocalSlots, f.nLocals, f.gcLocalTypes)
+	}
+	for i, e := range f.gcLoopValues {
+		if e.home != i*2 || e.extent != uint32(20+i*4) {
+			t.Fatalf("key %d=%+v", i, e)
+		}
+	}
+	if f.gcLoopValueHome(0, 20) == nil {
+		t.Fatal("selected home missing")
+	}
+	f.inlineDepth = 1
+	if f.gcLoopValueHome(0, 20) != nil {
+		t.Fatal("inline cache use admitted")
+	}
+	f.inlineDepth = 0
+	f.localBase = 1
+	if f.gcLoopValueHome(0, 20) != nil {
+		t.Fatal("inline local remapping admitted")
+	}
+}

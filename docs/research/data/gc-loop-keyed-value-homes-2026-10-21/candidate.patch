diff --git a/src/wago/gc_loop_value_homes_amd64_test.go b/src/wago/gc_loop_value_homes_amd64_test.go
new file mode 100644
index 000000000..ffb9f04dd
--- /dev/null
+++ b/src/wago/gc_loop_value_homes_amd64_test.go
@@ -0,0 +1,208 @@
+//go:build linux && amd64 && !tinygo && !wago_guardpage
+
+package wago
+
+import (
+	"context"
+	"encoding/binary"
+	gc "github.com/wago-org/wago/src/core/runtime/gc/native"
+	"os"
+	"testing"
+	"unsafe"
+)
+
+func TestGCLoopValueHomes(t *testing.T) {
+	data, err := os.ReadFile("../../tests/fixtures/wasm/gc-loop-value-homes.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, regABI := range []bool{false, true} {
+		c, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3).WithOptimization("reg-abi", regABI), data)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if a := c.GCNativeRootAdmission(); !a.Required || !a.Exact {
+			t.Fatalf("roots=%+v", a)
+		}
+		loaded := publicArtifactRoundTrip(t, c)
+		for _, artifact := range []*Compiled{c, loaded} {
+			for _, cfg := range []GCConfig{{VerifyAfterCollect: true}, {CollectEveryAlloc: true, StressNurseryBytes: 128, VerifyAfterCollect: true}, {Profile: GCProfileTiny, TinyHeapBytes: 4096, TinyBlockBytes: 16, VerifyAfterCollect: true}} {
+				var in *Instance
+				calls := 0
+				imports := NewImports()
+				imports.HostFunc("env", "step", func(caller Caller, _ HostCall) {
+					calls++
+					if got, err := in.InvokeFromHost(context.Background(), caller, "inner"); err != nil || len(got) != 1 || got[0] != 11 {
+						t.Errorf("nested read=%v,%v", got, err)
+					}
+					if err := in.CollectGC(); err != nil {
+						t.Error(err)
+					}
+				})
+				in, err = Instantiate(artifact, InstantiateOptions{Imports: imports, GC: cfg})
+				if err != nil {
+					t.Fatal(err)
+				}
+				for _, mode := range []uint64{0, 1, 2, 3, 4, 5, 6, 7} {
+					if _, err = in.Invoke("init"); err != nil {
+						t.Fatal(err)
+					}
+					got, err := in.Invoke("run", 16, mode)
+					want := uint64(112)
+					if mode == 1 {
+						want = 144
+					}
+					if mode == 3 {
+						want = 136
+					}
+					if err != nil || len(got) != 1 || got[0] != want {
+						t.Fatalf("register=%v codec=%v mode=%d: %v,%v want%d", regABI, artifact == loaded, mode, got, err, want)
+					}
+				}
+				if _, err = in.Invoke("init"); err != nil {
+					t.Fatal(err)
+				}
+				if got, err := in.Invoke("read-only", 16); err != nil || len(got) != 1 || got[0] != 112 {
+					t.Fatalf("read-only call=%v,%v", got, err)
+				}
+				if calls != 64 {
+					t.Fatalf("host calls=%d want64", calls)
+				}
+				if got, err := in.Invoke("run", 0, 8); err != nil || len(got) != 1 || got[0] != 0 {
+					t.Fatalf("zero trip=%v,%v", got, err)
+				}
+				if _, err := in.Invoke("run", 1, 8); err == nil {
+					t.Fatal("null loop access did not trap")
+				}
+				if _, err = in.Invoke("init"); err != nil {
+					t.Fatal(err)
+				}
+				if got, err := in.Invoke("params", 32); err != nil || len(got) != 1 || got[0] != 0 {
+					t.Fatalf("parameter-only frame=%v,%v", got, err)
+				}
+				if got, err := in.Invoke("run", 16, 0); err != nil || len(got) != 1 || got[0] != 112 {
+					t.Fatalf("fresh entry after trap=%v,%v", got, err)
+				}
+				in.Close()
+			}
+		}
+		loaded.Close()
+		c.Close()
+	}
+}
+
+// Corruption after a filled entry makes missing caller invalidation visible even
+// if an evacuated object's old payload happens to retain the same field bytes.
+func TestGCLoopValueHomesHostInvalidation(t *testing.T) {
+	data, err := os.ReadFile("../../tests/fixtures/wasm/gc-loop-value-homes.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3), data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	loaded := publicArtifactRoundTrip(t, c)
+	defer loaded.Close()
+	for _, artifact := range []*Compiled{c, loaded} {
+		for _, mode := range []uint64{2, 5, 6, 7} {
+			for _, header := range []bool{false, true} {
+				var target []byte
+				imports := NewImports()
+				calls := 0
+				imports.HostFunc("env", "step", func() { calls++; binary.LittleEndian.PutUint32(target, 0) })
+				in, err := Instantiate(artifact, InstantiateOptions{Imports: imports})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err = in.Invoke("init"); err != nil {
+					t.Fatal(err)
+				}
+				bits := readGlobalObject(in.globalCells[0], in.c.Globals[0].Type)
+				v := in.gc.NativeView()
+				h := unsafe.Slice((*byte)(offHeapPtr(v.Handles+uintptr(gc.Ref(uint32(bits))>>1)*gc.NativeHandleStride)), gc.NativeHandleStride)
+				if header {
+					obj := unsafe.Slice((*byte)(offHeapPtr(v.Spaces[h[gc.NativeHandleSpaceOffset]].Base+uintptr(binary.LittleEndian.Uint32(h)))), 24)
+					target = obj[4:]
+				} else {
+					target = h[gc.NativeHandleSizeOffset:]
+				}
+				old := binary.LittleEndian.Uint32(target)
+				_, err = in.Invoke("run", 2, mode)
+				binary.LittleEndian.PutUint32(target, old)
+				if err == nil || calls != 1 {
+					t.Fatalf("mode=%d header=%v missing full recheck: calls=%d err=%v", mode, header, calls, err)
+				}
+				if got, err := in.Invoke("run", 2, 0); err != nil || len(got) != 1 || got[0] != 14 {
+					t.Fatalf("entry reset=%v,%v", got, err)
+				}
+				in.Close()
+			}
+		}
+	}
+}
+
+func TestGCLoopValueHomesCrossInstanceInvalidation(t *testing.T) {
+	data, err := os.ReadFile("../../tests/fixtures/wasm/gc-loop-value-homes.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3)
+	c, err := cfg.Compile(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	rt := NewRuntime(WithRuntimeConfig(cfg))
+	defer rt.Close()
+	module, err := rt.Module(c)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var consumer *Instance
+	var target []byte
+	corrupt := false
+	calls := 0
+	imports := NewImports()
+	imports.HostFunc("env", "step", func() {
+		calls++
+		if corrupt {
+			binary.LittleEndian.PutUint32(target, 0)
+		} else if err := consumer.CollectGC(); err != nil {
+			t.Error(err)
+		}
+	})
+	provider, err := rt.Instantiate(context.Background(), module, WithImports(imports))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer provider.Close()
+	step, err := provider.ExportedFunc("step")
+	if err != nil {
+		t.Fatal(err)
+	}
+	consumer, err = rt.Instantiate(context.Background(), module, WithImports(NewImports().Function("env", "step", step)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer consumer.Close()
+	if _, err = consumer.Invoke("init"); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := consumer.Invoke("run", 4, 5); err != nil || len(got) != 1 || got[0] != 28 || calls != 4 {
+		t.Fatalf("cross-domain moving collection=%v,%v calls=%d", got, err, calls)
+	}
+	bits := readGlobalObject(consumer.globalCells[0], consumer.c.Globals[0].Type)
+	v := consumer.gc.NativeView()
+	h := unsafe.Slice((*byte)(offHeapPtr(v.Handles+uintptr(gc.Ref(uint32(bits))>>1)*gc.NativeHandleStride)), gc.NativeHandleStride)
+	target = h[gc.NativeHandleSizeOffset:]
+	old := binary.LittleEndian.Uint32(target)
+	corrupt = true
+	calls = 0
+	_, err = consumer.Invoke("run", 2, 5)
+	binary.LittleEndian.PutUint32(target, old)
+	if err == nil || calls != 1 {
+		t.Fatalf("cross-domain cache survived a Go callback: err=%v calls=%d", err, calls)
+	}
+}

@@ -0,0 +1,62 @@
+//go:build linux && amd64 && !tinygo && wago_codegenstats
+
+package wago
+
+import (
+	"os"
+	"testing"
+
+	backend "github.com/wago-org/wago/src/core/compiler/backend/railshot/amd64"
+	"github.com/wago-org/wago/src/core/compiler/codegen"
+	"github.com/wago-org/wago/src/core/compiler/frontend"
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+)
+
+func TestGCLoopValueHomesAdmission(t *testing.T) {
+	data, err := os.ReadFile("../../tests/fixtures/wasm/gc-loop-value-homes.wasm")
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, err := wasm.DecodeModule(data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = wasm.ValidateModule(m); err != nil {
+		t.Fatal(err)
+	}
+	meta, err := frontend.BuildGCTypeMetadata(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var diagnostic string
+	plan := newGCFrameRootPlan(m, true, &diagnostic, nil)
+	if plan == nil || diagnostic != "" {
+		t.Fatalf("root plan: %s", diagnostic)
+	}
+	var stats backend.ModuleStats
+	c, err := backend.CompileModuleWith(m, backend.CompileOptions{Stats: &stats, GCStructHelpers: true, GCArrayHelpers: true, GCFrameRoots: plan, Codegen: codegen.Options{Module: codegen.ModuleInfo{GCTypeDescs: meta.Descs, GCTypeLayouts: meta.Layouts}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.CodeImage.Close()
+
+	seen := false
+	preserved := false
+	for _, s := range stats.Funcs {
+		if s != nil && s.Name == "read-only" {
+			preserved = s.Peephole["gc-loop-value-call-preserve"] > 0
+		}
+		if s != nil && s.Name == "run" {
+			seen = true
+			if s.Peephole["gc-loop-value-home"] != 1 {
+				t.Fatalf("loop does not emit one checked runtime cache site: %v", s.Peephole)
+			}
+		}
+	}
+	if !preserved {
+		t.Fatal("read-only callee did not preserve an actual loop cache")
+	}
+	if !seen {
+		t.Fatal("missing run function")
+	}
+}

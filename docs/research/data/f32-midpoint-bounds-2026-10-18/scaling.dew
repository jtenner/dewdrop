open dew.std.bytes_builder
open dew.std.math
open dew.std.bytes

struct F32ScalingInput {
  mut value: Bytes
}

let f32_scaling_input = F32ScalingInput::{
  value: b""
}

pub fn f32_scaling_prepare(length: U32) -> Unit {
  let builder = BytesBuilder::with_capacity(length + 64u32)
  builder.append(b"1.000000059604644775390625")
  while 0u32 {
    index if index < length => {
      builder.append_byte(48u8)
      continue index + 1u32
    }
    _ => break self_host_tokenizer_unit()
  }
  builder.append(b"f32")
  f32_scaling_input.value = builder.finish()
}

pub fn f32_scaling_run() -> U32 {
  let exponent = SelfHostExponentScan::{
    magnitude: 0u32
    negative: false
    present: false
    valid: true
  }
  f32_to_bits(self_host_round_f32_decimal(f32_scaling_input.value, 0u32,
    f32_scaling_input.value.byte_length() - 3u32, exponent,
    f64_from_bits(4607182419068452864u64)))
}

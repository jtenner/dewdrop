--- /dev/null
+++ b/src/core/runtime/gc/native/local_handle_order_test.go
@@ -0,0 +1,32 @@
+package gc
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestLocalHandleOrderSummary(t *testing.T) {
+	if n := unsafe.Sizeof(localHandleOrderTrace{}); n > 32<<10 {
+		t.Fatalf("trace size=%d, want <=32768", n)
+	}
+	for _, ids := range [][]uint32{{1, 2, 3, 4, 5}, {5, 4, 3, 2, 1}} {
+		s := localSummarizeHandleOrder(ids, 0, 32)
+		if s.Pairs != 4 || s.Delta[0] != 4 || s.Line64Crossings != 1 || s.Page4KCrossings != 0 || s.SampledDirectionChanges != 0 {
+			t.Fatalf("ids=%v stats=%+v", ids, s)
+		}
+		if s.Ascending+s.Descending != 4 {
+			t.Fatalf("direction counts=%+v", s)
+		}
+	}
+	s := localSummarizeHandleOrder([]uint32{1, 2, 512, 3, 4}, 0, 1024)
+	if s.Pairs != 4 || s.Page4KCrossings != 2 || s.SampledDirectionChanges != 2 || s.Delta[0] != 2 || s.Delta[4] != 2 {
+		t.Fatalf("scrambled stats=%+v", s)
+	}
+	ids := make([]uint32, 20000)
+	for i := range ids {
+		ids[i] = uint32(i + 1)
+	}
+	if s := localSummarizeHandleOrder(ids, 0, 20001); s.Pairs != 4096 || s.Delta[0] != 4096 {
+		t.Fatalf("bounded sample=%+v", s)
+	}
+}

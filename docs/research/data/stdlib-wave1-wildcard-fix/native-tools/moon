#!/usr/bin/env python3
import os, sys
args = sys.argv[1:]
if args and args[0] in ('run', 'build', 'test', 'check'):
    result = [args[0], '-j', '1']
    i = 1
    while i < len(args):
        if args[i] == '--':
            result.extend(args[i:])
            break
        if args[i] in ('-j', '--jobs'):
            i += 2
            continue
        if args[i].startswith('-j') and args[i][2:].isdigit():
            i += 1
            continue
        result.append(args[i])
        i += 1
    args = result
os.execv('/data/home/.moon/bin/moon', ['moon', *args])

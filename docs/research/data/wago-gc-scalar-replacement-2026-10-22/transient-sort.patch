+
+func TestPromotionSortTransientStableOrderAndBound(t *testing.T) {
+	for _, n := range []int{maxPromotionSortPlans + 1, 262144, maxTransientPromotionSortPlans, maxTransientPromotionSortPlans + 1} {
+		t.Run(fmt.Sprint(n), func(t *testing.T) {
+			c, plans := promotionSortFixture(n, 4096, false)
+			for i := range plans {
+				if i%11 == 0 {
+					plans[i].entry = handleEntry{space: spaceNursery, off: uint32(i), size: c.handles[plans[i].handle].size}
+				} else if i%11 == 1 {
+					plans[i].entry = handleEntry{space: spaceLarge, off: uint32(i), size: c.handles[plans[i].handle].size}
+				}
+			}
+			want := slices.Clone(plans)
+			referencePromotionSort(c, want)
+			c.sortPromotionPlans(plans)
+			if !slices.Equal(plans, want) {
+				for i := range plans {
+					if plans[i] != want[i] {
+						t.Fatalf("plan %d: got %+v want %+v", i, plans[i], want[i])
+					}
+				}
+			}
+			if cap(c.promotionSortScratch) != 0 {
+				t.Fatalf("large sort retained %d plans", cap(c.promotionSortScratch))
+			}
+		})
+	}
+}
+
+func TestPromotionSortTransientKeepsSmallWorkspace(t *testing.T) {
+	c, small := promotionSortFixture(4096, 4096, false)
+	c.sortPromotionPlans(small)
+	capacity := cap(c.promotionSortScratch)
+	other, large := promotionSortFixture(maxPromotionSortPlans+1, 4096, false)
+	c.handles = other.handles
+	c.sortPromotionPlans(large)
+	for i := 1; i < len(large); i++ {
+		if large[i-1].entry.size > large[i].entry.size {
+			t.Fatalf("unordered plans at %d", i)
+		}
+	}
+	if cap(c.promotionSortScratch) != capacity {
+		t.Fatalf("small workspace grew from %d to %d", capacity, cap(c.promotionSortScratch))
+	}
+	for i, p := range c.promotionSortScratch[:capacity] {
+		if p != (plannedPromotion{}) {
+			t.Fatalf("small workspace %d retains %+v", i, p)
+		}
+	}
+}
+
+func BenchmarkPromotionPlanSortLarge(b *testing.B) {
+	for _, n := range []int{65537, 262144, 524288} {
+		b.Run(fmt.Sprint(n), func(b *testing.B) {
+			c, seed := promotionSortFixture(n, 4096, false)
+			plans := slices.Clone(seed)
+			b.ReportAllocs()
+			b.ResetTimer()
+			for range b.N {
+				copy(plans, seed)
+				c.sortPromotionPlans(plans)
+			}
+		})
+	}
+}

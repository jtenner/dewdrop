@@ -0,0 +1,48 @@
+package gc
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestHotHandleTypeAndColdCardLinks(t *testing.T) {
+	c := newTestCollector(t, Config{})
+	parent, err := c.NewStructDefault(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.entry(parent).typeID != 1 {
+		t.Fatal("canonical type is not in the hot handle")
+	}
+	if unsafe.Sizeof(handleEntry{}) != 16 {
+		t.Fatal("hot handle grew")
+	}
+	if len(c.cardSlots) != 0 {
+		t.Fatal("nursery allocation created cold card metadata")
+	}
+	if err := c.ForcePromote(parent); err != nil {
+		t.Fatal(err)
+	}
+	child, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.StructSet(parent, 0, RefValue(child)); err != nil {
+		t.Fatal(err)
+	}
+	if c.cardSlot(handleOf(parent)) == 0 || c.entry(parent).typeID != 1 {
+		t.Fatal("card publication changed canonical type")
+	}
+	if c.NativeView().ObjectCardSlots != sliceData(c.cardSlots) || c.NativeView().ObjectCardSlotCount != uint32(len(c.cardSlots)) {
+		t.Fatal("native cold card links do not match their owned backing")
+	}
+	if err := c.CollectMinor(RefSliceRoots{parent}); err != nil {
+		t.Fatal(err)
+	}
+	if c.entry(parent).typeID != 1 || c.entry(child).typeID != 0 {
+		t.Fatal("evacuation lost canonical types")
+	}
+	if err := c.Verify(RefSliceRoots{parent}); err != nil {
+		t.Fatal(err)
+	}
+}

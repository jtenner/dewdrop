new file mode 100644
index 000000000..2994349d1
--- /dev/null
+++ b/src/core/runtime/gc/native/card_slots.go
@@ -0,0 +1,58 @@
+package gc
+
+import (
+	"fmt"
+	"slices"
+	"unsafe"
+
+	"github.com/wago-org/wago/internal/virtualmem"
+)
+
+func (c *Collector) cardSlot(h uint32) uint32 {
+	if uint64(h) >= uint64(len(c.cardSlots)) {
+		return 0
+	}
+	return c.cardSlots[h]
+}
+
+func (c *Collector) ensureCardSlot(h uint32) error {
+	if uint64(h) < uint64(len(c.cardSlots)) {
+		return nil
+	}
+	if h == 0 || uint64(h) >= uint64(len(c.handles)) {
+		return fmt.Errorf("gc: card link handle %d outside live table", h)
+	}
+	need := uint64(h) + 1
+	if c.backing != nil {
+		if c.backing.cardSlots == nil {
+			r, err := virtualmem.Reserve(c.backing.handleLimit * 4)
+			if err != nil {
+				return fmt.Errorf("gc: reserve cold card links: %w", err)
+			}
+			c.backing.cardSlots = r
+		}
+		r := c.backing.cardSlots
+		old := uint64(len(c.cardSlots)) * 4
+		if err := r.Commit(old, need*4-old); err != nil {
+			return fmt.Errorf("gc: commit cold card links: %w", err)
+		}
+		capacity := min(r.CommittedBytes()/4, c.backing.handleLimit)
+		b := r.Bytes(capacity * 4)
+		c.cardSlots = unsafe.Slice((*uint32)(unsafe.Pointer(&b[0])), int(capacity))
+	} else {
+		c.cardSlots = slices.Grow(c.cardSlots, int(need)-len(c.cardSlots))[:need]
+	}
+	c.refreshNativeCards()
+	return nil
+}
+
+func (c *Collector) setCardSlot(h, slot uint32) {
+	if slot == 0 && uint64(h) >= uint64(len(c.cardSlots)) {
+		return
+	}
+	if err := c.ensureCardSlot(h); err != nil {
+		// Nonzero production stores are preflighted before changing card nodes.
+		panic("gc: cold card link publication without committed capacity: " + err.Error())
+	}
+	c.cardSlots[h] = slot
+}

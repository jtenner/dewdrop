new file mode 100644
index 000000000..ff1fdc3c5
--- /dev/null
+++ b/src/core/runtime/gc/native/compact_layout_bench_test.go
@@ -0,0 +1,50 @@
+package gc
+
+import (
+	"testing"
+	"unsafe"
+)
+
+// Use a fixed iteration count when comparing products, so both retain the same
+// object population and reach the same bounded collector state.
+func BenchmarkCompactStructLayout(b *testing.B) {
+	for _, tc := range []struct {
+		name   string
+		fields []StorageKind
+	}{
+		{"i32", []StorageKind{StorageI32}},
+		{"two-i64", []StorageKind{StorageI64, StorageI64}},
+		{"ref-i32", []StorageKind{StorageRefNull, StorageI32}},
+		{"i32-v128", []StorageKind{StorageI32, StorageV128}},
+	} {
+		b.Run(tc.name, func(b *testing.B) {
+			d, err := NewStructDesc(0, tc.fields)
+			if err != nil {
+				b.Fatal(err)
+			}
+			c, err := NewCollector(Config{NurseryBytes: 1 << 20, ThroughputHeapBytes: 16 << 20}, []TypeDesc{d})
+			if err != nil {
+				b.Fatal(err)
+			}
+			defer c.Close()
+			b.ReportAllocs()
+			b.ResetTimer()
+			var ref Ref
+			for i := 0; i < b.N; i++ {
+				ref, err = c.NewStructDefaultWithRoots(0, EmptyRoots{})
+				if err != nil {
+					b.Fatal(err)
+				}
+				if err = c.ForcePromote(ref); err != nil {
+					b.Fatal(err)
+				}
+			}
+			b.StopTimer()
+			e := c.entry(ref)
+			b.ReportMetric(float64(e.size), "logical-B/object")
+			b.ReportMetric(float64(c.throughput.handleAllocSize(*e)), "allocated-B/object")
+			b.ReportMetric(float64(unsafe.Sizeof(handleEntry{})), "hot-B/object")
+			b.ReportMetric(float64(c.MemoryStats().CommittedBytes), "committed-B")
+		})
+	}
+}

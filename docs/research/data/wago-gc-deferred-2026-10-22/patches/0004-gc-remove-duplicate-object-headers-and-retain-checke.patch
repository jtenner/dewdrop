diff --git a/src/core/compiler/backend/railshot/amd64/gc_array_extent.go b/src/core/compiler/backend/railshot/amd64/gc_array_extent.go
new file mode 100644
index 000000000..1d5586a95
--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/gc_array_extent.go
@@ -0,0 +1,20 @@
+//go:build amd64
+
+package amd64
+
+import gc "github.com/wago-org/wago/src/core/runtime/gc/native"
+
+// Array extents belong to hot handles, not duplicate heap headers. Capture the
+// validated extent before register allocation can reuse the leaf's RDI scratch.
+// The private numeric home survives other native leaf calls and is not a root.
+func (f *fn) emitCheckedGCArrayObject(object *elem, typ uint32, extentHome int) (Reg, func()) {
+	f.stats.addGCHandleResolution()
+	f.gcPureIfEndPC = 0
+	f.invalidateGCResolvedObject()
+	if gcSharedStubsEnabled {
+		obj := f.emitSharedCheckedGCObjectPinned(object, typ, gc.HeaderSize, gcSharedStubResolveBoundedObject)
+		f.a.StoreRsp32(f.spillOff(extentHome), RDI)
+		return obj, func() { f.pinned = f.pinned.remove(obj) }
+	}
+	return f.emitCheckedGCObject(object, typ, gc.HeaderSize, f.spillOff(extentHome))
+}

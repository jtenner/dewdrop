+// Element 40 is in the second 128-byte card, although its index fits the
+// first card's byte range. Native card checks must compare bytes to bytes.
+func TestGCNativeOldArrayStoreUsesPayloadByteCards(t *testing.T) {
+	compiled, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3), gcNativeOldArrayReferenceStoreFixture(130, 40))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer compiled.Close()
+	in, err := Instantiate(compiled, InstantiateOptions{GC: GCConfig{StressBarriers: true, VerifyAfterCollect: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer in.Close()
+	if _, err = in.Invoke("init"); err != nil {
+		t.Fatal(err)
+	}
+	parent := corergc.Ref(uint32(readGlobalObject(in.globalCells[0], in.c.Globals[0].Type)))
+	if err = in.gc.ForcePromote(parent); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = in.Invoke("set_both"); err != nil {
+		t.Fatal(err)
+	}
+	view := in.gc.NativeView()
+	head := *(*uint32)(offHeapPtr(view.ObjectCardSlots + uintptr(uint32(parent)>>1)*4))
+	if head == 0 || head > view.ObjectCardCount {
+		t.Fatalf("invalid parent card head %d", head)
+	}
+	card := unsafe.Slice((*byte)(offHeapPtr(view.ObjectCards+uintptr(head-1)*corergc.NativeObjectCardStride)), corergc.NativeObjectCardStride)
+	if binary.LittleEndian.Uint32(card[corergc.NativeObjectCardHandleOffset:]) != uint32(parent)>>1 || binary.LittleEndian.Uint32(card[corergc.NativeObjectCardStartOffset:]) > 160 || binary.LittleEndian.Uint32(card[corergc.NativeObjectCardEndOffset:]) < 163 {
+		t.Fatalf("parent card %x does not cover element 40 at bytes160..163", card)
+	}
+	if _, err = in.Invoke("clear_children"); err != nil {
+		t.Fatal(err)
+	}
+	if err = in.gc.CollectMinor(nil); err != nil {
+		t.Fatal(err)
+	}
+	for _, index := range []uint32{0, 40} {
+		child, err := in.gc.ArrayGet(parent, index)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = in.gc.StructGet(child.Ref, 0); err != nil {
+			t.Fatalf("index%d lost child: %v", index, err)
+		}
+	}
+}

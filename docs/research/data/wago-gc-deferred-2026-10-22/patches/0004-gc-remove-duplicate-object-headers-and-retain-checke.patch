@@ -0,0 +1,66 @@
+package gc
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestCompactObjectLayoutAndVectorAlignment(t *testing.T) {
+	if HeaderSize != 8 {
+		t.Fatalf("dynamic header = %d bytes, want 8", HeaderSize)
+	}
+	i32, err := NewStructDesc(0, []StorageKind{StorageI32})
+	if err != nil {
+		t.Fatal(err)
+	}
+	vec, err := NewStructDesc(1, []StorageKind{StorageI32, StorageV128})
+	if err != nil {
+		t.Fatal(err)
+	}
+	arr, err := NewArrayDesc(2, StorageV128)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{DisableCollection: true}, []TypeDesc{i32, vec, arr})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	s, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want, err := StructSize(i32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c.entry(s).size != want || want > 16 {
+		t.Fatalf("small struct bytes=%d, want at most 16", c.entry(s).size)
+	}
+	v, err := c.NewStructDefault(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, err := c.NewArrayDefault(2, 2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		r   Ref
+		off uint32
+	}{{v, vec.PayloadOffset() + vec.Fields[1].Offset}, {a, arr.PayloadOffset()}} {
+		b := c.bytes(tc.r)
+		if uintptr(unsafe.Pointer(&b[tc.off]))%16 != 0 {
+			t.Fatal("vector payload lost 16-byte alignment")
+		}
+	}
+	if err := c.StructSet(v, 1, V128Value(7, 9)); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.ArraySet(a, 1, V128Value(11, 13)); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Verify(RefSliceRoots{s, v, a}); err != nil {
+		t.Fatal(err)
+	}
+}

+package gc
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestThroughputCompactClassRetainsFullSmallObjectCapacity(t *testing.T) {
+	var heap throughputHeap
+	cfg, _ := normalizeConfig(Config{ThroughputHeapBytes: 4096, ThroughputPageBytes: 4096})
+	if err := heap.Init(cfg); err != nil {
+		t.Fatal(err)
+	}
+	defer heap.Close()
+	entries := make([]handleEntry, 256)
+	for i := range entries {
+		var err error
+		entries[i], err = heap.alloc(8, spaceOld)
+		if err != nil {
+			t.Fatalf("small-object allocation%d of256: %v", i, err)
+		}
+		binary.LittleEndian.PutUint64(heap.mem[entries[i].off:], uint64(i)+1)
+	}
+	if _, err := heap.alloc(8, spaceOld); err == nil {
+		t.Fatal("bounded old heap accepted object257")
+	}
+	for i := 1; i < len(entries); i += 2 {
+		if err := heap.free(entries[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 1; i < len(entries); i += 2 {
+		e, err := heap.alloc(8, spaceOld)
+		if err != nil {
+			t.Fatal(err)
+		}
+		entries[i] = e
+		binary.LittleEndian.PutUint64(heap.mem[e.off:], uint64(i)+1)
+	}
+	for i, e := range entries {
+		if got := binary.LittleEndian.Uint64(heap.mem[e.off:]); got != uint64(i)+1 {
+			t.Fatalf("object%d aliases another allocation: %d", i, got)
+		}
+	}
+	if err := heap.verify(append([]handleEntry{{}}, entries...)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestThroughputCompactClassReusesSixteenByteRemainder(t *testing.T) {
+	var heap throughputHeap
+	cfg, _ := normalizeConfig(Config{ThroughputHeapBytes: 4096, ThroughputPageBytes: 4096})
+	if err := heap.Init(cfg); err != nil {
+		t.Fatal(err)
+	}
+	defer heap.Close()
+	span, err := heap.alloc(48, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	guard, err := heap.alloc(8, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary.LittleEndian.PutUint64(heap.mem[guard.off:], 0xfeedbeef)
+	if err = heap.free(span); err != nil {
+		t.Fatal(err)
+	}
+	first, err := heap.alloc(32, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := heap.alloc(8, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.off != 0 || second.off != 32 || heap.bump != 64 {
+		t.Fatalf("split16 lost capacity: first=%+v second=%+v bump%d", first, second, heap.bump)
+	}
+	if got := binary.LittleEndian.Uint64(heap.mem[guard.off:]); got != 0xfeedbeef {
+		t.Fatalf("split overwrote guard: %x", got)
+	}
+	if err = heap.verify([]handleEntry{{}, first, second, guard}); err != nil {
+		t.Fatal(err)
+	}
+}

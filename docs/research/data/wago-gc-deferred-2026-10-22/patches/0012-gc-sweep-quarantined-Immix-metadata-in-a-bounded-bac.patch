@@ -0,0 +1,40 @@
+//go:build wago_gc_workers && wagodebug && !tinygo
+
+package gc
+
+import (
+	"errors"
+	"runtime"
+	"testing"
+)
+
+func TestBackgroundSweepFailureKeepsReclamationDebt(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	c, roots := newBackgroundSweepFixture(t, 1024)
+	cleanup := armFailure(&c.throughput, failBackgroundSweep, 0)
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	cleanup()
+	debt := c.throughput.pendingBytes
+	if err := c.FinishBackgroundSweep(); !errors.Is(err, errInjectedFailure) {
+		t.Fatalf("worker failure hidden: %v", err)
+	}
+	if c.throughput.pendingBytes != debt || len(c.throughput.pendingFree) == 0 {
+		t.Fatal("failed worker lost exact debt")
+	}
+	if err := c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.throughput.sweepAllPending(); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+	cycles := c.CycleTelemetry().Cycles
+	if len(cycles) < 2 || !cycles[len(cycles)-1].Failed {
+		t.Fatal("background failure missing from telemetry")
+	}
+}

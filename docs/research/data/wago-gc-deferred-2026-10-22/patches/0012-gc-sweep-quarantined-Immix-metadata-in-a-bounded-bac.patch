+		}
+	}
+	if err = c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if !c.throughput.backgroundSweepPending() {
+		t.Fatal("no background work")
+	}
+	child, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, r := range roots {
+		if err = c.StructSet(r, 0, RefValue(child)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = c.FinishBackgroundSweep(); err != nil {
+		t.Fatal(err)
+	}
+	e := c.handles[handleOf(roots[0])]
+	if c.throughput.immix.regions[e.off/immixBlockBytes].cards == [immixLines / 64]uint64{} {
+		t.Fatal("worker publication lost new card hints")
+	}
+	if err = c.CollectMinor(roots); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+}

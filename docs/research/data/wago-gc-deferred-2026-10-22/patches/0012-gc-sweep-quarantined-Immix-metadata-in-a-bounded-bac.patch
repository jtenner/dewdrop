+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"runtime"
+	"testing"
+)
+
+func newBackgroundSweepFixture(t *testing.T, minimum uint64) (*Collector, RefSliceRoots) {
+	t.Helper()
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 128 << 10, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096, Execution: &ExecutionOptions{BackgroundSweep: true, Telemetry: true, MinSweepBytes: minimum}})
+	var roots RefSliceRoots
+	for i := 0; i < 4096; i++ {
+		r, err := c.NewStructDefault(0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.ForcePromote(r); err != nil {
+			t.Fatal(err)
+		}
+		if i%16 < 8 {
+			roots = append(roots, r)
+		}
+	}
+	return c, roots
+}
+func TestBackgroundSweepAllocationFallbackAtHeapLimit(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	c, roots := newBackgroundSweepFixture(t, 1024)
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if !c.throughput.backgroundSweepPending() {
+		t.Fatal("eligible sweep did not launch")
+	}
+	before := c.throughput.bump
+	entry, err := c.throughput.alloc(8, spaceOld, true)
+	if err != nil {
+		t.Fatalf("allocation did not assist/join: %v", err)
+	}
+	if c.throughput.bump != before {
+		t.Fatal("allocation grew rather than reusing swept lines")
+	}
+	if err = c.throughput.free(entry); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.FinishBackgroundSweep(); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+	stats := c.CycleTelemetry()
+	if stats.BackgroundTasks != 1 || stats.BackgroundSweptBytes == 0 {
+		t.Fatalf("missing background counters: %+v", stats)
+	}
+}
+func TestBackgroundSweepThresholdAndSingleProcessorRemainWorkerFree(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	for _, processors := range []int{1, 2} {
+		runtime.GOMAXPROCS(processors)
+		minimum := uint64(1)
+		if processors == 2 {
+			minimum = 1 << 30
+		}
+		c, roots := newBackgroundSweepFixture(t, minimum)
+		if err := c.CollectFull(roots); err != nil {
+			t.Fatal(err)
+		}
+		if c.throughput.backgroundSweepPending() || c.CycleTelemetry().BackgroundTasks != 0 {
+			t.Fatal("small/unavailable sweep started a worker")
+		}
+		if err := c.Verify(roots); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+func TestBackgroundSweepCloseJoinsBeforeUnmapping(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	c, roots := newBackgroundSweepFixture(t, 1024)
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	task := c.throughput.immix.execution.sweep
+	if task == nil {
+		t.Fatal("no pending background sweep")
+	}
+	c.Close()
+	select {
+	case <-task.done:
+	default:
+		t.Fatal("Close returned before joining sweep")
+	}
+}
+func TestBackgroundSweepMergesMutatorCardHints(t *testing.T) {

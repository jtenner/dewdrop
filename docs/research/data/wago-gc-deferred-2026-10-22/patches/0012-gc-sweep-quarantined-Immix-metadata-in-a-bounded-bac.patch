diff --git a/src/core/runtime/gc/native/sweep_background_enabled.go b/src/core/runtime/gc/native/sweep_background_enabled.go
new file mode 100644
index 000000000..0176acce7
--- /dev/null
+++ b/src/core/runtime/gc/native/sweep_background_enabled.go
@@ -0,0 +1,165 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"fmt"
+	"runtime"
+	"time"
+)
+
+const maxBackgroundSweepRegions = 64
+const maxBackgroundSweepSpans = 32768
+
+type backgroundSweepRegion struct {
+	block         uint32
+	before, after immixRegion
+	spans         []throughputFreeSpan
+}
+type backgroundSweep struct {
+	done    chan struct{}
+	jobs    []backgroundSweepRegion
+	bytes   uint64
+	elapsed uint64
+	err     error
+	epoch   uint32
+}
+
+func (m *immixHeap) backgroundBusy(block uint32) bool {
+	x := m.execution
+	return x != nil && int(block/64) < len(x.busy) && x.busy[block/64]&(uint64(1)<<(block%64)) != 0
+}
+func (h *throughputHeap) backgroundSweepPending() bool {
+	return h.immix != nil && h.immix.execution != nil && h.immix.execution.sweep != nil
+}
+
+// Only copied integer/region metadata crosses into the worker. Busy regions
+// cannot serve allocation until the owner joins and publishes the result.
+// Payload stores can continue; region cards are merged on publication.
+func (h *throughputHeap) startBackgroundSweep() {
+	m := h.immix
+	if m == nil || m.execution == nil {
+		return
+	}
+	x := m.execution
+	if !x.options.BackgroundSweep || x.sweep != nil || h.pendingBytes < x.options.MinSweepBytes || runtime.GOMAXPROCS(0) < 2 {
+		return
+	}
+	task := &backgroundSweep{done: make(chan struct{}), epoch: m.epoch}
+	byBlock := make(map[uint32]int)
+	retained := h.pendingFree[:0]
+	spans := 0
+	for _, span := range h.pendingFree {
+		block := span.off / immixBlockBytes
+		if spans >= maxBackgroundSweepSpans || uint64(span.off%immixBlockBytes)+uint64(span.size) > uint64(immixBlockBytes) || m.regions[block].kind == immixLarge {
+			retained = append(retained, span)
+			continue
+		}
+		index, ok := byBlock[block]
+		if !ok {
+			if len(task.jobs) == maxBackgroundSweepRegions {
+				retained = append(retained, span)
+				continue
+			}
+			index = len(task.jobs)
+			byBlock[block] = index
+			task.jobs = append(task.jobs, backgroundSweepRegion{block: block, before: m.regions[block]})
+		}
+		task.jobs[index].spans = append(task.jobs[index].spans, span)
+		task.bytes += uint64(span.size)
+		spans++
+	}
+	clear(h.pendingFree[len(retained):])
+	h.pendingFree = retained
+	if task.bytes < x.options.MinSweepBytes {
+		for _, job := range task.jobs {
+			h.pendingFree = append(h.pendingFree, job.spans...)
+		}
+		return
+	}
+	words := (len(m.regions) + 63) / 64
+	if len(x.busy) < words {
+		x.busy = append(x.busy, make([]uint64, words-len(x.busy))...)
+	}
+	for _, job := range task.jobs {
+		x.busy[job.block/64] |= uint64(1) << (job.block % 64)
+		for i, cursor := range m.cursors {
+			if cursor.end != 0 && cursor.block == job.block {
+				m.cursors[i] = immixCursor{}
+			}
+		}
+	}
+	task.err = injectFailure(h, failBackgroundSweep)
+	x.sweep = task
+	x.backgroundTasks++
+	go task.run()
+}
+func (task *backgroundSweep) run() {
+	start := time.Now()
+	defer func() { task.elapsed = uint64(time.Since(start)); close(task.done) }()
+	if task.err != nil {
+		return
+	}
+	for i := range task.jobs {
+		job := &task.jobs[i]
+		localRegions := [1]immixRegion{job.before}
+		local := immixHeap{regions: localRegions[:], epoch: task.epoch}
+		for _, span := range job.spans {
+			span.off %= immixBlockBytes
+			if err := local.release(span); err != nil {
+				task.err = fmt.Errorf("gc: background region%d sweep: %w", job.block, err)
+				return
+			}
+		}
+		job.after = local.regions[0]
+	}
+}
+func (h *throughputHeap) finishBackgroundSweep(wait bool) (bool, error) {
+	if !h.backgroundSweepPending() {
+		return false, nil
+	}
+	m := h.immix
+	x := m.execution
+	task := x.sweep
+	start := time.Now()
+	if wait {
+		<-task.done
+	} else {
+		select {
+		case <-task.done:
+		default:
+			return false, nil
+		}
+	}
+	x.assistWaitNS += uint64(time.Since(start))
+	for _, job := range task.jobs {
+		if task.err == nil {
+			result := job.after
+			// Native/Go barriers may update card hints while metadata is quarantined.
+			result.cards = m.regions[job.block].cards
+			m.regions[job.block] = result
+		} else {
+			h.pendingFree = append(h.pendingFree, job.spans...)
+		}
+		x.busy[job.block/64] &^= uint64(1) << (job.block % 64)
+	}
+	if task.err == nil {
+		h.pendingBytes -= task.bytes
+		x.backgroundSweptBytes += task.bytes
+	}
+	if x.options.Telemetry {
+		x.record(CollectionCycle{Kind: CollectionBackgroundSweep, Workers: 1, Failed: task.err != nil, WallNS: task.elapsed, SweepNS: task.elapsed, WorkerNS: task.elapsed, HeapBytes: uint64(h.bump)})
+	}
+	x.sweep = nil
+	return true, task.err
+}
+
+// FinishBackgroundSweep joins pending metadata work and exposes any worker
+// failure. Allocation, collection, verification and Close join automatically.
+func (c *Collector) FinishBackgroundSweep() error {
+	if err := c.errIfClosed(); err != nil {
+		return err
+	}
+	_, err := c.throughput.finishBackgroundSweep(true)
+	return err
+}

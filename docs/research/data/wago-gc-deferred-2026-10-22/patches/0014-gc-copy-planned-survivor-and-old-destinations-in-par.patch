+
+func BenchmarkParallelEvacuation(b *testing.B) {
+	counts := []uint16{1, 2, 4, uint16(min(128, runtime.GOMAXPROCS(0)))}
+	seen := map[uint16]bool{}
+	for _, workers := range counts {
+		if seen[workers] {
+			continue
+		}
+		seen[workers] = true
+		for _, length := range []uint32{1, 128} {
+			b.Run(fmt.Sprintf("array%d/workers%d", length, workers), func(b *testing.B) {
+				var pause, copyPhase, workerTime uint64
+				for iteration := 0; iteration < b.N; iteration++ {
+					b.StopTimer()
+					array, err := NewArrayDesc(0, StorageI64)
+					if err != nil {
+						b.Fatal(err)
+					}
+					c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 32 << 20, DisableMovingNursery: true, ThroughputHeapBytes: 32 << 20, ThroughputPageBytes: 4096, Execution: &ExecutionOptions{Workers: workers, Telemetry: true, MinCopyBytes: 1}}, []TypeDesc{array})
+					if err != nil {
+						b.Fatal(err)
+					}
+					roots := make(RefSliceRoots, 16384)
+					for i := range roots {
+						roots[i], err = c.NewArrayDefault(0, length)
+						if err != nil {
+							b.Fatal(err)
+						}
+						if err = c.ArraySet(roots[i], length-1, I64Value(int64(i)+7)); err != nil {
+							b.Fatal(err)
+						}
+					}
+					b.StartTimer()
+					err = c.CollectMinor(roots)
+					b.StopTimer()
+					if err != nil {
+						b.Fatal(err)
+					}
+					record := c.CycleTelemetry().Cycles[0]
+					b.ReportMetric(float64(record.Workers), "actual-workers")
+					pause += record.PauseNS
+					copyPhase += record.CopyNS
+					workerTime += record.WorkerNS
+					for i, r := range roots {
+						v, err := c.ArrayGet(r, length-1)
+						if err != nil || v.I64() != int64(i)+7 {
+							b.Fatal("copy payload changed")
+						}
+					}
+					c.Close()
+				}
+				b.ReportMetric(float64(pause)/float64(b.N), "pause-ns")
+				b.ReportMetric(float64(copyPhase)/float64(b.N), "copy-plan-ns")
+				b.ReportMetric(float64(workerTime)/float64(b.N), "worker-elapsed-ns")
+			})
+		}
+	}
+}

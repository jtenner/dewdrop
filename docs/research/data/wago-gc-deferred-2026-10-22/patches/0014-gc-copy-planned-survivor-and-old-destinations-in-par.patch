index 000000000..7c21793d4
--- /dev/null
+++ b/src/core/runtime/gc/native/copy_parallel_enabled.go
@@ -0,0 +1,125 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"runtime"
+	"sync"
+	"time"
+)
+
+const parallelCopyChunkBytes = 64 << 10
+
+type parallelCopyChunk struct {
+	start, end int
+	elapsed    uint64
+}
+
+func (c *Collector) parallelCopyPlans(plans []plannedPromotion) bool {
+	m := c.throughput.immix
+	if m == nil || m.execution == nil {
+		return false
+	}
+	x := m.execution
+	x.lastCopyWorkers = 1
+	workers := min(int(x.options.Workers), runtime.GOMAXPROCS(0))
+	if workers < 2 {
+		return false
+	}
+	var total uint64
+	for _, p := range plans {
+		if p.entry.space != spaceLarge {
+			total += uint64(p.entry.size)
+		}
+	}
+	workers = min(workers, int(total/parallelCopyChunkBytes), len(plans))
+	if workers < 2 || total < x.options.MinCopyBytes {
+		return false
+	}
+	chunks := x.copyChunks[:0]
+	target := (total + uint64(workers) - 1) / uint64(workers)
+	start := 0
+	var bytes uint64
+	for i, p := range plans {
+		if p.entry.space != spaceLarge {
+			source := c.handles[p.handle]
+			if p.entry.space != spaceNursery && p.entry.space != spaceOld {
+				panic("gc: parallel copy destination has invalid space")
+			}
+			if p.entry.space == spaceNursery {
+				base := c.survivorBase(c.survivorFrom ^ 1)
+				if p.entry.off < base || uint64(p.entry.off)+uint64(p.entry.size) > uint64(base)+uint64(c.survivorBytes) {
+					panic("gc: parallel copy destination is not in the inactive survivor space")
+				}
+			}
+			if source.space != spaceNursery || source.size != p.entry.size {
+				panic("gc: parallel copy plan has an invalid nursery source or extent")
+			}
+			totalSource := uint64(source.off) + uint64(source.size)
+			totalDestination := uint64(p.entry.off) + uint64(p.entry.size)
+			if totalSource > uint64(len(c.nursery)) || p.entry.space == spaceNursery && totalDestination > uint64(len(c.nursery)) || p.entry.space == spaceOld && totalDestination > uint64(len(c.throughput.mem)) {
+				panic("gc: parallel copy plan exceeds reserved backing")
+			}
+			bytes += uint64(p.entry.size)
+		}
+		if bytes >= target && len(chunks) < workers-1 {
+			chunks = append(chunks, parallelCopyChunk{start: start, end: i + 1})
+			start = i + 1
+			bytes = 0
+		}
+	}
+	if start < len(plans) {
+		chunks = append(chunks, parallelCopyChunk{start: start, end: len(plans)})
+	}
+	x.copyChunks = chunks
+	var group sync.WaitGroup
+	group.Add(len(chunks))
+	// All destinations and commit failures were resolved before this call.
+	// Chunks own disjoint fully reserved destinations; handles remain unchanged.
+	for i := range chunks {
+		go func(index int) {
+			defer group.Done()
+			begin := time.Now()
+			chunk := &chunks[index]
+			for _, p := range plans[chunk.start:chunk.end] {
+				if p.entry.space == spaceLarge {
+					continue
+				}
+				source := c.handles[p.handle]
+				from := c.nursery[source.off : source.off+source.size]
+				if p.entry.space == spaceNursery {
+					copy(c.nursery[p.entry.off:p.entry.off+p.entry.size], from)
+				} else {
+					copy(c.throughput.mem[p.entry.off:p.entry.off+p.entry.size], from)
+				}
+			}
+			chunk.elapsed = uint64(time.Since(begin))
+		}(i)
+	}
+	group.Wait()
+	for _, chunk := range chunks {
+		x.copyWorkerNS += chunk.elapsed
+	}
+	x.lastCopyWorkers = uint16(len(chunks))
+	x.parallelCopyCycles++
+	return true
+}
+
+// publishPrecopiedPromotion mirrors promoteHandleTo after workers have joined.
+// No source poisoning or handle publication is allowed during the copy phase.
+func (c *Collector) publishPrecopiedPromotion(h uint32, entry handleEntry) {
+	if nativeCollectorFastPaths && c.majorYoungDirty {
+		c.noteMajorHandle(h)
+	}
+	source := c.handles[h]
+	entry.typeID = source.typeID
+	entry.class |= source.class & NativeHandlePointerFreeBit
+	c.poisonYoungSource(source)
+	c.handles[h] = entry
+}
+func (c *Collector) copyExecutionWorkers() int {
+	if c.throughput.immix == nil || c.throughput.immix.execution == nil {
+		return 1
+	}
+	return max(1, int(c.throughput.immix.execution.lastCopyWorkers))
+}
diff --git a/src/core/runtime/gc/native/copy_parallel_test.go b/src/core/runtime/gc/native/copy_parallel_test.go
new file mode 100644
index 000000000..98217d2af
--- /dev/null
+++ b/src/core/runtime/gc/native/copy_parallel_test.go
@@ -0,0 +1,117 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"runtime"
+	"testing"
+)
+
+func newParallelCopyCollector(t testing.TB, workers uint16, immediate bool) *Collector {
+	t.Helper()
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	array, err := NewArrayDesc(1, StorageI64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg := Config{Allocator: AllocatorImmix, NurseryBytes: 4 << 20, SurvivorBytes: 1 << 20, ThroughputHeapBytes: 4 << 20, ThroughputPageBytes: 4096, PoisonFreed: true, Execution: &ExecutionOptions{Workers: workers, Telemetry: true, MinCopyBytes: 1}}
+	if immediate {
+		cfg.SurvivorBytes = 0
+		cfg.DisableMovingNursery = true
+	}
+	c, err := NewCollector(cfg, []TypeDesc{node, array})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(c.Close)
+	return c
+}
+func allocateParallelCopyNodes(t testing.TB, c *Collector, count int) RefSliceRoots {
+	t.Helper()
+	roots := make(RefSliceRoots, count)
+	for i := range roots {
+		var err error
+		roots[i], err = c.NewStructDefault(0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.StructSet(roots[i], 1, I64Value(int64(i)+1000)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return roots
+}
+func TestParallelCopyPublishesAfterCompleteInitialization(t *testing.T) {
+	previous := runtime.GOMAXPROCS(4)
+	defer runtime.GOMAXPROCS(previous)
+	for _, immediate := range []bool{false, true} {
+		c := newParallelCopyCollector(t, 4, immediate)
+		roots := allocateParallelCopyNodes(t, c, 16384)
+		large, err := c.NewArrayDefault(1, 8192)
+		if err != nil {
+			t.Fatal(err)
+		}
+		roots = append(roots, large)
+		largeOffset := c.handles[handleOf(large)].off
+		if err = c.CollectMinor(roots); err != nil {
+			t.Fatal(err)
+		}
+		for i, r := range roots[:16384] {
+			v, err := c.StructGet(r, 1)
+			if err != nil || v.I64() != int64(i)+1000 {
+				t.Fatalf("first copy object%d: %v", i, err)
+			}
+		}
+		if c.handles[handleOf(large)].off != largeOffset {
+			t.Fatal("large young object was copied")
+		}
+		if !immediate {
+			young := allocateParallelCopyNodes(t, c, 8192)
+			child := young[0]
+			for _, r := range roots[:16384] {
+				if err = c.StructSet(r, 0, RefValue(child)); err != nil {
+					t.Fatal(err)
+				}
+			}
+			roots = append(roots, young...)
+			if err = c.CollectMinor(roots); err != nil {
+				t.Fatal(err)
+			}
+			if c.handles[handleOf(roots[0])].young() || !c.handles[handleOf(child)].young() || !c.handles[handleOf(roots[0])].remembered {
+				t.Fatal("mixed survivor/old publication lost generation cards")
+			}
+		}
+		if err = c.Verify(roots); err != nil {
+			t.Fatal(err)
+		}
+		stats := c.CycleTelemetry()
+		if stats.ParallelCopyCycles == 0 || stats.CopyWorkerNS == 0 {
+			t.Fatal("parallel copy did not run")
+		}
+		if cycle := stats.Cycles[len(stats.Cycles)-1]; cycle.Workers < 2 || cycle.WorkerNS == 0 {
+			t.Fatalf("missing per-cycle workers: %+v", cycle)
+		}
+	}
+}
+func TestParallelCopyThresholdKeepsSmallMinorWorkerFree(t *testing.T) {
+	c := newParallelCopyCollector(t, 4, true)
+	roots := allocateParallelCopyNodes(t, c, 128)
+	if err := c.CollectMinor(roots); err != nil {
+		t.Fatal(err)
+	}
+	if c.CycleTelemetry().ParallelCopyCycles != 0 {
+		t.Fatal("tiny copy started workers")
+	}
+	c = newParallelCopyCollector(t, 4, true)
+	c.throughput.immix.execution.options.MinCopyBytes = 1 << 30
+	roots = allocateParallelCopyNodes(t, c, 16384)
+	if err := c.CollectMinor(roots); err != nil {
+		t.Fatal(err)
+	}
+	if c.CycleTelemetry().ParallelCopyCycles != 0 {
+		t.Fatal("copy byte threshold ignored")
+	}
+}

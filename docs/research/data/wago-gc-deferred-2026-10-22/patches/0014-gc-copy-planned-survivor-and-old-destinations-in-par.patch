diff --git a/src/core/runtime/gc/native/execution_bench_test.go b/src/core/runtime/gc/native/execution_bench_test.go
index 5fa8bdb34..0966ccd2e 100644
--- a/src/core/runtime/gc/native/execution_bench_test.go

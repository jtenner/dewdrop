diff --git a/src/core/runtime/gc/native/copy_parallel_debug_test.go b/src/core/runtime/gc/native/copy_parallel_debug_test.go
new file mode 100644
index 000000000..aa0f779b3
--- /dev/null
+++ b/src/core/runtime/gc/native/copy_parallel_debug_test.go
@@ -0,0 +1,38 @@
+//go:build wago_gc_workers && wagodebug && !tinygo
+
+package gc
+
+import (
+	"errors"
+	"runtime"
+	"testing"
+)
+
+func TestParallelCopyFailureBeforePublicationRollsBack(t *testing.T) {
+	previous := runtime.GOMAXPROCS(4)
+	defer runtime.GOMAXPROCS(previous)
+	for _, point := range []failurePoint{failPromotionDestination, failPromotionCommit} {
+		c := newParallelCopyCollector(t, 4, true)
+		roots := allocateParallelCopyNodes(t, c, 16384)
+		before := snapshotPromotionState(c)
+		cleanup := armFailure(c, point, 17)
+		err := c.CollectMinor(roots)
+		cleanup()
+		if !errors.Is(err, errInjectedFailure) {
+			t.Fatalf("failure hidden: %v", err)
+		}
+		assertPromotionStateEqual(t, c, before)
+		if c.CycleTelemetry().ParallelCopyCycles != 0 {
+			t.Fatal("copy workers ran before the final failure point")
+		}
+		if err = c.CollectMinor(roots); err != nil {
+			t.Fatal(err)
+		}
+		if c.CycleTelemetry().ParallelCopyCycles != 1 {
+			t.Fatal("parallel retry did not copy")
+		}
+		if err = c.Verify(roots); err != nil {
+			t.Fatal(err)
+		}
+	}
+}

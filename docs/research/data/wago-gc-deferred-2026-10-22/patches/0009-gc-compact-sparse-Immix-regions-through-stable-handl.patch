diff --git a/src/core/runtime/gc/native/immix_compact.go b/src/core/runtime/gc/native/immix_compact.go
new file mode 100644
index 000000000..958a0e648
--- /dev/null
+++ b/src/core/runtime/gc/native/immix_compact.go
@@ -0,0 +1,202 @@
+package gc
+
+import (
+	"errors"
+	"math/bits"
+	"sort"
+	"unsafe"
+)
+
+// CompactionResult counts one bounded selective old-space evacuation. Scratch
+// contains source snapshots and integer/metadata plans, never persistent roots.
+type CompactionResult struct {
+	BytesMoved, HandleUpdates, ScratchBytes uint64
+	RegionsSelected, RegionsReleased        uint32
+}
+type immixCandidate struct {
+	block uint32
+	score uint64
+}
+type immixEvacSource struct {
+	block  uint32
+	before immixRegion
+}
+
+const immixMaxEvacRegions = 8
+
+// CompactOld completes a full collection, then evacuates at most eight sparse
+// ordinary regions and budgetBytes of live payload (zero selects 1 MiB). Live
+// references retain their exact words. The evacuation itself is transactional;
+// the preceding collection has the normal full-collection side effects. Call
+// ReleaseUnusedMemory separately to advise newly empty regions to the OS.
+// The caller must own the same exclusive GC lease as for CollectFull.
+func (c *Collector) CompactOld(roots RootSet, budgetBytes uint64) (CompactionResult, error) {
+	if err := c.errIfClosed(); err != nil {
+		return CompactionResult{}, err
+	}
+	if c.throughput.immix == nil {
+		return CompactionResult{}, errors.New("gc: old compaction requires the Immix allocator")
+	}
+	if err := c.CollectFull(roots); err != nil {
+		return CompactionResult{}, err
+	}
+	defer c.refreshNativeView()
+	result, err := c.evacuateImmixSparse(budgetBytes)
+	if err == nil && c.cfg.VerifyAfterCollect {
+		err = c.Verify(roots)
+	}
+	return result, err
+}
+func (c *Collector) evacuateImmixSparse(budget uint64) (CompactionResult, error) {
+	var result CompactionResult
+	h := &c.throughput
+	m := h.immix
+	if m == nil || m.compacting || m.txDepth != 0 {
+		return result, errors.New("gc: invalid Immix evacuation phase")
+	}
+	if err := h.sweepAllPending(); err != nil {
+		return result, err
+	}
+	if budget == 0 {
+		budget = 1 << 20
+	}
+	candidates := make([]immixCandidate, 0, immixMaxEvacRegions)
+	// Logical bytes can undercount 16-byte charges by at most two at the minimum
+	// eight-byte object size. This conservative admission guarantees half-empty
+	// destination packing without a full-heap auxiliary occupancy array.
+	for b := range m.regions {
+		r := &m.regions[b]
+		if r.kind != immixReferences && r.kind != immixPointerFree || r.epoch != m.epoch || r.liveBytes == 0 || r.liveBytes > immixBlockBytes/4 || r.occupied > uint16(immixLines/2) {
+			continue
+		}
+		var cards uint64
+		for _, word := range r.cards {
+			cards += uint64(bits.OnesCount64(word))
+		}
+		benefit := uint64(immixBlockBytes) - uint64(r.liveBytes)*2
+		score := benefit * 1024 / (1 + uint64(r.liveBytes) + uint64(r.connections)*8 + cards*32)
+		candidate := immixCandidate{uint32(b), score}
+		at := 0
+		for at < len(candidates) && candidates[at].score >= score {
+			at++
+		}
+		if at == cap(candidates) {
+			continue
+		}
+		if len(candidates) < cap(candidates) {
+			candidates = append(candidates, immixCandidate{})
+		}
+		copy(candidates[at+1:], candidates[at:len(candidates)-1])
+		candidates[at] = candidate
+	}
+	sources := make([]immixEvacSource, 0, len(candidates))
+	var selectedBytes uint64
+	for _, candidate := range candidates {
+		r := m.regions[candidate.block]
+		if uint64(r.liveBytes) > budget-selectedBytes {
+			continue
+		}
+		sources = append(sources, immixEvacSource{candidate.block, r})
+		selectedBytes += uint64(r.liveBytes)
+	}
+	if len(sources) == 0 {
+		return result, nil
+	}
+	// Snapshot at most 256 KiB of source bytes. All selected objects can now be
+	// packed into the selected regions themselves, even with no heap headroom.
+	snapshots := make([]byte, len(sources)*int(immixBlockBytes))
+	for i, source := range sources {
+		copy(snapshots[i*int(immixBlockBytes):], h.mem[source.block*immixBlockBytes:(source.block+1)*immixBlockBytes])
+	}
+	selected := func(block uint32) int {
+		for i, s := range sources {
+			if s.block == block {
+				return i
+			}
+		}
+		return -1
+	}
+	plans := make([]plannedPromotion, 0, int(selectedBytes/8))
+	for id, e := range c.handles {
+		if e.space == spaceOld && selected(e.off/immixBlockBytes) >= 0 {
+			plans = append(plans, plannedPromotion{handle: uint32(id), entry: e})
+		}
+	}
+	// Largest first keeps bounded packing efficient; pointer-free classes keep
+	// their separate cursors. Plans retain sources until destination planning.
+	sort.Slice(plans, func(i, j int) bool { return plans[i].entry.size > plans[j].entry.size })
+	if err := injectFailure(c, failImmixEvacPlan); err != nil {
+		return result, err
+	}
+	oldCursors, oldSearch := m.cursors, m.search
+	for _, source := range sources {
+		m.resetEmptyRegion(source.block)
+	}
+	m.exclude = make([]bool, len(m.regions))
+	for b := range m.exclude {
+		m.exclude[b] = selected(uint32(b)) < 0
+	}
+	m.cursors = [2]immixCursor{}
+	m.compacting = true
+	defer func() { m.compacting = false; m.exclude = nil }()
+	tx := h.beginAllocTransaction()
+	dest := make([]handleEntry, len(plans))
+	rollback := func(n int) {
+		for i := n - 1; i >= 0; i-- {
+			h.rollbackSuccessfulAlloc(dest[i], tx.bump)
+		}
+		h.restoreAllocTransaction(tx)
+		for _, source := range sources {
+			m.regions[source.block] = source.before
+		}
+		m.cursors, m.search = oldCursors, oldSearch
+	}
+	for i, p := range plans {
+		entry, err := h.alloc(p.entry.size, spaceOld, p.entry.class&NativeHandlePointerFreeBit != 0)
+		if err != nil {
+			rollback(i)
+			return result, err
+		}
+		dest[i] = entry
+		if err = injectFailure(c, failImmixEvacDestination); err != nil {
+			rollback(i + 1)
+			return result, err
+		}
+	}
+	for range plans {
+		if err := injectFailure(c, failImmixEvacCommit); err != nil {
+			rollback(len(plans))
+			return result, err
+		}
+	}
+	h.commitAllocTransaction(tx)
+	result.ScratchBytes = uint64(len(snapshots)+cap(m.exclude)) + uint64(cap(sources))*uint64(unsafe.Sizeof(immixEvacSource{})) + uint64(cap(candidates))*uint64(unsafe.Sizeof(immixCandidate{})) + uint64(cap(plans))*uint64(unsafe.Sizeof(plannedPromotion{})) + uint64(cap(dest))*uint64(unsafe.Sizeof(handleEntry{}))
+	// Every fallible step has finished. Copy from snapshots, initialize the whole
+	// logical payload, then publish exactly one stable handle entry per object.
+	for i, p := range plans {
+		source := selected(p.entry.off / immixBlockBytes)
+		at := uint32(source)*immixBlockBytes + p.entry.off%immixBlockBytes
+		e := dest[i]
+		copy(h.mem[e.off:e.off+e.size], snapshots[at:at+e.size])
+		e.typeID = p.entry.typeID
+		e.class |= p.entry.class & NativeHandlePointerFreeBit
+		e.remembered = p.entry.remembered
+		c.handles[p.handle] = e
+		m.mark(e)
+		if e.remembered {
+			m.noteCards(e.off, e.off+e.size-1)
+		}
+		result.BytesMoved += uint64(e.size)
+		result.HandleUpdates++
+	}
+	result.RegionsSelected = uint32(len(sources))
+	for _, source := range sources {
+		if m.regions[source.block].occupied == 0 {
+			result.RegionsReleased++
+		}
+	}
+	m.evacuatedBytes += result.BytesMoved
+	m.handleUpdates += result.HandleUpdates
+	c.lastCardBounds = objectCardBounds{}
+	return result, nil
+}

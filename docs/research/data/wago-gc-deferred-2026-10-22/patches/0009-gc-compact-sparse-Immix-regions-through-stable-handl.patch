+package gc
+
+import (
+	"encoding/binary"
+	"testing"
+)
+
+func TestImmixSparseCompactionAtHeapLimitPreservesStableGraph(t *testing.T) {
+	for _, portable := range []bool{false, true} {
+		node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+		if err != nil {
+			t.Fatal(err)
+		}
+		c := newTestCollectorWithTypes(t, Config{Allocator: AllocatorImmix, NurseryBytes: 128 << 10, DisableMovingNursery: true, ThroughputHeapBytes: 4 * immixBlockBytes, ThroughputPageBytes: 4096, DisableVirtualBacking: portable}, []TypeDesc{node})
+		refs := make([]Ref, 4*int(immixBlockBytes)/16)
+		for i := range refs {
+			var err error
+			refs[i], err = c.NewStructDefault(0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.ForcePromote(refs[i]); err != nil {
+				t.Fatal(err)
+			}
+			// Test type 0 contains a reference followed by i32.
+			if err = c.StructSet(refs[i], 1, I32Value(int32(i))); err != nil {
+				t.Fatal(err)
+			}
+		}
+		roots := RefSliceRoots{}
+		for i, r := range refs {
+			if i%32 == 0 {
+				roots = append(roots, r)
+			}
+		}
+		for i, r := range roots {
+			if err := c.StructSet(r, 0, RefValue(roots[(i+1)%len(roots)])); err != nil {
+				t.Fatal(err)
+			}
+		}
+		beforeBump := c.throughput.bump
+		result, err := c.CompactOld(roots, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if result.RegionsReleased < 3 || result.BytesMoved == 0 || result.HandleUpdates != uint64(len(roots)) || result.ScratchBytes > 1<<20 {
+			t.Fatalf("portable=%v: compaction result %+v", portable, result)
+		}
+		if c.throughput.bump != beforeBump {
+			t.Fatal("compaction grew a full heap")
+		}
+		for i, r := range roots {
+			value, err := c.StructGet(r, 1)
+			if err != nil || value.I32() != int32(i*32) {
+				t.Fatalf("value%d: %+v %v", i, value, err)
+			}
+			child, err := c.StructGet(r, 0)
+			if err != nil || child.Ref != roots[(i+1)%len(roots)] {
+				t.Fatalf("edge%d changed", i)
+			}
+		}
+		if err = c.Verify(roots); err != nil {
+			t.Fatal(err)
+		}
+		// Reuse compaction-created line space without changing the stable graph.
+		for i := 0; i < 100; i++ {
+			r, err := c.NewStructDefault(0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.ForcePromote(r); err != nil {
+				t.Fatal(err)
+			}
+		}
+		for i, r := range roots {
+			if binary.LittleEndian.Uint32(c.bytes(r)[PayloadOffset+4:]) != uint32(i*32) {
+				t.Fatal("reuse changed retained payload")
+			}
+		}
+	}
+}
+
+func TestImmixCompactionBudgetAndLargeRegionExclusion(t *testing.T) {
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 128 << 10, ThroughputHeapBytes: 8 * immixBlockBytes, ThroughputPageBytes: 4096})
+	roots := RefSliceRoots{}
+	for i := 0; i < 4096; i++ {
+		r, err := c.NewStructDefault(0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.ForcePromote(r); err != nil {
+			t.Fatal(err)
+		}
+		if i%64 == 0 {
+			roots = append(roots, r)
+		}
+	}
+	large, err := c.NewArrayDefault(2, 20000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	roots = append(roots, large)
+	entry := c.handles[handleOf(large)]
+	if err = c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := c.evacuateImmixSparse(1); err != nil || got.BytesMoved != 0 {
+		t.Fatalf("tiny budget: %+v %v", got, err)
+	}
+	if got, err := c.evacuateImmixSparse(1024); err != nil || got.BytesMoved > 1024 || got.BytesMoved == 0 {
+		t.Fatalf("bounded budget: %+v %v", got, err)
+	}
+	if c.handles[handleOf(large)] != entry {
+		t.Fatal("large region was relocated")
+	}
+	if err = c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestImmixLongFragmentedHeapCompaction(t *testing.T) {
+	for _, portable := range []bool{false, true} {
+		c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 4 << 20, ThroughputHeapBytes: 16 * immixBlockBytes, ThroughputPageBytes: 4096, DisableVirtualBacking: portable})
+		roots := RefSliceRoots{}
+		expected := []int64{}
+		for round := 0; round < 32; round++ {
+			for i := 0; i < 512; i++ {
+				r, err := c.NewStructDefault(0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				value := int64(round*512 + i + 1)
+				if err = c.StructSet(r, 1, I64Value(value)); err != nil {
+					t.Fatal(err)
+				}
+				if err = c.ForcePromote(r); err != nil {
+					t.Fatal(err)
+				}
+				if i%4 == 0 {
+					roots = append(roots, r)
+					expected = append(expected, value)
+				}
+			}
+			retained := roots[:0]
+			values := expected[:0]
+			for i, r := range roots {
+				if i%2 == 0 {
+					retained = append(retained, r)
+					values = append(values, expected[i])
+				}
+			}
+			roots, expected = retained, values
+			if _, err := c.CompactOld(roots, 0); err != nil {
+				t.Fatalf("round%d: %v", round, err)
+			}
+			for i, r := range roots {
+				v, err := c.StructGet(r, 1)
+				if err != nil || v.I64() != expected[i] {
+					t.Fatalf("round%d object%d: %v", round, i, err)
+				}
+			}
+			if err := c.Verify(roots); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
+
+func TestImmixMixedVectorCompactionPreservesAlignmentAndCards(t *testing.T) {
+	vector, err := NewStructDesc(0, []StorageKind{StorageV128, StorageRefNull})
+	if err != nil {
+		t.Fatal(err)
+	}
+	scalar, err := NewStructDesc(1, []StorageKind{StorageI64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := newTestCollectorWithTypes(t, Config{Allocator: AllocatorImmix, NurseryBytes: 1 << 20, ThroughputHeapBytes: 1 << 20, ThroughputPageBytes: 4096}, []TypeDesc{vector, scalar})
+	var roots RefSliceRoots
+	for i := 0; i < 3072; i++ {
+		r, err := c.NewStructDefault(TypeID(i % 2))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i%2 == 0 {
+			err = c.StructSet(r, 0, V128Value(uint64(i), uint64(i)+17))
+		} else {
+			err = c.StructSet(r, 0, I64Value(int64(i)))
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.ForcePromote(r); err != nil {
+			t.Fatal(err)
+		}
+		if i%64 < 2 {
+			roots = append(roots, r)
+		}
+	}
+	child, err := c.NewStructDefault(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < len(roots); i += 2 {
+		if err = c.StructSet(roots[i], 1, RefValue(child)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	result, err := c.CompactOld(roots, 0)
+	if err != nil || result.BytesMoved == 0 {
+		t.Fatalf("compaction: %+v %v", result, err)
+	}
+	for i, r := range roots {
+		v, err := c.StructGet(r, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		number := uint64(i/2*64 + i%2)
+		if i%2 == 0 {
+			if v.Bits != number || v.BitsHi != number+17 || (c.handles[handleOf(r)].off+PayloadOffset)%16 != 0 {
+				t.Fatal("vector data/alignment changed")
+			}
+		} else if v.I64() != int64(number) {
+			t.Fatal("scalar data changed")
+		}
+	}
+	if err = c.CollectMinor(roots); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+}

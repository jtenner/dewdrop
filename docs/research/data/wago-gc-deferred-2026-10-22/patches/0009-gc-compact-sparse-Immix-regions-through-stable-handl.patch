+func TestImmixEvacuationFailureLeavesSourcesAndHandlesUnchanged(t *testing.T) {
+	for _, point := range []failurePoint{failImmixEvacPlan, failImmixEvacDestination, failImmixEvacCommit} {
+		for _, after := range []int{0, 1, 17} {
+			if point == failImmixEvacPlan && after != 0 {
+				continue
+			}
+			c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 128 << 10, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096})
+			var roots RefSliceRoots
+			for i := 0; i < 4096; i++ {
+				r, err := c.NewStructDefault(0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = c.ForcePromote(r); err != nil {
+					t.Fatal(err)
+				}
+				if i%32 == 0 {
+					roots = append(roots, r)
+				}
+			}
+			if err := c.CollectFull(roots); err != nil {
+				t.Fatal(err)
+			}
+			if err := c.throughput.sweepAllPending(); err != nil {
+				t.Fatal(err)
+			}
+			before := snapshotPromotionState(c)
+			regions := slices.Clone(c.throughput.immix.regions)
+			cursors := c.throughput.immix.cursors
+			payload := slices.Clone(c.throughput.mem)
+			cleanup := armFailure(c, point, after)
+			_, err := c.evacuateImmixSparse(0)
+			cleanup()
+			if !errors.Is(err, errInjectedFailure) {
+				t.Fatalf("%d/%d: missing failure: %v", point, after, err)
+			}
+			assertPromotionStateEqual(t, c, before)
+			if !slices.Equal(payload, c.throughput.mem) || !slices.Equal(regions, c.throughput.immix.regions) || cursors != c.throughput.immix.cursors {
+				t.Fatalf("%d/%d: evacuation changed source state", point, after)
+			}
+			if err = c.Verify(roots); err != nil {
+				t.Fatal(err)
+			}
+			if result, err := c.evacuateImmixSparse(0); err != nil || result.RegionsReleased == 0 {
+				t.Fatalf("retry: %+v %v", result, err)
+			}
+		}
+	}
+}

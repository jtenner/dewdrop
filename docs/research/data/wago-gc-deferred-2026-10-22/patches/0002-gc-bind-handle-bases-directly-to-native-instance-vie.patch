index 000000000..b26b70f49
--- /dev/null
+++ b/src/core/runtime/gc/native/native_bindings.go
@@ -0,0 +1,77 @@
+package gc
+
+import "sync"
+
+// Binding metadata never enters guest memory or persisted native artifacts.
+// The mutex covers physical release racing another instance's Go allocation.
+// Collector mutation/native execution retains the existing invocation lease.
+type nativeBindings struct {
+	mu    sync.Mutex
+	base  uintptr
+	views []*NativeInstanceView
+}
+
+func (c *Collector) bindInstanceView(v *NativeInstanceView) {
+	if c.bindings == nil {
+		c.bindings = &nativeBindings{base: v.Handles}
+	}
+	b := c.bindings
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	v.bindings = b
+	v.bindingSlot = len(b.views)
+	b.views = append(b.views, v)
+}
+
+func (c *Collector) refreshInstanceHandles(base uintptr) {
+	b := c.bindings
+	if b == nil || b.base == base {
+		return
+	}
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	for _, v := range b.views {
+		v.Handles = base
+	}
+	b.base = base
+}
+
+func (b *nativeBindings) close() {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	for _, v := range b.views {
+		v.revoke()
+	}
+	b.views = nil
+	b.base = 0
+}
+
+func (v *NativeInstanceView) revoke() {
+	v.Version = 0
+	v.Collector = 0
+	v.LocalTypes = 0
+	v.LocalTypeCount = 0
+	v.Handles = 0
+	v.keepTypes = nil
+}
+
+// Close releases a native binding after its instance is physically quiescent.
+// Logical Close alone is insufficient when imported code/context is retained.
+func (v *NativeInstanceView) Close() {
+	if v == nil || v.bindings == nil {
+		return
+	}
+	b := v.bindings
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	i := v.bindingSlot
+	if i >= len(b.views) || b.views[i] != v {
+		return
+	}
+	last := len(b.views) - 1
+	b.views[i] = b.views[last]
+	b.views[i].bindingSlot = i
+	b.views[last] = nil
+	b.views = b.views[:last]
+	v.revoke()
+}
diff --git a/src/core/runtime/gc/native/native_bindings_test.go b/src/core/runtime/gc/native/native_bindings_test.go
new file mode 100644
index 000000000..57ef5e6f2
--- /dev/null
+++ b/src/core/runtime/gc/native/native_bindings_test.go
@@ -0,0 +1,87 @@
+package gc
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestInstanceHandleBindingsFollowPortableGrowth(t *testing.T) {
+	c, err := NewCollector(Config{DisableVirtualBacking: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	a, err := BuildNativeInstanceView(c, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := BuildNativeInstanceView(c, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := a.Handles
+	for range 1024 {
+		c.newHandle(handleEntry{})
+	}
+	c.refreshNativeHandles()
+	if a.Handles == before || a.Handles != sliceData(c.handles) || b.Handles != a.Handles {
+		t.Fatal("instance bindings retain relocated handles")
+	}
+	b.Close()
+	if b.Handles != 0 || b.Collector != 0 {
+		t.Fatal("closed instance binding retains native addresses")
+	}
+	for range 1024 {
+		c.newHandle(handleEntry{})
+	}
+	c.refreshNativeView()
+	if a.Handles != sliceData(c.handles) || b.Handles != 0 {
+		t.Fatal("growth lost live binding or revived closed binding")
+	}
+	c.Close()
+	if a.Handles != 0 || a.Collector != 0 {
+		t.Fatal("collector close retained native binding")
+	}
+	a.Close()
+}
+
+func TestInstanceBindingReleaseDoesNotAccumulate(t *testing.T) {
+	c, err := NewCollector(Config{}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	for range 1024 {
+		v, err := BuildNativeInstanceView(c, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		v.Close()
+	}
+	if len(c.bindings.views) != 0 || cap(c.bindings.views) > 4 {
+		t.Fatal("released instance bindings accumulated")
+	}
+}
+
+func TestInstanceBindingReleaseDuringPortableGrowth(t *testing.T) {
+	c, err := NewCollector(Config{DisableVirtualBacking: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	var wg sync.WaitGroup
+	for range 512 {
+		v, err := BuildNativeInstanceView(c, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		wg.Add(1)
+		go func() { defer wg.Done(); v.Close() }()
+		c.newHandle(handleEntry{})
+		c.refreshNativeHandles()
+	}
+	wg.Wait()
+	if len(c.bindings.views) != 0 {
+		t.Fatal("physical release left native bindings registered")
+	}
+}

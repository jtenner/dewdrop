--- /dev/null
+++ b/src/core/compiler/backend/railshot/amd64/gc_concurrent_barrier.go
@@ -0,0 +1,46 @@
+//go:build amd64
+
+package amd64
+
+import gc "github.com/wago-org/wago/src/core/runtime/gc/native"
+
+// At the successful reference-store join R8 names the collector view, a saved compact parent at [RSP] and R11 its object.
+// Preserve R8/R9/R11/RSI/RDI. R9 may have been consumed by the card check. These
+// leaves may clobber RAX/RCX/RDX/R10. One domain has one mutator; graph workers
+// never read dirty words. This whole sequence is absent in non-concurrent code.
+func (f *fn) emitNativeConcurrentDirtyParent() {
+	if !gc.ConcurrentProductSupported {
+		return
+	}
+	a := f.a
+	a.Load32(RAX, R8, gc.NativeViewConcurrentActiveOffset)
+	a.TestSelf(RAX, false)
+	inactive := a.JccPlaceholder(condE)
+	// The immutable start graph already retains deleted edges. Only insertion
+	// of an object child needs an incremental-update dirty bit.
+	a.TestSelf(RDI, false)
+	childNull := a.JccPlaceholder(condE)
+	a.MovRegReg32(RAX, RDI)
+	a.AluRI(4, RAX, 1, false)
+	a.TestSelf(RAX, false)
+	childI31 := a.JccPlaceholder(condNE)
+	a.Load32(RAX, RSP, 0)
+	a.ShiftImm(5, RAX, 1, false) // validated compact parent -> handle index
+	a.MovReg64(RCX, RAX)
+	a.ShiftImm(5, RAX, 6, true) // bitmap word
+	a.AluRM(cmpRMcode, RAX, R8, gc.NativeViewConcurrentDirtyWordCountOffset, false)
+	bornOutsideSnapshot := a.JccPlaceholder(condAE)
+	a.Load64(R10, R8, gc.NativeViewConcurrentDirtyBitsOffset)
+	a.AluRI(4, RCX, 63, false)
+	a.MovImm32(RDX, 1)
+	a.ShiftCL(4, RDX, true)
+	a.ImulRI(RAX, 8, true)
+	a.Add64(R10, RAX)
+	a.Load64(RAX, R10, 0)
+	a.AluRR(0x09, RAX, RDX, true)
+	a.Store64(R10, 0, RAX)
+	a.PatchRel32(childNull, a.Len())
+	a.PatchRel32(childI31, a.Len())
+	a.PatchRel32(inactive, a.Len())
+	a.PatchRel32(bornOutsideSnapshot, a.Len())
+}

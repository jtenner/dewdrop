+func gcConcurrentNativeModule() []byte {
+	fields := make([][]byte, 40)
+	for i := range fields {
+		fields[i] = []byte{0x6d, 1}
+	}
+	parent := append([]byte{0x5f}, wasmtest.Vec(fields...)...)
+	types := [][]byte{{0x5f, 1, 0x7f, 1}, parent, {0x5e, 0x6d, 1}, wasmtest.FuncType(nil, nil), wasmtest.FuncType([]wasm.ValType{wasm.I32}, nil)}
+	imp := append(append(wasmtest.Name("env"), wasmtest.Name("step")...), 0, 3)
+	globals := [][]byte{{0x63, 1, 1, 0xd0, 1, 0x0b}, {0x63, 2, 1, 0xd0, 2, 0x0b}, {0x63, 0, 1, 0xd0, 0, 0x0b}}
+	bodies := [][]byte{
+		wasmtest.Code([]byte{0xfb, 1, 1, 0x24, 0, 0x41, 0x80, 4, 0xfb, 7, 2, 0x24, 1, 0x41, 42, 0xfb, 0, 0, 0x24, 2, 0x0b}),
+		wasmtest.Code([]byte{0x23, 0, 0x23, 2, 0xfb, 5, 1, 0, 0x0b}),
+		wasmtest.Code([]byte{0x23, 0, 0x23, 2, 0xfb, 5, 1, 32, 0x0b}),
+		wasmtest.Code([]byte{0x23, 1, 0x20, 0, 0x23, 2, 0xfb, 0x0e, 2, 0x0b}),
+		wasmtest.Code([]byte{0x23, 0, 0x23, 0, 0xfb, 5, 1, 0, 0x0b}),
+		wasmtest.Code([]byte{0x20, 0, 0xfb, 0, 0, 0x24, 2, 0x0b}),
+		wasmtest.Code([]byte{0x23, 0, 0xd0, 1, 0x24, 0, 0x10, 0, 0xfb, 2, 1, 0, 0xd1, 0x1a, 0x0b}),
+	}
+	functionTypes := [][]byte{{3}, {3}, {3}, {4}, {3}, {4}, {3}}
+	names := []string{"init", "struct_store", "struct_distant", "array_store", "struct_self", "new_child", "host_round"}
+	exports := make([][]byte, len(names))
+	for i, name := range names {
+		exports[i] = wasmtest.ExportEntry(name, 0, uint32(i+1))
+	}
+	return wasmtest.Module(wasmtest.Section(1, wasmtest.Vec(types...)), wasmtest.Section(2, wasmtest.Vec(imp)), wasmtest.Section(3, wasmtest.Vec(functionTypes...)), wasmtest.Section(6, wasmtest.Vec(globals...)), wasmtest.Section(7, wasmtest.Vec(exports...)), wasmtest.Section(10, wasmtest.Vec(bodies...)))
+}
+func concurrentNativeConfig() GCConfig {
+	return GCConfig{Allocator: GCAllocatorImmix, NurseryBytes: 1 << 20, SurvivorBytes: 512 << 10, ThroughputHeapBytes: 4 << 20, ThroughputPageBytes: 4096, VerifyAfterCollect: true, Execution: &GCExecutionOptions{ConcurrentMark: true, Telemetry: true, MinConcurrentBytes: 1, MinConcurrentObjects: 1, RemarkBudget: 1 << 20}}
+}
+func concurrentNativeGlobal(in *Instance, index int) gc.Ref {
+	return gc.Ref(uint32(readGlobalObject(in.globalCells[index], in.c.Globals[index].Type)))
+}
+func clearConcurrentParentBit(t *testing.T, in *Instance, parent gc.Ref) func() {
+	t.Helper()
+	view := in.gc.NativeView()
+	h := uint32(parent) >> 1
+	if view.ConcurrentActive != 1 || h/64 >= view.ConcurrentDirtyWordCount {
+		t.Fatal("native parent is outside its active dirty bitmap")
+	}
+	words := unsafe.Slice((*uint64)(offHeapPtr(view.ConcurrentDirtyBits)), int(view.ConcurrentDirtyWordCount))
+	mask := uint64(1) << (h % 64)
+	words[h/64] &^= mask
+	return func() {
+		t.Helper()
+		if words[h/64]&mask == 0 {
+			t.Fatalf("native store did not dirty parent handle%d", h)
+		}
+	}
+}
+func TestGCConcurrentNativeStoreBarriersAndArtifactReload(t *testing.T) {
+	compiled, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3), gcConcurrentNativeModule())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer compiled.Close()
+	loaded := publicArtifactRoundTrip(t, compiled)
+	defer loaded.Close()
+	for _, artifact := range []*Compiled{compiled, loaded} {
+		for _, old := range []bool{false, true} {
+			in, err := Instantiate(artifact, InstantiateOptions{GC: concurrentNativeConfig(), Imports: testImports("env.step", slotHostFunc(func(HostModule, []uint64, []uint64) {}))})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err = in.Invoke("init"); err != nil {
+				t.Fatal(err)
+			}
+			parent, array := concurrentNativeGlobal(in, 0), concurrentNativeGlobal(in, 1)
+			if old {
+				if err = in.gc.ForcePromote(parent); err != nil {
+					t.Fatal(err)
+				}
+				if err = in.gc.ForcePromote(array); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if started, err := in.StartConcurrentGC(); err != nil || !started {
+				t.Fatalf("start: %v %v", started, err)
+			}
+			for _, test := range []struct {
+				name string
+				ref  gc.Ref
+				args []uint64
+			}{{"struct_self", parent, nil}, {"struct_store", parent, nil}, {"struct_distant", parent, nil}, {"array_store", array, []uint64{0}}, {"array_store", array, []uint64{40}}} {
+				// First old-to-young access can create cards in Go. The second must
+				// independently dirty the parent on the covered native leaf path.
+				if _, err = in.Invoke(test.name, test.args...); err != nil {
+					t.Fatal(err)
+				}
+				assertDirty := clearConcurrentParentBit(t, in, test.ref)
+				if _, err = in.Invoke(test.name, test.args...); err != nil {
+					t.Fatal(err)
+				}
+				assertDirty()
+			}
+			if _, err = in.Invoke("new_child", 73); err != nil {
+				t.Fatal(err)
+			}
+			if _, err = in.Invoke("struct_store"); err != nil {
+				t.Fatal(err)
+			}
+			if _, err = in.Invoke("array_store", 0); err != nil {
+				t.Fatal(err)
+			}
+			if done, err := in.FinishConcurrentGC(); err != nil || !done {
+				t.Fatalf("finish: %v %v", done, err)
+			}
+			child, err := in.gc.StructGet(parent, 0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			value, err := in.gc.StructGet(child.Ref, 0)
+			if err != nil || value.I32() != 73 {
+				t.Fatalf("stored child: %+v %v", value, err)
+			}
+			if err = in.CollectGC(); err != nil {
+				t.Fatal(err)
+			}
+			if history, err := in.GCCycleTelemetry(); err != nil || history.ConcurrentCompletes != 1 {
+				t.Fatalf("history: %+v %v", history, err)
+			}
+			in.Close()
+		}
+	}
+}
+func TestGCConcurrentHostReentryExactFrameRoots(t *testing.T) {
+	compiled, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3), gcConcurrentNativeModule())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer compiled.Close()
+	var owner *Instance
+	called := false
+	var callbackErr error
+	callback := slotHostFunc(func(caller HostModule, _ []uint64, _ []uint64) {
+		called = true
+		if started, err := owner.StartConcurrentGC(); err != nil || !started {
+			callbackErr = fmt.Errorf("host start: %v %v", started, err)
+			return
+		}
+		if _, err := owner.InvokeFromHost(context.Background(), caller, "new_child", 91); err != nil {
+			callbackErr = err
+		}
+	})
+	owner, err = Instantiate(compiled, InstantiateOptions{GC: concurrentNativeConfig(), Imports: testImports("env.step", callback)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer owner.Close()
+	if _, err = owner.Invoke("init"); err != nil {
+		t.Fatal(err)
+	}
+	parent := concurrentNativeGlobal(owner, 0)
+	if _, err = owner.Invoke("host_round"); err != nil {
+		t.Fatal(err)
+	}
+	if !called {
+		t.Fatal("host handshake not called")
+	}
+	if callbackErr != nil {
+		t.Fatal(callbackErr)
+	}
+	if done, err := owner.FinishConcurrentGC(); err != nil || !done {
+		t.Fatalf("finish: %v %v", done, err)
+	}
+	if _, err = owner.gc.StructGet(parent, 0); err != nil {
+		t.Fatalf("parked frame root was lost: %v", err)
+	}
+	if err = owner.CollectGC(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = owner.gc.StructGet(parent, 0); err == nil {
+		t.Fatal("later collection retained released frame root")
+	}
+}
+func TestGCConcurrentSharedDomainRoots(t *testing.T) {
+	rt := NewRuntime(WithRuntimeConfig(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3)))
+	defer rt.Close()
+	module, err := rt.Compile(gcConcurrentNativeModule())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer module.Close()
+	imports := testImports("env.step", slotHostFunc(func(HostModule, []uint64, []uint64) {}))
+	first, err := rt.Instantiate(context.Background(), module, WithGC(concurrentNativeConfig()), WithImports(imports))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer first.Close()
+	second, err := rt.Instantiate(context.Background(), module, WithGC(concurrentNativeConfig()), WithImports(imports))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	if first.gc != second.gc {
+		t.Fatal("fixture did not share a collector")
+	}
+	for _, in := range []*Instance{first, second} {
+		if _, err = in.Invoke("init"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if started, err := first.StartConcurrentGC(); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	for _, in := range []*Instance{first, second} {
+		if _, err = in.Invoke("struct_store"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if done, err := second.FinishConcurrentGC(); err != nil || !done {
+		t.Fatal(done, err)
+	}
+	for _, in := range []*Instance{first, second} {
+		parent := concurrentNativeGlobal(in, 0)
+		child, err := in.gc.StructGet(parent, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if value, err := in.gc.StructGet(child.Ref, 0); err != nil || value.I32() != 42 {
+			t.Fatal(value, err)
+		}
+	}
+}

+func TestGCConcurrentAutomaticNativeRefillSafepoints(t *testing.T) {
+	compiled := gcReadRegionsCompiled(t)
+	cfg := concurrentNativeConfig()
+	cfg.NurseryBytes = 256
+	cfg.SurvivorBytes = 128
+	cfg.Execution.AutoConcurrent = true
+	in, err := Instantiate(compiled, InstantiateOptions{GC: cfg})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer in.Close()
+	if _, err = in.Invoke("init"); err != nil {
+		t.Fatal(err)
+	}
+	for round := 0; round < 32; round++ {
+		// roots deliberately clears its reference global; restore the fixture.
+		if _, err = in.Invoke("init"); err != nil {
+			t.Fatal(err)
+		}
+		if got, err := in.Invoke("roots"); err != nil || len(got) != 1 || got[0] != 1040 {
+			t.Fatalf("automatic root round%d: %v %v", round, got, err)
+		}
+		if got, err := in.Invoke("loop", 8192); err != nil || len(got) != 1 || got[0] != 57344 {
+			t.Fatalf("automatic read round%d: %v %v", round, got, err)
+		}
+	}
+	if _, err = in.FinishConcurrentGC(); err != nil {
+		t.Fatal(err)
+	}
+	history, err := in.GCCycleTelemetry()
+	if err != nil || history.ConcurrentStarts == 0 {
+		t.Fatalf("automatic native marking not exercised: %+v %v", history, err)
+	}
+}

index 000000000..31744e6af
--- /dev/null
+++ b/src/core/runtime/gc/native/concurrent_test.go
@@ -0,0 +1,382 @@
+//go:build wago_gc_concurrent && wago_gc_workers && amd64 && !tinygo
+
+package gc
+
+import (
+	"errors"
+	"runtime"
+	"testing"
+)
+
+func newConcurrentTestCollector(t testing.TB, remark uint64) *Collector {
+	t.Helper()
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	array, err := NewArrayDesc(1, StorageRefNull)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 1 << 20, SurvivorBytes: 512 << 10, ThroughputHeapBytes: 4 << 20, ThroughputPageBytes: 4096, Execution: &ExecutionOptions{ConcurrentMark: true, Telemetry: true, MinConcurrentBytes: 1, MinConcurrentObjects: 1, MaxSnapshotBytes: 8 << 20, RemarkBudget: remark}}, []TypeDesc{node, array})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(c.Close)
+	return c
+}
+func concurrentNode(t testing.TB, c *Collector, value int64, old bool) Ref {
+	t.Helper()
+	r, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.StructSet(r, 1, I64Value(value)); err != nil {
+		t.Fatal(err)
+	}
+	if old {
+		if err = c.ForcePromote(r); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return r
+}
+func concurrentSet(t testing.TB, c *Collector, parent, child Ref) {
+	t.Helper()
+	if err := c.StructSet(parent, 0, RefValue(child)); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestConcurrentSnapshotDeletionInsertionBirthsAndChangingRoots(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	parent := concurrentNode(t, c, 1, true)
+	deleted := concurrentNode(t, c, 2, true)
+	white := concurrentNode(t, c, 3, true)
+	descendant := concurrentNode(t, c, 4, true)
+	changingRoot := concurrentNode(t, c, 5, true)
+	dead := concurrentNode(t, c, 6, true)
+	youngParent := concurrentNode(t, c, 7, false)
+	concurrentSet(t, c, parent, deleted)
+	concurrentSet(t, c, white, descendant)
+	roots := RefSliceRoots{parent, youngParent}
+	if started, err := c.StartConcurrent(roots); err != nil || !started {
+		t.Fatalf("start: %v %v", started, err)
+	}
+	if c.nativeView.ConcurrentActive != 1 || c.nativeView.ConcurrentDirtyBits == 0 {
+		t.Fatal("native barrier state not published")
+	}
+	concurrentSet(t, c, parent, Null())
+	concurrentSet(t, c, youngParent, white)
+	born := concurrentNode(t, c, 8, false)
+	concurrentSet(t, c, born, changingRoot)
+	// Born objects are black even if not in the final exact root set.
+	roots = append(roots, changingRoot)
+	c.throughput.immix.epoch = ^uint32(0)
+	if completed, err := c.FinishConcurrent(roots); err != nil || !completed {
+		t.Fatalf("finish: %v %v", completed, err)
+	}
+	for _, r := range []Ref{parent, deleted, white, descendant, changingRoot, youngParent, born} {
+		if !c.validObjectRef(r) {
+			t.Fatalf("lost live/floating identity %d", r)
+		}
+	}
+	if c.validObjectRef(dead) {
+		t.Fatal("initial unreachable object was retained")
+	}
+	if c.nativeView.ConcurrentActive != 0 || c.nativeView.ConcurrentDirtyBits != 0 || c.ConcurrentStatus().Phase != ConcurrentComplete {
+		t.Fatal("completed cycle left a native barrier active")
+	}
+	if err := c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if c.validObjectRef(deleted) {
+		t.Fatal("a later exact collection retained snapshot floating garbage")
+	}
+}
+func TestConcurrentBulkAndDeferredWrites(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	a, err := c.NewArrayDefault(1, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(a); err != nil {
+		t.Fatal(err)
+	}
+	white := concurrentNode(t, c, 17, true)
+	source, err := c.NewArrayDefault(1, 64)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ArrayFill(source, 0, RefValue(white), 64); err != nil {
+		t.Fatal(err)
+	}
+	if started, err := c.StartConcurrent(RefSliceRoots{a}); err != nil || !started {
+		t.Fatalf("start: %v %v", started, err)
+	}
+	if err = c.ArraySetDeferredBarrier(a, 0, RefValue(white)); err != nil {
+		t.Fatal(err)
+	}
+	c.PostBulkWriteBarrier(a, 0, 1)
+	if err = c.ArrayCopy(a, 1, source, 1, 32); err != nil {
+		t.Fatal(err)
+	}
+	born, err := c.NewArrayDefault(1, 20000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ArrayFill(born, 0, RefValue(white), 20000); err != nil {
+		t.Fatal(err)
+	}
+	if done, err := c.FinishConcurrent(RefSliceRoots{a}); err != nil || !done {
+		t.Fatalf("finish: %v %v", done, err)
+	}
+	if !c.validObjectRef(white) || !c.validObjectRef(born) {
+		t.Fatal("bulk/birth edge was lost")
+	}
+	if err = c.CollectMinor(RefSliceRoots{a, born}); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.Verify(RefSliceRoots{a, born}); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestConcurrentBudgetAbortNeverSweepsPartialMarks(t *testing.T) {
+	c := newConcurrentTestCollector(t, 32)
+	roots := make(RefSliceRoots, 128)
+	for i := range roots {
+		roots[i] = concurrentNode(t, c, int64(i), false)
+	}
+	if started, err := c.StartConcurrent(roots); err != nil || !started {
+		t.Fatalf("start: %v %v", started, err)
+	}
+	if done, err := c.FinishConcurrent(roots); done || !errors.Is(err, ErrConcurrentRemarkBudget) {
+		t.Fatalf("budget failure hidden: %v %v", done, err)
+	}
+	for _, r := range roots {
+		if !c.validObjectRef(r) {
+			t.Fatal("aborted remark reclaimed an identity")
+		}
+	}
+	if c.ConcurrentStatus().Phase != ConcurrentAborted || c.ConcurrentStatus().Reason == "" || c.nativeView.ConcurrentActive != 0 {
+		t.Fatal("abort not visible/disabled")
+	}
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestConcurrentSnapshotMemoryBudgetIsVisible(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	for i := 0; i < 1024; i++ {
+		concurrentNode(t, c, int64(i), false)
+	}
+	c.throughput.immix.execution.options.MaxSnapshotBytes = 4096
+	if started, err := c.StartConcurrent(EmptyRoots{}); started || !errors.Is(err, ErrConcurrentSnapshotBudget) {
+		t.Fatalf("memory budget hidden: %v %v", started, err)
+	}
+	if c.concurrentActive() || c.CycleTelemetry().ConcurrentSnapshotDeclines != 1 {
+		t.Fatal("declined snapshot started work")
+	}
+	if err := c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestConcurrentYoungCollectionAndExplicitPromotionHandshake(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	root := concurrentNode(t, c, 13, false)
+	if started, err := c.StartConcurrent(RefSliceRoots{root}); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	if err := c.CollectMinor(RefSliceRoots{root}); err != nil {
+		t.Fatal(err)
+	}
+	if c.concurrentActive() || !c.validObjectRef(root) || c.Stats().FullCollections != 1 {
+		t.Fatal("young collection skipped concurrent handshake")
+	}
+	if started, err := c.StartConcurrent(RefSliceRoots{root}); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	if err := c.ForcePromote(root); err != nil {
+		t.Fatal(err)
+	}
+	if c.concurrentActive() || c.ConcurrentStatus().Phase != ConcurrentAborted || !c.validObjectRef(root) {
+		t.Fatal("explicit promotion did not cancel before changing birth ledger")
+	}
+}
+func TestConcurrentCloseJoinsGraphWorker(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	root := concurrentNode(t, c, 1, false)
+	if started, err := c.StartConcurrent(RefSliceRoots{root}); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	cycle := c.throughput.immix.execution.concurrent
+	c.Close()
+	select {
+	case <-cycle.done:
+	default:
+		t.Fatal("close did not join")
+	}
+	if c.nativeView.ConcurrentActive != 0 || c.nativeView.ConcurrentDirtyBits != 0 {
+		t.Fatal("close left native bitmap address live")
+	}
+}
+
+func TestConcurrentMostlyNullArrayCannotEvadeSnapshotWorkLimit(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	array, err := c.NewArrayDefault(1, 100000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.throughput.immix.execution.options.MaxSnapshotBytes = 4096
+	if started, err := c.StartConcurrent(RefSliceRoots{array}); started || !errors.Is(err, ErrConcurrentSnapshotBudget) {
+		t.Fatalf("null-array decode budget hidden: %v %v", started, err)
+	}
+	if _, err = c.ArrayLen(array); err != nil {
+		t.Fatal("declined capture changed the array")
+	}
+}
+func TestConcurrentMutatorWritesDoNotRaceGraphWorker(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	roots := make(RefSliceRoots, 4096)
+	for i := range roots {
+		roots[i] = concurrentNode(t, c, int64(i), false)
+	}
+	for i, r := range roots {
+		concurrentSet(t, c, r, roots[(i+1)%len(roots)])
+	}
+	if started, err := c.StartConcurrent(roots[:1]); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	for i, r := range roots {
+		concurrentSet(t, c, r, roots[(i+17)%len(roots)])
+		if i%32 == 0 {
+			born := concurrentNode(t, c, int64(i), false)
+			concurrentSet(t, c, born, r)
+		}
+	}
+	if done, err := c.FinishConcurrent(roots[:1]); err != nil || !done {
+		t.Fatal(done, err)
+	}
+	if err := c.Verify(roots[:1]); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestConcurrentThresholdDefaultsKeepWorkerOff(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	root := concurrentNode(t, c, 1, false)
+	c.throughput.immix.execution.options.MinConcurrentBytes = ^uint64(0)
+	if started, err := c.StartConcurrent(RefSliceRoots{root}); err != nil || started || c.concurrentActive() {
+		t.Fatalf("disabled threshold admitted: %v %v", started, err)
+	}
+}
+
+func TestConcurrentDuplicateRootMemoryBudgetIsVisible(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	root := concurrentNode(t, c, 1, false)
+	roots := make(RefSliceRoots, 2000)
+	for i := range roots {
+		roots[i] = root
+	}
+	c.throughput.immix.execution.options.MaxSnapshotBytes = 4096
+	if started, err := c.StartConcurrent(roots); started || !errors.Is(err, ErrConcurrentSnapshotBudget) {
+		t.Fatalf("root memory bound hidden: %v %v", started, err)
+	}
+}
+
+func TestConcurrentAllocationPressureRunsExactFullFallback(t *testing.T) {
+	c := newConcurrentTestCollector(t, 1<<20)
+	// Limit old space to the two regions occupied by this single old array.
+	c.throughput.limit = 2 * immixBlockBytes
+	old, err := c.NewArrayDefault(1, 16000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(old); err != nil {
+		t.Fatal(err)
+	}
+	if started, err := c.StartConcurrent(RefSliceRoots{old}); err != nil || !started {
+		t.Fatal(started, err)
+	}
+	// The old root is now dead. Snapshot floating garbage must not cause an OOM
+	// after a synchronous pressure collection with the current exact empty roots.
+	replacement, err := c.NewArrayDefaultWithRoots(1, 16000, EmptyRoots{})
+	if err != nil {
+		t.Fatalf("floating snapshot root caused a false OOM: %v", err)
+	}
+	if length, err := c.ArrayLen(replacement); err != nil || length != 16000 {
+		t.Fatal(length, err)
+	}
+	if c.concurrentActive() {
+		t.Fatal("synchronous pressure left concurrent marking active")
+	}
+	if err = c.Verify(RefSliceRoots{replacement}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestConcurrentAutomaticSafepointsAndVisibleDeclines(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	c := newConcurrentTestCollector(t, 1<<20)
+	x := c.throughput.immix.execution
+	x.options.AutoConcurrent = true
+	root := concurrentNode(t, c, 1, false)
+	roots := RefSliceRoots{root}
+	for i := 0; i < 200; i++ {
+		if _, err := c.NewStructDefaultWithRoots(0, roots); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := c.CycleTelemetry(); got.ConcurrentStarts == 0 {
+		t.Fatal("automatic allocation safepoint never started")
+	}
+	if c.concurrentActive() {
+		if _, err := c.FinishConcurrent(roots); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+	c = newConcurrentTestCollector(t, 1<<20)
+	roots = nil
+	for i := 0; i < 1024; i++ {
+		roots = append(roots, concurrentNode(t, c, int64(i), false))
+	}
+	x = c.throughput.immix.execution
+	x.options.AutoConcurrent = true
+	x.options.MaxSnapshotBytes = 4096
+	if _, err := c.NewStructDefaultWithRoots(0, roots); err != nil {
+		t.Fatalf("resource admission broke normal allocation: %v", err)
+	}
+	if c.CycleTelemetry().ConcurrentSnapshotDeclines == 0 || c.ConcurrentStatus().Reason == "" {
+		t.Fatal("automatic admission failure was hidden")
+	}
+}
+func TestConcurrentAutomaticMinorBoundaryAndSingleProcessorAdmission(t *testing.T) {
+	previous := runtime.GOMAXPROCS(2)
+	defer runtime.GOMAXPROCS(previous)
+	c := newConcurrentTestCollector(t, 1<<20)
+	root := concurrentNode(t, c, 1, false)
+	c.throughput.immix.execution.options.AutoConcurrent = true
+	if err := c.CollectMinor(RefSliceRoots{root}); err != nil {
+		t.Fatal(err)
+	}
+	if c.CycleTelemetry().ConcurrentStarts != 1 {
+		t.Fatal("native refill minor safepoint did not start marking")
+	}
+	c.abortConcurrent("test boundary complete")
+	runtime.GOMAXPROCS(1)
+	c.throughput.immix.execution.nextConcurrentStart = 0
+	if _, err := c.NewStructDefaultWithRoots(0, RefSliceRoots{root}); err != nil {
+		t.Fatal(err)
+	}
+	if c.concurrentActive() {
+		t.Fatal("automatic marking started without a spare processor")
+	}
+}

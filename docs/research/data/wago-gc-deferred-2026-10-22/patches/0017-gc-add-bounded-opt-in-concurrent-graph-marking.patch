diff --git a/src/core/runtime/gc/native/concurrent_enabled.go b/src/core/runtime/gc/native/concurrent_enabled.go
new file mode 100644
index 000000000..997ca5a6c
--- /dev/null
+++ b/src/core/runtime/gc/native/concurrent_enabled.go
@@ -0,0 +1,680 @@
+//go:build wago_gc_concurrent && wago_gc_workers && amd64 && !tinygo
+
+package gc
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math/bits"
+	"runtime"
+	"sync/atomic"
+	"time"
+)
+
+const ConcurrentProductSupported = true
+const concurrentABIDelta uint32 = 2
+
+type concurrentCycle struct {
+	offsets, edges                      []uint32
+	typeCounts                          []uint32
+	alive, live, pending, dirty         []uint64
+	rootCount, nurseryPrefix            int
+	first                               int
+	done                                chan struct{}
+	stop                                atomic.Bool
+	scanned                             atomic.Uint64
+	elapsed, snapshotPause, remarkPause uint64
+	started                             time.Time
+	bytes, remarkWork                   uint64
+}
+
+func bitSet(bits []uint64, h uint32) bool {
+	return int(h/64) < len(bits) && bits[h/64]&(uint64(1)<<(h%64)) != 0
+}
+func (c *Collector) concurrentActive() bool {
+	return c.throughput.immix != nil && c.throughput.immix.execution != nil && c.throughput.immix.execution.concurrent != nil
+}
+func (c *Collector) ConcurrentStatus() ConcurrentStatus {
+	if c.throughput.immix == nil || c.throughput.immix.execution == nil {
+		return ConcurrentStatus{}
+	}
+	x := c.throughput.immix.execution
+	if s := x.concurrent; s != nil {
+		return ConcurrentStatus{Phase: ConcurrentMark, SnapshotBytes: s.bytes, ScannedEdges: s.scanned.Load()}
+	}
+	return x.concurrentStatus
+}
+func (c *Collector) refreshConcurrentView() {
+	v := c.nativeView
+	if v == nil {
+		return
+	}
+	v.ConcurrentActive = 0
+	v.ConcurrentDirtyBits = 0
+	v.ConcurrentDirtyWordCount = 0
+	if c.concurrentActive() {
+		s := c.throughput.immix.execution.concurrent
+		v.ConcurrentDirtyBits = sliceData(s.dirty)
+		v.ConcurrentDirtyWordCount = uint32(len(s.dirty))
+		v.ConcurrentActive = 1
+	}
+}
+func (c *Collector) concurrentDirtyParent(ref Ref) {
+	if !c.concurrentActive() || !ref.IsObj() {
+		return
+	}
+	s := c.throughput.immix.execution.concurrent
+	h := handleOf(ref)
+	if int(h/64) < len(s.dirty) {
+		s.dirty[h/64] |= uint64(1) << (h % 64)
+	}
+}
+
+type concurrentRootCapture struct {
+	collector       *Collector
+	snapshot        *concurrentCycle
+	err             error
+	work, workLimit uint64
+	at, end         int
+	countOnly       bool
+}
+
+func (sink *concurrentRootCapture) step(n uint64) bool {
+	if sink.err != nil {
+		return false
+	}
+	if n > sink.workLimit-sink.work {
+		sink.err = ErrConcurrentSnapshotBudget
+		return false
+	}
+	sink.work += n
+	return true
+}
+func (sink *concurrentRootCapture) VisitRootRef(ref Ref) bool {
+	if !sink.step(1) {
+		return false
+	}
+	if !sink.collector.validObjectRef(ref) {
+		return true
+	}
+	if sink.at >= sink.end {
+		if sink.countOnly {
+			sink.err = ErrConcurrentSnapshotBudget
+		} else {
+			sink.err = errors.New("gc: concurrent root universe changed while stopped")
+		}
+		return false
+	}
+	if !sink.countOnly {
+		sink.snapshot.edges[sink.at] = handleOf(ref)
+	}
+	sink.at++
+	return true
+}
+func (c *Collector) captureConcurrentRoots(roots RootSet, sink *concurrentRootCapture) {
+	if direct, ok := roots.(DirectRootRefSet); ok {
+		direct.RangeRootRefs(sink)
+	} else if roots != nil {
+		roots.RangeRoots(func(slot RootSlot) bool { return sink.VisitRootRef(slot.GetRef()) })
+	}
+	for _, ref := range c.globalSlots {
+		if !sink.VisitRootRef(ref) {
+			break
+		}
+	}
+	for _, ref := range c.tableSlots {
+		if !sink.VisitRootRef(ref) {
+			break
+		}
+	}
+}
+func (c *Collector) StartConcurrent(roots RootSet) (bool, error) {
+	if err := c.errIfClosed(); err != nil {
+		return false, err
+	}
+	m := c.throughput.immix
+	if m == nil || m.execution == nil || !m.execution.options.ConcurrentMark {
+		return false, errors.New("gc: concurrent marking was not configured")
+	}
+	x := m.execution
+	if x.concurrent != nil {
+		return false, errors.New("gc: concurrent marking is already active")
+	}
+	options := x.options
+	objects := len(c.handles) - min(len(c.freeHandles)+1, len(c.handles))
+	if uint64(c.throughput.bump)+uint64(c.nurseryBump)+uint64(c.survivorBump) < options.MinConcurrentBytes || objects < int(options.MinConcurrentObjects) {
+		return false, nil
+	}
+	start := time.Now()
+	if _, err := c.throughput.finishBackgroundSweep(true); err != nil {
+		return false, err
+	}
+	c.discardNativeStructHandles()
+	c.discardNativeLargeArrayAllocation()
+	decline := func(err error) (bool, error) {
+		x.concurrentSnapshotDeclines++
+		x.concurrentStatus = ConcurrentStatus{Phase: ConcurrentAborted, Reason: err.Error()}
+		return false, err
+	}
+	n := len(c.handles)
+	words := (n + 63) / 64
+	base := uint64(n+1)*4 + uint64(words)*32 + uint64(len(c.types))*4
+	if base > options.MaxSnapshotBytes {
+		return decline(ErrConcurrentSnapshotBudget)
+	}
+	s := &concurrentCycle{offsets: make([]uint32, n+1), alive: make([]uint64, words), live: make([]uint64, words), pending: make([]uint64, words), dirty: make([]uint64, words), first: words, done: make(chan struct{}), started: start, nurseryPrefix: len(c.nurseryHandles)}
+	// Count exact CSR capacity first. This avoids geometric edge buffers and
+	// their transient garbage exceeding the configured memory bound.
+	maximum := int((options.MaxSnapshotBytes - base) / 4)
+	sink := concurrentRootCapture{collector: c, snapshot: s, workLimit: options.MaxSnapshotBytes / 4, countOnly: true, end: maximum}
+	c.captureConcurrentRoots(roots, &sink)
+	if sink.err != nil {
+		return decline(sink.err)
+	}
+	s.rootCount = sink.at
+	total := s.rootCount
+	typeCounts := make([]uint32, len(c.types)) // count+1; zero means uncomputed
+	var allocated uint64
+	for h, e := range c.handles {
+		if !sink.step(1) {
+			break
+		}
+		s.offsets[h] = uint32(total)
+		if h == 0 || e.space == spaceFree {
+			continue
+		}
+		if int(e.typeID) >= len(c.types) {
+			sink.err = fmt.Errorf("gc: concurrent snapshot handle%d has an invalid canonical type", h)
+			break
+		}
+		d := &c.types[e.typeID]
+		if (e.class&NativeHandlePointerFreeBit != 0) == d.HasRefs {
+			sink.err = fmt.Errorf("gc: concurrent snapshot handle%d pointer-free classification mismatch", h)
+			break
+		}
+		desc, b, err := c.refDescPtrBytes(makeObjRef(uint32(h)))
+		if err != nil {
+			sink.err = err
+			break
+		}
+		allocated += uint64(e.size)
+		s.alive[h/64] |= uint64(1) << uint(h%64)
+		if !d.HasRefs {
+			continue
+		}
+		var refs uint32
+		if desc.Kind == KindStruct {
+			if uint64(PayloadOffset)+uint64(desc.Size) > uint64(len(b)) {
+				sink.err = errors.New("gc: concurrent snapshot struct extent invalid")
+				break
+			}
+			cached := typeCounts[e.typeID]
+			if cached == 0 {
+				for _, field := range desc.Fields {
+					if !sink.step(1) {
+						break
+					}
+					if isCollectorRefKind(field.Kind) {
+						refs++
+					}
+				}
+				typeCounts[e.typeID] = refs + 1
+			} else {
+				refs = cached - 1
+			}
+		} else if desc.ArrayElementsAreRefs() {
+			refs = binary.LittleEndian.Uint32(b[:4])
+			if uint64(desc.PayloadOffset())+uint64(refs)*uint64(desc.ElemSize) > uint64(len(b)) {
+				sink.err = errors.New("gc: concurrent snapshot array extent invalid")
+				break
+			}
+		}
+		if uint64(refs) > uint64(maximum-total) {
+			sink.err = ErrConcurrentSnapshotBudget
+			break
+		}
+		total += int(refs)
+	}
+	s.offsets[n] = uint32(total)
+	if sink.err != nil {
+		return decline(sink.err)
+	}
+	if allocated < options.MinConcurrentBytes {
+		return false, nil
+	}
+	// A stable, unique live-young prefix proves every later birth is in the tail.
+	for _, h := range c.nurseryHandles {
+		if !sink.step(1) {
+			break
+		}
+		if h == 0 || int(h) >= len(c.handles) || !c.handles[h].young() || bitSet(s.pending, h) {
+			sink.err = errors.New("gc: concurrent start has an invalid or duplicate young ledger entry")
+			break
+		}
+		s.pending[h/64] |= uint64(1) << (h % 64)
+	}
+	clear(s.pending)
+	if !sink.step(uint64(n)) {
+		return decline(sink.err)
+	}
+	s.edges = make([]uint32, total)
+	sink.countOnly = false
+	sink.at = 0
+	sink.end = s.rootCount
+	c.captureConcurrentRoots(roots, &sink)
+	if sink.at != s.rootCount && sink.err == nil {
+		sink.err = errors.New("gc: concurrent root universe changed while stopped")
+	}
+	for h := 1; h < n && sink.err == nil; h++ {
+		if c.handles[h].space == spaceFree || c.handles[h].class&NativeHandlePointerFreeBit != 0 {
+			continue
+		}
+		sink.at = int(s.offsets[h])
+		sink.end = int(s.offsets[h+1])
+		sink.captureObject(uint32(h))
+		if sink.at != sink.end && sink.err == nil {
+			sink.err = errors.New("gc: concurrent object scan extent changed while stopped")
+		}
+	}
+	if sink.err != nil {
+		return decline(sink.err)
+	}
+	// Retain the count workspace until completion, so accounting includes it.
+	s.typeCounts = typeCounts
+	s.bytes = base + uint64(cap(s.edges))*4
+	s.snapshotPause = uint64(time.Since(start))
+	x.concurrent = s
+	x.concurrentStatus = ConcurrentStatus{Phase: ConcurrentMark, SnapshotBytes: s.bytes}
+	x.concurrentStarts++
+	x.nextConcurrentStart = c.stats.Allocations + max(uint64(options.MinConcurrentObjects), uint64(64))
+	if x.nextConcurrentStart < c.stats.Allocations {
+		x.nextConcurrentStart = ^uint64(0)
+	}
+	c.refreshConcurrentView()
+	go s.run()
+	return true, nil
+}
+func (s *concurrentCycle) shade(h uint32) {
+	if h == 0 {
+		return
+	}
+	if int(h/64) >= len(s.live) {
+		return
+	}
+	mask := uint64(1) << (h % 64)
+	if s.live[h/64]&mask != 0 {
+		return
+	}
+	s.live[h/64] |= mask
+	if int(h)+1 < len(s.offsets) && bitSet(s.alive, h) && s.offsets[h] < s.offsets[h+1] {
+		s.pending[h/64] |= mask
+		s.first = min(s.first, int(h/64))
+	}
+}
+func (s *concurrentCycle) pop() (uint32, bool) {
+	for s.first < len(s.pending) && s.pending[s.first] == 0 {
+		s.first++
+	}
+	if s.first == len(s.pending) {
+		return 0, false
+	}
+	bit := uint(bits.TrailingZeros64(s.pending[s.first]))
+	h := uint32(s.first*64) + uint32(bit)
+	s.pending[s.first] &^= uint64(1) << bit
+	return h, true
+}
+func (s *concurrentCycle) run() {
+	start := time.Now()
+	defer func() { s.elapsed = uint64(time.Since(start)); close(s.done) }()
+	for i, h := range s.edges[:s.rootCount] {
+		if i%512 == 0 && s.stop.Load() {
+			return
+		}
+		s.shade(h)
+	}
+	for {
+		if s.stop.Load() {
+			return
+		}
+		h, ok := s.pop()
+		if !ok {
+			return
+		}
+		from, to := s.offsets[h], s.offsets[h+1]
+		for at := from; at < to; at++ {
+			if at%512 == 0 && s.stop.Load() {
+				return
+			}
+			s.shade(s.edges[at])
+		}
+		s.scanned.Add(uint64(to - from))
+	}
+}
+func (c *Collector) abortConcurrent(reason string) {
+	if !c.concurrentActive() {
+		return
+	}
+	x := c.throughput.immix.execution
+	s := x.concurrent
+	s.stop.Store(true)
+	<-s.done
+	x.concurrent = nil
+	x.concurrentAborts++
+	x.concurrentStatus = ConcurrentStatus{Phase: ConcurrentAborted, SnapshotBytes: s.bytes, ScannedEdges: s.scanned.Load(), RemarkWork: s.remarkWork, Reason: reason}
+	c.refreshConcurrentView()
+	if x.options.Telemetry {
+		x.record(CollectionCycle{Kind: CollectionConcurrent, Failed: true, Workers: 1, PauseNS: s.snapshotPause + s.remarkPause, WallNS: uint64(time.Since(s.started)), WorkerNS: s.elapsed})
+	}
+}
+
+type concurrentRemark struct {
+	collector *Collector
+	snapshot  *concurrentCycle
+	left      uint64
+	err       error
+}
+
+func (r *concurrentRemark) consume(n uint64) bool {
+	if r.err != nil {
+		return false
+	}
+	if n > r.left {
+		r.err = ErrConcurrentRemarkBudget
+		return false
+	}
+	r.left -= n
+	r.snapshot.remarkWork += n
+	return true
+}
+func (r *concurrentRemark) VisitRootRef(ref Ref) bool {
+	if !r.consume(1) {
+		return false
+	}
+	if r.collector.validObjectRef(ref) {
+		r.snapshot.shade(handleOf(ref))
+	}
+	return true
+}
+func (r *concurrentRemark) scanCurrent(h uint32) {
+	if !r.consume(1) {
+		return
+	}
+	c := r.collector
+	d, b, err := c.refDescPtrBytes(makeObjRef(h))
+	if err != nil {
+		r.err = err
+		return
+	}
+	if !d.HasRefs {
+		return
+	}
+	if d.Kind == KindStruct {
+		if uint64(PayloadOffset)+uint64(d.Size) > uint64(len(b)) {
+			r.err = errors.New("gc: concurrent remark struct extent invalid")
+			return
+		}
+		for _, field := range d.Fields {
+			if !r.consume(1) {
+				return
+			}
+			if isCollectorRefKind(field.Kind) {
+				if !r.VisitRootRef(Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:]))) {
+					return
+				}
+			}
+		}
+	} else if d.ArrayElementsAreRefs() {
+		length := binary.LittleEndian.Uint32(b[:4])
+		if uint64(d.PayloadOffset())+uint64(length)*uint64(d.ElemSize) > uint64(len(b)) {
+			r.err = errors.New("gc: concurrent remark array extent invalid")
+			return
+		}
+		for i := uint32(0); i < length; i++ {
+			if !r.VisitRootRef(Ref(binary.LittleEndian.Uint32(b[d.PayloadOffset()+i*d.ElemSize:]))) {
+				return
+			}
+		}
+	}
+}
+func (c *Collector) FinishConcurrent(roots RootSet) (bool, error) {
+	if err := c.errIfClosed(); err != nil {
+		return false, err
+	}
+	if !c.concurrentActive() {
+		return false, nil
+	}
+	start := time.Now()
+	x := c.throughput.immix.execution
+	s := x.concurrent
+	<-s.done
+	c.discardNativeStructHandles()
+	c.discardNativeLargeArrayAllocation()
+	budget := x.options.RemarkBudget
+	remark := concurrentRemark{collector: c, snapshot: s, left: budget}
+	words := (len(c.handles) + 63) / 64
+	if len(s.live) < words {
+		if uint64(words)*8+s.bytes > x.options.MaxSnapshotBytes {
+			remark.err = ErrConcurrentRemarkBudget
+		} else {
+			previous := len(s.live)
+			next := make([]uint64, words)
+			copy(next, s.live)
+			s.live = next
+			s.bytes += uint64(words-previous) * 8
+		}
+	}
+
+	if direct, ok := roots.(DirectRootRefSet); ok {
+		direct.RangeRootRefs(&remark)
+	} else if roots != nil {
+		roots.RangeRoots(func(slot RootSlot) bool { return remark.VisitRootRef(slot.GetRef()) })
+	}
+	for _, ref := range c.globalSlots {
+		if !remark.VisitRootRef(ref) {
+			break
+		}
+	}
+	for _, ref := range c.tableSlots {
+		if !remark.VisitRootRef(ref) {
+			break
+		}
+	}
+	if s.nurseryPrefix > len(c.nurseryHandles) {
+		remark.err = errors.New("gc: concurrent birth ledger prefix changed")
+	}
+	if remark.err == nil {
+		for _, h := range c.nurseryHandles[s.nurseryPrefix:] {
+			if !remark.consume(1) {
+				break
+			}
+			if h != 0 && int(h) < len(c.handles) && c.handles[h].space != spaceFree {
+				s.shade(h)
+				remark.scanCurrent(h)
+				if remark.err != nil {
+					break
+				}
+			}
+		}
+	}
+	for word, dirty := range s.dirty {
+		if !remark.consume(1) {
+			break
+		}
+		for dirty != 0 {
+			bit := uint(bits.TrailingZeros64(dirty))
+			dirty &^= uint64(1) << bit
+			h := uint32(word*64) + uint32(bit)
+			if bitSet(s.alive, h) && int(h) < len(c.handles) && c.handles[h].space != spaceFree {
+				remark.scanCurrent(h)
+				if remark.err != nil {
+					break
+				}
+			}
+		}
+	}
+	for remark.err == nil {
+		h, ok := s.pop()
+		if !ok {
+			break
+		}
+		for _, child := range s.edges[s.offsets[h]:s.offsets[h+1]] {
+			if !remark.consume(1) {
+				break
+			}
+			s.shade(child)
+		}
+	}
+	// Publication and synchronous sweep also consume bounded per-handle/region/card work.
+	if remark.err == nil {
+		remark.consume(4*uint64(len(c.handles)) + uint64(immixLines)*uint64(len(c.throughput.immix.regions)) + 4*uint64(len(c.remembered)+len(c.objectCards)+len(c.slotCards)))
+	}
+	if remark.err != nil {
+		s.remarkPause = uint64(time.Since(start))
+		x.concurrentRemarkDeclines++
+		c.abortConcurrent(remark.err.Error())
+		return false, remark.err
+	}
+	// The graph worker has joined and the complete bounded remark succeeded.
+	// Mutator remains stopped while packed mark/line state and sweep publish.
+	x.concurrent = nil
+	c.refreshConcurrentView()
+	c.stats.FullCollections++
+	c.clearMarks()
+	m := c.throughput.immix
+	for h := uint32(1); int(h) < len(c.handles); h++ {
+		if c.handles[h].space == spaceFree || !bitSet(s.live, h) {
+			continue
+		}
+		m.firstMark(h)
+		e := c.handles[h]
+		if e.young() {
+			c.mark[h] = true
+		}
+		if e.space == spaceOld || e.space == spaceLarge {
+			m.mark(e)
+		}
+	}
+	c.sweepAll()
+	c.pruneConcurrentRemembered()
+	c.finishFullCardMetadata()
+	_, err := c.throughput.adviseIdleImmix(false)
+	c.refreshNativeView()
+	x.concurrentCompletes++
+	x.concurrentStatus = ConcurrentStatus{Phase: ConcurrentComplete, SnapshotBytes: s.bytes, ScannedEdges: s.scanned.Load(), RemarkWork: s.remarkWork}
+	if x.options.Telemetry {
+		x.record(CollectionCycle{Kind: CollectionConcurrent, Failed: err != nil, Workers: 1, PauseNS: s.snapshotPause + uint64(time.Since(start)), WallNS: uint64(time.Since(s.started)), RemarkNS: uint64(time.Since(start)), WorkerNS: s.elapsed, Objects: uint32(len(c.handles) - min(len(c.freeHandles)+1, len(c.handles))), HeapBytes: uint64(c.throughput.bump)})
+	}
+	if err == nil && c.cfg.VerifyAfterCollect {
+		err = c.Verify(roots)
+	}
+	return true, err
+}
+
+// Scan slots, including nulls, against the snapshot decode-work cap. A mostly
+// null huge array must not evade the CPU bound merely because it adds no edges.
+func (sink *concurrentRootCapture) captureObject(h uint32) {
+	c := sink.collector
+	d, b, err := c.refDescPtrBytes(makeObjRef(h))
+	if err != nil {
+		sink.err = err
+		return
+	}
+	if !d.HasRefs {
+		return
+	}
+	if d.Kind == KindStruct {
+		if d.firstRef != 0 {
+			for index := uint32(d.firstRef); index != 0; {
+				field := d.Fields[index-1]
+				if !sink.captureChild(h, Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:]))) {
+					return
+				}
+				index = uint32(field.nextRef)
+			}
+		} else {
+			for _, field := range d.Fields {
+				if !sink.step(1) {
+					return
+				}
+				if isCollectorRefKind(field.Kind) {
+					if !sink.captureChild(h, Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:]))) {
+						return
+					}
+				}
+			}
+		}
+	} else if d.ArrayElementsAreRefs() {
+		length := binary.LittleEndian.Uint32(b[:4])
+		for i := uint32(0); i < length; i++ {
+			if !sink.captureChild(h, Ref(binary.LittleEndian.Uint32(b[d.PayloadOffset()+i*d.ElemSize:]))) {
+				return
+			}
+		}
+	}
+}
+func (sink *concurrentRootCapture) captureChild(parent uint32, child Ref) bool {
+	if !sink.step(1) {
+		return false
+	}
+	if sink.at >= sink.end {
+		sink.err = errors.New("gc: concurrent object scan exceeds its planned edges")
+		return false
+	}
+	if child.IsObj() {
+		if !sink.collector.validObjectRef(child) {
+			sink.err = fmt.Errorf("gc: concurrent snapshot handle%d has an invalid child", parent)
+			return false
+		}
+		sink.snapshot.edges[sink.at] = handleOf(child)
+	}
+	sink.at++
+	return true
+}
+func (c *Collector) pruneConcurrentRemembered() {
+	out := c.remembered[:0]
+	for _, h := range c.remembered {
+		if h != 0 && int(h) < len(c.handles) && c.handles[h].remembered && !c.handles[h].young() && (c.handles[h].space == spaceOld || c.handles[h].space == spaceLarge) {
+			out = append(out, h)
+		}
+	}
+	clear(c.remembered[len(out):])
+	c.remembered = out
+}
+
+// These calls already own the standard exact-root safepoint. Expected resource
+// admission declines stay visible in status/counters and preserve normal GC
+// fallback; invariant/worker errors remain allocation errors.
+func (c *Collector) advanceConcurrentAllocation(roots RootSet) error {
+	if roots == nil || c.throughput.immix == nil || c.throughput.immix.execution == nil {
+		return nil
+	}
+	x := c.throughput.immix.execution
+	if !x.options.AutoConcurrent || runtime.GOMAXPROCS(0) < 2 {
+		return nil
+	}
+	if s := x.concurrent; s != nil {
+		select {
+		case <-s.done:
+			_, err := c.FinishConcurrent(roots)
+			if errors.Is(err, ErrConcurrentRemarkBudget) {
+				return nil
+			}
+			return err
+		default:
+			return nil
+		}
+	}
+	if c.stats.Allocations < x.nextConcurrentStart {
+		return nil
+	}
+	x.nextConcurrentStart = c.stats.Allocations + max(uint64(x.options.MinConcurrentObjects), uint64(64))
+	if x.nextConcurrentStart < c.stats.Allocations {
+		x.nextConcurrentStart = ^uint64(0)
+	}
+	_, err := c.StartConcurrent(roots)
+	if errors.Is(err, ErrConcurrentSnapshotBudget) {
+		return nil
+	}
+	return err
+}
diff --git a/src/core/runtime/gc/native/concurrent_test.go b/src/core/runtime/gc/native/concurrent_test.go

diff --git a/src/core/runtime/gc/native/concurrent.go b/src/core/runtime/gc/native/concurrent.go
new file mode 100644
index 000000000..14cf3d892
--- /dev/null
+++ b/src/core/runtime/gc/native/concurrent.go
@@ -0,0 +1,23 @@
+package gc
+
+import "errors"
+
+var ErrConcurrentSnapshotBudget = errors.New("gc: concurrent snapshot exceeds its memory budget")
+var ErrConcurrentRemarkBudget = errors.New("gc: concurrent remark exceeds its work budget; no concurrent sweep was published")
+
+type ConcurrentPhase uint8
+
+const (
+	ConcurrentIdle ConcurrentPhase = iota
+	ConcurrentSnapshot
+	ConcurrentMark
+	ConcurrentRemark
+	ConcurrentComplete
+	ConcurrentAborted
+)
+
+type ConcurrentStatus struct {
+	Phase                                   ConcurrentPhase
+	SnapshotBytes, ScannedEdges, RemarkWork uint64
+	Reason                                  string
+}
diff --git a/src/core/runtime/gc/native/concurrent_bench_test.go b/src/core/runtime/gc/native/concurrent_bench_test.go
new file mode 100644
index 000000000..9f140142e
--- /dev/null
+++ b/src/core/runtime/gc/native/concurrent_bench_test.go
@@ -0,0 +1,61 @@
+//go:build wago_gc_concurrent && wago_gc_workers && amd64 && !tinygo
+
+package gc
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+var concurrentBenchmarkSink uint64
+
+func BenchmarkConcurrentCollection(b *testing.B) {
+	for _, count := range []int{4096, 262144} {
+		for _, enabled := range []bool{false, true} {
+			b.Run(fmt.Sprintf("n%d/concurrent%v", count, enabled), func(b *testing.B) {
+				options := ExecutionOptions{Workers: 1, Telemetry: true, ConcurrentMark: enabled, MinConcurrentBytes: 1, MinConcurrentObjects: 1, MaxSnapshotBytes: 16 << 20, RemarkBudget: 16 << 20}
+				c, roots := newExecutionGraphFixture(b, count, options, true)
+				var mutatorNS, pauseNS, remarkNS, workerNS uint64
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					if enabled {
+						if started, err := c.StartConcurrent(roots); err != nil || !started {
+							b.Fatalf("start: %v %v", started, err)
+						}
+					}
+					before := time.Now()
+					// Fixed Go mutator work gives graph marking a real overlap window.
+					value := uint64(i + 1)
+					for step := 0; step < 500000; step++ {
+						value = (value << 7) ^ (value >> 3) ^ uint64(step)
+					}
+					concurrentBenchmarkSink = value
+					mutatorNS += uint64(time.Since(before))
+					if enabled {
+						if done, err := c.FinishConcurrent(roots); err != nil || !done {
+							b.Fatalf("finish: %v %v", done, err)
+						}
+					} else if err := c.CollectFull(roots); err != nil {
+						b.Fatal(err)
+					}
+					cycles := c.CycleTelemetry().Cycles
+					r := cycles[len(cycles)-1]
+					pauseNS += r.PauseNS
+					remarkNS += r.RemarkNS
+					workerNS += r.WorkerNS
+				}
+				b.StopTimer()
+				b.ReportMetric(float64(mutatorNS)/float64(b.N), "mutator-ns")
+				b.ReportMetric(float64(pauseNS)/float64(b.N), "pause-ns")
+				b.ReportMetric(float64(remarkNS)/float64(b.N), "remark-ns")
+				b.ReportMetric(float64(workerNS)/float64(b.N), "worker-elapsed-ns")
+				b.ReportMetric(float64(c.ConcurrentStatus().SnapshotBytes), "snapshot-B")
+				history := c.CycleTelemetry()
+				b.ReportMetric(float64(history.P99PauseNS), "p99-pause-ns")
+				b.ReportMetric(float64(history.MaxPauseNS), "max-pause-ns")
+			})
+		}
+	}
+}

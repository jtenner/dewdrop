@@ -0,0 +1,32 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import "testing"
+
+func TestCycleTelemetryIsBoundedAndCopiesOptions(t *testing.T) {
+	options := &ExecutionOptions{Telemetry: true, Workers: 1}
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, Execution: options})
+	options.Telemetry = false
+	for i := 0; i < 80; i++ {
+		if err := c.CollectFull(EmptyRoots{}); err != nil {
+			t.Fatal(err)
+		}
+		if err := c.CollectMinor(EmptyRoots{}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := c.CycleTelemetry()
+	if got.Count != 160 || len(got.Cycles) != cycleHistory || got.MaxPauseNS == 0 || got.P99PauseNS > got.MaxPauseNS {
+		t.Fatalf("invalid telemetry: %+v", got)
+	}
+	for i, r := range got.Cycles {
+		if r.Sequence != uint64(97+i) || r.Failed || r.Workers != 1 || r.PauseNS == 0 || r.WallNS < r.PauseNS {
+			t.Fatalf("cycle%d: %+v", i, r)
+		}
+	}
+	got.Cycles[0].Sequence = 0
+	if c.CycleTelemetry().Cycles[0].Sequence == 0 {
+		t.Fatal("history aliases caller output")
+	}
+}

+package gc
+
+import "testing"
+
+func TestExecutionProductAdmission(t *testing.T) {
+	options := &ExecutionOptions{Telemetry: true}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, Execution: options}, testTypes(t))
+	if !executionProduct {
+		if err == nil {
+			c.Close()
+			t.Fatal("minimal product accepted execution machinery")
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	for _, cfg := range []Config{
+		{Profile: ProfileTiny, Execution: options},
+		{Execution: options},
+		{Allocator: AllocatorImmix, Execution: &ExecutionOptions{Workers: 129}},
+		{Allocator: AllocatorImmix, Execution: options, DisableCollection: true},
+	} {
+		if err := ValidateConfig(cfg); err == nil {
+			t.Fatalf("invalid execution config accepted: %+v", cfg)
+		}
+	}
+}
+func TestDefaultCollectorHasNoExecutionHistory(t *testing.T) {
+	c := newTestCollector(t, Config{})
+	if err := c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+	if got := c.CycleTelemetry(); got.Count != 0 || len(got.Cycles) != 0 {
+		t.Fatal("default collector recorded clocks/history")
+	}
+}

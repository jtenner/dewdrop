index 000000000..5fe0daaff
--- /dev/null
+++ b/src/core/runtime/gc/native/execution_enabled.go
@@ -0,0 +1,100 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"sort"
+	"time"
+)
+
+const executionProduct = true
+const cycleHistory = 64
+
+type collectorExecution struct {
+	options  ExecutionOptions
+	cycles   [cycleHistory]CollectionCycle
+	sequence uint64
+}
+type executionCycle struct {
+	owner        *collectorExecution
+	start, phase time.Time
+	record       CollectionCycle
+}
+
+func (c *Collector) initExecution() {
+	if c.cfg.Execution != nil {
+		c.throughput.immix.execution = &collectorExecution{options: *c.cfg.Execution}
+	}
+}
+func (c *Collector) beginExecutionCycle(kind CollectionKind) executionCycle {
+	m := c.throughput.immix
+	if m == nil || m.execution == nil {
+		return executionCycle{}
+	}
+	x := m.execution
+	if !x.options.Telemetry {
+		return executionCycle{}
+	}
+	now := time.Now()
+	return executionCycle{owner: x, start: now, phase: now, record: CollectionCycle{Kind: kind, Workers: 1}}
+}
+func (t *executionCycle) markDone() {
+	if t.owner != nil {
+		now := time.Now()
+		t.record.MarkNS = uint64(now.Sub(t.phase))
+		t.phase = now
+	}
+}
+func (t *executionCycle) sweepDone() {
+	if t.owner != nil {
+		now := time.Now()
+		t.record.SweepNS = uint64(now.Sub(t.phase))
+		t.phase = now
+	}
+}
+func (t *executionCycle) copyDone() {
+	if t.owner != nil {
+		now := time.Now()
+		t.record.CopyNS = uint64(now.Sub(t.phase))
+		t.phase = now
+	}
+}
+func (c *Collector) finishExecutionCycle(t executionCycle, err error) {
+	if t.owner == nil {
+		return
+	}
+	t.record.PauseNS = uint64(time.Since(t.start))
+	t.record.WallNS = t.record.PauseNS
+	t.record.Failed = err != nil
+	t.record.Objects = uint32(len(c.handles) - min(len(c.freeHandles)+1, len(c.handles)))
+	t.record.HeapBytes = uint64(c.throughput.bump)
+	t.owner.record(t.record)
+}
+func (x *collectorExecution) record(r CollectionCycle) {
+	x.sequence++
+	r.Sequence = x.sequence
+	x.cycles[(x.sequence-1)%cycleHistory] = r
+}
+func (c *Collector) CycleTelemetry() CycleTelemetry {
+	m := c.throughput.immix
+	if m == nil || m.execution == nil {
+		return CycleTelemetry{}
+	}
+	x := m.execution
+	n := min(x.sequence, uint64(cycleHistory))
+	result := CycleTelemetry{Count: x.sequence, Cycles: make([]CollectionCycle, n)}
+	pauses := make([]uint64, 0, n)
+	for i := range result.Cycles {
+		r := x.cycles[(x.sequence-n+uint64(i))%cycleHistory]
+		result.Cycles[i] = r
+		if r.Kind != CollectionBackgroundSweep {
+			pauses = append(pauses, r.PauseNS)
+		}
+	}
+	sort.Slice(pauses, func(i, j int) bool { return pauses[i] < pauses[j] })
+	if len(pauses) > 0 {
+		result.MaxPauseNS = pauses[len(pauses)-1]
+		result.P99PauseNS = pauses[(len(pauses)*99+99)/100-1]
+	}
+	return result
+}

index 000000000..131d5fff4
--- /dev/null
+++ b/src/core/runtime/gc/native/execution.go
@@ -0,0 +1,73 @@
+package gc
+
+import "fmt"
+
+// ExecutionOptions enables optional region-collector machinery. Build with
+// wago_gc_workers; minimal/default and Tiny products reject this configuration.
+// Nil preserves the ordinary worker-free collector and performs no clock reads.
+type ExecutionOptions struct {
+	Telemetry       bool
+	BackgroundSweep bool
+	Workers         uint16
+	MinMarkBytes    uint64
+	MinMarkObjects  uint32
+	MinCopyBytes    uint64
+	MinSweepBytes   uint64
+}
+type CollectionKind uint8
+
+const (
+	CollectionFull CollectionKind = iota + 1
+	CollectionMinor
+	CollectionBackgroundSweep
+)
+
+// CollectionCycle is a bounded diagnostic record. WorkerNS is summed worker
+// elapsed time, not OS CPU time. Use process/thread counters for CPU and PMU data.
+type CollectionCycle struct {
+	Sequence                                                     uint64
+	Kind                                                         CollectionKind
+	Failed                                                       bool
+	Workers                                                      uint16
+	PauseNS, WallNS, MarkNS, SweepNS, CopyNS, RemarkNS, WorkerNS uint64
+	Objects                                                      uint32
+	HeapBytes                                                    uint64
+}
+type CycleTelemetry struct {
+	Cycles                 []CollectionCycle
+	Count                  uint64
+	P99PauseNS, MaxPauseNS uint64
+}
+
+func normalizeExecution(cfg *Config) error {
+	if cfg.Execution == nil {
+		return nil
+	}
+	if !executionProduct {
+		return fmt.Errorf("gc: execution options require the wago_gc_workers product")
+	}
+	if cfg.Profile != ProfileThroughput || cfg.Allocator != AllocatorImmix || cfg.DisableCollection {
+		return fmt.Errorf("gc: execution options require the collecting Immix throughput profile")
+	}
+	options := *cfg.Execution
+	if options.Workers == 0 {
+		options.Workers = 1
+	}
+	if options.Workers > 128 {
+		return fmt.Errorf("gc: worker count %d exceeds 128", options.Workers)
+	}
+	if options.MinMarkBytes == 0 {
+		options.MinMarkBytes = 8 << 20
+	}
+	if options.MinMarkObjects == 0 {
+		options.MinMarkObjects = 65536
+	}
+	if options.MinCopyBytes == 0 {
+		options.MinCopyBytes = 1 << 20
+	}
+	if options.MinSweepBytes == 0 {
+		options.MinSweepBytes = 256 << 10
+	}
+	cfg.Execution = &options
+	return nil
+}

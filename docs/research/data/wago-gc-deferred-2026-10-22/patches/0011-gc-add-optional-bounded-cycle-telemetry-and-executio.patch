+package wago
+
+import "testing"
+
+func TestSharedGCExecutionConfigUsesValueEquality(t *testing.T) {
+	a := GCConfig{Execution: &GCExecutionOptions{Telemetry: true, Workers: 2}}
+	b := GCConfig{Execution: &GCExecutionOptions{Telemetry: true, Workers: 2}}
+	if !equalGCConfigs(a, b) {
+		t.Fatal("equivalent execution options rejected")
+	}
+	b.Execution.Workers = 4
+	if equalGCConfigs(a, b) {
+		t.Fatal("different execution options accepted")
+	}
+	b.Execution = nil
+	if equalGCConfigs(a, b) {
+		t.Fatal("missing options accepted")
+	}
+}

diff --git a/src/core/runtime/gc/native/mark_parallel_enabled.go b/src/core/runtime/gc/native/mark_parallel_enabled.go
new file mode 100644
index 000000000..55471bd1b
--- /dev/null
+++ b/src/core/runtime/gc/native/mark_parallel_enabled.go
@@ -0,0 +1,330 @@
+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"encoding/binary"
+	"runtime"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unsafe"
+)
+
+const markLocalBuckets = 16
+const markTransferTasks = 32
+const markSharedLimit = 1024
+const parallelArrayChunk = 512
+
+type parallelMarkTask struct{ handle, index uint32 }
+type parallelMarkDeque struct {
+	mu    sync.Mutex
+	tasks []parallelMarkTask
+}
+type parallelMarkWorker struct {
+	pool                       *parallelMarkPool
+	id                         int
+	local                      [markLocalBuckets][]parallelMarkTask
+	first                      int
+	source                     uint32
+	cross                      bool
+	steals, transfers, elapsed uint64
+}
+type parallelMarkPool struct {
+	collector   *Collector
+	workers     []parallelMarkWorker
+	shared      []parallelMarkDeque
+	pending     atomic.Int64
+	wake        chan struct{}
+	done        chan struct{}
+	connections []uint32
+}
+
+func (p *parallelMarkPool) region(h uint32) uint32 {
+	e := p.collector.handles[h]
+	if e.space == spaceOld || e.space == spaceLarge {
+		return e.off / immixBlockBytes
+	}
+	return uint32(len(p.collector.throughput.immix.regions)) + h/256
+}
+func (p *parallelMarkPool) notify() {
+	select {
+	case p.wake <- struct{}{}:
+	default:
+	}
+}
+func (w *parallelMarkWorker) enqueue(task parallelMarkTask) {
+	p := w.pool
+	bucket := int(p.region(task.handle) % markLocalBuckets)
+	p.pending.Add(1)
+	w.local[bucket] = append(w.local[bucket], task)
+	w.first = bucket
+	w.share(bucket)
+}
+func (w *parallelMarkWorker) share(bucket int) {
+	local := w.local[bucket]
+	if len(local) < 2*markTransferTasks {
+		return
+	}
+	q := &w.pool.shared[w.id]
+	q.mu.Lock()
+	if len(q.tasks) >= markSharedLimit {
+		q.mu.Unlock()
+		return
+	}
+	empty := len(q.tasks) == 0
+	start := len(local) - markTransferTasks
+	q.tasks = append(q.tasks, local[start:]...)
+	w.local[bucket] = local[:start]
+	q.mu.Unlock()
+	w.transfers++
+	if empty {
+		w.pool.notify()
+	}
+}
+func (w *parallelMarkWorker) shade(ref Ref) {
+	if !ref.IsObj() {
+		return
+	}
+	h := handleOf(ref)
+	c := w.pool.collector
+	if h == 0 || int(h) >= len(c.handles) || c.handles[h].space == spaceFree {
+		return
+	}
+	if w.source != immixNoRegion && w.pool.region(h) != w.source {
+		w.cross = true
+	}
+	m := c.throughput.immix
+	word := &m.work.seen[h/64]
+	bit := uint64(1) << (h % 64)
+	for {
+		old := atomic.LoadUint64(&word.bits)
+		if old&bit != 0 {
+			return
+		}
+		if atomic.CompareAndSwapUint64(&word.bits, old, old|bit) {
+			break
+		}
+	}
+	if c.handles[h].class&NativeHandlePointerFreeBit == 0 {
+		w.enqueue(parallelMarkTask{handle: h})
+	}
+}
+func (p *parallelMarkPool) VisitRootRef(ref Ref) bool {
+	if !ref.IsObj() || handleOf(ref) == 0 || int(handleOf(ref)) >= len(p.collector.handles) {
+		return true
+	}
+	w := &p.workers[int(p.region(handleOf(ref)))%len(p.workers)]
+	w.shade(ref)
+	return true
+}
+func (w *parallelMarkWorker) pop() (parallelMarkTask, bool) {
+	for i := 0; i < markLocalBuckets; i++ {
+		bucket := (w.first + i) % markLocalBuckets
+		tasks := w.local[bucket]
+		if len(tasks) == 0 {
+			continue
+		}
+		task := tasks[len(tasks)-1]
+		w.local[bucket] = tasks[:len(tasks)-1]
+		w.first = bucket
+		w.share(bucket)
+		return task, true
+	}
+	// Transfer at most 32 integer tasks per synchronization. Region buckets
+	// regroup stolen tasks before descriptor/payload reads.
+	for n := 0; n < len(w.pool.shared); n++ {
+		victim := (w.id + n) % len(w.pool.shared)
+		q := &w.pool.shared[victim]
+		q.mu.Lock()
+		count := min(markTransferTasks, len(q.tasks))
+		if count == 0 {
+			q.mu.Unlock()
+			continue
+		}
+		start := len(q.tasks) - count
+		for _, task := range q.tasks[start:] {
+			bucket := int(w.pool.region(task.handle) % markLocalBuckets)
+			w.local[bucket] = append(w.local[bucket], task)
+		}
+		q.tasks = q.tasks[:start]
+		q.mu.Unlock()
+		if victim != w.id {
+			w.steals++
+		}
+		return w.pop()
+	}
+	return parallelMarkTask{}, false
+}
+func (w *parallelMarkWorker) scan(task parallelMarkTask) {
+	c := w.pool.collector
+	d, b, err := c.refDescPtrBytes(makeObjRef(task.handle))
+	if err != nil || !d.HasRefs {
+		return
+	}
+	w.source = w.pool.region(task.handle)
+	w.cross = false
+	if d.Kind == KindStruct {
+		if uint64(PayloadOffset)+uint64(d.Size) > uint64(len(b)) {
+			panic("gc: parallel mark struct extent invalid")
+		}
+		if d.firstRef != 0 {
+			for index := uint32(d.firstRef); index != 0; {
+				field := d.Fields[index-1]
+				w.shade(Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:])))
+				index = uint32(field.nextRef)
+			}
+		} else {
+			for _, field := range d.Fields {
+				if isCollectorRefKind(field.Kind) {
+					w.shade(Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:])))
+				}
+			}
+		}
+	} else if d.ArrayElementsAreRefs() {
+		length := binary.LittleEndian.Uint32(b[:4])
+		if uint64(d.PayloadOffset())+uint64(length)*uint64(d.ElemSize) > uint64(len(b)) {
+			panic("gc: parallel mark array extent invalid")
+		}
+		end := min(length, task.index+min(uint32(parallelArrayChunk), ^uint32(0)-task.index))
+		if end < length {
+			w.enqueue(parallelMarkTask{task.handle, end})
+		}
+		for i := task.index; i < end; i++ {
+			w.shade(Ref(binary.LittleEndian.Uint32(b[d.PayloadOffset()+i*d.ElemSize:])))
+		}
+	}
+	if w.cross && int(w.source) < len(w.pool.connections) {
+		atomic.AddUint32(&w.pool.connections[w.source], 1)
+	}
+	w.source = immixNoRegion
+}
+func (w *parallelMarkWorker) run() {
+	start := time.Now()
+	defer func() { w.elapsed = uint64(time.Since(start)) }()
+	for {
+		task, ok := w.pop()
+		if !ok {
+			if w.pool.pending.Load() == 0 {
+				return
+			}
+			select {
+			case <-w.pool.done:
+				return
+			case <-w.pool.wake:
+				continue
+			}
+		}
+		w.scan(task)
+		if w.pool.pending.Add(-1) == 0 {
+			close(w.pool.done)
+			return
+		}
+	}
+}
+func (c *Collector) parallelMarkRoots(roots RootSet) int {
+	m := c.throughput.immix
+	if m == nil || m.execution == nil {
+		return 0
+	}
+	x := m.execution
+	options := x.options
+	workers := min(int(options.Workers), runtime.GOMAXPROCS(0))
+	objects := len(c.handles) - min(len(c.freeHandles)+1, len(c.handles))
+	if workers < 2 || objects < int(options.MinMarkObjects) || uint64(c.throughput.bump)+uint64(c.nurseryBump) < options.MinMarkBytes {
+		return 0
+	}
+	var allocated uint64
+	for _, e := range c.handles {
+		if e.space != spaceFree {
+			allocated += uint64(e.size)
+		}
+	}
+	if allocated < options.MinMarkBytes {
+		return 0
+	}
+	p := x.markPool
+	if p == nil || len(p.workers) != workers {
+		p = &parallelMarkPool{workers: make([]parallelMarkWorker, workers), shared: make([]parallelMarkDeque, workers)}
+		x.markPool = p
+	}
+	p.collector = c
+	p.pending.Store(0)
+	p.wake = make(chan struct{}, workers)
+	p.done = make(chan struct{})
+	p.connections = append(p.connections[:0], make([]uint32, len(m.regions))...)
+	for i := range m.work.seen {
+		m.work.seen[i] = immixMarkWord{epoch: m.epoch}
+	}
+	for i := range p.workers {
+		w := &p.workers[i]
+		w.pool = p
+		w.id = i
+		w.first = 0
+		w.source = immixNoRegion
+		w.cross = false
+		w.steals = 0
+		w.transfers = 0
+		w.elapsed = 0
+		for j := range w.local {
+			w.local[j] = w.local[j][:0]
+		}
+		p.shared[i].tasks = p.shared[i].tasks[:0]
+	}
+	if direct, ok := roots.(DirectRootRefSet); ok {
+		direct.RangeRootRefs(p)
+	} else if roots != nil {
+		roots.RangeRoots(func(slot RootSlot) bool { return p.VisitRootRef(slot.GetRef()) })
+	}
+	for _, r := range c.globalSlots {
+		p.VisitRootRef(r)
+	}
+	for _, r := range c.tableSlots {
+		p.VisitRootRef(r)
+	}
+	used := 1
+	if p.pending.Load() != 0 {
+		var group sync.WaitGroup
+		group.Add(workers)
+		for i := range p.workers {
+			go func(w *parallelMarkWorker) { defer group.Done(); w.run() }(&p.workers[i])
+		}
+		group.Wait()
+		used = workers
+		x.parallelMarkCycles++
+	}
+	// Workers only publish packed atomic marks. Merge young/line state and coarse
+	// connectivity hints after join, before sweep or any stable-handle mutation.
+	for h := uint32(1); int(h) < len(c.handles); h++ {
+		if !m.marked(h) {
+			continue
+		}
+		e := c.handles[h]
+		if e.young() {
+			c.mark[h] = true
+		}
+		if e.space == spaceOld || e.space == spaceLarge {
+			m.mark(e)
+		}
+	}
+	for i := range p.connections {
+		if m.regions[i].epoch == m.epoch {
+			m.regions[i].connections = p.connections[i]
+		}
+	}
+	var scratch uint64
+	for i := range p.workers {
+		w := &p.workers[i]
+		x.markWorkerNS += w.elapsed
+		x.queueSteals += w.steals
+		x.queueTransfers += w.transfers
+		for _, local := range w.local {
+			scratch += uint64(cap(local)) * uint64(unsafe.Sizeof(parallelMarkTask{}))
+		}
+		scratch += uint64(cap(p.shared[i].tasks)) * uint64(unsafe.Sizeof(parallelMarkTask{}))
+	}
+	scratch += uint64(cap(p.connections)) * 4
+	x.parallelScratchBytes = scratch
+	p.collector = nil
+	return used
+}

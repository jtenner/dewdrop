+func newParallelMarkFixture(t testing.TB, count int, workers uint16) (*Collector, RefSliceRoots) {
+	t.Helper()
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageRefNull, StorageRefNull, StorageRefNull, StorageI64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	array, err := NewArrayDesc(1, StorageRefNull)
+	if err != nil {
+		t.Fatal(err)
+	}
+	scalar, err := NewStructDesc(2, []StorageKind{StorageI64})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: uint32(count)*40 + 1<<20, DisableMovingNursery: true, ThroughputHeapBytes: 128 << 20, ThroughputPageBytes: 4096, Execution: &ExecutionOptions{Workers: workers, Telemetry: true, MinMarkObjects: 1, MinMarkBytes: 1}}, []TypeDesc{node, array, scalar})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(c.Close)
+	refs := make([]Ref, count)
+	for i := range refs {
+		refs[i], err = c.NewStructDefault(0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.ForcePromote(refs[i]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i, r := range refs {
+		for field := uint32(0); field < 4; field++ {
+			if err = c.StructSet(r, field, RefValue(refs[(i*4+int(field)+1)%len(refs)])); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	root, err := c.NewArrayDefault(1, uint32(count))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, r := range refs {
+		if err = c.ArraySet(root, uint32(i), RefValue(r)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = c.ForcePromote(root); err != nil {
+		t.Fatal(err)
+	}
+	// These leaves are live only through persistent roots; the extra node dies.
+	global, err := c.NewStructDefault(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	table, err := c.NewStructDefault(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.globalSlots = []Ref{global}
+	c.tableSlots = []Ref{table}
+	c.WriteBarrierSlot(SlotGlobal, 0, global)
+	c.WriteBarrierSlot(SlotTable, 0, table)
+	if _, err = c.NewStructDefault(0); err != nil {
+		t.Fatal(err)
+	}
+	return c, RefSliceRoots{root}
+}
+func TestParallelMarkMatchesSerialAcrossCyclesAndEpochWrap(t *testing.T) {
+	previous := runtime.GOMAXPROCS(4)
+	defer runtime.GOMAXPROCS(previous)
+	serial, sroots := newParallelMarkFixture(t, 4096, 1)
+	parallel, proots := newParallelMarkFixture(t, 4096, 4)
+	for round := 0; round < 4; round++ {
+		if round == 2 {
+			parallel.throughput.immix.epoch = ^uint32(0)
+		}
+		if err := serial.CollectFull(sroots); err != nil {
+			t.Fatal(err)
+		}
+		if err := parallel.CollectFull(proots); err != nil {
+			t.Fatal(err)
+		}
+		if serial.Stats().LiveObjects != parallel.Stats().LiveObjects {
+			t.Fatal("parallel live count differs")
+		}
+		for h, e := range serial.handles {
+			if (e.space == spaceFree) != (parallel.handles[h].space == spaceFree) {
+				t.Fatalf("handle%d liveness differs", h)
+			}
+			if h > 0 && e.space != spaceFree && !slices.Equal(serial.bytes(makeObjRef(uint32(h))), parallel.bytes(makeObjRef(uint32(h)))) {
+				t.Fatalf("handle%d payload changed", h)
+			}
+		}
+		if err := parallel.Verify(proots); err != nil {
+			t.Fatal(err)
+		}
+		if err := parallel.CollectMinor(proots); err != nil {
+			t.Fatal(err)
+		}
+		if err := serial.CollectMinor(sroots); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := parallel.CycleTelemetry()
+	if got.ParallelMarkCycles != 4 || got.QueueTransfers == 0 || got.ParallelScratchBytes == 0 {
+		t.Fatalf("parallel path not exercised: %+v", got)
+	}
+}
+func TestParallelMarkThresholdAvoidsWorkers(t *testing.T) {
+	previous := runtime.GOMAXPROCS(4)
+	defer runtime.GOMAXPROCS(previous)
+	c, roots := newParallelMarkFixture(t, 256, 4)
+	c.throughput.immix.execution.options.MinMarkObjects = 1 << 20
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if got := c.CycleTelemetry(); got.ParallelMarkCycles != 0 || got.Cycles[len(got.Cycles)-1].Workers != 1 {
+		t.Fatal("below-threshold collection started workers")
+	}
+	c.throughput.immix.execution.options.MinMarkObjects = 1
+	c.throughput.immix.execution.options.MinMarkBytes = 1 << 30
+	if err := c.CollectFull(roots); err != nil {
+		t.Fatal(err)
+	}
+	if c.CycleTelemetry().ParallelMarkCycles != 0 {
+		t.Fatal("byte threshold ignored")
+	}
+}
+func TestParallelMarkStealsBoundedRegionTasks(t *testing.T) {
+	c, roots := newParallelMarkFixture(t, 64, 2)
+	p := &parallelMarkPool{collector: c, workers: make([]parallelMarkWorker, 2), shared: make([]parallelMarkDeque, 2)}
+	for i := range p.workers {
+		p.workers[i].pool = p
+		p.workers[i].id = i
+	}
+	for i := 0; i < 64; i++ {
+		p.shared[0].tasks = append(p.shared[0].tasks, parallelMarkTask{handle: handleOf(roots[0]), index: uint32(i)})
+	}
+	if _, ok := p.workers[1].pop(); !ok || p.workers[1].steals != 1 || len(p.shared[0].tasks) != 64-markTransferTasks {
+		t.Fatal("bounded work stealing failed")
+	}
+}

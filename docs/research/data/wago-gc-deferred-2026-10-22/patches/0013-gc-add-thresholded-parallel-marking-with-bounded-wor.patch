+//go:build wago_gc_workers && !tinygo
+
+package gc
+
+import (
+	"fmt"
+	"runtime"
+	"testing"
+)
+
+func BenchmarkParallelFullMark(b *testing.B) {
+	counts := []int{4096, 262144}
+	workers := []uint16{1, 2, 4, uint16(min(128, runtime.GOMAXPROCS(0)))}
+	seen := make(map[uint16]bool)
+	for _, w := range workers {
+		if seen[w] {
+			continue
+		}
+		seen[w] = true
+		for _, count := range counts {
+			b.Run(fmt.Sprintf("n%d/workers%d", count, w), func(b *testing.B) {
+				c, roots := newParallelMarkFixture(b, count, w)
+				if err := c.CollectFull(roots); err != nil {
+					b.Fatal(err)
+				}
+				b.ReportAllocs()
+				b.ResetTimer()
+				for i := 0; i < b.N; i++ {
+					if err := c.CollectFull(roots); err != nil {
+						b.Fatal(err)
+					}
+				}
+				b.StopTimer()
+				got := c.CycleTelemetry()
+				b.ReportMetric(float64(got.P99PauseNS), "p99-pause-ns")
+				b.ReportMetric(float64(got.MaxPauseNS), "max-pause-ns")
+				b.ReportMetric(float64(got.ParallelScratchBytes), "parallel-scratch-B")
+				b.ReportMetric(float64(got.QueueSteals), "steals")
+			})
+		}
+	}
+}

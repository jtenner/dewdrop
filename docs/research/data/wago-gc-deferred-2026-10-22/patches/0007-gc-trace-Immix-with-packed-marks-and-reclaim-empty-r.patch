diff --git a/internal/virtualmem/advice_test.go b/internal/virtualmem/advice_test.go
new file mode 100644
index 000000000..01a28186b
--- /dev/null
+++ b/internal/virtualmem/advice_test.go
@@ -0,0 +1,65 @@
+package virtualmem
+
+import (
+	"errors"
+	"testing"
+	"unsafe"
+)
+
+func TestUnusedPagesRetainAddressAndNeighborData(t *testing.T) {
+	page := PageSize()
+	region, err := Reserve(3 * page)
+	if !Supported {
+		if !errors.Is(err, ErrUnsupported) {
+			t.Fatalf("unsupported reservation: %v", err)
+		}
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer region.Close()
+	if err = region.Commit(0, 3*page); err != nil {
+		t.Fatal(err)
+	}
+	data := region.Bytes(3 * page)
+	base := uintptr(unsafe.Pointer(&data[0]))
+	data[0] = 17
+	data[2*page] = 23
+	for i := page; i < 2*page; i++ {
+		data[i] = 42
+	}
+	if err = region.AdviseUnused(page, page); err != nil {
+		t.Fatal(err)
+	}
+	if err = region.Reuse(page, page); err != nil {
+		t.Fatal(err)
+	}
+	if uintptr(unsafe.Pointer(&region.Bytes(3 * page)[0])) != base || data[0] != 17 || data[2*page] != 23 {
+		t.Fatal("page advice changed an address or neighboring live data")
+	}
+	for i := page; i < 2*page; i++ {
+		data[i] = 37
+	}
+	for i := page; i < 2*page; i++ {
+		if data[i] != 37 {
+			t.Fatal("reused page did not retain initialized bytes")
+		}
+	}
+	if region.CommittedBytes() != 3*page {
+		t.Fatal("advice changed accessibility accounting")
+	}
+	for _, operation := range []func(uint64, uint64) error{region.AdviseUnused, region.Reuse} {
+		for _, bad := range [][2]uint64{{1, page}, {page, page + 1}, {3 * page, page}, {^uint64(0), page}} {
+			if err = operation(bad[0], bad[1]); err == nil {
+				t.Fatalf("invalid advice range accepted: %v", bad)
+			}
+		}
+	}
+	if err = region.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = region.AdviseUnused(0, page); err == nil {
+		t.Fatal("closed owner accepted advice")
+	}
+}
diff --git a/internal/virtualmem/advice_windows.go b/internal/virtualmem/advice_windows.go
new file mode 100644
index 000000000..b42565998
--- /dev/null
+++ b/internal/virtualmem/advice_windows.go
@@ -0,0 +1,19 @@
+//go:build windows && (amd64 || arm64) && !tinygo
+
+package virtualmem
+
+import (
+	"fmt"
+	"unsafe"
+)
+
+// MEM_RESET preserves commitment/access and makes no zero-fill promise. Every
+// new guest object is initialized before publication, independently of advice.
+func adviseUnused(b []byte) error {
+	p, _, err := virtualAlloc.Call(uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)), 0x80000, 0x04)
+	if p == 0 {
+		return fmt.Errorf("virtual memory reset: %w", err)
+	}
+	return nil
+}
+func reusePages([]byte) error { return nil }

+			t.Fatalf("child%d: %+v %v", i, value, err)
+		}
+	}
+	if c.Stats().LiveObjects != 3001 {
+		t.Fatal("dense array traversal lost or invented objects")
+	}
+	if stats := c.ImmixStats(); stats.MarkScratchBytes > uint64(len(c.handles))*8+1024 {
+		t.Fatalf("mark scratch exceeds bounded integer queues: %+v", stats)
+	}
+	if err = c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+	if c.Stats().LiveObjects != 0 {
+		t.Fatal("old mark epoch retained the previous dense graph")
+	}
+}
+func TestImmixUnusedPageAdvicePreservesLiveNeighborsAndReuse(t *testing.T) {
+	for _, portable := range []bool{false, true} {
+		t.Run(map[bool]string{false: "mapped", true: "portable"}[portable], func(t *testing.T) {
+			node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+			if err != nil {
+				t.Fatal(err)
+			}
+			scalar, err := NewStructDesc(1, []StorageKind{StorageI64})
+			if err != nil {
+				t.Fatal(err)
+			}
+			c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 4096, ThroughputHeapBytes: 4 * immixBlockBytes, ThroughputPageBytes: 4096, DisableVirtualBacking: portable}, []TypeDesc{node, scalar})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			dead, err := c.NewStructWithRoots(0, []Value{RefValue(Null()), I32Value(91)}, EmptyRoots{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.ForcePromote(dead); err != nil {
+				t.Fatal(err)
+			}
+			live, err := c.NewStructWithRoots(1, []Value{I64Value(42)}, EmptyRoots{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.ForcePromote(live); err != nil {
+				t.Fatal(err)
+			}
+			base := c.NativeView().Spaces[NativeSpaceOld].Base
+			if err = c.CollectFull(RefSliceRoots{live}); err != nil {
+				t.Fatal(err)
+			}
+			advised, err := c.ReleaseUnusedMemory()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if c.throughput.reservation != nil && advised != uint64(immixBlockBytes) {
+				t.Fatalf("advised%d, want one empty region", advised)
+			}
+			if portable && advised != 0 {
+				t.Fatal("portable backing claimed OS page advice")
+			}
+			if c.NativeView().Spaces[NativeSpaceOld].Base != base {
+				t.Fatal("page advice changed the stable heap base")
+			}
+			value, err := c.StructGet(live, 0)
+			if err != nil || value.I64() != 42 {
+				t.Fatalf("neighbor=%+v %v", value, err)
+			}
+			fresh, err := c.NewStructDefault(0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.ForcePromote(fresh); err != nil {
+				t.Fatal(err)
+			}
+			if c.entry(fresh).off != 0 {
+				t.Fatal("advised region was not reused")
+			}
+			field, err := c.StructGet(fresh, 1)
+			if err != nil || field.I32() != 0 {
+				t.Fatalf("reused default object exposed stale data: %+v %v", field, err)
+			}
+			if err = c.Verify(RefSliceRoots{live, fresh}); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+func TestImmixAutomaticPageAdviceWaitsForTwoIdleCycles(t *testing.T) {
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 4096, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096})
+	ref, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(ref); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ {
+		if err = c.CollectFull(EmptyRoots{}); err != nil {
+			t.Fatal(err)
+		}
+		got := c.ImmixStats().ReleasedPageBytes
+		if i < 2 && got != 0 {
+			t.Fatal("newly empty region advised before its idle threshold")
+		}
+		if i == 2 && c.throughput.reservation != nil && got != uint64(immixBlockBytes) {
+			t.Fatalf("idle page advice=%d", got)
+		}
+	}
+}

@@ -0,0 +1,94 @@
+package gc
+
+import (
+	"fmt"
+	"testing"
+)
+
+func BenchmarkImmixFullCollection(b *testing.B) {
+	for _, count := range []int{4096, 65536} {
+		for _, shape := range []string{"chain", "scalar-array", "sparse-scalars"} {
+			for _, allocator := range []AllocatorKind{AllocatorPagedSizeClass, AllocatorImmix} {
+				name := fmt.Sprintf("%s/n%d/allocator%d", shape, count, allocator)
+				b.Run(name, func(b *testing.B) {
+					node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+					if err != nil {
+						b.Fatal(err)
+					}
+					scalar, err := NewStructDesc(1, []StorageKind{StorageI64})
+					if err != nil {
+						b.Fatal(err)
+					}
+					array, err := NewArrayDesc(2, StorageRefNull)
+					if err != nil {
+						b.Fatal(err)
+					}
+					c, err := NewCollector(Config{Allocator: allocator, NurseryBytes: 16 << 20, ThroughputHeapBytes: 32 << 20, ThroughputPageBytes: 4096}, []TypeDesc{node, scalar, array})
+					if err != nil {
+						b.Fatal(err)
+					}
+					defer c.Close()
+					refs := make([]Ref, count)
+					var roots RefSliceRoots
+					var scratch InitializerRootScratch
+					for i := range refs {
+						if shape == "chain" {
+							prior := Null()
+							if i != 0 {
+								prior = refs[i-1]
+							}
+							values := [2]Value{RefValue(prior), I32Value(int32(i))}
+							refs[i], err = c.NewStructWithRootScratch(0, values[:], EmptyRoots{}, &scratch)
+						} else {
+							refs[i], err = c.NewStructDefault(1)
+						}
+						if err != nil {
+							b.Fatal(err)
+						}
+						if err = c.ForcePromote(refs[i]); err != nil {
+							b.Fatal(err)
+						}
+					}
+					switch shape {
+					case "chain":
+						roots = RefSliceRoots{refs[len(refs)-1]}
+					case "scalar-array":
+						root, err := c.NewArrayDefault(2, uint32(len(refs)))
+						if err != nil {
+							b.Fatal(err)
+						}
+						for i, r := range refs {
+							if err = c.ArraySet(root, uint32(i), RefValue(r)); err != nil {
+								b.Fatal(err)
+							}
+						}
+						if err = c.ForcePromote(root); err != nil {
+							b.Fatal(err)
+						}
+						roots = RefSliceRoots{root}
+					case "sparse-scalars":
+						for i, r := range refs {
+							if i%100 == 0 {
+								roots = append(roots, r)
+							}
+						}
+					}
+					if err = c.CollectFull(roots); err != nil {
+						b.Fatal(err)
+					}
+					b.ReportAllocs()
+					b.ResetTimer()
+					for i := 0; i < b.N; i++ {
+						if err = c.CollectFull(roots); err != nil {
+							b.Fatal(err)
+						}
+					}
+					b.StopTimer()
+					s := c.ImmixStats()
+					b.ReportMetric(float64(s.MetadataBytes+s.MarkScratchBytes), "region-meta-B")
+					b.ReportMetric(float64(c.Stats().LiveObjects), "live-objects")
+				})
+			}
+		}
+	}
+}

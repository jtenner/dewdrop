+	if c.validObjectRef(ref) {
+		t.Fatal("stale minor bit retained an unrooted old object")
+	}
+	if c.mark[h] {
+		t.Fatal("freed handle retained a minor mark before later reuse")
+	}
+}
+func TestImmixRegionQueuesTraceDenseReferenceArrays(t *testing.T) {

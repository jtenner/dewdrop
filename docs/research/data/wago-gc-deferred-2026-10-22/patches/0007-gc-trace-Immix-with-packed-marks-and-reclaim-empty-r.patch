+
+func TestImmixPackedFullMarksIgnoreStaleMinorBits(t *testing.T) {
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 4096, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096})
+	ref, err := c.NewStructDefault(1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(ref); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.CollectFull(RefSliceRoots{ref}); err != nil {
+		t.Fatal(err)
+	}
+	h := handleOf(ref)
+	if !c.fullMarked(h) || c.mark[h] {
+		t.Fatal("full marks did not use the packed epoch product")
+	}
+	c.mark[h] = true // stale legacy/minor state must not retain an old object.
+	if err = c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)

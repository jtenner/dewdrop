+func TestImmixPageAdviceFailureIsVisibleAndRetryable(t *testing.T) {
+	c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 4096, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096})
+	if virtualmem.Supported && c.throughput.reservation == nil {
+		t.Fatal("supported build did not reserve stable backing")
+	}
+	ref, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(ref); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+	if !virtualmem.Supported {
+		if bytes, err := c.ReleaseUnusedMemory(); err != nil || bytes != 0 {
+			t.Fatalf("portable advice: %d %v", bytes, err)
+		}
+		return
+	}
+	cleanup := armFailure(&c.throughput, failImmixPageAdvice, 0)
+	_, err = c.ReleaseUnusedMemory()
+	cleanup()
+	if !errors.Is(err, errInjectedFailure) {
+		t.Fatalf("page-advice failure hidden: %v", err)
+	}
+	if c.ImmixStats().ReleasedPageBytes != 0 {
+		t.Fatal("failed advice claimed released pages")
+	}
+	if err = c.Verify(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+	if bytes, err := c.ReleaseUnusedMemory(); err != nil || bytes != uint64(immixBlockBytes) {
+		t.Fatalf("retry: %d %v", bytes, err)
+	}
+}
diff --git a/src/core/runtime/gc/native/immix_mark.go b/src/core/runtime/gc/native/immix_mark.go
new file mode 100644
index 000000000..40c46f111
--- /dev/null
+++ b/src/core/runtime/gc/native/immix_mark.go
@@ -0,0 +1,229 @@
+package gc
+
+import "math/bits"
+
+const immixNoRegion = ^uint32(0)
+
+type immixMarkWord struct {
+	bits  uint64
+	epoch uint32
+	_     uint32
+}
+
+// Intrusive integer links group work by region without per-object Go pointers.
+// The packed full-mark bitmap is authoritative; the existing young bool marks
+// are retained only for minor evacuation and its failure/rollback protocol.
+type immixMarkTask struct{ handle, next uint32 }
+type immixArrayTask struct{ handle, index uint32 }
+type immixMarkWork struct {
+	heads    []uint32
+	nodes    []immixMarkTask
+	deferred []immixArrayTask
+	free     uint32
+	limit    int
+	active   []uint64
+	seen     []immixMarkWord
+	first    int
+	source   uint32
+}
+
+func (m *immixHeap) prepareMarkWork(handles int) {
+	if m.work == nil {
+		m.work = &immixMarkWork{}
+	}
+	w := m.work
+	heads := len(m.regions) + 1
+	if cap(w.heads) < heads {
+		w.heads = make([]uint32, heads)
+	} else {
+		w.heads = w.heads[:heads]
+		clear(w.heads)
+	}
+	w.nodes = w.nodes[:0]
+	w.deferred = w.deferred[:0]
+	w.free = 0
+	w.limit = handles
+	words := (handles + 63) / 64
+	if len(w.seen) < words {
+		w.seen = append(w.seen, make([]immixMarkWord, words-len(w.seen))...)
+	}
+	active := (heads + 63) / 64
+	if cap(w.active) < active {
+		w.active = make([]uint64, active)
+	} else {
+		w.active = w.active[:active]
+		clear(w.active)
+	}
+	w.first = len(w.active)
+	w.source = immixNoRegion
+}
+func (m *immixHeap) firstMark(h uint32) bool {
+	word := &m.work.seen[h/64]
+	if word.epoch != m.epoch {
+		word.epoch = m.epoch
+		word.bits = 0
+	}
+	bit := uint64(1) << (h % 64)
+	if word.bits&bit != 0 {
+		return false
+	}
+	word.bits |= bit
+	return true
+}
+func (m *immixHeap) marked(h uint32) bool {
+	if m.work == nil || int(h/64) >= len(m.work.seen) {
+		return false
+	}
+	word := m.work.seen[h/64]
+	return word.epoch == m.epoch && word.bits&(uint64(1)<<(h%64)) != 0
+}
+func (m *immixHeap) enqueue(h uint32, e handleEntry) {
+	w := m.work
+	bucket := uint32(len(m.regions))
+	if e.space == spaceOld || e.space == spaceLarge {
+		bucket = e.off / immixBlockBytes
+	}
+	if int(bucket) >= len(w.heads) || int(h) >= w.limit {
+		panic("gc: Immix mark queue exceeds its prepared bounds")
+	}
+	var node uint32
+	if w.free != 0 {
+		node = w.free
+		w.free = w.nodes[node-1].next
+	} else {
+		if len(w.nodes) == w.limit {
+			panic("gc: Immix mark work exceeds the handle bound")
+		}
+		if len(w.nodes) == cap(w.nodes) {
+			capacity := min(w.limit, max(len(w.nodes)+1, cap(w.nodes)+cap(w.nodes)/2+1))
+			next := make([]immixMarkTask, len(w.nodes), capacity)
+			copy(next, w.nodes)
+			w.nodes = next
+		}
+		w.nodes = append(w.nodes, immixMarkTask{})
+		node = uint32(len(w.nodes))
+	}
+	w.nodes[node-1] = immixMarkTask{handle: h, next: w.heads[bucket]}
+	w.heads[bucket] = node
+	word := int(bucket / 64)
+	w.active[word] |= uint64(1) << (bucket % 64)
+	w.first = min(w.first, word)
+}
+func (m *immixHeap) popMark() (uint32, bool) {
+	w := m.work
+	for w.first < len(w.active) && w.active[w.first] == 0 {
+		w.first++
+	}
+	if w.first == len(w.active) {
+		return 0, false
+	}
+	bucket := uint32(w.first*64 + bits.TrailingZeros64(w.active[w.first]))
+	node := w.heads[bucket]
+	if node == 0 {
+		panic("gc: Immix active region has no mark work")
+	}
+	h := w.nodes[node-1].handle
+	w.heads[bucket] = w.nodes[node-1].next
+	w.nodes[node-1] = immixMarkTask{next: w.free}
+	w.free = node
+	if w.heads[bucket] == 0 {
+		w.active[w.first] &^= uint64(1) << (bucket % 64)
+	}
+	w.source = bucket
+	if bucket == uint32(len(m.regions)) {
+		w.source = immixNoRegion
+	}
+	return h, true
+}
+func (m *immixHeap) noteConnection(e handleEntry) {
+	source := m.work.source
+	if source == immixNoRegion || e.space != spaceOld && e.space != spaceLarge || e.off/immixBlockBytes == source {
+		return
+	}
+	r := &m.regions[source]
+	if r.connections != ^uint32(0) {
+		r.connections++
+	}
+}
+func (c *Collector) fullMarked(h uint32) bool {
+	if m := c.throughput.immix; m != nil {
+		return m.marked(h)
+	}
+	return c.mark[h]
+}
+func (c *Collector) drainImmixMarkQueues() {
+	m := c.throughput.immix
+	w := m.work
+	for {
+		h, ok := m.popMark()
+		var cursor objectScanCursor
+		if !ok {
+			if len(w.deferred) == 0 {
+				break
+			}
+			task := w.deferred[len(w.deferred)-1]
+			w.deferred = w.deferred[:len(w.deferred)-1]
+			h = task.handle
+			cursor.index = task.index
+			w.source = immixNoRegion
+			e := c.handles[h]
+			if e.space == spaceOld || e.space == spaceLarge {
+				w.source = e.off / immixBlockBytes
+			}
+		}
+		id := c.handles[h].typeID
+		if int(id) >= len(c.types) {
+			panic("gc: Immix mark work names an invalid canonical type")
+		}
+		d := &c.types[id]
+		if d.Kind != KindArray {
+			c.scanObjectImmixMark(h)
+			continue
+		}
+		budget := objectScanBudget{ObjectRanges: 1, ScanEntries: 512, RefSlots: 512, PayloadBytes: 8192}
+		_, complete := c.scanObjectRefsRange(h, &cursor, budget, objectScanVisitor{mode: objectScanVisitImmixMark})
+		if !complete {
+			w.deferred = append(w.deferred, immixArrayTask{h, cursor.index})
+		}
+	}
+	w.source = immixNoRegion
+}
+
+func (c *Collector) markImmixRef(r Ref) {
+	if !r.IsObj() {
+		return
+	}
+	h := handleOf(r)
+	if h == 0 || int(h) >= len(c.handles) || c.handles[h].space == spaceFree {
+		return
+	}
+	m := c.throughput.immix
+	e := c.handles[h]
+	m.noteConnection(e)
+	if !m.firstMark(h) {
+		return
+	}
+	if e.young() {
+		c.mark[h] = true
+	}
+	if e.space == spaceOld || e.space == spaceLarge {
+		m.mark(e)
+	}
+	if e.class&NativeHandlePointerFreeBit == 0 {
+		m.enqueue(h, e)
+	}
+}
+func (c *Collector) markImmixRoots(roots RootSet) {
+	if direct, ok := roots.(DirectRootRefSet); ok {
+		c.markDirectRoots(direct, rootMarkImmixFull)
+	} else if roots != nil && !rangeRootRefs(roots, func(r Ref) bool { c.markImmixRef(r); return true }) {
+		roots.RangeRoots(func(s RootSlot) bool { c.markImmixRef(s.GetRef()); return true })
+	}
+	for _, r := range c.globalSlots {
+		c.markImmixRef(r)
+	}
+	for _, r := range c.tableSlots {
+		c.markImmixRef(r)
+	}
+	c.drainImmixMarkQueues()
+}
diff --git a/src/core/runtime/gc/native/immix_scan.go b/src/core/runtime/gc/native/immix_scan.go
new file mode 100644
index 000000000..4f78392f5
--- /dev/null
+++ b/src/core/runtime/gc/native/immix_scan.go
@@ -0,0 +1,37 @@
+package gc
+
+import "encoding/binary"
+
+// Keep this direct sink in step with scanObjectMark. The default product keeps
+// its existing hot loop and the region product keeps its precomputed scan plan.
+func (c *Collector) scanObjectImmixMark(h uint32) {
+	// Keep reference order and filtering in step with scanObjectRefs.
+	// A separate loop lets the compiler inline marking without a callback.
+	r := makeObjRef(h)
+	d, err := c.refDesc(r)
+	if err != nil || !d.HasRefs {
+		return
+	}
+	hdr := c.header(r)
+	b := c.bytes(r)
+	if d.Kind == KindStruct {
+		if nativeCollectorFastPaths && d.firstRef != 0 {
+			for index := uint32(d.firstRef); index != 0; {
+				field := d.Fields[index-1]
+				c.markImmixRef(Ref(binary.LittleEndian.Uint32(b[PayloadOffset+field.Offset:])))
+				index = uint32(field.nextRef)
+			}
+			return
+		}
+		for _, f := range d.Fields {
+			if isCollectorRefKind(f.Kind) {
+				c.markImmixRef(Ref(binary.LittleEndian.Uint32(b[PayloadOffset+f.Offset:])))
+			}
+		}
+	} else if d.ArrayElementsAreRefs() {
+		for i := uint32(0); i < hdr.Aux; i++ {
+			off := d.PayloadOffset() + i*d.ElemSize
+			c.markImmixRef(Ref(binary.LittleEndian.Uint32(b[off:])))
+		}
+	}
+}
diff --git a/src/core/runtime/gc/native/immix_sweep.go b/src/core/runtime/gc/native/immix_sweep.go
new file mode 100644
index 000000000..ebf0a7566
--- /dev/null
+++ b/src/core/runtime/gc/native/immix_sweep.go
@@ -0,0 +1,173 @@
+package gc
+
+import (
+	"fmt"
+	"math/bits"
+)
+
+func (m *immixHeap) resetEmptyRegion(block uint32) {
+	m.regions[block] = immixRegion{emptySince: m.epoch}
+	for i := range m.cursors {
+		if m.cursors[i].end != 0 && m.cursors[i].block == block {
+			m.cursors[i] = immixCursor{}
+		}
+	}
+}
+
+// A completed full mark proves completely white regions empty in one metadata
+// reset. Only partially live regions retain per-object lazy sweep debt.
+func (h *throughputHeap) sweepImmixEmptyRegions() {
+	m := h.immix
+	for b := uint32(0); b < uint32(len(m.regions)); {
+		r := &m.regions[b]
+		if r.kind == immixLarge {
+			if r.owner != b+1 {
+				b++
+				continue
+			}
+			count := r.blocks
+			if count == 0 || uint64(b)+uint64(count) > uint64(len(m.regions)) {
+				panic("gc: invalid dedicated Immix region extent")
+			}
+			if r.epoch != m.epoch {
+				for i := b; i < b+count; i++ {
+					m.resetEmptyRegion(i)
+				}
+			}
+			b += count
+			continue
+		}
+		if r.occupied != 0 && r.epoch != m.epoch {
+			m.resetEmptyRegion(b)
+		}
+		b++
+	}
+	out := h.pendingFree[:0]
+	var pending uint64
+	for _, span := range h.pendingFree {
+		if m.hasStart(span.off) {
+			out = append(out, span)
+			pending += uint64(span.size)
+		}
+	}
+	clear(h.pendingFree[len(out):])
+	h.pendingFree = out
+	h.pendingBytes = pending
+}
+
+func (h *throughputHeap) reuseImmixRegion(block uint32) error {
+	r := &h.immix.regions[block]
+	if r.released && h.reservation != nil {
+		if err := h.reservation.Reuse(uint64(block)*uint64(immixBlockBytes), uint64(immixBlockBytes)); err != nil {
+			return fmt.Errorf("gc: reuse Immix region%d: %w", block, err)
+		}
+	}
+	r.released = false
+	return nil
+}
+
+func (h *throughputHeap) adviseIdleImmix(force bool) (uint64, error) {
+	m := h.immix
+	if m == nil || h.reservation == nil {
+		return 0, nil
+	}
+	var total uint64
+	for b := uint32(0); b < uint32(len(m.regions)); {
+		r := &m.regions[b]
+		if r.kind != immixEmpty || r.occupied != 0 || r.released || r.emptySince == 0 || !force && m.epoch-r.emptySince < 2 {
+			b++
+			continue
+		}
+		first := b
+		for b < uint32(len(m.regions)) {
+			r = &m.regions[b]
+			if r.kind != immixEmpty || r.occupied != 0 || r.released || r.emptySince == 0 || !force && m.epoch-r.emptySince < 2 {
+				break
+			}
+			b++
+		}
+		bytes := uint64(b-first) * uint64(immixBlockBytes)
+		if err := injectFailure(h, failImmixPageAdvice); err != nil {
+			return total, err
+		}
+		if err := h.reservation.AdviseUnused(uint64(first)*uint64(immixBlockBytes), bytes); err != nil {
+			return total, fmt.Errorf("gc: advise unused Immix regions%d..%d: %w", first, b, err)
+		}
+		for i := first; i < b; i++ {
+			m.regions[i].released = true
+		}
+		total += bytes
+		m.releasedBytes += bytes
+	}
+	return total, nil
+}
+
+// ReleaseUnusedMemory reconciles existing old sweep debt and advises empty
+// Immix regions to the OS. The returned count is advice, not measured RSS or a
+// decrease in addressable/committed bytes. Portable/non-region heaps return zero.
+// Caller serialization is the same as for collection; live addresses never move.
+func (c *Collector) ReleaseUnusedMemory() (uint64, error) {
+	if err := c.errIfClosed(); err != nil {
+		return 0, err
+	}
+	if c.throughput.immix == nil {
+		return 0, nil
+	}
+	if err := c.throughput.sweepAllPending(); err != nil {
+		return 0, err
+	}
+	return c.throughput.adviseIdleImmix(true)
+}
+
+func (c *Collector) sweepImmixDeadHandle(h uint32) {
+	// Full marking no longer clears the old portion of the minor bool array.
+	// Clear a dead identity before putting it on either Go/native reuse path.
+	c.mark[h] = false
+	e := &c.handles[h]
+	if e.space == spaceOld || e.space == spaceLarge {
+		c.deferThroughputFree(h)
+	} else {
+		c.free(h)
+	}
+}
+func (c *Collector) sweepImmixHandles() {
+	m := c.throughput.immix
+	if nativeCollectorFastPaths && len(c.majorBlocks) != 0 && len(c.freeHandles) >= len(c.handles)/2 {
+		if c.majorYoungDirty {
+			c.noteMajorHandles(c.nurseryHandles)
+			c.majorYoungDirty = false
+		}
+		for word, occupied := range c.majorBlocks {
+			var live uint64
+			for occupied != 0 {
+				bit := uint(bits.TrailingZeros64(occupied))
+				mask := uint64(1) << bit
+				occupied &^= mask
+				start := (word*64 + int(bit)) << majorBlockShift
+				end := min(start+(1<<majorBlockShift), len(c.handles))
+				for h := max(start, 1); h < end; h++ {
+					if c.handles[h].space == spaceFree {
+						continue
+					}
+					if m.marked(uint32(h)) {
+						live |= mask
+					} else {
+						c.sweepImmixDeadHandle(uint32(h))
+					}
+				}
+			}
+			c.majorBlocks[word] = live
+		}
+	} else {
+		for h := uint32(1); int(h) < len(c.handles); h++ {
+			if c.handles[h].space != spaceFree && !m.marked(h) {
+				c.sweepImmixDeadHandle(h)
+			}
+		}
+	}
+	c.compactNurseryHandles()
+	if nativeCollectorFastPaths {
+		c.prepareMajorBlocks()
+	}
+	c.throughput.sweepImmixEmptyRegions()
+}

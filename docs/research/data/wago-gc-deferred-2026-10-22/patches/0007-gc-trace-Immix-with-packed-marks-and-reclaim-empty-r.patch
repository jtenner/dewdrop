+	if err != nil {
+		t.Fatal(err)
+	}
+	for i, r := range children {
+		if err = c.ArraySet(root, uint32(i), RefValue(r)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = c.ForcePromote(root); err != nil {
+		t.Fatal(err)
+	}
+	if err = c.CollectFull(RefSliceRoots{root}); err != nil {
+		t.Fatal(err)
+	}
+	for i, r := range children {

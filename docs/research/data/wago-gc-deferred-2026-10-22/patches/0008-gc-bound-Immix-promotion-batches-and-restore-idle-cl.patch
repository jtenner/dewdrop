+// Empty-region claims are the only metadata which reverse object frees cannot
+// reconstruct. Journal only those claims, not the complete heap per allocation.
+func (m *immixHeap) saveEmptyClaim(block uint32) {
+	if m.txDepth != 0 && m.regions[block].occupied == 0 {
+		m.undo = append(m.undo, immixClaimUndo{block, m.regions[block]})
+	}
+}

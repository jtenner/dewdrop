+func TestImmixTransactionRestoresIdleRegionClaim(t *testing.T) {
+	for _, portable := range []bool{false, true} {
+		h := newImmixTestHeap(t, 4*immixBlockBytes, portable)
+		e, err := h.alloc(8, spaceOld, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = h.free(e); err != nil {
+			t.Fatal(err)
+		}
+		h.immix.epoch = 9
+		if _, err = h.adviseIdleImmix(true); err != nil {
+			t.Fatal(err)
+		}
+		before := slices.Clone(h.immix.regions)
+		tx := h.beginAllocTransaction()
+		e, err = h.alloc(8, spaceOld, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		h.rollbackSuccessfulAlloc(e, tx.bump)
+		h.restoreAllocTransaction(tx)
+		if !slices.Equal(before, h.immix.regions) {
+			t.Fatalf("portable=%v: rollback changed idle/released region metadata", portable)
+		}
+		if err = h.verify([]handleEntry{{}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestImmixPartialRunStopsAtRegionAndRestoresClaims(t *testing.T) {
+	h := newImmixTestHeap(t, 2*immixBlockBytes, false)
+	tx := h.beginAllocTransaction()
+	run, ok, err := h.tryAllocRun(8, 10000, spaceOld, true)
+	if err != nil || !ok || run.count != int(immixBlockBytes/16) {
+		t.Fatalf("partial run: %+v %v %v", run, ok, err)
+	}
+	live := []handleEntry{{}}
+	for i := 0; i < run.count; i++ {
+		live = append(live, handleEntry{off: run.off + uint32(i)*run.allocSize, size: 8, space: spaceOld})
+	}
+	if err = h.verify(live); err != nil {
+		t.Fatal(err)
+	}
+	for i := len(live) - 1; i > 0; i-- {
+		h.rollbackSuccessfulAlloc(live[i], tx.bump)
+	}
+	h.restoreAllocTransaction(tx)
+	if len(h.immix.regions) != 0 || h.immix.txDepth != 0 || len(h.immix.undo) != 0 {
+		t.Fatal("partial run rollback kept ownership")
+	}
+	tx = h.beginAllocTransaction()
+	if _, err = h.alloc(16, spaceOld, true); err != nil {
+		t.Fatal(err)
+	}
+	h.commitAllocTransaction(tx)
+	if h.immix.txDepth != 0 || len(h.immix.undo) != 0 {
+		t.Fatal("committed transaction retained undo entries")
+	}
+}
+
+func TestImmixLargePromotionBatchAndMixedClasses(t *testing.T) {
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+	if err != nil {
+		t.Fatal(err)
+	}
+	scalar, err := NewStructDesc(1, []StorageKind{StorageI64, StorageI32})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 512 << 10, DisableMovingNursery: true, ThroughputHeapBytes: 2 << 20, ThroughputPageBytes: 4096}, []TypeDesc{node, scalar})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	roots := make(RefSliceRoots, 10000)
+	for i := range roots {
+		roots[i], err = c.NewStructDefault(TypeID(i % 2))
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = c.CollectMinor(roots); err != nil {
+		t.Fatal(err)
+	}
+	for i, r := range roots {
+		e := c.handles[handleOf(r)]
+		want := immixReferences
+		if i%2 == 1 {
+			want = immixPointerFree
+		}
+		if e.young() || c.throughput.immix.regions[e.off/immixBlockBytes].kind != want {
+			t.Fatalf("object%d incorrect class/age", i)
+		}
+	}
+	if c.throughput.immix.txDepth != 0 {
+		t.Fatal("promotion left transaction open")
+	}
+	if err = c.Verify(roots); err != nil {
+		t.Fatal(err)
+	}
+}

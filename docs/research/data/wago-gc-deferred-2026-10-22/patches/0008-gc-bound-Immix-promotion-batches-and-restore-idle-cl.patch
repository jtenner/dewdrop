+// Return a partial ordinary-block run. Callers cap grouping work even when a
+// large object cannot use this path, so failed runs never cause quadratic scans.
+func (h *throughputHeap) tryAllocImmixRun(size uint32, count int, sp spaceKind, pointerFree bool) (throughputAllocRun, bool, error) {
+	if count < 2 || size == 0 || size > immixLargeThreshold || sp != spaceOld {
+		return throughputAllocRun{}, false, nil
+	}
+	first, err := h.allocImmix(size, sp, pointerFree)
+	if err != nil {
+		return throughputAllocRun{}, false, err
+	}
+	charged := Align16(size)
+	which := 0
+	if pointerFree {
+		which = 1
+	}
+	cursor := &h.immix.cursors[which]
+	actual := min(count, 1+int((cursor.end-cursor.next)/charged))
+	for i := 1; i < actual; i++ {
+		if err = h.immix.record(cursor.next, charged); err != nil {
+			panic("gc: invalid Immix run ownership: " + err.Error())
+		}
+		cursor.next += charged
+	}
+	return throughputAllocRun{count: actual, off: first.off, allocSize: charged, lastAllocSize: charged, class: first.class}, true, nil
+}

diff --git a/src/core/runtime/gc/native/immix.go b/src/core/runtime/gc/native/immix.go
new file mode 100644
index 000000000..b81f9a3fa
--- /dev/null
+++ b/src/core/runtime/gc/native/immix.go
@@ -0,0 +1,507 @@
+package gc
+
+import (
+	"errors"
+	"fmt"
+	"math/bits"
+	"unsafe"
+)
+
+const (
+	immixBlockBytes     uint32 = 32 << 10
+	immixLineBytes      uint32 = 128
+	immixLines                 = immixBlockBytes / immixLineBytes
+	immixUnits                 = immixBlockBytes / 16
+	immixLargeThreshold        = immixBlockBytes / 2
+)
+
+type immixRegionKind uint8
+
+const (
+	immixEmpty immixRegionKind = iota
+	immixReferences
+	immixPointerFree
+	immixLarge
+)
+
+// Metadata never contains guest references or raw object pointers. Line counts
+// count object overlaps, not bytes, so shared boundary lines remain occupied
+// until their final object is swept. Eight aligned starts fit in one line.
+type immixRegion struct {
+	starts      [immixUnits / 64]uint64
+	used        [immixLines / 64]uint64
+	marks       [immixLines / 64]uint64
+	cards       [immixLines / 64]uint64
+	counts      [immixLines]uint8
+	owner       uint32 // one-based first block for a dedicated large region
+	blocks      uint32 // extent on its first block only
+	epoch       uint32
+	liveBytes   uint32
+	occupied    uint16
+	kind        immixRegionKind
+	released    bool
+	generation  uint8
+	pointerFree bool
+}
+
+type immixCursor struct{ next, end, block uint32 }
+type immixHeap struct {
+	regions        []immixRegion
+	cursors        [2]immixCursor
+	search         [2]uint32
+	epoch          uint32
+	exclude        []bool
+	releasedBytes  uint64
+	evacuatedBytes uint64
+	handleUpdates  uint64
+	hasCards       bool
+}
+
+type ImmixStats struct {
+	Regions, OccupiedLines, LiveLines, PointerFreeRegions, LargeRegions         uint32
+	LiveBytes, AllocatedBytes, ReleasedPageBytes, EvacuatedBytes, HandleUpdates uint64
+	MetadataBytes                                                               uint64
+}
+
+func (c *Collector) ImmixStats() ImmixStats {
+	var s ImmixStats
+	m := c.throughput.immix
+	if m == nil {
+		return s
+	}
+	s.Regions = uint32(len(m.regions))
+	s.MetadataBytes = uint64(cap(m.regions)) * uint64(unsafe.Sizeof(immixRegion{}))
+	s.ReleasedPageBytes = m.releasedBytes
+	s.EvacuatedBytes = m.evacuatedBytes
+	s.HandleUpdates = m.handleUpdates
+	for i := range m.regions {
+		r := &m.regions[i]
+		s.OccupiedLines += uint32(r.occupied)
+		if r.kind == immixPointerFree {
+			s.PointerFreeRegions++
+		}
+		if r.kind == immixLarge && r.owner == uint32(i)+1 {
+			s.LargeRegions++
+		}
+		if r.epoch == m.epoch {
+			s.LiveBytes += uint64(r.liveBytes)
+			for _, v := range r.marks {
+				s.LiveLines += uint32(bits.OnesCount64(v))
+			}
+		}
+	}
+	for _, e := range c.handles {
+		if e.space == spaceOld || e.space == spaceLarge {
+			s.AllocatedBytes += uint64(Align16(e.size))
+		}
+	}
+	return s
+}
+
+func (m *immixHeap) excluded(block uint32) bool {
+	return int(block) < len(m.exclude) && m.exclude[block]
+}
+func (m *immixHeap) hasStart(off uint32) bool {
+	block := off / immixBlockBytes
+	if int(block) >= len(m.regions) || off%16 != 0 {
+		return false
+	}
+	unit := (off % immixBlockBytes) / 16
+	return m.regions[block].starts[unit/64]&(uint64(1)<<(unit%64)) != 0
+}
+func (m *immixHeap) beginMark() {
+	m.epoch++
+	if m.epoch == 0 {
+		for i := range m.regions {
+			m.regions[i].epoch = 0
+		}
+		m.epoch = 1
+	}
+}
+func (m *immixHeap) mark(e handleEntry) {
+	if e.size == 0 || uint64(e.off)+uint64(e.size) > uint64(len(m.regions))*uint64(immixBlockBytes) {
+		panic("gc: marked Immix object exceeds its region backing")
+	}
+
+	end := uint64(e.off) + uint64(e.size)
+	for off := uint64(e.off); off < end; {
+		block := uint32(off / uint64(immixBlockBytes))
+		r := &m.regions[block]
+		r.generation = 255
+		if e.young() {
+			r.generation = e.age()
+		}
+		if r.kind == immixLarge {
+			r.pointerFree = e.class&NativeHandlePointerFreeBit != 0
+		}
+		if r.epoch != m.epoch {
+			r.epoch = m.epoch
+			r.marks = [immixLines / 64]uint64{}
+			r.liveBytes = 0
+		}
+		limit := min(end, uint64(block+1)*uint64(immixBlockBytes))
+		r.liveBytes += uint32(limit - off)
+		first := (off % uint64(immixBlockBytes)) / uint64(immixLineBytes)
+		last := (limit - 1) % uint64(immixBlockBytes) / uint64(immixLineBytes)
+		for line := first; line <= last; line++ {
+			r.marks[line/64] |= uint64(1) << (line % 64)
+		}
+		off = limit
+	}
+}
+
+func (m *immixHeap) record(off, size uint32) error {
+	if off%16 != 0 || size == 0 || size%16 != 0 || uint64(off)+uint64(size) > uint64(len(m.regions))*uint64(immixBlockBytes) {
+		return errors.New("gc: Immix allocation extent invalid")
+	}
+	block := off / immixBlockBytes
+	unit := (off % immixBlockBytes) / 16
+	if m.hasStart(off) {
+		return errors.New("gc: Immix object start already allocated")
+	}
+	end := uint64(off) + uint64(size)
+	// Validate the complete range before changing counts.
+	for at := uint64(off); at < end; {
+		b := uint32(at / uint64(immixBlockBytes))
+		r := &m.regions[b]
+		limit := min(end, uint64(b+1)*uint64(immixBlockBytes))
+		for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32((limit-1)%uint64(immixBlockBytes))/immixLineBytes; line++ {
+			if r.counts[line] >= 8 {
+				return errors.New("gc: Immix line overlap overflow")
+			}
+		}
+		at = limit
+	}
+	m.regions[block].starts[unit/64] |= uint64(1) << (unit % 64)
+	for at := uint64(off); at < end; {
+		b := uint32(at / uint64(immixBlockBytes))
+		r := &m.regions[b]
+		limit := min(end, uint64(b+1)*uint64(immixBlockBytes))
+		for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32((limit-1)%uint64(immixBlockBytes))/immixLineBytes; line++ {
+			if r.counts[line] == 0 {
+				r.occupied++
+				r.used[line/64] |= uint64(1) << (line % 64)
+			}
+			r.counts[line]++
+		}
+		r.released = false
+		at = limit
+	}
+	return nil
+}
+
+func (m *immixHeap) release(span throughputFreeSpan) error {
+	if !m.hasStart(span.off) || span.size == 0 || span.size%16 != 0 || uint64(span.off)+uint64(span.size) > uint64(len(m.regions))*uint64(immixBlockBytes) {
+		return errors.New("gc: Immix free has no owned object start")
+	}
+	end := uint64(span.off) + uint64(span.size)
+	for at := uint64(span.off); at < end; {
+		b := uint32(at / uint64(immixBlockBytes))
+		limit := min(end, uint64(b+1)*uint64(immixBlockBytes))
+		r := &m.regions[b]
+		for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32((limit-1)%uint64(immixBlockBytes))/immixLineBytes; line++ {
+			if r.counts[line] == 0 {
+				return errors.New("gc: Immix line underflow")
+			}
+		}
+		at = limit
+	}
+	b := span.off / immixBlockBytes
+	unit := (span.off % immixBlockBytes) / 16
+	m.regions[b].starts[unit/64] &^= uint64(1) << (unit % 64)
+	for at := uint64(span.off); at < end; {
+		block := uint32(at / uint64(immixBlockBytes))
+		limit := min(end, uint64(block+1)*uint64(immixBlockBytes))
+		r := &m.regions[block]
+		for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32((limit-1)%uint64(immixBlockBytes))/immixLineBytes; line++ {
+			r.counts[line]--
+			if r.counts[line] == 0 {
+				r.occupied--
+				r.used[line/64] &^= uint64(1) << (line % 64)
+			}
+		}
+		at = limit
+	}
+	// A large allocation is alone in its blocks, so all its blocks can immediately
+	// become ordinary arenas. No handle points at their former object bytes.
+	if m.regions[b].kind == immixLarge {
+		count := m.regions[b].blocks
+		for i := b; i < b+count; i++ {
+			m.regions[i] = immixRegion{}
+		}
+	}
+	if m.regions[b].occupied == 0 && m.regions[b].kind != immixLarge {
+		m.regions[b].kind = immixEmpty
+		for i := range m.cursors {
+			if m.cursors[i].end != 0 && m.cursors[i].block == b {
+				m.cursors[i] = immixCursor{}
+			}
+		}
+	}
+	return nil
+}
+
+func (m *immixHeap) findRun(kind immixRegionKind, need uint32) (uint32, uint32, bool) {
+	if len(m.regions) == 0 {
+		return 0, 0, false
+	}
+	which := int(kind - immixReferences)
+	start := m.search[which] % uint32(len(m.regions))
+	for n := uint32(0); n < uint32(len(m.regions)); n++ {
+		b := (start + n) % uint32(len(m.regions))
+		r := &m.regions[b]
+		if m.excluded(b) || r.kind == immixLarge || (r.kind != immixEmpty && r.kind != kind) || immixLines-uint32(r.occupied) < need {
+			continue
+		}
+		for line := uint32(0); line < immixLines; {
+			word := r.used[line/64]
+			free := ^word & (^uint64(0) << (line % 64))
+			if free == 0 {
+				line = (line/64 + 1) * 64
+				continue
+			}
+			line = line/64*64 + uint32(bits.TrailingZeros64(free))
+			end := line
+			for end < immixLines && r.counts[end] == 0 {
+				end++
+			}
+			if end-line >= need {
+				r.kind = kind
+				m.search[which] = b
+				return b*immixBlockBytes + line*immixLineBytes, b*immixBlockBytes + end*immixLineBytes, true
+			}
+			line = end + 1
+		}
+	}
+	return 0, 0, false
+}
+
+func (h *throughputHeap) allocImmix(size uint32, sp spaceKind, pointerFree bool) (handleEntry, error) {
+	if size == 0 || size > ^uint32(0)-15 {
+		return handleEntry{}, ErrAllocationTooLarge
+	}
+	m := h.immix
+	charged := Align16(size)
+	if sp == spaceLarge || charged > immixLargeThreshold {
+		blocks := uint32((uint64(charged) + uint64(immixBlockBytes) - 1) / uint64(immixBlockBytes))
+		first, ok := m.findEmptyBlocks(blocks)
+		for !ok && len(h.pendingFree) != 0 {
+			if err := h.sweepOnePending(); err != nil {
+				return handleEntry{}, err
+			}
+			first, ok = m.findEmptyBlocks(blocks)
+		}
+		if !ok {
+			off, err := h.growImmixBlocks(blocks)
+			if err != nil {
+				return handleEntry{}, err
+			}
+			first = off / immixBlockBytes
+		}
+		for b := first; b < first+blocks; b++ {
+			m.regions[b] = immixRegion{kind: immixLarge, owner: first + 1}
+		}
+		m.regions[first].blocks = blocks
+		off := first * immixBlockBytes
+		if err := m.record(off, charged); err != nil {
+			return handleEntry{}, err
+		}
+		return handleEntry{off: off, size: size, class: uint16(len(throughputClassSizes)), space: sp}, nil
+	}
+	which := 0
+	kind := immixReferences
+	if pointerFree {
+		which = 1
+		kind = immixPointerFree
+	}
+	cursor := &m.cursors[which]
+	if cursor.end == 0 || m.excluded(cursor.block) || uint64(cursor.next)+uint64(charged) > uint64(cursor.end) {
+		// Lazily reconcile dead objects only when another free-line run is needed.
+		for {
+			off, end, ok := m.findRun(kind, (charged+immixLineBytes-1)/immixLineBytes)
+			if ok {
+				*cursor = immixCursor{next: off, end: end, block: off / immixBlockBytes}
+				break
+			}
+			if len(h.pendingFree) == 0 {
+				off, err := h.growImmixBlocks(1)
+				if err != nil {
+					return handleEntry{}, err
+				}
+				m.regions[off/immixBlockBytes].kind = kind
+				*cursor = immixCursor{next: off, end: off + immixBlockBytes, block: off / immixBlockBytes}
+				break
+			}
+			if err := h.sweepOnePending(); err != nil {
+				return handleEntry{}, err
+			}
+		}
+	}
+	off := cursor.next
+	if err := m.record(off, charged); err != nil {
+		return handleEntry{}, err
+	}
+	cursor.next += charged
+	return handleEntry{off: off, size: size, class: uint16(len(throughputClassSizes)), space: sp}, nil
+}
+
+func (m *immixHeap) findEmptyBlocks(count uint32) (uint32, bool) {
+	run := uint32(0)
+	for b := uint32(0); b < uint32(len(m.regions)); b++ {
+		r := &m.regions[b]
+		if r.occupied != 0 || r.kind == immixLarge || m.excluded(b) {
+			run = 0
+			continue
+		}
+		run++
+		if run == count {
+			first := b + 1 - count
+			for i := range m.cursors {
+				if m.cursors[i].end != 0 && m.cursors[i].block >= first && m.cursors[i].block <= b {
+					m.cursors[i] = immixCursor{}
+				}
+			}
+			return first, true
+		}
+	}
+	return 0, false
+}
+func (h *throughputHeap) growImmixBlocks(count uint32) (uint32, error) {
+	bytes := uint64(count) * uint64(immixBlockBytes)
+	if count == 0 || bytes > uint64(^uint32(0)) {
+		return 0, ErrAllocationTooLarge
+	}
+	off, err := h.grow(uint32(bytes))
+	if err != nil {
+		return 0, err
+	}
+	if off%immixBlockBytes != 0 {
+		panic("gc: Immix region base is not block aligned")
+	}
+	m := h.immix
+	needed := len(m.regions) + int(count)
+	if needed > cap(m.regions) {
+		capacity := min(int(h.limit/immixBlockBytes), max(needed, cap(m.regions)+cap(m.regions)/2+1))
+		next := make([]immixRegion, needed, capacity)
+		copy(next, m.regions)
+		m.regions = next
+	} else {
+		m.regions = m.regions[:needed]
+		clear(m.regions[needed-int(count):])
+	}
+	return off, nil
+}
+
+func (h *throughputHeap) verifyImmix(handles []handleEntry, reserved []handleEntry) error {
+	m := h.immix
+	if len(m.regions) != int(h.bump/immixBlockBytes) || h.bump%immixBlockBytes != 0 || h.bump > uint32(len(h.mem)) || h.bump > h.limit {
+		return errors.New("gc: Immix region extent mismatch")
+	}
+	// Independent exact intervals catch overlap even within a shared live line.
+	owned := make([]throughputFreeSpan, 0)
+	counts := make([][immixLines]uint8, len(m.regions))
+	starts := make([][immixUnits / 64]uint64, len(m.regions))
+	add := func(off, size uint32) error {
+		if off%16 != 0 || size == 0 || uint64(off)+uint64(size) > uint64(h.bump) {
+			return errors.New("gc: Immix owned interval out of bounds")
+		}
+		for _, s := range owned {
+			if spansOverlap(s.off, s.size, off, size) {
+				return errors.New("gc: Immix object ownership overlap")
+			}
+		}
+		owned = append(owned, throughputFreeSpan{off, size})
+		b := off / immixBlockBytes
+		u := (off % immixBlockBytes) / 16
+		starts[b][u/64] |= uint64(1) << (u % 64)
+		end := uint64(off) + uint64(size)
+		for at := uint64(off); at < end; {
+			block := uint32(at / uint64(immixBlockBytes))
+			limit := min(end, uint64(block+1)*uint64(immixBlockBytes))
+			for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32((limit-1)%uint64(immixBlockBytes))/immixLineBytes; line++ {
+				counts[block][line]++
+			}
+			at = limit
+		}
+		return nil
+	}
+	for i, e := range handles {
+		if i != 0 && (e.space == spaceOld || e.space == spaceLarge) {
+			if err := add(e.off, Align16(e.size)); err != nil {
+				return fmt.Errorf("gc: Immix handle%d: %w", i, err)
+			}
+		}
+	}
+	for _, e := range reserved {
+		if err := add(e.off, Align16(e.size)); err != nil {
+			return err
+		}
+	}
+	for _, span := range h.pendingFree {
+		if err := add(span.off, span.size); err != nil {
+			return err
+		}
+	}
+	for i := range m.regions {
+		r := &m.regions[i]
+		if r.counts != counts[i] || r.starts != starts[i] {
+			return fmt.Errorf("gc: Immix region%d ownership metadata mismatch", i)
+		}
+		var occupied uint16
+		for line, count := range r.counts {
+			if count > 8 {
+				return errors.New("gc: Immix line overlap overflow")
+			}
+			used := r.used[line/64]&(uint64(1)<<uint(line%64)) != 0
+			if used != (count != 0) {
+				return errors.New("gc: Immix free-line bitmap mismatch")
+			}
+			if used {
+				occupied++
+			}
+		}
+		if r.occupied != occupied {
+			return errors.New("gc: Immix occupancy mismatch")
+		}
+	}
+	return nil
+}
+
+// Region cards are conservative locality/evacuation-cost hints. Exact object
+// cards remain the authoritative minor-collection inputs.
+func (m *immixHeap) noteCards(start, end uint32) {
+	if end < start || uint64(end) >= uint64(len(m.regions))*uint64(immixBlockBytes) {
+		panic("gc: Immix card exceeds its object region")
+	}
+	m.hasCards = true
+	for at := uint64(start); at <= uint64(end); {
+		block := uint32(at / uint64(immixBlockBytes))
+		last := min(uint64(end), uint64(block+1)*uint64(immixBlockBytes)-1)
+		r := &m.regions[block]
+		for line := uint32(at%uint64(immixBlockBytes)) / immixLineBytes; line <= uint32(last%uint64(immixBlockBytes))/immixLineBytes; line++ {
+			r.cards[line/64] |= uint64(1) << (line % 64)
+		}
+		at = last + 1
+	}
+}
+func (m *immixHeap) clearCards() {
+	if m.hasCards {
+		for i := range m.regions {
+			m.regions[i].cards = [immixLines / 64]uint64{}
+		}
+		m.hasCards = false
+	}
+}
+func (m *immixHeap) noteLargeAge(e handleEntry) {
+	first := e.off / immixBlockBytes
+	if int(first) >= len(m.regions) || m.regions[first].kind != immixLarge {
+		panic("gc: large object has no dedicated Immix region")
+	}
+	age := uint8(255)
+	if e.young() {
+		age = e.age()
+	}
+	for b := first; b < first+m.regions[first].blocks; b++ {
+		m.regions[b].generation = age
+	}
+}

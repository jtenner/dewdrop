+//go:build wagodebug
+
+package gc
+
+import (
+	"errors"
+	"fmt"
+	"slices"
+	"testing"
+)
+
+func TestImmixPromotionFailureRestoresRegionOwnership(t *testing.T) {
+	for _, point := range []failurePoint{failPromotionDestination, failPromotionCommit} {
+		for after := 0; after < 4; after++ {
+			t.Run(fmt.Sprintf("%d/%d", point, after), func(t *testing.T) {
+				c := newTestCollector(t, Config{Allocator: AllocatorImmix, NurseryBytes: 4096, DisableMovingNursery: true, ThroughputHeapBytes: 4 * immixBlockBytes, ThroughputPageBytes: 4096})
+				guard, err := c.NewStructDefault(0)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = c.ForcePromote(guard); err != nil {
+					t.Fatal(err)
+				}
+				roots := make([]Root, 4)
+				for i := range roots {
+					ref, err := c.NewStructDefault(0)
+					if err != nil {
+						t.Fatal(err)
+					}
+					roots[i] = Root(ref)
+				}
+				before := snapshotPromotionState(c)
+				regions := slices.Clone(c.throughput.immix.regions)
+				cursors := c.throughput.immix.cursors
+				cleanup := armFailure(c, point, after)
+				err = c.CollectMinor(stressRootSlots(roots))
+				cleanup()
+				if !errors.Is(err, errInjectedFailure) {
+					t.Fatalf("failure not visible: %v", err)
+				}
+				assertPromotionStateEqual(t, c, before)
+				if !slices.Equal(regions, c.throughput.immix.regions) || cursors != c.throughput.immix.cursors {
+					t.Fatal("failed promotion changed Immix ownership/cursors")
+				}
+				if err = c.Verify(stressRootSlots(roots)); err != nil {
+					t.Fatal(err)
+				}
+			})
+		}
+	}
+}
diff --git a/src/core/runtime/gc/native/immix_test.go b/src/core/runtime/gc/native/immix_test.go

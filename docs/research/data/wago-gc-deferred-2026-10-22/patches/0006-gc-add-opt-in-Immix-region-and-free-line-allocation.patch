@@ -0,0 +1,55 @@
+//go:build linux && amd64 && !tinygo && !wago_guardpage
+
+package wago
+
+import "testing"
+
+func TestGCImmixNativeReadsRootsAndArtifactReload(t *testing.T) {
+	compiled := gcReadRegionsCompiled(t)
+	loaded := publicArtifactRoundTrip(t, compiled)
+	defer loaded.Close()
+	for _, artifact := range []*Compiled{compiled, loaded} {
+		in, err := Instantiate(artifact, InstantiateOptions{GC: GCConfig{Allocator: GCAllocatorImmix, NurseryBytes: 256, SurvivorBytes: 128, ThroughputHeapBytes: 1 << 20, ThroughputPageBytes: 4096, CollectEveryAlloc: true, ForceMajorEveryMinor: true, VerifyAfterCollect: true}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i := 0; i < 3; i++ {
+			if _, err = in.Invoke("init"); err != nil {
+				t.Fatal(err)
+			}
+			if got, err := in.Invoke("loop", 8192); err != nil || len(got) != 1 || got[0] != 57344 {
+				t.Fatalf("loop: %v,%v", got, err)
+			}
+			if got, err := in.Invoke("roots"); err != nil || len(got) != 1 || got[0] != 1040 {
+				t.Fatalf("roots: %v,%v", got, err)
+			}
+			if err = in.CollectGC(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		in.Close()
+	}
+}
+func TestGCImmixNativeLargeAllocationReservations(t *testing.T) {
+	compiled, err := Compile(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3), gcNativeDynamicDefaultArrayModule(4))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer compiled.Close()
+	in, err := Instantiate(compiled, InstantiateOptions{GC: GCConfig{Allocator: GCAllocatorImmix, NurseryBytes: 1024, LargeObjectBytes: 1024, ThroughputHeapBytes: 1 << 20, ThroughputPageBytes: 4096, VerifyAfterCollect: true}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer in.Close()
+	for i := 0; i < 32; i++ {
+		if got, err := in.Invoke("run", 1024); err != nil || len(got) != 1 || got[0] != 1024 {
+			t.Fatalf("iteration%d: %v,%v", i, got, err)
+		}
+		if err = in.gc.Verify(nil); err != nil {
+			t.Fatal(err)
+		}
+		if err = in.CollectGC(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}

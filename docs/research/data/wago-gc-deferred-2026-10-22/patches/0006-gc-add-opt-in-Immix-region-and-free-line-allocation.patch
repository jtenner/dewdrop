+package gc
+
+import (
+	"encoding/binary"
+	"errors"
+	"math/rand"
+	"slices"
+	"testing"
+)
+
+func TestImmixProfileAdmission(t *testing.T) {
+	// Allocator kind 2 is the new opt-in region/line product. Keep this initial
+	// admission test independent of its private metadata representation.
+	for _, portable := range []bool{false, true} {
+		c, err := NewCollector(Config{Allocator: AllocatorImmix, ThroughputHeapBytes: 128 << 10, ThroughputPageBytes: 4096, DisableVirtualBacking: portable}, testTypes(t))
+		if err != nil {
+			t.Fatalf("Immix portable=%v: %v", portable, err)
+		}
+		c.Close()
+	}
+}
+
+func newImmixTestHeap(t *testing.T, limit uint32, portable bool) *throughputHeap {
+	t.Helper()
+	cfg, err := normalizeConfig(Config{Allocator: AllocatorImmix, ThroughputHeapBytes: limit, ThroughputPageBytes: 4096, DisableVirtualBacking: portable})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := new(throughputHeap)
+	if err = h.Init(cfg); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(h.Close)
+	return h
+}
+func TestImmixSharedLineCannotBeReusedUntilItsLastObjectDies(t *testing.T) {
+	h := newImmixTestHeap(t, immixBlockBytes, false)
+	live := make([]handleEntry, immixBlockBytes/16)
+	for i := range live {
+		var err error
+		live[i], err = h.alloc(8, spaceOld)
+		if err != nil {
+			t.Fatal(err)
+		}
+		binary.LittleEndian.PutUint64(h.mem[live[i].off:], uint64(i)+1)
+	}
+	for i := 1; i < 8; i++ {
+		if err := h.free(live[i]); err != nil {
+			t.Fatal(err)
+		}
+		live[i] = handleEntry{}
+	}
+	if _, err := h.alloc(8, spaceOld); !errors.Is(err, ErrHeapExhausted) {
+		t.Fatalf("partly live line reused: %v", err)
+	}
+	for i := 8; i < 16; i++ {
+		if err := h.deferFree(live[i]); err != nil {
+			t.Fatal(err)
+		}
+		live[i] = handleEntry{}
+	}
+	if len(h.pendingFree) != 8 {
+		t.Fatal("dead line was not deferred")
+	}
+	replacement, err := h.alloc(8, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if replacement.off != immixLineBytes || len(h.pendingFree) != 0 {
+		t.Fatalf("lazy free-line reuse: %+v pending%d", replacement, len(h.pendingFree))
+	}
+	binary.LittleEndian.PutUint64(h.mem[replacement.off:], 0xfeedbeef)
+	for i, e := range live {
+		if e.space != spaceFree && binary.LittleEndian.Uint64(h.mem[e.off:]) != uint64(i)+1 {
+			t.Fatalf("retained object%d changed", i)
+		}
+	}
+	if err = h.verify(append(append([]handleEntry{{}}, live...), replacement)); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestImmixEmptyBlockChangesClassWithoutRetainingOldCursor(t *testing.T) {
+	h := newImmixTestHeap(t, 2*immixBlockBytes, false)
+	old, err := h.alloc(8, spaceOld, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = h.free(old); err != nil {
+		t.Fatal(err)
+	}
+	scalar, err := h.alloc(8, spaceOld, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	refs, err := h.alloc(8, spaceOld, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if scalar.off/immixBlockBytes == refs.off/immixBlockBytes {
+		t.Fatal("old cursor entered a block claimed by the other class")
+	}
+	if err = h.verify([]handleEntry{{}, scalar, refs}); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestImmixLargeRegionsCanBeReusedIndependently(t *testing.T) {
+	h := newImmixTestHeap(t, 4*immixBlockBytes, false)
+	large, err := h.alloc(70000, spaceLarge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h.bump != 3*immixBlockBytes || h.immix.regions[0].blocks != 3 {
+		t.Fatal("large object did not get dedicated blocks")
+	}
+	guard, err := h.alloc(8, spaceOld)
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary.LittleEndian.PutUint64(h.mem[guard.off:], 42)
+	if err = h.free(large); err != nil {
+		t.Fatal(err)
+	}
+	next, err := h.alloc(40000, spaceLarge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if next.off != large.off || h.bump != 4*immixBlockBytes || binary.LittleEndian.Uint64(h.mem[guard.off:]) != 42 {
+		t.Fatal("dedicated-region reuse changed a retained object or grew backing")
+	}
+	if err = h.verify([]handleEntry{{}, guard, next}); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestImmixAllocationTransactionRestoresCursorsAndOwnership(t *testing.T) {
+	h := newImmixTestHeap(t, 4*immixBlockBytes, false)
+	guard, err := h.alloc(8, spaceOld, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := slices.Clone(h.immix.regions)
+	tx := h.beginAllocTransaction()
+	var entries []handleEntry
+	for _, size := range []uint32{8, 64, 32768} {
+		e, err := h.alloc(size, spaceOld, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		entries = append(entries, e)
+	}
+	for i := len(entries) - 1; i >= 0; i-- {
+		h.rollbackSuccessfulAlloc(entries[i], tx.bump)
+	}
+	h.restoreAllocTransaction(tx)
+	if !slices.Equal(h.immix.regions, before) || h.immix.cursors != tx.immixCursors || h.bump != tx.bump {
+		t.Fatal("rollback retained destination ownership or changed a cursor")
+	}
+	if err = h.verify([]handleEntry{{}, guard}); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestImmixRandomizedAllocationPreservesRetainedBytes(t *testing.T) {
+	for _, portable := range []bool{false, true} {
+		t.Run(map[bool]string{false: "mapped", true: "portable"}[portable], func(t *testing.T) {
+			h := newImmixTestHeap(t, 4<<20, portable)
+			random := rand.New(rand.NewSource(313))
+			var live []handleEntry
+			var values []uint64
+			for step := 0; step < 5000; step++ {
+				if len(live) > 0 && (len(live) >= 96 || random.Intn(2) == 0) {
+					i := random.Intn(len(live))
+					if err := h.free(live[i]); err != nil {
+						t.Fatal(err)
+					}
+					live = append(live[:i], live[i+1:]...)
+					values = append(values[:i], values[i+1:]...)
+				} else {
+					size := uint32(8 + random.Intn(2048))
+					space := spaceOld
+					if random.Intn(10) == 0 {
+						space = spaceLarge
+						size = uint32(32768 + random.Intn(32768))
+					}
+					e, err := h.alloc(size, space, random.Intn(2) == 0)
+					if err != nil {
+						t.Fatalf("step%d live%d: %v", step, len(live), err)
+					}
+					value := uint64(step) + 1
+					binary.LittleEndian.PutUint64(h.mem[e.off:], value)
+					live = append(live, e)
+					values = append(values, value)
+				}
+				for i, e := range live {
+					if binary.LittleEndian.Uint64(h.mem[e.off:]) != values[i] {
+						t.Fatalf("step%d object%d aliases another allocation", step, i)
+					}
+				}
+				if step%50 == 0 {
+					if err := h.verify(append([]handleEntry{{}}, live...)); err != nil {
+						t.Fatalf("step%d: %v", step, err)
+					}
+				}
+			}
+		})
+	}
+}
+func TestImmixCollectorCyclesAndStableReferences(t *testing.T) {
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+	if err != nil {
+		t.Fatal(err)
+	}
+	array, err := NewArrayDesc(1, StorageI32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 64 << 10, ThroughputHeapBytes: 128 << 10, ThroughputPageBytes: 4096, LargeObjectBytes: 1024, VerifyAfterCollect: true}, []TypeDesc{node, array})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	root := Null()
+	for i := 0; i < 400; i++ {
+		next, err := c.NewStructWithRoots(0, []Value{RefValue(root), I32Value(int32(i))}, RefSliceRoots{root})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = c.ForcePromote(next); err != nil {
+			t.Fatal(err)
+		}
+		root = next
+	}
+	large, err := c.NewArrayWithRoots(1, 1000, I32Value(42), RefSliceRoots{root})
+	if err != nil {
+		t.Fatal(err)
+	}
+	oldOffset := c.entry(large).off
+	for i := 0; i < 2; i++ {
+		if err = c.CollectMinor(RefSliceRoots{root, large}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if c.entry(large).off != oldOffset || c.entry(large).young() {
+		t.Fatal("large survivor was not aged in place")
+	}
+	if err = c.CollectFull(RefSliceRoots{root, large}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 399; i >= 0; i-- {
+		value, err := c.StructGet(root, 1)
+		if err != nil || value.I32() != int32(i) {
+			t.Fatalf("chain%d: %+v %v", i, value, err)
+		}
+		child, err := c.StructGet(root, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		root = child.Ref
+	}
+	if !root.IsNull() {
+		t.Fatal("stable chain ended at the wrong reference")
+	}
+	if err = c.CollectFull(RefSliceRoots{large}); err != nil {
+		t.Fatal(err)
+	}
+	if got := c.Stats().LiveObjects; got != 1 {
+		t.Fatalf("reclaimed graph retains%d objects", got)
+	}
+	if err = c.Verify(RefSliceRoots{large}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestImmixUnusedNativeLargeReservationHasExplicitOwnership(t *testing.T) {
+	array, err := NewArrayDesc(0, StorageI32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, NurseryBytes: 1024, LargeObjectBytes: 1024, ThroughputHeapBytes: 4 * immixBlockBytes, ThroughputPageBytes: 4096}, []TypeDesc{array})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if !c.PrepareNativeArrayAllocationImmediate(4104) {
+		t.Fatal("large native reservation rejected")
+	}
+	if err = c.Verify(EmptyRoots{}); err != nil {
+		t.Fatalf("unpublished reservation lost ownership: %v", err)
+	}

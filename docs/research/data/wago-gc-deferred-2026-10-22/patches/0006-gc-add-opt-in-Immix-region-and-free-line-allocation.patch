+func TestImmixLineMarkEpochWrapAndBoundedMetadata(t *testing.T) {
+	node, err := NewStructDesc(0, []StorageKind{StorageRefNull, StorageI32})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c, err := NewCollector(Config{Allocator: AllocatorImmix, ThroughputHeapBytes: 2 * immixBlockBytes, ThroughputPageBytes: 4096}, []TypeDesc{node})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	ref, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = c.ForcePromote(ref); err != nil {
+		t.Fatal(err)
+	}
+	for _, epoch := range []uint32{c.throughput.immix.epoch, ^uint32(0)} {
+		c.throughput.immix.epoch = epoch
+		if err = c.CollectFull(RefSliceRoots{ref}); err != nil {
+			t.Fatal(err)
+		}
+		stats := c.ImmixStats()
+		if stats.LiveBytes != uint64(c.entry(ref).size) || stats.LiveLines != 1 {
+			t.Fatalf("marked region telemetry: %+v", stats)
+		}
+		if stats.MetadataBytes > uint64(c.throughput.limit/immixBlockBytes)*640 {
+			t.Fatalf("metadata exceeds region bound: %+v", stats)
+		}
+	}
+	if c.throughput.immix.epoch != 1 {
+		t.Fatal("mark epoch did not wrap safely")
+	}
+	if err = c.CollectFull(EmptyRoots{}); err != nil {
+		t.Fatal(err)
+	}
+	if stats := c.ImmixStats(); stats.LiveLines != 0 || stats.LiveBytes != 0 {
+		t.Fatalf("stale mark survived epoch: %+v", stats)
+	}
+}

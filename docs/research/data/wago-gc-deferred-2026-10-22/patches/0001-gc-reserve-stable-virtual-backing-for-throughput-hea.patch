index 000000000..a45a3094c
--- /dev/null
+++ b/src/core/runtime/gc/native/stable_backing_test.go
@@ -0,0 +1,126 @@
+package gc
+
+import (
+	"github.com/wago-org/wago/internal/virtualmem"
+	"testing"
+	"unsafe"
+)
+
+func TestStableBackingGrowth(t *testing.T) {
+	if !virtualmem.Supported {
+		t.Skip("no virtual reservation support")
+	}
+	c, err := NewCollector(Config{ThroughputHeapBytes: 2 << 20, ThroughputPageBytes: 4096, DisableCollection: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if c.backing == nil || c.throughput.reservation == nil {
+		t.Fatal("throughput backing is not reserved")
+	}
+	base := sliceData(c.handles)
+	for i := 0; i < 1024; i++ {
+		c.newHandle(handleEntry{})
+	}
+	if sliceData(c.handles) != base {
+		t.Fatal("handle table moved")
+	}
+	var first handleEntry
+	for i := 0; i < 32; i++ {
+		e, err := c.throughput.alloc(4096, spaceLarge)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if i == 0 {
+			first = e
+			c.throughput.bytes(e)[0] = 89
+		}
+	}
+	oldBase := uintptr(unsafe.Pointer(&c.throughput.mem[0]))
+	if _, err := c.throughput.alloc(128<<10, spaceLarge); err != nil {
+		t.Fatal(err)
+	}
+	if uintptr(unsafe.Pointer(&c.throughput.mem[0])) != oldBase {
+		t.Fatal("old space moved")
+	}
+	if c.throughput.bytes(first)[0] != 89 {
+		t.Fatal("growth lost data")
+	}
+	if c.MemoryStats().BackingCopyBytes != 0 {
+		t.Fatal("stable growth copied backing")
+	}
+	v := c.NativeView()
+	c.Close()
+	if v.Handles != 0 || v.HandleCount != 0 || v.Spaces[NativeSpaceOld].Base != 0 {
+		t.Fatal("closed native view retains mappings")
+	}
+}
+
+func TestPortableBackingGrowth(t *testing.T) {
+	c, err := NewCollector(Config{DisableVirtualBacking: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if c.backing != nil || c.throughput.reservation != nil {
+		t.Fatal("portable backing reserved address space")
+	}
+	for i := 0; i < 1024; i++ {
+		c.newHandle(handleEntry{})
+	}
+	if c.NativeView().HandleStride != NativeHandleStride {
+		t.Fatal("portable handle ABI changed")
+	}
+}
+
+func TestBoundedHandleExhaustionPreservesObject(t *testing.T) {
+	if !virtualmem.Supported {
+		t.Skip("no virtual reservation support")
+	}
+	c := newTestCollector(t, Config{})
+	r, err := c.NewStructDefault(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.StructSet(r, 0, I32Value(42)); err != nil {
+		t.Fatal(err)
+	}
+	// Exhaust committed identity capacity without exhausting object storage.
+	c.backing.handleLimit = uint64(len(c.handles))
+	c.handles = c.handles[:len(c.handles):len(c.handles)]
+	if _, err := c.NewStructDefault(0); err == nil {
+		t.Fatal("bounded identity exhaustion succeeded")
+	}
+	if got, err := c.StructGet(r, 0); err != nil || got.Bits != 42 {
+		t.Fatalf("live value lost after exhaustion: %+v %v", got, err)
+	}
+}
+
+func BenchmarkBackingGrowth(b *testing.B) {
+	for _, portable := range []bool{false, true} {
+		name := "stable"
+		if portable {
+			name = "portable"
+		}
+		b.Run(name, func(b *testing.B) {
+			b.ReportAllocs()
+			var copied uint64
+			for i := 0; i < b.N; i++ {
+				var h throughputHeap
+				if err := h.Init(Config{ThroughputHeapBytes: 2 << 20, ThroughputPageBytes: 4096, ThroughputClassLimit: 4096, DisableVirtualBacking: portable}); err != nil {
+					b.Fatal(err)
+				}
+				for j := 0; j < 256; j++ {
+					e, err := h.alloc(4096, spaceLarge)
+					if err != nil {
+						b.Fatal(err)
+					}
+					h.bytes(e)[0] = byte(j)
+				}
+				copied += h.backingCopyBytes
+				h.Close()
+			}
+			b.ReportMetric(float64(copied)/float64(b.N), "copied-B/op")
+		})
+	}
+}

diff --git a/src/core/runtime/gc/native/stable_backing.go b/src/core/runtime/gc/native/stable_backing.go
new file mode 100644
index 000000000..cb39e35b9
--- /dev/null
+++ b/src/core/runtime/gc/native/stable_backing.go
@@ -0,0 +1,123 @@
+package gc
+
+import (
+	"fmt"
+	"unsafe"
+
+	"github.com/wago-org/wago/internal/virtualmem"
+)
+
+type collectorBacking struct {
+	nursery, handles *virtualmem.Region
+	handleLimit      uint64
+}
+
+func (b *collectorBacking) close() {
+	for _, r := range []*virtualmem.Region{b.nursery, b.handles} {
+		if err := r.Close(); err != nil {
+			panic("gc: close backing: " + err.Error())
+		}
+	}
+}
+
+func initialNurseryBacking(cfg Config, size, alignment uint32) []byte {
+	if !cfg.DisableVirtualBacking && virtualmem.Supported {
+		return nil
+	}
+	return makeAlignedBytes(size, uintptr(alignment))
+}
+
+func (c *Collector) initStableBacking(initialBytes uint32) error {
+	if c.cfg.DisableVirtualBacking || !virtualmem.Supported {
+		return nil
+	}
+	b := &collectorBacking{}
+	var err error
+	defer func() {
+		if err != nil {
+			b.close()
+		}
+	}()
+	nurseryLimit := uint64(initialBytes)
+	if c.nurseryGrowthLimit != 0 {
+		nurseryLimit = uint64(c.nurseryGrowthLimit) + 2*uint64(min(c.nurseryGrowthLimit/2, uint32(512<<10)))
+	}
+	b.nursery, err = virtualmem.Reserve(nurseryLimit)
+	if err != nil {
+		return fmt.Errorf("gc: reserve nursery: %w", err)
+	}
+	err = b.nursery.Commit(0, uint64(initialBytes))
+	if err != nil {
+		return fmt.Errorf("gc: commit nursery: %w", err)
+	}
+	// Minimum logical object size is eight bytes after compact headers. Include
+	// native reservations and the invalid identity; free identities are reused.
+	b.handleLimit = 1 + (uint64(c.cfg.ThroughputHeapBytes)+nurseryLimit)/8 + 2*nativeStructHandleBatch
+	if b.handleLimit > 1<<31 {
+		b.handleLimit = 1 << 31
+	}
+	b.handles, err = virtualmem.Reserve(b.handleLimit * NativeHandleStride)
+	if err != nil {
+		return fmt.Errorf("gc: reserve handles: %w", err)
+	}
+	err = b.handles.Commit(0, NativeHandleStride)
+	if err != nil {
+		return fmt.Errorf("gc: commit handles: %w", err)
+	}
+	c.backing = b
+	c.nursery = b.nursery.Bytes(uint64(initialBytes))
+	c.handles = unsafe.Slice((*handleEntry)(unsafe.Pointer(&b.handles.Bytes(NativeHandleStride)[0])), 1)
+	return nil
+}
+
+// ensureHandleCapacity runs before allocating object bytes or publishing a
+// native reservation. A commit failure is returned without losing live state.
+func (c *Collector) ensureHandleCapacity(extra int) error {
+	if c.backing == nil || extra <= cap(c.handles)-len(c.handles) {
+		return nil
+	}
+	need := uint64(len(c.handles)) + uint64(extra)
+	if need > c.backing.handleLimit {
+		return fmt.Errorf("gc: bounded handle table exhausted (%d entries)", need)
+	}
+	bytes := need * NativeHandleStride
+	if err := c.backing.handles.Commit(uint64(cap(c.handles))*NativeHandleStride, bytes-uint64(cap(c.handles))*NativeHandleStride); err != nil {
+		return fmt.Errorf("gc: commit handles: %w", err)
+	}
+	capacity := min(c.backing.handles.CommittedBytes()/NativeHandleStride, c.backing.handleLimit)
+	all := c.backing.handles.Bytes(capacity * NativeHandleStride)
+	c.handles = unsafe.Slice((*handleEntry)(unsafe.Pointer(&all[0])), int(capacity))[:len(c.handles)]
+	return nil
+}
+
+// MemoryStats separates reserved virtual address bytes from committed pages.
+// OS RSS and commit charge require platform measurements; these are not RSS.
+type MemoryStats struct {
+	ReservedBytes, CommittedBytes, BackingCopyBytes uint64
+}
+
+func (c *Collector) MemoryStats() MemoryStats {
+	s := MemoryStats{BackingCopyBytes: c.throughput.backingCopyBytes}
+	if c.backing != nil {
+		for _, r := range []*virtualmem.Region{c.backing.nursery, c.backing.handles, c.throughput.reservation} {
+			if r != nil {
+				s.ReservedBytes += r.ReservedBytes()
+				s.CommittedBytes += r.CommittedBytes()
+			}
+		}
+	}
+	return s
+}
+
+func (c *Collector) preflightHandleCapacity(batch int) error {
+	reused := min(batch, len(c.freeHandles))
+	if c.checkedHandles != nil {
+		reused = 0
+		for i := len(c.freeHandles) - 1; i >= 0 && reused < batch; i-- {
+			if (*c.checkedHandles)[c.freeHandles[i]] != ^uint64(0) {
+				reused++
+			}
+		}
+	}
+	return c.ensureHandleCapacity(batch - reused)
+}

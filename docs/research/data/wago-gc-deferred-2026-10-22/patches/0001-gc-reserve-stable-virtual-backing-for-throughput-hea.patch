diff --git a/internal/virtualmem/region_test.go b/internal/virtualmem/region_test.go
new file mode 100644
index 000000000..afc9ce69f
--- /dev/null
+++ b/internal/virtualmem/region_test.go
@@ -0,0 +1,81 @@
+package virtualmem
+
+import (
+	"testing"
+	"unsafe"
+)
+
+func TestRegionGrowthDiscardAndClose(t *testing.T) {
+	if !Supported {
+		t.Skip("virtual reservations are not supported by this build")
+	}
+	r, err := Reserve(8 * PageSize())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	if err := r.Commit(0, PageSize()); err != nil {
+		t.Fatal(err)
+	}
+	b := r.Bytes(PageSize())
+	base := unsafe.Pointer(&b[0])
+	b[0] = 91
+	if err := r.Commit(PageSize(), 2*PageSize()); err != nil {
+		t.Fatal(err)
+	}
+	if got := unsafe.Pointer(&r.Bytes(3 * PageSize())[0]); got != base {
+		t.Fatal("reservation moved")
+	}
+	if b[0] != 91 {
+		t.Fatal("growth lost existing bytes")
+	}
+	if err := r.Commit(8*PageSize(), 1); err == nil {
+		t.Fatal("commit past reservation succeeded")
+	}
+	if err := r.Discard(0, PageSize()); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Commit(0, PageSize()); err != nil {
+		t.Fatal(err)
+	}
+	if b[0] != 0 {
+		t.Fatal("discarded page did not return zero")
+	}
+	if r.CommittedBytes() != 3*PageSize() {
+		t.Fatalf("committed bytes = %d", r.CommittedBytes())
+	}
+	if err := r.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := r.Commit(0, 1); err == nil {
+		t.Fatal("commit after close succeeded")
+	}
+}
+
+func TestRegionRejectsInvalidBounds(t *testing.T) {
+	if _, err := Reserve(0); err == nil {
+		t.Fatal("zero reservation succeeded")
+	}
+	if _, err := Reserve(^uint64(0)); err == nil {
+		t.Fatal("overflow reservation succeeded")
+	}
+	if !Supported {
+		return
+	}
+	r, err := Reserve(PageSize())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	for _, off := range []uint64{PageSize() + 1, ^uint64(0)} {
+		if err := r.Commit(off, 1); err == nil {
+			t.Fatalf("commit at %d succeeded", off)
+		}
+	}
+	if err := r.Discard(1, 1); err == nil {
+		t.Fatal("unaligned discard succeeded")
+	}
+}
diff --git a/internal/virtualmem/region_unix.go b/internal/virtualmem/region_unix.go
new file mode 100644
index 000000000..5a422e662
--- /dev/null
+++ b/internal/virtualmem/region_unix.go
@@ -0,0 +1,27 @@
+//go:build (linux || darwin) && (amd64 || arm64) && !tinygo
+
+package virtualmem
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+const Supported = true
+
+func reserve(n int) ([]byte, error) {
+	return syscall.Mmap(-1, 0, n, syscall.PROT_NONE, syscall.MAP_ANON|syscall.MAP_PRIVATE)
+}
+func commit(b []byte) error { return syscall.Mprotect(b, syscall.PROT_READ|syscall.PROT_WRITE) }
+func discard(b []byte) error {
+	// Replace only unused pages with a fresh anonymous PROT_NONE mapping. Unlike
+	// Darwin MADV_FREE this guarantees zero fill on the next commit, and releases
+	// physical pages while preserving the original owner and virtual interval.
+	_, _, errno := syscall.Syscall6(syscall.SYS_MMAP, uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)),
+		syscall.PROT_NONE, syscall.MAP_ANON|syscall.MAP_PRIVATE|syscall.MAP_FIXED, ^uintptr(0), 0)
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+func release(b []byte) error { return syscall.Munmap(b) }
diff --git a/internal/virtualmem/region_windows.go b/internal/virtualmem/region_windows.go
new file mode 100644
index 000000000..45ee41a2f
--- /dev/null
+++ b/internal/virtualmem/region_windows.go
@@ -0,0 +1,46 @@
+//go:build windows && (amd64 || arm64) && !tinygo
+
+package virtualmem
+
+import (
+	"fmt"
+	"syscall"
+	"unsafe"
+)
+
+const Supported = true
+
+var kernel32 = syscall.NewLazyDLL("kernel32.dll")
+var virtualAlloc = kernel32.NewProc("VirtualAlloc")
+var virtualFree = kernel32.NewProc("VirtualFree")
+
+//go:nocheckptr
+func mappedPointer(p uintptr) unsafe.Pointer { return unsafe.Pointer(p) }
+func reserve(n int) ([]byte, error) {
+	p, _, e := virtualAlloc.Call(0, uintptr(n), 0x2000, 0x01)
+	if p == 0 {
+		return nil, fmt.Errorf("virtual memory reserve: %w", e)
+	}
+	return unsafe.Slice((*byte)(mappedPointer(p)), n), nil
+}
+func commit(b []byte) error {
+	p, _, e := virtualAlloc.Call(uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)), 0x1000, 0x04)
+	if p == 0 {
+		return fmt.Errorf("virtual memory commit: %w", e)
+	}
+	return nil
+}
+func discard(b []byte) error {
+	ok, _, e := virtualFree.Call(uintptr(unsafe.Pointer(&b[0])), uintptr(len(b)), 0x4000)
+	if ok == 0 {
+		return fmt.Errorf("virtual memory decommit: %w", e)
+	}
+	return nil
+}
+func release(b []byte) error {
+	ok, _, e := virtualFree.Call(uintptr(unsafe.Pointer(&b[0])), 0, 0x8000)
+	if ok == 0 {
+		return fmt.Errorf("virtual memory release: %w", e)
+	}
+	return nil
+}

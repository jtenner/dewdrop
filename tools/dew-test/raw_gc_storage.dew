open dew.std.wasm.intrinsics
open dew.std.string
open dew.std.string_builder
open dew.std.bytes_builder
open dew.std.bytes

struct RawTextStorage {
  chunks: WasmArray<V128>
  start: U32
  length: U32
}

struct RawBuilderStorage {
  mut chunks: WasmArray<V128>
  mut length: U32
  mut consumed: U32
}

builtin raw_text_storage(value: Bytes) -> RawTextStorage = "ref.cast"
builtin raw_text_bytes(value: RawTextStorage) -> Bytes = "ref.cast"
builtin raw_builder_storage(value: BytesBuilder) -> RawBuilderStorage = "ref.cast"
builtin raw_storage_builder(value: RawBuilderStorage) -> BytesBuilder = "ref.cast"

fn raw_text_storage_caster() -> fn(Bytes) -> RawTextStorage {
  raw_text_storage
}

fn raw_storage_a_chunks() -> WasmArray<V128> {
  wasm_array_new(1u32, unsafe_bitcast::<U8x16, V128>(wasm_u8x16_splat(65u8)))
}

struct RawBacking<t> {
  mut storage: WasmArray<t>
}

struct RawCell {
  value: I64
}

builtin raw_cell_value(value: RawCell) -> I64 = "struct.get 0"
builtin raw_bytes_length(value: Bytes) -> U32 = "struct.get 2"
builtin raw_string_length(value: String) -> U32 = "struct.get 2"
builtin raw_bytes_as_string(value: Bytes) -> String = "ref.cast"
builtin raw_string_as_bytes(value: String) -> Bytes = "ref.cast"
builtin raw_cell_cast(value: RawCell) -> RawCell = "ref.cast"
builtin raw_bytes_as_cell(value: Bytes) -> RawCell = "ref.cast"
builtin raw_builder_as_bytes(value: StringBuilder) -> BytesBuilder = "ref.cast"

fn raw_builder_caster() -> fn(StringBuilder) -> BytesBuilder {
  raw_builder_as_bytes
}

struct RawCastLog {
  mut count: U32
}

fn raw_cast_input(log: RawCastLog) -> Bytes {
  log.count = log.count + 1u32
  b"\xce\xbb\xf0\x9f\x98\x80"
}

fn raw_cast_stop() -> Never {
  unreachable()
}

fn raw_bytes_caster() -> fn(Bytes) -> String {
  raw_bytes_as_string
}

fn raw_cell_reader() -> fn(RawCell) -> I64 {
  raw_cell_value
}

fn raw_bytes_reader() -> fn(Bytes) -> U32 {
  raw_bytes_length
}

fn raw_backing<t>(value: t) -> RawBacking<t> {
  RawBacking::{
    storage: wasm_array_new(1u32, value)
  }
}

fn raw_backing_read<t>(value: RawBacking<t>) -> t {
  wasm_array_get(value.storage, 0u32)
}

fn raw_backing_array<t>(value: RawBacking<t>) -> WasmArray<t> {
  value.storage
}

pub fn main(case: U32) -> I32 {
  if case == 0u32 {
    let backing = raw_backing(41i32)
    wasm_array_set(backing.storage, 0u32, 42i32)
    if raw_backing_read(backing) == 42i32 {
      1i32
    } else {
      0i32
    }
  } else if case == 1u32 {
    let backing = raw_backing(4294967297i64)
    wasm_array_set(backing.storage, 0u32, 4294967298i64)
    if raw_backing_read(backing) == 4294967298i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 2u32 {
    let backing = raw_backing(RawCell::{
      value: 42i64
    })
    if raw_backing_read(backing).value == 42i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 3u32 {
    let backing = raw_backing(4294967297i64)
    if wasm_array_get(raw_backing_array(backing), 0u32) == 4294967297i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 4u32 {
    let backing = raw_backing(1.5f32)
    if raw_backing_read(backing) == 1.5f32 {
      1i32
    } else {
      0i32
    }
  } else if case == 5u32 {
    let backing = raw_backing(1.5f64)
    if raw_backing_read(backing) == 1.5f64 {
      1i32
    } else {
      0i32
    }
  } else if case == 6u32 {
    let backing = raw_backing(1i64)
    backing.storage = wasm_array_new(2u32, 4294967297i64)
    if wasm_array_len(backing.storage) == 2u32 && raw_backing_read(backing) == 4294967297i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 7u32 {
    if raw_cell_value(RawCell::{
      value: 4294967297i64
    }) == 4294967297i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 8u32 {
    if raw_bytes_length(b"hello") == 5u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 9u32 {
    let read = raw_cell_reader()
    if read(RawCell::{
      value: 4294967297i64
    }) == 4294967297i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 10u32 {
    let read = raw_bytes_reader()
    if read(b"hello") == 5u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 11u32 {
    let text = raw_bytes_as_string(b"\xce\xbb\xf0\x9f\x98\x80")
    if raw_string_length(text) == 6u32 && raw_bytes_length(raw_string_as_bytes(text)) == 6u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 12u32 {
    let cast = raw_bytes_caster()
    if raw_string_length(cast(b"\xce\xbb\xf0\x9f\x98\x80")) == 6u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 13u32 {
    if raw_cell_value(raw_cell_cast(RawCell::{
      value: 4294967297i64
    })) == 4294967297i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 14u32 {
    if raw_cell_value(raw_bytes_as_cell(b"")) == 0i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 15u32 {
    let log = RawCastLog::{
      count: 0u32
    }
    let text = raw_bytes_as_string(raw_cast_input(log))
    if log.count == 1u32 && raw_string_length(text) == 6u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 16u32 {
    if raw_string_length(raw_bytes_as_string(raw_cast_stop())) == 0u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 17u32 {
    if raw_string_length(raw_bytes_as_string(b"")) == 0u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 18u32 {
    let builder = StringBuilder::new()
    let bytes = raw_builder_as_bytes(builder)
    bytes.append_byte(65u8)
    bytes.append(b"B")
    if builder.byte_length() == 2u32 && builder.finish() == "AB" {
      1i32
    } else {
      0i32
    }
  } else if case == 19u32 {
    let builder = StringBuilder::new()
    let bytes = raw_builder_as_bytes(builder)
    bytes.append_byte(65u8)
    let _ = bytes.finish()
    if builder.byte_length() == 1u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 20u32 {
    let builder = StringBuilder::with_capacity(0u32)
    let cast = raw_builder_caster()
    let bytes = cast(builder)
    bytes.append(b"\xce\xbb\xf0\x9f\x98\x80")
    if builder.byte_length() == 6u32 && builder.finish() == "λ😀" {
      1i32
    } else {
      0i32
    }
  } else if case == 21u32 {
    let storage = raw_text_storage(b"0123456789abcdefgh")
    if storage.start == 0u32 && storage.length == 18u32 && wasm_array_len(storage.chunks) == 2u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 22u32 {
    let storage = RawTextStorage::{
      chunks: raw_storage_a_chunks()
      start: 2u32
      length: 3u32
    }
    if raw_text_bytes(storage) == b"AAA" {
      1i32
    } else {
      0i32
    }
  } else if case == 23u32 {
    let builder = BytesBuilder::with_capacity(1u32)
    let storage = raw_builder_storage(builder)
    wasm_array_set(storage.chunks, 0u32, unsafe_bitcast::<U8x16, V128>(wasm_u8x16_splat(65u8)))
    storage.length = 1u32
    let bytes = builder.finish()
    if bytes == b"A" && storage.consumed == 1u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 24u32 {
    let storage = RawBuilderStorage::{
      chunks: raw_storage_a_chunks()
      length: 3u32
      consumed: 0u32
    }
    let builder = raw_storage_builder(storage)
    builder.append_byte(66u8)
    let bytes = builder.finish()
    if bytes == b"AAAB" && storage.length == 4u32 && storage.consumed == 1u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 25u32 {
    let storage = raw_text_storage_caster()(b"!abcdef?".view(1u32, 6u32).view(2u32, 3u32))
    if storage.start == 3u32 && storage.length == 3u32 && raw_text_bytes(storage) == b"cde" {
      1i32
    } else {
      0i32
    }
  } else if case == 26u32 {
    let builder = BytesBuilder::new()
    let storage = raw_builder_storage(builder)
    storage.chunks = raw_storage_a_chunks()
    storage.length = 1u32
    if builder.finish() == b"A" {
      1i32
    } else {
      0i32
    }
  } else {
    0i32
  }
}

open dew.std.preamble
open dew.std.array
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.option
open dew.std.string
open dew.std.text_runtime
open dew.std.wasm.intrinsics

fn bytes_result(value: Bool) -> I32 {
  if value {
    1i32
  } else {
    0i32
  }
}

pub fn main(case: U32) -> I32 {
  if case == 0u32 {
    bytes_result(b"".equals(b"") && !b"a".equals(b"") && b"abc".starts_with(b"") && b"abc".ends_with(b"") && !b"a".starts_with(b"ab") && !b"a".ends_with(b"ba") && b"abc".find(b"") is Option::Some(0u32) && b"".find(b"a") is Option::None)
  } else if case == 1u32 {
    let value = b"--0123456789abcdef0123456789abcdef0123456789abcdef--".view(2u32, 48u32)
    let equal = b"!0123456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 48u32)
    bytes_result(value.equals(equal) && value.starts_with(b"0123456789abcdef012") && value.ends_with(b"def0123456789abcdef") && !value.equals(b"0123456789abcdef0123456789abcdef0123456789abcdeg") && !value.starts_with(b"0123456789abcdeg") && !value.ends_with(b"ef?"))
  } else if case == 2u32 {
    let value = b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabaaaab"
    bytes_result(value.find(b"ab") is Option::Some(32u32) && value.find(b"aaaab") is Option::Some(29u32) && value.find(b"ac") is Option::None && value.find_byte(98u8) is Option::Some(33u32) && b"x\x00\xff".find_byte(0u8) is Option::Some(1u32) && b"x\x00\xff".find_byte(255u8) is Option::Some(2u32))
  } else if case == 3u32 {
    let value = b"!0123456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 48u32)
    bytes_result(value.find(b"456789abcdef0123456789abcdef0123456789abcdef") is Option::Some(4u32) && value.find(b"456789abcdef0123456789abcdef0123456789abcdeg") is Option::None && value.find(b"0123456789abcdef0123456789abcdef0123456789abcdef") is Option::Some(0u32))
  } else if case == 4u32 {
    bytes_result(b"".hash() == 14695981039346656037u64 && b"a".hash() == 12638187200555641996u64 && b"hello".hash() == 11831194018420276491u64 && b"!hello?".view(1u32, 5u32).hash() == b"hello".hash())
  } else if case == 5u32 {
    let valid = [b"", b"ascii", b"\xc2\x80", b"\xdf\xbf", b"\xe0\xa0\x80", b"\xed\x9f\xbf", b"\xef\xbf\xbf", b"\xf0\x90\x80\x80", b"\xf4\x8f\xbf\xbf"]
    for value in valid {
      if !value.is_valid_utf8() {
        return 0i32
      }
    }
    1i32
  } else if case == 6u32 {
    let invalid = [b"\x80", b"\xbf", b"\xc0\x80", b"\xc1\xbf", b"\xc2", b"\xc2A", b"\xe0\x9f\xbf", b"\xe1", b"\xe1\x80", b"\xed\xa0\x80", b"\xf0\x8f\xbf\xbf", b"\xf1", b"\xf1\x80", b"\xf1\x80\x80", b"\xf4\x90\x80\x80", b"\xf5\x80\x80\x80", b"\xff"]
    for value in invalid {
      if value.is_valid_utf8() {
        return 0i32
      }
    }
    1i32
  } else if case == 7u32 {
    let value = b"!0123456789abcdef0123456789abcdef\xf0\x90\x80\x80?"
    bytes_result(value.view(1u32, 36u32).is_valid_utf8() && !value.view(1u32, 35u32).is_valid_utf8() && !value.view(34u32, 3u32).is_valid_utf8())
  } else if case == 8u32 {
    let builder = BytesBuilder::new()
    while 0u32 {
      index if index < 257u32 => {
        builder.append_byte((index % 251u32).into())
        continue index + 1u32
      }
      _ => break ()
    }
    let value = builder.finish()
    while 0u32 {
      offset if offset < 32u32 => {
        let view = value.view(offset, 65u32)
        if !view.equals(value.slice(offset, offset + 65u32)) || view.find(view.view(31u32, 17u32)) is Option::None || view.find_byte(250u8) is Option::Some(_) {
          return 0i32
        }
        continue offset + 1u32
      }
      _ => break ()
    }
    1i32
  } else if case == 9u32 {
    let value = b"!checked \xce\xbb \xf0\x9f\x8c\x8d?".view(1u32, 15u32)
    let text = value.to_string()
    bytes_result(text == "checked λ 🌍" && text.as_bytes().equals(value) && b"".to_string() == "")
  } else if case == 10u32 {
    b"\xed\xa0\x80".to_string()
    0i32
  } else if case == 11u32 {
    b"!\xf0\x90\x80\x80?".view(1u32, 3u32).to_string()
    0i32
  } else if case == 12u32 {
    let left = b"!\x00\xff0123456789abcdef?".view(1u32, 18u32)
    let right = b"!!\xfe\x80tail??".view(2u32, 6u32)
    let joined = left.concat(right)
    bytes_result(joined == b"\x00\xff0123456789abcdef\xfe\x80tail" && joined.byte_length() == 24u32 && left == b"\x00\xff0123456789abcdef" && right == b"\xfe\x80tail" && b"".concat(left) == left && right.concat(b"") == right && b"".concat(b"") == b"")
  } else if case == 13u32 {
    let source = b"0123456789abcdef0123456789abcdef0123456789abcdef"
    while 0u32 {
      offset if offset < 16u32 => {
        let left = source.view(offset, 17u32)
        let right = source.view(31u32 - offset, 17u32)
        let joined = left.concat(right)
        if joined.byte_length() != 34u32 || joined.view(0u32, 17u32) != left || joined.view(17u32, 17u32) != right {
          return 0i32
        }
        continue offset + 1u32
      }
      _ => break ()
    }
    1i32
  } else if case == 14u32 {
    bytes_result(bytes_simd_view_lanes())
  } else if case == 15u32 {
    bytes_result(bytes_simd_effects())
  } else if case == 16u32 {
    let load = bytes_simd_operation()
    let vector = load(b"0123456789abcdef!", 1u32)
    bytes_result(wasm_u8x16_extract_0(vector) == 49u8 && wasm_u8x16_extract_15(vector) == 33u8)
  } else if case == 17u32 {
    wasm_bytes_load_u8x16(b"", 0u32)
    0i32
  } else if case == 18u32 {
    wasm_bytes_load_u8x16(b"0123456789abcdef", 1u32)
    0i32
  } else if case == 19u32 {
    wasm_bytes_load_u8x16(b"0123456789abcdef!".view(1u32, 15u32), 0u32)
    0i32
  } else if case == 20u32 {
    wasm_bytes_load_u8x16(b"0123456789abcdef", 4294967295u32)
    0i32
  } else if case == 21u32 {
    let builder = BytesBuilder::with_capacity(256u32)
    builder.append(b"abcd")
    let bytes = builder.finish()
    bytes_result(b"".byte_length() == 0u32 && bytes.byte_length() == 4u32 &&
      bytes.view(1u32, 3u32).view(1u32, 1u32).byte_length() == 1u32 &&
      bytes.view(4u32, 0u32).byte_length() == 0u32)
  } else if case == 22u32 {
    let builder = BytesBuilder::with_capacity(256u32)
    let alias = builder
    if builder.byte_length() != 0u32 {
      return 0i32
    }
    builder.append(b"abcd")
    builder.append_byte(255u8)
    bytes_result(alias.byte_length() == 5u32 && builder.byte_length() == 5u32)
  } else if case == 23u32 {
    let builder = BytesBuilder::new()
    let bytes = builder.finish()
    bytes_result(builder.byte_length() == bytes.byte_length())
  } else if case == 24u32 {
    let builder = BytesBuilder::new()
    let alias = builder
    builder.append(b"abcd")
    let bytes = builder.finish()
    bytes_result(alias.byte_length() == bytes.byte_length())
  } else if case == 25u32 {
    let read = bytes_builder_length_operation()
    let builder = BytesBuilder::new()
    builder.append(b"abcd")
    bytes_result(read(builder) == 4u32)
  } else if case == 26u32 {
    let create = bytes_builder_default_operation()
    let builder = create()
    let alias = builder
    if builder.byte_length() != 0u32 {
      return 0i32
    }
    while 0u32 {
      index if index < 129u32 => {
        builder.append_byte(index.into())
        continue index + 1u32
      }
      _ => break ()
    }
    if alias.byte_length() != 129u32 {
      return 0i32
    }
    let bytes = alias.finish()
    bytes_result(bytes.byte_length() == 129u32 && bytes.byte_at(0u32) == 0u8 && bytes.byte_at(63u32) == 63u8 && bytes.byte_at(64u32) == 64u8 && bytes.byte_at(128u32) == 128u8)
  } else if case == 27u32 {
    let create = bytes_builder_default_operation()
    bytes_result(create().finish().byte_length() == 0u32)
  } else if case == 28u32 {
    let cast = bytes_string_operation()
    let value = b"!!\xce\xbb\xf0\x9f\x98\x80??".view(1u32, 8u32).view(1u32, 6u32)
    bytes_result(cast(value) == "λ😀" && cast(b"") == "" && cast(b"\xff").as_bytes() == b"\xff")
  } else if case == 29u32 {
    bytes_result(bytes_into_string(b"\xce\xbb\xf0\x9f\x98\x80") == "λ😀" && bytes_into_string(b"") == "")
  } else if case == 30u32 {
    bytes_into_string(b"\xc0\x80")
    0i32
  } else if case == 31u32 {
    let view = bytes_view_operation()
    bytes_result(view(view(b"!!\xffabc??", 2u32, 4u32), 1u32, 3u32) == b"abc")
  } else if case == 32u32 {
    let view = bytes_view_operation()
    bytes_result(view(b"abc", 3u32, 0u32) == b"" && view(b"", 0u32, 0u32) == b"")
  } else if case == 33u32 {
    bytes_view_operation()(b"abc", 4u32, 0u32)
    0i32
  } else if case == 34u32 {
    bytes_view_operation()(b"abc", 2u32, 2u32)
    0i32
  } else if case == 35u32 {
    bytes_view_operation()(b"abc", 4294967295u32, 1u32)
    0i32
  } else if case == 36u32 {
    let log = BytesViewLog::{
      value: 0u32
    }
    let value = bytes_view_operation()(bytes_view_input(log), bytes_view_start(log), bytes_view_length(log))
    bytes_result(value == b"bc" && log.value == 123u32)
  } else if case == 37u32 {
    let read = bytes_access_operation()
    let value = b"!0123456789abcdefghijklmnop?".view(1u32, 26u32)
    bytes_result(read(value, 0u32) == 48u8 && read(value, 15u32) == 102u8 && read(value, 16u32) == 103u8 && read(value, 25u32) == 112u8)
  } else if case == 38u32 {
    bytes_access_operation()(b"abc", 3u32)
    0i32
  } else if case == 39u32 {
    bytes_access_operation()(b"", 0u32)
    0i32
  } else if case == 40u32 {
    bytes_access_operation()(b"abc", 4294967295u32)
    0i32
  } else if case == 41u32 {
    let log = BytesViewLog::{
      value: 0u32
    }
    let byte = bytes_access_operation()(bytes_view_input(log), bytes_view_start(log))
    bytes_result(byte == 98u8 && log.value == 12u32)
  } else if case == 42u32 {
    bytes_result(bytes_access_matrix())
  } else if case == 43u32 {
    bytes_result(bytes_builder_copy_matrix())
  } else if case == 44u32 {
    let builder = bytes_builder_capacity_operation()(0u32)
    bytes_builder_append_operation()(builder, b"a\x00\xff")
    bytes_builder_byte_operation()(builder, 128u8)
    bytes_result(bytes_builder_finish_operation()(builder) == b"a\x00\xff\x80")
  } else if case == 45u32 {
    let builder = BytesBuilder::with_capacity(0u32)
    let _ = builder.finish()
    bytes_builder_finish_operation()(builder)
    0i32
  } else if case == 46u32 {
    let builder = BytesBuilder::new()
    let _ = builder.finish()
    bytes_builder_append_operation()(builder, b"")
    0i32
  } else if case == 47u32 {
    let builder = BytesBuilder::new()
    let _ = builder.finish()
    bytes_builder_byte_operation()(builder, 1u8)
    0i32
  } else if case == 48u32 {
    let builder = BytesBuilder::new()
    let alias = builder
    let _ = builder.finish()
    bytes_builder_finish_operation()(alias)
    0i32
  } else if case == 49u32 {
    let builder = BytesBuilder::with_capacity(0u32)
    let alias = builder
    while 0u32 {
      index if index < 1025u32 => {
        builder.append_byte((index & 255u32).into())
        continue index + 1u32
      }
      _ => break ()
    }
    let bytes = alias.finish()
    bytes_result(bytes.byte_length() == 1025u32 && bytes.byte_at(1023u32) == 255u8 && bytes.byte_at(1024u32) == 0u8)
  } else if case == 50u32 {
    // One invalid length field must fail before growth or an array access.
    bytes_builder_byte_operation()(bytes_builder_overflow_state(4294967295u32), 1u8)
    0i32
  } else if case == 51u32 {
    bytes_builder_append_operation()(bytes_builder_overflow_state(4294967294u32), b"ab")
    0i32
  } else if case == 52u32 {
    let log = BytesViewLog::{
      value: 0u32
    }
    let builder = BytesBuilder::with_capacity(0u32)
    bytes_builder_append_operation()(bytes_builder_logged_input(log, builder), bytes_builder_logged_part(log))
    bytes_result(log.value == 12u32 && builder.finish() == b"\x00\xff")
  } else {
    unreachable()
  }
}

struct BytesBuilderTestStorage {
  mut chunks: WasmArray<V128>
  mut length: U32
  mut consumed: U32
}

builtin bytes_builder_test_value(value: BytesBuilderTestStorage) -> BytesBuilder = "ref.cast"

fn bytes_builder_overflow_state(length: U32) -> BytesBuilder {
  bytes_builder_test_value(BytesBuilderTestStorage::{
    chunks: wasm_array_new_default::<V128>(0u32)
    length: length
    consumed: 0u32
  })
}

fn bytes_builder_capacity_operation() -> fn(U32) -> BytesBuilder {
  bytes_builder_with_capacity_raw
}
fn bytes_builder_append_operation() -> fn(BytesBuilder, Bytes) -> Unit {
  bytes_builder_append
}
fn bytes_builder_byte_operation() -> fn(BytesBuilder, U8) -> Unit {
  bytes_builder_append_byte
}
fn bytes_builder_finish_operation() -> fn(BytesBuilder) -> Bytes {
  bytes_builder_finish
}

fn bytes_builder_logged_input(log: BytesViewLog, value: BytesBuilder) -> BytesBuilder {
  log.value = log.value * 10u32 + 1u32
  value
}

fn bytes_builder_logged_part(log: BytesViewLog) -> Bytes {
  log.value = log.value * 10u32 + 2u32
  b"\x00\xff"
}

fn bytes_builder_copy_matrix() -> Bool {
  let seed = BytesBuilder::with_capacity(0u32)
  while 0u32 {
    index if index < 128u32 => {
      seed.append_byte(((index * 37u32) & 255u32).into())
      continue index + 1u32
    }
    _ => break ()
  }
  let source = seed.finish()
  while 0u32 {
    source_start if source_start < 16u32 => {
      while 0u32 {
        prefix if prefix < 16u32 => {
          for length in [0u32, 1u32, 15u32, 16u32, 17u32, 31u32, 32u32, 33u32, 65u32] {
            let builder = BytesBuilder::with_capacity(prefix)
            builder.append(source.view(0u32, prefix))
            builder.append(source.view(source_start, length))
            let result = builder.finish()
            if result.byte_length() != prefix + length || result.view(0u32, prefix) != source.view(0u32, prefix) || result.view(prefix, length) != source.view(source_start, length) {
              return false
            }
          }
          continue prefix + 1u32
        }
        _ => break ()
      }
      continue source_start + 1u32
    }
    _ => break ()
  }
  true
}

fn bytes_builder_length_operation() -> fn(BytesBuilder) -> U32 {
  bytes_builder_byte_length
}

struct BytesViewLog {
  mut value: U32
}

fn bytes_view_input(log: BytesViewLog) -> Bytes {
  log.value = log.value * 10u32 + 1u32
  b"abcd"
}

fn bytes_view_start(log: BytesViewLog) -> U32 {
  log.value = log.value * 10u32 + 2u32
  1u32
}

fn bytes_view_length(log: BytesViewLog) -> U32 {
  log.value = log.value * 10u32 + 3u32
  2u32
}

fn bytes_view_operation() -> fn(Bytes, U32, U32) -> Bytes {
  bytes_view
}

fn bytes_access_operation() -> fn(Bytes, U32) -> U8 {
  bytes_byte_at
}

fn bytes_access_matrix() -> Bool {
  let builder = BytesBuilder::with_capacity(256u32)
  while 0u32 {
    index if index < 256u32 => {
      builder.append_byte(index.into())
      continue index + 1u32
    }
    _ => break ()
  }
  let bytes = builder.finish()
  while 0u32 {
    offset if offset < 16u32 => {
      let view = bytes.view(offset, 240u32)
      while 0u32 {
        index if index < 240u32 => {
          if view.byte_at(index) != (offset + index).into() {
            return false
          }
          continue index + 1u32
        }
        _ => break ()
      }
      continue offset + 1u32
    }
    _ => break ()
  }
  bytes.byte_at(255u32) == 255u8
}

fn bytes_builder_default_operation() -> fn() -> BytesBuilder {
  bytes_builder_new
}

fn bytes_string_operation() -> fn(Bytes) -> String {
  bytes_to_string_unchecked
}

fn bytes_into_string(value: Bytes) -> String {
  value.into()
}

fn bytes_simd_view_lanes() -> Bool {
  let builder = BytesBuilder::new()
  while 0u32 {
    index if index < 128u32 => {
      builder.append_byte(((index * 37u32) % 256u32).into())
      continue index + 1u32
    }
    _ => break ()
  }
  let backing = builder.finish()
  while 0u32 {
    offset if offset < 16u32 => {
      let view = backing.view(3u32, 100u32).view(offset, 64u32)
      while 0u32 {
        start if start < 32u32 => {
          let vector = wasm_bytes_load_u8x16(view, start)
          let base = 3u32 + offset + start
          if wasm_u8x16_extract_0(vector) != u32_into_u8((base * 37u32) % 256u32) ||
            wasm_u8x16_extract_1(vector) != u32_into_u8(((base + 1u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_2(vector) != u32_into_u8(((base + 2u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_3(vector) != u32_into_u8(((base + 3u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_4(vector) != u32_into_u8(((base + 4u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_5(vector) != u32_into_u8(((base + 5u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_6(vector) != u32_into_u8(((base + 6u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_7(vector) != u32_into_u8(((base + 7u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_8(vector) != u32_into_u8(((base + 8u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_9(vector) != u32_into_u8(((base + 9u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_10(vector) != u32_into_u8(((base + 10u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_11(vector) != u32_into_u8(((base + 11u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_12(vector) != u32_into_u8(((base + 12u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_13(vector) != u32_into_u8(((base + 13u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_14(vector) != u32_into_u8(((base + 14u32) * 37u32) % 256u32) ||
            wasm_u8x16_extract_15(vector) != u32_into_u8(((base + 15u32) * 37u32) % 256u32) {
            return false
          }
          continue start + 1u32
        }
        _ => break ()
      }
      continue offset + 1u32
    }
    _ => break ()
  }
  true
}

fn bytes_simd_effect_value(log: Array<I32>) -> Bytes {
  log.push(1i32)
  b"0123456789abcdef!"
}

fn bytes_simd_effect_start(log: Array<I32>) -> U32 {
  log.push(2i32)
  1u32
}

fn bytes_simd_effects() -> Bool {
  let log = array_new::<I32>()
  let vector = wasm_bytes_load_u8x16(bytes_simd_effect_value(log), bytes_simd_effect_start(log))
  log.length() == 2u32 && log[0u32] == 1i32 && log[1u32] == 2i32 && wasm_u8x16_extract_0(vector) == 49u8 && wasm_u8x16_extract_15(vector) == 33u8
}

fn bytes_simd_operation() -> fn(Bytes, U32) -> U8x16 {
  wasm_bytes_load_u8x16
}

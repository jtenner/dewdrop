fn debug_integer_generic<t: Debug>(value: t) -> Unit {
  debug(value)
}

pub fn main(which: U32) -> I32 {
  match which {
    0u32 => debug(0i32)
    1u32 => debug(-128i8)
    2u32 => debug(127i8)
    3u32 => debug(-32768i16)
    4u32 => debug(32767i16)
    5u32 => debug(-2147483648i32)
    6u32 => debug(2147483647i32)
    7u32 => debug(unsafe_bitcast::<U64, I64>(9223372036854775808u64))
    8u32 => debug(9223372036854775807i64)
    9u32 => debug(255u8)
    10u32 => debug(65535u16)
    11u32 => debug(4294967295u32)
    12u32 => debug(18446744073709551615u64)
    13u32 => debug(swar32_from_bits(4294967295u32))
    14u32 => debug(swar64_from_bits(18446744073709551615u64))
    15u32 => debug_integer_generic(-101i32)
    16u32 => debug(0u64)
    17u32 => debug(unsafe_bitcast::<I32, I8>(384i32))
    18u32 => debug(unsafe_bitcast::<I32, I16>(98304i32))
    19u32 => debug(unsafe_bitcast::<I32, U8>(-1i32))
    20u32 => debug(unsafe_bitcast::<I32, U16>(-1i32))
    _ => unreachable()
  }
  0i32
}

struct CellU16 {
  mut value: U16
}
enum PayloadU16 {
  Value(U16)
}
fn readU16(value: U16) -> I32 {
  let cell = CellU16::{
    value: value
  }
  bits::<U16, I32>(cell.value)
}
fn writeU16(value: U16) -> I32 {
  let cell = CellU16::{
    value: bits::<I32, U16>(0i32)
  }
  cell.value = value
  bits::<U16, I32>(cell.value)

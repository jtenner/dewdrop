fn captureI8(value: I8) -> fn() -> I32 {
  fn() -> I32 {
    bits::<I8, I32>(value)
  }
}
fn captureMutableI8(value: I8) -> fn() -> I32 {
  let mut held = bits::<I32, I8>(0i32)
  let result = fn() -> I32 {
    bits::<I8, I32>(held)
  }
  held = value
  result
}

fn captureU8(value: U8) -> fn() -> I32 {
  fn() -> I32 {
    bits::<U8, I32>(value)
  }
}
fn captureMutableU8(value: U8) -> fn() -> I32 {
  let mut held = bits::<I32, U8>(0i32)
  let result = fn() -> I32 {
    bits::<U8, I32>(held)
  }
  held = value
  result
}


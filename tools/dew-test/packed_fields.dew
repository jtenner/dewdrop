builtin bits<a, b>(value: a) -> b = "unsafe.bitcast"

struct CellI8 {
  mut value: I8
}
enum PayloadI8 {
  Value(I8)
}
fn readI8(value: I8) -> I32 {
  let cell = CellI8::{
    value: value
  }
  bits::<I8, I32>(cell.value)
}
fn writeI8(value: I8) -> I32 {
  let cell = CellI8::{
    value: bits::<I32, I8>(0i32)
  }
  cell.value = value
  bits::<I8, I32>(cell.value)
}
fn payloadI8(value: I8) -> I32 {
  match PayloadI8::Value(value) {
    PayloadI8::Value(item) => bits::<I8, I32>(item)
  }
}

struct CellU8 {
  mut value: U8
}
enum PayloadU8 {
  Value(U8)
}
fn readU8(value: U8) -> I32 {
  let cell = CellU8::{
    value: value

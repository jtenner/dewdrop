fn writeU8(value: U8) -> I32 {
  let cell = CellU8::{
    value: bits::<I32, U8>(0i32)
  }
  cell.value = value
  bits::<U8, I32>(cell.value)
}
fn payloadU8(value: U8) -> I32 {
  match PayloadU8::Value(value) {
    PayloadU8::Value(item) => bits::<U8, I32>(item)
  }
}


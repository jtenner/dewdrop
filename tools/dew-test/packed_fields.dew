fn captureU16(value: U16) -> fn() -> I32 {
  fn() -> I32 {
    bits::<U16, I32>(value)
  }
}
fn captureMutableU16(value: U16) -> fn() -> I32 {
  let mut held = bits::<I32, U16>(0i32)
  let result = fn() -> I32 {
    bits::<U16, I32>(held)
  }
  held = value
  result
}

enum NestedPackedPayload {
  NestedI8(PayloadI8)
  NestedU8(PayloadU8)
  NestedI16(PayloadI16)
  NestedU16(PayloadU16)
}

fn nestedPayloadI8(value: I8) -> I32 {
  match NestedPackedPayload::NestedI8(PayloadI8::Value(value)) {
    NestedPackedPayload::NestedI8(PayloadI8::Value(item)) => bits::<I8, I32>(item)
    _ => 0i32
  }
}

fn nestedPayloadU8(value: U8) -> I32 {
  match NestedPackedPayload::NestedU8(PayloadU8::Value(value)) {
    NestedPackedPayload::NestedU8(PayloadU8::Value(item)) => bits::<U8, I32>(item)
    _ => 0i32
  }
}

fn nestedPayloadI16(value: I16) -> I32 {
  match NestedPackedPayload::NestedI16(PayloadI16::Value(value)) {
    NestedPackedPayload::NestedI16(PayloadI16::Value(item)) => bits::<I16, I32>(item)
    _ => 0i32
  }
}

fn nestedPayloadU16(value: U16) -> I32 {
  match NestedPackedPayload::NestedU16(PayloadU16::Value(value)) {
    NestedPackedPayload::NestedU16(PayloadU16::Value(item)) => bits::<U16, I32>(item)
    _ => 0i32
  }
}


fn nestedLiteralI8(value: I8) -> I32 {
  match NestedPackedPayload::NestedI8(PayloadI8::Value(value)) {
    NestedPackedPayload::NestedI8(PayloadI8::Value(127i8)) => 42i32
    _ => 0i32
  }
}

fn nestedLiteralU8(value: U8) -> I32 {
  match NestedPackedPayload::NestedU8(PayloadU8::Value(value)) {
    NestedPackedPayload::NestedU8(PayloadU8::Value(255u8)) => 42i32
    _ => 0i32
  }
}

fn nestedLiteralI16(value: I16) -> I32 {
  match NestedPackedPayload::NestedI16(PayloadI16::Value(value)) {
    NestedPackedPayload::NestedI16(PayloadI16::Value(32767i16)) => 42i32
    _ => 0i32
  }
}

fn nestedLiteralU16(value: U16) -> I32 {
  match NestedPackedPayload::NestedU16(PayloadU16::Value(value)) {
    NestedPackedPayload::NestedU16(PayloadU16::Value(65535u16)) => 42i32
    _ => 0i32
  }
}


struct NestedPackedStruct {
  signed8: CellI8
  unsigned8: CellU8
  signed16: CellI16
  unsigned16: CellU16
}

fn nestedStructPayload(which: U32) -> I32 {
  let value = NestedPackedStruct::{
    signed8: CellI8::{
      value: bits::<I32, I8>(511i32)
    }
    unsigned8: CellU8::{
      value: bits::<I32, U8>(511i32)
    }
    signed16: CellI16::{
      value: bits::<I32, I16>(131071i32)
    }
    unsigned16: CellU16::{
      value: bits::<I32, U16>(131071i32)
    }
  }
  match value {
    NestedPackedStruct {
      unsigned16: CellU16 {
        value: d
      }
      signed8: CellI8 {
        value: a
      }
      unsigned8: CellU8 {
        value: b
      }
      signed16: CellI16 {
        value: c
      }
    } => match which {
      32u32 => bits::<I8, I32>(a)
      33u32 => bits::<U8, I32>(b)
      34u32 => bits::<I16, I32>(c)
      _ => bits::<U16, I32>(d)
    }
  }
}

pub fn main(which: U32) -> I32 {
  match which {
    0u32 => readI8(bits::<I32, I8>(511i32))
    1u32 => readU8(bits::<I32, U8>(511i32))
    2u32 => readI16(bits::<I32, I16>(131071i32))
    3u32 => readU16(bits::<I32, U16>(131071i32))
    4u32 => writeI8(bits::<I32, I8>(511i32))
    5u32 => writeU8(bits::<I32, U8>(511i32))
    6u32 => writeI16(bits::<I32, I16>(131071i32))
    7u32 => writeU16(bits::<I32, U16>(131071i32))
    8u32 => payloadI8(bits::<I32, I8>(511i32))
    9u32 => payloadU8(bits::<I32, U8>(511i32))
    10u32 => payloadI16(bits::<I32, I16>(131071i32))
    11u32 => payloadU16(bits::<I32, U16>(131071i32))
    12u32 => captureI8(bits::<I32, I8>(511i32))()
    13u32 => captureU8(bits::<I32, U8>(511i32))()
    14u32 => captureI16(bits::<I32, I16>(131071i32))()
    15u32 => captureU16(bits::<I32, U16>(131071i32))()
    16u32 => captureMutableI8(bits::<I32, I8>(511i32))()
    17u32 => captureMutableU8(bits::<I32, U8>(511i32))()
    18u32 => captureMutableI16(bits::<I32, I16>(131071i32))()
    19u32 => captureMutableU16(bits::<I32, U16>(131071i32))()
    20u32 => nestedPayloadI8(bits::<I32, I8>(511i32))
    21u32 => nestedPayloadU8(bits::<I32, U8>(511i32))
    22u32 => nestedPayloadI16(bits::<I32, I16>(131071i32))
    23u32 => nestedPayloadU16(bits::<I32, U16>(131071i32))
    24u32 => nestedLiteralI8(127i8)
    25u32 => nestedLiteralI8(0i8)
    26u32 => nestedLiteralU8(255u8)
    27u32 => nestedLiteralU8(0u8)
    28u32 => nestedLiteralI16(32767i16)
    29u32 => nestedLiteralI16(0i16)
    30u32 => nestedLiteralU16(65535u16)
    31u32 => nestedLiteralU16(0u16)
    32u32 => nestedStructPayload(which)
    33u32 => nestedStructPayload(which)
    34u32 => nestedStructPayload(which)
    35u32 => nestedStructPayload(which)
    _ => 0i32
  }
}

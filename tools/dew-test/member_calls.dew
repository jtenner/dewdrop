// This fixture also runs without the native compiler's implicit preamble.
trait IndexedGet<index, value> {
  fn indexed_get(self, index: index) -> value
}

trait IndexedSet<index, value> {
  fn indexed_set(self, index: index, value: value) -> Unit
}

struct MemberSlot<t> {
  mut item: t
}

impl<t> IndexedGet<U32, t> for MemberSlot<t> {
  fn indexed_get(self, index: U32) -> t {
    self.item
  }
}

impl<t> IndexedSet<U32, t> for MemberSlot<t> {
  fn indexed_set(self, index: U32, value: t) -> Unit {
    self.item = value
  }
}

struct MemberCell {
  mut value: I32
}

impl MemberCell {
  fn read(self) -> I32 {
    self.value
  }
}

struct MemberWrapper {
  inner: MemberCell
}

struct RoadMap<key, value> {
  key: key
  value: value
}

impl<key, value> IndexedGet<key, value> for RoadMap<key, value> {
  fn indexed_get(self, index: key) -> value {
    self.value
  }
}

enum MemberPayload<t> {
  Empty
  Value(t)
}

fn member_extract<t>(value: MemberPayload<t>, fallback: t) -> t {
  match value {
    MemberPayload::Value(item) => item
    MemberPayload::Empty => fallback
  }
}

builtin member_add(left: I32, right: I32) -> I32 = "i32.add"
builtin member_mul(left: I32, right: I32) -> I32 = "i32.mul"

struct PlainUnitSlot {
  trace: MemberCell
}

fn member_record(cell: MemberCell, digit: I32) -> Unit {
  cell.value = member_add(member_mul(cell.value, 10i32), digit)
}

impl IndexedSet<U32, Unit> for PlainUnitSlot {
  fn indexed_set(self, index: U32, value: Unit) -> Unit {
    member_record(self.trace, 4i32)
  }
}

fn member_plain_unit_receiver(trace: MemberCell) -> PlainUnitSlot {
  member_record(trace, 1i32)
  PlainUnitSlot::{
    trace: trace
  }
}

fn member_plain_unit_index(trace: MemberCell) -> U32 {
  member_record(trace, 2i32)
  0u32
}

fn member_plain_unit_value(trace: MemberCell) -> Unit {
  member_record(trace, 3i32)
}

fn member_unit_receiver(cell: MemberCell) -> MemberSlot<Unit> {
  cell.value = member_add(cell.value, 1i32)
  MemberSlot::{
    item: ()
  }
}

fn member_unit_value(cell: MemberCell) -> Unit {
  cell.value = member_add(cell.value, 1i32)
}

pub fn main(value: I32, expected: I32) -> I32 {
  let cell = MemberCell::{
    value: 0i32
  }
  member_unit_receiver(cell).item
  member_unit_receiver(cell)[0u32]
  member_unit_receiver(cell).item = member_unit_value(cell)
  member_unit_receiver(cell)[0u32] = member_unit_value(cell)
  let receiver_effects = cell.value == 6i32
  let trace = MemberCell::{
    value: 0i32
  }
  member_plain_unit_receiver(trace)[member_plain_unit_index(trace)] = member_plain_unit_value(trace)
  let plain_unit_order = trace.value == 1234i32
  let (tuple_left, tuple_right) = member_extract(MemberPayload::Value((7i32, 11i64)), (0i32, 0i64))
  let tuple_binding = tuple_left == 7i32 && tuple_right == 11i64
  let road = RoadMap::{
    key: 1u32
    value: 19i64
  }
  let indexed_result = road[1u32] == 19i64
  let float_slot = MemberSlot::{
    item: 1.5f32
  }
  let double_slot = MemberSlot::{
    item: 2.5f64
  }
  let indexed_float_results = float_slot[0u32] + float_slot[1u32] == 3.0f32 &&
    double_slot[0u32] + double_slot[1u32] == 5.0f64
  cell.value = 0i32
  let wrapper = MemberWrapper::{
    inner: cell
  }
  let old = MemberCell::{
    value: 17i32
  }
  let previous = MemberWrapper::{
    inner: old
  }
  let slot = MemberSlot::{
    item: previous
  }
  slot[0u32] = wrapper
  slot[0u32].inner.value = value
  if indexed_result && indexed_float_results && tuple_binding && receiver_effects && plain_unit_order && slot[0u32].inner.value == expected && cell.read() == value && old.read() == 17i32 {
    slot[0u32].inner.read()
  } else {
    -1i32
  }
}

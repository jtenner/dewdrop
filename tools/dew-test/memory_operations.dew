// Exercise the checked-in library memory functions with host-supplied memory.
pub fn probe_i8(address: U32, value: I8, write: Bool) -> I8 {
  if write {
    i8_store(address, value)
  }
  i8_load(address)
}
pub fn probe_u8(address: U32, value: U8, write: Bool) -> U8 {
  if write {
    u8_store(address, value)
  }
  u8_load(address)
}

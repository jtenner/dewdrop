open dew.std.preamble
open dew.std.array
open dew.std.string
open dew.std.string_builder
open dew.std.text_runtime
open dew.std.bytes
open dew.std.option
open dew.std.wasm.intrinsics

struct StringLoadLog {
  mut order: U32
}

fn string_load_source(log: StringLoadLog) -> String {
  log.order = log.order * 10u32 + 1u32
  "xx0123456789abcdef-yy".view(2u32, 17u32).to_string()
}

fn string_load_index(log: StringLoadLog) -> U32 {
  log.order = log.order * 10u32 + 2u32
  1u32
}

fn string_load_function() -> fn(String, U32) -> U8x16 {
  wasm_string_load_u8x16
}

struct StringLabel {
  name: String
}

fn strings_same(left: String, right: String) -> Bool {
  left == right
}

fn strings_different(left: String, right: String) -> Bool {
  left != right
}

fn string_field_same(left: StringLabel, right: String) -> Bool {
  left.name == right
}

fn string_result(value: Bool) -> I32 {
  if value {
    1i32
  } else {
    0i32
  }
}

pub fn main(case: U32) -> I32 {
  if case == 0u32 {
    string_result("".utf16_length() == 0u32 && "".hash() == b"".hash() && "abc".starts_with("") && "abc".ends_with("") && "abc".find("") is Option::Some(0u32) && "".find("a") is Option::None && !"a".starts_with("ab") && !"a".ends_with("ba"))
  } else if case == 1u32 {
    let value = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabaaaab"
    string_result(value.find("aaaab") is Option::Some(29u32) && value.find_view("!ab?".view(1u32, 2u32)) is Option::Some(32u32) && !value.contains("ac") && value.contains_view("!aaaab?".view(1u32, 5u32)))
  } else if case == 2u32 {
    let value = "0123456789abcdef0123456789abcdef0123456789abcdef"
    let needle = "!456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 44u32)
    string_result(value.find_view(needle) is Option::Some(4u32) && value.find("456789abcdef0123456789abcdef0123456789abcdeg") is Option::None && value.find(value) is Option::Some(0u32) && value.hash() == value.as_bytes().hash())
  } else if case == 3u32 {
    let value = "λ0123456789abcdef🌍"
    string_result(value.starts_with("λ012") && value.starts_with_view("!λ012?".view(1u32, 5u32)) && value.ends_with("def🌍") && value.ends_with_view("!def🌍?".view(1u32, 7u32)) && !value.starts_with("λ013") && !value.ends_with("deg🌍"))
  } else if case == 4u32 {
    let source = "0123456789abcdef0123456789abcdefλ🌍€"
    while 0u32 {
      offset if offset <= 32u32 => {
        let value = source.view(offset, source.byte_length() - offset).to_string()
        if value.utf16_length() != 36u32 - offset || value.hash() != value.as_bytes().hash() {
          return 0i32
        }
        continue offset + 1u32
      }
      _ => break ()
    }
    1i32
  } else if case == 5u32 {
    let value = "🌍🌍🌍🌍🌍🌍🌍🌍λ€"
    string_result(value.utf16_length() == 18u32 && value.find("λ€") is Option::Some(32u32) && value.hash() == value.as_bytes().hash() && "hello".hash() == 11831194018420276491u64)
  } else if case == 6u32 {
    let left = "!λ0123456789abcdef?".view(1u32, 18u32).to_string()
    let right = "!🌍tail?".view(1u32, 8u32)
    let combined = left.concat_view(right)
    string_result(combined == "λ0123456789abcdef🌍tail" && left.concat(right.to_string()) == combined && "".concat(combined) == combined && combined.concat("") == combined && left == "λ0123456789abcdef" && right.to_string() == "🌍tail")
  } else if case == 7u32 {
    let value = "!λ?".view(1u32, 2u32).to_string()
    match value {
      "x" => 0i32
      "λ" => 1i32
      _ => 0i32
    }
  } else if case == 8u32 {
    let left = "Op".concat("tion")
    let right = "Opt".concat("ion")
    string_result(left.equals(right) && strings_same(left, right) && !strings_different(left, right) && string_field_same(StringLabel::{
      name: left
    }, right))
  } else if case == 9u32 {
    let value = "!0123456789abcdefλ🌍?".view(1u32, 22u32).to_string()
    string_result("".byte_length() == 0u32 && value.byte_length() == 22u32 && value.byte_at(0u32) == 48u8 && value.byte_at(15u32) == 102u8 && value.byte_at(16u32) == 206u8 && value.byte_at(17u32) == 187u8 && value.byte_at(18u32) == 240u8 && value.byte_at(21u32) == 141u8)
  } else if case == 10u32 {
    "x".byte_at(1u32)
    0i32
  } else if case == 11u32 {
    "x".byte_at(4294967295u32)
    0i32
  } else if case == 12u32 {
    "".byte_at(0u32)
    0i32
  } else if case == 13u32 {
    let source = "xx0123456789abcdef-yy".view(2u32, 17u32).to_string()
    let aligned = wasm_string_load_u8x16(source, 0u32)
    let unaligned = wasm_string_load_u8x16(source, 1u32)
    string_result(wasm_u8x16_extract_0(aligned) == 48u8 && wasm_u8x16_extract_15(aligned) == 102u8 && wasm_u8x16_extract_0(unaligned) == 49u8 && wasm_u8x16_extract_15(unaligned) == 45u8)
  } else if case == 14u32 {
    let log = StringLoadLog::{
      order: 0u32
    }
    let loaded = wasm_string_load_u8x16(string_load_source(log), string_load_index(log))
    string_result(log.order == 12u32 && wasm_u8x16_extract_0(loaded) == 49u8 && wasm_u8x16_extract_15(loaded) == 45u8)
  } else if case == 15u32 {
    let load = string_load_function()
    let loaded = load("0123456789abcdef", 0u32)
    string_result(wasm_u8x16_extract_0(loaded) == 48u8 && wasm_u8x16_extract_15(loaded) == 102u8)
  } else if case == 16u32 {
    wasm_string_load_u8x16("0123456789abcdef", 1u32)
    0i32
  } else if case == 17u32 {
    wasm_string_load_u8x16("0123456789abcdef", 4294967295u32)
    0i32
  } else if case == 18u32 {
    wasm_string_load_u8x16("", 0u32)
    0i32
  } else if case == 19u32 {
    let builder = StringBuilder::with_capacity(256u32)
    let alias = builder
    if builder.byte_length() != 0u32 {
      return 0i32
    }
    builder.append("λ😀")
    string_result(builder.byte_length() == 6u32 && alias.byte_length() == 6u32)
  } else if case == 20u32 {
    let builder = StringBuilder::new()
    let text = builder.finish()
    string_result(builder.byte_length() == text.byte_length())
  } else if case == 21u32 {
    let builder = StringBuilder::new()
    let alias = builder
    builder.append("λ😀")
    let text = builder.finish()
    string_result(alias.byte_length() == text.byte_length())
  } else if case == 22u32 {
    let read = string_builder_length_operation()
    let builder = StringBuilder::new()
    builder.append("λ😀")
    string_result(read(builder) == 6u32)
  } else if case == 23u32 {
    let create = string_builder_default_operation()
    let builder = create()
    let alias = builder
    if builder.byte_length() != 0u32 {
      return 0i32
    }
    while 0u32 {
      index if index < 65u32 => {
        builder.append("λ😀")
        continue index + 1u32
      }
      _ => break ()
    }
    if alias.byte_length() != 390u32 {
      return 0i32
    }
    let result = alias.finish()
    string_result(result.byte_length() == 390u32 && result.utf16_length() == 195u32 && result.starts_with("λ😀λ😀") && result.ends_with("λ😀λ😀"))
  } else if case == 24u32 {
    let create = string_builder_default_operation()
    string_result(create().finish() == "")
  } else if case == 25u32 {
    let cast = string_bytes_operation()
    let value = "!λ😀?".view(1u32, 6u32).to_string()
    string_result(cast(value) == b"\xce\xbb\xf0\x9f\x98\x80" && cast("") == b"" && value == "λ😀")
  } else if case == 26u32 {
    let bytes = string_into_bytes("λ😀")
    string_result(bytes == b"\xce\xbb\xf0\x9f\x98\x80")
  } else if case == 27u32 {
    let append = string_append_operation()
    let builder = StringBuilder::with_capacity(0u32)
    let source = "!λ😀?".view(1u32, 6u32).to_string()
    append(builder, source)
    append(builder, "")
    append(builder, source)
    string_result(builder.finish() == "λ😀λ😀" && source == "λ😀")
  } else if case == 28u32 {
    let append = string_append_view_operation()
    let builder = StringBuilder::with_capacity(0u32)
    let source = "!xxλ😀yy?".view(1u32, 10u32).view(2u32, 6u32)
    append(builder, source)
    append(builder, source.view(0u32, 0u32))
    append(builder, source)
    string_result(builder.finish() == "λ😀λ😀" && source.as_bytes() == b"\xce\xbb\xf0\x9f\x98\x80")
  } else if case == 29u32 {
    let append = string_append_ascii_operation()
    let builder = StringBuilder::with_capacity(0u32)
    append(builder, 0u8)
    append(builder, 127u8)
    string_result(builder.finish().as_bytes() == b"\x00\x7f")
  } else if case == 30u32 {
    let append = string_append_ascii_operation()
    let builder = StringBuilder::new()
    append(builder, 128u8)
    0i32
  } else if case == 31u32 {
    let builder = StringBuilder::new()
    let _ = builder.finish()
    string_append_operation()(builder, "")
    0i32
  } else if case == 32u32 {
    let builder = StringBuilder::new()
    let _ = builder.finish()
    string_append_view_operation()(builder, "".view(0u32, 0u32))
    0i32
  } else if case == 33u32 {
    let builder = StringBuilder::new()
    let _ = builder.finish()
    string_append_ascii_operation()(builder, 0u8)
    0i32
  } else if case == 34u32 {
    let builder = StringBuilder::new()
    let log = StringLoadLog::{
      order: 0u32
    }
    string_append_operation()(string_append_builder(log, builder), string_append_part(log))
    string_result(log.order == 12u32 && builder.finish() == "λ")
  } else if case == 35u32 {
    string_result(string_builder_scalar_matrix())
  } else if case == 36u32 {
    let builder = string_builder_capacity_operation()(0u32)
    string_builder_scalar_operation()(builder, 127757u32)
    string_result(string_builder_finish_operation()(builder) == "🌍")
  } else if case == 37u32 {
    string_builder_scalar_operation()(StringBuilder::new(), 55296u32)
    0i32
  } else if case == 38u32 {
    string_builder_scalar_operation()(StringBuilder::new(), 57343u32)
    0i32
  } else if case == 39u32 {
    string_builder_scalar_operation()(StringBuilder::new(), 1114112u32)
    0i32
  } else if case == 40u32 {
    string_builder_scalar_operation()(StringBuilder::new(), 4294967295u32)
    0i32
  } else if case == 41u32 {
    let builder = StringBuilder::new()
    let _ = builder.finish()
    string_builder_scalar_operation()(builder, 0u32)
    0i32
  } else if case == 42u32 {
    let builder = StringBuilder::new()
    let _ = builder.finish()
    string_builder_finish_operation()(builder)
    0i32
  } else if case == 43u32 {
    string_builder_scalar_operation()(string_builder_overflow_state(4294967294u32), 2048u32)
    0i32
  } else if case == 44u32 {
    let builder = StringBuilder::with_capacity(0u32)
    let log = StringLoadLog::{
      order: 0u32
    }
    string_builder_scalar_operation()(string_append_builder(log, builder), string_builder_logged_scalar(log))
    string_result(log.order == 12u32 && builder.finish() == "λ")
  } else if case == 45u32 {
    let builder = string_builder_capacity_operation()(0u32)
    let alias = builder
    while 0u32 {
      index if index < 257u32 => {
        string_builder_scalar_operation()(builder, 8364u32)
        continue index + 1u32
      }
      _ => break ()
    }
    let text = string_builder_finish_operation()(alias)
    string_result(text.byte_length() == 771u32 && text.starts_with("€€") && text.ends_with("€€"))
  } else if case == 46u32 {
    string_builder_scalar_operation()(string_builder_overflow_state(4294967295u32), 0u32)
    0i32
  } else {
    unreachable()
  }
}

struct StringBuilderTestStorage {
  mut chunks: WasmArray<V128>
  mut length: U32
  mut consumed: U32
}

builtin string_builder_test_value(value: StringBuilderTestStorage) -> StringBuilder = "ref.cast"

fn string_builder_overflow_state(length: U32) -> StringBuilder {
  string_builder_test_value(StringBuilderTestStorage::{
    chunks: wasm_array_new_default::<V128>(0u32)
    length: length
    consumed: 0u32
  })
}

fn string_builder_capacity_operation() -> fn(U32) -> StringBuilder {
  string_builder_with_capacity_raw
}
fn string_builder_scalar_operation() -> fn(StringBuilder, U32) -> Unit {
  string_builder_append_scalar
}
fn string_builder_finish_operation() -> fn(StringBuilder) -> String {
  string_builder_finish
}
fn string_builder_logged_scalar(log: StringLoadLog) -> U32 {
  log.order = log.order * 10u32 + 2u32
  955u32
}

fn string_builder_scalar_matrix() -> Bool {
  let prefix_text = "abcdefghijklmnop"
  let encoded = "\x00\x7f\xc2\x80\xdf\xbf\xe0\xa0\x80\xed\x9f\xbf\xee\x80\x80\xef\xbf\xbf\xf0\x90\x80\x80\xf4\x8f\xbf\xbf"
  while 0u32 {
    prefix if prefix < 16u32 => {
      let builder = StringBuilder::with_capacity(1u32)
      builder.append_view(prefix_text.view(0u32, prefix))
      for scalar in [0u32, 127u32, 128u32, 2047u32, 2048u32, 55295u32, 57344u32, 65535u32, 65536u32, 1114111u32] {
        builder.append_scalar(scalar)
      }
      let result = builder.finish()
      if result.as_bytes().view(0u32, prefix) != prefix_text.as_bytes().view(0u32, prefix) || result.as_bytes().view(prefix, encoded.byte_length()) != encoded.as_bytes() || result.byte_length() != prefix + encoded.byte_length() {
        return false
      }
      continue prefix + 1u32
    }
    _ => break ()
  }
  true
}

fn string_builder_length_operation() -> fn(StringBuilder) -> U32 {
  string_builder_byte_length
}

fn string_append_operation() -> fn(StringBuilder, String) -> Unit {
  string_builder_append
}

fn string_append_view_operation() -> fn(StringBuilder, StringView) -> Unit {
  string_builder_append_view
}

fn string_append_ascii_operation() -> fn(StringBuilder, U8) -> Unit {
  string_builder_append_ascii
}

fn string_append_builder(log: StringLoadLog, builder: StringBuilder) -> StringBuilder {
  log.order = log.order * 10u32 + 1u32
  builder
}

fn string_append_part(log: StringLoadLog) -> String {
  log.order = log.order * 10u32 + 2u32
  "λ"
}

fn string_builder_default_operation() -> fn() -> StringBuilder {
  string_builder_new
}

fn string_bytes_operation() -> fn(String) -> Bytes {
  __dew_text_bytes
}

fn string_into_bytes(value: String) -> Bytes {
  value.into()
}

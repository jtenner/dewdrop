open dew.std.array
open dew.std.option
open dew.std.wasm.intrinsics

fn bulk_values() -> Array<I64> {
  let values = Array::new()
  values.push(10i64)
  values.push(20i64)
  values.push(30i64)
  values.push(40i64)
  values
}

struct BulkCell {
  mut value: I32
}

struct BulkIndexCell<t> {
  value: t
}

impl<t> IndexedGet<U32, t> for BulkIndexCell<t> {
  fn indexed_get(self, key: U32) -> t {
    self.value
  }
}

fn bulk_effect(cell: BulkCell) -> Unit {
  cell.value = cell.value + 1i32
}

fn bulk_local_identity<t>(value: t) -> t {
  let result = value
  result
}

pub fn main(case: U32) -> I32 {
  if case == 0u32 {
    let values = bulk_values()
    values.copy_within(1u32, 0u32, 3u32)
    if values[1u32] == 10i64 && values[3u32] == 30i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 1u32 {
    let values = bulk_values()
    values.extend(values)
    if values.length() == 8u32 && values[4u32] == 10i64 && values[7u32] == 40i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 2u32 {
    let values = bulk_values()
    let copied = values.copy()
    copied.fill(7i64, 0u32, 4u32)
    let sliced = values.slice(1u32, 3u32)
    if copied[3u32] == 7i64 && values[3u32] == 40i64 && sliced[0u32] == 20i64 && sliced.length() == 2u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 3u32 {
    let cell = BulkCell::{
      value: 3i32
    }
    let values = Array::make(3u32, cell)
    let copied = values.copy()
    cell.value = 8i32
    if copied[2u32].value == 8i32 && copied.length() == 3u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 4u32 {
    let cell = BulkCell::{
      value: 0i32
    }
    let values = Array::make(2u32, bulk_effect(cell))
    values.push(bulk_effect(cell))
    values.set_unchecked(0u32, bulk_effect(cell))
    values.get_unchecked(1u32)
    let copied = values.copy()
    copied.extend(values)
    if cell.value == 3i32 && values.length() == 3u32 && copied.length() == 6u32 && values.get(0u32) is Option::Some(_) {
      1i32
    } else {
      0i32
    }
  } else if case == 5u32 {
    bulk_values().copy_within(0u32, 3u32, 2u32)
    0i32
  } else if case == 6u32 {
    bulk_values().copy_within(4294967295u32, 0u32, 0u32)
    0i32
  } else if case == 7u32 {
    bulk_values().fill(7i64, 0u32, 5u32)
    0i32
  } else if case == 8u32 {
    let values = Array::make(0u32, ())
    values.get_unchecked(0u32)
    0i32
  } else if case == 10u32 {
    let values = bulk_values()
    values[unreachable()]
    0i32
  } else if case == 11u32 {
    let value = BulkIndexCell::{
      value: 42i32
    }
    value[unreachable()]
    0i32
  } else if case == 12u32 {
    let cell = BulkCell::{
      value: 0i32
    }
    let values = Array::make(1u32, ())
    let rejected = values.set(1u32, bulk_effect(cell))
    let accepted = values.set(0u32, bulk_effect(cell))
    if !rejected && accepted && cell.value == 2i32 && values.length() == 1u32 && values.get(0u32) is Option::Some(_) && values.get(1u32) is Option::None {
      1i32
    } else {
      0i32
    }
  } else if case == 13u32 {
    let values = Array::make(1u32, ())
    let iterator = values.iter()
    let first = iterator.next() is Option::Some(_)
    let second = iterator.next() is Option::None
    if first && second {
      1i32
    } else {
      0i32
    }
  } else if case == 15u32 {
    let values = [(2i32, 3i64)]
    let iterator = values.iter()
    let first = match values.get(0u32) {
      Option::Some(value) => {
        let (left, right) = value
        left == 2i32 && right == 3i64
      }
      Option::None => false
    }
    let second = match iterator.next() {
      Option::Some(value) => {
        let (left, right) = value
        left == 2i32 && right == 3i64
      }
      Option::None => false
    }
    if first && second && iterator.next() is Option::None {
      1i32
    } else {
      0i32
    }
  } else if case == 14u32 {
    let values = bulk_values()
    match values.get(0u32) {
      Option::Some(value) => if value == 10i64 && values.get(4u32) is Option::None {
        1i32
      } else {
        0i32
      }
      Option::None => 0i32
    }
  } else if case == 16u32 {
    let values = Array::with_capacity(2u32)
    values.push(10i64)
    values.push(20i64)
    values.push(30i64)
    values.reserve(10u32)
    let reserved = values.capacity() >= 13u32 && values.length() == 3u32
    values.shrink_to_fit()
    let popped = values.pop() is Option::Some(30i64)
    if reserved && popped && values.capacity() == 3u32 && values.length() == 2u32 && wasm_array_get(values.backing, 2u32) == 0i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 17u32 {
    let values = bulk_values()
    let capacity = values.capacity()
    values.truncate(4u32)
    values.truncate(1u32)
    let cleared = wasm_array_get(values.backing, 1u32) == 0i64 && wasm_array_get(values.backing, 3u32) == 0i64
    values.clear()
    values.clear()
    if cleared && values.length() == 0u32 && values.capacity() == capacity && wasm_array_get(values.backing, 0u32) == 0i64 {
      1i32
    } else {
      0i32
    }
  } else if case == 18u32 {
    bulk_values().truncate(5u32)
    0i32
  } else if case == 19u32 {
    bulk_values().reserve(4294967295u32)
    0i32
  } else if case == 20u32 {
    let values = Array::with_capacity(8u32)
    values.push(1i64)
    values.get_unchecked(1u32)
    0i32
  } else if case == 21u32 {
    let values = Array::with_capacity(8u32)
    values.push(1i64)
    values.set_unchecked(1u32, 2i64)
    0i32
  } else if case == 22u32 {
    let values = Array::make(1u32, 1i64)
    let iterator = values.iter()
    array_iter_next(iterator)
    array_iter_next(iterator)
    0i32
  } else if case == 23u32 {
    let values = Array::make(1u32, 10i64)
    let iterator = values.iter()
    let first = array_iter_next(iterator)
    values.push(20i64)
    let second = array_iter_next(iterator)
    values.truncate(1u32)
    if first == 10i64 && second == 20i64 && !array_iter_has_next(iterator) {
      1i32
    } else {
      0i32
    }
  } else if case == 24u32 {
    let cell = BulkCell::{
      value: 3i32
    }
    let values = [cell, cell]
    values.truncate(1u32)
    // Deliberately inspect removed raw storage. Dereferencing its cleared
    // reference must trap; omitting the clear would return the old value.
    wasm_array_get(values.backing, 1u32).value
  } else if case == 25u32 {
    let cell = BulkCell::{
      value: 0i32
    }
    bulk_local_identity(bulk_effect(cell))
    let values = Array::make(2u32, bulk_effect(cell))
    values.reserve(8u32)
    values.truncate(1u32)
    values.shrink_to_fit()
    if cell.value == 2i32 && values.length() == 1u32 && values.capacity() == 1u32 {
      1i32
    } else {
      0i32
    }
  } else if case == 26u32 {
    let cell = BulkCell::{
      value: 3i32
    }
    let values = [cell, cell]
    values.truncate(1u32)
    cell.value = 8i32
    if values[0u32].value == 8i32 {
      1i32
    } else {
      0i32
    }
  } else if case == 27u32 {
    let signed8 = [-127i8, 126i8]
    let unsigned8 = [128u8, 255u8]
    let signed16 = [-32767i16, 32766i16]
    let unsigned16 = [32768u16, 65535u16]
    signed8.push(-128i8)
    unsigned8.push(254u8)
    signed16.push(-32768i16)
    unsigned16.push(65534u16)
    if signed8[0u32] == -127i8 && signed8[2u32] == -128i8 && unsigned8[1u32] == 255u8 && unsigned8[2u32] == 254u8 && signed16[0u32] == -32767i16 && signed16[2u32] == -32768i16 && unsigned16[1u32] == 65535u16 && unsigned16[2u32] == 65534u16 {
      1i32
    } else {
      0i32
    }
  } else if case == 9u32 {
    let cell = BulkCell::{
      value: 0i32
    }
    let values = [bulk_effect(cell), bulk_effect(cell)]
    values[0u32]
    values[0u32] = bulk_effect(cell)
    let iterator = values.iter()
    array_iter_next(iterator)
    array_iter_next(iterator)
    let present = values.pop() is Option::Some(_)
    let missing = values.get(1u32) is Option::None
    values.clear()
    if cell.value == 3i32 && !array_iter_has_next(iterator) && present && missing && values.pop() is Option::None {
      1i32
    } else {
      0i32
    }
  } else {
    unreachable()
  }
}

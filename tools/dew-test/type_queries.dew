fn query_nested_transfer(initial: I32) -> I64 {
  while initial {
    state => {
      let value = match state {
        0 => 42i64
        _ => match state {
          1 => return 43i64
          _ => if state == 2 {
            return 44i64
          } else {
            continue 0i32

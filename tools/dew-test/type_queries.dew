open dew.std.types
open dew.std.array
open dew.std.string
open dew.std.bytes
open dew.std.result

type Nothing = Unit

struct QueryLeft {
  value: I32
}

struct QueryRight {
  value: I32
}

trait QueryMark {
}

impl QueryMark for QueryLeft {
}

struct QueryBox<t> {
  item: t
}

enum QueryMessage<t> {
  Empty
  Value(t, I64)
}

type QueryItem<t> = field_type<QueryBox<t>>("item")

fn query_identity<t>(value: t) -> t {
  value
}

fn query_member_keep<t>(value: field_type<t>("item")) -> field_type<t>("item") {
  value
}

fn query_member_forward<t>(value: field_type<t>("item")) -> field_type<t>("item") {
  query_member_keep::<t>(value)
}

fn query_payload_keep<t>(value: variant_payload_types<t>("Value")) -> variant_payload_types<t>("Value") {
  value
}

fn query_member_reader<t>(value: field_type<t>("item")) -> fn() -> field_type<t>("item") {
  fn() -> field_type<t>("item") {
    value
  }
}

fn query_deferred<t>() -> Bool {
  type_equal::<field_type<t>("item"), I64>()
}

fn query_tick(trace: Array<I32>) -> I32 {
  trace[0u32] = trace[0u32] + 1i32
  trace[0u32]
}

fn query_consume(left: I32, middle: I32, right: I32) -> I32 {
  right
}

fn query_sequence<t>() -> I32 {
  let _ = is_unit::<t>()
  let trace = [0i32]
  query_consume(query_tick(trace), if true {
    return trace[0u32]
  } else {
    return 99i32
  }, query_tick(trace))
}

fn query_return<t>() -> I32 {
  if is_unit::<t>() {
    return 7i32
  } else {
    ()
  }
  8i32
}

fn query_ignore_lambda<t>(value: t) -> Bool {
  true
}

fn query_discarded_lambda<t>() -> Bool {
  if is_unit::<t>() {
    true
  } else {
    let unused = fn(value: field_type<t>("item")) -> Bool {
      false
    }
    query_ignore_lambda(unused)
  }
}

fn query_local_storage<t>() -> I32 {
  if is_unit::<t>() {
    let live = 7i32
    live
  } else {
    let other = 9i64
    if other == 9i64 {
      8i32
    } else {
      0i32
    }
  }
}

fn query_pattern<t>(value: I32) -> I32 {
  let _ = is_unit::<t>()
  match value {
    1i32 => 11i32
    other => other
  }
}

fn query_item(value: QueryItem<I64>) -> field_type<QueryBox<I64>>("item") {
  query_identity::<QueryItem<I64>>(value)
}

fn query_fields<t>() -> Array<String> {
  field_names::<t>()
}

struct QueryEmpty {}

fn query_signed<t>() -> Bool {
  is_signed_integer::<t>()
}

fn query_forward<t>() -> Bool {
  query_signed::<t>()
}

fn query_signed_value<t>(value: t) -> Bool {
  is_signed_integer::<t>()
}

fn query_reader<t>() -> fn(t) -> Bool {
  query_signed_value
}

fn query_branch<t>() -> U32 {
  if is_unit::<t>() {
    static_assert(type_equal::<t, Unit>(), "Unit branch")
    1u32
  } else {
    static_assert(!is_unit::<t>(), "value branch")
    2u32
  }
}

fn query_marked<t>() -> Bool {
  implements::<t, QueryMark>()
}

fn query_lambda<t>() -> U32 {
  let read = fn() -> U32 {
    if is_unit::<t>() {
      3u32
    } else {
      4u32
    }
  }
  read()
}

fn query_typed_lambda<t>(value: t) -> t {
  let read = fn(item: t) -> t {
    let _ = is_unit::<t>()
    item
  }
  read(value)
}

fn query_local_types() -> I64 {
  type Item = field_type<QueryBox<I64>>("item")
  let read = fn(value: Item) -> Item {
    type Inner = Item
    query_identity::<Inner>(value)
  }
  if true {
    type Item = I32
    query_identity::<Item>(1i32)
  } else {
    0i32
  }
  read(query_identity::<Item>(2i64))
}

fn query_capture<t>(value: t) -> t {
  let read = fn() -> t {
    let _ = is_unit::<t>()
    value
  }
  read()
}

fn query_escape<t>(value: t) -> fn() -> t {
  fn() -> t {
    let _ = is_unit::<t>()
    value
  }
}

fn query_mutable<t>(value: t) -> fn(t) -> t {
  let mut stored = value
  fn(next: t) -> t {
    let _ = is_unit::<t>()
    stored = next
    stored
  }
}

fn query_result(ok: Bool) -> Result<Bool, String> {
  if ok {
    Result::Ok(true)
  } else {
    Result::Err("failure")
  }
}

fn query_result_match(ok: Bool) -> Bool {
  match query_result(ok) {
    Result::Ok(value) => value
    Result::Err(message) => message == "failure"
  }
}

fn query_raw_layout<t>() -> Bool {
  size_of::<t>() == 24u32 && align_of::<t>() == 8u32 && field_offset::<t>(2u32) == 8u32
}

fn query_builtin_name(name: Bytes) -> Bool {
  name == b"types.field_type" || name == b"types.variant_payload_types"
}

type DeferredQueryItem<t> = field_type<t>("item")

pub fn main(case: U32) -> Bool {
  if case == 0u32 {
    is_unit::<Nothing>()
  } else if case == 1u32 {
    !is_unit::<Never>() && is_never::<Never>()
  } else if case == 2u32 {
    !type_equal::<I8, I32>()
  } else if case == 3u32 {
    !type_equal::<QueryLeft, QueryRight>()
  } else if case == 4u32 {
    type_equal::<QueryLeft, QueryLeft>()
  } else if case == 5u32 {
    is_integer::<U64>() && !is_integer::<F64>()
  } else if case == 6u32 {
    is_signed_integer::<I8>() && !is_signed_integer::<U8>()
  } else if case == 7u32 {
    is_float::<F64>() && !is_float::<I64>()
  } else if case == 8u32 {
    bit_width::<I16>() == 16u32
  } else if case == 9u32 {
    can_bitcast::<I16x2, U32>() && !can_bitcast::<I32, F32>()
  } else if case == 10u32 {
    !can_bitcast::<QueryLeft, QueryLeft>()
  } else if case == 11u32 {
    lane_count::<U8x16>() == 16u32
  } else if case == 12u32 {
    lane_bit_width::<F64x2>() == 64u32
  } else if case == 13u32 {
    tuple_length::<(Unit, I64, QueryLeft)>() == 3u32
  } else if case == 14u32 {
    type_equal::<(Unit, I64), (Unit, I64)>() &&
      !type_equal::<(Unit, I64), (I64, Unit)>()
  } else if case == 15u32 {
    query_forward::<I8>() && !query_forward::<U8>()
  } else if case == 16u32 {
    query_branch::<Unit>() == 1u32 && query_branch::<I64>() == 2u32
  } else if case == 17u32 {
    query_marked::<QueryLeft>() && !query_marked::<QueryRight>()
  } else if case == 18u32 {
    let signed = query_reader::<I8>()
    let unsigned = query_reader::<U8>()
    signed(1i8) && !unsigned(1u8)
  } else if case == 19u32 {
    query_item(4294967297i64) == 4294967297i64
  } else if case == 20u32 {
    type_equal::<QueryItem<I8>, I8>() && type_equal::<QueryItem<U8>, U8>()
  } else if case == 21u32 {
    let (left, right) = query_identity::<variant_payload_types<QueryMessage<I32>>("Value")>((7i32, 4294967297i64))
    left == 7i32 && right == 4294967297i64
  } else if case == 22u32 {
    tuple_length::<variant_payload_types<QueryMessage<I32>>("Empty")>() == 0u32
  } else if case == 23u32 {
    let names = query_fields::<QueryBox<I32>>()
    names.length() == 1u32 && names[0u32] == "item"
  } else if case == 24u32 {
    let names = variant_names::<QueryMessage<I64>>()
    names.length() == 2u32 && names[0u32] == "Empty" && names[1u32] == "Value"
  } else if case == 25u32 {
    let first = query_fields::<QueryBox<I32>>()
    first[0u32] = "changed"
    let second = query_fields::<QueryBox<I32>>()
    second[0u32] == "item"
  } else if case == 26u32 {
    query_fields::<QueryEmpty>().length() == 0u32
  } else if case == 27u32 {
    size_of::<I8>() == 1u32 && align_of::<I64>() == 8u32
  } else if case == 28u32 {
    size_of::<Unit>() == 0u32 && align_of::<Unit>() == 1u32 && size_of::<V128>() == 16u32
  } else if case == 29u32 {
    static_assert(bit_width::<I16>() == 16u32, "logical width")
    true
  } else if case == 30u32 {
    query_lambda::<Unit>() == 3u32 && query_lambda::<I32>() == 4u32
  } else if case == 31u32 {
    query_local_types() == 2i64
  } else if case == 32u32 {
    query_result_match(true)
  } else if case == 33u32 {
    query_result_match(false)
  } else if case == 34u32 {
    query_raw_layout::<(U8, Unit, I64, (U16, U8))>()
  } else if case == 35u32 {
    field_offset::<(U8, Unit, I64)>(1u32) == 1u32
  } else if case == 36u32 {
    field_offset::<(U8, Unit, I64, (U16, U8))>(3u32) == 16u32
  } else if case == 37u32 {
    size_of::<(Unit, Unit)>() == 0u32 && align_of::<(Unit, Unit)>() == 1u32
  } else if case == 38u32 {
    query_builtin_name(b"types.field_type") && query_builtin_name(b"types.variant_payload_types")
  } else if case == 39u32 {
    !query_builtin_name(b"types.field") && !query_builtin_name(b"types.field_type_extra")
  } else if case == 40u32 {
    query_typed_lambda::<Unit>(())
    query_typed_lambda::<I64>(42i64) == 42i64
  } else if case == 41u32 {
    query_capture::<Unit>(())
    query_capture::<I64>(43i64) == 43i64
  } else if case == 42u32 {
    let read_unit = query_escape::<Unit>(())
    let read_scalar = query_escape::<I64>(44i64)
    read_unit()
    read_scalar() == 44i64
  } else if case == 43u32 {
    let write_unit = query_mutable::<Unit>(())
    let write_scalar = query_mutable::<I64>(1i64)
    write_unit(())
    write_scalar(45i64) == 45i64 && write_scalar(46i64) == 46i64
  } else if case == 44u32 {
    type_equal::<DeferredQueryItem<QueryBox<I64>>, I64>()
  } else if case == 45u32 {
    query_deferred::<QueryBox<I64>>() && !query_deferred::<QueryBox<I32>>()
  } else if case == 46u32 {
    query_sequence::<Unit>() == 1i32 && query_sequence::<I64>() == 1i32
  } else if case == 47u32 {
    query_return::<Unit>() == 7i32 && query_return::<I64>() == 8i32
  } else if case == 48u32 {
    query_local_storage::<Unit>() == 7i32 && query_local_storage::<I32>() == 8i32
  } else if case == 49u32 {
    query_pattern::<Unit>(1i32) == 11i32 && query_pattern::<I64>(2i32) == 2i32
  } else if case == 50u32 {
    query_discarded_lambda::<Unit>()
  } else if case == 51u32 {
    query_member_keep::<QueryBox<I64>>(51i64) == 51i64 && query_member_keep::<QueryBox<I32>>(52i32) == 52i32
  } else if case == 52u32 {
    query_member_forward::<QueryBox<I64>>(53i64) == 53i64
  } else if case == 53u32 {
    query_member_keep::<QueryBox<Unit>>(())
    true
  } else if case == 54u32 {
    let (left, right) = query_payload_keep::<QueryMessage<I32>>((54i32, 55i64))
    left == 54i32 && right == 55i64
  } else if case == 55u32 {
    let read_unit = query_member_reader::<QueryBox<Unit>>(())
    let read_scalar = query_member_reader::<QueryBox<I64>>(56i64)
    read_unit()
    read_scalar() == 56i64
  } else {
    false
  }
}

open dew.std.preamble
open dew.std.string
open dew.std.bytes
open dew.std.option
open dew.std.text_runtime

fn view_result(value: Bool) -> I32 {
  if value {
    1i32
  } else {
    0i32
  }
}

pub fn main(case: U32) -> I32 {
  if case == 0u32 {
    let empty = "".view(0u32, 0u32)
    let value = "!abc?".view(1u32, 3u32)
    view_result(empty.equals(empty) && empty.utf16_length() == 0u32 && value.starts_with(empty) && value.ends_with(empty) && value.find(empty) is Option::Some(0u32) && empty.find(value) is Option::None && !empty.starts_with(value) && !empty.ends_with(value))
  } else if case == 1u32 {
    let left = "!0123456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 48u32)
    let right = "--0123456789abcdef0123456789abcdef0123456789abcdef--".view(2u32, 48u32)
    if !left.as_bytes().equals(right.as_bytes()) {
      return -6i32
    }
    if !left.equals(right) {
      return -5i32
    }
    if !(left == right) {
      return -1i32
    }
    if left.hash() != right.hash() {
      return -2i32
    }
    if left.hash() != left.as_bytes().hash() {
      return -3i32
    }
    if !(left != "0123456789abcdef0123456789abcdef0123456789abcdeg".view(0u32, 48u32)) {
      return -4i32
    }
    1i32
  } else if case == 2u32 {
    let value = "!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabaaaab?".view(1u32, 38u32)
    let needle = "!aaaab?".view(1u32, 5u32)
    view_result(value.find(needle) is Option::Some(29u32) && value.find_string("ab") is Option::Some(32u32) && !value.contains_string("ac") && value.contains(needle))
  } else if case == 3u32 {
    let value = "!0123456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 48u32)
    let needle = "!456789abcdef0123456789abcdef0123456789abcdef?".view(1u32, 44u32)
    view_result(value.find(needle) is Option::Some(4u32) && value.find_string("456789abcdef0123456789abcdef0123456789abcdeg") is Option::None && value.find(value) is Option::Some(0u32))
  } else if case == 4u32 {
    let value = "!λ0123456789abcdef🌍?".view(1u32, 22u32)
    view_result(value.starts_with("!λ012?".view(1u32, 5u32)) && value.starts_with_string("λ012") && value.ends_with("!def🌍?".view(1u32, 7u32)) && value.ends_with_string("def🌍") && !value.starts_with_string("λ013") && !value.ends_with_string("deg🌍"))
  } else if case == 5u32 {
    let source = "0123456789abcdef0123456789abcdefλ🌍€"
    while 0u32 {
      offset if offset <= 32u32 => {
        let view = source.view(offset, source.byte_length() - offset)
        if view.utf16_length() != 36u32 - offset || view.hash() != view.as_bytes().hash() {
          return 0i32
        }
        continue offset + 1u32
      }
      _ => break ()
    }
    1i32
  } else if case == 6u32 {
    let view = "!🌍🌍🌍🌍🌍🌍🌍🌍λ€?".view(1u32, 37u32)
    view_result(view.utf16_length() == 18u32 && view.find_string("λ€") is Option::Some(32u32) && view.hash() == view.as_bytes().hash())
  } else if case == 7u32 {
    let nested = "!!λhello🌍??".view(2u32, 11u32).view(2u32, 9u32)
    view_result(nested.to_string() == "hello🌍" && nested.utf16_length() == 7u32 && nested.find_string("🌍") is Option::Some(5u32) && nested.starts_with_string("hello") && nested.ends_with_string("🌍"))
  } else if case == 8u32 {
    let view = "!!λ0123456789abcdef🌍??".view(2u32, 22u32).view(2u32, 20u32)
    let text = view.to_string()
    view_result(view.byte_length() == 20u32 && view.byte_at(0u32) == 48u8 && view.byte_at(15u32) == 102u8 && view.byte_at(16u32) == 240u8 && view.byte_at(19u32) == 141u8 && text == "0123456789abcdef🌍" && text.byte_length() == view.byte_length() && "".view(0u32, 0u32).to_string() == "")
  } else if case == 9u32 {
    "!x?".view(1u32, 1u32).byte_at(1u32)
    0i32
  } else if case == 10u32 {
    "!x?".view(1u32, 1u32).byte_at(4294967295u32)
    0i32
  } else if case == 11u32 {
    "!x?".view(1u32, 0u32).byte_at(0u32)
    0i32
  } else if case == 12u32 {
    let cast = view_bytes_operation()
    let view = "!!λ😀??".view(1u32, 8u32).view(1u32, 6u32)
    view_result(cast(view) == b"\xce\xbb\xf0\x9f\x98\x80" && cast("".view(0u32, 0u32)) == b"" && view.to_string() == "λ😀")
  } else if case == 13u32 {
    view_result(view_into_bytes("!λ😀?".view(1u32, 6u32)) == b"\xce\xbb\xf0\x9f\x98\x80")
  } else if case == 14u32 {
    view_result("0123456789abcdef".view(16u32, 0u32).byte_length() == 0u32)
  } else if case == 15u32 {
    view_result("0123456789abcdef".view(0u32, 16u32).view(16u32, 0u32).byte_length() == 0u32)
  } else if case == 16u32 {
    view_result(string_range_operation()("0123456789abcdef0123456789abcdef", 32u32, 0u32).byte_length() == 0u32)
  } else if case == 17u32 {
    let view = string_range_operation()("!!λ😀??", 1u32, 8u32)
    view_result(view_range_operation()(view, 1u32, 6u32).to_string() == "λ😀")
  } else if case == 18u32 {
    string_range_operation()("λ", 1u32, 1u32)
    0i32
  } else if case == 19u32 {
    string_range_operation()("λ", 0u32, 1u32)
    0i32
  } else if case == 20u32 {
    view_range_operation()("λ😀".view(0u32, 6u32), 3u32, 0u32)
    0i32
  } else if case == 21u32 {
    string_range_operation()("x", 0u32, 2u32)
    0i32
  } else if case == 22u32 {
    string_range_operation()("x", 4294967295u32, 0u32)
    0i32
  } else if case == 23u32 {
    let log = StringViewLog::{
      value: 0u32
    }
    let view = string_range_operation()(string_range_input(log), string_range_start(log), string_range_length(log))
    view_result(view.to_string() == "bc" && log.value == 123u32)
  } else if case == 24u32 {
    view_result("".view(0u32, 0u32).view(0u32, 0u32).byte_length() == 0u32)
  } else if case == 25u32 {
    view_result(string_range_operation()("aaaaaaaaaaaaaaλ", 16u32, 0u32).byte_length() == 0u32)
  } else {
    unreachable()
  }
}

fn view_bytes_operation() -> fn(StringView) -> Bytes {
  string_view_as_bytes_unchecked
}

fn string_range_operation() -> fn(String, U32, U32) -> StringView {
  string_view
}

fn view_range_operation() -> fn(StringView, U32, U32) -> StringView {
  string_view_view
}

struct StringViewLog {
  mut value: U32
}

fn string_range_input(log: StringViewLog) -> String {
  log.value = log.value * 10u32 + 1u32
  "abcd"
}

fn string_range_start(log: StringViewLog) -> U32 {
  log.value = log.value * 10u32 + 2u32
  1u32
}

fn string_range_length(log: StringViewLog) -> U32 {
  log.value = log.value * 10u32 + 3u32
  2u32
}

fn view_into_bytes(value: StringView) -> Bytes {
  value.into()
}

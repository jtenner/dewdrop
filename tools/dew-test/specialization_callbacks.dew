fn identity<t>(value: t) -> t {
  value
}

// This shared single-module fixture has no standard-module imports.
// Match the public Result declaration to exercise ordinary enum storage.
enum Result<t, e> {
  Ok(t)
  Err(e)
}

fn result_ok<t, e>(value: t) -> Result<t, e> {
  Result::Ok(value)
}

fn result_err<t, e>(value: e) -> Result<t, e> {
  Result::Err(value)
}

pub fn result_ok_callback(value: I64) -> I64 {
  match result_ok::<I64, I32>(value) {
    Result::Ok(item) => item
    Result::Err(_) => 0i64
  }
}

pub fn result_err_callback(value: I64) -> I64 {
  match result_err::<I32, I64>(value) {
    Result::Err(item) => item
    Result::Ok(_) => 0i64
  }
}

pub fn result_nested_callback(value: I64) -> I64 {
  match result_err::<I32, Result<I64, I32>>(result_ok::<I64, I32>(value)) {
    Result::Err(Result::Ok(item)) => item
    _ => 0i64
  }
}

pub fn result_unit_callback(value: I64) -> I64 {
  let mut count = 0i32
  let tick = fn() -> Unit {
    count = count + 1i32
  }
  let first = result_ok::<Unit, I64>(tick())
  let second = result_err::<I64, Unit>(tick())
  match first {
    Result::Ok(effect) => {
      let _ = effect
      match second {
        Result::Err(other) => {
          let _ = other
          if count == 2i32 {
            value
          } else {
            0i64
          }
        }
        _ => 0i64
      }
    }
    _ => 0i64
  }
}

pub fn result_reference_callback(value: I64) -> I64 {
  match result_err::<I32, Item>(Item::{
    value: value
  }) {
    Result::Err(item) => item.value
    _ => 0i64
  }
}

pub fn result_function_callback(value: I64) -> I64 {
  match result_err::<I32, fn(I64) -> I64>(reader::<I64>()) {
    Result::Err(callback) => callback(value)
    _ => 0i64
  }
}

pub fn result_vector_callback(value: I64) -> I64 {
  match result_err::<I64, I32x4>(enum_vector_splat(7i32)) {
    Result::Err(vector) => {
      if enum_vector_lane(vector) == 7i32 {
        value
      } else {
        0i64
      }
    }
    _ => 0i64
  }
}

pub fn result_float_callback(value: I64) -> I64 {
  match result_ok::<F32, F64>(1.25f32) {
    Result::Ok(left) => {
      match result_err::<F32, F64>(2.5f64) {
        Result::Err(right) => {
          if left == 1.25f32 && right == 2.5f64 {
            value
          } else {
            0i64
          }
        }
        _ => 0i64
      }
    }
    _ => 0i64
  }
}

enum ReorderedResult<a, b> {
  Ok(b)
  Err(a)
}

fn reordered_ok(value: I64) -> ReorderedResult<I32, I64> {
  ReorderedResult::Ok(value)
}

fn reordered_err(value: I64) -> ReorderedResult<I64, I32> {
  ReorderedResult::Err(value)
}

pub fn result_name_collision_callback(value: I64) -> I64 {
  let first = reordered_ok(value)
  let second = reordered_err(value)
  match first {
    ReorderedResult::Ok(left) => {
      match second {
        ReorderedResult::Err(right) => {
          if left == right {
            right
          } else {
            0i64
          }
        }
        _ => 0i64
      }
    }
    _ => 0i64
  }
}

enum GenericEnvelope<t> {
  Hold(t)
  Empty
}

fn envelope<t>(value: t) -> GenericEnvelope<t> {
  GenericEnvelope::Hold(value)
}

pub fn generic_enum_callback(value: I64) -> I64 {
  match envelope(value) {
    GenericEnvelope::Hold(item) => item
    GenericEnvelope::Empty => 0i64
  }
}

fn read_envelope<t>(source: GenericEnvelope<t>, fallback: t) -> t {
  match source {
    GenericEnvelope::Hold(item) => item
    GenericEnvelope::Empty => fallback
  }
}

pub fn generic_enum_reader_callback(value: I64) -> I64 {
  read_envelope(envelope(value), 0i64)
}

pub fn generic_enum_nested_callback(value: I64) -> I64 {
  match envelope(envelope(value)) {
    GenericEnvelope::Hold(GenericEnvelope::Hold(item)) => item
    _ => 0i64
  }
}

enum MixedEnvelope<a, b> {
  Entry(I32, a, Unit, b)
}

pub fn generic_enum_mixed_callback(value: I64) -> I64 {
  match MixedEnvelope::Entry(7i32, value, (), 9i32) {
    MixedEnvelope::Entry(prefix, item, effect, suffix) => {
      let _ = effect
      if prefix == 7i32 && suffix == 9i32 {
        item
      } else {
        0i64
      }
    }
  }
}

pub fn generic_enum_reference_callback(value: I64) -> I64 {
  match envelope(Item::{
    value: value
  }) {
    GenericEnvelope::Hold(item) => item.value
    GenericEnvelope::Empty => 0i64
  }
}

pub fn generic_enum_unit_callback(value: I64) -> I64 {
  match envelope(()) {
    GenericEnvelope::Hold(effect) => {
      let _ = effect
      value
    }
    GenericEnvelope::Empty => 0i64
  }
}

pub fn generic_enum_float_callback(value: I64) -> I64 {
  match MixedEnvelope::Entry(7i32, 1.25f32, (), 2.5f64) {
    MixedEnvelope::Entry(prefix, left, effect, right) => {
      let _ = effect
      if prefix == 7i32 && left == 1.25f32 && right == 2.5f64 {
        value
      } else {
        0i64
      }
    }
  }
}

builtin enum_vector_splat(value: I32) -> I32x4 = "i32x4.splat"
builtin enum_vector_lane(value: I32x4) -> I32 = "i32x4.extract_lane 0"

pub fn generic_enum_vector_callback(value: I64) -> I64 {
  match envelope(enum_vector_splat(7i32)) {
    GenericEnvelope::Hold(vector) => {
      if enum_vector_lane(vector) == 7i32 {
        value
      } else {
        0i64
      }
    }
    GenericEnvelope::Empty => 0i64
  }
}

pub fn generic_enum_function_callback(value: I64) -> I64 {
  match envelope(reader::<I64>()) {
    GenericEnvelope::Hold(callback) => callback(value)
    GenericEnvelope::Empty => 0i64
  }
}

pub fn generic_enum_literal_callback(value: I64) -> I64 {
  match envelope(envelope(7i32)) {
    GenericEnvelope::Hold(GenericEnvelope::Hold(7i32)) => value
    _ => 0i64
  }
}

pub fn generic_enum_empty_callback(value: I64) -> I64 {
  read_envelope::<I64>(GenericEnvelope::Empty, value)
}

pub fn generic_enum_unit_reader_callback(value: I64) -> I64 {
  let effect = read_envelope(envelope(()), ())
  let _ = effect
  value
}

struct EnumEvaluationTrace {
  mut order: I32
}

fn enum_evaluation_step(trace: EnumEvaluationTrace, digit: I32) -> I32 {
  trace.order = trace.order * 10i32 + digit
  digit
}

fn enum_evaluation_payload(trace: EnumEvaluationTrace, value: I64) -> I64 {
  let _ = enum_evaluation_step(trace, 2i32)
  value
}

fn enum_evaluation_effect(trace: EnumEvaluationTrace) -> Unit {
  let _ = enum_evaluation_step(trace, 3i32)
}

pub fn generic_enum_order_callback(value: I64) -> I64 {
  let trace = EnumEvaluationTrace::{
    order: 0i32
  }
  let payload = MixedEnvelope::Entry(
    enum_evaluation_step(trace, 1i32),
    enum_evaluation_payload(trace, value),
    enum_evaluation_effect(trace),
    enum_evaluation_step(trace, 4i32),
  )
  match payload {
    MixedEnvelope::Entry(prefix, item, effect, suffix) => {
      let _ = effect
      if trace.order == 1234i32 && prefix == 1i32 && suffix == 4i32 {
        item
      } else {
        0i64
      }
    }
  }
}

fn reader<t>() -> fn(t) -> t {
  identity
}

fn readers<a, b>() -> (fn(a) -> a, fn(b) -> b) {
  (identity, identity)
}

struct Item {
  value: I64
}

fn item_reader() -> fn(Item) -> Item {
  identity
}

pub fn nominal_callback(value: I64) -> I64 {
  let callback = item_reader()
  callback(Item::{
    value: value
  }).value
}

pub fn generic_nominal_callback(value: I64) -> I64 {
  let callback = reader::<Item>()
  callback(Item::{
    value: value
  }).value
}

fn captured_reader<t>(held: t) -> fn(t) -> t {
  fn(value: t) -> t {
    held
  }
}

fn captured_item_reader(held: Item) -> fn(Item) -> Item {
  fn(value: Item) -> Item {
    held
  }
}

pub fn captured_nominal_callback(value: I64) -> I64 {
  let callback = captured_item_reader(Item::{
    value: value
  })
  callback(Item::{
    value: 0i64
  }).value
}

pub fn captured_generic_nominal_callback(value: I64) -> I64 {
  let callback = captured_reader::<Item>(Item::{
    value: value
  })
  callback(Item::{
    value: 0i64
  }).value
}

fn unit_middle(left: I32, effect: Unit, right: I64) -> I64 {
  if left == 1i32 {
    right
  } else {
    0i64
  }
}

pub fn callback_evaluation_order(value: I64) -> I64 {
  let mut order = 0i32
  let callback = unit_middle
  let first = fn() -> I32 {
    order = order * 10i32 + 1i32
    1i32
  }
  let second = fn() -> Unit {
    order = order * 10i32 + 2i32
  }
  let third = fn() -> I64 {
    order = order * 10i32 + 3i32
    value
  }
  let result = callback(first(), second(), third())
  if order == 123i32 {
    result
  } else {
    0i64
  }
}

pub fn pair_i32_i64(left: I32, right: I64) -> I64 {
  let callback = reader::<(I32, I64)>()
  let (_, selected) = callback((left, right))
  selected
}

pub fn pair_i64_i32(left: I64, right: I32) -> I64 {
  let callback = reader::<(I64, I32)>()
  let (selected, _) = callback((left, right))
  selected
}

pub fn nested_i32_i64(left: I32, right: I64) -> I64 {
  let callback = reader::<(I32, (I64, I32))>()
  let (_, (selected, _)) = callback((left, (right, left)))
  selected
}

pub fn nested_i64_i32(left: I64, right: I32) -> I64 {
  let callback = reader::<((I32, I64), I32)>()
  let ((_, selected), _) = callback(((right, left), right))
  selected
}

pub fn erased_product(value: I64) -> I64 {
  let callback = reader::<(Unit, I64, Unit)>()
  let (_, selected, _) = callback(((), value, ()))
  selected
}

pub fn mixed_scalars(value: I64) -> I64 {
  let (left, right) = readers::<I32, I64>()
  if left(7i32) == 7i32 {
    right(value)
  } else {
    0i64
  }
}
trait FirstRead {
  fn read(self) -> I64
}

trait SecondRead {
  fn read(self) -> I64
}

impl FirstRead for I64 {
  fn read(self) -> I64 {
    self
  }
}

impl SecondRead for I64 {
  fn read(self) -> I64 {
    self + 1i64
  }
}

fn first_read<t: FirstRead>(value: t) -> I64 {
  value.read()
}

fn second_read<t: SecondRead>(value: t) -> I64 {
  value.read()
}

fn first_reader() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    first_read(value)
  }
}

fn second_reader() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    second_read(value)
  }
}

pub fn trait_identity_callback(value: I64) -> I64 {
  let first = first_reader()
  let second = second_reader()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

fn first_generic_reader<t: FirstRead>() -> fn(t) -> I64 {
  first_read
}

fn second_generic_reader<t: SecondRead>() -> fn(t) -> I64 {
  second_read
}

pub fn first_generic_lambda<t: FirstRead>() -> fn(t) -> I64 {
  fn(value: t) -> I64 {
    first_read(value)
  }
}

pub fn second_generic_lambda<t: SecondRead>() -> fn(t) -> I64 {
  fn(value: t) -> I64 {
    second_read(value)
  }
}

pub fn bound_function_callback(value: I64) -> I64 {
  let first = first_generic_reader::<I64>()
  let second = second_generic_reader::<I64>()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

pub fn bound_lambda_callback(value: I64) -> I64 {
  let first = first_generic_lambda::<I64>()
  let second = second_generic_lambda::<I64>()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

fn invoke_bound_callback(callback: fn(I64) -> I64, value: I64) -> I64 {
  callback(value)
}

pub fn direct_bound_callback(value: I64) -> I64 {
  if invoke_bound_callback(second_read, value) == value + 1i64 {
    invoke_bound_callback(first_read, value)
  } else {
    0i64
  }
}

pub fn closed_generic_lambda<t: FirstRead>() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    direct_bound_callback(value)
  }
}

pub fn closed_bound_callback(value: I64) -> I64 {
  let callback = closed_generic_lambda::<I64>()
  callback(value)
}

fn nested_capture_reader(value: I64) -> fn() -> fn() -> I64 {
  fn() -> fn() -> I64 {
    fn() -> I64 {
      value
    }
  }
}

pub fn nested_capture_callback(value: I64) -> I64 {
  let outer = nested_capture_reader(value)
  let inner = outer()
  inner()
}

fn nested_mutable_reader(value: I64) -> fn() -> fn() -> I64 {
  let mut held = value
  fn() -> fn() -> I64 {
    fn() -> I64 {
      held = held + 1i64
      held
    }
  }
}

pub fn nested_mutable_capture_callback(value: I64) -> I64 {
  let outer = nested_mutable_reader(value)
  let first = outer()
  let second = outer()
  let left = first()
  let right = second()
  if left == value + 1i64 && right == value + 2i64 {
    right - 2i64
  } else {
    0i64
  }
}

fn erased_capture_reader(left: I32, effect: Unit, right: I64) -> fn() -> I64 {
  fn() -> I64 {
    effect
    if left == 1i32 {
      right
    } else {
      0i64
    }
  }
}

pub fn erased_capture_callback(value: I64) -> I64 {
  let mut order = 0i32
  let tick = fn() -> Unit {
    order = order + 1i32
  }
  let reader = erased_capture_reader(1i32, tick(), value)
  let result = reader()
  if order == 1i32 {
    result
  } else {
    0i64
  }
}

fn packed_capture_reader(low: I8, high: U8, value: I64) -> fn() -> I64 {
  fn() -> I64 {
    if low == -1i8 && high == 255u8 {
      value
    } else {
      0i64
    }
  }
}

pub fn packed_capture_callback(value: I64) -> I64 {
  let reader = packed_capture_reader(-1i8, 255u8, value)
  reader()
}

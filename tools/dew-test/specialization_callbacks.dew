fn identity<t>(value: t) -> t {
  value
}

fn reader<t>() -> fn(t) -> t {
  identity
}

fn readers<a, b>() -> (fn(a) -> a, fn(b) -> b) {
  (identity, identity)
}

struct Item {
  value: I64
}

fn item_reader() -> fn(Item) -> Item {
  identity
}

pub fn nominal_callback(value: I64) -> I64 {
  let callback = item_reader()
  callback(Item::{
    value: value
  }).value
}

pub fn generic_nominal_callback(value: I64) -> I64 {
  let callback = reader::<Item>()
  callback(Item::{
    value: value
  }).value
}

fn captured_reader<t>(held: t) -> fn(t) -> t {
  fn(value: t) -> t {
    held
  }
}

fn captured_item_reader(held: Item) -> fn(Item) -> Item {
  fn(value: Item) -> Item {
    held
  }
}

pub fn captured_nominal_callback(value: I64) -> I64 {
  let callback = captured_item_reader(Item::{
    value: value
  })
  callback(Item::{
    value: 0i64
  }).value
}

pub fn captured_generic_nominal_callback(value: I64) -> I64 {
  let callback = captured_reader::<Item>(Item::{
    value: value
  })
  callback(Item::{
    value: 0i64
  }).value
}

fn unit_middle(left: I32, effect: Unit, right: I64) -> I64 {
  if left == 1i32 {
    right
  } else {
    0i64
  }
}

pub fn callback_evaluation_order(value: I64) -> I64 {
  let mut order = 0i32
  let callback = unit_middle
  let first = fn() -> I32 {
    order = order * 10i32 + 1i32
    1i32
  }
  let second = fn() -> Unit {
    order = order * 10i32 + 2i32
  }
  let third = fn() -> I64 {
    order = order * 10i32 + 3i32
    value
  }
  let result = callback(first(), second(), third())
  if order == 123i32 {
    result
  } else {
    0i64
  }
}

pub fn pair_i32_i64(left: I32, right: I64) -> I64 {
  let callback = reader::<(I32, I64)>()
  let (_, selected) = callback((left, right))
  selected
}

pub fn pair_i64_i32(left: I64, right: I32) -> I64 {
  let callback = reader::<(I64, I32)>()
  let (selected, _) = callback((left, right))
  selected
}

pub fn nested_i32_i64(left: I32, right: I64) -> I64 {
  let callback = reader::<(I32, (I64, I32))>()
  let (_, (selected, _)) = callback((left, (right, left)))
  selected
}

pub fn nested_i64_i32(left: I64, right: I32) -> I64 {
  let callback = reader::<((I32, I64), I32)>()
  let ((_, selected), _) = callback(((right, left), right))
  selected
}

pub fn erased_product(value: I64) -> I64 {
  let callback = reader::<(Unit, I64, Unit)>()
  let (_, selected, _) = callback(((), value, ()))
  selected
}

pub fn mixed_scalars(value: I64) -> I64 {
  let (left, right) = readers::<I32, I64>()
  if left(7i32) == 7i32 {
    right(value)
  } else {
    0i64
  }
}
trait FirstRead {
  fn read(self) -> I64
}

trait SecondRead {
  fn read(self) -> I64
}

impl FirstRead for I64 {
  fn read(self) -> I64 {
    self
  }
}

impl SecondRead for I64 {
  fn read(self) -> I64 {
    self + 1i64
  }
}

fn first_read<t: FirstRead>(value: t) -> I64 {
  value.read()
}

fn second_read<t: SecondRead>(value: t) -> I64 {
  value.read()
}

fn first_reader() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    first_read(value)
  }
}

fn second_reader() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    second_read(value)
  }
}

pub fn trait_identity_callback(value: I64) -> I64 {
  let first = first_reader()
  let second = second_reader()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

fn first_generic_reader<t: FirstRead>() -> fn(t) -> I64 {
  first_read
}

fn second_generic_reader<t: SecondRead>() -> fn(t) -> I64 {
  second_read
}

pub fn first_generic_lambda<t: FirstRead>() -> fn(t) -> I64 {
  fn(value: t) -> I64 {
    first_read(value)
  }
}

pub fn second_generic_lambda<t: SecondRead>() -> fn(t) -> I64 {
  fn(value: t) -> I64 {
    second_read(value)
  }
}

pub fn bound_function_callback(value: I64) -> I64 {
  let first = first_generic_reader::<I64>()
  let second = second_generic_reader::<I64>()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

pub fn bound_lambda_callback(value: I64) -> I64 {
  let first = first_generic_lambda::<I64>()
  let second = second_generic_lambda::<I64>()
  if second(value) == value + 1i64 {
    first(value)
  } else {
    0i64
  }
}

fn invoke_bound_callback(callback: fn(I64) -> I64, value: I64) -> I64 {
  callback(value)
}

pub fn direct_bound_callback(value: I64) -> I64 {
  if invoke_bound_callback(second_read, value) == value + 1i64 {
    invoke_bound_callback(first_read, value)
  } else {
    0i64
  }
}

pub fn closed_generic_lambda<t: FirstRead>() -> fn(I64) -> I64 {
  fn(value: I64) -> I64 {
    direct_bound_callback(value)
  }
}

pub fn closed_bound_callback(value: I64) -> I64 {
  let callback = closed_generic_lambda::<I64>()
  callback(value)
}

fn nested_capture_reader(value: I64) -> fn() -> fn() -> I64 {
  fn() -> fn() -> I64 {
    fn() -> I64 {
      value
    }
  }
}

pub fn nested_capture_callback(value: I64) -> I64 {
  let outer = nested_capture_reader(value)
  let inner = outer()
  inner()
}

fn nested_mutable_reader(value: I64) -> fn() -> fn() -> I64 {
  let mut held = value
  fn() -> fn() -> I64 {
    fn() -> I64 {
      held = held + 1i64
      held
    }
  }
}

pub fn nested_mutable_capture_callback(value: I64) -> I64 {
  let outer = nested_mutable_reader(value)
  let first = outer()
  let second = outer()
  let left = first()
  let right = second()
  if left == value + 1i64 && right == value + 2i64 {
    right - 2i64
  } else {
    0i64
  }
}

fn erased_capture_reader(left: I32, effect: Unit, right: I64) -> fn() -> I64 {
  fn() -> I64 {
    effect
    if left == 1i32 {
      right
    } else {
      0i64
    }
  }
}

pub fn erased_capture_callback(value: I64) -> I64 {
  let mut order = 0i32
  let tick = fn() -> Unit {
    order = order + 1i32
  }
  let reader = erased_capture_reader(1i32, tick(), value)
  let result = reader()
  if order == 1i32 {
    result
  } else {
    0i64
  }
}

fn packed_capture_reader(low: I8, high: U8, value: I64) -> fn() -> I64 {
  fn() -> I64 {
    if low == -1i8 && high == 255u8 {
      value
    } else {
      0i64
    }
  }
}

pub fn packed_capture_callback(value: I64) -> I64 {
  let reader = packed_capture_reader(-1i8, 255u8, value)
  reader()
}

// Emission and runtime probe. Compiled beside the exact common source.
pub fn plan_plain() -> BTreePlan {
  btree_plan::<String, U64, BTreeStoragePlain>(BTreeStoragePlain::{
  }, btree_default_config())
}
pub fn make_plain(plan: BTreePlan) -> BTreeNode<String, U64> {
  btree_node_new::<String, U64>(plan, false)
}
pub fn clear_plain(node: BTreeNode<String, U64>, plan: BTreePlan) -> Unit {
  btree_node_clear(node, plan)
}

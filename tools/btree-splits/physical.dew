pub fn split_work_hinted(work: BTreeWork<I32, I64>) -> Bool {
  work.hinted
}
pub fn split_numeric_drop_hint(tree: BTree<I32, I64, NaturalComparator>) -> Unit {
  match tree.work {
    Option::Some(work) => {
      btree_clear_slots(work.nodes, 15u32, 1u32, 1u32)
      work.hinted = false
    }
    _ => ()
  }
}
pub fn split_numeric_branch(node: BTreeNode<I32, I64>) -> Bool {
  btree_is_branch(node)

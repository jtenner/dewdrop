  match node.body {
    BTreeBody::PlainLeaf(body) => body.values
    _ => unreachable()
  }
}
pub fn split_numeric_children(node: BTreeNode<I32, I64>) -> WasmArray<BTreeNode<I32, I64>> {
  match node.body {
    BTreeBody::PlainBranch(body) => body.children
    _ => unreachable()
  }
}
pub fn split_cost_lookup(tree: BTree<I32, I64, NaturalComparator>, population: U32, count: U32) -> I64 {
  let mut i = 0u32
  let mut sum = 0i64
  while true {
    true if i < count => {
      let ordinal = (i * 7919u32) % population
      let key = unsafe_bitcast::<U32, I32>(ordinal * 2u32 + (i & 1u32))
      sum = sum + split_numeric_lookup(tree, key)
      i = i + 1u32
      continue true
    }
    _ => break sum
  }
}
pub fn split_cost_replace(tree: BTree<I32, I64, NaturalComparator>, population: U32, count: U32) -> U32 {
  let mut i = 0u32
  let mut added = 0u32
  while true {
    true if i < count => {
      let key = unsafe_bitcast::<U32, I32>(((i * 7919u32) % population) * 2u32)
      added = added + unsafe_bitcast::<Bool, U32>(btree_insert(tree, key, 7i64))
      i = i + 1u32
      continue true
    }
    _ => break added
  }
}
pub fn split_cost_build(count: U32, mode: U32, disable_hint: Bool) -> U32 {
  let tree = btree_plain_new::<I32, I64, NaturalComparator>(natural_comparator(), btree_config(1024u32, 64u32, 64u32))
  let mut i = 0u32
  while true {
    true if i < count => {
      if disable_hint {
        split_numeric_drop_hint(tree)
      }
      let ordinal = if mode == 0u32 {
        i
      } else {
        split_permutation(i, count)
      }
      btree_set(tree, unsafe_bitcast::<U32, I32>(ordinal * 2u32), 7i64)
      i = i + 1u32
      continue true
    }
    _ => break tree.length
  }
}
struct BTreeSplitRef {
  private order: I32
}
struct BTreeSplitRefCompare {
}
impl Comparator<BTreeSplitRef> for BTreeSplitRefCompare {
  fn compare(self, left: BTreeSplitRef, right: BTreeSplitRef) -> Ordering {
    if left.order < right.order {
      Ordering::Less
    } else if left.order > right.order {
      Ordering::Greater
    } else {
      Ordering::Equal
    }
  }
}
pub fn split_ref_make(count: U32, mode: U32) -> BTree<BTreeSplitRef, BTreeSplitRef, BTreeSplitRefCompare> {
  let tree = btree_plain_new::<BTreeSplitRef, BTreeSplitRef, BTreeSplitRefCompare>(BTreeSplitRefCompare::{
  }, btree_config(1024u32, 64u32, 64u32))
  let mut i = 0u32
  while true {
    true if i < count => {
      let ordinal = if mode == 0u32 {
        i
      } else if mode == 1u32 {
        count - i - 1u32
      } else {
        split_permutation(i, count)
      }
      btree_set(tree, BTreeSplitRef::{
        order: unsafe_bitcast::<U32, I32>(ordinal * 2u32)
      }, BTreeSplitRef::{
        order: unsafe_bitcast::<U32, I32>(ordinal * 6u32 + 100u32)
      })
      i = i + 1u32
      continue true
    }
    _ => break tree
  }
}

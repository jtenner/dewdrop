}
pub fn split_numeric_length_set(tree: BTree<I32, I64, NaturalComparator>, length: U32) -> Unit {
  tree.length = length
}
pub fn split_numeric_clear(tree: BTree<I32, I64, NaturalComparator>) -> Unit {
  btree_clear(tree)
}

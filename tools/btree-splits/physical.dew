fn split_permutation(index: U32, count: U32) -> U32 {
  let ordinal = (btree_widen(index) * 7919u64) % btree_widen(count)
  ordinal.into()
}
// Original modules provide runtime samples; instrumented copies inspect slots.
fn split_numeric_build(count: U32, mode: U32) -> BTree<I32, I64, NaturalComparator> {
  let tree = btree_plain_new::<I32, I64, NaturalComparator>(natural_comparator(), btree_config(1024u32, 64u32, 64u32))
  let mut i = 0u32
  while true {
    true if i < count => {
      let ordinal = if mode == 0u32 {
        i
      } else if mode == 1u32 {
        count - i - 1u32
      } else {
        split_permutation(i, count)
      }
      btree_set(tree, unsafe_bitcast::<U32, I32>(ordinal * 2u32), unsafe_bitcast::<U64, I64>(btree_widen(ordinal * 3u32 + 100u32)))
      i = i + 1u32
      continue true
    }
    _ => break tree
  }
}
pub fn split_numeric_make(count: U32, mode: U32) -> BTree<I32, I64, NaturalComparator> {
  split_numeric_build(count, mode)
}
pub fn split_numeric_insert(tree: BTree<I32, I64, NaturalComparator>, key: I32, value: I64) -> Bool {
  btree_insert(tree, key, value)
}
pub fn split_numeric_put(tree: BTree<I32, I64, NaturalComparator>, key: I32, value: I64) -> Option<I64> {
  btree_put(tree, key, value)
}
pub fn split_numeric_lookup(tree: BTree<I32, I64, NaturalComparator>, key: I32) -> I64 {
  match btree_get(tree, key) {
    Option::Some(value) => value
    Option::None => -1i64
  }
}
pub fn split_numeric_contains(tree: BTree<I32, I64, NaturalComparator>, key: I32) -> Bool {
  btree_contains(tree, key)
}

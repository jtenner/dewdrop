  match tree.root {
    Option::Some(_) => true
    _ => false
  }
}
pub fn split_numeric_root(tree: BTree<I32, I64, NaturalComparator>) -> BTreeNode<I32, I64> {
  match tree.root {
    Option::Some(node) => node
    _ => unreachable()
  }
}
pub fn split_numeric_has_work(tree: BTree<I32, I64, NaturalComparator>) -> Bool {
  match tree.work {
    Option::Some(_) => true
    _ => false
  }
}
pub fn split_numeric_work(tree: BTree<I32, I64, NaturalComparator>) -> BTreeWork<I32, I64> {
  match tree.work {
    Option::Some(work) => work
    _ => unreachable()
  }
}
pub fn split_work_nodes(work: BTreeWork<I32, I64>) -> WasmArray<BTreeNode<I32, I64>> {

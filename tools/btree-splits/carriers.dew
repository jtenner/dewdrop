}

fn split_carrier_head_key<v>(tree: BTree<I32, v, NaturalComparator>) -> I32 {
  match tree.root {
    Option::Some(root) => {
      if !btree_is_branch(root) {
        assert(false, "carrier probe must reach a branch separator")
      }
      btree_node_key(root, 0u32, false)
    }
    _ => unreachable()
  }
}

// Concrete probe boundaries expose every value carrier without a Default bound.
pub fn split_carrier_make_i32() -> BTree<I32, I32, NaturalComparator> {
  let tree = btree_plain_new::<I32, I32, NaturalComparator>(natural_comparator(), btree_config(1024u32, 64u32, 64u32))
  btree_set(tree, 1i32, 7i32)
  let mut i = 0u32
  while true {
    true if i < 2000u32 => {
      btree_set(tree, unsafe_bitcast::<U32, I32>(i * 2u32 + 10u32), 7i32)
      i = i + 1u32
      continue true
    }
    _ => break ()
  }
  tree
}
pub fn split_carrier_value_i32() -> I32 {
  9i32
}
pub fn split_carrier_replace_i32(tree: BTree<I32, I32, NaturalComparator>, value: I32) -> Unit {
  btree_set(tree, split_carrier_head_key(tree), value)
}
pub fn split_carrier_fit_i32(tree: BTree<I32, I32, NaturalComparator>, value: I32) -> Bool {
  btree_insert(tree, 2i32, value)
}
pub fn split_carrier_get_i32(tree: BTree<I32, I32, NaturalComparator>) -> Option<I32> {
  btree_get(tree, split_carrier_head_key(tree))
}
pub fn split_carrier_put_i32(tree: BTree<I32, I32, NaturalComparator>, value: I32) -> Option<I32> {
  btree_put(tree, split_carrier_head_key(tree), value)
}

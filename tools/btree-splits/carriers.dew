  let tree = btree_plain_new::<I32, Unit, NaturalComparator>(natural_comparator(), btree_config(1024u32, 64u32, 64u32))
  btree_set(tree, 1i32, ())
  let mut i = 0u32
  while true {
    true if i < 2000u32 => {
      btree_set(tree, unsafe_bitcast::<U32, I32>(i * 2u32 + 10u32), ())
      i = i + 1u32
      continue true
    }
    _ => break ()
  }
  tree
}
pub fn split_carrier_value_unit() -> Unit {
  ()
}
pub fn split_carrier_replace_unit(tree: BTree<I32, Unit, NaturalComparator>) -> Unit {
  btree_set(tree, split_carrier_head_key(tree), ())
}
pub fn split_carrier_fit_unit(tree: BTree<I32, Unit, NaturalComparator>) -> Bool {
  btree_insert(tree, 2i32, ())
}
pub fn split_carrier_get_unit(tree: BTree<I32, Unit, NaturalComparator>) -> Option<Unit> {

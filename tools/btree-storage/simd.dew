open dew.std.wasm.intrinsics

fn replace16(block: U16x8, lane: U32, value: U16) -> U16x8 {
  match lane {
    0u32 => wasm_u16x8_replace_0(block, value)
    1u32 => wasm_u16x8_replace_1(block, value)
    2u32 => wasm_u16x8_replace_2(block, value)
    3u32 => wasm_u16x8_replace_3(block, value)
    4u32 => wasm_u16x8_replace_4(block, value)
    5u32 => wasm_u16x8_replace_5(block, value)
    6u32 => wasm_u16x8_replace_6(block, value)
    7u32 => wasm_u16x8_replace_7(block, value)
    _ => unreachable()
  }
}
fn extract16(block: U16x8, lane: U32) -> U16 {
  match lane {
    0u32 => wasm_u16x8_extract_0(block)
    1u32 => wasm_u16x8_extract_1(block)
    2u32 => wasm_u16x8_extract_2(block)
    3u32 => wasm_u16x8_extract_3(block)
    4u32 => wasm_u16x8_extract_4(block)
    5u32 => wasm_u16x8_extract_5(block)
    6u32 => wasm_u16x8_extract_6(block)
    7u32 => wasm_u16x8_extract_7(block)
    _ => unreachable()
  }
}
pub fn lane16(lane: U32, value: U16) -> U16 {
  extract16(replace16(wasm_u16x8_splat(0u16), lane, value), lane)
}
pub fn rank16(query: U16, live: U32, equal: Bool) -> U32 {
  let block = wasm_u16x8_splat(65535u16)
  let block = wasm_u16x8_replace_0(block, 0u16)
  let block = wasm_u16x8_replace_1(block, 32768u16)
  let block = wasm_u16x8_replace_2(block, 65535u16)
  let block = wasm_u16x8_replace_7(block, 0u16) // tag bytes outside the live mask
  let wanted = wasm_u16x8_splat(query)
  let compared = if equal {
    wasm_u16x8_eq(block, wanted)
  } else {
    wasm_u16x8_lt_u(block, wanted)
  }
  wasm_u16x8_bitmask(compared) & ((1u32 << live) - 1u32)
}

fn replace32(block: U32x4, lane: U32, value: U32) -> U32x4 {
  match lane {
    0u32 => wasm_u32x4_replace_0(block, value)
    1u32 => wasm_u32x4_replace_1(block, value)
    2u32 => wasm_u32x4_replace_2(block, value)
    3u32 => wasm_u32x4_replace_3(block, value)
    _ => unreachable()
  }
}
fn extract32(block: U32x4, lane: U32) -> U32 {
  match lane {
    0u32 => wasm_u32x4_extract_0(block)
    1u32 => wasm_u32x4_extract_1(block)
    2u32 => wasm_u32x4_extract_2(block)
    3u32 => wasm_u32x4_extract_3(block)
    _ => unreachable()
  }
}
pub fn lane32(lane: U32, value: U32) -> U32 {
  extract32(replace32(wasm_u32x4_splat(0u32), lane, value), lane)
}
pub fn rank32(query: U32, live: U32, equal: Bool) -> U32 {
  let block = wasm_u32x4_splat(4294967295u32)
  let block = wasm_u32x4_replace_0(block, 0u32)
  let block = wasm_u32x4_replace_1(block, 2147483648u32)
  let block = wasm_u32x4_replace_2(block, 4294967295u32)
  let block = wasm_u32x4_replace_3(block, 0u32) // tag bytes outside the live mask
  let wanted = wasm_u32x4_splat(query)
  let compared = if equal {
    wasm_u32x4_eq(block, wanted)
  } else {
    wasm_u32x4_lt_u(block, wanted)
  }
  wasm_u32x4_bitmask(compared) & ((1u32 << live) - 1u32)
}

fn replace64(block: U64x2, lane: U32, value: U64) -> U64x2 {
  match lane {
    0u32 => wasm_u64x2_replace_0(block, value)
    1u32 => wasm_u64x2_replace_1(block, value)
    _ => unreachable()
  }
}
fn extract64(block: U64x2, lane: U32) -> U64 {
  match lane {
    0u32 => wasm_u64x2_extract_0(block)
    1u32 => wasm_u64x2_extract_1(block)
    _ => unreachable()
  }
}
pub fn lane64(lane: U32, value: U64) -> U64 {
  extract64(replace64(wasm_u64x2_splat(0u64), lane, value), lane)
}
pub fn rank64(query: U64, live: U32, equal: Bool) -> U32 {
  let block = wasm_u64x2_splat(18446744073709551615u64)
  let block = wasm_u64x2_replace_0(block, 0u64)
  let block = wasm_u64x2_replace_1(block, 9223372036854775808u64)
  let wanted = wasm_u64x2_splat(query)
  let compared = if equal {
    wasm_u64x2_eq(block, wanted)
  } else {
    let sign = unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(9223372036854775808u64))
    let left = wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(block), sign)
    let right = wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(wanted), sign)
    unsafe_bitcast::<V128, U64x2>(wasm_v128_lt_s_i64(left, right))
  }
  wasm_u64x2_bitmask(compared) & ((1u32 << live) - 1u32)
}

pub fn rank64_pair(first: U64, second: U64, query: U64, live: U32, equal: Bool) -> U32 {
  let block = wasm_u64x2_replace_1(wasm_u64x2_splat(first), second)
  let wanted = wasm_u64x2_splat(query)
  let compared = if equal {
    wasm_u64x2_eq(block, wanted)
  } else {
    let sign = unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(9223372036854775808u64))
    let left = wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(block), sign)
    let right = wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(wanted), sign)
    unsafe_bitcast::<V128, U64x2>(wasm_v128_lt_s_i64(left, right))
  }
  wasm_u64x2_bitmask(compared) & ((1u32 << live) - 1u32)
}

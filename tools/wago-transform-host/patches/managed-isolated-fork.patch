diff --git a/src/wago/managed_isolated_fork_amd64_test.go b/src/wago/managed_isolated_fork_amd64_test.go
new file mode 100644
--- /dev/null
+++ b/src/wago/managed_isolated_fork_amd64_test.go
@@ -0,0 +1,58 @@
+//go:build linux && amd64 && !tinygo && !wago_guardpage
+
+package wago
+
+import (
+  "context"
+  "strings"
+  "testing"
+)
+
+func TestManagedIsolatedForkHasPrivateCollectorAndExecution(t *testing.T) {
+  rt := NewRuntime(WithRuntimeConfig(NewRuntimeConfig().WithCoreFeatures(CoreFeaturesV3)))
+  defer rt.Close()
+  manager := newPendingInstanceManager("isolated-fork-test", AuthorityScope{MaxInstances: 2, MaxMemoryBytes: 65536})
+  manager.activate(rt)
+  defer manager.close()
+  mod, err := rt.Compile(gcDecoderTupleReferenceModule(0))
+  if err != nil { t.Fatal(err) }
+  defer mod.Close()
+  parent, err := rt.Instantiate(context.Background(), mod)
+  if err != nil { t.Fatal(err) }
+  defer parent.Close()
+  caller := parent.beginHostCallScope()
+  defer caller.scope.end(caller.generation, caller.parentGeneration)
+  var children []*ManagedInstance
+  for range 2 {
+    child, err := manager.ForkIsolated(context.Background(), caller)
+    if err != nil { t.Fatal(err) }
+    children = append(children, child)
+    in := child.Instance()
+    if in.rt != rt || in.c != parent.c || in.refStore == parent.refStore || !in.refStore.private || in.gc == nil || in.gc == parent.gc || !in.usesIndependentExecution() {
+      t.Fatal("isolated fork must retain compiled code and runtime policy, with private references, collector and native execution")
+    }
+    result, err := in.Invoke("run")
+    if err != nil || len(result) != 1 || result[0] != 1 { t.Fatalf("isolated run=%v, %v", result, err) }
+  }
+  if children[0].Instance().gc == children[1].Instance().gc || children[0].Instance().refStore == children[1].Instance().refStore { t.Fatal("isolated children share state") }
+  for _, child := range children {
+    if err := child.Close(); err != nil { t.Fatal(err) }
+    if err := child.WaitClosed(); err != nil { t.Fatal(err) }
+  }
+  manager.mu.Lock()
+  live := manager.live
+  manager.mu.Unlock()
+  if live != 0 { t.Fatalf("isolated close retained %d reservations", live) }
+}
+
+func TestManagedIsolatedForkRejectsReferenceGlobal(t *testing.T) {
+  rt := NewRuntime()
+  defer rt.Close()
+  manager := newPendingInstanceManager("isolated-fork-test", AuthorityScope{MaxInstances: 1, MaxMemoryBytes: 65536})
+  manager.activate(rt)
+  defer manager.close()
+  parent := &Instance{rt: rt, c: &Compiled{GlobalImports: []GlobalImportDef{{Module: "env", Name: "g", Type: ValAnyRef}}}, imports: Imports{"env.g": GlobalImport{Type: ValAnyRef}}}
+  caller := parent.beginHostCallScope()
+  defer caller.scope.end(caller.generation, caller.parentGeneration)
+  if _, err := manager.ForkIsolated(context.Background(), caller); err == nil || !strings.Contains(err.Error(), "reference global") { t.Fatalf("reference global accepted: %v", err) }
+}

+//go:build linux && amd64 && !tinygo && !wago_guardpage
+
+package wago
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/wago-org/wago/src/core/compiler/wasm"
+	corergc "github.com/wago-org/wago/src/core/runtime/gc/native"

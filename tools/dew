#!/usr/bin/env bash
set -euo pipefail
export DEW_WORKING_DIRECTORY="$PWD"
root="$(cd "$(dirname "$0")/.." && pwd)"
export DEW_REPOSITORY_ROOT="$root"
bootstrap_target_dir="${DEW_BOOTSTRAP_TARGET_DIR:-$root/_build}"
case "$bootstrap_target_dir" in
  /*) ;;
  *) bootstrap_target_dir="$root/$bootstrap_target_dir" ;;
esac
cd "$root"
exec moon run --target-dir "$bootstrap_target_dir" --target native --release \
  -j 8 src/dew_bootstrap -- "$@"

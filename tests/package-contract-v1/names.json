      "input": "@a/b/c",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "upper-scope",
      "input": "@A/b",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "upper-name",
      "input": "@a/B",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "space",
      "input": "@a/b c",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "unicode",
      "input": "@a/caf\u00e9",

      "expected": {
        "accept": true
      },
      "rule": "name-grammar"
    },
    {
      "id": "empty",
      "input": "",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "unscoped",
      "input": "a/b",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "scope-empty",
      "input": "@/b",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {

{
  "schemaVersion": 1,
  "kind": "manifest",
  "cases": [
    {
      "id": "dependencies-absent",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\"}",
      "expected": {
        "accept": true,
        "dependencies": {}
      },
      "rule": "absent-dependencies"
    },
    {
      "id": "dependencies-empty",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": true,
        "dependencies": {}
      },
      "rule": "manifest-fields"
    },
    {
      "id": "dependencies-sorted",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@z/b\":\"*\",\"@a/c\":\"^1.0.0\"}}",
      "expected": {
        "accept": true,
        "dependencies": {
          "@a/c": "^1.0.0",
          "@z/b": "*"
        }
      },
      "rule": "dependency-order"
    },
    {
      "id": "escaped-valid-keys",
      "input": "{\"na\\u006de\":\"@a/b\",\"ver\\u0073ion\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": true,
        "dependencies": {}
      },
      "rule": "decoded-keys"
    },
    {
      "id": "unknown-field",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{},\"description\":\"x\"}",
      "expected": {
        "accept": false
      },
      "rule": "unknown-field"
    },
    {
      "id": "name-missing",
      "input": "{\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "required-name"
    },
    {
      "id": "version-missing",
      "input": "{\"name\":\"@a/b\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "required-version"
    },
    {
      "id": "name-null",
      "input": "{\"name\":null,\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "name-type"
    },
    {
      "id": "version-number",
      "input": "{\"name\":\"@a/b\",\"version\":1,\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "version-type"
    },
    {
      "id": "bad-name",
      "input": "{\"name\":\"@A/b\",\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "name-grammar"
    },
    {
      "id": "bad-version",
      "input": "{\"name\":\"@a/b\",\"version\":\"01.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "strict-semver"
    },
    {
      "id": "dependencies-null",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":null}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-object"
    },
    {
      "id": "dependencies-array",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":[]}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-object"
    },
    {
      "id": "dependencies-string",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":\"*\"}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-object"
    },
    {
      "id": "dependency-name",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@A/b\":\"*\"}}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-name"
    },
    {
      "id": "dependency-value",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@c/d\":1}}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-string"
    },
    {
      "id": "dependency-object",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@c/d\":{\"version\":\"1.0.0\"}}}",
      "expected": {
        "accept": false
      },
      "rule": "dependency-string"
    },
    {
      "id": "dependency-range",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@c/d\":\">=1.0.0\"}}",
      "expected": {
        "accept": false
      },
      "rule": "requirement-grammar"
    },
    {
      "id": "root-array",
      "input": "[]",
      "expected": {
        "accept": false
      },
      "rule": "manifest-object"
    },
    {
      "id": "root-null",
      "input": "null",
      "expected": {
        "accept": false
      },
      "rule": "manifest-object"
    },
    {
      "id": "duplicate-name",
      "input": "{\"name\":\"@a/b\",\"name\":\"@c/d\",\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "duplicate-name-escaped",
      "input": "{\"name\":\"@a/b\",\"na\\u006de\":\"@c/d\",\"version\":\"1.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "duplicate-version",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"version\":\"2.0.0\",\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "duplicate-dependencies",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{},\"dependencies\":{}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "duplicate-dependency",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@c/d\":\"*\",\"@c/d\":\"^1.0.0\"}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "duplicate-dependency-escaped",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",\"dependencies\":{\"@c/d\":\"*\",\"@c\\u002fd\":\"^1.0.0\"}}",
      "expected": {
        "accept": false
      },
      "rule": "duplicate-decoded-key"
    },
    {
      "id": "trailing-data",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\"} false",
      "expected": {
        "accept": false
      },
      "rule": "json-syntax"
    },
    {
      "id": "trailing-comma",
      "input": "{\"name\":\"@a/b\",\"version\":\"1.0.0\",}",
      "expected": {
        "accept": false
      },
      "rule": "json-syntax"
    },

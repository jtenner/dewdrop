      },
      "rule": "requirement-grammar"
    },
    {
      "id": "exact",
      "input": "1.2.3",
      "expected": {
        "accept": true
      },
      "rule": "requirement-grammar"
    },
    {
      "id": "caret",
      "input": "^1.2.3",
      "expected": {
        "accept": true
      },
      "rule": "requirement-grammar"
    },
    {
      "id": "tilde",
      "input": "~0.2.3",
      "expected": {
        "accept": true
      },
      "rule": "requirement-grammar"
    },
    {
      "id": "pre",
      "input": "^1.0.0-alpha.1",
      "expected": {
        "accept": true
      },
      "rule": "requirement-grammar"
    },
    {
      "id": "git-https",
      "input": "git+https://example.invalid/a.git#main",

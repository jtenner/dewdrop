pub trait Value {
  fn value(self) -> I32
}

impl Value for I32 {
  fn value(self) -> I32 {
    self
  }
}

fn finish_read<t: Value>(remaining: I32, prefix: I32, suffix: I32, value: t) -> I32 {
  if remaining > 0 {
    finish_read(remaining - 1, prefix, suffix, value)
  } else {
    prefix + suffix + value.value()
  }
}

pub fn forwarded_read<t: Value>(prefix: I32, value: t) -> I32 {
  finish_read(0, prefix, 0, value)
}

trait Read {
  fn read(self) -> I32
}

struct Box<t> {
  value: t
}

impl<t: Value> Read for Box<t> {
  fn read(self) -> I32 {
    self.value.value()
  }
}

fn consume<t: Read>(value: t) -> I32 {
  value.read()
}

pub fn consume_value<t: Value>(value: t) -> I32 {
  consume(Box {
    value: value
  })
}

trait Inspect {
  fn inspect(self) -> I32
}

struct Wrap<t> {
  value: t
}

impl<t: Read> Inspect for Wrap<t> {
  fn inspect(self) -> I32 {
    self.value.read()
  }
}

fn consume_inspect<t: Inspect>(value: t) -> I32 {
  value.inspect()
}

pub fn consume_nested_value<t: Value>(value: t) -> I32 {
  consume_inspect(Wrap {
    value: Box {
      value: value
    }
  })
}

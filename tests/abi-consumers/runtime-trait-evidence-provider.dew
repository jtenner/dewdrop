open fixture.runtime_evidence

pub fn choose<t: Value>(condition: Bool, value: t) -> Value {
  if condition {
    value
  } else {
    value
  }
}

pub fn read<t: Value>(value: t) -> I32 {
  forwarded_read(0, value)
}

pub fn boxed_read<t: Value>(value: t) -> I32 {
  consume_value(value)
}

pub fn nested_read<t: Value>(value: t) -> I32 {
  consume_nested_value(value)
}

pub fn reader<t: Value>() -> fn(t) -> I32 {
  consume_nested_value
}

pub fn main() -> I32 {
  read(42)
}

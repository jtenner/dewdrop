import dew.std.wasm.intrinsics as @wasm
open dew.std.wasi

pub fn main() -> U32 {
  let scalar_ok = @wasm.wasm_i32_add(19i32, 23i32) == 42i32 &&
    @wasm.wasm_core_i32_lt(1i32, 2i32) &&
    @wasm.i64_trunc_i32(4294967297i64) == 1i32 &&
    @wasm.wasm_f32_sqrt(81.0f32) == 9.0f32
  @wasm.wasm_u32_store(3u32, 305419896u32)
  let memory_ok = @wasm.wasm_u32_load(3u32) == 305419896u32
  let vector = @wasm.wasm_v128_splat_i32(7i32)
  let difference = @wasm.wasm_v128_xor(vector, @wasm.wasm_v128_splat_i32(7i32))
  if scalar_ok && memory_ok && !@wasm.wasm_v128_any_true(difference) {
    wasi_fd_write(1u32, b"wasm:intrinsics")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

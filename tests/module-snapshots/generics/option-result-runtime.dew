open dew.std.string

fn option_i64() -> Option<I64> {
  Option::Some(42i64)
}

fn option_string() -> Option<String> {
  Option::Some("hello")
}

fn result_ok() -> Result<U32, String> {
  Result::Ok(7u32)
}

fn result_error() -> Result<U32, String> {
  Result::Err("bad")
}

pub fn main() -> Unit {
  assert(
    match option_i64() {
      Some(value) => value == 42i64
      None => false
    },
    "Option<I64>",
  )
  assert(
    match option_string() {
      Some(value) => value.byte_length() == 5u32
      None => false
    },
    "Option<String>",
  )
  assert(
    match result_ok() {
      Ok(value) => value == 7u32
      Err(_) => false
    },
    "Result::Ok",
  )
  assert(
    match result_error() {
      Ok(_) => false
      Err(message) => message.byte_length() == 3u32
    },
    "Result::Err",
  )
}

fn identity<t>(value: t) -> t {
  value
}

fn return_i32_identity() -> fn(I32) -> I32 {
  identity
}

fn return_i64_identity() -> fn(I64) -> I64 {
  identity
}

pub fn main() -> Unit {
  let i32_identity = return_i32_identity()
  let i64_identity = return_i64_identity()
  assert(i32_identity(42) == 42, "escaping generic i32 reference")
  assert(i64_identity(42i64) == 42i64, "escaping generic i64 reference")
}

struct CallbackBox<t> {
  callback: fn(t) -> t
}

enum CallbackChoice<t> {
  Tuple(fn(t) -> t)
  Struct {
    callback: fn(t) -> t
  }
}

fn increment(value: I32) -> I32 {
  value + 1
}

fn assert_42(value: I32) -> Unit {
  assert(value == 42, "aggregate callback result")
}

pub fn identity_box<t>(value: CallbackBox<t>, first: Bool) -> CallbackBox<t> {
  if first {
    value
  } else {
    value
  }
}

pub fn identity_choice<t>(value: CallbackChoice<t>, first: Bool) -> CallbackChoice<t> {
  if first {
    value
  } else {
    value
  }
}

pub fn main() -> Unit {
  let box = identity_box(CallbackBox::{
    callback: increment
  }, true)
  let tuple = identity_choice(CallbackChoice::Tuple(increment), true)
  let structured = identity_choice(CallbackChoice::Struct::{
    callback: increment
  }, false)
  let callback = box.callback
  assert_42(callback(41))
  assert_42(
    match tuple {
      CallbackChoice::Tuple(callback) => callback(41)
      _ => 0
    },
  )
  assert_42(
    match structured {
      CallbackChoice::Struct {
        callback
      } => callback(41)
      _ => 0
    },
  )
}

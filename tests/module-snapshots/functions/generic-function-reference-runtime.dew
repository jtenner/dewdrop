fn identity<t>(value: t) -> t {
  value
}

fn apply_i32(callback: fn(I32) -> I32, value: I32) -> I32 {
  callback(value)
}

fn apply_i64(callback: fn(I64) -> I64, value: I64) -> I64 {
  callback(value)
}

pub fn main() -> Unit {
  assert(apply_i32(identity, 42) == 42, "generic i32 callback reference")
  assert(apply_i64(identity, 42i64) == 42i64, "generic i64 callback reference")
}

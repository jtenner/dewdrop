enum Maybe {
  Some(I32, I32)
  None
}

fn guarded(first: I32, second: I32) -> I32 {
  match Maybe::Some(first, second) {
    Maybe::Some(left, right) if left > 0 => right + 1
    Maybe::Some(left, right) if right > 0 => left + 2
    Maybe::Some(left, right) => left - right
    Maybe::None => 0
  }
}

pub fn main() -> Unit {
  assert(guarded(1, 20) == 21, "first guarded branch")
  assert(guarded(0, 22) == 2, "second guarded branch")
  assert(guarded(0, 0) == 0, "fallback branch")
}

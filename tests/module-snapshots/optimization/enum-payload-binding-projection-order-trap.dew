enum Maybe {
  Some(I32, I32)
  None
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  match Maybe::Some(trap_first(), trap_second()) {
    whole => match whole {
      Maybe::Some(first, second) => second
      Maybe::None => 0
    }
    Maybe::Some(first, second) => first
    Maybe::None => 0
  }
}

enum Maybe {
  Some(I32, I32)
  None
}

fn retain(value: Maybe) -> Maybe {
  value
}

fn guarded(first: I32, second: I32) -> I32 {
  match retain(Maybe::Some(first, second)) {
    Maybe::Some(left, right) if left > 0 => right + 1
    Maybe::Some(left, right) => right
    Maybe::None => 0
  }
}

pub fn main() -> I32 {
  guarded(1, 20) + guarded(0, 22)
}

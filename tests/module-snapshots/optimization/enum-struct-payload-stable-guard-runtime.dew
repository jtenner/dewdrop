enum Record {
  Some {
    left: I32
    right: I32
  }
  None
}

fn guarded(flag: Bool, left: I32, right: I32) -> I32 {
  match (Record::Some::{
    left: left
    right: right
  }) {
    Record::Some {
      left
      right
    } if flag => right
    Record::Some {
      left
      right
    } => right
    Record::None => 0
  }
}

pub fn main() -> I32 {
  guarded(true, 1, 20) + guarded(false, 2, 22)
}

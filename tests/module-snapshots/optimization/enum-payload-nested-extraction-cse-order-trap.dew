struct Box {
  left: I32
  right: I32
}

enum Wrapped {
  Some(Box)
  None
}

fn retain(value: Wrapped) -> Wrapped {
  value
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  match retain(Wrapped::Some(Box {
    left: trap_first()
    right: trap_second()
  })) {
    Wrapped::Some(Box {
      left
      right
    }) if left > 0 => right + 1
    Wrapped::Some(Box {
      left
      right
    }) => right
    Wrapped::None => 0
  }
}

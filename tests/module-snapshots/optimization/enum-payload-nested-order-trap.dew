struct Box {
  left: I32
  right: I32
}

enum Wrapped {
  Some(Box)
  None
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  match Wrapped::Some(Box {
    left: trap_first()
    right: trap_second()
  }) {
    Wrapped::Some(Box {
      left
      right
    }) => right
    Wrapped::None => 0
  }
}

enum Maybe {
  Some(I32, I32)
  None
}

fn guarded(first_flag: Bool, second_flag: Bool, first: I32, second: I32) -> I32 {
  match Maybe::Some(first, second) {
    Maybe::Some(left, right) if first_flag && !second_flag => right
    Maybe::Some(left, right) => right
    Maybe::None => 0
  }
}

pub fn main() -> I32 {
  guarded(true, false, 1, 20) + guarded(false, true, 2, 22)
}

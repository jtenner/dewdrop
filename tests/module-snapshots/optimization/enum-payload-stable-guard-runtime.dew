enum Maybe {
  Some(I32, I32)
  None
}

fn guarded(flag: Bool, first: I32, second: I32) -> I32 {
  match Maybe::Some(first, second) {
    Maybe::Some(left, right) if flag => right
    Maybe::Some(left, right) => right
    Maybe::None => 0
  }
}

pub fn main() -> I32 {
  guarded(true, 1, 20) + guarded(false, 2, 22)
}

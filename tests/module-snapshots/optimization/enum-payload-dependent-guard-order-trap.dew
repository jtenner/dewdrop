enum Maybe {
  Some(I32, I32)
  None
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  match Maybe::Some(trap_first(), trap_second()) {
    Maybe::Some(first, second) if first > 0 => second
    Maybe::Some(first, second) if second == 0 => second
    Maybe::Some(first, second) => second
    Maybe::None => 0
  }
}

struct Token {
  value: I32
}

struct Pair {
  first: Token
  second: Token
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  let pair = Pair {
    first: Token {
      value: trap_first()
    }
    second: Token {
      value: trap_second()
    }
  }
  pair.second.value
}

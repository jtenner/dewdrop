enum Choice {
  First
  Second
}

struct Pair {
  left: I32
  right: I32
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  let pair = match Choice::First {
    Choice::First => Pair::{
      left: trap_first()
      right: trap_second()
    }
    Choice::Second => Pair::{
      left: 0
      right: 1
    }
  }
  pair.right
}

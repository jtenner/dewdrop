enum Maybe {
  Some(I32, I32)
  None
}

fn projected(first: I32, second: I32) -> I32 {
  match Maybe::Some(first, second) {
    whole => match whole {
      Maybe::Some(left, right) => right
      Maybe::None => 0
    }
    Maybe::Some(left, right) => left
    Maybe::None => 0
  }
}

pub fn main() -> I32 {
  projected(20, 22)
}

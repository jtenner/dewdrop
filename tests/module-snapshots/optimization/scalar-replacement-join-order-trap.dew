struct Pair {
  left: I32
  right: I32
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  let pair = if true {
    Pair::{
      left: trap_first()
      right: trap_second()
    }
  } else {
    Pair::{
      left: 0
      right: 1
    }
  }
  pair.right
}

enum Choice {
  First(I32, I32)
  Second(I32, I32)
  Empty
}

fn trap_first() -> I32 {
  unreachable()
}

fn trap_second() -> I32 {
  1 / 0
}

pub fn main() -> I32 {
  match Choice::First(trap_first(), trap_second()) {
    Choice::First(first, second), Choice::Second(first, second) => second
    Choice::Empty => 0
  }
}

open dew.std.string
open dew.std.wasi
open dew.std.bytes

fn found_at() -> U32 {
  match "prefix needle suffix".find("needle") {
    Option::Some(index) => index
    Option::None => 4294967295u32
  }
}

pub fn main() -> U32 {
  if found_at() == 7u32 {
    wasi_fd_write(1u32, b"text:short-found")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

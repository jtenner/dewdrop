open dew.std.string
open dew.std.text

pub fn main() -> Unit {
  let points = "$¢€𐍈".code_points()
  let alias = points
  assert(points.has_next(), "string has first")
  assert(points.next() == 36u32, "ascii scalar")
  assert(alias.next() == 162u32, "two-byte scalar and shared cursor")
  assert(points.next() == 8364u32, "three-byte scalar")
  assert(points.next() == 66376u32, "four-byte scalar")
  assert(!points.has_next(), "string exhausted")

  let empty = "".code_points()
  assert(!empty.has_next(), "empty string")

  let source = "0$¢€𐍈z"
  let view = source.view(1u32, 10u32).code_points()
  assert(view.next() == 36u32, "view ascii")
  assert(view.next() == 162u32, "view two-byte")
  assert(view.next() == 8364u32, "view three-byte")
  assert(view.next() == 66376u32, "view four-byte")
  assert(!view.has_next(), "view exhausted")
}

open dew.std.string
open dew.std.wasi
open dew.std.bytes

pub fn main() -> U32 {
  let value = "prefix-middle-suffix"
  if value.starts_with("prefix") {
    if value.ends_with("suffix") {
      wasi_fd_write(1u32, b"text:prefix-suffix")
    } else {
      wasi_fd_write(1u32, b"FAIL")
    }
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

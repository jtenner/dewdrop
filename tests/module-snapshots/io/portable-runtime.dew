open dew.std.io
open dew.std.bytes
open dew.std.wasi

fn bytes_or_empty(result: Result<Bytes, IoError>) -> Bytes {
  match result {
    Result::Ok(value) => value
    Result::Err(_) => b""
  }
}

pub fn main() -> U32 {
  let input = BytesInput::new(b"portable input")
  let first = bytes_or_empty(io_read_exact(input, 8u32))
  let second = bytes_or_empty(io_read_exact(input, 6u32))
  let output = BytesOutput::with_capacity(14u32)
  let written = io_write_all(output, first)
  let written_again = io_write_all(output, second)
  let finished = output.finish()
  let finished_ok = match finished {
    Result::Ok(value) => value.equals(b"portable input")
    Result::Err(_) => false
  }
  let valid =
    written is Result::Ok(8u32) &&
    written_again is Result::Ok(6u32) &&
    finished_ok &&
    io_read_exact(input, 1u32) is Result::Err(IoError::UnexpectedEnd)
  if valid {
    wasi_fd_write(1u32, b"io:portable")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

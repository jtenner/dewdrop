open dew.std.wasi
pub fn main() -> U32 {
  let u32_wrap = 1u32 << 32u32
  let u64_wrap = 1u64 << 64u64
  let i64_wrap = 1i64 << 64i64
  let arithmetic_right = -1i32 >> 31i32
  let signed_fill = -8i64 >> 3i64
  if u32_wrap == 1u32 &&
    u64_wrap == 1u64 &&
    i64_wrap == 1i64 &&
    arithmetic_right == -1i32 &&
    signed_fill == -1i64 {
    wasi_fd_write(1u32, b"numeric:shift-width")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

open dew.std.wasi
pub fn main() -> U32 {
  f32_store(3u32, 7.5f32)
  f64_store(11u32, 9.25f64)
  if f32_load(3u32) == 7.5f32 {
    if f64_load(11u32) == 9.25f64 {
      wasi_fd_write(1u32, b"memory:float")
    } else {
      wasi_fd_write(1u32, b"FAIL")
    }
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

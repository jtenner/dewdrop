open dew.std.array
open dew.std.wasi

fn values() -> Array<I32> {
  let output = Array::new()
  output.push(10)
  output.push(20)
  output
}

pub fn main() -> Unit {
  let values = values()
  values[0u32] = 11
  let entries = values.entries()
  match entries.next() {
    Option::Some(entry) =>
      if entry.value() == 11 {
        match entries.next() {
          Option::Some(_) => wasi_fd_write(1u32, b"collections:array-entries-runtime")
          Option::None => unreachable()
        }
      } else {
        unreachable()
      }
    Option::None => unreachable()
  }
}

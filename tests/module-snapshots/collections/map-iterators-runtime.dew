open dew.std.map
open dew.std.string

fn empty_i32_map() -> Map<I32, I32> {
  Map::empty()
}

fn sum_keys(iter: MapKeyIter<I32, I32>, sum: I32) -> I32 {
  match iter.next() {
    Option::Some(value) => sum_keys(iter, sum + value)
    Option::None => sum
  }
}

fn sum_values(iter: MapValueIter<I32, I32>, sum: I32) -> I32 {
  match iter.next() {
    Option::Some(value) => sum_values(iter, sum + value)
    Option::None => sum
  }
}

fn combine_entry(entry: MapEntry<I32, I32>) -> I32 {
  entry.key() + entry.value()
}

fn sum_entries(iter: MapEntryIter<I32, I32>, sum: I32) -> I32 {
  match iter.next() {
    Option::Some(entry) => sum_entries(iter, sum + combine_entry(entry))
    Option::None => sum
  }
}

fn string_value_lengths(iter: MapValueIter<I32, String>, sum: U32) -> U32 {
  match iter.next() {
    Option::Some(value) => string_value_lengths(iter, sum + value.byte_length())
    Option::None => sum
  }
}

fn empty_keys(iter: MapKeyIter<I32, I32>) -> Bool {
  match iter.next() {
    Option::Some(_) => false
    Option::None => true
  }
}

fn empty_values(iter: MapValueIter<I32, I32>) -> Bool {
  match iter.next() {
    Option::Some(_) => false
    Option::None => true
  }
}

fn empty_entries(iter: MapEntryIter<I32, I32>) -> Bool {
  match iter.next() {
    Option::Some(_) => false
    Option::None => true
  }
}

pub fn main() -> Unit {
  let values = Map::singleton(1, 10)
  values.insert(17, 20)
  values.insert(33, 30)
  values.insert(2, 40)
  assert(sum_keys(values.keys(), 0) == 53, "map key iterator visits every key")
  assert(sum_values(values.values(), 0) == 100, "map value iterator visits every value")
  assert(sum_entries(values.entries(), 0) == 153, "map entry iterator preserves key/value pairing")

  let empty = empty_i32_map()
  assert(empty_keys(empty.keys()), "empty map key iterator")
  assert(empty_values(empty.values()), "empty map value iterator")
  assert(empty_entries(empty.entries()), "empty map entry iterator")

  let strings = Map::singleton(1, "one")
  strings.insert(2, "three")
  assert(string_value_lengths(strings.values(), 0u32) == 8u32, "map reference value iterator")
}

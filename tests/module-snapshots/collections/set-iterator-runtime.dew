open dew.std.set

fn empty_i32_set() -> Set<I32> {
  Set::empty()
}

fn sum_keys(iter: SetIter<I32>, sum: I32) -> I32 {
  match iter.next() {
    Option::Some(value) => sum_keys(iter, sum + value)
    Option::None => sum
  }
}

fn exhausted(iter: SetIter<I32>) -> Bool {
  match iter.next() {
    Option::Some(_) => false
    Option::None => true
  }
}

pub fn main() -> Unit {
  let values = Set::singleton(1)
  values.insert(17)
  values.insert(33)
  values.insert(2)
  assert(sum_keys(values.iter(), 0) == 53, "set iterator visits every key")
  let empty = empty_i32_set()
  assert(exhausted(empty.iter()), "empty set iterator")
}

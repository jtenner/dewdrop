open dew.std.set

pub fn main() -> Unit {
  let set = Set::singleton(0u32)
  let set_alias = set
  assert(set_alias.insert(128u32), "Set inserts colliding growth key 1")
  assert(set_alias.insert(256u32), "Set inserts colliding growth key 2")
  assert(set_alias.insert(384u32), "Set inserts colliding growth key 3")
  assert(set_alias.insert(512u32), "Set inserts colliding growth key 4")
  assert(set_alias.insert(640u32), "Set inserts colliding growth key 5")
  assert(set_alias.insert(768u32), "Set inserts colliding growth key 6")
  assert(set_alias.insert(896u32), "Set inserts colliding growth key 7")
  assert(set_alias.insert(1024u32), "Set inserts colliding growth key 8")
  assert(set_alias.insert(1152u32), "Set inserts colliding growth key 9")
  assert(set_alias.insert(1280u32), "Set inserts colliding growth key 10")
  assert(set_alias.insert(1408u32), "Set inserts colliding growth key 11")
  assert(set_alias.insert(1536u32), "Set inserts colliding growth key 12")
  assert(set_alias.insert(1664u32), "Set inserts colliding growth key 13")
  assert(set_alias.insert(1792u32), "Set inserts colliding growth key 14")
  assert(set.length() == 15u32, "Set before first growth length 15")
  assert(set_alias.insert(1920u32), "Set inserts colliding growth key 15")
  assert(set.length() == 16u32, "Set at first threshold length 16")
  assert(!set_alias.insert(0u32), "Set duplicate at threshold remains idempotent")
  assert(set.length() == 16u32, "Set duplicate at threshold keeps length")
  assert(set_alias.insert(2048u32), "Set inserts colliding growth key 16")
  assert(set.length() == 17u32, "Set after first threshold length 17")
  assert(set_alias.insert(2176u32), "Set inserts colliding growth key 17")
  assert(set_alias.insert(2304u32), "Set inserts colliding growth key 18")
  assert(set_alias.insert(2432u32), "Set inserts colliding growth key 19")
  assert(set_alias.insert(2560u32), "Set inserts colliding growth key 20")
  assert(set_alias.insert(2688u32), "Set inserts colliding growth key 21")
  assert(set_alias.insert(2816u32), "Set inserts colliding growth key 22")
  assert(set_alias.insert(2944u32), "Set inserts colliding growth key 23")
  assert(set_alias.insert(3072u32), "Set inserts colliding growth key 24")
  assert(set_alias.insert(3200u32), "Set inserts colliding growth key 25")
  assert(set_alias.insert(3328u32), "Set inserts colliding growth key 26")
  assert(set_alias.insert(3456u32), "Set inserts colliding growth key 27")
  assert(set_alias.insert(3584u32), "Set inserts colliding growth key 28")
  assert(set_alias.insert(3712u32), "Set inserts colliding growth key 29")
  assert(set_alias.insert(3840u32), "Set inserts colliding growth key 30")
  assert(set.length() == 31u32, "Set before second growth length 31")
  assert(set_alias.insert(3968u32), "Set inserts colliding growth key 31")
  assert(set.length() == 32u32, "Set at second threshold length 32")
  assert(set_alias.insert(4096u32), "Set inserts colliding growth key 32")
  assert(set.length() == 33u32, "Set after second threshold length 33")
  assert(set_alias.insert(4224u32), "Set inserts colliding growth key 33")
  assert(set_alias.insert(4352u32), "Set inserts colliding growth key 34")
  assert(set_alias.insert(4480u32), "Set inserts colliding growth key 35")
  assert(set_alias.insert(4608u32), "Set inserts colliding growth key 36")
  assert(set_alias.insert(4736u32), "Set inserts colliding growth key 37")
  assert(set_alias.insert(4864u32), "Set inserts colliding growth key 38")
  assert(set_alias.insert(4992u32), "Set inserts colliding growth key 39")
  assert(set_alias.insert(5120u32), "Set inserts colliding growth key 40")
  assert(set_alias.insert(5248u32), "Set inserts colliding growth key 41")
  assert(set_alias.insert(5376u32), "Set inserts colliding growth key 42")
  assert(set_alias.insert(5504u32), "Set inserts colliding growth key 43")
  assert(set_alias.insert(5632u32), "Set inserts colliding growth key 44")
  assert(set_alias.insert(5760u32), "Set inserts colliding growth key 45")
  assert(set_alias.insert(5888u32), "Set inserts colliding growth key 46")
  assert(set_alias.insert(6016u32), "Set inserts colliding growth key 47")
  assert(set_alias.insert(6144u32), "Set inserts colliding growth key 48")
  assert(set_alias.insert(6272u32), "Set inserts colliding growth key 49")
  assert(set_alias.insert(6400u32), "Set inserts colliding growth key 50")
  assert(set_alias.insert(6528u32), "Set inserts colliding growth key 51")
  assert(set_alias.insert(6656u32), "Set inserts colliding growth key 52")
  assert(set_alias.insert(6784u32), "Set inserts colliding growth key 53")
  assert(set_alias.insert(6912u32), "Set inserts colliding growth key 54")
  assert(set_alias.insert(7040u32), "Set inserts colliding growth key 55")
  assert(set_alias.insert(7168u32), "Set inserts colliding growth key 56")
  assert(set_alias.insert(7296u32), "Set inserts colliding growth key 57")
  assert(set_alias.insert(7424u32), "Set inserts colliding growth key 58")
  assert(set_alias.insert(7552u32), "Set inserts colliding growth key 59")
  assert(set_alias.insert(7680u32), "Set inserts colliding growth key 60")
  assert(set_alias.insert(7808u32), "Set inserts colliding growth key 61")
  assert(set_alias.insert(7936u32), "Set inserts colliding growth key 62")
  assert(set.length() == 63u32, "Set before third growth length 63")
  assert(set_alias.insert(8064u32), "Set inserts colliding growth key 63")
  assert(set.length() == 64u32, "Set at third threshold length 64")
  assert(set_alias.insert(8192u32), "Set inserts colliding growth key 64")
  assert(set.length() == 65u32, "Set after third threshold length 65")
  assert(set_alias.insert(8320u32), "Set inserts colliding growth key 65")
  assert(set.length() == 66u32, "Set colliding length after three growth boundaries")
  assert(set.contains(0u32), "Set colliding pre-growth key survives")
  assert(set.contains(1920u32), "Set colliding first threshold key survives")
  assert(set.contains(2048u32), "Set colliding first post-growth key survives")
  assert(set.contains(3968u32), "Set colliding second threshold key survives")
  assert(set.contains(4096u32), "Set colliding second post-growth key survives")
  assert(set.contains(8064u32), "Set colliding third threshold key survives")
  assert(set.contains(8192u32), "Set colliding third post-growth key survives")
  assert(set.contains(8320u32), "Set colliding latest key survives")
  assert(set.remove(0u32), "Set removes colliding pre-growth key after growth")
  assert(set.remove(4096u32), "Set removes colliding middle growth key")
  assert(set.remove(8320u32), "Set removes colliding latest growth key")
  assert(set.length() == 63u32, "Set colliding removal after growth updates length")
  assert(!set.contains(0u32), "Set removed pre-growth key stays absent")
  assert(!set.contains(4096u32), "Set removed middle key stays absent")
  assert(!set.contains(8320u32), "Set removed latest key stays absent")
  set_alias.clear()
  assert(set.is_empty(), "Set clear after growth is alias visible")
  assert(set.insert(7u32), "Set inserts after clear and growth")
  assert(set_alias.contains(7u32), "Set post-clear insertion is alias visible")
}

pub fn main() -> Unit {
  assert(7i8.hash() == 7u64, "I8 hash")
  assert(7i16.hash() == 7u64, "I16 hash")
  assert(7.hash() == 7u64, "I32 hash")
  assert(7i64.hash() == 7u64, "I64 hash")
  assert(7u8.hash() == 7u64, "U8 hash")
  assert(7u16.hash() == 7u64, "U16 hash")
  assert(7u32.hash() == 7u64, "U32 hash")
  assert(7u64.hash() == 7u64, "U64 hash")

  assert(7i8.hash_eq(7i8), "I8 equal")
  assert(!7i8.hash_eq(8i8), "I8 unequal")
  assert(7i16.hash_eq(7i16), "I16 equal")
  assert(!7i16.hash_eq(8i16), "I16 unequal")
  assert(7.hash_eq(7), "I32 equal")
  assert(!7.hash_eq(8), "I32 unequal")
  assert(7i64.hash_eq(7i64), "I64 equal")
  assert(!7i64.hash_eq(8i64), "I64 unequal")
  assert(7u8.hash_eq(7u8), "U8 equal")
  assert(!7u8.hash_eq(8u8), "U8 unequal")
  assert(7u16.hash_eq(7u16), "U16 equal")
  assert(!7u16.hash_eq(8u16), "U16 unequal")
  assert(7u32.hash_eq(7u32), "U32 equal")
  assert(!7u32.hash_eq(8u32), "U32 unequal")
  assert(7u64.hash_eq(7u64), "U64 equal")
  assert(!7u64.hash_eq(8u64), "U64 unequal")
}

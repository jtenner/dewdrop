open dew.std.bloom_filter

pub fn main() -> Bool {
  let empty = BloomFilter::empty()
  let first = empty.add_hash(123u64)
  let second = first.add_hash(456u64)
  empty.is_empty() &&
    second.maybe_contains_hash(123u64) &&
    second.maybe_contains_hash(456u64) &&
    !second.maybe_contains_hash(789u64)
}

open dew.std.bloom_filter

pub fn main() -> Bool {
  let empty = bloom_filter_empty()
  let first = bloom_filter_add_hash(empty, 123u64)
  let second = bloom_filter_add_hash(first, 456u64)
  bloom_filter_is_empty(empty) &&
    bloom_filter_maybe_contains_hash(second, 123u64) &&
    bloom_filter_maybe_contains_hash(second, 456u64) &&
    !bloom_filter_maybe_contains_hash(second, 789u64)
}

open dew.std.set

struct Key {
  value: I32
}

impl Hash for Key {
  fn hash(self) -> U64 {
    7u64
  }
  fn hash_eq(self, right: Key) -> Bool {
    self.value == right.value
  }
}

pub fn main() -> Unit {
  let values = Set::singleton(Key::{ value: 0 })
  assert(values.insert(Key::{ value: 1 }), "insert collision key 1")
  assert(values.insert(Key::{ value: 2 }), "insert collision key 2")
  assert(values.insert(Key::{ value: 3 }), "insert collision key 3")
  assert(values.insert(Key::{ value: 4 }), "insert collision key 4")
  assert(values.insert(Key::{ value: 5 }), "insert collision key 5")
  assert(values.insert(Key::{ value: 6 }), "insert collision key 6")
  assert(values.insert(Key::{ value: 7 }), "insert collision key 7")
  assert(values.insert(Key::{ value: 8 }), "insert collision key 8")
  assert(values.insert(Key::{ value: 9 }), "insert collision key 9")
  assert(values.insert(Key::{ value: 10 }), "insert collision key 10")
  assert(values.insert(Key::{ value: 11 }), "insert collision key 11")
  assert(values.insert(Key::{ value: 12 }), "insert collision key 12")
  assert(values.insert(Key::{ value: 13 }), "insert collision key 13")
  assert(values.insert(Key::{ value: 14 }), "insert collision key 14")
  assert(values.insert(Key::{ value: 15 }), "insert collision key 15")
  assert(values.insert(Key::{ value: 16 }), "insert collision key 16")
  assert(values.insert(Key::{ value: 17 }), "insert collision key 17")
  assert(values.insert(Key::{ value: 18 }), "insert collision key 18")
  assert(values.insert(Key::{ value: 19 }), "insert collision key 19")
  assert(values.insert(Key::{ value: 20 }), "insert collision key 20")
  assert(values.insert(Key::{ value: 21 }), "insert collision key 21")
  assert(values.insert(Key::{ value: 22 }), "insert collision key 22")
  assert(values.insert(Key::{ value: 23 }), "insert collision key 23")
  assert(values.insert(Key::{ value: 24 }), "insert collision key 24")
  assert(values.insert(Key::{ value: 25 }), "insert collision key 25")
  assert(values.insert(Key::{ value: 26 }), "insert collision key 26")
  assert(values.insert(Key::{ value: 27 }), "insert collision key 27")
  assert(values.insert(Key::{ value: 28 }), "insert collision key 28")
  assert(values.insert(Key::{ value: 29 }), "insert collision key 29")
  assert(values.insert(Key::{ value: 30 }), "insert collision key 30")
  assert(values.insert(Key::{ value: 31 }), "insert collision key 31")
  assert(values.insert(Key::{ value: 32 }), "insert collision key 32")
  assert(values.insert(Key::{ value: 33 }), "insert collision key 33")
  assert(values.insert(Key::{ value: 34 }), "insert collision key 34")
  assert(values.insert(Key::{ value: 35 }), "insert collision key 35")
  assert(values.insert(Key::{ value: 36 }), "insert collision key 36")
  assert(values.insert(Key::{ value: 37 }), "insert collision key 37")
  assert(values.insert(Key::{ value: 38 }), "insert collision key 38")
  assert(values.insert(Key::{ value: 39 }), "insert collision key 39")
  assert(values.insert(Key::{ value: 40 }), "insert collision key 40")
  assert(values.insert(Key::{ value: 41 }), "insert collision key 41")
  assert(values.insert(Key::{ value: 42 }), "insert collision key 42")
  assert(values.insert(Key::{ value: 43 }), "insert collision key 43")
  assert(values.insert(Key::{ value: 44 }), "insert collision key 44")
  assert(values.insert(Key::{ value: 45 }), "insert collision key 45")
  assert(values.insert(Key::{ value: 46 }), "insert collision key 46")
  assert(values.insert(Key::{ value: 47 }), "insert collision key 47")
  assert(values.insert(Key::{ value: 48 }), "insert collision key 48")
  assert(values.insert(Key::{ value: 49 }), "insert collision key 49")
  assert(values.insert(Key::{ value: 50 }), "insert collision key 50")
  assert(values.insert(Key::{ value: 51 }), "insert collision key 51")
  assert(values.insert(Key::{ value: 52 }), "insert collision key 52")
  assert(values.insert(Key::{ value: 53 }), "insert collision key 53")
  assert(values.insert(Key::{ value: 54 }), "insert collision key 54")
  assert(values.insert(Key::{ value: 55 }), "insert collision key 55")
  assert(values.insert(Key::{ value: 56 }), "insert collision key 56")
  assert(values.insert(Key::{ value: 57 }), "insert collision key 57")
  assert(values.insert(Key::{ value: 58 }), "insert collision key 58")
  assert(values.insert(Key::{ value: 59 }), "insert collision key 59")
  assert(values.insert(Key::{ value: 60 }), "insert collision key 60")
  assert(values.insert(Key::{ value: 61 }), "insert collision key 61")
  assert(values.insert(Key::{ value: 62 }), "insert collision key 62")
  assert(values.insert(Key::{ value: 63 }), "insert collision key 63")
  assert(values.insert(Key::{ value: 64 }), "insert collision key 64")
  assert(values.length() == 65u32, "deep collision length")
  assert(values.contains(Key::{ value: 0 }), "deep collision tail lookup")
  assert(values.contains(Key::{ value: 32 }), "deep collision middle lookup")
  assert(values.contains(Key::{ value: 64 }), "deep collision head lookup")
  assert(values.remove(Key::{ value: 64 }), "deep collision remove head")
  assert(values.remove(Key::{ value: 32 }), "deep collision remove middle")
  assert(values.remove(Key::{ value: 0 }), "deep collision remove tail")
  assert(!values.remove(Key::{ value: 999 }), "deep collision remove missing")
  assert(!values.contains(Key::{ value: 64 }), "removed head absent")
  assert(!values.contains(Key::{ value: 32 }), "removed middle absent")
  assert(!values.contains(Key::{ value: 0 }), "removed tail absent")
  assert(values.contains(Key::{ value: 1 }), "deep collision low survivor")
  assert(values.contains(Key::{ value: 63 }), "deep collision high survivor")
  assert(values.length() == 62u32, "deep collision removal length")
}

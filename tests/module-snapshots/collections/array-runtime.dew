open dew.std.array
open dew.std.i32x4
open dew.std.string

fn empty_i32_array() -> Array<I32> {
  Array::new()
}

fn reserved_i64_array() -> Array<I64> {
  Array::with_capacity(1u32)
}

fn empty_f32_array() -> Array<F32> {
  Array::new()
}

fn empty_f64_array() -> Array<F64> {
  Array::new()
}

fn empty_v128_array() -> Array<I32x4> {
  Array::new()
}

fn empty_string_array() -> Array<String> {
  Array::new()
}

fn vector_lane_2(value: I32x4) -> I32 {
  value.extract_2()
}

fn is_second(value: String) -> Bool {
  value.byte_length() == 6u32
}

fn sum_i32(iter: ArrayIter<I32>, sum: I32) -> I32 {
  match iter.next() {
    Option::Some(value) => sum_i32(iter, sum + value)
    Option::None => sum
  }
}

pub fn main() -> Unit {
  let values = empty_i32_array()
  assert(values.length() == 0u32, "array starts empty")
  assert(values.capacity() == 0u32, "array starts at zero capacity")
  assert(values.is_empty(), "array starts logically empty")
  values.push(0)
  values.push(1)
  values.push(2)
  values.push(3)
  values.push(4)
  values.push(5)
  values.push(6)
  values.push(7)
  values.push(8)
  values.push(9)
  assert(values.length() == 10u32, "array repeated growth length")
  assert(values.capacity() == 16u32, "array deterministic doubling capacity")
  assert(values[0u32] == 0, "array growth preserves first element")
  assert(values[4u32] == 4, "array growth preserves middle element")
  assert(values[9u32] == 9, "array growth preserves final element")

  let alias = values
  alias[4u32] = 40
  assert(values[4u32] == 40, "array aliases share indexed mutation")
  assert(values.set(9u32, 90), "array safe set reports success")
  assert(!values.set(10u32, 100), "array safe set reports bounds failure")
  match values.get(9u32) {
    Option::Some(value) => assert(value == 90, "array safe get value")
    Option::None => assert(false, "array safe get unexpectedly empty")
  }
  match values.get(10u32) {
    Option::Some(_) => assert(false, "array out of bounds unexpectedly present")
    Option::None => {}
  }
  match values.pop() {
    Option::Some(value) => assert(value == 90, "array pop returns final value")
    Option::None => assert(false, "array pop unexpectedly empty")
  }
  assert(values.length() == 9u32, "array pop decrements length")
  assert(values.capacity() == 16u32, "array pop preserves capacity")

  let iter = values.iter()
  assert(sum_i32(iter, 0) == 72, "array iterator visits each live element once")

  values.clear()
  assert(values.length() == 0u32, "array clear resets length")
  assert(values.capacity() == 16u32, "array clear preserves capacity")
  match values.pop() {
    Option::Some(_) => assert(false, "cleared array pop unexpectedly present")
    Option::None => {}
  }
  values.push(77)
  assert(alias[0u32] == 77, "array push after clear reuses aliased storage")

  let wide = reserved_i64_array()
  assert(wide.capacity() == 1u32, "array reserved capacity")
  wide.push(9223372036854775807i64)
  wide.push(-9223372036854775807i64)
  assert(wide[0u32] == 9223372036854775807i64, "array i64 carrier")
  assert(wide[1u32] == -9223372036854775807i64, "array i64 growth")

  let singles = empty_f32_array()
  singles.push(1.5f32)
  singles.push(2.5f32)
  assert(singles[1u32] == 2.5f32, "array f32 carrier")

  let doubles = empty_f64_array()
  doubles.push(1.5f64)
  doubles.push(2.5f64)
  assert(doubles[1u32] == 2.5f64, "array f64 carrier")

  let vectors = empty_v128_array()
  vectors.push(i32x4_splat(7))
  vectors.push(i32x4_splat(11))
  assert(vector_lane_2(vectors[1u32]) == 11, "array v128 carrier")

  let strings = empty_string_array()
  strings.push("first")
  strings.push("second")
  match strings.pop() {
    Option::Some(value) => assert(is_second(value), "array reference pop")
    Option::None => assert(false, "array reference pop unexpectedly empty")
  }
  strings.clear()
  assert(strings.is_empty(), "array reference clear")
}

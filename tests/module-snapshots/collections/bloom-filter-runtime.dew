open dew.std.bloom_filter
open dew.std.string
open dew.std.wasi

pub fn main() -> U32 {
  let empty = BloomFilter::empty()
  let with_dew = empty.add("dew")
  let collision = empty.add("p")
  let valid =
    empty.is_empty() &&
    !with_dew.is_empty() &&
    with_dew.maybe_contains("dew") &&
    !with_dew.maybe_contains("starshine") &&
    collision.maybe_contains("0") &&
    !"p".equals("0")
  if valid {
    wasi_fd_write(1u32, b"collections:bloom-filter")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

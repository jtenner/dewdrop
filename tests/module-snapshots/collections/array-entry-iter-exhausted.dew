open dew.std.array

pub fn main() -> Unit {
  let entries = Array::make(1u32, 7).entries()
  match entries.next() {
    Option::Some(entry) => assert(entry.value() == 7, "first entry")
    Option::None => unreachable()
  }
  match entries.next() {
    Option::Some(_) => unreachable()
    Option::None => {}
  }
}

open dew.std.set
open dew.std.fixed_array

fn record_set_order(state: FixedArray<I32>, digit: I32) -> I32 {
  state[0u32] = state[0u32] * 10 + digit
  digit
}

fn ordered_set(state: FixedArray<I32>) -> Set<I32> {
  record_set_order(state, 1)
  Set::empty()
}

fn empty_values() -> Set<I32> {
  Set::empty()
}

pub fn main() -> Unit {
  let empty = empty_values()
  assert(empty.is_empty(), "new set is empty")
  assert(empty.length() == 0u32, "empty set length")
  assert(!empty.contains(1), "empty set contains nothing")
  assert(!empty.remove(1), "remove missing from empty set")
  assert(empty.insert(1), "first insertion reports new")
  assert(!empty.insert(1), "duplicate insertion reports existing")
  assert(empty.length() == 1u32, "duplicate insertion keeps length")

  let values = Set::singleton(0)
  assert(values.insert(16), "collision insert one")
  assert(values.insert(32), "collision insert two")
  assert(values.insert(48), "collision insert three")
  assert(values.length() == 4u32, "collision set length")

  assert(values.remove(48), "remove collision-chain head")
  assert(!values.contains(48), "removed head absent")
  assert(values.remove(16), "remove collision-chain middle")
  assert(!values.contains(16), "removed middle absent")
  assert(values.remove(0), "remove collision-chain tail")
  assert(!values.contains(0), "removed tail absent")
  assert(values.contains(32), "unremoved collision key retained")
  assert(values.length() == 1u32, "removals update length")
  assert(!values.remove(99), "remove missing collision key")

  let alias = values
  alias.clear()
  assert(values.is_empty(), "clear visible through aliases")
  assert(values.length() == 0u32, "clear resets length")
  assert(!values.contains(32), "clear removes old entries")
  assert(values.insert(4), "insert after clear")
  assert(values.contains(4), "post-clear insertion visible")

  let signed = Set::singleton(-1i64)
  assert(signed.contains(-1i64), "negative signed key")
  assert(signed.insert(9223372036854775807i64), "signed maximum key")
  assert(signed.remove(-1i64), "remove negative signed key")

  let unsigned = Set::singleton(18446744073709551615u64)
  assert(unsigned.contains(18446744073709551615u64), "u64 maximum key")

  let order = FixedArray::make(1u32, 0)
  ordered_set(order).insert(record_set_order(order, 2))
  assert(order[0u32] == 12, "set insert evaluates receiver first")
  order[0u32] = 0
  ordered_set(order).contains(record_set_order(order, 2))
  assert(order[0u32] == 12, "set lookup evaluates receiver first")
}

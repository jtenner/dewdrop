  values.insert(Key::{ value: 76 }, 760)
  values.insert(Key::{ value: 77 }, 770)
  values.insert(Key::{ value: 78 }, 780)
  values.insert(Key::{ value: 79 }, 790)
  values.insert(Key::{ value: 80 }, 800)
  values.insert(Key::{ value: 81 }, 810)
  values.insert(Key::{ value: 82 }, 820)
  values.insert(Key::{ value: 83 }, 830)
  values.insert(Key::{ value: 84 }, 840)
  values.insert(Key::{ value: 85 }, 850)
  values.insert(Key::{ value: 86 }, 860)
  values.insert(Key::{ value: 87 }, 870)
  values.insert(Key::{ value: 88 }, 880)
  values.insert(Key::{ value: 89 }, 890)
  values.insert(Key::{ value: 90 }, 900)
  values.insert(Key::{ value: 91 }, 910)
  values.insert(Key::{ value: 92 }, 920)
  values.insert(Key::{ value: 93 }, 930)

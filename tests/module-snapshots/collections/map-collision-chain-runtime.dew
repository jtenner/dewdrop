  values.insert(Key::{ value: 101 }, 1010)
  values.insert(Key::{ value: 102 }, 1020)
  values.insert(Key::{ value: 103 }, 1030)
  values.insert(Key::{ value: 104 }, 1040)
  values.insert(Key::{ value: 105 }, 1050)
  values.insert(Key::{ value: 106 }, 1060)
  values.insert(Key::{ value: 107 }, 1070)
  values.insert(Key::{ value: 108 }, 1080)
  values.insert(Key::{ value: 109 }, 1090)
  values.insert(Key::{ value: 110 }, 1100)
  values.insert(Key::{ value: 111 }, 1110)
  values.insert(Key::{ value: 112 }, 1120)
  values.insert(Key::{ value: 113 }, 1130)
  values.insert(Key::{ value: 114 }, 1140)
  values.insert(Key::{ value: 115 }, 1150)
  values.insert(Key::{ value: 116 }, 1160)
  values.insert(Key::{ value: 117 }, 1170)
  values.insert(Key::{ value: 118 }, 1180)
  values.insert(Key::{ value: 119 }, 1190)
  values.insert(Key::{ value: 120 }, 1200)
  values.insert(Key::{ value: 121 }, 1210)
  values.insert(Key::{ value: 122 }, 1220)
  values.insert(Key::{ value: 123 }, 1230)
  values.insert(Key::{ value: 124 }, 1240)
  values.insert(Key::{ value: 125 }, 1250)
  values.insert(Key::{ value: 126 }, 1260)
  values.insert(Key::{ value: 127 }, 1270)
  values.insert(Key::{ value: 128 }, 1280)
  assert(values.length() == 129u32, "deep collision chain length")
  assert(values[Key::{ value: 0 }] == 0, "deep collision chain tail")
  assert(values[Key::{ value: 64 }] == 640, "deep collision chain middle")
  assert(values[Key::{ value: 128 }] == 1280, "deep collision chain head")
  values[Key::{ value: 0 }] = 1
  values[Key::{ value: 64 }] = 641
  values[Key::{ value: 128 }] = 1281
  assert(values.length() == 129u32, "deep collision replacements keep length")
  assert(values[Key::{ value: 0 }] == 1, "deep collision tail replacement")
  assert(values[Key::{ value: 64 }] == 641, "deep collision middle replacement")
  assert(values[Key::{ value: 128 }] == 1281, "deep collision head replacement")
  assert(!values.contains_key(Key::{ value: 999 }), "deep collision missing lookup")
}

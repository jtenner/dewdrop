  values.insert(Key::{ value: 34 }, 340)
  values.insert(Key::{ value: 35 }, 350)
  values.insert(Key::{ value: 36 }, 360)
  values.insert(Key::{ value: 37 }, 370)
  values.insert(Key::{ value: 38 }, 380)
  values.insert(Key::{ value: 39 }, 390)
  values.insert(Key::{ value: 40 }, 400)
  values.insert(Key::{ value: 41 }, 410)
  values.insert(Key::{ value: 42 }, 420)
  values.insert(Key::{ value: 43 }, 430)
  values.insert(Key::{ value: 44 }, 440)
  values.insert(Key::{ value: 45 }, 450)
  values.insert(Key::{ value: 46 }, 460)
  values.insert(Key::{ value: 47 }, 470)
  values.insert(Key::{ value: 48 }, 480)
  values.insert(Key::{ value: 49 }, 490)
  values.insert(Key::{ value: 50 }, 500)
  values.insert(Key::{ value: 51 }, 510)
  values.insert(Key::{ value: 52 }, 520)
  values.insert(Key::{ value: 53 }, 530)
  values.insert(Key::{ value: 54 }, 540)
  values.insert(Key::{ value: 55 }, 550)
  values.insert(Key::{ value: 56 }, 560)
  values.insert(Key::{ value: 57 }, 570)
  values.insert(Key::{ value: 58 }, 580)
  values.insert(Key::{ value: 59 }, 590)
  values.insert(Key::{ value: 60 }, 600)
  values.insert(Key::{ value: 61 }, 610)
  values.insert(Key::{ value: 62 }, 620)
  values.insert(Key::{ value: 63 }, 630)
  values.insert(Key::{ value: 64 }, 640)
  values.insert(Key::{ value: 65 }, 650)
  values.insert(Key::{ value: 66 }, 660)
  values.insert(Key::{ value: 67 }, 670)
  values.insert(Key::{ value: 68 }, 680)
  values.insert(Key::{ value: 69 }, 690)
  values.insert(Key::{ value: 70 }, 700)

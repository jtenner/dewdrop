open dew.std.map

struct Key {
  value: I32
}

impl Hash for Key {
  fn hash(self) -> U64 {
    0u64
  }
  fn hash_eq(self, right: Key) -> Bool {
    self.value == right.value
  }
}

pub fn main() -> Unit {
  let values = Map::singleton(Key::{ value: 0 }, 0)
  values.insert(Key::{ value: 1 }, 10)
  values.insert(Key::{ value: 2 }, 20)
  values.insert(Key::{ value: 3 }, 30)
  values.insert(Key::{ value: 4 }, 40)
  values.insert(Key::{ value: 5 }, 50)
  values.insert(Key::{ value: 6 }, 60)
  values.insert(Key::{ value: 7 }, 70)
  values.insert(Key::{ value: 8 }, 80)

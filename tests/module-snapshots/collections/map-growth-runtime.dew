open dew.std.map

pub fn main() -> Unit {
  let map = Map::singleton(0u32, 0)
  let map_alias = map
  map_alias.insert(128u32, 10)
  map_alias.insert(256u32, 20)
  map_alias.insert(384u32, 30)
  map_alias.insert(512u32, 40)
  map_alias.insert(640u32, 50)
  map_alias.insert(768u32, 60)
  map_alias.insert(896u32, 70)
  map_alias.insert(1024u32, 80)
  map_alias.insert(1152u32, 90)
  map_alias.insert(1280u32, 100)
  map_alias.insert(1408u32, 110)
  map_alias.insert(1536u32, 120)
  map_alias.insert(1664u32, 130)
  map_alias.insert(1792u32, 140)
  assert(map.length() == 15u32, "Map before first growth length 15")
  map_alias.insert(1920u32, 150)
  assert(map.length() == 16u32, "Map at first threshold length 16")
  map_alias.insert(0u32, 999)
  assert(map.length() == 16u32, "Map replacement at threshold keeps length")
  map_alias.insert(2048u32, 160)
  assert(map.length() == 17u32, "Map after first threshold length 17")
  map_alias.insert(2176u32, 170)
  map_alias.insert(2304u32, 180)
  map_alias.insert(2432u32, 190)
  map_alias.insert(2560u32, 200)
  map_alias.insert(2688u32, 210)
  map_alias.insert(2816u32, 220)
  map_alias.insert(2944u32, 230)
  map_alias.insert(3072u32, 240)
  map_alias.insert(3200u32, 250)
  map_alias.insert(3328u32, 260)
  map_alias.insert(3456u32, 270)
  map_alias.insert(3584u32, 280)
  map_alias.insert(3712u32, 290)
  map_alias.insert(3840u32, 300)
  assert(map.length() == 31u32, "Map before second growth length 31")
  map_alias.insert(3968u32, 310)
  assert(map.length() == 32u32, "Map at second threshold length 32")
  map_alias.insert(4096u32, 320)
  assert(map.length() == 33u32, "Map after second threshold length 33")
  map_alias.insert(4224u32, 330)
  map_alias.insert(4352u32, 340)
  map_alias.insert(4480u32, 350)
  map_alias.insert(4608u32, 360)
  map_alias.insert(4736u32, 370)
  map_alias.insert(4864u32, 380)
  map_alias.insert(4992u32, 390)
  map_alias.insert(5120u32, 400)
  map_alias.insert(5248u32, 410)
  map_alias.insert(5376u32, 420)
  map_alias.insert(5504u32, 430)
  map_alias.insert(5632u32, 440)
  map_alias.insert(5760u32, 450)
  map_alias.insert(5888u32, 460)
  map_alias.insert(6016u32, 470)
  map_alias.insert(6144u32, 480)
  map_alias.insert(6272u32, 490)
  map_alias.insert(6400u32, 500)
  map_alias.insert(6528u32, 510)
  map_alias.insert(6656u32, 520)
  map_alias.insert(6784u32, 530)
  map_alias.insert(6912u32, 540)
  map_alias.insert(7040u32, 550)
  map_alias.insert(7168u32, 560)
  map_alias.insert(7296u32, 570)
  map_alias.insert(7424u32, 580)
  map_alias.insert(7552u32, 590)
  map_alias.insert(7680u32, 600)
  map_alias.insert(7808u32, 610)
  map_alias.insert(7936u32, 620)
  assert(map.length() == 63u32, "Map before third growth length 63")
  map_alias.insert(8064u32, 630)
  assert(map.length() == 64u32, "Map at third threshold length 64")
  map_alias.insert(8192u32, 640)
  assert(map.length() == 65u32, "Map after third threshold length 65")
  map_alias.insert(8320u32, 650)
  assert(map.length() == 66u32, "Map colliding length after three growth boundaries")
  assert(map[0u32] == 999, "Map colliding threshold replacement key survives")
  assert(map[1920u32] == 150, "Map colliding first threshold key survives")
  assert(map[2048u32] == 160, "Map colliding first post-growth key survives")
  assert(map[3968u32] == 310, "Map colliding second threshold key survives")
  assert(map[4096u32] == 320, "Map colliding second post-growth key survives")
  assert(map[8064u32] == 630, "Map colliding third threshold key survives")
  assert(map[8192u32] == 640, "Map colliding third post-growth key survives")
  assert(map[8320u32] == 650, "Map colliding latest key survives")
  assert(map.remove(0u32), "Map removes colliding pre-growth key after growth")
  assert(map.remove(4096u32), "Map removes colliding middle growth key")
  assert(map.remove(8320u32), "Map removes colliding latest growth key")
  assert(map.length() == 63u32, "Map colliding removal after growth updates length")
  assert(!map.contains_key(0u32), "Map removed pre-growth key stays absent")
  assert(!map.contains_key(4096u32), "Map removed middle key stays absent")
  assert(!map.contains_key(8320u32), "Map removed latest key stays absent")
  map_alias.clear()
  assert(map.length() == 0u32, "Map clear after growth is alias visible")
  map.insert(7u32, 70)
  assert(map_alias[7u32] == 70, "Map inserts after clear and growth")
}

open dew.std.wasi

enum Narrow {
  Byte(U8)
  Wide(U16)
  SignedByte(I8)
  SignedWide(I16)
}

fn extract(value: Narrow) -> I32 {
  match value {
    Narrow::Byte(item) => item.into()
    Narrow::Wide(item) => item.into()
    Narrow::SignedByte(item) => item.into()
    Narrow::SignedWide(item) => item.into()
  }
}

pub fn main() -> U32 {
  let byte = Narrow::Byte(255u8)
  let wide = Narrow::Wide(65535u16)
  let signed_byte = Narrow::SignedByte(-128i8)
  let signed_wide = Narrow::SignedWide(-32768i16)
  if extract(byte) == 255 &&
    extract(wide) == 65535 &&
    extract(signed_byte) == -128 &&
    extract(signed_wide) == -32768 {
    wasi_fd_write(1u32, b"control:narrow-payload-match")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

open dew.std.wasi

fn unit() -> Unit {
}

fn unit_loop() -> Unit {
  while unit() {
    _ => break unit()
  }
}

fn nested(initial: I32) -> I32 {
  while initial {
    0 => break 99
    outer => {
      let inner = while 2 {
        0 => break outer - 1
        value => continue value - 1
      }
      continue inner
    }
  }
}

fn through_if(initial: I32) -> I32 {
  while initial {
    value => if value > 0 {
      continue value - 1
    } else {
      break 7
    }
  }
}

fn through_return(initial: I32) -> I32 {
  while initial {
    0 => {
      return 5
    }
    value => continue value - 1
  }
}

pub fn main() -> U32 {
  unit_loop()
  if nested(3) + through_if(3) + through_return(3) == 111 {
    wasi_fd_write(1u32, b"control:while-nested-99-7-5")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

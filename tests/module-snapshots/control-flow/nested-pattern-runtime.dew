open dew.std.wasi

enum Inner {
  A(I32)
  B(I32)
}

enum Outer {
  Wrap(Inner)
  Named {
    inner: Inner
    flag: Bool
  }
}

enum Toggle {
  Off
  On
}

enum WrappedToggle {
  Toggle(Toggle)
}

struct Box {
  inner: Inner
}

fn read_outer(value: Outer) -> I32 {
  match value {
    Outer::Wrap(Inner::A(7)) => 70
    Outer::Wrap(Inner::A(item)), Outer::Wrap(Inner::B(item)) => item
    Outer::Named {
      inner: Inner::A(item)
      flag: true
    } => item + 100
    Outer::Named {
      inner: Inner::A(item)
      flag: false
    } => item + 200
    Outer::Named {
      inner: Inner::B(item)
      ...
    } => item + 300
    _ => -1000
  }
}

fn read_box(value: Box) -> I32 {
  match value {
    Box {
      inner: Inner::A(item)
    } => item
    Box {
      inner: Inner::B(item)
    } => item + 10
    _ => -1000
  }
}

fn read_toggle(value: WrappedToggle) -> I32 {
  match value {
    WrappedToggle::Toggle(Toggle::Off) => 7
    WrappedToggle::Toggle(Toggle::On) => 11
    _ => -1000
  }
}

pub fn main() -> U32 {
  let result = read_outer(Outer::Wrap(Inner::A(7))) +
    read_outer(Outer::Wrap(Inner::B(5))) +
    read_outer(Outer::Named::{
      inner: Inner::A(3)
      flag: true
    }) +
    read_box(Box::{
      inner: Inner::B(4)
    }) +
    read_toggle(WrappedToggle::Toggle(Toggle::On))
  if result == 203 {
    wasi_fd_write(1u32, b"control:nested-patterns")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

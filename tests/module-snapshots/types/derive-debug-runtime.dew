open dew.std.wasi

struct Point {
  x: I32
  y: I32
} derive(Debug)

enum Choice {
  None
  Number(I32)
  Named {
    label: I32
    active: Bool
  }
} derive(Debug)

struct Wrapper<t> {
  value: t
} derive(Debug)

pub fn main() -> U32 {
  let point = Point {
    x: 3
    y: 4
  }
  let named = Choice::Named {
    label: 9
    active: true
  }
  let wrapped = Wrapper {
    value: 42
  }
  debug(point)
  wasi_fd_write(1u32, b"|")
  debug(Choice::Number(7))
  wasi_fd_write(1u32, b"|")
  debug(named)
  wasi_fd_write(1u32, b"|")
  debug(wrapped)
}

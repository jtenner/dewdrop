open dew.std.wasi

struct Point {
  x: I32
  y: I32
} derive(Debug)

enum Choice {
  None
  Number(I32)
  Named {
    label: I32
    active: Bool
  }
} derive(Debug)

struct Wrapper<t> {
  value: t
} derive(Debug)

struct Scene {
  point: Point
  choice: Choice
} derive(Debug)

struct Message {
  text: String
  data: Bytes
} derive(Debug)

fn unit_value() -> Unit {}

pub fn main() -> U32 {
  let point = Point {
    x: 3
    y: 4
  }
  let named = Choice::Named {
    label: 9
    active: true
  }
  let wrapped = Wrapper {
    value: 42
  }
  debug(point)
  wasi_fd_write(1u32, b"|")
  debug(Choice::Number(7))
  wasi_fd_write(1u32, b"|")
  debug(named)
  wasi_fd_write(1u32, b"|")
  debug(wrapped)
  wasi_fd_write(1u32, b"|")
  debug(Scene {
    point: Point {
      x: -5
      y: 6
    }
    choice: Choice::Number(8)
  })
  wasi_fd_write(1u32, b"|")
  debug(0i32)
  wasi_fd_write(1u32, b",")
  debug(-128i8)
  wasi_fd_write(1u32, b",")
  debug(-32768i16)
  wasi_fd_write(1u32, b",")
  debug(-2147483648i32)
  wasi_fd_write(1u32, b",")
  debug(-9223372036854775808i64)
  wasi_fd_write(1u32, b",")
  debug(255u8)
  wasi_fd_write(1u32, b",")
  debug(65535u16)
  wasi_fd_write(1u32, b",")
  debug(4294967295u32)
  wasi_fd_write(1u32, b",")
  debug(18446744073709551615u64)
  wasi_fd_write(1u32, b"|")
  debug(1.5f32)
  wasi_fd_write(1u32, b",")
  debug(-0.0f32)
  wasi_fd_write(1u32, b",")
  debug(1.5f64)
  wasi_fd_write(1u32, b",")
  debug(-0.0f64)
  wasi_fd_write(1u32, b"|")
  debug(unit_value())
  wasi_fd_write(1u32, b"|")
  debug(Message {
    text: "hello λ"
    data: b"\x00A\xff"
  })
}

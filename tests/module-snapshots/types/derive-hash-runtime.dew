open dew.std.wasi

struct Pair<t> {
  left: t
  right: t
} derive(Hash)

enum Choice<t> {
  None
  Some(t)
  Named {
    value: t
  }
} derive(Hash)

struct Nested<t> {
  pair: Pair<t>
  choice: Choice<t>
} derive(Hash)

fn none_i32() -> Choice<I32> {
  Choice::None
}

fn some_i32(value: I32) -> Choice<I32> {
  Choice::Some(value)
}

pub fn main() -> U32 {
  let first = Nested {
    pair: Pair {
      left: 3
      right: 4
    }
    choice: Choice::Some(5)
  }
  let same = Nested {
    pair: Pair {
      left: 3
      right: 4
    }
    choice: Choice::Some(5)
  }
  let different = Nested {
    pair: Pair {
      left: 3
      right: 9
    }
    choice: Choice::Named {
      value: 5
    }
  }
  let valid = first.hash_eq(same) && !first.hash_eq(different) &&
    first.hash() == same.hash() &&
    none_i32().hash_eq(none_i32()) &&
    !none_i32().hash_eq(some_i32(0))
  if valid {
    wasi_fd_write(1u32, b"derive:hash")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

open fixture.generic

fn apply_i32(callback: fn(I32) -> I32, value: I32) -> I32 {
  callback(value)
}

fn apply_i64(callback: fn(I64) -> I64, value: I64) -> I64 {
  callback(value)
}

pub fn main() -> Unit {
  assert(identity(42) == 42, "imported generic direct call")
  assert(apply_i32(identity, 42) == 42, "imported generic i32 callback")
  assert(apply_i64(identity, 42i64) == 42i64, "imported generic i64 callback")
}

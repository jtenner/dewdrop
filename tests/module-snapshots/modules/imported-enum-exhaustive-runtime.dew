open dew.std.wasi
open fixture.state

fn read(value: State) -> I32 {
  match value {
    State::Ready(item) => item
    State::Done(item) => item + 10
  }
}

pub fn main() -> U32 {
  if read(ready(7)) + read(done(2)) == 19 {
    wasi_fd_write(1u32, b"modules:imported-enum-exhaustive")
  } else {
    wasi_fd_write(1u32, b"FAIL")
  }
}

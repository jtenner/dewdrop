    (b"3.40282336497324057985868971510757064704e+38f32", 2139095038U),
    (b"3.40282336497324057985868971510891282432e+38F", 2139095038U),
    (b"3.40282336497324057985868971511025500160e+38f32", 2139095039U),
    (b"3.40282356779733661637539395458008350720e+38F", 2139095039U),
    (b"3.40282356779733661637539395458142568448e+38f32", 2139095040U),
    (b"3.40282356779733661637539395458276786176e+38F", 2139095040U),
    (
      b"1.000_000_059_604_644_775_390_625_000_000_000_000_000_1e+0f32", 1065353217U,
    ),
    (b"10.000000596046447753906249999999999999999e-1F", 1065353216U),
    (b"0.0f32", 0U),
    (b"1.0e-100f32", 0U),
    (b"1.0e100f32", 2139095040U),
    (b"1.25f32", 1067450368U),
  ]
  for pair in cases {
    let (source, expected) = pair
    let kinds = token_kinds(source)

///|
test "f32 decimal literals round once at a midpoint" {
  let kinds = token_kinds(
    b"1.0000000596046447753906249999999999999999f32 1.000000059604644775390625f32 1.0000000596046447753906250000000000000001f32",
  )
  let expected = [0x3f800000U, 0x3f800000U, 0x3f800001U]
  assert_eq(kinds.length(), expected.length())
  for index, kind in kinds {
    match kind {
      F32(value) => assert_eq(value.reinterpret_as_uint(), expected[index])
      _ => fail("expected f32 literal")
    }
  }
}


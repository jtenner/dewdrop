///|
test "f32 long decimal range midpoint neighbors" {
  let cases = [
    (
      "7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015624",
      "7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625",
      "e-46f32", 0U,
    ),
    (
      "2.101947696487225606385594374934874196920392912814773657635602425834686624028790902229957282543182373046874",
      "2.101947696487225606385594374934874196920392912814773657635602425834686624028790902229957282543182373046875",
      "e-45f32", 1U,
    ),
    (
      "3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078124",
      "3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078125",
      "e-45f32", 2U,
    ),
    (
      "1.1754941406275178592461758986628081843312458647327962400313859427181746759860647699724722770042717456817626953124",
      "1.1754941406275178592461758986628081843312458647327962400313859427181746759860647699724722770042717456817626953125",
      "e-38f32", 8388606U,
    ),
    (
      "1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984374",
      "1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984375",
      "e-38f32", 8388607U,
    ),
    (
      "1.1754944208872107242095900834087248423144721207851846153345402941318314539442813071445925743319094181060791015624",
      "1.1754944208872107242095900834087248423144721207851846153345402941318314539442813071445925743319094181060791015625",
      "e-38f32", 8388608U,
    ),
    (
      "1.000000059604644775390624", "1.000000059604644775390625", "e0f32", 1065353216U,
    ),
    (
      "3.40282336497324057985868971510891282431", "3.40282336497324057985868971510891282432",
      "e38f32", 2139095038U,
    ),
    (
      "3.40282356779733661637539395458142568447", "3.40282356779733661637539395458142568448",
      "e38f32", 2139095039U,
    ),
  ]
  for (below, midpoint, suffix, lower) in cases {
    for length in [1024, 65536] {
      for side in [-1, 0, 1] {
        let source = Buffer()
        source.write_string_utf8(if side < 0 { below } else { midpoint })
        for index = 0; index < length; index = index + 1 {
          source.write_byte(if side < 0 { b'9' } else { b'0' })
        }
        if side > 0 {
          source.write_byte(b'1')
        }
        source.write_string_utf8(suffix)
        let expected = lower +
          (if side > 0 || (side == 0 && (lower & 1U) != 0U) { 1U } else { 0U })
        match token_kinds(source.to_bytes()) {
          [F32(actual)] => assert_eq(actual.reinterpret_as_uint(), expected)
          _ => fail("expected one long-range F32 token")
        }
      }
    }
  }
}

///|
test "f32 decimal exponents cancel more than ten thousand leading zeros" {
  for count in [10001, 20000] {
    let source = Buffer()
    source.write_string_utf8("0.")
    for index = 0; index < count; index = index + 1 {
      source.write_byte(b'0')
    }
    source.write_string_utf8("1000000059604644775390625e")
    source.write_string_utf8((count + 1).to_string())
    source.write_string_utf8("f32")
    match token_kinds(source.to_bytes()) {
      [F32(actual)] => assert_eq(actual.reinterpret_as_uint(), 0x3f800000U)
      _ => fail("expected one exponent-cancellation F32 token")
    }
  }
}

///|
pub fn standard_path_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.string\nopen dew.std.string_builder\n\npub enum PathError {\n  Empty\n  Absolute\n  ParentEscape\n  EmptySegment\n  Nul\n  Backslash\n  TooLong\n}\n\npub struct RelativePath {\n  value: String\n}\n\nfn path_has_nul_or_backslash(value: String) -> Option<PathError> {\n  let bytes = value.as_bytes()\n  while 0u32 {\n    index if index < bytes.byte_length() => {\n      let byte = bytes.byte_at(index)\n      if byte == 0u8 {\n        break Option::Some(PathError::Nul)\n      } else if byte == 92u8 {\n        break Option::Some(PathError::Backslash)\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break Option::None\n  }\n}\n\npub fn relative_path(value: String) -> Result<RelativePath, PathError> {\n  if value.byte_length() == 0u32 {\n    Result::Err(PathError::Empty)\n  } else if value.byte_length() > 4096u32 {\n    Result::Err(PathError::TooLong)\n  } else if value.byte_at(0u32) == 47u8 {\n    Result::Err(PathError::Absolute)\n  } else {\n    match path_has_nul_or_backslash(value) {\n      Option::Some(error) => Result::Err(error)\n      Option::None => {\n        let bytes = value.as_bytes()\n        let mut segment_start = 0u32\n        while 0u32 {\n          index if index <= bytes.byte_length() => {\n            if index == bytes.byte_length() || bytes.byte_at(index) == 47u8 {\n              let length = index - segment_start\n              if length == 0u32 {\n                break Result::Err(PathError::EmptySegment)\n              } else if length == 1u32 && bytes.byte_at(segment_start) == 46u8 {\n                break Result::Err(PathError::EmptySegment)\n              } else if length == 2u32 &&\n                bytes.byte_at(segment_start) == 46u8 &&\n                bytes.byte_at(segment_start + 1u32) == 46u8 {\n                break Result::Err(PathError::ParentEscape)\n              } else if index == bytes.byte_length() {\n                break Result::Ok(RelativePath::{\n                  value: value\n                })\n              } else {\n                segment_start = index + 1u32\n                continue index + 1u32\n              }\n            } else {\n              continue index + 1u32\n            }\n          }\n          _ => break Result::Err(PathError::EmptySegment)\n        }\n      }\n    }\n  }\n}\n\nimpl RelativePath {\n  fn to_string(self) -> String {\n    self.value\n  }\n  fn as_bytes(self) -> Bytes {\n    self.value.as_bytes()\n  }\n  fn byte_length(self) -> U32 {\n    self.value.byte_length()\n  }\n  fn join(self, child: String) -> Result<RelativePath, PathError> {\n    match relative_path(child) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(valid_child) => {\n        let builder = StringBuilder::with_capacity(\n          self.value.byte_length() + 1u32 + valid_child.value.byte_length(),\n        )\n        builder.append(self.value)\n        builder.append_ascii(47u8)\n        builder.append(valid_child.value)\n        Result::Ok(RelativePath::{\n          value: builder.finish()\n        })\n      }\n    }\n  }\n}\n"
}

///|
pub fn standard_fs_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.path\nopen dew.std.string\n\npub enum FsOperation {\n  Stat\n  Read\n  Write\n  CreateDirectory\n  Rename\n  RemoveFile\n  RemoveDirectory\n  Sync\n  Close\n}\n\npub enum FsErrorKind {\n  NotFound\n  PermissionDenied\n  AlreadyExists\n  NotDirectory\n  IsDirectory\n  NotEmpty\n  InvalidPath\n  FileTooLarge\n  NoSpace\n  ReadOnly\n  Unsupported\n  Backend\n}\n\npub struct FsError {\n  operation: FsOperation\n  path: String\n  kind: FsErrorKind\n  code: U32\n}\n\npub enum PathKind {\n  Missing\n  File\n  Directory\n  Symlink\n  Other\n}\n\npub trait FileSystem {\n  fn path_kind(self, path: RelativePath) -> Result<PathKind, FsError>\n  fn read_file(self, path: RelativePath, max_bytes: U32) -> Result<Bytes, FsError>\n  fn write_file(self, path: RelativePath, value: Bytes) -> Result<Unit, FsError>\n  fn create_directory(self, path: RelativePath) -> Result<Unit, FsError>\n  fn rename(self, source: RelativePath, destination: RelativePath) -> Result<Unit, FsError>\n  fn remove_file(self, path: RelativePath) -> Result<Unit, FsError>\n  fn remove_directory(self, path: RelativePath) -> Result<Unit, FsError>\n  fn atomic_write(\n    self,\n    temporary: RelativePath,\n    destination: RelativePath,\n    value: Bytes,\n  ) -> Result<Unit, FsError>\n}\n\npub fn fs_path_kind<f: FileSystem>(\n  filesystem: f,\n  path: RelativePath,\n) -> Result<PathKind, FsError> {\n  filesystem.path_kind(path)\n}\n\npub fn fs_read_file<f: FileSystem>(\n  filesystem: f,\n  path: RelativePath,\n  max_bytes: U32,\n) -> Result<Bytes, FsError> {\n  filesystem.read_file(path, max_bytes)\n}\n\npub fn fs_write_file<f: FileSystem>(\n  filesystem: f,\n  path: RelativePath,\n  value: Bytes,\n) -> Result<Unit, FsError> {\n  filesystem.write_file(path, value)\n}\n\npub fn fs_create_directories<f: FileSystem>(\n  filesystem: f,\n  path: RelativePath,\n) -> Result<Unit, FsError> {\n  let source = path.to_string()\n  while 0u32 {\n    index if index <= source.byte_length() => {\n      if index == source.byte_length() || source.byte_at(index) == 47u8 {\n        let prefix = source.slice(0u32, index)\n        match relative_path(prefix) {\n          Result::Err(_) => break Result::Err(FsError::{\n            operation: FsOperation::CreateDirectory\n            path: source\n            kind: FsErrorKind::InvalidPath\n            code: 0u32\n          })\n          Result::Ok(current) =>\n            match filesystem.create_directory(current) {\n              Result::Err(error) => break Result::Err(error)\n              Result::Ok(_) =>\n                if index == source.byte_length() {\n                  break Result::Ok(fs_unit())\n                } else {\n                  continue index + 1u32\n                }\n            }\n        }\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break Result::Ok(fs_unit())\n  }\n}\n\nfn fs_unit() -> Unit {\n}\n\npub fn fs_atomic_write<f: FileSystem>(\n  filesystem: f,\n  temporary: RelativePath,\n  destination: RelativePath,\n  value: Bytes,\n) -> Result<Unit, FsError> {\n  filesystem.atomic_write(temporary, destination, value)\n}\n"
}

///|
pub fn standard_process_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bytes\n\npub enum ProcessOperation {\n  Arguments\n  Environment\n  StandardOutput\n  StandardError\n  Exit\n}\n\npub enum ProcessErrorKind {\n  Missing\n  InvalidUtf8\n  LimitExceeded\n  Unsupported\n  Backend\n}\n\npub struct ProcessError {\n  operation: ProcessOperation\n  kind: ProcessErrorKind\n  code: U32\n}\n\npub trait Process {\n  fn arguments(self, max_count: U32, max_bytes: U32) -> Result<Array<String>, ProcessError>\n  fn environment(self, name: String, max_bytes: U32) -> Result<Option<String>, ProcessError>\n  fn write_stdout(self, value: Bytes) -> Result<U32, ProcessError>\n  fn write_stderr(self, value: Bytes) -> Result<U32, ProcessError>\n  fn exit(self, status: U32) -> Never\n}\n\npub fn process_arguments<p: Process>(\n  process: p,\n  max_count: U32,\n  max_bytes: U32,\n) -> Result<Array<String>, ProcessError> {\n  process.arguments(max_count, max_bytes)\n}\n\npub fn process_environment<p: Process>(\n  process: p,\n  name: String,\n  max_bytes: U32,\n) -> Result<Option<String>, ProcessError> {\n  process.environment(name, max_bytes)\n}\n\npub fn process_write_stdout<p: Process>(\n  process: p,\n  value: Bytes,\n) -> Result<U32, ProcessError> {\n  process.write_stdout(value)\n}\n\npub fn process_write_stderr<p: Process>(\n  process: p,\n  value: Bytes,\n) -> Result<U32, ProcessError> {\n  process.write_stderr(value)\n}\n"
}

///|
pub fn standard_fs_wasi_source() -> Bytes {
  b"import dew.std.wasm.wasi as @wasi\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.path\nopen dew.std.fs\nopen dew.std.wasm.intrinsics\n\npub struct WasiFileSystem {\n  root: U32\n}\n\nfn wasi_fs_unit() -> Unit {\n}\n\npub fn wasi_file_system(root: U32) -> WasiFileSystem {\n  WasiFileSystem::{\n    root: root\n  }\n}\n\nfn wasi_fs_error_kind(code: U32) -> FsErrorKind {\n  match code {\n    2u32 => FsErrorKind::PermissionDenied\n    63u32 => FsErrorKind::PermissionDenied\n    20u32 => FsErrorKind::AlreadyExists\n    22u32 => FsErrorKind::FileTooLarge\n    61u32 => FsErrorKind::FileTooLarge\n    28u32 => FsErrorKind::InvalidPath\n    37u32 => FsErrorKind::InvalidPath\n    31u32 => FsErrorKind::IsDirectory\n    44u32 => FsErrorKind::NotFound\n    51u32 => FsErrorKind::NoSpace\n    54u32 => FsErrorKind::NotDirectory\n    55u32 => FsErrorKind::NotEmpty\n    58u32 => FsErrorKind::Unsupported\n    69u32 => FsErrorKind::ReadOnly\n    _ => FsErrorKind::Backend\n  }\n}\n\nfn wasi_fs_error(operation: FsOperation, path: RelativePath, code: U32) -> FsError {\n  FsError::{\n    operation: operation\n    path: path.to_string()\n    kind: wasi_fs_error_kind(code)\n    code: code\n  }\n}\n\nfn wasi_copy_path(path: RelativePath, pointer: U32) -> U32 {\n  let bytes = path.as_bytes()\n  while 0u32 {\n    index if index < bytes.byte_length() => {\n      wasm_u8_store(pointer + index, bytes.byte_at(index))\n      continue index + 1u32\n    }\n    _ => break bytes.byte_length()\n  }\n}\n\nfn wasi_copy_bytes(value: Bytes, start: U32, pointer: U32, length: U32) -> Unit {\n  while 0u32 {\n    index if index < length => {\n      wasm_u8_store(pointer + index, value.byte_at(start + index))\n      continue index + 1u32\n    }\n    _ => break wasi_fs_unit()\n  }\n}\n\nfn wasi_read_memory(pointer: U32, length: U32, builder: BytesBuilder) -> Unit {\n  while 0u32 {\n    index if index < length => {\n      builder.append_byte(wasm_u8_load(pointer + index))\n      continue index + 1u32\n    }\n    _ => break wasi_fs_unit()\n  }\n}\n\nfn wasi_fs_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\nfn wasi_fs_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn wasi_read_rights() -> U64 {\n  2097154u64\n}\n\nfn wasi_write_rights() -> U64 {\n  6291536u64\n}\n\nimpl FileSystem for WasiFileSystem {\n  fn path_kind(self, path: RelativePath) -> Result<PathKind, FsError> {\n    let path_pointer = 128u32\n    let length = wasi_copy_path(path, path_pointer)\n    let error = @wasi.path_filestat_get(self.root, 0u32, path_pointer, length, 0u32)\n    if error == 44u32 {\n      Result::Ok(PathKind::Missing)\n    } else if error != 0u32 {\n      Result::Err(wasi_fs_error(FsOperation::Stat, path, error))\n    } else {\n      match wasm_u8_load(16u32) {\n        3u8 => Result::Ok(PathKind::Directory)\n        4u8 => Result::Ok(PathKind::File)\n        7u8 => Result::Ok(PathKind::Symlink)\n        _ => Result::Ok(PathKind::Other)\n      }\n    }\n  }\n\n  fn read_file(self, path: RelativePath, max_bytes: U32) -> Result<Bytes, FsError> {\n    let path_pointer = 128u32\n    let path_length = wasi_copy_path(path, path_pointer)\n    let open_error = @wasi.path_open(\n      self.root,\n      0u32,\n      path_pointer,\n      path_length,\n      0u32,\n      wasi_read_rights(),\n      0u64,\n      0u32,\n      0u32,\n    )\n    if open_error != 0u32 {\n      Result::Err(wasi_fs_error(FsOperation::Read, path, open_error))\n    } else {\n      let fd = wasm_u32_load(0u32)\n      let stat_error = @wasi.fd_filestat_get(fd, 0u32)\n      if stat_error != 0u32 {\n        @wasi.fd_close(fd)\n        Result::Err(wasi_fs_error(FsOperation::Stat, path, stat_error))\n      } else {\n        let size = wasm_u64_load(32u32)\n        if size > wasi_fs_u32_to_u64(max_bytes) {\n          @wasi.fd_close(fd)\n          Result::Err(wasi_fs_error(FsOperation::Read, path, 22u32))\n        } else {\n          let expected = wasi_fs_u64_to_u32(size)\n          let builder = BytesBuilder::with_capacity(expected)\n          while 0u32 {\n            total if total < expected => {\n              let window = if expected - total < 49152u32 {\n                expected - total\n              } else {\n                49152u32\n              }\n              wasm_u32_store(0u32, 16u32)\n              wasm_u32_store(4u32, window)\n              let read_error = @wasi.fd_read(fd, 0u32, 1u32, 8u32)\n              let count = wasm_u32_load(8u32)\n              if read_error != 0u32 {\n                @wasi.fd_close(fd)\n                break Result::Err(wasi_fs_error(FsOperation::Read, path, read_error))\n              } else if count == 0u32 {\n                @wasi.fd_close(fd)\n                break Result::Ok(builder.finish())\n              } else if count > window {\n                @wasi.fd_close(fd)\n                break Result::Err(wasi_fs_error(FsOperation::Read, path, 29u32))\n              } else {\n                wasi_read_memory(16u32, count, builder)\n                continue total + count\n              }\n            }\n            _ => {\n              @wasi.fd_close(fd)\n              break Result::Ok(builder.finish())\n            }\n          }\n        }\n      }\n    }\n  }\n\n  fn write_file(self, path: RelativePath, value: Bytes) -> Result<Unit, FsError> {\n    let path_pointer = 128u32\n    let path_length = wasi_copy_path(path, path_pointer)\n    let open_error = @wasi.path_open(\n      self.root,\n      0u32,\n      path_pointer,\n      path_length,\n      9u32,\n      wasi_write_rights(),\n      0u64,\n      0u32,\n      0u32,\n    )\n    if open_error != 0u32 {\n      Result::Err(wasi_fs_error(FsOperation::Write, path, open_error))\n    } else {\n      let fd = wasm_u32_load(0u32)\n      let length = value.byte_length()\n      while 0u32 {\n        total if total < length => {\n          let window = if length - total < 49152u32 {\n            length - total\n          } else {\n            49152u32\n          }\n          wasi_copy_bytes(value, total, 16u32, window)\n          wasm_u32_store(0u32, 16u32)\n          wasm_u32_store(4u32, window)\n          let write_error = @wasi.fd_write(fd, 0u32, 1u32, 8u32)\n          let count = wasm_u32_load(8u32)\n          if write_error != 0u32 || count == 0u32 || count > window {\n            @wasi.fd_close(fd)\n            let reported_error = if write_error == 0u32 {\n              29u32\n            } else {\n              write_error\n            }\n            break Result::Err(\n              wasi_fs_error(FsOperation::Write, path, reported_error),\n            )\n          } else {\n            continue total + count\n          }\n        }\n        _ => {\n          let sync_error = @wasi.fd_sync(fd)\n          let close_error = @wasi.fd_close(fd)\n          if sync_error != 0u32 {\n            break Result::Err(wasi_fs_error(FsOperation::Sync, path, sync_error))\n          } else if close_error != 0u32 {\n            break Result::Err(wasi_fs_error(FsOperation::Close, path, close_error))\n          } else {\n            break Result::Ok(wasi_fs_unit())\n          }\n        }\n      }\n    }\n  }\n\n  fn create_directory(self, path: RelativePath) -> Result<Unit, FsError> {\n    let pointer = 128u32\n    let length = wasi_copy_path(path, pointer)\n    let error = @wasi.path_create_directory(self.root, pointer, length)\n    if error == 0u32 || error == 20u32 {\n      Result::Ok(wasi_fs_unit())\n    } else {\n      Result::Err(wasi_fs_error(FsOperation::CreateDirectory, path, error))\n    }\n  }\n\n  fn rename(self, source: RelativePath, destination: RelativePath) -> Result<Unit, FsError> {\n    let source_pointer = 128u32\n    let source_length = wasi_copy_path(source, source_pointer)\n    let destination_pointer = source_pointer + source_length\n    let destination_length = wasi_copy_path(destination, destination_pointer)\n    let error = @wasi.path_rename(\n      self.root,\n      source_pointer,\n      source_length,\n      self.root,\n      destination_pointer,\n      destination_length,\n    )\n    if error == 0u32 {\n      Result::Ok(wasi_fs_unit())\n    } else {\n      Result::Err(wasi_fs_error(FsOperation::Rename, source, error))\n    }\n  }\n\n  fn remove_file(self, path: RelativePath) -> Result<Unit, FsError> {\n    let pointer = 128u32\n    let length = wasi_copy_path(path, pointer)\n    let error = @wasi.path_unlink_file(self.root, pointer, length)\n    if error == 0u32 || error == 44u32 {\n      Result::Ok(wasi_fs_unit())\n    } else {\n      Result::Err(wasi_fs_error(FsOperation::RemoveFile, path, error))\n    }\n  }\n\n  fn remove_directory(self, path: RelativePath) -> Result<Unit, FsError> {\n    let pointer = 128u32\n    let length = wasi_copy_path(path, pointer)\n    let error = @wasi.path_remove_directory(self.root, pointer, length)\n    if error == 0u32 || error == 44u32 {\n      Result::Ok(wasi_fs_unit())\n    } else {\n      Result::Err(wasi_fs_error(FsOperation::RemoveDirectory, path, error))\n    }\n  }\n\n  fn atomic_write(\n    self,\n    temporary: RelativePath,\n    destination: RelativePath,\n    value: Bytes,\n  ) -> Result<Unit, FsError> {\n    match self.write_file(temporary, value) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(_) => self.rename(temporary, destination)\n    }\n  }\n}\n"
}

///|
pub fn standard_fs_facet_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.path\nopen dew.std.fs\n\nforeign type FacetI32Result\nforeign type FacetI64Result\nforeign type FacetStatResult\n\nforeign impl \"facet\" as FacetFsHost {\n  fn abi_version() -> U32 = \"abi_version\"\n  fn i32_value(value: FacetI32Result) -> U32 = \"i32_result_value\"\n  fn i32_error(value: FacetI32Result) -> U32 = \"i32_result_error\"\n  fn i64_value(value: FacetI64Result) -> U64 = \"i64_result_value\"\n  fn i64_error(value: FacetI64Result) -> U32 = \"i64_result_error\"\n  fn stat_file_type(value: FacetStatResult) -> U32 = \"stat_result_file_type\"\n  fn stat_size(value: FacetStatResult) -> U64 = \"stat_result_size\"\n  fn stat_error(value: FacetStatResult) -> U32 = \"stat_result_error\"\n  fn handle_close(handle: U32) -> U32 = \"handle_close\"\n  fn fs_preopen_get(index: U32) -> FacetI32Result = \"fs_preopen_get\"\n  fn fd_stat(fd: U32) -> FacetStatResult = \"fd_stat\"\n  fn fd_read(fd: U32, buffer: FixedArray<U8>, offset: U64, length: U64) -> FacetI64Result = \"fd_read_array_i8\"\n  fn fd_write(fd: U32, buffer: FixedArray<U8>, offset: U64, length: U64) -> FacetI64Result = \"fd_write_array_i8\"\n  fn fd_sync(fd: U32) -> U32 = \"fd_sync\"\n  fn path_open(directory: U32, path: FixedArray<U8>, offset: U32, length: U32, wtf: U32, flags: U32, rights: U64) -> FacetI32Result = \"path_open_array_i8\"\n  fn path_stat(directory: U32, path: FixedArray<U8>, offset: U32, length: U32, wtf: U32, flags: U32) -> FacetStatResult = \"path_stat_array_i8\"\n  fn path_create_directory(directory: U32, path: FixedArray<U8>, offset: U32, length: U32, wtf: U32) -> U32 = \"path_create_dir_array_i8\"\n  fn path_remove(directory: U32, path: FixedArray<U8>, offset: U32, length: U32, wtf: U32, flags: U32) -> U32 = \"path_remove_array_i8\"\n  fn path_rename(source_directory: U32, source: FixedArray<U8>, source_offset: U32, source_length: U32, source_wtf: U32, destination_directory: U32, destination: FixedArray<U8>, destination_offset: U32, destination_length: U32, destination_wtf: U32, flags: U32) -> U32 = \"path_rename_array_i8\"\n}\n\npub struct FacetFileSystem {\n  root: U32\n}\n\npub fn facet_file_system(root: U32) -> FacetFileSystem {\n  FacetFileSystem::{\n    root: root\n  }\n}\n\npub fn facet_abi_version() -> U32 {\n  FacetFsHost.abi_version()\n}\n\nfn facet_root_error(code: U32) -> FsError {\n  FsError::{\n    operation: FsOperation::Stat\n    path: \"\"\n    kind: facet_error_kind(code)\n    code: code\n  }\n}\n\npub fn facet_preopen_file_system(index: U32) -> Result<FacetFileSystem, FsError> {\n  let result = FacetFsHost.fs_preopen_get(index)\n  let error = FacetFsHost.i32_error(result)\n  if error == 0u32 {\n    Result::Ok(facet_file_system(FacetFsHost.i32_value(result)))\n  } else {\n    Result::Err(facet_root_error(error))\n  }\n}\n\nfn facet_fs_unit() -> Unit {\n}\n\nfn facet_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn facet_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\nfn facet_path_buffer(path: RelativePath) -> FixedArray<U8> {\n  let bytes = path.as_bytes()\n  let output = FixedArray::make(bytes.byte_length(), 0u8)\n  while 0u32 {\n    index if index < bytes.byte_length() => {\n      output.set_unchecked(index, bytes.byte_at(index))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\nfn facet_bytes_buffer(value: Bytes) -> FixedArray<U8> {\n  let output = FixedArray::make(value.byte_length(), 0u8)\n  while 0u32 {\n    index if index < value.byte_length() => {\n      output.set_unchecked(index, value.byte_at(index))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\nfn facet_buffer_bytes(value: FixedArray<U8>, length: U32) -> Bytes {\n  let builder = BytesBuilder::with_capacity(length)\n  while 0u32 {\n    index if index < length => {\n      builder.append_byte(value.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break builder.finish()\n  }\n}\n\nfn facet_error_kind(code: U32) -> FsErrorKind {\n  match code {\n    1u32 => FsErrorKind::PermissionDenied\n    7u32 => FsErrorKind::PermissionDenied\n    37u32 => FsErrorKind::PermissionDenied\n    2u32 => FsErrorKind::NotFound\n    9u32 => FsErrorKind::AlreadyExists\n    10u32 => FsErrorKind::NotDirectory\n    11u32 => FsErrorKind::IsDirectory\n    13u32 => FsErrorKind::FileTooLarge\n    22u32 => FsErrorKind::FileTooLarge\n    14u32 => FsErrorKind::NoSpace\n    26u32 => FsErrorKind::NoSpace\n    15u32 => FsErrorKind::ReadOnly\n    18u32 => FsErrorKind::NotEmpty\n    12u32 => FsErrorKind::InvalidPath\n    19u32 => FsErrorKind::InvalidPath\n    20u32 => FsErrorKind::InvalidPath\n    21u32 => FsErrorKind::Unsupported\n    _ => FsErrorKind::Backend\n  }\n}\n\nfn facet_fs_error(operation: FsOperation, path: RelativePath, code: U32) -> FsError {\n  FsError::{\n    operation: operation\n    path: path.to_string()\n    kind: facet_error_kind(code)\n    code: code\n  }\n}\n\nfn facet_read_rights() -> U64 {\n  25u64\n}\n\nfn facet_write_rights() -> U64 {\n  123u64\n}\n\nimpl FileSystem for FacetFileSystem {\n  fn path_kind(self, path: RelativePath) -> Result<PathKind, FsError> {\n    let buffer = facet_path_buffer(path)\n    let result = FacetFsHost.path_stat(self.root, buffer, 0u32, buffer.length(), 0u32, 0u32)\n    let error = FacetFsHost.stat_error(result)\n    if error == 2u32 {\n      Result::Ok(PathKind::Missing)\n    } else if error != 0u32 {\n      Result::Err(facet_fs_error(FsOperation::Stat, path, error))\n    } else {\n      match FacetFsHost.stat_file_type(result) {\n        1u32 => Result::Ok(PathKind::File)\n        2u32 => Result::Ok(PathKind::Directory)\n        3u32 => Result::Ok(PathKind::Symlink)\n        _ => Result::Ok(PathKind::Other)\n      }\n    }\n  }\n\n  fn read_file(self, path: RelativePath, max_bytes: U32) -> Result<Bytes, FsError> {\n    let path_buffer = facet_path_buffer(path)\n    let opened = FacetFsHost.path_open(\n      self.root,\n      path_buffer,\n      0u32,\n      path_buffer.length(),\n      0u32,\n      0u32,\n      facet_read_rights(),\n    )\n    let open_error = FacetFsHost.i32_error(opened)\n    if open_error != 0u32 {\n      Result::Err(facet_fs_error(FsOperation::Read, path, open_error))\n    } else {\n      let fd = FacetFsHost.i32_value(opened)\n      let stat = FacetFsHost.fd_stat(fd)\n      let stat_error = FacetFsHost.stat_error(stat)\n      if stat_error != 0u32 {\n        FacetFsHost.handle_close(fd)\n        Result::Err(facet_fs_error(FsOperation::Stat, path, stat_error))\n      } else {\n        let size = FacetFsHost.stat_size(stat)\n        if size > facet_u32_to_u64(max_bytes) {\n          FacetFsHost.handle_close(fd)\n          Result::Err(facet_fs_error(FsOperation::Read, path, 13u32))\n        } else {\n          let length = facet_u64_to_u32(size)\n          let buffer = FixedArray::make(length, 0u8)\n          while 0u64 {\n            total if total < size => {\n              let read = FacetFsHost.fd_read(fd, buffer, total, size - total)\n              let error = FacetFsHost.i64_error(read)\n              let count = FacetFsHost.i64_value(read)\n              if error != 0u32 {\n                FacetFsHost.handle_close(fd)\n                break Result::Err(facet_fs_error(FsOperation::Read, path, error))\n              } else if count == 0u64 {\n                FacetFsHost.handle_close(fd)\n                break Result::Ok(facet_buffer_bytes(buffer, facet_u64_to_u32(total)))\n              } else {\n                continue total + count\n              }\n            }\n            _ => {\n              FacetFsHost.handle_close(fd)\n              break Result::Ok(facet_buffer_bytes(buffer, length))\n            }\n          }\n        }\n      }\n    }\n  }\n\n  fn write_file(self, path: RelativePath, value: Bytes) -> Result<Unit, FsError> {\n    let path_buffer = facet_path_buffer(path)\n    let opened = FacetFsHost.path_open(\n      self.root,\n      path_buffer,\n      0u32,\n      path_buffer.length(),\n      0u32,\n      5u32,\n      facet_write_rights(),\n    )\n    let open_error = FacetFsHost.i32_error(opened)\n    if open_error != 0u32 {\n      Result::Err(facet_fs_error(FsOperation::Write, path, open_error))\n    } else {\n      let fd = FacetFsHost.i32_value(opened)\n      let buffer = facet_bytes_buffer(value)\n      let length = facet_u32_to_u64(buffer.length())\n      while 0u64 {\n        total if total < length => {\n          let written = FacetFsHost.fd_write(fd, buffer, total, length - total)\n          let error = FacetFsHost.i64_error(written)\n          let count = FacetFsHost.i64_value(written)\n          if error != 0u32 || count == 0u64 {\n            FacetFsHost.handle_close(fd)\n            let reported_error = if error == 0u32 {\n              3u32\n            } else {\n              error\n            }\n            break Result::Err(facet_fs_error(FsOperation::Write, path, reported_error))\n          } else {\n            continue total + count\n          }\n        }\n        _ => {\n          let sync_error = FacetFsHost.fd_sync(fd)\n          let close_error = FacetFsHost.handle_close(fd)\n          if sync_error != 0u32 {\n            break Result::Err(facet_fs_error(FsOperation::Sync, path, sync_error))\n          } else if close_error != 0u32 {\n            break Result::Err(facet_fs_error(FsOperation::Close, path, close_error))\n          } else {\n            break Result::Ok(facet_fs_unit())\n          }\n        }\n      }\n    }\n  }\n\n  fn create_directory(self, path: RelativePath) -> Result<Unit, FsError> {\n    let buffer = facet_path_buffer(path)\n    let error = FacetFsHost.path_create_directory(self.root, buffer, 0u32, buffer.length(), 0u32)\n    if error == 0u32 || error == 9u32 {\n      Result::Ok(facet_fs_unit())\n    } else {\n      Result::Err(facet_fs_error(FsOperation::CreateDirectory, path, error))\n    }\n  }\n\n  fn rename(self, source: RelativePath, destination: RelativePath) -> Result<Unit, FsError> {\n    let source_buffer = facet_path_buffer(source)\n    let destination_buffer = facet_path_buffer(destination)\n    let error = FacetFsHost.path_rename(\n      self.root,\n      source_buffer,\n      0u32,\n      source_buffer.length(),\n      0u32,\n      self.root,\n      destination_buffer,\n      0u32,\n      destination_buffer.length(),\n      0u32,\n      1u32,\n    )\n    if error == 0u32 {\n      Result::Ok(facet_fs_unit())\n    } else {\n      Result::Err(facet_fs_error(FsOperation::Rename, source, error))\n    }\n  }\n\n  fn remove_file(self, path: RelativePath) -> Result<Unit, FsError> {\n    let buffer = facet_path_buffer(path)\n    let error = FacetFsHost.path_remove(self.root, buffer, 0u32, buffer.length(), 0u32, 1u32)\n    if error == 0u32 || error == 2u32 {\n      Result::Ok(facet_fs_unit())\n    } else {\n      Result::Err(facet_fs_error(FsOperation::RemoveFile, path, error))\n    }\n  }\n\n  fn remove_directory(self, path: RelativePath) -> Result<Unit, FsError> {\n    let buffer = facet_path_buffer(path)\n    let error = FacetFsHost.path_remove(self.root, buffer, 0u32, buffer.length(), 0u32, 2u32)\n    if error == 0u32 || error == 2u32 {\n      Result::Ok(facet_fs_unit())\n    } else {\n      Result::Err(facet_fs_error(FsOperation::RemoveDirectory, path, error))\n    }\n  }\n\n  fn atomic_write(\n    self,\n    temporary: RelativePath,\n    destination: RelativePath,\n    value: Bytes,\n  ) -> Result<Unit, FsError> {\n    match self.write_file(temporary, value) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(_) => self.rename(temporary, destination)\n    }\n  }\n}\n"
}

///|
pub fn standard_process_wasi_source() -> Bytes {
  b"import dew.std.wasm.wasi as @wasi\nopen dew.std.array\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.process\nopen dew.std.string\nopen dew.std.wasm.intrinsics\n\npub struct WasiProcess {\n}\n\npub fn wasi_process() -> WasiProcess {\n  WasiProcess::{}\n}\n\nfn wasi_process_error(\n  operation: ProcessOperation,\n  kind: ProcessErrorKind,\n  code: U32,\n) -> ProcessError {\n  ProcessError::{\n    operation: operation\n    kind: kind\n    code: code\n  }\n}\n\nfn wasi_process_backend_error(operation: ProcessOperation, code: U32) -> ProcessError {\n  wasi_process_error(operation, ProcessErrorKind::Backend, code)\n}\n\nfn wasi_memory_string(pointer: U32, length: U32) -> Result<String, ProcessError> {\n  let builder = BytesBuilder::with_capacity(length)\n  while 0u32 {\n    index if index < length => {\n      builder.append_byte(wasm_u8_load(pointer + index))\n      continue index + 1u32\n    }\n    _ => {\n      let value = builder.finish()\n      if value.is_valid_utf8() {\n        break Result::Ok(value.to_string())\n      } else {\n        break Result::Err(\n          wasi_process_error(ProcessOperation::Arguments, ProcessErrorKind::InvalidUtf8, 25u32),\n        )\n      }\n    }\n  }\n}\n\nfn wasi_find_zero(pointer: U32, limit: U32) -> Option<U32> {\n  while 0u32 {\n    index if index < limit => {\n      if wasm_u8_load(pointer + index) == 0u8 {\n        break Option::Some(index)\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break Option::None\n  }\n}\n\nfn wasi_process_write(\n  descriptor: U32,\n  operation: ProcessOperation,\n  value: Bytes,\n) -> Result<U32, ProcessError> {\n  let length = value.byte_length()\n  while 0u32 {\n    total if total < length => {\n      let window = if length - total < 49152u32 {\n        length - total\n      } else {\n        49152u32\n      }\n      while 0u32 {\n        index if index < window => {\n          wasm_u8_store(16u32 + index, value.byte_at(total + index))\n          continue index + 1u32\n        }\n        _ => break 0u32\n      }\n      wasm_u32_store(0u32, 16u32)\n      wasm_u32_store(4u32, window)\n      let error = @wasi.fd_write(descriptor, 0u32, 1u32, 8u32)\n      let count = wasm_u32_load(8u32)\n      if error != 0u32 || count == 0u32 || count > window {\n        break Result::Err(\n          wasi_process_backend_error(operation, if error == 0u32 {\n            29u32\n          } else {\n            error\n          }),\n        )\n      } else {\n        continue total + count\n      }\n    }\n    _ => break Result::Ok(length)\n  }\n}\n\nimpl Process for WasiProcess {\n  fn arguments(self, max_count: U32, max_bytes: U32) -> Result<Array<String>, ProcessError> {\n    let error = @wasi.args_sizes_get(0u32, 4u32)\n    if error != 0u32 {\n      Result::Err(wasi_process_backend_error(ProcessOperation::Arguments, error))\n    } else {\n      let count = wasm_u32_load(0u32)\n      let bytes = wasm_u32_load(4u32)\n      if count > max_count || bytes > max_bytes || count > 4096u32 || bytes > 49152u32 {\n        Result::Err(\n          wasi_process_error(ProcessOperation::Arguments, ProcessErrorKind::LimitExceeded, 61u32),\n        )\n      } else {\n        let pointer_table = 16u32\n        let text_start = pointer_table + count * 4u32\n        let get_error = @wasi.args_get(pointer_table, text_start)\n        if get_error != 0u32 {\n          Result::Err(wasi_process_backend_error(ProcessOperation::Arguments, get_error))\n        } else {\n          let output = Array::with_capacity(count)\n          while 0u32 {\n            index if index < count => {\n              let pointer = wasm_u32_load(pointer_table + index * 4u32)\n              match wasi_find_zero(pointer, text_start + bytes - pointer) {\n                Option::None => break Result::Err(\n                  wasi_process_backend_error(ProcessOperation::Arguments, 28u32),\n                )\n                Option::Some(length) =>\n                  match wasi_memory_string(pointer, length) {\n                    Result::Err(read_error) => break Result::Err(read_error)\n                    Result::Ok(value) => {\n                      output.push(value)\n                      continue index + 1u32\n                    }\n                  }\n              }\n            }\n            _ => break Result::Ok(output)\n          }\n        }\n      }\n    }\n  }\n\n  fn environment(self, name: String, max_bytes: U32) -> Result<Option<String>, ProcessError> {\n    let error = @wasi.environ_sizes_get(0u32, 4u32)\n    if error != 0u32 {\n      Result::Err(wasi_process_backend_error(ProcessOperation::Environment, error))\n    } else {\n      let count = wasm_u32_load(0u32)\n      let bytes = wasm_u32_load(4u32)\n      if count > 4096u32 || bytes > max_bytes || bytes > 49152u32 {\n        Result::Err(\n          wasi_process_error(ProcessOperation::Environment, ProcessErrorKind::LimitExceeded, 61u32),\n        )\n      } else {\n        let pointer_table = 16u32\n        let text_start = pointer_table + count * 4u32\n        let get_error = @wasi.environ_get(pointer_table, text_start)\n        if get_error != 0u32 {\n          Result::Err(wasi_process_backend_error(ProcessOperation::Environment, get_error))\n        } else {\n          while 0u32 {\n            index if index < count => {\n              let pointer = wasm_u32_load(pointer_table + index * 4u32)\n              match wasi_find_zero(pointer, text_start + bytes - pointer) {\n                Option::None => break Result::Err(\n                  wasi_process_backend_error(ProcessOperation::Environment, 28u32),\n                )\n                Option::Some(length) => {\n                  let mut equal = 4294967295u32\n                  while 0u32 {\n                    offset if offset < length => {\n                      if wasm_u8_load(pointer + offset) == 61u8 {\n                        equal = offset\n                        break offset\n                      } else {\n                        continue offset + 1u32\n                      }\n                    }\n                    _ => break 0u32\n                  }\n                  if equal != 4294967295u32 && equal == name.byte_length() {\n                    let name_bytes = name.as_bytes()\n                    let mut matches = true\n                    while 0u32 {\n                      offset if offset < equal => {\n                        matches = matches && wasm_u8_load(pointer + offset) == name_bytes.byte_at(offset)\n                        continue offset + 1u32\n                      }\n                      _ => break 0u32\n                    }\n                    if matches {\n                      match wasi_memory_string(pointer + equal + 1u32, length - equal - 1u32) {\n                        Result::Err(read_error) => break Result::Err(read_error)\n                        Result::Ok(value) => break Result::Ok(Option::Some(value))\n                      }\n                    } else {\n                      continue index + 1u32\n                    }\n                  } else {\n                    continue index + 1u32\n                  }\n                }\n              }\n            }\n            _ => break Result::Ok(Option::None)\n          }\n        }\n      }\n    }\n  }\n\n  fn write_stdout(self, value: Bytes) -> Result<U32, ProcessError> {\n    wasi_process_write(1u32, ProcessOperation::StandardOutput, value)\n  }\n\n  fn write_stderr(self, value: Bytes) -> Result<U32, ProcessError> {\n    wasi_process_write(2u32, ProcessOperation::StandardError, value)\n  }\n\n  fn exit(self, status: U32) -> Never {\n    @wasi.proc_exit(status)\n    unreachable()\n  }\n}\n"
}

///|
pub fn standard_process_facet_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.array\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.process\nopen dew.std.string\n\nforeign type FacetProcessI32Result\nforeign type FacetProcessI64Result\n\nforeign impl \"facet\" as FacetProcessHost {\n  fn abi_version() -> U32 = \"abi_version\"\n  fn i32_value(value: FacetProcessI32Result) -> U32 = \"i32_result_value\"\n  fn i32_error(value: FacetProcessI32Result) -> U32 = \"i32_result_error\"\n  fn i64_value(value: FacetProcessI64Result) -> U64 = \"i64_result_value\"\n  fn i64_error(value: FacetProcessI64Result) -> U32 = \"i64_result_error\"\n  fn args_count() -> FacetProcessI32Result = \"args_count\"\n  fn args_len(index: U32, wtf: U32) -> FacetProcessI64Result = \"args_len_i8\"\n  fn args_read(index: U32, wtf: U32, destination: FixedArray<U8>, offset: U32, capacity: U32) -> FacetProcessI64Result = \"args_read_into_array_i8\"\n  fn env_count() -> FacetProcessI32Result = \"env_count\"\n  fn env_len(index: U32, field: U32, wtf: U32) -> FacetProcessI64Result = \"env_len_i8\"\n  fn env_read(index: U32, field: U32, wtf: U32, destination: FixedArray<U8>, offset: U32, capacity: U32) -> FacetProcessI64Result = \"env_read_into_array_i8\"\n  fn stdio_stdout() -> FacetProcessI32Result = \"stdio_stdout\"\n  fn stdio_stderr() -> FacetProcessI32Result = \"stdio_stderr\"\n  fn fd_write(fd: U32, source: FixedArray<U8>, offset: U64, length: U64) -> FacetProcessI64Result = \"fd_write_array_i8\"\n  fn proc_exit(status: U32) -> Unit = \"proc_exit\"\n}\n\npub struct FacetProcess {\n}\n\npub fn facet_process() -> FacetProcess {\n  FacetProcess::{}\n}\n\npub fn facet_process_abi_version() -> U32 {\n  FacetProcessHost.abi_version()\n}\n\nfn facet_process_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn facet_process_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\nfn facet_process_error(\n  operation: ProcessOperation,\n  kind: ProcessErrorKind,\n  code: U32,\n) -> ProcessError {\n  ProcessError::{\n    operation: operation\n    kind: kind\n    code: code\n  }\n}\n\nfn facet_process_backend_error(operation: ProcessOperation, code: U32) -> ProcessError {\n  facet_process_error(operation, ProcessErrorKind::Backend, code)\n}\n\nfn facet_process_buffer(value: Bytes) -> FixedArray<U8> {\n  let output = FixedArray::make(value.byte_length(), 0u8)\n  while 0u32 {\n    index if index < value.byte_length() => {\n      output.set_unchecked(index, value.byte_at(index))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\nfn facet_text_from_buffer(\n  buffer: FixedArray<U8>,\n  count: U32,\n  operation: ProcessOperation,\n) -> Result<String, ProcessError> {\n  let builder = BytesBuilder::with_capacity(count)\n  while 0u32 {\n    index if index < count => {\n      builder.append_byte(buffer.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => {\n      let bytes = builder.finish()\n      if bytes.is_valid_utf8() {\n        break Result::Ok(bytes.to_string())\n      } else {\n        break Result::Err(\n          facet_process_error(operation, ProcessErrorKind::InvalidUtf8, 23u32),\n        )\n      }\n    }\n  }\n}\n\nfn facet_argument(\n  index: U32,\n  max_bytes: U32,\n) -> Result<String, ProcessError> {\n  let operation = ProcessOperation::Arguments\n  let length_result = FacetProcessHost.args_len(index, 0u32)\n  let length_error = FacetProcessHost.i64_error(length_result)\n  if length_error != 0u32 {\n    Result::Err(facet_process_backend_error(operation, length_error))\n  } else {\n    let length = FacetProcessHost.i64_value(length_result)\n    if length > facet_process_u32_to_u64(max_bytes) {\n      Result::Err(\n        facet_process_error(operation, ProcessErrorKind::LimitExceeded, 17u32),\n      )\n    } else {\n      let count = facet_process_u64_to_u32(length)\n      let buffer = FixedArray::make(count, 0u8)\n      let read = FacetProcessHost.args_read(index, 0u32, buffer, 0u32, count)\n      let read_error = FacetProcessHost.i64_error(read)\n      let written = FacetProcessHost.i64_value(read)\n      if read_error != 0u32 {\n        Result::Err(facet_process_backend_error(operation, read_error))\n      } else if written != length {\n        Result::Err(facet_process_backend_error(operation, 17u32))\n      } else {\n        facet_text_from_buffer(buffer, count, operation)\n      }\n    }\n  }\n}\n\nfn facet_environment_field(\n  index: U32,\n  field: U32,\n  max_bytes: U32,\n) -> Result<String, ProcessError> {\n  let operation = ProcessOperation::Environment\n  let length_result = FacetProcessHost.env_len(index, field, 0u32)\n  let length_error = FacetProcessHost.i64_error(length_result)\n  if length_error != 0u32 {\n    Result::Err(facet_process_backend_error(operation, length_error))\n  } else {\n    let length = FacetProcessHost.i64_value(length_result)\n    if length > facet_process_u32_to_u64(max_bytes) {\n      Result::Err(\n        facet_process_error(operation, ProcessErrorKind::LimitExceeded, 17u32),\n      )\n    } else {\n      let count = facet_process_u64_to_u32(length)\n      let buffer = FixedArray::make(count, 0u8)\n      let read = FacetProcessHost.env_read(index, field, 0u32, buffer, 0u32, count)\n      let read_error = FacetProcessHost.i64_error(read)\n      let written = FacetProcessHost.i64_value(read)\n      if read_error != 0u32 {\n        Result::Err(facet_process_backend_error(operation, read_error))\n      } else if written != length {\n        Result::Err(facet_process_backend_error(operation, 17u32))\n      } else {\n        facet_text_from_buffer(buffer, count, operation)\n      }\n    }\n  }\n}\n\nfn facet_write_stream(\n  descriptor: FacetProcessI32Result,\n  operation: ProcessOperation,\n  value: Bytes,\n) -> Result<U32, ProcessError> {\n  let descriptor_error = FacetProcessHost.i32_error(descriptor)\n  if descriptor_error != 0u32 {\n    Result::Err(facet_process_backend_error(operation, descriptor_error))\n  } else {\n    let fd = FacetProcessHost.i32_value(descriptor)\n    l
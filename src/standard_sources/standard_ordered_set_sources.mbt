///|
pub fn standard_ordered_set_source() -> Bytes {
  b"open dew.std.ordering\nopen dew.std.collections.red_black_tree\n\npub struct OrderedSet<k, c> {\n  tree: RedBlackTree<k, Bool, c>\n}\n\npub struct OrderedSetIter<k, c> {\n  inner: RedBlackTreeIter<k, Bool, c>\n}\n\npub fn ordered_set_new<k, c: Comparator<k>>(\n  comparator: c,\n) -> OrderedSet<k, c> {\n  OrderedSet::{\n    tree: red_black_tree_new(comparator)\n  }\n}\n\npub fn ordered_set_length<k, c>(set: OrderedSet<k, c>) -> U32 {\n  red_black_tree_length(set.tree)\n}\n\npub fn ordered_set_is_empty<k, c>(set: OrderedSet<k, c>) -> Bool {\n  red_black_tree_is_empty(set.tree)\n}\n\npub fn ordered_set_insert<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Bool {\n  red_black_tree_insert(set.tree, key, true)\n}\n\npub fn ordered_set_contains<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Bool {\n  red_black_tree_contains(set.tree, key)\n}\n\npub fn ordered_set_remove<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Bool {\n  red_black_tree_remove(set.tree, key)\n}\n\npub fn ordered_set_clear<k, c>(set: OrderedSet<k, c>) -> Unit {\n  red_black_tree_clear(set.tree)\n}\n\npub fn ordered_set_entry_key<k>(entry: Option<TreeEntry<k, Bool>>) -> Option<k> {\n  match entry {\n    Option::Some(value) => Option::Some(tree_entry_key(value))\n    Option::None => Option::None\n  }\n}\n\npub fn ordered_set_minimum<k, c>(set: OrderedSet<k, c>) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_minimum(set.tree))\n}\n\npub fn ordered_set_maximum<k, c>(set: OrderedSet<k, c>) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_maximum(set.tree))\n}\n\npub fn ordered_set_lower_bound<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_lower_bound(set.tree, key))\n}\n\npub fn ordered_set_upper_bound<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_upper_bound(set.tree, key))\n}\n\npub fn ordered_set_predecessor<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_predecessor(set.tree, key))\n}\n\npub fn ordered_set_successor<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  key: k,\n) -> Option<k> {\n  ordered_set_entry_key(red_black_tree_successor(set.tree, key))\n}\n\npub fn ordered_set_iter<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n) -> OrderedSetIter<k, c> {\n  OrderedSetIter::{\n    inner: red_black_tree_iter(set.tree)\n  }\n}\n\npub fn ordered_set_range<k, c: Comparator<k>>(\n  set: OrderedSet<k, c>,\n  lower: Option<k>,\n  lower_inclusive: Bool,\n  upper: Option<k>,\n  upper_inclusive: Bool,\n) -> OrderedSetIter<k, c> {\n  OrderedSetIter::{\n    inner: red_black_tree_range(\n      set.tree,\n      lower,\n      lower_inclusive,\n      upper,\n      upper_inclusive,\n    )\n  }\n}\n\npub fn ordered_set_iter_has_next<k, c: Comparator<k>>(\n  iter: OrderedSetIter<k, c>,\n) -> Bool {\n  red_black_tree_iter_has_next(iter.inner)\n}\n\npub fn ordered_set_iter_next<k, c: Comparator<k>>(\n  iter: OrderedSetIter<k, c>,\n) -> k {\n  tree_entry_key(red_black_tree_iter_next(iter.inner))\n}\n"
}

///|
pub fn standard_show_source() -> Bytes {
  b"open dew.std.string\nopen dew.std.string_builder\n\npub struct ShowFormatter {\n  builder: StringBuilder\n  depth: U32\n}\n\npub trait Show {\n  fn append_show(self, formatter: ShowFormatter) -> Unit\n}\n\nfn show_max_depth() -> U32 {\n  64u32\n}\n\nfn show_max_bytes() -> U32 {\n  1048576u32\n}\n\nfn show_require_bytes(formatter: ShowFormatter, added: U32) -> Unit {\n  let used = formatter.builder.byte_length()\n  if used > show_max_bytes() || added > show_max_bytes() - used {\n    unreachable()\n  } else {\n  }\n}\n\npub fn show<t: Show>(value: t) -> String {\n  let builder = StringBuilder::new()\n  show_append(ShowFormatter {\n    builder: builder\n    depth: 0u32\n  }, value)\n  builder.finish()\n}\n\nfn show_require_depth(formatter: ShowFormatter) -> Unit {\n  if formatter.depth >= show_max_depth() {\n    unreachable()\n  } else {\n  }\n}\n\npub fn show_append<t: Show>(formatter: ShowFormatter, value: t) -> Unit {\n  show_require_depth(formatter)\n  value.append_show(ShowFormatter {\n    builder: formatter.builder\n    depth: formatter.depth + 1u32\n  })\n}\n\npub fn show_append_text(formatter: ShowFormatter, value: String) -> Unit {\n  show_require_bytes(formatter, value.byte_length())\n  formatter.builder.append(value)\n}\n\npub fn show_append_view(formatter: ShowFormatter, value: StringView) -> Unit {\n  show_require_bytes(formatter, value.byte_length())\n  formatter.builder.append_view(value)\n}\n\npub fn show_append_ascii(formatter: ShowFormatter, value: U8) -> Unit {\n  show_require_bytes(formatter, 1u32)\n  formatter.builder.append_ascii(value)\n}\n\nfn show_u64_to_u8(value: U64) -> U8 {\n  value.into()\n}\n\nfn show_i8_to_i64(value: I8) -> I64 {\n  value.into()\n}\n\nfn show_i16_to_i64(value: I16) -> I64 {\n  value.into()\n}\n\nfn show_i32_to_i64(value: I32) -> I64 {\n  value.into()\n}\n\nfn show_u8_to_u64(value: U8) -> U64 {\n  value.into()\n}\n\nfn show_u16_to_u64(value: U16) -> U64 {\n  value.into()\n}\n\nfn show_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn show_i64_to_u64(value: I64) -> U64 {\n  value.into()\n}\n\nfn show_append_u64_digits(formatter: ShowFormatter, value: U64) -> Unit {\n  if value >= 10u64 {\n    show_append_u64_digits(formatter, value / 10u64)\n  } else {\n  }\n  show_append_ascii(formatter, show_u64_to_u8(value % 10u64) + 48u8)\n}\n\nfn show_append_i64(formatter: ShowFormatter, value: I64) -> Unit {\n  if value < 0i64 {\n    show_append_ascii(formatter, 45u8)\n    let magnitude = show_i64_to_u64(-(value + 1i64)) + 1u64\n    show_append_u64_digits(formatter, magnitude)\n  } else {\n    show_append_u64_digits(formatter, show_i64_to_u64(value))\n  }\n}\n\nimpl Show for Bool {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    if self {\n      show_append_text(formatter, \"true\")\n    } else {\n      show_append_text(formatter, \"false\")\n    }\n  }\n}\n\nimpl Show for I8 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i8_to_i64(self))\n  }\n}\n\nimpl Show for I16 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i16_to_i64(self))\n  }\n}\n\nimpl Show for I32 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i32_to_i64(self))\n  }\n}\n\nimpl Show for I64 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, self)\n  }\n}\n\nimpl Show for U8 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64_digits(formatter, show_u8_to_u64(self))\n  }\n}\n\nimpl Show for U16 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64_digits(formatter, show_u16_to_u64(self))\n  }\n}\n\nimpl Show for U32 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64_digits(formatter, show_u32_to_u64(self))\n  }\n}\n\nimpl Show for U64 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64_digits(formatter, self)\n  }\n}\n\nimpl Show for String {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_text(formatter, self)\n  }\n}\n\nimpl Show for StringView {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_view(formatter, self)\n  }\n}\n"
}

///|
pub fn standard_show_source() -> Bytes {
  b"open dew.std.string_builder\n\npub trait Show {\n  fn append_show(self, builder: StringBuilder) -> Unit\n}\n\npub fn show<t: Show>(value: t) -> String {\n  let builder = StringBuilder::new()\n  value.append_show(builder)\n  builder.finish()\n}\n\npub fn show_append<t: Show>(builder: StringBuilder, value: t) -> Unit {\n  value.append_show(builder)\n}\n\npub fn show_append_text(builder: StringBuilder, value: String) -> Unit {\n  builder.append(value)\n}\n\npub fn show_append_ascii(builder: StringBuilder, value: U8) -> Unit {\n  builder.append_ascii(value)\n}\n\nfn show_u64_to_u8(value: U64) -> U8 {\n  value.into()\n}\n\nfn show_i8_to_i64(value: I8) -> I64 {\n  value.into()\n}\n\nfn show_i16_to_i64(value: I16) -> I64 {\n  value.into()\n}\n\nfn show_i32_to_i64(value: I32) -> I64 {\n  value.into()\n}\n\nfn show_u8_to_u64(value: U8) -> U64 {\n  value.into()\n}\n\nfn show_u16_to_u64(value: U16) -> U64 {\n  value.into()\n}\n\nfn show_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn show_i64_to_u64(value: I64) -> U64 {\n  value.into()\n}\n\nfn show_append_u64_digits(builder: StringBuilder, value: U64) -> Unit {\n  if value >= 10u64 {\n    show_append_u64_digits(builder, value / 10u64)\n  } else {\n  }\n  builder.append_ascii(show_u64_to_u8(value % 10u64) + 48u8)\n}\n\nfn show_append_i64(builder: StringBuilder, value: I64) -> Unit {\n  if value < 0i64 {\n    builder.append_ascii(45u8)\n    let magnitude = show_i64_to_u64(-(value + 1i64)) + 1u64\n    show_append_u64_digits(builder, magnitude)\n  } else {\n    show_append_u64_digits(builder, show_i64_to_u64(value))\n  }\n}\n\nimpl Show for Bool {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    if self {\n      builder.append(\"true\")\n    } else {\n      builder.append(\"false\")\n    }\n  }\n}\n\nimpl Show for I8 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_i64(builder, show_i8_to_i64(self))\n  }\n}\n\nimpl Show for I16 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_i64(builder, show_i16_to_i64(self))\n  }\n}\n\nimpl Show for I32 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_i64(builder, show_i32_to_i64(self))\n  }\n}\n\nimpl Show for I64 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_i64(builder, self)\n  }\n}\n\nimpl Show for U8 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_u64_digits(builder, show_u8_to_u64(self))\n  }\n}\n\nimpl Show for U16 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_u64_digits(builder, show_u16_to_u64(self))\n  }\n}\n\nimpl Show for U32 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_u64_digits(builder, show_u32_to_u64(self))\n  }\n}\n\nimpl Show for U64 {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    show_append_u64_digits(builder, self)\n  }\n}\n\nimpl Show for String {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    builder.append(self)\n  }\n}\n\nimpl Show for StringView {\n  fn append_show(self, builder: StringBuilder) -> Unit {\n    builder.append_view(self)\n  }\n}\n"
}

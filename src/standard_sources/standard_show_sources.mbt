///|
pub fn standard_show_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.array\nopen dew.std.string\nopen dew.std.string_builder\n\npub struct ShowFormatter {\n  builder: StringBuilder\n  depth: U32\n}\n\npub trait Show {\n  fn append_show(self, formatter: ShowFormatter) -> Unit\n}\n\npub fn show_unit() -> Unit {\n}\n\npub fn show_max_depth() -> U32 {\n  64u32\n}\n\npub fn show_max_bytes() -> U32 {\n  1048576u32\n}\n\npub fn show_require_bytes(formatter: ShowFormatter, added: U32) -> Unit {\n  let used = formatter.builder.byte_length()\n  if used > show_max_bytes() || added > show_max_bytes() - used {\n    unreachable()\n  } else {\n  }\n}\n\npub fn show<t: Show>(value: t) -> String {\n  let builder = StringBuilder::new()\n  show_append(ShowFormatter::{\n    builder: builder\n    depth: 0u32\n  }, value)\n  builder.finish()\n}\n\npub fn show_require_depth(formatter: ShowFormatter) -> Unit {\n  if formatter.depth >= show_max_depth() {\n    unreachable()\n  } else {\n  }\n}\n\npub fn show_append<t: Show>(formatter: ShowFormatter, value: t) -> Unit {\n  show_require_depth(formatter)\n  value.append_show(ShowFormatter::{\n    builder: formatter.builder\n    depth: formatter.depth + 1u32\n  })\n}\n\npub fn show_append_text(formatter: ShowFormatter, value: String) -> Unit {\n  show_require_bytes(formatter, value.byte_length())\n  formatter.builder.append(value)\n}\n\npub fn show_append_view(formatter: ShowFormatter, value: StringView) -> Unit {\n  show_require_bytes(formatter, value.byte_length())\n  formatter.builder.append_view(value)\n}\n\npub fn show_append_ascii(formatter: ShowFormatter, value: U8) -> Unit {\n  show_require_bytes(formatter, 1u32)\n  formatter.builder.append_ascii(value)\n}\n\npub fn show_i8_to_i64(value: I8) -> I64 {\n  value.into()\n}\n\npub fn show_i16_to_i64(value: I16) -> I64 {\n  value.into()\n}\n\npub fn show_i32_to_i64(value: I32) -> I64 {\n  value.into()\n}\n\npub fn show_u8_to_u64(value: U8) -> U64 {\n  value.into()\n}\n\npub fn show_u16_to_u64(value: U16) -> U64 {\n  value.into()\n}\n\npub fn show_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn show_i64_to_u64(value: I64) -> U64 {\n  value.into()\n}\n\npub fn show_u64_digit_count(value: U64) -> U32 {\n  if value < 10u64 {\n    1u32\n  } else {\n    1u32 + show_u64_digit_count(value / 10u64)\n  }\n}\n\npub fn show_i64_byte_count(value: I64) -> U32 {\n  if value < 0i64 {\n    1u32 + show_u64_digit_count(show_i64_to_u64(-(value + 1i64)) + 1u64)\n  } else {\n    show_u64_digit_count(show_i64_to_u64(value))\n  }\n}\n\npub fn show_append_i64(formatter: ShowFormatter, value: I64) -> Unit {\n  show_require_bytes(formatter, show_i64_byte_count(value))\n  formatter.builder.append_i64(value)\n}\n\npub fn show_append_u64(formatter: ShowFormatter, value: U64) -> Unit {\n  show_require_bytes(formatter, show_u64_digit_count(value))\n  formatter.builder.append_u64(value)\n}\n\nimpl Show for Unit {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_text(formatter, \"()\")\n  }\n}\n\nimpl Show for Bool {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    if self {\n      show_append_text(formatter, \"true\")\n    } else {\n      show_append_text(formatter, \"false\")\n    }\n  }\n}\n\nimpl Show for I8 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i8_to_i64(self))\n  }\n}\n\nimpl Show for I16 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i16_to_i64(self))\n  }\n}\n\nimpl Show for I32 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, show_i32_to_i64(self))\n  }\n}\n\nimpl Show for I64 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_i64(formatter, self)\n  }\n}\n\nimpl Show for U8 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64(formatter, show_u8_to_u64(self))\n  }\n}\n\nimpl Show for U16 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64(formatter, show_u16_to_u64(self))\n  }\n}\n\nimpl Show for U32 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64(formatter, show_u32_to_u64(self))\n  }\n}\n\nimpl Show for U64 {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_u64(formatter, self)\n  }\n}\n\nimpl Show for String {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_text(formatter, self)\n  }\n}\n\nimpl Show for StringView {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_view(formatter, self)\n  }\n}\n\nimpl<t: Show> Show for FixedArray<t> {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_ascii(formatter, 91u8)\n    let length = self.length()\n    while 0u32 {\n      index if index < length => {\n        if index > 0u32 {\n          show_append_text(formatter, \", \")\n        } else {\n        }\n        show_append(formatter, self.get_unchecked(index))\n        continue index + 1u32\n      }\n      _ => break show_unit()\n    }\n    show_append_ascii(formatter, 93u8)\n  }\n}\n\nimpl<t: Show> Show for Array<t> {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    show_append_ascii(formatter, 91u8)\n    let length = self.length()\n    while 0u32 {\n      index if index < length => {\n        if index > 0u32 {\n          show_append_text(formatter, \", \")\n        } else {\n        }\n        show_append(formatter, self.get_unchecked(index))\n        continue index + 1u32\n      }\n      _ => break show_unit()\n    }\n    show_append_ascii(formatter, 93u8)\n  }\n}\n\nimpl<t: Show> Show for Option<t> {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    match self {\n      None => show_append_text(formatter, \"None\")\n      Some(value) => {\n        show_append_text(formatter, \"Some(\")\n        show_append(formatter, value)\n        show_append_ascii(formatter, 41u8)\n      }\n    }\n  }\n}\n\nimpl<t: Show, e: Show> Show for Result<t, e> {\n  fn append_show(self, formatter: ShowFormatter) -> Unit {\n    match self {\n      Ok(value) => {\n        show_append_text(formatter, \"Ok(\")\n        show_append(formatter, value)\n        show_append_ascii(formatter, 41u8)\n      }\n      Err(error) => {\n        show_append_text(formatter, \"Err(\")\n        show_append(formatter, error)\n        show_append_ascii(formatter, 41u8)\n      }\n    }\n  }\n}\n\npub enum CompilerDiagnosticLevel {\n  Error\n  Warning\n  Info\n  Hint\n}\n\npub struct CompilerDiagnostic {\n  path: String\n  line: U32\n  column: U32\n  byte_offset: U32\n  level: CompilerDiagnosticLevel\n  code: String\n  message: String\n}\n\npub enum CompilerDiagnosticRenderError {\n  LimitExceeded(U64, U32)\n}\n\npub fn compiler_diagnostic_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn compiler_diagnostic_level_text(level: CompilerDiagnosticLevel) -> String {\n  match level {\n    Error => \"error\"\n    Warning => \"warning\"\n    Info => \"info\"\n    Hint => \"hint\"\n  }\n}\n\npub fn compiler_diagnostic_render_size(\n  diagnostic: CompilerDiagnostic,\n  level: String,\n) -> U64 {\n  compiler_diagnostic_u32_to_u64(diagnostic.path.byte_length()) +\n  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.line))) +\n  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.column))) +\n  compiler_diagnostic_u32_to_u64(level.byte_length()) +\n  compiler_diagnostic_u32_to_u64(diagnostic.code.byte_length()) +\n  compiler_diagnostic_u32_to_u64(diagnostic.message.byte_length()) +\n  compiler_diagnostic_u32_to_u64(show_u64_digit_count(compiler_diagnostic_u32_to_u64(diagnostic.byte_offset))) +\n  16u64\n}\n\npub fn render_compiler_diagnostic(\n  diagnostic: CompilerDiagnostic,\n  max_bytes: U32,\n) -> Result<String, CompilerDiagnosticRenderError> {\n  let level = compiler_diagnostic_level_text(diagnostic.level)\n  let required = compiler_diagnostic_render_size(diagnostic, level)\n  if required > compiler_diagnostic_u32_to_u64(max_bytes) {\n    Result::Err(CompilerDiagnosticRenderError::LimitExceeded(required, max_bytes))\n  } else {\n    let builder = StringBuilder::with_capacity(required.into())\n    builder.append(diagnostic.path)\n    builder.append_ascii(58u8)\n    builder.append_u32(diagnostic.line)\n    builder.append_ascii(58u8)\n    builder.append_u32(diagnostic.column)\n    builder.append(\": \")\n    builder.append(level)\n    builder.append_ascii(91u8)\n    builder.append(diagnostic.code)\n    builder.append(\"]: \")\n    builder.append(diagnostic.message)\n    builder.append(\" (byte \")\n    builder.append_u32(diagnostic.byte_offset)\n    builder.append_ascii(41u8)\n    Result::Ok(builder.finish())\n  }\n}\n"
}

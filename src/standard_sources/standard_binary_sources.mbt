///|
pub fn standard_binary_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.bytes_builder\n\npub enum BinaryError {\n  ShortInput(U32, U32, U32)\n} derive(Eq)\n\npub struct BinaryCursor {\n  private input: Bytes\n  private mut position: U32\n}\n\npub fn binary_cursor(input: Bytes) -> BinaryCursor {\n  BinaryCursor::{\n    input: input\n    position: 0u32\n  }\n}\npub fn binary_position(cursor: BinaryCursor) -> U32 {\n  cursor.position\n}\npub fn binary_remaining(cursor: BinaryCursor) -> U32 {\n  cursor.input.byte_length() - cursor.position\n}\npub fn binary_remaining_bytes(cursor: BinaryCursor) -> Bytes {\n  cursor.input.view(cursor.position, binary_remaining(cursor))\n}\npub fn read_bytes(cursor: BinaryCursor, length: U32) -> Result<Bytes, BinaryError> {\n  let available = binary_remaining(cursor)\n  if length > available {\n    Result::Err(BinaryError::ShortInput(cursor.position, length, available))\n  } else {\n    let value = cursor.input.view(cursor.position, length)\n    cursor.position = cursor.position + length\n    Result::Ok(value)\n  }\n}\n\npub fn read_u16_le(cursor: BinaryCursor) -> Result<U16, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 2u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 2u32, available))\n  } else {\n    let b0 = binary_u8_to_u16(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u16(cursor.input.byte_at(cursor.position + 1u32))\n    let value = (b0 << 0u16) | (b1 << 8u16)\n    cursor.position = cursor.position + 2u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u16_le(builder: BytesBuilder, value: U16) -> Unit {\n  let b0 = binary_u16_to_u8(((value >> 0u16) & 255u16))\n  builder.append_byte(b0)\n  let b1 = binary_u16_to_u8(((value >> 8u16) & 255u16))\n  builder.append_byte(b1)\n}\n\npub fn read_u16_be(cursor: BinaryCursor) -> Result<U16, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 2u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 2u32, available))\n  } else {\n    let b0 = binary_u8_to_u16(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u16(cursor.input.byte_at(cursor.position + 1u32))\n    let value = (b0 << 8u16) | (b1 << 0u16)\n    cursor.position = cursor.position + 2u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u16_be(builder: BytesBuilder, value: U16) -> Unit {\n  let b0 = binary_u16_to_u8(((value >> 8u16) & 255u16))\n  builder.append_byte(b0)\n  let b1 = binary_u16_to_u8(((value >> 0u16) & 255u16))\n  builder.append_byte(b1)\n}\n\npub fn read_u32_le(cursor: BinaryCursor) -> Result<U32, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 4u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 4u32, available))\n  } else {\n    let b0 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 1u32))\n    let b2 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 2u32))\n    let b3 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 3u32))\n    let value = (b0 << 0u32) | (b1 << 8u32) | (b2 << 16u32) | (b3 << 24u32)\n    cursor.position = cursor.position + 4u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u32_le(builder: BytesBuilder, value: U32) -> Unit {\n  let b0 = binary_u32_to_u8(((value >> 0u32) & 255u32))\n  builder.append_byte(b0)\n  let b1 = binary_u32_to_u8(((value >> 8u32) & 255u32))\n  builder.append_byte(b1)\n  let b2 = binary_u32_to_u8(((value >> 16u32) & 255u32))\n  builder.append_byte(b2)\n  let b3 = binary_u32_to_u8(((value >> 24u32) & 255u32))\n  builder.append_byte(b3)\n}\n\npub fn read_u32_be(cursor: BinaryCursor) -> Result<U32, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 4u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 4u32, available))\n  } else {\n    let b0 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 1u32))\n    let b2 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 2u32))\n    let b3 = binary_u8_to_u32(cursor.input.byte_at(cursor.position + 3u32))\n    let value = (b0 << 24u32) | (b1 << 16u32) | (b2 << 8u32) | (b3 << 0u32)\n    cursor.position = cursor.position + 4u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u32_be(builder: BytesBuilder, value: U32) -> Unit {\n  let b0 = binary_u32_to_u8(((value >> 24u32) & 255u32))\n  builder.append_byte(b0)\n  let b1 = binary_u32_to_u8(((value >> 16u32) & 255u32))\n  builder.append_byte(b1)\n  let b2 = binary_u32_to_u8(((value >> 8u32) & 255u32))\n  builder.append_byte(b2)\n  let b3 = binary_u32_to_u8(((value >> 0u32) & 255u32))\n  builder.append_byte(b3)\n}\n\npub fn read_u64_le(cursor: BinaryCursor) -> Result<U64, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 8u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 8u32, available))\n  } else {\n    let b0 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 1u32))\n    let b2 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 2u32))\n    let b3 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 3u32))\n    let b4 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 4u32))\n    let b5 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 5u32))\n    let b6 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 6u32))\n    let b7 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 7u32))\n    let value = (b0 << 0u64) | (b1 << 8u64) | (b2 << 16u64) | (b3 << 24u64) | (b4 << 32u64) | (b5 << 40u64) | (b6 << 48u64) | (b7 << 56u64)\n    cursor.position = cursor.position + 8u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u64_le(builder: BytesBuilder, value: U64) -> Unit {\n  let b0 = binary_u64_to_u8(((value >> 0u64) & 255u64))\n  builder.append_byte(b0)\n  let b1 = binary_u64_to_u8(((value >> 8u64) & 255u64))\n  builder.append_byte(b1)\n  let b2 = binary_u64_to_u8(((value >> 16u64) & 255u64))\n  builder.append_byte(b2)\n  let b3 = binary_u64_to_u8(((value >> 24u64) & 255u64))\n  builder.append_byte(b3)\n  let b4 = binary_u64_to_u8(((value >> 32u64) & 255u64))\n  builder.append_byte(b4)\n  let b5 = binary_u64_to_u8(((value >> 40u64) & 255u64))\n  builder.append_byte(b5)\n  let b6 = binary_u64_to_u8(((value >> 48u64) & 255u64))\n  builder.append_byte(b6)\n  let b7 = binary_u64_to_u8(((value >> 56u64) & 255u64))\n  builder.append_byte(b7)\n}\n\npub fn read_u64_be(cursor: BinaryCursor) -> Result<U64, BinaryError> {\n  let available = binary_remaining(cursor)\n  if available < 8u32 {\n    Result::Err(BinaryError::ShortInput(cursor.position, 8u32, available))\n  } else {\n    let b0 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 0u32))\n    let b1 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 1u32))\n    let b2 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 2u32))\n    let b3 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 3u32))\n    let b4 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 4u32))\n    let b5 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 5u32))\n    let b6 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 6u32))\n    let b7 = binary_u8_to_u64(cursor.input.byte_at(cursor.position + 7u32))\n    let value = (b0 << 56u64) | (b1 << 48u64) | (b2 << 40u64) | (b3 << 32u64) | (b4 << 24u64) | (b5 << 16u64) | (b6 << 8u64) | (b7 << 0u64)\n    cursor.position = cursor.position + 8u32\n    Result::Ok(value)\n  }\n}\n\npub fn write_u64_be(builder: BytesBuilder, value: U64) -> Unit {\n  let b0 = binary_u64_to_u8(((value >> 56u64) & 255u64))\n  builder.append_byte(b0)\n  let b1 = binary_u64_to_u8(((value >> 48u64) & 255u64))\n  builder.append_byte(b1)\n  let b2 = binary_u64_to_u8(((value >> 40u64) & 255u64))\n  builder.append_byte(b2)\n  let b3 = binary_u64_to_u8(((value >> 32u64) & 255u64))\n  builder.append_byte(b3)\n  let b4 = binary_u64_to_u8(((value >> 24u64) & 255u64))\n  builder.append_byte(b4)\n  let b5 = binary_u64_to_u8(((value >> 16u64) & 255u64))\n  builder.append_byte(b5)\n  let b6 = binary_u64_to_u8(((value >> 8u64) & 255u64))\n  builder.append_byte(b6)\n  let b7 = binary_u64_to_u8(((value >> 0u64) & 255u64))\n  builder.append_byte(b7)\n}\n\nfn binary_u8_to_u16(value: U8) -> U16 {\n  value.into()\n}\nfn binary_u16_to_u8(value: U16) -> U8 {\n  value.into()\n}\n\nfn binary_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\nfn binary_u32_to_u8(value: U32) -> U8 {\n  value.into()\n}\n\nfn binary_u8_to_u64(value: U8) -> U64 {\n  value.into()\n}\nfn binary_u64_to_u8(value: U64) -> U8 {\n  value.into()\n}\n"
}

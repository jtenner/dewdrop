///|
pub fn standard_deque_source() -> Bytes {
  b"open dew.std.collections.circular_buffer\n\npub type Deque<t> = CircularBuffer<t>\npub type DequeIter<t> = CircularBufferIter<t>\n\npub builtin deque_new<t>() -> Deque<t> = \"dew_deque_new\"\npub builtin deque_with_capacity<t>(capacity: U32) -> Deque<t> = \"dew_deque_with_capacity\"\npub builtin deque_length<t>(deque: Deque<t>) -> U32 = \"dew_deque_length\"\npub builtin deque_capacity<t>(deque: Deque<t>) -> U32 = \"dew_deque_capacity\"\npub builtin deque_is_empty<t>(deque: Deque<t>) -> Bool = \"dew_deque_is_empty\"\npub builtin deque_push_front<t>(deque: Deque<t>, value: t) -> Unit = \"dew_deque_push_front\"\npub builtin deque_push_back<t>(deque: Deque<t>, value: t) -> Unit = \"dew_deque_push_back\"\npub builtin deque_pop_front<t>(deque: Deque<t>) -> Option<t> = \"dew_deque_pop_front\"\npub builtin deque_pop_back<t>(deque: Deque<t>) -> Option<t> = \"dew_deque_pop_back\"\npub builtin deque_peek_front<t>(deque: Deque<t>) -> Option<t> = \"dew_deque_peek_front\"\npub builtin deque_peek_back<t>(deque: Deque<t>) -> Option<t> = \"dew_deque_peek_back\"\npub builtin deque_clear<t>(deque: Deque<t>) -> Unit = \"dew_deque_clear\"\npub builtin deque_iter<t>(deque: Deque<t>) -> DequeIter<t> = \"dew_deque_iter\"\npub builtin deque_iter_has_next<t>(iter: DequeIter<t>) -> Bool = \"dew_deque_iter_has_next\"\npub builtin deque_iter_next<t>(iter: DequeIter<t>) -> t = \"dew_deque_iter_next\"\n"
}

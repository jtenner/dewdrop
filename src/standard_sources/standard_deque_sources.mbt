///|
pub fn standard_deque_source() -> Bytes {
  b"open dew.std.collections.circular_buffer\n\npub type Deque<t> = CircularBuffer<t>\npub type DequeIter<t> = CircularBufferIter<t>\n\npub fn deque_new<t>() -> Deque<t> {\n  circular_buffer_growable(0u32)\n}\npub fn deque_with_capacity<t>(capacity: U32) -> Deque<t> {\n  circular_buffer_growable(capacity)\n}\npub fn deque_length<t>(deque: Deque<t>) -> U32 {\n  circular_buffer_length(deque)\n}\npub fn deque_capacity<t>(deque: Deque<t>) -> U32 {\n  circular_buffer_capacity(deque)\n}\npub fn deque_is_empty<t>(deque: Deque<t>) -> Bool {\n  circular_buffer_is_empty(deque)\n}\npub fn deque_push_front<t>(deque: Deque<t>, value: t) -> Unit {\n  if !circular_buffer_push_front(deque, value) {\n    unreachable()\n  }\n}\npub fn deque_push_back<t>(deque: Deque<t>, value: t) -> Unit {\n  if !circular_buffer_push_back(deque, value) {\n    unreachable()\n  }\n}\npub fn deque_pop_front<t>(deque: Deque<t>) -> Option<t> {\n  circular_buffer_pop_front(deque)\n}\npub fn deque_pop_back<t>(deque: Deque<t>) -> Option<t> {\n  circular_buffer_pop_back(deque)\n}\npub fn deque_peek_front<t>(deque: Deque<t>) -> Option<t> {\n  circular_buffer_peek_front(deque)\n}\npub fn deque_peek_back<t>(deque: Deque<t>) -> Option<t> {\n  circular_buffer_peek_back(deque)\n}\npub fn deque_clear<t>(deque: Deque<t>) -> Unit {\n  circular_buffer_clear(deque)\n}\npub fn deque_iter<t>(deque: Deque<t>) -> DequeIter<t> {\n  circular_buffer_iter(deque)\n}\npub fn deque_iter_has_next<t>(iter: DequeIter<t>) -> Bool {\n  circular_buffer_iter_has_next(iter)\n}\npub fn deque_iter_next<t>(iter: DequeIter<t>) -> t {\n  circular_buffer_iter_next(iter)\n}\n"
}

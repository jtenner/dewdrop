///|
pub fn standard_io_process_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.io\nopen dew.std.process\n\npub enum ProcessOutputChannel {\n  StandardOutput\n  StandardError\n}\n\n// Capture ordinary Process evidence at construction, as in std/iter.dew.\npub struct ProcessWriter<p> {\n  private process: p\n  private output_channel: ProcessOutputChannel\n  private output: fn(p, Bytes) -> Result<U32, ProcessError>\n}\n\nfn process_stdout_write<p: Process>(process: p, value: Bytes) -> Result<U32, ProcessError> {\n  process.write_stdout(value)\n}\n\nfn process_stderr_write<p: Process>(process: p, value: Bytes) -> Result<U32, ProcessError> {\n  process.write_stderr(value)\n}\n\npub fn process_stdout<p: Process>(process: p) -> ProcessWriter<p> {\n  ProcessWriter::{\n    process: process\n    output_channel: ProcessOutputChannel::StandardOutput\n    output: process_stdout_write\n  }\n}\n\npub fn process_stderr<p: Process>(process: p) -> ProcessWriter<p> {\n  ProcessWriter::{\n    process: process\n    output_channel: ProcessOutputChannel::StandardError\n    output: process_stderr_write\n  }\n}\n\nimpl<p> ProcessWriter<p> {\n  fn channel(self) -> ProcessOutputChannel {\n    self.output_channel\n  }\n}\n\n// Retain backend codes; collapse non-limit kinds to Backend. The operation\n// field is discarded. The writer itself retains the selected output channel.\nimpl<p> Writer for ProcessWriter<p> {\n  fn write(self, value: Bytes) -> Result<U32, IoError> {\n    let output = self.output\n    match output(self.process, value) {\n      Result::Ok(count) => Result::Ok(count)\n      Result::Err(error) => {\n        match error.kind {\n          ProcessErrorKind::LimitExceeded => Result::Err(IoError::LimitExceeded)\n          _ => Result::Err(IoError::Backend(error.code))\n        }\n      }\n    }\n  }\n}\n"
}

///|
pub fn standard_sha256_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.bytes\n\npub fn sha256_unit() -> Unit {\n}\n\npub fn sha256_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn sha256_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn sha256_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\npub fn sha256_u64_to_u8(value: U64) -> U8 {\n  value.into()\n}\n\npub fn sha256_rotate_right(value: U32, count: U32) -> U32 {\n  (value >> count) | (value << (32u32 - count))\n}\n\npub fn sha256_round_constant(index: U32) -> U32 {\n  match index {\n    0u32 => 1116352408u32\n    1u32 => 1899447441u32\n    2u32 => 3049323471u32\n    3u32 => 3921009573u32\n    4u32 => 961987163u32\n    5u32 => 1508970993u32\n    6u32 => 2453635748u32\n    7u32 => 2870763221u32\n    8u32 => 3624381080u32\n    9u32 => 310598401u32\n    10u32 => 607225278u32\n    11u32 => 1426881987u32\n    12u32 => 1925078388u32\n    13u32 => 2162078206u32\n    14u32 => 2614888103u32\n    15u32 => 3248222580u32\n    16u32 => 3835390401u32\n    17u32 => 4022224774u32\n    18u32 => 264347078u32\n    19u32 => 604807628u32\n    20u32 => 770255983u32\n    21u32 => 1249150122u32\n    22u32 => 1555081692u32\n    23u32 => 1996064986u32\n    24u32 => 2554220882u32\n    25u32 => 2821834349u32\n    26u32 => 2952996808u32\n    27u32 => 3210313671u32\n    28u32 => 3336571891u32\n    29u32 => 3584528711u32\n    30u32 => 113926993u32\n    31u32 => 338241895u32\n    32u32 => 666307205u32\n    33u32 => 773529912u32\n    34u32 => 1294757372u32\n    35u32 => 1396182291u32\n    36u32 => 1695183700u32\n    37u32 => 1986661051u32\n    38u32 => 2177026350u32\n    39u32 => 2456956037u32\n    40u32 => 2730485921u32\n    41u32 => 2820302411u32\n    42u32 => 3259730800u32\n    43u32 => 3345764771u32\n    44u32 => 3516065817u32\n    45u32 => 3600352804u32\n    46u32 => 4094571909u32\n    47u32 => 275423344u32\n    48u32 => 430227734u32\n    49u32 => 506948616u32\n    50u32 => 659060556u32\n    51u32 => 883997877u32\n    52u32 => 958139571u32\n    53u32 => 1322822218u32\n    54u32 => 1537002063u32\n    55u32 => 1747873779u32\n    56u32 => 1955562222u32\n    57u32 => 2024104815u32\n    58u32 => 2227730452u32\n    59u32 => 2361852424u32\n    60u32 => 2428436474u32\n    61u32 => 2756734187u32\n    62u32 => 3204031479u32\n    63u32 => 3329325298u32\n    _ => unreachable()\n  }\n}\n\npub fn sha256_initial_state() -> FixedArray<U32> {\n  let state = FixedArray::make(8u32, 0u32)\n  state.set_unchecked(0u32, 1779033703u32)\n  state.set_unchecked(1u32, 3144134277u32)\n  state.set_unchecked(2u32, 1013904242u32)\n  state.set_unchecked(3u32, 2773480762u32)\n  state.set_unchecked(4u32, 1359893119u32)\n  state.set_unchecked(5u32, 2600822924u32)\n  state.set_unchecked(6u32, 528734635u32)\n  state.set_unchecked(7u32, 1541459225u32)\n  state\n}\n\npub fn sha256_padded_byte(\n  input: Bytes,\n  input_length: U64,\n  index: U64,\n  padded_length: U64,\n  bit_length: U64,\n) -> U8 {\n  if index < input_length {\n    let input_index = sha256_u64_to_u32(index)\n    input.byte_at(input_index)\n  } else if index == input_length {\n    128u8\n  } else if index >= padded_length - 8u64 {\n    let length_index = index - (padded_length - 8u64)\n    let shift = (7u64 - length_index) * 8u64\n    sha256_u64_to_u8((bit_length >> shift) & 255u64)\n  } else {\n    0u8\n  }\n}\n\npub fn sha256_prepare_schedule(\n  schedule: FixedArray<U32>,\n  input: Bytes,\n  input_length: U64,\n  block_index: U32,\n  padded_length: U64,\n  bit_length: U64,\n) -> Unit {\n  let block_start = sha256_u32_to_u64(block_index)\n  let start = block_start * 64u64\n  while 0u32 {\n    word_index if word_index < 16u32 => {\n      let byte_index = word_index * 4u32\n      let byte_offset = sha256_u32_to_u64(byte_index)\n      let first = sha256_u8_to_u32(\n        sha256_padded_byte(\n          input,\n          input_length,\n          start + byte_offset,\n          padded_length,\n          bit_length,\n        ),\n      )\n      let second = sha256_u8_to_u32(\n        sha256_padded_byte(\n          input,\n          input_length,\n          start + byte_offset + 1u64,\n          padded_length,\n          bit_length,\n        ),\n      )\n      let third = sha256_u8_to_u32(\n        sha256_padded_byte(\n          input,\n          input_length,\n          start + byte_offset + 2u64,\n          padded_length,\n          bit_length,\n        ),\n      )\n      let fourth = sha256_u8_to_u32(\n        sha256_padded_byte(\n          input,\n          input_length,\n          start + byte_offset + 3u64,\n          padded_length,\n          bit_length,\n        ),\n      )\n      schedule.set_unchecked(\n        word_index,\n        (first << 24u32) | (second << 16u32) | (third << 8u32) | fourth,\n      )\n      continue word_index + 1u32\n    }\n    _ => break sha256_unit()\n  }\n  while 16u32 {\n    word_index if word_index < 64u32 => {\n      let before_15 = schedule.get_unchecked(word_index - 15u32)\n      let before_2 = schedule.get_unchecked(word_index - 2u32)\n      let sigma_0 = sha256_rotate_right(before_15, 7u32) ^\n        sha256_rotate_right(before_15, 18u32) ^ (before_15 >> 3u32)\n      let sigma_1 = sha256_rotate_right(before_2, 17u32) ^\n        sha256_rotate_right(before_2, 19u32) ^ (before_2 >> 10u32)\n      schedule.set_unchecked(\n        word_index,\n        schedule.get_unchecked(word_index - 16u32) + sigma_0 +\n        schedule.get_unchecked(word_index - 7u32) + sigma_1,\n      )\n      continue word_index + 1u32\n    }\n    _ => break sha256_unit()\n  }\n}\n\npub fn sha256_compress(state: FixedArray<U32>, schedule: FixedArray<U32>) -> Unit {\n  let mut a = state.get_unchecked(0u32)\n  let mut b = state.get_unchecked(1u32)\n  let mut c = state.get_unchecked(2u32)\n  let mut d = state.get_unchecked(3u32)\n  let mut e = state.get_unchecked(4u32)\n  let mut f = state.get_unchecked(5u32)\n  let mut g = state.get_unchecked(6u32)\n  let mut h = state.get_unchecked(7u32)\n  while 0u32 {\n    round if round < 64u32 => {\n      let sum_1 = sha256_rotate_right(e, 6u32) ^\n        sha256_rotate_right(e, 11u32) ^ sha256_rotate_right(e, 25u32)\n      let choose = (e & f) ^ ((e ^ 4294967295u32) & g)\n      let temporary_1 = h + sum_1 + choose + sha256_round_constant(round) +\n        schedule.get_unchecked(round)\n      let sum_0 = sha256_rotate_right(a, 2u32) ^\n        sha256_rotate_right(a, 13u32) ^ sha256_rotate_right(a, 22u32)\n      let majority = (a & b) ^ (a & c) ^ (b & c)\n      let temporary_2 = sum_0 + majority\n      h = g\n      g = f\n      f = e\n      e = d + temporary_1\n      d = c\n      c = b\n      b = a\n      a = temporary_1 + temporary_2\n      continue round + 1u32\n    }\n    _ => break sha256_unit()\n  }\n  state.set_unchecked(0u32, state.get_unchecked(0u32) + a)\n  state.set_unchecked(1u32, state.get_unchecked(1u32) + b)\n  state.set_unchecked(2u32, state.get_unchecked(2u32) + c)\n  state.set_unchecked(3u32, state.get_unchecked(3u32) + d)\n  state.set_unchecked(4u32, state.get_unchecked(4u32) + e)\n  state.set_unchecked(5u32, state.get_unchecked(5u32) + f)\n  state.set_unchecked(6u32, state.get_unchecked(6u32) + g)\n  state.set_unchecked(7u32, state.get_unchecked(7u32) + h)\n}\n\npub fn sha256_u32_to_u8(value: U32) -> U8 {\n  value.into()\n}\n\npub fn sha256(input: Bytes) -> FixedArray<U8> {\n  let input_length_u32 = input.byte_length()\n  let input_length = sha256_u32_to_u64(input_length_u32)\n  let bit_length = input_length * 8u64\n  let remainder = input_length_u32 % 64u32\n  let block_count = (input_length_u32 / 64u32) + if remainder <= 55u32 {\n    1u32\n  } else {\n    2u32\n  }\n  let block_count_u64 = sha256_u32_to_u64(block_count)\n  let padded_length = block_count_u64 * 64u64\n  let state = sha256_initial_state()\n  let schedule = FixedArray::make(64u32, 0u32)\n  while 0u32 {\n    block_index if block_index < block_count => {\n      sha256_prepare_schedule(\n        schedule,\n        input,\n        input_length,\n        block_index,\n        padded_length,\n        bit_length,\n      )\n      sha256_compress(state, schedule)\n      continue block_index + 1u32\n    }\n    _ => break sha256_unit()\n  }\n  let digest = FixedArray::make(32u32, 0u8)\n  while 0u32 {\n    word_index if word_index < 8u32 => {\n      let word = state.get_unchecked(word_index)\n      let offset = word_index * 4u32\n      digest.set_unchecked(offset, sha256_u32_to_u8((word >> 24u32) & 255u32))\n      digest.set_unchecked(offset + 1u32, sha256_u32_to_u8((word >> 16u32) & 255u32))\n      digest.set_unchecked(offset + 2u32, sha256_u32_to_u8((word >> 8u32) & 255u32))\n      digest.set_unchecked(offset + 3u32, sha256_u32_to_u8(word & 255u32))\n      continue word_index + 1u32\n    }\n    _ => break digest\n  }\n}\n"
}

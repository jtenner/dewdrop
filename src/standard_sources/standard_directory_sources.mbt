///|
pub fn standard_directory_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bytes\nopen dew.std.string\nopen dew.std.path\nopen dew.std.set\n\npub enum DirectoryError {\n  InvalidLimit\n  PartialRecord\n  MalformedRecord\n  InvalidName\n  InvalidUtf8\n  RepeatedCookie\n  PermissionDenied\n  Symlink\n  Host(U32)\n  Close(U32)\n} derive(Eq)\n\npub enum DirectoryEntryKind {\n  Unknown\n  BlockDevice\n  CharacterDevice\n  Directory\n  File\n  SocketDatagram\n  SocketStream\n  Symlink\n} derive(Eq)\n\npub struct DirectoryEntry {\n  name: String\n  kind: DirectoryEntryKind\n}\n\npub struct DirectoryPage {\n  entries: Array<DirectoryEntry>\n  cookie: U64\n  end: Bool\n}\n\npub trait DirectoryReader {\n  fn read_directory(self, path: RelativePath, cookie: U64, max_entries: U32, max_bytes: U32) -> Result<DirectoryPage, DirectoryError>\n}\n\n// A host owns handles. Reads return at most the requested encoded bytes.\npub trait DirectoryHost {\n  fn open_directory(self, path: RelativePath) -> Result<U32, DirectoryError>\n  fn read_directory_bytes(self, handle: U32, cookie: U64, max_bytes: U32) -> Result<Bytes, DirectoryError>\n  fn close_directory(self, handle: U32) -> Result<Unit, DirectoryError>\n}\n\npub fn directory_limits_valid(max_entries: U32, max_bytes: U32) -> Bool {\n  max_entries > 0u32 && max_entries <= 2048u32 && max_bytes >= 24u32 && max_bytes <= 49152u32\n}\n\npub fn directory_path_valid(path: RelativePath) -> Bool {\n  match relative_path(path.to_string()) {\n    Result::Ok(_) => true\n    Result::Err(_) => false\n  }\n}\n\npub fn directory_u64(value: U8) -> U64 {\n  value.into()\n}\n\npub fn directory_shift(value: U32) -> U64 {\n  value.into()\n}\n\npub fn directory_u32(value: U64) -> U32 {\n  value.into()\n}\n\npub fn directory_le(value: Bytes, offset: U32, width: U32) -> U64 {\n  let mut result = 0u64\n  while 0u32 {\n    index if index < width => {\n      result = result | (directory_u64(value.byte_at(offset + index)) << directory_shift(index * 8u32))\n      continue index + 1u32\n    }\n    _ => break result\n  }\n}\n\npub fn directory_page(entries: Array<DirectoryEntry>, cookie: U64, end: Bool) -> Result<DirectoryPage, DirectoryError> {\n  Result::Ok(DirectoryPage::{\n    entries: entries\n    cookie: cookie\n    end: end\n  })\n}\n\n// WASI preview1 dirent: next:u64, inode:u64, name_length:u32, type:u8,\n// three padding bytes, then name bytes. Padding and inode are opaque.\npub fn directory_decode_page(value: Bytes, cookie: U64, max_entries: U32, max_bytes: U32) -> Result<DirectoryPage, DirectoryError> {\n  if !directory_limits_valid(max_entries, max_bytes) {\n    Result::Err(DirectoryError::InvalidLimit)\n  } else if value.byte_length() > max_bytes {\n    Result::Err(DirectoryError::MalformedRecord)\n  } else {\n    let entries = Array::new()\n    let seen = Set::singleton(cookie)\n    let mut next = cookie\n    let mut records = 0u32\n    let length = value.byte_length()\n    while 0u32 {\n      offset if offset < length => {\n        if records == max_entries {\n          break directory_page(entries, next, false)\n        } else if length - offset < 24u32 {\n          if records == 0u32 {\n            break Result::Err(DirectoryError::PartialRecord)\n          } else {\n            break directory_page(entries, next, false)\n          }\n        } else {\n          let name_length = directory_u32(directory_le(value, offset + 16u32, 4u32))\n          if name_length > length - offset - 24u32 {\n            if records == 0u32 {\n              break Result::Err(DirectoryError::PartialRecord)\n            } else {\n              break directory_page(entries, next, false)\n            }\n          } else {\n            let following = directory_le(value, offset, 8u32)\n            if !seen.insert(following) {\n              break Result::Err(DirectoryError::RepeatedCookie)\n            } else {\n              let name = value.view(offset + 24u32, name_length)\n              if !name.is_valid_utf8() {\n                break Result::Err(DirectoryError::InvalidUtf8)\n              } else if name_length == 0u32 {\n                break Result::Err(DirectoryError::InvalidName)\n              } else {\n                let valid = while 0u32 {\n                  index if index < name_length => {\n                    let byte = name.byte_at(index)\n                    if byte == 0u8 || byte == 47u8 || byte == 92u8 {\n                      break false\n                    } else {\n                      continue index + 1u32\n                    }\n                  }\n                  _ => break true\n                }\n                let kind = match value.byte_at(offset + 20u32) {\n                  0u8 => Option::Some(DirectoryEntryKind::Unknown)\n                  1u8 => Option::Some(DirectoryEntryKind::BlockDevice)\n                  2u8 => Option::Some(DirectoryEntryKind::CharacterDevice)\n                  3u8 => Option::Some(DirectoryEntryKind::Directory)\n                  4u8 => Option::Some(DirectoryEntryKind::File)\n                  5u8 => Option::Some(DirectoryEntryKind::SocketDatagram)\n                  6u8 => Option::Some(DirectoryEntryKind::SocketStream)\n                  7u8 => Option::Some(DirectoryEntryKind::Symlink)\n                  _ => Option::None\n                }\n                if !valid {\n                  break Result::Err(DirectoryError::InvalidName)\n                } else {\n                  match kind {\n                    Option::None => break Result::Err(DirectoryError::MalformedRecord)\n                    Option::Some(entry_kind) => {\n                      if name != b\".\" && name != b\"..\" {\n                        entries.push(DirectoryEntry::{\n                          name: name.to_string()\n                          kind: entry_kind\n                        })\n                      }\n                      next = following\n                      records = records + 1u32\n                      continue offset + 24u32 + name_length\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n      _ => break directory_page(entries, next, length < max_bytes)\n    }\n  }\n}\n\npub fn directory_read<h: DirectoryHost>(host: h, path: RelativePath, cookie: U64, max_entries: U32, max_bytes: U32) -> Result<DirectoryPage, DirectoryError> {\n  if !directory_limits_valid(max_entries, max_bytes) {\n    Result::Err(DirectoryError::InvalidLimit)\n  } else if !directory_path_valid(path) {\n    Result::Err(DirectoryError::InvalidName)\n  } else {\n    match host.open_directory(path) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(handle) => {\n        let value = host.read_directory_bytes(handle, cookie, max_bytes)\n        let closed = host.close_directory(handle)\n        match value {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(bytes) => {\n            match directory_decode_page(bytes, cookie, max_entries, max_bytes) {\n              Result::Err(error) => Result::Err(error)\n              Result::Ok(page) => {\n                match closed {\n                  Result::Err(error) => Result::Err(error)\n                  Result::Ok(_) => Result::Ok(page)\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn read_directory<r: DirectoryReader>(reader: r, path: RelativePath, cookie: U64, max_entries: U32, max_bytes: U32) -> Result<DirectoryPage, DirectoryError> {\n  reader.read_directory(path, cookie, max_entries, max_bytes)\n}\n"
}

///|
pub fn standard_wasi_directory_source() -> Bytes {
  b"import dew.std.wasm.wasi as @wasi\nopen dew.std.fs.directory\nopen dew.std.path\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.string\nopen dew.std.wasm.intrinsics\n\npub struct WasiDirectoryReader {\n  root: U32\n}\n\npub fn wasi_directory_reader(root: U32) -> WasiDirectoryReader {\n  WasiDirectoryReader::{\n    root: root\n  }\n}\n\npub fn directory_host_error(code: U32) -> DirectoryError {\n  if code == 2u32 || code == 63u32 {\n    DirectoryError::PermissionDenied\n  } else if code == 32u32 {\n    DirectoryError::Symlink\n  } else {\n    DirectoryError::Host(code)\n  }\n}\n\nimpl DirectoryHost for WasiDirectoryReader {\n  fn open_directory(self, path: RelativePath) -> Result<U32, DirectoryError> {\n    if !directory_path_valid(path) {\n      Result::Err(DirectoryError::InvalidName)\n    } else {\n      let value = path.as_bytes()\n      let mut parent = self.root\n      let mut owned = false\n      let mut start = 0u32\n      while 0u32 {\n        index if index <= value.byte_length() => {\n          if index == value.byte_length() || value.byte_at(index) == 47u8 {\n            let length = index - start\n            while 0u32 {\n              part if part < length => {\n                wasm_u8_store(128u32 + part, value.byte_at(start + part))\n                continue part + 1u32\n              }\n              _ => break ()\n            }\n            // Inspect without following links, then open DIRECTORY with no\n            // lookup flags. Do not rely on the open flag alone on Node WASI.\n            let stat_error = @wasi.path_filestat_get(parent, 0u32, 128u32, length, 0u32)\n            let kind = wasm_u8_load(16u32)\n            let error = if stat_error != 0u32 {\n              stat_error\n            } else if kind == 7u8 {\n              32u32\n            } else if kind != 3u8 {\n              54u32\n            } else {\n              @wasi.path_open(parent, 0u32, 128u32, length, 2u32, 286720u64, 286720u64, 0u32, 0u32)\n            }\n            let child = wasm_u32_load(0u32)\n            let close_error = if owned {\n              @wasi.fd_close(parent)\n            } else {\n              0u32\n            }\n            if error != 0u32 {\n              break Result::Err(directory_host_error(error))\n            } else if close_error != 0u32 {\n              @wasi.fd_close(child)\n              break Result::Err(DirectoryError::Close(close_error))\n            } else if index == value.byte_length() {\n              break Result::Ok(child)\n            } else {\n              parent = child\n              owned = true\n              start = index + 1u32\n              continue index + 1u32\n            }\n          } else {\n            continue index + 1u32\n          }\n        }\n        _ => break Result::Err(DirectoryError::InvalidName)\n      }\n    }\n  }\n\n  fn read_directory_bytes(self, handle: U32, cookie: U64, max_bytes: U32) -> Result<Bytes, DirectoryError> {\n    if max_bytes > 49152u32 {\n      Result::Err(DirectoryError::InvalidLimit)\n    } else {\n      let error = @wasi.fd_readdir(handle, 8192u32, max_bytes, cookie, 0u32)\n      let used = wasm_u32_load(0u32)\n      if error != 0u32 {\n        Result::Err(directory_host_error(error))\n      } else if used > max_bytes {\n        Result::Err(DirectoryError::MalformedRecord)\n      } else {\n        let builder = BytesBuilder::with_capacity(used)\n        while 0u32 {\n          index if index < used => {\n            builder.append_byte(wasm_u8_load(8192u32 + index))\n            continue index + 1u32\n          }\n          _ => break Result::Ok(builder.finish())\n        }\n      }\n    }\n  }\n\n  fn close_directory(self, handle: U32) -> Result<Unit, DirectoryError> {\n    let error = @wasi.fd_close(handle)\n    if error == 0u32 {\n      Result::Ok(())\n    } else {\n      Result::Err(DirectoryError::Close(error))\n    }\n  }\n}\n\nimpl DirectoryReader for WasiDirectoryReader {\n  fn read_directory(self, path: RelativePath, cookie: U64, max_entries: U32, max_bytes: U32) -> Result<DirectoryPage, DirectoryError> {\n    directory_read(self, path, cookie, max_entries, max_bytes)\n  }\n}\n"
}

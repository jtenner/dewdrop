///|
pub fn standard_ordered_map_source() -> Bytes {
  b"open dew.std.ordering\nopen dew.std.collections.red_black_tree\n\npub struct OrderedMap<k, v, c> {\n  tree: RedBlackTree<k, v, c>\n}\n\npub type OrderedMapEntry<k, v> = TreeEntry<k, v>\npub type OrderedMapIter<k, v, c> = RedBlackTreeIter<k, v, c>\n\npub fn ordered_map_new<k, v, c: Comparator<k>>(\n  comparator: c,\n) -> OrderedMap<k, v, c> {\n  OrderedMap {\n    tree: red_black_tree_new(comparator)\n  }\n}\n\npub fn ordered_map_length<k, v, c>(map: OrderedMap<k, v, c>) -> U32 {\n  red_black_tree_length(map.tree)\n}\n\npub fn ordered_map_is_empty<k, v, c>(map: OrderedMap<k, v, c>) -> Bool {\n  red_black_tree_is_empty(map.tree)\n}\n\npub fn ordered_map_insert<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n  value: v,\n) -> Bool {\n  red_black_tree_insert(map.tree, key, value)\n}\n\npub fn ordered_map_set<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n  value: v,\n) -> Unit {\n  let inserted = red_black_tree_insert(map.tree, key, value)\n  let ignored = inserted\n}\n\npub fn ordered_map_get<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Option<v> {\n  red_black_tree_get(map.tree, key)\n}\n\npub fn ordered_map_contains_key<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Bool {\n  red_black_tree_contains(map.tree, key)\n}\n\npub fn ordered_map_remove<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Bool {\n  red_black_tree_remove(map.tree, key)\n}\n\npub fn ordered_map_clear<k, v, c>(map: OrderedMap<k, v, c>) -> Unit {\n  red_black_tree_clear(map.tree)\n}\n\npub fn ordered_map_minimum<k, v, c>(\n  map: OrderedMap<k, v, c>,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_minimum(map.tree)\n}\n\npub fn ordered_map_maximum<k, v, c>(\n  map: OrderedMap<k, v, c>,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_maximum(map.tree)\n}\n\npub fn ordered_map_lower_bound<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_lower_bound(map.tree, key)\n}\n\npub fn ordered_map_upper_bound<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_upper_bound(map.tree, key)\n}\n\npub fn ordered_map_predecessor<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_predecessor(map.tree, key)\n}\n\npub fn ordered_map_successor<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  key: k,\n) -> Option<OrderedMapEntry<k, v>> {\n  red_black_tree_successor(map.tree, key)\n}\n\npub fn ordered_map_entry_key<k, v>(entry: OrderedMapEntry<k, v>) -> k {\n  tree_entry_key(entry)\n}\n\npub fn ordered_map_entry_value<k, v>(entry: OrderedMapEntry<k, v>) -> v {\n  tree_entry_value(entry)\n}\n\npub fn ordered_map_iter<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n) -> OrderedMapIter<k, v, c> {\n  red_black_tree_iter(map.tree)\n}\n\npub fn ordered_map_range<k, v, c: Comparator<k>>(\n  map: OrderedMap<k, v, c>,\n  lower: Option<k>,\n  lower_inclusive: Bool,\n  upper: Option<k>,\n  upper_inclusive: Bool,\n) -> OrderedMapIter<k, v, c> {\n  red_black_tree_range(\n    map.tree,\n    lower,\n    lower_inclusive,\n    upper,\n    upper_inclusive,\n  )\n}\n\npub fn ordered_map_iter_has_next<k, v, c: Comparator<k>>(\n  iter: OrderedMapIter<k, v, c>,\n) -> Bool {\n  red_black_tree_iter_has_next(iter)\n}\n\npub fn ordered_map_iter_next<k, v, c: Comparator<k>>(\n  iter: OrderedMapIter<k, v, c>,\n) -> OrderedMapEntry<k, v> {\n  red_black_tree_iter_next(iter)\n}\n"
}

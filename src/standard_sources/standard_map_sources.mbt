///|
pub fn standard_map_source() -> Bytes {
  b"pub struct Map<key, value> {}\n\nbuiltin map_singleton<key, value>(key: key, value: value) -> Map<key, value> = \"dew_map_singleton\"\nbuiltin map_length<key, value>(map: Map<key, value>) -> U32 = \"dew_map_length\"\nbuiltin map_get<key, value>(map: Map<key, value>, key: key) -> Option<value> = \"dew_map_get\"\nbuiltin map_get_unchecked<key, value>(map: Map<key, value>, key: key) -> value = \"dew_map_get_unchecked\"\nbuiltin map_insert<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = \"dew_map_insert\"\nbuiltin map_set<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = \"dew_map_set\"\nbuiltin map_contains_key<key, value>(map: Map<key, value>, key: key) -> Bool = \"dew_map_contains_key\"\n\nimpl<key, value> Map<key, value> {\n  fn singleton(key: key, value: value) -> Map<key, value> {\n    map_singleton(key, value)\n  }\n  fn length(self) -> U32 {\n    map_length(self)\n  }\n  fn get(self, key: key) -> Option<value> {\n    map_get(self, key)\n  }\n  fn get_unchecked(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n  fn insert(self, key: key, value: value) -> Unit {\n    map_insert(self, key, value)\n  }\n  fn set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n  fn contains_key(self, key: key) -> Bool {\n    map_contains_key(self, key)\n  }\n  fn empty() -> Map<key, value> {\n    map_empty()\n  }\n  fn remove(self, key: key) -> Bool {\n    map_remove(self, key)\n  }\n  fn clear(self) -> Unit {\n    map_clear(self)\n  }\n}\n\nimpl<key, value> IndexedGet<key, value> for Map<key, value> {\n  fn indexed_get(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n}\n\nimpl<key, value> IndexedSet<key, value> for Map<key, value> {\n  fn indexed_set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n}\n\nbuiltin map_empty<key, value>() -> Map<key, value> = \"dew_map_empty\"\nbuiltin map_remove<key, value>(map: Map<key, value>, key: key) -> Bool = \"dew_map_remove\"\nbuiltin map_clear<key, value>(map: Map<key, value>) -> Unit = \"dew_map_clear\"\n\npub struct MapEntry<key, value> {}\npub struct MapKeyIter<key, value> {}\npub struct MapValueIter<key, value> {}\npub struct MapEntryIter<key, value> {}\n\nbuiltin map_keys<key, value>(map: Map<key, value>) -> MapKeyIter<key, value> = \"dew_map_keys\"\nbuiltin map_values<key, value>(map: Map<key, value>) -> MapValueIter<key, value> = \"dew_map_values\"\nbuiltin map_entries<key, value>(map: Map<key, value>) -> MapEntryIter<key, value> = \"dew_map_entries\"\nbuiltin map_key_iter_has_next<key, value>(iter: MapKeyIter<key, value>) -> Bool = \"dew_map_key_iter_has_next\"\nbuiltin map_key_iter_next<key, value>(iter: MapKeyIter<key, value>) -> key = \"dew_map_key_iter_next\"\nbuiltin map_value_iter_has_next<key, value>(iter: MapValueIter<key, value>) -> Bool = \"dew_map_value_iter_has_next\"\nbuiltin map_value_iter_next<key, value>(iter: MapValueIter<key, value>) -> value = \"dew_map_value_iter_next\"\nbuiltin map_entry_iter_has_next<key, value>(iter: MapEntryIter<key, value>) -> Bool = \"dew_map_entry_iter_has_next\"\nbuiltin map_entry_iter_next<key, value>(iter: MapEntryIter<key, value>) -> MapEntry<key, value> = \"dew_map_entry_iter_next\"\nbuiltin map_entry_key<key, value>(entry: MapEntry<key, value>) -> key = \"dew_map_entry_key\"\nbuiltin map_entry_value<key, value>(entry: MapEntry<key, value>) -> value = \"dew_map_entry_value\"\n\nimpl<key, value> Map<key, value> {\n  fn keys(self) -> MapKeyIter<key, value> {\n    map_keys(self)\n  }\n  fn values(self) -> MapValueIter<key, value> {\n    map_values(self)\n  }\n  fn entries(self) -> MapEntryIter<key, value> {\n    map_entries(self)\n  }\n}\n\nimpl<key, value> MapEntry<key, value> {\n  fn key(self) -> key {\n    map_entry_key(self)\n  }\n  fn value(self) -> value {\n    map_entry_value(self)\n  }\n}\n\nimpl<key, value> Iter<key> for MapKeyIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_key_iter_has_next(self)\n  }\n  fn next(self) -> key {\n    map_key_iter_next(self)\n  }\n}\n\nimpl<key, value> Iter<value> for MapValueIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_value_iter_has_next(self)\n  }\n  fn next(self) -> value {\n    map_value_iter_next(self)\n  }\n}\n\nimpl<key, value> Iter<MapEntry<key, value>> for MapEntryIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_entry_iter_has_next(self)\n  }\n  fn next(self) -> MapEntry<key, value> {\n    map_entry_iter_next(self)\n  }\n}\n"
}

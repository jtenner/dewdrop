///|
pub fn standard_map_source() -> Bytes {
  b"open dew.std.preamble\nopen dew.std.wasm.intrinsics\nopen dew.std.types\nopen dew.std.option\nopen dew.std.string\nopen dew.std.bytes\n\npub struct Map<key, value> {\n  mut buckets: WasmArray<Option<MapEntry<key, value>>>\n  mut count: U32\n}\n\npub struct MapEntry<key, value> {\n  mut next: Option<MapEntry<key, value>>\n  hash: U64\n  key: key\n  mut value: value\n}\n\npub struct MapEntryIter<key, value> {\n  owner: Map<key, value>\n  mut bucket: U32\n  mut current: Option<MapEntry<key, value>>\n}\npub struct MapKeyIter<key, value> {\n  inner: MapEntryIter<key, value>\n}\npub struct MapValueIter<key, value> {\n  inner: MapEntryIter<key, value>\n}\n\nfn map_hash<key>(key: key) -> U64 {\n  if implements::<key, Hash>() {\n    key.hash()\n  } else {\n    static_assert(false, \"Map keys must implement Hash\")\n    unreachable()\n  }\n}\n\nfn map_hash_equal<key>(left: key, right: key) -> Bool {\n  if implements::<key, Hash>() {\n    left.hash_eq(right)\n  } else {\n    static_assert(false, \"Map keys must implement Hash\")\n    unreachable()\n  }\n}\n\nfn map_bucket_index(hash: U64, count: U32) -> U32 {\n  if count == 0u32 || (count & (count - 1u32)) != 0u32 {\n    unreachable()\n  } else {\n    let low = unsafe_bitcast::<I32, U32>(i64_trunc_i32(unsafe_bitcast::<U64, I64>(hash)))\n    low & (count - 1u32)\n  }\n}\n\nfn map_empty<key, value>() -> Map<key, value> {\n  Map::{\n    buckets: wasm_array_new(16u32, Option::None)\n    count: 0u32\n  }\n}\n\nfn map_singleton<key, value>(key: key, value: value) -> Map<key, value> {\n  let map = map_empty()\n  map_insert(map, key, value)\n  map\n}\n\nfn map_length<key, value>(map: Map<key, value>) -> U32 {\n  map.count\n}\n\nfn map_find<key, value>(map: Map<key, value>, key: key, hash: U64) -> Option<MapEntry<key, value>> {\n  let index = map_bucket_index(hash, wasm_array_len(map.buckets))\n  while wasm_array_get(map.buckets, index) {\n    Option::None => break Option::None\n    Option::Some(entry) => {\n      if entry.hash == hash && map_hash_equal(entry.key, key) {\n        break Option::Some(entry)\n      } else {\n        continue entry.next\n      }\n    }\n  }\n}\n\nfn map_get<key, value>(map: Map<key, value>, key: key) -> Option<value> {\n  match map_find(map, key, map_hash(key)) {\n    Option::Some(entry) => Option::Some(entry.value)\n    Option::None => Option::None\n  }\n}\n\nfn map_get_unchecked<key, value>(map: Map<key, value>, key: key) -> value {\n  match map_find(map, key, map_hash(key)) {\n    Option::Some(entry) => entry.value\n    Option::None => unreachable()\n  }\n}\n\nfn map_contains_key<key, value>(map: Map<key, value>, key: key) -> Bool {\n  map_find(map, key, map_hash(key)) is Option::Some(_)\n}\n\nfn map_grow<key, value>(map: Map<key, value>) -> Unit {\n  let old = map.buckets\n  let capacity = wasm_array_len(old)\n  if capacity >= 2147483648u32 {\n    unreachable()\n  } else {\n    let buckets = wasm_array_new(capacity * 2u32, Option::None)\n    while 0u32 {\n      index if index < capacity => {\n        while wasm_array_get(old, index) {\n          Option::None => break ()\n          Option::Some(entry) => {\n            let next = entry.next\n            let target = map_bucket_index(entry.hash, capacity * 2u32)\n            entry.next = wasm_array_get(buckets, target)\n            wasm_array_set(buckets, target, Option::Some(entry))\n            continue next\n          }\n        }\n        continue index + 1u32\n      }\n      _ => break ()\n    }\n    map.buckets = buckets\n  }\n}\n\nfn map_insert<key, value>(map: Map<key, value>, key: key, value: value) -> Unit {\n  let hash = map_hash(key)\n  match map_find(map, key, hash) {\n    Option::Some(entry) => {\n      entry.value = value\n    }\n    Option::None => {\n      if map.count == 4294967295u32 {\n        unreachable()\n      } else {\n        if map.count >= wasm_array_len(map.buckets) {\n          map_grow(map)\n        }\n        let index = map_bucket_index(hash, wasm_array_len(map.buckets))\n        let entry = MapEntry::{\n          next: wasm_array_get(map.buckets, index)\n          hash: hash\n          key: key\n          value: value\n        }\n        wasm_array_set(map.buckets, index, Option::Some(entry))\n        map.count = map.count + 1u32\n      }\n    }\n  }\n}\n\nfn map_set<key, value>(map: Map<key, value>, key: key, value: value) -> Unit {\n  map_insert(map, key, value)\n}\n\nfn map_remove<key, value>(map: Map<key, value>, key: key) -> Bool {\n  let hash = map_hash(key)\n  let index = map_bucket_index(hash, wasm_array_len(map.buckets))\n  let mut previous = Option::None\n  while wasm_array_get(map.buckets, index) {\n    Option::None => break false\n    Option::Some(entry) => {\n      if entry.hash == hash && map_hash_equal(entry.key, key) {\n        match previous {\n          Option::None => {\n            wasm_array_set(map.buckets, index, entry.next)\n          }\n          Option::Some(parent) => {\n            parent.next = entry.next\n          }\n        }\n        map.count = map.count - 1u32\n        break true\n      } else {\n        previous = Option::Some(entry)\n        continue entry.next\n      }\n    }\n  }\n}\n\nfn map_clear<key, value>(map: Map<key, value>) -> Unit {\n  map.buckets = wasm_array_new(16u32, Option::None)\n  map.count = 0u32\n}\n\nfn map_entries<key, value>(map: Map<key, value>) -> MapEntryIter<key, value> {\n  MapEntryIter::{\n    owner: map\n    bucket: 0u32\n    current: Option::None\n  }\n}\n\nfn map_entry_iter_has_next<key, value>(iter: MapEntryIter<key, value>) -> Bool {\n  if iter.current is Option::Some(_) {\n    true\n  } else {\n    while iter.bucket {\n      bucket if bucket < wasm_array_len(iter.owner.buckets) => {\n        match wasm_array_get(iter.owner.buckets, bucket) {\n          Option::Some(entry) => {\n            iter.current = Option::Some(entry)\n            break true\n          }\n          Option::None => {\n            iter.bucket = bucket + 1u32\n            continue bucket + 1u32\n          }\n        }\n      }\n      _ => break false\n    }\n  }\n}\n\nfn map_entry_iter_next_option<key, value>(iter: MapEntryIter<key, value>) -> Option<MapEntry<key, value>> {\n  if map_entry_iter_has_next(iter) {\n    let current = iter.current\n    match current {\n      Option::Some(entry) => {\n        iter.current = entry.next\n        if entry.next is Option::None {\n          iter.bucket = iter.bucket + 1u32\n        }\n      }\n      Option::None => unreachable()\n    }\n    current\n  } else {\n    Option::None\n  }\n}\n\nfn map_entry_iter_next<key, value>(iter: MapEntryIter<key, value>) -> MapEntry<key, value> {\n  match map_entry_iter_next_option(iter) {\n    Option::Some(entry) => entry\n    Option::None => unreachable()\n  }\n}\n\nfn map_keys<key, value>(map: Map<key, value>) -> MapKeyIter<key, value> {\n  MapKeyIter::{\n    inner: map_entries(map)\n  }\n}\nfn map_values<key, value>(map: Map<key, value>) -> MapValueIter<key, value> {\n  MapValueIter::{\n    inner: map_entries(map)\n  }\n}\nfn map_key_iter_has_next<key, value>(iter: MapKeyIter<key, value>) -> Bool {\n  map_entry_iter_has_next(iter.inner)\n}\nfn map_value_iter_has_next<key, value>(iter: MapValueIter<key, value>) -> Bool {\n  map_entry_iter_has_next(iter.inner)\n}\nfn map_key_iter_next<key, value>(iter: MapKeyIter<key, value>) -> key {\n  map_entry_iter_next(iter.inner).key\n}\nfn map_value_iter_next<key, value>(iter: MapValueIter<key, value>) -> value {\n  map_entry_iter_next(iter.inner).value\n}\nfn map_key_iter_next_option<key, value>(iter: MapKeyIter<key, value>) -> Option<key> {\n  match map_entry_iter_next_option(iter.inner) {\n    Option::Some(entry) => Option::Some(entry.key)\n    Option::None => Option::None\n  }\n}\nfn map_value_iter_next_option<key, value>(iter: MapValueIter<key, value>) -> Option<value> {\n  match map_entry_iter_next_option(iter.inner) {\n    Option::Some(entry) => Option::Some(entry.value)\n    Option::None => Option::None\n  }\n}\n\nimpl<key, value> Map<key, value> {\n  fn empty() -> Map<key, value> {\n    map_empty()\n  }\n  fn singleton(key: key, value: value) -> Map<key, value> {\n    map_singleton(key, value)\n  }\n  fn length(self) -> U32 {\n    map_length(self)\n  }\n  fn get(self, key: key) -> Option<value> {\n    map_get(self, key)\n  }\n  fn get_unchecked(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n  fn contains_key(self, key: key) -> Bool {\n    map_contains_key(self, key)\n  }\n  fn insert(self, key: key, value: value) -> Unit {\n    map_insert(self, key, value)\n  }\n  fn set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n  fn remove(self, key: key) -> Bool {\n    map_remove(self, key)\n  }\n  fn clear(self) -> Unit {\n    map_clear(self)\n  }\n  fn entries(self) -> MapEntryIter<key, value> {\n    map_entries(self)\n  }\n  fn iter(self) -> MapEntryIter<key, value> {\n    map_entries(self)\n  }\n  fn keys(self) -> MapKeyIter<key, value> {\n    map_keys(self)\n  }\n  fn values(self) -> MapValueIter<key, value> {\n    map_values(self)\n  }\n}\n\nimpl<key, value> MapEntry<key, value> {\n  fn key(self) -> key {\n    self.key\n  }\n  fn value(self) -> value {\n    self.value\n  }\n}\n\nimpl<key, value> IndexedGet<key, value> for Map<key, value> {\n  fn indexed_get(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n}\nimpl<key, value> IndexedSet<key, value> for Map<key, value> {\n  fn indexed_set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n}\nimpl<key, value> Iter<key> for MapKeyIter<key, value> {\n  fn next(self) -> Option<key> {\n    map_key_iter_next_option(self)\n  }\n}\nimpl<key, value> MapKeyIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_key_iter_has_next(self)\n  }\n}\nimpl<key, value> MapValueIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_value_iter_has_next(self)\n  }\n}\nimpl<key, value> MapEntryIter<key, value> {\n  fn has_next(self) -> Bool {\n    map_entry_iter_has_next(self)\n  }\n}\nimpl<key, value> Iter<value> for MapValueIter<key, value> {\n  fn next(self) -> Option<value> {\n    map_value_iter_next_option(self)\n  }\n}\nimpl<key, value> Iter<MapEntry<key, value>> for MapEntryIter<key, value> {\n  fn next(self) -> Option<MapEntry<key, value>> {\n    map_entry_iter_next_option(self)\n  }\n}\n"
}

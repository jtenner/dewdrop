///|
pub fn standard_utf8_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.string\nopen dew.std.string_builder\n\npub enum Utf8DecodeError {\n  InvalidSequence(U32)\n} derive(Eq)\n\npub fn utf8_is_continuation(byte: U8) -> Bool {\n  byte >= 128u8 && byte <= 191u8\n}\n\npub fn utf8_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn utf8_valid_sequence_width(value: Bytes, index: U32) -> U32 {\n  let length = value.byte_length()\n  let remaining = length - index\n  let first = value.byte_at(index)\n  if first <= 127u8 {\n    1u32\n  } else if first >= 194u8 && first <= 223u8 {\n    if remaining >= 2u32 && utf8_is_continuation(value.byte_at(index + 1u32)) {\n      2u32\n    } else {\n      0u32\n    }\n  } else if first >= 224u8 && first <= 239u8 {\n    if remaining < 3u32 {\n      0u32\n    } else {\n      let second = value.byte_at(index + 1u32)\n      let third = value.byte_at(index + 2u32)\n      if utf8_is_continuation(second) &&\n        utf8_is_continuation(third) &&\n        (first != 224u8 || second >= 160u8) &&\n        (first != 237u8 || second < 160u8) {\n        3u32\n      } else {\n        0u32\n      }\n    }\n  } else if first >= 240u8 && first <= 244u8 {\n    if remaining < 4u32 {\n      0u32\n    } else {\n      let second = value.byte_at(index + 1u32)\n      let third = value.byte_at(index + 2u32)\n      let fourth = value.byte_at(index + 3u32)\n      if utf8_is_continuation(second) &&\n        utf8_is_continuation(third) &&\n        utf8_is_continuation(fourth) &&\n        (first != 240u8 || second >= 144u8) &&\n        (first != 244u8 || second < 144u8) {\n        4u32\n      } else {\n        0u32\n      }\n    }\n  } else {\n    0u32\n  }\n}\n\npub fn utf8_first_invalid_index(value: Bytes) -> U32 {\n  let length = value.byte_length()\n  while 0u32 {\n    index if index < length => {\n      let width = utf8_valid_sequence_width(value, index)\n      if width == 0u32 {\n        break index\n      } else {\n        continue index + width\n      }\n    }\n    _ => break 4294967295u32\n  }\n}\n\npub fn utf8_expected_sequence_width(first: U8) -> U32 {\n  if first >= 194u8 && first <= 223u8 {\n    2u32\n  } else if first >= 224u8 && first <= 239u8 {\n    3u32\n  } else if first >= 240u8 && first <= 244u8 {\n    4u32\n  } else {\n    1u32\n  }\n}\n\npub fn utf8_invalid_sequence_width(value: Bytes, index: U32) -> U32 {\n  let length = value.byte_length()\n  let expected = utf8_expected_sequence_width(value.byte_at(index))\n  if expected == 1u32 {\n    1u32\n  } else {\n    while 1u32 {\n      width if width < expected && width < length - index && utf8_is_continuation(value.byte_at(index + width)) => {\n        continue width + 1u32\n      }\n      width => break width\n    }\n  }\n}\n\npub fn utf8_append_valid_scalar(\n  builder: StringBuilder,\n  value: Bytes,\n  index: U32,\n  width: U32,\n) -> Unit {\n  let first = utf8_u8_to_u32(value.byte_at(index))\n  if width == 1u32 {\n    builder.append_ascii(value.byte_at(index))\n  } else if width == 2u32 {\n    let second = utf8_u8_to_u32(value.byte_at(index + 1u32))\n    builder.append_scalar(\n      ((first & 31u32) << 6u32) |\n      (second & 63u32),\n    )\n  } else if width == 3u32 {\n    let second = utf8_u8_to_u32(value.byte_at(index + 1u32))\n    let third = utf8_u8_to_u32(value.byte_at(index + 2u32))\n    builder.append_scalar(\n      ((first & 15u32) << 12u32) |\n      ((second & 63u32) << 6u32) |\n      (third & 63u32),\n    )\n  } else {\n    let second = utf8_u8_to_u32(value.byte_at(index + 1u32))\n    let third = utf8_u8_to_u32(value.byte_at(index + 2u32))\n    let fourth = utf8_u8_to_u32(value.byte_at(index + 3u32))\n    builder.append_scalar(\n      ((first & 7u32) << 18u32) |\n      ((second & 63u32) << 12u32) |\n      ((third & 63u32) << 6u32) |\n      (fourth & 63u32),\n    )\n  }\n}\n\npub fn encode(value: String) -> Bytes {\n  value.as_bytes()\n}\n\npub fn encode_view(value: StringView) -> Bytes {\n  value.as_bytes()\n}\n\npub fn utf8_unit() -> Unit {\n}\n\npub fn validate(value: Bytes) -> Result<Unit, Utf8DecodeError> {\n  if value.is_valid_utf8() {\n    Result::Ok(utf8_unit())\n  } else {\n    Result::Err(Utf8DecodeError::InvalidSequence(utf8_first_invalid_index(value)))\n  }\n}\n\npub fn decode(value: Bytes) -> Result<String, Utf8DecodeError> {\n  if value.is_valid_utf8() {\n    Result::Ok(value.to_string())\n  } else {\n    Result::Err(Utf8DecodeError::InvalidSequence(utf8_first_invalid_index(value)))\n  }\n}\n\npub fn decode_lossy(value: Bytes) -> String {\n  if value.is_valid_utf8() {\n    value.to_string()\n  } else {\n    let builder = StringBuilder::with_capacity(value.byte_length())\n    let length = value.byte_length()\n    while 0u32 {\n      index if index < length => {\n        let width = utf8_valid_sequence_width(value, index)\n        if width == 0u32 {\n          builder.append_scalar(65533u32)\n          continue index + utf8_invalid_sequence_width(value, index)\n        } else {\n          utf8_append_valid_scalar(builder, value, index, width)\n          continue index + width\n        }\n      }\n      _ => break builder.finish()\n    }\n  }\n}\n"
}

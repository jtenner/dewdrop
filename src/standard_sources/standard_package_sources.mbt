///|
pub fn standard_encode_source() -> Bytes {
  b"open dew.std.bytes\n\npub trait Encode<t_err> {\n  fn encode(self) -> Result<Bytes, t_err>\n}\n"
}

///|
pub fn standard_decode_source() -> Bytes {
  b"open dew.std.bytes\n\npub trait Decode<t, t_err> {\n  fn decode(bytes: Bytes) -> Result<t, t_err>\n}\n"
}

///|
pub fn standard_format_source() -> Bytes {
  b"pub enum FormatEncodeError {\n  Validation(FormatValidationErr)\n  EncodingFailed\n}\n\npub enum FormatDecodeError {\n  FileTooLarge(U32, U32)\n  InvalidUtf8\n  InvalidSyntax(String)\n  UnsupportedVersion(U32)\n  UnexpectedEnd(U32)\n  InvalidTag(U32, U32)\n  InvalidLength(U32, U32)\n  ChecksumMismatch\n  TrailingData(U32)\n}\n\npub enum FormatValidationErr {\n  MissingField(String)\n  UnknownField(String)\n  InvalidField(String)\n  LimitExceeded(String, U32, U32)\n  ByteLimitExceeded(String, U64, U64)\n  Duplicate(String)\n  OutOfOrder(String)\n  UnsupportedVersion(U32)\n  ChecksumMismatch\n}\n\npub trait Validate<t_err> {\n  fn validate(self) -> Result<Unit, t_err>\n}\n\npub fn validate<t_err, t: Validate<t_err>>(\n  value: t,\n) -> Result<Unit, t_err> {\n  value.validate()\n}\n"
}

///|
pub fn standard_semver_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bytes\nopen dew.std.ordering\nopen dew.std.string\nopen dew.std.string_builder\n\npub enum SemVerIdentifier {\n  Numeric(U32)\n  Text(String)\n}\n\npub struct SemVer {\n  major: U32\n  minor: U32\n  patch: U32\n  prerelease: Array<SemVerIdentifier>\n  build: Array<String>\n  text: String\n}\n\npub enum SemVerParseError {\n  Empty\n  TooLong(U32, U32)\n  InvalidCore\n  InvalidNumber(U32)\n  NumberOverflow(U32)\n  LeadingZero(U32)\n  EmptyIdentifier(U32)\n  InvalidIdentifier(U32, U8)\n  DuplicatePrerelease\n  DuplicateBuild\n}\n\npub fn semver_max_bytes() -> U32 {\n  255u32\n}\n\npub fn semver_unit() -> Unit {\n}\n\npub fn semver_is_digit(byte: U8) -> Bool {\n  byte >= 48u8 && byte <= 57u8\n}\n\npub fn semver_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn semver_is_identifier_byte(byte: U8) -> Bool {\n  semver_is_digit(byte) ||\n  (byte >= 65u8 && byte <= 90u8) ||\n  (byte >= 97u8 && byte <= 122u8) ||\n  byte == 45u8\n}\n\npub fn semver_find_byte(value: String, start: U32, end: U32, byte: U8) -> Option<U32> {\n  while start {\n    index if index < end => if value.byte_at(index) == byte {\n      break Option::Some(index)\n    } else {\n      continue index + 1u32\n    }\n    _ => break Option::None\n  }\n}\n\npub fn semver_parse_u32(value: String, start: U32, end: U32) -> Result<U32, SemVerParseError> {\n  if start == end {\n    Result::Err(SemVerParseError::InvalidNumber(start))\n  } else if end - start > 1u32 && value.byte_at(start) == 48u8 {\n    Result::Err(SemVerParseError::LeadingZero(start))\n  } else {\n    let mut number = 0u32\n    while start {\n      index if index < end => {\n        let byte = value.byte_at(index)\n        if !semver_is_digit(byte) {\n          break Result::Err(SemVerParseError::InvalidNumber(index))\n        } else {\n          let digit = semver_u8_to_u32(byte - 48u8)\n          if number > 429496729u32 ||\n            (number == 429496729u32 && digit > 5u32) {\n            break Result::Err(SemVerParseError::NumberOverflow(index))\n          } else {\n            number = number * 10u32 + digit\n            continue index + 1u32\n          }\n        }\n      }\n      _ => break Result::Ok(number)\n    }\n  }\n}\n\npub fn semver_identifier_kind_from(\n  value: String,\n  index: U32,\n  end: U32,\n  kind: U32,\n) -> U32 {\n  if index >= end {\n    kind\n  } else {\n    let byte = value.byte_at(index)\n    let next = if !semver_is_identifier_byte(byte) {\n      2u32\n    } else if kind == 0u32 && !semver_is_digit(byte) {\n      1u32\n    } else {\n      kind\n    }\n    semver_identifier_kind_from(value, index + 1u32, end, next)\n  }\n}\n\npub fn semver_identifier_kind(value: String, start: U32, end: U32) -> U32 {\n  semver_identifier_kind_from(value, start, end, 0u32)\n}\n\npub fn semver_parse_identifiers_from(\n  value: String,\n  item_start: U32,\n  index: U32,\n  end: U32,\n  numeric_rules: Bool,\n  output: Array<SemVerIdentifier>,\n) -> Result<Array<SemVerIdentifier>, SemVerParseError> {\n  if index > end {\n    Result::Ok(output)\n  } else if index < end && value.byte_at(index) != 46u8 {\n    semver_parse_identifiers_from(value, item_start, index + 1u32, end, numeric_rules, output)\n  } else if index == item_start {\n    Result::Err(SemVerParseError::EmptyIdentifier(index))\n  } else {\n    let kind = semver_identifier_kind(value, item_start, index)\n    if kind == 2u32 {\n      Result::Err(SemVerParseError::InvalidIdentifier(item_start, value.byte_at(item_start)))\n    } else if kind == 0u32 && numeric_rules {\n      match semver_parse_u32(value, item_start, index) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(number) => {\n          output.push(SemVerIdentifier::Numeric(number))\n          semver_parse_identifiers_from(value, index + 1u32, index + 1u32, end, numeric_rules, output)\n        }\n      }\n    } else {\n      output.push(SemVerIdentifier::Text(value.slice(item_start, index)))\n      semver_parse_identifiers_from(value, index + 1u32, index + 1u32, end, numeric_rules, output)\n    }\n  }\n}\n\npub fn semver_parse_identifiers(\n  value: String,\n  start: U32,\n  end: U32,\n  numeric_rules: Bool,\n) -> Result<Array<SemVerIdentifier>, SemVerParseError> {\n  if start == end {\n    Result::Err(SemVerParseError::EmptyIdentifier(start))\n  } else {\n    semver_parse_identifiers_from(value, start, start, end, numeric_rules, Array::new())\n  }\n}\n\npub fn semver_identifiers_to_strings(values: Array<SemVerIdentifier>) -> Array<String> {\n  let output = Array::with_capacity(values.length())\n  while 0u32 {\n    index if index < values.length() => {\n      match values.get_unchecked(index) {\n        SemVerIdentifier::Numeric(number) => {\n          let builder = StringBuilder::new()\n          builder.append_u32(number)\n          output.push(builder.finish())\n        }\n        SemVerIdentifier::Text(text) => output.push(text)\n      }\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn semver_finish_parse(\n  value: String,\n  length: U32,\n  core_end: U32,\n  prerelease_start: U32,\n  build_start: U32,\n) -> Result<SemVer, SemVerParseError> {\n  match semver_find_byte(value, 0u32, core_end, 46u8) {\n    Option::None => Result::Err(SemVerParseError::InvalidCore)\n    Option::Some(first_dot) => match semver_find_byte(value, first_dot + 1u32, core_end, 46u8) {\n      Option::None => Result::Err(SemVerParseError::InvalidCore)\n      Option::Some(second_dot) => if semver_find_byte(value, second_dot + 1u32, core_end, 46u8) is Option::Some(_) {\n        Result::Err(SemVerParseError::InvalidCore)\n      } else {\n        match semver_parse_u32(value, 0u32, first_dot) {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(major) => match semver_parse_u32(value, first_dot + 1u32, second_dot) {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(minor) => match semver_parse_u32(value, second_dot + 1u32, core_end) {\n              Result::Err(error) => Result::Err(error)\n              Result::Ok(patch) => {\n                let prerelease_end = if build_start < length {\n                  build_start - 1u32\n                } else {\n                  length\n                }\n                let prerelease_result = if prerelease_start < length {\n                  semver_parse_identifiers(value, prerelease_start, prerelease_end, true)\n                } else {\n                  Result::Ok(Array::new())\n                }\n                match prerelease_result {\n                  Result::Err(error) => Result::Err(error)\n                  Result::Ok(prerelease) => {\n                    let build_result = if build_start < length {\n                      semver_parse_identifiers(value, build_start, length, false)\n                    } else {\n                      Result::Ok(Array::new())\n                    }\n                    match build_result {\n                      Result::Err(error) => Result::Err(error)\n                      Result::Ok(build_values) => Result::Ok(SemVer::{\n                        major: major\n                        minor: minor\n                        patch: patch\n                        prerelease: prerelease\n                        build: semver_identifiers_to_strings(build_values)\n                        text: value\n                      })\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn semver_parse_without_build(\n  value: String,\n  length: U32,\n  main_end: U32,\n  build_start: U32,\n) -> Result<SemVer, SemVerParseError> {\n  match semver_find_byte(value, 0u32, main_end, 45u8) {\n    Option::Some(dash) => semver_finish_parse(value, length, dash, dash + 1u32, build_start)\n    Option::None => semver_finish_parse(value, length, main_end, length, build_start)\n  }\n}\n\npub fn semver_parse(value: String) -> Result<SemVer, SemVerParseError> {\n  let length = value.byte_length()\n  if length == 0u32 {\n    Result::Err(SemVerParseError::Empty)\n  } else if length > semver_max_bytes() {\n    Result::Err(SemVerParseError::TooLong(length, semver_max_bytes()))\n  } else {\n    match semver_find_byte(value, 0u32, length, 43u8) {\n      Option::None => semver_parse_without_build(value, length, length, length)\n      Option::Some(plus) => if semver_find_byte(value, plus + 1u32, length, 43u8) is Option::Some(_) {\n        Result::Err(SemVerParseError::DuplicateBuild)\n      } else {\n        semver_parse_without_build(value, length, plus, plus + 1u32)\n      }\n    }\n  }\n}\n\npub fn semver_parse_bytes(value: Bytes) -> Result<SemVer, SemVerParseError> {\n  if value.is_valid_utf8() {\n    semver_parse(value.to_string())\n  } else {\n    Result::Err(SemVerParseError::InvalidIdentifier(0u32, 0u8))\n  }\n}\n\npub fn semver(major: U32, minor: U32, patch: U32) -> SemVer {\n  let builder = StringBuilder::new()\n  builder.append_u32(major)\n  builder.append(\".\")\n  builder.append_u32(minor)\n  builder.append(\".\")\n  builder.append_u32(patch)\n  SemVer::{\n    major: major\n    minor: minor\n    patch: patch\n    prerelease: Array::new()\n    build: Array::new()\n    text: builder.finish()\n  }\n}\n\nimpl SemVer {\n  fn major(self) -> U32 {\n    self.major\n  }\n  fn minor(self) -> U32 {\n    self.minor\n  }\n  fn patch(self) -> U32 {\n    self.patch\n  }\n  fn prerelease(self) -> Array<SemVerIdentifier> {\n    self.prerelease\n  }\n  fn build(self) -> Array<String> {\n    self.build\n  }\n  fn is_prerelease(self) -> Bool {\n    self.prerelease.length() > 0u32\n  }\n  fn to_string(self) -> String {\n    self.text\n  }\n}\n\npub fn semver_compare_text(left: String, right: String) -> Ordering {\n  string_comparator().compare(left, right)\n}\n\npub fn semver_compare_identifier(left: SemVerIdentifier, right: SemVerIdentifier) -> Ordering {\n  match left {\n    SemVerIdentifier::Numeric(left_number) => match right {\n      SemVerIdentifier::Numeric(right_number) => if left_number < right_number {\n        Ordering::Less\n      } else if left_number > right_number {\n        Ordering::Greater\n      } else {\n        Ordering::Equal\n      }\n      SemVerIdentifier::Text(_) => Ordering::Less\n    }\n    SemVerIdentifier::Text(left_text) => match right {\n      SemVerIdentifier::Numeric(_) => Ordering::Greater\n      SemVerIdentifier::Text(right_text) => semver_compare_text(left_text, right_text)\n    }\n  }\n}\n\npub fn semver_compare(left: SemVer, right: SemVer) -> Ordering {\n  if left.major < right.major {\n    Ordering::Less\n  } else if left.major > right.major {\n    Ordering::Greater\n  } else if left.minor < right.minor {\n    Ordering::Less\n  } else if left.minor > right.minor {\n    Ordering::Greater\n  } else if left.patch < right.patch {\n    Ordering::Less\n  } else if left.patch > right.patch {\n    Ordering::Greater\n  } else if left.prerelease.length() == 0u32 && right.prerelease.length() == 0u32 {\n    Ordering::Equal\n  } else if left.prerelease.length() == 0u32 {\n    Ordering::Greater\n  } else if right.prerelease.length() == 0u32 {\n    Ordering::Less\n  } else {\n    let limit = if left.prerelease.length() < right.prerelease.length() {\n      left.prerelease.length()\n    } else {\n      right.prerelease.length()\n    }\n    while 0u32 {\n      index if index < limit => {\n        let compared = semver_compare_identifier(\n          left.prerelease.get_unchecked(index),\n          right.prerelease.get_unchecked(index),\n        )\n        if compared is Ordering::Equal {\n          continue index + 1u32\n        } else {\n          break compared\n        }\n      }\n      _ => if left.prerelease.length() < right.prerelease.length() {\n        break Ordering::Less\n      } else if left.prerelease.length() > right.prerelease.length() {\n        break Ordering::Greater\n      } else {\n        break Ordering::Equal\n      }\n    }\n  }\n}\n\npub fn semver_same_precedence(left: SemVer, right: SemVer) -> Bool {\n  semver_compare(left, right) is Ordering::Equal\n}\n\npub fn semver_caret_matches(base: SemVer, candidate: SemVer) -> Bool {\n  if semver_compare(candidate, base) is Ordering::Less {\n    false\n  } else if candidate.is_prerelease() && !semver_same_precedence(candidate, base) {\n    false\n  } else if base.major > 0u32 {\n    candidate.major == base.major\n  } else if base.minor > 0u32 {\n    candidate.major == 0u32 && candidate.minor == base.minor\n  } else {\n    candidate.major == 0u32 && candidate.minor == 0u32 && candidate.patch == base.patch\n  }\n}\n\npub fn semver_tilde_matches(base: SemVer, candidate: SemVer) -> Bool {\n  !(semver_compare(candidate, base) is Ordering::Less) &&\n  (!candidate.is_prerelease() || semver_same_precedence(candidate, base)) &&\n  candidate.major == base.major && candidate.minor == base.minor\n}\n"
}

///|
pub fn standard_package_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bytes\nopen dew.std.decode\nopen dew.std.encode\nopen dew.std.format\nopen dew.std.json\nopen dew.std.ordering\nopen dew.std.semver\nopen dew.std.string\n\npub enum PackageRequirement {\n  Any\n  Exact(SemVer)\n  Caret(SemVer)\n  Tilde(SemVer)\n  Git(String)\n}\n\npub struct PackageDependency {\n  name: String\n  requirement: PackageRequirement\n}\n\npub struct PackageManifest {\n  name: String\n  version: SemVer\n  dependencies: Array<PackageDependency>\n}\n\npub struct LockedPackage {\n  name: String\n  version: SemVer\n  source: String\n  path: String\n  integrity: String\n  interface_fingerprint: String\n}\n\npub struct PackageLock {\n  packages: Array<LockedPackage>\n}\n\npub struct ModuleManifestEntry {\n  name: String\n  files: Array<String>\n}\n\npub struct ModuleManifest {\n  root: String\n  modules: Array<ModuleManifestEntry>\n}\n\npub fn package_manifest_max_bytes() -> U32 {\n  1048576u32\n}\n\npub fn package_lock_max_bytes() -> U32 {\n  8388608u32\n}\n\npub fn module_manifest_max_bytes() -> U32 {\n  4194304u32\n}\n\npub fn package_max_dependencies() -> U32 {\n  256u32\n}\n\npub fn package_lock_max_packages() -> U32 {\n  4096u32\n}\n\npub fn module_manifest_max_modules() -> U32 {\n  1024u32\n}\n\npub fn module_manifest_max_files_per_module() -> U32 {\n  4096u32\n}\n\npub fn package_name_max_bytes() -> U32 {\n  255u32\n}\n\npub fn package_requirement_max_bytes() -> U32 {\n  2048u32\n}\n\npub fn package_path_max_bytes() -> U32 {\n  4096u32\n}\n\npub fn package_unit() -> Unit {\n}\n\npub fn package_is_name_byte(byte: U8) -> Bool {\n  (byte >= 97u8 && byte <= 122u8) ||\n  (byte >= 48u8 && byte <= 57u8) ||\n  byte == 45u8 || byte == 95u8 || byte == 46u8\n}\n\npub fn package_name_is_valid(name: String) -> Bool {\n  let length = name.byte_length()\n  if length < 4u32 || length > package_name_max_bytes() || name.byte_at(0u32) != 64u8 {\n    false\n  } else {\n    let mut slash = 4294967295u32\n    let valid = while 1u32 {\n      index if index < length => {\n        let byte = name.byte_at(index)\n        if byte == 47u8 {\n          if slash != 4294967295u32 || index == 1u32 || index + 1u32 == length {\n            break false\n          } else {\n            slash = index\n            continue index + 1u32\n          }\n        } else if !package_is_name_byte(byte) {\n          break false\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break true\n    }\n    valid && slash != 4294967295u32\n  }\n}\n\npub fn package_string_has_nul(value: String) -> Bool {\n  while 0u32 {\n    index if index < value.byte_length() => if value.byte_at(index) == 0u8 {\n      break true\n    } else {\n      continue index + 1u32\n    }\n    _ => break false\n  }\n}\n\npub fn package_requirement_parse(value: String) -> Result<PackageRequirement, FormatValidationErr> {\n  if value.byte_length() == 0u32 || value.byte_length() > package_requirement_max_bytes() {\n    Result::Err(FormatValidationErr::InvalidField(\"dependency requirement\"))\n  } else if value.equals(\"*\") {\n    Result::Ok(PackageRequirement::Any)\n  } else if value.starts_with(\"git+\") {\n    match value.find(\"#\") {\n      Option::Some(index) if index > 4u32 && index + 1u32 < value.byte_length() && !package_string_has_nul(value) =>\n        Result::Ok(PackageRequirement::Git(value))\n      _ => Result::Err(FormatValidationErr::InvalidField(\"Git dependency requirement\"))\n    }\n  } else if value.byte_at(0u32) == 94u8 {\n    match semver_parse(value.slice(1u32, value.byte_length())) {\n      Result::Ok(version) => Result::Ok(PackageRequirement::Caret(version))\n      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField(\"caret dependency requirement\"))\n    }\n  } else if value.byte_at(0u32) == 126u8 {\n    match semver_parse(value.slice(1u32, value.byte_length())) {\n      Result::Ok(version) => Result::Ok(PackageRequirement::Tilde(version))\n      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField(\"tilde dependency requirement\"))\n    }\n  } else {\n    match semver_parse(value) {\n      Result::Ok(version) => Result::Ok(PackageRequirement::Exact(version))\n      Result::Err(_) => Result::Err(FormatValidationErr::InvalidField(\"exact dependency requirement\"))\n    }\n  }\n}\n\npub fn package_requirement_to_string(value: PackageRequirement) -> String {\n  match value {\n    PackageRequirement::Any => \"*\"\n    PackageRequirement::Exact(version) => version.to_string()\n    PackageRequirement::Caret(version) => \"^\".concat(version.to_string())\n    PackageRequirement::Tilde(version) => \"~\".concat(version.to_string())\n    PackageRequirement::Git(source) => source\n  }\n}\n\npub fn package_requirement_matches(requirement: PackageRequirement, version: SemVer) -> Bool {\n  match requirement {\n    PackageRequirement::Any => !version.is_prerelease()\n    PackageRequirement::Exact(expected) => semver_same_precedence(expected, version)\n    PackageRequirement::Caret(base) => semver_caret_matches(base, version)\n    PackageRequirement::Tilde(base) => semver_tilde_matches(base, version)\n    PackageRequirement::Git(_) => true\n  }\n}\n\npub fn package_dependency(name: String, requirement: PackageRequirement) -> PackageDependency {\n  PackageDependency::{\n    name: name\n    requirement: requirement\n  }\n}\n\nimpl PackageDependency {\n  fn name(self) -> String {\n    self.name\n  }\n  fn requirement(self) -> PackageRequirement {\n    self.requirement\n  }\n}\n\npub fn package_manifest(\n  name: String,\n  version: SemVer,\n  dependencies: Array<PackageDependency>,\n) -> PackageManifest {\n  PackageManifest::{\n    name: name\n    version: version\n    dependencies: dependencies\n  }\n}\n\nimpl PackageManifest {\n  fn name(self) -> String {\n    self.name\n  }\n  fn version(self) -> SemVer {\n    self.version\n  }\n  fn dependencies(self) -> Array<PackageDependency> {\n    self.dependencies\n  }\n}\n\npub fn locked_package(\n  name: String,\n  version: SemVer,\n  source: String,\n  path: String,\n  integrity: String,\n  interface_fingerprint: String,\n) -> LockedPackage {\n  LockedPackage::{\n    name: name\n    version: version\n    source: source\n    path: path\n    integrity: integrity\n    interface_fingerprint: interface_fingerprint\n  }\n}\n\nimpl LockedPackage {\n  fn name(self) -> String {\n    self.name\n  }\n  fn version(self) -> SemVer {\n    self.version\n  }\n  fn source(self) -> String {\n    self.source\n  }\n  fn path(self) -> String {\n    self.path\n  }\n  fn integrity(self) -> String {\n    self.integrity\n  }\n  fn interface_fingerprint(self) -> String {\n    self.interface_fingerprint\n  }\n}\n\npub fn package_lock(packages: Array<LockedPackage>) -> PackageLock {\n  PackageLock::{\n    packages: packages\n  }\n}\n\nimpl PackageLock {\n  fn packages(self) -> Array<LockedPackage> {\n    self.packages\n  }\n}\n\npub fn module_manifest_entry(name: String, files: Array<String>) -> ModuleManifestEntry {\n  ModuleManifestEntry::{\n    name: name\n    files: files\n  }\n}\n\nimpl ModuleManifestEntry {\n  fn name(self) -> String {\n    self.name\n  }\n  fn files(self) -> Array<String> {\n    self.files\n  }\n}\n\npub fn module_manifest(root: String, modules: Array<ModuleManifestEntry>) -> ModuleManifest {\n  ModuleManifest::{\n    root: root\n    modules: modules\n  }\n}\n\nimpl ModuleManifest {\n  fn root(self) -> String {\n    self.root\n  }\n  fn modules(self) -> Array<ModuleManifestEntry> {\n    self.modules\n  }\n}\n\npub fn package_json_limits(max_bytes: U32, max_values: U32) -> JsonLimits {\n  JsonLimits::{\n    max_input_bytes: max_bytes\n    max_depth: 16u32\n    max_values: max_values\n    max_string_bytes: package_path_max_bytes()\n  }\n}\n\npub fn package_json_parse(bytes: Bytes, max_bytes: U32, max_values: U32) -> Result<JsonValue, FormatDecodeError> {\n  if bytes.byte_length() > max_bytes {\n    Result::Err(FormatDecodeError::FileTooLarge(bytes.byte_length(), max_bytes))\n  } else {\n    match json_parse_bytes_with_limits(bytes, package_json_limits(max_bytes, max_values)) {\n      Result::Ok(value) => Result::Ok(value)\n      Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"invalid JSON\"))\n    }\n  }\n}\n\npub fn package_json_string(value: Option<JsonValue>, field: String) -> Result<String, FormatDecodeError> {\n  match value {\n    Option::Some(JsonValue::String(text)) => Result::Ok(text)\n    Option::Some(JsonValue::ValidatedString(text)) => Result::Ok(text.string())\n    _ => Result::Err(FormatDecodeError::InvalidSyntax(field))\n  }\n}\n\npub fn package_json_object(value: JsonValue, field: String) -> Result<Array<JsonMember>, FormatDecodeError> {\n  match value {\n    JsonValue::Object(members) => Result::Ok(members)\n    _ => Result::Err(FormatDecodeError::InvalidSyntax(field))\n  }\n}\n\npub fn package_json_array(value: Option<JsonValue>, field: String) -> Result<Array<JsonValue>, FormatDecodeError> {\n  match value {\n    Option::Some(JsonValue::Array(values)) => Result::Ok(values)\n    _ => Result::Err(FormatDecodeError::InvalidSyntax(field))\n  }\n}\n\npub fn package_allowed2(first: String, second: String) -> Array<String> {\n  let output = Array::new()\n  output.push(first)\n  output.push(second)\n  output\n}\n\npub fn package_allowed3(first: String, second: String, third: String) -> Array<String> {\n  let output = package_allowed2(first, second)\n  output.push(third)\n  output\n}\n\npub fn package_allowed6(\n  first: String,\n  second: String,\n  third: String,\n  fourth: String,\n  fifth: String,\n  sixth: String,\n) -> Array<String> {\n  let output = package_allowed3(first, second, third)\n  output.push(fourth)\n  output.push(fifth)\n  output.push(sixth)\n  output\n}\n\npub fn package_json_known(members: Array<JsonMember>, allowed: Array<String>) -> Bool {\n  while 0u32 {\n    index if index < members.length() => {\n      let key = members.get_unchecked(index).key\n      let found = while 0u32 {\n        allowed_index if allowed_index < allowed.length() => {\n          let allowed_key = allowed[allowed_index]\n          if package_string_compare(key, allowed_key) is Ordering::Equal {\n            break true\n          } else {\n            continue allowed_index + 1u32\n          }\n        }\n        _ => break false\n      }\n      if !found {\n        break false\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break true\n  }\n}\n\npub fn package_string_compare(left: String, right: String) -> Ordering {\n  string_comparator().compare(left, right)\n}\n\npub fn package_is_hex(value: String, length: U32) -> Bool {\n  if value.byte_length() != length {\n    false\n  } else {\n    while 0u32 {\n      index if index < length => {\n        let byte = value.byte_at(index)\n        if (byte >= 48u8 && byte <= 57u8) || (byte >= 97u8 && byte <= 102u8) {\n          continue index + 1u32\n        } else {\n          break false\n        }\n      }\n      _ => break true\n    }\n  }\n}\n\npub fn package_relative_path_is_valid(value: String) -> Bool {\n  value.byte_length() > 0u32 &&\n  value.byte_length() <= package_path_max_bytes() &&\n  value.byte_at(0u32) != 47u8 &&\n  !value.contains(\"\\\\\") &&\n  !value.contains(\"\\x00\") &&\n  !value.equals(\"..\") &&\n  !value.starts_with(\"../\") &&\n  !value.contains(\"/../\") &&\n  !value.ends_with(\"/..\")\n}\n\npub fn package_manifest_dependencies(\n  values: Array<JsonMember>,\n  index: U32,\n  output: Array<PackageDependency>,\n) -> Result<Array<PackageDependency>, FormatDecodeError> {\n  if index >= values.length() {\n    Result::Ok(output)\n  } else {\n    let member = values.get_unchecked(index)\n    let requirement_text = match member.value {\n      JsonValue::String(text) => Result::Ok(text)\n      JsonValue::ValidatedString(text) => Result::Ok(text.string())\n      _ => Result::Err(FormatDecodeError::InvalidSyntax(\"dependency requirement\"))\n    }\n    match requirement_text {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(text) => match package_requirement_parse(text) {\n        Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"dependency requirement\"))\n        Result::Ok(requirement) => {\n          output.push(package_dependency(member.key, requirement))\n          package_manifest_dependencies(values, index + 1u32, output)\n        }\n      }\n    }\n  }\n}\n\npub fn package_manifest_finish(\n  members: Array<JsonMember>,\n  name: String,\n  version: SemVer,\n) -> Result<PackageManifest, FormatDecodeError> {\n  match json_object_get(members, \"dependencies\") {\n    Option::None => Result::Ok(package_manifest(name, version, Array::new()))\n    Option::Some(JsonValue::Object(values)) => if values.length() > package_max_dependencies() {\n      Result::Err(FormatDecodeError::InvalidLength(values.length(), package_max_dependencies()))\n    } else {\n      match package_manifest_dependencies(values, 0u32, Array::new()) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(dependencies) => Result::Ok(package_manifest(name, version, dependencies))\n      }\n    }\n    _ => Result::Err(FormatDecodeError::InvalidSyntax(\"package dependencies\"))\n  }\n}\n\npub fn package_manifest_try_decode(bytes: Bytes) -> Result<PackageManifest, FormatDecodeError> {\n  match package_json_parse(bytes, package_manifest_max_bytes(), 4096u32) {\n    Result::Err(error) => Result::Err(error)\n    Result::Ok(value) => match package_json_object(value, \"package manifest root\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(members) => if !package_json_known(members, package_allowed3(\"name\", \"version\", \"dependencies\")) {\n        Result::Err(FormatDecodeError::InvalidSyntax(\"unknown package manifest field\"))\n      } else {\n        match package_json_string(json_object_get(members, \"name\"), \"package name\") {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(name) => match package_json_string(json_object_get(members, \"version\"), \"package version\") {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(version_text) => match semver_parse(version_text) {\n              Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"package version\"))\n              Result::Ok(version) => package_manifest_finish(members, name, version)\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn package_json_output(value: JsonValue, max_bytes: U32) -> Result<Bytes, FormatEncodeError> {\n  match json_stringify_with_limits(value, 16u32, max_bytes - 1u32) {\n    Result::Ok(text) => Result::Ok(text.concat(\"\\n\").as_bytes())\n    Result::Err(_) => Result::Err(FormatEncodeError::EncodingFailed)\n  }\n}\n\npub fn package_manifest_dependency_seen(\n  dependencies: Array<PackageDependency>,\n  limit: U32,\n  name: String,\n) -> Bool {\n  if limit == 0u32 {\n    false\n  } else if dependencies.get_unchecked(limit - 1u32).name().equals(name) {\n    true\n  } else {\n    package_manifest_dependency_seen(dependencies, limit - 1u32, name)\n  }\n}\n\npub fn package_manifest_validate_dependencies(\n  dependencies: Array<PackageDependency>,\n  index: U32,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= dependencies.length() {\n    Result::Ok(package_unit())\n  } else {\n    let dependency = dependencies.get_unchecked(index)\n    let name = dependency.name()\n    if !package_name_is_valid(name) {\n      Result::Err(FormatValidationErr::InvalidField(\"dependency name\"))\n    } else if package_manifest_dependency_seen(dependencies, index, name) {\n      Result::Err(FormatValidationErr::Duplicate(name))\n    } else {\n      package_manifest_validate_dependencies(dependencies, index + 1u32)\n    }\n  }\n}\n\npub fn package_manifest_dependency_after(name: String, previous: String) -> Bool {\n  previous.byte_length() == 0u32 || package_string_compare(previous, name) is Ordering::Less\n}\n\npub fn package_manifest_min_dependency(\n  dependencies: Array<PackageDependency>,\n  index: U32,\n  previous: String,\n  best: U32,\n) -> U32 {\n  if index >= dependencies.length() {\n    best\n  } else {\n    let name = dependencies.get_unchecked(index).name()\n    let next = if package_manifest_dependency_after(name, previous) &&\n      (best >= dependencies.length() || package_string_compare(name, dependencies.get_unchecked(best).name()) is Ordering::Less) {\n      index\n    } else {\n      best\n    }\n    package_manifest_min_dependency(dependencies, index + 1u32, previous, next)\n  }\n}\n\npub fn package_manifest_encode_dependencies(\n  dependencies: Array<PackageDependency>,\n  output: Array<JsonMember>,\n  previous: String,\n  remaining: U32,\n) -> Unit {\n  if remaining == 0u32 {\n    package_unit()\n  } else {\n    let index = package_manifest_min_dependency(dependencies, 0u32, previous, dependencies.length())\n    let dependency = dependencies.get_unchecked(index)\n    let name = dependency.name()\n    output.push(json_member(name, JsonValue::String(package_requirement_to_string(dependency.requirement()))))\n    package_manifest_encode_dependencies(dependencies, output, name, remaining - 1u32)\n  }\n}\n\nimpl Encode<FormatEncodeError> for PackageManifest {\n  fn encode(self) -> Result<Bytes, FormatEncodeError> {\n    match self.validate() {\n      Result::Err(error) => Result::Err(FormatEncodeError::Validation(error))\n      Result::Ok(_) => {\n        let dependencies = json_object()\n        package_manifest_encode_dependencies(self.dependencies, dependencies, \"\", self.dependencies.length())\n        let fields = json_object()\n        fields.push(json_member(\"name\", JsonValue::String(self.name)))\n        fields.push(json_member(\"version\", JsonValue::String(self.version.to_string())))\n        fields.push(json_member(\"dependencies\", JsonValue::Object(dependencies)))\n        package_json_output(JsonValue::Object(fields), package_manifest_max_bytes())\n      }\n    }\n  }\n}\n\nimpl Decode<PackageManifest, FormatDecodeError> for PackageManifest {\n  fn decode(bytes: Bytes) -> Result<PackageManifest, FormatDecodeError> {\n    package_manifest_try_decode(bytes)\n  }\n}\n\nimpl Validate<FormatValidationErr> for PackageManifest {\n  fn validate(self) -> Result<Unit, FormatValidationErr> {\n    if !package_name_is_valid(self.name) {\n      Result::Err(FormatValidationErr::InvalidField(\"package name\"))\n    } else if self.dependencies.length() > package_max_dependencies() {\n      Result::Err(FormatValidationErr::LimitExceeded(\"dependencies\", self.dependencies.length(), package_max_dependencies()))\n    } else {\n      package_manifest_validate_dependencies(self.dependencies, 0u32)\n    }\n  }\n}\n\npub fn package_locked_from_fields(fields: Array<JsonMember>) -> Result<LockedPackage, FormatDecodeError> {\n  if !package_json_known(fields, package_allowed6(\"name\", \"version\", \"source\", \"path\", \"integrity\", \"interface\")) {\n    Result::Err(FormatDecodeError::InvalidSyntax(\"unknown locked package field\"))\n  } else {\n    match package_json_string(json_object_get(fields, \"name\"), \"locked package name\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(name) => match package_json_string(json_object_get(fields, \"version\"), \"locked package version\") {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(version_text) => match semver_parse(version_text) {\n          Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"locked package version\"))\n          Result::Ok(version) => match package_json_string(json_object_get(fields, \"source\"), \"locked package source\") {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(source) => match package_json_string(json_object_get(fields, \"path\"), \"locked package path\") {\n              Result::Err(error) => Result::Err(error)\n              Result::Ok(path) => match package_json_string(json_object_get(fields, \"integrity\"), \"locked package integrity\") {\n                Result::Err(error) => Result::Err(error)\n                Result::Ok(integrity) => match package_json_string(json_object_get(fields, \"interface\"), \"locked package interface\") {\n                  Result::Err(error) => Result::Err(error)\n                  Result::Ok(interface_) => Result::Ok(locked_package(name, version, source, path, integrity, interface_))\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn package_lock_entries(\n  entries: Array<JsonValue>,\n  index: U32,\n  output: Array<LockedPackage>,\n) -> Result<PackageLock, FormatDecodeError> {\n  if index >= entries.length() {\n    Result::Ok(package_lock(output))\n  } else {\n    match package_json_object(entries.get_unchecked(index), \"locked package\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(fields) => match package_locked_from_fields(fields) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(item) => {\n          output.push(item)\n          package_lock_entries(entries, index + 1u32, output)\n        }\n      }\n    }\n  }\n}\n\npub fn package_lock_try_decode(bytes: Bytes) -> Result<PackageLock, FormatDecodeError> {\n  match package_json_parse(bytes, package_lock_max_bytes(), 65536u32) {\n    Result::Err(error) => Result::Err(error)\n    Result::Ok(value) => match package_json_object(value, \"lockfile root\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(members) => if !package_json_known(members, package_allowed2(\"lockfileVersion\", \"packages\")) ||\n        !(json_object_get(members, \"lockfileVersion\") is Option::Some(JsonValue::Number(\"1\"))) {\n        Result::Err(FormatDecodeError::UnsupportedVersion(0u32))\n      } else {\n        match package_json_array(json_object_get(members, \"packages\"), \"lockfile packages\") {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(entries) => if entries.length() > package_lock_max_packages() {\n            Result::Err(FormatDecodeError::InvalidLength(entries.length(), package_lock_max_packages()))\n          } else {\n            package_lock_entries(entries, 0u32, Array::with_capacity(entries.length()))\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn package_lock_validate_entries(\n  packages: Array<LockedPackage>,\n  index: U32,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= packages.length() {\n    Result::Ok(package_unit())\n  } else {\n    let item = packages.get_unchecked(index)\n    let item_name = item.name()\n    let item_source = item.source()\n    let item_path = item.path()\n    let item_integrity = item.integrity()\n    let item_interface = item.interface_fingerprint()\n    if !package_name_is_valid(item_name) || !package_relative_path_is_valid(item_path) ||\n      !item_integrity.starts_with(\"sha256-\") || item_integrity.byte_length() != 71u32 ||\n      !package_is_hex(item_integrity.slice(7u32, 71u32), 64u32) || !package_is_hex(item_interface, 64u32) ||\n      item_source.byte_length() == 0u32 || item_source.byte_length() > package_requirement_max_bytes() {\n      Result::Err(FormatValidationErr::InvalidField(\"locked package\"))\n    } else {\n      let duplicate = while 0u32 {\n        earlier if earlier < index => if packages.get_unchecked(earlier).name().equals(item_name) {\n          break true\n        } else {\n          continue earlier + 1u32\n        }\n        _ => break false\n      }\n      if duplicate {\n        Result::Err(FormatValidationErr::Duplicate(item_name))\n      } else {\n        package_lock_validate_entries(packages, index + 1u32)\n      }\n    }\n  }\n}\n\nimpl Encode<FormatEncodeError> for PackageLock {\n  fn encode(self) -> Result<Bytes, FormatEncodeError> {\n    match self.validate() {\n      Result::Err(error) => Result::Err(FormatEncodeError::Validation(error))\n      Result::Ok(_) => {\n        let entries = json_array()\n        while 0u32 {\n          index if index < self.packages.length() => {\n            let item = self.packages.get_unchecked(index)\n            let item_name = item.name()\n            let item_version = item.version()\n            let item_source = item.source()\n            let item_path = item.path()\n            let item_integrity = item.integrity()\n            let item_interface = item.interface_fingerprint()\n            let fields = json_object()\n            fields.push(json_member(\"name\", JsonValue::String(item_name)))\n            fields.push(json_member(\"version\", JsonValue::String(item_version.to_string())))\n            fields.push(json_member(\"source\", JsonValue::String(item_source)))\n            fields.push(json_member(\"path\", JsonValue::String(item_path)))\n            fields.push(json_member(\"integrity\", JsonValue::String(item_integrity)))\n            fields.push(json_member(\"interface\", JsonValue::String(item_interface)))\n            entries.push(JsonValue::Object(fields))\n            continue index + 1u32\n          }\n          _ => break package_unit()\n        }\n        let fields = json_object()\n        fields.push(json_member(\"lockfileVersion\", JsonValue::Number(\"1\")))\n        fields.push(json_member(\"packages\", JsonValue::Array(entries)))\n        package_json_output(JsonValue::Object(fields), package_lock_max_bytes())\n      }\n    }\n  }\n}\n\nimpl Decode<PackageLock, FormatDecodeError> for PackageLock {\n  fn decode(bytes: Bytes) -> Result<PackageLock, FormatDecodeError> {\n    package_lock_try_decode(bytes)\n  }\n}\n\nimpl Validate<FormatValidationErr> for PackageLock {\n  fn validate(self) -> Result<Unit, FormatValidationErr> {\n    if self.packages.length() > package_lock_max_packages() {\n      Result::Err(FormatValidationErr::LimitExceeded(\"locked packages\", self.packages.length(), package_lock_max_packages()))\n    } else {\n      package_lock_validate_entries(self.packages, 0u32)\n    }\n  }\n}\n\npub fn module_manifest_files(\n  values: Array<JsonValue>,\n  index: U32,\n  output: Array<String>,\n) -> Result<Array<String>, FormatDecodeError> {\n  if index >= values.length() {\n    Result::Ok(output)\n  } else {\n    match values.get_unchecked(index) {\n      JsonValue::String(path) => {\n        output.push(path)\n        module_manifest_files(values, index + 1u32, output)\n      }\n      JsonValue::ValidatedString(path) => {\n        output.push(path.string())\n        module_manifest_files(values, index + 1u32, output)\n      }\n      _ => Result::Err(FormatDecodeError::InvalidSyntax(\"module file path\"))\n    }\n  }\n}\n\npub fn module_manifest_modules(\n  entries: Array<JsonValue>,\n  index: U32,\n  output: Array<ModuleManifestEntry>,\n) -> Result<Array<ModuleManifestEntry>, FormatDecodeError> {\n  if index >= entries.length() {\n    Result::Ok(output)\n  } else {\n    match package_json_object(entries.get_unchecked(index), \"module\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(fields) => if !package_json_known(fields, package_allowed2(\"name\", \"files\")) {\n        Result::Err(FormatDecodeError::InvalidSyntax(\"unknown module field\"))\n      } else {\n        match package_json_string(json_object_get(fields, \"name\"), \"module name\") {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(name) => match package_json_array(json_object_get(fields, \"files\"), \"module files\") {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(files) => if files.length() > module_manifest_max_files_per_module() {\n              Result::Err(FormatDecodeError::InvalidLength(files.length(), module_manifest_max_files_per_module()))\n            } else {\n              match module_manifest_files(files, 0u32, Array::with_capacity(files.length())) {\n                Result::Err(error) => Result::Err(error)\n                Result::Ok(paths) => {\n                  output.push(module_manifest_entry(name, paths))\n                  module_manifest_modules(entries, index + 1u32, output)\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn module_manifest_try_decode(bytes: Bytes) -> Result<ModuleManifest, FormatDecodeError> {\n  match package_json_parse(bytes, module_manifest_max_bytes(), 131072u32) {\n    Result::Err(error) => Result::Err(error)\n    Result::Ok(value) => match package_json_object(value, \"module manifest root\") {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(members) => if !package_json_known(members, package_allowed2(\"root\", \"modules\")) {\n        Result::Err(FormatDecodeError::InvalidSyntax(\"unknown module manifest field\"))\n      } else {\n        match package_json_string(json_object_get(members, \"root\"), \"root module\") {\n          Result::Err(error) => Result::Err(error)\n          Result::Ok(root) => match package_json_array(json_object_get(members, \"modules\"), \"modules\") {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(entries) => if entries.length() > module_manifest_max_modules() {\n              Result::Err(FormatDecodeError::InvalidLength(entries.length(), module_manifest_max_modules()))\n            } else {\n              match module_manifest_modules(entries, 0u32, Array::with_capacity(entries.length())) {\n                Result::Err(error) => Result::Err(error)\n                Result::Ok(modules) => Result::Ok(module_manifest(root, modules))\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn module_name_is_valid(name: String) -> Bool {\n  if name.byte_length() == 0u32 || name.byte_length() > package_name_max_bytes() || name.byte_at(0u32) == 46u8 || name.ends_with(\".\") {\n    false\n  } else {\n    while 0u32 {\n      index if index < name.byte_length() => {\n        let byte = name.byte_at(index)\n        if (byte >= 97u8 && byte <= 122u8) || (byte >= 48u8 && byte <= 57u8) || byte == 95u8 || byte == 46u8 {\n          continue index + 1u32\n        } else {\n          break false\n        }\n      }\n      _ => break !name.contains(\"..\")\n    }\n  }\n}\n\npub fn module_manifest_name_seen(\n  modules: Array<ModuleManifestEntry>,\n  limit: U32,\n  name: String,\n) -> Bool {\n  if limit == 0u32 {\n    false\n  } else if modules.get_unchecked(limit - 1u32).name().equals(name) {\n    true\n  } else {\n    module_manifest_name_seen(modules, limit - 1u32, name)\n  }\n}\n\npub fn module_manifest_file_seen(files: Array<String>, limit: U32, path: String) -> Bool {\n  if limit == 0u32 {\n    false\n  } else if files.get_unchecked(limit - 1u32).equals(path) {\n    true\n  } else {\n    module_manifest_file_seen(files, limit - 1u32, path)\n  }\n}\n\npub fn module_manifest_validate_files(\n  files: Array<String>,\n  index: U32,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= files.length() {\n    Result::Ok(package_unit())\n  } else {\n    let path = files.get_unchecked(index)\n    if !package_relative_path_is_valid(path) || !path.ends_with(\".dew\") {\n      Result::Err(FormatValidationErr::InvalidField(\"module file path\"))\n    } else if module_manifest_file_seen(files, index, path) {\n      Result::Err(FormatValidationErr::Duplicate(path))\n    } else {\n      module_manifest_validate_files(files, index + 1u32)\n    }\n  }\n}\n\npub fn module_manifest_validate_modules(\n  modules: Array<ModuleManifestEntry>,\n  index: U32,\n  root: String,\n  root_found: Bool,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= modules.length() {\n    if root_found {\n      Result::Ok(package_unit())\n    } else {\n      Result::Err(FormatValidationErr::MissingField(\"root module entry\"))\n    }\n  } else {\n    let module_ = modules.get_unchecked(index)\n    let name = module_.name()\n    let files = module_.files()\n    if !module_name_is_valid(name) || files.length() == 0u32 || files.length() > module_manifest_max_files_per_module() {\n      Result::Err(FormatValidationErr::InvalidField(\"module\"))\n    } else if module_manifest_name_seen(modules, index, name) {\n      Result::Err(FormatValidationErr::Duplicate(name))\n    } else {\n      match module_manifest_validate_files(files, 0u32) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(_) => module_manifest_validate_modules(\n          modules,\n          index + 1u32,\n          root,\n          root_found || name.equals(root),\n        )\n      }\n    }\n  }\n}\n\nimpl Encode<FormatEncodeError> for ModuleManifest {\n  fn encode(self) -> Result<Bytes, FormatEncodeError> {\n    match self.validate() {\n      Result::Err(error) => Result::Err(FormatEncodeError::Validation(error))\n      Result::Ok(_) => {\n        let entries = json_array()\n        while 0u32 {\n          index if index < self.modules.length() => {\n            let module_ = self.modules.get_unchecked(index)\n            let module_files = module_.files()\n            let files = json_array()\n            while 0u32 {\n              file_index if file_index < module_files.length() => {\n                files.push(JsonValue::String(module_files.get_unchecked(file_index)))\n                continue file_index + 1u32\n              }\n              _ => break package_unit()\n            }\n            let fields = json_object()\n            fields.push(json_member(\"name\", JsonValue::String(module_.name)))\n            fields.push(json_member(\"files\", JsonValue::Array(files)))\n            entries.push(JsonValue::Object(fields))\n            continue index + 1u32\n          }\n          _ => break package_unit()\n        }\n        let fields = json_object()\n        fields.push(json_member(\"root\", JsonValue::String(self.root)))\n        fields.push(json_member(\"modules\", JsonValue::Array(entries)))\n        package_json_output(JsonValue::Object(fields), module_manifest_max_bytes())\n      }\n    }\n  }\n}\n\nimpl Decode<ModuleManifest, FormatDecodeError> for ModuleManifest {\n  fn decode(bytes: Bytes) -> Result<ModuleManifest, FormatDecodeError> {\n    module_manifest_try_decode(bytes)\n  }\n}\n\nimpl Validate<FormatValidationErr> for ModuleManifest {\n  fn validate(self) -> Result<Unit, FormatValidationErr> {\n    if !module_name_is_valid(self.root) {\n      Result::Err(FormatValidationErr::InvalidField(\"root module\"))\n    } else if self.modules.length() == 0u32 || self.modules.length() > module_manifest_max_modules() {\n      Result::Err(FormatValidationErr::LimitExceeded(\"modules\", self.modules.length(), module_manifest_max_modules()))\n    } else {\n      module_manifest_validate_modules(self.modules, 0u32, self.root, false)\n    }\n  }\n}\n"
}

///|
pub fn standard_package_artifact_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bytes\nopen dew.std.bytes_builder\nopen dew.std.decode\nopen dew.std.encode\nopen dew.std.fixed_array\nopen dew.std.format\nopen dew.std.integrity.sha256\nopen dew.std.package\nopen dew.std.semver\nopen dew.std.string\n\npub struct PackageArtifactFile {\n  path: String\n  contents: Bytes\n}\n\npub struct PackageArtifact {\n  name: String\n  version: SemVer\n  source: String\n  integrity: String\n  interface_fingerprint: String\n  dependencies: Array<PackageDependency>\n  files: Array<PackageArtifactFile>\n}\n\npub struct PackageArtifactReader {\n  bytes: Bytes\n  mut offset: U32\n  mut failed: Bool\n}\n\npub fn package_artifact_max_bytes() -> U32 {\n  268435456u32\n}\n\npub fn package_artifact_max_source_bytes() -> U32 {\n  16777216u32\n}\n\npub fn package_artifact_max_files() -> U32 {\n  65536u32\n}\n\npub fn package_artifact_file(path: String, contents: Bytes) -> PackageArtifactFile {\n  PackageArtifactFile::{\n    path: path\n    contents: contents\n  }\n}\n\nimpl PackageArtifactFile {\n  fn path(self) -> String {\n    self.path\n  }\n  fn contents(self) -> Bytes {\n    self.contents\n  }\n}\n\npub fn package_artifact(\n  name: String,\n  version: SemVer,\n  source: String,\n  integrity: String,\n  interface_fingerprint: String,\n  dependencies: Array<PackageDependency>,\n  files: Array<PackageArtifactFile>,\n) -> PackageArtifact {\n  PackageArtifact::{\n    name: name\n    version: version\n    source: source\n    integrity: integrity\n    interface_fingerprint: interface_fingerprint\n    dependencies: dependencies\n    files: files\n  }\n}\n\nimpl PackageArtifact {\n  fn name(self) -> String {\n    self.name\n  }\n  fn version(self) -> SemVer {\n    self.version\n  }\n  fn source(self) -> String {\n    self.source\n  }\n  fn integrity(self) -> String {\n    self.integrity\n  }\n  fn interface_fingerprint(self) -> String {\n    self.interface_fingerprint\n  }\n  fn dependencies(self) -> Array<PackageDependency> {\n    self.dependencies\n  }\n  fn files(self) -> Array<PackageArtifactFile> {\n    self.files\n  }\n}\n\npub fn package_artifact_unit() -> Unit {\n}\n\npub fn package_artifact_u32_to_u8(value: U32) -> U8 {\n  value.into()\n}\n\npub fn package_artifact_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn package_artifact_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn package_artifact_write_u32(output: BytesBuilder, value: U32) -> Unit {\n  output.append_byte(package_artifact_u32_to_u8(value & 255u32))\n  output.append_byte(package_artifact_u32_to_u8((value >> 8u32) & 255u32))\n  output.append_byte(package_artifact_u32_to_u8((value >> 16u32) & 255u32))\n  output.append_byte(package_artifact_u32_to_u8((value >> 24u32) & 255u32))\n}\n\npub fn package_artifact_write_bytes(output: BytesBuilder, value: Bytes) -> Unit {\n  package_artifact_write_u32(output, value.byte_length())\n  output.append(value)\n}\n\npub fn package_artifact_write_string(output: BytesBuilder, value: String) -> Unit {\n  package_artifact_write_bytes(output, value.as_bytes())\n}\n\npub fn package_artifact_read_u32(reader: PackageArtifactReader) -> U32 {\n  if reader.failed || reader.offset > reader.bytes.byte_length() || reader.bytes.byte_length() - reader.offset < 4u32 {\n    reader.failed = true\n    0u32\n  } else {\n    let offset = reader.offset\n    reader.offset = offset + 4u32\n    let first = package_artifact_u8_to_u32(reader.bytes.byte_at(offset))\n    let second = package_artifact_u8_to_u32(reader.bytes.byte_at(offset + 1u32))\n    let third = package_artifact_u8_to_u32(reader.bytes.byte_at(offset + 2u32))\n    let fourth = package_artifact_u8_to_u32(reader.bytes.byte_at(offset + 3u32))\n    first | (second << 8u32) | (third << 16u32) | (fourth << 24u32)\n  }\n}\n\npub fn package_artifact_read_bytes(reader: PackageArtifactReader, limit: U32) -> Bytes {\n  let length = package_artifact_read_u32(reader)\n  if reader.failed || length > limit || reader.offset > reader.bytes.byte_length() || length > reader.bytes.byte_length() - reader.offset {\n    reader.failed = true\n    b\"\"\n  } else {\n    let start = reader.offset\n    reader.offset = start + length\n    reader.bytes.slice(start, start + length)\n  }\n}\n\npub fn package_artifact_read_string(reader: PackageArtifactReader, limit: U32) -> String {\n  let value = package_artifact_read_bytes(reader, limit)\n  if reader.failed || !value.is_valid_utf8() {\n    reader.failed = true\n    \"\"\n  } else {\n    value.to_string()\n  }\n}\n\npub fn package_artifact_digest_matches(payload: Bytes, encoded: Bytes) -> Bool {\n  let digest = sha256(payload)\n  while 0u32 {\n    index if index < 32u32 => if encoded.byte_at(payload.byte_length() + index) == digest.get_unchecked(index) {\n      continue index + 1u32\n    } else {\n      break false\n    }\n    _ => break true\n  }\n}\n\npub fn package_artifact_is_hex(value: String, length: U32) -> Bool {\n  if value.byte_length() != length {\n    false\n  } else {\n    while 0u32 {\n      index if index < length => {\n        let byte = value.byte_at(index)\n        if (byte >= 48u8 && byte <= 57u8) || (byte >= 97u8 && byte <= 102u8) {\n          continue index + 1u32\n        } else {\n          break false\n        }\n      }\n      _ => break true\n    }\n  }\n}\n\npub fn package_artifact_path_is_valid(value: String) -> Bool {\n  value.byte_length() > 0u32 &&\n  value.byte_length() <= package_path_max_bytes() &&\n  value.byte_at(0u32) != 47u8 &&\n  !value.contains(\"\\\\\") &&\n  !value.contains(\"\\x00\") &&\n  !value.equals(\"..\") &&\n  !value.starts_with(\"../\") &&\n  !value.contains(\"/../\") &&\n  !value.ends_with(\"/..\")\n}\n\npub fn package_artifact_read_dependencies(\n  reader: PackageArtifactReader,\n  count: U32,\n  index: U32,\n  output: Array<PackageDependency>,\n) -> Result<Array<PackageDependency>, FormatDecodeError> {\n  if index >= count {\n    Result::Ok(output)\n  } else {\n    let name = package_artifact_read_string(reader, package_name_max_bytes())\n    let requirement_text = package_artifact_read_string(reader, package_requirement_max_bytes())\n    if reader.failed {\n      Result::Err(FormatDecodeError::UnexpectedEnd(reader.offset))\n    } else {\n      match package_requirement_parse(requirement_text) {\n        Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"package artifact dependency\"))\n        Result::Ok(requirement) => {\n          output.push(package_dependency(name, requirement))\n          package_artifact_read_dependencies(reader, count, index + 1u32, output)\n        }\n      }\n    }\n  }\n}\n\npub fn package_artifact_read_files(\n  reader: PackageArtifactReader,\n  count: U32,\n  index: U32,\n  output: Array<PackageArtifactFile>,\n) -> Result<Array<PackageArtifactFile>, FormatDecodeError> {\n  if index >= count {\n    Result::Ok(output)\n  } else {\n    let path = package_artifact_read_string(reader, package_path_max_bytes())\n    let contents = package_artifact_read_bytes(reader, package_artifact_max_source_bytes())\n    if reader.failed {\n      Result::Err(FormatDecodeError::UnexpectedEnd(reader.offset))\n    } else {\n      output.push(package_artifact_file(path, contents))\n      package_artifact_read_files(reader, count, index + 1u32, output)\n    }\n  }\n}\n\npub fn package_artifact_finish_decode(\n  payload: Bytes,\n  reader: PackageArtifactReader,\n  name: String,\n  version: SemVer,\n  source: String,\n  integrity: String,\n  interface_: String,\n) -> Result<PackageArtifact, FormatDecodeError> {\n  let dependency_count = package_artifact_read_u32(reader)\n  if dependency_count > package_max_dependencies() {\n    Result::Err(FormatDecodeError::InvalidLength(dependency_count, package_max_dependencies()))\n  } else {\n    match package_artifact_read_dependencies(reader, dependency_count, 0u32, Array::with_capacity(dependency_count)) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(dependencies) => {\n        let file_count = package_artifact_read_u32(reader)\n        if file_count > package_artifact_max_files() {\n          Result::Err(FormatDecodeError::InvalidLength(file_count, package_artifact_max_files()))\n        } else {\n          match package_artifact_read_files(reader, file_count, 0u32, Array::with_capacity(file_count)) {\n            Result::Err(error) => Result::Err(error)\n            Result::Ok(files) => if reader.failed {\n              Result::Err(FormatDecodeError::UnexpectedEnd(reader.offset))\n            } else if reader.offset != payload.byte_length() {\n              Result::Err(FormatDecodeError::TrailingData(reader.offset))\n            } else {\n              Result::Ok(package_artifact(name, version, source, integrity, interface_, dependencies, files))\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn package_artifact_try_decode(bytes: Bytes) -> Result<PackageArtifact, FormatDecodeError> {\n  let length = bytes.byte_length()\n  if length > package_artifact_max_bytes() {\n    Result::Err(FormatDecodeError::FileTooLarge(length, package_artifact_max_bytes()))\n  } else if length < 40u32 || !bytes.subarray(0u32, 8u32).equals(b\"DEWPKG1\\x00\") {\n    Result::Err(FormatDecodeError::InvalidSyntax(\"package artifact magic\"))\n  } else {\n    let payload = bytes.slice(0u32, length - 32u32)\n    if !package_artifact_digest_matches(payload, bytes) {\n      Result::Err(FormatDecodeError::ChecksumMismatch)\n    } else {\n      let reader = PackageArtifactReader::{\n        bytes: payload\n        offset: 8u32\n        failed: false\n      }\n      let name = package_artifact_read_string(reader, package_name_max_bytes())\n      let version_text = package_artifact_read_string(reader, semver_max_bytes())\n      let source = package_artifact_read_string(reader, package_requirement_max_bytes())\n      let integrity = package_artifact_read_string(reader, 71u32)\n      let interface_ = package_artifact_read_string(reader, 64u32)\n      if reader.failed {\n        Result::Err(FormatDecodeError::UnexpectedEnd(reader.offset))\n      } else {\n        match semver_parse(version_text) {\n          Result::Err(_) => Result::Err(FormatDecodeError::InvalidSyntax(\"package artifact version\"))\n          Result::Ok(version) => package_artifact_finish_decode(\n            payload, reader, name, version, source, integrity, interface_,\n          )\n        }\n      }\n    }\n  }\n}\n\npub fn package_artifact_dependency_size(\n  values: Array<PackageDependency>,\n  index: U32,\n) -> U64 {\n  if index >= values.length() {\n    0u64\n  } else {\n    let dependency = values.get_unchecked(index)\n    8u64 + package_artifact_u32_to_u64(dependency.name().byte_length()) +\n    package_artifact_u32_to_u64(package_requirement_to_string(dependency.requirement()).byte_length()) +\n    package_artifact_dependency_size(values, index + 1u32)\n  }\n}\n\npub fn package_artifact_file_size(\n  values: Array<PackageArtifactFile>,\n  index: U32,\n) -> U64 {\n  if index >= values.length() {\n    0u64\n  } else {\n    let file = values.get_unchecked(index)\n    8u64 + package_artifact_u32_to_u64(file.path().byte_length()) +\n    package_artifact_u32_to_u64(file.contents().byte_length()) +\n    package_artifact_file_size(values, index + 1u32)\n  }\n}\n\npub fn package_artifact_encoded_size(value: PackageArtifact) -> U64 {\n  68u64 + package_artifact_u32_to_u64(value.name.byte_length()) +\n  package_artifact_u32_to_u64(value.version.to_string().byte_length()) +\n  package_artifact_u32_to_u64(value.source.byte_length()) +\n  package_artifact_u32_to_u64(value.integrity.byte_length()) +\n  package_artifact_u32_to_u64(value.interface_fingerprint.byte_length()) +\n  package_artifact_dependency_size(value.dependencies, 0u32) +\n  package_artifact_file_size(value.files, 0u32)\n}\n\npub fn package_artifact_dependency_seen(\n  values: Array<PackageDependency>,\n  limit: U32,\n  name: String,\n) -> Bool {\n  if limit == 0u32 {\n    false\n  } else if values.get_unchecked(limit - 1u32).name().equals(name) {\n    true\n  } else {\n    package_artifact_dependency_seen(values, limit - 1u32, name)\n  }\n}\n\npub fn package_artifact_validate_dependencies(\n  values: Array<PackageDependency>,\n  index: U32,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= values.length() {\n    Result::Ok(package_artifact_unit())\n  } else {\n    let name = values.get_unchecked(index).name()\n    if !package_name_is_valid(name) {\n      Result::Err(FormatValidationErr::InvalidField(\"artifact dependency\"))\n    } else if package_artifact_dependency_seen(values, index, name) {\n      Result::Err(FormatValidationErr::Duplicate(name))\n    } else {\n      package_artifact_validate_dependencies(values, index + 1u32)\n    }\n  }\n}\n\npub fn package_artifact_file_seen(\n  values: Array<PackageArtifactFile>,\n  limit: U32,\n  path: String,\n) -> Bool {\n  if limit == 0u32 {\n    false\n  } else if values.get_unchecked(limit - 1u32).path().equals(path) {\n    true\n  } else {\n    package_artifact_file_seen(values, limit - 1u32, path)\n  }\n}\n\npub fn package_artifact_validate_files(\n  values: Array<PackageArtifactFile>,\n  index: U32,\n) -> Result<Unit, FormatValidationErr> {\n  if index >= values.length() {\n    Result::Ok(package_artifact_unit())\n  } else {\n    let file = values.get_unchecked(index)\n    let path = file.path()\n    if !package_artifact_path_is_valid(path) || file.contents().byte_length() > package_artifact_max_source_bytes() {\n      Result::Err(FormatValidationErr::InvalidField(\"artifact file\"))\n    } else if package_artifact_file_seen(values, index, path) {\n      Result::Err(FormatValidationErr::Duplicate(path))\n    } else {\n      package_artifact_validate_files(values, index + 1u32)\n    }\n  }\n}\n\nimpl Encode<FormatEncodeError> for PackageArtifact {\n  fn encode(self) -> Result<Bytes, FormatEncodeError> {\n    match self.validate() {\n      Result::Err(error) => Result::Err(FormatEncodeError::Validation(error))\n      Result::Ok(_) => {\n        let output = BytesBuilder::new()\n        output.append(b\"DEWPKG1\\x00\")\n        package_artifact_write_string(output, self.name)\n        package_artifact_write_string(output, self.version.to_string())\n        package_artifact_write_string(output, self.source)\n        package_artifact_write_string(output, self.integrity)\n        package_artifact_write_string(output, self.interface_fingerprint)\n        package_artifact_write_u32(output, self.dependencies.length())\n        while 0u32 {\n          index if index < self.dependencies.length() => {\n            let dependency = self.dependencies.get_unchecked(index)\n            package_artifact_write_string(output, dependency.name())\n            package_artifact_write_string(output, package_requirement_to_string(dependency.requirement()))\n            continue index + 1u32\n          }\n          _ => break package_artifact_unit()\n        }\n        package_artifact_write_u32(output, self.files.length())\n        while 0u32 {\n          index if index < self.files.length() => {\n            let file = self.files.get_unchecked(index)\n            package_artifact_write_string(output, file.path())\n            package_artifact_write_bytes(output, file.contents())\n            continue index + 1u32\n          }\n          _ => break package_artifact_unit()\n        }\n        let payload = output.finish()\n        let complete = BytesBuilder::with_capacity(payload.byte_length() + 32u32)\n        complete.append(payload)\n        let digest = sha256(payload)\n        while 0u32 {\n          index if index < 32u32 => {\n            complete.append_byte(digest.get_unchecked(index))\n            continue index + 1u32\n          }\n          _ => break package_artifact_unit()\n        }\n        Result::Ok(complete.finish())\n      }\n    }\n  }\n}\n\nimpl Decode<PackageArtifact, FormatDecodeError> for PackageArtifact {\n  fn decode(bytes: Bytes) -> Result<PackageArtifact, FormatDecodeError> {\n    package_artifact_try_decode(bytes)\n  }\n}\n\nimpl Validate<FormatValidationErr> for PackageArtifact {\n  fn validate(self) -> Result<Unit, FormatValidationErr> {\n    if !package_name_is_valid(self.name) || self.source.byte_length() == 0u32 ||\n      self.source.byte_length() > package_requirement_max_bytes() ||\n      !self.integrity.starts_with(\"sha256-\") || self.integrity.byte_length() != 71u32 ||\n      !package_artifact_is_hex(self.integrity.slice(7u32, 71u32), 64u32) ||\n      !package_artifact_is_hex(self.interface_fingerprint, 64u32) {\n      Result::Err(FormatValidationErr::InvalidField(\"package artifact provenance\"))\n    } else if package_artifact_encoded_size(self) > 268435456u64 {\n      Result::Err(FormatValidationErr::ByteLimitExceeded(\"package artifact bytes\", package_artifact_encoded_size(self), 268435456u64))\n    } else if self.dependencies.length() > package_max_dependencies() {\n      Result::Err(FormatValidationErr::LimitExceeded(\"artifact dependencies\", self.dependencies.length(), package_max_dependencies()))\n    } else if self.files.length() == 0u32 || self.files.length() > package_artifact_max_files() {\n      Result::Err(FormatValidationErr::LimitExceeded(\"artifact files\", self.files.length(), package_artifact_max_files()))\n    } else {\n      match package_artifact_validate_dependencies(self.dependencies, 0u32) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(_) => package_artifact_validate_files(self.files, 0u32)\n      }\n    }\n  }\n}\n"
}

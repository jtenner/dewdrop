///|
pub fn standard_json_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.bloom_filter\nopen dew.std.bytes\nopen dew.std.fixed_array\nopen dew.std.io\nopen dew.std.string\nopen dew.std.string_builder\nopen dew.std.wasm.intrinsics\n\npub enum JsonValue {\n  Null\n  Bool(Bool)\n  Number(String)\n  ValidatedNumber(JsonNumber)\n  String(String)\n  ValidatedString(JsonString)\n  Array(Array<JsonValue>)\n  Object(Array<JsonMember>)\n}\n\npub struct JsonMember {\n  key: String\n  value: JsonValue\n}\n\npub struct JsonNumber {\n  lexeme: String\n}\n\npub struct JsonString {\n  value: String\n  needs_escape: Bool\n}\n\npub struct ParsedJsonString {\n  value: String\n  needs_escape: Bool\n}\n\npub struct JsonLimits {\n  max_input_bytes: U32\n  max_depth: U32\n  max_values: U32\n  max_string_bytes: U32\n}\n\npub struct JsonDocument {\n  source: String\n  value: JsonValue\n}\n\npub struct JsonRawDocument {\n  source: String\n}\n\n\npub enum JsonParseError {\n  InputLimitExceeded(U32)\n  DepthLimitExceeded(U32)\n  ValueLimitExceeded(U32)\n  StringLimitExceeded(U32)\n  InvalidUtf8\n  UnexpectedEnd(U32)\n  UnexpectedByte(U32, U8)\n  InvalidLiteral(U32)\n  InvalidNumber(U32)\n  InvalidEscape(U32)\n  InvalidUnicodeEscape(U32)\n  DuplicateObjectKey(U32, String)\n  TrailingData(U32)\n}\n\npub enum JsonWriteError {\n  DepthLimitExceeded\n  ByteLimitExceeded\n  InvalidNumber(String)\n  DuplicateObjectKey(String)\n}\n\npub enum JsonReadError {\n  Io(IoError)\n  Parse(JsonParseError)\n}\n\npub enum JsonOutputError {\n  Io(IoError)\n  Write(JsonWriteError)\n}\n\npub struct JsonParser {\n  input: Bytes\n  source: String\n  state: FixedArray<U32>\n  limits: JsonLimits\n  compact_tokens: Bool\n  validated_numbers: Bool\n  validated_strings: Bool\n}\n\npub struct JsonWriter {\n  builder: StringBuilder\n  max_depth: U32\n  max_bytes: U32\n  error: FixedArray<U32>\n  error_payload: FixedArray<String>\n}\n\npub builtin json_bytes_to_string_unchecked(value: Bytes) -> String = \"ref.cast\"\n\npub fn json_unit() -> Unit {}\n\npub fn json_default_limits() -> JsonLimits {\n  JsonLimits::{\n    max_input_bytes: 16777216u32\n    max_depth: 128u32\n    max_values: 1048576u32\n    max_string_bytes: 16777216u32\n  }\n}\n\npub fn json_parser_offset(parser: JsonParser) -> U32 {\n  parser.state.get_unchecked(0u32)\n}\n\npub fn json_parser_set_offset(parser: JsonParser, offset: U32) -> Unit {\n  parser.state.set_unchecked(0u32, offset)\n}\n\npub fn json_parser_value_count(parser: JsonParser) -> U32 {\n  parser.state.get_unchecked(1u32)\n}\n\npub fn json_parser_set_value_count(parser: JsonParser, count: U32) -> Unit {\n  parser.state.set_unchecked(1u32, count)\n}\n\npub fn json_is_whitespace(byte: U8) -> Bool {\n  byte == 32u8 || byte == 9u8 || byte == 10u8 || byte == 13u8\n}\n\npub fn json_first_mask_lane(mask: U32) -> U32 {\n  wasm_u32_ctz(mask)\n}\n\npub fn json_skip_whitespace_simd(value: Bytes, start: U32) -> U32 {\n  let length = value.byte_length()\n  let mut index = start\n  while index {\n    current if current + 16u32 <= length => {\n      let vector = wasm_bytes_load_u8x16(value, current)\n      let whitespace = wasm_u8x16_or(\n        wasm_u8x16_or(\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(32u8)),\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(9u8)),\n        ),\n        wasm_u8x16_or(\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(10u8)),\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(13u8)),\n        ),\n      )\n      let non_whitespace = wasm_u8x16_bitmask(whitespace) ^ 65535u32\n      if non_whitespace == 0u32 {\n        continue current + 16u32\n      } else {\n        break current + json_first_mask_lane(non_whitespace)\n      }\n    }\n    current => {\n      if current < length && json_is_whitespace(value.byte_at(current)) {\n        continue current + 1u32\n      } else {\n        break current\n      }\n    }\n  }\n}\n\npub fn json_scan_string_special_simd(value: String, start: U32) -> U32 {\n  let length = value.byte_length()\n  let mut index = start\n  while index {\n    current if current + 16u32 <= length => {\n      let vector = wasm_string_load_u8x16(value, current)\n      let specials = wasm_u8x16_or(\n        wasm_u8x16_lt_u(vector, wasm_u8x16_splat(32u8)),\n        wasm_u8x16_or(\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(34u8)),\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(92u8)),\n        ),\n      )\n      let mask = wasm_u8x16_bitmask(specials)\n      if mask == 0u32 {\n        continue current + 16u32\n      } else {\n        break current + json_first_mask_lane(mask)\n      }\n    }\n    current => {\n      if current >= length {\n        break current\n      } else {\n        let byte = value.byte_at(current)\n        if byte < 32u8 || byte == 34u8 || byte == 92u8 {\n          break current\n        } else {\n          continue current + 1u32\n        }\n      }\n    }\n  }\n}\n\npub fn json_scan_bytes_string_special_simd(value: Bytes, start: U32) -> U32 {\n  let length = value.byte_length()\n  let mut index = start\n  while index {\n    current if current + 16u32 <= length => {\n      let vector = wasm_bytes_load_u8x16(value, current)\n      let specials = wasm_u8x16_or(\n        wasm_u8x16_lt_u(vector, wasm_u8x16_splat(32u8)),\n        wasm_u8x16_or(\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(34u8)),\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(92u8)),\n        ),\n      )\n      let mask = wasm_u8x16_bitmask(specials)\n      if mask == 0u32 {\n        continue current + 16u32\n      } else {\n        break current + json_first_mask_lane(mask)\n      }\n    }\n    current => {\n      if current >= length {\n        break current\n      } else {\n        let byte = value.byte_at(current)\n        if byte < 32u8 || byte == 34u8 || byte == 92u8 {\n          break current\n        } else {\n          continue current + 1u32\n        }\n      }\n    }\n  }\n}\n\npub fn json_is_scalar_terminator(byte: U8) -> Bool {\n  json_is_whitespace(byte) || byte == 44u8 || byte == 93u8 || byte == 125u8\n}\n\npub fn json_scan_scalar_end_simd(value: Bytes, start: U32) -> U32 {\n  let length = value.byte_length()\n  let mut index = start\n  while index {\n    current if current + 16u32 <= length => {\n      let vector = wasm_bytes_load_u8x16(value, current)\n      let terminators = wasm_u8x16_or(\n        wasm_u8x16_or(\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(32u8)),\n          wasm_u8x16_eq(vector, wasm_u8x16_splat(9u8)),\n        ),\n        wasm_u8x16_or(\n          wasm_u8x16_or(\n            wasm_u8x16_eq(vector, wasm_u8x16_splat(10u8)),\n            wasm_u8x16_eq(vector, wasm_u8x16_splat(13u8)),\n          ),\n          wasm_u8x16_or(\n            wasm_u8x16_eq(vector, wasm_u8x16_splat(44u8)),\n            wasm_u8x16_or(\n              wasm_u8x16_eq(vector, wasm_u8x16_splat(93u8)),\n              wasm_u8x16_eq(vector, wasm_u8x16_splat(125u8)),\n            ),\n          ),\n        ),\n      )\n      let mask = wasm_u8x16_bitmask(terminators)\n      if mask == 0u32 {\n        continue current + 16u32\n      } else {\n        break current + json_first_mask_lane(mask)\n      }\n    }\n    current => {\n      if current < length && json_is_scalar_terminator(value.byte_at(current)) == false {\n        continue current + 1u32\n      } else {\n        break current\n      }\n    }\n  }\n}\n\npub fn json_parser_skip_whitespace(parser: JsonParser) -> Unit {\n  json_parser_set_offset(\n    parser,\n    json_skip_whitespace_simd(parser.input, json_parser_offset(parser)),\n  )\n}\n\npub fn json_is_digit(byte: U8) -> Bool {\n  byte >= 48u8 && byte <= 57u8\n}\n\npub fn json_is_nonzero_digit(byte: U8) -> Bool {\n  byte >= 49u8 && byte <= 57u8\n}\n\npub fn json_digit_run_end(value: Bytes, start: U32, end: U32) -> U32 {\n  while start {\n    index if index < end && json_is_digit(value.byte_at(index)) => continue index + 1u32\n    index => break index\n  }\n}\n\npub fn json_number_after_integer(\n  value: Bytes,\n  start: U32,\n  end: U32,\n) -> Option<U32> {\n  if start >= end {\n    Option::None\n  } else if value.byte_at(start) == 48u8 {\n    if start + 1u32 < end && json_is_digit(value.byte_at(start + 1u32)) {\n      Option::None\n    } else {\n      Option::Some(start + 1u32)\n    }\n  } else if json_is_nonzero_digit(value.byte_at(start)) {\n    Option::Some(json_digit_run_end(value, start + 1u32, end))\n  } else {\n    Option::None\n  }\n}\n\npub fn json_number_after_fraction(\n  value: Bytes,\n  start: U32,\n  end: U32,\n) -> Option<U32> {\n  if start < end && value.byte_at(start) == 46u8 {\n    let digits = start + 1u32\n    if digits >= end || json_is_digit(value.byte_at(digits)) == false {\n      Option::None\n    } else {\n      Option::Some(json_digit_run_end(value, digits + 1u32, end))\n    }\n  } else {\n    Option::Some(start)\n  }\n}\n\npub fn json_number_after_exponent(\n  value: Bytes,\n  start: U32,\n  end: U32,\n) -> Option<U32> {\n  if start < end && (value.byte_at(start) == 101u8 || value.byte_at(start) == 69u8) {\n    let first = start + 1u32\n    let digits = if first < end && (value.byte_at(first) == 43u8 || value.byte_at(first) == 45u8) {\n      first + 1u32\n    } else {\n      first\n    }\n    if digits >= end || json_is_digit(value.byte_at(digits)) == false {\n      Option::None\n    } else {\n      Option::Some(json_digit_run_end(value, digits + 1u32, end))\n    }\n  } else {\n    Option::Some(start)\n  }\n}\n\npub fn json_number_is_valid(value: Bytes, start: U32, end: U32) -> Bool {\n  if start >= end {\n    false\n  } else {\n    let integer_start = if value.byte_at(start) == 45u8 {\n      start + 1u32\n    } else {\n      start\n    }\n    match json_number_after_integer(value, integer_start, end) {\n      Option::None => false\n      Option::Some(after_integer) => {\n        match json_number_after_fraction(value, after_integer, end) {\n          Option::None => false\n          Option::Some(after_fraction) => {\n            match json_number_after_exponent(value, after_fraction, end) {\n              Option::Some(after_exponent) => after_exponent == end\n              Option::None => false\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\npub fn json_hex_value(byte: U8) -> U32 {\n  if byte >= 48u8 && byte <= 57u8 {\n    u8_into_u32(byte - 48u8)\n  } else if byte >= 65u8 && byte <= 70u8 {\n    u8_into_u32(byte - 55u8)\n  } else if byte >= 97u8 && byte <= 102u8 {\n    u8_into_u32(byte - 87u8)\n  } else {\n    4294967295u32\n  }\n}\n\npub fn json_parse_hex4(input: Bytes, start: U32) -> Option<U32> {\n  if start > input.byte_length() || input.byte_length() - start < 4u32 {\n    Option::None\n  } else {\n    let a = json_hex_value(input.byte_at(start))\n    let b = json_hex_value(input.byte_at(start + 1u32))\n    let c = json_hex_value(input.byte_at(start + 2u32))\n    let d = json_hex_value(input.byte_at(start + 3u32))\n    if a == 4294967295u32 || b == 4294967295u32 || c == 4294967295u32 || d == 4294967295u32 {\n      Option::None\n    } else {\n      Option::Some((a << 12u32) | (b << 8u32) | (c << 4u32) | d)\n    }\n  }\n}\n\npub fn json_append_plain_string_segment(\n  parser: JsonParser,\n  builder: StringBuilder,\n  start: U32,\n  end: U32,\n) -> Bool {\n  let used = builder.byte_length()\n  if end < start || used > parser.limits.max_string_bytes || end - start > parser.limits.max_string_bytes - used {\n    false\n  } else {\n    if end > start {\n      builder.append_view(parser.source.view(start, end - start))\n    } else {\n    }\n    true\n  }\n}\n\npub fn json_parse_string_with_provenance(\n  parser: JsonParser,\n) -> Result<ParsedJsonString, JsonParseError> {\n  let opening = json_parser_offset(parser)\n  let length = parser.input.byte_length()\n  if opening >= length {\n    Result::Err(JsonParseError::UnexpectedEnd(opening))\n  } else if parser.input.byte_at(opening) != 34u8 {\n    Result::Err(JsonParseError::UnexpectedByte(opening, parser.input.byte_at(opening)))\n  } else {\n    let content = opening + 1u32\n    let first_special = json_scan_string_special_simd(parser.source, content)\n    if first_special >= length {\n      Result::Err(JsonParseError::UnexpectedEnd(length))\n    } else if parser.input.byte_at(first_special) == 34u8 {\n      let decoded_length = first_special - content\n      if decoded_length > parser.limits.max_string_bytes {\n        Result::Err(JsonParseError::StringLimitExceeded(first_special))\n      } else {\n        json_parser_set_offset(parser, first_special + 1u32)\n        let view = parser.source.view(content, decoded_length)\n        if parser.compact_tokens {\n          Result::Ok(ParsedJsonString::{\n            value: view.compact()\n            needs_escape: false\n          })\n        } else {\n          Result::Ok(ParsedJsonString::{\n            value: view.to_string()\n            needs_escape: false\n          })\n        }\n      }\n    } else if parser.input.byte_at(first_special) < 32u8 {\n      Result::Err(JsonParseError::InvalidEscape(first_special))\n    } else {\n    let builder = StringBuilder::new()\n    let mut segment = content\n    let mut index = first_special\n    while () {\n      _ => {\n      let special = json_scan_string_special_simd(parser.source, index)\n      if special >= length {\n        break Result::Err(JsonParseError::UnexpectedEnd(length))\n      } else {\n      }\n      if json_append_plain_string_segment(parser, builder, segment, special) == false {\n        break Result::Err(JsonParseError::StringLimitExceeded(special))\n      } else {\n      }\n      let byte = parser.input.byte_at(special)\n      if byte == 34u8 {\n        json_parser_set_offset(parser, special + 1u32)\n        break Result::Ok(ParsedJsonString::{\n          value: builder.finish()\n          needs_escape: true\n        })\n      } else if byte < 32u8 {\n        break Result::Err(JsonParseError::InvalidEscape(special))\n      } else if byte != 92u8 {\n        break Result::Err(JsonParseError::UnexpectedByte(special, byte))\n      } else if special + 1u32 >= length {\n        break Result::Err(JsonParseError::UnexpectedEnd(length))\n      } else {\n        let escape = parser.input.byte_at(special + 1u32)\n        if escape == 34u8 || escape == 92u8 || escape == 47u8 {\n          builder.append_ascii(escape)\n          index = special + 2u32\n          segment = index\n        } else if escape == 98u8 {\n          builder.append_ascii(8u8)\n          index = special + 2u32\n          segment = index\n        } else if escape == 102u8 {\n          builder.append_ascii(12u8)\n          index = special + 2u32\n          segment = index\n        } else if escape == 110u8 {\n          builder.append_ascii(10u8)\n          index = special + 2u32\n          segment = index\n        } else if escape == 114u8 {\n          builder.append_ascii(13u8)\n          index = special + 2u32\n          segment = index\n        } else if escape == 116u8 {\n          builder.append_ascii(9u8)\n          index = special + 2u32\n          segment = index\n        } else if escape == 117u8 {\n          match json_parse_hex4(parser.input, special + 2u32) {\n            Option::None => break Result::Err(JsonParseError::InvalidUnicodeEscape(special))\n            Option::Some(first) => {\n              if first >= 55296u32 && first <= 56319u32 {\n                let second_escape = special + 6u32\n                if second_escape + 5u32 >= length ||\n                  parser.input.byte_at(second_escape) != 92u8 ||\n                  parser.input.byte_at(second_escape + 1u32) != 117u8 {\n                  break Result::Err(JsonParseError::InvalidUnicodeEscape(special))\n                } else {\n                }\n                match json_parse_hex4(parser.input, second_escape + 2u32) {\n                  Option::Some(second) if second >= 56320u32 && second <= 57343u32 => {\n                    builder.append_scalar(\n                      65536u32 + ((first - 55296u32) << 10u32) + (second - 56320u32),\n                    )\n                    index = second_escape + 6u32\n                    segment = index\n                  }\n                  _ => break Result::Err(JsonParseError::InvalidUnicodeEscape(special))\n                }\n              } else if first >= 56320u32 && first <= 57343u32 {\n                break Result::Err(JsonParseError::InvalidUnicodeEscape(special))\n              } else {\n                builder.append_scalar(first)\n                index = special + 6u32\n                segment = index\n              }\n            }\n          }\n        } else {\n          break Result::Err(JsonParseError::InvalidEscape(special))\n        }\n        if builder.byte_length() > parser.limits.max_string_bytes {\n          break Result::Err(JsonParseError::StringLimitExceeded(special))\n        } else {\n          continue ()\n        }\n      }\n      }\n    }\n    }\n  }\n}\n\npub fn json_parse_string(parser: JsonParser) -> Result<String, JsonParseError> {\n  match json_parse_string_with_provenance(parser) {\n    Result::Ok(value) => Result::Ok(value.value)\n    Result::Err(error) => Result::Err(error)\n  }\n}\n\npub fn json_parse_literal(\n  parser: JsonParser,\n  spelling: Bytes,\n  value: JsonValue,\n) -> Result<JsonValue, JsonParseError> {\n  let start = json_parser_offset(parser)\n  let length = parser.input.byte_length()\n  if start > length || spelling.byte_length() > length - start {\n    Result::Err(JsonParseError::UnexpectedEnd(length))\n  } else if parser.input.view(start, spelling.byte_length()).equals(spelling) == false {\n    Result::Err(JsonParseError::InvalidLiteral(start))\n  } else {\n    json_parser_set_offset(parser, start + spelling.byte_length())\n    Result::Ok(value)\n  }\n}\n\npub fn json_number(value: String) -> Result<JsonNumber, JsonWriteError> {\n  let bytes = value.as_bytes()\n  if json_number_is_valid(bytes, 0u32, bytes.byte_length()) {\n    Result::Ok(JsonNumber::{\n      lexeme: value\n    })\n  } else {\n    Result::Err(JsonWriteError::InvalidNumber(value))\n  }\n}\n\nimpl JsonNumber {\n  fn lexeme(self) -> String {\n    self.lexeme\n  }\n  fn value(self) -> JsonValue {\n    JsonValue::ValidatedNumber(self)\n  }\n}\n\npub fn json_string(value: String) -> JsonString {\n  JsonString::{\n    value: value\n    needs_escape: json_scan_bytes_string_special_simd(value.as_bytes(), 0u32) < value.byte_length()\n  }\n}\n\nimpl JsonString {\n  fn string(self) -> String {\n    self.value\n  }\n  fn value(self) -> JsonValue {\n    JsonValue::ValidatedString(self)\n  }\n}\n\npub fn json_parse_number_lexeme(parser: JsonParser) -> Result<String, JsonParseError> {\n  let start = json_parser_offset(parser)\n  let end = json_scan_scalar_end_simd(parser.input, start)\n  if json_number_is_valid(parser.input, start, end) == false {\n    Result::Err(JsonParseError::InvalidNumber(start))\n  } else {\n    json_parser_set_offset(parser, end)\n    let view = parser.source.view(start, end - start)\n    if parser.compact_tokens {\n      Result::Ok(view.compact())\n    } else {\n      Result::Ok(view.to_string())\n    }\n  }\n}\n\npub fn json_parse_number(parser: JsonParser) -> Result<JsonValue, JsonParseError> {\n  match json_parse_number_lexeme(parser) {\n    Result::Ok(value) => {\n      if parser.validated_numbers {\n        Result::Ok(JsonValue::ValidatedNumber(JsonNumber::{\n          lexeme: value\n        }))\n      } else {\n        Result::Ok(JsonValue::Number(value))\n      }\n    }\n    Result::Err(error) => Result::Err(error)\n  }\n}\n\npub fn json_parse_array(\n  parser: JsonParser,\n  depth: U32,\n) -> Result<JsonValue, JsonParseError> {\n  let values = Array::new()\n  json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n  json_parser_skip_whitespace(parser)\n  if json_parser_offset(parser) < parser.input.byte_length() &&\n    parser.input.byte_at(json_parser_offset(parser)) == 93u8 {\n    json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n    Result::Ok(JsonValue::Array(values))\n  } else {\n    while () {\n      _ => {\n      match json_parse_value(parser, depth + 1u32) {\n        Result::Err(error) => break Result::Err(error)\n        Result::Ok(value) => values.push(value)\n      }\n      json_parser_skip_whitespace(parser)\n      let offset = json_parser_offset(parser)\n      if offset >= parser.input.byte_length() {\n        break Result::Err(JsonParseError::UnexpectedEnd(offset))\n      } else {\n      }\n      let byte = parser.input.byte_at(offset)\n      if byte == 93u8 {\n        json_parser_set_offset(parser, offset + 1u32)\n        break Result::Ok(JsonValue::Array(values))\n      } else if byte == 44u8 {\n        json_parser_set_offset(parser, offset + 1u32)\n        json_parser_skip_whitespace(parser)\n      } else {\n        break Result::Err(JsonParseError::UnexpectedByte(offset, byte))\n      }\n      continue ()\n      }\n    }\n  }\n}\n\npub fn json_string_equals(left: String, right: String) -> Bool {\n  left.equals(right)\n}\n\npub fn json_string_hash(value: String) -> U64 {\n  value.hash()\n}\n\npub fn json_object_prefix_has_key(\n  members: Array<JsonMember>,\n  end: U32,\n  key: String,\n) -> Bool {\n  while 0u32 {\n    index if index < end => {\n      if json_string_equals(members.get_unchecked(index).key, key) {\n        break true\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break false\n  }\n}\n\npub fn json_object_has_key(members: Array<JsonMember>, key: String) -> Bool {\n  json_object_prefix_has_key(members, members.length(), key)\n}\n\npub fn json_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\npub fn json_bloom_shard(hash: U64) -> U32 {\n  json_u64_to_u32((hash >> 43u64) & 3u64)\n}\n\npub fn json_bloom_shard_maybe_contains(\n  first: BloomFilter,\n  second: BloomFilter,\n  third: BloomFilter,\n  fourth: BloomFilter,\n  shard: U32,\n  hash: U64,\n) -> Bool {\n  if shard == 0u32 {\n    first.maybe_contains_hash(hash)\n  } else if shard == 1u32 {\n    second.maybe_contains_hash(hash)\n  } else if shard == 2u32 {\n    third.maybe_contains_hash(hash)\n  } else {\n    fourth.maybe_contains_hash(hash)\n  }\n}\n\npub fn json_bloom_threshold() -> U32 {\n  16u32\n}\n\npub fn json_parse_object(\n  parser: JsonParser,\n  depth: U32,\n) -> Result<JsonValue, JsonParseError> {\n  let members = Array::new()\n  let mut key_filter0 = BloomFilter::empty()\n  let mut key_filter1 = BloomFilter::empty()\n  let mut key_filter2 = BloomFilter::empty()\n  let mut key_filter3 = BloomFilter::empty()\n  json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n  json_parser_skip_whitespace(parser)\n  if json_parser_offset(parser) < parser.input.byte_length() &&\n    parser.input.byte_at(json_parser_offset(parser)) == 125u8 {\n    json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n    Result::Ok(JsonValue::Object(members))\n  } else {\n    while () {\n      _ => {\n      let key_offset = json_parser_offset(parser)\n      if key_offset >= parser.input.byte_length() {\n        break Result::Err(JsonParseError::UnexpectedEnd(key_offset))\n      } else {\n      }\n      if parser.input.byte_at(key_offset) != 34u8 {\n        break Result::Err(\n          JsonParseError::UnexpectedByte(key_offset, parser.input.byte_at(key_offset)),\n        )\n      } else {\n      }\n      let key = match json_parse_string(parser) {\n        Result::Ok(value) => value\n        Result::Err(error) => break Result::Err(error)\n      }\n      let member_count = members.length()\n      let bloom_active = member_count >= json_bloom_threshold()\n      let key_hash = if bloom_active {\n        key.hash()\n      } else {\n        0u64\n      }\n      if member_count == json_bloom_threshold() {\n        while 0u32 {\n          index if index < member_count => {\n            let member = members.get_unchecked(index)\n            let existing_hash = json_string_hash(member.key)\n            let existing_shard = json_bloom_shard(existing_hash)\n            if existing_shard == 0u32 {\n              key_filter0 = key_filter0.add_hash(existing_hash)\n            } else if existing_shard == 1u32 {\n              key_filter1 = key_filter1.add_hash(existing_hash)\n            } else if existing_shard == 2u32 {\n              key_filter2 = key_filter2.add_hash(existing_hash)\n            } else {\n              key_filter3 = key_filter3.add_hash(existing_hash)\n            }\n            continue index + 1u32\n          }\n          _ => break json_unit()\n        }\n      } else {\n      }\n      let key_shard = if bloom_active {\n        json_bloom_shard(key_hash)\n      } else {\n        0u32\n      }\n      let duplicate = if bloom_active {\n        json_bloom_shard_maybe_contains(\n          key_filter0,\n          key_filter1,\n          key_filter2,\n          key_filter3,\n          key_shard,\n          key_hash,\n        ) && json_object_has_key(members, key)\n      } else {\n        json_object_has_key(members, key)\n      }\n      if duplicate {\n        break Result::Err(JsonParseError::DuplicateObjectKey(key_offset, key))\n      } else if key_shard == 0u32 && bloom_active {\n        key_filter0 = key_filter0.add_hash(key_hash)\n      } else if key_shard == 1u32 && bloom_active {\n        key_filter1 = key_filter1.add_hash(key_hash)\n      } else if key_shard == 2u32 && bloom_active {\n        key_filter2 = key_filter2.add_hash(key_hash)\n      } else if bloom_active {\n        key_filter3 = key_filter3.add_hash(key_hash)\n      } else {\n      }\n      json_parser_skip_whitespace(parser)\n      let colon = json_parser_offset(parser)\n      if colon >= parser.input.byte_length() {\n        break Result::Err(JsonParseError::UnexpectedEnd(colon))\n      } else {\n      }\n      if parser.input.byte_at(colon) != 58u8 {\n        break Result::Err(\n          JsonParseError::UnexpectedByte(colon, parser.input.byte_at(colon)),\n        )\n      } else {\n      }\n      json_parser_set_offset(parser, colon + 1u32)\n      json_parser_skip_whitespace(parser)\n      let member_value = match json_parse_value(parser, depth + 1u32) {\n        Result::Ok(value) => value\n        Result::Err(error) => break Result::Err(error)\n      }\n      members.push(JsonMember::{\n        key: key\n        value: member_value\n      })\n      json_parser_skip_whitespace(parser)\n      let offset = json_parser_offset(parser)\n      if offset >= parser.input.byte_length() {\n        break Result::Err(JsonParseError::UnexpectedEnd(offset))\n      } else {\n      }\n      let byte = parser.input.byte_at(offset)\n      if byte == 125u8 {\n        json_parser_set_offset(parser, offset + 1u32)\n        break Result::Ok(JsonValue::Object(members))\n      } else if byte == 44u8 {\n        json_parser_set_offset(parser, offset + 1u32)\n        json_parser_skip_whitespace(parser)\n      } else {\n        break Result::Err(JsonParseError::UnexpectedByte(offset, byte))\n      }\n      continue ()\n      }\n    }\n  }\n}\n\npub fn json_parse_value(\n  parser: JsonParser,\n  depth: U32,\n) -> Result<JsonValue, JsonParseError> {\n  if depth > parser.limits.max_depth {\n    Result::Err(JsonParseError::DepthLimitExceeded(depth))\n  } else if json_parser_value_count(parser) >= parser.limits.max_values {\n    Result::Err(JsonParseError::ValueLimitExceeded(json_parser_offset(parser)))\n  } else {\n    json_parser_set_value_count(parser, json_parser_value_count(parser) + 1u32)\n    json_parser_skip_whitespace(parser)\n    let offset = json_parser_offset(parser)\n    if offset >= parser.input.byte_length() {\n      Result::Err(JsonParseError::UnexpectedEnd(offset))\n    } else {\n      let byte = parser.input.byte_at(offset)\n      if byte == 110u8 {\n        json_parse_literal(parser, b\"null\", JsonValue::Null)\n      } else if byte == 116u8 {\n        json_parse_literal(parser, b\"true\", JsonValue::Bool(true))\n      } else if byte == 102u8 {\n        json_parse_literal(parser, b\"false\", JsonValue::Bool(false))\n      } else if byte == 34u8 {\n        match json_parse_string_with_provenance(parser) {\n          Result::Ok(value) => {\n            if parser.validated_strings {\n              Result::Ok(JsonValue::ValidatedString(JsonString::{\n                value: value.value\n                needs_escape: value.needs_escape\n              }))\n            } else {\n              Result::Ok(JsonValue::String(value.value))\n            }\n          }\n          Result::Err(error) => Result::Err(error)\n        }\n      } else if byte == 91u8 {\n        json_parse_array(parser, depth)\n      } else if byte == 123u8 {\n        json_parse_object(parser, depth)\n      } else if byte == 45u8 || json_is_digit(byte) {\n        json_parse_number(parser)\n      } else {\n        Result::Err(JsonParseError::UnexpectedByte(offset, byte))\n      }\n    }\n  }\n}\n\npub fn json_validate_literal(\n  parser: JsonParser,\n  spelling: Bytes,\n) -> Result<Unit, JsonParseError> {\n  let start = json_parser_offset(parser)\n  let length = parser.input.byte_length()\n  if start > length || spelling.byte_length() > length - start {\n    Result::Err(JsonParseError::UnexpectedEnd(length))\n  } else if parser.input.view(start, spelling.byte_length()).equals(spelling) == false {\n    Result::Err(JsonParseError::InvalidLiteral(start))\n  } else {\n    json_parser_set_offset(parser, start + spelling.byte_length())\n    Result::Ok(json_unit())\n  }\n}\n\npub fn json_validate_value(\n  parser: JsonParser,\n  depth: U32,\n) -> Result<Unit, JsonParseError> {\n  if depth > parser.limits.max_depth {\n    Result::Err(JsonParseError::DepthLimitExceeded(depth))\n  } else if json_parser_value_count(parser) >= parser.limits.max_values {\n    Result::Err(JsonParseError::ValueLimitExceeded(json_parser_offset(parser)))\n  } else {\n    json_parser_set_value_count(parser, json_parser_value_count(parser) + 1u32)\n    json_parser_skip_whitespace(parser)\n    let offset = json_parser_offset(parser)\n    if offset >= parser.input.byte_length() {\n      Result::Err(JsonParseError::UnexpectedEnd(offset))\n    } else {\n      let byte = parser.input.byte_at(offset)\n      if byte == 110u8 {\n        json_validate_literal(parser, b\"null\")\n      } else if byte == 116u8 {\n        json_validate_literal(parser, b\"true\")\n      } else if byte == 102u8 {\n        json_validate_literal(parser, b\"false\")\n      } else if byte == 34u8 {\n        match json_parse_string(parser) {\n          Result::Ok(_) => Result::Ok(json_unit())\n          Result::Err(error) => Result::Err(error)\n        }\n      } else if byte == 45u8 || json_is_digit(byte) {\n        match json_parse_number_lexeme(parser) {\n          Result::Ok(_) => Result::Ok(json_unit())\n          Result::Err(error) => Result::Err(error)\n        }\n      } else if byte == 91u8 {\n        json_parser_set_offset(parser, offset + 1u32)\n        json_parser_skip_whitespace(parser)\n        if json_parser_offset(parser) < parser.input.byte_length() &&\n          parser.input.byte_at(json_parser_offset(parser)) == 93u8 {\n          json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n          Result::Ok(json_unit())\n        } else {\n          while () {\n            _ => {\n              match json_validate_value(parser, depth + 1u32) {\n                Result::Err(error) => break Result::Err(error)\n                Result::Ok(_) => {\n                }\n              }\n              json_parser_skip_whitespace(parser)\n              let next = json_parser_offset(parser)\n              if next >= parser.input.byte_length() {\n                break Result::Err(JsonParseError::UnexpectedEnd(next))\n              } else {\n              }\n              let delimiter = parser.input.byte_at(next)\n              if delimiter == 93u8 {\n                json_parser_set_offset(parser, next + 1u32)\n                break Result::Ok(json_unit())\n              } else if delimiter == 44u8 {\n                json_parser_set_offset(parser, next + 1u32)\n                json_parser_skip_whitespace(parser)\n                continue ()\n              } else {\n                break Result::Err(JsonParseError::UnexpectedByte(next, delimiter))\n              }\n            }\n          }\n        }\n      } else if byte == 123u8 {\n        let keys = Array::new()\n        let mut key_filter0 = BloomFilter::empty()\n        let mut key_filter1 = BloomFilter::empty()\n        let mut key_filter2 = BloomFilter::empty()\n        let mut key_filter3 = BloomFilter::empty()\n        json_parser_set_offset(parser, offset + 1u32)\n        json_parser_skip_whitespace(parser)\n        if json_parser_offset(parser) < parser.input.byte_length() &&\n          parser.input.byte_at(json_parser_offset(parser)) == 125u8 {\n          json_parser_set_offset(parser, json_parser_offset(parser) + 1u32)\n          Result::Ok(json_unit())\n        } else {\n          while () {\n            _ => {\n              let key_offset = json_parser_offset(parser)\n              if key_offset >= parser.input.byte_length() {\n                break Result::Err(JsonParseError::UnexpectedEnd(key_offset))\n              } else if parser.input.byte_at(key_offset) != 34u8 {\n                break Result::Err(\n                  JsonParseError::UnexpectedByte(\n                    key_offset,\n                    parser.input.byte_at(key_offset),\n                  ),\n                )\n              } else {\n              }\n              let key = match json_parse_string(parser) {\n                Result::Ok(value) => value\n                Result::Err(error) => break Result::Err(error)\n              }\n              let key_count = keys.length()\n              let bloom_active = key_count >= json_bloom_threshold()\n              let key_hash = if bloom_active {\n                json_string_hash(key)\n              } else {\n                0u64\n              }\n              if key_count == json_bloom_threshold() {\n                while 0u32 {\n                  index if index < key_count => {\n                    let existing_hash = json_string_hash(keys.get_unchecked(index))\n                    let existing_shard = json_bloom_shard(existing_hash)\n                    if existing_shard == 0u32 {\n                      key_filter0 = key_filter0.add_hash(existing_hash)\n                    } else if existing_shard == 1u32 {\n                      key_filter1 = key_filter1.add_hash(existing_hash)\n                    } else if existing_shard == 2u32 {\n                      key_filter2 = key_filter2.add_hash(existing_hash)\n                    } else {\n                      key_filter3 = key_filter3.add_hash(existing_hash)\n                    }\n                    continue index + 1u32\n                  }\n                  _ => break json_unit()\n                }\n              } else {\n              }\n              let key_shard = if bloom_active {\n                json_bloom_shard(key_hash)\n              } else {\n                0u32\n              }\n              let duplicate = if bloom_active {\n                json_bloom_shard_maybe_contains(\n                  key_filter0,\n                  key_filter1,\n                  key_filter2,\n                  key_filter3,\n                  key_shard,\n                  key_hash,\n                ) && json_string_prefix_has_key(keys, key_count, key)\n              } else {\n                json_string_prefix_has_key(keys, key_count, key)\n              }\n              if duplicate {\n                break Result::Err(JsonParseError::DuplicateObjectKey(key_offset, key))\n              } else {\n                keys.push(key)\n                if key_shard == 0u32 && bloom_active {\n                  key_filter0 = key_filter0.add_hash(key_hash)\n                } else if key_shard == 1u32 && bloom_active {\n                  key_filter1 = key_filter1.add_hash(key_hash)\n                } else if key_shard == 2u32 && bloom_active {\n                  key_filter2 = key_filter2.add_hash(key_hash)\n                } else if bloom_active {\n                  key_filter3 = key_filter3.add_hash(key_hash)\n                } else {\n                }\n              }\n              json_parser_skip_whitespace(parser)\n              let colon = json_parser_offset(parser)\n              if colon >= parser.input.byte_length() {\n                break Result::Err(JsonParseError::UnexpectedEnd(colon))\n              } else if parser.input.byte_at(colon) != 58u8 {\n                break Result::Err(\n                  JsonParseError::UnexpectedByte(colon, parser.input.byte_at(colon)),\n                )\n              } else {\n                json_parser_set_offset(parser, colon + 1u32)\n                json_parser_skip_whitespace(parser)\n              }\n              match json_validate_value(parser, depth + 1u32) {\n                Result::Err(error) => break Result::Err(error)\n                Result::Ok(_) => {\n                }\n              }\n              json_parser_skip_whitespace(parser)\n              let next = json_parser_offset(parser)\n              if next >= parser.input.byte_length() {\n                break Result::Err(JsonParseError::UnexpectedEnd(next))\n              } else {\n              }\n              let delimiter = parser.input.byte_at(next)\n              if delimiter == 125u8 {\n                json_parser_set_offset(parser, next + 1u32)\n                break Result::Ok(json_unit())\n              } else if delimiter == 44u8 {\n                json_parser_set_offset(parser, next + 1u32)\n                json_parser_skip_whitespace(parser)\n                continue ()\n              } else {\n                break Result::Err(JsonParseError::UnexpectedByte(next, delimiter))\n              }\n            }\n          }\n        }\n      } else {\n        Result::Err(JsonParseError::UnexpectedByte(offset, byte))\n      }\n    }\n  }\n}\n\npub fn json_string_prefix_has_key(\n  keys: Array<String>,\n  end: U32,\n  key: String,\n) -> Bool {\n  while 0u32 {\n    index if index < end => {\n      if json_string_equals(keys.get_unchecked(index), key) {\n        break true\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break false\n  }\n}\n\npub fn json_parse_validated_string_with_limits(\n  source: String,\n  limits: JsonLimits,\n  compact_tokens: Bool,\n  validated_numbers: Bool,\n  validated_strings: Bool,\n) -> Result<JsonValue, JsonParseError> {\n  let length = source.byte_length()\n  if length > limits.max_input_bytes {\n    Result::Err(JsonParseError::InputLimitExceeded(length))\n  } else {\n    let parser = JsonParser::{\n      input: source.as_bytes()\n      source: source\n      state: FixedArray::make(2u32, 0u32)\n      limits: limits\n      compact_tokens: compact_tokens\n      validated_numbers: validated_numbers\n      validated_strings: validated_strings\n    }\n    match json_parse_value(parser, 0u32) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(value) => {\n        json_parser_skip_whitespace(parser)\n        if json_parser_offset(parser) == length {\n          Result::Ok(value)\n        } else {\n          Result::Err(JsonParseError::TrailingData(json_parser_offset(parser)))\n        }\n      }\n    }\n  }\n}\n\npub fn json_parse_bytes_with_limits(\n  input: Bytes,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  let length = input.byte_length()\n  if length > limits.max_input_bytes {\n    Result::Err(JsonParseError::InputLimitExceeded(length))\n  } else if input.is_valid_utf8() == false {\n    Result::Err(JsonParseError::InvalidUtf8)\n  } else {\n    json_parse_validated_string_with_limits(\n      json_bytes_to_string_unchecked(input),\n      limits,\n      true,\n      false,\n      false,\n    )\n  }\n}\n\npub fn json_parse_bytes(input: Bytes) -> Result<JsonValue, JsonParseError> {\n  json_parse_bytes_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, true, false, false)\n}\n\npub fn json_parse(input: String) -> Result<JsonValue, JsonParseError> {\n  json_parse_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_retained_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, false, false, false)\n}\n\npub fn json_parse_retained(input: String) -> Result<JsonValue, JsonParseError> {\n  json_parse_retained_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_validated_numbers_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, true, true, false)\n}\n\npub fn json_parse_validated_numbers(\n  input: String,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_numbers_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_retained_validated_numbers_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, false, true, false)\n}\n\npub fn json_parse_retained_validated_numbers(\n  input: String,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_retained_validated_numbers_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_canonical_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, true, true, true)\n}\n\npub fn json_parse_canonical(input: String) -> Result<JsonValue, JsonParseError> {\n  json_parse_canonical_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_retained_canonical_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_validated_string_with_limits(input, limits, false, true, true)\n}\n\npub fn json_parse_retained_canonical(\n  input: String,\n) -> Result<JsonValue, JsonParseError> {\n  json_parse_retained_canonical_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_document_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonDocument, JsonParseError> {\n  match json_parse_retained_with_limits(input, limits) {\n    Result::Err(error) => Result::Err(error)\n    Result::Ok(value) => Result::Ok(JsonDocument::{\n      source: input\n      value: value\n    })\n  }\n}\n\npub fn json_parse_document(input: String) -> Result<JsonDocument, JsonParseError> {\n  json_parse_document_with_limits(input, json_default_limits())\n}\n\nimpl JsonDocument {\n  fn source(self) -> String {\n    self.source\n  }\n  fn value(self) -> JsonValue {\n    self.value\n  }\n  fn stringify_source(self) -> String {\n    self.source\n  }\n}\n\npub fn json_validate_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<Unit, JsonParseError> {\n  let length = input.byte_length()\n  if length > limits.max_input_bytes {\n    Result::Err(JsonParseError::InputLimitExceeded(length))\n  } else {\n    let parser = JsonParser::{\n      input: input.as_bytes()\n      source: input\n      state: FixedArray::make(2u32, 0u32)\n      limits: limits\n      compact_tokens: false\n      validated_numbers: false\n      validated_strings: false\n    }\n    match json_validate_value(parser, 0u32) {\n      Result::Err(error) => Result::Err(error)\n      Result::Ok(_) => {\n        json_parser_skip_whitespace(parser)\n        if json_parser_offset(parser) == length {\n          Result::Ok(json_unit())\n        } else {\n          Result::Err(JsonParseError::TrailingData(json_parser_offset(parser)))\n        }\n      }\n    }\n  }\n}\n\npub fn json_validate(input: String) -> Result<Unit, JsonParseError> {\n  json_validate_with_limits(input, json_default_limits())\n}\n\npub fn json_parse_raw_document_with_limits(\n  input: String,\n  limits: JsonLimits,\n) -> Result<JsonRawDocument, JsonParseError> {\n  match json_validate_with_limits(input, limits) {\n    Result::Err(error) => Result::Err(error)\n    Result::Ok(_) => Result::Ok(JsonRawDocument::{\n      source: input\n    })\n  }\n}\n\npub fn json_parse_raw_document(\n  input: String,\n) -> Result<JsonRawDocument, JsonParseError> {\n  json_parse_raw_document_with_limits(input, json_default_limits())\n}\n\nimpl JsonRawDocument {\n  fn source(self) -> String {\n    self.source\n  }\n  fn stringify_source(self) -> String {\n    self.source\n  }\n  fn materialize(self) -> Result<JsonValue, JsonParseError> {\n    json_parse_retained(self.source)\n  }\n}\n\n\npub fn json_parse_reader_with_limits<r: Reader>(\n  reader: r,\n  chunk_limit: U32,\n  limits: JsonLimits,\n) -> Result<JsonValue, JsonReadError> {\n  match io_read_to_end(reader, chunk_limit, limits.max_input_bytes) {\n    Result::Err(error) => Result::Err(JsonReadError::Io(error))\n    Result::Ok(input) => {\n      match json_parse_bytes_with_limits(input, limits) {\n        Result::Err(error) => Result::Err(JsonReadError::Parse(error))\n        Result::Ok(value) => Result::Ok(value)\n      }\n    }\n  }\n}\n\npub fn json_parse_reader<r: Reader>(\n  reader: r,\n  chunk_limit: U32,\n) -> Result<JsonValue, JsonReadError> {\n  json_parse_reader_with_limits(reader, chunk_limit, json_default_limits())\n}\n\npub fn json_writer_set_error(writer: JsonWriter, code: U32) -> Unit {\n  if writer.error.get_unchecked(0u32) == 0u32 {\n    writer.error.set_unchecked(0u32, code)\n  } else {\n  }\n}\n\npub fn json_writer_set_payload_error(\n  writer: JsonWriter,\n  code: U32,\n  payload: String,\n) -> Unit {\n  if writer.error.get_unchecked(0u32) == 0u32 {\n    writer.error_payload.set_unchecked(0u32, payload)\n    writer.error.set_unchecked(0u32, code)\n  } else {\n  }\n}\n\npub fn json_writer_append_ascii(writer: JsonWriter, byte: U8) -> Unit {\n  if writer.error.get_unchecked(0u32) != 0u32 {\n  } else if writer.builder.byte_length() >= writer.max_bytes {\n    json_writer_set_error(writer, 3u32)\n  } else {\n    writer.builder.append_ascii(byte)\n  }\n}\n\npub fn json_writer_append_text(writer: JsonWriter, value: String) -> Unit {\n  let used = writer.builder.byte_length()\n  let added = value.byte_length()\n  if writer.error.get_unchecked(0u32) != 0u32 {\n  } else if used > writer.max_bytes || added > writer.max_bytes - used {\n    json_writer_set_error(writer, 3u32)\n  } else {\n    writer.builder.append(value)\n  }\n}\n\npub fn json_writer_append_view(writer: JsonWriter, value: StringView) -> Unit {\n  let used = writer.builder.byte_length()\n  let added = value.byte_length()\n  if writer.error.get_unchecked(0u32) != 0u32 {\n  } else if used > writer.max_bytes || added > writer.max_bytes - used {\n    json_writer_set_error(writer, 3u32)\n  } else {\n    writer.builder.append_view(value)\n  }\n}\n\npub fn json_hex_ascii(value: U8) -> U8 {\n  if value < 10u8 {\n    value + 48u8\n  } else {\n    value + 87u8\n  }\n}\n\npub fn json_write_string(\n  writer: JsonWriter,\n  value: String,\n) -> Unit {\n  json_writer_append_ascii(writer, 34u8)\n  let bytes = value.as_bytes()\n  let length = bytes.byte_length()\n  let mut index = 0u32\n  while index {\n    current if current < length && writer.error.get_unchecked(0u32) == 0u32 => {\n      let special = json_scan_bytes_string_special_simd(bytes, current)\n      if special > current {\n        json_writer_append_view(writer, value.view(current, special - current))\n      } else {\n      }\n      if special >= length {\n        break length\n      } else {\n        let byte = bytes.byte_at(special)\n        if byte == 34u8 || byte == 92u8 {\n          json_writer_append_ascii(writer, 92u8)\n          json_writer_append_ascii(writer, byte)\n        } else if byte == 8u8 || byte == 12u8 || byte == 10u8 || byte == 13u8 || byte == 9u8 {\n          json_writer_append_ascii(writer, 92u8)\n          json_writer_append_ascii(\n            writer,\n            if byte == 8u8 {\n              98u8\n            } else if byte == 12u8 {\n              102u8\n            } else if byte == 10u8 {\n              110u8\n            } else if byte == 13u8 {\n              114u8\n            } else {\n              116u8\n            },\n          )\n        } else {\n          json_writer_append_ascii(writer, 92u8)\n          json_writer_append_ascii(writer, 117u8)\n          json_writer_append_ascii(writer, 48u8)\n          json_writer_append_ascii(writer, 48u8)\n          json_writer_append_ascii(writer, json_hex_ascii(byte >> 4u8))\n          json_writer_append_ascii(writer, json_hex_ascii(byte & 15u8))\n        }\n        continue special + 1u32\n      }\n    }\n    current => break current\n  }\n  json_writer_append_ascii(writer, 34u8)\n}\n\npub fn json_write_validated_string(\n  writer: JsonWriter,\n  value: JsonString,\n) -> Unit {\n  if value.needs_escape {\n    json_write_string(writer, value.value)\n  } else {\n    json_writer_append_ascii(writer, 34u8)\n    json_writer_append_text(writer, value.value)\n    json_writer_append_ascii(writer, 34u8)\n  }\n}\n\npub fn json_write_value(\n  writer: JsonWriter,\n  value: JsonValue,\n  depth: U32,\n) -> Unit {\n  if writer.error.get_unchecked(0u32) != 0u32 {\n    json_unit()\n  } else if depth > writer.max_depth {\n    json_writer_set_error(writer, 1u32)\n  } else {\n    match value {\n      JsonValue::Null => json_writer_append_text(writer, \"null\")\n      JsonValue::Bool(flag) => {\n        if flag {\n          json_writer_append_text(writer, \"true\")\n        } else {\n          json_writer_append_text(writer, \"false\")\n        }\n      }\n      JsonValue::Number(number) => {\n        let bytes = number.as_bytes()\n        if json_number_is_valid(bytes, 0u32, bytes.byte_length()) {\n          json_writer_append_text(writer, number)\n        } else {\n          json_writer_set_payload_error(writer, 2u32, number)\n        }\n      }\n      JsonValue::ValidatedNumber(number) => json_writer_append_text(writer, number.lexeme)\n      JsonValue::String(text) => json_write_string(writer, text)\n      JsonValue::ValidatedString(text) => json_write_validated_string(writer, text)\n      JsonValue::Array(values) => {\n        json_writer_append_ascii(writer, 91u8)\n        let length = values.length()\n        while 0u32 {\n          index if index < length && writer.error.get_unchecked(0u32) == 0u32 => {\n            if index > 0u32 {\n              json_writer_append_ascii(writer, 44u8)\n            } else {\n            }\n            json_write_value(writer, values.get_unchecked(index), depth + 1u32)\n            continue index + 1u32\n          }\n          _ => break json_unit()\n        }\n        json_writer_append_ascii(writer, 93u8)\n      }\n      JsonValue::Object(members) => {\n        json_writer_append_ascii(writer, 123u8)\n        let mut key_filter0 = BloomFilter::empty()\n        let mut key_filter1 = BloomFilter::empty()\n        let mut key_filter2 = BloomFilter::empty()\n        let mut key_filter3 = BloomFilter::empty()\n        let length = members.length()\n        let bloom_active = length >= json_bloom_threshold()\n        while 0u32 {\n          index if index < length && writer.error.get_unchecked(0u32) == 0u32 => {\n            let member = members.get_unchecked(index)\n            let key_hash = if bloom_active {\n              json_string_hash(member.key)\n            } else {\n              0u64\n            }\n            let key_shard = if bloom_active {\n              json_bloom_shard(key_hash)\n            } else {\n              0u32\n            }\n            let duplicate = if bloom_active {\n              json_bloom_shard_maybe_contains(\n                key_filter0,\n                key_filter1,\n                key_filter2,\n                key_filter3,\n                key_shard,\n                key_hash,\n              ) && json_object_prefix_has_key(members, index, member.key)\n            } else {\n              json_object_prefix_has_key(members, index, member.key)\n            }\n            if duplicate {\n              json_writer_set_payload_error(writer, 4u32, member.key)\n            } else {\n              if key_shard == 0u32 && bloom_active {\n                key_filter0 = key_filter0.add_hash(key_hash)\n              } else if key_shard == 1u32 && bloom_active {\n                key_filter1 = key_filter1.add_hash(key_hash)\n              } else if key_shard == 2u32 && bloom_active {\n                key_filter2 = key_filter2.add_hash(key_hash)\n              } else if bloom_active {\n                key_filter3 = key_filter3.add_hash(key_hash)\n              } else {\n              }\n              if index > 0u32 {\n                json_writer_append_ascii(writer, 44u8)\n              } else {\n              }\n              json_write_string(writer, member.key)\n              json_writer_append_ascii(writer, 58u8)\n              json_write_value(writer, member.value, depth + 1u32)\n            }\n            continue index + 1u32\n          }\n          _ => break json_unit()\n        }\n        json_writer_append_ascii(writer, 125u8)\n      }\n    }\n  }\n}\n\npub fn json_stringify_with_limits(\n  value: JsonValue,\n  max_depth: U32,\n  max_bytes: U32,\n) -> Result<String, JsonWriteError> {\n  let error = FixedArray::make(1u32, 0u32)\n  let writer = JsonWriter::{\n    builder: StringBuilder::new()\n    max_depth: max_depth\n    max_bytes: max_bytes\n    error: error\n    error_payload: FixedArray::make(1u32, \"\")\n  }\n  json_write_value(writer, value, 0u32)\n  if error.get_unchecked(0u32) == 1u32 {\n    Result::Err(JsonWriteError::DepthLimitExceeded)\n  } else if error.get_unchecked(0u32) == 2u32 {\n    Result::Err(\n      JsonWriteError::InvalidNumber(writer.error_payload.get_unchecked(0u32)),\n    )\n  } else if error.get_unchecked(0u32) == 3u32 {\n    Result::Err(JsonWriteError::ByteLimitExceeded)\n  } else if error.get_unchecked(0u32) == 4u32 {\n    Result::Err(\n      JsonWriteError::DuplicateObjectKey(writer.error_payload.get_unchecked(0u32)),\n    )\n  } else {\n    Result::Ok(writer.builder.finish())\n  }\n}\n\npub fn json_stringify(value: JsonValue) -> Result<String, JsonWriteError> {\n  json_stringify_with_limits(value, 128u32, 16777216u32)\n}\n\npub fn json_write_with_limits<w: Writer>(\n  writer: w,\n  value: JsonValue,\n  max_depth: U32,\n  max_bytes: U32,\n) -> Result<U32, JsonOutputError> {\n  match json_stringify_with_limits(value, max_depth, max_bytes) {\n    Result::Err(error) => Result::Err(JsonOutputError::Write(error))\n    Result::Ok(output) => {\n      match io_write_all(writer, output.as_bytes()) {\n        Result::Err(error) => Result::Err(JsonOutputError::Io(error))\n        Result::Ok(written) => Result::Ok(written)\n      }\n    }\n  }\n}\n\npub fn json_write<w: Writer>(\n  writer: w,\n  value: JsonValue,\n) -> Result<U32, JsonOutputError> {\n  json_write_with_limits(writer, value, 128u32, 16777216u32)\n}\n\npub fn json_member(key: String, value: JsonValue) -> JsonMember {\n  JsonMember::{\n    key: key\n    value: value\n  }\n}\n\npub fn json_array() -> Array<JsonValue> {\n  Array::new()\n}\n\npub fn json_object() -> Array<JsonMember> {\n  Array::new()\n}\n\npub fn json_object_get(\n  members: Array<JsonMember>,\n  key: String,\n) -> Option<JsonValue> {\n  while 0u32 {\n    index if index < members.length() => {\n      let member = members.get_unchecked(index)\n      if json_string_equals(member.key, key) {\n        break Option::Some(member.value)\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => break Option::None\n  }\n}\n"
}

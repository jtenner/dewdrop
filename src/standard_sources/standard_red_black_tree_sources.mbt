///|
pub fn standard_red_black_tree_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.ordering\n\npub struct TreeEntry<k, v> {\n  key: k\n  value: v\n}\n\npub struct RedBlackTree<k, v, c> {\n  keys: Array<k>\n  values: Array<v>\n  parents: Array<I32>\n  lefts: Array<I32>\n  rights: Array<I32>\n  reds: Array<Bool>\n  active: Array<Bool>\n  root: Array<I32>\n  live: Array<U32>\n  comparator: c\n}\n\npub struct RedBlackTreeIter<k, v, c> {\n  tree: RedBlackTree<k, v, c>\n  current: Array<I32>\n  upper: Option<k>\n  upper_inclusive: Bool\n}\n\nfn tree_unit() -> Unit {}\n\nfn tree_no_key<k>() -> Option<k> {\n  Option::None\n}\n\nfn tree_i32_box(value: I32) -> Array<I32> {\n  let result = array_with_capacity(1u32)\n  array_push(result, value)\n  result\n}\n\nfn tree_u32_box(value: U32) -> Array<U32> {\n  let result = array_with_capacity(1u32)\n  array_push(result, value)\n  result\n}\n\nfn tree_index(index: I32) -> U32 {\n  index.into()\n}\n\nfn tree_root<k, v, c>(tree: RedBlackTree<k, v, c>) -> I32 {\n  array_get_unchecked(tree.root, 0u32)\n}\n\nfn tree_set_root<k, v, c>(tree: RedBlackTree<k, v, c>, value: I32) -> Unit {\n  array_set_unchecked(tree.root, 0u32, value)\n}\n\nfn tree_live<k, v, c>(tree: RedBlackTree<k, v, c>) -> U32 {\n  array_get_unchecked(tree.live, 0u32)\n}\n\nfn tree_set_live<k, v, c>(tree: RedBlackTree<k, v, c>, value: U32) -> Unit {\n  array_set_unchecked(tree.live, 0u32, value)\n}\n\nfn tree_parent<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> I32 {\n  if node < 0 {\n    -1\n  } else {\n    array_get_unchecked(tree.parents, tree_index(node))\n  }\n}\n\nfn tree_left<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> I32 {\n  if node < 0 {\n    -1\n  } else {\n    array_get_unchecked(tree.lefts, tree_index(node))\n  }\n}\n\nfn tree_right<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> I32 {\n  if node < 0 {\n    -1\n  } else {\n    array_get_unchecked(tree.rights, tree_index(node))\n  }\n}\n\nfn tree_is_red<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> Bool {\n  if node < 0 {\n    false\n  } else {\n    array_get_unchecked(tree.reds, tree_index(node))\n  }\n}\n\nfn tree_set_parent<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n  value: I32,\n) -> Unit {\n  if node >= 0 {\n    array_set_unchecked(tree.parents, tree_index(node), value)\n  } else {\n    tree_unit()\n  }\n}\n\nfn tree_set_left<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n  value: I32,\n) -> Unit {\n  if node >= 0 {\n    array_set_unchecked(tree.lefts, tree_index(node), value)\n  } else {\n    tree_unit()\n  }\n}\n\nfn tree_set_right<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n  value: I32,\n) -> Unit {\n  if node >= 0 {\n    array_set_unchecked(tree.rights, tree_index(node), value)\n  } else {\n    tree_unit()\n  }\n}\n\nfn tree_set_red<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n  value: Bool,\n) -> Unit {\n  if node >= 0 {\n    array_set_unchecked(tree.reds, tree_index(node), value)\n  } else {\n    tree_unit()\n  }\n}\n\nfn tree_key<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> k {\n  array_get_unchecked(tree.keys, tree_index(node))\n}\n\nfn tree_value<k, v, c>(tree: RedBlackTree<k, v, c>, node: I32) -> v {\n  array_get_unchecked(tree.values, tree_index(node))\n}\n\nfn tree_entry<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n) -> TreeEntry<k, v> {\n  TreeEntry {\n    key: tree_key(tree, node)\n    value: tree_value(tree, node)\n  }\n}\n\npub fn red_black_tree_new<k, v, c: Comparator<k>>(\n  comparator: c,\n) -> RedBlackTree<k, v, c> {\n  RedBlackTree {\n    keys: array_new()\n    values: array_new()\n    parents: array_new()\n    lefts: array_new()\n    rights: array_new()\n    reds: array_new()\n    active: array_new()\n    root: tree_i32_box(-1)\n    live: tree_u32_box(0u32)\n    comparator: comparator\n  }\n}\n\npub fn red_black_tree_length<k, v, c>(tree: RedBlackTree<k, v, c>) -> U32 {\n  tree_live(tree)\n}\n\npub fn red_black_tree_is_empty<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n) -> Bool {\n  tree_live(tree) == 0u32\n}\n\nfn tree_compare_key<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n  node: I32,\n) -> Ordering {\n  tree.comparator.compare(key, tree_key(tree, node))\n}\n\nfn tree_find_index<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> I32 {\n  while tree_root(tree) {\n    -1 => break -1\n    node => {\n      match tree_compare_key(tree, key, node) {\n        Ordering::Less => continue tree_left(tree, node)\n        Ordering::Greater => continue tree_right(tree, node)\n        Ordering::Equal => break node\n      }\n    }\n  }\n}\n\nfn tree_minimum_index<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  start: I32,\n) -> I32 {\n  while start {\n    -1 => break -1\n    node => {\n      let left = tree_left(tree, node)\n      if left < 0 {\n        break node\n      } else {\n        continue left\n      }\n    }\n  }\n}\n\nfn tree_maximum_index<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  start: I32,\n) -> I32 {\n  while start {\n    -1 => break -1\n    node => {\n      let right = tree_right(tree, node)\n      if right < 0 {\n        break node\n      } else {\n        continue right\n      }\n    }\n  }\n}\n\nfn tree_successor_index<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n) -> I32 {\n  let right = tree_right(tree, node)\n  if right >= 0 {\n    tree_minimum_index(tree, right)\n  } else {\n    let mut current = node\n    let mut parent = tree_parent(tree, current)\n    while true {\n      true if parent >= 0 && current == tree_right(tree, parent) => {\n        current = parent\n        parent = tree_parent(tree, parent)\n        continue true\n      }\n      _ => break parent\n    }\n  }\n}\n\nfn tree_predecessor_index<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n) -> I32 {\n  let left = tree_left(tree, node)\n  if left >= 0 {\n    tree_maximum_index(tree, left)\n  } else {\n    let mut current = node\n    let mut parent = tree_parent(tree, current)\n    while true {\n      true if parent >= 0 && current == tree_left(tree, parent) => {\n        current = parent\n        parent = tree_parent(tree, parent)\n        continue true\n      }\n      _ => break parent\n    }\n  }\n}\n\nfn tree_left_rotate<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n) -> Unit {\n  let pivot = tree_right(tree, node)\n  let middle = tree_left(tree, pivot)\n  tree_set_right(tree, node, middle)\n  tree_set_parent(tree, middle, node)\n  let parent = tree_parent(tree, node)\n  tree_set_parent(tree, pivot, parent)\n  if parent < 0 {\n    tree_set_root(tree, pivot)\n  } else if node == tree_left(tree, parent) {\n    tree_set_left(tree, parent, pivot)\n  } else {\n    tree_set_right(tree, parent, pivot)\n  }\n  tree_set_left(tree, pivot, node)\n  tree_set_parent(tree, node, pivot)\n}\n\nfn tree_right_rotate<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  node: I32,\n) -> Unit {\n  let pivot = tree_left(tree, node)\n  let middle = tree_right(tree, pivot)\n  tree_set_left(tree, node, middle)\n  tree_set_parent(tree, middle, node)\n  let parent = tree_parent(tree, node)\n  tree_set_parent(tree, pivot, parent)\n  if parent < 0 {\n    tree_set_root(tree, pivot)\n  } else if node == tree_right(tree, parent) {\n    tree_set_right(tree, parent, pivot)\n  } else {\n    tree_set_left(tree, parent, pivot)\n  }\n  tree_set_right(tree, pivot, node)\n  tree_set_parent(tree, node, pivot)\n}\n\nfn tree_insert_fixup<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  inserted: I32,\n) -> Unit {\n  let mut node = inserted\n  while true {\n    true if tree_is_red(tree, tree_parent(tree, node)) => {\n      let parent = tree_parent(tree, node)\n      let grand = tree_parent(tree, parent)\n      if parent == tree_left(tree, grand) {\n        let uncle = tree_right(tree, grand)\n        if tree_is_red(tree, uncle) {\n          tree_set_red(tree, parent, false)\n          tree_set_red(tree, uncle, false)\n          tree_set_red(tree, grand, true)\n          node = grand\n        } else {\n          if node == tree_right(tree, parent) {\n            node = parent\n            tree_left_rotate(tree, node)\n          } else {\n            tree_unit()\n          }\n          let fixed_parent = tree_parent(tree, node)\n          let fixed_grand = tree_parent(tree, fixed_parent)\n          tree_set_red(tree, fixed_parent, false)\n          tree_set_red(tree, fixed_grand, true)\n          tree_right_rotate(tree, fixed_grand)\n        }\n      } else {\n        let uncle = tree_left(tree, grand)\n        if tree_is_red(tree, uncle) {\n          tree_set_red(tree, parent, false)\n          tree_set_red(tree, uncle, false)\n          tree_set_red(tree, grand, true)\n          node = grand\n        } else {\n          if node == tree_left(tree, parent) {\n            node = parent\n            tree_right_rotate(tree, node)\n          } else {\n            tree_unit()\n          }\n          let fixed_parent = tree_parent(tree, node)\n          let fixed_grand = tree_parent(tree, fixed_parent)\n          tree_set_red(tree, fixed_parent, false)\n          tree_set_red(tree, fixed_grand, true)\n          tree_left_rotate(tree, fixed_grand)\n        }\n      }\n      continue true\n    }\n    _ => break tree_unit()\n  }\n  tree_set_red(tree, tree_root(tree), false)\n}\n\npub fn red_black_tree_insert<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n  value: v,\n) -> Bool {\n  let mut parent = -1\n  let mut current = tree_root(tree)\n  let mut relation = Ordering::Equal\n  while true {\n    true if current >= 0 => {\n      parent = current\n      relation = tree_compare_key(tree, key, current)\n      match relation {\n        Ordering::Less => {\n          current = tree_left(tree, current)\n          tree_unit()\n        }\n        Ordering::Greater => {\n          current = tree_right(tree, current)\n          tree_unit()\n        }\n        Ordering::Equal => {\n          array_set_unchecked(tree.values, tree_index(current), value)\n          return false\n        }\n      }\n      continue true\n    }\n    _ => break tree_unit()\n  }\n  let node = array_length(tree.keys).into()\n  array_push(tree.keys, key)\n  array_push(tree.values, value)\n  array_push(tree.parents, parent)\n  array_push(tree.lefts, -1)\n  array_push(tree.rights, -1)\n  array_push(tree.reds, true)\n  array_push(tree.active, true)\n  if parent < 0 {\n    tree_set_root(tree, node)\n  } else if relation is Ordering::Less {\n    tree_set_left(tree, parent, node)\n  } else {\n    tree_set_right(tree, parent, node)\n  }\n  tree_set_live(tree, tree_live(tree) + 1u32)\n  tree_insert_fixup(tree, node)\n  true\n}\n\npub fn red_black_tree_get<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Option<v> {\n  let node = tree_find_index(tree, key)\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_value(tree, node))\n  }\n}\n\npub fn red_black_tree_contains<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Bool {\n  tree_find_index(tree, key) >= 0\n}\n\nfn tree_transplant<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  removed: I32,\n  replacement: I32,\n) -> Unit {\n  let parent = tree_parent(tree, removed)\n  if parent < 0 {\n    tree_set_root(tree, replacement)\n  } else if removed == tree_left(tree, parent) {\n    tree_set_left(tree, parent, replacement)\n  } else {\n    tree_set_right(tree, parent, replacement)\n  }\n  tree_set_parent(tree, replacement, parent)\n}\n\nfn tree_delete_fixup<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n  start: I32,\n  start_parent: I32,\n) -> Unit {\n  let mut node = start\n  let mut parent_hint = start_parent\n  while true {\n    true if node != tree_root(tree) && !tree_is_red(tree, node) => {\n      let parent = if node >= 0 {\n        tree_parent(tree, node)\n      } else {\n        parent_hint\n      }\n      if parent < 0 {\n        node = tree_root(tree)\n      } else if node == tree_left(tree, parent) {\n        let mut sibling = tree_right(tree, parent)\n        if tree_is_red(tree, sibling) {\n          tree_set_red(tree, sibling, false)\n          tree_set_red(tree, parent, true)\n          tree_left_rotate(tree, parent)\n          sibling = tree_right(tree, parent)\n        } else {\n          tree_unit()\n        }\n        if !tree_is_red(tree, tree_left(tree, sibling)) &&\n          !tree_is_red(tree, tree_right(tree, sibling)) {\n          tree_set_red(tree, sibling, true)\n          node = parent\n          parent_hint = tree_parent(tree, node)\n        } else {\n          if !tree_is_red(tree, tree_right(tree, sibling)) {\n            tree_set_red(tree, tree_left(tree, sibling), false)\n            tree_set_red(tree, sibling, true)\n            tree_right_rotate(tree, sibling)\n            sibling = tree_right(tree, parent)\n          } else {\n            tree_unit()\n          }\n          tree_set_red(tree, sibling, tree_is_red(tree, parent))\n          tree_set_red(tree, parent, false)\n          tree_set_red(tree, tree_right(tree, sibling), false)\n          tree_left_rotate(tree, parent)\n          node = tree_root(tree)\n          parent_hint = -1\n        }\n      } else {\n        let mut sibling = tree_left(tree, parent)\n        if tree_is_red(tree, sibling) {\n          tree_set_red(tree, sibling, false)\n          tree_set_red(tree, parent, true)\n          tree_right_rotate(tree, parent)\n          sibling = tree_left(tree, parent)\n        } else {\n          tree_unit()\n        }\n        if !tree_is_red(tree, tree_right(tree, sibling)) &&\n          !tree_is_red(tree, tree_left(tree, sibling)) {\n          tree_set_red(tree, sibling, true)\n          node = parent\n          parent_hint = tree_parent(tree, node)\n        } else {\n          if !tree_is_red(tree, tree_left(tree, sibling)) {\n            tree_set_red(tree, tree_right(tree, sibling), false)\n            tree_set_red(tree, sibling, true)\n            tree_left_rotate(tree, sibling)\n            sibling = tree_left(tree, parent)\n          } else {\n            tree_unit()\n          }\n          tree_set_red(tree, sibling, tree_is_red(tree, parent))\n          tree_set_red(tree, parent, false)\n          tree_set_red(tree, tree_left(tree, sibling), false)\n          tree_right_rotate(tree, parent)\n          node = tree_root(tree)\n          parent_hint = -1\n        }\n      }\n      continue true\n    }\n    _ => break tree_unit()\n  }\n  tree_set_red(tree, node, false)\n}\n\npub fn red_black_tree_remove<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Bool {\n  let removed = tree_find_index(tree, key)\n  if removed < 0 {\n    false\n  } else {\n    let mut moved = removed\n    let mut moved_was_red = tree_is_red(tree, moved)\n    let mut replacement = -1\n    let mut replacement_parent = -1\n    if tree_left(tree, removed) < 0 {\n      replacement = tree_right(tree, removed)\n      replacement_parent = tree_parent(tree, removed)\n      tree_transplant(tree, removed, replacement)\n    } else if tree_right(tree, removed) < 0 {\n      replacement = tree_left(tree, removed)\n      replacement_parent = tree_parent(tree, removed)\n      tree_transplant(tree, removed, replacement)\n    } else {\n      moved = tree_minimum_index(tree, tree_right(tree, removed))\n      moved_was_red = tree_is_red(tree, moved)\n      replacement = tree_right(tree, moved)\n      if tree_parent(tree, moved) == removed {\n        replacement_parent = moved\n        tree_set_parent(tree, replacement, moved)\n      } else {\n        replacement_parent = tree_parent(tree, moved)\n        tree_transplant(tree, moved, replacement)\n        tree_set_right(tree, moved, tree_right(tree, removed))\n        tree_set_parent(tree, tree_right(tree, moved), moved)\n      }\n      tree_transplant(tree, removed, moved)\n      tree_set_left(tree, moved, tree_left(tree, removed))\n      tree_set_parent(tree, tree_left(tree, moved), moved)\n      tree_set_red(tree, moved, tree_is_red(tree, removed))\n    }\n    array_set_unchecked(tree.active, tree_index(removed), false)\n    tree_set_live(tree, tree_live(tree) - 1u32)\n    if !moved_was_red {\n      tree_delete_fixup(tree, replacement, replacement_parent)\n    } else {\n      tree_unit()\n    }\n    true\n  }\n}\n\npub fn red_black_tree_minimum<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n) -> Option<TreeEntry<k, v>> {\n  let node = tree_minimum_index(tree, tree_root(tree))\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_entry(tree, node))\n  }\n}\n\npub fn red_black_tree_maximum<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n) -> Option<TreeEntry<k, v>> {\n  let node = tree_maximum_index(tree, tree_root(tree))\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_entry(tree, node))\n  }\n}\n\nfn tree_lower_bound_index<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n  inclusive: Bool,\n) -> I32 {\n  let mut candidate = -1\n  while tree_root(tree) {\n    -1 => break candidate\n    node => {\n      match tree_compare_key(tree, key, node) {\n        Ordering::Less => {\n          candidate = node\n          continue tree_left(tree, node)\n        }\n        Ordering::Equal => {\n          if inclusive {\n            break node\n          } else {\n            continue tree_right(tree, node)\n          }\n        }\n        Ordering::Greater => continue tree_right(tree, node)\n      }\n    }\n  }\n}\n\npub fn red_black_tree_lower_bound<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Option<TreeEntry<k, v>> {\n  let node = tree_lower_bound_index(tree, key, true)\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_entry(tree, node))\n  }\n}\n\npub fn red_black_tree_upper_bound<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Option<TreeEntry<k, v>> {\n  let node = tree_lower_bound_index(tree, key, false)\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_entry(tree, node))\n  }\n}\n\npub fn red_black_tree_predecessor<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Option<TreeEntry<k, v>> {\n  let bound = tree_lower_bound_index(tree, key, true)\n  let node = if bound < 0 {\n    tree_maximum_index(tree, tree_root(tree))\n  } else {\n    match tree.comparator.compare(tree_key(tree, bound), key) {\n      Ordering::Less => bound\n      Ordering::Equal, Ordering::Greater => tree_predecessor_index(tree, bound)\n    }\n  }\n  if node < 0 {\n    Option::None\n  } else {\n    Option::Some(tree_entry(tree, node))\n  }\n}\n\npub fn red_black_tree_successor<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  key: k,\n) -> Option<TreeEntry<k, v>> {\n  red_black_tree_upper_bound(tree, key)\n}\n\npub fn tree_entry_key<k, v>(entry: TreeEntry<k, v>) -> k {\n  entry.key\n}\n\npub fn tree_entry_value<k, v>(entry: TreeEntry<k, v>) -> v {\n  entry.value\n}\n\npub fn red_black_tree_clear<k, v, c>(\n  tree: RedBlackTree<k, v, c>,\n) -> Unit {\n  array_clear(tree.keys)\n  array_clear(tree.values)\n  array_clear(tree.parents)\n  array_clear(tree.lefts)\n  array_clear(tree.rights)\n  array_clear(tree.reds)\n  array_clear(tree.active)\n  tree_set_root(tree, -1)\n  tree_set_live(tree, 0u32)\n}\n\nfn tree_iter_start<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  lower: Option<k>,\n  lower_inclusive: Bool,\n) -> I32 {\n  match lower {\n    Option::Some(key) => tree_lower_bound_index(tree, key, lower_inclusive)\n    Option::None => tree_minimum_index(tree, tree_root(tree))\n  }\n}\n\npub fn red_black_tree_range<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n  lower: Option<k>,\n  lower_inclusive: Bool,\n  upper: Option<k>,\n  upper_inclusive: Bool,\n) -> RedBlackTreeIter<k, v, c> {\n  RedBlackTreeIter {\n    tree: tree\n    current: tree_i32_box(tree_iter_start(tree, lower, lower_inclusive))\n    upper: upper\n    upper_inclusive: upper_inclusive\n  }\n}\n\npub fn red_black_tree_iter<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n) -> RedBlackTreeIter<k, v, c> {\n  red_black_tree_range(tree, Option::None, true, Option::None, true)\n}\n\npub fn red_black_tree_iter_has_next<k, v, c: Comparator<k>>(\n  iter: RedBlackTreeIter<k, v, c>,\n) -> Bool {\n  let node = array_get_unchecked(iter.current, 0u32)\n  if node < 0 {\n    false\n  } else {\n    match iter.upper {\n      Option::None => true\n      Option::Some(upper) =>\n        match iter.tree.comparator.compare(tree_key(iter.tree, node), upper) {\n          Ordering::Less => true\n          Ordering::Equal => iter.upper_inclusive\n          Ordering::Greater => false\n        }\n    }\n  }\n}\n\npub fn red_black_tree_iter_next<k, v, c: Comparator<k>>(\n  iter: RedBlackTreeIter<k, v, c>,\n) -> TreeEntry<k, v> {\n  if red_black_tree_iter_has_next(iter) {\n    let node = array_get_unchecked(iter.current, 0u32)\n    let result = tree_entry(iter.tree, node)\n    array_set_unchecked(\n      iter.current,\n      0u32,\n      tree_successor_index(iter.tree, node),\n    )\n    result\n  } else {\n    unreachable()\n  }\n}\n\npub fn red_black_tree_validate<k, v, c: Comparator<k>>(\n  tree: RedBlackTree<k, v, c>,\n) -> Bool {\n  let root = tree_root(tree)\n  if root >= 0 && tree_is_red(tree, root) {\n    false\n  } else {\n    let nodes = array_new()\n    let blacks = array_new()\n    array_push(nodes, root)\n    array_push(blacks, 0u32)\n    let mut cursor = 0u32\n    let mut expected_black = 4294967295u32\n    let mut visited = 0u32\n    let mut valid = true\n    while true {\n      true if cursor < array_length(nodes) => {\n        let node = array_get_unchecked(nodes, cursor)\n        let black = array_get_unchecked(blacks, cursor)\n        cursor = cursor + 1u32\n        if node < 0 {\n          if expected_black == 4294967295u32 {\n            expected_black = black\n          } else if expected_black != black {\n            valid = false\n          } else {\n            tree_unit()\n          }\n        } else {\n          visited = visited + 1u32\n          let left = tree_left(tree, node)\n          let right = tree_right(tree, node)\n          if tree_is_red(tree, node) &&\n            (tree_is_red(tree, left) || tree_is_red(tree, right)) {\n            valid = false\n          } else {\n            tree_unit()\n          }\n          if left >= 0 && tree_parent(tree, left) != node {\n            valid = false\n          } else {\n            tree_unit()\n          }\n          if right >= 0 && tree_parent(tree, right) != node {\n            valid = false\n          } else {\n            tree_unit()\n          }\n          let next_black = black + if tree_is_red(tree, node) {\n            0u32\n          } else {\n            1u32\n          }\n          array_push(nodes, left)\n          array_push(blacks, next_black)\n          array_push(nodes, right)\n          array_push(blacks, next_black)\n        }\n        continue true\n      }\n      _ => break tree_unit()\n    }\n    if visited != tree_live(tree) {\n      valid = false\n    } else {\n      tree_unit()\n    }\n    let iter = red_black_tree_iter(tree)\n    let mut previous = tree_no_key()\n    while true {\n      true if red_black_tree_iter_has_next(iter) => {\n        let entry = red_black_tree_iter_next(iter)\n        match previous {\n          Option::Some(key) =>\n            match tree.comparator.compare(key, entry.key) {\n              Ordering::Less => tree_unit()\n              Ordering::Equal, Ordering::Greater => {\n                valid = false\n                tree_unit()\n              }\n            }\n          Option::None => tree_unit()\n        }\n        previous = Option::Some(entry.key)\n        continue true\n      }\n      _ => break tree_unit()\n    }\n    valid\n  }\n}\n"
}

///|
pub fn standard_priority_queue_source() -> Bytes {
  b"open dew.std.ordering\nopen dew.std.collections.binary_heap\n\npub struct PriorityItem<t, p> {\n  value: t\n  priority: p\n}\n\npub struct PriorityItemComparator<t, p, c> {\n  comparator: c\n}\n\nimpl<t, p, c: Comparator<p>> Comparator<PriorityItem<t, p>> for PriorityItemComparator<t, p, c> {\n  fn compare(\n    self,\n    left: PriorityItem<t, p>,\n    right: PriorityItem<t, p>,\n  ) -> Ordering {\n    self.comparator.compare(left.priority, right.priority)\n  }\n}\n\npub struct PriorityQueue<t, p, c> {\n  heap: BinaryHeap<PriorityItem<t, p>, PriorityItemComparator<t, p, c>>\n}\n\npub struct PriorityQueueIter<t, p> {\n  inner: BinaryHeapIter<PriorityItem<t, p>>\n}\n\npub fn priority_queue_new<t, p, c: Comparator<p>>(\n  comparator: c,\n  order: HeapOrder,\n) -> PriorityQueue<t, p, c> {\n  PriorityQueue::{\n    heap: binary_heap_new(PriorityItemComparator::{\n      comparator: comparator\n    }, order)\n  }\n}\n\npub fn priority_queue_with_capacity<t, p, c: Comparator<p>>(\n  comparator: c,\n  order: HeapOrder,\n  capacity: U32,\n) -> PriorityQueue<t, p, c> {\n  PriorityQueue::{\n    heap: binary_heap_with_capacity(PriorityItemComparator::{\n      comparator: comparator\n    }, order, capacity)\n  }\n}\n\npub fn priority_queue_length<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> U32 {\n  binary_heap_length(queue.heap)\n}\n\npub fn priority_queue_capacity<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> U32 {\n  binary_heap_capacity(queue.heap)\n}\n\npub fn priority_queue_is_empty<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> Bool {\n  binary_heap_is_empty(queue.heap)\n}\n\npub fn priority_queue_enqueue<t, p, c: Comparator<p>>(\n  queue: PriorityQueue<t, p, c>,\n  value: t,\n  priority: p,\n) -> Unit {\n  binary_heap_push(queue.heap, PriorityItem::{\n    value: value\n    priority: priority\n  })\n}\n\npub fn priority_queue_peek<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> Option<PriorityItem<t, p>> {\n  binary_heap_peek(queue.heap)\n}\n\npub fn priority_queue_dequeue<t, p, c: Comparator<p>>(\n  queue: PriorityQueue<t, p, c>,\n) -> Option<PriorityItem<t, p>> {\n  binary_heap_pop(queue.heap)\n}\n\npub fn priority_queue_clear<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> Unit {\n  binary_heap_clear(queue.heap)\n}\n\npub fn priority_item_value<t, p>(item: PriorityItem<t, p>) -> t {\n  item.value\n}\n\npub fn priority_item_priority<t, p>(item: PriorityItem<t, p>) -> p {\n  item.priority\n}\n\npub fn priority_queue_iter<t, p, c>(\n  queue: PriorityQueue<t, p, c>,\n) -> PriorityQueueIter<t, p> {\n  PriorityQueueIter::{\n    inner: binary_heap_iter(queue.heap)\n  }\n}\n\npub fn priority_queue_iter_has_next<t, p>(\n  iter: PriorityQueueIter<t, p>,\n) -> Bool {\n  binary_heap_iter_has_next(iter.inner)\n}\n\npub fn priority_queue_iter_next<t, p>(\n  iter: PriorityQueueIter<t, p>,\n) -> PriorityItem<t, p> {\n  binary_heap_iter_next(iter.inner)\n}\n"
}

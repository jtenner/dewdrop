///|
pub fn standard_btree_source() -> Bytes {
  b"open dew.std.ordering\nopen dew.std.types\nopen dew.std.wasm.intrinsics\nopen dew.std.string_builder\n// Modeled payload budgets, not GC heap page sizes.\npub struct BTreeConfig {\n  private leaf_bytes: U32\n  private inline_branch_bytes: U32\n  private plain_branch_bytes: U32\n}\nfn btree_budget_valid(bytes: U32, minimum: U32) -> Bool {\n  bytes >= minimum && (bytes & (bytes - 1u32)) == 0u32\n}\npub fn btree_config(leaf_bytes: U32, inline_branch_bytes: U32, plain_branch_bytes: U32) -> BTreeConfig {\n  if !(btree_budget_valid(leaf_bytes, 1024u32)) {\n    assert(false, \"BTreeConfig: leaf budget must be a power of two >= 1024\")\n  }\n  if !(btree_budget_valid(inline_branch_bytes, 64u32)) {\n    assert(false, \"BTreeConfig: inline branch budget must be a power of two >= 64\")\n  }\n  if !(btree_budget_valid(plain_branch_bytes, 64u32)) {\n    assert(false, \"BTreeConfig: plain branch budget must be a power of two >= 64\")\n  }\n  BTreeConfig::{\n    leaf_bytes: leaf_bytes\n    inline_branch_bytes: inline_branch_bytes\n    plain_branch_bytes: plain_branch_bytes\n  }\n}\npub fn btree_default_config() -> BTreeConfig {\n  btree_config(1024u32, 512u32, 1024u32)\n}\nimpl BTreeConfig {\n  fn leaf_bytes(self) -> U32 {\n    self.leaf_bytes\n  }\n  fn inline_branch_bytes(self) -> U32 {\n    self.inline_branch_bytes\n  }\n  fn plain_branch_bytes(self) -> U32 {\n    self.plain_branch_bytes\n  }\n}\npub enum BTreeInlineWidth {\n  Two\n  Four\n  Eight\n}\npub trait InlineKey<k> {\n  fn inline_key_at(self, key: k, offset: U32) -> U64\n  fn inline_width(self) -> BTreeInlineWidth\n}\npub trait InlineKeyHash<k> {\n  fn inline_hash_tag(self, key: k) -> U8\n}\npub trait InlineKeyCompareFrom<k> {\n  fn compare_from(self, left: k, right: k, equal_bytes: U32) -> Ordering\n}\npub trait InlineKeyPrefix<k> {\n  fn compare_prefix(self, key: k, prefix: BTreeInlinePrefix) -> Ordering\n}\npub trait InlineKeyLength<k> {\n  fn inline_encoding_length(self, key: k) -> U32\n}\n// One object. Provider callbacks get this object without a new byte view.\npub struct BTreeInlinePrefix {\n  private mut first: V128\n  private mut second: V128\n  private mut third: V128\n  private mut fourth: V128\n  private mut length: U32\n}\nimpl BTreeInlinePrefix {\n  fn byte_length(self) -> U32 {\n    self.length\n  }\n  fn window_at(self, offset: U32) -> U64 {\n    if offset >= self.length {\n      0u64\n    } else {\n      let index = offset / 8u32\n      let shift = btree_widen(offset % 8u32) * 8u64\n      let first = btree_prefix_word(self, index)\n      let word = if shift == 0u64 {\n        first\n      } else {\n        let second = if index < 7u32 {\n          btree_prefix_word(self, index + 1u32)\n        } else {\n          0u64\n        }\n        (first << shift) | (second >> (64u64 - shift))\n      }\n      let remaining = self.length - offset\n      if remaining >= 8u32 {\n        word\n      } else {\n        word & (18446744073709551615u64 << ((8u64 - btree_widen(remaining)) * 8u64))\n      }\n    }\n  }\n}\nfn btree_prefix_word(prefix: BTreeInlinePrefix, index: U32) -> U64 {\n  if !(index < 8u32) {\n    assert(false, \"BTree prefix word: index exceeds four V128 fields\")\n  }\n  let block = if index < 2u32 {\n    prefix.first\n  } else if index < 4u32 {\n    prefix.second\n  } else if index < 6u32 {\n    prefix.third\n  } else {\n    prefix.fourth\n  }\n  btree_extract64(block, index % 2u32)\n}\nfn btree_prefix_new<k, c: InlineKey<k>>(comparator: c, key: k) -> BTreeInlinePrefix {\n  BTreeInlinePrefix::{\n    first: unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_1(wasm_u64x2_splat(comparator.inline_key_at(key, 0u32)), comparator.inline_key_at(key, 8u32)))\n    second: unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_1(wasm_u64x2_splat(comparator.inline_key_at(key, 16u32)), comparator.inline_key_at(key, 24u32)))\n    third: unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_1(wasm_u64x2_splat(comparator.inline_key_at(key, 32u32)), comparator.inline_key_at(key, 40u32)))\n    fourth: unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_1(wasm_u64x2_splat(comparator.inline_key_at(key, 48u32)), comparator.inline_key_at(key, 56u32)))\n    length: btree_initial_prefix_length(comparator, key)\n  }\n}\nfn btree_width_bytes(width: BTreeInlineWidth) -> U32 {\n  match width {\n    BTreeInlineWidth::Two => 2u32\n    BTreeInlineWidth::Four => 4u32\n    BTreeInlineWidth::Eight => 8u32\n  }\n}\nfn btree_optional_evidence<k, c>() -> Unit {\n  static_assert(!(implements::<c, InlineKeyHash<k>>() || implements::<c, InlineKeyCompareFrom<k>>() || implements::<c, InlineKeyPrefix<k>>() || implements::<c, InlineKeyLength<k>>()) || implements::<c, InlineKey<k>>(), \"BTree: optional inline evidence requires InlineKey\")\n}\npub struct BTreePlan {\n  private leaf_capacity: U32\n  private branch_capacity: U32\n  private leaf_budget: U64\n  private branch_budget: U64\n  private leaf_width: U32\n  private branch_width: U32\n  private tags: Bool\n  private pair_bytes: U32\n}\nimpl BTreePlan {\n  fn leaf_capacity(self) -> U32 {\n    self.leaf_capacity\n  }\n  fn branch_capacity(self) -> U32 {\n    self.branch_capacity\n  }\n  fn leaf_budget(self) -> U64 {\n    self.leaf_budget\n  }\n  fn branch_budget(self) -> U64 {\n    self.branch_budget\n  }\n  fn leaf_width(self) -> U32 {\n    self.leaf_width\n  }\n  fn branch_width(self) -> U32 {\n    self.branch_width\n  }\n  fn has_tags(self) -> Bool {\n    self.tags\n  }\n  fn pair_bytes(self) -> U32 {\n    self.pair_bytes\n  }\n  fn leaf_minimum(self) -> U32 {\n    btree_minimum(self.leaf_capacity)\n  }\n  fn branch_minimum(self) -> U32 {\n    btree_minimum(self.branch_capacity)\n  }\n  fn leaf_edge_half(self) -> U32 {\n    btree_edge_half(self.leaf_capacity)\n  }\n  fn branch_edge_half(self) -> U32 {\n    btree_edge_half(self.branch_capacity)\n  }\n  fn batch_cutoff(self) -> U64 {\n    let pages = 1048576u64 / self.leaf_budget\n    (if pages > 0u64 {\n      pages\n    } else {\n      1u64\n    }) * ((7u64 * btree_widen(self.leaf_capacity)) / 10u64 + 1u64)\n  }\n}\nfn btree_minimum(capacity: U32) -> U32 {\n  if capacity / 8u32 > 4u32 {\n    capacity / 8u32\n  } else {\n    4u32\n  }\n}\nfn btree_edge_half(capacity: U32) -> U32 {\n  let twice = 2u32 * btree_minimum(capacity)\n  if twice < capacity / 2u32 {\n    twice\n  } else {\n    capacity / 2u32\n  }\n}\nfn btree_slot_bytes<t>() -> U32 {\n  if is_unit::<t>() || type_equal::<t, Bool>() {\n    4u32\n  } else if is_integer::<t>() || is_float::<t>() {\n    if bit_width::<t>() <= 32u32 {\n      4u32\n    } else {\n      8u32\n    }\n  } else if can_bitcast::<t, U32>() {\n    4u32\n  } else if can_bitcast::<t, U64>() {\n    8u32\n  } else if can_bitcast::<t, V128>() {\n    16u32\n  } else {\n    8u32\n  }\n}\nfn btree_pair_bytes<k, v>() -> U32 {\n  if is_unit::<v>() {\n    0u32\n  } else if type_equal::<k, v>() {\n    2u32 * btree_slot_bytes::<k>()\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n      8u32\n    } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n      16u32\n    } else if can_bitcast::<k, V128>() && can_bitcast::<v, V128>() {\n      32u32\n    } else if !can_bitcast::<k, V128>() && !can_bitcast::<v, V128>() {\n      16u32\n    } else {\n      32u32\n    }\n  } else {\n    0u32\n  }\n}\nfn btree_metadata_bytes(capacity: U32, width: U32, tags: Bool) -> U64 {\n  let stride = btree_widen(width)\n  ((btree_widen(capacity) * (stride + (if tags {\n    1u64\n  } else {\n    0u64\n  })) + 15u64) / 16u64) * 16u64\n}\nfn btree_payload(capacity: U32, width: U32, tags: Bool, key_bytes: U32, trailing_bytes: U32, pair_bytes: U32, branch: Bool) -> U64 {\n  let count = btree_widen(capacity)\n  let key = btree_widen(key_bytes)\n  let trailing = btree_widen(trailing_bytes)\n  if width == 0u32 {\n    16u64 + (count + 1u64) * key + (count + 2u64) * trailing\n  } else {\n    let entries = if branch {\n      8u64\n    } else if pair_bytes > 0u32 {\n      btree_widen(pair_bytes)\n    } else {\n      key + trailing\n    }\n    16u64 + (count + 2u64) * entries + btree_metadata_bytes(capacity, width, tags)\n  }\n}\nfn btree_capacity(budget: U64, configured: U32, width: U32, tags: Bool, key: U32, trailing: U32, pair: U32, branch: Bool) -> U32 {\n  let strip = if configured > 1024u32 {\n    configured\n  } else {\n    1024u32\n  }\n  let limit = if width == 0u32 || strip / width > 1023u32 {\n    1023u32\n  } else {\n    strip / width\n  }\n  let mut low = 0u32\n  let mut high = limit + 1u32\n  while true {\n    true if low + 1u32 < high => {\n      let middle = low + (high - low) / 2u32\n      if btree_payload(middle, width, tags, key, trailing, pair, branch) <= budget {\n        low = middle\n      } else {\n        high = middle\n      }\n      continue true\n    }\n    _ => break low\n  }\n}\npub fn btree_plan<k, v, c: Comparator<k>>(comparator: c, config: BTreeConfig) -> BTreePlan {\n  btree_optional_evidence::<k, c>()\n  // Every config has private immutable fields and comes through validation.\n  let width = if implements::<c, InlineKey<k>>() {\n    btree_width_bytes(comparator.inline_width())\n  } else {\n    0u32\n  }\n  let branch_width = if width == 8u32 && implements::<c, InlineKeyCompareFrom<k>>() {\n    4u32\n  } else {\n    width\n  }\n  let key = btree_slot_bytes::<k>()\n  let value = if is_unit::<v>() {\n    0u32\n  } else {\n    btree_slot_bytes::<v>()\n  }\n  let pair = if width > 0u32 {\n    btree_pair_bytes::<k, v>()\n  } else {\n    0u32\n  }\n  let leaf_base = btree_widen(config.leaf_bytes)\n  let leaf_need = btree_payload(12u32, width, false, key, value, pair, false)\n  let leaf_budget = ((leaf_need + leaf_base - 1u64) / leaf_base) * leaf_base\n  let leaf = btree_capacity(leaf_budget, config.leaf_bytes, width, false, key, value, pair, false)\n  let tagged = if width > 0u32 && implements::<c, InlineKeyHash<k>>() {\n    btree_capacity(leaf_budget, config.leaf_bytes, width, true, key, value, pair, false)\n  } else {\n    0u32\n  }\n  let tags = tagged >= 12u32 && tagged + 1u32 >= leaf\n  let branch_configured = if width == 0u32 {\n    config.plain_branch_bytes\n  } else {\n    config.inline_branch_bytes\n  }\n  let branch_base = btree_widen(branch_configured)\n  let branch_need = btree_payload(12u32, branch_width, false, key, 8u32, 0u32, true)\n  let branch_budget = ((branch_need + branch_base - 1u64) / branch_base) * branch_base\n  let branch = btree_capacity(branch_budget, branch_configured, branch_width, false, key, 8u32, 0u32, true)\n  if !(leaf >= 12u32 && branch >= 12u32) {\n    assert(false, \"BTree plan: minimum capacity 12 must fit\")\n  }\n  BTreePlan::{\n    leaf_capacity: if tags {\n      tagged\n    } else {\n      leaf\n    }\n    branch_capacity: branch\n    leaf_budget: leaf_budget\n    branch_budget: branch_budget\n    leaf_width: width\n    branch_width: branch_width\n    tags: tags\n    pair_bytes: pair\n  }\n}\nfn btree_integer_window(word: U64, offset: U32) -> U64 {\n  if offset >= 8u32 {\n    0u64\n  } else {\n    word << (btree_widen(offset) * 8u64)\n  }\n}\nimpl InlineKey<U64> for NaturalComparator {\n  fn inline_key_at(self, key: U64, offset: U32) -> U64 {\n    btree_integer_window(key, offset)\n  }\n  fn inline_width(self) -> BTreeInlineWidth {\n    BTreeInlineWidth::Two\n  }\n}\nimpl InlineKey<I64> for NaturalComparator {\n  fn inline_key_at(self, key: I64, offset: U32) -> U64 {\n    btree_integer_window(unsafe_bitcast::<I64, U64>(key) ^ 9223372036854775808u64, offset)\n  }\n  fn inline_width(self) -> BTreeInlineWidth {\n    BTreeInlineWidth::Two\n  }\n}\nimpl InlineKeyLength<U64> for NaturalComparator {\n  fn inline_encoding_length(self, key: U64) -> U32 {\n    8u32\n  }\n}\nimpl InlineKeyLength<I64> for NaturalComparator {\n  fn inline_encoding_length(self, key: I64) -> U32 {\n    8u32\n  }\n}\nimpl InlineKey<String> for StringComparator {\n  fn inline_key_at(self, key: String, offset: U32) -> U64 {\n    let length = ordering_string_byte_length(key)\n    let mut word = 0u64\n    while 0u32 {\n      i if i < 8u32 => {\n        let byte = if offset < length && i < length - offset {\n          ordering_string_byte_at(key, offset + i).into()\n        } else {\n          0u64\n        }\n        word = (word << 8u64) | byte\n        continue i + 1u32\n      }\n      _ => break word\n    }\n  }\n  fn inline_width(self) -> BTreeInlineWidth {\n    BTreeInlineWidth::Eight\n  }\n}\nimpl InlineKeyHash<String> for StringComparator {\n  fn inline_hash_tag(self, key: String) -> U8 {\n    let length = ordering_string_byte_length(key)\n    (if length < 255u32 {\n      length\n    } else {\n      255u32\n    }).into()\n  }\n}\nimpl InlineKeyLength<String> for StringComparator {\n  fn inline_encoding_length(self, key: String) -> U32 {\n    ordering_string_byte_length(key)\n  }\n}\nimpl InlineKeyCompareFrom<String> for StringComparator {\n  fn compare_from(self, left: String, right: String, equal_bytes: U32) -> Ordering {\n    let left_length = ordering_string_byte_length(left)\n    let right_length = ordering_string_byte_length(right)\n    let limit = if left_length < right_length {\n      left_length\n    } else {\n      right_length\n    }\n    while equal_bytes {\n      i if i < limit => {\n        let a = ordering_string_byte_at(left, i)\n        let b = ordering_string_byte_at(right, i)\n        if a < b {\n          break Ordering::Less\n        } else if a > b {\n          break Ordering::Greater\n        } else {\n          continue i + 1u32\n        }\n      }\n      _ => break if left_length < right_length {\n        Ordering::Less\n      } else if left_length > right_length {\n        Ordering::Greater\n      } else {\n        Ordering::Equal\n      }\n    }\n  }\n}\nimpl InlineKeyPrefix<String> for StringComparator {\n  fn compare_prefix(self, key: String, prefix: BTreeInlinePrefix) -> Ordering {\n    btree_compare_padded_prefix(self, key, prefix)\n  }\n}\nimpl InlineKey<StringView> for StringViewComparator {\n  fn inline_key_at(self, key: StringView, offset: U32) -> U64 {\n    let length = ordering_string_view_byte_length(key)\n    let mut word = 0u64\n    while 0u32 {\n      i if i < 8u32 => {\n        let byte = if offset < length && i < length - offset {\n          ordering_string_view_byte_at(key, offset + i).into()\n        } else {\n          0u64\n        }\n        word = (word << 8u64) | byte\n        continue i + 1u32\n      }\n      _ => break word\n    }\n  }\n  fn inline_width(self) -> BTreeInlineWidth {\n    BTreeInlineWidth::Eight\n  }\n}\nimpl InlineKeyHash<StringView> for StringViewComparator {\n  fn inline_hash_tag(self, key: StringView) -> U8 {\n    let length = ordering_string_view_byte_length(key)\n    (if length < 255u32 {\n      length\n    } else {\n      255u32\n    }).into()\n  }\n}\nimpl InlineKeyLength<StringView> for StringViewComparator {\n  fn inline_encoding_length(self, key: StringView) -> U32 {\n    ordering_string_view_byte_length(key)\n  }\n}\nimpl InlineKeyCompareFrom<StringView> for StringViewComparator {\n  fn compare_from(self, left: StringView, right: StringView, equal_bytes: U32) -> Ordering {\n    let left_length = ordering_string_view_byte_length(left)\n    let right_length = ordering_string_view_byte_length(right)\n    let limit = if left_length < right_length {\n      left_length\n    } else {\n      right_length\n    }\n    while equal_bytes {\n      i if i < limit => {\n        let a = ordering_string_view_byte_at(left, i)\n        let b = ordering_string_view_byte_at(right, i)\n        if a < b {\n          break Ordering::Less\n        } else if a > b {\n          break Ordering::Greater\n        } else {\n          continue i + 1u32\n        }\n      }\n      _ => break if left_length < right_length {\n        Ordering::Less\n      } else if left_length > right_length {\n        Ordering::Greater\n      } else {\n        Ordering::Equal\n      }\n    }\n  }\n}\nimpl InlineKeyPrefix<StringView> for StringViewComparator {\n  fn compare_prefix(self, key: StringView, prefix: BTreeInlinePrefix) -> Ordering {\n    btree_compare_padded_prefix(self, key, prefix)\n  }\n}\nimpl InlineKey<Bytes> for BytesComparator {\n  fn inline_key_at(self, key: Bytes, offset: U32) -> U64 {\n    let length = ordering_bytes_byte_length(key)\n    let mut word = 0u64\n    while 0u32 {\n      i if i < 8u32 => {\n        let byte = if offset < length && i < length - offset {\n          ordering_bytes_byte_at(key, offset + i).into()\n        } else {\n          0u64\n        }\n        word = (word << 8u64) | byte\n        continue i + 1u32\n      }\n      _ => break word\n    }\n  }\n  fn inline_width(self) -> BTreeInlineWidth {\n    BTreeInlineWidth::Eight\n  }\n}\nimpl InlineKeyHash<Bytes> for BytesComparator {\n  fn inline_hash_tag(self, key: Bytes) -> U8 {\n    let length = ordering_bytes_byte_length(key)\n    (if length < 255u32 {\n      length\n    } else {\n      255u32\n    }).into()\n  }\n}\nimpl InlineKeyLength<Bytes> for BytesComparator {\n  fn inline_encoding_length(self, key: Bytes) -> U32 {\n    ordering_bytes_byte_length(key)\n  }\n}\nimpl InlineKeyCompareFrom<Bytes> for BytesComparator {\n  fn compare_from(self, left: Bytes, right: Bytes, equal_bytes: U32) -> Ordering {\n    let left_length = ordering_bytes_byte_length(left)\n    let right_length = ordering_bytes_byte_length(right)\n    let limit = if left_length < right_length {\n      left_length\n    } else {\n      right_length\n    }\n    while equal_bytes {\n      i if i < limit => {\n        let a = ordering_bytes_byte_at(left, i)\n        let b = ordering_bytes_byte_at(right, i)\n        if a < b {\n          break Ordering::Less\n        } else if a > b {\n          break Ordering::Greater\n        } else {\n          continue i + 1u32\n        }\n      }\n      _ => break if left_length < right_length {\n        Ordering::Less\n      } else if left_length > right_length {\n        Ordering::Greater\n      } else {\n        Ordering::Equal\n      }\n    }\n  }\n}\nimpl InlineKeyPrefix<Bytes> for BytesComparator {\n  fn compare_prefix(self, key: Bytes, prefix: BTreeInlinePrefix) -> Ordering {\n    btree_compare_padded_prefix(self, key, prefix)\n  }\n}\nfn btree_compare_padded_prefix<k, c: InlineKey<k>>(comparator: c, key: k, prefix: BTreeInlinePrefix) -> Ordering {\n  while 0u32 {\n    offset if offset < prefix.byte_length() => {\n      let remaining = prefix.byte_length() - offset\n      let mask = if remaining >= 8u32 {\n        18446744073709551615u64\n      } else {\n        18446744073709551615u64 << ((8u64 - btree_widen(remaining)) * 8u64)\n      }\n      let left = comparator.inline_key_at(key, offset) & mask\n      let right = prefix.window_at(offset)\n      if left < right {\n        break Ordering::Less\n      } else if left > right {\n        break Ordering::Greater\n      } else {\n        continue offset + 8u32\n      }\n    }\n    _ => break Ordering::Equal\n  }\n}\nfn btree_compare_from<k, c: Comparator<k>>(comparator: c, left: k, right: k, equal_bytes: U32) -> Ordering {\n  if implements::<c, InlineKeyCompareFrom<k>>() {\n    comparator.compare_from(left, right, equal_bytes)\n  } else {\n    comparator.compare(left, right)\n  }\n}\nfn btree_compare_prefix<k, c: InlineKey<k>>(comparator: c, key: k, prefix: BTreeInlinePrefix) -> Ordering {\n  if implements::<c, InlineKeyPrefix<k>>() {\n    comparator.compare_prefix(key, prefix)\n  } else {\n    btree_compare_padded_prefix(comparator, key, prefix)\n  }\n}\nfn btree_initial_prefix_length<k, c: InlineKey<k>>(comparator: c, key: k) -> U32 {\n  if implements::<c, InlineKeyLength<k>>() {\n    let length = comparator.inline_encoding_length(key)\n    if length < 64u32 {\n      length\n    } else {\n      64u32\n    }\n  } else {\n    64u32\n  }\n}\nfn btree_extract_byte(block: V128, lane: U32) -> U8 {\n  let view = unsafe_bitcast::<V128, U8x16>(block)\n  match lane {\n    0u32 => wasm_u8x16_extract_0(view)\n    1u32 => wasm_u8x16_extract_1(view)\n    2u32 => wasm_u8x16_extract_2(view)\n    3u32 => wasm_u8x16_extract_3(view)\n    4u32 => wasm_u8x16_extract_4(view)\n    5u32 => wasm_u8x16_extract_5(view)\n    6u32 => wasm_u8x16_extract_6(view)\n    7u32 => wasm_u8x16_extract_7(view)\n    8u32 => wasm_u8x16_extract_8(view)\n    9u32 => wasm_u8x16_extract_9(view)\n    10u32 => wasm_u8x16_extract_10(view)\n    11u32 => wasm_u8x16_extract_11(view)\n    12u32 => wasm_u8x16_extract_12(view)\n    13u32 => wasm_u8x16_extract_13(view)\n    14u32 => wasm_u8x16_extract_14(view)\n    15u32 => wasm_u8x16_extract_15(view)\n    _ => unreachable()\n  }\n}\nfn btree_replacebyte(block: V128, lane: U32, value: U8) -> V128 {\n  let view = unsafe_bitcast::<V128, U8x16>(block)\n  unsafe_bitcast::<U8x16, V128>(match lane {\n    0u32 => wasm_u8x16_replace_0(view, value)\n    1u32 => wasm_u8x16_replace_1(view, value)\n    2u32 => wasm_u8x16_replace_2(view, value)\n    3u32 => wasm_u8x16_replace_3(view, value)\n    4u32 => wasm_u8x16_replace_4(view, value)\n    5u32 => wasm_u8x16_replace_5(view, value)\n    6u32 => wasm_u8x16_replace_6(view, value)\n    7u32 => wasm_u8x16_replace_7(view, value)\n    8u32 => wasm_u8x16_replace_8(view, value)\n    9u32 => wasm_u8x16_replace_9(view, value)\n    10u32 => wasm_u8x16_replace_10(view, value)\n    11u32 => wasm_u8x16_replace_11(view, value)\n    12u32 => wasm_u8x16_replace_12(view, value)\n    13u32 => wasm_u8x16_replace_13(view, value)\n    14u32 => wasm_u8x16_replace_14(view, value)\n    15u32 => wasm_u8x16_replace_15(view, value)\n    _ => unreachable()\n  })\n}\nfn btree_extract16(block: V128, lane: U32) -> U16 {\n  let view = unsafe_bitcast::<V128, U16x8>(block)\n  match lane {\n    0u32 => wasm_u16x8_extract_0(view)\n    1u32 => wasm_u16x8_extract_1(view)\n    2u32 => wasm_u16x8_extract_2(view)\n    3u32 => wasm_u16x8_extract_3(view)\n    4u32 => wasm_u16x8_extract_4(view)\n    5u32 => wasm_u16x8_extract_5(view)\n    6u32 => wasm_u16x8_extract_6(view)\n    7u32 => wasm_u16x8_extract_7(view)\n    _ => unreachable()\n  }\n}\nfn btree_replace16(block: V128, lane: U32, value: U16) -> V128 {\n  let view = unsafe_bitcast::<V128, U16x8>(block)\n  unsafe_bitcast::<U16x8, V128>(match lane {\n    0u32 => wasm_u16x8_replace_0(view, value)\n    1u32 => wasm_u16x8_replace_1(view, value)\n    2u32 => wasm_u16x8_replace_2(view, value)\n    3u32 => wasm_u16x8_replace_3(view, value)\n    4u32 => wasm_u16x8_replace_4(view, value)\n    5u32 => wasm_u16x8_replace_5(view, value)\n    6u32 => wasm_u16x8_replace_6(view, value)\n    7u32 => wasm_u16x8_replace_7(view, value)\n    _ => unreachable()\n  })\n}\nfn btree_extract32(block: V128, lane: U32) -> U32 {\n  let view = unsafe_bitcast::<V128, U32x4>(block)\n  match lane {\n    0u32 => wasm_u32x4_extract_0(view)\n    1u32 => wasm_u32x4_extract_1(view)\n    2u32 => wasm_u32x4_extract_2(view)\n    3u32 => wasm_u32x4_extract_3(view)\n    _ => unreachable()\n  }\n}\nfn btree_replace32(block: V128, lane: U32, value: U32) -> V128 {\n  let view = unsafe_bitcast::<V128, U32x4>(block)\n  unsafe_bitcast::<U32x4, V128>(match lane {\n    0u32 => wasm_u32x4_replace_0(view, value)\n    1u32 => wasm_u32x4_replace_1(view, value)\n    2u32 => wasm_u32x4_replace_2(view, value)\n    3u32 => wasm_u32x4_replace_3(view, value)\n    _ => unreachable()\n  })\n}\nfn btree_extract64(block: V128, lane: U32) -> U64 {\n  let view = unsafe_bitcast::<V128, U64x2>(block)\n  match lane {\n    0u32 => wasm_u64x2_extract_0(view)\n    1u32 => wasm_u64x2_extract_1(view)\n    _ => unreachable()\n  }\n}\nfn btree_replace64(block: V128, lane: U32, value: U64) -> V128 {\n  let view = unsafe_bitcast::<V128, U64x2>(block)\n  unsafe_bitcast::<U64x2, V128>(match lane {\n    0u32 => wasm_u64x2_replace_0(view, value)\n    1u32 => wasm_u64x2_replace_1(view, value)\n    _ => unreachable()\n  })\n}\nfn btree_metadata_new(capacity: U32, width: U32, tags: Bool) -> WasmArray<V128> {\n  let blocks = (btree_metadata_bytes(capacity, width, tags) / 16u64).into()\n  let slots = wasm_array_new_default::<V128>(blocks)\n  let sentinel = unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(18446744073709551615u64))\n  while 0u32 {\n    i if i < blocks => {\n      wasm_array_set(slots, i, sentinel)\n      continue i + 1u32\n    }\n    _ => break ()\n  }\n  slots\n}\nfn btree_window_set(slots: WasmArray<V128>, width: U32, index: U32, word: U64) -> Unit {\n  let byte = index * width\n  let block = wasm_array_get(slots, byte / 16u32)\n  let changed = if width == 2u32 {\n    btree_replace16(block, (byte % 16u32) / 2u32, (word >> 48u64).into())\n  } else if width == 4u32 {\n    btree_replace32(block, (byte % 16u32) / 4u32, (word >> 32u64).into())\n  } else {\n    btree_replace64(block, (byte % 16u32) / 8u32, word)\n  }\n  wasm_array_set(slots, byte / 16u32, changed)\n}\nfn btree_window_get(slots: WasmArray<V128>, width: U32, index: U32) -> U64 {\n  let byte = index * width\n  let block = wasm_array_get(slots, byte / 16u32)\n  if width == 2u32 {\n    btree_u16_word(btree_extract16(block, (byte % 16u32) / 2u32)) << 48u64\n  } else if width == 4u32 {\n    btree_widen(btree_extract32(block, (byte % 16u32) / 4u32)) << 32u64\n  } else {\n    btree_extract64(block, (byte % 16u32) / 8u32)\n  }\n}\nfn btree_tag_set(slots: WasmArray<V128>, capacity: U32, width: U32, index: U32, tag: U8) -> Unit {\n  if !(index < capacity) {\n    assert(false, \"BTree tag write: index must be below capacity\")\n  }\n  let byte = capacity * width + index\n  wasm_array_set(slots, byte / 16u32, btree_replacebyte(wasm_array_get(slots, byte / 16u32), byte % 16u32, tag))\n}\nfn btree_tag_get(slots: WasmArray<V128>, capacity: U32, width: U32, index: U32) -> U8 {\n  if !(index < capacity) {\n    assert(false, \"BTree tag read: index must be below capacity\")\n  }\n  let byte = capacity * width + index\n  btree_extract_byte(wasm_array_get(slots, byte / 16u32), byte % 16u32)\n}\nfn btree_metadata_move(slots: WasmArray<V128>, capacity: U32, width: U32, tags: Bool, destination: U32, source: U32, count: U32) -> Unit {\n  if !(source <= capacity && count <= capacity - source && destination <= capacity && count <= capacity - destination) {\n    assert(false, \"BTree metadata move: run exceeds capacity\")\n  }\n  while 0u32 {\n    step if step < count => {\n      let i = if destination > source {\n        count - step - 1u32\n      } else {\n        step\n      }\n      btree_window_set(slots, width, destination + i, btree_window_get(slots, width, source + i))\n      if tags {\n        btree_tag_set(slots, capacity, width, destination + i, btree_tag_get(slots, capacity, width, source + i))\n      }\n      continue step + 1u32\n    }\n    _ => break ()\n  }\n  if destination > source {\n    let gap = destination - source\n    btree_metadata_clear(slots, capacity, width, tags, source, if gap < count {\n      gap\n    } else {\n      count\n    })\n  } else if source > destination {\n    let gap = source - destination\n    let clear = if gap < count {\n      gap\n    } else {\n      count\n    }\n    btree_metadata_clear(slots, capacity, width, tags, source + count - clear, clear)\n  }\n}\nfn btree_metadata_clear(slots: WasmArray<V128>, capacity: U32, width: U32, tags: Bool, start: U32, count: U32) -> Unit {\n  if !(start <= capacity && count <= capacity - start) {\n    assert(false, \"BTree metadata clear: run exceeds capacity\")\n  }\n  while 0u32 {\n    i if i < count => {\n      btree_window_set(slots, width, start + i, 18446744073709551615u64)\n      if tags {\n        btree_tag_set(slots, capacity, width, start + i, 0u8)\n      }\n      continue i + 1u32\n    }\n    _ => break ()\n  }\n}\nfn btree_widen(value: U32) -> U64 {\n  value.into()\n}\nfn btree_u16_word(value: U16) -> U64 {\n  value.into()\n}\n// Array references are immutable. Counts and head state guard all live reads.\nstruct BTreePlainLeaf<k, v> {\n  private keys: WasmArray<k>\n  private values: WasmArray<v>\n}\nstruct BTreeKeyLeaf<k> {\n  private keys: WasmArray<k>\n}\nenum BTreeLeafStorage<k, v> {\n  Same(WasmArray<k>)\n  Pair32(WasmArray<U32>)\n  Pair64(WasmArray<U64>)\n  Pair128(WasmArray<V128>)\n  Columns(BTreePlainLeaf<k, v>)\n  Keys(BTreeKeyLeaf<k>)\n}\nstruct BTreeInlineLeaf<k, v> {\n  private entries: BTreeLeafStorage<k, v>\n  private metadata: WasmArray<V128>\n}\nstruct BTreePlainBranch<k, v> {\n  private keys: WasmArray<k>\n  private children: WasmArray<BTreeNode<k, v>>\n}\nstruct BTreeInlineBranch<k, v> {\n  private children: WasmArray<BTreeNode<k, v>>\n  private metadata: WasmArray<V128>\n}\nenum BTreeBody<k, v> {\n  PlainLeaf(BTreePlainLeaf<k, v>)\n  PlainKeys(BTreeKeyLeaf<k>)\n  InlineLeaf(BTreeInlineLeaf<k, v>)\n  PlainBranch(BTreePlainBranch<k, v>)\n  InlineBranch(BTreeInlineBranch<k, v>)\n}\nstruct BTreeNode<k, v> {\n  private mut count: U32\n  private mut prefix: U32\n  private mut head: Bool\n  private body: BTreeBody<k, v>\n}\nfn btree_leaf_storage<k, v>(capacity: U32) -> BTreeLeafStorage<k, v> {\n  if is_unit::<v>() {\n    BTreeLeafStorage::Keys(BTreeKeyLeaf::{\n      keys: wasm_array_new_default::<k>(capacity + 2u32)\n    })\n  } else if type_equal::<k, v>() {\n    BTreeLeafStorage::Same(wasm_array_new_default::<k>(2u32 * (capacity + 2u32)))\n  } else if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n    BTreeLeafStorage::Pair32(wasm_array_new_default::<U32>(2u32 * (capacity + 2u32)))\n  } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n    BTreeLeafStorage::Pair64(wasm_array_new_default::<U64>(2u32 * (capacity + 2u32)))\n  } else if can_bitcast::<k, V128>() && can_bitcast::<v, V128>() {\n    BTreeLeafStorage::Pair128(wasm_array_new_default::<V128>(2u32 * (capacity + 2u32)))\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    let stride = if can_bitcast::<k, V128>() || can_bitcast::<v, V128>() {\n      2u32\n    } else {\n      1u32\n    }\n    BTreeLeafStorage::Pair128(wasm_array_new_default::<V128>(stride * (capacity + 2u32)))\n  } else {\n    BTreeLeafStorage::Columns(BTreePlainLeaf::{\n      keys: wasm_array_new_default::<k>(capacity + 2u32)\n      values: wasm_array_new_default::<v>(capacity + 2u32)\n    })\n  }\n}\nfn btree_node_new<k, v>(plan: BTreePlan, branch: Bool) -> BTreeNode<k, v> {\n  let body = if branch {\n    let children = wasm_array_new_default::<BTreeNode<k, v>>(plan.branch_capacity + 2u32)\n    if plan.branch_width > 0u32 {\n      BTreeBody::InlineBranch(BTreeInlineBranch::{\n        children: children\n        metadata: btree_metadata_new(plan.branch_capacity, plan.branch_width, false)\n      })\n    } else {\n      BTreeBody::PlainBranch(BTreePlainBranch::{\n        keys: wasm_array_new_default::<k>(plan.branch_capacity + 1u32)\n        children: children\n      })\n    }\n  } else if plan.leaf_width > 0u32 {\n    BTreeBody::InlineLeaf(BTreeInlineLeaf::{\n      entries: btree_leaf_storage::<k, v>(plan.leaf_capacity)\n      metadata: btree_metadata_new(plan.leaf_capacity, plan.leaf_width, plan.tags)\n    })\n  } else if is_unit::<v>() {\n    BTreeBody::PlainKeys(BTreeKeyLeaf::{\n      keys: wasm_array_new_default::<k>(plan.leaf_capacity + 1u32)\n    })\n  } else {\n    BTreeBody::PlainLeaf(BTreePlainLeaf::{\n      keys: wasm_array_new_default::<k>(plan.leaf_capacity + 1u32)\n      values: wasm_array_new_default::<v>(plan.leaf_capacity + 2u32)\n    })\n  }\n  BTreeNode::{\n    count: 0u32\n    prefix: 0u32\n    head: false\n    body: body\n  }\n}\nfn btree_raw_block<t>(value: t) -> V128 {\n  let zero = wasm_u64x2_splat(0u64)\n  if type_equal::<t, Bool>() {\n    unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_0(zero, if value {\n      1u64\n    } else {\n      0u64\n    }))\n  } else if can_bitcast::<t, U32>() {\n    unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_0(zero, btree_widen(unsafe_bitcast::<t, U32>(value))))\n  } else if can_bitcast::<t, U64>() {\n    unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_0(zero, unsafe_bitcast::<t, U64>(value)))\n  } else if can_bitcast::<t, V128>() {\n    unsafe_bitcast::<t, V128>(value)\n  } else if type_equal::<t, F32>() {\n    static_assert(can_bitcast::<U64x2, F32x4>() && can_bitcast::<F32x4, V128>(), \"BTree scalar pair: F32 vector views\")\n    unsafe_bitcast::<F32x4, V128>(wasm_f32x4_replace_0(unsafe_bitcast::<U64x2, F32x4>(zero), value))\n  } else if type_equal::<t, F64>() {\n    static_assert(can_bitcast::<U64x2, F64x2>() && can_bitcast::<F64x2, V128>(), \"BTree scalar pair: F64 vector views\")\n    unsafe_bitcast::<F64x2, V128>(wasm_f64x2_replace_0(unsafe_bitcast::<U64x2, F64x2>(zero), value))\n  } else {\n    assert(false, \"BTree raw pair: a reference or Unit cannot enter raw storage\")\n    unreachable()\n  }\n}\nfn btree_raw_value<t>(block: V128) -> t {\n  if type_equal::<t, F32>() {\n    static_assert(can_bitcast::<V128, F32x4>(), \"BTree scalar pair: F32 load view\")\n    wasm_f32x4_extract_0(unsafe_bitcast::<V128, F32x4>(block))\n  } else if type_equal::<t, F64>() {\n    static_assert(can_bitcast::<V128, F64x2>(), \"BTree scalar pair: F64 load view\")\n    wasm_f64x2_extract_0(unsafe_bitcast::<V128, F64x2>(block))\n  } else if type_equal::<t, Bool>() {\n    btree_extract64(block, 0u32) != 0u64\n  } else if type_equal::<t, I8>() {\n    btree_extract32(block, 0u32).into()\n  } else if type_equal::<t, U8>() {\n    btree_extract32(block, 0u32).into()\n  } else if type_equal::<t, I16>() {\n    btree_extract32(block, 0u32).into()\n  } else if type_equal::<t, U16>() {\n    btree_extract32(block, 0u32).into()\n  } else if can_bitcast::<U32, t>() {\n    unsafe_bitcast::<U32, t>(btree_extract32(block, 0u32))\n  } else if can_bitcast::<U64, t>() {\n    unsafe_bitcast::<U64, t>(btree_extract64(block, 0u32))\n  } else if can_bitcast::<V128, t>() {\n    unsafe_bitcast::<V128, t>(block)\n  } else {\n    assert(false, \"BTree raw pair load: unsupported logical type\")\n    unreachable()\n  }\n}\nfn btree_pair_stride<k, v>() -> U32 {\n  if can_bitcast::<k, V128>() || can_bitcast::<v, V128>() {\n    2u32\n  } else {\n    1u32\n  }\n}\nfn btree_inline_key_set<k, v>(storage: BTreeLeafStorage<k, v>, position: U32, key: k) -> Unit {\n  if is_unit::<v>() {\n    let selected_slots = btree_unit_keys(storage).keys\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_set(selected_slots, selected_index, key)\n  } else if type_equal::<k, v>() {\n    let selected_slots = btree_same_pairs(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index, key)\n  } else if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n    let selected_slots = btree_pairs32(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index, btree_bits32(key))\n  } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n    let selected_slots = btree_pairs64(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index, unsafe_bitcast::<k, U64>(key))\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    let slots = btree_pairs128(storage)\n    let stride = btree_pair_stride::<k, v>()\n    let index = btree_pair_position(slots, position, stride)\n    let block = btree_raw_block(key)\n    wasm_array_set(slots, index, if stride == 2u32 {\n      block\n    } else {\n      btree_replace64(block, 1u32, btree_extract64(wasm_array_get(slots, index), 1u32))\n    })\n  } else {\n    let selected_slots = btree_columns(storage).keys\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_set(selected_slots, selected_index, key)\n  }\n}\nfn btree_inline_value_set<k, v>(storage: BTreeLeafStorage<k, v>, position: U32, value: v) -> Unit {\n  if is_unit::<v>() {\n    ()\n  } else if type_equal::<k, v>() {\n    let selected_slots = btree_same_pairs(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index + 1u32, value)\n  } else if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n    let selected_slots = btree_pairs32(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index + 1u32, btree_bits32(value))\n  } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n    let selected_slots = btree_pairs64(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_set(selected_slots, selected_index + 1u32, unsafe_bitcast::<v, U64>(value))\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    let slots = btree_pairs128(storage)\n    let stride = btree_pair_stride::<k, v>()\n    let index = btree_pair_position(slots, position, stride)\n    let block = btree_raw_block(value)\n    if stride == 2u32 {\n      wasm_array_set(slots, index + 1u32, block)\n    } else {\n      wasm_array_set(slots, index, btree_replace64(wasm_array_get(slots, index), 1u32, btree_extract64(block, 0u32)))\n    }\n  } else {\n    let selected_slots = btree_columns(storage).values\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_set(selected_slots, selected_index, value)\n  }\n}\nfn btree_inline_key_get<k, v>(storage: BTreeLeafStorage<k, v>, position: U32) -> k {\n  if is_unit::<v>() {\n    let selected_slots = btree_unit_keys(storage).keys\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_get(selected_slots, selected_index)\n  } else if type_equal::<k, v>() {\n    let selected_slots = btree_same_pairs(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_get(selected_slots, selected_index)\n  } else if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n    let selected_slots = btree_pairs32(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    btree_raw_value::<k>(btree_replace32(unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(0u64)), 0u32, wasm_array_get(selected_slots, selected_index)))\n  } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n    let selected_slots = btree_pairs64(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    btree_raw_value::<k>(unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_0(wasm_u64x2_splat(0u64), wasm_array_get(selected_slots, selected_index))))\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    let slots = btree_pairs128(storage)\n    let stride = btree_pair_stride::<k, v>()\n    let index = btree_pair_position(slots, position, stride)\n    btree_raw_value::<k>(wasm_array_get(slots, index))\n  } else {\n    let selected_slots = btree_columns(storage).keys\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_get(selected_slots, selected_index)\n  }\n}\nfn btree_inline_value_get<k, v>(storage: BTreeLeafStorage<k, v>, position: U32) -> v {\n  if is_unit::<v>() {\n    ()\n  } else if type_equal::<k, v>() {\n    let selected_slots = btree_same_pairs(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    wasm_array_get(selected_slots, selected_index + 1u32)\n  } else if can_bitcast::<k, U32>() && can_bitcast::<v, U32>() {\n    let selected_slots = btree_pairs32(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    btree_raw_value::<v>(btree_replace32(unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(0u64)), 0u32, wasm_array_get(selected_slots, selected_index + 1u32)))\n  } else if can_bitcast::<k, U64>() && can_bitcast::<v, U64>() {\n    let selected_slots = btree_pairs64(storage)\n    let selected_index = btree_pair_position(selected_slots, position, 2u32)\n    btree_raw_value::<v>(unsafe_bitcast::<U64x2, V128>(wasm_u64x2_replace_0(wasm_u64x2_splat(0u64), wasm_array_get(selected_slots, selected_index + 1u32))))\n  } else if (type_equal::<k, Bool>() || is_integer::<k>() || is_float::<k>() || can_bitcast::<k, U32>() || can_bitcast::<k, U64>() || can_bitcast::<k, V128>()) && (type_equal::<v, Bool>() || is_integer::<v>() || is_float::<v>() || can_bitcast::<v, U32>() || can_bitcast::<v, U64>() || can_bitcast::<v, V128>()) {\n    let slots = btree_pairs128(storage)\n    let stride = btree_pair_stride::<k, v>()\n    let index = btree_pair_position(slots, position, stride)\n    let block = wasm_array_get(slots, index + (if stride == 2u32 {\n      1u32\n    } else {\n      0u32\n    }))\n    btree_raw_value::<v>(if stride == 2u32 {\n      block\n    } else {\n      btree_replace64(block, 0u32, btree_extract64(block, 1u32))\n    })\n  } else {\n    let selected_slots = btree_columns(storage).values\n    let selected_index = btree_pair_position(selected_slots, position, 1u32)\n    wasm_array_get(selected_slots, selected_index)\n  }\n}\nfn btree_rank2(slots: WasmArray<V128>, capacity: U32, length: U32, query: U64) -> U64 {\n  if !(length <= capacity) {\n    assert(false, \"BTree SIMD rank: live count exceeds capacity\")\n  }\n  let wanted = wasm_u16x8_splat((query >> 48u64).into())\n  let mut less = 0u32\n  let mut equal = 0u32\n  while 0u32 {\n    base if base < capacity => {\n      let live = if base >= length {\n        0u32\n      } else if length - base < 8u32 {\n        length - base\n      } else {\n        8u32\n      }\n      let mask = (1u32 << live) - 1u32\n      let block = unsafe_bitcast::<V128, U16x8>(wasm_array_get(slots, base / 8u32))\n      let lt = wasm_u16x8_bitmask(wasm_u16x8_lt_u(block, wanted)) & mask\n      let eq = wasm_u16x8_bitmask(wasm_u16x8_eq(block, wanted)) & mask\n      less = less + wasm_u32_popcnt(lt)\n      equal = equal + wasm_u32_popcnt(eq)\n      continue base + 8u32\n    }\n    _ => break btree_widen(less) | (btree_widen(equal) << 32u64)\n  }\n}\n// Low 32 bits count less-than lanes; high 32 bits count equal lanes.\nfn btree_rank4(slots: WasmArray<V128>, capacity: U32, length: U32, query: U64) -> U64 {\n  if !(length <= capacity) {\n    assert(false, \"BTree SIMD rank: live count exceeds capacity\")\n  }\n  let wanted = wasm_u32x4_splat((query >> 32u64).into())\n  let mut less = 0u32\n  let mut equal = 0u32\n  while 0u32 {\n    base if base < capacity => {\n      let live = if base >= length {\n        0u32\n      } else if length - base < 4u32 {\n        length - base\n      } else {\n        4u32\n      }\n      let mask = (1u32 << live) - 1u32\n      let block = unsafe_bitcast::<V128, U32x4>(wasm_array_get(slots, base / 4u32))\n      let lt = wasm_u32x4_bitmask(wasm_u32x4_lt_u(block, wanted)) & mask\n      let eq = wasm_u32x4_bitmask(wasm_u32x4_eq(block, wanted)) & mask\n      less = less + wasm_u32_popcnt(lt)\n      equal = equal + wasm_u32_popcnt(eq)\n      continue base + 4u32\n    }\n    _ => break btree_widen(less) | (btree_widen(equal) << 32u64)\n  }\n}\n// Low 32 bits count less-than lanes; high 32 bits count equal lanes.\nfn btree_rank8(slots: WasmArray<V128>, capacity: U32, length: U32, query: U64) -> U64 {\n  if !(length <= capacity) {\n    assert(false, \"BTree SIMD rank: live count exceeds capacity\")\n  }\n  let wanted = wasm_u64x2_splat(query)\n  let sign = unsafe_bitcast::<U64x2, V128>(wasm_u64x2_splat(9223372036854775808u64))\n  let mut less = 0u32\n  let mut equal = 0u32\n  while 0u32 {\n    base if base < capacity => {\n      let live = if base >= length {\n        0u32\n      } else if length - base < 2u32 {\n        length - base\n      } else {\n        2u32\n      }\n      let mask = (1u32 << live) - 1u32\n      let block = unsafe_bitcast::<V128, U64x2>(wasm_array_get(slots, base / 2u32))\n      let lt = wasm_u64x2_bitmask(unsafe_bitcast::<V128, U64x2>(wasm_v128_lt_s_i64(wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(block), sign), wasm_v128_xor(unsafe_bitcast::<U64x2, V128>(wanted), sign)))) & mask\n      let eq = wasm_u64x2_bitmask(wasm_u64x2_eq(block, wanted)) & mask\n      less = less + wasm_u32_popcnt(lt)\n      equal = equal + wasm_u32_popcnt(eq)\n      continue base + 2u32\n    }\n    _ => break btree_widen(less) | (btree_widen(equal) << 32u64)\n  }\n}\nfn btree_rank(slots: WasmArray<V128>, capacity: U32, width: U32, length: U32, query: U64) -> U64 {\n  if width == 2u32 {\n    btree_rank2(slots, capacity, length, query)\n  } else if width == 4u32 {\n    btree_rank4(slots, capacity, length, query)\n  } else {\n    btree_rank8(slots, capacity, length, query)\n  }\n}\nfn btree_clear_slots<t>(slots: WasmArray<t>, start: U32, count: U32, stride: U32) -> Unit {\n  if !(stride > 0u32 && stride <= wasm_array_len(slots)) {\n    assert(false, \"BTree column clear: invalid default stride\")\n  }\n  let end = wasm_array_len(slots) - stride\n  if !(start <= end && count <= end - start) {\n    assert(false, \"BTree column clear: permanent default slots must remain untouched\")\n  }\n  if !(start % stride == 0u32 && count % stride == 0u32) {\n    assert(false, \"BTree column clear: invalid pair stride\")\n  }\n  if count > 0u32 {\n    wasm_array_copy(slots, start, slots, end, stride)\n    while stride {\n      copied if copied < count => {\n        let next = if copied < count - copied {\n          copied\n        } else {\n          count - copied\n        }\n        wasm_array_copy(slots, start + copied, slots, start, next)\n        continue copied + next\n      }\n      _ => break ()\n    }\n  }\n}\nfn btree_move_slots<t>(slots: WasmArray<t>, destination: U32, source: U32, count: U32, stride: U32) -> Unit {\n  if !(stride > 0u32 && stride <= wasm_array_len(slots)) {\n    assert(false, \"BTree column move: invalid default stride\")\n  }\n  let end = wasm_array_len(slots) - stride\n  if !(source <= end && count <= end - source && destination <= end && count <= end - destination) {\n    assert(false, \"BTree column move: run reaches permanent default slots\")\n  }\n  if !(source % stride == 0u32 && destination % stride == 0u32 && count % stride == 0u32) {\n    assert(false, \"BTree column move: invalid pair stride\")\n  }\n  wasm_array_copy(slots, destination, slots, source, count)\n  if destination > source {\n    let gap = destination - source\n    btree_clear_slots(slots, source, if gap < count {\n      gap\n    } else {\n      count\n    }, stride)\n  } else if source > destination {\n    let gap = source - destination\n    let clear = if gap < count {\n      gap\n    } else {\n      count\n    }\n    btree_clear_slots(slots, source + count - clear, clear, stride)\n  }\n}\nfn btree_leaf_storage_clear<k, v>(storage: BTreeLeafStorage<k, v>, position: U32, count: U32) -> Unit {\n  if is_unit::<v>() {\n    match storage {\n      BTreeLeafStorage::Keys(columns) => btree_clear_slots(columns.keys, position, count, 1u32)\n      _ => {\n        assert(false, \"BTree Unit leaf: expected key-only storage\")\n      }\n    }\n  } else {\n    match storage {\n      BTreeLeafStorage::Same(slots) => btree_clear_slots(slots, 2u32 * position, 2u32 * count, 2u32)\n      BTreeLeafStorage::Pair32(slots) => btree_clear_slots(slots, 2u32 * position, 2u32 * count, 2u32)\n      BTreeLeafStorage::Pair64(slots) => btree_clear_slots(slots, 2u32 * position, 2u32 * count, 2u32)\n      BTreeLeafStorage::Pair128(slots) => {\n        let stride = btree_pair_stride::<k, v>()\n        btree_clear_slots(slots, stride * position, stride * count, stride)\n      }\n      BTreeLeafStorage::Columns(columns) => {\n        btree_clear_slots(columns.keys, position, count, 1u32)\n        btree_clear_slots(columns.values, position, count, 1u32)\n      }\n      BTreeLeafStorage::Keys(columns) => btree_clear_slots(columns.keys, position, count, 1u32)\n    }\n  }\n}\nfn btree_leaf_storage_move<k, v>(storage: BTreeLeafStorage<k, v>, destination: U32, source: U32, count: U32) -> Unit {\n  if is_unit::<v>() {\n    match storage {\n      BTreeLeafStorage::Keys(columns) => btree_move_slots(columns.keys, destination, source, count, 1u32)\n      _ => {\n        assert(false, \"BTree Unit leaf: expected key-only storage\")\n      }\n    }\n  } else {\n    match storage {\n      BTreeLeafStorage::Same(slots) => btree_move_slots(slots, destination * 2u32, source * 2u32, count * 2u32, 2u32)\n      BTreeLeafStorage::Pair32(slots) => btree_move_slots(slots, destination * 2u32, source * 2u32, count * 2u32, 2u32)\n      BTreeLeafStorage::Pair64(slots) => btree_move_slots(slots, destination * 2u32, source * 2u32, count * 2u32, 2u32)\n      BTreeLeafStorage::Pair128(slots) => {\n        let stride = btree_pair_stride::<k, v>()\n        btree_move_slots(slots, destination * stride, source * stride, count * stride, stride)\n      }\n      BTreeLeafStorage::Columns(columns) => {\n        btree_move_slots(columns.keys, destination, source, count, 1u32)\n        btree_move_slots(columns.values, destination, source, count, 1u32)\n      }\n      BTreeLeafStorage::Keys(columns) => btree_move_slots(columns.keys, destination, source, count, 1u32)\n    }\n  }\n}\nfn btree_node_key<k, v>(node: BTreeNode<k, v>, index: U32, head: Bool) -> k {\n  if !(if head {\n    node.head\n  } else {\n    index < node.count\n  }) {\n    btree_node_failure(node, index, \"key read: slot is not live\")\n  }\n  match node.body {\n    BTreeBody::PlainLeaf(leaf) => {\n      if !(!head) {\n        assert(false, \"BTree plain leaf key read: head key belongs to an ancestor\")\n      }\n      wasm_array_get(leaf.keys, index)\n    }\n    BTreeBody::PlainKeys(leaf) => {\n      if !(!head) {\n        assert(false, \"BTree plain Unit leaf key read: head key belongs to an ancestor\")\n      }\n      wasm_array_get(leaf.keys, index)\n    }\n    BTreeBody::InlineLeaf(leaf) => btree_inline_key_get(leaf.entries, if head {\n      0u32\n    } else {\n      index + 1u32\n    })\n    BTreeBody::PlainBranch(branch) => {\n      if !(!head) {\n        assert(false, \"BTree plain branch key read: branch has no head\")\n      }\n      wasm_array_get(branch.keys, index)\n    }\n    BTreeBody::InlineBranch(_) => {\n      assert(false, \"BTree inline branch key read: no full keys are stored\")\n      unreachable()\n    }\n  }\n}\nfn btree_node_value<k, v>(node: BTreeNode<k, v>, index: U32, head: Bool) -> v {\n  if !(if head {\n    node.head\n  } else {\n    index < node.count\n  }) {\n    btree_node_failure(node, index, \"value read: slot is not live\")\n  }\n  let position = if head {\n    0u32\n  } else {\n    index + 1u32\n  }\n  match node.body {\n    BTreeBody::PlainLeaf(leaf) => {\n      if is_unit::<v>() {\n        ()\n      } else {\n        wasm_array_get(leaf.values, position)\n      }\n    }\n    BTreeBody::PlainKeys(_) => {\n      if is_unit::<v>() {\n        ()\n      } else {\n        assert(false, \"BTree plain Unit leaf load: logical type mismatch\")\n        unreachable()\n      }\n    }\n    BTreeBody::InlineLeaf(leaf) => btree_inline_value_get(leaf.entries, position)\n    _ => {\n      assert(false, \"BTree value read: branch has no value column\")\n      unreachable()\n    }\n  }\n}\nfn btree_node_child<k, v>(node: BTreeNode<k, v>, index: U32) -> BTreeNode<k, v> {\n  if !(index <= node.count) {\n    btree_node_failure(node, index, \"child read: edge exceeds separator count\")\n  }\n  match node.body {\n    BTreeBody::PlainBranch(branch) => wasm_array_get(branch.children, index)\n    BTreeBody::InlineBranch(branch) => wasm_array_get(branch.children, index)\n    _ => {\n      assert(false, \"BTree child read: leaf has no children\")\n      unreachable()\n    }\n  }\n}\nfn btree_node_clear<k, v>(node: BTreeNode<k, v>, plan: BTreePlan) -> Unit {\n  match node.body {\n    BTreeBody::PlainLeaf(leaf) => {\n      btree_clear_slots(leaf.keys, 0u32, plan.leaf_capacity, 1u32)\n      if !is_unit::<v>() {\n        btree_clear_slots(leaf.values, 0u32, plan.leaf_capacity + 1u32, 1u32)\n      }\n    }\n    BTreeBody::PlainKeys(leaf) => btree_clear_slots(leaf.keys, 0u32, plan.leaf_capacity, 1u32)\n    BTreeBody::InlineLeaf(leaf) => {\n      btree_leaf_storage_clear(leaf.entries, 0u32, plan.leaf_capacity + 1u32)\n      btree_metadata_clear(leaf.metadata, plan.leaf_capacity, plan.leaf_width, plan.tags, 0u32, plan.leaf_capacity)\n    }\n    BTreeBody::PlainBranch(branch) => {\n      btree_clear_slots(branch.keys, 0u32, plan.branch_capacity, 1u32)\n      btree_clear_slots(branch.children, 0u32, plan.branch_capacity + 1u32, 1u32)\n    }\n    BTreeBody::InlineBranch(branch) => {\n      btree_clear_slots(branch.children, 0u32, plan.branch_capacity + 1u32, 1u32)\n      btree_metadata_clear(branch.metadata, plan.branch_capacity, plan.branch_width, false, 0u32, plan.branch_capacity)\n    }\n  }\n  node.count = 0u32\n  node.head = false\n  node.prefix = 0u32\n}\n// This path runs only on failure. Good reads do not build message objects.\nfn btree_node_failure<k, v>(node: BTreeNode<k, v>, index: U32, operation: String) -> Never {\n  let kind = match node.body {\n    BTreeBody::PlainLeaf(_) => \"plain leaf\"\n    BTreeBody::PlainKeys(_) => \"plain Unit leaf\"\n    BTreeBody::InlineLeaf(_) => \"inline leaf\"\n    BTreeBody::PlainBranch(_) => \"plain branch\"\n    BTreeBody::InlineBranch(_) => \"inline branch\"\n  }\n  let capacity = match node.body {\n    BTreeBody::PlainLeaf(body) => wasm_array_len(body.keys) - 1u32\n    BTreeBody::PlainKeys(body) => wasm_array_len(body.keys) - 1u32\n    BTreeBody::PlainBranch(body) => wasm_array_len(body.keys) - 1u32\n    BTreeBody::InlineBranch(body) => wasm_array_len(body.children) - 2u32\n    BTreeBody::InlineLeaf(body) => match body.entries {\n      BTreeLeafStorage::Same(slots) => wasm_array_len(slots) / 2u32 - 2u32\n      BTreeLeafStorage::Pair32(slots) => wasm_array_len(slots) / 2u32 - 2u32\n      BTreeLeafStorage::Pair64(slots) => wasm_array_len(slots) / 2u32 - 2u32\n      BTreeLeafStorage::Pair128(slots) => wasm_array_len(slots) / btree_pair_stride::<k, v>() - 2u32\n      BTreeLeafStorage::Columns(columns) => wasm_array_len(columns.keys) - 2u32\n      BTreeLeafStorage::Keys(columns) => wasm_array_len(columns.keys) - 2u32\n    }\n  }\n  let message = StringBuilder::new()\n  message.append(\"BTree \")\n  message.append(kind)\n  message.append(\" \")\n  message.append(operation)\n  message.append(\"; count=\")\n  message.append_u32(node.count)\n  message.append(\" capacity=\")\n  message.append_u32(capacity)\n  message.append(\" index=\")\n  message.append_u32(index)\n  message.append(\" head=\")\n  message.append(if node.head {\n    \"true\"\n  } else {\n    \"false\"\n  })\n  assert(false, message.finish())\n  unreachable()\n}\nfn btree_same_pairs<k, v>(storage: BTreeLeafStorage<k, v>) -> WasmArray<k> {\n  match storage {\n    BTreeLeafStorage::Same(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_pairs32<k, v>(storage: BTreeLeafStorage<k, v>) -> WasmArray<U32> {\n  match storage {\n    BTreeLeafStorage::Pair32(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_pairs64<k, v>(storage: BTreeLeafStorage<k, v>) -> WasmArray<U64> {\n  match storage {\n    BTreeLeafStorage::Pair64(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_pairs128<k, v>(storage: BTreeLeafStorage<k, v>) -> WasmArray<V128> {\n  match storage {\n    BTreeLeafStorage::Pair128(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_columns<k, v>(storage: BTreeLeafStorage<k, v>) -> BTreePlainLeaf<k, v> {\n  match storage {\n    BTreeLeafStorage::Columns(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_unit_keys<k, v>(storage: BTreeLeafStorage<k, v>) -> BTreeKeyLeaf<k> {\n  match storage {\n    BTreeLeafStorage::Keys(slots) => slots\n    _ => {\n      assert(false, \"BTree leaf storage: selected carrier/body mismatch\")\n      unreachable()\n    }\n  }\n}\nfn btree_pair_position<t>(slots: WasmArray<t>, position: U32, stride: U32) -> U32 {\n  if !(stride > 0u32 && position < wasm_array_len(slots) / stride - 1u32) {\n    assert(false, \"BTree leaf pair access: permanent default pair is not live\")\n  }\n  position * stride\n}\nfn btree_bits32<t>(value: t) -> U32 {\n  static_assert(can_bitcast::<t, U32>(), \"BTree common pair: U32 carrier required\")\n  if type_equal::<t, Bool>() {\n    if value {\n      1u32\n    } else {\n      0u32\n    }\n  } else {\n    unsafe_bitcast::<t, U32>(value)\n  }\n}\n"
}

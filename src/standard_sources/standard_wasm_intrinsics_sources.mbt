e_bitcast::<U32, U8x4>(u32_load(address))\n}\npub fn wasm_u8x4_store(address: U32, value: U8x4) -> Unit {\n  u32_store(address, unsafe_bitcast::<U8x4, U32>(value))\n}\npub fn wasm_u8x4_and(left: U8x4, right: U8x4) -> U8x4 {\n  unsafe_bitcast::<U32, U8x4>(u32_and(unsafe_bitcast::<U8x4, U32>(left), unsafe_bitcast::<U8x4, U32>(right)))\n}\npub fn wasm_u8x4_or(left: U8x4, right: U8x4) -> U8x4 {\n  unsafe_bitcast::<U32, U8x4>(u32_or(unsafe_bitcast::<U8x4, U32>(left), unsafe_bitcast::<U8x4, U32>(right)))\n}\npub fn wasm_u8x4_xor(left: U8x4, right: U8x4) -> U8x4 {\n  unsafe_bitcast::<U32, U8x4>(u32_xor(unsafe_bitcast::<U8x4, U32>(left), unsafe_bitcast::<U8x4, U32>(right)))\n}\n\n// std/u8x8.dew\npub fn wasm_u8x8_from_swar64(value: Swar64) -> U8x8 {\n  unsafe_bitcast::<Swar64, U8x8>(value)\n}\npub fn wasm_u8x8_to_swar64(value: U8x8) -> Swar64 {\n  unsafe_bitcast::<U8x8, Swar64>(value)\n}\npub fn wasm_u8x8_load(address: U32) -> U8x8 {\n  unsafe_bitcast::<U64, U8x8>(u64_load(address))\n}\npub fn wasm_u8x8_store(address: U32, value: U8x8) -> Unit {\n  u64_store(address, unsafe_bitcast::<U8x8, U64>(value))\n}\npub fn wasm_u8x8_and(left: U8x8, right: U8x8) -> U8x8 {\n  unsafe_bitcast::<U64, U8x8>(u64_and(unsafe_bitcast::<U8x8, U64>(left), unsafe_bitcast::<U8x8, U64>(right)))\n}\npub fn wasm_u8x8_or(left: U8x8, right: U8x8) -> U8x8 {\n  unsafe_bitcast::<U64, U8x8>(u64_or(unsafe_bitcast::<U8x8, U64>(left), unsafe_bitcast::<U8x8, U64>(right)))\n}\npub fn wasm_u8x8_xor(left: U8x8, right: U8x8) -> U8x8 {\n  unsafe_bitcast::<U64, U8x8>(u64_xor(unsafe_bitcast::<U8x8, U64>(left), unsafe_bitcast::<U8x8, U64>(right)))\n}\n\n// Library algorithm; lane operations each map to one Wasm instruction.\npub fn wasm_bytes_load_u8x16(value: Bytes, start: U32) -> U8x16 {\n  let length = __dew_text_byte_length(value)\n  if start > length || length - start < 16u32 {\n    unreachable()\n  }\n  let mut vector = wasm_u8x16_splat(__dew_text_byte_at(value, start))\n  vector = wasm_u8x16_replace_1(vector, __dew_text_byte_at(value, start + 1u32))\n  vector = wasm_u8x16_replace_2(vector, __dew_text_byte_at(value, start + 2u32))\n  vector = wasm_u8x16_replace_3(vector, __dew_text_byte_at(value, start + 3u32))\n  vector = wasm_u8x16_replace_4(vector, __dew_text_byte_at(value, start + 4u32))\n  vector = wasm_u8x16_replace_5(vector, __dew_text_byte_at(value, start + 5u32))\n  vector = wasm_u8x16_replace_6(vector, __dew_text_byte_at(value, start + 6u32))\n  vector = wasm_u8x16_replace_7(vector, __dew_text_byte_at(value, start + 7u32))\n  vector = wasm_u8x16_replace_8(vector, __dew_text_byte_at(value, start + 8u32))\n  vector = wasm_u8x16_replace_9(vector, __dew_text_byte_at(value, start + 9u32))\n  vector = wasm_u8x16_replace_10(vector, __dew_text_byte_at(value, start + 10u32))\n  vector = wasm_u8x16_replace_11(vector, __dew_text_byte_at(value, start + 11u32))\n  vector = wasm_u8x16_replace_12(vector, __dew_text_byte_at(value, start + 12u32))\n  vector = wasm_u8x16_replace_13(vector, __dew_text_byte_at(value, start + 13u32))\n  vector = wasm_u8x16_replace_14(vector, __dew_text_byte_at(value, start + 14u32))\n  vector = wasm_u8x16_replace_15(vector, __dew_text_byte_at(value, start + 15u32))\n  vector\n}\n\n// Library conversion through the shared Bytes algorithm.\npub fn wasm_string_load_u8x16(value: String, start: U32) -> U8x16 {\n  wasm_bytes_load_u8x16(__dew_text_bytes(value), start)\n}\n"

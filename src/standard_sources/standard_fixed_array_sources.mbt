///|
pub fn standard_fixed_array_source() -> Bytes {
  b"pub struct FixedArray<t> {}\n\npub builtin fixed_array_make<t>(length: U32, value: t) -> FixedArray<t> = \"dew_fixed_array_make\"\npub builtin fixed_array_length<t>(value: FixedArray<t>) -> U32 = \"dew_fixed_array_length\"\npub builtin fixed_array_get<t>(value: FixedArray<t>, index: U32) -> Option<t> = \"dew_fixed_array_get\"\npub builtin fixed_array_get_unchecked<t>(value: FixedArray<t>, index: U32) -> t = \"dew_fixed_array_get_unchecked\"\npub builtin fixed_array_set<t>(value: FixedArray<t>, index: U32, item: t) -> Unit = \"dew_fixed_array_set\"\npub builtin fixed_array_set_unchecked<t>(value: FixedArray<t>, index: U32, item: t) -> Unit = \"dew_fixed_array_set_unchecked\"\n\nimpl<t> FixedArray<t> {\n  fn make(length: U32, value: t) -> FixedArray<t> {\n    fixed_array_make(length, value)\n  }\n  fn length(self) -> U32 {\n    fixed_array_length(self)\n  }\n  fn get(self, index: U32) -> Option<t> {\n    fixed_array_get(self, index)\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    fixed_array_get_unchecked(self, index)\n  }\n  fn set(self, index: U32, value: t) -> Unit {\n    fixed_array_set(self, index, value)\n  }\n  fn set_unchecked(self, index: U32, value: t) -> Unit {\n    fixed_array_set_unchecked(self, index, value)\n  }\n}\n\nimpl<t> Index<U32, t> for FixedArray<t> {\n  fn index(self, key: U32) -> t {\n    fixed_array_get_unchecked(self, key)\n  }\n}\n\nimpl<t> IndexSet<U32, t> for FixedArray<t> {\n  fn index_set(self, key: U32, value: t) -> Unit {\n    fixed_array_set_unchecked(self, key, value)\n  }\n}\n"
}

///|
pub fn standard_fixed_array_source() -> Bytes {
  b"open dew.std.wasm.intrinsics\n\npub type FixedArray<t> = WasmArray<t>\n\nimpl<t> FixedArray<t> {\n  fn make(length: U32, value: t) -> FixedArray<t> {\n    wasm_array_new(length, value)\n  }\n  fn length(self) -> U32 {\n    wasm_array_len(self)\n  }\n  fn get(self, index: U32) -> Option<t> {\n    if index < wasm_array_len(self) {\n      Option::Some(wasm_array_get(self, index))\n    } else {\n      Option::None\n    }\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    wasm_array_get(self, index)\n  }\n  fn set(self, index: U32, value: t) -> Unit {\n    wasm_array_set(self, index, value)\n  }\n  fn set_unchecked(self, index: U32, value: t) -> Unit {\n    wasm_array_set(self, index, value)\n  }\n}\n\nimpl<t> IndexedGet<U32, t> for FixedArray<t> {\n  fn indexed_get(self, index: U32) -> t {\n    wasm_array_get(self, index)\n  }\n}\n\nimpl<t> IndexedSet<U32, t> for FixedArray<t> {\n  fn indexed_set(self, index: U32, value: t) -> Unit {\n    wasm_array_set(self, index, value)\n  }\n}\n\nimpl<t: Eq> FixedArray<t> {\n  fn equals(self, right: FixedArray<t>) -> Bool {\n    let length = wasm_array_len(self)\n    if length != wasm_array_len(right) {\n      false\n    } else {\n      while 0u32 {\n        index if index < length => {\n          if wasm_array_get(self, index) == wasm_array_get(right, index) {\n            continue index + 1u32\n          } else {\n            break false\n          }\n        }\n        _ => break true\n      }\n    }\n  }\n}\n\nimpl<t: Eq> Eq for FixedArray<t> {\n  fn eq(self, right: FixedArray<t>) -> Bool {\n    self.equals(right)\n  }\n}\n\nimpl<t: Eq> Ne for FixedArray<t> {\n  fn ne(self, right: FixedArray<t>) -> Bool {\n    !self.equals(right)\n  }\n}\n"
}

///|
pub fn standard_string_fixed_array_source() -> Bytes {
  b"open dew.std.fixed_array\n\nfn string_fixed_array_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\nfn string_fixed_array_u32_to_u16(value: U32) -> U16 {\n  value.into()\n}\n\nimpl String {\n  fn to_utf8_fixed_array(self) -> FixedArray<U8> {\n    let length = self.byte_length()\n    let output = FixedArray::make(length, 0u8)\n    while 0u32 {\n      index if index < length => {\n        output.set_unchecked(index, self.byte_at(index))\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn to_utf16_fixed_array(self) -> FixedArray<U16> {\n    let byte_length = self.byte_length()\n    let output = FixedArray::make(self.utf16_length(), 0u16)\n    let mut input_index = 0u32\n    let mut output_index = 0u32\n    while true {\n      true if input_index < byte_length => {\n        let first = self.byte_at(input_index)\n        let first_bits = string_fixed_array_u8_to_u32(first)\n        let mut scalar = first_bits\n        let mut width = 1u32\n        if first >= 194u8 && first <= 223u8 {\n          let second = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 1u32),\n          )\n          scalar = ((first_bits & 31u32) << 6u32) | (second & 63u32)\n          width = 2u32\n        } else if first >= 224u8 && first <= 239u8 {\n          let second = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 1u32),\n          )\n          let third = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 2u32),\n          )\n          scalar = ((first_bits & 15u32) << 12u32) |\n            ((second & 63u32) << 6u32) |\n            (third & 63u32)\n          width = 3u32\n        } else if first >= 240u8 {\n          let second = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 1u32),\n          )\n          let third = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 2u32),\n          )\n          let fourth = string_fixed_array_u8_to_u32(\n            self.byte_at(input_index + 3u32),\n          )\n          scalar = ((first_bits & 7u32) << 18u32) |\n            ((second & 63u32) << 12u32) |\n            ((third & 63u32) << 6u32) |\n            (fourth & 63u32)\n          width = 4u32\n        } else {\n          width = 1u32\n        }\n        if scalar <= 65535u32 {\n          output.set_unchecked(\n            output_index,\n            string_fixed_array_u32_to_u16(scalar),\n          )\n          output_index = output_index + 1u32\n        } else {\n          let adjusted = scalar - 65536u32\n          output.set_unchecked(\n            output_index,\n            string_fixed_array_u32_to_u16(\n              55296u32 + (adjusted >> 10u32),\n            ),\n          )\n          output.set_unchecked(\n            output_index + 1u32,\n            string_fixed_array_u32_to_u16(\n              56320u32 + (adjusted & 1023u32),\n            ),\n          )\n          output_index = output_index + 2u32\n        }\n        input_index = input_index + width\n        continue true\n      }\n      _ => break output\n    }\n  }\n}\n"
}

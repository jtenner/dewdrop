///|
pub fn standard_queue_source() -> Bytes {
  b"open dew.std.array\n\npub type Queue<t> = Array<t>\npub type QueueIter<t> = ArrayIter<t>\n\npub builtin queue_new<t>() -> Queue<t> = \"dew_queue_new\"\npub builtin queue_with_capacity<t>(capacity: U32) -> Queue<t> = \"dew_queue_with_capacity\"\npub builtin queue_length<t>(queue: Queue<t>) -> U32 = \"dew_queue_length\"\npub builtin queue_is_empty<t>(queue: Queue<t>) -> Bool = \"dew_queue_is_empty\"\npub builtin queue_enqueue<t>(queue: Queue<t>, value: t) -> Unit = \"dew_queue_enqueue\"\npub builtin queue_dequeue<t>(queue: Queue<t>) -> Option<t> = \"dew_queue_dequeue\"\npub builtin queue_peek<t>(queue: Queue<t>) -> Option<t> = \"dew_queue_peek\"\npub builtin queue_clear<t>(queue: Queue<t>) -> Unit = \"dew_queue_clear\"\npub builtin queue_iter<t>(queue: Queue<t>) -> QueueIter<t> = \"dew_queue_iter\"\npub builtin queue_iter_has_next<t>(iter: QueueIter<t>) -> Bool = \"dew_queue_iter_has_next\"\npub builtin queue_iter_next<t>(iter: QueueIter<t>) -> t = \"dew_queue_iter_next\"\n"
}

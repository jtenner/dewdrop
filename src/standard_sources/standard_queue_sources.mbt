///|
pub fn standard_queue_source() -> Bytes {
  b"open dew.std.collections.circular_buffer\n\npub type Queue<t> = CircularBuffer<t>\npub type QueueIter<t> = CircularBufferIter<t>\n\npub fn queue_new<t>() -> Queue<t> {\n  queue_with_capacity(0u32)\n}\npub fn queue_with_capacity<t>(capacity: U32) -> Queue<t> {\n  circular_buffer_growable(capacity)\n}\npub fn queue_length<t>(queue: Queue<t>) -> U32 {\n  circular_buffer_length(queue)\n}\npub fn queue_is_empty<t>(queue: Queue<t>) -> Bool {\n  circular_buffer_is_empty(queue)\n}\npub fn queue_enqueue<t>(queue: Queue<t>, value: t) -> Unit {\n  if !circular_buffer_push_back(queue, value) {\n    unreachable()\n  }\n}\npub fn queue_dequeue<t>(queue: Queue<t>) -> Option<t> {\n  circular_buffer_pop_front(queue)\n}\npub fn queue_peek<t>(queue: Queue<t>) -> Option<t> {\n  circular_buffer_peek_front(queue)\n}\npub fn queue_clear<t>(queue: Queue<t>) -> Unit {\n  circular_buffer_clear(queue)\n}\npub fn queue_iter<t>(queue: Queue<t>) -> QueueIter<t> {\n  circular_buffer_iter(queue)\n}\npub fn queue_iter_has_next<t>(iter: QueueIter<t>) -> Bool {\n  circular_buffer_iter_has_next(iter)\n}\npub fn queue_iter_next<t>(iter: QueueIter<t>) -> t {\n  circular_buffer_iter_next(iter)\n}\n"
}

///|
pub fn standard_wasi_source() -> Bytes {
  b"builtin wasi_fd_write_import(fd: U32, iovs: U32, iovs_length: U32, written: U32) -> U32 = \"wasi_snapshot_preview1.fd_write\"\nbuiltin wasi_fd_read_import(fd: U32, iovs: U32, iovs_length: U32, read: U32) -> U32 = \"wasi_snapshot_preview1.fd_read\"\n\nbuiltin wasi_fd_write(fd: U32, value: Bytes) -> U32 = \"dew_wasi_fd_write\"\nbuiltin wasi_fd_read(fd: U32, limit: U32) -> Bytes = \"dew_wasi_fd_read\"\n"
}

///|
pub fn standard_wasm_wasi_source() -> Bytes {
  b"pub type WasiErrno = U32\npub type WasiFd = U32\npub type WasiSize = U32\npub type WasiPointer = U32\npub type WasiTimestamp = U64\npub type WasiFilesize = U64\npub type WasiFiledelta = I64\npub type WasiRights = U64\npub type WasiDircookie = U64\n\npub builtin args_get(argv: WasiPointer, argv_buffer: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.args_get\"\npub builtin args_sizes_get(argc: WasiPointer, argv_buffer_size: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.args_sizes_get\"\npub builtin environ_get(environ: WasiPointer, environ_buffer: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.environ_get\"\npub builtin environ_sizes_get(environ_count: WasiPointer, environ_buffer_size: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.environ_sizes_get\"\npub builtin clock_res_get(clock_id: U32, resolution: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.clock_res_get\"\npub builtin clock_time_get(clock_id: U32, precision: WasiTimestamp, time: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.clock_time_get\"\npub builtin fd_advise(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize, advice: U32) -> WasiErrno = \"wasi_snapshot_preview1.fd_advise\"\npub builtin fd_allocate(fd: WasiFd, offset: WasiFilesize, length: WasiFilesize) -> WasiErrno = \"wasi_snapshot_preview1.fd_allocate\"\npub builtin fd_close(fd: WasiFd) -> WasiErrno = \"wasi_snapshot_preview1.fd_close\"\npub builtin fd_datasync(fd: WasiFd) -> WasiErrno = \"wasi_snapshot_preview1.fd_datasync\"\npub builtin fd_fdstat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_fdstat_get\"\npub builtin fd_fdstat_set_flags(fd: WasiFd, flags: U32) -> WasiErrno = \"wasi_snapshot_preview1.fd_fdstat_set_flags\"\npub builtin fd_fdstat_set_rights(fd: WasiFd, rights_base: WasiRights, rights_inheriting: WasiRights) -> WasiErrno = \"wasi_snapshot_preview1.fd_fdstat_set_rights\"\npub builtin fd_filestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_filestat_get\"\npub builtin fd_filestat_set_size(fd: WasiFd, size: WasiFilesize) -> WasiErrno = \"wasi_snapshot_preview1.fd_filestat_set_size\"\npub builtin fd_filestat_set_times(fd: WasiFd, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = \"wasi_snapshot_preview1.fd_filestat_set_times\"\npub builtin fd_pread(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, read: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_pread\"\npub builtin fd_prestat_get(fd: WasiFd, status: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_prestat_get\"\npub builtin fd_prestat_dir_name(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.fd_prestat_dir_name\"\npub builtin fd_pwrite(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, offset: WasiFilesize, written: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_pwrite\"\npub builtin fd_write(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, written: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_write\"\npub builtin fd_read(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, read: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_read\"\npub builtin fd_readdir(fd: WasiFd, buffer: WasiPointer, buffer_length: WasiSize, cookie: WasiDircookie, used: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_readdir\"\npub builtin fd_renumber(from: WasiFd, to: WasiFd) -> WasiErrno = \"wasi_snapshot_preview1.fd_renumber\"\npub builtin fd_seek(fd: WasiFd, offset: WasiFiledelta, whence: U32, new_offset: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_seek\"\npub builtin fd_sync(fd: WasiFd) -> WasiErrno = \"wasi_snapshot_preview1.fd_sync\"\npub builtin fd_tell(fd: WasiFd, offset: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.fd_tell\"\npub builtin path_create_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_create_directory\"\npub builtin path_filestat_get(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, status: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.path_filestat_get\"\npub builtin path_filestat_set_times(fd: WasiFd, lookup_flags: U32, path: WasiPointer, path_length: WasiSize, access_time: WasiTimestamp, modification_time: WasiTimestamp, flags: U32) -> WasiErrno = \"wasi_snapshot_preview1.path_filestat_set_times\"\npub builtin path_link(old_fd: WasiFd, old_flags: U32, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_link\"\npub builtin path_open(fd: WasiFd, directory_flags: U32, path: WasiPointer, path_length: WasiSize, open_flags: U32, rights_base: WasiRights, rights_inheriting: WasiRights, fd_flags: U32, opened_fd: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.path_open\"\npub builtin path_readlink(fd: WasiFd, path: WasiPointer, path_length: WasiSize, buffer: WasiPointer, buffer_length: WasiSize, used: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.path_readlink\"\npub builtin path_remove_directory(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_remove_directory\"\npub builtin path_rename(old_fd: WasiFd, old_path: WasiPointer, old_path_length: WasiSize, new_fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_rename\"\npub builtin path_symlink(old_path: WasiPointer, old_path_length: WasiSize, fd: WasiFd, new_path: WasiPointer, new_path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_symlink\"\npub builtin path_unlink_file(fd: WasiFd, path: WasiPointer, path_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.path_unlink_file\"\npub builtin poll_oneoff(input: WasiPointer, output: WasiPointer, subscriptions: WasiSize, events: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.poll_oneoff\"\npub builtin proc_exit(code: U32) -> Unit = \"wasi_snapshot_preview1.proc_exit\"\npub builtin proc_raise(signal: U32) -> WasiErrno = \"wasi_snapshot_preview1.proc_raise\"\npub builtin sched_yield() -> WasiErrno = \"wasi_snapshot_preview1.sched_yield\"\npub builtin random_get(buffer: WasiPointer, buffer_length: WasiSize) -> WasiErrno = \"wasi_snapshot_preview1.random_get\"\npub builtin sock_accept(fd: WasiFd, fd_flags: U32, accepted_fd: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.sock_accept\"\npub builtin sock_recv(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, received: WasiPointer, output_flags: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.sock_recv\"\npub builtin sock_send(fd: WasiFd, iovs: WasiPointer, iovs_length: WasiSize, flags: U32, sent: WasiPointer) -> WasiErrno = \"wasi_snapshot_preview1.sock_send\"\npub builtin sock_shutdown(fd: WasiFd, how: U32) -> WasiErrno = \"wasi_snapshot_preview1.sock_shutdown\"\n"
}

///|
pub fn standard_text_sources() -> Array[Bytes] {
  [
    b"open dew.std.wasm.intrinsics\n\nbuiltin string_byte_length(value: String) -> U32 = \"dew_string_byte_length\"\nbuiltin string_as_bytes(value: String) -> Bytes = \"dew_string_as_bytes\"\nbuiltin string_utf16_length(value: String) -> U32 = \"dew_string_utf16_length\"\nbuiltin string_equals(left: String, right: String) -> Bool = \"dew_string_equals\"\nbuiltin string_hash(value: String) -> U64 = \"dew_string_hash\"\nbuiltin string_byte_at(value: String, index: U32) -> U8 = \"dew_string_byte_at\"\nbuiltin string_view(value: String, start: U32, length: U32) -> StringView = \"dew_string_view\"\nbuiltin string_concat(left: String, right: String) -> String = \"dew_string_concat\"\nbuiltin string_concat_view(left: String, right: StringView) -> String = \"dew_string_concat_view\"\nbuiltin string_find_raw(value: String, needle: String) -> U32 = \"dew_string_find\"\nbuiltin string_find_view_raw(value: String, needle: StringView) -> U32 = \"dew_string_find_view\"\nbuiltin string_starts_with(value: String, prefix: String) -> Bool = \"dew_string_starts_with\"\nbuiltin string_starts_with_view(value: String, prefix: StringView) -> Bool = \"dew_string_starts_with_view\"\nbuiltin string_ends_with(value: String, suffix: String) -> Bool = \"dew_string_ends_with\"\nbuiltin string_ends_with_view(value: String, suffix: StringView) -> Bool = \"dew_string_ends_with_view\"\nbuiltin string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\nbuiltin string_view_byte_at(value: StringView, index: U32) -> U8 = \"dew_string_view_byte_at\"\nbuiltin string_view_to_string(value: StringView) -> String = \"dew_string_view_to_string\"\nbuiltin string_view_as_bytes_unchecked(value: StringView) -> Bytes = \"dew_string_view_as_bytes\"\nbuiltin string_view_view(value: StringView, start: U32, length: U32) -> StringView = \"dew_string_view_view\"\nbuiltin string_builder_new() -> StringBuilder = \"dew_string_builder_new\"\nbuiltin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = \"dew_string_builder_with_capacity\"\nbuiltin string_builder_byte_length(value: StringBuilder) -> U32 = \"dew_string_builder_byte_length\"\nbuiltin string_builder_append(value: StringBuilder, part: String) -> Unit = \"dew_string_builder_append\"\nbuiltin string_builder_append_view(value: StringBuilder, part: StringView) -> Unit = \"dew_string_builder_append_view\"\nbuiltin string_builder_append_ascii(value: StringBuilder, byte: U8) -> Unit = \"dew_string_builder_append_ascii\"\nbuiltin string_builder_append_scalar(value: StringBuilder, scalar: U32) -> Unit = \"dew_string_builder_append_scalar\"\nbuiltin string_builder_finish(value: StringBuilder) -> String = \"dew_string_builder_finish\"\nbuiltin bytes_builder_new() -> BytesBuilder = \"dew_bytes_builder_new\"\nbuiltin bytes_builder_with_capacity_raw(capacity: U32) -> BytesBuilder = \"dew_bytes_builder_with_capacity\"\nbuiltin bytes_builder_byte_length(value: BytesBuilder) -> U32 = \"dew_bytes_builder_byte_length\"\nbuiltin bytes_builder_append(value: BytesBuilder, part: Bytes) -> Unit = \"dew_bytes_builder_append\"\nbuiltin bytes_builder_append_byte(value: BytesBuilder, byte: U8) -> Unit = \"dew_bytes_builder_append_byte\"\nbuiltin bytes_builder_finish(value: BytesBuilder) -> Bytes = \"dew_bytes_builder_finish\"\nbuiltin bytes_byte_length(value: Bytes) -> U32 = \"dew_bytes_byte_length\"\nbuiltin bytes_to_string_unchecked(value: Bytes) -> String = \"dew_bytes_to_string_unchecked\"\nbuiltin bytes_byte_at(value: Bytes, index: U32) -> U8 = \"dew_bytes_byte_at\"\nbuiltin bytes_view(value: Bytes, start: U32, length: U32) -> Bytes = \"dew_bytes_view\"\nbuiltin bytes_concat(left: Bytes, right: Bytes) -> Bytes = \"dew_bytes_concat\"\n\nfn string_view_as_bytes(value: StringView) -> Bytes {\n  string_view_as_bytes_unchecked(value)\n}\n\n// The caller supplies known-valid UTF-8 from a String or StringView.\nfn text_utf16_length(value: Bytes) -> U32 {\n  let length = bytes_byte_length(value)\n  let mut continuations = 0u32\n  let mut four_byte_leads = 0u32\n  let tail = while 0u32 {\n    index if length - index >= 16u32 => {\n      let chunk = wasm_bytes_load_u8x16(value, index)\n      let continuation_mask = wasm_u8x16_eq(wasm_u8x16_and(chunk, wasm_u8x16_splat(192u8)), wasm_u8x16_splat(128u8))\n      let four_byte_mask = wasm_u8x16_ge_u(chunk, wasm_u8x16_splat(240u8))\n      continuations = continuations + wasm_u32_popcnt(wasm_u8x16_bitmask(continuation_mask))\n      four_byte_leads = four_byte_leads + wasm_u32_popcnt(wasm_u8x16_bitmask(four_byte_mask))\n      continue index + 16u32\n    }\n    index => break index\n  }\n  while tail {\n    index if index < length => {\n      let byte = bytes_byte_at(value, index)\n      if byte >= 128u8 && byte < 192u8 {\n        continuations = continuations + 1u32\n      }\n      if byte >= 240u8 {\n        four_byte_leads = four_byte_leads + 1u32\n      }\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  length - continuations + four_byte_leads\n}\n\nfn string_view_utf16_length(value: StringView) -> U32 {\n  text_utf16_length(string_view_as_bytes(value))\n}\n\nfn string_view_equals(left: StringView, right: StringView) -> Bool {\n  bytes_equals(string_view_as_bytes(left), string_view_as_bytes(right))\n}\n\nfn string_view_hash(value: StringView) -> U64 {\n  bytes_hash(string_view_as_bytes(value))\n}\n\nfn string_view_find_raw(value: StringView, needle: StringView) -> U32 {\n  bytes_find_raw(string_view_as_bytes(value), string_view_as_bytes(needle))\n}\n\nfn string_view_find_string_raw(value: StringView, needle: String) -> U32 {\n  bytes_find_raw(string_view_as_bytes(value), string_as_bytes(needle))\n}\n\nfn string_view_starts_with(value: StringView, prefix: StringView) -> Bool {\n  bytes_starts_with(string_view_as_bytes(value), string_view_as_bytes(prefix))\n}\n\nfn string_view_starts_with_string(value: StringView, prefix: String) -> Bool {\n  bytes_starts_with(string_view_as_bytes(value), string_as_bytes(prefix))\n}\n\nfn string_view_ends_with(value: StringView, suffix: StringView) -> Bool {\n  bytes_ends_with(string_view_as_bytes(value), string_view_as_bytes(suffix))\n}\n\nfn string_view_ends_with_string(value: StringView, suffix: String) -> Bool {\n  bytes_ends_with(string_view_as_bytes(value), string_as_bytes(suffix))\n}\n\nfn bytes_to_string(value: Bytes) -> String {\n  if !bytes_is_valid_utf8(value) {\n    unreachable()\n  }\n  bytes_to_string_unchecked(value)\n}\n\n// All callers prove both ranges before this allocation-free comparison.\nfn bytes_range_equals(left: Bytes, left_start: U32, right: Bytes, right_start: U32, length: U32) -> Bool {\n  let tail = while 0u32 {\n    index if length - index >= 16u32 => {\n      let left_chunk = wasm_bytes_load_u8x16(left, left_start + index)\n      let right_chunk = wasm_bytes_load_u8x16(right, right_start + index)\n      if wasm_u8x16_bitmask(wasm_u8x16_eq(left_chunk, right_chunk)) != 65535u32 {\n        return false\n      }\n      continue index + 16u32\n    }\n    index => break index\n  }\n  while tail {\n    index if index < length => {\n      if bytes_byte_at(left, left_start + index) != bytes_byte_at(right, right_start + index) {\n        return false\n      }\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  true\n}\n\nfn bytes_equals(left: Bytes, right: Bytes) -> Bool {\n  let length = bytes_byte_length(left)\n  length == bytes_byte_length(right) && bytes_range_equals(left, 0u32, right, 0u32, length)\n}\n\nfn bytes_starts_with(left: Bytes, prefix: Bytes) -> Bool {\n  let length = bytes_byte_length(prefix)\n  length <= bytes_byte_length(left) && bytes_range_equals(left, 0u32, prefix, 0u32, length)\n}\n\nfn bytes_ends_with(left: Bytes, suffix: Bytes) -> Bool {\n  let length = bytes_byte_length(left)\n  let suffix_length = bytes_byte_length(suffix)\n  suffix_length <= length && bytes_range_equals(left, length - suffix_length, suffix, 0u32, suffix_length)\n}\n\nfn bytes_widen_byte(value: U8) -> U64 {\n  value.into()\n}\n\nfn bytes_hash_chunk(initial: U64, chunk: U8x16) -> U64 {\n  let mut hash = initial\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_0(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_1(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_2(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_3(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_4(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_5(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_6(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_7(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_8(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_9(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_10(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_11(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_12(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_13(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_14(chunk))) * 1099511628211u64\n  hash = (hash ^ bytes_widen_byte(wasm_u8x16_extract_15(chunk))) * 1099511628211u64\n  hash\n}\n\nfn bytes_hash(value: Bytes) -> U64 {\n  let length = bytes_byte_length(value)\n  let mut hash = 14695981039346656037u64\n  let tail = while 0u32 {\n    index if length - index >= 16u32 => {\n      hash = bytes_hash_chunk(hash, wasm_bytes_load_u8x16(value, index))\n      continue index + 16u32\n    }\n    index => break index\n  }\n  while tail {\n    index if index < length => {\n      hash = (hash ^ bytes_widen_byte(bytes_byte_at(value, index))) * 1099511628211u64\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  hash\n}\n\nfn bytes_find_byte_raw(value: Bytes, byte: U8) -> U32 {\n  let length = bytes_byte_length(value)\n  let wanted = wasm_u8x16_splat(byte)\n  let tail = while 0u32 {\n    index if length - index >= 16u32 => {\n      let mask = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, index), wanted))\n      if mask != 0u32 {\n        return index + wasm_u32_ctz(mask)\n      }\n      continue index + 16u32\n    }\n    index => break index\n  }\n  while tail {\n    index if index < length => {\n      if bytes_byte_at(value, index) == byte {\n        return index\n      }\n      continue index + 1u32\n    }\n    _ => break 4294967295u32\n  }\n}\n\nfn bytes_find_short(value: Bytes, needle: Bytes, needle_length: U32, limit: U32) -> U32 {\n  let first = wasm_u8x16_splat(bytes_byte_at(needle, 0u32))\n  let last = wasm_u8x16_splat(bytes_byte_at(needle, needle_length - 1u32))\n  while 0u32 {\n    candidate if candidate <= limit => {\n      if limit - candidate >= 15u32 {\n        let heads = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate), first))\n        let tails = wasm_u8x16_bitmask(wasm_u8x16_eq(wasm_bytes_load_u8x16(value, candidate + needle_length - 1u32), last))\n        while heads & tails {\n          mask if mask != 0u32 => {\n            let index = candidate + wasm_u32_ctz(mask)\n            if bytes_range_equals(value, index, needle, 0u32, needle_length) {\n              return index\n            }\n            continue mask & (mask - 1u32)\n          }\n          _ => break ()\n        }\n        continue candidate + 16u32\n      }\n      if bytes_range_equals(value, candidate, needle, 0u32, needle_length) {\n        return candidate\n      }\n      continue candidate + 1u32\n    }\n    _ => break 4294967295u32\n  }\n}\n\nfn bytes_find_raw(value: Bytes, needle: Bytes) -> U32 {\n  let length = bytes_byte_length(value)\n  let needle_length = bytes_byte_length(needle)\n  if needle_length == 0u32 {\n    return 0u32\n  }\n  if needle_length > length {\n    return 4294967295u32\n  }\n  if needle_length == 1u32 {\n    return bytes_find_byte_raw(value, bytes_byte_at(needle, 0u32))\n  }\n  let limit = length - needle_length\n  if needle_length <= 16u32 {\n    return bytes_find_short(value, needle, needle_length, limit)\n  }\n  // Rolling hashes reject most long candidates in constant time. A hash match\n  // is only a candidate: compare the bytes before reporting a match.\n  let mut needle_hash = 0u64\n  let mut window_hash = 0u64\n  let mut power = 1u64\n  while 0u32 {\n    index if index < needle_length => {\n      needle_hash = needle_hash * 257u64 + bytes_widen_byte(bytes_byte_at(needle, index))\n      window_hash = window_hash * 257u64 + bytes_widen_byte(bytes_byte_at(value, index))\n      if index < needle_length - 1u32 {\n        power = power * 257u64\n      }\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  while 0u32 {\n    candidate => {\n      if window_hash == needle_hash && bytes_range_equals(value, candidate, needle, 0u32, needle_length) {\n        return candidate\n      }\n      if candidate == limit {\n        break 4294967295u32\n      }\n      window_hash = (window_hash - bytes_widen_byte(bytes_byte_at(value, candidate)) * power) * 257u64 + bytes_widen_byte(bytes_byte_at(value, candidate + needle_length))\n      continue candidate + 1u32\n    }\n  }\n}\n\nfn bytes_utf8_continuation(byte: U8) -> Bool {\n  byte >= 128u8 && byte <= 191u8\n}\n\nfn bytes_is_valid_utf8(value: Bytes) -> Bool {\n  let length = bytes_byte_length(value)\n  while 0u32 {\n    index if index < length => {\n      let remaining = length - index\n      if remaining >= 16u32 && wasm_u8x16_bitmask(wasm_bytes_load_u8x16(value, index)) == 0u32 {\n        continue index + 16u32\n      }\n      let first = bytes_byte_at(value, index)\n      if first < 128u8 {\n        continue index + 1u32\n      }\n      if first < 194u8 || first > 244u8 {\n        return false\n      }\n      if first < 224u8 {\n        if remaining < 2u32 || !bytes_utf8_continuation(bytes_byte_at(value, index + 1u32)) {\n          return false\n        }\n        continue index + 2u32\n      }\n      if first < 240u8 {\n        if remaining < 3u32 {\n          return false\n        }\n        let second = bytes_byte_at(value, index + 1u32)\n        if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) {\n          return false\n        }\n        if (first == 224u8 && second < 160u8) || (first == 237u8 && second >= 160u8) {\n          return false\n        }\n        continue index + 3u32\n      }\n      if remaining < 4u32 {\n        return false\n      }\n      let second = bytes_byte_at(value, index + 1u32)\n      if !bytes_utf8_continuation(second) || !bytes_utf8_continuation(bytes_byte_at(value, index + 2u32)) || !bytes_utf8_continuation(bytes_byte_at(value, index + 3u32)) {\n        return false\n      }\n      if (first == 240u8 && second < 144u8) || (first == 244u8 && second >= 144u8) {\n        return false\n      }\n      continue index + 4u32\n    }\n    _ => break true\n  }\n}\n",
    b"impl Eq for String {\n  fn eq(self, right: String) -> Bool {\n    string_equals(self, right)\n  }\n}\n\nimpl Ne for String {\n  fn ne(self, right: String) -> Bool {\n    !string_equals(self, right)\n  }\n}\n\nimpl Eq for StringView {\n  fn eq(self, right: StringView) -> Bool {\n    string_view_equals(self, right)\n  }\n}\n\nimpl Ne for StringView {\n  fn ne(self, right: StringView) -> Bool {\n    !string_view_equals(self, right)\n  }\n}\n\nimpl Hash for String {\n  fn hash(self) -> U64 {\n    string_hash(self)\n  }\n  fn hash_eq(self, right: String) -> Bool {\n    string_equals(self, right)\n  }\n}\n\nimpl Hash for StringView {\n  fn hash(self) -> U64 {\n    string_view_hash(self)\n  }\n  fn hash_eq(self, right: StringView) -> Bool {\n    string_view_equals(self, right)\n  }\n}\n\nimpl String {\n  fn byte_length(self) -> U32 {\n    string_byte_length(self)\n  }\n  fn as_bytes(self) -> Bytes {\n    string_as_bytes(self)\n  }\n  fn utf16_length(self) -> U32 {\n    string_utf16_length(self)\n  }\n  fn equals(self, other: String) -> Bool {\n    string_equals(self, other)\n  }\n  fn byte_at(self, index: U32) -> U8 {\n    string_byte_at(self, index)\n  }\n  fn view(self, start: U32, length: U32) -> StringView {\n    string_view(self, start, length)\n  }\n  fn subarray(self, start: U32, end: U32) -> StringView {\n    string_view(self, start, end - start)\n  }\n  fn slice(self, start: U32, end: U32) -> String {\n    let view = string_view(self, start, end - start)\n    let builder = string_builder_with_capacity_raw(view.byte_length())\n    string_builder_append_view(builder, view)\n    string_builder_finish(builder)\n  }\n  fn compact(self) -> String {\n    let builder = string_builder_with_capacity_raw(self.byte_length())\n    string_builder_append(builder, self)\n    string_builder_finish(builder)\n  }\n  fn concat(self, other: String) -> String {\n    string_concat(self, other)\n  }\n  fn concat_view(self, other: StringView) -> String {\n    string_concat_view(self, other)\n  }\n  fn find(self, needle: String) -> Option<U32> {\n    dew_option_u32_from_raw(string_find_raw(self, needle))\n  }\n  fn find_view(self, needle: StringView) -> Option<U32> {\n    dew_option_u32_from_raw(string_find_view_raw(self, needle))\n  }\n  fn contains(self, needle: String) -> Bool {\n    string_find_raw(self, needle) != 4294967295u32\n  }\n  fn contains_view(self, needle: StringView) -> Bool {\n    string_find_view_raw(self, needle) != 4294967295u32\n  }\n  fn starts_with(self, prefix: String) -> Bool {\n    string_starts_with(self, prefix)\n  }\n  fn starts_with_view(self, prefix: StringView) -> Bool {\n    string_starts_with_view(self, prefix)\n  }\n  fn ends_with(self, suffix: String) -> Bool {\n    string_ends_with(self, suffix)\n  }\n  fn ends_with_view(self, suffix: StringView) -> Bool {\n    string_ends_with_view(self, suffix)\n  }\n}\n\nimpl StringView {\n  fn byte_length(self) -> U32 {\n    string_view_byte_length(self)\n  }\n  fn byte_at(self, index: U32) -> U8 {\n    string_view_byte_at(self, index)\n  }\n  fn to_string(self) -> String {\n    string_view_to_string(self)\n  }\n  fn as_bytes(self) -> Bytes {\n    string_view_as_bytes(self)\n  }\n  fn utf16_length(self) -> U32 {\n    string_view_utf16_length(self)\n  }\n  fn equals(self, other: StringView) -> Bool {\n    string_view_equals(self, other)\n  }\n  fn view(self, start: U32, length: U32) -> StringView {\n    string_view_view(self, start, length)\n  }\n  fn subarray(self, start: U32, end: U32) -> StringView {\n    string_view_view(self, start, end - start)\n  }\n  fn slice(self, start: U32, end: U32) -> String {\n    let view = string_view_view(self, start, end - start)\n    let builder = string_builder_with_capacity_raw(view.byte_length())\n    string_builder_append_view(builder, view)\n    string_builder_finish(builder)\n  }\n  fn compact(self) -> String {\n    let builder = string_builder_with_capacity_raw(self.byte_length())\n    string_builder_append_view(builder, self)\n    string_builder_finish(builder)\n  }\n  fn find(self, needle: StringView) -> Option<U32> {\n    dew_option_u32_from_raw(string_view_find_raw(self, needle))\n  }\n  fn find_string(self, needle: String) -> Option<U32> {\n    dew_option_u32_from_raw(string_view_find_string_raw(self, needle))\n  }\n  fn contains(self, needle: StringView) -> Bool {\n    string_view_find_raw(self, needle) != 4294967295u32\n  }\n  fn contains_string(self, needle: String) -> Bool {\n    string_view_find_string_raw(self, needle) != 4294967295u32\n  }\n  fn starts_with(self, prefix: StringView) -> Bool {\n    string_view_starts_with(self, prefix)\n  }\n  fn starts_with_string(self, prefix: String) -> Bool {\n    string_view_starts_with_string(self, prefix)\n  }\n  fn ends_with(self, suffix: StringView) -> Bool {\n    string_view_ends_with(self, suffix)\n  }\n  fn ends_with_string(self, suffix: String) -> Bool {\n    string_view_ends_with_string(self, suffix)\n  }\n}\n",
    b"fn string_builder_u64_to_u8(value: U64) -> U8 {\n  value.into()\n}\n\nfn string_builder_i8_to_i64(value: I8) -> I64 {\n  value.into()\n}\n\nfn string_builder_i16_to_i64(value: I16) -> I64 {\n  value.into()\n}\n\nfn string_builder_i32_to_i64(value: I32) -> I64 {\n  value.into()\n}\n\nfn string_builder_u8_to_u64(value: U8) -> U64 {\n  value.into()\n}\n\nfn string_builder_u16_to_u64(value: U16) -> U64 {\n  value.into()\n}\n\nfn string_builder_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn string_builder_i64_to_u64(value: I64) -> U64 {\n  value.into()\n}\n\nfn string_builder_append_u64_digits(builder: StringBuilder, value: U64) -> Unit {\n  if value >= 10u64 {\n    string_builder_append_u64_digits(builder, value / 10u64)\n  } else {\n  }\n  string_builder_append_ascii(builder, string_builder_u64_to_u8(value % 10u64) + 48u8)\n}\n\nfn string_builder_append_i64_value(builder: StringBuilder, value: I64) -> Unit {\n  if value < 0i64 {\n    string_builder_append_ascii(builder, 45u8)\n    string_builder_append_u64_digits(\n      builder,\n      string_builder_i64_to_u64(-(value + 1i64)) + 1u64,\n    )\n  } else {\n    string_builder_append_u64_digits(builder, string_builder_i64_to_u64(value))\n  }\n}\n\nimpl StringBuilder {\n  fn new() -> StringBuilder {\n    string_builder_new()\n  }\n  fn with_capacity(capacity: U32) -> StringBuilder {\n    string_builder_with_capacity_raw(capacity)\n  }\n  fn byte_length(self) -> U32 {\n    string_builder_byte_length(self)\n  }\n  fn append(self, value: String) -> Unit {\n    string_builder_append(self, value)\n  }\n  fn append_view(self, value: StringView) -> Unit {\n    string_builder_append_view(self, value)\n  }\n  fn append_ascii(self, byte: U8) -> Unit {\n    string_builder_append_ascii(self, byte)\n  }\n  fn append_scalar(self, scalar: U32) -> Unit {\n    string_builder_append_scalar(self, scalar)\n  }\n  fn append_checked(self, bytes: Bytes) -> Unit {\n    string_builder_append(self, bytes_to_string(bytes))\n  }\n  fn append_i8(self, value: I8) -> Unit {\n    string_builder_append_i64_value(self, string_builder_i8_to_i64(value))\n  }\n  fn append_i16(self, value: I16) -> Unit {\n    string_builder_append_i64_value(self, string_builder_i16_to_i64(value))\n  }\n  fn append_i32(self, value: I32) -> Unit {\n    string_builder_append_i64_value(self, string_builder_i32_to_i64(value))\n  }\n  fn append_i64(self, value: I64) -> Unit {\n    string_builder_append_i64_value(self, value)\n  }\n  fn append_u8(self, value: U8) -> Unit {\n    string_builder_append_u64_digits(self, string_builder_u8_to_u64(value))\n  }\n  fn append_u16(self, value: U16) -> Unit {\n    string_builder_append_u64_digits(self, string_builder_u16_to_u64(value))\n  }\n  fn append_u32(self, value: U32) -> Unit {\n    string_builder_append_u64_digits(self, string_builder_u32_to_u64(value))\n  }\n  fn append_u64(self, value: U64) -> Unit {\n    string_builder_append_u64_digits(self, value)\n  }\n  fn finish(self) -> String {\n    string_builder_finish(self)\n  }\n}\n",
    b"impl BytesBuilder {\n  fn new() -> BytesBuilder {\n    bytes_builder_new()\n  }\n  fn with_capacity(capacity: U32) -> BytesBuilder {\n    bytes_builder_with_capacity_raw(capacity)\n  }\n  fn byte_length(self) -> U32 {\n    bytes_builder_byte_length(self)\n  }\n  fn append(self, value: Bytes) -> Unit {\n    bytes_builder_append(self, value)\n  }\n  fn append_byte(self, byte: U8) -> Unit {\n    bytes_builder_append_byte(self, byte)\n  }\n  fn finish(self) -> Bytes {\n    bytes_builder_finish(self)\n  }\n}\n",
    b"impl Eq for Bytes {\n  fn eq(self, right: Bytes) -> Bool {\n    bytes_equals(self, right)\n  }\n}\n\nimpl Ne for Bytes {\n  fn ne(self, right: Bytes) -> Bool {\n    !bytes_equals(self, right)\n  }\n}\n\nimpl Hash for Bytes {\n  fn hash(self) -> U64 {\n    bytes_hash(self)\n  }\n  fn hash_eq(self, right: Bytes) -> Bool {\n    bytes_equals(self, right)\n  }\n}\n\nimpl Bytes {\n  fn byte_length(self) -> U32 {\n    bytes_byte_length(self)\n  }\n  fn is_valid_utf8(self) -> Bool {\n    bytes_is_valid_utf8(self)\n  }\n  fn to_string(self) -> String {\n    bytes_to_string(self)\n  }\n  fn equals(self, other: Bytes) -> Bool {\n    bytes_equals(self, other)\n  }\n  fn byte_at(self, index: U32) -> U8 {\n    bytes_byte_at(self, index)\n  }\n  fn view(self, start: U32, length: U32) -> Bytes {\n    bytes_view(self, start, length)\n  }\n  fn subarray(self, start: U32, end: U32) -> Bytes {\n    bytes_view(self, start, end - start)\n  }\n  fn slice(self, start: U32, end: U32) -> Bytes {\n    let view = bytes_view(self, start, end - start)\n    let builder = bytes_builder_with_capacity_raw(view.byte_length())\n    bytes_builder_append(builder, view)\n    bytes_builder_finish(builder)\n  }\n  fn compact(self) -> Bytes {\n    let builder = bytes_builder_with_capacity_raw(self.byte_length())\n    bytes_builder_append(builder, self)\n    bytes_builder_finish(builder)\n  }\n  fn concat(self, other: Bytes) -> Bytes {\n    bytes_concat(self, other)\n  }\n  fn find_byte(self, byte: U8) -> Option<U32> {\n    let index = bytes_find_byte_raw(self, byte)\n    if index == 4294967295u32 {\n      Option::None\n    } else {\n      Option::Some(index)\n    }\n  }\n  fn contains_byte(self, byte: U8) -> Bool {\n    bytes_find_byte_raw(self, byte) != 4294967295u32\n  }\n  fn find(self, needle: Bytes) -> Option<U32> {\n    if needle.byte_length() == 1u32 {\n      self.find_byte(needle.byte_at(0u32))\n    } else {\n      dew_option_u32_from_raw(bytes_find_raw(self, needle))\n    }\n  }\n  fn contains(self, needle: Bytes) -> Bool {\n    if needle.byte_length() == 1u32 {\n      self.contains_byte(needle.byte_at(0u32))\n    } else {\n      bytes_find_raw(self, needle) != 4294967295u32\n    }\n  }\n  fn starts_with(self, prefix: Bytes) -> Bool {\n    bytes_starts_with(self, prefix)\n  }\n  fn ends_with(self, suffix: Bytes) -> Bool {\n    bytes_ends_with(self, suffix)\n  }\n}\n",

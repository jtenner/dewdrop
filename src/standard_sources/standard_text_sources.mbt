lf, suffix: StringView) -> Bool {\n    string_ends_with_view(self, suffix)\n  }\n}\n\nimpl StringView {\n  fn byte_length(self) -> U32 {\n    string_view_byte_length(self)\n  }\n  fn byte_at(self, index: U32) -> U8 {\n    string_view_byte_at(self, index)\n  }\n  fn to_string(self) -> String {\n    string_view_to_string(self)\n  }\n  fn as_bytes(self) -> Bytes {\n    string_view_as_bytes(self)\n  }\n  fn utf16_length(self) -> U32 {\n    string_view_utf16_length(self)\n  }\n  fn equals(self, other: StringView) -> Bool {\n    string_view_equals(self, other)\n  }\n  fn view(self, start: U32, length: U32) -> StringView {\n    string_view_view(self, start, length)\n  }\n  fn subarray(self, start: U32, end: U32) -> StringView {\n    string_view_view(self, start, end - start)\n  }\n  fn slice(self, start: U32, end: U32) -> String {\n    let view = string_view_view(self, start, end - start)\n    let builder = string_builder_with_capacity_raw(view.byte_length())\n    string_builder_append_view(builder, view)\n    string_builder_finish(builder)\n  }\n  fn compact(self) -> String {\n    let builder = string_builder_with_capacity_raw(self.byte_length())\n    string_builder_append_view(builder, self)\n    string_builder_finish(builder)\n  }\n  fn find(self, needle: StringView) -> Option<U32> {\n    dew_option_u32_from_raw(string_view_find_raw(self, needle))\n  }\n  fn find_string(self, needle: String) -> Option<U32> {\n    dew_option_u32_from_raw(string_view_find_string_raw(self, needle))\n  }\n  fn contains(self, needle: StringView) -> Bool {\n    string_view_find_raw(self, needle) != 4294967295u32\n  }\n  fn contains_string(self, needle: String) -> Bool {\n    string_view_find_string_raw(self, needle) != 4294967295u32\n  }\n  fn starts_with(self, prefix: StringView) -> Bool {\n    string_view_starts_with(self, prefix)\n  }\n  fn starts_with_string(self, prefix: String) -> Bool {\n    string_view_starts_with_string(self, prefix)\n  }\n  fn ends_with(self, suffix: StringView) -> 
ilder_finish(value: BytesBuilder) -> Bytes = \"dew_bytes_builder_finish\"\nbuiltin bytes_byte_length(value: Bytes) -> U32 = \"dew_bytes_byte_length\"\nbuiltin bytes_is_valid_utf8(value: Bytes) -> Bool = \"dew_bytes_is_valid_utf8\"\nbuiltin bytes_to_string(value: Bytes) -> String = \"dew_bytes_to_string\"\nbuiltin bytes_equals(left: Bytes, right: Bytes) -> Bool = \"dew_bytes_equals\"\nbuiltin bytes_byte_at(value: Bytes, index: U32) -> U8 = \"dew_bytes_byte_at\"\nbuiltin bytes_view(value: Bytes, start: U32, length: U32) -> Bytes = \"dew_bytes_view\"\nbuiltin bytes_concat(left: Bytes, right: Bytes) -> Bytes = \"dew_bytes_concat\"\nbuiltin bytes_find_byte_raw(value: Bytes, byte: U8) -> U32 = \"dew_bytes_find_byte\"\nbuiltin bytes_find_raw(value: Bytes, needle: Bytes) -> U32 = \"dew_bytes_find\"\nbuiltin bytes_starts_with(left: Bytes, prefix: Bytes) -> Bool = \"dew_bytes_starts_with\"\nbuiltin bytes_ends_with(left: Bytes, suffix: Bytes) -> Bool = \"dew_bytes_ends_with\"\n",

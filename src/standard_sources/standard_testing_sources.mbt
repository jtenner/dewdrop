///|
pub fn standard_testing_source() -> Bytes {
  b"pub fn fail(message: String) -> Unit {\n  assert(false, message)\n}\n\npub fn assert_true(condition: Bool, message: String) -> Unit {\n  assert(condition, message)\n}\n\npub fn assert_false(condition: Bool, message: String) -> Unit {\n  assert(!condition, message)\n}\n\npub fn assert_equal<t: Eq>(actual: t, expected: t, message: String) -> Unit {\n  assert(actual == expected, message)\n}\n\npub fn assert_not_equal<t: Eq>(actual: t, expected: t, message: String) -> Unit {\n  assert(!(actual == expected), message)\n}\n\npub fn assert_less<t: Lt>(actual: t, expected: t, message: String) -> Unit {\n  assert(actual < expected, message)\n}\n\npub fn assert_less_or_equal<t: Lte>(actual: t, expected: t, message: String) -> Unit {\n  assert(actual <= expected, message)\n}\n\npub fn assert_greater<t: Gt>(actual: t, expected: t, message: String) -> Unit {\n  assert(actual > expected, message)\n}\n\npub fn assert_greater_or_equal<t: Gte>(actual: t, expected: t, message: String) -> Unit {\n  assert(actual >= expected, message)\n}\n\npub fn assert_option_some<t>(value: Option<t>, message: String) -> Unit {\n  match value {\n    Option::Some(_) => {}\n    Option::None => fail(message)\n  }\n}\n\npub fn assert_option_none<t>(value: Option<t>, message: String) -> Unit {\n  match value {\n    Option::Some(_) => fail(message)\n    Option::None => {}\n  }\n}\n\npub fn assert_result_ok<t, e>(value: Result<t, e>, message: String) -> Unit {\n  match value {\n    Result::Ok(_) => {}\n    Result::Err(_) => fail(message)\n  }\n}\n\npub fn assert_result_err<t, e>(value: Result<t, e>, message: String) -> Unit {\n  match value {\n    Result::Ok(_) => fail(message)\n    Result::Err(_) => {}\n  }\n}\n"
}

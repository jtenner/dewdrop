///|
pub fn standard_array_source() -> Bytes {
  b"open dew.std.wasm.intrinsics\n\npub struct Array<t> {\n  mut backing: WasmArray<t>\n  mut count: U32\n  mut limit: U32\n}\npub struct ArrayIter<t> {}\n\npub builtin array_new<t>() -> Array<t> = \"dew_array_new\"\npub builtin array_with_capacity<t>(capacity: U32) -> Array<t> = \"dew_array_with_capacity\"\npub fn array_length<t>(value: Array<t>) -> U32 {\n  value.count\n}\npub fn array_capacity<t>(value: Array<t>) -> U32 {\n  value.limit\n}\npub fn array_get<t>(value: Array<t>, index: U32) -> Option<t> {\n  if index < array_length(value) {\n    Option::Some(array_get_unchecked(value, index))\n  } else {\n    Option::None\n  }\n}\npub builtin array_get_unchecked<t>(value: Array<t>, index: U32) -> t = \"dew_array_get_unchecked\"\npub fn array_set<t>(value: Array<t>, index: U32, item: t) -> Bool {\n  if index < array_length(value) {\n    array_set_unchecked(value, index, item)\n    true\n  } else {\n    false\n  }\n}\npub builtin array_set_unchecked<t>(value: Array<t>, index: U32, item: t) -> Unit = \"dew_array_set_unchecked\"\npub builtin array_push<t>(value: Array<t>, item: t) -> Unit = \"dew_array_push\"\npub builtin array_pop<t>(value: Array<t>) -> Option<t> = \"dew_array_pop\"\npub builtin array_clear<t>(value: Array<t>) -> Unit = \"dew_array_clear\"\npub builtin array_iter<t>(value: Array<t>) -> ArrayIter<t> = \"dew_array_iter\"\npub builtin array_iter_has_next<t>(value: ArrayIter<t>) -> Bool = \"dew_array_iter_has_next\"\npub builtin array_iter_next<t>(value: ArrayIter<t>) -> t = \"dew_array_iter_next\"\n\nimpl<t> Array<t> {\n  fn new() -> Array<t> {\n    array_new()\n  }\n  fn with_capacity(capacity: U32) -> Array<t> {\n    array_with_capacity(capacity)\n  }\n  fn length(self) -> U32 {\n    array_length(self)\n  }\n  fn capacity(self) -> U32 {\n    array_capacity(self)\n  }\n  fn is_empty(self) -> Bool {\n    array_length(self) == 0u32\n  }\n  fn push(self, value: t) -> Unit {\n    array_push(self, value)\n  }\n  fn pop(self) -> Option<t> {\n    array_pop(self)\n  }\n  fn get(self, index: U32) -> Option<t> {\n    array_get(self, index)\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    array_get_unchecked(self, index)\n  }\n  fn set(self, index: U32, value: t) -> Bool {\n    array_set(self, index, value)\n  }\n  fn set_unchecked(self, index: U32, value: t) -> Unit {\n    array_set_unchecked(self, index, value)\n  }\n  fn clear(self) -> Unit {\n    array_clear(self)\n  }\n  fn iter(self) -> ArrayIter<t> {\n    array_iter(self)\n  }\n}\n\nimpl<t> IndexedGet<U32, t> for Array<t> {\n  fn indexed_get(self, index: U32) -> t {\n    array_get_unchecked(self, index)\n  }\n}\n\nimpl<t> IndexedSet<U32, t> for Array<t> {\n  fn indexed_set(self, index: U32, value: t) -> Unit {\n    array_set_unchecked(self, index, value)\n  }\n}\n\nimpl<t> Iter<t> for ArrayIter<t> {\n  fn next(self) -> Option<t> {\n    array_iter_next_option(self)\n  }\n}\n\nfn array_make_raw<t>(length: U32, value: t) -> Array<t> {\n  let output = array_with_capacity(length)\n  while 0u32 {\n    index if index < length => {\n      array_push(output, value)\n      continue index + 1u32\n    }\n    _ => break array_unit()\n  }\n  output\n}\n\nbuiltin array_reserve_raw<t>(value: Array<t>, additional: U32) -> Unit = \"dew_array_reserve\"\nbuiltin array_shrink_to_fit_raw<t>(value: Array<t>) -> Unit = \"dew_array_shrink_to_fit\"\nbuiltin array_truncate_raw<t>(value: Array<t>, length: U32) -> Unit = \"dew_array_truncate\"\n\nfn array_copy_raw<t>(value: Array<t>) -> Array<t> {\n  array_slice_raw(value, 0u32, array_length(value))\n}\n\nfn array_copy_within_raw<t>(value: Array<t>, target: U32, start: U32, end: U32) -> Unit {\n  let length = array_length(value)\n  array_require_range(length, start, end)\n  let count = end - start\n  if target > length || count > length - target {\n    unreachable()\n  } else if target > start && target - start < count {\n    // Copy backward when the destination overlaps the unread source suffix.\n    while count {\n      remaining if remaining > 0u32 => {\n        let offset = remaining - 1u32\n        array_set_unchecked(value, target + offset, array_get_unchecked(value, start + offset))\n        continue offset\n      }\n      _ => break array_unit()\n    }\n  } else {\n    while 0u32 {\n      offset if offset < count => {\n        array_set_unchecked(value, target + offset, array_get_unchecked(value, start + offset))\n        continue offset + 1u32\n      }\n      _ => break array_unit()\n    }\n  }\n}\n\nfn array_fill_raw<t>(value: Array<t>, item: t, start: U32, end: U32) -> Unit {\n  array_require_range(array_length(value), start, end)\n  while start {\n    index if index < end => {\n      array_set_unchecked(value, index, item)\n      continue index + 1u32\n    }\n    _ => break array_unit()\n  }\n}\n\nfn array_slice_raw<t>(value: Array<t>, start: U32, end: U32) -> Array<t> {\n  array_require_range(array_length(value), start, end)\n  let output = array_with_capacity(end - start)\n  while start {\n    index if index < end => {\n      array_push(output, array_get_unchecked(value, index))\n      continue index + 1u32\n    }\n    _ => break array_unit()\n  }\n  output\n}\n\nfn array_extend_raw<t>(value: Array<t>, source: Array<t>) -> Unit {\n  // Capture the length before push: source may alias value.\n  let count = array_length(source)\n  if count > 4294967295u32 - array_length(value) {\n    unreachable()\n  } else {\n    while 0u32 {\n      index if index < count => {\n        array_push(value, array_get_unchecked(source, index))\n        continue index + 1u32\n      }\n      _ => break array_unit()\n    }\n  }\n}\n\npub trait ArrayComparator<t> {\n  fn before(self, left: t, right: t) -> Bool\n}\n\npub struct NaturalArrayComparator {}\n\npub fn natural_array_comparator() -> NaturalArrayComparator {\n  NaturalArrayComparator::{\n  }\n}\n\nimpl<t: Lt> ArrayComparator<t> for NaturalArrayComparator {\n  fn before(self, left: t, right: t) -> Bool {\n    left < right\n  }\n}\n\npub struct ArrayEntry<t> {\n  index: U32\n  value: t\n}\n\npub struct ArrayKeyIter<t> {\n  values: Array<t>\n  mut index: U32\n}\n\npub struct ArrayEntryIter<t> {\n  values: Array<t>\n  mut index: U32\n}\n\nfn array_unit() -> Unit {}\n\nfn array_min(left: U32, right: U32) -> U32 {\n  if left < right {\n    left\n  } else {\n    right\n  }\n}\n\nfn array_require_range(length: U32, start: U32, end: U32) -> Unit {\n  if start > end || end > length {\n    unreachable()\n  } else {\n  }\n}\n\nfn array_extend_values<t>(value: Array<t>, source: Array<t>) -> Unit {\n  array_extend_raw(value, source)\n}\n\nfn array_at_index(length: U32, index: I32) -> Option<U32> {\n  let wide_length = u32_into_i64(length)\n  let wide_index = i32_into_i64(index)\n  let resolved = if wide_index < 0i64 {\n    wide_length + wide_index\n  } else {\n    wide_index\n  }\n  if resolved < 0i64 || resolved >= wide_length {\n    Option::None\n  } else {\n    Option::Some(i64_into_u32(resolved))\n  }\n}\n\nfn array_merge_pass_natural<t: Lt>(\n  source: Array<t>,\n  target: Array<t>,\n  width: U32,\n  length: U32,\n) -> Unit {\n  while 0u32 {\n    left if left < length => {\n      let middle = if width > length - left {\n        length\n      } else {\n        left + width\n      }\n      let end = if width > length - middle {\n        length\n      } else {\n        middle + width\n      }\n      let mut first = left\n      let mut second = middle\n      let mut output = left\n      while true {\n        true if first < middle && second < end => {\n          let left_value = array_get_unchecked(source, first)\n          let right_value = array_get_unchecked(source, second)\n          if right_value < left_value {\n            array_set_unchecked(target, output, right_value)\n            second = second + 1u32\n          } else {\n            array_set_unchecked(target, output, left_value)\n            first = first + 1u32\n          }\n          output = output + 1u32\n          continue true\n        }\n        _ => break array_unit()\n      }\n      while first {\n        index if index < middle => {\n          let value = array_get_unchecked(source, index)\n          array_set_unchecked(target, output, value)\n          output = output + 1u32\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n      while second {\n        index if index < end => {\n          let value = array_get_unchecked(source, index)\n          array_set_unchecked(target, output, value)\n          output = output + 1u32\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n      continue end\n    }\n    _ => break array_unit()\n  }\n}\n\nfn array_merge_pass<t, c: ArrayComparator<t>>(\n  source: Array<t>,\n  target: Array<t>,\n  width: U32,\n  length: U32,\n  comparator: c,\n) -> Unit {\n  while 0u32 {\n    left if left < length => {\n      let middle = if width > length - left {\n        length\n      } else {\n        left + width\n      }\n      let end = if width > length - middle {\n        length\n      } else {\n        middle + width\n      }\n      let mut first = left\n      let mut second = middle\n      let mut output = left\n      while true {\n        true if first < middle && second < end => {\n          let left_value = array_get_unchecked(source, first)\n          let right_value = array_get_unchecked(source, second)\n          if comparator.before(right_value, left_value) {\n            array_set_unchecked(target, output, right_value)\n            second = second + 1u32\n          } else {\n            array_set_unchecked(target, output, left_value)\n            first = first + 1u32\n          }\n          output = output + 1u32\n          continue true\n        }\n        _ => break array_unit()\n      }\n      while first {\n        index if index < middle => {\n          let value = array_get_unchecked(source, index)\n          array_set_unchecked(target, output, value)\n          output = output + 1u32\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n      while second {\n        index if index < end => {\n          let value = array_get_unchecked(source, index)\n          array_set_unchecked(target, output, value)\n          output = output + 1u32\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n      continue end\n    }\n    _ => break array_unit()\n  }\n}\n\npub fn array_map_to<t, u>(values: Array<t>, mapper: fn(t) -> u) -> Array<u> {\n  let limit = array_length(values)\n  let output = Array::with_capacity(limit)\n  while 0u32 {\n    index if index < limit => {\n      if index < array_length(values) {\n        array_push(output, mapper(array_get_unchecked(values, index)))\n      } else {\n      }\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn array_map_to_indexed<t, u>(\n  values: Array<t>,\n  mapper: fn(t, U32) -> u,\n) -> Array<u> {\n  let limit = array_length(values)\n  let output = Array::with_capacity(limit)\n  while 0u32 {\n    index if index < limit => {\n      if index < array_length(values) {\n        array_push(output, mapper(array_get_unchecked(values, index), index))\n      } else {\n      }\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn array_flat_map_to<t, u>(\n  values: Array<t>,\n  mapper: fn(t) -> Array<u>,\n) -> Array<u> {\n  let limit = array_length(values)\n  let output = Array::new()\n  while 0u32 {\n    index if index < limit => {\n      if index < array_length(values) {\n        array_extend_values(output, mapper(array_get_unchecked(values, index)))\n      } else {\n      }\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn array_reduce_into<t, state>(\n  values: Array<t>,\n  initial: state,\n  reducer: fn(state, t) -> state,\n) -> state {\n  let limit = array_length(values)\n  let mut state_value = initial\n  while 0u32 {\n    index if index < limit => {\n      if index < array_length(values) {\n        state_value = reducer(\n          state_value,\n          array_get_unchecked(values, index),\n        )\n      } else {\n      }\n      continue index + 1u32\n    }\n    _ => break state_value\n  }\n}\n\npub fn array_reduce_right_into<t, state>(\n  values: Array<t>,\n  initial: state,\n  reducer: fn(state, t) -> state,\n) -> state {\n  let mut state_value = initial\n  while array_length(values) {\n    0u32 => break state_value\n    remaining => {\n      let index = remaining - 1u32\n      if index < array_length(values) {\n        state_value = reducer(\n          state_value,\n          array_get_unchecked(values, index),\n        )\n      } else {\n      }\n      continue index\n    }\n  }\n}\n\npub fn array_sort_by<t, c: ArrayComparator<t>>(\n  values: Array<t>,\n  comparator: c,\n) -> Unit {\n  let length = array_length(values)\n  if length < 2u32 {\n  } else {\n    let scratch = array_copy_raw(values)\n    let mut width = 1u32\n    let mut read_values = true\n    while true {\n      true if width < length => {\n        if read_values {\n          array_merge_pass(values, scratch, width, length, comparator)\n        } else {\n          array_merge_pass(scratch, values, width, length, comparator)\n        }\n        read_values = !read_values\n        if width > length / 2u32 {\n          width = length\n        } else {\n          width = width * 2u32\n        }\n        continue true\n      }\n      _ => break array_unit()\n    }\n    if !read_values {\n      while 0u32 {\n        index if index < length => {\n          let value = array_get_unchecked(scratch, index)\n          array_set_unchecked(values, index, value)\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n    } else {\n    }\n  }\n}\n\npub fn array_to_sorted_by<t, c: ArrayComparator<t>>(\n  values: Array<t>,\n  comparator: c,\n) -> Array<t> {\n  let output = array_copy_raw(values)\n  array_sort_by(output, comparator)\n  output\n}\n\nimpl<t> Array<t> {\n  fn make(length: U32, value: t) -> Array<t> {\n    array_make_raw(length, value)\n  }\n  fn reserve(self, additional: U32) -> Unit {\n    array_reserve_raw(self, additional)\n  }\n  fn shrink_to_fit(self) -> Unit {\n    array_shrink_to_fit_raw(self)\n  }\n  fn truncate(self, length: U32) -> Unit {\n    array_truncate_raw(self, length)\n  }\n  fn copy(self) -> Array<t> {\n    array_copy_raw(self)\n  }\n  fn clone(self) -> Array<t> {\n    array_copy_raw(self)\n  }\n  fn extend(self, source: Array<t>) -> Unit {\n    array_extend_values(self, source)\n  }\n  fn push_all(self, source: Array<t>) -> Unit {\n    array_extend_values(self, source)\n  }\n  fn first(self) -> Option<t> {\n    array_get(self, 0u32)\n  }\n  fn last(self) -> Option<t> {\n    let length = array_length(self)\n    if length == 0u32 {\n      Option::None\n    } else {\n      array_get(self, length - 1u32)\n    }\n  }\n  fn at(self, index: I32) -> Option<t> {\n    match array_at_index(array_length(self), index) {\n      Option::Some(resolved) => array_get(self, resolved)\n      Option::None => Option::None\n    }\n  }\n  fn swap(self, left: U32, right: U32) -> Unit {\n    let length = array_length(self)\n    if left >= length || right >= length {\n      unreachable()\n    } else if left == right {\n    } else {\n      let left_value = array_get_unchecked(self, left)\n      let right_value = array_get_unchecked(self, right)\n      array_set_unchecked(self, left, right_value)\n      array_set_unchecked(self, right, left_value)\n    }\n  }\n  fn shift(self) -> Option<t> {\n    let length = array_length(self)\n    if length == 0u32 {\n      Option::None\n    } else {\n      let value = array_get_unchecked(self, 0u32)\n      if length > 1u32 {\n        array_copy_within_raw(self, 0u32, 1u32, length)\n      } else {\n      }\n      array_truncate_raw(self, length - 1u32)\n      Option::Some(value)\n    }\n  }\n  fn unshift(self, value: t) -> Unit {\n    let length = array_length(self)\n    array_reserve_raw(self, 1u32)\n    array_push(self, value)\n    if length > 0u32 {\n      array_copy_within_raw(self, 1u32, 0u32, length)\n      array_set_unchecked(self, 0u32, value)\n    } else {\n    }\n  }\n  fn insert(self, index: U32, value: t) -> Bool {\n    let length = array_length(self)\n    if index > length {\n      false\n    } else {\n      array_reserve_raw(self, 1u32)\n      array_push(self, value)\n      if index < length {\n        array_copy_within_raw(self, index + 1u32, index, length)\n        array_set_unchecked(self, index, value)\n      } else {\n      }\n      true\n    }\n  }\n  fn remove(self, index: U32) -> Option<t> {\n    let length = array_length(self)\n    if index >= length {\n      Option::None\n    } else {\n      let value = array_get_unchecked(self, index)\n      if index + 1u32 < length {\n        array_copy_within_raw(self, index, index + 1u32, length)\n      } else {\n      }\n      array_truncate_raw(self, length - 1u32)\n      Option::Some(value)\n    }\n  }\n  fn fill(self, value: t, start: U32, end: U32) -> Unit {\n    array_require_range(array_length(self), start, end)\n    array_fill_raw(self, value, start, end)\n  }\n  fn copy_within(self, target: U32, start: U32, end: U32) -> Unit {\n    let length = array_length(self)\n    array_require_range(length, start, end)\n    let count = end - start\n    if target > length || count > length - target {\n      unreachable()\n    } else {\n      array_copy_within_raw(self, target, start, end)\n    }\n  }\n  fn slice(self, start: U32, end: U32) -> Array<t> {\n    array_require_range(array_length(self), start, end)\n    array_slice_raw(self, start, end)\n  }\n  fn concat(self, other: Array<t>) -> Array<t> {\n    let output = array_copy_raw(self)\n    array_extend_values(output, other)\n    output\n  }\n  fn reverse(self) -> Unit {\n    let length = array_length(self)\n    if length > 1u32 {\n      let mut left = 0u32\n      let mut right = length - 1u32\n      while true {\n        true if left < right => {\n          let left_value = array_get_unchecked(self, left)\n          let right_value = array_get_unchecked(self, right)\n          array_set_unchecked(self, left, right_value)\n          array_set_unchecked(self, right, left_value)\n          left = left + 1u32\n          right = right - 1u32\n          continue true\n        }\n        _ => break array_unit()\n      }\n    } else {\n    }\n  }\n  fn to_reversed(self) -> Array<t> {\n    let output = array_copy_raw(self)\n    output.reverse()\n    output\n  }\n  fn splice(self, start: U32, delete_count: U32, items: Array<t>) -> Array<t> {\n    let length = array_length(self)\n    if start > length {\n      unreachable()\n    } else {\n    }\n    let deleted = array_min(delete_count, length - start)\n    let removed = array_slice_raw(self, start, start + deleted)\n    let additions = array_copy_raw(items)\n    let added = array_length(additions)\n    let tail = start + deleted\n    if added > deleted {\n      let extra = added - deleted\n      array_reserve_raw(self, extra)\n      while 0u32 {\n        index if index < extra => {\n          let value = array_get_unchecked(additions, index)\n          array_push(self, value)\n          continue index + 1u32\n        }\n        _ => break array_unit()\n      }\n      if tail < length {\n        array_copy_within_raw(self, start + added, tail, length)\n      } else {\n      }\n    } else if added < deleted {\n      if tail < length {\n        array_copy_within_raw(self, start + added, tail, length)\n      } else {\n      }\n      array_truncate_raw(self, length - (deleted - added))\n    } else {\n    }\n    while 0u32 {\n      index if index < added => {\n        let value = array_get_unchecked(additions, index)\n        array_set_unchecked(self, start + index, value)\n        continue index + 1u32\n      }\n      _ => break array_unit()\n    }\n    removed\n  }\n  fn to_spliced(self, start: U32, delete_count: U32, items: Array<t>) -> Array<t> {\n    let output = array_copy_raw(self)\n    output.splice(start, delete_count, items)\n    output\n  }\n  fn keys(self) -> ArrayKeyIter<t> {\n    ArrayKeyIter::{\n      values: self\n      index: 0u32\n    }\n  }\n  fn entries(self) -> ArrayEntryIter<t> {\n    ArrayEntryIter::{\n      values: self\n      index: 0u32\n    }\n  }\n  fn for_each(self, action: fn(t) -> Unit) -> Unit {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          action(array_get_unchecked(self, index))\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break array_unit()\n    }\n  }\n  fn for_each_indexed(self, action: fn(t, U32) -> Unit) -> Unit {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          action(array_get_unchecked(self, index), index)\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break array_unit()\n    }\n  }\n  fn map(self, mapper: fn(t) -> t) -> Array<t> {\n    let limit = array_length(self)\n    let output = Array::with_capacity(limit)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          array_push(output, mapper(array_get_unchecked(self, index)))\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn map_indexed(self, mapper: fn(t, U32) -> t) -> Array<t> {\n    let limit = array_length(self)\n    let output = Array::with_capacity(limit)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          array_push(output, mapper(array_get_unchecked(self, index), index))\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn filter(self, predicate: fn(t) -> Bool) -> Array<t> {\n    let limit = array_length(self)\n    let output = Array::with_capacity(limit)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          let value = array_get_unchecked(self, index)\n          if predicate(value) {\n            array_push(output, value)\n          } else {\n          }\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn filter_indexed(self, predicate: fn(t, U32) -> Bool) -> Array<t> {\n    let limit = array_length(self)\n    let output = Array::with_capacity(limit)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          let value = array_get_unchecked(self, index)\n          if predicate(value, index) {\n            array_push(output, value)\n          } else {\n          }\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn flat_map(self, mapper: fn(t) -> Array<t>) -> Array<t> {\n    let limit = array_length(self)\n    let output = Array::new()\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          array_extend_values(output, mapper(array_get_unchecked(self, index)))\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n  fn every(self, predicate: fn(t) -> Bool) -> Bool {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) && !predicate(array_get_unchecked(self, index)) {\n          break false\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break true\n    }\n  }\n  fn every_indexed(self, predicate: fn(t, U32) -> Bool) -> Bool {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) && !predicate(array_get_unchecked(self, index), index) {\n          break false\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break true\n    }\n  }\n  fn some(self, predicate: fn(t) -> Bool) -> Bool {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) && predicate(array_get_unchecked(self, index)) {\n          break true\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break false\n    }\n  }\n  fn some_indexed(self, predicate: fn(t, U32) -> Bool) -> Bool {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) && predicate(array_get_unchecked(self, index), index) {\n          break true\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break false\n    }\n  }\n  fn find(self, predicate: fn(t) -> Bool) -> Option<t> {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          let value = array_get_unchecked(self, index)\n          if predicate(value) {\n            break Option::Some(value)\n          } else {\n          }\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break Option::None\n    }\n  }\n  fn find_index(self, predicate: fn(t) -> Bool) -> Option<U32> {\n    let limit = array_length(self)\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) && predicate(array_get_unchecked(self, index)) {\n          break Option::Some(index)\n        } else {\n          continue index + 1u32\n        }\n      }\n      _ => break Option::None\n    }\n  }\n  fn find_last(self, predicate: fn(t) -> Bool) -> Option<t> {\n    let length = array_length(self)\n    while length {\n      0u32 => break Option::None\n      remaining => {\n        let index = remaining - 1u32\n        if index < array_length(self) {\n          let value = array_get_unchecked(self, index)\n          if predicate(value) {\n            break Option::Some(value)\n          } else {\n          }\n        } else {\n        }\n        continue index\n      }\n    }\n  }\n  fn find_last_index(self, predicate: fn(t) -> Bool) -> Option<U32> {\n    let length = array_length(self)\n    while length {\n      0u32 => break Option::None\n      remaining => {\n        let index = remaining - 1u32\n        if index < array_length(self) && predicate(array_get_unchecked(self, index)) {\n          break Option::Some(index)\n        } else {\n          continue index\n        }\n      }\n    }\n  }\n  fn reduce(self, initial: t, reducer: fn(t, t) -> t) -> t {\n    let limit = array_length(self)\n    let mut state_value = initial\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          state_value = reducer(state_value, array_get_unchecked(self, index))\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break state_value\n    }\n  }\n  fn reduce_indexed(self, initial: t, reducer: fn(t, t, U32) -> t) -> t {\n    let limit = array_length(self)\n    let mut state_value = initial\n    while 0u32 {\n      index if index < limit => {\n        if index < array_length(self) {\n          state_value = reducer(state_value, array_get_unchecked(self, index), index)\n        } else {\n        }\n        continue index + 1u32\n      }\n      _ => break state_value\n    }\n  }\n  fn reduce_right(self, initial: t, reducer: fn(t, t) -> t) -> t {\n    let mut state_value = initial\n    while array_length(self) {\n      0u32 => break state_value\n      remaining => {\n        let index = remaining - 1u32\n        if index < array_length(self) {\n          state_value = reducer(state_value, array_get_unchecked(self, index))\n        } else {\n        }\n        continue index\n      }\n    }\n  }\n}\n\nimpl<t: Lt> Array<t> {\n  fn sort(self) -> Unit {\n    let length = array_length(self)\n    if length < 2u32 {\n    } else {\n      let scratch = array_copy_raw(self)\n      let mut width = 1u32\n      let mut read_self = true\n      while true {\n        true if width < length => {\n          if read_self {\n            array_merge_pass_natural(self, scratch, width, length)\n          } else {\n            array_merge_pass_natural(scratch, self, width, length)\n          }\n          read_self = !read_self\n          if width > length / 2u32 {\n            width = length\n          } else {\n            width = width * 2u32\n          }\n          continue true\n        }\n        _ => break array_unit()\n      }\n      if !read_self {\n        while 0u32 {\n          index if index < length => {\n            let value = array_get_unchecked(scratch, index)\n            array_set_unchecked(self, index, value)\n            continue index + 1u32\n          }\n          _ => break array_unit()\n        }\n      } else {\n      }\n    }\n  }\n  fn to_sorted(self) -> Array<t> {\n    let output = array_copy_raw(self)\n    output.sort()\n    output\n  }\n}\n\nimpl<t: Eq> Array<t> {\n  fn includes(self, value: t) -> Bool {\n    self.index_of(value) is Option::Some(_)\n  }\n  fn index_of(self, value: t) -> Option<U32> {\n    self.index_of_from(value, 0u32)\n  }\n  fn index_of_from(self, value: t, start: U32) -> Option<U32> {\n    let length = array_length(self)\n    if start > length {\n      Option::None\n    } else {\n      while start {\n        index if index < length => {\n          if array_get_unchecked(self, index) == value {\n            break Option::Some(index)\n          } else {\n            continue index + 1u32\n          }\n        }\n        _ => break Option::None\n      }\n    }\n  }\n  fn last_index_of(self, value: t) -> Option<U32> {\n    self.last_index_of_before(value, array_length(self))\n  }\n  fn last_index_of_before(self, value: t, end: U32) -> Option<U32> {\n    let length = array_length(self)\n    if end > length {\n      Option::None\n    } else {\n      while end {\n        0u32 => break Option::None\n        remaining => {\n          let index = remaining - 1u32\n          if array_get_unchecked(self, index) == value {\n            break Option::Some(index)\n          } else {\n            continue index\n          }\n        }\n      }\n    }\n  }\n  fn equals(self, other: Array<t>) -> Bool {\n    let length = array_length(self)\n    if length != array_length(other) {\n      false\n    } else {\n      while 0u32 {\n        index if index < length => {\n          if array_get_unchecked(self, index) == array_get_unchecked(other, index) {\n            continue index + 1u32\n          } else {\n            break false\n          }\n        }\n        _ => break true\n      }\n    }\n  }\n}\n\nimpl<t: Eq> Eq for Array<t> {\n  fn eq(self, right: Array<t>) -> Bool {\n    self.equals(right)\n  }\n}\n\nimpl<t: Eq> Ne for Array<t> {\n  fn ne(self, right: Array<t>) -> Bool {\n    !self.equals(right)\n  }\n}\n\nimpl<t> Array<Array<t>> {\n  fn flat(self) -> Array<t> {\n    let output = Array::new()\n    let length = array_length(self)\n    while 0u32 {\n      index if index < length => {\n        array_extend_values(output, array_get_unchecked(self, index))\n        continue index + 1u32\n      }\n      _ => break output\n    }\n  }\n}\n\nimpl<t> ArrayEntry<t> {\n  fn index(self) -> U32 {\n    self.index\n  }\n  fn value(self) -> t {\n    self.value\n  }\n}\n\nimpl<t> Iter<U32> for ArrayKeyIter<t> {\n  fn next(self) -> Option<U32> {\n    if self.index >= array_length(self.values) {\n      Option::None\n    } else {\n      let index = self.index\n      self.index = index + 1u32\n      Option::Some(index)\n    }\n  }\n}\n\nimpl<t> Iter<ArrayEntry<t>> for ArrayEntryIter<t> {\n  fn next(self) -> Option<ArrayEntry<t>> {\n    if self.index >= array_length(self.values) {\n      Option::None\n    } else {\n      let index = self.index\n      let value = array_get_unchecked(self.values, index)\n      self.index = index + 1u32\n      Option::Some(ArrayEntry::{\n        index: index\n        value: value\n      })\n    }\n  }\n}\n\nfn arena_index_to_id(index: U32) -> I32 {\n  if index > 2147483647u32 {\n    unreachable()\n  } else {\n    index.into()\n  }\n}\n\nfn arena_id_to_index(id: I32) -> U32 {\n  if id < 0i32 {\n    unreachable()\n  } else {\n    id.into()\n  }\n}\n\npub fn arena_missing_id() -> I32 {\n  -1i32\n}\n\npub struct ArenaSpan {\n  start: I32\n  length: I32\n}\n\nimpl ArenaSpan {\n  fn end(self) -> I32 {\n    self.start + self.length\n  }\n  fn is_empty(self) -> Bool {\n    self.length == 0i32\n  }\n  fn contains(self, id: I32) -> Bool {\n    id >= self.start && id < self.end()\n  }\n}\n\npub struct Arena<t> {\n  values: Array<t>\n}\n\nimpl<t> Arena<t> {\n  fn new() -> Arena<t> {\n    Arena::{\n      values: Array::new()\n    }\n  }\n  fn with_capacity(capacity: I32) -> Arena<t> {\n    Arena::{\n      values: Array::with_capacity(arena_id_to_index(capacity))\n    }\n  }\n  fn make(length: I32, value: t) -> Arena<t> {\n    Arena::{\n      values: Array::make(arena_id_to_index(length), value)\n    }\n  }\n  fn length(self) -> I32 {\n    arena_index_to_id(self.values.length())\n  }\n  fn is_empty(self) -> Bool {\n    self.values.is_empty()\n  }\n  fn push(self, value: t) -> I32 {\n    let id = arena_index_to_id(self.values.length())\n    self.values.push(value)\n    id\n  }\n  fn pop(self) -> Option<t> {\n    self.values.pop()\n  }\n  fn get(self, id: I32) -> Option<t> {\n    if id == -1i32 {\n      Option::None\n    } else {\n      self.values.get(arena_id_to_index(id))\n    }\n  }\n  fn get_unchecked(self, id: I32) -> t {\n    self.values.get_unchecked(arena_id_to_index(id))\n  }\n  fn set(self, id: I32, value: t) -> Bool {\n    if id == -1i32 {\n      false\n    } else {\n      self.values.set(arena_id_to_index(id), value)\n    }\n  }\n  fn set_unchecked(self, id: I32, value: t) -> Unit {\n    self.values.set_unchecked(arena_id_to_index(id), value)\n  }\n  fn checkpoint(self) -> I32 {\n    self.length()\n  }\n  fn truncate(self, length: I32) ->
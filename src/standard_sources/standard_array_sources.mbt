///|
pub fn standard_array_source() -> Bytes {
  b"pub struct Array<t> {}\npub struct ArrayIter<t> {}\n\npub builtin array_new<t>() -> Array<t> = \"dew_array_new\"\npub builtin array_with_capacity<t>(capacity: U32) -> Array<t> = \"dew_array_with_capacity\"\npub builtin array_length<t>(value: Array<t>) -> U32 = \"dew_array_length\"\npub builtin array_capacity<t>(value: Array<t>) -> U32 = \"dew_array_capacity\"\npub builtin array_get<t>(value: Array<t>, index: U32) -> Option<t> = \"dew_array_get\"\npub builtin array_get_unchecked<t>(value: Array<t>, index: U32) -> t = \"dew_array_get_unchecked\"\npub builtin array_set<t>(value: Array<t>, index: U32, item: t) -> Bool = \"dew_array_set\"\npub builtin array_set_unchecked<t>(value: Array<t>, index: U32, item: t) -> Unit = \"dew_array_set_unchecked\"\npub builtin array_push<t>(value: Array<t>, item: t) -> Unit = \"dew_array_push\"\npub builtin array_pop<t>(value: Array<t>) -> Option<t> = \"dew_array_pop\"\npub builtin array_clear<t>(value: Array<t>) -> Unit = \"dew_array_clear\"\npub builtin array_iter<t>(value: Array<t>) -> ArrayIter<t> = \"dew_array_iter\"\npub builtin array_iter_has_next<t>(value: ArrayIter<t>) -> Bool = \"dew_array_iter_has_next\"\npub builtin array_iter_next<t>(value: ArrayIter<t>) -> t = \"dew_array_iter_next\"\n\nimpl<t> Array<t> {\n  fn new() -> Array<t> {\n    array_new()\n  }\n  fn with_capacity(capacity: U32) -> Array<t> {\n    array_with_capacity(capacity)\n  }\n  fn length(self) -> U32 {\n    array_length(self)\n  }\n  fn capacity(self) -> U32 {\n    array_capacity(self)\n  }\n  fn is_empty(self) -> Bool {\n    array_length(self) == 0u32\n  }\n  fn push(self, value: t) -> Unit {\n    array_push(self, value)\n  }\n  fn pop(self) -> Option<t> {\n    array_pop(self)\n  }\n  fn get(self, index: U32) -> Option<t> {\n    array_get(self, index)\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    array_get_unchecked(self, index)\n  }\n  fn set(self, index: U32, value: t) -> Bool {\n    array_set(self, index, value)\n  }\n  fn set_unchecked(self, index: U32, value: t) -> Unit {\n    array_set_unchecked(self, index, value)\n  }\n  fn clear(self) -> Unit {\n    array_clear(self)\n  }\n  fn iter(self) -> ArrayIter<t> {\n    array_iter(self)\n  }\n}\n\nimpl<t> IndexedGet<U32, t> for Array<t> {\n  fn indexed_get(self, index: U32) -> t {\n    array_get_unchecked(self, index)\n  }\n}\n\nimpl<t> IndexedSet<U32, t> for Array<t> {\n  fn indexed_set(self, index: U32, value: t) -> Unit {\n    array_set_unchecked(self, index, value)\n  }\n}\n\nimpl<t> Iter<t> for ArrayIter<t> {\n  fn has_next(self) -> Bool {\n    array_iter_has_next(self)\n  }\n  fn next(self) -> t {\n    array_iter_next(self)\n  }\n}\n"
}

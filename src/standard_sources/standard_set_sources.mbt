///|
pub fn standard_set_source() -> Bytes {
  b"pub struct Set<key> {}\n\nbuiltin set_empty<key>() -> Set<key> = \"dew_set_empty\"\nbuiltin set_singleton<key>(key: key) -> Set<key> = \"dew_set_singleton\"\nbuiltin set_length<key>(set: Set<key>) -> U32 = \"dew_set_length\"\nbuiltin set_is_empty<key>(set: Set<key>) -> Bool = \"dew_set_is_empty\"\nbuiltin set_contains<key>(set: Set<key>, key: key) -> Bool = \"dew_set_contains\"\nbuiltin set_insert<key>(set: Set<key>, key: key) -> Bool = \"dew_set_insert\"\nbuiltin set_remove<key>(set: Set<key>, key: key) -> Bool = \"dew_set_remove\"\nbuiltin set_clear<key>(set: Set<key>) -> Unit = \"dew_set_clear\"\n\nimpl<key> Set<key> {\n  fn empty() -> Set<key> {\n    set_empty()\n  }\n  fn singleton(key: key) -> Set<key> {\n    set_singleton(key)\n  }\n  fn length(self) -> U32 {\n    set_length(self)\n  }\n  fn is_empty(self) -> Bool {\n    set_is_empty(self)\n  }\n  fn contains(self, key: key) -> Bool {\n    set_contains(self, key)\n  }\n  fn insert(self, key: key) -> Bool {\n    set_insert(self, key)\n  }\n  fn remove(self, key: key) -> Bool {\n    set_remove(self, key)\n  }\n  fn clear(self) -> Unit {\n    set_clear(self)\n  }\n}\n\npub struct SetIter<key> {}\n\nbuiltin set_iter<key>(set: Set<key>) -> SetIter<key> = \"dew_set_iter\"\nbuiltin set_iter_has_next<key>(iter: SetIter<key>) -> Bool = \"dew_set_iter_has_next\"\nbuiltin set_iter_next<key>(iter: SetIter<key>) -> key = \"dew_set_iter_next\"\n\nimpl<key> Set<key> {\n  fn iter(self) -> SetIter<key> {\n    set_iter(self)\n  }\n}\n\nimpl<key> Iter<key> for SetIter<key> {\n  fn next(self) -> Option<key> {\n    set_iter_next_option(self)\n  }\n}\n\nbuiltin set_iter_next_option<key>(iter: SetIter<key>) -> Option<key> = \"dew_set_iter_next_option\"\n"
}

///|
pub fn standard_set_source() -> Bytes {
  b"open dew.std.map\nopen dew.std.option\n\npub struct Set<key> {\n  values: Map<key, Unit>\n}\n\npub struct SetIter<key> {\n  inner: MapKeyIter<key, Unit>\n}\n\npub fn set_empty<key>() -> Set<key> {\n  Set::{\n    values: Map::empty()\n  }\n}\npub fn set_singleton<key>(key: key) -> Set<key> {\n  Set::{\n    values: Map::singleton(key, ())\n  }\n}\npub fn set_length<key>(set: Set<key>) -> U32 {\n  set.values.length()\n}\npub fn set_is_empty<key>(set: Set<key>) -> Bool {\n  set.values.length() == 0u32\n}\npub fn set_contains<key>(set: Set<key>, key: key) -> Bool {\n  set.values.contains_key(key)\n}\npub fn set_insert<key>(set: Set<key>, key: key) -> Bool {\n  let before = set.values.length()\n  set.values.insert(key, ())\n  set.values.length() != before\n}\npub fn set_remove<key>(set: Set<key>, key: key) -> Bool {\n  set.values.remove(key)\n}\npub fn set_clear<key>(set: Set<key>) -> Unit {\n  set.values.clear()\n}\n\nimpl<key> Set<key> {\n  fn empty() -> Set<key> {\n    set_empty()\n  }\n  fn singleton(key: key) -> Set<key> {\n    set_singleton(key)\n  }\n  fn length(self) -> U32 {\n    set_length(self)\n  }\n  fn is_empty(self) -> Bool {\n    set_is_empty(self)\n  }\n  fn contains(self, key: key) -> Bool {\n    set_contains(self, key)\n  }\n  fn insert(self, key: key) -> Bool {\n    set_insert(self, key)\n  }\n  fn remove(self, key: key) -> Bool {\n    set_remove(self, key)\n  }\n  fn clear(self) -> Unit {\n    set_clear(self)\n  }\n}\n\npub fn set_iter<key>(set: Set<key>) -> SetIter<key> {\n  SetIter::{\n    inner: set.values.keys()\n  }\n}\npub fn set_iter_has_next<key>(iter: SetIter<key>) -> Bool {\n  iter.inner.has_next()\n}\npub fn set_iter_next<key>(iter: SetIter<key>) -> key {\n  match iter.inner.next() {\n    Option::Some(key) => key\n    Option::None => unreachable()\n  }\n}\n\nimpl<key> Set<key> {\n  fn iter(self) -> SetIter<key> {\n    set_iter(self)\n  }\n}\n\nimpl<key> Iter<key> for SetIter<key> {\n  fn next(self) -> Option<key> {\n    set_iter_next_option(self)\n  }\n}\n\nimpl<key> SetIter<key> {\n  fn has_next(self) -> Bool {\n    set_iter_has_next(self)\n  }\n}\n\npub fn set_iter_next_option<key>(iter: SetIter<key>) -> Option<key> {\n  iter.inner.next()\n}\n"
}

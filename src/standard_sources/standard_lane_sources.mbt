  [
    b"fn i8x4_from_swar32(value: Swar32) -> I8x4 {\n  unsafe_bitcast::<Swar32, I8x4>(value)\n}\nfn i8x4_to_swar32(value: I8x4) -> Swar32 {\n  unsafe_bitcast::<I8x4, Swar32>(value)\n}\nimpl Into<U8x4> for I8x4 {\n  fn into(self) -> U8x4 {\n    unsafe_bitcast::<I8x4, U8x4>(self)\n  }\n}\nimpl Into<I16x2> for I8x4 {\n  fn into(self) -> I16x2 {\n    unsafe_bitcast::<I8x4, I16x2>(self)\n  }\n}\nimpl Into<U16x2> for I8x4 {\n  fn into(self) -> U16x2 {\n    unsafe_bitcast::<I8x4, U16x2>(self)\n  }\n}\nfn i8x4_load(address: U32) -> I8x4 {\n  unsafe_bitcast::<U32, I8x4>(u32_load(address))\n}\nfn i8x4_store(address: U32, value: I8x4) -> Unit {\n  u32_store(address, unsafe_bitcast::<I8x4, U32>(value))\n}\nfn i8x4_and(left: I8x4, right: I8x4) -> I8x4 {\n  unsafe_bitcast::<U32, I8x4>(u32_and(unsafe_bitcast::<I8x4, U32>(left), unsafe_bitcast::<I8x4, U32>(right)))\n}\nfn i8x4_or(left: I8x4, right: I8x4) -> I8x4 {\n  unsafe_bitcast::<U32, I8x4>(u32_or(unsafe_bitcast::<I8x4, U32>(left), unsafe_bitcast::<I8x4, U32>(right)))\n}\nfn i8x4_xor(left: I8x4, right: I8x4) -> I8x4 {\n  unsafe_bitcast::<U32, I8x4>(u32_xor(unsafe_bitcast::<I8x4, U32>(left), unsafe_bitcast::<I8x4, U32>(right)))\n}\nfn i8x4_splat(value: I8) -> I8x4 {\n  i8x4_from_swar32(swar32_splat_i8(value))\n}\nfn i8x4_extract(value: I8x4, index: U8) -> I8 {\n  swar32_extract_i8_s(i8x4_to_swar32(value), index)\n}\nfn i8x4_replace(value: I8x4, index: U8, lane: I8) -> I8x4 {\n  i8x4_from_swar32(swar32_replace_i8(i8x4_to_swar32(value), index, lane))\n}\nfn i8x4_add(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_add_i8(i8x4_to_swar32(left), i8x4_to_swar32(right)))\n}\nfn i8x4_sub(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_sub_i8(i8x4_to_swar32(left), i8x4_to_swar32(right)))\n}\nfn i8x4_shl(value: I8x4, count: U8) -> I8x4 {\n  i8x4_from_swar32(swar32_shl_i8(i8x4_to_swar32(value), count))\n}\nfn i8x4_shr(value: I8x4, count: U8) -> I8x4 {\n  i8x4_from_swar32(swar32_shr_i8_s(i8x4_to_swar32(value), count))\n}\nfn i8x4_popcnt(value: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_popcnt_i8(i8x4_to_swar32(value)))\n}\nfn i8x4_bitmask(value: I8x4) -> U32 {\n  swar32_bitmask_i8(i8x4_to_swar32(value))\n}\nfn i8x4_all_true(value: I8x4) -> Bool {\n  swar32_all_true_i8(i8x4_to_swar32(value))\n}\nfn i8x4_eq(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_eq_i8(i8x4_to_swar32(left), i8x4_to_swar32(right)))\n}\nfn i8x4_mul(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  i8x4_from_swar32(swar32_from_bits((((a & 255u32) * (b & 255u32)) & 255u32) | (((((a >> 8u32) & 255u32) * ((b >> 8u32) & 255u32)) & 255u32) << 8u32) | (((((a >> 16u32) & 255u32) * ((b >> 16u32) & 255u32)) & 255u32) << 16u32) | (((((a >> 24u32) & 255u32) * ((b >> 24u32) & 255u32)) & 255u32) << 24u32)))\n}\nfn i8x4_ne(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_from_bits(swar32_to_bits(i8x4_to_swar32(i8x4_eq(left, right))) ^ 4294967295u32))\n}\nfn i8x4_lt(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  let ax = a ^ 2155905152u32\n  let bx = b ^ 2155905152u32\n  let d = ((ax | 2155905152u32) - (bx & 2139062143u32)) ^ ((ax ^ (bx ^ 4294967295u32)) & 2155905152u32)\n  let mask = (((((ax ^ 4294967295u32) & bx) | (((ax ^ bx) ^ 4294967295u32) & d)) & 2155905152u32) >> 7u32) * 255u32\n  i8x4_from_swar32(swar32_from_bits(mask))\n}\nfn i8x4_le(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_from_bits(swar32_to_bits(i8x4_to_swar32(i8x4_lt(right, left))) ^ 4294967295u32))\n}\nfn i8x4_gt(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_lt(right, left)\n}\nfn i8x4_ge(left: I8x4, right: I8x4) -> I8x4 {\n  i8x4_from_swar32(swar32_from_bits(swar32_to_bits(i8x4_to_swar32(i8x4_lt(left, right))) ^ 4294967295u32))\n}\nfn i8x4_min(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  let mask = swar32_to_bits(i8x4_to_swar32(i8x4_lt(left, right)))\n  i8x4_from_swar32(swar32_from_bits(b ^ ((a ^ b) & mask)))\n}\nfn i8x4_max(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  let mask = swar32_to_bits(i8x4_to_swar32(i8x4_lt(left, right)))\n  i8x4_from_swar32(swar32_from_bits(a ^ ((a ^ b) & mask)))\n}\nfn i8x4_abs(value: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(value))\n  let mask = ((a & 2155905152u32) >> 7u32) * 255u32\n  let x = a ^ mask\n  let carry = mask & 16843009u32\n  let lo = (x & 252645135u32) + (carry & 252645135u32)\n  let hi = (x & 4042322160u32) + (carry & 4042322160u32) + (lo & 269488144u32)\n  i8x4_from_swar32(swar32_from_bits((lo & 252645135u32) | (hi & 4042322160u32)))\n}\nfn i8x4_neg(value: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(value))\n  i8x4_from_swar32(swar32_from_bits((2155905152u32 - (a & 2139062143u32)) ^ ((a ^ 4294967295u32) & 2155905152u32)))\n}\nfn i8x4_add_sat(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  let sum = ((a & 2139062143u32) + (b & 2139062143u32)) ^ ((a ^ b) & 2155905152u32)\n  let overflow = (((a ^ b) ^ 4294967295u32) & (a ^ sum) & 2155905152u32) >> 7u32\n  let mask = overflow * 255u32\n  let limit = (((a & 2155905152u32) >> 7u32) * 255u32) ^ 2139062143u32\n  i8x4_from_swar32(swar32_from_bits((sum & (mask ^ 4294967295u32)) | (limit & mask)))\n}\nfn i8x4_sub_sat(left: I8x4, right: I8x4) -> I8x4 {\n  let a = swar32_to_bits(i8x4_to_swar32(left))\n  let b = swar32_to_bits(i8x4_to_swar32(right))\n  let dlo = ((a | 8388736u32) - (b & 8323199u32)) ^ ((a ^ (b ^ 4294967295u32)) & 8388736u32)\n  let dhi = ((a | 2147516416u32) - (b & 2130738944u32)) ^ ((a ^ (b ^ 4294967295u32)) & 2147516416u32)\n  let diff = (dlo & 16711935u32) | (dhi & 4278255360u32)\n  let overflow = ((a ^ b) & (a ^ diff) & 2155905152u32) >> 7u32\n  let mask = overflow * 255u32\n  let limit = (((a & 2155905152u32) >> 7u32) * 255u32) ^ 2139062143u32\n  i8x4_from_swar32(swar32_from_bits((diff & (mask ^ 4294967295u32)) | (limit & mask)))\n}\nimpl I8x4 {\n  fn to_swar32(self) -> Swar32 {\n    i8x4_to_swar32(self)\n  }\n  fn extract(self, index: U8) -> I8 {\n    i8x4_extract(self, index)\n  }\n  fn replace(self, index: U8, lane: I8) -> I8x4 {\n    i8x4_replace(self, index, lane)\n  }\n  fn shl(self, count: U8) -> I8x4 {\n    i8x4_shl(self, count)\n  }\n  fn shr(self, count: U8) -> I8x4 {\n    i8x4_shr(self, count)\n  }\n  fn popcnt(self) -> I8x4 {\n    i8x4_popcnt(self)\n  }\n  fn bitmask(self) -> U32 {\n    i8x4_bitmask(self)\n  }\n  fn all_true(self) -> Bool {\n    i8x4_all_true(self)\n  }\n  fn eq_mask(self, right: I8x4) -> I8x4 {\n    i8x4_eq(self, right)\n  }\n  fn mul(self, right: I8x4) -> I8x4 {\n    i8x4_mul(self, right)\n  }\n  fn ne_mask(self, right: I8x4) -> I8x4 {\n    i8x4_ne(self, right)\n  }\n  fn lt_mask(self, right: I8x4) -> I8x4 {\n    i8x4_lt(self, right)\n  }\n  fn le_mask(self, right: I8x4) -> I8x4 {\n    i8x4_le(self, right)\n  }\n  fn gt_mask(self, right: I8x4) -> I8x4 {\n    i8x4_gt(self, right)\n  }\n  fn ge_mask(self, right: I8x4) -> I8x4 {\n    i8x4_ge(self, right)\n  }\n  fn min(self, right: I8x4) -> I8x4 {\n    i8x4_min(self, right)\n  }\n  fn max(self, right: I8x4) -> I8x4 {\n    i8x4_max(self, right)\n  }\n  fn add_sat(self, right: I8x4) -> I8x4 {\n    i8x4_add_sat(self, right)\n  }\n  fn sub_sat(self, right: I8x4) -> I8x4 {\n    i8x4_sub_sat(self, right)\n  }\n  fn abs(self) -> I8x4 {\n    i8x4_abs(self)\n  }\n  fn neg(self) -> I8x4 {\n    i8x4_neg(self)\n  }\n}\nimpl BitAnd for I8x4 {\n  fn bit_and(self, right: I8x4) -> I8x4 {\n    i8x4_and(self, right)\n  }\n}\nimpl BitOr for I8x4 {\n  fn bit_or(self, right: I8x4) -> I8x4 {\n    i8x4_or(self, right)\n  }\n}\nimpl BitXor for I8x4 {\n  fn bit_xor(self, right: I8x4) -> I8x4 {\n    i8x4_xor(self, ri
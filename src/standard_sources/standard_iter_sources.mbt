///|
pub fn standard_iter_source() -> Bytes {
  b"pub fn iter_unit() -> Unit {}\n\npub fn iter_for_each<t, i: Iter<t>>(\n  iter: i,\n  action: fn(t) -> Unit,\n) -> Unit {\n  while iter.next() {\n    Option::Some(value) => {\n      action(value)\n      continue iter.next()\n    }\n    Option::None => break iter_unit()\n  }\n}\n\npub fn iter_fold<t, state, i: Iter<t>>(\n  iter: i,\n  initial: state,\n  folder: fn(state, t) -> state,\n) -> state {\n  let mut value = initial\n  while iter.next() {\n    Option::Some(item) => {\n      value = folder(value, item)\n      continue iter.next()\n    }\n    Option::None => break value\n  }\n}\n\npub fn iter_any<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        break true\n      } else {\n        continue iter.next()\n      }\n    }\n    Option::None => break false\n  }\n}\n\npub fn iter_all<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        continue iter.next()\n      } else {\n        break false\n      }\n    }\n    Option::None => break true\n  }\n}\n\npub fn iter_find<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Option<t> {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        break Option::Some(value)\n      } else {\n        continue iter.next()\n      }\n    }\n    Option::None => break Option::None\n  }\n}\n\n// Capture the ordinary Iter evidence once at construction. The wrapper's\n// implementation needs only its typed pull function, including in nested chains.\nfn iter_next<t, i: Iter<t>>(inner: i) -> Option<t> {\n  inner.next()\n}\n\npub struct MapIter<t, u, i> {\n  inner: i\n  pull: fn(i) -> Option<t>\n  callback: fn(t) -> u\n  mut done: Bool\n}\n\npub struct FilterIter<t, i> {\n  inner: i\n  pull: fn(i) -> Option<t>\n  predicate: fn(t) -> Bool\n  mut done: Bool\n}\n\npub struct TakeIter<t, i> {\n  inner: i\n  pull: fn(i) -> Option<t>\n  mut remaining: U32\n  mut done: Bool\n}\n\npub struct SkipIter<t, i> {\n  inner: i\n  pull: fn(i) -> Option<t>\n  mut remaining: U32\n  mut done: Bool\n}\n\npub struct EnumerateIter<t, i> {\n  inner: i\n  pull: fn(i) -> Option<t>\n  mut index: U64\n  mut done: Bool\n}\n\npub struct IterEntry<t> {\n  index: U64\n  value: t\n}\n\npub fn iter_map<t, u, i: Iter<t>>(\n  inner: i,\n  callback: fn(t) -> u,\n) -> MapIter<t, u, i> {\n  MapIter::{\n    inner: inner\n    pull: iter_next\n    callback: callback\n    done: false\n  }\n}\n\npub fn iter_filter<t, i: Iter<t>>(\n  inner: i,\n  predicate: fn(t) -> Bool,\n) -> FilterIter<t, i> {\n  FilterIter::{\n    inner: inner\n    pull: iter_next\n    predicate: predicate\n    done: false\n  }\n}\n\npub fn iter_take<t, i: Iter<t>>(inner: i, count: U32) -> TakeIter<t, i> {\n  TakeIter::{\n    inner: inner\n    pull: iter_next\n    remaining: count\n    done: false\n  }\n}\n\npub fn iter_skip<t, i: Iter<t>>(inner: i, count: U32) -> SkipIter<t, i> {\n  SkipIter::{\n    inner: inner\n    pull: iter_next\n    remaining: count\n    done: false\n  }\n}\n\npub fn iter_enumerate<t, i: Iter<t>>(inner: i) -> EnumerateIter<t, i> {\n  EnumerateIter::{\n    inner: inner\n    pull: iter_next\n    index: 0u64\n    done: false\n  }\n}\n\nimpl<t, u, i> Iter<u> for MapIter<t, u, i> {\n  fn next(self) -> Option<u> {\n    if self.done {\n      None\n    } else {\n      let pull = self.pull\n      match pull(self.inner) {\n        Some(value) => {\n          let callback = self.callback\n          Some(callback(value))\n        }\n        None => {\n          self.done = true\n          None\n        }\n      }\n    }\n  }\n}\n\nimpl<t, i> Iter<t> for FilterIter<t, i> {\n  fn next(self) -> Option<t> {\n    if self.done {\n      None\n    } else {\n      let pull = self.pull\n      while pull(self.inner) {\n        Some(value) => {\n          let predicate = self.predicate\n          if predicate(value) {\n            break Some(value)\n          } else {\n            continue pull(self.inner)\n          }\n        }\n        None => {\n          self.done = true\n          break None\n        }\n      }\n    }\n  }\n}\n\nimpl<t, i> Iter<t> for TakeIter<t, i> {\n  fn next(self) -> Option<t> {\n    if self.done || self.remaining == 0u32 {\n      None\n    } else {\n      let pull = self.pull\n      match pull(self.inner) {\n        Some(value) => {\n          self.remaining = self.remaining - 1u32\n          Some(value)\n        }\n        None => {\n          self.done = true\n          None\n        }\n      }\n    }\n  }\n}\n\nimpl<t, i> Iter<t> for SkipIter<t, i> {\n  fn next(self) -> Option<t> {\n    if self.done {\n      None\n    } else {\n      let pull = self.pull\n      while pull(self.inner) {\n        Some(value) => {\n          if self.remaining == 0u32 {\n            break Some(value)\n          } else {\n            self.remaining = self.remaining - 1u32\n            continue pull(self.inner)\n          }\n        }\n        None => {\n          self.done = true\n          break None\n        }\n      }\n    }\n  }\n}\n\nimpl<t, i> Iter<IterEntry<t>> for EnumerateIter<t, i> {\n  fn next(self) -> Option<IterEntry<t>> {\n    if self.done {\n      None\n    } else {\n      let pull = self.pull\n      match pull(self.inner) {\n        Some(value) => {\n          let index = self.index\n          self.index = index + 1u64\n          Some(IterEntry::{\n            index: index\n            value: value\n          })\n        }\n        None => {\n          self.done = true\n          None\n        }\n      }\n    }\n  }\n}\n"
}

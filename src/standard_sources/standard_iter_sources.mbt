///|
pub fn standard_iter_source() -> Bytes {
  b"fn iter_unit() -> Unit {}\n\npub fn iter_for_each<t, i: Iter<t>>(\n  iter: i,\n  action: fn(t) -> Unit,\n) -> Unit {\n  while iter.next() {\n    Option::Some(value) => {\n      action(value)\n      continue iter.next()\n    }\n    Option::None => break iter_unit()\n  }\n}\n\npub fn iter_fold<t, state, i: Iter<t>>(\n  iter: i,\n  initial: state,\n  folder: fn(state, t) -> state,\n) -> state {\n  let mut value = initial\n  while iter.next() {\n    Option::Some(item) => {\n      value = folder(value, item)\n      continue iter.next()\n    }\n    Option::None => break value\n  }\n}\n\npub fn iter_any<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        break true\n      } else {\n        continue iter.next()\n      }\n    }\n    Option::None => break false\n  }\n}\n\npub fn iter_all<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        continue iter.next()\n      } else {\n        break false\n      }\n    }\n    Option::None => break true\n  }\n}\n\npub fn iter_find<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Option<t> {\n  while iter.next() {\n    Option::Some(value) => {\n      if predicate(value) {\n        break Option::Some(value)\n      } else {\n        continue iter.next()\n      }\n    }\n    Option::None => break Option::None\n  }\n}\n"
}

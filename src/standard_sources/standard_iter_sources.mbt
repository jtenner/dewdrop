///|
pub fn standard_iter_source() -> Bytes {
  b"fn iter_unit() -> Unit {}\n\npub fn iter_for_each<t, i: Iter<t>>(\n  iter: i,\n  action: fn(t) -> Unit,\n) -> Unit {\n  while true {\n    true if iter.has_next() => {\n      action(iter.next())\n      continue true\n    }\n    _ => break iter_unit()\n  }\n}\n\npub fn iter_fold<t, state, i: Iter<t>>(\n  iter: i,\n  initial: state,\n  folder: fn(state, t) -> state,\n) -> state {\n  while initial {\n    value if iter.has_next() => continue folder(value, iter.next())\n    value => break value\n  }\n}\n\npub fn iter_any<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while true {\n    true if iter.has_next() => {\n      if predicate(iter.next()) {\n        break true\n      } else {\n        continue true\n      }\n    }\n    _ => break false\n  }\n}\n\npub fn iter_all<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Bool {\n  while true {\n    true if iter.has_next() => {\n      if predicate(iter.next()) {\n        continue true\n      } else {\n        break false\n      }\n    }\n    _ => break true\n  }\n}\n\npub fn iter_find<t, i: Iter<t>>(\n  iter: i,\n  predicate: fn(t) -> Bool,\n) -> Option<t> {\n  while true {\n    true if iter.has_next() => {\n      let value = iter.next()\n      if predicate(value) {\n        break Option::Some(value)\n      } else {\n        continue true\n      }\n    }\n    _ => break Option::None\n  }\n}\n"
}

///|
pub fn standard_types_source() -> Bytes {
  b"// Pure compiler queries. These declarations never make runtime calls.\n// Type identity is logical identity, not Wasm carrier equality.\npub builtin type_equal<a, b>() -> Bool = \"types.type_equal\"\npub builtin is_unit<t>() -> Bool = \"types.is_unit\"\npub builtin is_never<t>() -> Bool = \"types.is_never\"\npub builtin is_integer<t>() -> Bool = \"types.is_integer\"\npub builtin is_signed_integer<t>() -> Bool = \"types.is_signed_integer\"\npub builtin is_float<t>() -> Bool = \"types.is_float\"\npub builtin bit_width<t>() -> U32 = \"types.bit_width\"\npub builtin can_bitcast<from, to>() -> Bool = \"types.can_bitcast\"\npub builtin lane_count<t>() -> U32 = \"types.lane_count\"\npub builtin lane_bit_width<t>() -> U32 = \"types.lane_bit_width\"\npub builtin tuple_length<t>() -> U32 = \"types.tuple_length\"\n// Only a proved absence returns false. Search errors remain diagnostics.\npub builtin implements<t, trait_>() -> Bool = \"types.implements\"\npub builtin static_assert(condition: Bool, message: String) -> Unit = \"types.static_assert\"\n"
}

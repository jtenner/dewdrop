///|
pub fn standard_stack_source() -> Bytes {
  b"open dew.std.array\n\npub type Stack<t> = Array<t>\npub type StackIter<t> = ArrayIter<t>\n\npub fn stack_new<t>() -> Stack<t> {\n  array_new()\n}\npub fn stack_with_capacity<t>(capacity: U32) -> Stack<t> {\n  array_with_capacity(capacity)\n}\npub fn stack_length<t>(stack: Stack<t>) -> U32 {\n  array_length(stack)\n}\npub fn stack_is_empty<t>(stack: Stack<t>) -> Bool {\n  array_length(stack) == 0u32\n}\npub fn stack_push<t>(stack: Stack<t>, value: t) -> Unit {\n  array_push(stack, value)\n}\npub fn stack_pop<t>(stack: Stack<t>) -> Option<t> {\n  array_pop(stack)\n}\npub fn stack_peek<t>(stack: Stack<t>) -> Option<t> {\n  let length = array_length(stack)\n  if length == 0u32 {\n    None\n  } else {\n    array_get(stack, length - 1u32)\n  }\n}\npub fn stack_clear<t>(stack: Stack<t>) -> Unit {\n  array_clear(stack)\n}\npub fn stack_iter<t>(stack: Stack<t>) -> StackIter<t> {\n  array_iter(stack)\n}\npub fn stack_iter_has_next<t>(iter: StackIter<t>) -> Bool {\n  array_iter_has_next(iter)\n}\npub fn stack_iter_next<t>(iter: StackIter<t>) -> t {\n  array_iter_next(iter)\n}\n"
}

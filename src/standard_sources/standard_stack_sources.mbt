///|
pub fn standard_stack_source() -> Bytes {
  b"open dew.std.array\n\npub type Stack<t> = Array<t>\npub type StackIter<t> = ArrayIter<t>\n\npub builtin stack_new<t>() -> Stack<t> = \"dew_stack_new\"\npub builtin stack_with_capacity<t>(capacity: U32) -> Stack<t> = \"dew_stack_with_capacity\"\npub builtin stack_length<t>(stack: Stack<t>) -> U32 = \"dew_stack_length\"\n\npub builtin stack_is_empty<t>(stack: Stack<t>) -> Bool = \"dew_stack_is_empty\"\n\npub builtin stack_push<t>(stack: Stack<t>, value: t) -> Unit = \"dew_stack_push\"\npub builtin stack_pop<t>(stack: Stack<t>) -> Option<t> = \"dew_stack_pop\"\n\npub builtin stack_peek<t>(stack: Stack<t>) -> Option<t> = \"dew_stack_peek\"\n\npub builtin stack_clear<t>(stack: Stack<t>) -> Unit = \"dew_stack_clear\"\npub builtin stack_iter<t>(stack: Stack<t>) -> StackIter<t> = \"dew_stack_iter\"\npub builtin stack_iter_has_next<t>(iter: StackIter<t>) -> Bool = \"dew_stack_iter_has_next\"\npub builtin stack_iter_next<t>(iter: StackIter<t>) -> t = \"dew_stack_iter_next\"\n"
}

///|
pub fn standard_ordering_source() -> Bytes {
  b"open dew.std.string\n\npub fn ordering_string_byte_length(value: String) -> U32 {\n  value.byte_length()\n}\npub fn ordering_string_byte_at(value: String, index: U32) -> U8 {\n  value.byte_at(index)\n}\npub fn ordering_string_view_byte_length(value: StringView) -> U32 {\n  value.byte_length()\n}\npub fn ordering_string_view_byte_at(value: StringView, index: U32) -> U8 {\n  value.byte_at(index)\n}\npub fn ordering_bytes_byte_length(value: Bytes) -> U32 {\n  __dew_text_byte_length(value)\n}\npub fn ordering_bytes_byte_at(value: Bytes, index: U32) -> U8 {\n  __dew_text_byte_at(value, index)\n}\n\npub enum Ordering {\n  Less\n  Equal\n  Greater\n}\n\npub trait Comparator<t> {\n  fn compare(self, left: t, right: t) -> Ordering\n}\n\npub struct NaturalComparator {}\n\npub fn natural_comparator() -> NaturalComparator {\n  NaturalComparator::{\n  }\n}\n\nimpl<t: Lt + Eq> Comparator<t> for NaturalComparator {\n  fn compare(self, left: t, right: t) -> Ordering {\n    if left < right {\n      Ordering::Less\n    } else if left == right {\n      Ordering::Equal\n    } else {\n      Ordering::Greater\n    }\n  }\n}\n\npub fn ordering_is_less(value: Ordering) -> Bool {\n  match value {\n    Ordering::Less => true\n    Ordering::Equal => false\n    Ordering::Greater => false\n  }\n}\n\npub fn ordering_is_equal(value: Ordering) -> Bool {\n  match value {\n    Ordering::Less => false\n    Ordering::Equal => true\n    Ordering::Greater => false\n  }\n}\n\npub fn ordering_is_greater(value: Ordering) -> Bool {\n  match value {\n    Ordering::Less => false\n    Ordering::Equal => false\n    Ordering::Greater => true\n  }\n}\n\npub fn ordering_reverse(value: Ordering) -> Ordering {\n  match value {\n    Ordering::Less => Ordering::Greater\n    Ordering::Equal => Ordering::Equal\n    Ordering::Greater => Ordering::Less\n  }\n}\n\npub struct StringComparator {\n}\n\npub struct StringViewComparator {\n}\n\npub struct BytesComparator {\n}\n\npub fn string_comparator() -> StringComparator {\n  StringComparator::{\n  }\n}\n\npub fn string_view_comparator() -> StringViewComparator {\n  StringViewComparator::{\n  }\n}\n\npub fn bytes_comparator() -> BytesComparator {\n  BytesComparator::{\n  }\n}\n\npub fn compare_string_bytes(left: String, right: String) -> Ordering {\n  let left_length = ordering_string_byte_length(left)\n  let right_length = ordering_string_byte_length(right)\n  let limit = if left_length < right_length {\n    left_length\n  } else {\n    right_length\n  }\n  while 0u32 {\n    index if index < limit => {\n      let left_byte = ordering_string_byte_at(left, index)\n      let right_byte = ordering_string_byte_at(right, index)\n      if left_byte < right_byte {\n        break Ordering::Less\n      } else if left_byte > right_byte {\n        break Ordering::Greater\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => if left_length < right_length {\n      break Ordering::Less\n    } else if left_length > right_length {\n      break Ordering::Greater\n    } else {\n      break Ordering::Equal\n    }\n  }\n}\n\npub fn compare_string_view_bytes(left: StringView, right: StringView) -> Ordering {\n  let left_length = ordering_string_view_byte_length(left)\n  let right_length = ordering_string_view_byte_length(right)\n  let limit = if left_length < right_length {\n    left_length\n  } else {\n    right_length\n  }\n  while 0u32 {\n    index if index < limit => {\n      let left_byte = ordering_string_view_byte_at(left, index)\n      let right_byte = ordering_string_view_byte_at(right, index)\n      if left_byte < right_byte {\n        break Ordering::Less\n      } else if left_byte > right_byte {\n        break Ordering::Greater\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => if left_length < right_length {\n      break Ordering::Less\n    } else if left_length > right_length {\n      break Ordering::Greater\n    } else {\n      break Ordering::Equal\n    }\n  }\n}\n\npub fn compare_bytes(left: Bytes, right: Bytes) -> Ordering {\n  let left_length = ordering_bytes_byte_length(left)\n  let right_length = ordering_bytes_byte_length(right)\n  let limit = if left_length < right_length {\n    left_length\n  } else {\n    right_length\n  }\n  while 0u32 {\n    index if index < limit => {\n      let left_byte = ordering_bytes_byte_at(left, index)\n      let right_byte = ordering_bytes_byte_at(right, index)\n      if left_byte < right_byte {\n        break Ordering::Less\n      } else if left_byte > right_byte {\n        break Ordering::Greater\n      } else {\n        continue index + 1u32\n      }\n    }\n    _ => if left_length < right_length {\n      break Ordering::Less\n    } else if left_length > right_length {\n      break Ordering::Greater\n    } else {\n      break Ordering::Equal\n    }\n  }\n}\n\nimpl Comparator<String> for StringComparator {\n  fn compare(self, left: String, right: String) -> Ordering {\n    compare_string_bytes(left, right)\n  }\n}\n\nimpl Comparator<StringView> for StringViewComparator {\n  fn compare(self, left: StringView, right: StringView) -> Ordering {\n    compare_string_view_bytes(left, right)\n  }\n}\n\nimpl Comparator<Bytes> for BytesComparator {\n  fn compare(self, left: Bytes, right: Bytes) -> Ordering {\n    compare_bytes(left, right)\n  }\n}\n"
}

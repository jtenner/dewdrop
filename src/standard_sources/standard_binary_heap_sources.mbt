///|
pub fn standard_binary_heap_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.ordering\n\npub enum HeapOrder {\n  Minimum\n  Maximum\n}\n\npub struct BinaryHeap<t, c> {\n  values: Array<t>\n  comparator: c\n  maximum: Bool\n}\n\npub type BinaryHeapIter<t> = ArrayIter<t>\n\npub fn heap_order_is_maximum(order: HeapOrder) -> Bool {\n  match order {\n    HeapOrder::Minimum => false\n    HeapOrder::Maximum => true\n  }\n}\n\npub fn binary_heap_new<t, c: Comparator<t>>(\n  comparator: c,\n  order: HeapOrder,\n) -> BinaryHeap<t, c> {\n  BinaryHeap::{\n    values: array_new()\n    comparator: comparator\n    maximum: heap_order_is_maximum(order)\n  }\n}\n\npub fn binary_heap_with_capacity<t, c: Comparator<t>>(\n  comparator: c,\n  order: HeapOrder,\n  capacity: U32,\n) -> BinaryHeap<t, c> {\n  BinaryHeap::{\n    values: array_with_capacity(capacity)\n    comparator: comparator\n    maximum: heap_order_is_maximum(order)\n  }\n}\n\npub fn binary_heap_length<t, c>(heap: BinaryHeap<t, c>) -> U32 {\n  array_length(heap.values)\n}\n\npub fn binary_heap_capacity<t, c>(heap: BinaryHeap<t, c>) -> U32 {\n  array_capacity(heap.values)\n}\n\npub fn binary_heap_is_empty<t, c>(heap: BinaryHeap<t, c>) -> Bool {\n  array_length(heap.values) == 0u32\n}\n\npub fn binary_heap_precedes<t, c: Comparator<t>>(\n  heap: BinaryHeap<t, c>,\n  left: t,\n  right: t,\n) -> Bool {\n  let ordering = heap.comparator.compare(left, right)\n  if heap.maximum {\n    ordering_is_greater(ordering)\n  } else {\n    ordering_is_less(ordering)\n  }\n}\n\npub fn binary_heap_unit() -> Unit {}\n\npub fn binary_heap_sift_up<t, c: Comparator<t>>(\n  heap: BinaryHeap<t, c>,\n  start: U32,\n) -> Unit {\n  while start {\n    0u32 => break binary_heap_unit()\n    index => {\n      let parent = (index - 1u32) / 2u32\n      let value = array_get_unchecked(heap.values, index)\n      let parent_value = array_get_unchecked(heap.values, parent)\n      if binary_heap_precedes(heap, value, parent_value) {\n        array_set_unchecked(heap.values, index, parent_value)\n        array_set_unchecked(heap.values, parent, value)\n        continue parent\n      } else {\n        break binary_heap_unit()\n      }\n    }\n  }\n}\n\npub fn binary_heap_sift_down<t, c: Comparator<t>>(\n  heap: BinaryHeap<t, c>,\n  start: U32,\n) -> Unit {\n  while start {\n    index => {\n      let length = array_length(heap.values)\n      let left = index * 2u32 + 1u32\n      if left >= length {\n        break binary_heap_unit()\n      } else {\n        let right = left + 1u32\n        let child = if right < length && binary_heap_precedes(\n          heap,\n          array_get_unchecked(heap.values, right),\n          array_get_unchecked(heap.values, left),\n        ) {\n          right\n        } else {\n          left\n        }\n        let value = array_get_unchecked(heap.values, index)\n        let child_value = array_get_unchecked(heap.values, child)\n        if binary_heap_precedes(heap, child_value, value) {\n          array_set_unchecked(heap.values, index, child_value)\n          array_set_unchecked(heap.values, child, value)\n          continue child\n        } else {\n          break binary_heap_unit()\n        }\n      }\n    }\n  }\n}\n\npub fn binary_heap_push<t, c: Comparator<t>>(\n  heap: BinaryHeap<t, c>,\n  value: t,\n) -> Unit {\n  array_push(heap.values, value)\n  binary_heap_sift_up(heap, array_length(heap.values) - 1u32)\n}\n\npub fn binary_heap_peek<t, c>(heap: BinaryHeap<t, c>) -> Option<t> {\n  array_get(heap.values, 0u32)\n}\n\npub fn binary_heap_pop<t, c: Comparator<t>>(\n  heap: BinaryHeap<t, c>,\n) -> Option<t> {\n  let length = array_length(heap.values)\n  if length == 0u32 {\n    Option::None\n  } else {\n    let root = array_get_unchecked(heap.values, 0u32)\n    let last = array_get_unchecked(heap.values, length - 1u32)\n    array_pop(heap.values)\n    if length > 1u32 {\n      array_set_unchecked(heap.values, 0u32, last)\n      binary_heap_sift_down(heap, 0u32)\n    } else {\n      binary_heap_unit()\n    }\n    Option::Some(root)\n  }\n}\n\npub fn binary_heap_clear<t, c>(heap: BinaryHeap<t, c>) -> Unit {\n  array_clear(heap.values)\n}\n\npub fn binary_heap_iter<t, c>(\n  heap: BinaryHeap<t, c>,\n) -> BinaryHeapIter<t> {\n  array_iter(heap.values)\n}\n\npub fn binary_heap_iter_has_next<t>(iter: BinaryHeapIter<t>) -> Bool {\n  array_iter_has_next(iter)\n}\n\npub fn binary_heap_iter_next<t>(iter: BinaryHeapIter<t>) -> t {\n  array_iter_next(iter)\n}\n\npub fn binary_heap_from_array<t, c: Comparator<t>>(\n  comparator: c,\n  order: HeapOrder,\n  values: Array<t>,\n) -> BinaryHeap<t, c> {\n  let length = array_length(values)\n  let heap = binary_heap_with_capacity(comparator, order, length)\n  while 0u32 {\n    index if index < length => {\n      array_push(heap.values, array_get_unchecked(values, index))\n      continue index + 1u32\n    }\n    _ => break binary_heap_unit()\n  }\n  if length > 1u32 {\n    let start = length / 2u32\n    while start {\n      0u32 => break binary_heap_unit()\n      index => {\n        let parent = index - 1u32\n        binary_heap_sift_down(heap, parent)\n        continue parent\n      }\n    }\n  } else {\n    binary_heap_unit()\n  }\n  heap\n}\n"
}

///|
pub fn standard_circular_buffer_source() -> Bytes {
  b"open dew.std.array\n\npub type CircularBuffer<t> = Array<t>\npub type CircularBufferIter<t> = ArrayIter<t>\n\npub builtin circular_buffer_bounded<t>(capacity: U32) -> CircularBuffer<t> = \"dew_circular_buffer_bounded\"\npub builtin circular_buffer_growable<t>(capacity: U32) -> CircularBuffer<t> = \"dew_circular_buffer_growable\"\npub builtin circular_buffer_length<t>(buffer: CircularBuffer<t>) -> U32 = \"dew_circular_buffer_length\"\npub builtin circular_buffer_capacity<t>(buffer: CircularBuffer<t>) -> U32 = \"dew_circular_buffer_capacity\"\npub builtin circular_buffer_is_empty<t>(buffer: CircularBuffer<t>) -> Bool = \"dew_circular_buffer_is_empty\"\npub builtin circular_buffer_is_full<t>(buffer: CircularBuffer<t>) -> Bool = \"dew_circular_buffer_is_full\"\npub builtin circular_buffer_push_back<t>(buffer: CircularBuffer<t>, value: t) -> Bool = \"dew_circular_buffer_push_back\"\npub builtin circular_buffer_pop_front<t>(buffer: CircularBuffer<t>) -> Option<t> = \"dew_circular_buffer_pop_front\"\npub builtin circular_buffer_peek_front<t>(buffer: CircularBuffer<t>) -> Option<t> = \"dew_circular_buffer_peek_front\"\npub builtin circular_buffer_clear<t>(buffer: CircularBuffer<t>) -> Unit = \"dew_circular_buffer_clear\"\npub builtin circular_buffer_iter<t>(buffer: CircularBuffer<t>) -> CircularBufferIter<t> = \"dew_circular_buffer_iter\"\npub builtin circular_buffer_iter_has_next<t>(iter: CircularBufferIter<t>) -> Bool = \"dew_circular_buffer_iter_has_next\"\npub builtin circular_buffer_iter_next<t>(iter: CircularBufferIter<t>) -> t = \"dew_circular_buffer_iter_next\"\npub builtin circular_buffer_push_front<t>(buffer: CircularBuffer<t>, value: t) -> Bool = \"dew_circular_buffer_push_front\"\npub builtin circular_buffer_pop_back<t>(buffer: CircularBuffer<t>) -> Option<t> = \"dew_circular_buffer_pop_back\"\npub builtin circular_buffer_peek_back<t>(buffer: CircularBuffer<t>) -> Option<t> = \"dew_circular_buffer_peek_back\"\n"
}

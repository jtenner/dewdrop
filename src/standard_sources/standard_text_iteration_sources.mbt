///|
pub fn standard_text_iteration_source() -> Bytes {
  b"open dew.std.string\nopen dew.std.fixed_array\n\npub enum DecimalParseError {\n  Empty\n  InvalidDigit(U32)\n  Overflow(U32)\n}\n\nfn parse_decimal_magnitude(\n  value: StringView,\n  start: U32,\n  limit: U32,\n) -> Result<U32, DecimalParseError> {\n  let length = value.byte_length()\n  let quotient = limit / 10u32\n  let remainder = limit % 10u32\n  let mut number = 0u32\n  while start {\n    index if index < length => {\n      let byte = value.byte_at(index)\n      if byte < 48u8 || byte > 57u8 {\n        break Result::Err(DecimalParseError::InvalidDigit(index))\n      } else {\n        let digit = code_point_u8_to_u32(byte - 48u8)\n        if number > quotient || (number == quotient && digit > remainder) {\n          break Result::Err(DecimalParseError::Overflow(index))\n        } else {\n          number = number * 10u32 + digit\n          continue index + 1u32\n        }\n      }\n    }\n    _ => break Result::Ok(number)\n  }\n}\n\npub fn parse_u32_decimal(value: StringView) -> Result<U32, DecimalParseError> {\n  if value.byte_length() == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    parse_decimal_magnitude(value, 0u32, 4294967295u32)\n  }\n}\n\npub fn parse_i32_decimal(value: StringView) -> Result<I32, DecimalParseError> {\n  let length = value.byte_length()\n  if length == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    let negative = value.byte_at(0u32) == 45u8\n    let start = if negative {\n      1u32\n    } else {\n      0u32\n    }\n    if start == length {\n      Result::Err(DecimalParseError::InvalidDigit(0u32))\n    } else {\n      let limit = if negative {\n        2147483648u32\n      } else {\n        2147483647u32\n      }\n      match parse_decimal_magnitude(value, start, limit) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(magnitude) => {\n          if negative && magnitude == 2147483648u32 {\n            Result::Ok(-2147483648i32)\n          } else {\n            let signed = decimal_magnitude_to_i32(magnitude)\n            Result::Ok(if negative {\n              -signed\n            } else {\n              signed\n            })\n          }\n        }\n      }\n    }\n  }\n}\n\nfn decimal_magnitude_to_i32(value: U32) -> I32 {\n  value.into()\n}\n\nfn parse_wide_decimal_magnitude(\n  value: StringView,\n  start: U32,\n  limit: U64,\n) -> Result<U64, DecimalParseError> {\n  let length = value.byte_length()\n  let quotient = limit / 10u64\n  let remainder = limit % 10u64\n  let mut number = 0u64\n  while start {\n    index if index < length => {\n      let byte = value.byte_at(index)\n      if byte < 48u8 || byte > 57u8 {\n        break Result::Err(DecimalParseError::InvalidDigit(index))\n      } else {\n        let digit = decimal_digit_to_u64(code_point_u8_to_u32(byte - 48u8))\n        if number > quotient || (number == quotient && digit > remainder) {\n          break Result::Err(DecimalParseError::Overflow(index))\n        } else {\n          number = number * 10u64 + digit\n          continue index + 1u32\n        }\n      }\n    }\n    _ => break Result::Ok(number)\n  }\n}\n\npub fn parse_u64_decimal(value: StringView) -> Result<U64, DecimalParseError> {\n  if value.byte_length() == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    parse_wide_decimal_magnitude(value, 0u32, 18446744073709551615u64)\n  }\n}\n\npub fn parse_i64_decimal(value: StringView) -> Result<I64, DecimalParseError> {\n  let length = value.byte_length()\n  if length == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    let negative = value.byte_at(0u32) == 45u8\n    let start = if negative {\n      1u32\n    } else {\n      0u32\n    }\n    if start == length {\n      Result::Err(DecimalParseError::InvalidDigit(0u32))\n    } else {\n      let limit = if negative {\n        9223372036854775808u64\n      } else {\n        9223372036854775807u64\n      }\n      match parse_wide_decimal_magnitude(value, start, limit) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(magnitude) => {\n          if negative && magnitude == 9223372036854775808u64 {\n            Result::Ok(-9223372036854775808i64)\n          } else {\n            let signed = decimal_magnitude_to_i64(magnitude)\n            Result::Ok(if negative {\n              -signed\n            } else {\n              signed\n            })\n          }\n        }\n      }\n    }\n  }\n}\n\nfn decimal_digit_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn decimal_magnitude_to_i64(value: U64) -> I64 {\n  value.into()\n}\n\npub struct StringCodePoints {\n  value: String\n  state: FixedArray<U32>\n}\n\npub struct StringViewCodePoints {\n  value: StringView\n  state: FixedArray<U32>\n}\n\npub fn text_code_points_string_byte_length(value: String) -> U32 {\n  value.byte_length()\n}\npub fn text_code_points_string_byte_at(value: String, index: U32) -> U8 {\n  value.byte_at(index)\n}\npub fn text_code_points_string_view_byte_length(value: StringView) -> U32 {\n  value.byte_length()\n}\npub fn text_code_points_string_view_byte_at(value: StringView, index: U32) -> U8 {\n  value.byte_at(index)\n}\n\npub fn code_point_continuation(byte: U8) -> Bool {\n  byte >= 128u8 && byte <= 191u8\n}\n\npub fn code_point_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn code_point_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn code_point_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\npub fn code_point_pack(scalar: U32, width: U32) -> U64 {\n  code_point_u32_to_u64(scalar) |\n  (code_point_u32_to_u64(width) << 32u64)\n}\n\npub fn decode_code_point(\n  first: U8,\n  second: U8,\n  third: U8,\n  fourth: U8,\n  remaining: U32,\n) -> U64 {\n  let first_bits = code_point_u8_to_u32(first)\n  let second_bits = code_point_u8_to_u32(second)\n  let third_bits = code_point_u8_to_u32(third)\n  let fourth_bits = code_point_u8_to_u32(fourth)\n  if first <= 127u8 {\n    code_point_pack(first_bits, 1u32)\n  } else if first >= 194u8 && first <= 223u8 && remaining >= 2u32 && code_point_continuation(second) {\n    code_point_pack(\n      ((first_bits & 31u32) << 6u32) | (second_bits & 63u32),\n      2u32,\n    )\n  } else if first >= 224u8 && first <= 239u8 && remaining >= 3u32 && code_point_continuation(second) && code_point_continuation(third) && (first != 224u8 || second >= 160u8) && (first != 237u8 || second < 160u8) {\n    code_point_pack(\n      ((first_bits & 15u32) << 12u32) |\n      ((second_bits & 63u32) << 6u32) |\n      (third_bits & 63u32),\n      3u32,\n    )\n  } else if first >= 240u8 && first <= 244u8 && remaining >= 4u32 && code_point_continuation(second) && code_point_continuation(third) && code_point_continuation(fourth) && (first != 240u8 || second >= 144u8) && (first != 244u8 || second < 144u8) {\n    code_point_pack(\n      ((first_bits & 7u32) << 18u32) |\n      ((second_bits & 63u32) << 12u32) |\n      ((third_bits & 63u32) << 6u32) |\n      (fourth_bits & 63u32),\n      4u32,\n    )\n  } else {\n    unreachable()\n  }\n}\n\npub fn code_point_state() -> FixedArray<U32> {\n  FixedArray::make(1u32, 0u32)\n}\n\npub fn string_code_points(value: String) -> StringCodePoints {\n  StringCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\npub fn string_view_code_points(value: StringView) -> StringViewCodePoints {\n  StringViewCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\npub fn string_code_points_has_next(iterator: StringCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_byte_length(iterator.value)\n}\n\npub fn string_view_code_points_has_next(iterator: StringViewCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_view_byte_length(iterator.value)\n}\n\npub fn string_code_points_next(iterator: StringCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\npub fn string_view_code_points_next(iterator: StringViewCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_view_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_view_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\nimpl String {\n  fn code_points(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n  fn iter(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n}\n\nimpl StringView {\n  fn code_points(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n  fn iter(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n}\n\nimpl Iter<U32> for StringCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_code_points_has_next(self) {\n      Option::Some(string_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n\nimpl Iter<U32> for StringViewCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_view_code_points_has_next(self) {\n      Option::Some(string_view_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n\n// State slots: next field start, exhausted flag, source scans, comparisons.\n// The delimiter prefix table is built once. Returned fields share source bytes.\npub struct StringViewSplit {\n  value: StringView\n  delimiter: StringView\n  prefix: FixedArray<U32>\n  state: FixedArray<U32>\n  line_mode: Bool\n}\n\nfn text_split_prefix(delimiter: StringView) -> FixedArray<U32> {\n  let length = delimiter.byte_length()\n  let prefix = FixedArray::make(length, 0u32)\n  let mut matched = 0u32\n  while 1u32 {\n    index if index < length => {\n      let byte = delimiter.byte_at(index)\n      matched = while matched {\n        count if count > 0u32 && byte != delimiter.byte_at(count) => {\n          continue prefix.get_unchecked(count - 1u32)\n        }\n        count => break count\n      }\n      if byte == delimiter.byte_at(matched) {\n        matched = matched + 1u32\n      }\n      prefix.set_unchecked(index, matched)\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  prefix\n}\n\nfn text_split(value: StringView, delimiter: StringView, line_mode: Bool) -> StringViewSplit {\n  StringViewSplit::{\n    value: value\n    delimiter: delimiter\n    prefix: text_split_prefix(delimiter)\n    state: FixedArray::make(4u32, 0u32)\n    line_mode: line_mode\n  }\n}\n\nimpl StringView {\n  fn split(self, delimiter: StringView) -> StringViewSplit {\n    text_split(self, delimiter, false)\n  }\n  fn lines(self) -> StringViewSplit {\n    text_split(self, \"\\n\".view(0u32, 1u32), true)\n  }\n}\n\nimpl StringViewSplit {\n  fn iter(self) -> StringViewSplit {\n    self\n  }\n  fn source_scans(self) -> U32 {\n    self.state.get_unchecked(2u32)\n  }\n  fn comparisons(self) -> U32 {\n    self.state.get_unchecked(3u32)\n  }\n}\n\nimpl Iter<StringView> for StringViewSplit {\n  fn next(self) -> Option<StringView> {\n    if self.state.get_unchecked(1u32) != 0u32 {\n      Option::None\n    } else {\n      let start = self.state.get_unchecked(0u32)\n      let length = self.value.byte_length()\n      let width = self.delimiter.byte_length()\n      let mut matched = 0u32\n      let mut scans = self.source_scans()\n      let mut comparisons = self.comparisons()\n      let end = while start {\n        index if index < length && width > 0u32 => {\n          let byte = self.value.byte_at(index)\n          scans = scans + 1u32\n          let equal = while matched {\n            count => {\n              comparisons = comparisons + 1u32\n              if byte == self.delimiter.byte_at(count) {\n                break true\n              } else if count == 0u32 {\n                break false\n              } else {\n                matched = self.prefix.get_unchecked(count - 1u32)\n                continue matched\n              }\n            }\n          }\n          if equal {\n            matched = matched + 1u32\n          }\n          if matched == width {\n            self.state.set_unchecked(0u32, index + 1u32)\n            break index + 1u32 - width\n          }\n          continue index + 1u32\n        }\n        _ => {\n          self.state.set_unchecked(1u32, 1u32)\n          break length\n        }\n      }\n      self.state.set_unchecked(2u32, scans)\n      self.state.set_unchecked(3u32, comparisons)\n      let field_end = if self.line_mode && self.state.get_unchecked(1u32) == 0u32 && end > start && self.value.byte_at(end - 1u32) == 13u8 {\n        end - 1u32\n      } else {\n        end\n      }\n      Option::Some(self.value.view(start, field_end - start))\n    }\n  }\n}\n"
}

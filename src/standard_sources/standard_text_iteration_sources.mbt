///|
pub fn standard_text_iteration_source() -> Bytes {
  b"open dew.std.string\nopen dew.std.fixed_array\n\npub struct StringCodePoints {\n  value: String\n  state: FixedArray<U32>\n}\n\npub struct StringViewCodePoints {\n  value: StringView\n  state: FixedArray<U32>\n}\n\nfn text_code_points_string_byte_length(value: String) -> U32 {\n  value.byte_length()\n}\nfn text_code_points_string_byte_at(value: String, index: U32) -> U8 {\n  value.byte_at(index)\n}\nbuiltin text_code_points_string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\nbuiltin text_code_points_string_view_byte_at(value: StringView, index: U32) -> U8 = \"dew_string_view_byte_at\"\n\nfn code_point_continuation(byte: U8) -> Bool {\n  byte >= 128u8 && byte <= 191u8\n}\n\nfn code_point_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\nfn code_point_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\nfn code_point_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\nfn code_point_pack(scalar: U32, width: U32) -> U64 {\n  code_point_u32_to_u64(scalar) |\n  (code_point_u32_to_u64(width) << 32u64)\n}\n\nfn decode_code_point(\n  first: U8,\n  second: U8,\n  third: U8,\n  fourth: U8,\n  remaining: U32,\n) -> U64 {\n  let first_bits = code_point_u8_to_u32(first)\n  let second_bits = code_point_u8_to_u32(second)\n  let third_bits = code_point_u8_to_u32(third)\n  let fourth_bits = code_point_u8_to_u32(fourth)\n  if first <= 127u8 {\n    code_point_pack(first_bits, 1u32)\n  } else if first >= 194u8 && first <= 223u8 && remaining >= 2u32 && code_point_continuation(second) {\n    code_point_pack(\n      ((first_bits & 31u32) << 6u32) | (second_bits & 63u32),\n      2u32,\n    )\n  } else if first >= 224u8 && first <= 239u8 && remaining >= 3u32 && code_point_continuation(second) && code_point_continuation(third) && (first != 224u8 || second >= 160u8) && (first != 237u8 || second < 160u8) {\n    code_point_pack(\n      ((first_bits & 15u32) << 12u32) |\n      ((second_bits & 63u32) << 6u32) |\n      (third_bits & 63u32),\n      3u32,\n    )\n  } else if first >= 240u8 && first <= 244u8 && remaining >= 4u32 && code_point_continuation(second) && code_point_continuation(third) && code_point_continuation(fourth) && (first != 240u8 || second >= 144u8) && (first != 244u8 || second < 144u8) {\n    code_point_pack(\n      ((first_bits & 7u32) << 18u32) |\n      ((second_bits & 63u32) << 12u32) |\n      ((third_bits & 63u32) << 6u32) |\n      (fourth_bits & 63u32),\n      4u32,\n    )\n  } else {\n    unreachable()\n  }\n}\n\nfn code_point_state() -> FixedArray<U32> {\n  FixedArray::make(1u32, 0u32)\n}\n\npub fn string_code_points(value: String) -> StringCodePoints {\n  StringCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\npub fn string_view_code_points(value: StringView) -> StringViewCodePoints {\n  StringViewCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\nfn string_code_points_has_next(iterator: StringCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_byte_length(iterator.value)\n}\n\nfn string_view_code_points_has_next(iterator: StringViewCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_view_byte_length(iterator.value)\n}\n\nfn string_code_points_next(iterator: StringCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\nfn string_view_code_points_next(iterator: StringViewCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_view_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_view_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\nimpl String {\n  fn code_points(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n  fn iter(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n}\n\nimpl StringView {\n  fn code_points(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n  fn iter(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n}\n\nimpl Iter<U32> for StringCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_code_points_has_next(self) {\n      Option::Some(string_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n\nimpl Iter<U32> for StringViewCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_view_code_points_has_next(self) {\n      Option::Some(string_view_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n"
}

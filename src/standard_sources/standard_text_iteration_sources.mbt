///|
pub fn standard_text_iteration_source() -> Bytes {
  b"open dew.std.string\nopen dew.std.fixed_array\n\npub enum DecimalParseError {\n  Empty\n  InvalidDigit(U32)\n  Overflow(U32)\n}\n\nfn parse_decimal_magnitude(\n  value: StringView,\n  start: U32,\n  limit: U32,\n) -> Result<U32, DecimalParseError> {\n  let length = value.byte_length()\n  let quotient = limit / 10u32\n  let remainder = limit % 10u32\n  let mut number = 0u32\n  while start {\n    index if index < length => {\n      let byte = value.byte_at(index)\n      if byte < 48u8 || byte > 57u8 {\n        break Result::Err(DecimalParseError::InvalidDigit(index))\n      } else {\n        let digit = code_point_u8_to_u32(byte - 48u8)\n        if number > quotient || (number == quotient && digit > remainder) {\n          break Result::Err(DecimalParseError::Overflow(index))\n        } else {\n          number = number * 10u32 + digit\n          continue index + 1u32\n        }\n      }\n    }\n    _ => break Result::Ok(number)\n  }\n}\n\npub fn parse_u32_decimal(value: StringView) -> Result<U32, DecimalParseError> {\n  if value.byte_length() == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    parse_decimal_magnitude(value, 0u32, 4294967295u32)\n  }\n}\n\npub fn parse_i32_decimal(value: StringView) -> Result<I32, DecimalParseError> {\n  let length = value.byte_length()\n  if length == 0u32 {\n    Result::Err(DecimalParseError::Empty)\n  } else {\n    let negative = value.byte_at(0u32) == 45u8\n    let start = if negative {\n      1u32\n    } else {\n      0u32\n    }\n    if start == length {\n      Result::Err(DecimalParseError::InvalidDigit(0u32))\n    } else {\n      let limit = if negative {\n        2147483648u32\n      } else {\n        2147483647u32\n      }\n      match parse_decimal_magnitude(value, start, limit) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(magnitude) => {\n          if negative && magnitude == 2147483648u32 {\n            Result::Ok(-2147483648i32)\n          } else {\n            let signed = decimal_magnitude_to_i32(magnitude)\n            Result::Ok(if negative {\n              -signed\n            } else {\n              signed\n            })\n          }\n        }\n      }\n    }\n  }\n}\n\nfn decimal_magnitude_to_i32(value: U32) -> I32 {\n  value.into()\n}\n\npub struct StringCodePoints {\n  value: String\n  state: FixedArray<U32>\n}\n\npub struct StringViewCodePoints {\n  value: StringView\n  state: FixedArray<U32>\n}\n\npub fn text_code_points_string_byte_length(value: String) -> U32 {\n  value.byte_length()\n}\npub fn text_code_points_string_byte_at(value: String, index: U32) -> U8 {\n  value.byte_at(index)\n}\npub fn text_code_points_string_view_byte_length(value: StringView) -> U32 {\n  value.byte_length()\n}\npub fn text_code_points_string_view_byte_at(value: StringView, index: U32) -> U8 {\n  value.byte_at(index)\n}\n\npub fn code_point_continuation(byte: U8) -> Bool {\n  byte >= 128u8 && byte <= 191u8\n}\n\npub fn code_point_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn code_point_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn code_point_u64_to_u32(value: U64) -> U32 {\n  value.into()\n}\n\npub fn code_point_pack(scalar: U32, width: U32) -> U64 {\n  code_point_u32_to_u64(scalar) |\n  (code_point_u32_to_u64(width) << 32u64)\n}\n\npub fn decode_code_point(\n  first: U8,\n  second: U8,\n  third: U8,\n  fourth: U8,\n  remaining: U32,\n) -> U64 {\n  let first_bits = code_point_u8_to_u32(first)\n  let second_bits = code_point_u8_to_u32(second)\n  let third_bits = code_point_u8_to_u32(third)\n  let fourth_bits = code_point_u8_to_u32(fourth)\n  if first <= 127u8 {\n    code_point_pack(first_bits, 1u32)\n  } else if first >= 194u8 && first <= 223u8 && remaining >= 2u32 && code_point_continuation(second) {\n    code_point_pack(\n      ((first_bits & 31u32) << 6u32) | (second_bits & 63u32),\n      2u32,\n    )\n  } else if first >= 224u8 && first <= 239u8 && remaining >= 3u32 && code_point_continuation(second) && code_point_continuation(third) && (first != 224u8 || second >= 160u8) && (first != 237u8 || second < 160u8) {\n    code_point_pack(\n      ((first_bits & 15u32) << 12u32) |\n      ((second_bits & 63u32) << 6u32) |\n      (third_bits & 63u32),\n      3u32,\n    )\n  } else if first >= 240u8 && first <= 244u8 && remaining >= 4u32 && code_point_continuation(second) && code_point_continuation(third) && code_point_continuation(fourth) && (first != 240u8 || second >= 144u8) && (first != 244u8 || second < 144u8) {\n    code_point_pack(\n      ((first_bits & 7u32) << 18u32) |\n      ((second_bits & 63u32) << 12u32) |\n      ((third_bits & 63u32) << 6u32) |\n      (fourth_bits & 63u32),\n      4u32,\n    )\n  } else {\n    unreachable()\n  }\n}\n\npub fn code_point_state() -> FixedArray<U32> {\n  FixedArray::make(1u32, 0u32)\n}\n\npub fn string_code_points(value: String) -> StringCodePoints {\n  StringCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\npub fn string_view_code_points(value: StringView) -> StringViewCodePoints {\n  StringViewCodePoints::{\n    value: value\n    state: code_point_state()\n  }\n}\n\npub fn string_code_points_has_next(iterator: StringCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_byte_length(iterator.value)\n}\n\npub fn string_view_code_points_has_next(iterator: StringViewCodePoints) -> Bool {\n  iterator.state.get_unchecked(0u32) < text_code_points_string_view_byte_length(iterator.value)\n}\n\npub fn string_code_points_next(iterator: StringCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\npub fn string_view_code_points_next(iterator: StringViewCodePoints) -> U32 {\n  let index = iterator.state.get_unchecked(0u32)\n  let length = text_code_points_string_view_byte_length(iterator.value)\n  if index >= length {\n    unreachable()\n  } else {\n    let remaining = length - index\n    let first = text_code_points_string_view_byte_at(iterator.value, index)\n    let second = if remaining >= 2u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 1u32)\n    } else {\n      0u8\n    }\n    let third = if remaining >= 3u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 2u32)\n    } else {\n      0u8\n    }\n    let fourth = if remaining >= 4u32 {\n      text_code_points_string_view_byte_at(iterator.value, index + 3u32)\n    } else {\n      0u8\n    }\n    let decoded = decode_code_point(first, second, third, fourth, remaining)\n    let scalar = code_point_u64_to_u32(decoded & 4294967295u64)\n    let width = code_point_u64_to_u32(decoded >> 32u64)\n    iterator.state.set_unchecked(0u32, index + width)\n    scalar\n  }\n}\n\nimpl String {\n  fn code_points(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n  fn iter(self) -> StringCodePoints {\n    string_code_points(self)\n  }\n}\n\nimpl StringView {\n  fn code_points(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n  fn iter(self) -> StringViewCodePoints {\n    string_view_code_points(self)\n  }\n}\n\nimpl Iter<U32> for StringCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_code_points_has_next(self) {\n      Option::Some(string_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n\nimpl Iter<U32> for StringViewCodePoints {\n  fn next(self) -> Option<U32> {\n    if string_view_code_points_has_next(self) {\n      Option::Some(string_view_code_points_next(self))\n    } else {\n      Option::None\n    }\n  }\n}\n"
}

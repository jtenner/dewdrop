///|
pub fn standard_into_builtins_source() -> Bytes {
  b"// Each raw target below is one Wasm instruction. Conversion policy stays in Dew.\nbuiltin raw_i32_extend8_s(value: I32) -> I32 = \"i32.extend8_s\"\nbuiltin raw_i32_extend16_s(value: I32) -> I32 = \"i32.extend16_s\"\nbuiltin raw_i32_wrap_i64(value: I64) -> I32 = \"i32.wrap_i64\"\nbuiltin raw_i64_extend_i32_s(value: I32) -> I64 = \"i64.extend_i32_s\"\nbuiltin raw_i64_extend_i32_u(value: I32) -> I64 = \"i64.extend_i32_u\"\nbuiltin raw_f32_convert_i32_s(value: I32) -> F32 = \"f32.convert_i32_s\"\nbuiltin raw_i32_trunc_f32_s(value: F32) -> I32 = \"i32.trunc_f32_s\"\nbuiltin raw_f32_convert_i32_u(value: I32) -> F32 = \"f32.convert_i32_u\"\nbuiltin raw_i32_trunc_f32_u(value: F32) -> I32 = \"i32.trunc_f32_u\"\nbuiltin raw_f32_convert_i64_s(value: I64) -> F32 = \"f32.convert_i64_s\"\nbuiltin raw_i64_trunc_f32_s(value: F32) -> I64 = \"i64.trunc_f32_s\"\nbuiltin raw_f32_convert_i64_u(value: I64) -> F32 = \"f32.convert_i64_u\"\nbuiltin raw_i64_trunc_f32_u(value: F32) -> I64 = \"i64.trunc_f32_u\"\nbuiltin raw_f64_convert_i32_s(value: I32) -> F64 = \"f64.convert_i32_s\"\nbuiltin raw_i32_trunc_f64_s(value: F64) -> I32 = \"i32.trunc_f64_s\"\nbuiltin raw_f64_convert_i32_u(value: I32) -> F64 = \"f64.convert_i32_u\"\nbuiltin raw_i32_trunc_f64_u(value: F64) -> I32 = \"i32.trunc_f64_u\"\nbuiltin raw_f64_convert_i64_s(value: I64) -> F64 = \"f64.convert_i64_s\"\nbuiltin raw_i64_trunc_f64_s(value: F64) -> I64 = \"i64.trunc_f64_s\"\nbuiltin raw_f64_convert_i64_u(value: I64) -> F64 = \"f64.convert_i64_u\"\nbuiltin raw_i64_trunc_f64_u(value: F64) -> I64 = \"i64.trunc_f64_u\"\nbuiltin raw_f32_demote_f64(value: F64) -> F32 = \"f32.demote_f64\"\nbuiltin raw_f64_promote_f32(value: F32) -> F64 = \"f64.promote_f32\"\n\npub fn i8_into_i8(value: I8) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(unsafe_bitcast::<I8, I32>(value)))\n}\npub fn i8_into_i16(value: I8) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(unsafe_bitcast::<I8, I32>(value)))\n}\npub fn i8_into_i32(value: I8) -> I32 {\n  unsafe_bitcast::<I8, I32>(value)\n}\npub fn i8_into_i64(value: I8) -> I64 {\n  raw_i64_extend_i32_s(unsafe_bitcast::<I8, I32>(value))\n}\npub fn i8_into_u8(value: I8) -> U8 {\n  unsafe_bitcast::<I32, U8>((unsafe_bitcast::<I8, I32>(value) & 255i32))\n}\npub fn i8_into_u16(value: I8) -> U16 {\n  unsafe_bitcast::<I32, U16>((unsafe_bitcast::<I8, I32>(value) & 65535i32))\n}\npub fn i8_into_u32(value: I8) -> U32 {\n  unsafe_bitcast::<I32, U32>(unsafe_bitcast::<I8, I32>(value))\n}\npub fn i8_into_u64(value: I8) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_extend_i32_s(unsafe_bitcast::<I8, I32>(value)))\n}\npub fn i8_into_f32(value: I8) -> F32 {\n  raw_f32_convert_i32_s(unsafe_bitcast::<I8, I32>(value))\n}\npub fn i8_into_f64(value: I8) -> F64 {\n  raw_f64_convert_i32_s(unsafe_bitcast::<I8, I32>(value))\n}\npub fn i16_into_i8(value: I16) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(unsafe_bitcast::<I16, I32>(value)))\n}\npub fn i16_into_i16(value: I16) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(unsafe_bitcast::<I16, I32>(value)))\n}\npub fn i16_into_i32(value: I16) -> I32 {\n  unsafe_bitcast::<I16, I32>(value)\n}\npub fn i16_into_i64(value: I16) -> I64 {\n  raw_i64_extend_i32_s(unsafe_bitcast::<I16, I32>(value))\n}\npub fn i16_into_u8(value: I16) -> U8 {\n  unsafe_bitcast::<I32, U8>((unsafe_bitcast::<I16, I32>(value) & 255i32))\n}\npub fn i16_into_u16(value: I16) -> U16 {\n  unsafe_bitcast::<I32, U16>((unsafe_bitcast::<I16, I32>(value) & 65535i32))\n}\npub fn i16_into_u32(value: I16) -> U32 {\n  unsafe_bitcast::<I32, U32>(unsafe_bitcast::<I16, I32>(value))\n}\npub fn i16_into_u64(value: I16) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_extend_i32_s(unsafe_bitcast::<I16, I32>(value)))\n}\npub fn i16_into_f32(value: I16) -> F32 {\n  raw_f32_convert_i32_s(unsafe_bitcast::<I16, I32>(value))\n}\npub fn i16_into_f64(value: I16) -> F64 {\n  raw_f64_convert_i32_s(unsafe_bitcast::<I16, I32>(value))\n}\npub fn i32_into_i8(value: I32) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(value))\n}\npub fn i32_into_i16(value: I32) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(value))\n}\npub fn i32_into_i32(value: I32) -> I32 {\n  value\n}\npub fn i32_into_i64(value: I32) -> I64 {\n  raw_i64_extend_i32_s(value)\n}\npub fn i32_into_u8(value: I32) -> U8 {\n  unsafe_bitcast::<I32, U8>((value & 255i32))\n}\npub fn i32_into_u16(value: I32) -> U16 {\n  unsafe_bitcast::<I32, U16>((value & 65535i32))\n}\npub fn i32_into_u32(value: I32) -> U32 {\n  unsafe_bitcast::<I32, U32>(value)\n}\npub fn i32_into_u64(value: I32) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_extend_i32_s(value))\n}\npub fn i32_into_f32(value: I32) -> F32 {\n  raw_f32_convert_i32_s(value)\n}\npub fn i32_into_f64(value: I32) -> F64 {\n  raw_f64_convert_i32_s(value)\n}\npub fn i64_into_i8(value: I64) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(raw_i32_wrap_i64(value)))\n}\npub fn i64_into_i16(value: I64) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(raw_i32_wrap_i64(value)))\n}\npub fn i64_into_i32(value: I64) -> I32 {\n  raw_i32_wrap_i64(value)\n}\npub fn i64_into_i64(value: I64) -> I64 {\n  value\n}\npub fn i64_into_u8(value: I64) -> U8 {\n  unsafe_bitcast::<I32, U8>((raw_i32_wrap_i64(value) & 255i32))\n}\npub fn i64_into_u16(value: I64) -> U16 {\n  unsafe_bitcast::<I32, U16>((raw_i32_wrap_i64(value) & 65535i32))\n}\npub fn i64_into_u32(value: I64) -> U32 {\n  unsafe_bitcast::<I32, U32>(raw_i32_wrap_i64(value))\n}\npub fn i64_into_u64(value: I64) -> U64 {\n  unsafe_bitcast::<I64, U64>(value)\n}\npub fn i64_into_f32(value: I64) -> F32 {\n  raw_f32_convert_i64_s(value)\n}\npub fn i64_into_f64(value: I64) -> F64 {\n  raw_f64_convert_i64_s(value)\n}\npub fn u8_into_i8(value: U8) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(unsafe_bitcast::<U8, I32>(value)))\n}\npub fn u8_into_i16(value: U8) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(unsafe_bitcast::<U8, I32>(value)))\n}\npub fn u8_into_i32(value: U8) -> I32 {\n  unsafe_bitcast::<U8, I32>(value)\n}\npub fn u8_into_i64(value: U8) -> I64 {\n  raw_i64_extend_i32_u(unsafe_bitcast::<U8, I32>(value))\n}\npub fn u8_into_u8(value: U8) -> U8 {\n  unsafe_bitcast::<I32, U8>((unsafe_bitcast::<U8, I32>(value) & 255i32))\n}\npub fn u8_into_u16(value: U8) -> U16 {\n  unsafe_bitcast::<I32, U16>((unsafe_bitcast::<U8, I32>(value) & 65535i32))\n}\npub fn u8_into_u32(value: U8) -> U32 {\n  unsafe_bitcast::<I32, U32>(unsafe_bitcast::<U8, I32>(value))\n}\npub fn u8_into_u64(value: U8) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_extend_i32_u(unsafe_bitcast::<U8, I32>(value)))\n}\npub fn u8_into_f32(value: U8) -> F32 {\n  raw_f32_convert_i32_u(unsafe_bitcast::<U8, I32>(value))\n}\npub fn u8_into_f64(value: U8) -> F64 {\n  raw_f64_convert_i32_u(unsafe_bitcast::<U8, I32>(value))\n}\npub fn u16_into_i8(value: U16) -> I8 {\n  unsafe_bitcast::<I32, I8>(raw_i32_extend8_s(unsafe_bitcast::<U16, I32>(value)))\n}\npub fn u16_into_i16(value: U16) -> I16 {\n  unsafe_bitcast::<I32, I16>(raw_i32_extend16_s(unsafe_bitcast::<U16, I32>(value)))\n}\npub fn u16_into_i32(value: U16) -> I32 {\n  unsafe_bitcast::<U16, I32>(value)\n}\npub fn u16_into_i64(value: U16) -> I64 {\n  raw_i64_extend_i32_u(unsafe_bitcast::<U16, I32>(value))\n}\npub fn u16_into_u8(value: U16) -> U8 {\n  unsafe_bitcast::<I32, U8>((unsafe_bitcast::<U16, I32>(value) & 255i32))\n}\npub fn u16_into_u16(value: U16) -> U16 {\n  unsafe_bitcast::<I32, U16>((unsafe_bitcast::<U16, I32>(value) & 65535i32))\n}\npub fn u16_into_u32(value: U16) -> U32 {\n  unsafe_bitcast::<I32, U32>(unsafe_bitcast::<U16, I32>(value))\n}\npub fn u16_into_u64(value: U16) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_extend_i32_u(unsafe_bitcast::<U16, I32>(value)))\n}\npub fn u16_into_f32(value: U16) -> F32 {\n  raw_f32_convert_i32_u(unsafe_bitcast::<U16, I32>(value))\n}\npub fn u16_into_f64(value: U16) -> F64 {\n  raw_f64_convert_i32_u(unsafe_bitcast::<U16, I32>(value))\n}\npub fn u32_into_i8(value:
32(value: F64) -> I32 {\n  raw_i32_trunc_f64_s(value)\n}\npub fn f64_into_i64(value: F64) -> I64 {\n  raw_i64_trunc_f64_s(value)\n}\npub fn f64_into_u8(value: F64) -> U8 {\n  let integer = f64_into_u32(value)\n  if integer > 255u32 {\n    unreachable()\n  } else {\n    unsafe_bitcast::<U32, U8>(integer)\n  }\n}\npub fn f64_into_u16(value: F64) -> U16 {\n  let integer = f64_into_u32(value)\n  if integer > 65535u32 {\n    unreachable()\n  } else {\n    unsafe_bitcast::<U32, U16>(integer)\n  }\n}\npub fn f64_into_u32(value: F64) -> U32 {\n  unsafe_bitcast::<I32, U32>(raw_i32_trunc_f64_u(value))\n}\npub fn f64_into_u64(value: F64) -> U64 {\n  unsafe_bitcast::<I64, U64>(raw_i64_trunc_f64_u(value))\n}\npub fn f64_into_f32(value: F64) -> F32 {\n  raw_f32_demote_f64(value)\n}\npub fn f64_into_f64(value: F64) -> F64 {\n  value\n}\n"

///|
pub fn standard_memory_preamble_source() -> Bytes {
  b"pub builtin i8_load(address: U32) -> I8 = \"dew_i8_load\"\npub builtin i8_store(address: U32, value: I8) -> Unit = \"dew_i8_store\"\npub builtin i16_load(address: U32) -> I16 = \"dew_i16_load\"\npub builtin i16_store(address: U32, value: I16) -> Unit = \"dew_i16_store\"\npub builtin i32_load(address: U32) -> I32 = \"i32.load\"\npub builtin i32_store(address: U32, value: I32) -> Unit = \"i32.store\"\npub builtin i64_load(address: U32) -> I64 = \"i64.load\"\npub builtin i64_store(address: U32, value: I64) -> Unit = \"i64.store\"\npub builtin u8_load(address: U32) -> U8 = \"dew_u8_load\"\npub builtin u8_store(address: U32, value: U8) -> Unit = \"dew_u8_store\"\npub builtin u16_load(address: U32) -> U16 = \"dew_u16_load\"\npub builtin u16_store(address: U32, value: U16) -> Unit = \"dew_u16_store\"\npub builtin u32_load(address: U32) -> U32 = \"i32.load\"\npub builtin u32_store(address: U32, value: U32) -> Unit = \"i32.store\"\npub builtin u64_load(address: U32) -> U64 = \"i64.load\"\npub builtin u64_store(address: U32, value: U64) -> Unit = \"i64.store\"\npub builtin f32_load(address: U32) -> F32 = \"dew_f32_load\"\npub builtin f32_store(address: U32, value: F32) -> Unit = \"dew_f32_store\"\npub builtin f64_load(address: U32) -> F64 = \"dew_f64_load\"\npub builtin f64_store(address: U32, value: F64) -> Unit = \"dew_f64_store\"\npub fn swar32_load(address: U32) -> Swar32 {\n  unsafe_bitcast(u32_load(address))\n}\npub fn swar32_store(address: U32, value: Swar32) -> Unit {\n  u32_store(address, unsafe_bitcast(value))\n}\npub fn swar64_load(address: U32) -> Swar64 {\n  unsafe_bitcast(u64_load(address))\n}\npub fn swar64_store(address: U32, value: Swar64) -> Unit {\n  u64_store(address, unsafe_bitcast(value))\n}\npub builtin v128_load(address: U32) -> V128 = \"v128.load\"\npub builtin v128_store(address: U32, value: V128) -> Unit = \"v128.store\"\n"
}

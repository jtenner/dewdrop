pub fn standard_numeric_impls_source() -> Bytes {
  b"impl Eq for Bool {\n  fn eq(self, right: Bool) -> Bool {\n    if self {\n      right\n    } else {\n      !right\n    }\n  }\n}\nimpl Ne for Bool {\n  fn ne(self, right: Bool) -> Bool {\n    if self {\n      !right\n    } else {\n      right\n    }\n  }\n}\n\nimpl BitOr for I8 {\n  fn bit_or(self, right: I8) -> I8 {\n    i8_or(self, right)\n  }\n}\nimpl BitXor for I8 {\n  fn bit_xor(self, right: I8) -> I8 {\n    i8_xor(self, right)\n  }\n}\nimpl BitAnd for I8 {\n  fn bit_and(self, right: I8) -> I8 {\n    i8_and(self, right)\n  }\n}\nimpl Eq for I8 {\n  fn eq(self, right: I8) -> Bool {\n    i8_eq(self, right)\n  }\n}\nimpl Ne for I8 {\n  fn ne(self, right: I8) -> Bool {\n    i8_ne(self, right)\n  }\n}\nimpl Lt for I8 {\n  fn lt(self, right: I8) -> Bool {\n    i8_lt(self, right)\n  }\n}\nimpl Lte for I8 {\n  fn lte(self, right: I8) -> Bool {\n    i8_lte(self, right)\n  }\n}\nimpl Gt for I8 {\n  fn gt(self, right: I8) -> Bool {\n    i8_gt(self, right)\n  }\n}\nimpl Gte for I8 {\n  fn gte(self, right: I8) -> Bool {\n    i8_gte(self, right)\n  }\n}\nimpl Shl for I8 {\n  fn shl(self, right: I8) -> I8 {\n    i8_shl(self, right)\n  }\n}\nimpl Shr for I8 {\n  fn shr(self, right: I8) -> I8 {\n    i8_shr(self, right)\n  }\n}\nimpl Add for I8 {\n  fn add(self, right: I8) -> I8 {\n    i8_add(self, right)\n  }\n}\nimpl Sub for I8 {\n  fn sub(self, right: I8) -> I8 {\n    i8_sub(self, right)\n  }\n}\nimpl Mul for I8 {\n  fn mul(self, right: I8) -> I8 {\n    i8_mul(self, right)\n  }\n}\nimpl Div for I8 {\n  fn div(self, right: I8) -> I8 {\n    i8_div(self, right)\n  }\n}\nimpl Rem for I8 {\n  fn rem(self, right: I8) -> I8 {\n    i8_rem(self, right)\n  }\n}\nimpl BitOr for I16 {\n  fn bit_or(self, right: I16) -> I16 {\n    i16_or(self, right)\n  }\n}\nimpl BitXor for I16 {\n  fn bit_xor(self, right: I16) -> I16 {\n    i16_xor(self, right)\n  }\n}\nimpl BitAnd for I16 {\n  fn bit_and(self, right: I16) -> I16 {\n    i16_and(self, right)\n  }\n}\nimpl Eq for I16 {\n  fn eq(self, ri
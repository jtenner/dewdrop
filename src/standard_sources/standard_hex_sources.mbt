///|
pub fn standard_hex_source() -> Bytes {
  b"open dew.std.bytes\nopen dew.std.bytes_builder\n\npub enum HexDecodeError {\n  OddLength\n  InvalidByte(U32)\n} derive(Eq)\n\n// Check before doubling or allocating. Encoding traps if the size cannot fit U32.\npub fn encoded_length(length: U32) -> Option<U32> {\n  if length > 2147483647u32 {\n    Option::None\n  } else {\n    Option::Some(length * 2u32)\n  }\n}\n\nfn hex_unit() -> Unit {\n}\n\nfn digit(value: U8) -> U8 {\n  if value < 10u8 {\n    value + 48u8\n  } else {\n    value + 87u8\n  }\n}\n\nfn nibble(byte: U8) -> U8 {\n  if byte >= 48u8 && byte <= 57u8 {\n    byte - 48u8\n  } else if byte >= 97u8 && byte <= 102u8 {\n    byte - 87u8\n  } else if byte >= 65u8 && byte <= 70u8 {\n    byte - 55u8\n  } else {\n    255u8\n  }\n}\n\npub fn encode(value: Bytes) -> Bytes {\n  let capacity = match encoded_length(value.byte_length()) {\n    Some(length) => length\n    None => {\n      unreachable()\n      0u32\n    }\n  }\n  let builder = BytesBuilder::with_capacity(capacity)\n  while 0u32 {\n    index if index < value.byte_length() => {\n      let byte = value.byte_at(index)\n      builder.append_byte(digit(byte / 16u8))\n      builder.append_byte(digit(byte % 16u8))\n      continue index + 1u32\n    }\n    _ => break builder.finish()\n  }\n}\n\n// Accept ASCII a-f and A-F. Offsets are relative to value, including views.\n// Odd length takes precedence over invalid bytes. Validate before allocation.\npub fn decode(value: Bytes) -> Result<Bytes, HexDecodeError> {\n  let length = value.byte_length()\n  if length % 2u32 != 0u32 {\n    return Err(HexDecodeError::OddLength)\n  }\n  while 0u32 {\n    index if index < length => {\n      if nibble(value.byte_at(index)) == 255u8 {\n        return Err(HexDecodeError::InvalidByte(index))\n      }\n      continue index + 1u32\n    }\n    _ => break hex_unit()\n  }\n  let builder = BytesBuilder::with_capacity(length / 2u32)\n  while 0u32 {\n    index if index < length => {\n      builder.append_byte(nibble(value.byte_at(index)) * 16u8 + nibble(value.byte_at(index + 1u32)))\n      continue index + 2u32\n    }\n    _ => break Ok(builder.finish())\n  }\n}\n"
}

///|
pub fn standard_preamble_builtins_source() -> Bytes {
  b"pub fn assert(condition: Bool, message: String) -> Unit {\n  let _ = message\n  if !condition {\n    unreachable()\n  }\n}\npub builtin unreachable() -> Never = \"unreachable\"\npub builtin i32_add(left: I32, right: I32) -> I32 = \"i32.add\"\npub builtin i32_sub(left: I32, right: I32) -> I32 = \"i32.sub\"\npub builtin i32_lte(left: I32, right: I32) -> Bool = \"i32.le_s\"\npub fn swar32_from_bits(value: U32) -> Swar32 {\n  unsafe_bitcast(value)\n}\npub fn swar32_to_bits(value: Swar32) -> U32 {\n  unsafe_bitcast(value)\n}\npub fn swar32_and(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_and(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar32_or(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_or(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar32_xor(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_xor(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_from_bits(value: U64) -> Swar64 {\n  unsafe_bitcast(value)\n}\npub fn swar64_to_bits(value: Swar64) -> U64 {\n  unsafe_bitcast(value)\n}\npub fn swar64_and(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_and(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_or(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_or(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_xor(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_xor(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub builtin v128_and(left: V128, right: V128) -> V128 = \"v128.and\"\npub builtin v128_or(left: V128, right: V128) -> V128 = \"v128.or\"\npub builtin v128_xor(left: V128, right: V128) -> V128 = \"v128.xor\"\n"
}

///|
pub fn standard_preamble_traits_source() -> Bytes {
  b"pub trait Add {\n  fn add(self, right: Self) -> Self\n}\npub trait Sub {\n  fn sub(self, right: Self) -> Self\n}\npub trait Lte {\n  fn lte(self, right: Self) -> Bool\n}\npub trait BitAnd {\n  fn bit_and(self, right: Self) -> Self\n}\npub trait BitOr {\n  fn bit_or(self, right: Self) -> Self\n}\npub trait BitXor {\n  fn bit_xor(self, right: Self) -> Self\n}\npub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\npub trait Ne {\n  fn ne(self, right: Self) -> Bool\n}\npub trait Lt {\n  fn lt(self, right: Self) -> Bool\n}\npub trait Gt {\n  fn gt(self, right: Self) -> Bool\n}\npub trait Gte {\n  fn gte(self, right: Self) -> Bool\n}\npub trait Shl {\n  fn shl(self, right: Self) -> Self\n}\npub trait Shr {\n  fn shr(self, right: Self) -> Self\n}\npub trait Mul {\n  fn mul(self, right: Self) -> Self\n}\npub trait Div {\n  fn div(self, right: Self) -> Self\n}\npub trait Rem {\n  fn rem(self, right: Self) -> Self\n}\npub trait Into<t> {\n  fn into(self) -> t\n}\n\npub trait IndexedGet<index, value> {\n  fn indexed_get(self, index: index) -> value\n}\n\npub trait IndexedSet<index, value> {\n  fn indexed_set(self, index: index, value: value) -> Unit\n}\n\npub trait Hash {\n  fn hash(self) -> U64\n  fn hash_eq(self, right: Self) -> Bool\n}\n"
}

///|
pub fn standard_debug_preamble_source() -> Bytes {
  b"pub trait Debug {\n  fn debug(self) -> Unit\n}\n\npub fn __dew_debug_ignore(value: U32) -> Unit {}\n// The synchronous host call owns this scratch range until it returns.\n// No host callback may re-enter Debug while its bytes are pending.\npub fn __dew_debug_write_scratch(start: U32, length: U32) -> U32 {\n  if start < 16u32 || start > 65536u32 || length > 65536u32 - start {\n    unreachable()\n  }\n  while 0u32 {\n    written if written < length => {\n      let remaining = length - written\n      u32_store(0u32, start + written)\n      u32_store(4u32, remaining)\n      u32_store(8u32, 0u32)\n      if DebugOutput.__dew_debug_fd_write(1u32, 0u32, 1u32, 8u32) != 0u32 {\n        unreachable()\n      } else {\n        let count = u32_load(8u32)\n        if count == 0u32 || count > remaining {\n          unreachable()\n        } else {\n          continue written + count\n        }\n      }\n    }\n    _ => break length\n  }\n}\n\npub fn __dew_debug_integer(value: U64, negative: Bool) -> U32 {\n  // A U64 needs at most 20 decimal digits. Reserve 32 bytes, including sign.\n  let mut cursor = 48u32\n  let _ = while value {\n    magnitude => {\n      cursor = cursor - 1u32\n      u8_store(cursor, u64_into_u8(magnitude % 10u64 + 48u64))\n      let next = magnitude / 10u64\n      if next == 0u64 {\n        break 0u32\n      } else {\n        continue next\n      }\n    }\n  }\n  if negative {\n    cursor = cursor - 1u32\n    u8_store(cursor, 45u8)\n  }\n  __dew_debug_write_scratch(cursor, 48u32 - cursor)\n}\n\npub fn __dew_debug_i8(value: I8) -> U32 {\n  __dew_debug_i64(i8_into_i64(i8_into_i8(value)))\n}\npub fn __dew_debug_i16(value: I16) -> U32 {\n  __dew_debug_i64(i16_into_i64(i16_into_i16(value)))\n}\npub fn __dew_debug_i32(value: I32) -> U32 {\n  __dew_debug_i64(value.into())\n}\npub fn __dew_debug_i64(value: I64) -> U32 {\n  let bits = unsafe_bitcast::<I64, U64>(value)\n  if value < 0i64 {\n    // Unsigned subtraction also handles the signed minimum exactly.\n    __dew_debug_integer(0u64 - bits, true)\n  } else {\n    __dew_debug_integer(bits, false)\n  }\n}\npub fn __dew_debug_u8(value: U8) -> U32 {\n  __dew_debug_u64(u8_into_u64(u8_into_u8(value)))\n}\npub fn __dew_debug_u16(value: U16) -> U32 {\n  __dew_debug_u64(u16_into_u64(u16_into_u16(value)))\n}\npub fn __dew_debug_u32(value: U32) -> U32 {\n  __dew_debug_u64(value.into())\n}\npub fn __dew_debug_u64(value: U64) -> U32 {\n  __dew_debug_integer(value, false)\n}\npub builtin __dew_debug_f32_bits(value: F32) -> U32 = \"i32.reinterpret_f32\"\npub builtin __dew_debug_f64_bits(value: F64) -> U64 = \"i64.reinterpret_f64\"\n\npub fn __dew_debug_hex_digits(value: U64, start: U32, digits: U32) -> U32 {\n  if digits > 16u32 || start < 16u32 || start > 65536u32 || digits > 65536u32 - start {\n    unreachable()\n  }\n  let mut bits = value\n  while digits {\n    left if left > 0u32 => {\n      let nibble = bits & 15u64\n      let byte = if nibble < 10u64 {\n        u64_into_u8(nibble + 48u64)\n      } else {\n        u64_into_u8(nibble + 87u64)\n      }\n      u8_store(start + left - 1u32, byte)\n      bits = bits >> 4u64\n      continue left - 1u32\n    }\n    _ => break start + digits\n  }\n}\n\npub fn __dew_debug_float_bits(bits: U64, wide: Bool) -> U32 {\n  u8_store(16u32, 102u8)\n  u8_store(17u32, if wide {\n    54u8\n  } else {\n    51u8\n  })\n  u8_store(18u32, if wide {\n    52u8\n  } else {\n    50u8\n  })\n  u8_store(19u32, 40u8)\n  u8_store(20u32, 48u8)\n  u8_store(21u32, 120u8)\n  let digits = if wide {\n    16u32\n  } else {\n    8u32\n  }\n  let end = __dew_debug_hex_digits(bits, 22u32, digits)\n  u8_store(end, 41u8)\n  __dew_debug_write_scratch(16u32, end + 1u32 - 16u32)\n}\n\npub fn __dew_debug_f32(value: F32) -> U32 {\n  __dew_debug_float_bits(u32_into_u64(__dew_debug_f32_bits(value)), false)\n}\npub fn __dew_debug_f64(value: F64) -> U32 {\n  __dew_debug_float_bits(__dew_debug_f64_bits(value), true)\n}\n// These are the existing text storage contracts. Keep one declaration of each\n// operation; dew.std.text_runtime exposes ordinary forwarding functions.\npub builtin __dew_text_bytes(value: String) -> Bytes = \"ref.cast\"\npub builtin __dew_text_byte_length(value: Bytes) -> U32 = \"struct.get 2\"\npub builtin __dew_text_byte_at(value: Bytes, index: U32) -> U8 = \"dew_bytes_byte_at\"\n\npub fn __dew_debug_count(total: U32, extra: U32) -> U32 {\n  if extra > 4294967295u32 - total {\n    unreachable()\n  }\n  total + extra\n}\n\npub fn __dew_debug_quoted_text(value: Bytes, bytes: Bool) -> U32 {\n  let length = __dew_text_byte_length(value)\n  let mut cursor = 16u32\n  let mut total = 0u32\n  if bytes {\n    u8_store(cursor, 98u8)\n    cursor = cursor + 1u32\n  }\n  u8_store(cursor, 34u8)\n  cursor = cursor + 1u32\n  let _ = while 0u32 {\n    index if index < length => {\n      // A byte expands to at most four ASCII bytes. Flush before that write.\n      if cursor > 65532u32 {\n        total = __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor - 16u32))\n        cursor = 16u32\n      }\n      let byte = __dew_text_byte_at(value, index)\n      let escape = match byte {\n        34u8 => 34u8\n        92u8 => 92u8\n        10u8 => 110u8\n        13u8 => 114u8\n        9u8 => 116u8\n        _ => 0u8\n      }\n      if escape != 0u8 {\n        u8_store(cursor, 92u8)\n        u8_store(cursor + 1u32, escape)\n        cursor = cursor + 2u32\n      } else if byte < 32u8 || byte == 127u8 || (bytes && byte > 126u8) {\n        u8_store(cursor, 92u8)\n        u8_store(cursor + 1u32, 120u8)\n        cursor = __dew_debug_hex_digits(u8_into_u64(byte), cursor + 2u32, 2u32)\n      } else {\n        u8_store(cursor, byte)\n        cursor = cursor + 1u32\n      }\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  if cursor == 65536u32 {\n    total = __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor - 16u32))\n    cursor = 16u32\n  }\n  u8_store(cursor, 34u8)\n  __dew_debug_count(total, __dew_debug_write_scratch(16u32, cursor + 1u32 - 16u32))\n}\n\npub fn __dew_debug_string(value: String) -> U32 {\n  __dew_debug_quoted_text(__dew_text_bytes(value), false)\n}\npub fn __dew_debug_bytes(value: Bytes) -> U32 {\n  __dew_debug_quoted_text(value, true)\n}\npub builtin __dew_debug_v128_low(value: V128) -> U64 = \"i64x2.extract_lane 0\"\npub builtin __dew_debug_v128_high(value: V128) -> U64 = \"i64x2.extract_lane 1\"\n\npub fn __dew_debug_v128(value: V128) -> U32 {\n  u8_store(16u32, 118u8)\n  u8_store(17u32, 49u8)\n  u8_store(18u32, 50u8)\n  u8_store(19u32, 56u8)\n  u8_store(20u32, 40u8)\n  u8_store(21u32, 48u8)\n  u8_store(22u32, 120u8)\n  let middle = __dew_debug_hex_digits(__dew_debug_v128_high(value), 23u32, 16u32)\n  let end = __dew_debug_hex_digits(__dew_debug_v128_low(value), middle, 16u32)\n  u8_store(end, 41u8)\n  __dew_debug_write_scratch(16u32, end + 1u32 - 16u32)\n}\npub fn debug<t: Debug>(value: t) -> Unit {\n  value.debug()\n}\n\nforeign import \"wasi_snapshot_preview1\" as DebugOutput {\n  fn __dew_debug_fd_write(fd: U32, iovs: U32, count: U32, written: U32) -> U32 = \"fd_write\"\n}\n\nimpl Debug for Unit {\n  fn debug(self) -> Unit {\n    u8_store(16u32, 40u8)\n    u8_store(17u32, 41u8)\n    __dew_debug_ignore(__dew_debug_write_scratch(16u32, 2u32))\n  }\n}\n\nimpl Debug for Bool {\n  fn debug(self) -> Unit {\n    let length = if self {\n      u8_store(16u32, 116u8)\n      u8_store(17u32, 114u8)\n      u8_store(18u32, 117u8)\n      u8_store(19u32, 101u8)\n      4u32\n    } else {\n      u8_store(16u32, 102u8)\n      u8_store(17u32, 97u8)\n      u8_store(18u32, 108u8)\n      u8_store(19u32, 115u8)\n      u8_store(20u32, 101u8)\n      5u32\n    }\n    __dew_debug_ignore(__dew_debug_write_scratch(16u32, length))\n  }\n}\n\nimpl Debug for I8 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i8(self))\n  }\n}\n\nimpl Debug for I16 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i16(self))\n  }\n}\n\nimpl Debug for I32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i32(self))\n  }\n}\n\nimpl Debug for I64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i64(self))\n  }\n}\n\nimpl Debug for U8 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u8(self))\n  }\n}\n\nimpl Debug for U16 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u16(self))\n  }\n}\n\nimpl Debug for U32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u32(self))\n  }\n}\n\nimpl Debug for U64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u64(self))\n  }\n}\n\nimpl Debug for F32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_f32(self))\n  }\n}\n\nimpl Debug for F64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_f64(self))\n  }\n}\n\nimpl Debug for String {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_string(self))\n  }\n}\n\nimpl Debug for Bytes {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_bytes(self))\n  }\n}\n\npub fn __dew_debug_swar(value: U64, wide: Bool) -> U32 {\n  u8_store(16u32, 83u8)\n  u8_store(17u32, 119u8)\n  u8_store(18u32, 97u8)\n  u8_store(19u32, 114u8)\n  u8_store(20u32, if wide {\n    54u8\n  } else {\n    51u8\n  })\n  u8_store(21u32, if wide {\n    52u8\n  } else {\n    50u8\n  })\n  u8_store(22u32, 40u8)\n  let _ = __dew_debug_write_scratch(16u32, 7u32)\n  let digits = __dew_debug_integer(value, false)\n  u8_store(16u32, 41u8)\n  let _ = __dew_debug_write_scratch(16u32, 1u32)\n  8u32 + digits\n}\n\nimpl Debug for Swar32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_swar(u32_into_u64(swar32_to_bits(self)), false))\n  }\n}\n\nimpl Debug for Swar64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_swar(swar64_to_bits(self), true))\n  }\n}\n\nimpl Debug for V128 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_v128(self))\n  }\n}\n"
}

///|
pub fn standard_preamble_i32_source() -> Bytes {
  b"impl Add for I32 {\n  fn add(self, right: I32) -> I32 {\n    i32_add(self, right)\n  }\n}\nimpl Sub for I32 {\n  fn sub(self, right: I32) -> I32 {\n    i32_sub(self, right)\n  }\n}\nimpl Lte for I32 {\n  fn lte(self, right: I32) -> Bool {\n    i32_lte(self, right)\n  }\n}\n"
}

///|
pub fn standard_preamble_packed_source() -> Bytes {
  b"// Unsafe: preserves bits only between equal non-reference Wasm carriers.\npub builtin unsafe_bitcast<source, target>(value: source) -> target = \"unsafe.bitcast\"\n\nimpl Swar32 {\n  fn from_bits(value: U32) -> Swar32 {\n    swar32_from_bits(value)\n  }\n  fn to_bits(self) -> U32 {\n    swar32_to_bits(self)\n  }\n}\nimpl BitAnd for Swar32 {\n  fn bit_and(self, right: Swar32) -> Swar32 {\n    swar32_and(self, right)\n  }\n}\nimpl BitOr for Swar32 {\n  fn bit_or(self, right: Swar32) -> Swar32 {\n    swar32_or(self, right)\n  }\n}\nimpl BitXor for Swar32 {\n  fn bit_xor(self, right: Swar32) -> Swar32 {\n    swar32_xor(self, right)\n  }\n}\nimpl Swar64 {\n  fn from_bits(value: U64) -> Swar64 {\n    swar64_from_bits(value)\n  }\n  fn to_bits(self) -> U64 {\n    swar64_to_bits(self)\n  }\n}\nimpl BitAnd for Swar64 {\n  fn bit_and(self, right: Swar64) -> Swar64 {\n    swar64_and(self, right)\n  }\n}\nimpl BitOr for Swar64 {\n  fn bit_or(self, right: Swar64) -> Swar64 {\n    swar64_or(self, right)\n  }\n}\nimpl BitXor for Swar64 {\n  fn bit_xor(self, right: Swar64) -> Swar64 {\n    swar64_xor(self, right)\n  }\n}\nimpl BitAnd for V128 {\n  fn bit_and(self, right: V128) -> V128 {\n    v128_and(self, right)\n  }\n}\nimpl BitOr for V128 {\n  fn bit_or(self, right: V128) -> V128 {\n    v128_or(self, right)\n  }\n}\nimpl BitXor for V128 {\n  fn bit_xor(self, right: V128) -> V128 {\n    v128_xor(self, right)\n  }\n}\n"
}

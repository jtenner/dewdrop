///|
pub fn standard_preamble_builtins_source() -> Bytes {
  b"pub builtin assert(condition: Bool, message: String) -> Unit = \"dew_assert\"\npub builtin unreachable() -> Never = \"unreachable\"\npub builtin i32_add(left: I32, right: I32) -> I32 = \"i32.add\"\npub builtin i32_sub(left: I32, right: I32) -> I32 = \"i32.sub\"\npub builtin i32_lte(left: I32, right: I32) -> Bool = \"i32.le_s\"\npub fn swar32_from_bits(value: U32) -> Swar32 {\n  unsafe_bitcast(value)\n}\npub fn swar32_to_bits(value: Swar32) -> U32 {\n  unsafe_bitcast(value)\n}\npub fn swar32_and(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_and(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar32_or(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_or(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar32_xor(left: Swar32, right: Swar32) -> Swar32 {\n  unsafe_bitcast(u32_xor(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_from_bits(value: U64) -> Swar64 {\n  unsafe_bitcast(value)\n}\npub fn swar64_to_bits(value: Swar64) -> U64 {\n  unsafe_bitcast(value)\n}\npub fn swar64_and(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_and(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_or(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_or(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub fn swar64_xor(left: Swar64, right: Swar64) -> Swar64 {\n  unsafe_bitcast(u64_xor(unsafe_bitcast(left), unsafe_bitcast(right)))\n}\npub builtin v128_and(left: V128, right: V128) -> V128 = \"v128.and\"\npub builtin v128_or(left: V128, right: V128) -> V128 = \"v128.or\"\npub builtin v128_xor(left: V128, right: V128) -> V128 = \"v128.xor\"\n"
}

///|
pub fn standard_preamble_traits_source() -> Bytes {
  b"pub trait Add {\n  fn add(self, right: Self) -> Self\n}\npub trait Sub {\n  fn sub(self, right: Self) -> Self\n}\npub trait Lte {\n  fn lte(self, right: Self) -> Bool\n}\npub trait BitAnd {\n  fn bit_and(self, right: Self) -> Self\n}\npub trait BitOr {\n  fn bit_or(self, right: Self) -> Self\n}\npub trait BitXor {\n  fn bit_xor(self, right: Self) -> Self\n}\npub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\npub trait Ne {\n  fn ne(self, right: Self) -> Bool\n}\npub trait Lt {\n  fn lt(self, right: Self) -> Bool\n}\npub trait Gt {\n  fn gt(self, right: Self) -> Bool\n}\npub trait Gte {\n  fn gte(self, right: Self) -> Bool\n}\npub trait Shl {\n  fn shl(self, right: Self) -> Self\n}\npub trait Shr {\n  fn shr(self, right: Self) -> Self\n}\npub trait Mul {\n  fn mul(self, right: Self) -> Self\n}\npub trait Div {\n  fn div(self, right: Self) -> Self\n}\npub trait Rem {\n  fn rem(self, right: Self) -> Self\n}\npub trait Into<t> {\n  fn into(self) -> t\n}\n\npub trait IndexedGet<index, value> {\n  fn indexed_get(self, index: index) -> value\n}\n\npub trait IndexedSet<index, value> {\n  fn indexed_set(self, index: index, value: value) -> Unit\n}\n\npub trait Hash {\n  fn hash(self) -> U64\n  fn hash_eq(self, right: Self) -> Bool\n}\n"
}

///|
pub fn standard_debug_preamble_source() -> Bytes {
  b"pub trait Debug {\n  fn debug(self) -> Unit\n}\n\nbuiltin __dew_debug_write(fd: U32, value: Bytes) -> U32 = \"dew_wasi_fd_write\"\nbuiltin __dew_debug_ignore(value: U32) -> Unit = \"dew_debug_ignore\"\nbuiltin __dew_debug_i8(value: I8) -> U32 = \"dew_debug_i8\"\nbuiltin __dew_debug_i16(value: I16) -> U32 = \"dew_debug_i16\"\nbuiltin __dew_debug_i32(value: I32) -> U32 = \"dew_debug_i32\"\nbuiltin __dew_debug_i64(value: I64) -> U32 = \"dew_debug_i64\"\nbuiltin __dew_debug_u8(value: U8) -> U32 = \"dew_debug_u8\"\nbuiltin __dew_debug_u16(value: U16) -> U32 = \"dew_debug_u16\"\nbuiltin __dew_debug_u32(value: U32) -> U32 = \"dew_debug_u32\"\nbuiltin __dew_debug_u64(value: U64) -> U32 = \"dew_debug_u64\"\nbuiltin __dew_debug_f32(value: F32) -> U32 = \"dew_debug_f32\"\nbuiltin __dew_debug_f64(value: F64) -> U32 = \"dew_debug_f64\"\nbuiltin __dew_debug_string(value: String) -> U32 = \"dew_debug_string\"\nbuiltin __dew_debug_bytes(value: Bytes) -> U32 = \"dew_debug_bytes\"\nbuiltin __dew_debug_v128(value: V128) -> U32 = \"dew_debug_v128\"\npub builtin debug<t: Debug>(value: t) -> Unit = \"dew_debug_dispatch\"\n\nimpl Debug for Unit {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_write(1u32, b\"()\"))\n  }\n}\n\nimpl Debug for Bool {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(if self {\n      __dew_debug_write(1u32, b\"true\")\n    } else {\n      __dew_debug_write(1u32, b\"false\")\n    })\n  }\n}\n\nimpl Debug for I8 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i8(self))\n  }\n}\n\nimpl Debug for I16 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i16(self))\n  }\n}\n\nimpl Debug for I32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i32(self))\n  }\n}\n\nimpl Debug for I64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_i64(self))\n  }\n}\n\nimpl Debug for U8 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u8(self))\n  }\n}\n\nimpl Debug for U16 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u16(self))\n  }\n}\n\nimpl Debug for U32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u32(self))\n  }\n}\n\nimpl Debug for U64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_u64(self))\n  }\n}\n\nimpl Debug for F32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_f32(self))\n  }\n}\n\nimpl Debug for F64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_f64(self))\n  }\n}\n\nimpl Debug for String {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_string(self))\n  }\n}\n\nimpl Debug for Bytes {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_bytes(self))\n  }\n}\n\nimpl Debug for Swar32 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_write(1u32, b\"Swar32(\"))\n    debug(swar32_to_bits(self))\n    __dew_debug_ignore(__dew_debug_write(1u32, b\")\"))\n  }\n}\n\nimpl Debug for Swar64 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_write(1u32, b\"Swar64(\"))\n    debug(swar64_to_bits(self))\n    __dew_debug_ignore(__dew_debug_write(1u32, b\")\"))\n  }\n}\n\nimpl Debug for V128 {\n  fn debug(self) -> Unit {\n    __dew_debug_ignore(__dew_debug_v128(self))\n  }\n}\n"
}

///|
pub fn standard_preamble_i32_source() -> Bytes {
  b"impl Add for I32 {\n  fn add(self, right: I32) -> I32 {\n    i32_add(self, right)\n  }\n}\nimpl Sub for I32 {\n  fn sub(self, right: I32) -> I32 {\n    i32_sub(self, right)\n  }\n}\nimpl Lte for I32 {\n  fn lte(self, right: I32) -> Bool {\n    i32_lte(self, right)\n  }\n}\n"
}

///|
pub fn standard_preamble_packed_source() -> Bytes {
  b"// Unsafe: preserves bits only between equal non-reference Wasm carriers.\npub builtin unsafe_bitcast<source, target>(value: source) -> target = \"unsafe.bitcast\"\n\nimpl Swar32 {\n  fn from_bits(value: U32) -> Swar32 {\n    swar32_from_bits(value)\n  }\n  fn to_bits(self) -> U32 {\n    swar32_to_bits(self)\n  }\n}\nimpl BitAnd for Swar32 {\n  fn bit_and(self, right: Swar32) -> Swar32 {\n    swar32_and(self, right)\n  }\n}\nimpl BitOr for Swar32 {\n  fn bit_or(self, right: Swar32) -> Swar32 {\n    swar32_or(self, right)\n  }\n}\nimpl BitXor for Swar32 {\n  fn bit_xor(self, right: Swar32) -> Swar32 {\n    swar32_xor(self, right)\n  }\n}\nimpl Swar64 {\n  fn from_bits(value: U64) -> Swar64 {\n    swar64_from_bits(value)\n  }\n  fn to_bits(self) -> U64 {\n    swar64_to_bits(self)\n  }\n}\nimpl BitAnd for Swar64 {\n  fn bit_and(self, right: Swar64) -> Swar64 {\n    swar64_and(self, right)\n  }\n}\nimpl BitOr for Swar64 {\n  fn bit_or(self, right: Swar64) -> Swar64 {\n    swar64_or(self, right)\n  }\n}\nimpl BitXor for Swar64 {\n  fn bit_xor(self, right: Swar64) -> Swar64 {\n    swar64_xor(self, right)\n  }\n}\nimpl BitAnd for V128 {\n  fn bit_and(self, right: V128) -> V128 {\n    v128_and(self, right)\n  }\n}\nimpl BitOr for V128 {\n  fn bit_or(self, right: V128) -> V128 {\n    v128_or(self, right)\n  }\n}\nimpl BitXor for V128 {\n  fn bit_xor(self, right: V128) -> V128 {\n    v128_xor(self, right)\n  }\n}\n"
}

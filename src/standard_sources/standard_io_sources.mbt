///|
pub fn standard_io_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.bytes\nopen dew.std.bytes_builder\n\npub enum IoError {\n  UnexpectedEnd\n  ZeroProgress\n  InvalidProgress\n  Closed\n  LimitExceeded\n  Backend(U32)\n}\n\npub trait Reader {\n  fn read(self, limit: U32) -> Result<Bytes, IoError>\n}\n\npub trait Writer {\n  fn write(self, value: Bytes) -> Result<U32, IoError>\n}\n\npub fn io_read<r: Reader>(\n  reader: r,\n  limit: U32,\n) -> Result<Bytes, IoError> {\n  reader.read(limit)\n}\n\npub fn io_write<w: Writer>(\n  writer: w,\n  value: Bytes,\n) -> Result<U32, IoError> {\n  writer.write(value)\n}\n\npub fn io_read_exact<r: Reader>(\n  reader: r,\n  length: U32,\n) -> Result<Bytes, IoError> {\n  let builder = BytesBuilder::with_capacity(length)\n  while 0u32 {\n    total if total < length => {\n      match reader.read(length - total) {\n        Result::Ok(chunk) => {\n          let count = chunk.byte_length()\n          if count == 0u32 {\n            break Result::Err(IoError::UnexpectedEnd)\n          } else if count > length - total {\n            break Result::Err(IoError::InvalidProgress)\n          } else {\n            builder.append(chunk)\n            continue total + count\n          }\n        }\n        Result::Err(error) => break Result::Err(error)\n      }\n    }\n    _ => break Result::Ok(builder.finish())\n  }\n}\n\npub fn io_write_all<w: Writer>(\n  writer: w,\n  value: Bytes,\n) -> Result<U32, IoError> {\n  let length = value.byte_length()\n  while 0u32 {\n    total if total < length => {\n      let remaining = value.view(total, length - total)\n      match writer.write(remaining) {\n        Result::Ok(written) => {\n          if written == 0u32 {\n            break Result::Err(IoError::ZeroProgress)\n          } else if written > length - total {\n            break Result::Err(IoError::InvalidProgress)\n          } else {\n            continue total + written\n          }\n        }\n        Result::Err(error) => break Result::Err(error)\n      }\n    }\n    _ => break Result::Ok(length)\n  }\n}\n\npub fn io_read_to_end<r: Reader>(\n  reader: r,\n  chunk_limit: U32,\n  max_bytes: U32,\n) -> Result<Bytes, IoError> {\n  if chunk_limit == 0u32 {\n    Result::Err(IoError::ZeroProgress)\n  } else {\n    let builder = BytesBuilder::new()\n    while 0u32 {\n      total => {\n        match reader.read(chunk_limit) {\n          Result::Ok(chunk) => {\n            let count = chunk.byte_length()\n            if count == 0u32 {\n              break Result::Ok(builder.finish())\n            } else if count > chunk_limit {\n              break Result::Err(IoError::InvalidProgress)\n            } else if total > max_bytes || count > max_bytes - total {\n              break Result::Err(IoError::LimitExceeded)\n            } else {\n              builder.append(chunk)\n              continue total + count\n            }\n          }\n          Result::Err(error) => break Result::Err(error)\n        }\n      }\n    }\n  }\n}\n\npub fn io_copy<r: Reader, w: Writer>(\n  reader: r,\n  writer: w,\n  chunk_limit: U32,\n) -> Result<U32, IoError> {\n  if chunk_limit == 0u32 {\n    Result::Err(IoError::ZeroProgress)\n  } else {\n    while 0u32 {\n      total => {\n        match reader.read(chunk_limit) {\n          Result::Ok(chunk) => {\n            let count = chunk.byte_length()\n            if count == 0u32 {\n              break Result::Ok(total)\n            } else if count > chunk_limit {\n              break Result::Err(IoError::InvalidProgress)\n            } else if count > 4294967295u32 - total {\n              break Result::Err(IoError::LimitExceeded)\n            } else {\n              match io_write_all(writer, chunk) {\n                Result::Ok(written) => {\n                  if written == count {\n                    continue total + count\n                  } else {\n                    break Result::Err(IoError::InvalidProgress)\n                  }\n                }\n                Result::Err(error) => break Result::Err(error)\n              }\n            }\n          }\n          Result::Err(error) => break Result::Err(error)\n        }\n      }\n    }\n  }\n}\n\npub struct BytesInput {\n  value: Bytes\n  offset: FixedArray<U32>\n}\n\nimpl BytesInput {\n  fn new(value: Bytes) -> BytesInput {\n    BytesInput::{\n      value: value\n      offset: FixedArray::make(1u32, 0u32)\n    }\n  }\n  fn remaining(self) -> U32 {\n    let offset = self.offset.get_unchecked(0u32)\n    let length = self.value.byte_length()\n    if offset > length {\n      0u32\n    } else {\n      length - offset\n    }\n  }\n  fn is_empty(self) -> Bool {\n    self.remaining() == 0u32\n  }\n}\n\nimpl Reader for BytesInput {\n  fn read(self, limit: U32) -> Result<Bytes, IoError> {\n    let offset = self.offset.get_unchecked(0u32)\n    let length = self.value.byte_length()\n    if offset > length {\n      Result::Err(IoError::InvalidProgress)\n    } else if limit == 0u32 || offset == length {\n      Result::Ok(b\"\")\n    } else {\n      let available = length - offset\n      let count = if limit < available {\n        limit\n      } else {\n        available\n      }\n      self.offset.set_unchecked(0u32, offset + count)\n      Result::Ok(self.value.view(offset, count))\n    }\n  }\n}\n\npub struct BytesOutput {\n  builder: BytesBuilder\n  state: FixedArray<U32>\n}\n\nimpl BytesOutput {\n  fn new() -> BytesOutput {\n    BytesOutput::with_capacity(0u32)\n  }\n  fn with_capacity(capacity: U32) -> BytesOutput {\n    BytesOutput::{\n      builder: BytesBuilder::with_capacity(capacity)\n      state: FixedArray::make(2u32, 0u32)\n    }\n  }\n  fn byte_length(self) -> U32 {\n    self.state.get_unchecked(1u32)\n  }\n  fn is_closed(self) -> Bool {\n    self.state.get_unchecked(0u32) != 0u32\n  }\n  fn finish(self) -> Result<Bytes, IoError> {\n    if self.is_closed() {\n      Result::Err(IoError::Closed)\n    } else {\n      self.state.set_unchecked(0u32, 1u32)\n      Result::Ok(self.builder.finish())\n    }\n  }\n}\n\nimpl Writer for BytesOutput {\n  fn write(self, value: Bytes) -> Result<U32, IoError> {\n    if self.is_closed() {\n      Result::Err(IoError::Closed)\n    } else {\n      let added = value.byte_length()\n      let length = self.byte_length()\n      if added > 4294967295u32 - length {\n        Result::Err(IoError::LimitExceeded)\n      } else {\n        self.builder.append(value)\n        self.state.set_unchecked(1u32, length + added)\n        Result::Ok(added)\n      }\n    }\n  }\n}\n\n// State slots: chunk offset, EOF, backend reads, record bytes copied.\npub struct BufferedReader<r> {\n  reader: r\n  chunk_limit: U32\n  max_buffer: U32\n  chunk: FixedArray<Bytes>\n  state: FixedArray<U32>\n}\n\npub fn buffered_reader_new<r: Reader>(\n  reader: r,\n  chunk_limit: U32,\n  max_buffer: U32,\n) -> BufferedReader<r> {\n  BufferedReader::{\n    reader: reader\n    chunk_limit: chunk_limit\n    max_buffer: max_buffer\n    chunk: FixedArray::make(1u32, b\"\")\n    state: FixedArray::make(4u32, 0u32)\n  }\n}\n\nimpl<r: Reader> BufferedReader<r> {\n  fn read_count(self) -> U32 {\n    self.state.get_unchecked(2u32)\n  }\n  fn copied_bytes(self) -> U32 {\n    self.state.get_unchecked(3u32)\n  }\n  fn buffered_bytes(self) -> U32 {\n    self.chunk.get_unchecked(0u32).byte_length() - self.state.get_unchecked(0u32)\n  }\n  fn consume(self, offset: U32) -> Unit {\n    if offset == self.chunk.get_unchecked(0u32).byte_length() {\n      self.chunk.set_unchecked(0u32, b\"\")\n      self.state.set_unchecked(0u32, 0u32)\n    } else {\n      self.state.set_unchecked(0u32, offset)\n    }\n  }\n  fn read_until(self, delimiter: Bytes, max_bytes: U32) -> Result<Option<Bytes>, IoError> {\n    let delimiter_length = delimiter.byte_length()\n    if self.chunk_limit == 0u32 || delimiter_length == 0u32 {\n      Result::Err(IoError::ZeroProgress)\n    } else if max_bytes == 0u32 || self.max_buffer == 0u32 || delimiter_length > max_bytes || delimiter_length > self.max_buffer {\n      Result::Err(IoError::LimitExceeded)\n    } else {\n      let prefix = io_delimiter_prefix(delimiter)\n      let builder = BytesBuilder::new()\n      while 0u32 {\n        matched => {\n          let total = builder.byte_length()\n          let chunk = self.chunk.get_unchecked(0u32)\n          let offset = self.state.get_unchecked(0u32)\n          if offset < chunk.byte_length() {\n            if total >= max_bytes {\n              break Result::Err(IoError::LimitExceeded)\n            } else {\n              let byte = chunk.byte_at(offset)\n              let next = while matched {\n                candidate => {\n                  if candidate > 0u32 && delimiter.byte_at(candidate) != byte {\n                    continue prefix.get_unchecked(candidate - 1u32)\n                  } else if delimiter.byte_at(candidate) == byte {\n                    break candidate + 1u32\n                  } else {\n                    break 0u32\n                  }\n                }\n              }\n              builder.append_byte(byte)\n              self.state.set_unchecked(3u32, self.copied_bytes() + 1u32)\n              self.consume(offset + 1u32)\n              if next == delimiter_length {\n                break Result::Ok(Option::Some(builder.finish()))\n              } else {\n                continue next\n              }\n            }\n          } else if self.state.get_unchecked(1u32) != 0u32 {\n            if total == 0u32 {\n              break Result::Ok(Option::None)\n            } else {\n              break Result::Ok(Option::Some(builder.finish()))\n            }\n          } else if total >= self.max_buffer {\n            break Result::Err(IoError::LimitExceeded)\n          } else {\n            let budget = self.max_buffer - total\n            let limit = if self.chunk_limit < budget {\n              self.chunk_limit\n            } else {\n              budget\n            }\n            self.state.set_unchecked(2u32, self.read_count() + 1u32)\n            match self.reader.read(limit) {\n              Result::Err(error) => break Result::Err(error)\n              Result::Ok(next) => {\n                if next.byte_length() > limit {\n                  break Result::Err(IoError::InvalidProgress)\n                } else {\n                  self.chunk.set_unchecked(0u32, next)\n                  self.state.set_unchecked(0u32, 0u32)\n                  if next.byte_length() == 0u32 {\n                    self.state.set_unchecked(1u32, 1u32)\n                  }\n                  continue matched\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  fn read_line(self, max_bytes: U32) -> Result<Option<Bytes>, IoError> {\n    match self.read_until(b\"\\n\", max_bytes) {\n      Result::Ok(Option::Some(value)) => {\n        let length = value.byte_length()\n        if length > 0u32 && value.byte_at(length - 1u32) == 10u8 {\n          Result::Ok(Option::Some(value.view(0u32, length - 1u32)))\n        } else {\n          Result::Ok(Option::Some(value))\n        }\n      }\n      Result::Ok(Option::None) => Result::Ok(Option::None)\n      Result::Err(error) => Result::Err(error)\n    }\n  }\n}\n\nimpl<r: Reader> Reader for BufferedReader<r> {\n  fn read(self, limit: U32) -> Result<Bytes, IoError> {\n    if limit == 0u32 {\n      Result::Ok(b\"\")\n    } else if self.buffered_bytes() > 0u32 {\n      let chunk = self.chunk.get_unchecked(0u32)\n      let offset = self.state.get_unchecked(0u32)\n      let remaining = chunk.byte_length() - offset\n      let count = if limit < remaining {\n        limit\n      } else {\n        remaining\n      }\n      self.consume(offset + count)\n      Result::Ok(chunk.view(offset, count))\n    } else if self.state.get_unchecked(1u32) != 0u32 {\n      Result::Ok(b\"\")\n    } else if self.chunk_limit == 0u32 {\n      Result::Err(IoError::ZeroProgress)\n    } else if self.max_buffer == 0u32 {\n      Result::Err(IoError::LimitExceeded)\n    } else {\n      let requested = if self.chunk_limit < self.max_buffer {\n        self.chunk_limit\n      } else {\n        self.max_buffer\n      }\n      self.state.set_unchecked(2u32, self.read_count() + 1u32)\n      match self.reader.read(requested) {\n        Result::Err(error) => Result::Err(error)\n        Result::Ok(chunk) => {\n          let length = chunk.byte_length()\n          if length > requested {\n            Result::Err(IoError::InvalidProgress)\n          } else {\n            let count = if limit < length {\n              limit\n            } else {\n              length\n            }\n            self.chunk.set_unchecked(0u32, chunk)\n            self.consume(count)\n            if length == 0u32 {\n              self.state.set_unchecked(1u32, 1u32)\n            }\n            Result::Ok(chunk.view(0u32, count))\n          }\n        }\n      }\n    }\n  }\n}\n\n\nfn io_delimiter_prefix(delimiter: Bytes) -> FixedArray<U32> {\n  let prefix = FixedArray::make(delimiter.byte_length(), 0u32)\n  while 1u32 {\n    index if index < delimiter.byte_length() => {\n      let byte = delimiter.byte_at(index)\n      let matched = while prefix.get_unchecked(index - 1u32) {\n        candidate => {\n          if candidate > 0u32 && delimiter.byte_at(candidate) != byte {\n            continue prefix.get_unchecked(candidate - 1u32)\n          } else if delimiter.byte_at(candidate) == byte {\n            break candidate + 1u32\n          } else {\n            break 0u32\n          }\n        }\n      }\n      prefix.set_unchecked(index, matched)\n      continue index + 1u32\n    }\n    _ => break ()\n  }\n  prefix\n}\n"
}

///|
pub fn standard_blake3_source() -> Bytes {
  b"open dew.std.fixed_array\nopen dew.std.array\nopen dew.std.bytes\n\npub fn blake3_unit() -> Unit {\n}\n\npub fn blake3_chunk_start() -> U32 {\n  1u32\n}\n\npub fn blake3_chunk_end() -> U32 {\n  2u32\n}\n\npub fn blake3_parent() -> U32 {\n  4u32\n}\n\npub fn blake3_root() -> U32 {\n  8u32\n}\n\npub fn blake3_iv() -> FixedArray<U32> {\n  let values = FixedArray::make(8u32, 0u32)\n  values.set_unchecked(0u32, 1779033703u32)\n  values.set_unchecked(1u32, 3144134277u32)\n  values.set_unchecked(2u32, 1013904242u32)\n  values.set_unchecked(3u32, 2773480762u32)\n  values.set_unchecked(4u32, 1359893119u32)\n  values.set_unchecked(5u32, 2600822924u32)\n  values.set_unchecked(6u32, 528734635u32)\n  values.set_unchecked(7u32, 1541459225u32)\n  values\n}\n\npub fn blake3_message_permutation() -> FixedArray<U32> {\n  let values = FixedArray::make(16u32, 0u32)\n  values.set_unchecked(0u32, 2u32)\n  values.set_unchecked(1u32, 6u32)\n  values.set_unchecked(2u32, 3u32)\n  values.set_unchecked(3u32, 10u32)\n  values.set_unchecked(4u32, 7u32)\n  values.set_unchecked(5u32, 0u32)\n  values.set_unchecked(6u32, 4u32)\n  values.set_unchecked(7u32, 13u32)\n  values.set_unchecked(8u32, 1u32)\n  values.set_unchecked(9u32, 11u32)\n  values.set_unchecked(10u32, 12u32)\n  values.set_unchecked(11u32, 5u32)\n  values.set_unchecked(12u32, 9u32)\n  values.set_unchecked(13u32, 14u32)\n  values.set_unchecked(14u32, 15u32)\n  values.set_unchecked(15u32, 8u32)\n  values\n}\n\npub struct Blake3Output {\n  input_chaining_value: FixedArray<U32>\n  block_words: FixedArray<U32>\n  counter: U64\n  block_length: U32\n  flags: U32\n}\n\npub fn blake3_rotate_right(value: U32, count: U32) -> U32 {\n  (value >> count) | (value << (32u32 - count))\n}\n\npub fn blake3_mix(\n  state: FixedArray<U32>,\n  a: U32,\n  b: U32,\n  c: U32,\n  d: U32,\n  left: U32,\n  right: U32,\n) -> Unit {\n  state.set_unchecked(a, state.get_unchecked(a) + state.get_unchecked(b) + left)\n  state.set_unchecked(d, blake3_rotate_right(state.get_unchecked(d) ^ state.get_unchecked(a), 16u32))\n  state.set_unchecked(c, state.get_unchecked(c) + state.get_unchecked(d))\n  state.set_unchecked(b, blake3_rotate_right(state.get_unchecked(b) ^ state.get_unchecked(c), 12u32))\n  state.set_unchecked(a, state.get_unchecked(a) + state.get_unchecked(b) + right)\n  state.set_unchecked(d, blake3_rotate_right(state.get_unchecked(d) ^ state.get_unchecked(a), 8u32))\n  state.set_unchecked(c, state.get_unchecked(c) + state.get_unchecked(d))\n  state.set_unchecked(b, blake3_rotate_right(state.get_unchecked(b) ^ state.get_unchecked(c), 7u32))\n}\n\npub fn blake3_round(state: FixedArray<U32>, message: FixedArray<U32>) -> Unit {\n  blake3_mix(state, 0u32, 4u32, 8u32, 12u32, message.get_unchecked(0u32), message.get_unchecked(1u32))\n  blake3_mix(state, 1u32, 5u32, 9u32, 13u32, message.get_unchecked(2u32), message.get_unchecked(3u32))\n  blake3_mix(state, 2u32, 6u32, 10u32, 14u32, message.get_unchecked(4u32), message.get_unchecked(5u32))\n  blake3_mix(state, 3u32, 7u32, 11u32, 15u32, message.get_unchecked(6u32), message.get_unchecked(7u32))\n  blake3_mix(state, 0u32, 5u32, 10u32, 15u32, message.get_unchecked(8u32), message.get_unchecked(9u32))\n  blake3_mix(state, 1u32, 6u32, 11u32, 12u32, message.get_unchecked(10u32), message.get_unchecked(11u32))\n  blake3_mix(state, 2u32, 7u32, 8u32, 13u32, message.get_unchecked(12u32), message.get_unchecked(13u32))\n  blake3_mix(state, 3u32, 4u32, 9u32, 14u32, message.get_unchecked(14u32), message.get_unchecked(15u32))\n}\n\npub fn blake3_permute(message: FixedArray<U32>) -> FixedArray<U32> {\n  let permutation = blake3_message_permutation()\n  let output = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    index if index < 16u32 => {\n      output.set_unchecked(index, message.get_unchecked(permutation.get_unchecked(index)))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn blake3_u64_low(value: U64) -> U32 {\n  value.into()\n}\n\npub fn blake3_compress(output: Blake3Output, root_counter: U64) -> FixedArray<U32> {\n  let state = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    index if index < 8u32 => {\n      state.set_unchecked(index, output.input_chaining_value.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break blake3_unit()\n  }\n  let iv = blake3_iv()\n  while 0u32 {\n    index if index < 4u32 => {\n      state.set_unchecked(8u32 + index, iv.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break blake3_unit()\n  }\n  state.set_unchecked(12u32, blake3_u64_low(root_counter))\n  state.set_unchecked(13u32, blake3_u64_low(root_counter >> 32u64))\n  state.set_unchecked(14u32, output.block_length)\n  state.set_unchecked(15u32, output.flags)\n  let mut message = output.block_words\n  while 0u32 {\n    round if round < 7u32 => {\n      blake3_round(state, message)\n      if round != 6u32 {\n        message = blake3_permute(message)\n      } else {\n      }\n      continue round + 1u32\n    }\n    _ => break blake3_unit()\n  }\n  let result = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    index if index < 8u32 => {\n      result.set_unchecked(index, state.get_unchecked(index) ^ state.get_unchecked(index + 8u32))\n      result.set_unchecked(\n        index + 8u32,\n        state.get_unchecked(index + 8u32) ^ output.input_chaining_value.get_unchecked(index),\n      )\n      continue index + 1u32\n    }\n    _ => break result\n  }\n}\n\npub fn blake3_copy_u32(values: FixedArray<U32>) -> FixedArray<U32> {\n  let output = FixedArray::make(values.length(), 0u32)\n  while 0u32 {\n    index if index < values.length() => {\n      output.set_unchecked(index, values.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n\npub fn blake3_chaining_value(output: Blake3Output) -> FixedArray<U32> {\n  let words = blake3_compress(output, output.counter)\n  let value = FixedArray::make(8u32, 0u32)\n  while 0u32 {\n    index if index < 8u32 => {\n      value.set_unchecked(index, words.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break value\n  }\n}\n\npub fn blake3_u32_to_u8(value: U32) -> U8 {\n  value.into()\n}\n\npub fn blake3_root_digest(output: Blake3Output) -> FixedArray<U8> {\n  let rooted = Blake3Output::{\n    input_chaining_value: output.input_chaining_value\n    block_words: output.block_words\n    counter: output.counter\n    block_length: output.block_length\n    flags: output.flags | blake3_root()\n  }\n  let words = blake3_compress(rooted, 0u64)\n  let digest = FixedArray::make(32u32, 0u8)\n  while 0u32 {\n    index if index < 8u32 => {\n      let word = words.get_unchecked(index)\n      let offset = index * 4u32\n      digest.set_unchecked(offset, blake3_u32_to_u8(word & 255u32))\n      digest.set_unchecked(offset + 1u32, blake3_u32_to_u8((word >> 8u32) & 255u32))\n      digest.set_unchecked(offset + 2u32, blake3_u32_to_u8((word >> 16u32) & 255u32))\n      digest.set_unchecked(offset + 3u32, blake3_u32_to_u8((word >> 24u32) & 255u32))\n      continue index + 1u32\n    }\n    _ => break digest\n  }\n}\n\npub fn blake3_u8_to_u32(value: U8) -> U32 {\n  value.into()\n}\n\npub fn blake3_block_words(input: Bytes, start: U32, length: U32) -> FixedArray<U32> {\n  let words = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    byte_index if byte_index < length => {\n      let word_index = byte_index / 4u32\n      let shift = (byte_index % 4u32) * 8u32\n      let word = words.get_unchecked(word_index) |\n        (blake3_u8_to_u32(input.byte_at(start + byte_index)) << shift)\n      words.set_unchecked(word_index, word)\n      continue byte_index + 1u32\n    }\n    _ => break words\n  }\n}\n\npub fn blake3_chunk_output(\n  input: Bytes,\n  start: U32,\n  length: U32,\n  chunk_counter: U64,\n) -> Blake3Output {\n  let block_count = if length == 0u32 {\n    1u32\n  } else {\n    (length / 64u32) + if length % 64u32 == 0u32 {\n      0u32\n    } else {\n      1u32\n    }\n  }\n  let chaining_value = blake3_iv()\n  let mut final_output = Blake3Output::{\n    input_chaining_value: chaining_value\n    block_words: FixedArray::make(16u32, 0u32)\n    counter: chunk_counter\n    block_length: 0u32\n    flags: blake3_chunk_start() | blake3_chunk_end()\n  }\n  while 0u32 {\n    block_index if block_index < block_count => {\n      let block_start = start + block_index * 64u32\n      let consumed = block_index * 64u32\n      let remaining = length - consumed\n      let block_length = if remaining < 64u32 {\n        remaining\n      } else {\n        64u32\n      }\n      let mut flags = 0u32\n      if block_index == 0u32 {\n        flags = flags | blake3_chunk_start()\n      } else {\n      }\n      if block_index + 1u32 == block_count {\n        flags = flags | blake3_chunk_end()\n      } else {\n      }\n      final_output = Blake3Output::{\n        input_chaining_value: blake3_copy_u32(chaining_value)\n        block_words: blake3_block_words(input, block_start, block_length)\n        counter: chunk_counter\n        block_length: block_length\n        flags: flags\n      }\n      if block_index + 1u32 != block_count {\n        let next = blake3_chaining_value(final_output)\n        while 0u32 {\n          index if index < 8u32 => {\n            chaining_value.set_unchecked(index, next.get_unchecked(index))\n            continue index + 1u32\n          }\n          _ => break blake3_unit()\n        }\n      } else {\n      }\n      continue block_index + 1u32\n    }\n    _ => break final_output\n  }\n}\n\npub fn blake3_parent_output(\n  left: FixedArray<U32>,\n  right: FixedArray<U32>,\n) -> Blake3Output {\n  let block = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    index if index < 8u32 => {\n      block.set_unchecked(index, left.get_unchecked(index))\n      block.set_unchecked(index + 8u32, right.get_unchecked(index))\n      continue index + 1u32\n    }\n    _ => break blake3_unit()\n  }\n  Blake3Output::{\n    input_chaining_value: blake3_iv()\n    block_words: block\n    counter: 0u64\n    block_length: 64u32\n    flags: blake3_parent()\n  }\n}\n\npub fn blake3_u32_to_u64(value: U32) -> U64 {\n  value.into()\n}\n\npub fn blake3_cv_level(capacity: U32) -> Array<FixedArray<U32>> {\n  Array::with_capacity(capacity)\n}\n\npub fn blake3_no_root() -> Option<Blake3Output> {\n  Option::None\n}\n\npub fn blake3(input: Bytes) -> FixedArray<U8> {\n  let input_length = input.byte_length()\n  let chunk_count = if input_length == 0u32 {\n    1u32\n  } else {\n    (input_length / 1024u32) + if input_length % 1024u32 == 0u32 {\n      0u32\n    } else {\n      1u32\n    }\n  }\n  if chunk_count == 1u32 {\n    blake3_root_digest(blake3_chunk_output(input, 0u32, input_length, 0u64))\n  } else {\n    let level = blake3_cv_level(chunk_count)\n    while 0u32 {\n      chunk_index if chunk_index < chunk_count => {\n        let start = chunk_index * 1024u32\n        let remaining = input_length - start\n        let length = if remaining < 1024u32 {\n          remaining\n        } else {\n          1024u32\n        }\n        level.push(\n          blake3_chaining_value(\n            blake3_chunk_output(input, start, length, blake3_u32_to_u64(chunk_index)),\n          ),\n        )\n        continue chunk_index + 1u32\n      }\n      _ => break blake3_unit()\n    }\n    let mut current = level\n    let mut root = blake3_no_root()\n    while current.length() {\n      count if count > 1u32 => {\n        let next = blake3_cv_level((count / 2u32) + (count % 2u32))\n        while 0u32 {\n          index if index < count => {\n            if index + 1u32 == count {\n              next.push(current.get_unchecked(index))\n              continue index + 1u32\n            } else {\n              let parent = blake3_parent_output(\n                current.get_unchecked(index),\n                current.get_unchecked(index + 1u32),\n              )\n              root = Option::Some(parent)\n              next.push(blake3_chaining_value(parent))\n              continue index + 2u32\n            }\n          }\n          _ => break blake3_unit()\n        }\n        current = next\n        continue current.length()\n      }\n      _ => break blake3_unit()\n    }\n    match root {\n      Some(value) => blake3_root_digest(value)\n      None => unreachable()\n    }\n  }\n}\n\npub fn blake3_hash32(input: Bytes) -> U32 {\n  let digest = blake3(input)\n  blake3_u8_to_u32(digest.get_unchecked(0u32)) |\n  (blake3_u8_to_u32(digest.get_unchecked(1u32)) << 8u32) |\n  (blake3_u8_to_u32(digest.get_unchecked(2u32)) << 16u32) |\n  (blake3_u8_to_u32(digest.get_unchecked(3u32)) << 24u32)\n}\n"
}

///|
fn vector_test_equal(actual : Value, expected : Value) -> Bool raise EvalError {
  match (actual, expected) {
    (Vector(al, ah), Vector(bl, bh)) => al == bl && ah == bh
    (Floating(a, _), Floating(b, _)) => a == b
    _ => raw_bits(actual) == raw_bits(expected)
  }
}

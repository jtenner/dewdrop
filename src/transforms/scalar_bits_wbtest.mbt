///|
test "integer bit instructions match Wasm widths and counts" {
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.clz", [Number(0UL, "I32")])), 32UL, msg="i32.clz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.clz", [Number(1UL, "I32")])), 31UL, msg="i32.clz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.clz", [Number(4294967295UL, "I32")])), 0UL, msg="i32.clz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.clz", [Number(0UL, "I64")])), 64UL, msg="i64.clz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.clz", [Number(1UL, "I64")])), 63UL, msg="i64.clz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.ctz", [Number(0UL, "I32")])), 32UL, msg="i32.ctz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.ctz", [Number(2147483648UL, "I32")])), 31UL, msg="i32.ctz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.ctz", [Number(0UL, "I64")])), 64UL, msg="i64.ctz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.ctz", [Number(9223372036854775808UL, "I64")])), 63UL, msg="i64.ctz")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.popcnt", [Number(4294967295UL, "I32")])), 32UL, msg="i32.popcnt")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.popcnt", [Number(18446744073709551615UL, "I64")])), 64UL, msg="i64.popcnt")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.popcnt", [Number(0UL, "I64")])), 0UL, msg="i64.popcnt")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.rotl", [Number(305419896UL, "I32"), Number(36UL, "I32")])), 591751041UL, msg="i32.rotl")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.rotr", [Number(305419896UL, "I32"), Number(36UL, "I32")])), 2166572391UL, msg="i32.rotr")
  assert_eq(raw_bits(scalar_bit_intrinsic("i32.rotl", [Number(305419896UL, "I32"), Number(32UL, "I32")])), 305419896UL, msg="i32.rotl")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.rotl", [Number(1311768467139281697UL, "I64"), Number(68UL, "I64")])), 2541551400518955537UL, msg="i64.rotl")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.rotr", [Number(1311768467139281697UL, "I64"), Number(68UL, "I64")])), 1234907033803052082UL, msg="i64.rotr")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.rotr", [Number(1311768467139281697UL, "I64"), Number(64UL, "I64")])), 1311768467139281697UL, msg="i64.rotr")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.extend8_s", [Number(128UL, "I64")])), 18446744073709551488UL, msg="i64.extend8_s")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.extend16_s", [Number(32768UL, "I64")])), 18446744073709518848UL, msg="i64.extend16_s")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.extend32_s", [Number(2147483648UL, "I64")])), 18446744071562067968UL, msg="i64.extend32_s")
  assert_eq(raw_bits(scalar_bit_intrinsic("i64.extend8_s", [Number(18446744073709486207UL, "I64")])), 127UL, msg="i64.extend8_s")
}

///|
pub fn ast_source() -> Bytes {
  b"open dew.std.array\nopen dew.std.option\nopen dew.std.wasm.intrinsics\n\npub enum ExprNode {\n  Source(String)\n  Quote(Array<String>, Array<ExprNode>)\n  Unit\n  Integer(I32)\n  Integer64(I64)\n  Unsigned64(U64)\n  Boolean(Bool)\n  Text(String)\n  Bytes(Bytes)\n  Name(String)\n  Path(String)\n  Field(ExprNode, String)\n  Index(ExprNode, ExprNode)\n  MethodCall(ExprNode, String, Array<ExprNode>)\n  Prefix(String, ExprNode)\n  Tuple(Array<ExprNode>)\n  Array(Array<ExprNode>)\n  MutableBind(String, ExprNode)\n  Assign(ExprNode, ExprNode)\n  Call(ExprNode, Array<ExprNode>)\n  Binary(String, ExprNode, ExprNode)\n  Block(Array<ExprNode>)\n  Bind(String, ExprNode)\n  Return(ExprNode)\n  If(ExprNode, ExprNode, ExprNode)\n}\n\npub struct FnNode {\n  name: String\n  body: ExprNode\n  signature: SignatureNode\n  call_adapter: Option<ExprNode>\n}\n\npub fn with_body(node: FnNode, body: ExprNode) -> FnNode {\n  FnNode::{\n    name: node.name\n    body: body\n    signature: node.signature\n    call_adapter: node.call_adapter\n  }\n}\n\npub fn integer(value: I32) -> ExprNode {\n  ExprNode::Integer(value)\n}\n\npub fn bytes(value: Bytes) -> ExprNode {\n  ExprNode::Bytes(value)\n}\n\npub fn source(value: String) -> ExprNode {\n  ExprNode::Source(value)\n}\n\npub fn call(callee: ExprNode, arguments: Array<ExprNode>) -> ExprNode {\n  ExprNode::Call(callee, arguments)\n}\n\nimpl FnNode {\n  fn with_body(self, body: ExprNode) -> FnNode {\n    FnNode::{\n      name: self.name\n      body: body\n      signature: self.signature\n      call_adapter: self.call_adapter\n    }\n  }\n}\n\nimpl FnNode {\n  fn prepend(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Block([expression, self.body]))\n  }\n  fn append(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Block([self.body, expression]))\n  }\n  fn wrap(self, callee: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Call(callee, [self.body]))\n  }\n  fn returning(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Return(expression))\n  }\n}\n\nimpl ExprNode {\n  fn call(self, arguments: Array<ExprNode>) -> ExprNode {\n    ExprNode::Call(self, arguments)\n  }\n  fn binary(self, operator: String, right: ExprNode) -> ExprNode {\n    ExprNode::Binary(operator, self, right)\n  }\n  fn field(self, name: String) -> ExprNode {\n    ExprNode::Field(self, name)\n  }\n  fn index(self, index: ExprNode) -> ExprNode {\n    ExprNode::Index(self, index)\n  }\n  fn method_call(self, name: String, arguments: Array<ExprNode>) -> ExprNode {\n    ExprNode::MethodCall(self, name, arguments)\n  }\n  fn returned(self) -> ExprNode {\n    ExprNode::Return(self)\n  }\n  fn bind(self, name: String) -> ExprNode {\n    ExprNode::Bind(name, self)\n  }\n  fn bind_mut(self, name: String) -> ExprNode {\n    ExprNode::MutableBind(name, self)\n  }\n  fn assign(self, value: ExprNode) -> ExprNode {\n    ExprNode::Assign(self, value)\n  }\n}\n\npub fn unit() -> ExprNode {\n  ExprNode::Unit\n}\n\npub fn integer64(value: I64) -> ExprNode {\n  ExprNode::Integer64(value)\n}\n\npub fn unsigned64(value: U64) -> ExprNode {\n  ExprNode::Unsigned64(value)\n}\n\npub fn text(value: String) -> ExprNode {\n  ExprNode::Text(value)\n}\n\npub fn boolean(value: Bool) -> ExprNode {\n  ExprNode::Boolean(value)\n}\n\npub fn name(value: String) -> ExprNode {\n  ExprNode::Name(value)\n}\n\npub fn path(value: String) -> ExprNode {\n  ExprNode::Path(value)\n}\n\npub fn array(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Array(values)\n}\n\npub fn tuple(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Tuple(values)\n}\n\npub fn block(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Block(values)\n}\n\npub fn prefix(operator: String, value: ExprNode) -> ExprNode {\n  ExprNode::Prefix(operator, value)\n}\n\n// Structured source types. Computed types retain their original expression.\npub struct TypeNode {\n  kind: String\n  name: String\n  arguments: Array<TypeNode>\n}\n\npub struct ParameterNode {\n  name: String\n  type_: TypeNode\n}\n\npub struct TypeParameterNode {\n  name: String\n  bounds: Array<TypeNode>\n}\n\npub fn named_type(name: String) -> TypeNode {\n  TypeNode::{\n    kind: \"named\"\n    name: name\n    arguments: []\n  }\n}\n\n// The compiler supplies storage through this ordinary library constructor.\npub fn syntax_array<t>(values: WasmArray<t>, count: U32) -> Array<t> {\n  Array::{\n    backing: values\n    count: count\n    limit: count\n  }\n}\n\npub enum DeclarationNode {\n  Function(String)\n  Type(String)\n  Implementation(String)\n}\n\npub struct ImportNode {\n  module_path: String\n  alias: String\n}\n\n// Splices are expressions. Quote-local $names are fresh within this quote.\npub fn quote(parts: Array<String>, splices: Array<ExprNode>) -> ExprNode {\n  ExprNode::Quote(parts, splices)\n}\n\n// Original parsed syntax. Children retain source order. Offsets are UTF-8 bytes.\npub struct SyntaxNode {\n  kind: String\n  label: String\n  offset: U32\n  children: Array<SyntaxNode>\n  types: Array<TypeNode>\n}\n\n// Checked original-body expression types. Offsets are UTF-8 source bytes.\npub struct ExpressionTypeNode {\n  offset: U32\n  kind: String\n  type_: TypeNode\n}\n\n// A changed signature is checked with the generated body after expansion.\npub struct SignatureNode {\n  parameters: Array<ParameterNode>\n  return_type: TypeNode\n}\n\npub fn parameter(name: String, type_: TypeNode) -> ParameterNode {\n  ParameterNode::{\n    name: name\n    type_: type_\n  }\n}\n\npub fn qualified_type(name: String) -> TypeNode {\n  TypeNode::{\n    kind: \"qualified\"\n    name: name\n    arguments: []\n  }\n}\n\npub fn tuple_type(fields: Array<TypeNode>) -> TypeNode {\n  TypeNode::{\n    kind: \"tuple\"\n    name: \"\"\n    arguments: fields\n  }\n}\n\npub fn applied_type(base: TypeNode, arguments: Array<TypeNode>) -> TypeNode {\n  let values = [base]\n  for argument in arguments {\n    values.push(argument)\n  }\n  TypeNode::{\n    kind: \"applied\"\n    name: \"\"\n    arguments: values\n  }\n}\n\npub fn function_type(parameters: Array<TypeNode>, result: TypeNode) -> TypeNode {\n  let values = array_new::<TypeNode>()\n  for parameter in parameters {\n    values.push(parameter)\n  }\n  values.push(result)\n  TypeNode::{\n    kind: \"function\"\n    name: \"\"\n    arguments: values\n  }\n}\n\nimpl ParameterNode {\n  fn with_type(self, type_: TypeNode) -> ParameterNode {\n    parameter(self.name, type_)\n  }\n  fn renamed(self, name: String) -> ParameterNode {\n    parameter(name, self.type_)\n  }\n}\n\nimpl TypeNode {\n  fn applied(self, arguments: Array<TypeNode>) -> TypeNode {\n    applied_type(self, arguments)\n  }\n}\n\nimpl FnNode {\n  fn with_signature(self, parameters: Array<ParameterNode>, result: TypeNode) -> FnNode {\n    FnNode::{\n      name: self.name\n      body: self.body\n      signature: SignatureNode::{\n        parameters: parameters\n        return_type: result\n      }\n      call_adapter: self.call_adapter\n    }\n  }\n  fn with_parameters(self, parameters: Array<ParameterNode>) -> FnNode {\n    self.with_signature(parameters, self.signature.return_type)\n  }\n  fn with_return_type(self, result: TypeNode) -> FnNode {\n    self.with_signature(self.signature.parameters, result)\n  }\n  // This body has the old parameters and result. Calls in it use the new function.\n  fn repair_calls_with(self, body: ExprNode) -> FnNode {\n    FnNode::{\n      name: self.name\n      body: self.body\n      signature: self.signature\n      call_adapter: Some(body)\n    }\n  }\n}\n"
}

///|
pub fn transform_source() -> Bytes {
  b"import dewdrop.ast as @ast\nopen dew.std.array\nopen dew.std.option\nopen dew.std.preamble\nopen dew.std.string\n\npub struct SourceLocation {\n  file_name: String\n  line_no: U32\n  col_no: U32\n}\n\npub struct TransformContext {\n  location: SourceLocation\n  fn_name: String\n  module_name: String\n  syntax: @ast.SyntaxNode\n  expression_types: Array<@ast.ExpressionTypeNode>\n  type_errors: Array<String>\n  arguments: Array<@ast.SyntaxNode>\n  arguments_source: String\n  parameters: Array<@ast.ParameterNode>\n  type_parameters: Array<@ast.TypeParameterNode>\n  return_type: @ast.TypeNode\n  parameters_source: String\n  return_type_source: String\n  fresh_name: String\n  declarations: Array<@ast.DeclarationNode>\n  imports: Array<@ast.ImportNode>\n}\n\npub struct TransformError {\n  message: String\n}\n\npub fn error(message: String) -> TransformError {\n  TransformError::{\n    message: message\n  }\n}\n\nimpl TransformContext {\n  fn add_function(self, source: String) -> Unit {\n    self.declarations.push(@ast.DeclarationNode::Function(source))\n  }\n  fn add_type(self, source: String) -> Unit {\n    self.declarations.push(@ast.DeclarationNode::Type(source))\n  }\n  fn add_implementation(self, source: String) -> Unit {\n    self.declarations.push(@ast.DeclarationNode::Implementation(source))\n  }\n  fn import_module(self, module_path: String, alias: String) -> Unit {\n    self.imports.push(@ast.ImportNode::{\n      module_path: module_path\n      alias: alias\n    })\n  }\n}\n\nimpl TransformContext {\n  fn type_of(self, node: @ast.SyntaxNode) -> Option<@ast.TypeNode> {\n    let kind = if node.kind == \"type_call\" {\n      \"call\"\n    } else if node.kind == \"is\" {\n      \"match\"\n    } else {\n      node.kind\n    }\n    let start = while (0u32, self.expression_types.length()) {\n      (low, high) if low < high => {\n        let middle = low + (high - low) / 2u32\n        if self.expression_types[middle].offset < node.offset {\n          continue (middle + 1u32, high)\n        } else {\n          continue (low, middle)\n        }\n      }\n      (low, _) => break low\n    }\n    let _ = while start {\n      index if index < self.expression_types.length() => {\n        let value = self.expression_types[index]\n        if value.offset != node.offset {\n          return None\n        }\n        if value.kind == kind {\n          return Some(value.type_)\n        }\n        continue index + 1u32\n      }\n      _ => break ()\n    }\n    None\n  }\n}\n"
}

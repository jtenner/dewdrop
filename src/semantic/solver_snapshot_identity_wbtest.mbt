///|
test "snapshot identity does not depend on arena lengths" {
  let (_, resolved) = unification_test_types()
  let solver = LocalTypeSolver::new(resolved)
  let outer = solver.snapshot()
  let inner = solver.snapshot()
  assert_true(outer != inner)
  solver.commit(inner)
  solver.rollback(outer)
  let next = solver.snapshot()
  assert_true(next != outer)
  solver.commit(next)
  solver.reset()
  let after_reset = solver.snapshot()
  assert_true(after_reset != outer)
  solver.rollback(after_reset)
}

///|
test "nested committed mutations roll back to exact solver contents" {
  let (_, resolved) = unification_test_types()
  let solver = LocalTypeSolver::new(resolved)
  let a = solver.fresh_variable()
  let b = solver.fresh_variable()
  let scalar = solver.resolved_type(resolved.primitive(I32Type))
  let parents = solver.variable_parents.copy()
  let sizes = solver.variable_sizes.copy()
  let bindings = solver.variable_bindings.copy()
  let variable_types = solver.variable_types.copy()
  let types = solver.types.copy()
  let arguments = solver.type_arguments.copy()
  let diagnostics = solver.diagnostics.copy()
  let outer = solver.snapshot()
  assert_true(solver.unify(a, b, synthetic_type_origin(0, 1UL)))
  let inner = solver.snapshot()
  assert_true(solver.unify(b, scalar, synthetic_type_origin(0, 1UL)))
  ignore(solver.product_type([solver.fresh_variable(), a]))
  solver.commit(inner)
  solver.rollback(outer)
  assert_eq(solver.variable_parents, parents)
  assert_eq(solver.variable_sizes, sizes)
  assert_eq(solver.variable_bindings, bindings)
  assert_eq(solver.variable_types, variable_types)
  assert_eq(solver.types, types)
  assert_eq(solver.type_arguments, arguments)
  assert_eq(solver.diagnostics, diagnostics)
  assert_eq(solver.snapshots.length(), 0)
  assert_eq(solver.undo_kinds.length(), 0)
  assert_eq(solver.undo_indices.length(), 0)
  assert_eq(solver.undo_values.length(), 0)
}

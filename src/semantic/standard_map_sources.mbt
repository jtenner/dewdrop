///|
fn standard_map_source() -> Bytes {
  b"pub struct Map<key, value> {}\n\nbuiltin map_singleton<key, value>(key: key, value: value) -> Map<key, value> = \"dew_map_singleton\"\nbuiltin map_length<key, value>(map: Map<key, value>) -> U32 = \"dew_map_length\"\nbuiltin map_get<key, value>(map: Map<key, value>, key: key) -> Option<value> = \"dew_map_get\"\nbuiltin map_get_unchecked<key, value>(map: Map<key, value>, key: key) -> value = \"dew_map_get_unchecked\"\nbuiltin map_insert<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = \"dew_map_insert\"\nbuiltin map_set<key, value>(map: Map<key, value>, key: key, value: value) -> Unit = \"dew_map_set\"\nbuiltin map_contains_key<key, value>(map: Map<key, value>, key: key) -> Bool = \"dew_map_contains_key\"\n\nimpl<key, value> Map<key, value> {\n  fn singleton(key: key, value: value) -> Map<key, value> {\n    map_singleton(key, value)\n  }\n  fn length(self) -> U32 {\n    map_length(self)\n  }\n  fn get(self, key: key) -> Option<value> {\n    map_get(self, key)\n  }\n  fn get_unchecked(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n  fn insert(self, key: key, value: value) -> Unit {\n    map_insert(self, key, value)\n  }\n  fn set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n  fn contains_key(self, key: key) -> Bool {\n    map_contains_key(self, key)\n  }\n  fn empty() -> Map<key, value> {\n    map_empty()\n  }\n  fn remove(self, key: key) -> Bool {\n    map_remove(self, key)\n  }\n  fn clear(self) -> Unit {\n    map_clear(self)\n  }\n}\n\nimpl<key, value> Index<key, value> for Map<key, value> {\n  fn index(self, key: key) -> value {\n    map_get_unchecked(self, key)\n  }\n}\n\nimpl<key, value> IndexSet<key, value> for Map<key, value> {\n  fn index_set(self, key: key, value: value) -> Unit {\n    map_set(self, key, value)\n  }\n}\n\nbuiltin map_empty<key, value>() -> Map<key, value> = \"dew_map_empty\"\nbuiltin map_remove<key, value>(map: Map<key, value>, key: key) -> Bool = \"dew_map_remove\"\nbuiltin map_clear<key, value>(map: Map<key, value>) -> Unit = \"dew_map_clear\"\n"
}

import {
  "jtenner/dewdrop/semantic",
  "jtenner/dewdrop/parser",
  "moonbitlang/core/json",
  "jtenner/dewdrop/backend",
  "jtenner/dewdrop/standard_loader",
  "jtenner/dewdrop/compiler_driver",
  "jtenner/dewdrop/core_linker",
  "jtenner/dewdrop/compile_request",
  "jtenner/dewdrop/standard_sources",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-flags": "-fwrapv -fno-strict-aliasing -Og -pipe" } },
)

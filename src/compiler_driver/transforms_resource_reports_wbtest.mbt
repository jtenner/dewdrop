///|
test "shared transform resource counts text_operations" {
  let manifest = @semantic.ProgramManifest::new([
    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/text_operations.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.string\nopen dew.std.bytes\nopen dew.std.string_builder\nopen dew.std.bytes_builder\nfn found(value: Option<U32>, expected: U32) -> Bool {\n  match value {\n    Some(index) => index == expected\n    None => false\n  }\n}\nfn check_text() -> Bool {\n  let text = \"0123456789abcdef😀éXYZ\"\n  let view = text.view(16u32, 6u32)\n  let clone = text.compact()\n  text.byte_length() == 25u32 && text.utf16_length() == 22u32 && text.byte_at(16u32) == 240u8 && view.to_string() == \"😀é\" && view.utf16_length() == 3u32 && view.byte_length() == 6u32 && view.byte_at(0u32) == 240u8 && view.as_bytes().byte_length() == 6u32 && view.slice(0u32, 4u32) == \"😀\" && view.subarray(4u32, 6u32).to_string() == \"é\" && view.compact() == \"😀é\" && clone == text && text.slice(16u32, 22u32) == \"😀é\" && text.subarray(16u32, 22u32).to_string() == \"😀é\" && text.starts_with(\"0123456789abcdef\") && text.ends_with(\"XYZ\") && found(text.find(\"f😀\"), 15u32) && found(text.find_view(view), 16u32) && text.contains_view(view) && view.contains_string(\"é\") && found(view.find_string(\"é\"), 4u32) && view.starts_with_string(\"😀\") && view.ends_with_string(\"é\") && view.equals(text.view(16u32, 6u32)) && text.concat_view(view) == text.concat(\"😀é\")\n}\nfn check_builders() -> Bool {\n  let text = \"😀é\"\n  let builder = StringBuilder::with_capacity(1u32)\n  builder.append_view(text.view(0u32, 6u32))\n  builder.append_ascii(45u8)\n  builder.append_scalar(128512u32)\n  builder.append_i8(-8i8)\n  builder.append_u64(18446744073709551615u64)\n  let count = builder.byte_length()\n  let result = builder.finish()\n  let bytes = BytesBuilder::with_capacity(1u32)\n  bytes.append(b\"0123456789abcdef\")\n  bytes.append_byte(255u8)\n  bytes.append(b\"XYZ\")\n  let length = bytes.byte_length()\n  let raw = bytes.finish()\n  count == 33u32 && result == \"😀é-😀-818446744073709551615\" && length == 20u32 && !raw.is_valid_utf8() && raw.byte_at(16u32) == 255u8 && raw.view(17u32, 3u32).to_string() == \"XYZ\" && found(raw.find_byte(255u8), 16u32) && raw.contains_byte(255u8) && raw.starts_with(b\"0123456789abcdef\") && raw.ends_with(b\"XYZ\") && found(raw.find(b\"ef\\xffX\"), 14u32) && raw.contains(b\"ef\\xffX\") && raw.slice(17u32, 20u32).equals(b\"XYZ\") && raw.subarray(0u32, 16u32).compact().concat(b\"!\").to_string() == \"0123456789abcdef!\"\n}\ntransform fn text_transform(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(if check_text() {\n    42i32\n  } else {\n    0i32\n  }))\n}\n#text_transform\nfn text_answer() -> I32 {\n  0i32\n}\ntransform fn builder_transform(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(if check_builders() {\n    42i32\n  } else {\n    0i32\n  }))\n}\n#builder_transform\nfn builder_answer() -> I32 {\n  0i32\n}\npub fn main() -> I32 {\n  if text_answer() == 42i32 && builder_answer() == 42i32 {\n    42i32\n  } else {\n    0i32\n  }\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 2)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/text_operations.dew")
  assert_eq(reports[0].function_name, "text_answer")
  assert_eq(reports[0].transform_name, "example.app::text_transform")
  assert_eq(reports[0].offset, 2549U)
  assert_eq(reports[0].work, 55212U)
  assert_eq(reports[0].allocation_work, 1040851U)
  assert_eq(reports[1].module_name, "example.app")
  assert_eq(reports[1].file_name, "examples/transforms/text_operations.dew")
  assert_eq(reports[1].function_name, "builder_answer")
  assert_eq(reports[1].transform_name, "example.app::builder_transform")
  assert_eq(reports[1].offset, 2791U)
  assert_eq(reports[1].work, 38406U)
  assert_eq(reports[1].allocation_work, 707380U)
}


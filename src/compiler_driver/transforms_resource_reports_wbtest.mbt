    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/memory.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\nbuiltin store_word(address: U32, value: U32) -> Unit = \"i32.store\"\nbuiltin read_byte(address: U32) -> U32 = \"i32.load8_u\"\nbuiltin read_signed_byte(address: U32) -> I32 = \"i32.load8_s\"\nbuiltin load_vector(address: U32) -> V128 = \"v128.load\"\nbuiltin load_splat(address: U32) -> V128 = \"v128.load8_splat\"\nbuiltin load_extended(address: U32) -> V128 = \"v128.load8x8_s\"\nbuiltin store_lane(address: U32, value: V128) -> Unit = \"v128.store32_lane 1\"\nbuiltin extract_word(value: V128) -> U32 = \"i32x4.extract_lane 0\"\nbuiltin extract_second_word(value: V128) -> U32 = \"i32x4.extract_lane 1\"\nbuiltin extract_half(value: V128) -> I32 = \"i16x8.extract_lane_s 0\"\n\nfn compute() -> I32 {\n  store_word(7u32, 4294967168u32)\n  let repeated = load_splat(7u32)\n  store_lane(100u32, repeated)\n  let vector = load_vector(96u32)\n  let packed32 = swar32_add_i8(swar32_splat_i8(20i8), swar32_splat_i8(1i8))\n  let packed64 = swar64_add_i16(swar64_splat_i16(20i16), swar64_splat_i16(1i16))\n  if read_byte(7u32) == 128u32 && read_signed_byte(7u32) == -128i32 && extract_word(repeated) == 2155905152u32 && extract_second_word(vector) == 2155905152u32 && extract_half(load_extended(7u32)) == -128i32 && swar32_extract_i8_s(packed32, 3u8) == 21i8 && swar64_extract_i16_s(packed64, 3u8) == 21i16 {\n    42i32\n  } else {\n    0i32\n  }\n}\n\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(compute()))\n}\n\n#calculate\npub fn main() -> I32 {\n  0i32\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 1)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/memory.dew")
  assert_eq(reports[0].function_name, "main")
  assert_eq(reports[0].transform_name, "example.app::calculate")
  assert_eq(reports[0].offset, 1508U)
  assert_eq(reports[0].work, 661U)
  assert_eq(reports[0].allocation_work, 78609U)
}

///|
test "shared transform resource counts packed_storage" {
  let manifest = @semantic.ProgramManifest::new([
    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/packed_storage.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.wasm.intrinsics\n\nstruct Packed {\n  low: Swar32\n  high: Swar64\n}\nbuiltin read_low(value: Packed) -> Swar32 = \"struct.get 0\"\nbuiltin read_high(value: Packed) -> Swar64 = \"struct.get 1\"\n\nfn default_value<t>() -> t {\n  wasm_array_get(wasm_array_new_default::<t>(1u32), 0u32)\n}\n\nfn compute() -> Bool {\n  let values = wasm_array_new_default::<Swar32>(2u32)\n  let zero = wasm_array_get(values, 0u32)\n  wasm_array_set(values, 1u32, swar32_from_bits(42u32))\n  let record = Packed::{\n    low: wasm_array_get(values, 1u32)\n    high: swar64_from_bits(42u64)\n  }\n  let array = [record.low, zero]\n  swar32_to_bits(read_low(record)) == 42u32 && swar64_to_bits(read_high(record)) == 42u64 && swar32_to_bits(array[0u32]) == 42u32 && swar32_to_bits(array[1u32]) == 0u32 && swar32_to_bits(default_value::<Swar32>()) == 0u32 && swar64_to_bits(default_value::<Swar64>()) == 0u64\n}\n\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(if compute() {\n    42i32\n  } else {\n    0i32\n  }))\n}\n\n#calculate\npub fn main() -> I32 {\n  0i32\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 1)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/packed_storage.dew")
  assert_eq(reports[0].function_name, "main")
  assert_eq(reports[0].transform_name, "example.app::calculate")
  assert_eq(reports[0].offset, 1117U)
  assert_eq(reports[0].work, 466U)
  assert_eq(reports[0].allocation_work, 9233U)
}

///|
test "shared transform resource counts signatures" {
  let manifest = @semantic.ProgramManifest::new([
    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/signatures.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\n// Add a parameter. Existing calls get an explicit default through the adapter.\ntransform fn add_bonus(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let parameters = [@ast.parameter(\"value\", @ast.named_type(\"I32\")), @ast.parameter(\"bonus\", @ast.named_type(\"I32\"))]\n  let changed = node.with_signature(parameters, @ast.named_type(\"I32\"))\n  let body = changed.with_body(@ast.name(\"value\").binary(\"+\", @ast.name(\"bonus\")))\n  body.repair_calls_with(@ast.name(node.name).call([@ast.name(\"value\"), @ast.integer(2i32)]))\n}\n\n#add_bonus\nfn answer(value: I32) -> I32 {\n  value\n}\n\npub fn main() -> I32 {\n  let callback = answer\n  callback(20i32) + answer(18i32, 2i32)\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 1)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/signatures.dew")
  assert_eq(reports[0].function_name, "answer")
  assert_eq(reports[0].transform_name, "example.app::add_bonus")
  assert_eq(reports[0].offset, 610U)
  assert_eq(reports[0].work, 421U)
  assert_eq(reports[0].allocation_work, 8231U)
}

///|
test "shared transform resource counts typed_reflection" {
  let manifest = @semantic.ProgramManifest::new([
    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/typed_reflection.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.array\nopen dew.std.string\n\nfn identity(value: I32) -> I32 {\n  value\n}\n\ntransform fn check_types(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let sum = ctx.syntax.children[0u32]\n  let call = sum.children[0u32]\n  let callee = call.children[0u32]\n  let valid = match (ctx.type_of(call), ctx.type_of(callee), ctx.type_of(sum)) {\n    (Some(call_type), Some(callee_type), Some(sum_type)) => {\n      call_type.name == \"I32\" && callee_type.kind == \"function\" && sum_type.name == \"I32\"\n    }\n    _ => false\n  }\n  let answer = if valid && ctx.type_errors.length() == 0u32 {\n    42i32\n  } else {\n    0i32\n  }\n  node.with_body(@ast.integer(answer))\n}\n\n#check_types\npub fn main() -> I32 {\n  identity(20i32) + identity(22i32)\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 1)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/typed_reflection.dew")
  assert_eq(reports[0].function_name, "main")
  assert_eq(reports[0].transform_name, "example.app::check_types")
  assert_eq(reports[0].offset, 746U)
  assert_eq(reports[0].work, 7915U)
  assert_eq(reports[0].allocation_work, 155409U)
}


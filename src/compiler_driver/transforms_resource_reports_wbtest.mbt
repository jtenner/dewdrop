}

///|
test "shared transform resource counts loop_guards" {
  let manifest = @semantic.ProgramManifest::new([
    @semantic.ManifestModule::new("example.app", [
      @semantic.ManifestFile::new(
        "examples/transforms/loop_guards.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\nfn guard_break() -> I32 {\n  while false {\n    _ if if true {\n      break 42i32\n    } else {\n      false\n    } => break 0i32\n    false => break 1i32\n    true => break 2i32\n  }\n}\n\nfn guard_continue() -> I32 {\n  while false {\n    state if if !state {\n      continue true\n    } else {\n      true\n    } => break 42i32\n    false => break 0i32\n    true => break 1i32\n  }\n}\n\nfn initial_break() -> I32 {\n  while 0i32 {\n    _ => {\n      let _ = while if true {\n        break 42i32\n      } else {\n        0i32\n      } {\n        _ => break 0i32\n      }\n      break 1i32\n    }\n  }\n}\n\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(if guard_break() == 42i32 && guard_continue() == 42i32 && initial_break() == 42i32 {\n    42i32\n  } else {\n    0i32\n  }))\n}\n#replace\npub fn main() -> I32 {\n  0i32\n}\n",
      ),
    ]),
  ])
  let options = CompilerPipelineOptions::production(4000UL, 0, true)
  match
    expand_manifest_sources(
      manifest,
      @semantic.StandardLibrarySources::bootstrap(),
      options,
    ) {
    Ok(_) => ()
    Err(error) => fail(error.message())
  }
  let reports = options.transform_reports
  assert_eq(reports.length(), 1)
  assert_eq(reports[0].module_name, "example.app")
  assert_eq(reports[0].file_name, "examples/transforms/loop_guards.dew")
  assert_eq(reports[0].function_name, "main")
  assert_eq(reports[0].transform_name, "example.app::replace")
  assert_eq(reports[0].offset, 882U)
  assert_eq(reports[0].work, 349U)
  assert_eq(reports[0].allocation_work, 6609U)
}

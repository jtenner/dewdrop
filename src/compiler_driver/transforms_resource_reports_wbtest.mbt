      @semantic.ManifestFile::new(
        "examples/transforms/typed_repair.dew", b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.array\ntransform fn repair(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let answer = if ctx.type_errors.length() > 0u32 && ctx.expression_types.length() == 0u32 {\n    42i32\n  } else {\n    0i32\n  }\n  node.with_body(@ast.integer(answer))\n}\n#repair\npub fn main() -> I32 {\n  missing_original_function()\n}\n",
      ),
    ]),

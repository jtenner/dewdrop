import dewdrop.ast as @ast
open dew.std.array

pub struct SourceLocation {
  file_name: String
  line_no: U32
  col_no: U32
}

pub struct TransformContext {
  location: SourceLocation
  fn_name: String
  module_name: String
  parameters: Array<@ast.ParameterNode>
  type_parameters: Array<@ast.TypeParameterNode>
  return_type: @ast.TypeNode
  parameters_source: String
  return_type_source: String
  fresh_name: String
  declarations: Array<@ast.DeclarationNode>
  imports: Array<@ast.ImportNode>
}

pub struct TransformError {
  message: String
}

pub fn error(message: String) -> TransformError {
  TransformError::{
    message: message
  }
}

impl TransformContext {
  fn add_function(self, source: String) -> Unit {
    self.declarations.push(@ast.DeclarationNode::Function(source))
  }
  fn add_type(self, source: String) -> Unit {
    self.declarations.push(@ast.DeclarationNode::Type(source))
  }
  fn add_implementation(self, source: String) -> Unit {
    self.declarations.push(@ast.DeclarationNode::Implementation(source))
  }
  fn import_module(self, module_path: String, alias: String) -> Unit {
    self.imports.push(@ast.ImportNode::{
      module_path: module_path
      alias: alias
    })
  }
}

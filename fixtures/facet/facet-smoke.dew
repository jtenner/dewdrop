open dew.std.fs
open dew.std.fs.facet
open dew.std.path
open dew.std.process
open dew.std.process.facet

fn facet_smoke_file_system(
  file_system: FacetFileSystem,
  path: RelativePath,
) -> Unit {
  let _kind = fs_path_kind(file_system, path)
  let _read = fs_read_file(file_system, path, 64u32)
  let _write = fs_write_file(file_system, path, b"facet")
  let _create = fs_create_directories(file_system, path)
  let _rename = file_system.rename(path, path)
  let _remove_file = file_system.remove_file(path)
  let _remove_directory = file_system.remove_directory(path)
  let _atomic = fs_atomic_write(file_system, path, path, b"facet")
}

fn facet_smoke_process() -> Unit {
  let _arguments = process_arguments(facet_process(), 8u32, 4096u32)
  let _environment = process_environment(facet_process(), "PATH", 4096u32)
  let _stdout = process_write_stdout(facet_process(), b"")
  let _stderr = process_write_stderr(facet_process(), b"")
}

pub fn main() -> U32 {
  let abi = facet_abi_version()
  facet_smoke_process()
  match facet_preopen_file_system(0u32) {
    Result::Err(_) => 0u32
    Result::Ok(file_system) => {
      match relative_path("facet-smoke") {
        Result::Err(_) => 0u32
        Result::Ok(path) => {
          facet_smoke_file_system(file_system, path)
          if abi == 1u32 && facet_process_abi_version() == 1u32 {
            1u32
          } else {
            0u32
          }
        }
      }
    }
  }
}

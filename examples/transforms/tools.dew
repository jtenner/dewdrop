import dewdrop.ast as @ast
import dewdrop.transform as @transform

fn factor() -> I32 {
  2i32
}

pub transform fn twice(
  node: @ast.FnNode,
  ctx: @transform.TransformContext,
) -> @ast.FnNode {
  node.with_body(@ast.ExprNode::Binary(
    "*",
    node.body,
    @ast.integer(factor()),
  ))
}

pub struct Scale {
  value: I32
}
impl Scale {
  fn new(value: I32) -> Scale {
    Scale::{
      value: value
    }
  }
  fn apply(self, value: I32) -> I32 {
    value * self.value
  }
}

import dewdrop.ast as @ast
import dewdrop.transform as @transform
import dew.std.types as @types

fn packed_type<t>(value: t) -> Bool {
  let _ = value
  @types.type_equal::<t, Swar32>()
}

fn compute() -> Bool {
  swar32_to_bits(swar32_splat_i8(-5i8)) == 4227595259u32 &&
  swar32_to_bits(swar32_splat_i16(-123i16)) == 4286971781u32 &&
  swar32_extract_i8_s(swar32_from_bits(2147451009u32), 0u8) == -127i8 &&
  swar32_extract_i8_u(swar32_from_bits(2147451009u32), 0u8) == 129u8 &&
  swar32_extract_i16_s(swar32_from_bits(2147451009u32), 0u8) == -32639i16 &&
  swar32_extract_i16_u(swar32_from_bits(2147451009u32), 0u8) == 32897u16 &&
  swar32_to_bits(swar32_add_i8(swar32_from_bits(2147451009u32), swar32_from_bits(2147581823u32))) == 4278255360u32 &&
  swar32_to_bits(swar32_sub_i8(swar32_from_bits(2147451009u32), swar32_from_bits(2147581823u32))) == 4294836482u32 &&
  swar32_to_bits(swar32_add_i16(swar32_from_bits(2147451009u32), swar32_from_bits(2147581823u32))) == 0u32 &&
  swar32_to_bits(swar32_sub_i16(swar32_from_bits(2147451009u32), swar32_from_bits(2147581823u32))) == 4294836482u32 &&
  swar32_any_true(swar32_from_bits(2147451009u32)) == true &&
  swar32_all_true_i8(swar32_from_bits(2147451009u32)) == true &&
  swar32_bitmask_i8(swar32_from_bits(2147451009u32)) == 7u32 &&
  swar32_to_bits(swar32_popcnt_i8(swar32_from_bits(2147451009u32))) == 117965058u32 &&
  swar32_to_bits(swar32_eq_i8(swar32_from_bits(2147451009u32), swar32_from_bits(2147581823u32))) == 0u32 &&
  swar64_to_bits(swar64_splat_i8(-5i8)) == 18157383382357244923u64 &&
  swar64_to_bits(swar64_splat_i16(-123i16)) == 18412403602556845957u64 &&
  swar64_to_bits(swar64_splat_i32(-1234567i32)) == 18441441653113563513u64 &&
  swar64_extract_i8_s(swar64_from_bits(18303097644806799489u64), 0u8) == -127i8 &&
  swar64_extract_i8_u(swar64_from_bits(18303097644806799489u64), 0u8) == 129u8 &&
  swar64_extract_i16_s(swar64_from_bits(18303097644806799489u64), 0u8) == -32639i16 &&
  swar64_extract_i16_u(swar64_from_bits(18303097644806799489u64), 0u8) == 32897u16 &&
  swar64_extract_i32_s(swar64_from_bits(18303097644806799489u64), 1u8) == -33445291i32 &&
  swar64_extract_i32_u(swar64_from_bits(18303097644806799489u64), 1u8) == 4261522005u32 &&
  swar64_to_bits(swar64_add_i8(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18411183303555088128u64 &&
  swar64_to_bits(swar64_sub_i8(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18267069584374628610u64 &&
  swar64_to_bits(swar64_add_i16(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18411183299276832768u64 &&
  swar64_to_bits(swar64_sub_i16(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18195011990336700674u64 &&
  swar64_to_bits(swar64_add_i32(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18411464774253608960u64 &&
  swar64_to_bits(swar64_sub_i32(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 18194730515359990018u64 &&
  swar64_any_true(swar64_from_bits(18303097644806799489u64)) == true &&
  swar64_all_true_i8(swar64_from_bits(18303097644806799489u64)) == true &&
  swar64_bitmask_i8(swar64_from_bits(18303097644806799489u64)) == 167u32 &&
  swar64_to_bits(swar64_popcnt_i8(swar64_from_bits(18303097644806799489u64))) == 504689048586551554u64 &&
  swar64_to_bits(swar64_eq_i8(swar64_from_bits(18303097644806799489u64), swar64_from_bits(108367133741776767u64))) == 1095216660480u64 &&
  swar32_to_bits(swar32_replace_i8(swar32_from_bits(2147451009u32), 3u8, -5i8)) == 4227825793u32 &&
  swar32_to_bits(swar32_replace_i16(swar32_from_bits(2147451009u32), 1u8, -123i16)) == 4286939265u32 &&
  swar32_to_bits(swar32_shl_i8(swar32_from_bits(2147451009u32), 9u8)) == 4278059010u32 &&
  swar32_to_bits(swar32_shr_i8_u(swar32_from_bits(2147451009u32), 9u8)) == 1065304128u32 &&
  swar32_to_bits(swar32_shr_i8_s(swar32_from_bits(2147451009u32), 9u8)) == 1073725632u32 &&
  swar32_to_bits(swar32_shl_i16(swar32_from_bits(2147451009u32), 17u8)) == 4294836482u32 &&
  swar32_to_bits(swar32_shr_i16_u(swar32_from_bits(2147451009u32), 17u8)) == 1073692736u32 &&
  swar32_to_bits(swar32_shr_i16_s(swar32_from_bits(2147451009u32), 17u8)) == 1073725504u32 &&
  swar64_to_bits(swar64_replace_i8(swar64_from_bits(18303097644806799489u64), 7u8, -5i8)) == 18086924862693015681u64 &&
  swar64_to_bits(swar64_replace_i16(swar64_from_bits(18303097644806799489u64), 3u8, -123i16)) == 18412309935770534017u64 &&
  swar64_to_bits(swar64_replace_i32(swar64_from_bits(18303097644806799489u64), 1u8, -1234567i32)) == 18441441650967281793u64 &&
  swar64_to_bits(swar64_shl_i8(swar64_from_bits(18303097644806799489u64), 9u8)) == 18159169740910493698u64 &&
  swar64_to_bits(swar64_shr_i8_u(swar64_from_bits(18303097644806799489u64), 9u8)) == 9151408082759139392u64 &&
  swar64_to_bits(swar64_shr_i8_s(swar64_from_bits(18303097644806799489u64), 9u8)) == 18374920857110692032u64 &&
  swar64_to_bits(swar64_shl_i16(swar64_from_bits(18303097644806799489u64), 17u8)) == 18159169740927271170u64 &&
  swar64_to_bits(swar64_shr_i16_u(swar64_from_bits(18303097644806799489u64), 17u8)) == 9151408082767528000u64 &&
  swar64_to_bits(swar64_shr_i16_s(swar64_from_bits(18303097644806799489u64), 17u8)) == 18374920857110691904u64 &&
  swar64_to_bits(swar64_shl_i32(swar64_from_bits(18303097644806799489u64), 33u8)) == 18159451215904047362u64 &&
  swar64_to_bits(swar64_shr_i32_u(swar64_from_bits(18303097644806799489u64), 33u8)) == 9151548820255916096u64 &&
  swar64_to_bits(swar64_shr_i32_s(swar64_from_bits(18303097644806799489u64), 33u8)) == 18374920857110691904u64 &&
  !swar32_any_true(swar32_from_bits(0u32)) &&
  !swar64_any_true(swar64_from_bits(0u64)) &&
  !swar32_all_true_i8(swar32_from_bits(1u32)) &&
  !swar64_all_true_i8(swar64_from_bits(1u64)) &&
  packed_type(swar32_from_bits(1u32)) &&
  !packed_type(swar64_from_bits(1u64)) &&
  !packed_type(1u32) &&
  @types.bit_width::<Swar32>() == 32u32 &&
  @types.bit_width::<Swar64>() == 64u32
}

transform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {
  node.with_body(@ast.integer(if compute() {
    42i32
  } else {
    0i32
  }))
}

#calculate
pub fn main() -> I32 {
  0i32
}

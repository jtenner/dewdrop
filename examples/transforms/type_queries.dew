import dewdrop.ast as @ast
import dewdrop.transform as @transform
import dew.std.types as @types
open dew.std.array

struct Payload {
  value: I32
  flag: Bool
}

enum Mode {
  Ready
  Value(I32)
}

transform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {
  @types.static_assert(@types.type_equal::<I32, I32>(), "I32 identity")
  let names = @types.field_names::<Payload>()
  let _ = names.pop()
  let fresh = @types.field_names::<Payload>()
  let modes = @types.variant_names::<Mode>()
  let valid = @types.is_unit::<Unit>() && @types.is_never::<Never>() && @types.is_integer::<I32>() && @types.is_signed_integer::<I32>() && @types.is_float::<F64>() && @types.bit_width::<U64>() == 64u32 && @types.can_bitcast::<I32, U32>() && @types.lane_count::<I8x16>() == 16u32 && @types.lane_bit_width::<I8x16>() == 8u32 && @types.tuple_length::<(I32, Bool)>() == 2u32 && @types.size_of::<(U8, I32)>() == 8u32 && @types.align_of::<(U8, I32)>() == 4u32 && @types.field_offset::<(U8, I32)>(1u32) == 4u32 && fresh.length() == 2u32 && modes.length() == 2u32
  let answer = if valid {
    42i32
  } else {
    0i32
  }
  node.with_body(@ast.integer(answer))
}

#replace
pub fn main() -> I32 {
  0i32
}

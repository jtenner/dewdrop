import dewdrop.ast as @ast
import dewdrop.transform as @transform
open dew.std.wasm.intrinsics

struct Box<t> {
  value: t
}

fn boxed_record<a, b>(value: a) -> Box<b> {
  Box::{
    value: wasm_unsafe_bitcast::<a, b>(value)
  }
}

fn boxed_option<a, b>(value: a) -> Option<b> {
  Some(wasm_unsafe_bitcast::<a, b>(value))
}

fn boxed_tuple<a, b>(value: a) -> (b, Bool) {
  (wasm_unsafe_bitcast::<a, b>(value), true)
}

transform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {
  let first = match boxed_option::<U32, I32>(0u32) {
    Some(0i32) => 2i32
    _ => 0i32
  }
  let data = boxed_record::<U32, I32>(40u32)
  let (tuple_value, tuple_flag) = boxed_tuple::<U32, I32>(0u32)
  let flag = match boxed_option::<U32, Bool>(1u32) {
    Some(value) => value
    None => false
  }
  node.with_body(@ast.integer(if flag && tuple_flag {
    data.value + tuple_value + first
  } else {
    0i32
  }))
}

#replace
pub fn main() -> I32 {
  0i32
}

import dewdrop.ast as @ast
import dewdrop.transform as @transform
open dew.std.array
open dew.std.string

transform fn labeled(node: @ast.FnNode, ctx: @transform.TransformContext) -> Result<@ast.FnNode, @transform.TransformError> {
  if ctx.arguments.length() != 1u32 {
    return Err(@transform.error("expected one label"))
  }
  match (ctx.arguments[0u32].kind, ctx.arguments[0u32].label) {
    ("String", "answer") => Ok(node.with_body(@ast.integer(42i32)))
    _ => Err(@transform.error("expected the answer label"))
  }
}

#labeled("answer")
pub fn main() -> I32 {
  0i32
}

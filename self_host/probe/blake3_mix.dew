open dew.std.fixed_array

fn probe_mix(
  state: FixedArray<U32>,
  a: U32,
  b: U32,
  left: U32,
) -> Unit {
  state.set_unchecked(a, state.get_unchecked(a) + state.get_unchecked(b) + left)
}

pub fn main() -> U32 {
  let state = FixedArray::make(2u32, 0u32)
  probe_mix(state, 0u32, 1u32, 7u32)
  state.get_unchecked(0u32)
}

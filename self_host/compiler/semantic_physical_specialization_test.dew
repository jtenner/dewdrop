test "unproved generic trait candidates cannot disappear" {
  let link = self_host_physical_test_trait_link(
    b"pub trait Marker {}\npub trait First {\n  fn convert(self) -> U64\n}\npub trait Second {\n  fn convert(self) -> U64\n}\nimpl First for U32 {\n  fn convert(self) -> U64 {\n    7u64\n  }\n}\nimpl<t: Marker> Second for t {\n  fn convert(self) -> U64 {\n    8u64\n  }\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "unproved evidence must produce a diagnostic")
  assert(
    module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::UnsupportedExpressionInference(_, _),
    "a concrete competitor must not hide a candidate that still needs evidence",
  )
}

test "unbounded generic trait competitors remain ambiguous" {
  let link = self_host_physical_test_trait_link(
    b"pub trait First {\n  fn convert(self) -> U64\n}\npub trait Second {\n  fn convert(self) -> U64\n}\nimpl First for U32 {\n  fn convert(self) -> U64 {\n    7u64\n  }\n}\nimpl<t> Second for t {\n  fn convert(self) -> U64 {\n    8u64\n  }\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "both viable trait methods must remain visible")
  assert(module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::AmbiguousMethod(_, _, _, _, 2u32, _), "generic parameters alone do not remove a viable method")
}

open dew.std.option
open dew.std.bytes_builder

test "trait evidence identities remain part of specialization keys" {
  let requests = []
  let shapes = []
  let heads = self_host_empty_u64_u32_map()
  let next = []
  let first = self_host_program_specialization_add_request_with_evidence(requests, shapes, heads, next, 11u64,
    [SelfHostPlannedValueShape::RefPlannedValueShape], [SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(100u64)])
  let second = self_host_program_specialization_add_request_with_evidence(requests, shapes, heads, next, 11u64,
    [SelfHostPlannedValueShape::RefPlannedValueShape], [SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(101u64)])
  let repeated = self_host_program_specialization_add_request_with_evidence(requests, shapes, heads, next, 11u64,
    [SelfHostPlannedValueShape::RefPlannedValueShape], [SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(100u64)])
  assert(first != second, "equal reference carriers do not erase trait receiver identity")
  assert(first == repeated, "equal structural evidence deduplicates")
  assert(!self_host_specialization_evidence_type_equal(
    SelfHostSpecializationEvidenceType::PrimitiveSpecializationEvidenceType(SelfHostPrimitiveType::I32Type),
    SelfHostSpecializationEvidenceType::PrimitiveSpecializationEvidenceType(SelfHostPrimitiveType::U32Type),
  ), "equal scalar carriers do not erase logical primitive identity")
}

fn self_host_physical_test_link_trace(
  link: SelfHostPlannedProgramWasmGCLink,
) -> String {
  let output = StringBuilder::new()
  let mut function_index = 0u32
  let _ = while function_index {
    current => if current < link.functions.length() {
      let function_ = self_host_planned_program_wasm_function_identity(link.functions[current])
      output.append("\nlinked ")
      output.append_u32(function_.function_index)
      output.append(" name=")
      output.append(bytes_to_string(self_host_linked_function_name(link, function_)))
      output.append(" key=")
      output.append(self_host_body_specialization_key(link, function_.declaration, function_.specialization))
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < link.fragments.specialization.lowering.modules.length() {
      let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[current])
      let mut expression_index = 0u32
      let _ = while expression_index {
        index => if index < module_.expressions.length() {
          let expression = self_host_program_specialization_expression(module_, index)
          output.append("\nexpr module=")
          output.append_u64(module_.module_id)
          output.append(" index=")
          output.append_u32(index)
          output.append(" kind=")
          output.append(self_host_body_expression_kind_name(expression.kind))
          output.append(" type=")
          output.append_i32(expression.type_)
          output.append(" shape=")
          output.append(self_host_body_carrier_name(self_host_body_carrier_from_shape(expression.shape)))
          output.append(" nominal=")
          output.append_u64(expression.nominal)
          if expression.source_name < module_.names.length() {
            output.append(" name=")
            output.append(module_.names[expression.source_name])
          }
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  output.finish()
}

fn self_host_physical_test_module(
  fragments: SelfHostPlannedProgramWasmGCFragments,
) -> SelfHostPlannedModuleWasmGCFragments {
  fragments.modules[0u32]
}

fn self_host_physical_test_assert_clean_inference(
  link: SelfHostPlannedProgramWasmGCLink,
) -> Unit {
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < link.fragments.specialization.lowering.modules.length() {
      let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[current])
      let report = StringBuilder::new()
      report.append("inference diagnostics in module ")
      report.append_u64(module_.module_id)
      report.append(": ")
      report.append_u32(module_.inferred.diagnostics.length())
      if module_.inferred.diagnostics.length() > 0u32 {
        let diagnostic = module_.inferred.diagnostics[0u32]
        report.append(" first_offset=")
        report.append_u32(diagnostic.offset())
        report.append(" kind=")
        report.append(match diagnostic {
          SelfHostBodyInferenceDiagnostic::UnsupportedExpressionInference(_, _) => "unsupported expression"
          SelfHostBodyInferenceDiagnostic::UnresolvedExpressionType(_, _) => "unresolved expression"
          SelfHostBodyInferenceDiagnostic::NoMatchingMethod(_, _, _) => "no matching method"
          SelfHostBodyInferenceDiagnostic::AmbiguousMethod(_, _, _, _, _, _) => "ambiguous method"
          SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(_) => "type constraint"
          SelfHostBodyInferenceDiagnostic::ReturnOutsideCallable(_) => "return outside callable"
          SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(_, _, _) => "no matching direct call"
          SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(_, _) => "invalid pattern constructor"
          SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(_, _) => "invalid construction target"
          _ => "other"
        })
        report.append(self_host_physical_test_link_trace(link))
      }
      assert(module_.inferred.diagnostics.length() == 0u32, report.finish())
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_physical_test_fragments(
  source: Bytes,
) -> SelfHostPlannedProgramWasmGCFragments {
  let collected = self_host_collect_program_manifest(
    5100u64,
    SelfHostProgramManifest::{
      modules: [SelfHostManifestModule::{
        path: "app.main"
        files: [SelfHostManifestFile::{
          path: "main.dew"
          source: source
          test_only: false
        }]
      }]
    },
  )
  assert(collected.diagnostics.length() == 0u32, "single-module fixture manifest must parse")
  let source_module = collected.modules.at(0u32)
  assert(source_module.diagnostic_count() == 0u32, "single-module fixture source must parse and collect")
  let lowering = self_host_plan_program_lowering(
    self_host_freeze_program_signature_interfaces(collected),
  )
  self_host_plan_program_wasmgc_fragments(
    self_host_plan_program_specialization(lowering, false),
  )
}

fn self_host_physical_test_frozen_body() -> SelfHostPlannedPhysicalBodyCarrierPlan {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn run() -> I32 {\n  42\n}\n"),
    false,
  )
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, "the source plan must be valid")
  assert(plan.bodies.length() == 1u32, "the source has one body")
  plan.bodies[0u32]
}

fn self_host_physical_test_body_at(plan: SelfHostPlannedProgramWasmBodyPlan, index: U32) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  plan.bodies[index]
}

fn self_host_physical_test_import_link(runtime: Bytes, source: Bytes) -> SelfHostPlannedProgramWasmGCLink {
  self_host_physical_test_named_import_link("app.runtime", runtime, source)
}

fn self_host_physical_test_named_import_link(runtime_path: String, runtime: Bytes, source: Bytes) -> SelfHostPlannedProgramWasmGCLink {
  self_host_physical_test_manifest_link(
    SelfHostProgramManifest::{
      modules: [
        SelfHostManifestModule::{
          path: runtime_path
          files: [SelfHostManifestFile::{
            path: "runtime.dew"
            source: runtime
            test_only: false
          }]
        },
        SelfHostManifestModule::{
          path: "app.main"
          files: [SelfHostManifestFile::{
            path: "main.dew"
            source: source
            test_only: false
          }]
        },
      ]
    },
  )
}

fn self_host_physical_test_manifest_link(manifest: SelfHostProgramManifest) -> SelfHostPlannedProgramWasmGCLink {
  let collected = self_host_collect_program_manifest(5500u64, manifest)
  assert(collected.diagnostics.length() == 0u32, "runtime fixture collection must have no diagnostics")
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < collected.modules.length() {
      let module_ = collected.modules.at(current)
      if module_.diagnostic_count() > 0u32 {
        let report = StringBuilder::new()
        report.append("runtime fixture parse/collection diagnostics module=")
        report.append_u32(current)
        match module_.diagnostic_at(0u32) {
          SelfHostCollectionDiagnostic::ParseDiagnostic(_, _, _, offset, _, token) => {
            report.append(" offset=")
            report.append_u32(offset)
            report.append(" token=")
            report.append(token)
          }
          _ => {}
        }
        assert(false, report.finish())
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_plan_program_wasmgc_link(
    self_host_plan_program_wasmgc_fragments(
      self_host_plan_program_specialization(
        self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(collected)),
        false,
      ),
    ),
    false,
  )
}

test "frozen body accepts an unchanged expression carrier" {
  let plan = self_host_physical_test_frozen_body()
  assert(
    !self_host_linked_refine_canonical_expression_shape(
      Option::Some(plan),
      plan.expressions[0u32].expression,
      SelfHostPlannedValueShape::I32PlannedValueShape,
    ),
    "emission must not change the plan",
  )
}

test "BOD-605 emission cannot rewrite a frozen carrier" expect_trap "unreachable" {
  let plan = self_host_physical_test_frozen_body()
  self_host_linked_refine_canonical_expression_shape(
    Option::Some(plan),
    plan.expressions[0u32].expression,
    SelfHostPlannedValueShape::I64PlannedValueShape,
  )
}

test "physical generic method keeps receiver and specializes result" {
  let fragments = self_host_physical_test_fragments(
    b"struct Box<t> {\n  value: t\n}\nimpl<t> Box<t> {\n  fn get_unchecked(self) -> t {\n    self.value\n  }\n}\nstruct Holder {\n  boxed: Box<I64>\n}\nimpl Holder {\n  fn read(self) -> I64 {\n    self.boxed.get_unchecked()\n  }\n}\n",
  )
  let module_ = self_host_physical_test_module(fragments)
  let mut found = false
  let mut index = 0u32
  let _ = while index {
    current => if current < self_host_program_link_fragment_function_count(module_) {
    let function_ = self_host_program_link_fragment_function(module_, current)
    if function_.specialization != 4294967295u32 {
      assert(function_.parameters.length == 1u32, "method has one receiver")
      assert(function_.results.length == 1u32, "method has one result")
      assert(
        module_.function_value_types[function_.parameters.start] is SelfHostPlannedWasmValueType::WasmNullableEqRefValue,
        "Box<I64> receiver must remain a reference",
      )
      assert(
        module_.function_value_types[function_.results.start] is SelfHostPlannedWasmValueType::WasmI64Value,
        "generic result must use the selected i64 shape",
      )
      found = true
    }
    continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(found, "generic method specialization must be present")
}

test "linked result does not change for a method named get_unchecked" {
  let fragments = self_host_physical_test_fragments(
    b"struct Box<t> {\n  value: t\n}\nimpl<t> Box<t> {\n  fn get_unchecked(self) -> Box<t> {\n    self\n  }\n}\nstruct Holder {\n  boxed: Box<I64>\n}\nimpl Holder {\n  fn read(self) -> Box<I64> {\n    self.boxed.get_unchecked()\n  }\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let mut found = false
  let mut index = 0u32
  let _ = while index {
    current => if current < link.functions.length() {
      let function_ = self_host_planned_program_wasm_function_identity(
        link.functions[current],
      )
      if function_.specialization != 4294967295u32 {
        let shape = self_host_linked_physical_function_result_shape(
          link,
          self_host_linked_physical_function_index(function_.function_index),
        )
        assert(
          shape is SelfHostPlannedValueShape::RefPlannedValueShape,
          "a Box<I64> result must stay a reference regardless of method name",
        )
        found = true
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(found, "named generic method must have a linked specialization")
}

test "builder factory locals keep their reference carrier" {
  let collected = self_host_collect_program_manifest(
    5400u64,
    SelfHostProgramManifest::{
      modules: [
        SelfHostManifestModule::{
          path: "app.builders"
          files: [SelfHostManifestFile::{
            path: "builders.dew"
            source: b"pub builtin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = \"dew_string_builder_with_capacity\"\npub builtin string_builder_append_ascii(builder: StringBuilder, byte: U8) -> Unit = \"dew_string_builder_append_ascii\"\nimpl BytesBuilder {\n  fn with_capacity(capacity: U32) -> StringBuilder {\n    string_builder_with_capacity_raw(capacity)\n  }\n}\nimpl StringBuilder {\n  fn with_capacity(capacity: U32) -> StringBuilder {\n    string_builder_with_capacity_raw(capacity)\n  }\n}\n"
            test_only: false
          }]
        },
        SelfHostManifestModule::{
          path: "app.main"
          files: [SelfHostManifestFile::{
            path: "main.dew"
            source: b"open app.builders\npub fn run() -> Unit {\n  let builder = StringBuilder::with_capacity(4u32)\n  string_builder_append_ascii(builder, 47u8)\n}\n"
            test_only: false
          }]
        },
      ]
    },
  )
  let fragments = self_host_plan_program_wasmgc_fragments(
    self_host_plan_program_specialization(
      self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(collected)),
      false,
    ),
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 3u32, "all builder fixture bodies must be planned")
  assert(
    plan.diagnostics.length() == 0u32,
    self_host_program_wasm_body_plan_error_report(plan),
  )
}

test "primitive inherent methods preserve their logical receiver" {
  let fragments = self_host_physical_test_fragments(
    b"impl U32 {\n  fn read(self) -> U64 {\n    1u64\n  }\n}\nimpl I32 {\n  fn read(self) -> U64 {\n    2u64\n  }\n}\npub fn run(value: U32) -> U64 {\n  value.read()\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 3u32, "both methods and their caller must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "string view builtin results keep their reference carrier" {
  let fragments = self_host_physical_test_fragments(
    b"builtin string_view(value: String, start: U32, length: U32) -> StringView = \"dew_string_view\"\nbuiltin string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\nimpl StringView {\n  fn byte_length(self) -> U32 {\n    string_view_byte_length(self)\n  }\n}\npub fn run(value: String) -> U32 {\n  let view = string_view(value, 0u32, 3u32)\n  view.byte_length()\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 2u32, "the string view method and caller must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "a static parameter cannot become a method receiver" {
  let fragments = self_host_physical_test_fragments(
    b"impl U32 {\n  fn read(value: U32) -> U64 {\n    1u64\n  }\n}\npub fn run(value: U32) -> U64 {\n  value.read()\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(fragments.specialization.lowering.modules[0u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "the invalid receiver must produce one diagnostic")
  assert(
    module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::NoMatchingMethod(_, _, _),
    "a value parameter is not a declared receiver",
  )
}

test "string slice retains a view across calls" {
  let fragments = self_host_physical_test_fragments(
    b"builtin string_view(value: String, start: U32, length: U32) -> StringView = \"dew_string_view\"\nbuiltin string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\nbuiltin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = \"dew_string_builder_with_capacity\"\nbuiltin string_builder_append_view(builder: StringBuilder, view: StringView) -> Unit = \"dew_string_builder_append_view\"\nbuiltin string_builder_finish(builder: StringBuilder) -> String = \"dew_string_builder_finish\"\nimpl StringView {\n  fn byte_length(self) -> U32 {\n    string_view_byte_length(self)\n  }\n}\nimpl String {\n  fn slice(self, start: U32, end: U32) -> String {\n    let view = string_view(self, start, end - start)\n    let builder = string_builder_with_capacity_raw(view.byte_length())\n    string_builder_append_view(builder, view)\n    string_builder_finish(builder)\n  }\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 2u32, "both methods must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "string slice retains an imported builtin view across calls" {
  let link = self_host_physical_test_import_link(
    b"pub builtin string_view(value: String, start: U32, length: U32) -> StringView = \"dew_string_view\"\npub builtin string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\npub builtin string_builder_with_capacity_raw(capacity: U32) -> StringBuilder = \"dew_string_builder_with_capacity\"\npub builtin string_builder_append_view(builder: StringBuilder, view: StringView) -> Unit = \"dew_string_builder_append_view\"\npub builtin string_builder_finish(builder: StringBuilder) -> String = \"dew_string_builder_finish\"\n",
    b"open app.runtime\nimpl StringView {\n  fn byte_length(self) -> U32 {\n    string_view_byte_length(self)\n  }\n}\nimpl String {\n  fn slice(self, start: U32, end: U32) -> String {\n    let view = string_view(self, start, end - start)\n    let builder = string_builder_with_capacity_raw(view.byte_length())\n    string_builder_append_view(builder, view)\n    string_builder_finish(builder)\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 2u32, "both imported-runtime caller methods must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "into calls retain the selected logical result" {
  let link = self_host_physical_test_import_link(
    b"pub trait Into<t> {\n  fn into(self) -> t\n}\nimpl Into<U32> for U32 {\n  fn into(self) -> U32 {\n    self\n  }\n}\nimpl Into<I64> for U32 {\n  fn into(self) -> I64 {\n    1i64\n  }\n}\nimpl Into<U64> for U32 {\n  fn into(self) -> U64 {\n    2u64\n  }\n}\n",
    b"open app.runtime\npub fn run(value: U32) -> U64 {\n  value.into()\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 4u32, "all three conversions and their caller must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "standard runtime helpers cross the frozen interface" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.text_runtime",
    b"builtin string_view(value: String, start: U32, length: U32) -> StringView = \"dew_string_view\"\nbuiltin string_view_byte_length(value: StringView) -> U32 = \"dew_string_view_byte_length\"\n",
    b"open dew.std.text_runtime\npub fn run(value: String) -> U32 {\n  let view = string_view(value, 0u32, 3u32)\n  string_view_byte_length(view)\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 1u32, "the standard runtime caller must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "standard publication does not expose ordinary private helpers" {
  let collected = self_host_collect_bytes(5500u64, b"fn hidden() -> U32 {\n  1u32\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  for path in ["app.runtime", "dew.std.string", "dew.std.string_builder", "dew.std.bytes", "dew.std.bytes_builder"] {
    let interface_ = self_host_freeze_module_signature_interface(path, collected, resolved)
    assert(interface_.declaration_count() == 0u32, "private helper must stay private")
  }
}

test "default preamble supplies core calls without changing source files" {
  let manifest = SelfHostProgramManifest::{
    modules: [
      SelfHostManifestModule::{
        path: "dew.std.preamble"
        files: [SelfHostManifestFile::{
          path: "core.dew"
          source: b"fn core_identity(value: U32) -> U32 {\n  value\n}\n"
          test_only: false
        }]
      },
      SelfHostManifestModule::{
        path: "app.main"
        files: [SelfHostManifestFile::{
          path: "main.dew"
          source: b"pub fn run() -> U32 {\n  core_identity(7u32)\n}\n"
          test_only: false
        }]
      },
    ]
  }
  let disabled = self_host_manifest_with_default_preamble(manifest, false)
  assert(self_host_manifest_module_file_count(disabled.modules[1u32]) == 1u32, "disabled preamble must not add an import")
  let enabled = self_host_manifest_with_default_preamble(manifest, true)
  assert(self_host_manifest_module_file_count(enabled.modules[1u32]) == 2u32, "enabled preamble adds one import file")
  assert(self_host_manifest_module_file(enabled.modules[1u32], 0u32).path == "main.dew", "original file IDs must remain stable")
  assert(self_host_manifest_module_file_count(manifest.modules[1u32]) == 1u32, "preparation must not mutate the source manifest")
  let frozen = self_host_freeze_program_signature_interfaces(self_host_collect_program_manifest(5500u64, enabled))
  let link = self_host_plan_program_wasmgc_link(
    self_host_plan_program_wasmgc_fragments(
      self_host_plan_program_specialization(self_host_plan_program_lowering(frozen), false),
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 2u32, "core function and caller must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_plan_error_report(plan))
}

test "nested error patterns retain scalar payloads" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(
      b"enum LexError {\n  InvalidEscape(U32)\n  InvalidText(String)\n}\nenum ParseError {\n  Lexical(LexError, U32)\n  Expected(U32, String, U32)\n}\nstruct Diagnostic {\n  error: ParseError\n}\nenum CollectionError {\n  Parse(U64, Diagnostic, U32)\n}\npub fn run(diagnostic: CollectionError) -> U32 {\n  match diagnostic {\n    CollectionError::Parse(_, detail, _) => match detail.error {\n      ParseError::Lexical(error, offset) => match error {\n        LexError::InvalidEscape(unit) => unit + offset\n        LexError::InvalidText(_) => offset\n      }\n      ParseError::Expected(_, _, offset) => offset\n    }\n  }\n}\n",
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 1u32, "nested error reader must be planned")
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

test "a pattern constructor cannot replace a different subject type" {
  let fragments = self_host_physical_test_fragments(
    b"enum Left {\n  Value(U32)\n}\nenum Right {\n  Value(U32)\n}\npub fn run(value: Left) -> U32 {\n  match value {\n    Right::Value(item) => item\n  }\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(fragments.specialization.lowering.modules[0u32])
  let mut found = false
  for diagnostic in module_.inferred.diagnostics {
    if diagnostic is SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(_) {
      found = true
    }
  }
  assert(found, "different nominal owners must produce a type constraint diagnostic")
}


test "opened imported variants retain unqualified constructor identity" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.option",
    b"pub enum Option<t> {\n  None\n  Some(t)\n}\n",
    b"open dew.std.option\npub fn run(value: Option<U32>) -> U32 {\n  match value {\n    Some(index) => index\n    None => 0u32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  let mut selected = 0u32
  for pattern in module_.patterns {
    match pattern.source {
      SelfHostHirPattern::TuplePattern(_, _, _) => {
        let declaration = self_host_pattern_constructor_declaration(module_, pattern)
        assert(link.runtime_variant_adapters.contains_key(declaration), "unqualified Some must have a selected declaration")
        assert(self_host_linked_pattern_variant_type(link, module_, pattern, SelfHostPlannedValueShape::U32PlannedValueShape, 0u64) is Option::Some(_), "emission must use that selected runtime adapter")
        selected = selected + 1u32
      }
      _ => {}
    }
  }
  assert(selected == 1u32, "the test must inspect the Some pattern")
}

test "bare constructors do not prefer a local enum over an imported enum" {
  let link = self_host_physical_test_named_import_link(
    "app.library",

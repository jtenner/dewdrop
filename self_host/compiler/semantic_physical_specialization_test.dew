test "declared generic bounds preserve logical method evidence" {
  let fragments = self_host_physical_test_fragments(
    b"trait Read<t> {\n  fn read(self) -> t\n}\nfn read<t: Read<I64>>(value: t) -> I64 {\n  value.read()\n}\npub fn run() -> I32 {\n  7i32\n}\n",
  )
  self_host_physical_test_assert_clean_inference(self_host_plan_program_wasmgc_link(fragments, false))
  let module_ = self_host_planned_module_lowering_identity(fragments.specialization.lowering.modules[0u32])
  let mut found = false
  for target in module_.inferred.call_targets {
    if target is SelfHostBasicCallTarget::BoundTraitBasicCallTarget(_, _, _, _) {
      found = true
    }
  }
  assert(found, "declared bounds remain distinct from physical implementation selection")
  let invalid = self_host_physical_test_fragments(
    b"trait Read<t> {\n  fn read(self) -> t\n}\nfn read<t>(value: t) -> I64 {\n  value.read()\n}\npub fn run() -> I32 {\n  7i32\n}\n",
  )
  assert(self_host_validate_program_inference(invalid.specialization.lowering) is Option::Some(_), "an undeclared bound cannot supply evidence")
}

test "competing declared bounds stay ambiguous" {
  let fragments = self_host_physical_test_fragments(
    b"trait First {\n  fn read(self) -> I64\n}\ntrait Second {\n  fn read(self) -> I64\n}\nfn read<t: First + Second>(value: t) -> I64 {\n  value.read()\n}\npub fn run() -> I32 {\n  7i32\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(fragments.specialization.lowering.modules[0u32])

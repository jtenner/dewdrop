  assert(module_.inferred.diagnostics.length() > 0u32, "ambiguous constructor must be diagnosed, not selected from local scope")
}

test "user Some and None patterns retain declaration identity" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(
      b"enum Local {\n  None\n  Some(U32)\n}\npub fn run(value: Local) -> U32 {\n  match value {\n    Local::Some(index) => index\n    Local::None => 0u32\n  }\n}\n",
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32])
  let mut checked = 0u32
  for pattern in module_.patterns {
    match pattern.selected_constructor {
      SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(declaration, _, _) => {
        let expected = self_host_linked_variant_type_index(link, declaration)
        let actual = self_host_linked_pattern_variant_type(link, module_, pattern, SelfHostPlannedValueShape::ErrorPlannedValueShape, 0u64)
        match expected {
          Option::Some(left) => match actual {
            Option::Some(right) => assert(left == right, "source spelling cannot replace the selected variant type")
            Option::None => assert(false, "the planned variant type must exist")
          }
          Option::None => assert(false, "the linked variant type must exist")
        }
        checked = checked + 1u32
      }
      _ => {}
    }
  }
  assert(checked == 2u32, "both Some and None identities must be checked")
}

test "a user None constructor keeps its physical type" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(
      b"enum Local {\n  None\n  Value(I64)\n}\npub fn run() -> Local {\n  Local::None\n}\n",
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
  let body = self_host_physical_test_body_at(plan, 0u32)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32])
  let mut checked = false
  for expression in body.expressions {
    let source = self_host_planned_expression_identity(module_.expressions[expression.expression])
    match source.selection {
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(declaration, _, _) => {
        match self_host_linked_variant_type_index(link, declaration) {
          Option::Some(expected) => assert(self_host_u32_equal(expression.selected_type_index, expected), "user None must not use the runtime Option type")
          Option::None => assert(false, "user None must have a linked type")
        }
        checked = true
      }
      _ => {}
    }
  }
  assert(checked, "the constructor selection must be present")
}

test "nested fixed array reads keep their scalar result" {
  let fragments = self_host_physical_test_fragments(
    b"pub struct WasmArray<t> {}\npub builtin wasm_array_get<t>(value: WasmArray<t>, index: U32) -> t = \"array_get\"\npub type FixedArray<t> = WasmArray<t>\nimpl<t> FixedArray<t> {\n  fn get_unchecked(self, index: U32) -> t {\n    wasm_array_get(self, index)\n  }\n}\nstruct Holder {\n  items: FixedArray<U32>\n}\nimpl Holder {\n  fn read(self, index: U32) -> U32 {\n    self.items.get_unchecked(self.items.get_unchecked(index))\n  }\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() > 0u32, "the fixture must have planned bodies")
  let report = StringBuilder::new()
  report.append(self_host_program_wasm_body_plan_error_report(plan))
  if plan.diagnostics.length() > 0u32 {
    report.append(self_host_physical_test_link_trace(link))
  }
  assert(
    plan.diagnostics.length() == 0u32,
    report.finish(),
  )
}


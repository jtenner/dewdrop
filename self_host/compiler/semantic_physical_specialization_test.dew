test "erased field adapters require declared generic storage and a concrete scalar" {
  let fragments = self_host_physical_test_fragments(
    b"struct Box<t> {\n  value: t\n}\nstruct Scalar {\n  value: I32\n}\npub fn run() -> I32 {\n  0i32\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32])
  let fields = self_host_erased_field_layouts(module_)
  let generic = fields[0u32].field
  let concrete = fields[1u32].field
  assert(self_host_linked_erased_field_box_type(link, generic, SelfHostWasmBodyCarrier::I64BodyCarrier) is Option::Some(_), "a declared generic field can box a proven scalar")
  assert(self_host_linked_erased_field_box_type(link, concrete, SelfHostWasmBodyCarrier::I64BodyCarrier) is Option::None, "a concrete scalar mismatch cannot gain an adapter")
  assert(self_host_linked_erased_field_box_type(link, generic, SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) is Option::None, "missing evidence cannot gain an adapter")
  assert(self_host_linked_erased_field_box_type(link, generic, SelfHostWasmBodyCarrier::ConflictingBodyCarrier) is Option::None, "a conflict cannot gain an adapter")
  assert(self_host_linked_erased_field_box_type(link, 18446744073709551615u64, SelfHostWasmBodyCarrier::I64BodyCarrier) is Option::None, "an unknown field cannot gain an adapter")
}

test "INV-002 rejects semantic errors before specialization" {
  let valid = self_host_physical_test_fragments(b"pub fn run() -> I32 {\n  7i32\n}\n")
  assert(self_host_validate_program_inference(valid.specialization.lowering) is Option::None, "valid inference can cross the phase boundary")
  let invalid = self_host_physical_test_fragments(b"pub fn run() -> I32 {\n  missing()\n}\n")
  match self_host_validate_program_inference(invalid.specialization.lowering) {
    Option::Some(message) => assert(message.starts_with("INV-002:"), "the phase failure has a stable invariant ID")
    Option::None => assert(false, "an unresolved name cannot cross the phase boundary")
  }
}


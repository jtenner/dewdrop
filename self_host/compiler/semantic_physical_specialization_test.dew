pub fn self_host_emit_pattern_guard_probe() -> Bytes {
  let fragments = self_host_physical_test_fragments(
    b"enum Cell {\n  Empty\n  Value(I32)\n}\nstruct Counter {\n  mut calls: U32\n}\nfn check(counter: Counter, value: I32) -> Bool {\n  counter.calls = counter.calls + 1u32\n  value == 7i32\n}\nfn classify(counter: Counter, cell: Cell) -> U32 {\n  match cell {\n    Cell::Value(value) if check(counter, value) => 10u32\n    Cell::Value(_) => 20u32\n    Cell::Empty => 30u32\n  }\n}\nfn conjunction(counter: Counter, cell: Cell) -> U32 {\n  if cell is Cell::Value(value) && check(counter, value) {\n    1u32\n  } else {\n    0u32\n  }\n}\npub fn main() -> U32 {\n  let counter = Counter::{\n    calls: 0u32\n  }\n  let result = classify(counter, Cell::Value(7i32)) + classify(counter, Cell::Value(8i32)) + classify(counter, Cell::Empty) + conjunction(counter, Cell::Value(7i32)) + conjunction(counter, Cell::Value(8i32)) + conjunction(counter, Cell::Empty)\n  result + counter.calls * 100u32\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(bytes) => bytes
    Result::Err(message) => {
      assert(false, message)
      b""
    }
  }
}


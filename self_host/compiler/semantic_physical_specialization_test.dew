test "a method receiver retains its field access" {
  let fragments = self_host_physical_test_fragments(
    b"struct Cell {\n  value: I64\n}\nstruct Holder {\n  cell: Cell\n}\nimpl Cell {\n  fn read(self) -> I64 {\n    self.value\n  }\n}\npub fn run(holder: Holder) -> I64 {\n  holder.cell.read()\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32])
  let mut checked = 0u32
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, _, _) => {
        match self_host_linked_direct_receiver_expression(module_, target) {
          Option::Some(receiver) => assert(module_.expressions[receiver].kind is SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _), "the receiver is holder.cell, not holder")
          Option::None => assert(false, "a selected method must retain its receiver")
        }
        checked = checked + 1u32
      }
      _ => {}
    }
  }
  assert(checked == 1u32, "one method receiver must be inspected")
}

test "field and method dependencies preserve source order" {
  let fragments = self_host_physical_test_fragments(
    b"struct Cell {\n  value: I64\n}\nimpl Cell {\n  fn identity(self) -> Self {\n    self\n  }\n  fn read(self, value: I64) -> I64 {\n    value\n  }\n}\nstruct Holder {\n  cell: Cell\n}\nimpl Holder {\n  fn run(self) -> I64 {\n    self.cell.identity().read(self.cell.value)\n  }\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() == 3u32, "all three methods must have bodies")
  assert(
    plan.diagnostics.length() == 0u32,
    self_host_program_wasm_body_plan_error_report(plan),
  )
}

test "imported fixed array permutation keeps its scalar operands" {
  let collected = self_host_collect_program_manifest(
    5100u64,
    SelfHostProgramManifest::{
      modules: [
        SelfHostManifestModule::{
          path: "app.arr"
          files: [SelfHostManifestFile::{
            path: "arr.dew"
            source: b"pub struct WasmArray<t> {}\npub builtin wasm_array_get<t>(value: WasmArray<t>, index: U32) -> t = \"array_get\"\npub builtin wasm_array_new<t>(length: U32, value: t) -> WasmArray<t> = \"array_new\"\npub builtin wasm_array_set<t>(value: WasmArray<t>, index: U32, item: t) -> Unit = \"array_set\"\npub type FixedArray<t> = WasmArray<t>\nimpl<t> FixedArray<t> {\n  fn make(length: U32, value: t) -> FixedArray<t> {\n    wasm_array_new(length, value)\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    wasm_array_get(self, index)\n  }\n  fn set_unchecked(self, index: U32, value: t) -> Unit {\n    wasm_array_set(self, index, value)\n  }\n}\n"
            test_only: false
          }]
        },
        SelfHostManifestModule::{
          path: "app.main"
          files: [SelfHostManifestFile::{
            path: "main.dew"
            source: b"open app.arr\nfn make_input() -> FixedArray<U32> {\n  FixedArray::make(16u32, 0u32)\n}\npub fn run(message: FixedArray<U32>) -> FixedArray<U32> {\n  let permutation = make_input()\n  let output = FixedArray::make(16u32, 0u32)\n  while 0u32 {\n    index if index < 16u32 => {\n      output.set_unchecked(index, message.get_unchecked(permutation.get_unchecked(index)))\n      continue index + 1u32\n    }\n    _ => break output\n  }\n}\n"
            test_only: false
          }]
        },
      ]
    },
  )
  let fragments = self_host_plan_program_wasmgc_fragments(
    self_host_plan_program_specialization(
      self_host_plan_program_lowering(
        self_host_freeze_program_signature_interfaces(collected),
      ),
      false,
    ),
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() > 0u32, "the fixture must have planned bodies")
  let report = StringBuilder::new()
  report.append(self_host_program_wasm_body_plan_error_report(plan))
  if plan.diagnostics.length() > 0u32 {
    report.append(self_host_physical_test_link_trace(link))
  }
  assert(
    plan.diagnostics.length() == 0u32,
    report.finish(),
  )
}

test "imported static factories use owner identity and arbitrary names" {
  let collected = self_host_collect_program_manifest(
    5200u64,
    SelfHostProgramManifest::{
      modules: [
        SelfHostManifestModule::{
          path: "app.ring"
          files: [SelfHostManifestFile::{
            path: "ring.dew"
            source: b"pub struct WasmArray<t> {}\npub builtin wasm_array_new<t>(length: U32, value: t) -> WasmArray<t> = \"array_new\"\npub type Ring<t> = WasmArray<t>\npub struct Other {}\nimpl Other {\n  fn create(length: U32, value: I64) -> Ring<I64> {\n    wasm_array_new(length, value)\n  }\n}\nimpl<t> Ring<t> {\n  fn create(length: U32, value: t) -> Ring<t> {\n    wasm_array_new(length, value)\n  }\n}\n"
            test_only: false
          }]
        },
        SelfHostManifestModule::{
          path: "app.main"
          files: [SelfHostManifestFile::{
            path: "main.dew"
            source: b"open app.ring\npub fn run() -> Ring<I64> {\n  Ring::create(1u32, 7i64)\n}\n"
            test_only: false
          }]
        },
      ]
    },
  )
  let fragments = self_host_plan_program_wasmgc_fragments(
    self_host_plan_program_specialization(
      self_host_plan_program_lowering(
        self_host_freeze_program_signature_interfaces(collected),
      ),
      false,
    ),
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.bodies.length() > 0u32, "the fixture must have planned bodies")
  let report = StringBuilder::new()
  report.append(self_host_program_wasm_body_plan_error_report(plan))
  if plan.diagnostics.length() > 0u32 {
    report.append(self_host_physical_test_link_trace(link))
  }
  assert(plan.diagnostics.length() == 0u32, report.finish())
  self_host_physical_test_assert_clean_inference(link)
  let body = match self_host_program_wasm_body_plan_for_identity(
    plan, 5201u64, 5201u64 << 32u64, 4294967295u32,
  ) {
    Option::Some(value) => value
    Option::None => {
      assert(false, "the run body must be present")
      unreachable()
    }
  }
  assert(body.calls.length() == 1u32, "run must have exactly one call")
  let callable = match self_host_program_specialization_program_callable(
    link.fragments.specialization.lowering, body.calls[0u32].declaration,
  ) {
    Option::Some(value) => value
    Option::None => {
      assert(false, "the selected factory must be present")
      unreachable()
    }
  }
  assert(
    self_host_linked_resolved_nominal_declaration(
      self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32]),
      callable.self_type,
    ) == 5200u64 << 32u64,
    "the factory must belong to Ring, not an ABI-compatible Other method",
  )
}


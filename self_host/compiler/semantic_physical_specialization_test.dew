pub fn self_host_emit_type_stack_probe() -> Bytes {
  let link = self_host_physical_test_manifest_link(SelfHostProgramManifest::{
    modules: [
      SelfHostManifestModule::{
        path: "dew.std.option"
        files: [SelfHostManifestFile::{
          path: "option.dew"
          source: b"pub enum Option<t> {\n  None\n  Some(t)\n}\n"
          test_only: false
        }]
      },
      SelfHostManifestModule::{
        path: "dew.std.array"
        files: [SelfHostManifestFile::{
          path: "array.dew"
          source: b"pub struct Array<t> {}\npub builtin array_new<t>() -> Array<t> = \"dew_array_new\"\npub builtin array_push<t>(array: Array<t>, value: t) -> Unit = \"dew_array_push\"\npub builtin array_length<t>(array: Array<t>) -> U32 = \"dew_array_length\"\npub builtin array_get<t>(array: Array<t>, index: U32) -> t = \"dew_array_get_unchecked\"\npub builtin array_truncate<t>(array: Array<t>, length: U32) -> Unit = \"dew_array_truncate\"\nimpl<t> Array<t> {\n  fn push(self, value: t) -> Unit {\n    array_push(self, value)\n  }\n  fn length(self) -> U32 {\n    array_length(self)\n  }\n  fn get_unchecked(self, index: U32) -> t {\n    array_get(self, index)\n  }\n  fn truncate(self, length: U32) -> Unit {\n    array_truncate(self, length)\n  }\n}\n"
          test_only: false
        }]
      },
      SelfHostManifestModule::{
        path: "app.main"
        files: [SelfHostManifestFile::{
          path: "main.dew"
          source: b"open dew.std.array\nopen dew.std.option\nenum Task {\n  Visit(I32)\n}\nfn self_host_array_pop<t>(values: Array<t>) -> Option<t> {\n  let length = values.length()\n  if length == 0u32 {\n    Option::None\n  } else {\n    let index = length - 1u32\n    let value = values.get_unchecked(index)\n    values.truncate(index)\n    Option::Some(value)\n  }\n}\nfn unit() -> Unit {\n}\nfn empty_tasks() -> Array<Task> {\n  []\n}\nfn empty_results() -> Array<I32> {\n  []\n}\nfn instantiate(root: I32) -> I32 {\n  let tasks = empty_tasks()\n  let results = empty_results()\n  tasks.push(Task::Visit(root))\n  let _ = while tasks.length() {\n    length => if length > 0u32 {\n      let task = match self_host_array_pop(tasks) {\n        Option::Some(value) => value\n        Option::None => Task::Visit(0i32)\n      }\n      match task {\n        Task::Visit(value) => results.push(-value - 2i32)\n      }\n      continue tasks.length()\n    } else {\n      break unit()\n    }\n  }\n  if results.length() == 1u32 {\n    results.get_unchecked(0u32)\n  } else {\n    0i32\n  }\n}\npub fn main() -> I32 {\n  instantiate(3i32) * 100i32 + instantiate(5i32)\n}\n"
          test_only: false
        }]
      },
    ]
  })
  self_host_physical_test_assert_clean_inference(link)
  match build_self_host_linked_root_i32_module(link, 2u32) {
    Result::Ok(bytes) => bytes
    Result::Err(error) => {
      let report = StringBuilder::new()
      report.append(error)
      report.append(self_host_physical_test_link_trace(link))
      assert(false, report.finish())
      b""
    }
  }
}


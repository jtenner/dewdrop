pub fn self_host_emit_solver_control_probe() -> Bytes {
  let fragments = self_host_physical_test_fragments(
    b"builtin equals(left: String, right: String) -> Bool = \"dew_string_equals\"\nstruct Solver {\n  mut failures: U32\n}\nimpl Solver {\n  fn candidate(self, left: I32, right: I32) -> Bool {\n    let mut viable = self.unify(left, left)\n    if viable {\n      viable = self.unify(left, right)\n    }\n    let _ = while 0u32 {\n      index => if viable && index < 0u32 {\n        viable = true\n        continue index + 1u32\n      } else {\n        break ()\n      }\n    }\n    viable\n  }\n  fn mismatch(self) -> Bool {\n    self.failures = self.failures + 1u32\n    false\n  }\n  fn unify(self, left: I32, right: I32) -> Bool {\n    let _ = while 1u32 {\n      length => if length > 0u32 {\n        if left == right {\n          continue 0u32\n        }\n        let compatible = false\n        if !compatible {\n          return self.mismatch()\n        }\n        continue 0u32\n      } else {\n        break ()\n      }\n    }\n    true\n  }\n}\nfn primitive(name: String) -> I32 {\n  match name {\n    \"Unit\" => 0i32\n    \"I32\" => 2i32\n    \"U32\" => 3i32\n    _ => -1i32\n  }\n}\npub fn main() -> I32 {\n  let solver = Solver::{\n    failures: 0u32\n  }\n  if !solver.unify(-4i32, -5i32) && solver.unify(-4i32, -4i32) && solver.failures == 1u32 && !solver.candidate(-4i32, -5i32) && primitive(\"U32\") == 3i32 && primitive(\"Missing\") == -1i32 {\n    1i32\n  } else {\n    0i32\n  }\n}\n",
  )
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(bytes) => bytes
    Result::Err(message) => {
      assert(false, message)
      b""
    }
  }
}


test "ambiguous concrete trait methods stay ambiguous" {
  let link = self_host_physical_test_trait_link(
    b"pub trait First {\n  fn convert(self) -> U64\n}\npub trait Second {\n  fn convert(self) -> U64\n}\nimpl First for U32 {\n  fn convert(self) -> U64 {\n    7u64\n  }\n}\nimpl Second for U32 {\n  fn convert(self) -> U64 {\n    8u64\n  }\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "one method ambiguity must be reported")
  assert(
    module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::AmbiguousMethod(_, _, _, _, 2u32, _),
    "neither compatible trait method may win by link order",
  )
}


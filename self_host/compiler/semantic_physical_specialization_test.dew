pub fn self_host_emit_string_equality_probe() -> Bytes {
  let fragments = self_host_physical_test_fragments(
    b"builtin concat(left: String, right: String) -> String = \"dew_string_concat\"\nbuiltin equals(left: String, right: String) -> Bool = \"dew_string_equals\"\nstruct Label {\n  name: String\n}\nfn same(left: String, right: String) -> Bool {\n  left == right\n}\nfn different(left: String, right: String) -> Bool {\n  left != right\n}\nfn field_same(left: Label, right: String) -> Bool {\n  left.name == right\n}\npub fn main() -> I32 {\n  let left = concat(\"Op\", \"tion\")\n  let right = concat(\"Opt\", \"ion\")\n  if equals(left, right) && same(left, right) && !different(left, right) && field_same(Label::{\n    name: left\n  }, right) {\n    1i32\n  } else {\n    0i32\n  }\n}\n",
  )

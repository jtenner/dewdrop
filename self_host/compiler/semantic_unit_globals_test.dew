fn self_host_test_global_read_mutation(kind: U32) -> Unit {
  let link = if kind == 2u32 {
    self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
      b"let empty = ()\npub fn main() -> Unit {\n  empty\n}\n",
    ), false)
  } else {
    self_host_initializer_link_fixture()
  }
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid global read before mutation")
  let plan = program.bodies[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Option::Some(value) => value
    Option::None => unreachable()
  }
  let original = link.initializers[0u32]
  let changed = SelfHostPlannedProgramInitializer::{
    module_index: original.module_index
    declaration: original.declaration
    body: original.body
    shape: if kind == 1u32 {
      SelfHostPlannedValueShape::I32PlannedValueShape
    } else if kind == 3u32 {
      SelfHostPlannedValueShape::GenericPlannedValueShape
    } else if kind == 4u32 {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    } else {
      original.shape
    }
    test_only: original.test_only
    global_index: if kind == 0u32 {
      1u32
    } else if kind == 2u32 {
      0u32
    } else {
      original.global_index
    }
    order: original.order
  }
  assert(plan.declaration == ((5100u64 << 32u64) | 1u64), "main body identity")
  self_host_emit_planned_global_get(link, Option::Some(plan), module_, body,
    1u32, changed, StarshineFfi.ffi_ffi_bridge_instructions_new())
}

test "LNK-502 global reads require an assigned physical slot" expect_trap "unreachable" {
  self_host_test_global_read_mutation(0u32)
}

test "ABI-710 global reads match their planned value type" expect_trap "unreachable" {
  self_host_test_global_read_mutation(1u32)
}

test "LNK-502 erased global reads cannot use a physical slot" expect_trap "unreachable" {
  self_host_test_global_read_mutation(2u32)
}

test "SPC-301 global reads cannot emit generic shapes" expect_trap "unreachable" {
  self_host_test_global_read_mutation(3u32)
}

test "SPC-301 global reads cannot emit erroneous shapes" expect_trap "unreachable" {
  self_host_test_global_read_mutation(4u32)
}

test "ARN-106 global read initializer keeps its selected declaration" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let program = self_host_plan_program_wasm_bodies(link)
  let plan = program.bodies[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Option::Some(value) => value
    Option::None => unreachable()
  }
  let original = link.initializers[0u32]
  let changed = SelfHostPlannedProgramInitializer::{
    module_index: original.module_index
    declaration: original.declaration + 1u64
    body: original.body
    shape: original.shape
    test_only: original.test_only
    global_index: original.global_index
    order: original.order
  }
  self_host_emit_planned_global_get(link, Option::Some(plan), module_, body,
    1u32, changed, StarshineFfi.ffi_ffi_bridge_instructions_new())
}

test "global read lookup retains its exact initializer" {
  let link = self_host_initializer_link_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let program = self_host_plan_program_wasm_bodies(link)
  let plan = program.bodies[0u32]
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Option::Some(value) => value
    Option::None => unreachable()
  }
  let selected = self_host_required_global_initializer(link, module_, body, 1u32)
  assert(selected.declaration == link.initializers[0u32].declaration, "exact global declaration")
  assert(selected.global_index == 0u32, "exact physical global slot")
}

fn self_host_test_global_lookup_mutation(kind: U32) -> Unit {
  let link = self_host_initializer_link_fixture()
  let program = self_host_plan_program_wasm_bodies(link)
  let plan = program.bodies[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Option::Some(value) => value
    Option::None => unreachable()
  }
  if kind == 0u32 {
    let _ = link.initializers.pop()
  } else if kind == 1u32 {
    link.initializers.push(link.initializers[0u32])
  } else if kind == 2u32 || kind == 3u32 {
    assert(self_host_linked_callable_function_index(link, plan.declaration) is Option::Some(_), "the named function exists but is not a global")
    let source = module_.expressions[1u32]
    module_.expressions[1u32] = SelfHostPlannedExpression::{
      type_: source.type_
      shape: source.shape
      nominal: source.nominal
      flow: source.flow
      kind: if kind == 2u32 {
        SelfHostPlannedExpressionKind::PlannedModuleValueGet(plan.declaration)
      } else {
        SelfHostPlannedExpressionKind::PlannedUnitConst
      }
      selection: source.selection
      reference: source.reference
      call_target: source.call_target
      call_type_arguments: source.call_type_arguments
      source_name: source.source_name
      member_base: source.member_base
      offset: source.offset
    }
  }
  let _ = self_host_required_global_initializer(link, module_, body, if kind == 4u32 {
    0u32
  } else {
    1u32
  })
}

test "BOD-610 global read cannot lose its initializer" expect_trap "unreachable" {
  self_host_test_global_lookup_mutation(0u32)
}

test "BOD-610 global read requires one initializer" expect_trap "unreachable" {
  self_host_test_global_lookup_mutation(1u32)
}

test "BOD-610 a missing global cannot become a named function" expect_trap "unreachable" {
  self_host_test_global_lookup_mutation(2u32)
}

test "BOD-606 global lookup requires a module-value read" expect_trap "unreachable" {
  self_host_test_global_lookup_mutation(3u32)
}

test "ARN-102 global lookup checks source body ownership" expect_trap "unreachable" {
  self_host_test_global_lookup_mutation(4u32)
}

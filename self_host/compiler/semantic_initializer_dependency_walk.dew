fn self_host_initializer_selected_call(plan: SelfHostProgramSpecializationPlan, calls: Map<U64, Map<U64, U32>>, caller: SelfHostInitializerBodyWork, source: SelfHostPlannedExpression, expression: U32) -> Option<SelfHostInitializerBodyWork> {
  match source.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _),
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _),
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _),
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _),
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _),
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _),
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => {}
    _ => return Option::None
  }
  let expected = self_host_program_specialization_call_recipe(source)
  let selected = match calls.get(caller.body) {
    Option::Some(entries) => entries.get((u32_into_u64(caller.specialization) << 32u64) | u32_into_u64(expression))
    Option::None => Option::None
  }
  let (target, specialization) = match selected {
    Option::Some(index) => {
      if index >= plan.calls.length() {
        self_host_initializer_dependency_failure(caller.declaration, caller.body, expression, 101u32, u32_into_u64(plan.calls.length()), u32_into_u64(index), 25u64)
      }
      let call = plan.calls[index]
      if call.caller_body != caller.body {
        self_host_initializer_dependency_failure(caller.declaration, caller.body, expression, 106u32, caller.body, call.caller_body, 25u64)
      }
      if call.expression != expression {
        self_host_initializer_dependency_failure(caller.declaration, caller.body, expression, 106u32, u32_into_u64(expression), u32_into_u64(call.expression), 25u64)
      }
      if call.caller_specialization != caller.specialization {
        self_host_initializer_dependency_failure(caller.declaration, caller.body, expression, 303u32, u32_into_u64(caller.specialization), u32_into_u64(call.caller_specialization), 25u64)
      }
      match expected {
        Option::Some(recipe) => if recipe.target != call.target {
          self_host_initializer_dependency_failure(caller.declaration, caller.body, expression, 106u32, recipe.target, call.target, 25u64)
        }
        Option::None => {}
      }
      (call.target, call.target_specialization)
    }
    Option::None => match expected {
      Option::Some(recipe) => (recipe.target, 4294967295u32)
      // There is no statically selected body for a dynamic function value or
      // intrinsic index instruction. Indirect effect analysis is separate.
      Option::None => return Option::None
    }
  }
  self_host_initializer_dependency_call_target(plan, caller, expression, target, specialization)
}

fn self_host_initializer_body_dependencies(plan: SelfHostProgramSpecializationPlan, initializer: SelfHostPlannedProgramInitializer, candidates: Array<SelfHostPlannedProgramInitializer>, globals: Map<U64, U32>, calls: Map<U64, Map<U64, U32>>) -> Array<U32> {
  let result = array_new::<U32>()
  let seen_globals = self_host_empty_u64_u32_map()
  let seen_bodies = self_host_program_specialization_call_bodies()
  let work = [SelfHostInitializerBodyWork::{
    module_index: initializer.module_index
    declaration: initializer.declaration
    body: initializer.body
    kind: SelfHostHirBodyKind::ModuleLetBody
    specialization: 4294967295u32
  }]
  while work.pop() {
    Option::Some(task) => {
      let module_ = self_host_initializer_dependency_instance(plan.lowering, task)
      let body = self_host_initializer_dependency_body(module_, task)
      let entries = match seen_bodies.get(task.body) {
        Option::Some(value) => value
        Option::None => {
          let value = self_host_empty_u64_u32_map()
          seen_bodies.set(task.body, value)
          value
        }
      }
      if entries.contains_key(u32_into_u64(task.specialization)) {
        continue work.pop()
      }
      self_host_verify_lowered_body_children_in_phase(module_, body, 4294967295u32, 5u32)
      let (span, root, tag) = match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(value) => (body.expressions, value, 1u32)
        SelfHostHirBodyRoot::BlockBodyRoot(value) => (body.blocks, value, 3u32)
      }
      if root < span.start || root - span.start >= span.length {
        self_host_initializer_dependency_failure(task.declaration, task.body, if tag == 1u32 {
          root
        } else {
          4294967295u32
        }, 102u32, u32_into_u64(span.start), u32_into_u64(root), (u32_into_u64(tag) << 32u64) | u32_into_u64(span.length))
      }
      entries.set(u32_into_u64(task.specialization), 1u32)
      while 0u32 {
        offset if offset < body.expressions.length => {
          let expression = body.expressions.start + offset
          let source = module_.expressions[expression]
          match source.kind {
            SelfHostPlannedExpressionKind::PlannedModuleValueGet(declaration) => {
              let index = match globals.get(declaration) {
                Option::Some(value) => value
                Option::None => self_host_initializer_dependency_failure(task.declaration, task.body, expression, 504u32, 1u64, 0u64, declaration)
              }
              if index >= candidates.length() {
                self_host_initializer_dependency_failure(task.declaration, task.body, expression, 101u32, u32_into_u64(candidates.length()), u32_into_u64(index), declaration)
              }
              if candidates[index].declaration != declaration {
                self_host_initializer_dependency_failure(task.declaration, task.body, expression, 106u32, declaration, candidates[index].declaration, declaration)
              }
              if !seen_globals.contains_key(declaration) {
                seen_globals.set(declaration, index)
                result.push(index)
              }
            }
            _ => match self_host_initializer_selected_call(plan, calls, task, source, expression) {
              Option::Some(next) => work.push(next)
              Option::None => {}
            }
          }
          continue offset + 1u32
        }
        _ => break ()
      }
      continue work.pop()
    }
    Option::None => break ()
  }
  result
}

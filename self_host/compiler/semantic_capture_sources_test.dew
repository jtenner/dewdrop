test "nested closure sources retain direct and forwarded locals" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn maker(seed: I64) -> fn(I64) -> fn() -> I64 {\n  fn(offset: I64) -> fn() -> I64 {\n    fn() -> I64 {\n      seed + offset\n    }\n  }\n}\n"),
    false,
  )
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid nested closures")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.lambdas.length() == 2u32 && module_.captures.length() == 3u32, "one direct and one forwarded inner capture")
  for plan in program.bodies {
    self_host_verify_one_physical_body(link, plan, [])
  }
}

fn self_host_capture_test_resourced(source: SelfHostPlannedCapture, origin: SelfHostLambdaCaptureSource) -> SelfHostPlannedCapture {
  SelfHostPlannedCapture::{
    lambda: source.lambda
    capture: source.capture
    source: origin
    mutable_: source.mutable_
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    offset: source.offset
  }
}

fn self_host_capture_test_bad_source(origin: SelfHostLambdaCaptureSource) -> Unit {
  let fixture = self_host_capture_test_fixture()
  fixture.module_.captures[0u32] = self_host_capture_test_resourced(fixture.module_.captures[0u32], origin)
  self_host_verify_one_physical_body(fixture.link, fixture.plan, [])
}

test "ARN-106 capture sources retain their root body" expect_trap "unreachable" {
  self_host_capture_test_bad_source(SelfHostLambdaCaptureSource::BodyLocalCapture((5100u64 << 32u64) + 1u64, 0u32))
}

test "ARN-104 capture source locals stay in their owning span" expect_trap "unreachable" {
  self_host_capture_test_bad_source(SelfHostLambdaCaptureSource::BodyLocalCapture(5100u64 << 32u64, 1u32))
}

test "ARN-104 capture source lambdas are present" expect_trap "unreachable" {
  self_host_capture_test_bad_source(SelfHostLambdaCaptureSource::LambdaLocalCapture(1u32, 0u32))
}

test "ARN-106 erased captures still require their source owner" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn maker(value: Unit) -> fn() -> Unit {\n  fn() -> Unit {\n    value\n  }\n}\n"),
    false,
  )
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid Unit capture before mutation")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.captures.length() == 1u32, "one logical Unit capture")
  let source = module_.captures[0u32]
  assert(source.shape is SelfHostPlannedValueShape::UnitPlannedValueShape, "the capture must be erased physically")
  module_.captures[0u32] = self_host_capture_test_resourced(source,
    SelfHostLambdaCaptureSource::BodyLocalCapture((5100u64 << 32u64) + 1u64, 0u32),
  )
  for plan in program.bodies {
    if plan.lambda == 0u32 {
      self_host_verify_one_physical_body(link, plan, [])
      return self_host_semantic_unit()
    }
  }
  assert(false, "the Unit lambda plan must be present")
}

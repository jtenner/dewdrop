struct SelfHostCaptureTestFixture {
  link: SelfHostPlannedProgramWasmGCLink
  module_: SelfHostPlannedModuleLowering
  plan: SelfHostPlannedPhysicalBodyCarrierPlan
}

fn self_host_capture_test_fixture() -> SelfHostCaptureTestFixture {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn maker(value: I64) -> fn() -> I64 {\n  fn() -> I64 {\n    value\n  }\n}\npub fn other(value: I64) -> I64 {\n  value\n}\n"),
    false,
  )
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "the original capture plan must be valid")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.lambdas.length() == 1u32 && module_.captures.length() == 1u32, "one lambda and one capture")
  for plan in program.bodies {
    if plan.lambda == 0u32 {
      return {
        link: link
        module_: module_
        plan: plan
      }
    }
  }
  unreachable()
}

fn self_host_capture_test_reidentified(source: SelfHostPlannedCapture, lambda: U32, capture: U32) -> SelfHostPlannedCapture {
  {
    lambda: lambda
    capture: capture
    source: source.source
    mutable_: source.mutable_
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    offset: source.offset
  }
}

test "ARN-106 physical capture entries preserve their relative identity" expect_trap "unreachable" {
  let fixture = self_host_capture_test_fixture()
  let source = fixture.module_.captures[0u32]
  fixture.module_.captures[0u32] = self_host_capture_test_reidentified(source, source.lambda, 1u32)
  self_host_verify_one_physical_body(fixture.link, fixture.plan, [])
}

test "ARN-106 physical capture entries preserve their lambda owner" expect_trap "unreachable" {
  let fixture = self_host_capture_test_fixture()
  let source = fixture.module_.captures[0u32]
  fixture.module_.captures[0u32] = self_host_capture_test_reidentified(source, 1u32, source.capture)
  self_host_verify_one_physical_body(fixture.link, fixture.plan, [])
}

test "ARN-104 physical capture reads require an owning lambda" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedCaptureGet(0u32))
}

test "ARN-104 physical capture reads stay in the lambda capture span" expect_trap "unreachable" {
  let fixture = self_host_capture_test_fixture()
  let body = fixture.module_.lambdas[0u32]
  assert(body.expressions.length == 1u32, "one captured read")
  let expression = body.expressions.start
  fixture.module_.expressions[expression] = self_host_child_test_replace(
    fixture.module_.expressions[expression],
    PlannedCaptureGet(1u32),
  )
  self_host_verify_one_physical_body(fixture.link, fixture.plan, [])
}

fn self_host_test_frozen_program() -> SelfHostPlannedProgramWasmBodyPlan {
  let link = self_host_test_physical_table_link()
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, "valid freeze fixture")
  assert(plan.bodies.length() == 1u32, "one frozen body")
  assert(plan.bodies[0u32].expressions[0u32].expression == 0u32, "source expression identity")
  assert(plan.bodies[0u32].locals.length() == 3u32, "three logical locals")
  assert(plan.bodies[0u32].local_slots[1u32] == 0u32, "physical I64 parameter slot")
  self_host_assert_frozen_body_plan(plan)
  plan
}

test "physical freeze copies array containers and keeps equal records valid" {
  let plan = self_host_test_frozen_program()
  let live = plan.bodies[0u32]
  let original = live.expressions[0u32]
  live.expressions[0u32] = self_host_test_physical_expression_id(original, original.expression)
  self_host_assert_frozen_body_plan(plan)
  let _ = live.expressions.pop()
  assert(plan.frozen_bodies[0u32].expressions.length() == 1u32, "live mutations cannot change the witness")
}

test "BOD-605 frozen programs cannot lose a body" expect_trap "unreachable" {
  let plan = self_host_test_frozen_program()
  let _ = plan.bodies.pop()
  self_host_assert_frozen_body_plan(plan)
}

test "BOD-605 frozen expressions retain their source identity" expect_trap "unreachable" {
  let plan = self_host_test_frozen_program()
  let live = plan.bodies[0u32]
  live.expressions[0u32] = self_host_test_physical_expression_id(live.expressions[0u32], 1u32)
  self_host_assert_frozen_body_plan(plan)
}

test "BOD-605 frozen locals retain their scalar carrier" expect_trap "unreachable" {
  let plan = self_host_test_frozen_program()
  plan.bodies[0u32].locals[1u32] = SelfHostWasmBodyCarrier::I32BodyCarrier
  self_host_assert_frozen_body_plan(plan)
}

test "BOD-605 frozen locals retain their physical slot" expect_trap "unreachable" {
  let plan = self_host_test_frozen_program()
  plan.bodies[0u32].local_slots[1u32] = 1u32
  self_host_assert_frozen_body_plan(plan)
}

test "BOD-605 frozen expressions table length cannot change" expect_trap "unreachable" {
  let plan = self_host_test_frozen_program()
  let _ = plan.bodies[0u32].expressions.pop()
  self_host_assert_frozen_body_plan(plan)
}


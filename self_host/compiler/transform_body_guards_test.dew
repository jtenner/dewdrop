test "signature repair keeps range edges and excludes neighboring repairs" {
  assert(ct_repaired_part(b"abcdef", 1u32, 5u32, [
    CtSourceRepair::{
      start: 0u32
      end: 1u32
      name: "left"
    },
    CtSourceRepair::{
      start: 2u32
      end: 3u32
      name: "X"
    },
    CtSourceRepair::{
      start: 4u32
      end: 5u32
      name: "Y"
    },
    CtSourceRepair::{
      start: 5u32
      end: 6u32
      name: "right"
    },
  ]) == "bXdY", "range repair boundaries")
  assert(ct_repaired_part(b"abcdef", 3u32, 3u32, []) == "", "empty range")
}

        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nstruct Value {\n  value: I32\n}\nimpl Value {\n  fn read(self) -> I32 {\n    true\n  }\n}\nfn compute() -> I32 {\n  let value = Value::{\n    value: 42i32\n  }\n  value.read()\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(compute()))\n}\n#replace\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false

test "transform body guard new result used in a condition" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn predicate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let changed = node.with_return_type(@ast.named_type(\"Bool\")).with_body(@ast.boolean(true))\n  changed.repair_calls_with(@ast.integer(42i32))\n}\n#predicate\nfn answer() -> I32 {\n  0i32\n}\npub fn main() -> I32 {\n  if answer() {\n    42i32\n  } else {\n    0i32\n  }\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => ct_signature_test_recheck(expanded)
    Err(error) => assert(false, error)
  }
}

test "transform body guard invalid executed helper" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn compute() -> I32 {\n  true\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(compute()))\n}\n#replace\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(_) => assert(false, "invalid helper was accepted")
    Err(error) => assert(error.contains("compile-time helper failed source checking"), error)
  }
}


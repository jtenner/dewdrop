test "transform body guard new ordinary call" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn extend(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let changed = node.with_parameters([ctx.parameters[0u32], @ast.parameter(\"bonus\", @ast.named_type(\"I32\"))])\n  let body = changed.with_body(@ast.name(\"value\").binary(\"+\", @ast.name(\"bonus\")))\n  body.repair_calls_with(@ast.name(node.name).call([@ast.name(\"value\"), @ast.integer(2i32)]))\n}\n#extend\nfn answer(value: I32) -> I32 {\n  value\n}\npub fn main() -> I32 {\n  answer(40i32, 2i32)\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => ct_signature_test_recheck(expanded)
    Err(error) => assert(false, error)
  }
}


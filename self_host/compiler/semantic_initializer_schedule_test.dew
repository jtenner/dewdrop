  assert(module_.initialization.diagnostics.length() == 0u32, "fixture is valid")
  module_.bodies.clear()
  let _ = self_host_compile_time_initialization(lowering, 0u32, module_)
}

test "ARN-102 query startup graph checks the root before scanning" expect_trap "unreachable" {
  let lowering = self_host_physical_test_lowering(b"let answer = 42i64\n")
  let module_ = lowering.modules[0u32]
  assert(module_.initialization.diagnostics.length() == 0u32, "fixture is valid")
  let body = module_.bodies[0u32]
  module_.bodies[0u32] = SelfHostPlannedBodyLowering::{
    body: body.body
    declaration: body.declaration
    kind: body.kind
    root: SelfHostHirBodyRoot::ExpressionBodyRoot(1u32)
    root_type: body.root_type
    root_shape: body.root_shape
    result_shape: body.result_shape
    flow: body.flow
    expressions: body.expressions
    blocks: body.blocks
    locals: body.locals
    local_initializers: body.local_initializers
    local_assignments: body.local_assignments
    patterns: body.patterns
    pattern_arms: body.pattern_arms
  }
  let _ = self_host_compile_time_initialization(lowering, 0u32, module_)
}

fn self_host_initializer_order_fixture(inverse: Bool) -> SelfHostPlannedProgramWasmGCLink {
  let root = if inverse {
    b"open app.library\npub struct Marker {}\npub let seed = make_seed()\nfn make_seed() -> I64 {\n  40i64\n}\npub fn read_seed() -> I64 {\n  seed\n}\npub fn main() -> I64 {\n  answer\n}\n"
  } else {
    b"open app.library\npub struct Marker {}\npub let answer = read_seed() + 2i64\npub fn main() -> I64 {\n  answer\n}\n"
  }
  let library = if inverse {
    b"open app.root\npub let answer = read_seed() + 2i64\npub fn accept_marker(value: Marker) -> Marker {\n  value\n}\n"
  } else {
    b"open app.root\npub let seed = make_seed()\nfn make_seed() -> I64 {\n  40i64\n}\npub fn read_seed() -> I64 {\n  seed\n}\npub fn accept_marker(value: Marker) -> Marker {\n  value\n}\n"
  }
  let link = self_host_physical_test_manifest_link(SelfHostProgramManifest::{
    modules: [
      SelfHostManifestModule::{
        path: "app.root"
        files: [SelfHostManifestFile::{
          path: "root.dew"
          source: root
          test_only: false
        }]
      },
      SelfHostManifestModule::{
        path: "app.library"
        files: [SelfHostManifestFile::{
          path: "library.dew"
          source: library
          test_only: false
        }]
      },
    ]
  })
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "a module import cycle is not an initializer cycle")
  link
}

test "startup follows cross-module global reads through called functions" {
  for inverse in [false, true] {
    let link = self_host_initializer_order_fixture(inverse)
    assert(link.initializers.length() == 2u32, "both global initializers remain")
    let seed = if inverse {
      (5500u64 << 32u64) | 1u64
    } else {
      5501u64 << 32u64
    }
    assert(link.initializers[0u32].declaration == seed, "seed must be set before the function reads it")
    assert(self_host_validate_program_wasmgc_link(link) is Option::None, "dependency-first schedule has exact link records")
  }
}

pub fn self_host_emit_initializer_order_probe(source: BytesBuilder) -> Bytes {
  let selector = source.finish()
  assert(selector.byte_length() == 1u32, "startup probe requires one direction selector")
  let link = self_host_initializer_order_fixture(selector.byte_at(0u32) != 0u8)
  match build_self_host_linked_i32_module(link, 5500u64) {
    Result::Ok(bytes) => bytes
    Result::Err(error) => {
      assert(false, error)
      unreachable()
    }
  }
}

test "startup reports a real function-mediated initialization cycle" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"fn read() -> I64 {\n  answer\n}\nlet answer = read()\npub fn main() -> I64 {\n  answer\n}\n",
  ), false)
  assert(link.diagnostics.length() == 1u32, "one real startup cycle")
  match link.diagnostics[0u32] {
    SelfHostProgramWasmGCLinkDiagnostic::EagerProgramInitializationCycle(declaration, dependency) => {
      assert(declaration == ((5100u64 << 32u64) | 1u64), "cycle names the initializer")
      assert(dependency == declaration, "the function reads its own caller's global")
    }
    _ => assert(false, "expected a startup cycle diagnostic")
  }
  assert(self_host_validate_program_wasmgc_link(link) is Option::Some(_), "a cycle cannot pass the emission boundary")
}

test "startup visits recursive calls once and keeps unique global edges" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"let seed = 40i64\nfn read(flag: Bool) -> I64 {\n  if flag {\n    read(false)\n  } else {\n    seed + seed - 40i64\n  }\n}\npub let answer = read(true) + 2i64\n",
  ), false)
  assert(link.diagnostics.length() == 0u32, "recursive calls do not loop in dependency analysis")
  let candidates = link.initializers
  let values = self_host_initializer_body_dependencies(link.fragments.specialization,
    candidates[1u32], candidates, self_host_initializer_candidate_index(candidates),
    self_host_initializer_dependency_calls(link.fragments.specialization.calls))
  assert(values.length() == 1u32 && values[0u32] == 0u32, "repeated reads share one dependency edge")
}

test "startup keeps real cycles in selected Unit query branches" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"builtin is_unit<t>() -> Bool = \"types.is_unit\"\nfn choose<t>() -> I64 {\n  if is_unit::<t>() {\n    answer\n  } else {\n    42i64\n  }\n}\nlet answer = choose::<Unit>()\npub fn main() -> I64 {\n  answer\n}\n",
  ), false)
  assert(link.diagnostics.length() == 1u32, "selected branch keeps its real cycle")
  assert(link.diagnostics[0u32] is SelfHostProgramWasmGCLinkDiagnostic::EagerProgramInitializationCycle(_, _), "query cycle is a semantic diagnostic")
}

test "SPC-304 startup cannot use a generic query template without its call record" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"builtin is_unit<t>() -> Bool = \"types.is_unit\"\nfn choose<t>() -> I64 {\n  if is_unit::<t>() {\n    answer\n  } else {\n    42i64\n  }\n}\nlet answer = choose::<I32>()\npub fn main() -> I64 {\n  answer\n}\n",
  ), false)
  assert(link.diagnostics.length() == 0u32, "removed branch has no cycle before mutation")
  link.fragments.specialization.calls.clear()
  let candidates = link.initializers
  let _ = self_host_initializer_body_dependencies(link.fragments.specialization,
    candidates[0u32], candidates, self_host_initializer_candidate_index(candidates),
    self_host_initializer_dependency_calls(link.fragments.specialization.calls))
}

fn self_host_startup_global_lookup_mutation(kind: U32) -> Unit {
  let link = self_host_initializer_order_fixture(false)
  let candidates = link.initializers
  let globals = self_host_initializer_candidate_index(candidates)
  let seed = 5501u64 << 32u64
  assert(candidates[0u32].declaration == seed, "exact seed identity before mutation")
  if kind == 0u32 {
    let _ = globals.remove(seed)
  } else {
    globals.set(seed, if kind == 1u32 {
      99u32
    } else {
      1u32
    })
  }
  let _ = self_host_initializer_body_dependencies(link.fragments.specialization,
    candidates[1u32], candidates, globals,
    self_host_initializer_dependency_calls(link.fragments.specialization.calls))
}

test "LNK-504 startup cannot lose a global dependency lookup" expect_trap "unreachable" {
  self_host_startup_global_lookup_mutation(0u32)
}


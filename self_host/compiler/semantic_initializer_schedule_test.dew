  self_host_startup_global_lookup_mutation(1u32)
}

test "ARN-106 startup checks a global dependency declaration" expect_trap "unreachable" {
  self_host_startup_global_lookup_mutation(2u32)
}

test "ARN-106 startup called body lookup checks stored identity" expect_trap "unreachable" {
  let link = self_host_initializer_order_fixture(false)
  let plan = link.fragments.specialization
  let module_ = plan.lowering.modules[1u32]
  assert(module_.bodies[2u32].body == ((5501u64 << 32u64) | 2u64), "selected reader body before mutation")
  let _ = module_.bodies.remove(2u32)
  let candidates = link.initializers
  let _ = self_host_initializer_body_dependencies(plan,
    candidates[1u32], candidates, self_host_initializer_candidate_index(candidates),
    self_host_initializer_dependency_calls(plan.calls))
}

fn self_host_startup_call_mutation(kind: U32) -> Unit {
  let link = self_host_initializer_order_fixture(false)
  let plan = link.fragments.specialization
  assert(plan.calls.length() == 0u32, "plain calls use exact declarations without generic records")
  match plan.lowering.modules[0u32].expressions[1u32].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(target, _, _, _) => {
      assert(target == ((5501u64 << 32u64) | 2u64), "source call has the exact reader target")
    }
    _ => assert(false, "fixture expression is a direct call")
  }
  // An identical exact replay is valid for a plain call too. Seed one before
  // mutating it; otherwise an absent optional record would not test identity.
  plan.calls.push(SelfHostProgramSpecializedCall::{
    caller_body: 5500u64 << 32u64
    caller_specialization: 4294967295u32
    expression: 1u32
    target: (5501u64 << 32u64) | 2u64
    target_specialization: 4294967295u32
  })
  let calls = self_host_initializer_dependency_calls(plan.calls)
  let valid = self_host_initializer_body_dependencies(plan,
    link.initializers[1u32], link.initializers,
    self_host_initializer_candidate_index(link.initializers), calls)
  assert(valid.length() == 1u32 && valid[0u32] == 0u32, "valid exact replay retains the seed edge before mutation")
  let mut changed = false
  while 0u32 {
    index if index < plan.calls.length() => {
      let call = plan.calls[index]
      if call.caller_body == (5500u64 << 32u64) && call.expression == 1u32 {
        assert(call.target == ((5501u64 << 32u64) | 2u64), "exact reader declaration before mutation")
        assert(call.caller_specialization == 4294967295u32, "plain initializer before mutation")
        assert(plan.requests.length() == 0u32, "plain fixture has no generic requests")
        plan.calls[index] = SelfHostProgramSpecializedCall::{
          caller_body: if kind == 0u32 {
            call.caller_body + 1u64
          } else {
            call.caller_body
          }
          caller_specialization: if kind == 2u32 {
            0u32
          } else {
            call.caller_specialization
          }
          expression: if kind == 1u32 {
            call.expression + 1u32
          } else {
            call.expression
          }
          target: if kind == 3u32 {
            call.target + 1u64
          } else {
            call.target
          }
          target_specialization: if kind == 4u32 {
            99u32
          } else {
            call.target_specialization
          }
        }
        changed = true
        break ()
      }
      continue index + 1u32
    }
    _ => break ()
  }
  assert(changed, "fixture contains the caller's exact record")
  let candidates = link.initializers
  let _ = self_host_initializer_body_dependencies(plan,
    candidates[1u32], candidates, self_host_initializer_candidate_index(candidates), calls)
}

test "ARN-106 startup call record keeps its caller body" expect_trap "unreachable" {
  self_host_startup_call_mutation(0u32)
}


fn self_host_startup_postcondition_mutation(kind: U32) -> Unit {
  let link = self_host_initializer_order_fixture(false)
  let candidates = link.initializers
  let dependencies = [array_new::<U32>(), [0u32]]
  let output = candidates.copy()
  self_host_verify_initializer_dependency_order(candidates, dependencies, output)
  if kind == 0u32 {
    dependencies[0u32] = [1u32]
  } else if kind == 1u32 {
    dependencies[1u32] = [99u32]
  } else if kind == 2u32 {
    let _ = dependencies.pop()
  } else {
    let _ = output.pop()
  }
  self_host_verify_initializer_dependency_order(candidates, dependencies, output)
}

test "LNK-501 startup verifies every dependency precedes its reader" expect_trap "unreachable" {
  self_host_startup_postcondition_mutation(0u32)
}


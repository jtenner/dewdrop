open dew.std.array
open dew.std.option

fn self_host_lambda_owner_callable(module_: SelfHostPlannedModuleLowering, body_id: U64) -> Option<SelfHostPlannedCallable> {
  match self_host_program_specialization_body(module_, body_id) {
    Option::Some(body) => self_host_program_specialization_callable(module_, body.declaration)
    Option::None => Option::None
  }
}

fn self_host_lambda_owner_is_generic(module_: SelfHostPlannedModuleLowering, body_id: U64) -> Bool {
  match self_host_lambda_owner_callable(module_, body_id) {
    Option::Some(owner) => self_host_u32_greater(self_host_program_specialization_callable_generics(owner).length, 0u32)
    Option::None => false
  }
}

fn self_host_lambda_request_shape(module_: SelfHostPlannedModuleLowering, request: Option<SelfHostProgramSpecializationRequest>, shapes: Array<SelfHostPlannedValueShape>, type_: I32, fallback: SelfHostPlannedValueShape) -> SelfHostPlannedValueShape {
  match request {
    Option::Some(selected) => match self_host_program_specialization_callable(module_, selected.declaration) {
      Option::Some(owner) => match self_host_program_specialization_resolved_type(module_, type_) {
        Option::Some(resolved) => return self_host_wasmgc_specialized_resolved_shape(
          module_, resolved, self_host_program_specialization_callable_generics(owner), selected, shapes, fallback,
        )
        Option::None => {}
      }
      Option::None => {}
    }
    Option::None => {}
  }
  fallback
}

fn self_host_lambda_physical_shape(module_: SelfHostPlannedModuleLowering, lambda: SelfHostPlannedLambdaLowering, shape: SelfHostPlannedValueShape, detail: U32) -> SelfHostPlannedValueShape {
  let error = self_host_specialization_shape_error(shape)
  let declaration = match self_host_lambda_owner_callable(module_, lambda.root_body) {
    Option::Some(owner) => owner.declaration
    Option::None => 0u64
  }
  let _ = self_host_assert_compiler_invariant_with_failure(
    self_host_u32_equal(error, 0u32),
    SelfHostInvariantFailure::{
      code: 301u32
      phase: 4u32
      module_id: module_.module_id
      declaration: declaration
      body: lambda.root_body
      expression: lambda.expressions.start
      expected: 0u64
      actual: u32_into_u64(error)
      detail: u32_into_u64(detail)
    },
    "lambda physical shapes require concrete specialization evidence",
  )
  shape
}

fn self_host_wasmgc_append_lambda_closure(module_: SelfHostPlannedModuleLowering, lambda: SelfHostPlannedLambdaLowering, request: Option<SelfHostProgramSpecializationRequest>, request_index: U32, shapes: Array<SelfHostPlannedValueShape>, physical_types: Array<SelfHostPlannedWasmPhysicalType>, fields: Array<SelfHostPlannedWasmField>) -> U32 {
  let type_index = physical_types.length()
  let field_start = fields.length()
  fields.push(SelfHostPlannedWasmField::{
    role: SelfHostPlannedWasmFieldRole::WasmClosureEntryField
    declaration: 0u64
    physical_index: 0u32
    storage: SelfHostPlannedWasmStorageType::WasmNullableFuncRefStorage
    mutable_: false
    exact_nominal: false
    offset: 0u32
  })
  let mut index = 0u32
  while index {
    _ => if index < lambda.captures.length {
      let capture = module_.captures[lambda.captures.start + index]
      let shape = self_host_lambda_physical_shape(module_, lambda,
        self_host_lambda_request_shape(module_, request, shapes, capture.type_, capture.shape), index,
      )
      if self_host_capture_has_value(shape) {
        fields.push(SelfHostPlannedWasmField::{
          role: SelfHostPlannedWasmFieldRole::WasmLambdaCaptureField(lambda.lambda, index)
          declaration: 0u64
          physical_index: fields.length() - field_start
          storage: if capture.mutable_ {
            SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage
          } else {
            self_host_wasmgc_storage_type(shape)
          }
          mutable_: false
          exact_nominal: false
          offset: capture.offset
        })
      }
      index = index + 1u32
      continue index
    } else {
      break self_host_semantic_unit()
    }
  }
  physical_types.push(SelfHostPlannedWasmPhysicalType::{
    kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(lambda.lambda, request_index)
    type_index: type_index
    fields: SelfHostHirSpan::{
      start: field_start
      length: fields.length() - field_start
    }
    offset: 0u32
  })
  type_index
}

fn self_host_wasmgc_append_specialized_lambdas(module_: SelfHostPlannedModuleLowering, request: SelfHostProgramSpecializationRequest, request_index: U32, shapes: Array<SelfHostPlannedValueShape>, physical_types: Array<SelfHostPlannedWasmPhysicalType>, fields: Array<SelfHostPlannedWasmField>, functions: Array<SelfHostPlannedWasmFunctionFragment>, value_types: Array<SelfHostPlannedWasmValueType>) -> Unit {
  if module_.lambdas.length() == 0u32 {
    return
  }
  let mut index = 0u32
  while index {
    _ => if index < module_.locals.length() {
      let local = self_host_body_planned_local_identity(module_.locals[index])
      if self_host_local_needs_capture_cell(module_, local) {
        match self_host_lambda_owner_callable(module_, local.body) {
          Option::Some(owner) => if self_host_u64_equal(owner.declaration, request.declaration) {
            let shape = self_host_lambda_request_shape(module_, Option::Some(request), shapes, local.type_, local.shape)
            if self_host_capture_has_value(shape) {
              let type_index = physical_types.length()
              let field_start = fields.length()
              fields.push(SelfHostPlannedWasmField::{
                role: SelfHostPlannedWasmFieldRole::WasmCaptureCellValueField(index)
                declaration: 0u64
                physical_index: 0u32
                storage: self_host_wasmgc_storage_type(shape)
                mutable_: true
                exact_nominal: false
                offset: local.offset
              })
              physical_types.push(SelfHostPlannedWasmPhysicalType::{
                kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmCaptureCellType(index, request_index)
                type_index: type_index
                fields: SelfHostHirSpan::{
                  start: field_start
                  length: 1u32
                }
                offset: local.offset
              })
            }
          }
          Option::None => {}
        }
      }
      index = index + 1u32
      continue index
    } else {
      break self_host_semantic_unit()
    }
  }
  for lambda in module_.lambdas {
    match self_host_lambda_owner_callable(module_, lambda.root_body) {
      Option::Some(owner) => if self_host_u64_equal(owner.declaration, request.declaration) {
        let _ = self_host_wasmgc_append_lambda_closure(module_, lambda, Option::Some(request), request_index, shapes, physical_types, fields)
        self_host_wasmgc_append_lambda_function_for_request(module_, lambda, Option::Some(request), request_index, shapes, functions, value_types)
      }
      Option::None => {}
    }
  }
}

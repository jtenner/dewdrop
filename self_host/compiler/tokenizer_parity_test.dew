open dew.std.array
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.math
open dew.std.testing

fn tokenizer_parity_kind(tokens: Array<SelfHostToken>, index: U32) -> SelfHostTokenKind {
  tokens.get_unchecked(index).kind
}

fn tokenizer_parity_unit() -> Unit {
}

test "self-host tokenizer supports every integer width and legacy suffix" {
  let tokens = self_host_tokenize(b"1i8 2i16 3i32 4i64 5u8 6u16 7u32 8u64 9 10U 11L 12UL 1_000")
  assert(tokens.length() == 13u32, "wrong width token count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::I8(1u64), "wrong i8")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::I16(2u64), "wrong i16")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::I32(3u64), "wrong i32")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::I64(4u64), "wrong i64")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::U8(5u64), "wrong u8")
  assert(tokenizer_parity_kind(tokens, 5u32) is SelfHostTokenKind::U16(6u64), "wrong u16")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::U32(7u64), "wrong u32")
  assert(tokenizer_parity_kind(tokens, 7u32) is SelfHostTokenKind::U64(8u64), "wrong u64")
  assert(tokenizer_parity_kind(tokens, 8u32) is SelfHostTokenKind::I32(9u64), "wrong default")
  assert(tokenizer_parity_kind(tokens, 9u32) is SelfHostTokenKind::U32(10u64), "wrong U")
  assert(tokenizer_parity_kind(tokens, 10u32) is SelfHostTokenKind::I64(11u64), "wrong L")
  assert(tokenizer_parity_kind(tokens, 11u32) is SelfHostTokenKind::U64(12u64), "wrong UL")
  assert(tokenizer_parity_kind(tokens, 12u32) is SelfHostTokenKind::I32(1000u64), "wrong separators")
}

test "self-host tokenizer enforces every integer boundary" {
  let tokens = self_host_tokenize(b"128i8 129i8 255u8 256u8 32768i16 32769i16 65535u16 65536u16 2147483648i32 2147483649i32 4294967295u32 4294967296u32 9223372036854775808i64 9223372036854775809i64 18446744073709551615u64 18446744073709551616u64")
  assert(tokens.length() == 16u32, "wrong boundary token count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::I8(128u64), "rejected i8 signed-min magnitude")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidInteger("129i8")), "accepted i8 overflow")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::U8(255u64), "rejected u8 max")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Error(_), "accepted u8 overflow")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::I16(32768u64), "rejected i16 boundary")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::U16(65535u64), "rejected u16 max")
  assert(tokenizer_parity_kind(tokens, 8u32) is SelfHostTokenKind::I32(2147483648u64), "rejected i32 boundary")
  assert(tokenizer_parity_kind(tokens, 10u32) is SelfHostTokenKind::U32(4294967295u64), "rejected u32 max")
  assert(tokenizer_parity_kind(tokens, 12u32) is SelfHostTokenKind::I64(9223372036854775808u64), "rejected i64 boundary")
  assert(tokenizer_parity_kind(tokens, 14u32) is SelfHostTokenKind::U64(18446744073709551615u64), "rejected u64 max")
  assert(tokenizer_parity_kind(tokens, 15u32) is SelfHostTokenKind::Error(_), "accepted u64 overflow")
}

test "self-host tokenizer rejects malformed integer suffixes" {
  let tokens = self_host_tokenize(b"1i 2i7 3u 4u128")
  assert(tokens.length() == 5u32, "wrong malformed suffix recovery")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidInteger("1i ")), "accepted bare i")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidInteger("2i7")), "accepted i7")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidInteger("3u ")), "accepted bare u")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidInteger("4u1")), "wrong u128 error span")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::I32(28u64), "lost trailing width digits")
}

test "self-host tokenizer supports decimal floats and width suffixes" {
  let tokens = self_host_tokenize(b"1.25 .5 6.022e23 1_000.5 1.0e-3 2.5F .25F 3.5f32 4.5f64")
  assert(tokens.length() == 9u32, "wrong float token count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::F64(1.25f64), "wrong 1.25")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::F64(0.5f64), "wrong .5")
  match tokenizer_parity_kind(tokens, 2u32) {
    SelfHostTokenKind::F64(value) => assert(value > 6.021e23f64 && value < 6.023e23f64, "wrong exponent")
    _ => assert(false, "missing exponent float")
  }
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::F64(1000.5f64), "wrong separated float")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::F64(0.001f64), "wrong negative exponent")
  assert(tokenizer_parity_kind(tokens, 5u32) is SelfHostTokenKind::F32(2.5f32), "wrong F float")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::F32(0.25f32), "wrong leading-dot F")
  assert(tokenizer_parity_kind(tokens, 7u32) is SelfHostTokenKind::F32(3.5f32), "wrong f32")
  assert(tokenizer_parity_kind(tokens, 8u32) is SelfHostTokenKind::F64(4.5f64), "wrong f64")
}

test "self-host tokenizer rejects malformed float forms and recovers" {
  let tokens = self_host_tokenize(b"1e+ 2e3 4F 4.0__5 1.0e 2.0f16 next")
  assert(tokens.length() == 7u32, "wrong malformed float count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidFloat("1e+")), "accepted exponent without dot")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidFloat("2e3")), "accepted dotless exponent")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidFloat("4F")), "accepted integer F")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidFloat("4.0__5")), "accepted bad fraction separators")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::Error(_), "accepted empty exponent")
  assert(tokenizer_parity_kind(tokens, 5u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidFloat("2.0f16")), "accepted f16")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::Identifier("next"), "did not recover after floats")
}

test "self-host tokenizer joins marked multiline strings" {
  let tokens = self_host_tokenize(b"#|alpha\n  #|beta\r\n\t#|gamma\r  let")
  assert(tokens.length() == 3u32, "wrong multiline token count")
  match tokenizer_parity_kind(tokens, 0u32) {
    SelfHostTokenKind::MultilineString(value) => assert(value.equals(b"alpha\nbeta\ngamma"), "wrong multiline bytes")
    _ => assert(false, "missing multiline literal")
  }
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Newline, "lost terminating newline")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Let), "did not resume after multiline")
}

test "self-host tokenizer terminates multiline strings at EOF" {
  let tokens = self_host_tokenize(b"#|tail")
  assert(tokens.length() == 1u32, "wrong EOF multiline count")
  match tokenizer_parity_kind(tokens, 0u32) {
    SelfHostTokenKind::MultilineString(value) => assert(value.equals(b"tail"), "wrong EOF multiline bytes")
    _ => assert(false, "missing EOF multiline")
  }
}

test "self-host tokenizer skips non-line Unicode whitespace" {
  let tokens = self_host_tokenize(b"a\xC2\xA0b\xE2\x80\x83c\xE3\x80\x80d")
  assert(tokens.length() == 4u32, "Unicode whitespace was not skipped")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Identifier("a"), "wrong a")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Identifier("d"), "wrong d")
}

test "self-host tokenizer rejects WTF-8 surrogates outside literals" {
  let tokens = self_host_tokenize(b"\xED\xA0\x80 \"\xED\xA0\x80\"")
  assert(tokens.length() == 2u32, "wrong surrogate token count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::UnexpectedUnit(55296u32)), "surrogate was not one error")
  match tokenizer_parity_kind(tokens, 1u32) {
    SelfHostTokenKind::StringLiteral(value) => assert(value.equals(b"\xED\xA0\x80"), "string lost surrogate")
    _ => assert(false, "missing surrogate string")
  }
}

test "self-host tokenizer preserves each malformed byte and continues" {
  let tokens = self_host_tokenize(b"\xC0\xAF\xE2\x82A")
  assert(tokens.length() == 5u32, "malformed bytes were grouped")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::UnexpectedUnit(1114304u32)), "wrong C0 sentinel")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Error(SelfHostLexError::UnexpectedUnit(1114287u32)), "wrong AF sentinel")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Error(SelfHostLexError::UnexpectedUnit(1114338u32)), "wrong E2 sentinel")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Error(SelfHostLexError::UnexpectedUnit(1114242u32)), "wrong 82 sentinel")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::Identifier("A"), "did not recover")
}

test "self-host tokenizer handles large trivia and identifier input linearly" {
  let builder = BytesBuilder::with_capacity(200005u32)
  while 0u32 {
    index if index < 100000u32 => {
      builder.append_byte(32u8)
      continue index + 1u32
    }
    _ => break tokenizer_parity_unit()
  }
  builder.append(b"name")
  while 0u32 {
    index if index < 100000u32 => {
      builder.append_byte(95u8)
      continue index + 1u32
    }
    _ => break tokenizer_parity_unit()
  }
  let tokens = self_host_tokenize(builder.finish())
  assert(tokens.length() == 1u32, "large input made extra tokens")
  assert(tokens.get_unchecked(0u32).has_location(100000u32, 0u32), "large offset was wrong")
}

test "self-host tokenizer covers every reserved keyword" {
  let tokens = self_host_tokenize(b"fn test pub builtin foreign impl trait for enum struct type let using mut if else match is while loop return defer break continue true false as in where open import export package")
  assert(tokens.length() == 33u32, "wrong complete keyword count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Fn), "wrong Fn keyword")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Test), "wrong Test keyword")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Pub), "wrong Pub keyword")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Builtin), "wrong Builtin keyword")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Foreign), "wrong Foreign keyword")
  assert(tokenizer_parity_kind(tokens, 5u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Impl), "wrong Impl keyword")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Trait), "wrong Trait keyword")
  assert(tokenizer_parity_kind(tokens, 7u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::For), "wrong For keyword")
  assert(tokenizer_parity_kind(tokens, 8u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Enum), "wrong Enum keyword")
  assert(tokenizer_parity_kind(tokens, 9u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Struct), "wrong Struct keyword")
  assert(tokenizer_parity_kind(tokens, 10u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Type), "wrong Type keyword")
  assert(tokenizer_parity_kind(tokens, 11u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Let), "wrong Let keyword")
  assert(tokenizer_parity_kind(tokens, 12u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Using), "wrong Using keyword")
  assert(tokenizer_parity_kind(tokens, 13u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Mut), "wrong Mut keyword")
  assert(tokenizer_parity_kind(tokens, 14u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::If), "wrong If keyword")
  assert(tokenizer_parity_kind(tokens, 15u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Else), "wrong Else keyword")
  assert(tokenizer_parity_kind(tokens, 16u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Match), "wrong Match keyword")
  assert(tokenizer_parity_kind(tokens, 17u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Is), "wrong Is keyword")
  assert(tokenizer_parity_kind(tokens, 18u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::While), "wrong While keyword")
  assert(tokenizer_parity_kind(tokens, 19u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Loop), "wrong Loop keyword")
  assert(tokenizer_parity_kind(tokens, 20u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Return), "wrong Return keyword")
  assert(tokenizer_parity_kind(tokens, 21u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Defer), "wrong Defer keyword")
  assert(tokenizer_parity_kind(tokens, 22u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Break), "wrong Break keyword")
  assert(tokenizer_parity_kind(tokens, 23u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Continue), "wrong Continue keyword")
  assert(tokenizer_parity_kind(tokens, 24u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::True), "wrong True keyword")
  assert(tokenizer_parity_kind(tokens, 25u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::False), "wrong False keyword")
  assert(tokenizer_parity_kind(tokens, 26u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::As), "wrong As keyword")
  assert(tokenizer_parity_kind(tokens, 27u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::In), "wrong In keyword")
  assert(tokenizer_parity_kind(tokens, 28u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Where), "wrong Where keyword")
  assert(tokenizer_parity_kind(tokens, 29u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Open), "wrong Open keyword")
  assert(tokenizer_parity_kind(tokens, 30u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Import), "wrong Import keyword")
  assert(tokenizer_parity_kind(tokens, 31u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Export), "wrong Export keyword")
  assert(tokenizer_parity_kind(tokens, 32u32) is SelfHostTokenKind::Keyword(SelfHostKeyword::Package), "wrong Package keyword")
}

test "self-host tokenizer covers every fixed symbol" {
  let tokens = self_host_tokenize(b"(){}[]^+-*/**%:::= == => != <= >= << >> && || ,;...<>!&|->")
  assert(tokens.length() == 34u32, "wrong complete symbol count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LeftParen), "wrong LeftParen symbol")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::RightParen), "wrong RightParen symbol")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LeftBrace), "wrong LeftBrace symbol")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::RightBrace), "wrong RightBrace symbol")
  assert(tokenizer_parity_kind(tokens, 4u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LeftBracket), "wrong LeftBracket symbol")
  assert(tokenizer_parity_kind(tokens, 5u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::RightBracket), "wrong RightBracket symbol")
  assert(tokenizer_parity_kind(tokens, 6u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Caret), "wrong Caret symbol")
  assert(tokenizer_parity_kind(tokens, 7u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Plus), "wrong Plus symbol")
  assert(tokenizer_parity_kind(tokens, 8u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Minus), "wrong Minus symbol")
  assert(tokenizer_parity_kind(tokens, 9u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Star), "wrong Star symbol")
  assert(tokenizer_parity_kind(tokens, 10u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Slash), "wrong Slash symbol")
  assert(tokenizer_parity_kind(tokens, 11u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Exponent), "wrong Exponent symbol")
  assert(tokenizer_parity_kind(tokens, 12u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Percent), "wrong Percent symbol")
  assert(tokenizer_parity_kind(tokens, 13u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::DoubleColon), "wrong DoubleColon symbol")
  assert(tokenizer_parity_kind(tokens, 14u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Colon), "wrong Colon symbol")
  assert(tokenizer_parity_kind(tokens, 15u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Equal), "wrong Equal symbol")
  assert(tokenizer_parity_kind(tokens, 16u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::EqualEqual), "wrong EqualEqual symbol")
  assert(tokenizer_parity_kind(tokens, 17u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::FatArrow), "wrong FatArrow symbol")
  assert(tokenizer_parity_kind(tokens, 18u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::BangEqual), "wrong BangEqual symbol")
  assert(tokenizer_parity_kind(tokens, 19u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LessEqual), "wrong LessEqual symbol")
  assert(tokenizer_parity_kind(tokens, 20u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::GreaterEqual), "wrong GreaterEqual symbol")
  assert(tokenizer_parity_kind(tokens, 21u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::ShiftLeft), "wrong ShiftLeft symbol")
  assert(tokenizer_parity_kind(tokens, 22u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::ShiftRight), "wrong ShiftRight symbol")
  assert(tokenizer_parity_kind(tokens, 23u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LogicalAnd), "wrong LogicalAnd symbol")
  assert(tokenizer_parity_kind(tokens, 24u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::LogicalOr), "wrong LogicalOr symbol")
  assert(tokenizer_parity_kind(tokens, 25u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Comma), "wrong Comma symbol")
  assert(tokenizer_parity_kind(tokens, 26u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Semicolon), "wrong Semicolon symbol")
  assert(tokenizer_parity_kind(tokens, 27u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Ellipsis), "wrong Ellipsis symbol")
  assert(tokenizer_parity_kind(tokens, 28u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Less), "wrong Less symbol")
  assert(tokenizer_parity_kind(tokens, 29u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Greater), "wrong Greater symbol")
  assert(tokenizer_parity_kind(tokens, 30u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Bang), "wrong Bang symbol")
  assert(tokenizer_parity_kind(tokens, 31u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Ampersand), "wrong Ampersand symbol")
  assert(tokenizer_parity_kind(tokens, 32u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Pipe), "wrong Pipe symbol")
  assert(tokenizer_parity_kind(tokens, 33u32) is SelfHostTokenKind::Symbol(SelfHostSymbol::Arrow), "wrong Arrow symbol")
}

test "self-host tokenizer handles all string escapes" {
  let tokens = self_host_tokenize(b"\"\\\"\\\\\\n\\r\\t\\0\\b\\f\\x41\"")
  assert(tokens.length() == 1u32, "wrong escaped string count")
  match tokenizer_parity_kind(tokens, 0u32) {
    SelfHostTokenKind::StringLiteral(value) => assert(value.equals(b"\"\\\n\r\t\x00\x08\x0CA"), "wrong complete escape payload")
    _ => assert(false, "missing escaped string")
  }
}

test "self-host tokenizer rejects bad and truncated escapes without stalling" {
  let bad = self_host_tokenize(b"\"\\q")
  assert(bad.length() == 1u32, "bad escape made extra tokens")
  assert(tokenizer_parity_kind(bad, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidEscape(113u32)), "accepted bad escape")
  let truncated = self_host_tokenize(b"\"\\xF")
  assert(truncated.length() == 1u32, "truncated hex made extra tokens")
  assert(tokenizer_parity_kind(truncated, 0u32) is SelfHostTokenKind::Error(SelfHostLexError::InvalidEscape(120u32)), "accepted truncated hex")
}

test "self-host tokenizer bounds huge exponent work" {
  let builder = BytesBuilder::with_capacity(100004u32)
  builder.append(b"1.0e")
  while 0u32 {
    index if index < 100000u32 => {
      builder.append_byte(57u8)
      continue index + 1u32
    }
    _ => break tokenizer_parity_unit()
  }
  let tokens = self_host_tokenize(builder.finish())
  assert(tokens.length() == 1u32, "huge exponent made extra tokens")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::F64(_), "huge exponent was not a float")
}

test "self-host tokenizer preserves F64 boundary rounding" {
  let tokens = self_host_tokenize(b"5.0e-324 2.2250738585072014e-308 1.7976931348623157e308")
  assert(tokens.length() == 3u32, "wrong F64 boundary count")
  match tokenizer_parity_kind(tokens, 0u32) {
    SelfHostTokenKind::F64(value) => assert(f64_to_bits(value) == 1u64, "lost minimum subnormal")
    _ => assert(false, "minimum subnormal was not F64")
  }
  match tokenizer_parity_kind(tokens, 1u32) {
    SelfHostTokenKind::F64(value) => assert(f64_to_bits(value) == 4503599627370496u64, "wrong minimum normal")
    _ => assert(false, "minimum normal was not F64")
  }
  match tokenizer_parity_kind(tokens, 2u32) {
    SelfHostTokenKind::F64(value) => assert(f64_to_bits(value) == 9218868437227405311u64, "wrong maximum finite")
    _ => assert(false, "maximum finite was not F64")
  }
}

test "self-host tokenizer matches difficult decimal rounding" {
  let tokens = self_host_tokenize(b"0.1 0.29 1.2345678901234567 9007199254740991.0")
  assert(tokens.length() == 4u32, "wrong difficult decimal count")
  assert(tokenizer_parity_kind(tokens, 0u32) is SelfHostTokenKind::F64(0.1f64), "wrong 0.1 rounding")
  assert(tokenizer_parity_kind(tokens, 1u32) is SelfHostTokenKind::F64(0.29f64), "wrong 0.29 rounding")
  assert(tokenizer_parity_kind(tokens, 2u32) is SelfHostTokenKind::F64(1.2345678901234567f64), "wrong long decimal rounding")
  assert(tokenizer_parity_kind(tokens, 3u32) is SelfHostTokenKind::F64(9007199254740991.0f64), "wrong integer precision boundary")
}

test "self-host tokenizer rounds long decimal tails to even" {
  let tokens = self_host_tokenize(b"1.00000000000000011102230246251565404236316680908203125 1.00000000000000011102230246251565404236316680908203126")
  assert(tokens.length() == 2u32, "wrong halfway decimal count")
  match tokenizer_parity_kind(tokens, 0u32) {
    SelfHostTokenKind::F64(value) => assert(f64_to_bits(value) == 4607182418800017408u64, "halfway decimal did not round to even")
    _ => assert(false, "halfway decimal was not F64")
  }
  match tokenizer_parity_kind(tokens, 1u32) {
    SelfHostTokenKind::F64(value) => assert(f64_to_bits(value) == 4607182418800017409u64, "above-halfway decimal did not round up")
    _ => assert(false, "above-halfway decimal was not F64")
  }
}

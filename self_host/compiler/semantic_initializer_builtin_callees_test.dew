test "initializer builtin call callees have no runtime global read" {
  let collected = self_host_collect_program_manifest(5100u64, {
    modules: [{
      path: "app.main"
      files: [{
        path: "initializer-builtin.dew"
        source: b"builtin product(left: I32, right: I32) -> I32 = \"i32.mul\"\nfn multiply(left: I32, right: I32) -> I32 {\n  product(left, right)\n}\nlet factor = 6i32\nlet answer = multiply(factor, 7i32)\npub fn main() -> I32 {\n  answer\n}\n"
        test_only: false
      }]
    }]
  })
  assert(collected.diagnostics.length() == 0u32, "initializer manifest parses")
  assert(collected.modules.at(0u32).diagnostic_count() == 0u32, "initializer source parses")
  let frozen = self_host_freeze_program_signature_interfaces(collected)
  assert(frozen.import_diagnostics.length() == 0u32 && frozen.path_diagnostics.length() == 0u32, "initializer imports resolve")
  let lowering = self_host_plan_program_lowering(frozen)
  match self_host_validate_program_inference(lowering) {
    Some(error) => assert(false, error)
    None => {}
  }
  let module_ = lowering.modules[0u32]
  let factor = collected.modules.at(0u32).declarations[2u32].id
  let answer = collected.modules.at(0u32).declarations[3u32].id
  let mut factor_read = false
  let mut answer_read = false
  let mut builtin_callees = 0u32
  let mut direct_callees = 0u32
  for expression in module_.expressions {
    match expression.kind {
      PlannedBuiltinCall(_, _, target, _, _) => {
        builtin_callees = builtin_callees + 1u32
        assert(target < module_.expressions.length(), "builtin callee stays in its source arena")
        assert(module_.expressions[target].kind is PlannedConsumedExpression, "direct builtin callee must not be a phantom module-value read")
      }
      PlannedDirectCall(_, target, _, _) => {
        direct_callees = direct_callees + 1u32
        assert(target < module_.expressions.length(), "ordinary callee stays in its source arena")
        assert(module_.expressions[target].kind is PlannedConsumedExpression, "ordinary direct callee remains consumed")
      }
      PlannedModuleValueGet(declaration) => {
        if declaration == factor {
          factor_read = true
        } else if declaration == answer {
          answer_read = true
        } else {
          assert(false, "module-value read must name a real module let")
        }
      }
      _ => {}
    }
  }
  assert(factor_read && answer_read, "genuine factor and answer reads remain in the checked plan")
  assert(builtin_callees == 1u32 && direct_callees == 1u32, "both checked call forms were inspected")
  let fragments = self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, false))
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  assert(link.diagnostics.length() == 0u32, "initializer dependency planning succeeds")
  assert(link.initializers.length() == 2u32, "both real module lets remain scheduled")
  assert(link.initializers[0u32].declaration == collected.modules.at(0u32).declarations[2u32].id, "factor is scheduled before answer")
  assert(link.initializers[1u32].declaration == collected.modules.at(0u32).declarations[3u32].id, "answer retains its factor dependency")
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, physical))
}

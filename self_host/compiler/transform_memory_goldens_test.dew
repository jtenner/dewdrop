fn ct_memory_golden_case(opcode: String, args: Array<CtValue>, expected: CtValue, expected_memory: Bytes) -> Unit {
  let (machine, _) = ct_bc_test_machine(b"fn compute() -> I32 {\n 42i32\n}\n", true)
  let memory = wasm_array_new_default::<U8>(65536u32)
  let _ = while 0u32 {
    i if i < 32u32 => {
      wasm_array_set(memory, i, u32_into_u8((i * 37u32 + 129u32) % 256u32))
      continue i + 1u32
    }
    _ => break ()
  }
  machine.memory = Some(memory)
  let code = match ct_memory_opcode(opcode) {
    Some(code) => code
    None => {
      assert(false, "missing memory opcode")
      return
    }
  }
  let value = ct_memory_instruction(machine, code, args)
  assert(machine.error.byte_length() == 0u32, machine.error)
  match (value, expected) {
    (Empty, Empty) => {}
    (Number(a, ak), Number(b, bk)), (Floating(a, ak), Floating(b, bk)) => assert(a == b && ak == bk, "scalar load golden")
    (Vector(al, ah), Vector(bl, bh)) => assert(al == bl && ah == bh, "vector load golden")
    _ => assert(false, "memory result carrier golden")
  }
  let _ = while 0u32 {
    i if i < expected_memory.byte_length() => {
      assert(wasm_array_get(memory, i) == expected_memory.byte_at(i), "store byte golden")
      continue i + 1u32
    }
    _ => break ()
  }
}

test "all catalog memory operations match fixed byte goldens" {
  ct_memory_golden_case("i32.load", [CtValue::Number(3u64, "U32")], CtValue::Number(1597642224u64, "I32"), b"")
  ct_memory_golden_case("i32.load8_s", [CtValue::Number(3u64, "U32")], CtValue::Number(4294967280u64, "I32"), b"")

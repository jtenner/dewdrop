fn self_host_capture_cell_shape_test(shape: SelfHostPlannedValueShape) -> Unit {
  let lowering = self_host_physical_test_lowering(b"pub fn make(seed: I64) -> fn() -> I64 {\n  let mut value = seed\n  fn() -> I64 {\n    value = value + 1i64\n    value\n  }\n}\n")
  let module_ = lowering.modules[0u32]
  assert(module_.inferred.diagnostics.length() == 0u32, "valid mutable capture source")
  let source = module_.locals[1u32]
  assert(source.local_id == 1u32 && source.mutable_ && source.shape is SelfHostPlannedValueShape::I64PlannedValueShape, "owned I64 captured local before mutation")
  assert(self_host_local_needs_capture_cell(module_, source), "live mutable capture needs a cell")
  module_.locals[1u32] = SelfHostPlannedLocal::{
    body: source.body
    lambda: source.lambda
    local_id: source.local_id
    elided: source.elided
    kind: source.kind
    mutable_: source.mutable_
    type_: source.type_
    shape: shape
    nominal: source.nominal
    offset: source.offset
  }
  let types = []
  let fields = []
  let cells = self_host_wasmgc_u32_slots(module_.locals.length())
  let lambdas = self_host_wasmgc_u32_slots(module_.lambdas.length())
  let _ = self_host_wasmgc_plan_closures(module_, types, fields, cells, lambdas)
  if shape is SelfHostPlannedValueShape::I64PlannedValueShape {
    assert(cells[1u32] != 4294967295u32, "concrete captured local has a cell")
    let field = fields[types[cells[1u32]].fields.start]
    assert(field.storage is SelfHostPlannedWasmStorageType::WasmI64Storage, "cell retains I64 storage")
  }
}

test "capture cells retain concrete physical storage" {
  self_host_capture_cell_shape_test(SelfHostPlannedValueShape::I64PlannedValueShape)
}

test "SPC-301 capture cells cannot use Generic evidence" expect_trap "unreachable" {
  self_host_capture_cell_shape_test(SelfHostPlannedValueShape::GenericPlannedValueShape)
}

test "SPC-301 capture cells cannot use Error evidence" expect_trap "unreachable" {
  self_host_capture_cell_shape_test(SelfHostPlannedValueShape::ErrorPlannedValueShape)
}

test "SPC-301 capture cell products cannot hide Error evidence" expect_trap "unreachable" {
  self_host_capture_cell_shape_test(SelfHostPlannedValueShape::ProductPlannedValueShape([
    SelfHostPlannedValueShape::I64PlannedValueShape,
    SelfHostPlannedValueShape::ErrorPlannedValueShape,
  ]))
}

fn self_host_specialized_capture_cell_shape_test(shape: SelfHostPlannedValueShape) -> Unit {
  let lowering = self_host_physical_test_lowering(b"fn make<t>(seed: t) -> fn() -> t {\n  let mut value = seed\n  fn() -> t {\n    value = value\n    value\n  }\n}\npub fn run() -> I64 {\n  let next = make(3i64)\n  next()\n}\n")
  let module_ = lowering.modules[0u32]
  assert(module_.inferred.diagnostics.length() == 0u32, "valid generic mutable capture")
  let specialization = self_host_plan_program_specialization(lowering, false)
  assert(specialization.requests.length() == 1u32, "one exact generic owner request")
  let request = specialization.requests[0u32]
  assert(request.declaration == module_.functions.callables[0u32].declaration && request.shapes.length == 1u32, "exact make request")
  assert(specialization.shapes[request.shapes.start] is SelfHostPlannedValueShape::I64PlannedValueShape, "concrete request before mutation")
  specialization.shapes[request.shapes.start] = shape
  let types = []
  let fields = []
  self_host_wasmgc_append_specialized_lambdas(module_, request, 0u32, specialization.shapes, types, fields, [], [])
  if shape is SelfHostPlannedValueShape::I64PlannedValueShape {
    let mut cells = 0u32
    for type_ in types {
      if type_.kind is SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmCaptureCellType(1u32, 0u32) {
        assert(fields[type_.fields.start].storage is SelfHostPlannedWasmStorageType::WasmI64Storage, "selected cell uses I64")
        cells = cells + 1u32
      }
    }
    assert(cells == 1u32, "one concrete specialized cell")
  }
}

test "generic capture cells use selected physical storage" {
  self_host_specialized_capture_cell_shape_test(SelfHostPlannedValueShape::I64PlannedValueShape)
}

test "SPC-301 specialized capture cells cannot use Generic evidence" expect_trap "unreachable" {
  self_host_specialized_capture_cell_shape_test(SelfHostPlannedValueShape::GenericPlannedValueShape)
}

test "SPC-301 specialized capture cells cannot use Error evidence" expect_trap "unreachable" {
  self_host_specialized_capture_cell_shape_test(SelfHostPlannedValueShape::ErrorPlannedValueShape)
}

test "SPC-301 specialized capture products cannot hide Error evidence" expect_trap "unreachable" {
  self_host_specialized_capture_cell_shape_test(SelfHostPlannedValueShape::ProductPlannedValueShape([
    SelfHostPlannedValueShape::I64PlannedValueShape,
    SelfHostPlannedValueShape::ErrorPlannedValueShape,
  ]))
}

test "Unit capture cells are erased after specialization" {
  let fragments = self_host_physical_test_fragments(b"fn make<t>(seed: t) -> fn() -> t {\n  let mut value = seed\n  fn() -> t {\n    value = value\n    value\n  }\n}\npub fn run() -> Unit {\n  let next = make(())\n  next()\n}\n")
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "Unit capture plan links")
  for type_ in fragments.modules[0u32].physical_types {
    assert(!(type_.kind is SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmCaptureCellType(_, _)), "Unit produces no physical cell")
  }
}

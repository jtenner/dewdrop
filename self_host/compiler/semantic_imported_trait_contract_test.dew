fn self_host_imported_trait_contract(consumer: Bytes, library: Bytes) -> SelfHostModuleImplIndex {
  let program = self_host_collect_program_manifest(5700u64, {
    modules: [
      {
        path: "app.consumer"
        files: [{
          path: "consumer.dew"
          source: consumer
          test_only: false
        }]
      },
      {
        path: "app.contract"
        files: [{
          path: "contract.dew"
          source: library
          test_only: false
        }]
      },
    ]
  })
  assert(program.diagnostics.length() == 0u32, "trait fixture program collection")
  for module_ in program.modules.values {
    assert(module_.diagnostic_count() == 0u32, "trait fixture source collection")
  }
  let frozen = self_host_freeze_program_signature_interfaces(program)
  let imports = self_host_resolve_module_imports(frozen.interfaces.at(0u32).resolved_types, frozen.import_scopes.at(0u32))
  assert(imports.resolved.diagnostics.length() == 0u32, "trait fixture resolved types")
  self_host_index_module_implementations_with_imports(program.modules.at(0u32), imports)
}

fn self_host_imported_read_contract(consumer: Bytes) -> SelfHostModuleImplIndex {
  self_host_imported_trait_contract(consumer,
    b"pub struct P0 {}\npub struct P1 {}\npub struct P2 {}\npub struct P3 {}\npub struct P4 {}\npub struct P5 {}\npub struct P6 {}\npub struct P7 {}\npub struct P8 {}\npub struct P9 {}\npub trait Read<t> {\n  fn read(self) -> t\n}\n",
  )
}

test "imported trait contracts keep the owner's generic arena" {
  let index = self_host_imported_read_contract(
    b"open app.contract\nstruct Box {}\nimpl Read<I64> for Box {\n  fn read(self) -> I64 {\n    42i64\n  }\n}\n",
  )
  assert(index.diagnostic_count() == 0u32, "valid imported trait implementation")
  assert(index.implementations[0u32].coherent, "valid imported implementation is coherent")
}

test "imported trait contracts check return types" {
  let index = self_host_imported_read_contract(
    b"open app.contract\nstruct Box {}\nimpl Read<I64> for Box {\n  fn read(self) -> I32 {\n    42i32\n  }\n}\n",
  )
  assert(index.diagnostic_count() == 1u32, "one bad return type")
  assert(index.diagnostic_at(0u32) is TraitMethodReturnTypeMismatch(_, _, _), "exact return diagnostic")
  assert(!index.implementations[0u32].coherent, "bad return cannot provide evidence")
}

test "imported trait contracts require every method" {
  let index = self_host_imported_read_contract(b"open app.contract\nstruct Box {}\nimpl Read<I64> for Box {}\n")
  assert(index.diagnostic_count() == 1u32, "one missing method")
  assert(index.diagnostic_at(0u32) is MissingTraitMethod(_, _, _), "exact missing diagnostic")
}

test "imported trait contracts check receiver presence" {
  let index = self_host_imported_read_contract(
    b"open app.contract\nstruct Box {}\nimpl Read<I64> for Box {\n  fn read(value: Box) -> I64 {\n    42i64\n  }\n}\n",
  )
  assert(index.diagnostic_count() == 1u32, "one receiver mismatch")
  assert(index.diagnostic_at(0u32) is TraitMethodReceiverMismatch(_, _, _), "exact receiver diagnostic")
}

test "imported trait method generics preserve their own identities" {
  let index = self_host_imported_trait_contract(
    b"open app.contract\nstruct Box {}\nimpl Convert<I64> for Box {\n  fn convert<v>(self, value: v, other: I64) -> v {\n    value\n  }\n}\n",
    b"pub trait Convert<t> {\n  fn convert<u>(self, value: u, other: t) -> u\n}\n",
  )
  assert(index.diagnostic_count() == 0u32, "owner and method generics are separate")
}

test "imported trait contracts check substituted parameter types" {
  let index = self_host_imported_trait_contract(
    b"open app.contract\nstruct Box {}\nimpl Convert<I64> for Box {\n  fn convert<v>(self, value: v, other: I32) -> v {\n    value\n  }\n}\n",
    b"pub trait Convert<t> {\n  fn convert<u>(self, value: u, other: t) -> u\n}\n",
  )
  assert(index.diagnostic_count() == 1u32, "one substituted parameter mismatch")
  assert(index.diagnostic_at(0u32) is TraitMethodParameterTypeMismatch(_, _, 2u32, _), "exact parameter diagnostic")
}

test "imported trait contracts check method generic counts" {
  let index = self_host_imported_trait_contract(
    b"open app.contract\nstruct Box {}\nimpl Convert<I64> for Box {\n  fn convert(self, value: I64, other: I64) -> I64 {\n    value\n  }\n}\n",
    b"pub trait Convert<t> {\n  fn convert<u>(self, value: u, other: t) -> u\n}\n",
  )
  assert(index.diagnostic_count() == 1u32, "one method generic count mismatch")
  assert(index.diagnostic_at(0u32) is TraitMethodGenericParameterCountMismatch(_, _, 1u32, 0u32, _), "exact method generic diagnostic")
}

test "ARN-106 imported generic spans cannot alias a local declaration" expect_trap "unreachable" {
  let collected = self_host_collect_bytes(5700u64, b"struct Box {}\n")
  let _ = collected.generic_parameters_of(self_host_make_semantic_id(5701u64, 0u32))
}

test "ARN-106 imported parameter spans cannot alias a local declaration" expect_trap "unreachable" {
  let collected = self_host_collect_bytes(5700u64, b"struct Box {}\n")
  let _ = collected.parameters_of(self_host_make_semantic_id(5701u64, 0u32))
}

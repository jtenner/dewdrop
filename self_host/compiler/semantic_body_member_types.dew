open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result
open dew.std.string

fn self_host_empty_member_parameters() -> Array<U64> {
  []
}

fn self_host_empty_member_bindings() -> Map<U64, I32> {
  empty()
}

pub struct SelfHostBodyMemberTypeDeclaration {
  parameters: Array<U64>
  fields: Map<String, U32>
  variants: Map<String, Array<U32>>
}

pub struct SelfHostBodyMemberTypeContext {
  declarations: Map<U64, SelfHostBodyMemberTypeDeclaration>
}

struct SelfHostPendingMemberEquation {
  left: I32
  right: I32
  origin: SelfHostTypeConstraintOrigin
}

fn self_host_empty_member_marks() -> Map<I32, Bool> {
  empty()
}

fn self_host_empty_member_fields() -> Map<String, U32> {
  empty()
}

fn self_host_empty_member_variants() -> Map<String, Array<U32>> {
  empty()
}

fn self_host_empty_member_declarations() -> Map<U64, SelfHostBodyMemberTypeDeclaration> {
  empty()
}

fn self_host_body_member_type_context(collected: SelfHostCollectedModule, resolved: SelfHostResolvedModuleTypes, imported: SelfHostBasicImportedInputs) -> Option<SelfHostBodyMemberTypeContext> {
  let mut needed = false
  for type_ in resolved.types {
    if type_ is MemberTypeProjection(_, _, _) {
      needed = true
    }
  }
  if !needed {
    return None
  }
  let declarations = self_host_empty_member_declarations()
  for entry in collected.declarations {
    if entry.kind is StructDecl || entry.kind is EnumDecl {
      let parameters = self_host_empty_member_parameters()
      let span = collected.generic_parameters_of(entry.id)
      let _ = while 0u32 {
        index => if index < span.length {
          parameters.push(collected.generic_parameter_at(span.start + index).id)
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      declarations.set(entry.id, {
        parameters: parameters
        fields: self_host_empty_member_fields()
        variants: self_host_empty_member_variants()
      })
    }
  }
  let _ = while 0u32 {
    index => if index < collected.fields.length() {
      let field = collected.fields[index]
      if field.variant is None {
        match declarations.get(field.declaration) {
          Some(owner) => owner.fields.set(collected.name(field.name), resolved.field_types[index])
          None => {}
        }
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = while 0u32 {
    index => if index < collected.variants.length() {
      let variant = collected.variants[index]
      match declarations.get(variant.declaration) {
        Some(owner) => {
          let payload = self_host_u32_slots(0u32, 0u32)
          if variant.kind is StructVariantDecl {
            let _ = while 0u32 {
              field_index => if field_index < collected.fields.length() {
                let field = collected.fields[field_index]
                if field.variant is Some(id) && id == variant.id {
                  payload.push(resolved.field_types[field_index])
                }
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          } else {
            let span = resolved.variant_payloads[index]
            self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, resolved.signature_type_lists.length()), "ARN-101 member projection payload recipe")
            let _ = while 0u32 {
              offset => if offset < span.length {
                payload.push(resolved.signature_type_lists[span.start + offset])
                continue offset + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          owner.variants.set(collected.name(variant.name), payload)
        }
        None => {}
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  // Nominal nodes are interned once. Walk that arena instead of requesting a
  // runtime Map iterator while the bootstrap compiler builds member recipes.
  for type_ in resolved.types {
    match type_ {
      NominalType(declaration) => if !declarations.contains_key(declaration) {
        match imported.type_generic_spans.get(declaration) {
          Some(span) => {
            self_host_assert_array_span(span.start, span.length, imported.generic_parameter_ids.length(), "ARN-101 imported member generic IDs")
            let parameters = self_host_empty_member_parameters()
            let _ = while 0u32 {
              index => if index < span.length {
                parameters.push(imported.generic_parameter_ids[span.start + index])
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            declarations.set(declaration, {
              parameters: parameters
              fields: self_host_empty_member_fields()
              variants: self_host_empty_member_variants()
            })
          }
          None => {}
        }
      }
      _ => {}
    }
  }
  for field in imported.fields {
    if field.variant is None {
      match declarations.get(field.declaration) {
        Some(owner) => owner.fields.set(field.name, field.type_)
        None => {}
      }
    }
  }
  for variant in imported.variants {
    match declarations.get(variant.declaration) {
      Some(owner) => {
        let payload = self_host_u32_slots(0u32, 0u32)
        if variant.kind is StructVariantDecl {
          for field in imported.fields {
            if field.variant is Some(id) && id == variant.variant {
              payload.push(field.type_)
            }
          }
        } else {
          let span = variant.payload_types
          self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, imported.variant_payload_types.length()), "ARN-101 imported member projection payload recipe")
          let _ = while 0u32 {
            index => if index < span.length {
              payload.push(imported.variant_payload_types[span.start + index])
              continue index + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        owner.variants.set(variant.name, payload)
      }
      None => {}
    }
  }
  Some({
    declarations: declarations
  })
}

impl SelfHostLocalTypeSolver {
  fn has_pending_member_projection(self, root: I32) -> Bool {
    let work = [root]
    let seen = self_host_empty_member_marks()
    let _ = while work.pop() {
      Some(source) => {
        let type_ = self.representative_type(source)
        if type_ <= 0i32 || seen.contains_key(type_) {
          continue work.pop()
        }
        seen.set(type_, true)
        let span = match self.type_term(type_) {
          BodyMemberTypeProjection(owner, _, _) => {
            match self.reduce_member_type(type_, 0u32) {
              Err(_) => continue work.pop()
              Ok(reduced) => if reduced != type_ {
                work.push(reduced)
                continue work.pop()
              }
            }
            if self.has_unresolved_variable(owner) {
              return true
            }
            work.push(owner)
            continue work.pop()
          }
          BodyProductType(span) => span
          BodyAppliedType(base, span) => {
            work.push(base)
            span
          }
          BodyFunctionType(span, result) => {
            work.push(result)
            span
          }
          _ => continue work.pop()
        }
        self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.type_arguments.length()), "ARN-101 pending member projection children")
        let _ = while 0u32 {
          index => if index < span.length {
            work.push(self.type_arguments[span.start + index])
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        continue work.pop()
      }
      None => break self_host_semantic_unit()
    }
    false
  }
  fn member_projection_type(self, owner: I32, operation: Bytes, selector: String) -> I32 {
    let owner = self.representative_type(owner)
    match self.type_term(owner) {
      BodyResolvedType(resolved_owner) => {
        let _ = while 0u32 {
          index => if index < self.resolved.types.length() {
            match self.resolved.types[index] {
              MemberTypeProjection(input, op, name) => if input == resolved_owner && op == operation && name == selector {
                return self.resolved_type(index)
              }
              _ => {}
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      _ => {}
    }
    self.push_type_term(BodyMemberTypeProjection(owner, operation, selector))
  }

  fn member_projection(self, type_: I32) -> Option<(I32, Bytes, String)> {
    match self.type_term(type_) {
      BodyMemberTypeProjection(owner, operation, selector) => Some((owner, operation, selector))
      BodyResolvedType(id) => match self.resolved.types[id] {
        MemberTypeProjection(owner, operation, selector) => Some((self.resolved_type(owner), operation, selector))
        _ => None
      }
      _ => None
    }
  }

  fn substitute_member_type(self, type_: U32, bindings: Map<U64, I32>, depth: U32) -> Result<I32, String> {
    if depth >= 256u32 {
      return Err("CT-034 member projection limit exceeded")
    }
    match self.resolved.types[type_] {
      GenericParameterType(parameter) => Ok(match bindings.get(parameter) {
        Some(value) => value
        None => self.resolved_type(type_)
      })
      SelfType(parameter) => Ok(match bindings.get(parameter) {
        Some(value) => value
        None => self.resolved_type(type_)
      })
      MemberTypeProjection(owner, operation, selector) => match self.substitute_member_type(owner, bindings, depth + 1u32) {
        Ok(owner) => self.reduce_member_type(self.member_projection_type(owner, operation, selector), depth + 1u32)
        Err(error) => Err(error)
      }
      type_term => {
        let span = match type_term {
          ProductType(span) => span
          AppliedType(_, span) => span
          FunctionType(span, _) => span
          _ => return Ok(self.resolved_type(type_))
        }
        self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.resolved.type_arguments.length()), "ARN-101 member substitution arguments")
        let values = self_host_local_empty_i32()
        let _ = while 0u32 {
          index => if index < span.length {
            match self.substitute_member_type(self.resolved.type_arguments[span.start + index], bindings, depth + 1u32) {
              Ok(value) => values.push(value)
              Err(error) => return Err(error)
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        match type_term {
          AppliedType(base, _) => match self.substitute_member_type(base, bindings, depth + 1u32) {
            Ok(base) => Ok(self.applied_type(base, values))
            Err(error) => Err(error)
          }
          FunctionType(_, result) => match self.substitute_member_type(result, bindings, depth + 1u32) {
            Ok(result) => Ok(self.function_type(values, result))
            Err(error) => Err(error)
          }
          _ => Ok(self.product_type(values))
        }
      }
    }
  }

  fn reduce_member_type(self, type_: I32, depth: U32) -> Result<I32, String> {
    if depth >= 256u32 {
      return Err("CT-034 member projection limit exceeded")
    }
    let type_ = self.representative_type(type_)
    let projection = match self.member_projection(type_) {
      Some(value) => value
      None => return Ok(type_)
    }
    let (owner, operation, selector) = projection
    if !self_host_computed_type_builtin(operation) {
      return Err("CT-033 invalid member projection operation")
    }
    let owner = match self.reduce_member_type(owner, depth + 1u32) {
      Ok(value) => value
      Err(error) => return Err(error)
    }
    let arguments = self_host_local_empty_i32()
    let base = match self.type_term(owner) {
      BodyAppliedType(base, span) => {
        self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.type_arguments.length()), "ARN-101 inferred member owner arguments")
        let _ = while 0u32 {
          index => if index < span.length {
            arguments.push(self.type_arguments[span.start + index])
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        base
      }
      BodyResolvedType(index) => match self.resolved.types[index] {
        AppliedType(base, span) => {
          self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.resolved.type_arguments.length()), "ARN-101 resolved member owner arguments")
          let _ = while 0u32 {
            index => if index < span.length {
              arguments.push(self.resolved_type(self.resolved.type_arguments[span.start + index]))
              continue index + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          self.resolved_type(base)
        }
        _ => owner
      }
      _ => owner
    }
    let declaration = match self.type_term(self.representative_type(base)) {
      BodyVariableType(_) => return Ok(type_)
      BodyMemberTypeProjection(_, _, _) => return Ok(type_)
      BodyResolvedType(index) => match self.resolved.types[index] {
        NominalType(declaration) => declaration
        GenericParameterType(_) => return Ok(type_)
        SelfType(_) => return Ok(type_)
        MemberTypeProjection(_, _, _) => return Ok(type_)
        _ => return Err("CT-032 member type query requires a struct or enum")
      }
      _ => return Err("CT-032 member type query requires a struct or enum")
    }
    let context = match self.member_types {
      Some(value) => value
      None => return Err("CT-032 missing member type context")
    }
    let recipe = match context.declarations.get(declaration) {
      Some(value) => value
      None => return Err("CT-032 missing member type declaration")
    }
    if arguments.length() != recipe.parameters.length() {
      return Err("CT-031 member owner has the wrong generic arity")
    }
    let templates = if operation == b"types.field_type" {
      match recipe.fields.get(selector) {
        Some(value) => [value]
        None => return Err("CT-032 no such field")
      }
    } else {
      match recipe.variants.get(selector) {
        Some(value) => value
        None => return Err("CT-032 no such variant")
      }
    }
    let bindings = self_host_empty_member_bindings()
    let _ = while 0u32 {
      index => if index < recipe.parameters.length() {
        bindings.set(recipe.parameters[index], arguments[index])
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let values = self_host_local_empty_i32()
    for template in templates {
      match self.substitute_member_type(template, bindings, depth + 1u32) {
        Ok(value) => values.push(value)
        Err(error) => return Err(error)
      }
    }
    Ok(if operation == b"types.field_type" {
      values[0u32]
    } else {
      self.product_type(values)
    })
  }

  fn zonk_member_type(self, type_: I32) -> I32 {
    match self.reduce_member_type(type_, 0u32) {
      Ok(value) => value
      Err(message) => {
        self.diagnostics.push(InvalidLocalMemberProjection(type_, message, self_host_synthetic_type_origin(4294967295u32, 0u32)))
        self.error_type()
      }
    }
  }
}

impl SelfHostBasicBodyInferencer {
  fn constrain_pending_member_equations(self, final_: Bool) -> Bool {
    let mut kept = 0u32
    let mut progress = false
    for equation in self.pending_member_equations {
      if !final_ && (self.solver.has_pending_member_projection(equation.left) || self.solver.has_pending_member_projection(equation.right)) {
        self.pending_member_equations[kept] = equation
        kept = kept + 1u32
      } else {
        let _ = self.solver.unify(equation.left, equation.right, equation.origin)
        progress = true
      }
    }
    self.pending_member_equations.truncate(kept)
    progress
  }
}

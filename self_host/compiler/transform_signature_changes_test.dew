test "transform signatures reject duplicate generated parameter names" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn bad(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_parameters([@ast.parameter(\"value\", @ast.named_type(\"I32\")), @ast.parameter(\"value\", @ast.named_type(\"I32\"))])\n}\n#bad\npub fn main() -> I32 {\n  42i32\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(_) => assert(false, "invalid transform signature was accepted")
    Err(error) => assert(error.contains("invalid or duplicate generated parameter name"), error)
  }
}

test "transform signatures reject invalid generated type names" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{

test "transform signatures stack preserves changed signature and adapter" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn extend(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let changed = node.with_parameters([ctx.parameters[0u32], @ast.parameter(\"bonus\", @ast.named_type(\"I32\"))])\n  changed.repair_calls_with(@ast.name(node.name).call([@ast.name(\"value\"), @ast.integer(0i32)]))\n}\ntransform fn keep(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.prepend(@ast.unit())\n}\n#extend\n#keep\nfn answer(value: I32) -> I32 {\n  value\n}\npub fn main() -> I32 {\n  answer(42i32)\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => ct_signature_test_recheck(expanded)
    Err(error) => assert(false, error)
  }
}

test "transform signatures repair earlier imported calls and references" {
  let manifest = SelfHostProgramManifest::{
    modules: [SelfHostManifestModule::{
      path: "app"
      files: [SelfHostManifestFile::{
        path: "main.dew"
        source: b"import helper as @h\npub fn main() -> I32 {\n  let callback = @h.answer\n  callback(40i32) + @h.answer(2i32)\n}\n"
        test_only: false
      }]
    }, SelfHostManifestModule::{
      path: "helper"
      files: [SelfHostManifestFile::{
        path: "helper.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn extend(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let changed = node.with_parameters([ctx.parameters[0u32], @ast.parameter(\"bonus\", @ast.named_type(\"I32\"))])\n  changed.repair_calls_with(@ast.name(node.name).call([@ast.name(\"value\"), @ast.integer(0i32)]))\n}\n#extend\npub fn answer(value: I32) -> I32 {\n  value\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      assert(ct_test_all_source(expanded.modules[0u32]).contains("@h.__dew_transform_adapter_"), "import alias was lost")
      ct_signature_test_recheck(expanded)
    }
    Err(error) => assert(false, error)
  }
}

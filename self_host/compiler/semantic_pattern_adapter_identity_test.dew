open dew.std.option

test "variant payload parameters follow declared positions without names" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Payload<a, b> {\n  Err(I32, b, a)\n}\npub fn run(value: Payload<I32, I64>) -> I64 {\n  match value {\n    Payload::Err(_, item, _) => item\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let variant = module_.type_layouts.variants[0u32].variant
  assert(self_host_linked_variant_payload_parameter(link, variant, 0u32) is None, "concrete payload is not an owner type parameter")
  match self_host_linked_variant_payload_parameter(link, variant, 1u32) {
    Some(value) => assert(value == 1u32, "second payload uses declared parameter b")
    None => assert(false, "second payload must have a declared parameter")
  }
  match self_host_linked_variant_payload_parameter(link, variant, 2u32) {
    Some(value) => assert(value == 0u32, "third payload uses declared parameter a")
    None => assert(false, "third payload must have a declared parameter")
  }
  assert(self_host_linked_variant_payload_parameter(link, variant, 3u32) is None, "missing payload has no parameter")
}

test "named struct patterns select the physical type of their declaration" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Payload {\n  value: I32\n}\npub fn run(value: Payload) -> I32 {\n  match value {\n    Payload {\n      value: item\n    } => item\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  for pattern in module_.patterns {
    if pattern.source is StructPattern(_, _, _, _, _) {
      let declaration = self_host_pattern_constructor_declaration(module_, pattern)
      assert(declaration != 0u64, "named struct pattern retains its selected declaration")
      let expected = match self_host_linked_struct_type_index(link, declaration) {
        Some(value) => value
        None => {
          assert(false, "selected struct has a linked physical type")
          4294967295u32
        }
      }
      match self_host_pattern_nested_type(link, module_, pattern) {
        Some(actual) => assert(actual == expected, "pattern uses its exact source struct")
        None => assert(false, "named struct pattern needs a physical target")
      }
      let missing = {
        elided: pattern.elided
        type_: pattern.type_
        shape: pattern.shape
        source: pattern.source
        reference: pattern.reference
        selected_constructor: NoBasicPatternConstructor
        offset: pattern.offset
      }
      assert(self_host_pattern_nested_type(link, module_, missing) is None, "source spelling and logical type cannot replace a missing selection")
      let wrong_kind = {
        elided: pattern.elided
        type_: pattern.type_
        shape: pattern.shape
        source: pattern.source
        reference: pattern.reference
        selected_constructor: SelectedBasicPatternConstructor(declaration, true, {
          start: 0u32
          length: 0u32
        })
        offset: pattern.offset
      }
      assert(self_host_pattern_nested_type(link, module_, wrong_kind) is None, "a struct ID cannot satisfy an enum-variant selection")
      checked = checked + 1u32
    }
  }
  assert(checked == 1u32, "inspect one named struct pattern")
}

test "call payload evidence follows the result generic instead of slot one" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.option",
    b"pub enum Option<t> {\n  None\n  Some(t)\n}\n",
    b"open dew.std.option\nfn select<a, b>(first: a, second: b) -> Option<a> {\n  Some(first)\n}\npub fn run() -> U32 {\n  match select::<U32, I64>(7u32, 9i64) {\n    Some(item) => item\n    None => 0u32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

test "Result payload evidence follows reordered declared type parameters" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.result",
    b"pub enum Result<t, e> {\n  Ok(t)\n  Err(e)\n}\n",
    b"open dew.std.result\nfn select<a, b>(first: a, second: b) -> Result<b, a> {\n  Err(first)\n}\npub fn run() -> U32 {\n  match select::<U32, I64>(7u32, 9i64) {\n    Err(item) => item\n    Ok(_) => 0u32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  for pattern in module_.patterns {
    if pattern.source is TuplePattern(_, _, _) {
      let declaration = self_host_pattern_constructor_declaration(module_, pattern)
      let expected = match self_host_linked_variant_type_index(link, declaration) {
        Some(value) => value
        None => {
          assert(false, "selected Result variant must have a source fragment")
          4294967295u32
        }
      }
      match self_host_linked_pattern_variant_type(link, module_, pattern, pattern.shape, 0u64) {
        Some(actual) => assert(actual == expected, "Result must use the selected source fragment, without an added identity field")
        None => assert(false, "Result pattern must have a physical type")
      }
    }
  }
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}


test "user generic payloads use their declared storage without runtime adapters" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Local<t> {\n  Some(t)\n}\npub fn run(value: Local<U32>) -> U32 {\n  match value {\n    Local::Some(item) => item\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  for pattern in module_.patterns {
    if pattern.source is TuplePattern(_, _, _) {
      let declaration = self_host_pattern_constructor_declaration(module_, pattern)
      let type_ = match self_host_linked_variant_type_index(link, declaration) {
        Some(value) => value
        None => {
          assert(false, "user variant must have a declared physical type")
          4294967295u32
        }
      }
      assert(self_host_linked_pattern_payload_box_type(link, type_, 0u32, I32BodyCarrier) is Some(_), "declared generic payload requires a scalar box")
      checked = checked + 1u32
    }
  }
  assert(checked == 1u32, "inspect the selected user Some pattern")
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

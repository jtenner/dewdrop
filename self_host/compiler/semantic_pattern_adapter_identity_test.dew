open dew.std.option

test "call payload evidence follows the result generic instead of slot one" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.option",
    b"pub enum Option<t> {\n  None\n  Some(t)\n}\n",
    b"open dew.std.option\nfn select<a, b>(first: a, second: b) -> Option<a> {\n  Some(first)\n}\npub fn run() -> U32 {\n  match select::<U32, I64>(7u32, 9i64) {\n    Some(item) => item\n    None => 0u32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  self_host_assert_selected_call_payload(link, module_, 0u32, SelfHostWasmBodyCarrier::I32BodyCarrier)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

test "Result payload evidence follows reordered declared type parameters" {
  let link = self_host_physical_test_named_import_link(
    "dew.std.result",
    b"pub enum Result<t, e> {\n  Ok(t)\n  Err(e)\n}\n",
    b"open dew.std.result\nfn select<a, b>(first: a, second: b) -> Result<b, a> {\n  Err(first)\n}\npub fn run() -> U32 {\n  match select::<U32, I64>(7u32, 9i64) {\n    Err(item) => item\n    Ok(_) => 0u32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  self_host_assert_selected_call_payload(link, module_, 0u32, SelfHostWasmBodyCarrier::I64BodyCarrier)
  self_host_assert_selected_call_payload(link, module_, 1u32, SelfHostWasmBodyCarrier::I32BodyCarrier)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

fn self_host_assert_selected_call_payload(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  argument: U32,
  expected: SelfHostWasmBodyCarrier,
) -> Unit {
  let mut checked = 0u32
  for body in module_.bodies {
    let mut offset = 0u32
    let _ = while offset {
      current if current < body.expressions.length => {
        let index = body.expressions.start + current
        match module_.expressions[index].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => if self_host_linked_declaration_name(link, declaration) == b"select" {
            match self_host_linked_exact_call_result_payload_shape(link, module_, body, 4294967295u32, index, argument) {
              Option::Some(shape) => assert(self_host_body_carrier_equal(self_host_body_carrier_from_shape(shape), expected), "payload must follow its declared result parameter")
              Option::None => assert(false, "exact call result argument must exist")
            }
            checked = checked + 1u32
          }
          _ => {}
        }
        continue current + 1u32
      }
      _ => break self_host_semantic_unit()
    }
  }
  assert(checked == 1u32, "inspect the generic select call")
}

test "runtime payload seeding does not claim a user Some variant" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(
      b"enum Local<t> {\n  Some(t)\n}\npub fn run(value: Local<U32>) -> U32 {\n  match value {\n    Local::Some(item) => item\n  }\n}\n",
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[0u32])
  let body = module_.bodies[0u32]
  let indexes = self_host_build_physical_body_indexes(link)
  let values = []
  let carriers = []
  let mut offset = 0u32
  let _ = while offset {
    current if current < body.locals.length => {
      values.push(self_host_body_physical_value(
        indexes,
        module_.locals[body.locals.start + current].type_,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
        0u64,
      ))
      carriers.push(SelfHostWasmBodyCarrier::UnresolvedBodyCarrier)
      continue current + 1u32
    }
    _ => break self_host_semantic_unit()
  }
  let mut checked = 0u32
  let mut pattern_offset = 0u32
  let _ = while pattern_offset {
    current if current < body.patterns.length => {
      let index = body.patterns.start + current
      let pattern = module_.patterns[index]
      if pattern.source is SelfHostHirPattern::TuplePattern(_, _, _) {
        let declaration = self_host_pattern_constructor_declaration(module_, pattern)
        assert(!link.runtime_variant_adapters.contains_key(declaration), "user constructor has no runtime adapter")
        assert(!self_host_body_seed_match_payload_binding(
          link,
          indexes,
          module_,
          body,
          index,
          4294967295u32,
          module_.locals[body.locals.start].type_,
          4294967295u32,
          4294967295u32,
          values,
          carriers,
        ), "runtime adapter seeding must not use a user variant spelling")
        checked = checked + 1u32
      }
      continue current + 1u32
    }
    _ => break self_host_semantic_unit()
  }
  assert(checked == 1u32, "inspect the selected user Some pattern")
  for carrier in carriers {
    assert(carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier, "runtime adapter helper must leave user values unchanged")
  }
}

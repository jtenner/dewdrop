}

test "BOD-605 owned capture cell heap type cannot change after freeze" expect_trap "unreachable" {
  let (_, plan) = self_host_capture_cell_plan_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  self_host_test_change_owned_cell(plan, 5u32, 2u32)

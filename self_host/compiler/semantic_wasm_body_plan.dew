    receiver_value.nominal_owner,
    0u64,
  ) {
    receiver_value.nominal_owner
  } else if !self_host_u32_equal(
    receiver_value.physical_heap_type,
    4294967295u32,
  ) {
    self_host_body_physical_owner(link, receiver_value.physical_heap_type)
  } else {
    0u64
  }
  if self_host_u64_equal(receiver_owner, 0u64) {
    match module_.expressions[receiver].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
        receiver_owner = self_host_body_local_parameter_nominal_owner(
          link,
          module_,
          body,
          local_id,
        )
        if self_host_u64_equal(receiver_owner, 0u64) && local_id < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, local_id)
          if local_index < module_.locals.length() {
            let planned_local = self_host_body_planned_local_identity(
              module_.locals[local_index],

  scratches.push(SelfHostPlannedPhysicalScratchCarrier::{
    expression: expression
    ordinal: 0u32
    value: value
    carrier: value.carrier
    context: context
  })
}

fn self_host_body_local_by_initializer(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Array<U32> {
  let result = []
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      result.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() {
        let local = self_host_body_planned_local_identity(module_.locals[source])
        match self_host_linked_local_initializer_expression(
          module_,
          body,
          local.local_id,
        ) {
          Option::Some(initializer) => if initializer >= body.expressions.start {
            let relative = initializer - body.expressions.start
            if relative < result.length() {
              self_host_body_u32_set(result, relative, current)
            }
          }
          Option::None => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_body_force_constructor_field_carriers(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  specialization: U32,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  fields: SelfHostHirSpan,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
) -> Bool {
  let type_index = if self_host_u32_equal(
    expression_plan.selected_type_index,
    4294967295u32,
  ) {
    match self_host_linked_infer_constructor_type_index(
      link,
      module_,
      body,
      specialization,
      module_.expressions[expression_plan.expression].nominal,
      fields,
    ) {
      Option::Some(value) => value
      Option::None => return false
    }
  } else {
    expression_plan.selected_type_index
  }
  let mut changed = false
  for linked_type in link.types {
    if self_host_u32_equal(
      linked_type.type_index,
      type_index,
    ) {
      let physical_module = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        physical_module,
        linked_type.fragment_index,
      )
      let mut physical_offset = 0u32
      let _ = while physical_offset {
        current => if current < physical.fields.length {
          let destination = self_host_body_physical_field(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          let mut argument = 4294967295u32
          let mut source_offset = 0u32
          let _ = while source_offset {
            source => if source < fields.length {
              let object_index = self_host_u32_add(fields.start, source)
              if object_index < module_.object_fields.length() {
                let object_field = self_host_planned_object_field_identity(
                  module_.object_fields[object_index],
                )
                let exact_field = self_host_u64_equal(
                  object_field.field,
                  destination.declaration,
                )
                let named_field = self_host_u32_greater(
                  self_host_linked_module_name_count(module_),
                  object_field.name,
                ) && match self_host_linked_field_name(
                  link,
                  destination.declaration,
                ) {
                  Option::Some(destination_name) => self_host_linked_module_name_at(
                    module_,
                    object_field.name,
                  ) == destination_name
                  Option::None => false
                }
                if exact_field {
                  argument = object_field.value
                  break self_host_semantic_unit()
                }
                if named_field && self_host_u32_equal(argument, 4294967295u32) {
                  argument = object_field.value
                }
              }
              continue source + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if !(link.erased_fields.get(destination.declaration) is Option::Some(true)) && !self_host_u32_equal(argument, 4294967295u32) &&
            self_host_body_plan_force_expression_carrier(
              body,
              expressions,
              argument,
              if link.unit_fields.get(destination.declaration) is Option::Some(true) {
                SelfHostWasmBodyCarrier::UnitBodyCarrier
              } else {
                self_host_body_carrier_from_storage(destination.storage)
              },
            ) {
            changed = true
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return changed
    }
  }
  changed
}

fn self_host_body_force_call_result(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  call_function_index: U32,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  local_by_initializer: Array<U32>,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if call_function_index == 4294967295u32 {
    return false
  }
  let physical_function = self_host_linked_physical_function_index(
    call_function_index,
  )
  if physical_function < indexes.call_site_result_by_function.length() {
    if self_host_body_bool_at(
      indexes.call_site_result_by_function,
      physical_function,
    ) {
      return false
    }
  }
  let result_shape = self_host_linked_physical_function_result_shape(
    link,
    physical_function,
  )
  let result_carrier = self_host_body_carrier_from_shape(result_shape)
  if result_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return false
  }
  let mut changed = self_host_body_plan_force_expression_carrier(
    body,
    expressions,
    expression,
    result_carrier,
  )
  if expression >= body.expressions.start {
    let relative = expression - body.expressions.start
    if relative < local_by_initializer.length() {
      let local_offset = self_host_body_u32_at(local_by_initializer, relative)
      if local_offset < local_values.length() {
        if self_host_body_plan_force_local_value(
          local_values,
          locals,
          local_offset,
          self_host_body_value_with_carrier(
            local_values[local_offset],
            result_carrier,
          ),
        ) {
          changed = true
        }
      }
    }
  }
  changed
}

fn self_host_body_force_call_arguments(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  arguments: SelfHostHirSpan,
  call_function_index: U32,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if call_function_index == 4294967295u32 {
    return false
  }
  let physical_function = self_host_linked_physical_function_index(
    call_function_index,
  )
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    physical_function,
  )
  let flatten_product = self_host_u32_equal(arguments.length, 1u32) &&
    self_host_u32_equal(parameter_count, 2u32)
  let mut physical_argument_count = 0u32
  let mut count_argument = 0u32
  let _ = while count_argument {
    current => if current < arguments.length {
      let child = self_host_u32_add(arguments.start, current)
      if child < module_.expression_children.length() {
        let argument_expression = module_.expression_children[child]
        if argument_expression >= body.expressions.start && argument_expression <
          self_host_u32_add(body.expressions.start, body.expressions.length) {
          let carrier = expressions[self_host_body_expression_slot(
            body,
            argument_expression,
          )].carrier
          if !(carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) && !(
            carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
          ) {
            let count = if flatten_product && argument_expression < module_.expressions.length() {
              match module_.expressions[argument_expression].kind {
                SelfHostPlannedExpressionKind::PlannedProductNew(fields) => fields.length
                _ => 1u32
              }
            } else {
              1u32
            }
            physical_argument_count = self_host_u32_add(
              physical_argument_count,
              count,
            )
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if parameter_count < physical_argument_count {
    return false
  }
  let parameter_offset = self_host_u32_subtract(
    parameter_count,
    physical_argument_count,
  )
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut changed = false
  let mut argument = 0u32
  let mut physical_argument = parameter_offset
  let _ = while argument {
    current => if current < arguments.length {
      let child = self_host_u32_add(arguments.start, current)
      if child < module_.expression_children.length() {
        let argument_expression = module_.expression_children[child]
        if argument_expression >= body.expressions.start &&
          argument_expression < expression_end {
          let actual_carrier = expressions[self_host_body_expression_slot(
            body,
            argument_expression,
          )].carrier
          if actual_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
            actual_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
            continue current + 1u32
          }
          let expected_shape = self_host_linked_physical_function_parameter_shape(
            link,
            physical_function,
            physical_argument,
          )
          let expected = self_host_body_carrier_from_shape(expected_shape)
          if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            if self_host_body_plan_force_expression_carrier(
              body,
              expressions,
              argument_expression,
              expected,
            ) {
              changed = true
            }
            match module_.expressions[argument_expression].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                let slot = self_host_body_local_slot(module_, body, local_id)
                if slot < local_values.length() && self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  slot,
                  self_host_body_value_with_carrier(
                    local_values[slot],
                    expected,
                  ),
                ) {
                  changed = true
                }
              }
              _ => {}
            }
          }
          physical_argument = self_host_u32_add(physical_argument, 1u32)
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = expression
  changed
}


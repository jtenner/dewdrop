    if physical_name.ends_with(b"get") {
      let specialization_shape = self_host_linked_physical_function_specialization_shape_at(
        link,
        physical_function,
        1u32,
      )
      if !(specialization_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {

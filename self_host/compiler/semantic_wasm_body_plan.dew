fn self_host_body_call_target_identity(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
) -> Option<SelfHostPlannedProgramWasmFunction> {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) {
      return Option::Some(function_)
    }
  }
  Option::None
}

fn self_host_body_call_receiver_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  declaration: U64,
) -> U32 {
  if self_host_u64_equal(declaration, 0u64) ||
    !self_host_linked_declaration_has_receiver(link, declaration) ||
    expression >= module_.expressions.length() {
    return 4294967295u32
  }
  let target = match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => return base
    SelfHostPlannedExpressionKind::PlannedIndexSet(base, _, _, _) => return base
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, value, _, _) => value
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
    _ => 4294967295u32
  }
  if target >= module_.expressions.length() {
    return 4294967295u32
  }
  match self_host_linked_direct_receiver_expression(module_, target) {
    Option::Some(receiver) => receiver
    Option::None => 4294967295u32
  }
}

fn self_host_body_call_operand_expression(
  source: SelfHostPhysicalOperandSource,
) -> U32 {
  match source {
    SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(value) => value
    SelfHostPhysicalOperandSource::ReceiverPhysicalOperand(value) => value
    // A cached pattern subject is not a source expression to evaluate again.
    SelfHostPhysicalOperandSource::PatternSubjectPhysicalOperand(_) => 4294967295u32
    SelfHostPhysicalOperandSource::TraitEvidencePhysicalOperand(value) => value
    SelfHostPhysicalOperandSource::ClosureEnvironmentPhysicalOperand(value) => value
    SelfHostPhysicalOperandSource::RuntimeContextPhysicalOperand(value) => value
  }
}

fn self_host_body_carrier_emits_call_operand(
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  !(carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) && !(
    carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
  )
}

fn self_host_body_plan_call_argument(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  evaluation_expression: U32,
  flatten_product: Bool,
  call_evaluations: Array<U32>,
  call_operands: Array<SelfHostPhysicalOperandSource>,
) -> Bool {
  call_evaluations.push(evaluation_expression)
  if evaluation_expression < body.expressions.start || evaluation_expression >=
    self_host_u32_add(body.expressions.start, body.expressions.length) {
    call_operands.push(
      SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(
        evaluation_expression,
      ),
    )
    return true
  }
  let planned = expressions[self_host_body_expression_slot(
    body,
    evaluation_expression,
  )]
  if planned.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return false
  }
  if !self_host_body_carrier_emits_call_operand(planned.carrier) {
    return true
  }
  match module_.expressions[evaluation_expression].kind {
    SelfHostPlannedExpressionKind::PlannedProductNew(fields) => if flatten_product {
      let mut field = 0u32
      let _ = while field {
        current => if current < fields.length {
          let child = self_host_u32_add(fields.start, current)
          if child < module_.expression_children.length() {
            call_operands.push(
              SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(
                module_.expression_children[child],
              ),
            )
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    } else {
      call_operands.push(
        SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(
          evaluation_expression,
        ),
      )
    }
    _ => call_operands.push(
      SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(
        evaluation_expression,
      ),
    )
  }
  true
}

fn self_host_body_build_physical_call_plans(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  call_evaluations: Array<U32>,
  call_operands: Array<SelfHostPhysicalOperandSource>,
) -> Array<SelfHostPhysicalCallPlan> {
  let calls = self_host_body_empty_call_plans()
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut expression = body.expressions.start
  let _ = while expression {
    current => if current < expression_end && current < module_.expressions.length() {
      let expression_plan = expressions[self_host_body_expression_slot(body, current)]
      if !self_host_u32_equal(
        expression_plan.call_function_index,
        4294967295u32,
      ) {
        match self_host_body_call_target_identity(
          link,
          expression_plan.call_function_index,
        ) {
          Option::Some(target) => {
            let arguments = match module_.expressions[current].kind {
              SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, values, _) => values
              SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, values) => values
              SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, values) => values
              SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, values, _) => values
              _ => SelfHostHirSpan::{
                start: 0u32
                length: 0u32
              }
            }
            let evaluation_start = call_evaluations.length()
            let operand_start = call_operands.length()
            let mut emits_call = true
            let receiver = self_host_body_call_receiver_expression(
              link,
              module_,
              current,
              target.declaration,
            )
            if receiver != 4294967295u32 {
              emits_call = self_host_body_plan_call_argument(module_, body, expressions,
                receiver, false, call_evaluations, call_operands,
              )
              if call_operands.length() > operand_start {
                call_operands[operand_start] = SelfHostPhysicalOperandSource::ReceiverPhysicalOperand(receiver)
              }
            }
            let parameter_count = self_host_linked_physical_function_parameter_count(
              link,
              self_host_linked_physical_function_index(target.function_index),
            )
            let receiver_count = call_operands.length() - operand_start
            let (index_argument, index_value) = match module_.expressions[current].kind {
              SelfHostPlannedExpressionKind::PlannedIndexGet(_, index, _) => (index, 4294967295u32)
              SelfHostPlannedExpressionKind::PlannedIndexSet(_, index, value, _) => (index, value)
              _ => (4294967295u32, 4294967295u32)
            }
            let argument_count = if index_value != 4294967295u32 {
              2u32
            } else if index_argument != 4294967295u32 {
              1u32
            } else {
              arguments.length
            }
            let flatten_product = self_host_u32_equal(arguments.length, 1u32) &&
              self_host_u32_equal(parameter_count, receiver_count + 2u32)
            let mut argument = 0u32
            let _ = while argument {
              offset => if offset < argument_count && emits_call {
                let child = self_host_u32_add(arguments.start, offset)
                if index_argument != 4294967295u32 || child < module_.expression_children.length() {
                  let source = if index_argument != 4294967295u32 {
                    if offset == 0u32 {
                      index_argument
                    } else {
                      index_value
                    }
                  } else {
                    module_.expression_children[child]
                  }
                  emits_call = self_host_body_plan_call_argument(
                    module_,
                    body,
                    expressions,
                    source,
                    flatten_product,
                    call_evaluations,
                    call_operands,
                  )
                } else {
                  call_evaluations.push(4294967295u32)
                  call_operands.push(
                    SelfHostPhysicalOperandSource::ExplicitArgumentPhysicalOperand(
                      4294967295u32,
                    ),
                  )
                }
                continue offset + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            calls.push(SelfHostPhysicalCallPlan::{
              expression: current
              declaration: target.declaration
              specialization: target.specialization
              physical_function: self_host_linked_physical_function_index(
                target.function_index,
              )
              emits_call: emits_call
              evaluations: SelfHostHirSpan::{
                start: evaluation_start
                length: call_evaluations.length() - evaluation_start
              }
              operands: SelfHostHirSpan::{
                start: operand_start
                length: call_operands.length() - operand_start
              }
            })
          }
          Option::None => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  calls
}

fn self_host_body_call_plan(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
) -> Option<SelfHostPhysicalCallPlan> {
  for call in plan.calls {
    if self_host_u32_equal(call.expression, expression) {
      return Option::Some(call)
    }
  }
  Option::None
}

fn self_host_body_expression_work_item(
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  if expression < body.expressions.start {
    return 4294967295u32
  }
  let relative = expression - body.expressions.start
  if relative >= body.expressions.length {
    return 4294967295u32
  }
  self_host_u32_add(relative, 1u32)
}

fn self_host_body_link_expression_work(
  graph: SelfHostBodyWorkGraph,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  expression: U32,
) -> Unit {
  let child_item = self_host_body_expression_work_item(body, expression)
  if child_item != 4294967295u32 {
    self_host_body_add_work_pair(graph, owner_item, child_item)
  }
}

fn self_host_body_link_expression_span_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  children: SelfHostHirSpan,
) -> Unit {
  let mut child = 0u32
  let _ = while child {
    current => if current < children.length {
      let index = self_host_u32_add(children.start, current)
      if index < module_.expression_children.length() {
        self_host_body_link_expression_work(
          graph,
          body,
          owner_item,
          module_.expression_children[index],
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_object_field_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  fields: SelfHostHirSpan,
) -> Unit {
  let mut field = 0u32
  let _ = while field {
    current => if current < fields.length {
      let index = self_host_u32_add(fields.start, current)
      if index < module_.object_fields.length() {
        self_host_body_link_expression_work(
          graph,
          body,
          owner_item,
          module_.object_fields[index].value,
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_local_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  local_id: U32,
) -> Unit {
  let slot = self_host_body_local_slot(module_, body, local_id)
  if slot < body.locals.length {
    self_host_body_add_work_pair(
      graph,
      owner_item,
      self_host_u32_add(local_base, slot),
    )
  }
}

fn self_host_body_link_pattern_local_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  pattern: U32,
) -> Unit {
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let index = self_host_u32_add(body.locals.start, current)
      if index < module_.locals.length() && self_host_linked_pattern_binds_local(
        module_,
        pattern,
        module_.locals[index].local_id,
      ) {
        self_host_body_add_work_pair(
          graph,
          owner_item,
          self_host_u32_add(local_base, current),
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_arm_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  arms: SelfHostHirSpan,
) -> Unit {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = module_.pattern_arms[arm_index]
          self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            source.body,
          )
          self_host_body_link_pattern_local_work(
            graph,
            module_,
            body,
            local_base,
            owner_item,
            source.pattern,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_build_work_graph(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  maximum_control: U32,
) -> SelfHostBodyWorkGraph {
  let local_base = self_host_u32_add(body.expressions.length, 1u32)
  let control_state_base = self_host_u32_add(local_base, body.locals.length)
  let control_result_base = self_host_u32_add(control_state_base, maximum_control)
  let work_item_count = self_host_u32_add(control_result_base, maximum_control)
  let graph = self_host_body_empty_work_graph(work_item_count)
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      let owner_item = self_host_u32_add(current, 1u32)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedConsumedExpression => if expression > body.expressions.start {
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              expression - 1u32,
            )
          }
          SelfHostPlannedExpressionKind::PlannedProductNew(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          SelfHostPlannedExpressionKind::PlannedEvaluationSequence(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          SelfHostPlannedExpressionKind::PlannedArrayLiteral(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          SelfHostPlannedExpressionKind::PlannedObjectNew(fields) => self_host_body_link_object_field_work(
            graph,
            module_,
            body,
            owner_item,
            fields,
          )
          SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => self_host_body_link_object_field_work(
            graph,
            module_,
            body,
            owner_item,
            fields,
          )
          SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            self_host_body_block_tail_expression(module_, block),
          )
          SelfHostPlannedExpressionKind::PlannedIfExpression(
            condition,
            then_block,
            else_expression,
          ) => {
            self_host_body_link_expression_work(graph, body, owner_item, condition)
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              self_host_body_block_tail_expression(module_, then_block),
            )
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              else_expression,
            )
          }
          SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
            self_host_body_link_expression_work(graph, body, owner_item, subject)
            self_host_body_link_arm_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              arms,
            )
          }
          SelfHostPlannedExpressionKind::PlannedWhileExpression(
            control,
            initial,
            arms,
          ) => {
            self_host_body_link_expression_work(graph, body, owner_item, initial)
            self_host_body_link_arm_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              arms,
            )
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_state_base, control),
              )
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_result_base, control),
              )
            }
          }
          SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          SelfHostPlannedExpressionKind::PlannedBreakExpression(control, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, value)
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_result_base, control),
              )
            }
          }
          SelfHostPlannedExpressionKind::PlannedContinueExpression(control, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, value)
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_state_base, control),
              )
            }
          }
          SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, left, right) => {
            self_host_body_link_expression_work(graph, body, owner_item, left)
            self_host_body_link_expression_work(graph, body, owner_item, right)
          }
          SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, left, right, arguments) => {
            self_host_body_link_expression_work(graph, body, owner_item, left)
            self_host_body_link_expression_work(graph, body, owner_item, right)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          SelfHostPlannedExpressionKind::PlannedProductField(base, _, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          SelfHostPlannedExpressionKind::PlannedIndexGet(base, index, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, index)
          }
          SelfHostPlannedExpressionKind::PlannedLocalGet(local) => self_host_body_link_local_work(
            graph,
            module_,
            body,
            local_base,
            owner_item,
            local,
          )
          SelfHostPlannedExpressionKind::PlannedLocalSet(local, value) => {
            self_host_body_link_local_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              local,
            )
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          SelfHostPlannedExpressionKind::PlannedCaptureSet(_, value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          SelfHostPlannedExpressionKind::PlannedFieldSet(_, base, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          SelfHostPlannedExpressionKind::PlannedIndexSet(base, index, value, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, index)
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut block = 0u32
  let _ = while block {
    current => if current < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current)
      if block_index < module_.blocks.length() {
        let items = module_.blocks[block_index].items
        let mut item = 0u32
        let _ = while item {
          offset => if offset < items.length {
            let index = self_host_u32_add(items.start, offset)
            if index < module_.block_items.length() {
              match module_.block_items[index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local,
                  _,
                  initializer,
                ) => {
                  self_host_body_link_expression_work(
                    graph,
                    body,
                    0u32,
                    initializer,
                  )
                  self_host_body_link_local_work(
                    graph,
                    module_,
                    body,
                    local_base,
                    0u32,
                    local,
                  )
                }
                _ => {}
              }
            }
            continue offset + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  graph
}

fn self_host_plan_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  linked_function: SelfHostPlannedProgramWasmFunction,
  body: SelfHostPlannedBodyLowering,
  lambda: U32,
) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
  self_host_assert_physical_body_span(body, body.expressions, module_.expressions.length(), 1u32)
  self_host_assert_physical_body_span(body, body.locals, module_.locals.length(), 2u32)
  self_host_assert_physical_body_span(body, body.blocks, module_.blocks.length(), 3u32)
  self_host_assert_physical_body_span(body, body.patterns, module_.patterns.length(), 4u32)
  self_host_assert_physical_body_span(body, body.pattern_arms, module_.pattern_arms.length(), 5u32)
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  let local_by_initializer = self_host_body_local_by_initializer(module_, body)
  let fragment_module = self_host_body_fragment_module(
    link,
    linked_function.module_index,
  )
  let fragment = self_host_body_function_fragment(
    fragment_module,
    linked_function.fragment_index,
  )
  let expressions = self_host_body_empty_physical_expressions()
  let mut expression = body.expressions.start
  let expression_end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let _ = while expression {
    current => if current < expression_end {
      expressions.push(
        self_host_body_seed_expression(
          link,
          indexes,
          module_,
          body,
          linked_function.specialization,
          current,
        ),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let local_values = self_host_body_empty_physical_values()
  let locals = self_host_body_empty_carriers()
  let mut parameter_index = if lambda == 4294967295u32 {
    0u32
  } else {
    1u32
  }
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_body_planned_local_identity(
        module_.locals[self_host_u32_add(body.locals.start, current)],
      )
      let source_shape = self_host_body_specialization_shape_for_type(
        link, module_, linked_function.specialization, source.type_, source.shape,
      )
      let local_carrier = if source_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
        SelfHostWasmBodyCarrier::UnitBodyCarrier
      } else if source_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
        SelfHostWasmBodyCarrier::NeverBodyCarrier
      } else if source.kind is SelfHostBodyLocalKind::ParameterLocal &&
        parameter_index < fragment.parameters.length {
        let value_index = self_host_u32_add(fragment.parameters.start, parameter_index)
        let parameter_carrier = if self_host_u32_greater(
          fragment_module.function_value_types.length(),
          value_index,
        ) {
          self_host_body_carrier_from_value_type(
            self_host_body_function_value_type(
              fragment_module,
              value_index,
            ),
          )
        } else {
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
        }
        parameter_index = self_host_u32_add(parameter_index, 1u32)
        parameter_carrier
      } else {
        // Initializers, assignments, and pattern payloads are physical proof.
        // A stale inferred local shape must not rewrite those expressions.
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      let inferred_local_owner = if !self_host_u64_equal(source.nominal, 0u64) {
        source.nominal
      } else {
        self_host_linked_type_nominal_declaration(module_, source.type_)
      }
      let local_owner = if source.kind is SelfHostBodyLocalKind::ParameterLocal &&
        self_host_u64_equal(inferred_local_owner, 0u64) {
        self_host_body_local_parameter_nominal_owner(
          link,
          module_,
          body,
          source.local_id,
        )
      } else {
        inferred_local_owner
      }
      local_values.push(
        self_host_body_physical_value(
          indexes,
          source.type_,
          local_carrier,
          local_owner,
        ),
      )
      locals.push(local_carrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut loop_local_offset = 0u32
  let _ = while loop_local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() && current < local_values.length() &&
        current < locals.length() {
        let planned_local = module_.locals[local_index]
        let nominal = self_host_linked_loop_binding_nominal_declaration(
          link,
          module_,
          body,
          planned_local.local_id,
        )
        if !self_host_u64_equal(nominal, 0u64) && self_host_u64_equal(
          local_values[current].nominal_owner,
          0u64,
        ) {
          let carrier = if local_values[current].carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
            SelfHostWasmBodyCarrier::EqRefBodyCarrier
          } else {
            local_values[current].carrier
          }
          local_values[current] = SelfHostPlannedPhysicalValueInfo::{
            logical_type: local_values[current].logical_type
            carrier: carrier
            conflict_expected: local_values[current].conflict_expected
            conflict_actual: local_values[current].conflict_actual
            nominal_owner: nominal
            physical_heap_type: self_host_body_physical_heap_type(indexes, nominal)
          }
          locals[current] = carrier
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut pattern_offset = 0u32
  let _ = while pattern_offset {
    current => if current < body.patterns.length {
      let pattern_index = self_host_u32_add(body.patterns.start, current)
      if pattern_index < module_.patterns.length() {
        let pattern = self_host_planned_pattern_identity(
          module_.patterns[pattern_index],
        )
        match pattern.source {
          SelfHostHirPattern::TuplePattern(_, children, _) => {
            let mut child_offset = 0u32
            let _ = while child_offset {
              field_index => if field_index < children.length {
                let child_index = self_host_u32_add(children.start, field_index)
                if child_index < module_.pattern_children.length() {
                  let child = module_.pattern_children[child_index]
                  if child < module_.patterns.length() {
                    match self_host_planned_pattern_identity(
                      module_.patterns[child],
                    ).reference {
                      SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
                        let slot = self_host_body_local_slot(module_, body, local_id)
                        if slot < local_values.length() {
                          let payload_value = self_host_body_pattern_payload_value(
                            link,
                            indexes,
                            module_,
                            pattern,
                            field_index,
                            local_values[slot],
                          )
                          let _ = self_host_body_plan_force_local_value(
                            local_values,
                            locals,
                            slot,
                            payload_value,
                          )
                        }
                      }
                      _ => {}
                    }
                  }
                }
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let control_state_values = self_host_body_empty_physical_values()
  let control_states = self_host_body_empty_carriers()
  let control_result_values = self_host_body_empty_physical_values()
  let control_results = self_host_body_empty_carriers()
  let mut maximum_control = 0u32
  let mut control_plan_index = 0u32
  while control_plan_index {
    current => if current < expressions.length() {
      let planned = self_host_body_physical_expression_at(expressions, current)
      match module_.expressions[planned.expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(control, _, _) => if control != 4294967295u32 &&
          control >= maximum_control {
          maximum_control = self_host_u32_add(control, 1u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut control = 0u32
  let _ = while control {
    current => if current < maximum_control {
      control_state_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_states.push(SelfHostWasmBodyCarrier::UnresolvedBodyCarrier)
      control_result_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_results.push(SelfHostWasmBodyCarrier::UnresolvedBodyCarrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let physical_result_carrier = if self_host_u32_equal(
    fragment.results.length,
    0u32,
  ) {
    SelfHostWasmBodyCarrier::UnitBodyCarrier
  } else if self_host_u32_equal(fragment.results.length, 1u32) &&
    self_host_u32_greater(
      fragment_module.function_value_types.length(),
      fragment.results.start,
    ) {
    self_host_body_carrier_from_value_type(
      self_host_body_function_value_type(
        fragment_module,
        fragment.results.start,
      ),
    )
  } else {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let result_owner = match self_host_program_specialization_callable(
    module_,
    linked_function.declaration,
  ) {
    Option::Some(callable) => self_host_linked_resolved_nominal_declaration(
      module_,
      callable.result_type,
    )
    Option::None => 0u64
  }
  let result = self_host_body_physical_value(
    indexes,
    body.root_type,
    physical_result_carrier,
    result_owner,
  )
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(root) => {
      // The physical function signature is exact proof for its root value.
      // A logical fallback must not replace this carrier.
      let _ = self_host_body_plan_force_expression_value(
        body,
        expressions,
        root,
        result,
      )
    }
    SelfHostHirBodyRoot::BlockBodyRoot(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if tail != 4294967295u32 {
        // The block tail must produce the exact physical function result.
        let _ = self_host_body_plan_force_expression_value(
          body,
          expressions,
          tail,
          result,
        )
      }
    }
  }
  self_host_body_force_declared_pattern_payloads(
    link,
    indexes,
    module_,
    body,
    local_values,
    locals,
  )
  self_host_body_force_return_carriers(
    module_,
    body,
    expressions,
    physical_result_carrier,
  )
  // Work item zero owns block/local-initializer constraints. The next items
  // own expression constraints. Local and control items are dependency hubs:
  // they wake only the expressions that read or write the changed cell.
  let work_graph = self_host_body_build_work_graph(
    module_,
    body,
    maximum_control,
  )
  let work_item_count = work_graph.heads.length()
  let work_queue = []
  let work_pending = []
  let mut work_item = 0u32
  let _ = while work_item {
    current => if current < work_item_count {
      work_pending.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_body_schedule_work_item(work_queue, work_pending, 0u32)
  let mut expression_work_item = body.expressions.length
  let _ = while expression_work_item {
    current => if current > 0u32 {
      self_host_body_schedule_work_item(work_queue, work_pending, current)
      continue self_host_u32_subtract(current, 1u32)
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut work_limit_exceeded = false
  let mut stalled_work_item = 4294967295u32
  let mut work_head = 0u32
  let mut processed_work_items = 0u32
  let mut successful_changes = 0u32
  // Each work item owns fewer than sixteen finite-height evidence components.
  // This bound is proportional to the plan size. It detects a transfer that
  // changes facts back and forth without restoring the old fixed-pass limit.
  let maximum_changes = work_item_count * 16u32
  let _ = while work_head {
    current_work_head => if current_work_head < work_queue.length() && !work_limit_exceeded {
      let current_work_item = work_queue[current_work_head]
      work_pending[current_work_item] = false
      let mut changed = false
      let mut block_offset = if self_host_u32_equal(current_work_item, 0u32) {
        0u32
      } else {
        body.blocks.length
      }
      let _ = while block_offset {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          let items = module_.blocks[block_index].items
          let mut item_offset = 0u32
          let _ = while item_offset {
            current_item => if current_item < items.length {
              let item = module_.block_items[
                self_host_u32_add(items.start, current_item)
              ]
              match item.kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  initializer,
                ) => {
                  let local_slot = self_host_body_local_slot(
                    module_,
                    body,
                    local_id,
                  )
                  if local_slot != 4294967295u32 &&
                    initializer >= body.expressions.start &&
                    initializer < expression_end {
                    let expected_carrier = local_values[local_slot].carrier
                    if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      initializer,
                      expected_carrier,
                    ) {
                      changed = true
                    }
                    let expression_slot = self_host_body_expression_slot(
                      body,
                      initializer,
                    )
                    let initializer_value = expressions[expression_slot].value
                    if self_host_body_plan_set_local_value(
                      local_values,
                      locals,
                      local_slot,
                      initializer_value,
                    ) {
                      changed = true
                    }
                    if self_host_body_plan_set_expression_value(
                      body,
                      expressions,
                      initializer,
                      local_values[local_slot],
                    ) {
                      changed = true
                    }
                  }
                }
                _ => {}
              }
              continue current_item + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      // Parents have larger expression ids than their children. Walk backward
      // so an expected carrier reaches a branch tail, local, and initializer
      // in one pass instead of one graph edge per pass.
      expression = if self_host_u32_equal(current_work_item, 0u32) ||
        current_work_item > body.expressions.length {
        body.expressions.start
      } else {
        self_host_u32_add(body.expressions.start, current_work_item)
      }
      let _ = while expression {
        remaining => if remaining > body.expressions.start {
          let current = self_host_u32_subtract(remaining, 1u32)
          let slot = self_host_body_expression_slot(body, current)
          if self_host_body_plan_resolve_field(
            link,
            indexes,
            module_,
            body,
            linked_function.specialization,
            expressions,
            embedded_targets,
            current,
          ) {
            changed = true
          }
          match module_.expressions[current].kind {
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(
              operator,
              operand,
            ) => if operand >= body.expressions.start && operand < expression_end {
              let operand_carrier = expressions[
                self_host_body_expression_slot(body, operand)
              ].carrier
              let semantic_carrier = self_host_body_carrier_from_shape(
                self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  module_.expressions[current].type_,
                ),
              )
              let result_carrier = if operator is SelfHostHirPrefixOperator::LogicalNot {
                SelfHostWasmBodyCarrier::I32BodyCarrier
              } else if !(semantic_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                semantic_carrier
              } else {
                operand_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if !(operator is SelfHostHirPrefixOperator::LogicalNot) &&
                self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  operand,
                  result_carrier,
                ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedBinaryExpression(
              operator,
              left,
              right,
            ) => if left >= body.expressions.start && left < expression_end {
              if right >= body.expressions.start && right < expression_end {
                let left_carrier = expressions[
                  self_host_body_expression_slot(body, left)
                ].carrier
                let right_carrier = expressions[
                  self_host_body_expression_slot(body, right)
                ].carrier
                let prior_result_carrier = expressions[slot].carrier
                let operand_carrier = self_host_body_binary_operand_carrier(
                  operator,
                  left_carrier,
                  right_carrier,
                  prior_result_carrier,
                )
                let result_carrier = if self_host_body_binary_is_comparison(operator) ||
                  operator is SelfHostHirBinaryOperator::LogicalOr ||
                  operator is SelfHostHirBinaryOperator::LogicalAnd {
                  SelfHostWasmBodyCarrier::I32BodyCarrier
                } else {
                  operand_carrier
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  current,
                  result_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  operand_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  operand_carrier,
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedOperatorCall(
              _,
              operator,
              left,
              right,
              _,
            ) => if left >= body.expressions.start && left < expression_end {
              let left_carrier = expressions[
                self_host_body_expression_slot(body, left)
              ].carrier
              let result_carrier = match operator {
                SelfHostHirBinaryOperator::LogicalOr => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::LogicalAnd => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Equal => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::NotEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Less => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::LessEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Greater => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::GreaterEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                _ => left_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if right >= body.expressions.start && right < expression_end {
                let function_index = expressions[slot].call_function_index
                let left_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  0u32,
                )
                let right_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  1u32,
                )
                if !(left_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  left_expected,
                ) {
                  changed = true
                }
                if !(right_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  right_expected,
                ) {
                  changed = true
                }
                if left_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier &&
                  right_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
                  let right_carrier = expressions[
                    self_host_body_expression_slot(body, right)
                  ].carrier
                  let operand_carrier = if !(
                    right_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                  ) {
                    right_carrier
                  } else if !(
                    left_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                  ) {
                    left_carrier
                  } else {
                    expressions[slot].carrier
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    left,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    right,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, arguments, _) => {
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                expressions[slot].call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                expressions[slot].call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => if self_host_body_force_constructor_field_carriers(
              link,
              module_,
              body,
              linked_function.specialization,
              expressions[slot],
              fields,
              expressions,
            ) {
              changed = true
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
              let mut call_function_index = expressions[slot].call_function_index
              if call_function_index == 4294967295u32 {
                let recovered = self_host_body_function_for_physical_receiver_method(
                  link,
                  module_,
                  body,
                  expressions,
                  target,
                  arguments.length,
                )
                if recovered != 4294967295u32 {
                  if self_host_body_plan_set_call_function(
                    body,
                    expressions,
                    current,
                    recovered,
                  ) {
                    changed = true
                  }
                  call_function_index = recovered
                }
              }
              if call_function_index == 4294967295u32 && self_host_u32_greater(
                arguments.length,
                0u32,
              ) {
                let declaration = match module_.expressions[current].call_target {
                  SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
                  _ => 0u64
                }
                let child_index = self_host_u32_add(
                  arguments.start,
                  arguments.length - 1u32,
                )
                if !self_host_u64_equal(declaration, 0u64) &&
                  child_index < module_.expression_children.length() {
                  let argument_expression = module_.expression_children[child_index]
                  if argument_expression >= body.expressions.start &&
                    argument_expression < expression_end {
                    let selected = self_host_body_unique_function_for_last_parameter_carrier(
                      link,
                      declaration,
                      expressions[self_host_body_expression_slot(
                        body,
                        argument_expression,
                      )].carrier,
                    )
                    if self_host_body_plan_set_call_function(
                      body,
                      expressions,
                      current,
                      selected,
                    ) {
                      call_function_index = selected
                      changed = true
                    }
                  }
                }
              }
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_linked_is_unresolved_array_push(module_, current) &&
                self_host_u32_greater(arguments.length, 0u32) &&
                arguments.start < module_.expression_children.length() {
                let item = module_.expression_children[arguments.start]
                if item >= body.expressions.start && item < expression_end {
                  let item_shape = self_host_linked_unresolved_array_push_item_shape(
                    link,
                    module_,
                    body,
                    linked_function.specialization,
                    current,
                  )
                  let item_carrier = self_host_body_carrier_from_shape(item_shape)
                  if !(item_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                    if self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      item,
                      item_carrier,
                    ) {
                      changed = true
                    }
                    match module_.expressions[item].kind {
                      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                        let local_slot = self_host_body_local_slot(
                          module_,
                          body,
                          local_id,
                        )
                        if local_slot < local_values.length() && self_host_body_plan_force_local_value(
                          local_values,
                          locals,
                          local_slot,
                          self_host_body_value_with_carrier(
                            local_values[local_slot],
                            item_carrier,
                          ),
                        ) {
                          changed = true
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 {
                if self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  local_slot,
                  self_host_body_value_with_carrier(
                    local_values[local_slot],
                    expressions[slot].carrier,
                  ),
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_value(
                  body,
                  expressions,
                  current,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 && value >= body.expressions.start &&
                value < expression_end {
                let expected_carrier = local_values[local_slot].carrier
                if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  value,
                  expected_carrier,
                ) {
                  changed = true
                }
                let value_slot = self_host_body_expression_slot(body, value)
                if self_host_body_plan_set_local_value(
                  local_values,
                  locals,
                  local_slot,
                  expressions[value_slot].value,
                ) {
                  changed = true
                }
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  value,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
              let tail = self_host_body_block_tail_expression(module_, block)
              if tail != 4294967295u32 && tail >= body.expressions.start &&
                tail < expression_end {
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[self_host_body_expression_slot(body, tail)].value,
                ) {
                  changed = true
                }
              } else if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_block_carrier(module_, body, expressions, block),
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              _,
              then_block,
              else_expression,
            ) => {
              let expected_carrier = expressions[slot].carrier
              if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                let then_tail = self_host_body_block_tail_expression(
                  module_,
                  then_block,
                )
                if then_tail != 4294967295u32 && then_tail >= body.expressions.start &&
                  then_tail < expression_end && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected_carrier,
                ) {
                  changed = true
                }
                if else_expression >= body.expressions.start && else_expression < expression_end &&
                  self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    else_expression,
                    expected_carrier,
                  ) {
                  changed = true
                }
              }
              let then_carrier = self_host_body_block_carrier(
                module_,
                body,
                expressions,
                then_block,
              )
              let else_carrier = if else_expression >= body.expressions.start &&
                else_expression < expression_end {
                expressions[
                  self_host_body_expression_slot(body, else_expression)
                ].carrier
              } else {
                SelfHostWasmBodyCarrier::UnitBodyCarrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_merge_carrier(then_carrier, else_carrier),
              ) {
                changed = true
              }
              let then_value_expression = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_value_expression != 4294967295u32 &&
                then_value_expression >= body.expressions.start &&
                then_value_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, then_value_expression)
                  ].value,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, else_expression)
                  ].value,
                ) {
                changed = true
              }
              let expected = expressions[slot].carrier
              let then_tail = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_tail != 4294967295u32 &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  else_expression,
                  expected,
                ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(
              subject,
              arms,
            ) => {
              let raw_subject_value = if subject >= body.expressions.start &&
                subject < expression_end {
                expressions[self_host_body_expression_slot(body, subject)].value
              } else {
                self_host_body_physical_value(
                  indexes,
                  -1i32,
                  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
                  0u64,
                )
              }
              let recovered_subject_owner = if self_host_u64_equal(
                raw_subject_value.nominal_owner,
                0u64,
              ) {
                self_host_linked_expression_nominal_declaration(
                  link,
                  module_,
                  body,
                  subject,
                )
              } else {
                raw_subject_value.nominal_owner
              }
              let subject_value = if !self_host_u64_equal(
                recovered_subject_owner,
                raw_subject_value.nominal_owner,
              ) {
                self_host_body_physical_value(
                  indexes,
                  raw_subject_value.logical_type,
                  raw_subject_value.carrier,
                  recovered_subject_owner,
                )
              } else {
                raw_subject_value
              }
              let subject_carrier = subject_value.carrier
              let expected_match_carrier = expressions[slot].carrier
              // Never is the identity for a join over branch completions.
              // Unknown here erased an all-diverging match on each visit;
              // its parent then restored Never and kept the queue alive.
              let mut merged = SelfHostWasmBodyCarrier::NeverBodyCarrier
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      let source_arm = self_host_planned_pattern_arm_identity(
                        module_.pattern_arms[arm_index],
                      )
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      let generic_payload_hint = match self_host_linked_exact_map_get_value_shape(
                        link,
                        module_,
                        body,
                        linked_function.specialization,
                        subject,
                      ) {
                        Option::Some(shape) => shape
                        Option::None => match self_host_linked_map_get_value_shape(
                          link,
                          module_,
                          body,
                          subject,
                        ) {
                          Option::Some(shape) => shape
                          Option::None => match self_host_linked_expression_container_element_shape(
                            link,
                            module_,
                            body,
                            subject,
                          ) {
                            Option::Some(shape) => shape
                            Option::None => match self_host_linked_type_first_argument_shape(
                              module_,
                              if subject < module_.expressions.length() {
                                module_.expressions[subject].type_
                              } else {
                                -1i32
                              },
                            ) {
                              Option::Some(shape) => shape
                              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                            }
                          }
                        }
                      }
                      let pattern_name = self_host_linked_pattern_name(
                        module_,
                        module_.patterns[source_arm.pattern],
                      )
                      let declared_payload_hint = match module_.patterns[
                        source_arm.pattern
                      ].source {
                        SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
                          children.length,
                          0u32,
                        ) && children.start < module_.pattern_children.length() {
                          let child_pattern = module_.pattern_children[children.start]
                          if child_pattern < module_.patterns.length() {
                            module_.patterns[child_pattern].shape
                          } else {
                            SelfHostPlannedValueShape::ErrorPlannedValueShape
                          }
                        } else {
                          SelfHostPlannedValueShape::ErrorPlannedValueShape
                        }
                        _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
                      }
                      let physical_payload_hint = if pattern_name == "Some" {
                        match self_host_linked_match_binding_use_shape(
                          link,
                          module_,
                          body,
                          linked_function.specialization,
                          arms,
                        ) {
                          Option::Some(shape) => if self_host_specialization_canonical_scalar(
                            shape,
                          ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                            shape
                          } else {
                            match self_host_linked_match_subject_receiver_element_shape(
                              link,
                              module_,
                              body,
                              subject,
                            ) {
                              Option::Some(receiver_shape) => receiver_shape
                              Option::None => if !(
                                shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                              ) {
                                shape
                              } else {
                                generic_payload_hint
                              }
                            }
                          }
                          Option::None => match self_host_linked_match_subject_receiver_element_shape(
                            link,
                            module_,
                            body,
                            subject,
                          ) {
                            Option::Some(shape) => shape
                            Option::None => generic_payload_hint
                          }
                        }
                      } else if (pattern_name == "Ok" || pattern_name == "Err") && !(
                        declared_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape
                      ) {
                        declared_payload_hint
                      } else {
                        generic_payload_hint
                      }
                      if self_host_body_force_physical_pattern_payloads(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value.nominal_owner,
                        physical_payload_hint,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      if self_host_body_seed_match_payload_binding(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject,
                        if subject < module_.expressions.length() {
                          module_.expressions[subject].type_
                        } else {
                          -1i32
                        },
                        if subject >= body.expressions.start && subject < expression_end {
                          expressions[
                            self_host_body_expression_slot(body, subject)
                          ].call_function_index
                        } else {
                          4294967295u32
                        },
                        linked_function.specialization,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      let arm_body = source_arm.body
                      if arm_body >= body.expressions.start && arm_body < expression_end {
                        let original_arm_carrier = expressions[
                          self_host_body_expression_slot(body, arm_body)
                        ].carrier
                        if !(expected_match_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                          original_arm_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                        let arm_slot = self_host_body_expression_slot(
                          body,
                          arm_body,
                        )
                        merged = self_host_body_merge_carrier(
                          merged,
                          expressions[arm_slot].carrier,
                        )
                        if self_host_body_plan_set_expression_value(
                          body,
                          expressions,
                          current,
                          expressions[arm_slot].value,
                        ) {
                          changed = true
                        }
                        if !(expected_match_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                          expressions[arm_slot].carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                merged,
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedWhileExpression(
              loop_control,
              initial,
              arms,
            ) => if loop_control < control_states.length() &&
              initial >= body.expressions.start && initial < expression_end {
              let initial_value = expressions[
                self_host_body_expression_slot(body, initial)
              ].value
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                initial_value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                initial,
                control_state_values[loop_control],
              ) {
                changed = true
              }
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[slot].value,
              ) {
                changed = true
              }
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        self_host_planned_pattern_arm_identity(
                          module_.pattern_arms[arm_index],
                        ).pattern,
                        control_state_values[loop_control],
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                current,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedBreakExpression(
              loop_control,
              value,
            ) => if loop_control < control_results.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedContinueExpression(
              loop_control,
              value,
            ) => if loop_control < control_states.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              let boundary_value = match self_host_body_loop_initial_value(
                module_,
                body,
                expressions,
                loop_control,
              ) {
                Option::Some(initial_value) => if !(
                  initial_value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                ) {
                  initial_value
                } else {
                  control_state_values[loop_control]
                }
                Option::None => control_state_values[loop_control]
              }
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                boundary_value,
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => if value != 4294967295u32 &&
              value >= body.expressions.start && value < expression_end &&
              self_host_body_plan_force_expression_carrier(
                body,
                expressions,
                value,
                physical_result_carrier,
              ) {
              changed = true
            }
            _ => {
              let _ = slot
            }
          }
          break self_host_semantic_unit()
        } else {
          break self_host_semantic_unit()
        }
      }
      if current_work_item > body.expressions.length {
        // A hub has no transfer rule. Its job is to wake the exact expressions
        // and block constraints that depend on its local or control cell.
        self_host_body_schedule_work_dependents(
          work_graph,
          work_queue,
          work_pending,
          current_work_item,
        )
      }
      if changed {
        successful_changes = self_host_u32_add(successful_changes, 1u32)
        if successful_changes > maximum_changes {
          work_limit_exceeded = true
          stalled_work_item = current_work_item
        } else {
          self_host_body_schedule_work_dependents(
            work_graph,
            work_queue,
            work_pending,
            current_work_item,
          )
        }
      }
      let next_work_head = self_host_u32_add(current_work_head, 1u32)
      processed_work_items = next_work_head
      continue next_work_head
    } else {
      break self_host_semantic_unit()
    }
  }
  let analysis_converged = processed_work_items >= work_queue.length() &&
    !work_limit_exceeded
  // The plan is frozen here. All physical facts above are worklist facts.
  // The remaining work only materializes immutable call and scratch recipes.
  let call_evaluations = []
  let call_operands = []
  let calls = self_host_body_build_physical_call_plans(
    link,
    module_,
    body,
    expressions,
    call_evaluations,
    call_operands,
  )
  self_host_body_build_string_pattern_calls(
    link, module_, body, linked_function.specialization,
    calls, call_evaluations, call_operands,
  )
  let scratches = self_host_body_empty_scratches()
  let mut scratch_plan_index = 0u32
  while scratch_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, _) => {
          let value = if subject >= body.expressions.start && subject < expression_end {
            expressions[self_host_body_expression_slot(body, subject)].value
          } else {
            self_host_body_physical_value(
              indexes,
              -1i32,
              SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
              0u64,
            )
          }
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            value,
            "match subject",
          )
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(loop_control, _, _) => if loop_control < control_states.length() {
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            control_state_values[loop_control],
            "loop state",
          )
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          ),
          "function value",
        )
        SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          expression_plan.value,
          "product projection",
        )
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          ),
          "array literal",
        )
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result_carrier = physical_result_carrier
  let local_slots = []
  let mut physical_local_count = 0u32
  let parameter_offset = if self_host_u32_equal(lambda, 4294967295u32) {
    0u32
  } else {
    1u32
  }
  let mut logical_local = 0u32
  for value in local_values {
    let elided = module_.locals[body.locals.start + logical_local].elided
    logical_local = logical_local + 1u32
    if elided || value.carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier || value.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
      local_slots.push(4294967295u32)
    } else {
      local_slots.push(parameter_offset + physical_local_count)
      physical_local_count = physical_local_count + 1u32
    }
  }
  SelfHostPlannedPhysicalBodyCarrierPlan::{
    converged: analysis_converged
    stalled_work_item: stalled_work_item
    module_index: linked_function.module_index
    module_id: module_.module_id
    declaration: linked_function.declaration
    body: body.body
    lambda: lambda
    physical_function_index: self_host_u32_add(
      linked_function.function_index,
      2u32,
    )
    specialization: linked_function.specialization
    specialization_key: self_host_body_specialization_key(
      link,
      linked_function.declaration,
      linked_function.specialization,
    )
    result: result
    result_carrier: result_carrier
    expressions: expressions
    local_values: local_values
    locals: locals
    local_slots: local_slots
    physical_local_count: physical_local_count
    control_state_values: control_state_values
    control_states: control_states
    control_result_values: control_result_values
    control_results: control_results
    scratches: scratches
    calls: calls
    call_evaluations: call_evaluations
    call_operands: call_operands
  }
}

fn self_host_body_plan_expression(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
) -> Option<SelfHostPlannedPhysicalExpressionCarrier> {
  if self_host_u32_equal(plan.expressions.length(), 0u32) {
    return Option::None
  }
  let first = self_host_body_physical_expression_at(plan.expressions, 0u32)
  if expression < first.expression {
    return Option::None
  }
  let slot = expression - first.expression
  if slot >= plan.expressions.length() {
    return Option::None
  }
  let source = self_host_body_physical_expression_at(plan.expressions, slot)
  if self_host_u32_equal(source.expression, expression) {
    Option::Some(source)
  } else {
    Option::None
  }
}

fn self_host_body_expression_kind_name(
  kind: SelfHostPlannedExpressionKind,
) -> String {
  match kind {
    SelfHostPlannedExpressionKind::PlannedPoisonExpression => "poison"
    SelfHostPlannedExpressionKind::PlannedDeadExpression => "dead"
    SelfHostPlannedExpressionKind::PlannedDeferredExpression => "deferred"
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => "consumed"
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => "i8.const"
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => "i16.const"
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => "i32.const"
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => "i64.const"
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => "u8.const"
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => "u16.const"
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => "u32.const"
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => "u64.const"
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => "f32.const"
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => "f64.const"
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => "bool.const"
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => "string.const"
    SelfHostPlannedExpressionKind::PlannedUnitConst => "unit.const"
    SelfHostPlannedExpressionKind::PlannedStringArrayConst(_) => "string-array.const"
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => "bytes.const"
    SelfHostPlannedExpressionKind::PlannedLocalGet(_) => "local.get"
    SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => "capture.get"
    SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => "module.get"
    SelfHostPlannedExpressionKind::PlannedFunctionReference(_) => "function.reference"
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => "product.new"
    SelfHostPlannedExpressionKind::PlannedEvaluationSequence(_) => "evaluation.sequence"
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => "array.literal"
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => "lambda.closure"
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => "object.new"
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => "construct"
    SelfHostPlannedExpressionKind::PlannedBlockExpression(_) => "block"
    SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => "local.set"
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => "direct.call"
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => "builtin.call"
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => "unresolved.call"
    SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => "field.get"
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => "unresolved.field"
    SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) => "if"
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => "match"
    SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => "while"
    SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, _) => "prefix"
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, _, _) => "binary"
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _) => "operator.call"
    SelfHostPlannedExpressionKind::PlannedReturnExpression(_) => "return"
    SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => "product.field"
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => "index.get"
    SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => "capture.set"
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, _, _) => "field.set"
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _) => "index.set"
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => "function-value.call"
    SelfHostPlannedExpressionKind::PlannedBreakExpression(_, _) => "break"
    SelfHostPlannedExpressionKind::PlannedContinueExpression(_, _) => "continue"
  }
}

fn self_host_body_add_known_expression_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  source: SelfHostPlannedExpression,
  expression: U32,
  entity: U64,
  selected_owner: U64,
  context: String,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    code: self_host_body_diagnostic_code(context)
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: selected_owner
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  entity: U64,
  context: String,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let source = if expression < module_.expressions.length() {
    module_.expressions[expression]
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    code: self_host_body_diagnostic_code(context)
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Option::Some(value) => value.value.nominal_owner
      Option::None => source.nominal
    }
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_nominal_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  expected_owner: U64,
  actual_owner: U64,
  context: String,

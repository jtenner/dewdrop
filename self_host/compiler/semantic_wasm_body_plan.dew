}

fn self_host_body_local_by_initializer(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Array<U32> {
  let result = []
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      result.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() {
        let local = self_host_body_planned_local_identity(module_.locals[source])
        match self_host_linked_local_initializer_expression(
          module_,
          body,
          local.local_id,
        ) {
          Option::Some(initializer) => if initializer >= body.expressions.start {
            let relative = initializer - body.expressions.start
            if relative < result.length() {
              self_host_body_u32_set(result, relative, current)
            }
          }
          Option::None => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_body_force_constructor_field_carriers(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  specialization: U32,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  fields: SelfHostHirSpan,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
) -> Bool {
  let type_index = if self_host_u32_equal(
    expression_plan.selected_type_index,
    4294967295u32,
  ) {
    match self_host_linked_infer_constructor_type_index(
      link,
      module_,
      body,
      specialization,
      module_.expressions[expression_plan.expression].nominal,
      fields,
    ) {
      Option::Some(value) => value
      Option::None => return false
    }
  } else {
    expression_plan.selected_type_index
  }
  let mut changed = false
  for linked_type in link.types {
    if self_host_u32_equal(
      linked_type.type_index,
      type_index,
    ) {
      let physical_module = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        physical_module,
        linked_type.fragment_index,
      )
      let mut physical_offset = 0u32
      let _ = while physical_offset {
        current => if current < physical.fields.length {
          let destination = self_host_body_physical_field(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          let mut argument = 4294967295u32
          let mut source_offset = 0u32
          let _ = while source_offset {
            source => if source < fields.length {
              let object_index = self_host_u32_add(fields.start, source)
              if object_index < module_.object_fields.length() {
                let object_field = self_host_planned_object_field_identity(
                  module_.object_fields[object_index],
                )
                let exact_field = self_host_u64_equal(
                  object_field.field,
                  destination.declaration,
                )
                let named_field = self_host_u32_greater(
                  self_host_linked_module_name_count(module_),
                  object_field.name,
                ) && match self_host_linked_field_name(
                  link,
                  destination.declaration,
                ) {
                  Option::Some(destination_name) => self_host_linked_module_name_at(
                    module_,
                    object_field.name,
                  ) == destination_name
                  Option::None => false
                }
                if exact_field {
                  argument = object_field.value
                  break self_host_semantic_unit()
                }
                if named_field && self_host_u32_equal(argument, 4294967295u32) {
                  argument = object_field.value
                }
              }
              continue source + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if !self_host_u32_equal(argument, 4294967295u32) &&
            self_host_body_plan_force_expression_carrier(
              body,
              expressions,
              argument,
              self_host_body_carrier_from_storage(destination.storage),
            ) {
            changed = true
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return changed
    }
  }
  changed
}

fn self_host_body_force_call_result(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  call_function_index: U32,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  local_by_initializer: Array<U32>,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if call_function_index == 4294967295u32 {
    return false
  }
  let physical_function = self_host_linked_physical_function_index(
    call_function_index,
  )
  if physical_function < indexes.call_site_result_by_function.length() {
    if self_host_body_bool_at(
      indexes.call_site_result_by_function,
      physical_function,
    ) {
      return false
    }
  }
  let result_shape = self_host_linked_physical_function_result_shape(
    link,
    physical_function,
  )
  let result_carrier = self_host_body_carrier_from_shape(result_shape)
  if result_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return false
  }
  let mut changed = self_host_body_plan_force_expression_carrier(
    body,
    expressions,
    expression,
    result_carrier,
  )
  if expression >= body.expressions.start {
    let relative = expression - body.expressions.start
    if relative < local_by_initializer.length() {
      let local_offset = self_host_body_u32_at(local_by_initializer, relative)
      if local_offset < local_values.length() {
        if self_host_body_plan_force_local_value(
          local_values,
          locals,
          local_offset,
          self_host_body_value_with_carrier(
            local_values[local_offset],
            result_carrier,
          ),
        ) {
          changed = true
        }
      }
    }
  }
  changed
}

fn self_host_body_force_call_arguments(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  arguments: SelfHostHirSpan,
  call_function_index: U32,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if call_function_index == 4294967295u32 {
    return false
  }
  let physical_function = self_host_linked_physical_function_index(
    call_function_index,
  )
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    physical_function,
  )
  if parameter_count < arguments.length {
    return false
  }
  let parameter_offset = self_host_u32_subtract(
    parameter_count,
    arguments.length,
  )
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut changed = false
  let mut argument = 0u32
  let _ = while argument {
    current => if current < arguments.length {
      let child = self_host_u32_add(arguments.start, current)
      if child < module_.expression_children.length() {
        let argument_expression = module_.expression_children[child]
        if argument_expression >= body.expressions.start &&
          argument_expression < expression_end {
          let expected_shape = self_host_linked_physical_function_parameter_shape(
            link,
            physical_function,
            self_host_u32_add(parameter_offset, current),
          )
          let expected = self_host_body_carrier_from_shape(expected_shape)
          if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            if self_host_body_plan_force_expression_carrier(
              body,
              expressions,
              argument_expression,
              expected,
            ) {
              changed = true
            }
            match module_.expressions[argument_expression].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                let slot = self_host_body_local_slot(module_, body, local_id)
                if slot < local_values.length() && self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  slot,
                  self_host_body_value_with_carrier(
                    local_values[slot],
                    expected,
                  ),
                ) {
                  changed = true
                }
              }
              _ => {}
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = expression
  changed
}

fn self_host_body_empty_physical_values(
) -> Array<SelfHostPlannedPhysicalValueInfo> {
  let values = [SelfHostPlannedPhysicalValueInfo::{
    logical_type: -1i32
    carrier: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    nominal_owner: 0u64
    physical_heap_type: 4294967295u32
  }]
  values.truncate(0u32)
  values
}

fn self_host_body_physical_expression_at(
  values: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  index: U32,
) -> SelfHostPlannedPhysicalExpressionCarrier {
  array_get_unchecked(values, index)
}

fn self_host_body_empty_physical_expressions(
) -> Array<SelfHostPlannedPhysicalExpressionCarrier> {
  let values = [SelfHostPlannedPhysicalExpressionCarrier::{
    expression: 0u32
    value: SelfHostPlannedPhysicalValueInfo::{
      logical_type: -1i32
      carrier: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      nominal_owner: 0u64
      physical_heap_type: 4294967295u32
    }
    carrier: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    receiver_expression: 4294967295u32
    receiver_logical_type: -1i32
    receiver_nominal_owner: 0u64
    receiver_physical_heap_type: 4294967295u32
    selected_field: 0u64
    selected_type_index: 4294967295u32
    selected_field_index: 4294967295u32
    selected_storage: Option::None
    call_function_index: 4294967295u32
  }]
  values.truncate(0u32)
  values
}

fn self_host_body_planned_local_identity(
  value: SelfHostPlannedLocal,
) -> SelfHostPlannedLocal {
  value
}

fn self_host_body_empty_carriers() -> Array<SelfHostWasmBodyCarrier> {
  let values = [SelfHostWasmBodyCarrier::UnresolvedBodyCarrier]
  values.truncate(0u32)
  values
}

fn self_host_body_empty_scratches(
) -> Array<SelfHostPlannedPhysicalScratchCarrier> {
  let values = [SelfHostPlannedPhysicalScratchCarrier::{
    expression: 0u32
    ordinal: 0u32
    value: SelfHostPlannedPhysicalValueInfo::{
      logical_type: -1i32
      carrier: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      nominal_owner: 0u64
      physical_heap_type: 4294967295u32
    }
    carrier: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    context: ""
  }]
  values.truncate(0u32)
  values
}

fn self_host_plan_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  linked_function: SelfHostPlannedProgramWasmFunction,
  body: SelfHostPlannedBodyLowering,
  lambda: U32,
) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  let module_ = link.fragments.specialization.lowering.modules[
    linked_function.module_index
  ]
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  let local_by_initializer = self_host_body_local_by_initializer(module_, body)
  let fragment_module = self_host_body_fragment_module(
    link,
    linked_function.module_index,
  )
  let fragment = self_host_body_function_fragment(
    fragment_module,
    linked_function.fragment_index,
  )
  let expressions = self_host_body_empty_physical_expressions()
  let mut expression = body.expressions.start
  let expression_end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let _ = while expression {
    current => if current < expression_end {
      expressions.push(
        self_host_body_seed_expression(
          link,
          indexes,
          module_,
          body,
          linked_function.specialization,
          current,
        ),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let local_values = self_host_body_empty_physical_values()
  let locals = self_host_body_empty_carriers()
  let mut parameter_index = if lambda == 4294967295u32 {
    0u32
  } else {
    1u32
  }
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_body_planned_local_identity(
        module_.locals[self_host_u32_add(body.locals.start, current)],
      )
      let local_carrier = if source.kind is SelfHostBodyLocalKind::ParameterLocal &&
        parameter_index < fragment.parameters.length {
        let value_index = self_host_u32_add(fragment.parameters.start, parameter_index)
        let parameter_carrier = if self_host_u32_greater(
          fragment_module.function_value_types.length(),
          value_index,
        ) {
          self_host_body_carrier_from_value_type(
            self_host_body_function_value_type(
              fragment_module,
              value_index,
            ),
          )
        } else {
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
        }
        parameter_index = self_host_u32_add(parameter_index, 1u32)
        parameter_carrier
      } else {
        // Initializers, assignments, and pattern payloads are physical proof.
        // A stale inferred local shape must not rewrite those expressions.
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      let inferred_local_owner = if !self_host_u64_equal(source.nominal, 0u64) {
        source.nominal
      } else {
        self_host_linked_type_nominal_declaration(module_, source.type_)
      }
      let local_owner = if source.kind is SelfHostBodyLocalKind::ParameterLocal &&
        self_host_u64_equal(inferred_local_owner, 0u64) {
        self_host_body_local_parameter_nominal_owner(
          link,
          module_,
          body,
          source.local_id,
        )
      } else {
        inferred_local_owner
      }
      local_values.push(
        self_host_body_physical_value(
          indexes,
          source.type_,
          local_carrier,
          local_owner,
        ),
      )
      locals.push(local_carrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut pattern_offset = 0u32
  let _ = while pattern_offset {
    current => if current < body.patterns.length {
      let pattern_index = self_host_u32_add(body.patterns.start, current)
      if pattern_index < module_.patterns.length() {
        let pattern = self_host_planned_pattern_identity(
          module_.patterns[pattern_index],
        )
        match pattern.source {
          SelfHostHirPattern::TuplePattern(_, children, _) => {
            let mut child_offset = 0u32
            let _ = while child_offset {
              field_index => if field_index < children.length {
                let child_index = self_host_u32_add(children.start, field_index)
                if child_index < module_.pattern_children.length() {
                  let child = module_.pattern_children[child_index]
                  if child < module_.patterns.length() {
                    match self_host_planned_pattern_identity(
                      module_.patterns[child],
                    ).reference {
                      SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
                        let slot = self_host_body_local_slot(module_, body, local_id)
                        if slot < local_values.length() {
                          let payload_value = self_host_body_pattern_payload_value(
                            link,
                            indexes,
                            module_,
                            pattern,
                            field_index,
                            local_values[slot],
                          )
                          let _ = self_host_body_plan_force_local_value(
                            local_values,
                            locals,
                            slot,
                            payload_value,
                          )
                        }
                      }
                      _ => {}
                    }
                  }
                }
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let control_state_values = self_host_body_empty_physical_values()
  let control_states = self_host_body_empty_carriers()
  let control_result_values = self_host_body_empty_physical_values()
  let control_results = self_host_body_empty_carriers()
  let mut maximum_control = 0u32
  let mut control_plan_index = 0u32
  while control_plan_index {
    current => if current < expressions.length() {
      let planned = self_host_body_physical_expression_at(expressions, current)
      match module_.expressions[planned.expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(control, _, _) => if control != 4294967295u32 &&
          control >= maximum_control {
          maximum_control = self_host_u32_add(control, 1u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut control = 0u32
  let _ = while control {
    current => if current < maximum_control {
      control_state_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_states.push(SelfHostWasmBodyCarrier::UnresolvedBodyCarrier)
      control_result_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_results.push(SelfHostWasmBodyCarrier::UnresolvedBodyCarrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let physical_result_carrier = if self_host_u32_equal(
    fragment.results.length,
    0u32,
  ) {
    SelfHostWasmBodyCarrier::UnitBodyCarrier
  } else if self_host_u32_equal(fragment.results.length, 1u32) &&
    self_host_u32_greater(
      fragment_module.function_value_types.length(),
      fragment.results.start,
    ) {
    self_host_body_carrier_from_value_type(
      self_host_body_function_value_type(
        fragment_module,
        fragment.results.start,
      ),
    )
  } else {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let result_owner = match self_host_program_specialization_callable(
    module_,
    linked_function.declaration,
  ) {
    Option::Some(callable) => self_host_linked_resolved_nominal_declaration(
      module_,
      callable.result_type,
    )
    Option::None => 0u64
  }
  let result = self_host_body_physical_value(
    indexes,
    body.root_type,
    physical_result_carrier,
    result_owner,
  )
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(root) => {
      // The physical function signature is exact proof for its root value.
      // A logical fallback must not replace this carrier.
      let _ = self_host_body_plan_force_expression_value(
        body,
        expressions,
        root,
        result,
      )
    }
    SelfHostHirBodyRoot::BlockBodyRoot(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if tail != 4294967295u32 {
        // The block tail must produce the exact physical function result.
        let _ = self_host_body_plan_force_expression_value(
          body,
          expressions,
          tail,
          result,
        )
      }
    }
  }
  let mut changed = true
  let mut pass = 0u32
  let _ = while pass {
    current_pass => if current_pass < 8u32 && changed {
      changed = false
      let mut block_offset = 0u32
      let _ = while block_offset {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          let items = module_.blocks[block_index].items
          let mut item_offset = 0u32
          let _ = while item_offset {
            current_item => if current_item < items.length {
              let item = module_.block_items[
                self_host_u32_add(items.start, current_item)
              ]
              match item.kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  initializer,
                ) => {
                  let local_slot = self_host_body_local_slot(
                    module_,
                    body,
                    local_id,
                  )
                  if local_slot != 4294967295u32 &&
                    initializer >= body.expressions.start &&
                    initializer < expression_end {
                    let expected_carrier = local_values[local_slot].carrier
                    if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      initializer,
                      expected_carrier,
                    ) {
                      changed = true
                    }
                    let expression_slot = self_host_body_expression_slot(
                      body,
                      initializer,
                    )
                    let initializer_value = expressions[expression_slot].value
                    if self_host_body_plan_set_local_value(
                      local_values,
                      locals,
                      local_slot,
                      initializer_value,
                    ) {
                      changed = true
                    }
                    if self_host_body_plan_set_expression_value(
                      body,
                      expressions,
                      initializer,
                      local_values[local_slot],
                    ) {
                      changed = true
                    }
                  }
                }
                _ => {}
              }
              continue current_item + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      // Parents have larger expression ids than their children. Walk backward
      // so an expected carrier reaches a branch tail, local, and initializer
      // in one pass instead of one graph edge per pass.
      expression = expression_end
      let _ = while expression {
        remaining => if remaining > body.expressions.start {
          let current = self_host_u32_subtract(remaining, 1u32)
          let slot = self_host_body_expression_slot(body, current)
          if self_host_body_plan_resolve_field(
            link,
            indexes,
            module_,
            body,
            expressions,
            embedded_targets,
            current,
          ) {
            changed = true
          }
          match module_.expressions[current].kind {
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(
              operator,
              operand,
            ) => if operand >= body.expressions.start && operand < expression_end {
              let operand_carrier = expressions[
                self_host_body_expression_slot(body, operand)
              ].carrier
              let semantic_carrier = self_host_body_carrier_from_shape(
                self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  module_.expressions[current].type_,
                ),
              )
              let result_carrier = if operator is SelfHostHirPrefixOperator::LogicalNot {
                SelfHostWasmBodyCarrier::I32BodyCarrier
              } else if !(semantic_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                semantic_carrier
              } else {
                operand_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if !(operator is SelfHostHirPrefixOperator::LogicalNot) &&
                self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  operand,
                  result_carrier,
                ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedBinaryExpression(
              operator,
              left,
              right,
            ) => if left >= body.expressions.start && left < expression_end {
              if right >= body.expressions.start && right < expression_end {
                let left_carrier = expressions[
                  self_host_body_expression_slot(body, left)
                ].carrier
                let right_carrier = expressions[
                  self_host_body_expression_slot(body, right)
                ].carrier
                let prior_result_carrier = expressions[slot].carrier
                let operand_carrier = self_host_body_binary_operand_carrier(
                  operator,
                  left_carrier,
                  right_carrier,
                  prior_result_carrier,
                )
                let result_carrier = if self_host_body_binary_is_comparison(operator) ||
                  operator is SelfHostHirBinaryOperator::LogicalOr ||
                  operator is SelfHostHirBinaryOperator::LogicalAnd {
                  SelfHostWasmBodyCarrier::I32BodyCarrier
                } else {
                  operand_carrier
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  current,
                  result_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  operand_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  operand_carrier,
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedOperatorCall(
              _,
              operator,
              left,
              right,
              _,
            ) => if left >= body.expressions.start && left < expression_end {
              let left_carrier = expressions[
                self_host_body_expression_slot(body, left)
              ].carrier
              let result_carrier = match operator {
                SelfHostHirBinaryOperator::LogicalOr => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::LogicalAnd => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Equal => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::NotEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Less => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::LessEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::Greater => SelfHostWasmBodyCarrier::I32BodyCarrier
                SelfHostHirBinaryOperator::GreaterEqual => SelfHostWasmBodyCarrier::I32BodyCarrier
                _ => left_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if right >= body.expressions.start && right < expression_end {
                let function_index = expressions[slot].call_function_index
                let left_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  0u32,
                )
                let right_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  1u32,
                )
                if !(left_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  left_expected,
                ) {
                  changed = true
                }
                if !(right_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  right_expected,
                ) {
                  changed = true
                }
                if left_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier &&
                  right_expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
                  let right_carrier = expressions[
                    self_host_body_expression_slot(body, right)
                  ].carrier
                  let operand_carrier = if !(
                    right_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                  ) {
                    right_carrier
                  } else if !(
                    left_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                  ) {
                    left_carrier
                  } else {
                    expressions[slot].carrier
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    left,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    right,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, arguments, _) => {
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                expressions[slot].call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                expressions[slot].call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => if self_host_body_force_constructor_field_carriers(
              link,
              module_,
              body,
              linked_function.specialization,
              expressions[slot],
              fields,
              expressions,
            ) {
              changed = true
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
              let mut call_function_index = expressions[slot].call_function_index
              if call_function_index == 4294967295u32 {
                let recovered = self_host_body_function_for_physical_receiver_method(
                  link,
                  module_,
                  body,
                  expressions,
                  target,
                  arguments.length,
                )
                if recovered != 4294967295u32 {
                  self_host_body_plan_set_call_function(
                    body,
                    expressions,
                    current,
                    recovered,
                  )
                  call_function_index = recovered
                  changed = true
                }
              }
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_linked_is_unresolved_array_push(module_, current) &&
                self_host_u32_greater(arguments.length, 0u32) &&
                arguments.start < module_.expression_children.length() {
                let item = module_.expression_children[arguments.start]
                if item >= body.expressions.start && item < expression_end {
                  let item_shape = self_host_linked_unresolved_array_push_item_shape(
                    link,
                    module_,
                    body,
                    linked_function.specialization,
                    current,
                  )
                  let item_carrier = self_host_body_carrier_from_shape(item_shape)
                  if !(item_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                    if self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      item,
                      item_carrier,
                    ) {
                      changed = true
                    }
                    match module_.expressions[item].kind {
                      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                        let local_slot = self_host_body_local_slot(
                          module_,
                          body,
                          local_id,
                        )
                        if local_slot < local_values.length() && self_host_body_plan_force_local_value(
                          local_values,
                          locals,
                          local_slot,
                          self_host_body_value_with_carrier(
                            local_values[local_slot],
                            item_carrier,
                          ),
                        ) {
                          changed = true
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 {
                if self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  local_slot,
                  self_host_body_value_with_carrier(
                    local_values[local_slot],
                    expressions[slot].carrier,
                  ),
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_value(
                  body,
                  expressions,
                  current,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 && value >= body.expressions.start &&
                value < expression_end {
                let expected_carrier = local_values[local_slot].carrier
                if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  value,
                  expected_carrier,
                ) {
                  changed = true
                }
                let value_slot = self_host_body_expression_slot(body, value)
                if self_host_body_plan_set_local_value(
                  local_values,
                  locals,
                  local_slot,
                  expressions[value_slot].value,
                ) {
                  changed = true
                }
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  value,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
              let tail = self_host_body_block_tail_expression(module_, block)
              if tail != 4294967295u32 && tail >= body.expressions.start &&
                tail < expression_end {
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[self_host_body_expression_slot(body, tail)].value,
                ) {
                  changed = true
                }
              } else if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_block_carrier(module_, body, expressions, block),
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              _,
              then_block,
              else_expression,
            ) => {
              let expected_carrier = expressions[slot].carrier
              if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                let then_tail = self_host_body_block_tail_expression(
                  module_,
                  then_block,
                )
                if then_tail != 4294967295u32 && then_tail >= body.expressions.start &&
                  then_tail < expression_end && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected_carrier,
                ) {
                  changed = true
                }
                if else_expression >= body.expressions.start && else_expression < expression_end &&
                  self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    else_expression,
                    expected_carrier,
                  ) {
                  changed = true
                }
              }
              let then_carrier = self_host_body_block_carrier(
                module_,
                body,
                expressions,
                then_block,
              )
              let else_carrier = if else_expression >= body.expressions.start &&
                else_expression < expression_end {
                expressions[
                  self_host_body_expression_slot(body, else_expression)
                ].carrier
              } else {
                SelfHostWasmBodyCarrier::UnitBodyCarrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_merge_carrier(then_carrier, else_carrier),
              ) {
                changed = true
              }
              let then_value_expression = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_value_expression != 4294967295u32 &&
                then_value_expression >= body.expressions.start &&
                then_value_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, then_value_expression)
                  ].value,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, else_expression)
                  ].value,
                ) {
                changed = true
              }
              let expected = expressions[slot].carrier
              let then_tail = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_tail != 4294967295u32 &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  else_expression,
                  expected,
                ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(
              subject,
              arms,
            ) => {
              let raw_subject_value = if subject >= body.expressions.start &&
                subject < expression_end {
                expressions[self_host_body_expression_slot(body, subject)].value
              } else {
                self_host_body_physical_value(
                  indexes,
                  -1i32,
                  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
                  0u64,
                )
              }
              let recovered_subject_owner = if self_host_u64_equal(
                raw_subject_value.nominal_owner,
                0u64,
              ) {
                self_host_linked_expression_nominal_declaration(
                  link,
                  module_,
                  body,
                  subject,
                )
              } else {
                raw_subject_value.nominal_owner
              }
              let subject_value = if !self_host_u64_equal(
                recovered_subject_owner,
                raw_subject_value.nominal_owner,
              ) {
                self_host_body_physical_value(
                  indexes,
                  raw_subject_value.logical_type,
                  raw_subject_value.carrier,
                  recovered_subject_owner,
                )
              } else {
                raw_subject_value
              }
              let subject_carrier = subject_value.carrier
              let expected_match_carrier = expressions[slot].carrier
              let mut merged = SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      let source_arm = self_host_planned_pattern_arm_identity(
                        module_.pattern_arms[arm_index],
                      )
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      let generic_payload_hint = match self_host_linked_exact_map_get_value_shape(
                        link,
                        module_,
                        body,
                        linked_function.specialization,
                        subject,
                      ) {
                        Option::Some(shape) => shape
                        Option::None => match self_host_linked_map_get_value_shape(
                          link,
                          module_,
                          body,
                          subject,
                        ) {
                          Option::Some(shape) => shape
                          Option::None => match self_host_linked_expression_container_element_shape(
                            link,
                            module_,
                            body,
                            subject,
                          ) {
                            Option::Some(shape) => shape
                            Option::None => match self_host_linked_type_first_argument_shape(
                              module_,
                              if subject < module_.expressions.length() {
                                module_.expressions[subject].type_
                              } else {
                                -1i32
                              },
                            ) {
                              Option::Some(shape) => shape
                              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                            }
                          }
                        }
                      }
                      let pattern_name = self_host_linked_pattern_name(
                        module_,
                        module_.patterns[source_arm.pattern],
                      )
                      let declared_payload_hint = match module_.patterns[
                        source_arm.pattern
                      ].source {
                        SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
                          children.length,
                          0u32,
                        ) && children.start < module_.pattern_children.length() {
                          let child_pattern = module_.pattern_children[children.start]
                          if child_pattern < module_.patterns.length() {
                            module_.patterns[child_pattern].shape
                          } else {
                            SelfHostPlannedValueShape::ErrorPlannedValueShape
                          }
                        } else {
                          SelfHostPlannedValueShape::ErrorPlannedValueShape
                        }
                        _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
                      }
                      let physical_payload_hint = if pattern_name == "Some" {
                        match self_host_linked_match_binding_use_shape(
                          link,
                          module_,
                          body,
                          linked_function.specialization,
                          arms,
                        ) {
                          Option::Some(shape) => if self_host_specialization_canonical_scalar(
                            shape,
                          ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                            shape
                          } else {
                            match self_host_linked_match_subject_receiver_element_shape(
                              link,
                              module_,
                              body,
                              subject,
                            ) {
                              Option::Some(receiver_shape) => receiver_shape
                              Option::None => if !(
                                shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                              ) {
                                shape
                              } else {
                                generic_payload_hint
                              }
                            }
                          }
                          Option::None => match self_host_linked_match_subject_receiver_element_shape(
                            link,
                            module_,
                            body,
                            subject,
                          ) {
                            Option::Some(shape) => shape
                            Option::None => generic_payload_hint
                          }
                        }
                      } else if (pattern_name == "Ok" || pattern_name == "Err") && !(
                        declared_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape
                      ) {
                        declared_payload_hint
                      } else {
                        generic_payload_hint
                      }
                      if self_host_body_force_physical_pattern_payloads(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value.nominal_owner,
                        physical_payload_hint,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      if self_host_body_seed_match_payload_binding(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject,
                        if subject < module_.expressions.length() {
                          module_.expressions[subject].type_
                        } else {
                          -1i32
                        },
                        if subject >= body.expressions.start && subject < expression_end {
                          expressions[
                            self_host_body_expression_slot(body, subject)
                          ].call_function_index
                        } else {
                          4294967295u32
                        },
                        linked_function.specialization,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      let arm_body = source_arm.body
                      if arm_body >= body.expressions.start && arm_body < expression_end {
                        let original_arm_carrier = expressions[
                          self_host_body_expression_slot(body, arm_body)
                        ].carrier
                        if !(expected_match_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                          original_arm_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                        let arm_slot = self_host_body_expression_slot(
                          body,
                          arm_body,
                        )
                        merged = self_host_body_merge_carrier(
                          merged,
                          expressions[arm_slot].carrier,
                        )
                        if self_host_body_plan_set_expression_value(
                          body,
                          expressions,
                          current,
                          expressions[arm_slot].value,
                        ) {
                          changed = true
                        }
                        if !(expected_match_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                          expressions[arm_slot].carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                merged,
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedWhileExpression(
              loop_control,
              initial,
              arms,
            ) => if loop_control < control_states.length() &&
              initial >= body.expressions.start && initial < expression_end {
              let initial_value = expressions[
                self_host_body_expression_slot(body, initial)
              ].value
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                initial_value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                initial,
                control_state_values[loop_control],
              ) {
                changed = true
              }
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[slot].value,
              ) {
                changed = true
              }
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        self_host_planned_pattern_arm_identity(
                          module_.pattern_arms[arm_index],
                        ).pattern,
                        control_state_values[loop_control],
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                current,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedBreakExpression(
              loop_control,
              value,
            ) => if loop_control < control_results.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedContinueExpression(
              loop_control,
              value,
            ) => if loop_control < control_states.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                control_state_values[loop_control],
              ) {
                changed = true
              }
            }
            SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => if value != 4294967295u32 &&
              value >= body.expressions.start && value < expression_end &&
              self_host_body_plan_force_expression_carrier(
                body,
                expressions,
                value,
                physical_result_carrier,
              ) {
              changed = true
            }
            _ => {
              let _ = slot
            }
          }
          continue current
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_pass + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  // A return boundary is exact proof from the physical function signature.
  // Reapply it after the fixed point so broad local propagation cannot erase it.
  self_host_body_force_declared_pattern_payloads(
    link,
    indexes,
    module_,
    body,
    local_values,
    locals,
  )
  self_host_body_force_return_carriers(
    module_,
    body,
    expressions,
    physical_result_carrier,
  )
  let mut field_plan_index = 0u32
  while field_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
          let _ = self_host_body_plan_resolve_field(
            link,
            indexes,
            module_,
            body,
            expressions,
            embedded_targets,
            expression_plan.expression,
          )
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
          let _ = self_host_body_plan_resolve_field(
            link,
            indexes,
            module_,
            body,
            expressions,
            embedded_targets,
            expression_plan.expression,
          )
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut final_local_offset = 0u32
  let _ = while final_local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() {
        let planned_local = module_.locals[local_index]
        if planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
          match self_host_linked_local_initializer_expression(
            module_,
            body,
            planned_local.local_id,
          ) {
            Option::Some(initializer) => if initializer >= body.expressions.start &&
              initializer < expression_end {
              let actual = expressions[self_host_body_expression_slot(
                body,
                initializer,
              )]
              if current < local_values.length() && !(
                actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
              ) && !(actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) &&
                local_values[current].carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier && !(
                  actual.carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
                ) {
                let _ = self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  current,
                  actual.value,
                )
              }
            }
            Option::None => {}
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut loop_local_offset = 0u32
  let _ = while loop_local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() && current < local_values.length() &&
        current < locals.length() {
        let local = module_.locals[local_index]
        let nominal = self_host_linked_loop_binding_nominal_declaration(
          link,
          module_,
          body,
          local.local_id,
        )
        if !self_host_u64_equal(nominal, 0u64) && !self_host_u64_equal(
          local_values[current].nominal_owner,
          nominal,
        ) {
          // Loop planning must keep the exact nominal element type before emission.
          let carrier = if local_values[current].carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
            SelfHostWasmBodyCarrier::EqRefBodyCarrier
          } else {
            local_values[current].carrier
          }
          local_values[current] = SelfHostPlannedPhysicalValueInfo::{
            logical_type: local_values[current].logical_type
            carrier: carrier
            nominal_owner: nominal
            physical_heap_type: self_host_body_physical_heap_type(
              indexes,
              nominal,
            )
          }
          locals[current] = carrier
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut call_plan_index = 0u32
  while call_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => {
          let _ = self_host_body_force_call_result(
            link,
            indexes,
            module_,
            body,
            expression_plan.expression,
            expression_plan.call_function_index,
            expressions,
            local_by_initializer,
            local_values,
            locals,
          )
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
          let _ = self_host_body_force_call_result(
            link,
            indexes,
            module_,
            body,
            expression_plan.expression,
            expression_plan.call_function_index,
            expressions,
            local_by_initializer,
            local_values,
            locals,
          )
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut argument_plan_index = 0u32
  while argument_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      let planned_expression = module_.expressions[expression_plan.expression]
      match planned_expression.kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, arguments) => if self_host_u32_equal(
          expression_plan.call_function_index,
          4294967295u32,
        ) && self_host_u32_greater(
          arguments.length,
          0u32,
        ) {
          let declaration = match planned_expression.call_target {
            SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
            _ => self_host_body_function_declaration(
              link,
              expression_plan.call_function_index,
            )
          }
          if !self_host_u64_equal(declaration, 0u64) {
            let child_index = self_host_u32_add(
              arguments.start,
              arguments.length - 1u32,
            )
            if child_index < module_.expression_children.length() {
              let argument_expression = module_.expression_children[child_index]
              if argument_expression >= body.expressions.start &&
                argument_expression < expression_end {
                let argument_carrier = expressions[
                  self_host_body_expression_slot(body, argument_expression)
                ].carrier
                self_host_body_plan_set_call_function(
                  body,
                  expressions,
                  expression_plan.expression,
                  self_host_body_unique_function_for_last_parameter_carrier(
                    link,
                    declaration,
                    argument_carrier,
                  ),
                )
              }
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut transfer_plan_index = 0u32
  while transfer_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        SelfHostPlannedExpressionKind::PlannedContinueExpression(
          loop_control,
          value,
        ) => if loop_control < control_state_values.length() &&
          value >= body.expressions.start && value < expression_end {
          let boundary_value = match self_host_body_loop_initial_value(
            module_,
            body,
            expressions,
            loop_control,
          ) {
            Option::Some(initial_value) => if !(
              initial_value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
            ) {
              initial_value
            } else {
              control_state_values[loop_control]
            }
            Option::None => control_state_values[loop_control]
          }
          if !(boundary_value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            let _ = self_host_body_plan_force_expression_value(
              body,
              expressions,
              value,
              boundary_value,
            )
            match self_host_body_wrapped_local_get(module_, value) {
              Option::Some(local_id) => {
                let slot = self_host_body_local_slot(module_, body, local_id)
                if slot < local_values.length() && slot < locals.length() {
                  let _ = self_host_body_plan_force_local_value(
                    local_values,
                    locals,
                    slot,
                    boundary_value,
                  )
                }
              }
              Option::None => {}
            }
          }
        }
        SelfHostPlannedExpressionKind::PlannedBreakExpression(
          loop_control,
          value,
        ) => if loop_control < control_result_values.length() &&
          value >= body.expressions.start && value < expression_end && !(
            control_result_values[loop_control].carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
          ) {
          let _ = self_host_body_plan_force_expression_value(
            body,
            expressions,
            value,
            control_result_values[loop_control],
          )
          match self_host_body_wrapped_local_get(module_, value) {
            Option::Some(local_id) => {
              let slot = self_host_body_local_slot(module_, body, local_id)
              if slot < local_values.length() && slot < locals.length() {
                let _ = self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  slot,
                  control_result_values[loop_control],
                )
              }
            }
            Option::None => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let scratches = self_host_body_empty_scratches()
  let mut scratch_plan_index = 0u32
  while scratch_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, _) => {
          let value = if subject >= body.expressions.start && subject < expression_end {
            expressions[self_host_body_expression_slot(body, subject)].value
          } else {
            self_host_body_physical_value(
              indexes,
              -1i32,
              SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
              0u64,
            )
          }
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            value,
            "match subject",
          )
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(loop_control, _, _) => if loop_control < control_states.length() {
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            control_state_values[loop_control],
            "loop state",
          )
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          ),
          "function value",
        )
        SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          expression_plan.value,
          "product projection",
        )
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          ),
          "array literal",
        )
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result_carrier = physical_result_carrier
  SelfHostPlannedPhysicalBodyCarrierPlan::{
    module_index: linked_function.module_index
    module_id: module_.module_id
    declaration: linked_function.declaration
    body: body.body
    lambda: lambda
    physical_function_index: self_host_u32_add(
      linked_function.function_index,
      2u32,
    )
    specialization: linked_function.specialization
    specialization_key: self_host_body_specialization_key(
      link,
      linked_function.declaration,
      linked_function.specialization,
    )
    result: result
    result_carrier: result_carrier
    expressions: expressions
    local_values: local_values
    locals: locals
    control_state_values: control_state_values
    control_states: control_states
    control_result_values: control_result_values
    control_results: control_results
    scratches: scratches
  }
}

fn self_host_body_plan_expression(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
) -> Option<SelfHostPlannedPhysicalExpressionCarrier> {
  if self_host_u32_equal(plan.expressions.length(), 0u32) {
    return Option::None
  }
  let first = self_host_body_physical_expression_at(plan.expressions, 0u32)
  if expression < first.expression {
    return Option::None
  }
  let slot = expression - first.expression
  if slot >= plan.expressions.length() {
    return Option::None
  }
  let source = self_host_body_physical_expression_at(plan.expressions, slot)
  if self_host_u32_equal(source.expression, expression) {
    Option::Some(source)
  } else {
    Option::None
  }
}

fn self_host_body_expression_kind_name(
  kind: SelfHostPlannedExpressionKind,
) -> String {
  match kind {
    SelfHostPlannedExpressionKind::PlannedPoisonExpression => "poison"
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => "consumed"
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => "i8.const"
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => "i16.const"
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => "i32.const"
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => "i64.const"
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => "u8.const"
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => "u16.const"
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => "u32.const"
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => "u64.const"
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => "f32.const"
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => "f64.const"
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => "bool.const"
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => "string.const"
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => "bytes.const"
    SelfHostPlannedExpressionKind::PlannedLocalGet(_) => "local.get"
    SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => "capture.get"
    SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => "module.get"
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => "product.new"
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => "array.literal"
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => "lambda.closure"
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => "object.new"
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => "construct"
    SelfHostPlannedExpressionKind::PlannedBlockExpression(_) => "block"
    SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => "local.set"
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => "direct.call"
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => "builtin.call"
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => "unresolved.call"
    SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => "field.get"
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => "unresolved.field"
    SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) => "if"
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => "match"
    SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => "while"
    SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, _) => "prefix"
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, _, _) => "binary"
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _) => "operator.call"
    SelfHostPlannedExpressionKind::PlannedReturnExpression(_) => "return"
    SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => "product.field"
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => "index.get"
    SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => "capture.set"
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, _, _) => "field.set"
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _) => "index.set"
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => "function-value.call"
    SelfHostPlannedExpressionKind::PlannedBreakExpression(_, _) => "break"
    SelfHostPlannedExpressionKind::PlannedContinueExpression(_, _) => "continue"
  }
}

fn self_host_body_add_known_expression_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  source: SelfHostPlannedExpression,
  expression: U32,
  entity: U64,
  selected_owner: U64,
  context: String,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: selected_owner
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  entity: U64,
  context: String,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let source = if expression < module_.expressions.length() {
    module_.expressions[expression]
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Option::Some(value) => value.value.nominal_owner
      Option::None => source.nominal
    }
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_nominal_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  expected_owner: U64,
  actual_owner: U64,
  context: String,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let source = if expression < module_.expressions.length() {
    self_host_planned_expression_identity(module_.expressions[expression])
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: expected_owner
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Option::Some(value) => value.value.nominal_owner
      Option::None => source.nominal
    }
    expected_owner: expected_owner
    actual_owner: actual_owner
    expected: expected
    actual: actual
  })
}

fn self_host_verify_body_call_result(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.call_function_index == 4294967295u32 {
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _) => {
      return
    }
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => {
      return
    }
    _ => {}
  }
  let physical_function = self_host_linked_physical_function_index(
    expression_plan.call_function_index,
  )
  let function_name = self_host_linked_physical_function_name(
    link,
    physical_function,
  )
  if function_name.ends_with(b"get_unchecked") ||
    function_name.ends_with(b"indexed_get") || function_name.ends_with(b"into") {
    return
  }
  let expected = self_host_body_function_result_carrier(
    link,
    expression_plan.call_function_index,
  )
  if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(expression_plan.call_function_index),
      "call result",
      expected,
      expression_plan.carrier,
    )
  }
}

fn self_host_body_embedded_targets(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Array<Bool> {
  let targets = []
  let mut slot = 0u32
  let _ = while slot {
    current => if current < body.expressions.length {
      targets.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let parent = self_host_u32_add(body.expressions.start, current)
      let target = match self_host_planned_expression_at(
        module_.expressions,
        parent,
      ).kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
        SelfHostPlannedExpressionKind::PlannedConstruct(value, _, _) => value
        _ => 4294967295u32
      }
      if target >= body.expressions.start {
        if target < end {
          targets[target - body.expressions.start] = true
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  targets
}

fn self_host_body_physical_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = self_host_body_fragment_module(link, linked_type.module_index)
      let physical = self_host_body_physical_type(
        module_,
        linked_type.fragment_index,
      )
      return match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(owner) => owner
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(owner) => owner
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(owner, _, _) => owner
        _ => 0u64
      }
    }
  }
  0u64
}

fn self_host_verify_body_field_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 ||
    expression_plan.selected_field_index == 4294967295u32 ||
    self_host_u64_equal(expression_plan.selected_field, 0u64) {
    if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "field access has no exact physical field identity",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
    }
    return
  }
  let expected_owner = self_host_body_physical_owner(
    link,
    expression_plan.selected_type_index,
  )
  let inferred_field = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        field,
        _,
        _,
      ) => field
      _ => 0u64
    }
  } else {
    0u64
  }
  let inferred_field_owner = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        _,
        _,
        owner,
      ) => owner
      _ => 0u64
    }
  } else {
    0u64
  }
  if !self_host_u64_equal(inferred_field, 0u64) && !self_host_u64_equal(
    inferred_field,
    expression_plan.selected_field,
  ) {
    // Physical field planning must keep the exact inference field identity.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field physical identity differs from inference selection",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(inferred_field_owner, 0u64) && !self_host_u64_equal(
    inferred_field_owner,
    expected_owner,
  ) {
    // A physical field type must belong to the inference field declaration.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field physical owner differs from declared field owner",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  let declared_receiver_owner = if expression_plan.receiver_expression < module_.expressions.length() {
    self_host_linked_expression_nominal_declaration(
      link,
      module_,
      body,
      expression_plan.receiver_expression,
    )
  } else {
    0u64
  }
  if !self_host_u64_equal(declared_receiver_owner, 0u64) &&
    !self_host_u64_equal(declared_receiver_owner, expected_owner) {
    // Field selection must not replace the receiver's declared nominal owner.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field target owner does not match receiver type",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) && (
    !self_host_u64_equal(
      expression_plan.receiver_nominal_owner,
      expected_owner,
    ) || !self_host_u32_equal(
      expression_plan.receiver_physical_heap_type,
      expression_plan.selected_type_index,
    )
  ) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field receiver nominal owner or physical heap type mismatch",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
  }
}

fn self_host_verify_body_constructor(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  fields: SelfHostHirSpan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "constructor has no exact physical destination type",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "constructor has no exact physical destination type",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      _ => {}
    }
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => match self_host_linked_expression_variant_type(
      link,
      Option::Some(plan),
      module_,
      body,
      plan.specialization,
      module_.expressions[expression_plan.expression],
      variant,
      fields,
    ) {
      Option::Some(expected_type) => if !self_host_u32_equal(
        expected_type,
        expression_plan.selected_type_index,
      ) {
        // A variant constructor must use the exact selected variant type.
        self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression_plan.expression,
          u32_into_u64(expected_type),
          "constructor selected physical type mismatch",
          SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          expression_plan.value.carrier,
        )
        return
      }
      Option::None => {}
    }
    _ => {}
  }
  for linked_type in link.types {
    if self_host_u32_equal(
      linked_type.type_index,
      expression_plan.selected_type_index,
    ) {
      let physical_module = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        physical_module,
        linked_type.fragment_index,
      )
      let mut physical_offset = 0u32
      let _ = while physical_offset {
        current => if current < physical.fields.length {
          let destination = self_host_body_physical_field(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          let mut argument = 4294967295u32
          let mut exact_argument = false
          let mut source_offset = 0u32
          let _ = while source_offset {
            source => if source < fields.length {
              let object_index = self_host_u32_add(fields.start, source)
              if object_index < module_.object_fields.length() {
                let object_field = self_host_planned_object_field_identity(
                  module_.object_fields[object_index],
                )
                let exact_field = self_host_u64_equal(
                  object_field.field,
                  destination.declaration,
                )
                let named_field = self_host_u32_greater(
                  self_host_linked_module_name_count(module_),
                  object_field.name,
                ) && match self_host_linked_field_name(
                  link,
                  destination.declaration,
                ) {
                  Option::Some(destination_name) => self_host_linked_module_name_at(
                    module_,
                    object_field.name,
                  ) == destination_name
                  Option::None => false
                }
                if exact_field || named_field {
                  argument = object_field.value
                  exact_argument = exact_field
                }
              }
              continue source + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if argument == 4294967295u32 {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression_plan.expression,
              destination.declaration,
              "constructor destination field has no exact source FieldId",
              self_host_body_carrier_from_storage(destination.storage),
              SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
            )
          } else {
            match self_host_body_plan_expression(plan, argument) {
              Option::Some(actual) => {
                let expected_carrier = self_host_body_carrier_from_storage(
                  destination.storage,
                )
                if exact_argument && !self_host_body_carrier_equal(
                  expected_carrier,
                  actual.value.carrier,
                ) && !(actual.value.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && !(
                  actual.value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                ) {
                  self_host_body_add_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    destination.declaration,
                    "constructor argument carrier mismatch",
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
                let expected_owner = self_host_body_field_value_nominal_owner(
                  link,
                  destination.declaration,
                )
                if exact_argument && !self_host_u64_equal(expected_owner, 0u64) &&
                  !self_host_u64_equal(actual.value.nominal_owner, 0u64) &&
                  !self_host_u64_equal(
                    expected_owner,
                    actual.value.nominal_owner,
                  ) {
                  self_host_body_add_nominal_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    expected_owner,
                    actual.value.nominal_owner,
                    "constructor argument nominal provenance mismatch",
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
              }
              Option::None => self_host_body_add_diagnostic(
                diagnostics,
                plan,
                module_,
                argument,
                destination.declaration,
                "constructor argument has no physical value plan",
                self_host_body_carrier_from_storage(destination.storage),
                SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
              )
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return
    }
  }
}

fn self_host_verify_body_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let expression_plan_count = array_length(plan.expressions)
  let mut expression_plan_index = 0u32
  let _ = while expression_plan_index {
    current_expression_plan => if current_expression_plan < expression_plan_count {
      let expression_plan = array_get_unchecked(
        plan.expressions,
        current_expression_plan,
      )
      match module_.expressions[expression_plan.expression].kind {
      SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => match self_host_body_plan_expression(
        plan,
        subject,
      ) {
        Option::Some(subject_plan) => {
          let mut arm_offset = 0u32
          let _ = while arm_offset {
            current_arm => if current_arm < arms.length {
              let child = self_host_u32_add(arms.start, current_arm)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let root_index = self_host_planned_pattern_arm_identity(
                    module_.pattern_arms[arm_index],
                  ).pattern
                  if root_index < module_.patterns.length() {
                    let root = self_host_planned_pattern_identity(
                      module_.patterns[root_index],
                    )
                    if root.selected_constructor is SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
                      _,
                      _,
                      _,
                    ) {
                    match root.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root,
                        SelfHostPlannedValueShape::ErrorPlannedValueShape,
                        subject_plan.value.nominal_owner,
                      ) {
                        Option::Some(type_index) => {
                          let mut field_index = 0u32
                          let _ = while field_index {
                            current_field => if current_field < children.length {
                              let pattern_child = self_host_u32_add(
                                children.start,
                                current_field,
                              )
                              if pattern_child < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[pattern_child]
                                if child_pattern_index < module_.patterns.length() {
                                  match module_.patterns[child_pattern_index].reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(local_id) => if module_.patterns[
                                      child_pattern_index
                                    ].source is SelfHostHirPattern::BindingPattern(_, _) {
                                      let slot = self_host_body_local_slot(
                                        module_,
                                        body,
                                        local_id,
                                      )
                                      if slot < plan.local_values.length() {
                                        let expected_carrier = self_host_body_physical_field_carrier(
                                          link,
                                          type_index,
                                          current_field,
                                        )
                                        let actual = plan.local_values[slot]
                                        let actual_carrier = if slot < plan.locals.length() {
                                          plan.locals[slot]
                                        } else {
                                          actual.carrier
                                        }
                                        if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
                                          !(actual_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
                                          !self_host_body_carrier_equal(expected_carrier, actual_carrier) {
                                          self_host_body_add_diagnostic(
                                            diagnostics,
                                            plan,
                                            module_,
                                            subject,
                                            u32_into_u64(local_id),
                                            "pattern payload carrier mismatch",
                                            expected_carrier,
                                            actual_carrier,
                                          )
                                        }
                                        let expected_owner = self_host_linked_field_value_nominal_declaration(
                                          link,
                                          SelfHostLinkedWasmFieldLink::{
                                            type_index: type_index
                                            field_index: current_field
                                          },
                                        )
                                        let actual_owner = actual.nominal_owner
                                        if expected_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier {
                                          if expected_owner != 0u64 && actual_owner != 0u64 {
                                            if expected_owner != actual_owner {
                                              self_host_body_add_nominal_diagnostic(
                                                diagnostics,
                                                plan,
                                                module_,
                                                subject,
                                                expected_owner,
                                                actual_owner,
                                                "pattern payload nominal provenance mismatch",
                                                expected_carrier,
                                                actual_carrier,
                                              )
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_field + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                    }
                  }
                }
              }
              continue current_arm + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        Option::None => {}
      }
        _ => {}
      }
      continue current_expression_plan + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_verify_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let module_ = link.fragments.specialization.lowering.modules[plan.module_index]
  let body = match self_host_body_lookup(module_, plan.body) {
    Option::Some(value) => value
    Option::None => match self_host_body_lambda_lookup(module_, plan.lambda) {
      Option::Some(value) => value
      Option::None => {
        return
      }
    }
  }
  self_host_verify_body_pattern_payloads(
    link,
    plan,
    module_,
    body,
    diagnostics,
  )
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() && current < plan.local_values.length() {
        let local = module_.locals[local_index]
        let expected_nominal = self_host_linked_loop_binding_nominal_declaration(
          link,
          module_,
          body,
          local.local_id,
        )
        let actual_nominal = plan.local_values[current].nominal_owner
        if !self_host_u64_equal(expected_nominal, 0u64) &&
          !self_host_u64_equal(actual_nominal, 0u64) &&
          !self_host_u64_equal(expected_nominal, actual_nominal) {
          // A loop binding must keep the nominal type of its container element.
          self_host_body_add_nominal_diagnostic(
            diagnostics,
            plan,
            module_,
            body.expressions.start,
            expected_nominal,
            actual_nominal,
            "loop binding nominal provenance mismatch",
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
            plan.local_values[current].carrier,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  for expression_plan in plan.expressions {
    let expression = expression_plan.expression
    let source = self_host_planned_expression_at(module_.expressions, expression)
    let embedded_target = if expression >= body.expressions.start {
      let relative = expression - body.expressions.start
      if relative < embedded_targets.length() {
        embedded_targets[relative]
      } else {
        false
      }
    } else {
      false
    }
    if !source.flow.falls_through {
      match source.kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => if !(expression_plan.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
          // A direct call with a physical result must not poison later flow.
          self_host_body_add_known_expression_diagnostic(
            diagnostics,
            plan,
            module_,
            source,
            expression,
            u32_into_u64(expression_plan.call_function_index),
            expression_plan.value.nominal_owner,
            "direct call result is incorrectly marked as diverging",
            expression_plan.carrier,
            SelfHostWasmBodyCarrier::NeverBodyCarrier,
          )
        }
        _ => {}
      }
    }
    match source.kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {}
      SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
        let slot = self_host_body_local_slot(module_, body, local_id)
        if slot < plan.local_values.length() {
          match self_host_body_plan_expression(plan, value) {
            Option::Some(actual) => {
              let expected = plan.local_values[slot].carrier
              if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
              ) && !(actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                self_host_body_add_diagnostic(
                  diagnostics,
                  plan,
                  module_,
                  value,
                  u32_into_u64(local_id),
                  "local assignment carrier mismatch",
                  expected,
                  actual.carrier,
                )
              }
            }
            Option::None => {}
          }
        }
      }
      SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => if value != 4294967295u32 {
        match self_host_body_plan_expression(plan, value) {
          Option::Some(actual) => if !self_host_body_carrier_equal(
            plan.result_carrier,
            actual.carrier,
          ) && !(actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              0u64,
              "return operand",
              plan.result_carrier,
              actual.carrier,
            )
          }
          Option::None => {}
        }
      }
      SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
        match expression_plan.selected_storage {
        Option::Some(storage) => {
          let expected = self_host_body_carrier_from_storage(storage)
          if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              match source.kind {
                SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => field
                _ => u32_into_u64(expression_plan.selected_field_index)
              },
              "field load",
              expected,
              expression_plan.carrier,
            )
          }
        }
        Option::None => self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression,
          0u64,
          "field load has no selected physical field",
          SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
        )
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => if !embedded_target {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
      }
      SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => self_host_verify_body_constructor(
        link,
        plan,
        module_,
        body,
        expression_plan,
        fields,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      _ => {}
    }
  }
  let mut block_offset = 0u32
  let _ = while block_offset {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      let items = module_.blocks[block_index].items
      let mut item_offset = 0u32
      let _ = while item_offset {
        current_item => if current_item < items.length {
          let item = module_.block_items[
            self_host_u32_add(items.start, current_item)
          ]
          match item.kind {
            SelfHostPlannedBlockItemKind::PlannedLetItem(
              local_id,
              _,
              initializer,
            ) => {
              let slot = self_host_body_local_slot(module_, body, local_id)
              match self_host_body_plan_expression(plan, initializer) {
                Option::Some(actual) => if slot < plan.local_values.length() {
                  let expected = plan.local_values[slot].carrier
                  if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                    actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                  ) && !(actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                    self_host_body_add_diagnostic(
                      diagnostics,
                      plan,
                      module_,
                      initializer,
                      u32_into_u64(local_id),
                      "local initializer carrier mismatch",
                      expected,
                      actual.carrier,
                    )
                  }
                }
                Option::None => {}
              }
            }
            _ => {}
          }
          continue current_item + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let root_carrier = match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(value) => value.carrier
      Option::None => SelfHostWasmBodyCarrier::UnitBodyCarrier
    }
    SelfHostHirBodyRoot::BlockBodyRoot(block) => self_host_body_block_carrier(
      module_,
      body,
      plan.expressions,
      block,
    )
  }
  if !(plan.result_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) &&
    !self_host_body_carrier_equal(plan.result_carrier, root_carrier) &&
    !(root_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) &&
    !(root_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => expression
        SelfHostHirBodyRoot::BlockBodyRoot(_) => body.expressions.start
      },
      0u64,
      "function result",
      plan.result_carrier,
      root_carrier,
    )
  }
}

pub fn self_host_plan_program_wasm_bodies(
  link: SelfHostPlannedProgramWasmGCLink,
) -> SelfHostPlannedProgramWasmBodyPlan {
  let indexes = self_host_build_physical_body_indexes(link)
  let bodies = []
  let diagnostics = []
  for function_ in link.functions {
    let fragment_module = self_host_body_fragment_module(
      link,
      function_.module_index,
    )
    let fragment = self_host_body_function_fragment(
      fragment_module,
      function_.fragment_index,
    )
    let module_ = link.fragments.specialization.lowering.modules[
      function_.module_index
    ]
    let (body, lambda) = match fragment.kind {
      SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body_id) => match self_host_body_lookup(
        module_,
        body_id,
      ) {
        Option::Some(value) => (Option::Some(value), 4294967295u32)
        Option::None => (Option::None, 4294967295u32)
      }
      SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
        lambda_id,
      ) => (self_host_body_lambda_lookup(module_, lambda_id), lambda_id)
      _ => (Option::None, 4294967295u32)
    }
    match body {
      Option::Some(value) => {
        let plan = self_host_plan_one_physical_body(
          link,
          indexes,
          function_,
          value,
          lambda,
        )
        self_host_verify_one_physical_body(link, plan, diagnostics)
        bodies.push(plan)
      }
      Option::None => {}
    }
  }
  SelfHostPlannedProgramWasmBodyPlan::{
    bodies: bodies
    diagnostics: diagnostics
  }
}

pub fn self_host_body_plan_pattern_payload_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  if pattern >= module_.patterns.length() {
    return Option::None
  }
  match module_.patterns[pattern].source {
    SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
      children.length,
      0u32,
    ) && children.start < module_.pattern_children.length() {
      let child = module_.pattern_children[children.start]
      if child < module_.patterns.length() {
        match module_.patterns[child].reference {
          SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
            let slot = self_host_body_local_slot(module_, body, local_id)
            if slot < plan.local_values.length() {
              return Option::Some(plan.local_values[slot])
            }
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  Option::None
}

pub fn self_host_body_plan_scratch_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
  ordinal: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  for scratch in plan.scratches {
    if self_host_u32_equal(scratch.expression, expression) &&
      self_host_u32_equal(scratch.ordinal, ordinal) {
      return Option::Some(scratch.value)
    }
  }
  Option::None
}

pub fn self_host_body_carrier_shape(
  carrier: SelfHostWasmBodyCarrier,
) -> SelfHostPlannedValueShape {
  match carrier {
    SelfHostWasmBodyCarrier::UnitBodyCarrier => SelfHostPlannedValueShape::UnitPlannedValueShape
    SelfHostWasmBodyCarrier::NeverBodyCarrier => SelfHostPlannedValueShape::NeverPlannedValueShape
    SelfHostWasmBodyCarrier::I32BodyCarrier => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostWasmBodyCarrier::I64BodyCarrier => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostWasmBodyCarrier::F32BodyCarrier => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostWasmBodyCarrier::F64BodyCarrier => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostWasmBodyCarrier::V128BodyCarrier => SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_body_carrier_name(carrier: SelfHostWasmBodyCarrier) -> String {
  match carrier {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => "unresolved"
    SelfHostWasmBodyCarrier::UnitBodyCarrier => "unit"
    SelfHostWasmBodyCarrier::NeverBodyCarrier => "never"
    SelfHostWasmBodyCarrier::I32BodyCarrier => "i32"
    SelfHostWasmBodyCarrier::I64BodyCarrier => "i64"
    SelfHostWasmBodyCarrier::F32BodyCarrier => "f32"
    SelfHostWasmBodyCarrier::F64BodyCarrier => "f64"
    SelfHostWasmBodyCarrier::V128BodyCarrier => "v128"
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => "eqref"
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => "funcref"
  }
}

pub fn self_host_program_wasm_body_plan_error_report(
  plan: SelfHostPlannedProgramWasmBodyPlan,
) -> String {
  let output = StringBuilder::new()
  output.append("physical body carrier verifier: ")
  output.append_u32(plan.diagnostics.length())
  output.append(" error(s)")
  for diagnostic in plan.diagnostics {
    output.append("\nmodule=")
    output.append_u64(diagnostic.module_id)
    output.append(" declaration=")
    output.append_u64(diagnostic.declaration)
    output.append(" name=")
    output.append(bytes_to_string(diagnostic.declaration_name))
    output.append(" body=")
    output.append_u64(diagnostic.body)
    output.append(" lambda=")
    output.append_u32(diagnostic.lambda)
    output.append(" function=")
    output.append_u32(diagnostic.physical_function_index)
    output.append(" specialization=")
    output.append(diagnostic.specialization_key)
    output.append(" expression=")
    output.append_u32(diagnostic.expression)
    output.append(" entity=")
    output.append_u64(diagnostic.entity)
    output.append(" offset=")
    output.append_u32(diagnostic.source_offset)
    output.append(" kind=")
    output.append(diagnostic.expression_kind)
    output.append(" source_name=")
    output.append(diagnostic.source_name)
    output.append(" context=")
    output.append(diagnostic.context)
    output.append(" logical_type=")
    output.append_i32(diagnostic.logical_type)
    output.append(" selected_owner=")
    output.append_u64(diagnostic.selected_owner)
    output.append(" expected_owner=")
    output.append_u64(diagnostic.expected_owner)
    output.append(" actual_owner=")
    output.append_u64(diagnostic.actual_owner)
    output.append(" expected=")
    output.append(self_host_body_carrier_name(diagnostic.expected))
    output.append(" actual=")
    output.append(self_host_body_carrier_name(diagnostic.actual))
  }
  output.finish()
}

pub fn self_host_program_wasm_body_plan_for_identity(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  module_id: U64,
  body_id: U64,
  specialization: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u64_equal(body.module_id, module_id) &&
      self_host_u64_equal(body.body, body_id) &&
      self_host_u32_equal(body.specialization, specialization) {
      return Option::Some(body)
    }
  }
  Option::None
}

pub fn self_host_program_wasm_body_plan_for_function(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  physical_function_index: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u32_equal(
      body.physical_function_index,
      physical_function_index,
    ) {
      return Option::Some(body)
    }
  }
  Option::None
}

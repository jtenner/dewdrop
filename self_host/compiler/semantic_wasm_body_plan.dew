fn self_host_body_empty_call_plans() -> Array<SelfHostPhysicalCallPlan> {
  let values = [{
    expression: 0u32
    receiver_expression: 4294967295u32
    declaration: 0u64
    specialization: 4294967295u32
    physical_function: 4294967295u32
    emits_call: false
    evaluations: {
      start: 0u32
      length: 0u32
    }
    operands: {
      start: 0u32
      length: 0u32
    }
  }]
  values.truncate(0u32)
  values

    }
  }
  let declared_child_shape = if children.start < module_.pattern_children.length() {
    let child_index = module_.pattern_children[children.start]
    if child_index < module_.patterns.length() {
      module_.patterns[child_index].shape
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
  } else {
    SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let payload_shape = if (name == "Some" || name == "Ok" || name == "Err") && !(
    declared_child_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
  ) {
    declared_child_shape
  } else {
    match shape {
      Option::Some(value) => value
      Option::None => if !self_host_u64_equal(owner, 0u64) {
        SelfHostPlannedValueShape::RefPlannedValueShape
      } else {
        return false
      }
    }
  }
  let mut changed = false
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() {
        let local_id = module_.locals[local_index].local_id
        if self_host_linked_pattern_binds_local(
          module_,
          pattern_index,
          local_id,
        ) && current < local_values.length() && self_host_body_plan_force_local_value(
          local_values,
          locals,
          current,
          SelfHostPlannedPhysicalValueInfo::{
            logical_type: local_values[current].logical_type

fn self_host_body_function_for_physical_receiver_method(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  target: U32,
  explicit_argument_count: U32,
) -> U32 {
  if target >= module_.expressions.length() {
    return 4294967295u32
  }
  let (receiver, name_index) = match module_.expressions[target].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, name) => (value, name)
    _ => return 4294967295u32
  }
  if receiver < body.expressions.start || receiver >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) || name_index >= self_host_linked_module_name_count(module_) {
    return 4294967295u32
  }
  let receiver_value = expressions[
    self_host_body_expression_slot(body, receiver)

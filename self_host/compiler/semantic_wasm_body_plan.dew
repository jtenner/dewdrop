fn self_host_body_function_matches_receiver_shapes(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  function_index: U32,
) -> Bool {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) && !(
      self_host_u32_equal(function_.specialization, 4294967295u32)
    ) && self_host_array_index_is_valid(
      function_.specialization,
      link.fragments.specialization.requests.length(),
    ) {
      let request = link.fragments.specialization.requests[function_.specialization]
      let mut known = 0u32
      let mut argument = 0u32
      let _ = while argument {
        current => if current < request.shapes.length {
          match self_host_linked_expression_container_argument_shape(
            link,
            module_,
            body,
            receiver,
            current,
          ) {
            Option::Some(receiver_shape) => {
              let receiver_carrier = self_host_body_carrier_from_shape(
                receiver_shape,
              )
              if !(receiver_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                let shape_index = self_host_u32_add(request.shapes.start, current)
                if shape_index >= link.fragments.specialization.shapes.length() || !self_host_body_carrier_equal(
                  receiver_carrier,
                  self_host_body_carrier_from_shape(
                    link.fragments.specialization.shapes[shape_index],
                  ),
                ) {
                  return false
                }
                known = self_host_u32_add(known, 1u32)
              }
            }
            Option::None => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return self_host_u32_greater(known, 0u32)
    }
  }
  false
}


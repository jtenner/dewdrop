            receiver_owner = if !self_host_u64_equal(
              planned_local.nominal,
              0u64,
            ) {
              planned_local.nominal
            } else {
              self_host_linked_type_nominal_declaration(
                module_,
                planned_local.type_,
              )
            }
          }
        }
        let initializer = self_host_body_local_initializer(
          module_,
          body,
          local_id,
        )
        if initializer < module_.expressions.length() {
          match module_.expressions[initializer].kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              declaration,
              _,
              _,
              _,
            ) => {
              receiver_owner = self_host_body_declaration_result_nominal_owner(
                link,
                declaration,
              )
            }
            _ => {}
          }
        }
      }
      _ => {}
    }
  }
  let receiver_is_array = self_host_u32_equal(
    receiver_value.physical_heap_type,
    self_host_linked_array_wrapper_type(link),
  ) || self_host_u64_equal(
    self_host_semantic_id_module(receiver_owner),
    link.array_module_id,
  )
  if self_host_u64_equal(receiver_owner, 0u64) && !receiver_is_array {
    return 4294967295u32
  }
  let name = self_host_linked_module_name_at(module_, name_index)
  let mut declaration = 0u64
  for candidate_module in link.fragments.specialization.lowering.modules {
    for callable in candidate_module.functions.callables {
      let candidate_owner = self_host_linked_resolved_nominal_declaration(
        candidate_module,
        callable.self_type,
      )
      let owner_matches = self_host_u64_equal(candidate_owner, receiver_owner) ||
        (receiver_is_array && self_host_u64_equal(
          self_host_semantic_id_module(candidate_owner),
          link.array_module_id,
        ))
      if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) &&
        self_host_u32_equal(
          callable.parameters.length,
          explicit_argument_count,
        ) && owner_matches {
        if !self_host_u64_equal(declaration, 0u64) && !self_host_u64_equal(
          declaration,
          callable.declaration,
        ) {
          return 4294967295u32
        }
        declaration = callable.declaration
      }
    }
  }
  if self_host_u64_equal(declaration, 0u64) {
    return 4294967295u32
  }
  let mut selected = 4294967295u32
  for function_ in link.functions {
    if self_host_u64_equal(function_.declaration, declaration) {
      if !self_host_u32_equal(selected, 4294967295u32) && !self_host_u32_equal(
        selected,
        function_.function_index,

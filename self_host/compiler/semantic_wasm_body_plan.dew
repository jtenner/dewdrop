open dew.std.map
open dew.std.option
open dew.std.string
open dew.std.string_builder

pub enum SelfHostWasmBodyCarrier {
  UnresolvedBodyCarrier
  ConflictingBodyCarrier
  UnitBodyCarrier
  NeverBodyCarrier
  I32BodyCarrier
  I64BodyCarrier
  F32BodyCarrier
  F64BodyCarrier
  V128BodyCarrier
  EqRefBodyCarrier
  FuncRefBodyCarrier
}

pub struct SelfHostPlannedPhysicalValueInfo {
  logical_type: I32
  carrier: SelfHostWasmBodyCarrier
  conflict_expected: SelfHostWasmBodyCarrier
  conflict_actual: SelfHostWasmBodyCarrier
  nominal_owner: U64
  physical_heap_type: U32
}

pub struct SelfHostPlannedPhysicalExpressionCarrier {
  expression: U32
  value: SelfHostPlannedPhysicalValueInfo
  carrier: SelfHostWasmBodyCarrier
  conflict_expected: SelfHostWasmBodyCarrier
  conflict_actual: SelfHostWasmBodyCarrier
  receiver_expression: U32
  receiver_logical_type: I32
  receiver_nominal_owner: U64
  receiver_physical_heap_type: U32
  selected_field: U64
  selected_type_index: U32
  selected_field_index: U32
  selected_storage: Option<SelfHostPlannedWasmStorageType>
  call_function_index: U32
}

pub struct SelfHostPlannedPhysicalScratchCarrier {
  expression: U32
  ordinal: U32
  value: SelfHostPlannedPhysicalValueInfo
  carrier: SelfHostWasmBodyCarrier
  context: String
}

pub enum SelfHostPhysicalOperandSource {
  ExplicitArgumentPhysicalOperand(U32)
  ReceiverPhysicalOperand(U32)
  PatternSubjectPhysicalOperand(U32)
  TraitEvidencePhysicalOperand(U32)
  ClosureEnvironmentPhysicalOperand(U32)
  RuntimeContextPhysicalOperand(U32)
}

pub struct SelfHostPhysicalCallPlan {
  expression: U32
  declaration: U64
  specialization: U32
  physical_function: U32
  emits_call: Bool
  evaluations: SelfHostHirSpan
  operands: SelfHostHirSpan
}

pub struct SelfHostPhysicalCarrierDiagnostic {
  code: U32
  module_id: U64
  declaration: U64
  declaration_name: Bytes
  body: U64
  lambda: U32
  physical_function_index: U32
  specialization: U32
  specialization_key: String
  expression: U32
  entity: U64
  source_offset: U32
  expression_kind: String
  source_name: String
  context: String
  logical_type: I32
  logical_shape: SelfHostPlannedValueShape
  selected_owner: U64
  expected_owner: U64
  actual_owner: U64
  expected: SelfHostWasmBodyCarrier
  actual: SelfHostWasmBodyCarrier
}

fn self_host_body_diagnostic_code(context: String) -> U32 {
  if context == "body carrier conflict" {
    return 601u32
  }
  if context == "physical body carrier analysis did not converge" {
    return 604u32
  }
  if context == "call target is missing" {
    return 607u32
  }
  if context == "planned and emitted call target differ" {
    return 701u32
  }
  if context == "call evaluation schedule mismatch" {
    return 702u32
  }
  if context == "call argument count mismatch" {
    return 703u32
  }
  if context == "call argument has no physical value plan" {
    return 704u32
  }
  if context == "call argument carrier mismatch" {
    return 705u32
  }
  if context == "call receiver count mismatch" {
    return 707u32
  }
  if context == "erased call value became an operand" {
    return 708u32
  }
  if context == "call result" {
    return 709u32
  }
  if context == "body root has no concrete physical value" {
    return 612u32
  }
  if context == "physical source body is missing" {
    return 610u32
  }
  0u32
}

pub struct SelfHostPlannedPhysicalBodyCarrierPlan {
  converged: Bool
  stalled_work_item: U32
  module_index: U32
  module_id: U64
  declaration: U64
  body: U64
  lambda: U32
  physical_function_index: U32
  specialization: U32
  specialization_key: String
  result: SelfHostPlannedPhysicalValueInfo
  result_carrier: SelfHostWasmBodyCarrier
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>
  local_values: Array<SelfHostPlannedPhysicalValueInfo>
  locals: Array<SelfHostWasmBodyCarrier>
  local_slots: Array<U32>
  physical_local_count: U32
  control_state_values: Array<SelfHostPlannedPhysicalValueInfo>
  control_states: Array<SelfHostWasmBodyCarrier>
  control_result_values: Array<SelfHostPlannedPhysicalValueInfo>
  control_results: Array<SelfHostWasmBodyCarrier>
  scratches: Array<SelfHostPlannedPhysicalScratchCarrier>
  calls: Array<SelfHostPhysicalCallPlan>
  call_evaluations: Array<U32>
  call_operands: Array<SelfHostPhysicalOperandSource>
}

pub struct SelfHostPlannedProgramWasmBodyPlan {
  bodies: Array<SelfHostPlannedPhysicalBodyCarrierPlan>
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>
}

struct SelfHostPhysicalFieldCarrier {
  field_declaration: U64
  physical_type_index: U32
  physical_field_index: U32
  storage: SelfHostPlannedWasmStorageType
  owner: U64
}

fn self_host_body_physical_field_carrier_identity(
  value: SelfHostPhysicalFieldCarrier,
) -> SelfHostPhysicalFieldCarrier {
  SelfHostPhysicalFieldCarrier::{
    field_declaration: value.field_declaration
    physical_type_index: value.physical_type_index
    physical_field_index: value.physical_field_index
    storage: value.storage
    owner: value.owner
  }
}

struct SelfHostPhysicalBodyIndexes {
  type_by_declaration: Map<U64, U32>
  type_by_variant: Map<U64, U32>
  field_by_declaration: Map<U64, SelfHostPhysicalFieldCarrier>
  function_by_declaration: Map<U64, U32>
  call_site_result_by_function: Array<Bool>
  specialized_call_head_by_body: Map<U64, U32>
  specialized_call_keys: Array<U64>
  specialized_call_functions: Array<U32>
  specialized_call_next: Array<U32>
}

fn self_host_body_indexed_field(
  indexes: SelfHostPhysicalBodyIndexes,
  declaration: U64,
) -> Option<SelfHostPhysicalFieldCarrier> {
  match indexes.field_by_declaration.get(declaration) {
    Option::Some(value) => Option::Some(
      self_host_body_physical_field_carrier_identity(value),
    )
    Option::None => Option::None
  }
}

fn self_host_body_carrier_equal(
  left: SelfHostWasmBodyCarrier,
  right: SelfHostWasmBodyCarrier,
) -> Bool {
  match left {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => right is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier => right is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    SelfHostWasmBodyCarrier::UnitBodyCarrier => right is SelfHostWasmBodyCarrier::UnitBodyCarrier
    SelfHostWasmBodyCarrier::NeverBodyCarrier => right is SelfHostWasmBodyCarrier::NeverBodyCarrier
    SelfHostWasmBodyCarrier::I32BodyCarrier => right is SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostWasmBodyCarrier::I64BodyCarrier => right is SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostWasmBodyCarrier::F32BodyCarrier => right is SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostWasmBodyCarrier::F64BodyCarrier => right is SelfHostWasmBodyCarrier::F64BodyCarrier
    SelfHostWasmBodyCarrier::V128BodyCarrier => right is SelfHostWasmBodyCarrier::V128BodyCarrier
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => right is SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => right is SelfHostWasmBodyCarrier::FuncRefBodyCarrier
  }
}

fn self_host_body_carrier_is_value(
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  !(carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
    !(carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier) &&
    !(carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) &&
    !(carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier)
}

fn self_host_body_carrier_is_numeric(
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  carrier is SelfHostWasmBodyCarrier::I32BodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::I64BodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::F32BodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::F64BodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::V128BodyCarrier
}

fn self_host_body_binary_is_comparison(
  operator: SelfHostHirBinaryOperator,
) -> Bool {
  operator is SelfHostHirBinaryOperator::Equal ||
    operator is SelfHostHirBinaryOperator::NotEqual ||
    operator is SelfHostHirBinaryOperator::Less ||
    operator is SelfHostHirBinaryOperator::LessEqual ||
    operator is SelfHostHirBinaryOperator::Greater ||
    operator is SelfHostHirBinaryOperator::GreaterEqual
}

fn self_host_body_binary_operand_carrier(
  operator: SelfHostHirBinaryOperator,
  left: SelfHostWasmBodyCarrier,
  right: SelfHostWasmBodyCarrier,
  result: SelfHostWasmBodyCarrier,
) -> SelfHostWasmBodyCarrier {
  if operator is SelfHostHirBinaryOperator::LogicalOr ||
    operator is SelfHostHirBinaryOperator::LogicalAnd {
    return SelfHostWasmBodyCarrier::I32BodyCarrier
  }
  if self_host_body_binary_is_comparison(operator) {
    // A comparison result is always i32, so it is not evidence about the
    // operands. Prefer a concrete scalar before a broad reference carrier.
    if self_host_body_carrier_is_numeric(right) {
      return right
    }
    if self_host_body_carrier_is_numeric(left) {
      return left
    }
    if self_host_body_carrier_is_value(right) {
      return right
    }
    return left
  }
  // Arithmetic operands and their result have one physical carrier. A parent
  // result constraint is stronger than an unresolved or broad-ref operand.
  if self_host_body_carrier_is_numeric(result) {
    return result
  }
  if self_host_body_carrier_is_numeric(right) {
    return right
  }
  if self_host_body_carrier_is_numeric(left) {
    return left
  }
  if self_host_body_carrier_is_value(right) {
    return right
  }
  if self_host_body_carrier_is_value(left) {
    return left
  }
  result
}

fn self_host_body_carrier_from_shape(
  shape: SelfHostPlannedValueShape,
) -> SelfHostWasmBodyCarrier {
  match shape {
    SelfHostPlannedValueShape::ErrorPlannedValueShape => {
      return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostPlannedValueShape::GenericPlannedValueShape => {
      return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => {
      return SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    _ => {}
  }
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::UnitPlannedValueShape => SelfHostWasmBodyCarrier::UnitBodyCarrier
    SelfHostPlannedValueShape::NeverPlannedValueShape => SelfHostWasmBodyCarrier::NeverBodyCarrier
    SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedValueShape::F32PlannedValueShape => SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostPlannedValueShape::F64PlannedValueShape => SelfHostWasmBodyCarrier::F64BodyCarrier
    SelfHostPlannedValueShape::V128PlannedValueShape => SelfHostWasmBodyCarrier::V128BodyCarrier
    SelfHostPlannedValueShape::RefPlannedValueShape => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    _ => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
}

fn self_host_body_carrier_from_value_type(
  type_: SelfHostPlannedWasmValueType,
) -> SelfHostWasmBodyCarrier {
  match type_ {
    SelfHostPlannedWasmValueType::WasmI32Value => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedWasmValueType::WasmI64Value => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedWasmValueType::WasmF32Value => SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostPlannedWasmValueType::WasmF64Value => SelfHostWasmBodyCarrier::F64BodyCarrier
    SelfHostPlannedWasmValueType::WasmV128Value => SelfHostWasmBodyCarrier::V128BodyCarrier
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedWasmValueType::WasmNullableFuncRefValue => SelfHostWasmBodyCarrier::FuncRefBodyCarrier
  }
}

fn self_host_body_carrier_from_storage(
  storage: SelfHostPlannedWasmStorageType,
) -> SelfHostWasmBodyCarrier {
  match storage {
    SelfHostPlannedWasmStorageType::WasmI32Storage => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedWasmStorageType::WasmI64Storage => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedWasmStorageType::WasmF32Storage => SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostPlannedWasmStorageType::WasmF64Storage => SelfHostWasmBodyCarrier::F64BodyCarrier
    SelfHostPlannedWasmStorageType::WasmV128Storage => SelfHostWasmBodyCarrier::V128BodyCarrier
    SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedWasmStorageType::WasmNullableFuncRefStorage => SelfHostWasmBodyCarrier::FuncRefBodyCarrier
  }
}

fn self_host_body_specialization_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  specialization: U32,
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  if !(shape is SelfHostPlannedValueShape::GenericPlannedValueShape) ||
    specialization == 4294967295u32 ||
    specialization >= link.fragments.specialization.requests.length() {
    return shape
  }
  let request = link.fragments.specialization.requests[specialization]
  if self_host_u32_equal(request.shapes.length, 1u32) &&
    self_host_u32_greater(
      link.fragments.specialization.shapes.length(),
      request.shapes.start,
    ) {
    link.fragments.specialization.shapes[request.shapes.start]
  } else {
    shape
  }
}

fn self_host_body_specialization_shape_for_type(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  specialization: U32,
  logical_type: I32,
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  if !(shape is SelfHostPlannedValueShape::GenericPlannedValueShape) ||
    specialization == 4294967295u32 ||
    specialization >= link.fragments.specialization.requests.length() {
    return shape
  }
  let request = link.fragments.specialization.requests[specialization]
  match self_host_program_specialization_callable(
    module_,
    request.declaration,
  ) {
    Option::Some(callable) => match self_host_program_specialization_resolved_type(
      module_,
      logical_type,
    ) {
      Option::Some(resolved_type) => self_host_wasmgc_specialized_resolved_shape(
        module_,
        resolved_type,
        self_host_program_specialization_callable_generics(callable),
        request,
        link.fragments.specialization.shapes,
        shape,
      )
      Option::None => shape
    }
    Option::None => shape
  }
}

fn self_host_body_specialization_key(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  specialization: U32,
) -> String {
  let output = StringBuilder::new()
  output.append_u64(declaration)
  output.append(":")
  if specialization == 4294967295u32 ||
    specialization >= link.fragments.specialization.requests.length() {
    output.append("plain")
  } else {
    let request = link.fragments.specialization.requests[specialization]
    let mut index = 0u32
    let _ = while index {
      current => if current < request.shapes.length {
        if self_host_u32_greater(current, 0u32) {
          output.append(",")
        }
        let shape = link.fragments.specialization.shapes[
          self_host_u32_add(request.shapes.start, current)
        ]
        output.append(match self_host_specialization_canonical_scalar(shape) {
          SelfHostPlannedValueShape::I32PlannedValueShape => "i32"
          SelfHostPlannedValueShape::I64PlannedValueShape => "i64"
          SelfHostPlannedValueShape::F32PlannedValueShape => "f32"
          SelfHostPlannedValueShape::F64PlannedValueShape => "f64"
          SelfHostPlannedValueShape::V128PlannedValueShape => "v128"
          SelfHostPlannedValueShape::UnitPlannedValueShape => "unit"
          SelfHostPlannedValueShape::NeverPlannedValueShape => "never"
          _ => "eqref"
        })
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    for evidence in self_host_specialization_request_evidence_types(request) {
      output.append(";")
      match evidence {
        SelfHostSpecializationEvidenceType::UnknownSpecializationEvidenceType => output.append("unknown-evidence")
        SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(owner) => {
          output.append("nominal=")
          output.append_u64(owner)
        }
        SelfHostSpecializationEvidenceType::PrimitiveSpecializationEvidenceType(primitive) => {
          output.append("primitive=")
          output.append_u32(primitive.rank())
        }
        SelfHostSpecializationEvidenceType::StructuralSpecializationEvidenceType(_) => output.append("structural-evidence")
      }
    }
  }
  output.finish()
}

fn self_host_body_call_key(specialization: U32, expression: U32) -> U64 {
  (u32_into_u64(specialization) << 32u64) | u32_into_u64(expression)
}

fn self_host_body_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_body_u32_set(
  values: Array<U32>,
  index: U32,
  value: U32,
) -> Unit {
  array_set_unchecked(values, index, value)
}

fn self_host_body_bool_at(values: Array<Bool>, index: U32) -> Bool {
  array_get_unchecked(values, index)
}

fn self_host_body_bool_set(
  values: Array<Bool>,
  index: U32,
  value: Bool,
) -> Unit {
  array_set_unchecked(values, index, value)
}

fn self_host_body_empty_u64_u32_map() -> Map<U64, U32> {
  Map::empty()
}

fn self_host_body_empty_u64_field_map(
) -> Map<U64, SelfHostPhysicalFieldCarrier> {
  Map::empty()
}

fn self_host_body_fragment_module(
  link: SelfHostPlannedProgramWasmGCLink,
  index: U32,
) -> SelfHostPlannedModuleWasmGCFragments {
  link.fragments.modules[index]
}

fn self_host_body_physical_type(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmPhysicalType {
  module_.physical_types[index]
}

fn self_host_body_physical_field(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmField {
  module_.fields[index]
}

fn self_host_body_function_fragment(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmFunctionFragment {
  module_.functions[index]
}

fn self_host_body_function_value_type(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmValueType {
  module_.function_value_types[index]
}

fn self_host_body_function_uses_call_site_result(
  link: SelfHostPlannedProgramWasmGCLink,
  function_: SelfHostPlannedProgramWasmFunction,
) -> Bool {
  let lowering_module = link.fragments.specialization.lowering.modules[
    function_.module_index
  ]
  if self_host_u64_equal(
    self_host_semantic_id_module(function_.declaration),
    lowering_module.module_id,
  ) {
    let functions = self_host_planned_module_functions_identity(
      lowering_module.functions,
    )
    let local = self_host_semantic_id_local(function_.declaration)
    if local < functions.callable_by_declaration.length() {
      let callable_index = functions.callable_by_declaration[local]
      if callable_index < functions.callables.length() {
        let callable = self_host_planned_callable_identity(
          functions.callables[callable_index],
        )
        match callable.kind {
          SelfHostPlannedCallableKind::PlannedBuiltinCallable(_) => return true
          SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, body) => {
            if body is Option::None {
              return true
            }
          }
          _ => {}
        }
      }
    }
  }
  false
}

fn self_host_build_physical_body_indexes(
  link: SelfHostPlannedProgramWasmGCLink,
) -> SelfHostPhysicalBodyIndexes {
  let type_by_declaration = self_host_body_empty_u64_u32_map()
  let type_by_variant = self_host_body_empty_u64_u32_map()
  let field_by_declaration = self_host_body_empty_u64_field_map()
  let function_by_declaration = link.call_index.plain_functions
  let call_site_result_by_function = []
  let mut function_policy_index = 0u32
  let function_policy_length = self_host_u32_add(link.functions.length(), 2u32)
  let _ = while function_policy_index {
    current => if current < function_policy_length {
      call_site_result_by_function.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let specialized_call_head_by_body = link.call_index.heads
  let specialized_call_keys = link.call_index.keys
  let specialized_call_functions = link.call_index.functions
  let specialized_call_next = link.call_index.next
  for linked_type in link.types {
    let module_ = self_host_body_fragment_module(
      link,
      linked_type.module_index,
    )
    let physical = self_host_body_physical_type(
      module_,
      linked_type.fragment_index,
    )
    let owner = match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(declaration) => {
        type_by_declaration[declaration] = linked_type.type_index
        declaration
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(declaration) => {
        type_by_declaration[declaration] = linked_type.type_index
        declaration
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        variant,
        _,
      ) => {
        type_by_variant[variant] = linked_type.type_index
        declaration
      }
      _ => 0u64
    }
    let mut field = 0u32
    let _ = while field {
      current => if current < physical.fields.length {
        let source = self_host_body_physical_field(
          module_,
          self_host_u32_add(physical.fields.start, current),
        )
        match source.role {
          SelfHostPlannedWasmFieldRole::WasmStructField(field) => if !self_host_u64_equal(
            field,
            0u64,
          ) {
            match field_by_declaration.get(field) {
              Option::Some(_) => {}
              Option::None => {
                field_by_declaration[field] = SelfHostPhysicalFieldCarrier::{
                  field_declaration: field
                  physical_type_index: linked_type.type_index
                  physical_field_index: source.physical_index
                  storage: source.storage
                  owner: owner
                }
              }
            }
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  for function_ in link.functions {
    if self_host_body_function_uses_call_site_result(link, function_) {
      let physical_function = self_host_linked_physical_function_index(
        function_.function_index,
      )
      if physical_function >= call_site_result_by_function.length() {
        unreachable()
      }
      self_host_body_bool_set(
        call_site_result_by_function,
        physical_function,
        true,
      )
    }
  }
  SelfHostPhysicalBodyIndexes::{
    type_by_declaration: type_by_declaration
    type_by_variant: type_by_variant
    field_by_declaration: field_by_declaration
    function_by_declaration: function_by_declaration
    call_site_result_by_function: call_site_result_by_function
    specialized_call_head_by_body: specialized_call_head_by_body
    specialized_call_keys: specialized_call_keys
    specialized_call_functions: specialized_call_functions
    specialized_call_next: specialized_call_next
  }
}

fn self_host_body_physical_heap_type(
  indexes: SelfHostPhysicalBodyIndexes,
  nominal_owner: U64,
) -> U32 {
  if self_host_u64_equal(nominal_owner, 0u64) {
    return 4294967295u32
  }
  match indexes.type_by_declaration.get(nominal_owner) {
    Option::Some(value) => value
    Option::None => match indexes.type_by_variant.get(nominal_owner) {
      Option::Some(value) => value
      Option::None => 4294967295u32
    }
  }
}

fn self_host_body_physical_value(
  indexes: SelfHostPhysicalBodyIndexes,
  logical_type: I32,
  carrier: SelfHostWasmBodyCarrier,
  nominal_owner: U64,
) -> SelfHostPlannedPhysicalValueInfo {
  SelfHostPlannedPhysicalValueInfo::{
    logical_type: logical_type
    carrier: carrier
    conflict_expected: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    conflict_actual: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    nominal_owner: nominal_owner
    physical_heap_type: self_host_body_physical_heap_type(
      indexes,
      nominal_owner,
    )
  }
}

fn self_host_body_value_with_carrier(
  value: SelfHostPlannedPhysicalValueInfo,
  carrier: SelfHostWasmBodyCarrier,
) -> SelfHostPlannedPhysicalValueInfo {
  SelfHostPlannedPhysicalValueInfo::{
    logical_type: value.logical_type
    carrier: carrier
    conflict_expected: value.conflict_expected
    conflict_actual: value.conflict_actual
    nominal_owner: value.nominal_owner
    physical_heap_type: value.physical_heap_type
  }
}

fn self_host_body_merge_value_provenance(
  preferred: SelfHostPlannedPhysicalValueInfo,
  source: SelfHostPlannedPhysicalValueInfo,
) -> SelfHostPlannedPhysicalValueInfo {
  let merged_carrier = self_host_body_merge_carrier(
    preferred.carrier,
    source.carrier,
  )
  let conflict_expected = if preferred.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    preferred.conflict_expected
  } else if source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    source.conflict_expected
  } else if merged_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    preferred.carrier
  } else {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let conflict_actual = if preferred.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    preferred.conflict_actual
  } else if source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    source.conflict_actual
  } else if merged_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    source.carrier
  } else {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  SelfHostPlannedPhysicalValueInfo::{
    logical_type: self_host_body_preferred_logical_type(
      preferred.logical_type,
      source.logical_type,
    )
    carrier: merged_carrier
    conflict_expected: conflict_expected
    conflict_actual: conflict_actual
    nominal_owner: if !self_host_u64_equal(preferred.nominal_owner, 0u64) {
      preferred.nominal_owner
    } else {
      source.nominal_owner
    }
    physical_heap_type: if preferred.physical_heap_type != 4294967295u32 {
      preferred.physical_heap_type
    } else {
      source.physical_heap_type
    }
  }
}

fn self_host_body_exact_field_by_owner_name(
  link: SelfHostPlannedProgramWasmGCLink,
  owner: U64,
  name: String,
) -> Option<SelfHostPhysicalFieldCarrier> {
  if self_host_u64_equal(owner, 0u64) {
    // A field name is not proof of its owner. Many compiler records use names
    // such as `value` and `type_` with different physical carriers.
    return Option::None
  }
  for linked_type in link.types {
    let module_ = self_host_body_fragment_module(link, linked_type.module_index)
    let physical = self_host_body_physical_type(
      module_,
      linked_type.fragment_index,
    )
    let matches_owner = match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(declaration) => self_host_u64_equal(
        declaration,
        owner,
      )
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        variant,
        _,
      ) => self_host_u64_equal(declaration, owner) || self_host_u64_equal(
        variant,
        owner,
      )
      _ => false
    }
    if matches_owner {
      let mut field_offset = 0u32
      let _ = while field_offset {
        current => if current < physical.fields.length {
          let field = self_host_body_physical_field(
            module_,
            self_host_u32_add(physical.fields.start, current),
          )
          match field.role {
            SelfHostPlannedWasmFieldRole::WasmStructField(field_id) => match self_host_linked_field_name(
              link,
              field_id,
            ) {
              Option::Some(candidate) => if candidate == name {
                return Option::Some(SelfHostPhysicalFieldCarrier::{
                  field_declaration: field_id
                  physical_type_index: linked_type.type_index
                  physical_field_index: field.physical_index
                  storage: field.storage
                  owner: owner
                })
              }
              Option::None => {}
            }
            _ => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return Option::None
    }
  }
  Option::None
}

fn self_host_body_resolved_type_argument_nominal_owner(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  argument: U32,
) -> U64 {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return 0u64
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::AppliedType(_, arguments) => if argument < arguments.length &&
      self_host_u32_add(arguments.start, argument) <
        self_host_linked_resolved_type_argument_count(module_) {
      self_host_linked_resolved_nominal_declaration(
        module_,
        self_host_linked_resolved_type_argument_at(
          module_,
          self_host_u32_add(arguments.start, argument),
        ),
      )
    } else {
      0u64
    }
    _ => 0u64
  }
}

fn self_host_body_type_argument_nominal_owner(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  argument: U32,
) -> U64 {
  if type_ < -1i32 {
    return self_host_body_resolved_type_argument_nominal_owner(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
      argument,
    )
  }
  if type_ < 0i32 {
    return 0u64
  }
  let index = self_host_i32_to_u32(type_)
  if index >= module_.inferred.types.length() {
    return 0u64
  }
  match module_.inferred.types[index] {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => self_host_body_resolved_type_argument_nominal_owner(
      module_,
      resolved,
      argument,
    )
    SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if argument < arguments.length &&
      self_host_u32_add(arguments.start, argument) < module_.inferred.type_arguments.length() {
      self_host_linked_type_nominal_declaration(
        module_,
        module_.inferred.type_arguments[
          self_host_u32_add(arguments.start, argument)
        ],
      )
    } else {
      0u64
    }
    _ => 0u64
  }
}

fn self_host_body_field_value_nominal_from_initializers(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(field) {
    Option::Some(owner) => if owner < link.fragments.specialization.lowering.modules.length() {
      return self_host_body_field_value_nominal_from_module_initializers(
        link,
        link.fragments.specialization.lowering.modules[owner],
        field,
      )
    }
    Option::None => {}
  }
  let mut selected = 0u64
  for module_ in link.fragments.specialization.lowering.modules {
    let nominal = self_host_body_field_value_nominal_from_module_initializers(
      link,
      module_,
      field,
    )
    if !self_host_u64_equal(nominal, 0u64) {
      if self_host_u64_equal(selected, 0u64) {
        selected = nominal
      } else if !self_host_u64_equal(selected, nominal) {
        return 0u64
      }
    }
  }
  selected
}

fn self_host_body_field_value_nominal_from_module_initializers(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  field: U64,
) -> U64 {
  let mut selected = 0u64
    for source_object_field in module_.object_fields {
      let object_field = self_host_planned_object_field_identity(
        source_object_field,
      )
      if self_host_u64_equal(object_field.field, field) {
        for source_body in module_.bodies {
          let body = self_host_planned_body_lowering_identity(source_body)
          if !(object_field.value < body.expressions.start) &&
            object_field.value < self_host_u32_add(
              body.expressions.start,
              body.expressions.length,
            ) {
            let nominal = self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              object_field.value,
            )
            if !self_host_u64_equal(nominal, 0u64) {
              if self_host_u64_equal(selected, 0u64) {
                selected = nominal
              } else if !self_host_u64_equal(selected, nominal) {
                return 0u64
              }
            }
            break self_host_semantic_unit()
          }
        }
      }
    }
  selected
}

fn self_host_body_field_value_nominal_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> U64 {
  if self_host_u64_equal(field, 0u64) {
    return 0u64
  }
  match link.fragments.specialization.lowering.index.declaration_owner(field) {
    Option::Some(owner) => if owner < link.fragments.specialization.lowering.modules.length() {
      let module_ = link.fragments.specialization.lowering.modules[owner]
    for layout_field in module_.type_layouts.fields {
      if self_host_u64_equal(layout_field.field, field) {
        let declared = self_host_linked_resolved_nominal_declaration(
          module_,
          layout_field.type_,
        )
        if !self_host_u64_equal(declared, 0u64) {
          return declared
        }
      }
    }
      return self_host_body_field_value_nominal_from_module_initializers(
        link,
        module_,
        field,
      )
    }
    Option::None => {}
  }
  for module_ in link.fragments.specialization.lowering.modules {
    for layout_field in module_.type_layouts.fields {
      if self_host_u64_equal(layout_field.field, field) {
        let declared = self_host_linked_resolved_nominal_declaration(
          module_,
          layout_field.type_,
        )
        if !self_host_u64_equal(declared, 0u64) {
          return declared
        }
      }
    }
  }
  self_host_body_field_value_nominal_from_initializers(link, field)
}

fn self_host_body_function_result_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  logical_function_index: U32,
) -> SelfHostWasmBodyCarrier {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical_function_index) {
      let module_ = self_host_body_fragment_module(
        link,
        function_.module_index,
      )
      let fragment = self_host_body_function_fragment(
        module_,
        function_.fragment_index,
      )
      if self_host_u32_equal(fragment.results.length, 0u32) {
        return SelfHostWasmBodyCarrier::UnitBodyCarrier
      }
      if self_host_u32_equal(fragment.results.length, 1u32) &&
        self_host_u32_greater(
          module_.function_value_types.length(),
          fragment.results.start,
        ) {
        return self_host_body_carrier_from_value_type(
          self_host_body_function_value_type(module_, fragment.results.start),
        )
      }
      return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_body_declaration_result_nominal_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  let module_id = self_host_semantic_id_module(declaration)
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < link.fragments.specialization.lowering.modules.length() {
      let module_ = link.fragments.specialization.lowering.modules[current]
      if self_host_u64_equal(module_.module_id, module_id) {
        match self_host_program_specialization_callable(module_, declaration) {
          Option::Some(callable) => return self_host_linked_resolved_nominal_declaration(
            module_,
            callable.result_type,
          )
          Option::None => return 0u64
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_body_function_result_nominal_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  logical_function_index: U32,
) -> U64 {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical_function_index) &&
      self_host_u32_greater(
        link.fragments.specialization.lowering.modules.length(),
        function_.module_index,
      ) {
      let module_ = link.fragments.specialization.lowering.modules[
        function_.module_index
      ]
      match self_host_program_specialization_callable(
        module_,
        function_.declaration,
      ) {
        Option::Some(callable) => return self_host_linked_resolved_nominal_declaration(
          module_,
          callable.result_type,
        )
        Option::None => return 0u64
      }
    }
  }
  0u64
}

fn self_host_body_function_parameter_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  logical_function_index: U32,
  parameter: U32,
) -> SelfHostWasmBodyCarrier {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical_function_index) {
      let module_ = self_host_body_fragment_module(link, function_.module_index)
      let fragment = self_host_body_function_fragment(
        module_,
        function_.fragment_index,
      )
      if parameter < fragment.parameters.length {
        let index = self_host_u32_add(fragment.parameters.start, parameter)
        if self_host_u32_greater(module_.function_value_types.length(), index) {
          return self_host_body_carrier_from_value_type(
            self_host_body_function_value_type(module_, index),
          )
        }
      }
      return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_body_call_function(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  body: U64,
  specialization: U32,
  expression: U32,
  declaration: U64,
) -> U32 {
  match self_host_body_specialized_call_index_get(
    indexes.specialized_call_head_by_body,
    indexes.specialized_call_keys,
    indexes.specialized_call_functions,
    indexes.specialized_call_next,
    body,
    self_host_body_call_key(specialization, expression),
  ) {
    Option::Some(value) => return value
    Option::None => {}
  }
  if self_host_u64_equal(declaration, 0u64) {
    // Zero is the missing declaration sentinel. It must never alias a linked
    // function or become a source of physical ABI evidence.
    return 4294967295u32
  }
  match indexes.function_by_declaration.get(declaration) {
    Option::Some(value) => return value
    Option::None => {}
  }
  match self_host_linked_i32_call_index(
    link,
    body,
    specialization,
    expression,
    declaration,
  ) {
    Option::Some(physical) => if self_host_u32_greater(physical, 1u32) {
      return self_host_u32_subtract(physical, 2u32)
    }
    Option::None => {}
  }
  for function_ in link.functions {
    if self_host_linked_named_function_matches(function_, declaration) {
      if self_host_u32_equal(function_.specialization, 4294967295u32) {
        return function_.function_index
      }
    }
  }
  // Link order is not specialization evidence. A missing exact mapping stays
  // missing until a later constraint proves one unique compatible function.
  4294967295u32
}

fn self_host_body_function_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
) -> U64 {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) {
      return function_.declaration
    }
  }
  0u64
}

fn self_host_body_function_matches_receiver_shapes(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  function_index: U32,
) -> Bool {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) && !(
      self_host_u32_equal(function_.specialization, 4294967295u32)
    ) && self_host_array_index_is_valid(
      function_.specialization,
      link.fragments.specialization.requests.length(),
    ) {
      let request = link.fragments.specialization.requests[function_.specialization]
      let mut known = 0u32
      let mut argument = 0u32
      let _ = while argument {
        current => if current < request.shapes.length {
          match self_host_linked_expression_container_argument_shape(
            link,
            module_,
            body,
            receiver,
            current,
          ) {
            Option::Some(receiver_shape) => {
              let receiver_carrier = self_host_body_carrier_from_shape(
                receiver_shape,
              )
              if !(receiver_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                let shape_index = self_host_u32_add(request.shapes.start, current)
                if shape_index >= link.fragments.specialization.shapes.length() || !self_host_body_carrier_equal(
                  receiver_carrier,
                  self_host_body_carrier_from_shape(
                    link.fragments.specialization.shapes[shape_index],
                  ),
                ) {
                  return false
                }
                known = self_host_u32_add(known, 1u32)
              }
            }
            Option::None => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return self_host_u32_greater(known, 0u32)
    }
  }
  false
}

fn self_host_body_refine_receiver_specialization(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  selected: U32,
) -> U32 {
  if self_host_u32_equal(selected, 4294967295u32) || self_host_body_function_matches_receiver_shapes(
    link,
    module_,
    body,
    receiver,
    selected,
  ) {
    return selected
  }
  let declaration = self_host_body_function_declaration(link, selected)
  if self_host_u64_equal(declaration, 0u64) {
    return selected
  }
  let mut refined = 4294967295u32
  for function_ in link.functions {
    if self_host_linked_named_function_matches(function_, declaration) && self_host_body_function_matches_receiver_shapes(
      link,
      module_,
      body,
      receiver,
      function_.function_index,
    ) {
      if !self_host_u32_equal(refined, 4294967295u32) && !self_host_u32_equal(
        refined,
        function_.function_index,
      ) {
        return selected
      }
      refined = function_.function_index
    }
  }
  if self_host_u32_equal(refined, 4294967295u32) {
    selected
  } else {
    refined
  }
}

fn self_host_body_unique_function_for_last_parameter_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  carrier: SelfHostWasmBodyCarrier,
) -> U32 {
  if carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
    carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return 4294967295u32
  }
  let mut selected = 4294967295u32
  for function_ in link.functions {
    if self_host_linked_named_function_matches(function_, declaration) {
      let module_ = self_host_body_fragment_module(link, function_.module_index)
      let fragment = self_host_body_function_fragment(
        module_,
        function_.fragment_index,
      )
      if self_host_u32_greater(fragment.parameters.length, 0u32) {
        let parameter = fragment.parameters.length - 1u32
        if self_host_body_function_parameter_carrier(
          link,
          function_.function_index,
          parameter,
        ) is carrier {
          if self_host_u32_equal(selected, 4294967295u32) {
            selected = function_.function_index
          } else if !self_host_u32_equal(selected, function_.function_index) {
            return 4294967295u32
          }
        }
      }
    }
  }
  selected
}

fn self_host_body_local_initializer(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U32 {
  let mut block_offset = 0u32
  let _ = while block_offset {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let items = module_.blocks[block_index].items
        let mut item_offset = 0u32
        let _ = while item_offset {
          current_item => if current_item < items.length {
            let item_index = self_host_u32_add(items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(candidate, local_id) {
                  return value
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  4294967295u32
}

fn self_host_body_local_parameter_nominal_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let exact_module = self_host_planned_module_lowering_identity(module_)
  let exact_body = self_host_planned_body_lowering_identity(body)
  match self_host_linked_local_parameter_position(
    exact_module,
    exact_body,
    local_id,
  ) {
    Option::Some(pair) => {
      let (position, count) = pair
      match self_host_program_specialization_callable(
        exact_module,
        exact_body.declaration,
      ) {
        Option::Some(callable) => {
          let nominal = self_host_linked_callable_parameter_nominal_from_callable(
            exact_module,
            callable,
            position,
            count,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            return nominal
          }
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
  self_host_linked_local_parameter_nominal_declaration(
    link,
    exact_module,
    exact_body,
    local_id,
  )
}

fn self_host_body_function_for_physical_receiver_method(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  target: U32,
  explicit_argument_count: U32,
) -> U32 {
  if target >= module_.expressions.length() {
    return 4294967295u32
  }
  let (receiver, name_index) = match module_.expressions[target].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, name) => (value, name)
    _ => return 4294967295u32
  }
  if receiver < body.expressions.start || receiver >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) || name_index >= self_host_linked_module_name_count(module_) {
    return 4294967295u32
  }
  let receiver_value = expressions[
    self_host_body_expression_slot(body, receiver)
  ].value
  let mut receiver_owner = if !self_host_u64_equal(
    receiver_value.nominal_owner,
    0u64,
  ) {
    receiver_value.nominal_owner
  } else if !self_host_u32_equal(
    receiver_value.physical_heap_type,
    4294967295u32,
  ) {
    self_host_body_physical_owner(link, receiver_value.physical_heap_type)
  } else {
    0u64
  }
  if self_host_u64_equal(receiver_owner, 0u64) {
    match module_.expressions[receiver].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
        receiver_owner = self_host_body_local_parameter_nominal_owner(
          link,
          module_,
          body,
          local_id,
        )
        if self_host_u64_equal(receiver_owner, 0u64) && local_id < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, local_id)
          if local_index < module_.locals.length() {
            let planned_local = self_host_body_planned_local_identity(
              module_.locals[local_index],
            )
            receiver_owner = if !self_host_u64_equal(
              planned_local.nominal,
              0u64,
            ) {
              planned_local.nominal
            } else {
              self_host_linked_type_nominal_declaration(
                module_,
                planned_local.type_,
              )
            }
          }
        }
        let initializer = self_host_body_local_initializer(
          module_,
          body,
          local_id,
        )
        if initializer < module_.expressions.length() {
          match module_.expressions[initializer].kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              declaration,
              _,
              _,
              _,
            ) => {
              receiver_owner = self_host_body_declaration_result_nominal_owner(
                link,
                declaration,
              )
            }
            _ => {}
          }
        }
      }
      _ => {}
    }
  }
  let receiver_is_array = self_host_u32_equal(
    receiver_value.physical_heap_type,
    self_host_linked_array_wrapper_type(link),
  ) || self_host_u64_equal(
    self_host_semantic_id_module(receiver_owner),
    link.array_module_id,
  )
  if self_host_u64_equal(receiver_owner, 0u64) && !receiver_is_array {
    return 4294967295u32
  }
  let name = self_host_linked_module_name_at(module_, name_index)
  let mut declaration = 0u64
  for candidate_module in link.fragments.specialization.lowering.modules {
    for callable in candidate_module.functions.callables {
      let candidate_owner = self_host_linked_resolved_nominal_declaration(
        candidate_module,
        callable.self_type,
      )
      let owner_matches = self_host_u64_equal(candidate_owner, receiver_owner) ||
        (receiver_is_array && self_host_u64_equal(
          self_host_semantic_id_module(candidate_owner),
          link.array_module_id,
        ))
      if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) &&
        self_host_u32_equal(
          callable.parameters.length,
          explicit_argument_count,
        ) && owner_matches {
        if !self_host_u64_equal(declaration, 0u64) && !self_host_u64_equal(
          declaration,
          callable.declaration,
        ) {
          return 4294967295u32
        }
        declaration = callable.declaration
      }
    }
  }
  if self_host_u64_equal(declaration, 0u64) {
    return 4294967295u32
  }
  let mut selected = 4294967295u32
  for function_ in link.functions {
    if self_host_linked_named_function_matches(function_, declaration) {
      if !self_host_u32_equal(selected, 4294967295u32) && !self_host_u32_equal(
        selected,
        function_.function_index,
      ) {
        return 4294967295u32
      }
      selected = function_.function_index
    }
  }
  selected
}

fn self_host_body_plan_set_call_function(
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  expression: U32,
  function_index: U32,
) -> Bool {
  if self_host_u32_equal(function_index, 4294967295u32) ||
    expression < body.expressions.start || expression >= self_host_u32_add(
      body.expressions.start,
      body.expressions.length,
    ) {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  let source = expressions[slot]
  if self_host_u32_equal(source.call_function_index, function_index) {
    return false
  }
  if !self_host_u32_equal(source.call_function_index, 4294967295u32) {
    // A call-site key is functional. A later target cannot replace the first
    // exact target selected for this physical plan.
    return false
  }
  expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
    expression: source.expression
    value: source.value
    carrier: source.carrier
    conflict_expected: source.conflict_expected
    conflict_actual: source.conflict_actual
    receiver_expression: source.receiver_expression
    receiver_logical_type: source.receiver_logical_type
    receiver_nominal_owner: source.receiver_nominal_owner
    receiver_physical_heap_type: source.receiver_physical_heap_type
    selected_field: source.selected_field
    selected_type_index: source.selected_type_index
    selected_field_index: source.selected_field_index
    selected_storage: source.selected_storage
    call_function_index: function_index
  }
  true
}

fn self_host_body_lookup(
  module_: SelfHostPlannedModuleLowering,
  body_id: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  let limit = array_length(module_.bodies)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let body = self_host_planned_body_lowering_identity(
        array_get_unchecked(module_.bodies, current),
      )
      if self_host_u64_equal(body.body, body_id) {
        return Option::Some(body)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_body_lambda_lookup(
  module_: SelfHostPlannedModuleLowering,
  lambda_id: U32,
) -> Option<SelfHostPlannedBodyLowering> {
  for lambda in module_.lambdas {
    if self_host_u32_equal(lambda.lambda, lambda_id) {
      return Option::Some(SelfHostPlannedBodyLowering::{
        body: lambda.root_body
        declaration: 18446744073709551615u64
        kind: SelfHostHirBodyKind::FunctionBody
        root: lambda.root
        root_type: lambda.root_type
        root_shape: lambda.root_shape
        result_shape: lambda.result_shape
        flow: lambda.flow
        locals: lambda.locals
        local_initializers: lambda.local_initializers
        local_assignments: lambda.local_assignments
        expressions: lambda.expressions
        blocks: lambda.blocks
        patterns: lambda.patterns
        pattern_arms: lambda.pattern_arms
      })
    }
  }
  Option::None
}

fn self_host_body_lookup_for_plan(
  module_: SelfHostPlannedModuleLowering,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
) -> Option<SelfHostPlannedBodyLowering> {
  if self_host_u32_equal(plan.lambda, 4294967295u32) {
    self_host_body_lookup(module_, plan.body)
  } else {
    match self_host_body_lambda_lookup(module_, plan.lambda) {
      Option::Some(body) => if self_host_u64_equal(body.body, plan.body) {
        Option::Some(body)
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }
}

fn self_host_body_require_linked_source(
  source: Option<SelfHostPlannedBodyLowering>,
  function_: SelfHostPlannedProgramWasmFunction,
  body: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  let _ = self_host_assert_compiler_invariant_with_failure(
    source is Option::Some(_),
    SelfHostInvariantFailure::{
      code: 610u32
      phase: 6u32
      module_id: self_host_semantic_id_module(function_.declaration)
      declaration: function_.declaration
      body: body
      expression: 4294967295u32
      expected: 1u64
      actual: 0u64
      detail: u32_into_u64(function_.function_index)
    },
    "linked defined function has no source body",
  )
  source
}

fn self_host_body_expression_slot(
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  // The body arena itself is checked at the planning boundary. Check ownership
  // here before subtraction, including the missing global-expression sentinel.
  match self_host_checked_relative_index(expression, body.expressions, 4294967295u32) {
    Option::Some(relative) => relative
    Option::None => {
      let _ = self_host_assert_compiler_invariant_with_failure(
        false,
        SelfHostInvariantFailure::{
          code: 102u32
          phase: 6u32
          module_id: self_host_semantic_id_module(body.body)
          declaration: body.declaration
          body: body.body
          expression: expression
          expected: u32_into_u64(body.expressions.start)
          actual: u32_into_u64(expression)
          detail: u32_into_u64(body.expressions.length)
        },
        "expression does not belong to its physical body",
      )
      unreachable()
    }
  }
}

fn self_host_assert_physical_body_span(
  body: SelfHostPlannedBodyLowering,
  span: SelfHostHirSpan,
  arena_length: U32,
  arena_kind: U32,
) -> Unit {
  if !self_host_array_span_is_valid(span.start, span.length, arena_length) {
    let _ = self_host_assert_compiler_invariant_with_failure(
      false,
      SelfHostInvariantFailure::{
        code: 101u32
        phase: 6u32
        module_id: self_host_semantic_id_module(body.body)
        declaration: body.declaration
        body: body.body
        expression: 4294967295u32
        expected: u32_into_u64(arena_length)
        actual: u32_into_u64(span.length)
        detail: (u32_into_u64(arena_kind) << 32u64) | u32_into_u64(span.start)
      },
      "physical body span is outside its arena",
    )
  }
}

fn self_host_body_local_slot(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U32 {
  if local_id < body.locals.length &&
    self_host_u32_equal(module_.locals[self_host_u32_add(body.locals.start, local_id)].local_id, local_id) {
    return local_id
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.locals.length {
      let local = module_.locals[self_host_u32_add(body.locals.start, current)]
      if self_host_u32_equal(local.local_id, local_id) {
        return current
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  4294967295u32
}

fn self_host_body_wrapped_local_get(
  module_: SelfHostPlannedModuleLowering,
  root: U32,
) -> Option<U32> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => return Option::Some(
          local_id,
        )
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            return Option::None
          }
          expression = tail
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          expression = operand
        }
        _ => return Option::None
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_body_loop_initial_value(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  loop_control: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(
          candidate,
          initial,
          _,
        ) => if self_host_u32_equal(candidate, loop_control) &&
          initial >= body.expressions.start && initial < expression_end {
          return Option::Some(expressions[
            self_host_body_expression_slot(body, initial)
          ].value)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_body_merge_carrier(
  left: SelfHostWasmBodyCarrier,
  right: SelfHostWasmBodyCarrier,
) -> SelfHostWasmBodyCarrier {
  if left is SelfHostWasmBodyCarrier::ConflictingBodyCarrier ||
    right is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
    return SelfHostWasmBodyCarrier::ConflictingBodyCarrier
  }
  if left is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return right
  }
  if right is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return left
  }
  if left is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return right
  }
  if right is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return left
  }
  if self_host_body_carrier_equal(left, right) {
    left
  } else {
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier
  }
}

fn self_host_body_schedule_work_item(
  queue: Array<U32>,
  pending: Array<Bool>,
  item: U32,
) -> Unit {
  if item < pending.length() && !pending[item] {
    pending[item] = true
    queue.push(item)
  }
}

fn self_host_body_schedule_all_work_items(
  queue: Array<U32>,
  pending: Array<Bool>,
) -> Unit {
  self_host_body_schedule_work_item(queue, pending, 0u32)
  let mut item = self_host_u32_subtract(pending.length(), 1u32)
  let _ = while item {
    current => if current > 0u32 {
      self_host_body_schedule_work_item(queue, pending, current)
      continue self_host_u32_subtract(current, 1u32)
    } else {
      break self_host_semantic_unit()
    }
  }
}

struct SelfHostBodyWorkGraph {
  heads: Array<U32>
  targets: Array<U32>
  next: Array<U32>
}

fn self_host_body_empty_work_graph(item_count: U32) -> SelfHostBodyWorkGraph {
  let heads = []
  let mut item = 0u32
  let _ = while item {
    current => if current < item_count {
      heads.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostBodyWorkGraph::{
    heads: heads
    targets: []
    next: []
  }
}

fn self_host_body_add_work_dependency(
  graph: SelfHostBodyWorkGraph,
  source: U32,
  target: U32,
) -> Unit {
  if source >= graph.heads.length() || target >= graph.heads.length() ||
    self_host_u32_equal(source, target) {
    return
  }
  let mut edge = graph.heads[source]
  let _ = while edge {
    current => if current != 4294967295u32 && current < graph.targets.length() &&
      current < graph.next.length() {
      if self_host_u32_equal(graph.targets[current], target) {
        return
      }
      continue graph.next[current]
    } else {
      break self_host_semantic_unit()
    }
  }
  let index = graph.targets.length()
  graph.targets.push(target)
  graph.next.push(graph.heads[source])
  graph.heads[source] = index
}

fn self_host_body_add_work_pair(
  graph: SelfHostBodyWorkGraph,
  left: U32,
  right: U32,
) -> Unit {
  self_host_body_add_work_dependency(graph, left, right)
  self_host_body_add_work_dependency(graph, right, left)
}

fn self_host_body_schedule_work_dependents(
  graph: SelfHostBodyWorkGraph,
  queue: Array<U32>,
  pending: Array<Bool>,
  item: U32,
) -> Unit {
  if item >= graph.heads.length() {
    return
  }
  let mut edge = graph.heads[item]
  let _ = while edge {
    current => if current != 4294967295u32 && current < graph.targets.length() &&
      current < graph.next.length() {
      self_host_body_schedule_work_item(queue, pending, graph.targets[current])
      continue graph.next[current]
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_qualified_call_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  let target = match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
    _ => {
      return 0u64
    }
  }
  if target == 0u32 || target >= module_.expressions.length() {
    return 0u64
  }
  let owner = match module_.expressions[target - 1u32].reference {
    SelfHostBodyNameReference::ModuleTypeNameReference(declaration) => declaration
    _ => {
      return 0u64
    }
  }
  let name = module_.expressions[target].source_name
  if name >= self_host_linked_module_name_count(module_) {
    return 0u64
  }
  let spelling = self_host_linked_module_name_at(module_, name)
  let mut selected = 0u64
  for candidate_module in link.fragments.specialization.lowering.modules {
    for callable in candidate_module.functions.callables {
      if !callable.has_receiver && self_host_bytes_equal_string(callable.name, spelling) &&
        self_host_u64_equal(
          self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          ),
          owner,
        ) {
        if !self_host_u64_equal(selected, 0u64) &&
          !self_host_u64_equal(selected, callable.declaration) {
          return 0u64
        }
        selected = callable.declaration
      }
    }
  }
  selected
}

fn self_host_body_seed_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  specialization: U32,
  expression: U32,
) -> SelfHostPlannedPhysicalExpressionCarrier {
  let planned = self_host_planned_expression_identity(
    module_.expressions[expression],
  )
  let mut carrier = self_host_body_carrier_from_shape(
    self_host_body_specialization_shape_for_type(
      link,
      module_,
      specialization,
      planned.type_,
      planned.shape,
    ),
  )
  let mut nominal_owner = if !self_host_u64_equal(planned.nominal, 0u64) {
    planned.nominal
  } else {
    self_host_linked_type_nominal_declaration(module_, planned.type_)
  }
  let mut physical_heap_type = self_host_body_physical_heap_type(
    indexes,
    nominal_owner,
  )
  let mut receiver_expression = 4294967295u32
  let mut receiver_logical_type = -1i32
  let mut receiver_nominal_owner = 0u64
  let mut receiver_physical_heap_type = 4294967295u32
  let mut selected_field = 0u64
  let mut selected_type_index = 4294967295u32
  let mut selected_field_index = 4294967295u32
  let mut selected_storage = Option::None
  let mut call_function_index = 4294967295u32
  let mut constructor_selection = false
  match planned.selection {
    SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
      declaration,
      _,
    ) => {
      constructor_selection = true
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      nominal_owner = declaration
      match indexes.type_by_declaration.get(declaration) {
        Option::Some(value) => {
          selected_type_index = value
          physical_heap_type = value
        }
        Option::None => {}
      }
    }
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => {
      constructor_selection = true
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      let runtime_none = match link.runtime_variant_adapters.get(variant) {
        Option::Some(SelfHostRuntimeVariantAdapter::RuntimeOptionNone) => true
        _ => false
      }
      if runtime_none {
        selected_type_index = self_host_linked_array_runtime_base(link) + 10u32
        physical_heap_type = selected_type_index
      } else {
        match indexes.type_by_variant.get(variant) {
          Option::Some(value) => {
            selected_type_index = value
            physical_heap_type = value
          }
          Option::None => {}
        }
      }
    }
    SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(field, _, _) => match self_host_body_indexed_field(
      indexes,
      field,
    ) {
      Option::Some(value) => {
        selected_field = value.field_declaration
        selected_type_index = value.physical_type_index
        selected_field_index = value.physical_field_index
        selected_storage = Option::Some(value.storage)
        carrier = self_host_body_field_read_carrier(link, module_, specialization, expression, field, value.storage)
        nominal_owner = self_host_body_field_value_nominal_owner(
          link,
          value.field_declaration,
        )
        physical_heap_type = self_host_body_physical_heap_type(
          indexes,
          nominal_owner,
        )
      }
      Option::None => {}
    }
    _ => {}
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => {
      carrier = SelfHostWasmBodyCarrier::I32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I64BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => {
      carrier = SelfHostWasmBodyCarrier::I64BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => {
      carrier = SelfHostWasmBodyCarrier::F32BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => {
      carrier = SelfHostWasmBodyCarrier::F64BodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedUnitConst => {
      carrier = SelfHostWasmBodyCarrier::UnitBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedStringArrayConst(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      physical_heap_type = self_host_linked_array_wrapper_type(link)
    }
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(lambda) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      match self_host_linked_module_index_by_id(link, module_.module_id) {
        Option::Some(module_index) => {
          match self_host_linked_lambda_position(module_, lambda) {
            Option::Some(position) => match self_host_linked_lambda_type_index(link, module_index, position, specialization) {
              Option::Some(type_) => {
                selected_type_index = type_
              }
              Option::None => {}
            }
            Option::None => {}
          }
          match self_host_linked_lambda_function_index(link, module_index, lambda, specialization) {
            Option::Some(function_) => if function_ >= 2u32 {
              call_function_index = function_ - 2u32
            }
            Option::None => {}
          }
        }
        Option::None => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedConstruct(target, _, _) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      if !constructor_selection && target < module_.expressions.length() {
        match module_.expressions[target].reference {
          SelfHostBodyNameReference::ModuleTypeNameReference(declaration) => {
            nominal_owner = declaration
            match indexes.type_by_declaration.get(declaration) {
              Option::Some(value) => {
                selected_type_index = value
                physical_heap_type = value
              }
              Option::None => {}
            }
          }
          _ => {}
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedReturnExpression(_) => {
      carrier = SelfHostWasmBodyCarrier::NeverBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedBreakExpression(_, _) => {
      carrier = SelfHostWasmBodyCarrier::NeverBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedContinueExpression(_, _) => {
      carrier = SelfHostWasmBodyCarrier::NeverBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedFunctionReference(declaration) => {
      carrier = SelfHostWasmBodyCarrier::EqRefBodyCarrier
      call_function_index = self_host_body_call_function(
        link, indexes, body.body, specialization, expression, declaration,
      )
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => if !constructor_selection {
      call_function_index = self_host_body_call_function(
        link,
        indexes,
        body.body,
        specialization,
        expression,
        declaration,
      )
      if call_function_index != 4294967295u32 {
        carrier = self_host_body_function_result_carrier(
          link,
          call_function_index,
        )
        let result_owner = self_host_body_function_result_nominal_owner(
          link,
          call_function_index,
        )
        if self_host_u64_equal(
          nominal_owner,
          0u64,
        ) && !self_host_u64_equal(
          result_owner,
          0u64,
        ) {
          nominal_owner = result_owner
          physical_heap_type = self_host_body_physical_heap_type(
            indexes,
            result_owner,
          )
        }
      }
      let declared_result_owner = self_host_body_declaration_result_nominal_owner(
        link,
        declaration,
      )
      if self_host_u64_equal(
        nominal_owner,
        0u64,
      ) && !self_host_u64_equal(
        declared_result_owner,
        0u64,
      ) {
        nominal_owner = declared_result_owner
        physical_heap_type = self_host_body_physical_heap_type(
          indexes,
          declared_result_owner,
        )
      }
      if self_host_linked_call_returns_array_element(
        link,
        body.body,
        specialization,
        expression,
      ) {
        let element_shape = match self_host_linked_call_first_type_argument_shape(
          module_,
          planned,
        ) {
          Option::Some(shape) => Option::Some(shape)
          Option::None => match planned.kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              _,
              _,
              arguments,
              _,
            ) => self_host_linked_call_base_element_shape(module_, arguments)
            _ => Option::None
          }
        }
        match element_shape {
          Option::Some(shape) => {
            let element_carrier = self_host_body_carrier_from_shape(shape)
            if !(element_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
              carrier = element_carrier
            }
          }
          Option::None => {}
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, declaration, _, _, _) => {
      call_function_index = self_host_body_call_function(
        link,
        indexes,
        body.body,
        specialization,
        expression,
        declaration,
      )
      if call_function_index != 4294967295u32 {
        carrier = self_host_body_function_result_carrier(
          link,
          call_function_index,
        )
        let result_owner = self_host_body_function_result_nominal_owner(
          link,
          call_function_index,
        )
        if self_host_u64_equal(nominal_owner, 0u64) && !self_host_u64_equal(
          result_owner,
          0u64,
        ) {
          nominal_owner = result_owner
          physical_heap_type = self_host_body_physical_heap_type(
            indexes,
            result_owner,
          )
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedOperatorCall(declaration, _, _, _, _) => {
      call_function_index = self_host_body_call_function(
        link,
        indexes,
        body.body,
        specialization,
        expression,
        declaration,
      )
      if call_function_index != 4294967295u32 {
        carrier = self_host_body_function_result_carrier(
          link,
          call_function_index,
        )
        let result_owner = self_host_body_function_result_nominal_owner(
          link,
          call_function_index,
        )
        if self_host_u64_equal(nominal_owner, 0u64) && !self_host_u64_equal(
          result_owner,
          0u64,
        ) {
          nominal_owner = result_owner
          physical_heap_type = self_host_body_physical_heap_type(
            indexes,
            result_owner,
          )
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => {
      carrier = SelfHostWasmBodyCarrier::UnitBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => {
      carrier = SelfHostWasmBodyCarrier::UnitBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, _, _) => {
      carrier = SelfHostWasmBodyCarrier::UnitBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, target) => {
      carrier = SelfHostWasmBodyCarrier::UnitBodyCarrier
      match target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => {
          call_function_index = self_host_body_call_function(
            link, indexes, body.body, specialization, expression, declaration,
          )
        }
        _ => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
      let qualified_declaration = self_host_body_qualified_call_declaration(
        link,
        module_,
        expression,
      )
      call_function_index = self_host_body_call_function(
        link,
        indexes,
        body.body,
        specialization,
        expression,
        qualified_declaration,
      )
      if call_function_index != 4294967295u32 && target < module_.expressions.length() {
        match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
            call_function_index = self_host_body_refine_receiver_specialization(
              link,
              module_,
              body,
              base,
              call_function_index,
            )
          }
          _ => {}
        }
      }
      if call_function_index == 4294967295u32 && target < module_.expressions.length() {
        match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
            module_,
          ) {
            match self_host_linked_method_call_index_for_receiver(
              link,
              module_,
              body,
              base,
              self_host_linked_module_name_at(module_, name),
            ) {
              Option::Some(physical) => if self_host_u32_greater(physical, 1u32) {
                call_function_index = self_host_u32_subtract(physical, 2u32)
              }
              Option::None => {}
            }
          }
          _ => {}
        }
      }
      if call_function_index != 4294967295u32 {
        carrier = self_host_body_function_result_carrier(
          link,
          call_function_index,
        )
        let result_owner = self_host_body_function_result_nominal_owner(
          link,
          call_function_index,
        )
        if self_host_u64_equal(
          nominal_owner,
          0u64,
        ) && !self_host_u64_equal(
          result_owner,
          0u64,
        ) {
          nominal_owner = result_owner
          physical_heap_type = self_host_body_physical_heap_type(
            indexes,
            result_owner,
          )
        }
      }
      match self_host_linked_unresolved_get_result_shape(
        link,
        module_,
        body,
        expression,
      ) {
        Option::Some(shape) => {
          carrier = self_host_body_carrier_from_shape(shape)
        }
        Option::None => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, target) => {
      match target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => {
          call_function_index = self_host_body_call_function(
            link,
            indexes,
            body.body,
            specialization,
            expression,
            declaration,
          )
        }
        _ => {}
      }
      // IndexedGet is an ordinary selected call. Its resolved result type and
      // linked signature provide evidence; receiver type arguments do not.
    }
    SelfHostPlannedExpressionKind::PlannedProductField(base, field, _) => match self_host_linked_product_field_shape(
      link,
      module_,
      body,
      specialization,
      base,
      field,
    ) {
      Option::Some(shape) => {
        carrier = self_host_body_carrier_from_shape(shape)
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_body_indexed_field(
      indexes,
      field,
    ) {
      Option::Some(value) => {
        receiver_expression = base
        receiver_logical_type = self_host_planned_expression_identity(
          module_.expressions[base],
        ).type_
        receiver_nominal_owner = value.owner
        receiver_physical_heap_type = value.physical_type_index
        selected_field = value.field_declaration
        selected_type_index = value.physical_type_index
        selected_field_index = value.physical_field_index
        selected_storage = Option::Some(value.storage)
        carrier = self_host_body_field_read_carrier(link, module_, specialization, expression, field, value.storage)
        nominal_owner = self_host_body_field_value_nominal_owner(
          link,
          value.field_declaration,
        )
        physical_heap_type = self_host_body_physical_heap_type(
          indexes,
          nominal_owner,
        )
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
      receiver_expression = base
      receiver_logical_type = self_host_planned_expression_identity(
        module_.expressions[base],
      ).type_
    }
    _ => {}
  }
  if !planned.flow.falls_through {
    // The absence of a Wasm result does not distinguish Unit from Never.
    // Keep the proven logical control-flow fact after target ABI seeding.
    carrier = SelfHostWasmBodyCarrier::NeverBodyCarrier
  }
  SelfHostPlannedPhysicalExpressionCarrier::{
    expression: expression
    value: SelfHostPlannedPhysicalValueInfo::{
      logical_type: planned.type_
      carrier: carrier
      conflict_expected: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      conflict_actual: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      nominal_owner: nominal_owner
      physical_heap_type: physical_heap_type
    }
    carrier: carrier
    conflict_expected: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    conflict_actual: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    receiver_expression: receiver_expression
    receiver_logical_type: receiver_logical_type
    receiver_nominal_owner: receiver_nominal_owner
    receiver_physical_heap_type: receiver_physical_heap_type
    selected_field: selected_field
    selected_type_index: selected_type_index
    selected_field_index: selected_field_index
    selected_storage: selected_storage
    call_function_index: call_function_index
  }
}

fn self_host_body_plan_force_expression_carrier(
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  expression: U32,
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  if expression < body.expressions.start || expression >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) || carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  let current = expressions[slot].carrier
  if self_host_body_carrier_equal(current, carrier) ||
    current is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return false
  }
  let forced_carrier = if current is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    carrier
  } else {
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier
  }
  if self_host_body_carrier_equal(current, forced_carrier) {
    return false
  }
  let source = expressions[slot]
  expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
    expression: source.expression
    value: self_host_body_value_with_carrier(source.value, forced_carrier)
    carrier: forced_carrier
    conflict_expected: if forced_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      current is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      current
    } else {
      source.conflict_expected
    }
    conflict_actual: if forced_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      current is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      carrier
    } else {
      source.conflict_actual
    }
    receiver_expression: source.receiver_expression
    receiver_logical_type: source.receiver_logical_type
    receiver_nominal_owner: source.receiver_nominal_owner
    receiver_physical_heap_type: source.receiver_physical_heap_type
    selected_field: source.selected_field
    selected_type_index: source.selected_type_index
    selected_field_index: source.selected_field_index
    selected_storage: source.selected_storage
    call_function_index: source.call_function_index
  }
  true
}

fn self_host_body_plan_set_local_carrier(
  locals: Array<SelfHostWasmBodyCarrier>,
  local: U32,
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  if local >= locals.length() ||
    carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    self_host_body_carrier_equal(locals[local], carrier) {
    return false
  }
  let merged = self_host_body_merge_carrier(locals[local], carrier)
  if !self_host_body_carrier_equal(merged, locals[local]) {
    locals[local] = merged
    return true
  }
  false
}

fn self_host_body_plan_set_expression_carrier(
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  expression: U32,
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  if expression < body.expressions.start || expression >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  if expressions[slot].carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier || self_host_body_carrier_equal(expressions[slot].carrier, carrier) {
    return false
  }
  let merged = self_host_body_merge_carrier(expressions[slot].carrier, carrier)
  if !self_host_body_carrier_equal(merged, expressions[slot].carrier) {
    let source = expressions[slot]
    expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
      expression: source.expression
      value: self_host_body_value_with_carrier(source.value, merged)
      carrier: merged
      conflict_expected: if merged is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
        source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
      ) {
        source.carrier
      } else {
        source.conflict_expected
      }
      conflict_actual: if merged is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
        source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
      ) {
        carrier
      } else {
        source.conflict_actual
      }
      receiver_expression: source.receiver_expression
      receiver_logical_type: source.receiver_logical_type
      receiver_nominal_owner: source.receiver_nominal_owner
      receiver_physical_heap_type: source.receiver_physical_heap_type
      selected_field: source.selected_field
      selected_type_index: source.selected_type_index
      selected_field_index: source.selected_field_index
      selected_storage: source.selected_storage
      call_function_index: source.call_function_index
    }
    return true
  }
  false
}

fn self_host_body_value_info_equal(
  left: SelfHostPlannedPhysicalValueInfo,
  right: SelfHostPlannedPhysicalValueInfo,
) -> Bool {
  left.logical_type == right.logical_type &&
    self_host_body_carrier_equal(left.carrier, right.carrier) &&
    self_host_body_carrier_equal(
      left.conflict_expected,
      right.conflict_expected,
    ) && self_host_body_carrier_equal(
      left.conflict_actual,
      right.conflict_actual,
    ) &&
    self_host_u64_equal(left.nominal_owner, right.nominal_owner) &&
    self_host_u32_equal(left.physical_heap_type, right.physical_heap_type)
}

fn self_host_body_preferred_logical_type(
  preferred: I32,
  fallback: I32,
) -> I32 {
  // Negative values encode resolved types. Only -1 is the missing sentinel.
  // Replacing one valid negative type with another made branch joins oscillate.
  if preferred == -1i32 {
    fallback
  } else {
    preferred
  }
}

fn self_host_body_plan_set_local_value(
  values: Array<SelfHostPlannedPhysicalValueInfo>,
  carriers: Array<SelfHostWasmBodyCarrier>,
  local: U32,
  source: SelfHostPlannedPhysicalValueInfo,
) -> Bool {
  if local >= values.length() || local >= carriers.length() {
    return false
  }
  let merged = self_host_body_merge_value_provenance(values[local], source)
  if self_host_body_value_info_equal(values[local], merged) {
    return false
  }
  values[local] = merged
  carriers[local] = merged.carrier
  true
}

fn self_host_body_plan_force_local_value(
  values: Array<SelfHostPlannedPhysicalValueInfo>,
  carriers: Array<SelfHostWasmBodyCarrier>,
  local: U32,
  source: SelfHostPlannedPhysicalValueInfo,
) -> Bool {
  if local >= values.length() || local >= carriers.length() ||
    source.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return false
  }
  let current = values[local]
  if current.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return false
  }
  let forced = self_host_body_merge_value_provenance(current, source)
  if self_host_body_value_info_equal(current, forced) {
    return false
  }
  values[local] = forced
  carriers[local] = forced.carrier
  true
}

fn self_host_body_plan_force_expression_value(
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  expression: U32,
  value: SelfHostPlannedPhysicalValueInfo,
) -> Bool {
  if expression < body.expressions.start || expression >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  let source = expressions[slot]
  if source.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return false
  }
  let forced = self_host_body_merge_value_provenance(source.value, value)
  if self_host_body_value_info_equal(source.value, forced) {
    return false
  }
  expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
    expression: source.expression
    value: forced
    carrier: forced.carrier
    conflict_expected: if value.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
      value.conflict_expected
    } else if forced.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      source.carrier
    } else {
      source.conflict_expected
    }
    conflict_actual: if value.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
      value.conflict_actual
    } else if forced.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      value.carrier
    } else {
      source.conflict_actual
    }
    receiver_expression: source.receiver_expression
    receiver_logical_type: source.receiver_logical_type
    receiver_nominal_owner: source.receiver_nominal_owner
    receiver_physical_heap_type: source.receiver_physical_heap_type
    selected_field: source.selected_field
    selected_type_index: source.selected_type_index
    selected_field_index: source.selected_field_index
    selected_storage: source.selected_storage
    call_function_index: source.call_function_index
  }
  true
}

fn self_host_body_plan_set_expression_value(
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  expression: U32,
  value: SelfHostPlannedPhysicalValueInfo,
) -> Bool {
  if expression < body.expressions.start || expression >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  let source = expressions[slot]
  if source.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    return false
  }
  let merged = self_host_body_merge_value_provenance(source.value, value)
  if self_host_body_value_info_equal(source.value, merged) {
    return false
  }
  expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
    expression: source.expression
    value: merged
    carrier: merged.carrier
    conflict_expected: if value.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
      value.conflict_expected
    } else if merged.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      source.carrier
    } else {
      source.conflict_expected
    }
    conflict_actual: if value.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
      value.conflict_actual
    } else if merged.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
      source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
    ) {
      value.carrier
    } else {
      source.conflict_actual
    }
    receiver_expression: source.receiver_expression
    receiver_logical_type: source.receiver_logical_type
    receiver_nominal_owner: source.receiver_nominal_owner
    receiver_physical_heap_type: source.receiver_physical_heap_type
    selected_field: source.selected_field
    selected_type_index: source.selected_type_index
    selected_field_index: source.selected_field_index
    selected_storage: source.selected_storage
    call_function_index: source.call_function_index
  }
  true
}

fn self_host_body_plan_resolve_field(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  specialization: U32,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  embedded_targets: Array<Bool>,
  expression: U32,
) -> Bool {
  if expression < body.expressions.start || expression >= self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  ) {
    return false
  }
  let slot = self_host_body_expression_slot(body, expression)
  let source = expressions[slot]
  let mut base = 4294967295u32
  let mut selected = self_host_body_indexed_field(indexes, 0u64)
  let mut exact_receiver_owner = false
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, value, _) => {
      base = value
      selected = self_host_body_indexed_field(indexes, field)
      exact_receiver_owner = true
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, name) => {
      base = value
      let embedded_target = if expression >= body.expressions.start {
        let relative = expression - body.expressions.start
        if relative < embedded_targets.length() {
          embedded_targets[relative]
        } else {
          false
        }
      } else {
        false
      }
      if !embedded_target && base >= body.expressions.start &&
        base < self_host_u32_add(body.expressions.start, body.expressions.length) &&
        name < self_host_linked_module_name_count(module_) {
        let base_value = expressions[self_host_body_expression_slot(body, base)].value
        let recovered_owner = if self_host_u64_equal(
          base_value.nominal_owner,
          0u64,
        ) {
          self_host_linked_expression_nominal_declaration(
            link,
            module_,
            body,
            base,
          )
        } else {
          base_value.nominal_owner
        }
        selected = self_host_body_exact_field_by_owner_name(
          link,
          recovered_owner,
          self_host_linked_module_name_at(module_, name),
        )
      }
    }
    _ => {}
  }
  match selected {
    Option::Some(field) => if base >= body.expressions.start && base < self_host_u32_add(
      body.expressions.start,
      body.expressions.length,
    ) {
      let receiver_source = expressions[
        self_host_body_expression_slot(body, base)
      ].value
      let receiver = if exact_receiver_owner || self_host_u64_equal(
        receiver_source.nominal_owner,
        0u64,
      ) {
        SelfHostPlannedPhysicalValueInfo::{
          logical_type: receiver_source.logical_type
          carrier: receiver_source.carrier
          conflict_expected: receiver_source.conflict_expected
          conflict_actual: receiver_source.conflict_actual
          nominal_owner: field.owner
          physical_heap_type: if self_host_u64_equal(field.owner, 0u64) {
            4294967295u32
          } else {
            field.physical_type_index
          }
        }
      } else {
        receiver_source
      }
      let _ = self_host_body_plan_set_expression_value(
        body,
        expressions,
        base,
        receiver,
      )
      let physical_result_owner = self_host_body_field_value_nominal_owner(
        link,
        field.field_declaration,
      )
      let result_owner = if !self_host_u64_equal(
        physical_result_owner,
        0u64,
      ) {
        physical_result_owner
      } else {
        self_host_planned_expression_identity(
          module_.expressions[expression],
        ).nominal
      }
      let exact_expression = self_host_planned_expression_identity(
        module_.expressions[expression],
      )
      let result_evidence = SelfHostPlannedPhysicalValueInfo::{
        logical_type: exact_expression.type_
        carrier: self_host_body_field_read_carrier(link, module_, specialization, expression, field.field_declaration, field.storage)
        conflict_expected: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
        conflict_actual: SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
        nominal_owner: result_owner
        physical_heap_type: self_host_body_physical_heap_type(
          indexes,
          result_owner,
        )
      }
      let result = self_host_body_merge_value_provenance(
        source.value,
        result_evidence,
      )
      let changed = !self_host_u64_equal(
        source.selected_field,
        field.field_declaration,
      ) ||
        !self_host_u32_equal(
          source.selected_type_index,
          field.physical_type_index,
        ) || !self_host_u32_equal(
          source.selected_field_index,
          field.physical_field_index,
        ) ||
        !self_host_u64_equal(source.receiver_nominal_owner, receiver.nominal_owner) ||
        !self_host_u32_equal(
          source.receiver_physical_heap_type,
          receiver.physical_heap_type,
        ) || !self_host_body_value_info_equal(source.value, result)
      if changed {
        expressions[slot] = SelfHostPlannedPhysicalExpressionCarrier::{
          expression: source.expression
          value: result
          carrier: result.carrier
          conflict_expected: if result.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
            source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
          ) {
            source.carrier
          } else {
            source.conflict_expected
          }
          conflict_actual: if result.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier && !(
            source.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
          ) {
            result_evidence.carrier
          } else {
            source.conflict_actual
          }
          receiver_expression: base
          receiver_logical_type: receiver.logical_type
          receiver_nominal_owner: receiver.nominal_owner
          receiver_physical_heap_type: receiver.physical_heap_type
          selected_field: field.field_declaration
          selected_type_index: field.physical_type_index
          selected_field_index: field.physical_field_index
          selected_storage: Option::Some(field.storage)
          call_function_index: source.call_function_index
        }
      }
      changed
    } else {
      false
    }
    Option::None => false
  }
}

fn self_host_body_block_tail_expression(
  module_: SelfHostPlannedModuleLowering,
  block: U32,
) -> U32 {
  if block >= module_.blocks.length() {
    return 4294967295u32
  }
  let items = module_.blocks[block].items
  if self_host_u32_equal(items.length, 0u32) {
    return 4294967295u32
  }
  let tail = self_host_u32_subtract(
    self_host_u32_add(items.start, items.length),
    1u32,
  )
  if tail >= module_.block_items.length() {
    return 4294967295u32
  }
  match module_.block_items[tail].kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => expression
    _ => 4294967295u32
  }
}

fn self_host_body_block_carrier(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  block: U32,
) -> SelfHostWasmBodyCarrier {
  if block >= module_.blocks.length() {
    return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let items = module_.blocks[block].items
  if self_host_u32_equal(items.length, 0u32) {
    return SelfHostWasmBodyCarrier::UnitBodyCarrier
  }
  let tail = self_host_u32_subtract(
    self_host_u32_add(items.start, items.length),
    1u32,
  )
  if tail >= module_.block_items.length() {
    return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let item = module_.block_items[tail]
  match item.kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => {
      let slot = self_host_body_expression_slot(body, expression)
      if expression >= body.expressions.start &&
        expression < self_host_u32_add(body.expressions.start, body.expressions.length) &&
        slot < expressions.length() {
        expressions[slot].carrier
      } else {
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
    }
    _ => SelfHostWasmBodyCarrier::UnitBodyCarrier
  }
}

fn self_host_body_physical_field_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  field_index: U32,
) -> SelfHostWasmBodyCarrier {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        module_,
        linked_type.fragment_index,
      )
      if field_index < physical.fields.length {
        return self_host_body_carrier_from_storage(
          self_host_body_physical_field(
            module_,
            self_host_u32_add(physical.fields.start, field_index),
          ).storage,
        )
      }
    }
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_body_pattern_payload_value(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  pattern: SelfHostPlannedPattern,
  field_index: U32,
  fallback: SelfHostPlannedPhysicalValueInfo,
) -> SelfHostPlannedPhysicalValueInfo {
  let declaration = self_host_pattern_constructor_declaration(module_, pattern)
  if link.runtime_variant_adapters.get(declaration) is Option::Some(_) {
    // Standard Option/Result values use a payload-specialized runtime type,
    // not the erased reference field in the generic declaration fragment.
    match pattern.source {
      SelfHostHirPattern::TuplePattern(_, children, _) => if field_index < children.length {
        let child_slot = self_host_u32_add(children.start, field_index)
        if child_slot < module_.pattern_children.length() {
          let child = module_.pattern_children[child_slot]
          if child < module_.patterns.length() {
            let type_ = module_.patterns[child].type_
            return self_host_body_physical_value(
              indexes,
              type_,
              self_host_body_carrier_from_shape(self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, type_)),
              self_host_linked_type_nominal_declaration(module_, type_),
            )
          }
        }
      }
      _ => {}
    }
    return self_host_body_physical_value(indexes, -1i32, SelfHostWasmBodyCarrier::UnresolvedBodyCarrier, 0u64)
  }
  let selected_constructor = match pattern.selected_constructor {
    SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(_, _, _) => {
      pattern.selected_constructor
    }
    _ => match pattern.source {
      SelfHostHirPattern::TuplePattern(target, _, _) => if target < module_.patterns.length() {
        module_.patterns[target].selected_constructor
      } else {
        pattern.selected_constructor
      }
      _ => pattern.selected_constructor
    }
  }
  match selected_constructor {
    SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
      constructor,
      _,
      arguments,
    ) => {
      match indexes.type_by_variant.get(constructor) {
        Option::Some(type_index) => {
          let physical_carrier = self_host_body_physical_field_carrier(
            link,
            type_index,
            field_index,
          )
          if !(physical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            let payload_type = match pattern.source {
              SelfHostHirPattern::TuplePattern(_, children, _) => if field_index <
                children.length && self_host_u32_add(
                  children.start,
                  field_index,
                ) < module_.pattern_children.length() {
                let child = module_.pattern_children[self_host_u32_add(
                  children.start,
                  field_index,
                )]
                if child < module_.patterns.length() {
                  module_.patterns[child].type_
                } else {
                  -1i32
                }
              } else {
                -1i32
              }
              _ => -1i32
            }
            let physical_payload_owner = self_host_linked_field_value_nominal_declaration(
              link,
              SelfHostLinkedWasmFieldLink::{
                type_index: type_index
                field_index: field_index
              },
            )
            let payload_owner = if !self_host_u64_equal(
              physical_payload_owner,
              0u64,
            ) {
              physical_payload_owner
            } else {
              self_host_linked_type_nominal_declaration(
                module_,
                payload_type,
              )
            }
            return self_host_body_physical_value(
              indexes,
              payload_type,
              physical_carrier,
              payload_owner,
            )
          }
        }
        Option::None => {}
      }
      match self_host_linked_pattern_variant_type(
        link,
        module_,
        pattern,
        SelfHostPlannedValueShape::ErrorPlannedValueShape,
        fallback.nominal_owner,
      ) {
        Option::Some(type_index) => {
          let physical_carrier = self_host_body_physical_field_carrier(
            link,
            type_index,
            field_index,
          )
          if !(physical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            let physical_payload_owner = self_host_linked_field_value_nominal_declaration(
              link,
              SelfHostLinkedWasmFieldLink::{
                type_index: type_index
                field_index: field_index
              },
            )
            return self_host_body_physical_value(
              indexes,
              -1i32,
              physical_carrier,
              physical_payload_owner,
            )
          }
        }
        Option::None => {}
      }
      let inferred_payload_type = match pattern.source {
        SelfHostHirPattern::TuplePattern(_, children, _) => if field_index <
          children.length && self_host_u32_add(
            children.start,
            field_index,
          ) < module_.pattern_children.length() {
          let child = module_.pattern_children[self_host_u32_add(
            children.start,
            field_index,
          )]
          if child < module_.patterns.length() {
            module_.patterns[child].type_
          } else {
            -1i32
          }
        } else {
          -1i32
        }
        _ => -1i32
      }
      let inferred_payload_shape = self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        inferred_payload_type,
      )
      if !(inferred_payload_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
        let inferred_payload_owner = self_host_linked_type_nominal_declaration(
          module_,
          inferred_payload_type,
        )
        return self_host_body_physical_value(
          indexes,
          inferred_payload_type,
          self_host_body_carrier_from_shape(inferred_payload_shape),
          inferred_payload_owner,
        )
      }
      let name = self_host_linked_declaration_name(link, constructor)
      if !(name.ends_with(b"Some") || name.ends_with(b"Ok") || name.ends_with(
        b"Err",
      )) {
        return fallback
      }
      let argument = if name.ends_with(b"Err") {
        1u32
      } else {
        0u32
      }
      if argument < arguments.length {
        let index = self_host_u32_add(arguments.start, argument)
        if index < module_.inferred.pattern_type_arguments.length() {
          let type_ = module_.inferred.pattern_type_arguments[index]
          let shape = self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            type_,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            let owner = self_host_linked_type_nominal_declaration(module_, type_)
            return self_host_body_physical_value(
              indexes,
              type_,
              self_host_body_carrier_from_shape(shape),
              owner,
            )
          }
        }
      }
    }
    _ => {}
  }
  fallback
}

fn self_host_body_force_return_carriers(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  result_carrier: SelfHostWasmBodyCarrier,
) -> Unit {
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => if value != 4294967295u32 &&
          value >= body.expressions.start && value < expression_end {
          let _ = self_host_body_plan_force_expression_carrier(
            body,
            expressions,
            value,
            result_carrier,
          )
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_force_pattern_value_at(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern_index: U32,
  incoming: SelfHostPlannedPhysicalValueInfo,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
  depth: U32,
) -> Bool {
  if depth >= 64u32 || pattern_index >= module_.patterns.length() {
    return false
  }
  let source = self_host_planned_pattern_identity(
    module_.patterns[pattern_index],
  )
  let nominal_owner = self_host_linked_type_nominal_declaration(
    module_,
    source.type_,
  )
  let pattern_carrier = self_host_body_carrier_from_shape(source.shape)
  let pattern_value = self_host_body_physical_value(
    indexes,
    source.type_,
    if !(incoming.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
      incoming.carrier
    } else {
      pattern_carrier
    },
    if !self_host_u64_equal(incoming.nominal_owner, 0u64) {
      incoming.nominal_owner
    } else {
      nominal_owner
    },
  )
  let mut changed = false
  match source.reference {
    SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
      let local = self_host_body_local_slot(module_, body, local_id)
      if local != 4294967295u32 && self_host_body_plan_force_local_value(
        local_values,
        locals,
        local,
        pattern_value,
      ) {
        changed = true
      }
    }
    _ => {}
  }
  match source.source {
    SelfHostHirPattern::TuplePattern(_, children, _) => {
      let mut child_offset = 0u32
      let _ = while child_offset {
        current => if current < children.length {
          let child_slot = self_host_u32_add(children.start, current)
          if child_slot < module_.pattern_children.length() {
            let child_pattern = module_.pattern_children[child_slot]
            let child_value = self_host_body_pattern_payload_value(
              link,
              indexes,
              module_,
              source,
              current,
              pattern_value,
            )
            if self_host_body_force_pattern_value_at(
              link,
              indexes,
              module_,
              body,
              child_pattern,
              child_value,
              local_values,
              locals,
              depth + 1u32,
            ) {
              changed = true
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    SelfHostHirPattern::AlternativePattern(first, alternatives, _) => {
      if self_host_body_force_pattern_value_at(
        link,
        indexes,
        module_,
        body,
        first,
        pattern_value,
        local_values,
        locals,
        depth + 1u32,
      ) {
        changed = true
      }
      let mut alternative_offset = 0u32
      let _ = while alternative_offset {
        current => if current < alternatives.length {
          let child_slot = self_host_u32_add(alternatives.start, current)
          if child_slot < module_.pattern_children.length() &&
            self_host_body_force_pattern_value_at(
              link,
              indexes,
              module_,
              body,
              module_.pattern_children[child_slot],
              pattern_value,
              local_values,
              locals,
              depth + 1u32,
            ) {
            changed = true
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    _ => {}
  }
  changed
}

fn self_host_body_force_pattern_values(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  incoming: SelfHostPlannedPhysicalValueInfo,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  self_host_body_force_pattern_value_at(
    link,
    indexes,
    module_,
    body,
    root,
    incoming,
    local_values,
    locals,
    0u32,
  )
}

fn self_host_body_force_declared_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Unit {
  let unknown = self_host_body_physical_value(
    indexes,
    -1i32,
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    0u64,
  )
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.patterns.length {
      let pattern = self_host_u32_add(body.patterns.start, current)
      if pattern < module_.patterns.length() {
        let _ = self_host_body_force_pattern_values(
          link,
          indexes,
          module_,
          body,
          pattern,
          unknown,
          local_values,
          locals,
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_force_physical_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  subject_owner: U64,
  payload_hint: SelfHostPlannedValueShape,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if root >= module_.patterns.length() {
    return false
  }
  let root_type = match self_host_linked_pattern_variant_type(
    link,
    module_,
    module_.patterns[root],
    payload_hint,
    subject_owner,
  ) {
    Option::Some(value) => value
    Option::None => return false
  }
  let patterns = [root]
  let physical_types = [root_type]
  let mut changed = false
  let _ = while patterns.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let pattern_index = match self_host_array_pop(patterns) {
        Option::Some(value) => value
        Option::None => 4294967295u32
      }
      let type_index = match self_host_array_pop(physical_types) {
        Option::Some(value) => value
        Option::None => 4294967295u32
      }
      if pattern_index < module_.patterns.length() && type_index != 4294967295u32 {
        let pattern = self_host_planned_pattern_identity(
          module_.patterns[pattern_index],
        )
        match pattern.source {
          SelfHostHirPattern::TuplePattern(_, children, _) => {
            let mut field_index = 0u32
            let _ = while field_index {
              current => if current < children.length {
                let child_offset = self_host_u32_add(children.start, current)
                if child_offset < module_.pattern_children.length() {
                  let child_index = module_.pattern_children[child_offset]
                  if child_index < module_.patterns.length() {
                    let child = self_host_planned_pattern_identity(
                      module_.patterns[child_index],
                    )
                    let carrier = self_host_body_physical_field_carrier(
                      link,
                      type_index,
                      current,
                    )
                    let owner = self_host_linked_field_value_nominal_declaration(
                      link,
                      SelfHostLinkedWasmFieldLink::{
                        type_index: type_index
                        field_index: current
                      },
                    )
                    let value = self_host_body_physical_value(
                      indexes,
                      child.type_,
                      carrier,
                      owner,
                    )
                    match child.reference {
                      SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
                        let slot = self_host_body_local_slot(module_, body, local_id)
                        if slot != 4294967295u32 && self_host_body_plan_force_local_value(
                          local_values,
                          locals,
                          slot,
                          value,
                        ) {
                          changed = true
                        }
                      }
                      _ => {}
                    }
                    match child.source {
                      SelfHostHirPattern::TuplePattern(_, _, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        child,
                        SelfHostPlannedValueShape::ErrorPlannedValueShape,
                        owner,
                      ) {
                        Option::Some(child_type) => {
                          patterns.push(child_index)
                          physical_types.push(child_type)
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                }
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue patterns.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  changed
}

fn self_host_body_seed_match_payload_binding(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern_index: U32,
  subject_expression: U32,
  subject_type: I32,
  subject_function: U32,
  caller_specialization: U32,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if pattern_index >= module_.patterns.length() {
    return false
  }
  let pattern = self_host_planned_pattern_identity(
    module_.patterns[pattern_index],
  )
  let mut target = 0u32
  let mut children = SelfHostHirSpan::{
    start: 0u32
    length: 0u32
  }
  match pattern.source {
    SelfHostHirPattern::TuplePattern(value, values, _) => {
      target = value
      children = values
    }
    _ => return false
  }
  if self_host_u32_equal(children.length, 0u32) ||
    children.start >= module_.pattern_children.length() {
    return false
  }
  let _ = target
  let name = self_host_linked_pattern_name(module_, pattern)
  let argument = if name == "Err" {
    1u32
  } else if name == "Some" || name == "Ok" {
    0u32
  } else {
    return false
  }
  let mut shape = self_host_linked_type_argument_shape(
    module_,
    subject_type,
    argument,
  )
  let mut owner = self_host_body_type_argument_nominal_owner(
    module_,
    subject_type,
    argument,

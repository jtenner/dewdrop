fn self_host_body_call_target_identity(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
) -> Option<SelfHostPlannedProgramWasmFunction> {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) {
      return Some(function_)
    }
  }
  None
}

fn self_host_body_call_receiver_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  declaration: U64,
) -> U32 {
  if self_host_u64_equal(declaration, 0u64) ||
    !self_host_linked_declaration_has_receiver(link, declaration) ||
    expression >= module_.expressions.length() {
    return 4294967295u32
  }
  let target = match module_.expressions[expression].kind {
    PlannedOperatorCall(_, _, left, _, _) => return left
    PlannedIndexGet(base, _, _) => return base
    PlannedIndexSet(base, _, _, _) => return base
    PlannedDirectCall(_, value, _, _) => value
    PlannedUnresolvedCall(value, _) => value
    _ => 4294967295u32
  }
  if target >= module_.expressions.length() {
    return 4294967295u32
  }
  match self_host_linked_direct_receiver_expression(module_, target) {
    Some(receiver) => receiver
    None => 4294967295u32
  }
}

fn self_host_body_call_operand_expression(
  source: SelfHostPhysicalOperandSource,
) -> U32 {
  match source {
    ExplicitArgumentPhysicalOperand(value) => value
    ReceiverPhysicalOperand(value) => value
    // A cached pattern subject is not a source expression to evaluate again.
    PatternSubjectPhysicalOperand(_) => 4294967295u32
    TraitEvidencePhysicalOperand(value) => value
    ClosureEnvironmentPhysicalOperand(value) => value
    RuntimeContextPhysicalOperand(value) => value
  }
}

fn self_host_body_carrier_emits_call_operand(
  carrier: SelfHostWasmBodyCarrier,
) -> Bool {
  !(carrier is UnitBodyCarrier) && !(
    carrier is NeverBodyCarrier
  )
}

fn self_host_body_plan_call_argument(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  evaluation_expression: U32,
  call_evaluations: Array<U32>,
  call_operands: Array<SelfHostPhysicalOperandSource>,
) -> Bool {
  call_evaluations.push(evaluation_expression)
  if evaluation_expression < body.expressions.start || evaluation_expression >=
    self_host_u32_add(body.expressions.start, body.expressions.length) {
    call_operands.push(
      ExplicitArgumentPhysicalOperand(
        evaluation_expression,
      ),
    )
    return true
  }
  let planned = expressions[self_host_body_expression_slot(
    body,
    evaluation_expression,
  )]
  if planned.carrier is NeverBodyCarrier {
    return false
  }
  if !self_host_body_carrier_emits_call_operand(planned.carrier) {
    return true
  }
  call_operands.push(
    ExplicitArgumentPhysicalOperand(evaluation_expression),
  )
  true
}

fn self_host_body_build_physical_call_plans(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expressions: Array<SelfHostPlannedPhysicalExpressionCarrier>,
  call_evaluations: Array<U32>,
  call_operands: Array<SelfHostPhysicalOperandSource>,
) -> Array<SelfHostPhysicalCallPlan> {
  let calls = self_host_body_empty_call_plans()
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut expression = body.expressions.start
  let _ = while expression {
    current => if current < expression_end && current < module_.expressions.length() {
      let expression_plan = expressions[self_host_body_expression_slot(body, current)]
      if !self_host_u32_equal(
        expression_plan.call_function_index,
        4294967295u32,
      ) {
        match self_host_body_call_target_identity(
          link,
          expression_plan.call_function_index,
        ) {
          Some(target) => {
            let arguments = match module_.expressions[current].kind {
              PlannedDirectCall(_, _, values, _) => values
              PlannedUnresolvedCall(_, values) => values
              PlannedBuiltinCall(_, _, _, values, _) => values
              _ => ({
                start: 0u32
                length: 0u32
              })
            }
            let evaluation_start = call_evaluations.length()
            let operand_start = call_operands.length()
            let mut emits_call = true
            let receiver = self_host_body_call_receiver_expression(
              link,
              module_,
              current,
              target.declaration,
            )
            if receiver != 4294967295u32 {
              emits_call = self_host_body_plan_call_argument(module_, body, expressions,
                receiver, call_evaluations, call_operands,
              )
              if call_operands.length() > operand_start {
                call_operands[operand_start] = ReceiverPhysicalOperand(receiver)
              }
            }
            let (index_argument, index_value) = match module_.expressions[current].kind {
              PlannedOperatorCall(_, _, _, right, _) => (right, 4294967295u32)
              PlannedIndexGet(_, index, _) => (index, 4294967295u32)
              PlannedIndexSet(_, index, value, _) => (index, value)
              _ => (4294967295u32, 4294967295u32)
            }
            let argument_count = if index_value != 4294967295u32 {
              2u32
            } else if index_argument != 4294967295u32 {
              1u32
            } else {
              arguments.length
            }
            let mut argument = 0u32
            let _ = while argument {
              offset => if offset < argument_count && emits_call {
                let child = self_host_u32_add(arguments.start, offset)
                if index_argument != 4294967295u32 || child < module_.expression_children.length() {
                  let source = if index_argument != 4294967295u32 {
                    if offset == 0u32 {
                      index_argument
                    } else {
                      index_value
                    }
                  } else {
                    module_.expression_children[child]
                  }
                  emits_call = self_host_body_plan_call_argument(
                    module_,
                    body,
                    expressions,
                    source,
                    call_evaluations,
                    call_operands,
                  )
                } else {
                  call_evaluations.push(4294967295u32)
                  call_operands.push(
                    ExplicitArgumentPhysicalOperand(
                      4294967295u32,
                    ),
                  )
                }
                continue offset + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            calls.push({
              expression: current
              receiver_expression: receiver
              declaration: target.declaration
              specialization: target.specialization
              physical_function: self_host_linked_physical_function_index(
                target.function_index,
              )
              emits_call: emits_call
              evaluations: {
                start: evaluation_start
                length: call_evaluations.length() - evaluation_start
              }
              operands: {
                start: operand_start
                length: call_operands.length() - operand_start
              }
            })
          }
          None => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  calls
}

fn self_host_body_call_plan(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
) -> Option<SelfHostPhysicalCallPlan> {
  for call in plan.calls {
    if self_host_u32_equal(call.expression, expression) {
      return Some(call)
    }
  }
  None
}

fn self_host_body_expression_work_item(
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  if expression < body.expressions.start {
    return 4294967295u32
  }
  let relative = expression - body.expressions.start
  if relative >= body.expressions.length {
    return 4294967295u32
  }
  self_host_u32_add(relative, 1u32)
}

fn self_host_body_link_expression_work(
  graph: SelfHostBodyWorkGraph,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  expression: U32,
) -> Unit {
  let child_item = self_host_body_expression_work_item(body, expression)
  if child_item != 4294967295u32 {
    self_host_body_add_work_pair(graph, owner_item, child_item)
  }
}

fn self_host_body_link_expression_span_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  children: SelfHostHirSpan,
) -> Unit {
  let mut child = 0u32
  let _ = while child {
    current => if current < children.length {
      let index = self_host_u32_add(children.start, current)
      if index < module_.expression_children.length() {
        self_host_body_link_expression_work(
          graph,
          body,
          owner_item,
          module_.expression_children[index],
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_object_field_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  owner_item: U32,
  fields: SelfHostHirSpan,
) -> Unit {
  let mut field = 0u32
  let _ = while field {
    current => if current < fields.length {
      let index = self_host_u32_add(fields.start, current)
      if index < module_.object_fields.length() {
        self_host_body_link_expression_work(
          graph,
          body,
          owner_item,
          module_.object_fields[index].value,
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_local_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  local_id: U32,
) -> Unit {
  let slot = self_host_body_local_slot(module_, body, local_id)
  if slot < body.locals.length {
    self_host_body_add_work_pair(
      graph,
      owner_item,
      self_host_u32_add(local_base, slot),
    )
  }
}

fn self_host_body_link_pattern_local_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  pattern: U32,
) -> Unit {
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let index = self_host_u32_add(body.locals.start, current)
      if index < module_.locals.length() && self_host_linked_pattern_binds_local(
        module_,
        pattern,
        module_.locals[index].local_id,
      ) {
        self_host_body_add_work_pair(
          graph,
          owner_item,
          self_host_u32_add(local_base, current),
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_link_arm_work(
  graph: SelfHostBodyWorkGraph,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_base: U32,
  owner_item: U32,
  arms: SelfHostHirSpan,
) -> Unit {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = module_.pattern_arms[arm_index]
          self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            source.body,
          )
          self_host_body_link_pattern_local_work(
            graph,
            module_,
            body,
            local_base,
            owner_item,
            source.pattern,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_build_work_graph(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  maximum_control: U32,
) -> SelfHostBodyWorkGraph {
  let wide_count = 1u64 + u32_into_u64(body.expressions.length) +
    u32_into_u64(body.locals.length) + 2u64 * u32_into_u64(maximum_control)
  let _ = self_host_assert_compiler_invariant_with_failure(wide_count <= 4294967295u64,
    {
      code: 101u32
      phase: 6u32
      module_id: module_.module_id
      declaration: body.declaration
      body: body.body
      expression: 4294967295u32
      expected: 4294967295u64
      actual: wide_count
      detail: (15u64 << 32u64) | 4294967295u64
    }, "physical carrier work graph node count overflow")
  let local_base = self_host_u32_add(body.expressions.length, 1u32)
  let control_state_base = self_host_u32_add(local_base, body.locals.length)
  let control_result_base = self_host_u32_add(control_state_base, maximum_control)
  let work_item_count = self_host_u32_add(control_result_base, maximum_control)
  let graph = self_host_body_empty_work_graph(work_item_count)
  let expression_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      let owner_item = self_host_u32_add(current, 1u32)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          PlannedConsumedExpression => if expression > body.expressions.start {
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              expression - 1u32,
            )
          }
          PlannedProductNew(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          PlannedEvaluationSequence(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          PlannedArrayLiteral(children) => self_host_body_link_expression_span_work(
            graph,
            module_,
            body,
            owner_item,
            children,
          )
          PlannedObjectNew(fields) => self_host_body_link_object_field_work(
            graph,
            module_,
            body,
            owner_item,
            fields,
          )
          PlannedConstruct(_, fields, _) => self_host_body_link_object_field_work(
            graph,
            module_,
            body,
            owner_item,
            fields,
          )
          PlannedBlockExpression(block) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            self_host_body_block_tail_expression(module_, block),
          )
          PlannedIfExpression(
            condition,
            then_block,
            else_expression,
          ) => {
            self_host_body_link_expression_work(graph, body, owner_item, condition)
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              self_host_body_block_tail_expression(module_, then_block),
            )
            self_host_body_link_expression_work(
              graph,
              body,
              owner_item,
              else_expression,
            )
          }
          PlannedMatchExpression(subject, arms) => {
            self_host_body_link_expression_work(graph, body, owner_item, subject)
            self_host_body_link_arm_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              arms,
            )
          }
          PlannedWhileExpression(
            control,
            initial,
            arms,
          ) => {
            self_host_body_link_expression_work(graph, body, owner_item, initial)
            self_host_body_link_arm_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              arms,
            )
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_state_base, control),
              )
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_result_base, control),
              )
            }
          }
          PlannedReturnExpression(value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          PlannedBreakExpression(control, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, value)
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_result_base, control),
              )
            }
          }
          PlannedContinueExpression(control, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, value)
            if control < maximum_control {
              self_host_body_add_work_pair(
                graph,
                owner_item,
                self_host_u32_add(control_state_base, control),
              )
            }
          }
          PlannedPrefixExpression(_, value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          PlannedBinaryExpression(_, left, right) => {
            self_host_body_link_expression_work(graph, body, owner_item, left)
            self_host_body_link_expression_work(graph, body, owner_item, right)
          }
          PlannedOperatorCall(_, _, left, right, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, left)
            self_host_body_link_expression_work(graph, body, owner_item, right)
          }
          PlannedBuiltinCall(_, _, target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          PlannedDirectCall(_, target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          PlannedFunctionValueCall(target, arguments, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          PlannedUnresolvedCall(target, arguments) => {
            self_host_body_link_expression_work(graph, body, owner_item, target)
            self_host_body_link_expression_span_work(
              graph,
              module_,
              body,
              owner_item,
              arguments,
            )
          }
          PlannedFieldGet(_, base, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          PlannedUnresolvedField(base, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          PlannedProductField(base, _, _) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            base,
          )
          PlannedIndexGet(base, index, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, index)
          }
          PlannedLocalGet(local) => self_host_body_link_local_work(
            graph,
            module_,
            body,
            local_base,
            owner_item,
            local,
          )
          PlannedLocalSet(local, value) => {
            self_host_body_link_local_work(
              graph,
              module_,
              body,
              local_base,
              owner_item,
              local,
            )
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          PlannedCaptureSet(_, value) => self_host_body_link_expression_work(
            graph,
            body,
            owner_item,
            value,
          )
          PlannedFieldSet(_, base, value) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          PlannedIndexSet(base, index, value, _) => {
            self_host_body_link_expression_work(graph, body, owner_item, base)
            self_host_body_link_expression_work(graph, body, owner_item, index)
            self_host_body_link_expression_work(graph, body, owner_item, value)
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut block = 0u32
  let _ = while block {
    current => if current < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current)
      if block_index < module_.blocks.length() {
        let items = module_.blocks[block_index].items
        let mut item = 0u32
        let _ = while item {
          offset => if offset < items.length {
            let index = self_host_u32_add(items.start, offset)
            if index < module_.block_items.length() {
              match module_.block_items[index].kind {
                PlannedLetItem(
                  local,
                  _,
                  initializer,
                ) => {
                  self_host_body_link_expression_work(
                    graph,
                    body,
                    0u32,
                    initializer,
                  )
                  self_host_body_link_local_work(
                    graph,
                    module_,
                    body,
                    local_base,
                    0u32,
                    local,
                  )
                }
                _ => {}
              }
            }
            continue offset + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  graph
}

fn self_host_plan_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  linked_function: SelfHostPlannedProgramWasmFunction,
  body: SelfHostPlannedBodyLowering,
  lambda: U32,
) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
  let fragment_module = self_host_body_fragment_module(link, linked_function.module_index)
  let fragment = self_host_body_function_fragment(fragment_module, linked_function.fragment_index)
  let physical_result_carrier = if self_host_u32_equal(
    fragment.results.length,
    0u32,
  ) {
    UnitBodyCarrier
  } else if self_host_u32_equal(fragment.results.length, 1u32) &&
    self_host_u32_greater(
      fragment_module.function_value_types.length(),
      fragment.results.start,
    ) {
    self_host_body_carrier_from_value_type(
      self_host_body_function_value_type(
        fragment_module,
        fragment.results.start,
      ),
    )
  } else {
    UnresolvedBodyCarrier
  }
  let result_owner = match self_host_program_specialization_callable(
    module_,
    linked_function.declaration,
  ) {
    Some(callable) => self_host_linked_resolved_nominal_declaration(
      module_,
      callable.result_type,
    )
    None => 0u64
  }
  self_host_plan_physical_body_with_signature(link, indexes, linked_function, body, lambda,
    fragment.parameters, physical_result_carrier, result_owner)
}

fn self_host_plan_physical_body_with_signature(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  linked_function: SelfHostPlannedProgramWasmFunction,
  body: SelfHostPlannedBodyLowering,
  lambda: U32,
  parameters: SelfHostHirSpan,
  physical_result_carrier: SelfHostWasmBodyCarrier,
  result_owner: U64,
) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
  self_host_verify_lowered_body_children(module_, body, lambda)
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  let local_by_initializer = self_host_body_local_by_initializer(module_, body)
  let fragment_module = self_host_body_fragment_module(link, linked_function.module_index)
  let expressions = self_host_body_empty_physical_expressions()
  let mut expression = body.expressions.start
  let expression_end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let _ = while expression {
    current => if current < expression_end {
      expressions.push(
        self_host_body_seed_expression(
          link,
          indexes,
          module_,
          body,
          linked_function.specialization,
          current,
        ),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let local_values = self_host_body_empty_physical_values()
  let locals = self_host_body_empty_carriers()
  let mut parameter_index = if lambda == 4294967295u32 {
    0u32
  } else {
    1u32
  }
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_body_planned_local_identity(
        module_.locals[self_host_u32_add(body.locals.start, current)],
      )
      let source_shape = self_host_body_specialization_shape_for_type(
        link, module_, linked_function.specialization, source.type_, source.shape,
      )
      let initializer_diverges = match self_host_linked_local_initializer_expression(module_, body, source.local_id) {
        Some(initializer) => {
          let _ = self_host_body_expression_slot(body, initializer)
          !module_.expressions[initializer].flow.falls_through
        }
        None => false
      }
      let local_carrier = if initializer_diverges {
        // No value reaches this binding. Preserve the source flow proof;
        // allocating a reference slot would invent a value after divergence.
        NeverBodyCarrier
      } else if source_shape is UnitPlannedValueShape {
        UnitBodyCarrier
      } else if source_shape is NeverPlannedValueShape {
        NeverBodyCarrier
      } else if source.kind is ParameterLocal &&
        parameter_index < parameters.length {
        let value_index = self_host_u32_add(parameters.start, parameter_index)
        let parameter_carrier = if self_host_u32_greater(
          fragment_module.function_value_types.length(),
          value_index,
        ) {
          self_host_body_carrier_from_value_type(
            self_host_body_function_value_type(
              fragment_module,
              value_index,
            ),
          )
        } else {
          UnresolvedBodyCarrier
        }
        parameter_index = self_host_u32_add(parameter_index, 1u32)
        parameter_carrier
      } else {
        // Initializers, assignments, and pattern payloads are physical proof.
        // A stale inferred local shape must not rewrite those expressions.
        UnresolvedBodyCarrier
      }
      let inferred_local_owner = if !self_host_u64_equal(source.nominal, 0u64) {
        source.nominal
      } else {
        self_host_linked_type_nominal_declaration(module_, source.type_)
      }
      let local_owner = if source.kind is ParameterLocal &&
        self_host_u64_equal(inferred_local_owner, 0u64) {
        self_host_body_local_parameter_nominal_owner(
          link,
          module_,
          body,
          source.local_id,
        )
      } else {
        inferred_local_owner
      }
      local_values.push(
        self_host_body_physical_value(
          indexes,
          source.type_,
          local_carrier,
          local_owner,
        ),
      )
      locals.push(local_carrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut loop_local_offset = 0u32
  let _ = while loop_local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() && current < local_values.length() &&
        current < locals.length() {
        let planned_local = module_.locals[local_index]
        let nominal = self_host_linked_loop_binding_nominal_declaration(
          link,
          module_,
          body,
          planned_local.local_id,
        )
        if !self_host_u64_equal(nominal, 0u64) && self_host_u64_equal(
          local_values[current].nominal_owner,
          0u64,
        ) {
          let carrier = if local_values[current].carrier is UnresolvedBodyCarrier {
            EqRefBodyCarrier
          } else {
            local_values[current].carrier
          }
          local_values[current] = {
            logical_type: local_values[current].logical_type
            carrier: carrier
            conflict_expected: local_values[current].conflict_expected
            conflict_actual: local_values[current].conflict_actual
            nominal_owner: nominal
            physical_heap_type: self_host_body_physical_heap_type(indexes, nominal)
          }
          locals[current] = carrier
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut pattern_offset = 0u32
  let _ = while pattern_offset {
    current => if current < body.patterns.length {
      let pattern_index = self_host_u32_add(body.patterns.start, current)
      if pattern_index < module_.patterns.length() {
        let pattern = self_host_planned_pattern_identity(
          module_.patterns[pattern_index],
        )
        match pattern.source {
          TuplePattern(_, children, _) => {
            let mut child_offset = 0u32
            let _ = while child_offset {
              field_index => if field_index < children.length {
                let child_index = self_host_u32_add(children.start, field_index)
                if child_index < module_.pattern_children.length() {
                  let child = module_.pattern_children[child_index]
                  if child < module_.patterns.length() {
                    match self_host_planned_pattern_identity(
                      module_.patterns[child],
                    ).reference {
                      PatternBindingReference(local_id) => {
                        let slot = self_host_body_local_slot(module_, body, local_id)
                        if slot < local_values.length() {
                          let payload_value = self_host_body_pattern_payload_value(
                            link,
                            indexes,
                            module_,
                            pattern,
                            field_index,
                            local_values[slot],
                          )
                          let _ = self_host_body_plan_force_local_value(
                            local_values,
                            locals,
                            slot,
                            payload_value,
                          )
                        }
                      }
                      _ => {}
                    }
                  }
                }
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let control_state_values = self_host_body_empty_physical_values()
  let control_states = self_host_body_empty_carriers()
  let control_result_values = self_host_body_empty_physical_values()
  let control_results = self_host_body_empty_carriers()
  let mut maximum_control = 0u32
  let mut control_plan_index = 0u32
  while control_plan_index {
    current => if current < expressions.length() {
      let planned = self_host_body_physical_expression_at(expressions, current)
      match module_.expressions[planned.expression].kind {
        PlannedWhileExpression(control, _, _) => if control != 4294967295u32 &&
          control >= maximum_control {
          maximum_control = self_host_u32_add(control, 1u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut control = 0u32
  let _ = while control {
    current => if current < maximum_control {
      control_state_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_states.push(UnresolvedBodyCarrier)
      control_result_values.push(
        self_host_body_physical_value(
          indexes,
          -1i32,
          UnresolvedBodyCarrier,
          0u64,
        ),
      )
      control_results.push(UnresolvedBodyCarrier)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result = self_host_body_physical_value(
    indexes,
    body.root_type,
    physical_result_carrier,
    result_owner,
  )
  match body.root {
    ExpressionBodyRoot(root) => {
      // The physical function signature is exact proof for its root value.
      // A logical fallback must not replace this carrier.
      let _ = self_host_body_plan_force_expression_value(
        body,
        expressions,
        root,
        result,
      )
    }
    BlockBodyRoot(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if tail != 4294967295u32 {
        // The block tail must produce the exact physical function result.
        let _ = self_host_body_plan_force_expression_value(
          body,
          expressions,
          tail,
          result,
        )
      }
    }
  }
  self_host_body_force_declared_pattern_payloads(
    link,
    indexes,
    module_,
    body,
    local_values,
    locals,
  )
  self_host_body_force_return_carriers(
    module_,
    body,
    expressions,
    physical_result_carrier,
  )
  // Work item zero owns block/local-initializer constraints. The next items
  // own expression constraints. Local and control items are dependency hubs:
  // they wake only the expressions that read or write the changed cell.
  let work_graph = self_host_body_build_work_graph(
    module_,
    body,
    maximum_control,
  )
  let work = self_host_body_work_queue_new(work_graph, module_.module_id,
    body.declaration, body.body, body.expressions)
  let _ = while self_host_body_work_queue_next(work) {
    Some(current_work_item) => {
      let mut changed = false
      let mut block_offset = if self_host_u32_equal(current_work_item, 0u32) {
        0u32
      } else {
        body.blocks.length
      }
      let _ = while block_offset {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          let items = module_.blocks[block_index].items
          let mut item_offset = 0u32
          let _ = while item_offset {
            current_item => if current_item < items.length {
              let item = module_.block_items[
                self_host_u32_add(items.start, current_item)
              ]
              match item.kind {
                PlannedLetItem(
                  local_id,
                  _,
                  initializer,
                ) => {
                  let local_slot = self_host_body_local_slot(
                    module_,
                    body,
                    local_id,
                  )
                  if local_slot != 4294967295u32 &&
                    initializer >= body.expressions.start &&
                    initializer < expression_end {
                    let expected_carrier = local_values[local_slot].carrier
                    if !(expected_carrier is UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      initializer,
                      expected_carrier,
                    ) {
                      changed = true
                    }
                    let expression_slot = self_host_body_expression_slot(
                      body,
                      initializer,
                    )
                    let initializer_value = expressions[expression_slot].value
                    if self_host_body_plan_set_local_value(
                      local_values,
                      locals,
                      local_slot,
                      initializer_value,
                    ) {
                      changed = true
                    }
                    if self_host_body_plan_set_expression_value(
                      body,
                      expressions,
                      initializer,
                      local_values[local_slot],
                    ) {
                      changed = true
                    }
                  }
                }
                _ => {}
              }
              continue current_item + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      // Parents have larger expression ids than their children. Walk backward
      // so an expected carrier reaches a branch tail, local, and initializer
      // in one pass instead of one graph edge per pass.
      expression = if self_host_u32_equal(current_work_item, 0u32) ||
        current_work_item > body.expressions.length {
        body.expressions.start
      } else {
        self_host_u32_add(body.expressions.start, current_work_item)
      }
      let _ = while expression {
        remaining => if remaining > body.expressions.start {
          let current = self_host_u32_subtract(remaining, 1u32)
          let slot = self_host_body_expression_slot(body, current)
          if self_host_body_plan_resolve_field(
            link,
            indexes,
            module_,
            body,
            linked_function.specialization,
            expressions,
            embedded_targets,
            current,
          ) {
            changed = true
          }
          match module_.expressions[current].kind {
            PlannedPrefixExpression(
              operator,
              operand,
            ) => if operand >= body.expressions.start && operand < expression_end {
              let operand_carrier = expressions[
                self_host_body_expression_slot(body, operand)
              ].carrier
              let semantic_carrier = self_host_body_carrier_from_shape(
                self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  module_.expressions[current].type_,
                ),
              )
              let result_carrier = if operator is LogicalNot {
                I32BodyCarrier
              } else if !(semantic_carrier is UnresolvedBodyCarrier) {
                semantic_carrier
              } else {
                operand_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if !(operator is LogicalNot) &&
                self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  operand,
                  result_carrier,
                ) {
                changed = true
              }
            }
            PlannedBinaryExpression(
              operator,
              left,
              right,
            ) => if left >= body.expressions.start && left < expression_end {
              if right >= body.expressions.start && right < expression_end {
                let left_carrier = expressions[
                  self_host_body_expression_slot(body, left)
                ].carrier
                let right_carrier = expressions[
                  self_host_body_expression_slot(body, right)
                ].carrier
                let prior_result_carrier = expressions[slot].carrier
                let operand_carrier = self_host_body_binary_operand_carrier(
                  operator,
                  left_carrier,
                  right_carrier,
                  prior_result_carrier,
                )
                let result_carrier = if self_host_body_binary_is_comparison(operator) ||
                  operator is LogicalOr ||
                  operator is LogicalAnd {
                  I32BodyCarrier
                } else {
                  operand_carrier
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  current,
                  result_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  operand_carrier,
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  operand_carrier,
                ) {
                  changed = true
                }
              }
            }
            PlannedOperatorCall(
              _,
              operator,
              left,
              right,
              _,
            ) => if left >= body.expressions.start && left < expression_end {
              let left_carrier = expressions[
                self_host_body_expression_slot(body, left)
              ].carrier
              let result_carrier = match operator {
                LogicalOr => I32BodyCarrier
                LogicalAnd => I32BodyCarrier
                Equal => I32BodyCarrier
                NotEqual => I32BodyCarrier
                Less => I32BodyCarrier
                LessEqual => I32BodyCarrier
                Greater => I32BodyCarrier
                GreaterEqual => I32BodyCarrier
                _ => left_carrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                result_carrier,
              ) {
                changed = true
              }
              if right >= body.expressions.start && right < expression_end {
                let function_index = expressions[slot].call_function_index
                let left_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  0u32,
                )
                let right_expected = self_host_body_function_parameter_carrier(
                  link,
                  function_index,
                  1u32,
                )
                if !(left_expected is UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  left,
                  left_expected,
                ) {
                  changed = true
                }
                if !(right_expected is UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  right,
                  right_expected,
                ) {
                  changed = true
                }
                if left_expected is UnresolvedBodyCarrier &&
                  right_expected is UnresolvedBodyCarrier {
                  let right_carrier = expressions[
                    self_host_body_expression_slot(body, right)
                  ].carrier
                  let operand_carrier = if !(
                    right_carrier is UnresolvedBodyCarrier
                  ) {
                    right_carrier
                  } else if !(
                    left_carrier is UnresolvedBodyCarrier
                  ) {
                    left_carrier
                  } else {
                    expressions[slot].carrier
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    left,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                  if self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    right,
                    operand_carrier,
                  ) {
                    changed = true
                  }
                }
              }
            }
            PlannedDirectCall(_, _, arguments, _) => {
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                expressions[slot].call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                expressions[slot].call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
            }
            PlannedConstruct(_, fields, _), PlannedObjectNew(fields) => if self_host_body_force_constructor_field_carriers(
              link,
              module_,
              body,
              linked_function.specialization,
              expressions[slot],
              fields,
              expressions,
            ) {
              changed = true
            }
            PlannedUnresolvedCall(target, arguments) => {
              let call_function_index = expressions[slot].call_function_index
              if self_host_body_force_call_result(
                link,
                indexes,
                module_,
                body,
                current,
                call_function_index,
                expressions,
                local_by_initializer,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_body_force_call_arguments(
                link,
                module_,
                body,
                current,
                arguments,
                call_function_index,
                expressions,
                local_values,
                locals,
              ) {
                changed = true
              }
              if self_host_linked_is_unresolved_array_push(module_, current) &&
                self_host_u32_greater(arguments.length, 0u32) &&
                arguments.start < module_.expression_children.length() {
                let item = module_.expression_children[arguments.start]
                if item >= body.expressions.start && item < expression_end {
                  let item_shape = self_host_linked_unresolved_array_push_item_shape(
                    link,
                    module_,
                    body,
                    linked_function.specialization,
                    current,
                  )
                  let item_carrier = self_host_body_carrier_from_shape(item_shape)
                  if !(item_carrier is UnresolvedBodyCarrier) {
                    if self_host_body_plan_force_expression_carrier(
                      body,
                      expressions,
                      item,
                      item_carrier,
                    ) {
                      changed = true
                    }
                    match module_.expressions[item].kind {
                      PlannedLocalGet(local_id) => {
                        let local_slot = self_host_body_local_slot(
                          module_,
                          body,
                          local_id,
                        )
                        if local_slot < local_values.length() && self_host_body_plan_force_local_value(
                          local_values,
                          locals,
                          local_slot,
                          self_host_body_value_with_carrier(
                            local_values[local_slot],
                            item_carrier,
                          ),
                        ) {
                          changed = true
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
            }
            PlannedLocalGet(local_id) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 {
                if self_host_body_plan_force_local_value(
                  local_values,
                  locals,
                  local_slot,
                  self_host_body_value_with_carrier(
                    local_values[local_slot],
                    expressions[slot].carrier,
                  ),
                ) {
                  changed = true
                }
                if self_host_body_plan_force_expression_value(
                  body,
                  expressions,
                  current,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            PlannedLocalSet(local_id, value) => {
              let local_slot = self_host_body_local_slot(module_, body, local_id)
              if local_slot != 4294967295u32 && value >= body.expressions.start &&
                value < expression_end {
                let expected_carrier = local_values[local_slot].carrier
                if !(expected_carrier is UnresolvedBodyCarrier) && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  value,
                  expected_carrier,
                ) {
                  changed = true
                }
                let value_slot = self_host_body_expression_slot(body, value)
                if self_host_body_plan_set_local_value(
                  local_values,
                  locals,
                  local_slot,
                  expressions[value_slot].value,
                ) {
                  changed = true
                }
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  value,
                  local_values[local_slot],
                ) {
                  changed = true
                }
              }
            }
            PlannedBlockExpression(block) => if !self_host_body_expression_discards_result(link, module_, linked_function.specialization, current) {
              let tail = self_host_body_block_tail_expression(module_, block)
              if tail != 4294967295u32 && tail >= body.expressions.start &&
                tail < expression_end {
                if self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[self_host_body_expression_slot(body, tail)].value,
                ) {
                  changed = true
                }
              } else if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_block_carrier(module_, body, expressions, block),
              ) {
                changed = true
              }
            }
            PlannedIfExpression(
              condition,
              then_block,
              else_expression,
            ) => if module_.expressions[condition].flow.falls_through && !self_host_body_expression_discards_result(link, module_, linked_function.specialization, current) {
              let expected_carrier = expressions[slot].carrier
              if !(expected_carrier is UnresolvedBodyCarrier) {
                let then_tail = self_host_body_block_tail_expression(
                  module_,
                  then_block,
                )
                if then_tail != 4294967295u32 && then_tail >= body.expressions.start &&
                  then_tail < expression_end && self_host_body_plan_force_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected_carrier,
                ) {
                  changed = true
                }
                if else_expression >= body.expressions.start && else_expression < expression_end &&
                  self_host_body_plan_force_expression_carrier(
                    body,
                    expressions,
                    else_expression,
                    expected_carrier,
                  ) {
                  changed = true
                }
              }
              let then_carrier = self_host_body_block_carrier(
                module_,
                body,
                expressions,
                then_block,
              )
              let else_carrier = if else_expression >= body.expressions.start &&
                else_expression < expression_end {
                expressions[
                  self_host_body_expression_slot(body, else_expression)
                ].carrier
              } else {
                UnitBodyCarrier
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                self_host_body_merge_carrier(then_carrier, else_carrier),
              ) {
                changed = true
              }
              let then_value_expression = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_value_expression != 4294967295u32 &&
                then_value_expression >= body.expressions.start &&
                then_value_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, then_value_expression)
                  ].value,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_value(
                  body,
                  expressions,
                  current,
                  expressions[
                    self_host_body_expression_slot(body, else_expression)
                  ].value,
                ) {
                changed = true
              }
              let expected = expressions[slot].carrier
              let then_tail = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              if then_tail != 4294967295u32 &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  then_tail,
                  expected,
                ) {
                changed = true
              }
              if else_expression >= body.expressions.start &&
                else_expression < expression_end &&
                self_host_body_plan_set_expression_carrier(
                  body,
                  expressions,
                  else_expression,
                  expected,
                ) {
                changed = true
              }
            }
            PlannedMatchExpression(
              subject,
              arms,
            ) => if module_.expressions[subject].flow.falls_through {
              let raw_subject_value = if subject >= body.expressions.start &&
                subject < expression_end {
                expressions[self_host_body_expression_slot(body, subject)].value
              } else {
                self_host_body_physical_value(
                  indexes,
                  -1i32,
                  UnresolvedBodyCarrier,
                  0u64,
                )
              }
              let recovered_subject_owner = if self_host_u64_equal(
                raw_subject_value.nominal_owner,
                0u64,
              ) {
                self_host_linked_expression_nominal_declaration(
                  link,
                  module_,
                  body,
                  subject,
                )
              } else {
                raw_subject_value.nominal_owner
              }
              let subject_value = if !self_host_u64_equal(
                recovered_subject_owner,
                raw_subject_value.nominal_owner,
              ) {
                self_host_body_physical_value(
                  indexes,
                  raw_subject_value.logical_type,
                  raw_subject_value.carrier,
                  recovered_subject_owner,
                )
              } else {
                raw_subject_value
              }
              let subject_carrier = subject_value.carrier
              let expected_match_carrier = expressions[slot].carrier
              // Never is the identity for a join over branch completions.
              // Unknown here erased an all-diverging match on each visit;
              // its parent then restored Never and kept the queue alive.
              let mut merged = NeverBodyCarrier
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      let source_arm = self_host_planned_pattern_arm_identity(
                        module_.pattern_arms[arm_index],
                      )
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      if self_host_body_force_physical_pattern_payloads(
                        link,
                        indexes,
                        module_,
                        body,
                        source_arm.pattern,
                        subject_value.nominal_owner,
                        ErrorPlannedValueShape,
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                      let arm_body = source_arm.body
                      if arm_body >= body.expressions.start && arm_body < expression_end {
                        let original_arm_carrier = expressions[
                          self_host_body_expression_slot(body, arm_body)
                        ].carrier
                        if !(expected_match_carrier is UnresolvedBodyCarrier) && !(
                          original_arm_carrier is NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                        let arm_slot = self_host_body_expression_slot(
                          body,
                          arm_body,
                        )
                        merged = self_host_body_merge_carrier(
                          merged,
                          expressions[arm_slot].carrier,
                        )
                        if self_host_body_plan_set_expression_value(
                          body,
                          expressions,
                          current,
                          expressions[arm_slot].value,
                        ) {
                          changed = true
                        }
                        if !(expected_match_carrier is UnresolvedBodyCarrier) && !(
                          expressions[arm_slot].carrier is NeverBodyCarrier
                        ) && self_host_body_plan_force_expression_carrier(
                          body,
                          expressions,
                          arm_body,
                          expected_match_carrier,
                        ) {
                          changed = true
                        }
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_carrier(
                body,
                expressions,
                current,
                merged,
              ) {
                changed = true
              }
            }
            PlannedWhileExpression(
              loop_control,
              initial,
              arms,
            ) => if loop_control < control_states.length() &&
              initial >= body.expressions.start && initial < expression_end {
              let initial_value = expressions[
                self_host_body_expression_slot(body, initial)
              ].value
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                initial_value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                initial,
                control_state_values[loop_control],
              ) {
                changed = true
              }
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[slot].value,
              ) {
                changed = true
              }
              let mut arm = 0u32
              let _ = while arm {
                current_arm => if current_arm < arms.length {
                  let child = self_host_u32_add(arms.start, current_arm)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      if self_host_body_force_pattern_values(
                        link,
                        indexes,
                        module_,
                        body,
                        self_host_planned_pattern_arm_identity(
                          module_.pattern_arms[arm_index],
                        ).pattern,
                        control_state_values[loop_control],
                        local_values,
                        locals,
                      ) {
                        changed = true
                      }
                    }
                  }
                  continue current_arm + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                current,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            PlannedBreakExpression(
              loop_control,
              value,
            ) => if loop_control < control_results.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              if self_host_body_plan_set_local_value(
                control_result_values,
                control_results,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                control_result_values[loop_control],
              ) {
                changed = true
              }
            }
            PlannedContinueExpression(
              loop_control,
              value,
            ) => if loop_control < control_states.length() &&
              value >= body.expressions.start && value < expression_end {
              let value_slot = self_host_body_expression_slot(body, value)
              let boundary_value = match self_host_body_loop_initial_value(
                module_,
                body,
                expressions,
                loop_control,
              ) {
                Some(initial_value) => if !(
                  initial_value.carrier is UnresolvedBodyCarrier
                ) {
                  initial_value
                } else {
                  control_state_values[loop_control]
                }
                None => control_state_values[loop_control]
              }
              if self_host_body_plan_set_local_value(
                control_state_values,
                control_states,
                loop_control,
                expressions[value_slot].value,
              ) {
                changed = true
              }
              if self_host_body_plan_set_expression_value(
                body,
                expressions,
                value,
                boundary_value,
              ) {
                changed = true
              }
            }
            PlannedReturnExpression(value) => if value != 4294967295u32 &&
              value >= body.expressions.start && value < expression_end &&
              self_host_body_plan_force_expression_carrier(
                body,
                expressions,
                value,
                physical_result_carrier,
              ) {
              changed = true
            }
            _ => {
              let _ = slot
            }
          }
          break self_host_semantic_unit()
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_body_work_queue_finish(work, current_work_item, changed)
      continue self_host_body_work_queue_next(work)
    }
    None => break self_host_semantic_unit()
  }
  let analysis_converged = work.complete
  let stalled_work_item = 4294967295u32
  // Every transfer has now passed the post-fixed-point audit. Materialize the
  // call, scratch, and local recipes before final verification and freeze.
  let call_evaluations = []
  let call_operands = []
  let calls = self_host_body_build_physical_call_plans(
    link,
    module_,
    body,
    expressions,
    call_evaluations,
    call_operands,
  )
  self_host_body_build_string_pattern_calls(
    link, module_, body, linked_function.specialization,
    calls, call_evaluations, call_operands,
  )
  let scratches = self_host_body_empty_scratches()
  let mut scratch_plan_index = 0u32
  while scratch_plan_index {
    current => if current < expressions.length() {
      let expression_plan = self_host_body_physical_expression_at(
        expressions,
        current,
      )
      match module_.expressions[expression_plan.expression].kind {
        PlannedConstruct(_, fields, _), PlannedObjectNew(fields) => self_host_plan_constructor_scratches(
          module_, body, expression_plan.expression, fields, expressions, scratches,
        )
        PlannedBuiltinCall(name, _, _, _, _) => if name.equals(b"array_new") {
          self_host_plan_raw_array_temporary(module_, body, expression_plan.expression, expressions, scratches)
        }
        PlannedMatchExpression(subject, _) => {
          let value = if subject >= body.expressions.start && subject < expression_end {
            expressions[self_host_body_expression_slot(body, subject)].value
          } else {
            self_host_body_physical_value(
              indexes,
              -1i32,
              UnresolvedBodyCarrier,
              0u64,
            )
          }
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            self_host_body_marker_scratch_value(module_, body, expression_plan.expression, subject, value),
            "match subject",
          )
        }
        PlannedWhileExpression(loop_control, initial, _) => if loop_control < control_states.length() {
          let state_value = if module_.expressions[initial].flow.falls_through {
            control_state_values[loop_control]
          } else {
            expressions[self_host_body_expression_slot(body, initial)].value
          }
          self_host_body_add_scratch(
            scratches,
            expression_plan.expression,
            self_host_body_marker_scratch_value(module_, body, expression_plan.expression, initial, state_value),
            "loop state",
          )
        }
        PlannedFunctionValueCall(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            EqRefBodyCarrier,
          ),
          "function value",
        )
        PlannedProductField(_, _, _) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_marker_scratch_value(module_, body, expression_plan.expression, expression_plan.expression, expression_plan.value),
          "product projection",
        )
        PlannedArrayLiteral(_) => self_host_body_add_scratch(
          scratches,
          expression_plan.expression,
          self_host_body_value_with_carrier(
            expression_plan.value,
            EqRefBodyCarrier,
          ),
          "array literal",
        )
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result_carrier = physical_result_carrier
  let local_slots = []
  let mut physical_local_count = 0u32
  let parameter_offset = if self_host_u32_equal(lambda, 4294967295u32) {
    0u32
  } else {
    1u32
  }
  let mut logical_local = 0u32
  for value in local_values {
    let elided = module_.locals[body.locals.start + logical_local].elided
    logical_local = logical_local + 1u32
    if elided || value.carrier is UnitBodyCarrier || value.carrier is NeverBodyCarrier {
      local_slots.push(4294967295u32)
    } else {
      local_slots.push(parameter_offset + physical_local_count)
      physical_local_count = physical_local_count + 1u32
    }
  }
  let capture_cells = self_host_plan_owned_capture_cells(link, module_, body,
    linked_function.module_index, linked_function.specialization, lambda,
    local_values, local_slots, physical_local_count, scratches.length())
  let capture_accesses = self_host_plan_capture_accesses(link, module_, body,
    linked_function.module_index, linked_function.specialization, lambda)
  let plan = {
    converged: analysis_converged
    stalled_work_item: stalled_work_item
    module_index: linked_function.module_index
    module_id: module_.module_id
    declaration: linked_function.declaration
    body: body.body
    lambda: lambda
    physical_function_index: self_host_u32_add(
      linked_function.function_index,
      2u32,
    )
    specialization: linked_function.specialization
    specialization_key: self_host_body_specialization_key(
      link,
      linked_function.declaration,
      linked_function.specialization,
    )
    result: result
    result_carrier: result_carrier
    expressions: expressions
    local_values: local_values
    locals: locals
    local_slots: local_slots
    physical_local_count: physical_local_count
    control_state_values: control_state_values
    control_states: control_states
    control_result_values: control_result_values
    control_results: control_results
    scratches: scratches
    capture_cells: capture_cells
    capture_accesses: capture_accesses
    object_constructors: []
    object_constructor_operands: []
    variant_constructors: []
    variant_constructor_operands: []
    closure_constructions: []
    closure_construction_captures: []
    calls: calls
    call_evaluations: call_evaluations
    call_operands: call_operands
  }
  self_host_populate_object_constructors(link, module_, body, plan)
  self_host_build_variant_constructor_recipes(link, module_, body, plan, plan.variant_constructors, plan.variant_constructor_operands)
  self_host_build_closure_construction_recipes(link, module_, body, plan, plan.closure_constructions, plan.closure_construction_captures)
  plan
}

fn self_host_body_plan_expression(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
) -> Option<SelfHostPlannedPhysicalExpressionCarrier> {
  if self_host_u32_equal(plan.expressions.length(), 0u32) {
    return None
  }
  let first = self_host_body_physical_expression_at(plan.expressions, 0u32)
  if expression < first.expression {
    return None
  }
  let slot = expression - first.expression
  if slot >= plan.expressions.length() {
    return None
  }
  let source = self_host_body_physical_expression_at(plan.expressions, slot)
  if self_host_u32_equal(source.expression, expression) {
    Some(source)
  } else {
    None
  }
}

fn self_host_body_expression_kind_name(
  kind: SelfHostPlannedExpressionKind,
) -> String {
  match kind {
    PlannedPoisonExpression => "poison"
    PlannedDeadExpression => "dead"
    PlannedDeferredExpression => "deferred"
    PlannedConsumedExpression => "consumed"
    PlannedI8Const(_) => "i8.const"
    PlannedI16Const(_) => "i16.const"
    PlannedI32Const(_) => "i32.const"
    PlannedI64Const(_) => "i64.const"
    PlannedU8Const(_) => "u8.const"
    PlannedU16Const(_) => "u16.const"
    PlannedU32Const(_) => "u32.const"
    PlannedU64Const(_) => "u64.const"
    PlannedF32Const(_) => "f32.const"
    PlannedF64Const(_) => "f64.const"
    PlannedBoolConst(_) => "bool.const"
    PlannedStringConst(_) => "string.const"
    PlannedUnitConst => "unit.const"
    PlannedStringArrayConst(_) => "string-array.const"
    PlannedBytesConst(_) => "bytes.const"
    PlannedLocalGet(_) => "local.get"
    PlannedCaptureGet(_) => "capture.get"
    PlannedModuleValueGet(_) => "module.get"
    PlannedFunctionReference(_) => "function.reference"
    PlannedProductNew(_) => "product.new"
    PlannedEvaluationSequence(_) => "evaluation.sequence"
    PlannedArrayLiteral(_) => "array.literal"
    PlannedLambdaClosure(_) => "lambda.closure"
    PlannedObjectNew(_) => "object.new"
    PlannedConstruct(_, _, _) => "construct"
    PlannedBlockExpression(_) => "block"
    PlannedLocalSet(_, _) => "local.set"
    PlannedDirectCall(_, _, _, _) => "direct.call"
    PlannedBuiltinCall(_, _, _, _, _) => "builtin.call"
    PlannedUnresolvedCall(_, _) => "unresolved.call"
    PlannedFieldGet(_, _, _) => "field.get"
    PlannedUnresolvedField(_, _) => "unresolved.field"
    PlannedIfExpression(_, _, _) => "if"
    PlannedMatchExpression(_, _) => "match"
    PlannedWhileExpression(_, _, _) => "while"
    PlannedPrefixExpression(_, _) => "prefix"
    PlannedBinaryExpression(_, _, _) => "binary"
    PlannedOperatorCall(_, _, _, _, _) => "operator.call"
    PlannedReturnExpression(_) => "return"
    PlannedProductField(_, _, _) => "product.field"
    PlannedIndexGet(_, _, _) => "index.get"
    PlannedCaptureSet(_, _) => "capture.set"
    PlannedFieldSet(_, _, _) => "field.set"
    PlannedIndexSet(_, _, _, _) => "index.set"
    PlannedFunctionValueCall(_, _, _) => "function-value.call"
    PlannedBreakExpression(_, _) => "break"
    PlannedContinueExpression(_, _) => "continue"
  }
}

fn self_host_body_add_known_expression_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  source: SelfHostPlannedExpression,
  expression: U32,
  entity: U64,
  selected_owner: U64,
  reason: SelfHostPhysicalDiagnosticReason,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Some(callable) => callable.name
    None => b""
  }
  diagnostics.push({
    code: reason.code()
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: reason.description()
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: selected_owner
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  entity: U64,
  reason: SelfHostPhysicalDiagnosticReason,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let source = if expression < module_.expressions.length() {
    module_.expressions[expression]
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Some(callable) => callable.name
    None => b""
  }
  diagnostics.push({
    code: reason.code()
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: entity
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: reason.description()
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Some(value) => value.value.nominal_owner
      None => source.nominal
    }
    expected_owner: 0u64
    actual_owner: 0u64
    expected: expected
    actual: actual
  })
}

fn self_host_body_add_nominal_diagnostic(
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  expected_owner: U64,
  actual_owner: U64,
  reason: SelfHostPhysicalDiagnosticReason,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Unit {
  let source = if expression < module_.expressions.length() {
    self_host_planned_expression_identity(module_.expressions[expression])
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Some(callable) => callable.name
    None => b""
  }
  diagnostics.push({
    code: reason.code()
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: expected_owner
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: reason.description()
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Some(value) => value.value.nominal_owner
      None => source.nominal
    }
    expected_owner: expected_owner
    actual_owner: actual_owner
    expected: expected
    actual: actual
  })
}

fn self_host_verify_body_call_result(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  self_host_verify_body_raw_intrinsic(link, plan, module_, expression_plan, diagnostics)
  self_host_verify_body_raw_struct(link, plan, module_, expression_plan, diagnostics)
  self_host_verify_body_raw_ref_cast(link, plan, module_, expression_plan, diagnostics)
  if expression_plan.call_function_index == 4294967295u32 {
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    StructConstructionBasicExpressionSelection(_, _) => {
      return
    }
    VariantConstructionBasicExpressionSelection(_, _, _) => {
      return
    }
    _ => {}
  }
  let expected = self_host_body_function_result_carrier(
    link,
    expression_plan.call_function_index,
  )
  if expression_plan.carrier is NeverBodyCarrier && !module_.expressions[expression_plan.expression].flow.falls_through {
    match self_host_body_call_plan(plan, expression_plan.expression) {
      Some(call) => if !call.emits_call {
        // A diverging argument ends evaluation before the call instruction.
        return
      }
      _ => {}
    }
    let target = expression_plan.call_function_index
    if target < link.functions.length() && expected is UnitBodyCarrier {
      let function_ = self_host_planned_program_wasm_function_identity(link.functions[target])
      if self_host_u32_equal(function_.function_index, target) {
        match self_host_program_specialization_callable(link.fragments.specialization.lowering.modules[function_.module_index], function_.declaration) {
          Some(callable) => if callable.result_shape is NeverPlannedValueShape {
            // Both proofs are required: declared divergence and zero ABI results.
            return
          }
          _ => {}
        }
      }
    }
  }
  if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(expression_plan.call_function_index),
      CallResultMismatch,
      expected,
      expression_plan.carrier,
    )
  }
}

fn self_host_verify_body_call_arguments(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  arguments: SelfHostHirSpan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  match module_.expressions[expression_plan.expression].selection {
    StructConstructionBasicExpressionSelection(_, _) => {
      return
    }
    VariantConstructionBasicExpressionSelection(_, _, _) => {
      return
    }
    _ => {}
  }
  if expression_plan.call_function_index == 4294967295u32 {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      0u64,
      MissingCallTarget,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
    return
  }
  let physical_function = self_host_linked_physical_function_index(
    expression_plan.call_function_index,
  )
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    physical_function,
  )
  let call = match self_host_body_call_plan(plan, expression_plan.expression) {
    Some(value) => value
    None => {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        u32_into_u64(expression_plan.call_function_index),
        MissingCallOperandPlan,
        UnresolvedBodyCarrier,
        UnresolvedBodyCarrier,
      )
      return
    }
  }
  if !self_host_u32_equal(call.physical_function, physical_function) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(call.physical_function),
      CallTargetMismatch,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
    return
  }
  if !call.emits_call {
    return
  }
  if !self_host_u32_equal(parameter_count, call.operands.length) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(expression_plan.call_function_index),
      CallOperandCountMismatch,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
    return
  }
  let expected_receiver = self_host_body_call_receiver_expression(link, module_,
    expression_plan.expression, call.declaration,
  )
  if call.receiver_expression != expected_receiver {
    self_host_body_add_diagnostic(diagnostics, plan, module_, expression_plan.expression,
      u32_into_u64(call.receiver_expression), CallReceiverCountMismatch,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
    return
  }
  let expected_receiver_count = if expected_receiver == 4294967295u32 {
    0u32
  } else {
    match self_host_body_plan_expression(plan, expected_receiver) {
      Some(receiver) => if receiver.carrier is UnitBodyCarrier {
        0u32
      } else {
        1u32
      }
      None => 1u32
    }
  }
  let mut receiver_count = 0u32
  let mut operand = 0u32
  let _ = while operand {
    current => if current < call.operands.length {
      let operand_index = self_host_u32_add(call.operands.start, current)
      if operand_index >= plan.call_operands.length() {
        self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression_plan.expression,
          u32_into_u64(current),
          MissingCallOperandPlan,
          UnresolvedBodyCarrier,
          UnresolvedBodyCarrier,
        )
      } else {
        let source = plan.call_operands[operand_index]
        match source {
          ReceiverPhysicalOperand(_) => {
            receiver_count = self_host_u32_add(receiver_count, 1u32)
          }
          _ => {}
        }
        let argument_expression = self_host_body_call_operand_expression(source)
        let expected = self_host_body_carrier_from_shape(
          self_host_linked_physical_function_parameter_shape(
            link,
            physical_function,
            current,
          ),
        )
        match self_host_body_plan_expression(plan, argument_expression) {
          Some(actual) => if actual.carrier is UnitBodyCarrier ||
            actual.carrier is NeverBodyCarrier {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              argument_expression,
              u32_into_u64(current),
              ErasedCallOperand,
              expected,
              actual.carrier,
            )
          } else if (
            actual.carrier is UnresolvedBodyCarrier ||
              actual.carrier is ConflictingBodyCarrier ||
              expected is UnresolvedBodyCarrier ||
              expected is ConflictingBodyCarrier ||
              !self_host_body_carrier_equal(expected, actual.carrier)
          ) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              argument_expression,
              u32_into_u64(current),
              CallOperandCarrierMismatch,
              expected,
              actual.carrier,
            )
          }
          None => self_host_body_add_diagnostic(
            diagnostics,
            plan,
            module_,
            argument_expression,
            u32_into_u64(current),
            MissingCallOperandPlan,
            expected,
            UnresolvedBodyCarrier,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if !self_host_u32_equal(receiver_count, expected_receiver_count) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(receiver_count),
      CallReceiverCountMismatch,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
  }
  let _ = arguments
  let _ = body
}

fn self_host_body_embedded_targets(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Array<Bool> {
  let targets = []
  let mut slot = 0u32
  let _ = while slot {
    current => if current < body.expressions.length {
      targets.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let parent = self_host_u32_add(body.expressions.start, current)
      let target = match self_host_planned_expression_at(
        module_.expressions,
        parent,
      ).kind {
        PlannedDirectCall(_, value, _, _) => value
        PlannedBuiltinCall(_, _, value, _, _) => value
        PlannedFunctionValueCall(value, _, _) => value
        PlannedUnresolvedCall(value, _) => value
        PlannedConstruct(value, _, _) => value
        _ => 4294967295u32
      }
      if target >= body.expressions.start {
        if target < end {
          targets[target - body.expressions.start] = true
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  targets
}

fn self_host_body_physical_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = self_host_body_fragment_module(link, linked_type.module_index)
      let physical = self_host_body_physical_type(
        module_,
        linked_type.fragment_index,
      )
      return match physical.kind {
        PlannedWasmStructType(owner) => owner
        PlannedWasmEnumBaseType(owner) => owner
        PlannedWasmEnumSubtypeType(owner, _, _) => owner
        _ => 0u64
      }
    }
  }
  0u64
}

fn self_host_verify_body_field_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 ||
    expression_plan.selected_field_index == 4294967295u32 ||
    self_host_u64_equal(expression_plan.selected_field, 0u64) {
    if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        MissingPhysicalFieldIdentity,
        EqRefBodyCarrier,
        UnresolvedBodyCarrier,
      )
    }
    return
  }
  let expected_owner = self_host_body_physical_owner(
    link,
    expression_plan.selected_type_index,
  )
  let inferred_field = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      FieldBasicExpressionSelection(
        field,
        _,
        _,
      ) => field
      _ => 0u64
    }
  } else {
    0u64
  }
  let inferred_field_owner = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      FieldBasicExpressionSelection(
        _,
        _,
        owner,
      ) => owner
      _ => 0u64
    }
  } else {
    0u64
  }
  if !self_host_u64_equal(inferred_field, 0u64) && !self_host_u64_equal(
    inferred_field,
    expression_plan.selected_field,
  ) {
    // Physical field planning must keep the exact inference field identity.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      FieldSelectionMismatch,
      EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(inferred_field_owner, 0u64) && !self_host_u64_equal(
    inferred_field_owner,
    expected_owner,
  ) {
    // A physical field type must belong to the inference field declaration.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      FieldOwnerMismatch,
      EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  let declared_receiver_owner = if expression_plan.receiver_expression < module_.expressions.length() {
    self_host_linked_expression_nominal_declaration(
      link,
      module_,
      body,
      expression_plan.receiver_expression,
    )
  } else {
    0u64
  }
  if !self_host_u64_equal(declared_receiver_owner, 0u64) &&
    !self_host_u64_equal(declared_receiver_owner, expected_owner) {
    // Field selection must not replace the receiver's declared nominal owner.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      FieldReceiverOwnerMismatch,
      EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) && (
    !self_host_u64_equal(
      expression_plan.receiver_nominal_owner,
      expected_owner,
    ) || !self_host_u32_equal(
      expression_plan.receiver_physical_heap_type,
      expression_plan.selected_type_index,
    )
  ) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      FieldReceiverHeapMismatch,
      EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
  }
}

fn self_host_verify_body_constructor(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  fields: SelfHostHirSpan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 {
    match module_.expressions[expression_plan.expression].selection {
      StructConstructionBasicExpressionSelection(_, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        MissingConstructorType,
        EqRefBodyCarrier,
        UnresolvedBodyCarrier,
      )
      VariantConstructionBasicExpressionSelection(_, _, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        MissingConstructorType,
        EqRefBodyCarrier,
        UnresolvedBodyCarrier,
      )
      _ => {}
    }
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => match self_host_linked_variant_type_index(link, variant) {
      Some(expected_type) => if !self_host_u32_equal(
        expected_type,
        expression_plan.selected_type_index,
      ) {
        // A variant constructor must use the exact selected variant type.
        self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression_plan.expression,
          u32_into_u64(expected_type),
          ConstructorTypeMismatch,
          EqRefBodyCarrier,
          expression_plan.value.carrier,
        )
        return
      }
      None => {}
    }
    _ => {}
  }
  for linked_type in link.types {
    if self_host_u32_equal(
      linked_type.type_index,
      expression_plan.selected_type_index,
    ) {
      let physical_module = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        physical_module,
        linked_type.fragment_index,
      )
      let mut physical_offset = 0u32
      let _ = while physical_offset {
        current => if current < physical.fields.length {
          let destination = self_host_body_physical_field(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          let mut argument = 4294967295u32
          let mut exact_argument = false
          let mut source_offset = 0u32
          let _ = while source_offset {
            source => if source < fields.length {
              let object_index = self_host_u32_add(fields.start, source)
              if object_index < module_.object_fields.length() {
                let object_field = self_host_planned_object_field_identity(
                  module_.object_fields[object_index],
                )
                let exact_field = self_host_u64_equal(
                  object_field.field,
                  destination.declaration,
                )
                let named_field = self_host_u32_greater(
                  self_host_linked_module_name_count(module_),
                  object_field.name,
                ) && match self_host_linked_field_name(
                  link,
                  destination.declaration,
                ) {
                  Some(destination_name) => self_host_linked_module_name_at(
                    module_,
                    object_field.name,
                  ) == destination_name
                  None => false
                }
                if exact_field || named_field {
                  argument = object_field.value
                  exact_argument = exact_field
                }
              }
              continue source + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if argument == 4294967295u32 {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression_plan.expression,
              destination.declaration,
              MissingConstructorFieldIdentity,
              self_host_body_carrier_from_storage(destination.storage),
              UnresolvedBodyCarrier,
            )
          } else {
            match self_host_body_plan_expression(plan, argument) {
              Some(actual) => {
                let expected_carrier = self_host_body_carrier_from_storage(
                  destination.storage,
                )
                let boxed = self_host_linked_erased_field_box_type(link, destination.declaration, actual.value.carrier) is Some(_) ||
                  self_host_linked_erased_field_unit_storage(link, destination.declaration, destination.storage, actual.value.carrier)
                if exact_argument && !boxed && !self_host_body_carrier_equal(
                  expected_carrier,
                  actual.value.carrier,
                ) && !(actual.value.carrier is NeverBodyCarrier) && !(
                  actual.value.carrier is UnresolvedBodyCarrier
                ) {
                  self_host_body_add_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    destination.declaration,
                    ConstructorArgumentCarrierMismatch,
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
                let expected_owner = self_host_body_field_value_nominal_owner(
                  link,
                  destination.declaration,
                )
                if exact_argument && !self_host_u64_equal(expected_owner, 0u64) &&
                  !self_host_u64_equal(actual.value.nominal_owner, 0u64) &&
                  !self_host_u64_equal(
                    expected_owner,
                    actual.value.nominal_owner,
                  ) {
                  self_host_body_add_nominal_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    expected_owner,
                    actual.value.nominal_owner,
                    ConstructorArgumentOwnerMismatch,
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
              }
              None => self_host_body_add_diagnostic(
                diagnostics,
                plan,
                module_,
                argument,
                destination.declaration,
                MissingConstructorArgumentPlan,
                self_host_body_carrier_from_storage(destination.storage),
                UnresolvedBodyCarrier,
              )
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return
    }
  }
}

fn self_host_verify_body_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let expression_plan_count = array_length(plan.expressions)
  let mut expression_plan_index = 0u32
  let _ = while expression_plan_index {
    current_expression_plan => if current_expression_plan < expression_plan_count {
      let expression_plan = array_get_unchecked(
        plan.expressions,
        current_expression_plan,
      )
      match module_.expressions[expression_plan.expression].kind {
      PlannedMatchExpression(subject, arms) => match self_host_body_plan_expression(
        plan,
        subject,
      ) {
        Some(subject_plan) => {
          let mut arm_offset = 0u32
          let _ = while arm_offset {
            current_arm => if current_arm < arms.length {
              let child = self_host_u32_add(arms.start, current_arm)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let root_index = self_host_planned_pattern_arm_identity(
                    module_.pattern_arms[arm_index],
                  ).pattern
                  if root_index < module_.patterns.length() {
                    let root = self_host_planned_pattern_identity(
                      module_.patterns[root_index],
                    )
                    if root.selected_constructor is SelectedBasicPatternConstructor(
                      _,
                      _,
                      _,
                    ) {
                    match root.source {
                      TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root,
                        ErrorPlannedValueShape,
                        subject_plan.value.nominal_owner,
                      ) {
                        Some(type_index) => {
                          let mut field_index = 0u32
                          let _ = while field_index {
                            current_field => if current_field < children.length {
                              let pattern_child = self_host_u32_add(
                                children.start,
                                current_field,
                              )
                              if pattern_child < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[pattern_child]
                                if child_pattern_index < module_.patterns.length() {
                                  match module_.patterns[child_pattern_index].reference {
                                    PatternBindingReference(local_id) => if module_.patterns[
                                      child_pattern_index
                                    ].source is BindingPattern(_, _) {
                                      let slot = self_host_body_local_slot(
                                        module_,
                                        body,
                                        local_id,
                                      )
                                      if slot < plan.local_values.length() {
                                        let expected_carrier = self_host_body_pattern_field_carrier(
                                          link,
                                          module_,
                                          type_index,
                                          current_field,
                                          module_.patterns[child_pattern_index].type_,
                                        )
                                        let actual = plan.local_values[slot]
                                        let actual_carrier = if slot < plan.locals.length() {
                                          plan.locals[slot]
                                        } else {
                                          actual.carrier
                                        }
                                        if !(expected_carrier is UnresolvedBodyCarrier) &&
                                          !(actual_carrier is UnresolvedBodyCarrier) &&
                                          !self_host_body_carrier_equal(expected_carrier, actual_carrier) {
                                          self_host_body_add_diagnostic(
                                            diagnostics,
                                            plan,
                                            module_,
                                            subject,
                                            u32_into_u64(local_id),
                                            PatternPayloadCarrierMismatch,
                                            expected_carrier,
                                            actual_carrier,
                                          )
                                        }
                                        let expected_owner = self_host_linked_field_value_nominal_declaration(
                                          link,
                                          {
                                            type_index: type_index
                                            field_index: current_field
                                          },
                                        )
                                        let actual_owner = actual.nominal_owner
                                        if expected_carrier is EqRefBodyCarrier {
                                          if expected_owner != 0u64 && actual_owner != 0u64 {
                                            if expected_owner != actual_owner {
                                              self_host_body_add_nominal_diagnostic(
                                                diagnostics,
                                                plan,
                                                module_,
                                                subject,
                                                expected_owner,
                                                actual_owner,
                                                PatternPayloadOwnerMismatch,
                                                expected_carrier,
                                                actual_carrier,
                                              )
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_field + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        None => {}
                      }
                      _ => {}
                    }
                    }
                  }
                }
              }
              continue current_arm + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        None => {}
      }
        _ => {}
      }
      continue current_expression_plan + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_assert_physical_table_count(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expected: U32,
  actual: U32,
  table: U32,
) -> Unit {
  let _ = self_host_assert_compiler_invariant_with_failure(
    self_host_u32_equal(expected, actual),
    {
      code: 103u32
      phase: 6u32
      module_id: plan.module_id
      declaration: plan.declaration
      body: plan.body
      expression: 4294967295u32
      expected: u32_into_u64(expected)
      actual: u32_into_u64(actual)
      detail: u32_into_u64(table)
    },
    "physical table must contain every owned logical entry exactly once",
  )
}

fn self_host_verify_physical_body_tables(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
) -> Unit {
  // Repeat arena checks at the read boundary: a plan can outlive its producer.
  // Unit/elided locals still occupy logical entries; only their Wasm slots vanish.
  self_host_verify_lowered_body_children(module_, body, plan.lambda)
  self_host_assert_physical_table_count(plan, body.locals.length, plan.local_values.length(), 711u32)
  self_host_assert_physical_table_count(plan, body.locals.length, plan.locals.length(), 712u32)
  self_host_assert_physical_table_count(plan, body.expressions.length, plan.expressions.length(), 713u32)
  let mut control_count = 0u32
  let mut relative = 0u32
  for expression_plan in plan.expressions {
    let expression = expression_plan.expression
    // Membership precedes both subtraction and the source-array read. Length
    // alone cannot prove order or exclude a duplicated in-range expression ID.
    let slot = self_host_body_expression_slot(body, expression)
    let _ = self_host_assert_compiler_invariant_with_failure(
      self_host_u32_equal(slot, relative),
      {
        code: 106u32
        phase: 6u32
        module_id: plan.module_id
        declaration: plan.declaration
        body: plan.body
        expression: expression
        expected: u32_into_u64(body.expressions.start + relative)
        actual: u32_into_u64(expression)
        detail: 713u64
      },
      "physical expression table must preserve its owning source identity",
    )
    match module_.expressions[expression].kind {
      PlannedWhileExpression(control, _, _) => if control != 4294967295u32 && control >= control_count {
        control_count = control + 1u32
      }
      _ => {}
    }
    relative = relative + 1u32
  }
  self_host_assert_physical_table_count(plan, control_count, plan.control_states.length(), 714u32)
  self_host_assert_physical_table_count(plan, control_count, plan.control_state_values.length(), 715u32)
  self_host_assert_physical_table_count(plan, control_count, plan.control_results.length(), 716u32)
  self_host_assert_physical_table_count(plan, control_count, plan.control_result_values.length(), 717u32)
}

fn self_host_verify_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  self_host_assert_physical_table_count(plan, plan.local_values.length(), plan.local_slots.length(), 710u32)
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Some(value) => value
    None => {
      self_host_body_add_diagnostic(
        diagnostics, plan, module_, 4294967295u32, u32_into_u64(plan.lambda),
        MissingPhysicalBody, plan.result_carrier,
        UnresolvedBodyCarrier,
      )
      return
    }
  }
  self_host_verify_physical_body_tables(module_, body, plan)
  self_host_verify_owned_capture_cells(link, module_, body, plan)
  self_host_verify_capture_accesses(link, module_, body, plan)
  self_host_verify_object_constructors(link, module_, body, plan)
  self_host_verify_variant_constructors(link, module_, body, plan)
  let diagnostic_start = diagnostics.length()
  if !plan.converged {
    let stalled_expression = if plan.stalled_work_item == 4294967295u32 ||
      self_host_u32_equal(plan.stalled_work_item, 0u32) {
      body.expressions.start
    } else {
      self_host_u32_add(
        body.expressions.start,
        self_host_u32_subtract(plan.stalled_work_item, 1u32),
      )
    }
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      stalled_expression,
      u32_into_u64(plan.stalled_work_item),
      CarrierAnalysisDidNotConverge,
      UnresolvedBodyCarrier,
      UnresolvedBodyCarrier,
    )
    return
  }
  self_host_verify_body_pattern_payloads(
    link,
    plan,
    module_,
    body,
    diagnostics,
  )
  self_host_verify_body_string_pattern_calls(link, plan, module_, body, diagnostics)
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      let local = module_.locals[local_index]
      let expected_nominal = self_host_linked_loop_binding_nominal_declaration(
        link,
        module_,
        body,
        local.local_id,
      )
      let actual_nominal = plan.local_values[current].nominal_owner
      if !self_host_u64_equal(expected_nominal, 0u64) &&
        !self_host_u64_equal(actual_nominal, 0u64) &&
        !self_host_u64_equal(expected_nominal, actual_nominal) {
        // A loop binding must keep the nominal type of its container element.
        self_host_body_add_nominal_diagnostic(
          diagnostics,
          plan,
          module_,
          body.expressions.start,
          expected_nominal,
          actual_nominal,
          LoopBindingOwnerMismatch,
          EqRefBodyCarrier,
          plan.local_values[current].carrier,
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  for expression_plan in plan.expressions {
    let expression = expression_plan.expression
    let source = self_host_planned_expression_at(module_.expressions, expression)
    let embedded_target = if expression >= body.expressions.start {
      let relative = expression - body.expressions.start
      if relative < embedded_targets.length() {
        embedded_targets[relative]
      } else {
        false
      }
    } else {
      false
    }
    if !source.flow.falls_through {
      match source.kind {
        PlannedDirectCall(_, _, _, _) => if !(expression_plan.carrier is NeverBodyCarrier) {
          // A direct call with a physical result must not poison later flow.
          self_host_body_add_known_expression_diagnostic(
            diagnostics,
            plan,
            module_,
            source,
            expression,
            u32_into_u64(expression_plan.call_function_index),
            expression_plan.value.nominal_owner,
            IncorrectCallDivergence,
            expression_plan.carrier,
            NeverBodyCarrier,
          )
        }
        _ => {}
      }
    }
    if expression_plan.carrier is ConflictingBodyCarrier {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression,
        0u64,
        CarrierConflict,
        expression_plan.conflict_expected,
        expression_plan.conflict_actual,
      )
    }
    match source.kind {
      PlannedLocalGet(_) => {}
      PlannedFunctionReference(declaration) => {
        if expression_plan.call_function_index == 4294967295u32 ||
          !self_host_linked_function_declaration_module_matches(link, expression_plan.call_function_index, declaration) {
          self_host_body_add_diagnostic(
            diagnostics, plan, module_, expression, declaration, MissingCallTarget,
            EqRefBodyCarrier,
            UnresolvedBodyCarrier,
          )
        }
      }
      PlannedLambdaClosure(lambda) => {
        if !self_host_lambda_construction_target_matches(link, plan, expression_plan, lambda) {
          self_host_body_add_diagnostic(
            diagnostics, plan, module_, expression, plan.declaration, MissingCallTarget,
            EqRefBodyCarrier,
            UnresolvedBodyCarrier,
          )
        }
      }
      PlannedLocalSet(local_id, value) => {
        let slot = self_host_body_local_slot(module_, body, local_id)
        if slot < plan.local_values.length() {
          match self_host_body_plan_expression(plan, value) {
            Some(actual) => {
              let expected = plan.local_values[slot].carrier
              if !(expected is UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                actual.carrier is NeverBodyCarrier
              ) && !(actual.carrier is UnresolvedBodyCarrier) {
                self_host_body_add_diagnostic(
                  diagnostics,
                  plan,
                  module_,
                  value,
                  u32_into_u64(local_id),
                  LocalAssignmentCarrierMismatch,
                  expected,
                  actual.carrier,
                )
              }
            }
            None => {}
          }
        }
      }
      PlannedReturnExpression(value) => if value != 4294967295u32 {
        match self_host_body_plan_expression(plan, value) {
          Some(actual) => if !self_host_body_carrier_equal(
            plan.result_carrier,
            actual.carrier,
          ) && !(actual.carrier is NeverBodyCarrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              0u64,
              ReturnOperandMismatch,
              plan.result_carrier,
              actual.carrier,
            )
          }
          None => {}
        }
      }
      PlannedFieldGet(_, _, _) => {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
        match expression_plan.selected_storage {
        Some(storage) => {
          let expected = self_host_body_field_read_carrier(link, module_, plan.specialization, expression, expression_plan.selected_field, storage)
          if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              match source.kind {
                PlannedFieldGet(field, _, _) => field
                _ => u32_into_u64(expression_plan.selected_field_index)
              },
              FieldLoadCarrierMismatch,
              expected,
              expression_plan.carrier,
            )
          }
        }
        None => self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression,
          0u64,
          MissingFieldLoadIdentity,
          EqRefBodyCarrier,
          UnresolvedBodyCarrier,
        )
        }
      }
      PlannedUnresolvedField(_, _) => if !embedded_target {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
      }
      PlannedConstruct(_, fields, _), PlannedObjectNew(fields) => self_host_verify_body_constructor(
        link,
        plan,
        module_,
        body,
        expression_plan,
        fields,
        diagnostics,
      )
      PlannedDirectCall(_, _, arguments, _) => {
        self_host_verify_body_call_result(
          link,
          plan,
          module_,
          expression_plan,
          diagnostics,
        )
        self_host_verify_body_call_arguments(
          link,
          plan,
          module_,
          body,
          expression_plan,
          arguments,
          diagnostics,
        )
      }
      PlannedBuiltinCall(_, _, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      PlannedOperatorCall(_, _, _, _, _) => {
        self_host_verify_body_call_result(link, plan, module_, expression_plan, diagnostics)
        self_host_verify_body_call_arguments(link, plan, module_, body, expression_plan,
          {
            start: 0u32
            length: 0u32
          }, diagnostics,
        )
      }
      PlannedUnresolvedCall(_, arguments) => {
        self_host_verify_body_call_result(
          link,
          plan,
          module_,
          expression_plan,
          diagnostics,
        )
        self_host_verify_body_call_arguments(
          link,
          plan,
          module_,
          body,
          expression_plan,
          arguments,
          diagnostics,
        )
      }
      PlannedIndexGet(_, _, _) => {
        self_host_verify_body_call_result(link, plan, module_, expression_plan, diagnostics)
        self_host_verify_body_call_arguments(link, plan, module_, body, expression_plan,
          {
            start: 0u32
            length: 0u32
          }, diagnostics,
        )
      }
      PlannedIndexSet(_, _, _, _) => {
        self_host_verify_body_call_result(link, plan, module_, expression_plan, diagnostics)
        self_host_verify_body_call_arguments(link, plan, module_, body, expression_plan,
          {
            start: 0u32
            length: 0u32
          }, diagnostics,
        )
      }
      _ => {}
    }
  }
  let mut block_offset = 0u32
  let _ = while block_offset {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      let items = module_.blocks[block_index].items
      let mut item_offset = 0u32
      let _ = while item_offset {
        current_item => if current_item < items.length {
          let item = module_.block_items[
            self_host_u32_add(items.start, current_item)
          ]
          match item.kind {
            PlannedLetItem(
              local_id,
              _,
              initializer,
            ) => {
              let slot = self_host_body_local_slot(module_, body, local_id)
              match self_host_body_plan_expression(plan, initializer) {
                Some(actual) => if slot < plan.local_values.length() {
                  let expected = plan.local_values[slot].carrier
                  if !(expected is UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                    actual.carrier is NeverBodyCarrier
                  ) && !(actual.carrier is UnresolvedBodyCarrier) {
                    self_host_body_add_diagnostic(
                      diagnostics,
                      plan,
                      module_,
                      initializer,
                      u32_into_u64(local_id),
                      LocalInitializerCarrierMismatch,
                      expected,
                      actual.carrier,
                    )
                  }
                }
                None => {}
              }
            }
            _ => {}
          }
          continue current_item + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let root_carrier = match body.root {
    ExpressionBodyRoot(expression) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Some(value) => value.carrier
      None => UnresolvedBodyCarrier
    }
    BlockBodyRoot(block) => self_host_body_block_carrier(
      module_,
      body,
      plan.expressions,
      block,
    )
  }
  if !(plan.result_carrier is UnitBodyCarrier) &&
    !self_host_body_carrier_equal(plan.result_carrier, root_carrier) &&
    !(root_carrier is NeverBodyCarrier) &&
    !(root_carrier is UnresolvedBodyCarrier) &&
    !(root_carrier is ConflictingBodyCarrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      match body.root {
        ExpressionBodyRoot(expression) => expression
        BlockBodyRoot(_) => body.expressions.start
      },
      0u64,
      BodyResultMismatch,
      plan.result_carrier,
      root_carrier,
    )
  }
  if !(plan.result_carrier is UnitBodyCarrier) && (
    root_carrier is UnresolvedBodyCarrier ||
      root_carrier is ConflictingBodyCarrier
  ) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      match body.root {
        ExpressionBodyRoot(expression) => expression
        BlockBodyRoot(_) => body.expressions.start
      },
      0u64,
      MissingConcreteBodyRoot,
      plan.result_carrier,
      root_carrier,
    )
  }
  // Preserve source-body diagnostics, including BOD-607, before rebuilding
  // derived capture recipes. Those diagnostics prevent the plan from emitting.
  if diagnostics.length() == diagnostic_start {
    self_host_verify_closure_recipes(link, module_, body, plan)
  }
}

pub fn self_host_plan_program_wasm_bodies(
  link: SelfHostPlannedProgramWasmGCLink,
) -> SelfHostPlannedProgramWasmBodyPlan {
  self_host_verify_link_records(link)
  let indexes = self_host_build_physical_body_indexes(link)
  let bodies = []
  let diagnostics = []
  for function_ in link.functions {
    let fragment_module = self_host_body_fragment_module(
      link,
      function_.module_index,
    )
    let fragment = self_host_body_function_fragment(
      fragment_module,
      function_.fragment_index,
    )
    let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, function_.module_index, function_.specialization)
    let (body, lambda) = match fragment.kind {
      PlannedWasmDefinedFunction(body_id) => match self_host_body_lookup(
        module_,
        body_id,
      ) {
        Some(value) => (Some(value), 4294967295u32)
        None => (
          self_host_body_require_linked_source(None, function_, body_id),
          4294967295u32,
        )
      }
      PlannedWasmDefinedLambdaFunction(
        lambda_id,
      ) => (
        self_host_body_require_linked_source(
          self_host_body_lambda_lookup(module_, lambda_id), function_, function_.declaration,
        ),
        lambda_id,
      )
      _ => (None, 4294967295u32)
    }
    match body {
      Some(value) => {
        let plan = self_host_plan_one_physical_body(
          link,
          indexes,
          function_,
          value,
          lambda,
        )
        self_host_verify_one_physical_body(link, plan, diagnostics)
        bodies.push(plan)
      }
      None => {}
    }
  }
  self_host_plan_initializer_bodies(link, indexes, bodies, diagnostics)
  {
    bodies: bodies
    frozen_bodies: self_host_freeze_physical_bodies(bodies)
    diagnostics: diagnostics
  }
}

pub fn self_host_body_plan_pattern_payload_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  if pattern >= module_.patterns.length() {
    return None
  }
  match module_.patterns[pattern].source {
    TuplePattern(_, children, _) => if self_host_u32_greater(
      children.length,
      0u32,
    ) && children.start < module_.pattern_children.length() {
      let child = module_.pattern_children[children.start]
      if child < module_.patterns.length() {
        match module_.patterns[child].reference {
          PatternBindingReference(local_id) => {
            let slot = self_host_body_local_slot(module_, body, local_id)
            if slot < plan.local_values.length() {
              return Some(plan.local_values[slot])
            }
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  None
}

pub fn self_host_body_plan_scratch_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
  ordinal: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  for scratch in plan.scratches {
    if self_host_u32_equal(scratch.expression, expression) &&
      self_host_u32_equal(scratch.ordinal, ordinal) {
      return Some(scratch.value)
    }
  }
  None
}

pub fn self_host_body_carrier_shape(
  carrier: SelfHostWasmBodyCarrier,
) -> SelfHostPlannedValueShape {
  match carrier {
    UnitBodyCarrier => UnitPlannedValueShape
    NeverBodyCarrier => NeverPlannedValueShape
    I32BodyCarrier => I32PlannedValueShape
    I64BodyCarrier => I64PlannedValueShape
    F32BodyCarrier => F32PlannedValueShape
    F64BodyCarrier => F64PlannedValueShape
    V128BodyCarrier => V128PlannedValueShape
    EqRefBodyCarrier => RefPlannedValueShape
    FuncRefBodyCarrier => RefPlannedValueShape
    ConflictingBodyCarrier => ErrorPlannedValueShape
    UnresolvedBodyCarrier => ErrorPlannedValueShape
  }
}

// Stable crash-record encoding, independent of enum layout.
fn self_host_body_carrier_code(carrier: SelfHostWasmBodyCarrier) -> U64 {
  match carrier {
    UnresolvedBodyCarrier => 0u64
    ConflictingBodyCarrier => 1u64
    UnitBodyCarrier => 2u64
    NeverBodyCarrier => 3u64
    I32BodyCarrier => 4u64
    I64BodyCarrier => 5u64
    F32BodyCarrier => 6u64
    F64BodyCarrier => 7u64
    V128BodyCarrier => 8u64
    EqRefBodyCarrier => 9u64
    FuncRefBodyCarrier => 10u64
  }
}

fn self_host_body_carrier_name(carrier: SelfHostWasmBodyCarrier) -> String {
  match carrier {
    UnresolvedBodyCarrier => "unresolved"
    ConflictingBodyCarrier => "conflict"
    UnitBodyCarrier => "unit"
    NeverBodyCarrier => "never"
    I32BodyCarrier => "i32"
    I64BodyCarrier => "i64"
    F32BodyCarrier => "f32"
    F64BodyCarrier => "f64"
    V128BodyCarrier => "v128"
    EqRefBodyCarrier => "eqref"
    FuncRefBodyCarrier => "funcref"
  }
}

pub fn self_host_program_wasm_body_plan_error_report(
  plan: SelfHostPlannedProgramWasmBodyPlan,
) -> String {
  let output = StringBuilder::new()
  output.append("physical body carrier verifier: ")
  output.append_u32(plan.diagnostics.length())
  output.append(" error(s)")
  for diagnostic in plan.diagnostics {
    output.append("\ncode=")
    output.append_u32(diagnostic.code)
    output.append(" module=")
    output.append_u64(diagnostic.module_id)
    output.append(" declaration=")
    output.append_u64(diagnostic.declaration)
    output.append(" name=")
    output.append(bytes_to_string(diagnostic.declaration_name))
    output.append(" body=")
    output.append_u64(diagnostic.body)
    output.append(" lambda=")
    output.append_u32(diagnostic.lambda)
    output.append(" function=")
    output.append_u32(diagnostic.physical_function_index)
    output.append(" specialization=")
    output.append(diagnostic.specialization_key)
    output.append(" expression=")
    output.append_u32(diagnostic.expression)
    output.append(" entity=")
    output.append_u64(diagnostic.entity)
    output.append(" offset=")
    output.append_u32(diagnostic.source_offset)
    output.append(" kind=")
    output.append(diagnostic.expression_kind)
    output.append(" source_name=")
    output.append(diagnostic.source_name)
    output.append(" context=")
    output.append(diagnostic.context)
    output.append(" logical_type=")
    output.append_i32(diagnostic.logical_type)
    output.append(" selected_owner=")
    output.append_u64(diagnostic.selected_owner)
    output.append(" expected_owner=")
    output.append_u64(diagnostic.expected_owner)
    output.append(" actual_owner=")
    output.append_u64(diagnostic.actual_owner)
    output.append(" expected=")
    output.append(self_host_body_carrier_name(diagnostic.expected))
    output.append(" actual=")
    output.append(self_host_body_carrier_name(diagnostic.actual))
  }
  output.finish()
}

pub fn self_host_program_wasm_body_plan_for_identity(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  module_id: U64,
  body_id: U64,
  specialization: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u64_equal(body.module_id, module_id) &&
      self_host_u64_equal(body.body, body_id) &&
      self_host_u32_equal(body.specialization, specialization) {
      return Some(body)
    }
  }
  None
}

pub fn self_host_program_wasm_body_plan_for_function(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  physical_function_index: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u32_equal(
      body.physical_function_index,
      physical_function_index,
    ) {
      return Some(body)
    }
  }
  None
}

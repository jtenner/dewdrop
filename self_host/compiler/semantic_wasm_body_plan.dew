}

fn self_host_body_force_physical_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  subject_owner: U64,
  payload_hint: SelfHostPlannedValueShape,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if root >= module_.patterns.length() {
    return false
  }
  let root_type = match self_host_linked_pattern_variant_type(
    link,
    module_,
    module_.patterns[root],
    payload_hint,
    subject_owner,
  ) {
    Option::Some(value) => value
    Option::None => return false
  }
  let patterns = [root]
  let physical_types = [root_type]
  let mut changed = false
  let _ = while patterns.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let pattern_index = match self_host_array_pop(patterns) {
        Option::Some(value) => value
        Option::None => 4294967295u32
      }
      let type_index = match self_host_array_pop(physical_types) {
        Option::Some(value) => value
        Option::None => 4294967295u32
      }
      if pattern_index < module_.patterns.length() && type_index != 4294967295u32 {
        let pattern = self_host_planned_pattern_identity(
          module_.patterns[pattern_index],
        )
        match pattern.source {
          SelfHostHirPattern::TuplePattern(_, children, _) => {
            let mut field_index = 0u32
            let _ = while field_index {
              current => if current < children.length {
                let child_offset = self_host_u32_add(children.start, current)
                if child_offset < module_.pattern_children.length() {
                  let child_index = module_.pattern_children[child_offset]
                  if child_index < module_.patterns.length() {
                    let child = self_host_planned_pattern_identity(
                      module_.patterns[child_index],
                    )
                    let carrier = self_host_body_physical_field_carrier(
                      link,
                      type_index,
                      current,
                    )
                    let owner = self_host_linked_field_value_nominal_declaration(
                      link,
                      SelfHostLinkedWasmFieldLink::{
                        type_index: type_index
                        field_index: current
                      },
                    )
                    let value = self_host_body_physical_value(
                      indexes,
                      child.type_,
                      carrier,
                      owner,
                    )
                    match child.reference {
                      SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
                        let slot = self_host_body_local_slot(module_, body, local_id)
                        if slot != 4294967295u32 && self_host_body_plan_force_local_value(
                          local_values,
                          locals,
                          slot,
                          value,
                        ) {
                          changed = true
                        }
                      }
                      _ => {}
                    }
                    match child.source {
                      SelfHostHirPattern::TuplePattern(_, _, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        child,
                        SelfHostPlannedValueShape::ErrorPlannedValueShape,
                        owner,
                      ) {
                        Option::Some(child_type) => {
                          patterns.push(child_index)
                          physical_types.push(child_type)
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                }
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue patterns.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  changed
}

fn self_host_body_seed_match_payload_binding(
  link: SelfHostPlannedProgramWasmGCLink,
  indexes: SelfHostPhysicalBodyIndexes,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern_index: U32,
  subject_expression: U32,
  subject_type: I32,
  subject_function: U32,
  caller_specialization: U32,
  local_values: Array<SelfHostPlannedPhysicalValueInfo>,
  locals: Array<SelfHostWasmBodyCarrier>,
) -> Bool {
  if pattern_index >= module_.patterns.length() {
    return false
  }
  let pattern = self_host_planned_pattern_identity(
    module_.patterns[pattern_index],
  )
  let mut target = 0u32
  let mut children = SelfHostHirSpan::{
    start: 0u32
    length: 0u32
  }
  match pattern.source {
    SelfHostHirPattern::TuplePattern(value, values, _) => {
      target = value
      children = values
    }
    _ => return false
  }
  if self_host_u32_equal(children.length, 0u32) ||
    children.start >= module_.pattern_children.length() {
    return false
  }
  let _ = target
  let name = self_host_linked_pattern_name(module_, pattern)
  let argument = if name == "Err" {
    1u32
  } else if name == "Some" || name == "Ok" {
    0u32
  } else {
    return false
  }
  let mut shape = self_host_linked_type_argument_shape(
    module_,
    subject_type,
    argument,
  )
  let mut owner = self_host_body_type_argument_nominal_owner(
    module_,
    subject_type,
    argument,
  )
  if subject_function != 4294967295u32 {
    for function_ in link.functions {
      if self_host_u32_equal(function_.function_index, subject_function) {
        let function_module = link.fragments.specialization.lowering.modules[
          function_.module_index
        ]
        match self_host_program_specialization_callable(
          function_module,
          function_.declaration,
        ) {
          Option::Some(callable) => {
            let result_owner = self_host_body_resolved_type_argument_nominal_owner(
              function_module,
              callable.result_type,
              argument,
            )
            if !self_host_u64_equal(result_owner, 0u64) {
              owner = result_owner
            }
            match self_host_linked_resolved_type_argument_shape(
              function_module,
              callable.result_type,
              argument,
            ) {
              Option::Some(result_shape) => {
                shape = Option::Some(result_shape)
              }
              Option::None => {}
            }
          }
          Option::None => {}
        }
      }
    }
  }
  if self_host_u32_equal(argument, 0u32) {
    if subject_function != 4294967295u32 {
      let physical_function = self_host_linked_physical_function_index(
        subject_function,
      )
      let physical_name = self_host_linked_physical_function_name(
        link,
        physical_function,
      )
      if physical_name.ends_with(b"get") {
        let specialization_shape = self_host_linked_physical_function_specialization_shape_at(
          link,
          physical_function,
          1u32,
        )
        if !(specialization_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          shape = Option::Some(specialization_shape)
        }
      }
    }
    match self_host_linked_exact_map_get_value_shape(
      link,
      module_,
      body,
      caller_specialization,
      subject_expression,
    ) {
      Option::Some(value_shape) => {
        shape = Option::Some(value_shape)
      }
      Option::None => match self_host_linked_map_get_value_shape(
      link,
      module_,
      body,
      subject_expression,
    ) {
      Option::Some(value_shape) => {
        shape = Option::Some(value_shape)
      }
      Option::None => match self_host_linked_match_subject_receiver_element_shape(
        link,
        module_,
        body,
        subject_expression,
      ) {
        Option::Some(value_shape) => {
          shape = Option::Some(value_shape)
        }
        Option::None => {}
      }
    }
    }
    let container_element_owner = self_host_linked_expression_container_element_nominal_declaration(
      link,
      module_,
      body,
      subject_expression,
    )
    if !self_host_u64_equal(container_element_owner, 0u64) {
      owner = container_element_owner
    }
  }
  if (self_host_u64_equal(owner, 0u64) || shape is Option::None) &&
    subject_expression < module_.expressions.length() {
    let declaration = match module_.expressions[subject_expression].kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(value, _, _, _) => value
      SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, value, _, _, _) => value
      SelfHostPlannedExpressionKind::PlannedOperatorCall(value, _, _, _, _) => value
      _ => match module_.expressions[subject_expression].call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
        _ => 0u64
      }
    }
    match link.fragments.specialization.lowering.index.declaration_owner(
      declaration,
    ) {
      Option::Some(module_index) => if module_index < link.fragments.specialization.lowering.modules.length() {
        let declaration_module = link.fragments.specialization.lowering.modules[
          module_index
        ]
        match self_host_program_specialization_callable(
          declaration_module,
          declaration,
        ) {
          Option::Some(callable) => {
            let result_owner = self_host_body_resolved_type_argument_nominal_owner(
              declaration_module,
              callable.result_type,
              argument,
            )
            if !self_host_u64_equal(result_owner, 0u64) {
              owner = result_owner
            }
            match self_host_linked_resolved_type_argument_shape(
              declaration_module,
              callable.result_type,
              argument,
            ) {
              Option::Some(result_shape) => {
                shape = Option::Some(result_shape)
              }
              Option::None => {}
            }
          }
          Option::None => {}
        }
      }
      Option::None => {}
    }
  }
  if self_host_u32_equal(argument, 0u32) && subject_function != 4294967295u32 {
    let physical_function = self_host_linked_physical_function_index(
      subject_function,
    )
    let physical_name = self_host_linked_physical_function_name(
      link,
      physical_function,
    )
    if physical_name.ends_with(b"get") {
      let specialization_shape = self_host_linked_physical_function_specialization_shape_at(
        link,
        physical_function,
        1u32,
      )
      if !(specialization_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
        shape = Option::Some(specialization_shape)
      }
    }
  }
  let declared_child_shape = if children.start < module_.pattern_children.length() {
    let child_index = module_.pattern_children[children.start]
    if child_index < module_.patterns.length() {
      module_.patterns[child_index].shape
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
  } else {
    SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let payload_shape = if (name == "Some" || name == "Ok" || name == "Err") && !(
    declared_child_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
  ) {
    declared_child_shape
  } else {
    match shape {
      Option::Some(value) => value
      Option::None => if !self_host_u64_equal(owner, 0u64) {
        SelfHostPlannedValueShape::RefPlannedValueShape
      } else {
        return false
      }
    }
  }
  let mut changed = false
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() {
        let local_id = module_.locals[local_index].local_id
        if self_host_linked_pattern_binds_local(
          module_,
          pattern_index,
          local_id,
        ) && current < local_values.length() && self_host_body_plan_force_local_value(
          local_values,
          locals,
          current,
          SelfHostPlannedPhysicalValueInfo::{
            logical_type: local_values[current].logical_type
            carrier: self_host_body_carrier_from_shape(payload_shape)
            nominal_owner: owner
            physical_heap_type: self_host_body_physical_heap_type(indexes, owner)
          },
        ) {
          changed = true
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  changed
}

fn self_host_body_add_scratch(
  scratches: Array<SelfHostPlannedPhysicalScratchCarrier>,

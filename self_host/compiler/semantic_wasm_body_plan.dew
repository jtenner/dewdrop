) -> Unit {
  let source = if expression < module_.expressions.length() {
    self_host_planned_expression_identity(module_.expressions[expression])
  } else {
    self_host_lowering_error_expression()
  }
  let declaration_name = match self_host_program_specialization_callable(
    module_,
    plan.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
  diagnostics.push(SelfHostPhysicalCarrierDiagnostic::{
    code: self_host_body_diagnostic_code(context)
    module_id: plan.module_id
    declaration: plan.declaration
    declaration_name: declaration_name
    body: plan.body
    lambda: plan.lambda
    physical_function_index: plan.physical_function_index
    specialization: plan.specialization
    specialization_key: plan.specialization_key
    expression: expression
    entity: expected_owner
    source_offset: source.offset
    expression_kind: self_host_body_expression_kind_name(source.kind)
    source_name: if self_host_u32_greater(
      module_.names.length(),
      source.source_name,
    ) {
      module_.names[source.source_name]
    } else {
      ""
    }
    context: context
    logical_type: source.type_
    logical_shape: source.shape
    selected_owner: match self_host_body_plan_expression(plan, expression) {
      Option::Some(value) => value.value.nominal_owner
      Option::None => source.nominal
    }
    expected_owner: expected_owner
    actual_owner: actual_owner
    expected: expected
    actual: actual
  })
}

fn self_host_verify_body_call_result(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  self_host_verify_body_raw_intrinsic(link, plan, module_, expression_plan, diagnostics)
  if expression_plan.call_function_index == 4294967295u32 {
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _) => {
      return
    }
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => {
      return
    }
    _ => {}
  }
  let expected = self_host_body_function_result_carrier(
    link,
    expression_plan.call_function_index,
  )
  if expression_plan.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier && !module_.expressions[expression_plan.expression].flow.falls_through {
    match self_host_body_call_plan(plan, expression_plan.expression) {
      Option::Some(call) => if !call.emits_call {
        // A diverging argument ends evaluation before the call instruction.
        return
      }
      _ => {}
    }
    let target = expression_plan.call_function_index
    if target < link.functions.length() && expected is SelfHostWasmBodyCarrier::UnitBodyCarrier {
      let function_ = self_host_planned_program_wasm_function_identity(link.functions[target])
      if self_host_u32_equal(function_.function_index, target) {
        match self_host_program_specialization_callable(link.fragments.specialization.lowering.modules[function_.module_index], function_.declaration) {
          Option::Some(callable) => if callable.result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
            // Both proofs are required: declared divergence and zero ABI results.
            return
          }
          _ => {}
        }
      }
    }
  }
  if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(expression_plan.call_function_index),
      "call result",
      expected,
      expression_plan.carrier,
    )
  }
}

fn self_host_verify_body_call_arguments(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  arguments: SelfHostHirSpan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  match module_.expressions[expression_plan.expression].selection {
    SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _) => {
      return
    }
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => {
      return
    }
    _ => {}
  }
  if expression_plan.call_function_index == 4294967295u32 {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      0u64,
      "call target is missing",
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    )
    return
  }
  let physical_function = self_host_linked_physical_function_index(
    expression_plan.call_function_index,
  )
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    physical_function,
  )
  let call = match self_host_body_call_plan(plan, expression_plan.expression) {
    Option::Some(value) => value
    Option::None => {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        u32_into_u64(expression_plan.call_function_index),
        "call argument has no physical value plan",
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      return
    }
  }
  if !self_host_u32_equal(call.physical_function, physical_function) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(call.physical_function),
      "planned and emitted call target differ",
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    )
    return
  }
  if !call.emits_call {
    return
  }
  if !self_host_u32_equal(parameter_count, call.operands.length) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(expression_plan.call_function_index),
      "call argument count mismatch",
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    )
    return
  }
  let expected_receiver_count = if self_host_linked_declaration_has_receiver(
    link,
    call.declaration,
  ) {
    1u32
  } else {
    0u32
  }
  let mut receiver_count = 0u32
  let mut operand = 0u32
  let _ = while operand {
    current => if current < call.operands.length {
      let operand_index = self_host_u32_add(call.operands.start, current)
      if operand_index >= plan.call_operands.length() {
        self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression_plan.expression,
          u32_into_u64(current),
          "call argument has no physical value plan",
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
        )
      } else {
        let source = plan.call_operands[operand_index]
        match source {
          SelfHostPhysicalOperandSource::ReceiverPhysicalOperand(_) => {
            receiver_count = self_host_u32_add(receiver_count, 1u32)
          }
          _ => {}
        }
        let argument_expression = self_host_body_call_operand_expression(source)
        let expected = self_host_body_carrier_from_shape(
          self_host_linked_physical_function_parameter_shape(
            link,
            physical_function,
            current,
          ),
        )
        match self_host_body_plan_expression(plan, argument_expression) {
          Option::Some(actual) => if actual.carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
            actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              argument_expression,
              u32_into_u64(current),
              "erased call value became an operand",
              expected,
              actual.carrier,
            )
          } else if (
            actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
              actual.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier ||
              expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
              expected is SelfHostWasmBodyCarrier::ConflictingBodyCarrier ||
              !self_host_body_carrier_equal(expected, actual.carrier)
          ) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              argument_expression,
              u32_into_u64(current),
              "call argument carrier mismatch",
              expected,
              actual.carrier,
            )
          }
          Option::None => self_host_body_add_diagnostic(
            diagnostics,
            plan,
            module_,
            argument_expression,
            u32_into_u64(current),
            "call argument has no physical value plan",
            expected,
            SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if !self_host_u32_equal(receiver_count, expected_receiver_count) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      u32_into_u64(receiver_count),
      "call receiver count mismatch",
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    )
  }
  let _ = arguments
  let _ = body
}

fn self_host_body_embedded_targets(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Array<Bool> {
  let targets = []
  let mut slot = 0u32
  let _ = while slot {
    current => if current < body.expressions.length {
      targets.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let parent = self_host_u32_add(body.expressions.start, current)
      let target = match self_host_planned_expression_at(
        module_.expressions,
        parent,
      ).kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
        SelfHostPlannedExpressionKind::PlannedConstruct(value, _, _) => value
        _ => 4294967295u32
      }
      if target >= body.expressions.start {
        if target < end {
          targets[target - body.expressions.start] = true
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  targets
}

fn self_host_body_physical_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = self_host_body_fragment_module(link, linked_type.module_index)
      let physical = self_host_body_physical_type(
        module_,
        linked_type.fragment_index,
      )
      return match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(owner) => owner
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(owner) => owner
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(owner, _, _) => owner
        _ => 0u64
      }
    }
  }
  0u64
}

fn self_host_verify_body_field_owner(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 ||
    expression_plan.selected_field_index == 4294967295u32 ||
    self_host_u64_equal(expression_plan.selected_field, 0u64) {
    if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "field access has no exact physical field identity",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
    }
    return
  }
  let expected_owner = self_host_body_physical_owner(
    link,
    expression_plan.selected_type_index,
  )
  let inferred_field = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        field,
        _,
        _,
      ) => field
      _ => 0u64
    }
  } else {
    0u64
  }
  let inferred_field_owner = if expression_plan.expression < module_.expressions.length() {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        _,
        _,
        owner,
      ) => owner
      _ => 0u64
    }
  } else {
    0u64
  }
  if !self_host_u64_equal(inferred_field, 0u64) && !self_host_u64_equal(
    inferred_field,
    expression_plan.selected_field,
  ) {
    // Physical field planning must keep the exact inference field identity.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field physical identity differs from inference selection",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(inferred_field_owner, 0u64) && !self_host_u64_equal(
    inferred_field_owner,
    expected_owner,
  ) {
    // A physical field type must belong to the inference field declaration.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field physical owner differs from declared field owner",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  let declared_receiver_owner = if expression_plan.receiver_expression < module_.expressions.length() {
    self_host_linked_expression_nominal_declaration(
      link,
      module_,
      body,
      expression_plan.receiver_expression,
    )
  } else {
    0u64
  }
  if !self_host_u64_equal(declared_receiver_owner, 0u64) &&
    !self_host_u64_equal(declared_receiver_owner, expected_owner) {
    // Field selection must not replace the receiver's declared nominal owner.
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field target owner does not match receiver type",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
    return
  }
  if !self_host_u64_equal(expression_plan.receiver_nominal_owner, 0u64) && (
    !self_host_u64_equal(
      expression_plan.receiver_nominal_owner,
      expected_owner,
    ) || !self_host_u32_equal(
      expression_plan.receiver_physical_heap_type,
      expression_plan.selected_type_index,
    )
  ) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      expression_plan.expression,
      expression_plan.selected_field,
      "field receiver nominal owner or physical heap type mismatch",
      SelfHostWasmBodyCarrier::EqRefBodyCarrier,
      expression_plan.value.carrier,
    )
  }
}

fn self_host_verify_body_constructor(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_plan: SelfHostPlannedPhysicalExpressionCarrier,
  fields: SelfHostHirSpan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  if expression_plan.selected_type_index == 4294967295u32 {
    match module_.expressions[expression_plan.expression].selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "constructor has no exact physical destination type",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression_plan.expression,
        0u64,
        "constructor has no exact physical destination type",
        SelfHostWasmBodyCarrier::EqRefBodyCarrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      _ => {}
    }
    return
  }
  match module_.expressions[expression_plan.expression].selection {
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => match self_host_linked_expression_variant_type(
      link,
      Option::Some(plan),
      module_,
      body,
      plan.specialization,
      module_.expressions[expression_plan.expression],
      variant,
      fields,
    ) {
      Option::Some(expected_type) => if !self_host_u32_equal(
        expected_type,
        expression_plan.selected_type_index,
      ) {
        // A variant constructor must use the exact selected variant type.
        self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression_plan.expression,
          u32_into_u64(expected_type),
          "constructor selected physical type mismatch",
          SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          expression_plan.value.carrier,
        )
        return
      }
      Option::None => {}
    }
    _ => {}
  }
  for linked_type in link.types {
    if self_host_u32_equal(
      linked_type.type_index,
      expression_plan.selected_type_index,
    ) {
      let physical_module = self_host_body_fragment_module(
        link,
        linked_type.module_index,
      )
      let physical = self_host_body_physical_type(
        physical_module,
        linked_type.fragment_index,
      )
      let mut physical_offset = 0u32
      let _ = while physical_offset {
        current => if current < physical.fields.length {
          let destination = self_host_body_physical_field(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          let mut argument = 4294967295u32
          let mut exact_argument = false
          let mut source_offset = 0u32
          let _ = while source_offset {
            source => if source < fields.length {
              let object_index = self_host_u32_add(fields.start, source)
              if object_index < module_.object_fields.length() {
                let object_field = self_host_planned_object_field_identity(
                  module_.object_fields[object_index],
                )
                let exact_field = self_host_u64_equal(
                  object_field.field,
                  destination.declaration,
                )
                let named_field = self_host_u32_greater(
                  self_host_linked_module_name_count(module_),
                  object_field.name,
                ) && match self_host_linked_field_name(
                  link,
                  destination.declaration,
                ) {
                  Option::Some(destination_name) => self_host_linked_module_name_at(
                    module_,
                    object_field.name,
                  ) == destination_name
                  Option::None => false
                }
                if exact_field || named_field {
                  argument = object_field.value
                  exact_argument = exact_field
                }
              }
              continue source + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if argument == 4294967295u32 {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression_plan.expression,
              destination.declaration,
              "constructor destination field has no exact source FieldId",
              self_host_body_carrier_from_storage(destination.storage),
              SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
            )
          } else {
            match self_host_body_plan_expression(plan, argument) {
              Option::Some(actual) => {
                let expected_carrier = self_host_body_carrier_from_storage(
                  destination.storage,
                )
                let boxed = self_host_linked_erased_field_box_type(link, destination.declaration, actual.value.carrier) is Option::Some(_) ||
                  self_host_linked_erased_field_unit_storage(link, destination.declaration, destination.storage, actual.value.carrier)
                if exact_argument && !boxed && !self_host_body_carrier_equal(
                  expected_carrier,
                  actual.value.carrier,
                ) && !(actual.value.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && !(
                  actual.value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                ) {
                  self_host_body_add_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    destination.declaration,
                    "constructor argument carrier mismatch",
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
                let expected_owner = self_host_body_field_value_nominal_owner(
                  link,
                  destination.declaration,
                )
                if exact_argument && !self_host_u64_equal(expected_owner, 0u64) &&
                  !self_host_u64_equal(actual.value.nominal_owner, 0u64) &&
                  !self_host_u64_equal(
                    expected_owner,
                    actual.value.nominal_owner,
                  ) {
                  self_host_body_add_nominal_diagnostic(
                    diagnostics,
                    plan,
                    module_,
                    argument,
                    expected_owner,
                    actual.value.nominal_owner,
                    "constructor argument nominal provenance mismatch",
                    expected_carrier,
                    actual.value.carrier,
                  )
                }
              }
              Option::None => self_host_body_add_diagnostic(
                diagnostics,
                plan,
                module_,
                argument,
                destination.declaration,
                "constructor argument has no physical value plan",
                self_host_body_carrier_from_storage(destination.storage),
                SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
              )
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return
    }
  }
}

fn self_host_verify_body_pattern_payloads(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let expression_plan_count = array_length(plan.expressions)
  let mut expression_plan_index = 0u32
  let _ = while expression_plan_index {
    current_expression_plan => if current_expression_plan < expression_plan_count {
      let expression_plan = array_get_unchecked(
        plan.expressions,
        current_expression_plan,
      )
      match module_.expressions[expression_plan.expression].kind {
      SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => match self_host_body_plan_expression(
        plan,
        subject,
      ) {
        Option::Some(subject_plan) => {
          let mut arm_offset = 0u32
          let _ = while arm_offset {
            current_arm => if current_arm < arms.length {
              let child = self_host_u32_add(arms.start, current_arm)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let root_index = self_host_planned_pattern_arm_identity(
                    module_.pattern_arms[arm_index],
                  ).pattern
                  if root_index < module_.patterns.length() {
                    let root = self_host_planned_pattern_identity(
                      module_.patterns[root_index],
                    )
                    if root.selected_constructor is SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
                      _,
                      _,
                      _,
                    ) {
                    match root.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root,
                        SelfHostPlannedValueShape::ErrorPlannedValueShape,
                        subject_plan.value.nominal_owner,
                      ) {
                        Option::Some(type_index) => {
                          let mut field_index = 0u32
                          let _ = while field_index {
                            current_field => if current_field < children.length {
                              let pattern_child = self_host_u32_add(
                                children.start,
                                current_field,
                              )
                              if pattern_child < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[pattern_child]
                                if child_pattern_index < module_.patterns.length() {
                                  match module_.patterns[child_pattern_index].reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(local_id) => if module_.patterns[
                                      child_pattern_index
                                    ].source is SelfHostHirPattern::BindingPattern(_, _) {
                                      let slot = self_host_body_local_slot(
                                        module_,
                                        body,
                                        local_id,
                                      )
                                      if slot < plan.local_values.length() {
                                        let expected_carrier = self_host_body_physical_field_carrier(
                                          link,
                                          type_index,
                                          current_field,
                                        )
                                        let actual = plan.local_values[slot]
                                        let actual_carrier = if slot < plan.locals.length() {
                                          plan.locals[slot]
                                        } else {
                                          actual.carrier
                                        }
                                        if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
                                          !(actual_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
                                          !self_host_body_carrier_equal(expected_carrier, actual_carrier) {
                                          self_host_body_add_diagnostic(
                                            diagnostics,
                                            plan,
                                            module_,
                                            subject,
                                            u32_into_u64(local_id),
                                            "pattern payload carrier mismatch",
                                            expected_carrier,
                                            actual_carrier,
                                          )
                                        }
                                        let expected_owner = self_host_linked_field_value_nominal_declaration(
                                          link,
                                          SelfHostLinkedWasmFieldLink::{
                                            type_index: type_index
                                            field_index: current_field
                                          },
                                        )
                                        let actual_owner = actual.nominal_owner
                                        if expected_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier {
                                          if expected_owner != 0u64 && actual_owner != 0u64 {
                                            if expected_owner != actual_owner {
                                              self_host_body_add_nominal_diagnostic(
                                                diagnostics,
                                                plan,
                                                module_,
                                                subject,
                                                expected_owner,
                                                actual_owner,
                                                "pattern payload nominal provenance mismatch",
                                                expected_carrier,
                                                actual_carrier,
                                              )
                                            }
                                          }
                                        }
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_field + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                    }
                  }
                }
              }
              continue current_arm + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        Option::None => {}
      }
        _ => {}
      }
      continue current_expression_plan + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_verify_one_physical_body(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let _ = self_host_assert_compiler_invariant_with_failure(
    self_host_u32_equal(plan.local_slots.length(), plan.local_values.length()),
    SelfHostInvariantFailure::{
      code: 103u32
      phase: 6u32
      module_id: plan.module_id
      declaration: plan.declaration
      body: plan.body
      expression: 4294967295u32
      expected: u32_into_u64(plan.local_values.length())
      actual: u32_into_u64(plan.local_slots.length())
      detail: 710u64
    },
    "physical local slots must remain parallel to logical local values",
  )
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
  let body = match self_host_body_lookup_for_plan(module_, plan) {
    Option::Some(value) => value
    Option::None => {
      self_host_body_add_diagnostic(
        diagnostics, plan, module_, 4294967295u32, u32_into_u64(plan.lambda),
        "physical source body is missing", plan.result_carrier,
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      )
      return
    }
  }
  if !plan.converged {
    let stalled_expression = if plan.stalled_work_item == 4294967295u32 ||
      self_host_u32_equal(plan.stalled_work_item, 0u32) {
      body.expressions.start
    } else {
      self_host_u32_add(
        body.expressions.start,
        self_host_u32_subtract(plan.stalled_work_item, 1u32),
      )
    }
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      stalled_expression,
      u32_into_u64(plan.stalled_work_item),
      "physical body carrier analysis did not converge",
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
    )
    return
  }
  self_host_verify_body_pattern_payloads(
    link,
    plan,
    module_,
    body,
    diagnostics,
  )
  self_host_verify_body_string_pattern_calls(link, plan, module_, body, diagnostics)
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length {
      let local_index = self_host_u32_add(body.locals.start, current)
      if local_index < module_.locals.length() && current < plan.local_values.length() {
        let local = module_.locals[local_index]
        let expected_nominal = self_host_linked_loop_binding_nominal_declaration(
          link,
          module_,
          body,
          local.local_id,
        )
        let actual_nominal = plan.local_values[current].nominal_owner
        if !self_host_u64_equal(expected_nominal, 0u64) &&
          !self_host_u64_equal(actual_nominal, 0u64) &&
          !self_host_u64_equal(expected_nominal, actual_nominal) {
          // A loop binding must keep the nominal type of its container element.
          self_host_body_add_nominal_diagnostic(
            diagnostics,
            plan,
            module_,
            body.expressions.start,
            expected_nominal,
            actual_nominal,
            "loop binding nominal provenance mismatch",
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
            plan.local_values[current].carrier,
          )
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let embedded_targets = self_host_body_embedded_targets(module_, body)
  for expression_plan in plan.expressions {
    let expression = expression_plan.expression
    let source = self_host_planned_expression_at(module_.expressions, expression)
    let embedded_target = if expression >= body.expressions.start {
      let relative = expression - body.expressions.start
      if relative < embedded_targets.length() {
        embedded_targets[relative]
      } else {
        false
      }
    } else {
      false
    }
    if !source.flow.falls_through {
      match source.kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => if !(expression_plan.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
          // A direct call with a physical result must not poison later flow.
          self_host_body_add_known_expression_diagnostic(
            diagnostics,
            plan,
            module_,
            source,
            expression,
            u32_into_u64(expression_plan.call_function_index),
            expression_plan.value.nominal_owner,
            "direct call result is incorrectly marked as diverging",
            expression_plan.carrier,
            SelfHostWasmBodyCarrier::NeverBodyCarrier,
          )
        }
        _ => {}
      }
    }
    if expression_plan.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier {
      self_host_body_add_diagnostic(
        diagnostics,
        plan,
        module_,
        expression,
        0u64,
        "body carrier conflict",
        expression_plan.conflict_expected,
        expression_plan.conflict_actual,
      )
    }
    match source.kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {}
      SelfHostPlannedExpressionKind::PlannedFunctionReference(declaration) => {
        if expression_plan.call_function_index == 4294967295u32 ||
          !self_host_linked_function_declaration_module_matches(link, expression_plan.call_function_index, declaration) {
          self_host_body_add_diagnostic(
            diagnostics, plan, module_, expression, declaration, "call target is missing",
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
            SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          )
        }
      }
      SelfHostPlannedExpressionKind::PlannedLambdaClosure(lambda) => {
        if !self_host_lambda_construction_target_matches(link, plan, expression_plan, lambda) {
          self_host_body_add_diagnostic(
            diagnostics, plan, module_, expression, plan.declaration, "call target is missing",
            SelfHostWasmBodyCarrier::EqRefBodyCarrier,
            SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
          )
        }
      }
      SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
        let slot = self_host_body_local_slot(module_, body, local_id)
        if slot < plan.local_values.length() {
          match self_host_body_plan_expression(plan, value) {
            Option::Some(actual) => {
              let expected = plan.local_values[slot].carrier
              if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
              ) && !(actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                self_host_body_add_diagnostic(
                  diagnostics,
                  plan,
                  module_,
                  value,
                  u32_into_u64(local_id),
                  "local assignment carrier mismatch",
                  expected,
                  actual.carrier,
                )
              }
            }
            Option::None => {}
          }
        }
      }
      SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => if value != 4294967295u32 {
        match self_host_body_plan_expression(plan, value) {
          Option::Some(actual) => if !self_host_body_carrier_equal(
            plan.result_carrier,
            actual.carrier,
          ) && !(actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              0u64,
              "return operand",
              plan.result_carrier,
              actual.carrier,
            )
          }
          Option::None => {}
        }
      }
      SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
        match expression_plan.selected_storage {
        Option::Some(storage) => {
          let expected = self_host_body_field_read_carrier(link, module_, plan.specialization, expression, expression_plan.selected_field, storage)
          if !self_host_body_carrier_equal(expected, expression_plan.carrier) {
            self_host_body_add_diagnostic(
              diagnostics,
              plan,
              module_,
              expression,
              match source.kind {
                SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => field
                _ => u32_into_u64(expression_plan.selected_field_index)
              },
              "field load",
              expected,
              expression_plan.carrier,
            )
          }
        }
        Option::None => self_host_body_add_diagnostic(
          diagnostics,
          plan,
          module_,
          expression,
          0u64,
          "field load has no selected physical field",
          SelfHostWasmBodyCarrier::EqRefBodyCarrier,
          SelfHostWasmBodyCarrier::UnresolvedBodyCarrier,
        )
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => if !embedded_target {
        self_host_verify_body_field_owner(
          link,
          plan,
          module_,
          body,
          expression_plan,
          diagnostics,
        )
      }
      SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => self_host_verify_body_constructor(
        link,
        plan,
        module_,
        body,
        expression_plan,
        fields,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, arguments, _) => {
        self_host_verify_body_call_result(
          link,
          plan,
          module_,
          expression_plan,
          diagnostics,
        )
        self_host_verify_body_call_arguments(
          link,
          plan,
          module_,
          body,
          expression_plan,
          arguments,
          diagnostics,
        )
      }
      SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _) => self_host_verify_body_call_result(
        link,
        plan,
        module_,
        expression_plan,
        diagnostics,
      )
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, arguments) => {
        self_host_verify_body_call_result(
          link,
          plan,
          module_,
          expression_plan,
          diagnostics,
        )
        self_host_verify_body_call_arguments(
          link,
          plan,
          module_,
          body,
          expression_plan,
          arguments,
          diagnostics,
        )
      }
      SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => {
        self_host_verify_body_call_result(link, plan, module_, expression_plan, diagnostics)
        self_host_verify_body_call_arguments(link, plan, module_, body, expression_plan,
          SelfHostHirSpan::{
            start: 0u32
            length: 0u32
          }, diagnostics,
        )
      }
      SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _) => {
        self_host_verify_body_call_result(link, plan, module_, expression_plan, diagnostics)
        self_host_verify_body_call_arguments(link, plan, module_, body, expression_plan,
          SelfHostHirSpan::{
            start: 0u32
            length: 0u32
          }, diagnostics,
        )
      }
      _ => {}
    }
  }
  let mut block_offset = 0u32
  let _ = while block_offset {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      let items = module_.blocks[block_index].items
      let mut item_offset = 0u32
      let _ = while item_offset {
        current_item => if current_item < items.length {
          let item = module_.block_items[
            self_host_u32_add(items.start, current_item)
          ]
          match item.kind {
            SelfHostPlannedBlockItemKind::PlannedLetItem(
              local_id,
              _,
              initializer,
            ) => {
              let slot = self_host_body_local_slot(module_, body, local_id)
              match self_host_body_plan_expression(plan, initializer) {
                Option::Some(actual) => if slot < plan.local_values.length() {
                  let expected = plan.local_values[slot].carrier
                  if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !self_host_body_carrier_equal(expected, actual.carrier) && !(
                    actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
                  ) && !(actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
                    self_host_body_add_diagnostic(
                      diagnostics,
                      plan,
                      module_,
                      initializer,
                      u32_into_u64(local_id),
                      "local initializer carrier mismatch",
                      expected,
                      actual.carrier,
                    )
                  }
                }
                Option::None => {}
              }
            }
            _ => {}
          }
          continue current_item + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let root_carrier = match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(value) => value.carrier
      Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostHirBodyRoot::BlockBodyRoot(block) => self_host_body_block_carrier(
      module_,
      body,
      plan.expressions,
      block,
    )
  }
  if !(plan.result_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) &&
    !self_host_body_carrier_equal(plan.result_carrier, root_carrier) &&
    !(root_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) &&
    !(root_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
    !(root_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => expression
        SelfHostHirBodyRoot::BlockBodyRoot(_) => body.expressions.start
      },
      0u64,
      "function result",
      plan.result_carrier,
      root_carrier,
    )
  }
  if !(plan.result_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) && (
    root_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
      root_carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier
  ) {
    self_host_body_add_diagnostic(
      diagnostics,
      plan,
      module_,
      match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => expression
        SelfHostHirBodyRoot::BlockBodyRoot(_) => body.expressions.start
      },
      0u64,
      "body root has no concrete physical value",
      plan.result_carrier,
      root_carrier,
    )
  }
}

pub fn self_host_plan_program_wasm_bodies(
  link: SelfHostPlannedProgramWasmGCLink,
) -> SelfHostPlannedProgramWasmBodyPlan {
  let indexes = self_host_build_physical_body_indexes(link)
  let bodies = []
  let diagnostics = []
  for function_ in link.functions {
    let fragment_module = self_host_body_fragment_module(
      link,
      function_.module_index,
    )
    let fragment = self_host_body_function_fragment(
      fragment_module,
      function_.fragment_index,
    )
    let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, function_.module_index, function_.specialization)
    let (body, lambda) = match fragment.kind {
      SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body_id) => match self_host_body_lookup(
        module_,
        body_id,
      ) {
        Option::Some(value) => (Option::Some(value), 4294967295u32)
        Option::None => (
          self_host_body_require_linked_source(Option::None, function_, body_id),
          4294967295u32,
        )
      }
      SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
        lambda_id,
      ) => (
        self_host_body_require_linked_source(
          self_host_body_lambda_lookup(module_, lambda_id), function_, function_.declaration,
        ),
        lambda_id,
      )
      _ => (Option::None, 4294967295u32)
    }
    match body {
      Option::Some(value) => {
        let plan = self_host_plan_one_physical_body(
          link,
          indexes,
          function_,
          value,
          lambda,
        )
        self_host_verify_one_physical_body(link, plan, diagnostics)
        bodies.push(plan)
      }
      Option::None => {}
    }
  }
  SelfHostPlannedProgramWasmBodyPlan::{
    bodies: bodies
    diagnostics: diagnostics
  }
}

pub fn self_host_body_plan_pattern_payload_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  pattern: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  if pattern >= module_.patterns.length() {
    return Option::None
  }
  match module_.patterns[pattern].source {
    SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
      children.length,
      0u32,
    ) && children.start < module_.pattern_children.length() {
      let child = module_.pattern_children[children.start]
      if child < module_.patterns.length() {
        match module_.patterns[child].reference {
          SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
            let slot = self_host_body_local_slot(module_, body, local_id)
            if slot < plan.local_values.length() {
              return Option::Some(plan.local_values[slot])
            }
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  Option::None
}

pub fn self_host_body_plan_scratch_value(
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  expression: U32,
  ordinal: U32,
) -> Option<SelfHostPlannedPhysicalValueInfo> {
  for scratch in plan.scratches {
    if self_host_u32_equal(scratch.expression, expression) &&
      self_host_u32_equal(scratch.ordinal, ordinal) {
      return Option::Some(scratch.value)
    }
  }
  Option::None
}

pub fn self_host_body_carrier_shape(
  carrier: SelfHostWasmBodyCarrier,
) -> SelfHostPlannedValueShape {
  match carrier {
    SelfHostWasmBodyCarrier::UnitBodyCarrier => SelfHostPlannedValueShape::UnitPlannedValueShape
    SelfHostWasmBodyCarrier::NeverBodyCarrier => SelfHostPlannedValueShape::NeverPlannedValueShape
    SelfHostWasmBodyCarrier::I32BodyCarrier => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostWasmBodyCarrier::I64BodyCarrier => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostWasmBodyCarrier::F32BodyCarrier => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostWasmBodyCarrier::F64BodyCarrier => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostWasmBodyCarrier::V128BodyCarrier => SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier => SelfHostPlannedValueShape::ErrorPlannedValueShape
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

// Stable crash-record encoding, independent of enum layout.
fn self_host_body_carrier_code(carrier: SelfHostWasmBodyCarrier) -> U64 {
  match carrier {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => 0u64
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier => 1u64
    SelfHostWasmBodyCarrier::UnitBodyCarrier => 2u64
    SelfHostWasmBodyCarrier::NeverBodyCarrier => 3u64
    SelfHostWasmBodyCarrier::I32BodyCarrier => 4u64
    SelfHostWasmBodyCarrier::I64BodyCarrier => 5u64
    SelfHostWasmBodyCarrier::F32BodyCarrier => 6u64
    SelfHostWasmBodyCarrier::F64BodyCarrier => 7u64
    SelfHostWasmBodyCarrier::V128BodyCarrier => 8u64
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => 9u64
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => 10u64
  }
}

fn self_host_body_carrier_name(carrier: SelfHostWasmBodyCarrier) -> String {
  match carrier {
    SelfHostWasmBodyCarrier::UnresolvedBodyCarrier => "unresolved"
    SelfHostWasmBodyCarrier::ConflictingBodyCarrier => "conflict"
    SelfHostWasmBodyCarrier::UnitBodyCarrier => "unit"
    SelfHostWasmBodyCarrier::NeverBodyCarrier => "never"
    SelfHostWasmBodyCarrier::I32BodyCarrier => "i32"
    SelfHostWasmBodyCarrier::I64BodyCarrier => "i64"
    SelfHostWasmBodyCarrier::F32BodyCarrier => "f32"
    SelfHostWasmBodyCarrier::F64BodyCarrier => "f64"
    SelfHostWasmBodyCarrier::V128BodyCarrier => "v128"
    SelfHostWasmBodyCarrier::EqRefBodyCarrier => "eqref"
    SelfHostWasmBodyCarrier::FuncRefBodyCarrier => "funcref"
  }
}

pub fn self_host_program_wasm_body_plan_error_report(
  plan: SelfHostPlannedProgramWasmBodyPlan,
) -> String {
  let output = StringBuilder::new()
  output.append("physical body carrier verifier: ")
  output.append_u32(plan.diagnostics.length())
  output.append(" error(s)")
  for diagnostic in plan.diagnostics {
    output.append("\ncode=")
    output.append_u32(diagnostic.code)
    output.append(" module=")
    output.append_u64(diagnostic.module_id)
    output.append(" declaration=")
    output.append_u64(diagnostic.declaration)
    output.append(" name=")
    output.append(bytes_to_string(diagnostic.declaration_name))
    output.append(" body=")
    output.append_u64(diagnostic.body)
    output.append(" lambda=")
    output.append_u32(diagnostic.lambda)
    output.append(" function=")
    output.append_u32(diagnostic.physical_function_index)
    output.append(" specialization=")
    output.append(diagnostic.specialization_key)
    output.append(" expression=")
    output.append_u32(diagnostic.expression)
    output.append(" entity=")
    output.append_u64(diagnostic.entity)
    output.append(" offset=")
    output.append_u32(diagnostic.source_offset)
    output.append(" kind=")
    output.append(diagnostic.expression_kind)
    output.append(" source_name=")
    output.append(diagnostic.source_name)
    output.append(" context=")
    output.append(diagnostic.context)
    output.append(" logical_type=")
    output.append_i32(diagnostic.logical_type)
    output.append(" selected_owner=")
    output.append_u64(diagnostic.selected_owner)
    output.append(" expected_owner=")
    output.append_u64(diagnostic.expected_owner)
    output.append(" actual_owner=")
    output.append_u64(diagnostic.actual_owner)
    output.append(" expected=")
    output.append(self_host_body_carrier_name(diagnostic.expected))
    output.append(" actual=")
    output.append(self_host_body_carrier_name(diagnostic.actual))
  }
  output.finish()
}

pub fn self_host_program_wasm_body_plan_for_identity(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  module_id: U64,
  body_id: U64,
  specialization: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u64_equal(body.module_id, module_id) &&
      self_host_u64_equal(body.body, body_id) &&
      self_host_u32_equal(body.specialization, specialization) {
      return Option::Some(body)
    }
  }
  Option::None
}

pub fn self_host_program_wasm_body_plan_for_function(
  plan: SelfHostPlannedProgramWasmBodyPlan,
  physical_function_index: U32,
) -> Option<SelfHostPlannedPhysicalBodyCarrierPlan> {
  for body in plan.bodies {
    if self_host_u32_equal(
      body.physical_function_index,
      physical_function_index,
    ) {
      return Option::Some(body)
    }
  }
  Option::None
}

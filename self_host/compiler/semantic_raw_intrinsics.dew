open dew.std.option

fn self_host_verify_body_raw_intrinsic(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: SelfHostPlannedPhysicalExpressionCarrier,
  diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>,
) -> Unit {
  let mut name = b""
  let arguments = match module_.expressions[expression.expression].kind {
    PlannedBuiltinCall(target, _, _, arguments, _) => {
      name = target
      arguments
    }
    PlannedDirectCall(declaration, _, arguments, _) => {
      // Variant and function IDs are from distinct arenas. The selection kind
      // must agree before a numeric declaration can name a builtin function.
      if module_.expressions[expression.expression].selection is VariantConstructionBasicExpressionSelection(_, _, _) {
        return
      }
      match self_host_linked_builtin_name(link, declaration) {
        Some(target) => {
          name = target
        }
        None => return
      }
      arguments
    }
    _ => return
  }
  match self_host_raw_intrinsic_error(name, Some(plan), module_, expression.expression, arguments) {
    Some(error) => {
      let expected = match self_host_raw_intrinsic_signature(name) {
        Some(signature) => signature.result
        None => if arguments.length == 1u32 && arguments.start < module_.expression_children.length() {
          match self_host_body_plan_expression(plan, module_.expression_children[arguments.start]) {
            Some(source) => source.carrier
            None => UnresolvedBodyCarrier
          }
        } else {
          UnresolvedBodyCarrier
        }
      }
      self_host_body_add_diagnostic(diagnostics, plan, module_, expression.expression, 0u64, error, expected, expression.carrier)
    }
    None => {}
  }
}

pub struct SelfHostRawIntrinsicSignature {
  inputs: Array<SelfHostWasmBodyCarrier>
  result: SelfHostWasmBodyCarrier
}

fn self_host_raw_intrinsic_signature(name: Bytes) -> Option<SelfHostRawIntrinsicSignature> {
  if name.equals(b"ref.eq") {
    return Some({
      inputs: [EqRefBodyCarrier, EqRefBodyCarrier]
      result: I32BodyCarrier
    })
  }
  if name.equals(b"unreachable") {
    return Some({
      inputs: []
      result: NeverBodyCarrier
    })
  }
  match self_host_raw_scalar_signature(name) {
    Some(signature) => return Some(signature)
    None => {}
  }
  let mut carrier = UnresolvedBodyCarrier
  let mut load = false
  let mut store = false
  if name.equals(b"v128.and") || name.equals(b"v128.or") || name.equals(b"v128.xor") {
    carrier = V128BodyCarrier
  } else if name.equals(b"i32.load") || name.equals(b"i32.store") {
    carrier = I32BodyCarrier
    load = name.equals(b"i32.load")
    store = !load
  } else if name.equals(b"i32.load8_s") || name.equals(b"i32.load8_u") || name.equals(b"i32.load16_s") || name.equals(b"i32.load16_u") || name.equals(b"i32.store8") || name.equals(b"i32.store16") {
    carrier = I32BodyCarrier
    store = name.equals(b"i32.store8") || name.equals(b"i32.store16")
    load = !store
  } else if name.equals(b"f32.load") || name.equals(b"f32.store") {
    carrier = F32BodyCarrier
    load = name.equals(b"f32.load")
    store = !load
  } else if name.equals(b"f64.load") || name.equals(b"f64.store") {
    carrier = F64BodyCarrier
    load = name.equals(b"f64.load")
    store = !load
  } else if name.equals(b"i64.load") || name.equals(b"i64.store") {
    carrier = I64BodyCarrier
    load = name.equals(b"i64.load")
    store = !load
  } else if name.equals(b"v128.load") || name.equals(b"v128.store") {
    carrier = V128BodyCarrier
    load = name.equals(b"v128.load")
    store = !load
  } else {
    return self_host_raw_simd_signature(name)
  }
  Some({
    inputs: if load {
      [I32BodyCarrier]
    } else if store {
      [I32BodyCarrier, carrier]
    } else {
      [carrier, carrier]
    }
    result: if store {
      UnitBodyCarrier
    } else {
      carrier
    }
  })
}

// A no-op cast preserves a concrete non-reference Wasm carrier. Equal eqref
// carriers do not establish equal heap types, so references are not accepted.
fn self_host_raw_intrinsic_error(
  name: Bytes,
  plan: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  arguments: SelfHostHirSpan,
) -> Option<SelfHostPhysicalDiagnosticReason> {
  let signature = self_host_raw_intrinsic_signature(name)
  if !name.equals(b"unsafe.bitcast") && signature is None {
    return None
  }
  let count = match signature {
    Some(value) => value.inputs.length()
    None => 1u32
  }
  if arguments.length != count || !self_host_array_span_is_valid(
    arguments.start,
    arguments.length,
    module_.expression_children.length(),
  ) {
    return Some(RawIntrinsicOperandCountMismatch)
  }
  let body_plan = match plan {
    Some(value) => value
    None => return Some(MissingRawIntrinsicBodyPlan)
  }
  let target = match self_host_body_plan_expression(body_plan, expression) {
    Some(value) => value.carrier
    None => return Some(MissingRawIntrinsicResultPlan)
  }
  // Never is flow, not an operand carrier. Require both frozen carrier and
  // flow evidence before omitting the stack contract for an unexecuted opcode.
  if target is NeverBodyCarrier &&
    expression < module_.expressions.length() &&
    !module_.expressions[expression].flow.falls_through {
    let _ = while 0u32 {
      index => if index < arguments.length {
        let argument = module_.expression_children[arguments.start + index]
        match self_host_body_plan_expression(body_plan, argument) {
          Some(operand) => if operand.carrier is NeverBodyCarrier &&
            argument < module_.expressions.length() &&
            !module_.expressions[argument].flow.falls_through {
            return None
          }
          None => return Some(MissingRawIntrinsicOperandPlan)
        }
        continue index + 1u32
      } else {
        break ()
      }
    }
  }
  match signature {
    Some(value) => {
      if !self_host_body_carrier_equal(target, value.result) {
        return Some(RawIntrinsicCarrierMismatch)
      }
      let _ = while 0u32 {
        index => if index < value.inputs.length() {
          let actual = match self_host_body_plan_expression(body_plan, module_.expression_children[arguments.start + index]) {
            Some(operand) => operand.carrier
            None => return Some(MissingRawIntrinsicOperandPlan)
          }
          if !self_host_body_carrier_equal(actual, value.inputs[index]) {
            return Some(RawIntrinsicCarrierMismatch)
          }
          continue index + 1u32
        } else {
          break ()
        }
      }
      return None
    }
    None => {}
  }
  let source = match self_host_body_plan_expression(
    body_plan,
    module_.expression_children[arguments.start],
  ) {
    Some(value) => value.carrier
    None => return Some(MissingRawIntrinsicSourcePlan)
  }
  let supported = match source {
    I32BodyCarrier => true
    I64BodyCarrier => true
    F32BodyCarrier => true
    F64BodyCarrier => true
    V128BodyCarrier => true
    _ => false
  }
  if supported && self_host_body_carrier_equal(source, target) {
    return None
  }
  Some(InvalidBitcastCarriers)
}

open dew.std.array
open dew.std.bytes
open dew.std.map
open dew.std.option
open dew.std.result
open dew.std.string
open dew.std.string_builder

fn self_host_compile_time_error_map() -> Map<U32, String> {
  empty()
}

fn self_host_compile_time_static_callee(module_: SelfHostPlannedModuleLowering, callee: U32, declaration: U64) -> Bool {
  if callee == 4294967295u32 {
    return true
  }
  if callee >= module_.expressions.length() {
    return false
  }
  match module_.expressions[callee].kind {
    PlannedFunctionReference(target) => target == declaration
    PlannedModuleValueGet(target) => {
      if target == declaration {
        return true
      }
      // A generic callable name is not a module initializer. Its selected
      // declaration lives on the call, while the callee keeps its name binding.
      match module_.expressions[callee].reference {
        ModuleValueNameReference(name) => {
          if name >= module_.names.length() {
            return false
          }
          match self_host_program_specialization_callable(module_, declaration) {
            Some(callable) => callable.name == module_.names[name].as_bytes()
            None => false
          }
        }
        ImportedModuleValueNameReference(target) => target == declaration
        _ => false
      }
    }
    PlannedConsumedExpression => true
    _ => false
  }
}

fn self_host_compile_time_callee_error(module_: SelfHostPlannedModuleLowering, callee: U32) -> String {
  let message = StringBuilder::new()
  message.append("CT-001 type query cannot have a runtime receiver callee=")
  message.append_u32(callee)
  if callee < module_.expressions.length() {
    message.append(" kind=")
    message.append(self_host_body_expression_kind_name(module_.expressions[callee].kind))
  }
  message.finish()
}

fn self_host_compile_time_diagnose(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32, message: String) -> Unit {
  let text = StringBuilder::new()
  text.append(message)
  text.append(" module=")
  text.append_u64(module_.module_id)
  text.append(" declaration=")
  text.append_u64(body.declaration)
  text.append(" body=")
  text.append_u64(body.body)
  text.append(" specialization=")
  text.append_u32(specialization)
  text.append(" expression=")
  text.append_u32(expression)
  text.append(" offset=")
  text.append_u32(module_.expressions[expression].offset)
  lowering.compile_time.diagnostics.push(text.finish())
}

fn self_host_compile_time_name_query(lowering: SelfHostPlannedProgramLowering, name: Bytes, types: Array<SelfHostCompileTimeType>) -> Result<Option<SelfHostCompileTimeConstant>, String> {
  if types.length() != 1u32 {
    return Err("CT-002 wrong names query arity")
  }
  match self_host_compile_time_types_concrete(types) {
    Err(error) => return Err(error)
    Ok(concrete) => if !concrete {
      return Ok(None)
    }
  }
  let base = match types[0u32] {
    AppliedCompileTimeType(base, _) => base
    value => value
  }
  let declaration = match base {
    NominalCompileTimeType(declaration) => declaration
    _ => return Err("CT-002 names query requires a nominal declaration")
  }
  let owner = match lowering.index.declaration_owner(declaration) {
    Some(owner) => owner
    None => return Err("CT-002 names query declaration is missing")
  }
  let collected = lowering.collected.modules.at(owner)
  let fields = name == b"types.field_names"
  let mut valid = false
  for entry in collected.declarations {
    if entry.id == declaration {
      valid = if fields {
        entry.kind is StructDecl
      } else {
        entry.kind is EnumDecl
      }
    }
  }
  if !valid {
    return Err("CT-002 field_names requires a struct; variant_names requires an enum")
  }
  let names = [b""]
  names.clear()
  if fields {
    for field in collected.fields {
      if field.declaration == declaration && field.variant is None {
        names.push(collected.name(field.name).as_bytes())
      }
    }
  } else {
    for variant in collected.variants {
      if variant.declaration == declaration {
        names.push(collected.name(variant.name).as_bytes())
      }
    }
  }
  Ok(Some(NamesCompileTimeConstant(names)))
}

fn self_host_compile_time_result_type(lowering: SelfHostPlannedProgramLowering, constant: SelfHostCompileTimeConstant) -> Result<SelfHostCompileTimeType, String> {
  match constant {
    BoolCompileTimeConstant(_) => Ok(PrimitiveCompileTimeType(BoolType))
    U32CompileTimeConstant(_) => Ok(PrimitiveCompileTimeType(U32Type))
    NamesCompileTimeConstant(_) => {
      let owner = match lowering.collected.module_index("dew.std.array") {
        Some(owner) => owner
        None => return Err("CT-003 names query requires the declared Array<String> result")
      }
      let declaration = match lowering.collected.modules.at(owner).lookup_type("Array") {
        Some(declaration) => declaration
        None => return Err("CT-003 names query Array declaration is missing")
      }
      Ok(AppliedCompileTimeType(
        NominalCompileTimeType(declaration),
        [PrimitiveCompileTimeType(StringType)],
      ))
    }
  }
}

fn self_host_fold_compile_time_call(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, source: SelfHostPlannedExpression, name: Bytes, bindings: SelfHostCompileTimeBindings, caller: U64) -> Result<Option<SelfHostPlannedExpression>, String> {
  if self_host_computed_type_builtin(name) {
    return Err("CT-036 a type-producing query must be used in a type position")
  }
  let operands = match source.kind {
    PlannedBuiltinCall(_, target, receiver, arguments, _) => {
      if !self_host_compile_time_static_callee(module_, receiver, target) {
        return Err(self_host_compile_time_callee_error(module_, receiver))
      }
      arguments
    }
    PlannedDirectCall(target, receiver, arguments, _) => {
      if !self_host_compile_time_static_callee(module_, receiver, target) {
        return Err(self_host_compile_time_callee_error(module_, receiver))
      }
      arguments
    }
    _ => return Err("CT-001 invalid type-query call kind")
  }
  let field_offset = name == b"types.field_offset"
  let operand_count = if field_offset {
    1u32
  } else {
    0u32
  }
  if operands.length != operand_count {
    return Err("CT-001 wrong type-query operand count")
  }
  let types = match self_host_read_compile_time_arguments(module_, source.call_type_arguments, bindings) {
    Ok(types) => types
    Err(error) => return Err(error)
  }
  let types = match self_host_reduce_compile_time_projection_list(lowering, types, 0u32) {
    Ok(values) => values
    Err(error) => return Err(error)
  }
  let evaluated = if field_offset {
    self_host_assert_array_span(operands.start, operands.length, module_.expression_children.length(), "ARN-101 field_offset operand span")
    let operand = module_.expression_children[operands.start]
    self_host_assert_array_index(operand, module_.expressions.length(), "ARN-104 field_offset operand expression")
    let index = match module_.expressions[operand].kind {
      PlannedU32Const(value) => {
        if value > 4294967295u64 {
          return Err("CT-020 field_offset requires a constant U32 field index")
        }
        value.into()
      }
      _ => return Err("CT-020 field_offset requires a constant U32 field index")
    }
    self_host_evaluate_compile_time_field_offset(types, index)
  } else if name == b"types.field_names" || name == b"types.variant_names" {
    self_host_compile_time_name_query(lowering, name, types)
  } else if name == b"types.implements" {
    self_host_evaluate_compile_time_implements(lowering, module_, types, caller)
  } else {
    self_host_evaluate_compile_time_query(name, types)
  }
  let constant = match evaluated {
    Ok(value) => match value {
      Some(constant) => constant
      None => return Ok(None)
    }
    Err(error) => return Err(error)
  }
  let expected = match self_host_compile_time_result_type(lowering, constant) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let actual = match self_host_read_compile_time_type(module_, source.type_, bindings, 0u32) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  match self_host_compile_time_types_equal(expected, actual) {
    Err(error) => return Err(error)
    Ok(equal) => if !equal {
      return Err("CT-003 query declaration has the wrong result type")
    }
  }
  let kind = match constant {
    BoolCompileTimeConstant(value) => PlannedBoolConst(value)
    U32CompileTimeConstant(value) => PlannedU32Const(u32_into_u64(value))
    NamesCompileTimeConstant(values) => PlannedStringArrayConst(values)
  }
  Ok(Some(self_host_compile_time_replace_kind(source, kind)))
}

fn self_host_fold_compile_time_assertion(module_: SelfHostPlannedModuleLowering, source: SelfHostPlannedExpression, bindings: SelfHostCompileTimeBindings) -> Result<SelfHostPlannedExpression, String> {
  let operands = match source.kind {
    PlannedBuiltinCall(_, target, receiver, arguments, _) => {
      if !self_host_compile_time_static_callee(module_, receiver, target) {
        return Err(self_host_compile_time_callee_error(module_, receiver))
      }
      arguments
    }
    PlannedDirectCall(target, receiver, arguments, _) => {
      if !self_host_compile_time_static_callee(module_, receiver, target) {
        return Err(self_host_compile_time_callee_error(module_, receiver))
      }
      arguments
    }
    _ => return Err("CT-001 invalid static_assert call kind")
  }
  if operands.length != 2u32 || source.call_type_arguments.length != 0u32 || !self_host_array_span_is_valid(operands.start, operands.length, module_.expression_children.length()) {
    return Err("CT-001 static_assert requires a condition and message, with no type arguments")
  }
  match self_host_read_compile_time_type(module_, source.type_, bindings, 0u32) {
    Ok(type_) => match type_ {
      PrimitiveCompileTimeType(primitive) if primitive is UnitType => {}
      _ => return Err("CT-003 static_assert must return Unit")
    }
    Err(error) => return Err(error)
  }
  let condition = module_.expression_children[operands.start]
  let message = module_.expression_children[operands.start + 1u32]
  let text = match module_.expressions[message].kind {
    PlannedStringConst(text) => text
    _ => return Err("CT-020 static_assert message must be a compile-time string")
  }
  match module_.expressions[condition].kind {
    PlannedBoolConst(value) => if !value {
      let error = StringBuilder::new()
      error.append("CT-021 static assertion failed: ")
      error.append(bytes_to_string(text))
      return Err(error.finish())
    }
    _ => return Err("CT-022 static_assert condition is not a compile-time Boolean")
  }
  Ok(self_host_compile_time_replace_kind(source, PlannedUnitConst))
}

fn self_host_compile_time_bool_binary(module_: SelfHostPlannedModuleLowering, operator: SelfHostHirBinaryOperator, left: U32, right: U32) -> Option<Bool> {
  match module_.expressions[left].kind {
    PlannedBoolConst(value) => {
      if (operator is LogicalOr && value) || (operator is LogicalAnd && !value) {
        return Some(value)
      }
    }
    _ => {}
  }
  match module_.expressions[left].kind {
    PlannedBoolConst(a) => match module_.expressions[right].kind {
      PlannedBoolConst(b) => match operator {
        LogicalAnd => Some(a && b)
        LogicalOr => Some(a || b)
        Equal => Some(a == b)
        NotEqual => Some(a != b)
        _ => None
      }
      _ => None
    }
    PlannedU32Const(a) => match module_.expressions[right].kind {
      PlannedU32Const(b) => match operator {
        Equal => Some(a == b)
        NotEqual => Some(a != b)
        Less => Some(a < b)
        Greater => Some(a > b)
        LessEqual => Some(a <= b)
        GreaterEqual => Some(a >= b)
        _ => None
      }
      _ => None
    }
    _ => None
  }
}

fn self_host_fold_compile_time_body(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, bindings: SelfHostCompileTimeBindings) -> Unit {
  self_host_fold_compile_time_body_with_conditions(lowering, module_, body, specialization, bindings, None)
}

fn self_host_fold_compile_time_body_with_conditions(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, bindings: SelfHostCompileTimeBindings, conditions: Option<Map<U32, Bool>>) -> Unit {
  let errors = self_host_compile_time_error_map()
  let owned = self_host_compile_time_owned_expressions(module_, body)
  let _ = while 0u32 {
    offset => if offset < owned.length() {
      let index = owned[offset]
      let source = module_.expressions[index]
      match self_host_program_specialization_call_recipe(source) {
        Some(recipe) => match lowering.compile_time.targets.get(recipe.target) {
          Some(name) => if name != b"types.static_assert" {
            match self_host_fold_compile_time_call(lowering, module_, source, name, bindings, body.declaration) {
              Ok(value) => match value {
                Some(replacement) => {
                  module_.expressions[index] = replacement
                }
                None => errors.set(index, "CT-004 type query remains unresolved in a concrete instance")
              }
              Err(error) => errors.set(index, error)
            }
          }
          None => {}
        }
        None => {}
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  // HIR expressions are stored child-first. Fold pure Bool operators before
  // choosing branches or checking assertions; no runtime operand is evaluated.
  let _ = while 0u32 {
    offset => if offset < owned.length() {
      let index = owned[offset]
      let source = module_.expressions[index]
      match self_host_compile_time_local_constant(module_, index) {
        Some(kind) => {
          module_.expressions[index] = self_host_compile_time_replace_kind(source, kind)
        }
        None => {}
      }
      match source.kind {
        PlannedPrefixExpression(operator, operand) => if operator is LogicalNot {
          match module_.expressions[operand].kind {
            PlannedBoolConst(value) => {
              module_.expressions[index] = self_host_compile_time_replace_kind(source, PlannedBoolConst(!value))
            }
            _ => {}
          }
        }
        PlannedBinaryExpression(operator, left, right) => match self_host_compile_time_bool_binary(module_, operator, left, right) {
          Some(value) => {
            module_.expressions[index] = self_host_compile_time_replace_kind(source, PlannedBoolConst(value))
          }
          None => {}
        }
        PlannedOperatorCall(target, operator, left, right, _) => match self_host_program_specialization_program_callable(lowering, target) {
          Some(callable) => match callable.kind {
            PlannedBuiltinCallable(name) => if
              (name == b"i32.eq" && operator is Equal) ||
              (name == b"i32.ne" && operator is NotEqual) {
              match self_host_compile_time_bool_binary(module_, operator, left, right) {
                Some(value) => {
                  module_.expressions[index] = self_host_compile_time_replace_kind(source, PlannedBoolConst(value))
                }
                None => {}
              }
            }
            _ => {}
          }
          None => {}
        }
        _ => {}
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match conditions {
    Some(selected) => for index in owned {
      match module_.expressions[index].kind {
        PlannedIfExpression(condition, _, _) => match module_.expressions[condition].kind {
          PlannedBoolConst(value) => selected.set(index, value)
          _ => {}
        }
        _ => {}
      }
    }
    None => {}
  }
  let live = self_host_prune_compile_time_body(module_, body)
  self_host_resolve_guarded_calls(lowering, module_, body, specialization, bindings, owned, live)
  let owner = match lowering.index.declaration_owner(body.declaration) {
    Some(owner) => owner
    None => {
      self_host_assert_compiler_invariant(false, "LNK-504 type binding body owner")
      unreachable()
    }
  }
  let collected = lowering.collected.modules.at(owner)
  let _ = while 0u32 {
    offset => if offset < owned.length() {
      let index = owned[offset]
      if live[index] {
        let source = module_.expressions[index]
        match self_host_validate_query_binding(lowering, collected, module_, index, bindings) {
          Some(message) => errors.set(index, message)
          None => {}
        }
        match errors.get(index) {
          Some(error) => self_host_compile_time_diagnose(lowering, module_, body, specialization, index, error)
          None => match self_host_program_specialization_call_recipe(source) {
            Some(recipe) => match lowering.compile_time.targets.get(recipe.target) {
              Some(name) => if name == b"types.static_assert" {
                match self_host_fold_compile_time_assertion(module_, source, bindings) {
                  Ok(replacement) => {
                    module_.expressions[index] = replacement
                  }
                  Err(error) => self_host_compile_time_diagnose(lowering, module_, body, specialization, index, error)
                }
              }
              None => {}
            }
            None => {}
          }
        }
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  // Assertions no longer evaluate their operands after successful folding.
  let _ = self_host_prune_compile_time_body(module_, body)
}

fn self_host_fold_program_compile_time_queries(lowering: SelfHostPlannedProgramLowering) -> Unit {
  if lowering.compile_time.targets.length() == 0u32 && lowering.compile_time.sensitive.length() == 0u32 {
    return
  }
  let mut module_index = 0u32
  for module_ in lowering.modules {
    for body in module_.bodies {
      if lowering.compile_time.sensitive.contains_key(body.declaration) {
        if body.kind is ModuleLetBody {
          self_host_fold_compile_time_body(lowering, module_, body, 4294967295u32,
            self_host_empty_compile_time_bindings())
        }
        match self_host_program_specialization_callable(module_, body.declaration) {
          Some(callable) => if self_host_program_specialization_callable_generics(callable).length == 0u32 {
            let bindings = self_host_empty_compile_time_bindings()
            match callable.kind {
              PlannedImplMethodCallable(implementation, _) => {
                self_host_assert_array_index(callable.self_type, module_.resolved_types.types.length(), "LNK-504 concrete implementation Self type")
                match self_host_read_compile_time_type(module_, -self_host_body_u32_to_i32(callable.self_type) - 2i32, bindings, 0u32) {
                  Ok(self_type) => {
                    let concrete = match self_host_compile_time_types_concrete([self_type]) {
                      Ok(value) => value
                      Err(_) => false
                    }
                    self_host_assert_compiler_invariant(concrete, "SPC-301 concrete implementation Self type is unresolved")
                    bindings.selves.set(implementation, self_type)
                  }
                  Err(_) => {
                    self_host_assert_compiler_invariant(false, "SPC-301 concrete implementation Self type could not be read")
                    unreachable()
                  }
                }
              }
              _ => {}
            }
            self_host_fold_compile_time_body(lowering, module_, body, 4294967295u32, bindings)
          }
          None => {}
        }
      }
    }
    lowering.modules[module_index] = self_host_compile_time_initialization(lowering, module_index, module_)
    module_index = module_index + 1u32
  }
}

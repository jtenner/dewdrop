fn ct_module(machine: CtMachine, path: String) -> U32 {
  if !ct_charge(machine, 16u32) {
    return 4294967295u32
  }
  match ct_source_index(machine.plan).modules.get(path) {
    Some(index) => return index
    None => {
    }
  }
  let _ = ct_fail(machine, "compile-time module source is unavailable: ".concat(path))
  4294967295u32
}

fn ct_member(machine: CtMachine, mi: U32, name: String, exported: Bool) -> Option<String> {
  if !ct_charge(machine, 16u32) {
    return None
  }
  let state = match ct_source_index(machine.plan).sources[mi].members.get(name) {
    Some(member) => if exported {
      member.exported
    } else {
      member.local
    }
    None => CtSourceMemberState::Absent
  }
  match state {
    Absent => None
    Present => Some(machine.plan.manifest.modules[mi].path.concat("::").concat(name))
    Overloaded => {
      let _ = ct_fail(machine, "overloaded compile-time names are not supported: ".concat(name))
      None
    }
    Shadowed => {
      let _ = ct_fail(machine, "unsupported compile-time declaration shadows name: ".concat(name))
      None
    }
  }
}

fn ct_resolve(machine: CtMachine, mi: U32, name: String, alias_: Option<String>) -> String {
  if !ct_charge(machine, 16u32) {
    return ""
  }
  match alias_ {
    Some(alias_name) => {
      let path = match ct_source_index(machine.plan).sources[mi].aliases.get(alias_name) {
        Some(Some(path)) => path
        Some(None) => {
          let _ = ct_fail(machine, "ambiguous transform import alias")
          return ""
        }
        None => {
          let _ = ct_fail(machine, "unknown transform import alias: ".concat(alias_name))
          return ""
        }
      }
      let target = ct_module(machine, path)
      match ct_member(machine, target, name, true) {
        Some(key) => return key
        None => {
          let _ = ct_fail(machine, "unknown or non-public compile-time member: ".concat(name))
          return ""
        }
      }
    }
    None => {}
  }
  match ct_member(machine, mi, name, false) {
    Some(key) => return key
    None => {}
  }
  let mut result = ""
  for import_ in ct_source_index(machine.plan).sources[mi].opens {
    if import_.wildcard {
      let _ = ct_fail(machine, "wildcard imports are not supported by the transform interpreter")
      return ""
    }
    let target = ct_module(machine, import_.joined_path)
    match ct_member(machine, target, name, true) {
      Some(key) => {
        if result.byte_length() != 0u32 && result != key {
          let _ = ct_fail(machine, "ambiguous compile-time name")
          return ""
        }
        result = key
      }
      None => {}
    }
  }
  if result.byte_length() != 0u32 {
    return result
  }
  match ct_imported_type_name(machine, mi, name) {
    Some(key) => return key
    None => {}
  }
  let _ = ct_fail(machine, "unknown or unsupported compile-time name: ".concat(name))
  ""
}

fn ct_path_inner(machine: CtMachine, mi: U32, expression: SelfHostExpr) -> String {
  match expression {
    NameExpr(name, _) => ct_resolve(machine, mi, name, None)
    QualifiedExpr(ImportAliasExpr(alias_, _), name, _) => ct_resolve(machine, mi, name, Some(alias_))
    QualifiedExpr(owner, name, _) => ct_path(machine, mi, owner).concat("::").concat(name)
    _ => {
      let _ = ct_fail(machine, "compile-time calls require a direct function or enum constructor")
      ""
    }
  }
}

fn ct_variant_name(value: SelfHostEnumVariant) -> String {
  match value {
    UnitVariant(name, _, _) => name
    TupleVariant(name, _, _, _) => name
    StructVariant(name, _, _, _) => name
  }
}

fn ct_call(machine: CtMachine, key: String, args: Array<CtValue>) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  match machine.functions.get(key) {
    Some(Source(mi, path, function, _)) => return ct_source_call(machine, mi, path, function, args)
    _ => {
    }
  }
  match ct_source_index(machine.plan).entries.get(key) {
    Some(Source(mi, path, function, _)) => {
      if function.receiver is Some(_) {
        return ct_fail(machine, "method calls are not supported at compile time")
      }
      if args.length() != function.parameters.length() {
        return ct_fail(machine, "compile-time argument count mismatch")
      }
      if machine.plan.annotated_functions.get(ct_site_key(machine.plan, mi, path, function.offset)) is Some(_) {
        return ct_fail(machine, "compile-time calls to annotated functions are not supported")
      }
      machine.functions.set(key, CtCallTarget::Source(mi, path, function, ""))
      ct_source_call(machine, mi, path, function, args)
    }
    Some(Constructor(key)), Some(UnitConstructor(key)) => CtValue::Variant(key, args)
    Some(Intrinsic(_, _)) => ct_fail(machine, "builtin is not supported at compile time")
    _ => ct_fail(machine, "function is unavailable at compile time (host calls are forbidden): ".concat(key))
  }
}

fn ct_binary(machine: CtMachine, op: SelfHostBinaryOperator, left: CtValue, right: CtValue) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  match (left, right) {
    (DefaultValue, DefaultValue) => match op {
      Equal => CtValue::Boolean(true)
      LessEqual => CtValue::Boolean(true)
      GreaterEqual => CtValue::Boolean(true)
      NotEqual => CtValue::Boolean(false)
      Less => CtValue::Boolean(false)
      Greater => CtValue::Boolean(false)
      Add => CtValue::DefaultValue
      Subtract => CtValue::DefaultValue
      Multiply => CtValue::DefaultValue
      BitAnd => CtValue::DefaultValue
      BitOr => CtValue::DefaultValue
      BitXor => CtValue::DefaultValue
      ShiftLeft => CtValue::DefaultValue
      ShiftRight => CtValue::DefaultValue
      Divide => ct_fail(machine, "integer division by zero at compile time")
      Remainder => ct_fail(machine, "integer division by zero at compile time")
      _ => ct_fail(machine, "unsupported untyped default operator at compile time")
    }
    (DefaultValue, Number(_, kind)) => return ct_binary(machine, op, ct_number(0u64, kind), right)
    (Number(_, kind), DefaultValue) => return ct_binary(machine, op, left, ct_number(0u64, kind))
    (DefaultValue, Boolean(_)) => return ct_binary(machine, op, CtValue::Boolean(false), right)
    (Boolean(_), DefaultValue) => return ct_binary(machine, op, left, CtValue::Boolean(false))
    (Boolean(a), Number(b, "Bool")), (Number(b, "Bool"), Boolean(a)) => match op {
      Equal => CtValue::Boolean((if a {
        1u64
      } else {
        0u64
      }) == b)
      NotEqual => CtValue::Boolean((if a {
        1u64
      } else {
        0u64
      }) != b)
      _ => ct_fail(machine, "unsupported Bool operator at compile time")
    }
    (Boolean(a), Boolean(b)) => match op {
      Equal => CtValue::Boolean(a == b)
      NotEqual => CtValue::Boolean(a != b)
      _ => ct_fail(machine, "unsupported Bool operator at compile time")
    }
    (Floating(_, kind), Floating(_, other)) if kind == other => ct_float_binary(machine, op, left, right, kind)
    (Number(a, kind), Number(b, other)) if kind == other || (op is ShiftLeft) || (op is ShiftRight) => {
      let sa = ct_signed(a, kind)
      let sb = ct_signed(b, kind)
      let signed_ = kind.starts_with("I")
      match op {
        Add => ct_number(a + b, kind)
        Subtract => ct_number(a - b, kind)
        Multiply => ct_number(a * b, kind)
        BitAnd => ct_number(a & b, kind)
        BitOr => ct_number(a | b, kind)
        BitXor => ct_number(a ^ b, kind)
        ShiftLeft => ct_number(a << (b & if kind == "I64" || kind == "U64" {
          63u64
        } else {
          31u64
        }), kind)
        ShiftRight => {
          let amount = b & if kind == "I64" || kind == "U64" {
            63u64
          } else {
            31u64
          }
          ct_number(if signed_ {
            unsafe_bitcast::<I64, U64>(sa >> unsafe_bitcast::<U64, I64>(amount))
          } else {
            a >> amount
          }, kind)
        }
        Equal => CtValue::Boolean(a == b)
        NotEqual => CtValue::Boolean(a != b)
        Less => CtValue::Boolean(if signed_ {
          sa < sb
        } else {
          a < b
        })
        LessEqual => CtValue::Boolean(if signed_ {
          sa <= sb
        } else {
          a <= b
        })
        Greater => CtValue::Boolean(if signed_ {
          sa > sb
        } else {
          a > b
        })
        GreaterEqual => CtValue::Boolean(if signed_ {
          sa >= sb
        } else {
          a >= b
        })
        Divide => {
          if b == 0u64 {
            return ct_fail(machine, "division by zero in transform")
          }
          if signed_ && sb == -1i64 && (sa == -9223372036854775808i64 || (kind == "I32" && sa == -2147483648i64)) {
            return ct_fail(machine, "signed division overflow in transform")
          }
          ct_number(if signed_ {
            ct_i64_to_u64(sa / sb)
          } else {
            a / b
          }, kind)
        }
        Remainder => {
          if b == 0u64 {
            return ct_fail(machine, "division by zero in transform")
          }
          ct_number(if signed_ {
            if sb == -1i64 {
              0u64
            } else {
              ct_i64_to_u64(sa % sb)
            }
          } else {
            a % b
          }, kind)
        }
        _ => ct_fail(machine, "unsupported integer operator at compile time")
      }
    }
    _ => ct_fail(machine, "unsupported operands at compile time")
  }
}

fn ct_block(machine: CtMachine, mi: U32, block: SelfHostBlock, outer: CtEnvironment) -> CtValue {
  let env = ct_scope(machine, outer)
  let mut result = CtValue::Empty
  for item in block.items {
    if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
      return result
    }
    if !ct_charge(machine, 16u32) {
      return result
    }
    result = CtValue::Empty
    if item.kind == 0u32 {
      let value = ct_eval(machine, mi, item.value, env)
      env.set(item.name, {
        name: item.name
        value: value
        mutable_: item.mutable_
      })
    } else if item.kind == 3u32 {
      result = ct_eval(machine, mi, item.value, env)
    } else if item.kind == 1u32 {
      match item.target {
        NameExpr(name, _) => match env.get(name) {
          Some(cell) if cell.mutable_ => {
            cell.value = ct_eval(machine, mi, item.value, env)
          }
          _ => return ct_fail(machine, "assignment requires a mutable compile-time local")
        }
        FieldExpr(owner, name, _) => {
          let target = ct_eval(machine, mi, owner, env)
          if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
            return result
          }
          ct_write_field(machine, target, name, ct_eval(machine, mi, item.value, env))
        }
        _ => return ct_fail(machine, "unsupported assignment at compile time")
      }
    } else if item.type_binding is None {
      return ct_fail(machine, "unsupported assignment at compile time")
    }
  }
  result
}

fn ct_eval_values(machine: CtMachine, mi: U32, items: Array<SelfHostExpr>, env: CtEnvironment) -> Array<CtValue> {
  let values = array_new::<CtValue>()
  for item in items {
    if machine.error.byte_length() != 0u32 || machine.flow != 0u32 {
      return values
    }
    values.push(ct_eval(machine, mi, item, env))
  }
  values
}

fn ct_eval_fields(machine: CtMachine, mi: U32, items: Array<SelfHostObjectField>, env: CtEnvironment) -> Array<CtBinding> {
  let values = array_new::<CtBinding>()
  for item in items {
    if machine.error.byte_length() != 0u32 || machine.flow != 0u32 {
      return values
    }
    values.push(ct_binding(item.name, ct_eval(machine, mi, item.value, env)))
  }
  values
}

fn ct_eval(machine: CtMachine, mi: U32, expression: SelfHostExpr, env: CtEnvironment) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  if !ct_charge(machine, 16u32) {
    return CtValue::Empty
  }
  if machine.depth >= 128u32 {
    return ct_fail(machine, "transform depth limit exceeded")
  }
  machine.depth = machine.depth + 1u32
  let value = ct_eval_inner(machine, mi, expression, env)
  machine.depth = machine.depth - 1u32
  let scalar_read = match expression {
    NameExpr(_, _) => true
    FieldExpr(_, _, _) => true
    _ => false
  }
  if scalar_read {
    match ct_lookup_scalar_type(machine, mi, expression.offset()) {
      Some(kind) => return ct_intrinsic_result(machine, value, kind)
      _ => {
      }
    }
  }
  value
}

fn ct_eval_inner(machine: CtMachine, mi: U32, expression: SelfHostExpr, env: CtEnvironment) -> CtValue {
  match expression {
    BytesExpr(value, _) => {
      let _ = ct_charge(machine, value.byte_length())
      CtValue::ByteText(value)
    }
    F32Expr(value, _) => CtValue::Floating(u32_into_u64(wasm_f32_to_bits(value)), "F32")
    F64Expr(value, _) => CtValue::Floating(wasm_f64_to_bits(value), "F64")
    I8Expr(value, _) => ct_number(value, "I8")
    I16Expr(value, _) => ct_number(value, "I16")
    I32Expr(value, _) => ct_number(value, "I32")
    I64Expr(value, _) => ct_number(value, "I64")
    U8Expr(value, _) => ct_number(value, "U8")
    U16Expr(value, _) => ct_number(value, "U16")
    U32Expr(value, _) => ct_number(value, "U32")
    U64Expr(value, _) => ct_number(value, "U64")
    BoolExpr(value, _) => CtValue::Boolean(value)
    StringExpr(value, _) => {
      let _ = ct_charge(machine, value.byte_length())
      if !value.is_valid_utf8() {
        return ct_fail(machine, "invalid UTF-8 string at compile time")
      }
      CtValue::Text(value.to_string())
    }
    NameExpr(name, _) => match env.get(name) {
      Some(cell) => cell.value
      None => ct_function_reference(machine, mi, expression, env)
    }
    LambdaExpr(parameters, _, body, _) => CtValue::Closure(mi, machine.file_path, parameters, body, ct_scope(machine, env), machine.frame)
    ArrayExpr(items, offset) => ct_array_value(machine, mi, offset, ct_eval_values(machine, mi, items, env))
    ProductExpr(items, _) => if items.length() == 0u32 {
      CtValue::Empty
    } else {
      CtValue::Sequence(ct_eval_values(machine, mi, items, env))
    }
    BlockExpr(block) => ct_block(machine, mi, block, env)
    ObjectExpr(items, _) => ct_record("", ct_eval_fields(machine, mi, items, env))
    ConstructExpr(type_, items, _) => ct_record(ct_path(machine, mi, type_), ct_eval_fields(machine, mi, items, env))
    QualifiedExpr(_, _, _) => if ct_lookup_reference(machine, mi, expression.offset()) is Some(_) {
      ct_function_reference(machine, mi, expression, env)
    } else {
      ct_unit_variant(machine, ct_path(machine, mi, expression))
    }
    FieldExpr(owner, name, _) => if ct_lookup_reference(machine, mi, expression.offset()) is Some(_) {
      ct_function_reference(machine, mi, expression, env)
    } else {
      ct_field(machine, ct_eval(machine, mi, owner, env), name)
    }
    ProductFieldExpr(owner, index, _, _) => {
      let value = ct_eval(machine, mi, owner, env)
      if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
        return CtValue::Empty
      }
      match value {
        Sequence(values) if index < values.length() => values[index]
        _ => ct_fail(machine, "invalid compile-time product access")
      }
    }
    IfExpr(condition, yes, no, _) => {
      if ct_truth(machine, ct_eval(machine, mi, condition, env)) {
        ct_block(machine, mi, yes, env)
      } else {
        match no {
          Some(value) => ct_eval(machine, mi, value, env)
          None => CtValue::Empty
        }
      }
    }
    CallExpr(callee, args, offset) => ct_checked_call(machine, mi, offset, callee, args, env, [])
    ExplicitTypeCallExpr(callee, types, args, offset) => ct_checked_call(machine, mi, offset, callee, args, env, types)
    IndexExpr(owner, index, offset) => ct_selected_operator(machine, mi, offset, [ct_eval(machine, mi, owner, env), ct_eval(machine, mi, index, env)])
    BinaryExpr(LogicalAnd, left, right, _) => if ct_truth(machine, ct_eval(machine, mi, left, env)) {
      ct_eval(machine, mi, right, env)
    } else {
      CtValue::Boolean(false)
    }
    BinaryExpr(LogicalOr, left, right, _) => if ct_truth(machine, ct_eval(machine, mi, left, env)) {
      CtValue::Boolean(true)
    } else {
      ct_eval(machine, mi, right, env)
    }
    BinaryExpr(op, left, right, offset) => ct_scalar_binary(machine, mi, offset, op, ct_eval(machine, mi, left, env), ct_eval(machine, mi, right, env))
    PrefixExpr(op, expression, offset) => {
      let raw = ct_eval(machine, mi, expression, env)
      if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
        return CtValue::Empty
      }
      ct_scalar_prefix(machine, op, raw, ct_lookup_scalar_type(machine, mi, offset))
    }
    ReturnExpr(value, _) => {
      let result = match value {
        Some(expression) => ct_eval(machine, mi, expression, env)
        None => CtValue::Empty
      }
      if machine.flow == 0u32 {
        machine.flow = 1u32
        machine.result = result
      }
      result
    }
    BreakExpr(expression, _) => {
      let result = ct_eval(machine, mi, expression, env)
      if machine.flow == 0u32 {
        machine.flow = 2u32
        machine.result = result
      }
      result
    }
    ContinueExpr(expression, _) => {
      let result = ct_eval(machine, mi, expression, env)
      if machine.flow == 0u32 {
        machine.flow = 3u32
        machine.result = result
      }
      result
    }
    MatchExpr(expression, arms, _) => ct_match(machine, mi, expression, arms, env, false)
    WhileExpr(expression, arms, _) => ct_match(machine, mi, expression, arms, env, true)
    _ => ct_fail(machine, "expression is not supported by the transform interpreter")
  }
}

fn ct_pattern_path_inner(machine: CtMachine, mi: U32, pattern: SelfHostPattern) -> String {
  let key = ct_checked_pattern_key(machine, mi, pattern.offset())
  if key.byte_length() == 0u32 {
    let _ = ct_fail(machine, "expected a checked enum constructor pattern")
    return ""
  }
  key
}

fn ct_pattern_inner(machine: CtMachine, mi: U32, pattern: SelfHostPattern, value: CtValue, env: CtEnvironment) -> Bool {
  match pattern {
    WildcardPattern(_) => true
    BindingPattern(name, offset) => {
      let constructor = ct_checked_pattern_key(machine, mi, offset)
      if machine.error.byte_length() != 0u32 {
        return false
      }
      if constructor.byte_length() == 0u32 {
        env.set(name, ct_binding(name, value))
        true
      } else {
        match value {
          Variant(key, values) => key == constructor && values.length() == 0u32
          _ => false
        }
      }
    }
    LiteralPattern(expression, _) => ct_literal_pattern_equal(machine, ct_eval(machine, mi, expression, env), value)
    ProductPattern(patterns, _) => match value {
      Empty if patterns.length() == 0u32 => true
      DefaultValue if patterns.length() == 0u32 => true
      Sequence(values) if values.length() == patterns.length() => {
        let mut index = 0u32
        for item in patterns {
          if !ct_pattern(machine, mi, item, values[index], env) {
            return false
          }
          index = index + 1u32
        }
        true
      }
      _ => false
    }
    QualifiedPattern(_, _, _) => {
      let constructor = ct_pattern_path_inner(machine, mi, pattern)
      match value {
        Variant(key, values) => key == constructor && values.length() == 0u32
        _ => false
      }
    }
    StructPattern(_, patterns, _, offset) => match value {
      ReferenceView(_, _) => {
        for pattern in patterns {
          if !ct_pattern(machine, mi, pattern.pattern, ct_field(machine, value, pattern.name), env) {
            return false
          }
        }
        true
      }
      Record(key, values) => {
        let expected = ct_checked_pattern_key(machine, mi, offset)
        if machine.error.byte_length() != 0u32 || (key.byte_length() != 0u32 && key != expected) {
          return false
        }
        for pattern in patterns {
          match ct_lookup(machine, values, pattern.name) {
            Some(item) => if !ct_pattern(machine, mi, pattern.pattern, item.value, env) {
              return false
            }
            None => return false
          }
        }
        true
      }
      _ => false
    }
    AlternativePattern(first, rest, _) => {
      let choices = [first]
      for choice in rest {
        choices.push(choice)
      }
      for choice in choices {
        let scope = ct_scope(machine, env)
        if ct_pattern(machine, mi, choice, value, scope) {
          let entries = scope.entries()
          while entries.has_next() {
            true => {
              let entry = map_entry_iter_next(entries)
              env.set(entry.key, entry.value)
              continue entries.has_next()
            }
            false => break ()
          }
          return true
        }
      }
      false
    }
    TuplePattern(_, patterns, _) => match value {
      Variant(key, values) if key == ct_pattern_path(machine, mi, pattern) && values.length() == patterns.length() => {
        let mut index = 0u32
        for item in patterns {
          if !ct_pattern(machine, mi, item, values[index], env) {
            return false
          }
          index = index + 1u32
        }
        true
      }
      _ => false
    }
    _ => {
      let _ = ct_fail(machine, "pattern is not supported by the transform interpreter")
      false
    }
  }
}

fn ct_match(machine: CtMachine, mi: U32, expression: SelfHostExpr, arms: Array<SelfHostPatternArm>, env: CtEnvironment, loop_: Bool) -> CtValue {
  let mut value = ct_eval(machine, mi, expression, env)
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return value
  }
  let _ = while 0u32 {
    _ => {
      if machine.flow != 0u32 || (loop_ && !ct_charge(machine, 0u32)) {
        return CtValue::Empty
      }
      let mut matched = false
      for arm in arms {
        if !matched {
          let scope = ct_scope(machine, env)
          if ct_pattern(machine, mi, arm.pattern, value, scope) {
            let allowed = match arm.guard_condition {
              Some(guard_) => ct_truth(machine, ct_eval(machine, mi, guard_, scope))
              None => true
            }
            if machine.error.byte_length() != 0u32 {
              return CtValue::Empty
            }
            if machine.flow != 0u32 {
              if !loop_ || machine.flow == 1u32 {
                return machine.result
              }
              if machine.flow == 2u32 {
                machine.flow = 0u32
                return machine.result
              }
              value = machine.result
              machine.flow = 0u32
              matched = true
            } else if allowed {
              matched = true
              let result = ct_eval(machine, mi, arm.body, scope)
              if !loop_ {
                return result
              }
              if machine.flow == 2u32 {
                machine.flow = 0u32
                return machine.result
              }
              if machine.flow == 3u32 {
                value = machine.result
                machine.flow = 0u32
              } else if machine.flow != 0u32 {
                return machine.result
              }
            }
          }
        }
        if matched {
          break ()
        }
      }
      if !matched {
        if !loop_ {
          return ct_fail(machine, "non-exhaustive match during transform execution")
        }
        return CtValue::Empty
      }
      continue 0u32
    }
  }
  CtValue::Empty
}

fn ct_path(machine: CtMachine, mi: U32, expression: SelfHostExpr) -> String {
  if !ct_charge(machine, 16u32) {
    return ""
  }
  if machine.depth >= 128u32 {
    let _ = ct_fail(machine, "transform depth limit exceeded")
    return ""
  }
  machine.depth = machine.depth + 1u32
  let result = ct_path_inner(machine, mi, expression)
  machine.depth = machine.depth - 1u32
  result
}

fn ct_pattern_path(machine: CtMachine, mi: U32, pattern: SelfHostPattern) -> String {
  if !ct_charge(machine, 16u32) {
    return ""
  }
  if machine.depth >= 128u32 {
    let _ = ct_fail(machine, "transform depth limit exceeded")
    return ""
  }
  machine.depth = machine.depth + 1u32
  let result = ct_pattern_path_inner(machine, mi, pattern)
  machine.depth = machine.depth - 1u32
  result
}

fn ct_pattern(machine: CtMachine, mi: U32, pattern: SelfHostPattern, value: CtValue, env: CtEnvironment) -> Bool {
  if !ct_charge(machine, 16u32) {
    return false
  }
  if machine.depth >= 128u32 {
    let _ = ct_fail(machine, "transform depth limit exceeded")
    return false
  }
  machine.depth = machine.depth + 1u32
  let result = ct_pattern_inner(machine, mi, pattern, value, env)
  machine.depth = machine.depth - 1u32
  result
}

fn ct_literal_pattern_equal(machine: CtMachine, expected: CtValue, value: CtValue) -> Bool {
  match (expected, value) {
    (Text(a), Text(b)) => a == b
    (Text(a), TextReference(_)) => a == ct_string(machine, value)
    (Floating(a, "F32"), Floating(b, "F32")) => wasm_f32_from_bits(u64_into_u32(a)) == wasm_f32_from_bits(u64_into_u32(b))
    (Floating(a, "F64"), Floating(b, "F64")) => wasm_f64_from_bits(a) == wasm_f64_from_bits(b)
    (Number(number, _), DefaultValue) => number == 0u64
    (Boolean(flag), DefaultValue) => !flag
    (Boolean(a), Number(bits, "Bool")), (Number(bits, "Bool"), Boolean(a)) => (if a {
      1u64
    } else {
      0u64
    }) == bits
    (Number(a, "Bool"), Number(b, "Bool")) => a == b
    (Number(a, kind), other) => match ct_intrinsic_result(machine, other, kind) {
      Number(b, _) => a == b
      _ => false
    }
    (Boolean(a), other) => match ct_intrinsic_result(machine, other, "Bool") {
      Boolean(b) => a == b
      _ => false
    }
    _ => {
      let _ = ct_fail(machine, "unsupported equality in compile-time pattern")
      false
    }
  }
}

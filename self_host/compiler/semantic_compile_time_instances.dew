open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

fn self_host_clone_compile_time_module(source: SelfHostPlannedModuleLowering) -> SelfHostPlannedModuleLowering {
  let projections = self_host_query_module_has_projections(source)
  let resolved = self_host_clone_query_resolved(source.resolved_types)
  let functions = if projections {
    self_host_clone_query_functions(source.functions)
  } else {
    source.functions
  }
  SelfHostPlannedModuleLowering::{
    module_id: source.module_id
    names: source.names.copy()
    name_diagnostics: source.name_diagnostics.copy()
    resolved_types: resolved
    type_layouts: source.type_layouts
    initialization: source.initialization
    functions: functions
    bodies: source.bodies.copy()
    lambdas: source.lambdas.copy()
    locals: source.locals.copy()
    captures: source.captures.copy()
    expressions: source.expressions.copy()
    blocks: source.blocks.copy()
    block_items: source.block_items.copy()
    object_fields: source.object_fields.copy()
    named_fields: source.named_fields.copy()
    named_variants: source.named_variants.copy()
    patterns: source.patterns.copy()
    pattern_fields: source.pattern_fields.copy()
    pattern_arms: source.pattern_arms.copy()
    expression_children: source.expression_children.copy()
    pattern_children: source.pattern_children.copy()
    arm_children: source.arm_children.copy()
    inferred: self_host_clone_query_inferred(source.inferred)
    evidence: self_host_clone_query_evidence(source.evidence)
    flow_diagnostics: source.flow_diagnostics.copy()
  }
}

fn self_host_program_function_lowering(lowering: SelfHostPlannedProgramLowering, owner: U32, specialization: U32) -> SelfHostPlannedModuleLowering {
  self_host_assert_array_index(owner, lowering.modules.length(), "ARN-104 selected module owner")
  match lowering.compile_time.instances.get(specialization) {
    Option::Some(instance) => {
      let module_ = instance.module_
      self_host_assert_compiler_invariant(module_.module_id == lowering.modules[owner].module_id, "LNK-504 selected query instance has the wrong owner")
      module_
    }
    Option::None => lowering.modules[owner]
  }
}

fn self_host_prepare_compile_time_instance(lowering: SelfHostPlannedProgramLowering, specialization: U32, requests: Array<SelfHostProgramSpecializationRequest>) -> Unit {
  self_host_assert_array_index(specialization, requests.length(), "SPC-301 query instance request")
  let request = requests[specialization]
  if !lowering.compile_time.sensitive.contains_key(request.declaration) {
    return
  }
  match lowering.compile_time.instances.get(specialization) {
    Option::Some(instance) => {
      self_host_assert_compiler_invariant(instance.declaration == request.declaration && self_host_specialization_evidence_types_equal(instance.evidence_types, request.evidence_types), "SPC-302 query instance request identity changed")
      return
    }
    Option::None => {}
  }
  let owner = match lowering.index.declaration_owner(request.declaration) {
    Option::Some(owner) => owner
    Option::None => {
      self_host_assert_compiler_invariant(false, "LNK-504 query instance has no module owner")
      unreachable()
    }
  }
  let mut module_ = self_host_clone_compile_time_module(lowering.modules[owner])
  let caller = self_host_program_specialization_callable(module_, request.declaration)
  let bindings = self_host_compile_time_caller_bindings(caller, specialization, requests)
  match caller {
    Option::Some(callable) => match callable.kind {
      SelfHostPlannedCallableKind::PlannedImplMethodCallable(implementation, _) => {
        let collected = lowering.collected.modules.at(owner)
        let mut target = 4294967295u32
        let _ = while 0u32 {
          index => if index < collected.impls.length() {
            if collected.impls[index].declaration == implementation {
              self_host_assert_array_index(index, module_.resolved_types.impl_target_types.length(), "ARN-103 implementation Self types")
              target = module_.resolved_types.impl_target_types[index]
              break self_host_semantic_unit()
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        self_host_assert_array_index(target, module_.resolved_types.types.length(), "LNK-504 query instance implementation Self type")
        match self_host_read_compile_time_type(module_, -self_host_body_u32_to_i32(target) - 2i32, bindings, 0u32) {
          Result::Ok(self_type) => {
            let concrete = match self_host_compile_time_types_concrete([self_type]) {
              Result::Ok(value) => value
              Result::Err(_) => false
            }
            self_host_assert_compiler_invariant(concrete, "SPC-301 implementation Self type is not concrete")
            bindings.set(implementation, self_type)
          }
          Result::Err(_) => {
            self_host_assert_compiler_invariant(false, "SPC-301 implementation Self type could not be resolved")
            unreachable()
          }
        }
      }
      _ => {}
    }
    Option::None => {}
  }
  lowering.compile_time.instances.set(specialization, SelfHostCompileTimeInstance::{
    declaration: request.declaration
    evidence_types: request.evidence_types.copy()
    module_: module_
    guarded_evidence: self_host_empty_guarded_evidence()
  })
  let needs_recheck = self_host_compile_time_body_needs_recheck(module_, request.declaration)
  let conditions = self_host_empty_u32_bool_map()
  for body in module_.bodies {
    if body.declaration == request.declaration {
      self_host_fold_compile_time_body_with_conditions(lowering, module_, body, specialization, bindings, Option::Some(conditions))
    }
  }
  if needs_recheck {
    module_ = self_host_recheck_compile_time_body(lowering, owner, request.declaration, specialization, bindings, conditions, module_)
    self_host_materialize_query_instance_types(lowering, module_, module_, bindings, request.declaration, specialization)
  } else {
    self_host_materialize_query_instance_types(lowering, lowering.modules[owner], module_, bindings, request.declaration, specialization)
  }
}

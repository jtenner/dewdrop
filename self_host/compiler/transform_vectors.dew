fn ct_vector_byte(machine: CtMachine, value: CtValue, lane: U32) -> U64 {
  match value {
    Vector(low, high) if lane < 16u32 => if lane < 8u32 {
      (low >> u32_into_u64(lane * 8u32)) & 255u64
    } else {
      (high >> u32_into_u64((lane - 8u32) * 8u32)) & 255u64
    }
    _ => {
      let _ = ct_fail(machine, "Wasm vector instruction requires a 128-bit vector and valid lane")
      0u64
    }
  }
}

fn ct_vector_replace(machine: CtMachine, value: CtValue, lane: U32, byte: U64) -> CtValue {
  match value {
    Vector(low, high) if lane < 16u32 => if lane < 8u32 {
      let shift = u32_into_u64(lane * 8u32)
      CtValue::Vector((low & ((255u64 << shift) ^ 18446744073709551615u64)) | ((byte & 255u64) << shift), high)
    } else {
      let shift = u32_into_u64((lane - 8u32) * 8u32)
      CtValue::Vector(low, (high & ((255u64 << shift) ^ 18446744073709551615u64)) | ((byte & 255u64) << shift))
    }
    _ => ct_fail(machine, "Wasm vector lane out of bounds at compile time")
  }
}

fn ct_vector_intrinsic(machine: CtMachine, opcode: String, args: Array<CtValue>) -> CtValue {
  if opcode == "i64x2.splat" && args.length() == 1u32 {
    let bits = ct_raw_bits(machine, args[0u32])
    return CtValue::Vector(bits, bits)
  }
  if opcode == "v128.bitselect" && args.length() == 3u32 {
    match (args[0u32], args[1u32], args[2u32]) {
      (Vector(al, ah), Vector(bl, bh), Vector(ml, mh)) => return CtValue::Vector(
        (al & ml) | (bl & (ml ^ 18446744073709551615u64)),
        (ah & mh) | (bh & (mh ^ 18446744073709551615u64)),
      )
      _ => return ct_fail(machine, "Wasm vector instruction requires 128-bit vectors")
    }
  }
  if opcode == "i8x16.splat" && args.length() == 1u32 {
    let lane = ct_raw_bits(machine, args[0u32]) & 255u64
    let packed = lane * 72340172838076673u64
    return CtValue::Vector(packed, packed)
  }
  if (opcode == "i8x16.eq" || opcode == "i8x16.swizzle" || opcode == "i8x16.add" || opcode == "i8x16.sub" || opcode == "v128.or" || opcode == "v128.and" || opcode == "v128.xor" || opcode == "i8x16.lt_u") && args.length() == 2u32 {
    let mut result = CtValue::Vector(0u64, 0u64)
    let _ = while 0u32 {
      lane if lane < 16u32 => {
        let a = ct_vector_byte(machine, args[0u32], lane)
        let b = ct_vector_byte(machine, args[1u32], lane)
        let byte = if opcode == "i8x16.add" {
          a + b
        } else if opcode == "i8x16.sub" {
          a - b
        } else if opcode == "v128.or" {
          a | b
        } else if opcode == "v128.and" {
          a & b
        } else if opcode == "v128.xor" {
          a ^ b
        } else if opcode == "i8x16.lt_u" {
          if a < b {
            255u64
          } else {
            0u64
          }
        } else if opcode == "i8x16.eq" {
          if ct_vector_byte(machine, args[0u32], lane) == ct_vector_byte(machine, args[1u32], lane) {
            255u64
          } else {
            0u64
          }
        } else {
          let index = ct_vector_byte(machine, args[1u32], lane)
          if index < 16u64 {
            ct_vector_byte(machine, args[0u32], u64_into_u32(index))
          } else {
            0u64
          }
        }
        result = ct_vector_replace(machine, result, lane, byte)
        continue lane + 1u32
      }
      _ => break ()
    }
    return result
  }
  if opcode == "i8x16.bitmask" && args.length() == 1u32 {
    let mut result = 0u64
    let _ = while 0u32 {
      lane if lane < 16u32 => {
        result = result | ((ct_vector_byte(machine, args[0u32], lane) >> 7u64) << u32_into_u64(lane))
        continue lane + 1u32
      }
      _ => break ()
    }
    return ct_number(result, "U32")
  }
  if args.length() == 1u32 {
    match ct_raw_immediate(opcode, "i8x16.extract_lane_u ") {
      Some(lane) => return ct_number(ct_vector_byte(machine, args[0u32], lane), "U8")
      None => {}
    }
  }
  if args.length() == 2u32 {
    match ct_raw_immediate(opcode, "i64x2.replace_lane ") {
      Some(lane) => match args[0u32] {
        Vector(low, high) if lane < 2u32 => return if lane == 0u32 {
          CtValue::Vector(ct_raw_bits(machine, args[1u32]), high)
        } else {
          CtValue::Vector(low, ct_raw_bits(machine, args[1u32]))
        }
        _ => return ct_fail(machine, "Wasm vector lane out of bounds at compile time")
      }
      None => {}
    }
    match ct_raw_immediate(opcode, "i8x16.replace_lane ") {
      Some(lane) => return ct_vector_replace(machine, args[0u32], lane, ct_raw_bits(machine, args[1u32]))
      None => {}
    }
  }
  ct_fail(machine, "unsupported Wasm vector intrinsic: ".concat(opcode))
}

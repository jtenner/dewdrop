fn ct_vector_byte(machine: CtMachine, value: CtValue, lane: U32) -> U64 {
  match value {
    Vector(low, high) if lane < 16u32 => if lane < 8u32 {
      (low >> u32_into_u64(lane * 8u32)) & 255u64
    } else {
      (high >> u32_into_u64((lane - 8u32) * 8u32)) & 255u64
    }
    _ => {
      let _ = ct_fail(machine, "Wasm vector instruction requires a 128-bit vector and valid lane")
      0u64
    }
  }
}

fn ct_vector_replace(machine: CtMachine, value: CtValue, lane: U32, byte: U64) -> CtValue {
  match value {
    Vector(low, high) if lane < 16u32 => if lane < 8u32 {
      let shift = u32_into_u64(lane * 8u32)
      CtValue::Vector((low & ((255u64 << shift) ^ 18446744073709551615u64)) | ((byte & 255u64) << shift), high)
    } else {
      let shift = u32_into_u64((lane - 8u32) * 8u32)
      CtValue::Vector(low, (high & ((255u64 << shift) ^ 18446744073709551615u64)) | ((byte & 255u64) << shift))
    }
    _ => ct_fail(machine, "Wasm vector lane out of bounds at compile time")
  }
}

open dew.std.array
open dew.std.map
open dew.std.option

pub enum SelfHostBodyInferenceDiagnostic {
  BodyConstraintDiagnostic(SelfHostLocalInferenceDiagnostic)
  NumericLiteralOutOfRange(U32, SelfHostPrimitiveType, U32)
  UnsupportedExpressionInference(U32, U32)
  InvalidAssignmentTarget(U32, U32)
  ImmutableAssignmentTarget(U32, U32)
  ReturnOutsideCallable(U32)
  CallArgumentCountMismatch(U32, U64, U32, U32, U32)
  NoMatchingDirectCall(U32, U32, U32)
  AmbiguousDirectCall(U32, U32, U64, U64, U32, U32)
  FieldAccessRequiresNominal(U32, U32)
  UnknownFieldForType(U32, U64, U32, U32)
  InvalidConstructionTarget(U32, U32)
  UnknownConstructionField(U32, U32, U64, U32)
  MissingConstructionField(U32, U32, U64, U32)
  MissingImportedConstructionField(U32, String, U64, U32)
  DuplicateConstructionField(U32, U32, U32)
  NoMatchingMethod(U32, U32, U32)
  AmbiguousMethod(U32, U32, U64, U64, U32, U32)
  UnknownQualifiedMember(U32, U64, U32, U32)
  ConstructionPayloadKindMismatch(U32, U64, U32)
  ConstructionPayloadArityMismatch(U32, U64, U32, U32, U32)
  NoMatchingOperator(U32, U32)
  AmbiguousOperator(U32, U64, U64, U32, U32)
  InvalidPatternConstructor(U32, U32)
  PatternPayloadKindMismatch(U32, U64, U32)
  PatternPayloadArityMismatch(U32, U32, U32, U32)
  UnknownPatternField(U32, U32, U32)
  MissingPatternField(U32, U32, U32)
  MissingImportedPatternField(String, U32, U32)
  UnresolvedExpressionType(U32, U32)
  UnresolvedLocalType(U64, U32, U32)
}

impl SelfHostBodyInferenceDiagnostic {
  fn offset(self) -> U32 {
    match self {
      SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(diagnostic) => diagnostic.offset()
      SelfHostBodyInferenceDiagnostic::NumericLiteralOutOfRange(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnsupportedExpressionInference(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::InvalidAssignmentTarget(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::ImmutableAssignmentTarget(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::ReturnOutsideCallable(offset) => offset
      SelfHostBodyInferenceDiagnostic::CallArgumentCountMismatch(_, _, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::AmbiguousDirectCall(_, _, _, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::FieldAccessRequiresNominal(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnknownFieldForType(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnknownConstructionField(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::MissingConstructionField(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::MissingImportedConstructionField(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::DuplicateConstructionField(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::NoMatchingMethod(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::AmbiguousMethod(_, _, _, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnknownQualifiedMember(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::ConstructionPayloadKindMismatch(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::ConstructionPayloadArityMismatch(_, _, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::NoMatchingOperator(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::AmbiguousOperator(_, _, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::PatternPayloadArityMismatch(_, _, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnknownPatternField(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::MissingPatternField(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::MissingImportedPatternField(_, _, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnresolvedExpressionType(_, offset) => offset
      SelfHostBodyInferenceDiagnostic::UnresolvedLocalType(_, _, offset) => offset
    }
  }
}

enum SelfHostSignatureInstantiationTask {
  VisitSignatureType(U32)
  FinishSignatureProduct(U32, U32)
  FinishSignatureApplication(U32, U32)
  FinishSignatureFunction(U32, U32)
}

pub enum SelfHostBasicExpressionSelection {
  NoBasicExpressionSelection
  ErrorBasicExpressionSelection
  FieldBasicExpressionSelection(U64, Bool)
  StructConstructionBasicExpressionSelection(U64, SelfHostHirSpan)
  VariantConstructionBasicExpressionSelection(U64, U32, SelfHostHirSpan)
}

pub enum SelfHostBasicPatternConstructor {
  NoBasicPatternConstructor
  ErrorBasicPatternConstructor
  SelectedBasicPatternConstructor(U64, Bool, SelfHostHirSpan)
}

pub enum SelfHostBasicObjectFieldTarget {
  NoBasicObjectFieldTarget
  ErrorBasicObjectFieldTarget
  SelectedBasicObjectFieldTarget(U64)
}

pub enum SelfHostBasicCallTarget {
  NoBasicCallTarget
  ErrorBasicCallTarget
  SelectedBasicCallTarget(U64, SelfHostHirSpan)
  FunctionValueBasicCallTarget(U32)
}

pub struct SelfHostBasicInferredBody {
  body: U64
  root_type: I32
  types: Array<SelfHostBodyTypeTerm>
  type_arguments: Array<I32>
  expression_types: Array<I32>
  local_types: Array<I32>
  block_types: Array<I32>
  pattern_types: Array<I32>
  control_state_types: Array<I32>
  control_result_types: Array<I32>
  call_targets: Array<SelfHostBasicCallTarget>
  operator_targets: Array<SelfHostBasicCallTarget>
  expression_selections: Array<SelfHostBasicExpressionSelection>
  object_field_targets: Array<SelfHostBasicObjectFieldTarget>
  pattern_constructors: Array<SelfHostBasicPatternConstructor>
  call_type_arguments: Array<I32>
  expression_type_arguments: Array<I32>
  pattern_type_arguments: Array<I32>
  unsupported_expressions: Array<Bool>
  diagnostics: Array<SelfHostBodyInferenceDiagnostic>
}

impl SelfHostBasicInferredBody {
  fn expression_type(self, body: SelfHostHirBody, expression: U32) -> I32 {
    self.expression_types[expression - body.expressions.start]
  }

  fn local_type(self, local: U32) -> I32 {
    self.local_types[local]
  }

  fn call_target(self, body: SelfHostHirBody, expression: U32) -> SelfHostBasicCallTarget {
    self.call_targets[expression - body.expressions.start]
  }

  fn operator_target(self, body: SelfHostHirBody, expression: U32) -> SelfHostBasicCallTarget {
    self.operator_targets[expression - body.expressions.start]
  }

  fn expression_selection(
    self,
    body: SelfHostHirBody,
    expression: U32,
  ) -> SelfHostBasicExpressionSelection {
    self.expression_selections[expression - body.expressions.start]
  }

  fn pattern_constructor(
    self,
    body: SelfHostHirBody,
    pattern: U32,
  ) -> SelfHostBasicPatternConstructor {
    self.pattern_constructors[pattern - body.patterns.start]
  }

  fn object_field_target(
    self,
    body: SelfHostHirBody,
    field: U32,
  ) -> SelfHostBasicObjectFieldTarget {
    self.object_field_targets[field - body.object_fields.start]
  }

  fn call_type_argument(self, index: U32) -> I32 {
    self.call_type_arguments[index]
  }

  fn diagnostic_count(self) -> U32 {
    self.diagnostics.length()
  }

  fn diagnostic_at(self, index: U32) -> SelfHostBodyInferenceDiagnostic {
    self.diagnostics[index]
  }

  fn type_term(self, type_: I32) -> SelfHostBodyTypeTerm {
    if type_ < -1i32 {
      SelfHostBodyTypeTerm::BodyResolvedType(
        self_host_body_i32_to_u32(-type_ - 2i32),
      )
    } else if type_ >= 0i32 {
      self.types[self_host_body_i32_to_u32(type_)]
    } else {
      SelfHostBodyTypeTerm::BodyErrorType
    }
  }
}

fn self_host_basic_inference_diagnostic_count(
  body: SelfHostBasicInferredBody,
) -> U32 {
  body.diagnostics.length()
}

fn self_host_basic_inference_diagnostic_at(
  body: SelfHostBasicInferredBody,
  index: U32,
) -> SelfHostBodyInferenceDiagnostic {
  body.diagnostics[index]
}

pub struct SelfHostBasicInferredModuleBodies {
  module_id: U64
  bodies: Array<SelfHostBasicInferredBody>
}

impl SelfHostBasicInferredModuleBodies {
  fn body(self, body: U64) -> Option<SelfHostBasicInferredBody> {
    if self_host_semantic_id_module(body) != self.module_id {
      Option::None
    } else {
      let index = self_host_semantic_id_local(body)
      if index < self.bodies.length() {
        Option::Some(self.bodies[index])
      } else {
        Option::None
      }
    }
  }
}

fn self_host_basic_expression_offset(expression: SelfHostHirExpr) -> U32 {
  expression.offset()
}

fn self_host_inference_i32_slots(length: U32, value: I32) -> Array<I32> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(value)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_store_basic_pattern_constructor(
  slots: Array<SelfHostBasicPatternConstructor>,
  index: U32,
  constructor: SelfHostBasicPatternConstructor,
) -> Unit {
  slots[index] = constructor
}

fn self_host_store_basic_call_target(
  slots: Array<SelfHostBasicCallTarget>,
  index: U32,
  target: SelfHostBasicCallTarget,
) -> Unit {
  slots[index] = target
}

fn self_host_store_basic_expression_selection(
  slots: Array<SelfHostBasicExpressionSelection>,
  index: U32,
  selection: SelfHostBasicExpressionSelection,
) -> Unit {
  slots[index] = selection
}

fn self_host_basic_string_equal(left: String, right: String) -> Bool {
  left == right
}

fn self_host_store_inference_type(
  slots: Array<I32>,
  index: U32,
  type_: I32,
) -> Unit {
  slots[index] = type_
}

fn self_host_inference_pattern_constructor_slots(
  length: U32,
) -> Array<SelfHostBasicPatternConstructor> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(SelfHostBasicPatternConstructor::NoBasicPatternConstructor)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_inference_object_field_target_slots(
  length: U32,
) -> Array<SelfHostBasicObjectFieldTarget> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(SelfHostBasicObjectFieldTarget::NoBasicObjectFieldTarget)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_inference_expression_selection_slots(
  length: U32,
) -> Array<SelfHostBasicExpressionSelection> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(SelfHostBasicExpressionSelection::NoBasicExpressionSelection)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_inference_call_target_slots(
  length: U32,
) -> Array<SelfHostBasicCallTarget> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(SelfHostBasicCallTarget::NoBasicCallTarget)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_inference_bool_slots(length: U32) -> Array<Bool> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_basic_empty_type_declaration_map() -> Map<U64, U32> {
  Map::empty()
}

struct SelfHostBasicImportedInputs {
  callables: Array<SelfHostResolvedImportedCallable>
  generic_parameter_ids: Array<U64>
  parameter_types: Array<U32>
  parameter_receivers: Array<Bool>
  implementations: Array<SelfHostResolvedImportedImplementation>
  fields: Array<SelfHostResolvedImportedField>
  variants: Array<SelfHostResolvedImportedVariant>
  variant_payload_types: Array<U32>
  type_declaration_types: Map<U64, U32>
  type_generic_spans: Map<U64, SelfHostHirSpan>
  module_value_types: Map<U64, U32>
}

struct SelfHostBasicBodyInferencer {
  collected: SelfHostCollectedModule
  resolved: SelfHostResolvedModuleTypes
  names: SelfHostResolvedModuleNames
  imported: SelfHostBasicImportedInputs
  body: SelfHostHirBody
  name_info: SelfHostResolvedBodyNames
  solver: SelfHostLocalTypeSolver
  expression_types: Array<I32>
  local_types: Array<I32>
  block_types: Array<I32>
  pattern_types: Array<I32>
  control_state_types: Array<I32>
  control_result_types: Array<I32>
  call_targets: Array<SelfHostBasicCallTarget>
  operator_targets: Array<SelfHostBasicCallTarget>
  expression_selections: Array<SelfHostBasicExpressionSelection>
  object_field_targets: Array<SelfHostBasicObjectFieldTarget>
  pattern_constructors: Array<SelfHostBasicPatternConstructor>
  unsupported_expressions: Array<Bool>
  consumed_member_roots: Array<Bool>
  consumed_pattern_roots: Array<Bool>
  diagnostics: Array<SelfHostBodyInferenceDiagnostic>
  instantiation_tasks: Array<SelfHostSignatureInstantiationTask>
  instantiation_results: Array<I32>
  candidate_type_arguments: Array<I32>
  imported_instantiation_generics: Array<U64>
  call_type_arguments: Array<I32>
  expression_type_arguments: Array<I32>
  pattern_type_arguments: Array<I32>
  pending_direct_calls: Array<U32>
  pending_method_calls: Array<U32>
  pending_variant_calls: Array<U32>
  pending_variant_values: Array<U32>
  pending_operators: Array<U32>
  pending_constructions: Array<U32>
  pending_fields: Array<U32>
  mut instantiation_generics: SelfHostHirSpan
  mut instantiation_method_generics: SelfHostHirSpan
  mut instantiation_self_owner: U64
  mut instantiation_self_type: I32
  mut callable_index: U32
  mut declared_return_type: I32
  mut result_type: I32
}

impl SelfHostBasicBodyInferencer {
  fn new(
    collected: SelfHostCollectedModule,
    resolved: SelfHostResolvedModuleTypes,
    names: SelfHostResolvedModuleNames,
    imported: SelfHostBasicImportedInputs,
    body: SelfHostHirBody,
    name_info: SelfHostResolvedBodyNames,
  ) -> SelfHostBasicBodyInferencer {
    let mut callable_index = 4294967295u32
    let mut index = 0u32
    let _ = while index {
      current => if current < collected.callables.length() {
        if self_host_u64_equal(
          collected.callables[current].declaration,
          body.declaration,
        ) {
          callable_index = current
          break self_host_semantic_unit()
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    SelfHostBasicBodyInferencer::{
      collected: collected
      resolved: resolved
      names: names
      imported: imported
      body: body
      name_info: name_info
      solver: SelfHostLocalTypeSolver::new(resolved)
      expression_types: self_host_inference_i32_slots(body.expressions.length, 0i32)
      local_types: self_host_inference_i32_slots(name_info.locals.length, 0i32)
      block_types: self_host_inference_i32_slots(body.blocks.length, 0i32)
      pattern_types: self_host_inference_i32_slots(body.patterns.length, 0i32)
      control_state_types: self_host_inference_i32_slots(name_info.controls.length, 0i32)
      control_result_types: self_host_inference_i32_slots(name_info.controls.length, 0i32)
      call_targets: self_host_inference_call_target_slots(body.expressions.length)
      operator_targets: self_host_inference_call_target_slots(body.expressions.length)
      expression_selections: self_host_inference_expression_selection_slots(body.expressions.length)
      object_field_targets: self_host_inference_object_field_target_slots(body.object_fields.length)
      pattern_constructors: self_host_inference_pattern_constructor_slots(body.patterns.length)
      unsupported_expressions: self_host_inference_bool_slots(body.expressions.length)
      consumed_member_roots: self_host_inference_bool_slots(body.expressions.length)
      consumed_pattern_roots: self_host_inference_bool_slots(body.patterns.length)
      diagnostics: []
      instantiation_tasks: []
      instantiation_results: []
      candidate_type_arguments: []
      imported_instantiation_generics: []
      call_type_arguments: []
      expression_type_arguments: []
      pattern_type_arguments: []
      pending_direct_calls: []
      pending_method_calls: []
      pending_variant_calls: []
      pending_variant_values: []
      pending_operators: []
      pending_constructions: []
      pending_fields: []
      instantiation_generics: SelfHostHirSpan::{
        start: 0u32
        length: 0u32
      }
      instantiation_method_generics: SelfHostHirSpan::{
        start: 0u32
        length: 0u32
      }
      instantiation_self_owner: 18446744073709551615u64
      instantiation_self_type: -1i32
      callable_index: callable_index
      declared_return_type: 0i32
      result_type: 0i32
    }
  }

  fn expression_index(self, expression: U32) -> U32 {
    expression - self.body.expressions.start
  }

  fn block_index(self, block: U32) -> U32 {
    block - self.body.blocks.start
  }

  fn pattern_index(self, pattern: U32) -> U32 {
    pattern - self.body.patterns.start
  }

  fn expression_type(self, expression: U32) -> I32 {
    self.expression_types[self.expression_index(expression)]
  }

  fn block_type(self, block: U32) -> I32 {
    self.block_types[self.block_index(block)]
  }

  fn pattern_type(self, pattern: U32) -> I32 {
    self.pattern_types[self.pattern_index(pattern)]
  }

  fn primitive(self, primitive: SelfHostPrimitiveType) -> I32 {
    self.solver.resolved_type(self.resolved.primitive(primitive))
  }

  fn constrain(
    self,
    left: I32,
    right: I32,
    origin: SelfHostTypeConstraintOrigin,
  ) -> Unit {
    let _ = self.solver.unify(left, right, origin)
  }

  fn is_primitive(self, type_: I32, primitive: SelfHostPrimitiveType) -> Bool {
    let representative = self.solver.representative_type(type_)
    match self.solver.type_term(representative) {
      SelfHostBodyTypeTerm::BodyResolvedType(resolved) => resolved == self.resolved.primitive(primitive)
      _ => false
    }
  }

  fn constrain_assignable(
    self,
    actual: I32,
    expected: I32,
    origin: SelfHostTypeConstraintOrigin,
  ) -> Unit {
    if !self.is_primitive(actual, SelfHostPrimitiveType::NeverType) {
      self.constrain(actual, expected, origin)
    }
  }

  fn mark_unsupported(self, expression: U32) -> Unit {
    let index = self.expression_index(expression)
    if !self.unsupported_expressions[index] {
      self.unsupported_expressions[index] = true
      self.solver.poison_type(self.expression_types[index])
    }
  }

  fn begin_signature_instantiation(self, declaration: U64) -> Unit {
    self.imported_instantiation_generics.clear()
    self.instantiation_generics = self.collected.generic_parameters_of(declaration)
    self.instantiation_method_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.candidate_type_arguments.clear()
    let mut index = 0u32
    let _ = while index {
      current => if current < self.instantiation_generics.length {
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = 18446744073709551615u64
    self.instantiation_self_type = -1i32
  }

  fn begin_imported_signature_instantiation(
    self,
    callable: SelfHostResolvedImportedCallable,
  ) -> Unit {
    self.imported_instantiation_generics.clear()
    self.instantiation_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.instantiation_method_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.candidate_type_arguments.clear()
    let mut index = 0u32
    let _ = while index {
      current => if current < callable.generic_parameters.length {
        self.imported_instantiation_generics.push(
          self.imported.generic_parameter_ids[
            self_host_u32_add(callable.generic_parameters.start, current)
          ],
        )
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = 18446744073709551615u64
    self.instantiation_self_type = -1i32
  }

  fn begin_imported_method_instantiation(
    self,
    implementation: SelfHostResolvedImportedImplementation,
    callable: SelfHostResolvedImportedCallable,
    receiver_type: I32,
  ) -> Unit {
    self.imported_instantiation_generics.clear()
    self.instantiation_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.instantiation_method_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.candidate_type_arguments.clear()
    let mut index = 0u32
    let total = self_host_u32_add(
      implementation.generic_parameters.length,
      callable.generic_parameters.length,
    )
    let _ = while index {
      current => if current < total {
        let parameter = if current < implementation.generic_parameters.length {
          self.imported.generic_parameter_ids[
            self_host_u32_add(implementation.generic_parameters.start, current)
          ]
        } else {
          self.imported.generic_parameter_ids[
            self_host_u32_add(
              callable.generic_parameters.start,
              current - implementation.generic_parameters.length,
            )
          ]
        }
        self.imported_instantiation_generics.push(parameter)
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = implementation.declaration
    self.instantiation_self_type = receiver_type
  }

  fn begin_fresh_imported_nominal_instantiation(
    self,
    declaration: U64,
  ) -> I32 {
    self.imported_instantiation_generics.clear()
    self.instantiation_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.instantiation_method_generics = SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }
    self.candidate_type_arguments.clear()
    let generic_span = match self.imported.type_generic_spans.get(declaration) {
      Option::Some(value) => value
      Option::None => self_host_empty_hir_span(0u32)
    }
    let mut index = 0u32
    let _ = while index {
      current => if current < generic_span.length {
        self.imported_instantiation_generics.push(
          self.imported.generic_parameter_ids[
            self_host_u32_add(generic_span.start, current)
          ],
        )
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = declaration
    let base_resolved = match self.imported.type_declaration_types.get(declaration) {
      Option::Some(value) => value
      Option::None => {
        return self.solver.error_type()
      }
    }
    let base = self.solver.resolved_type(base_resolved)
    let instance = if self_host_u32_equal(self.candidate_type_arguments.length(), 0u32) {
      base
    } else {
      self.solver.applied_type(base, self.candidate_type_arguments)
    }
    self.instantiation_self_type = instance
    instance
  }

  fn begin_imported_nominal_instantiation(
    self,
    declaration: U64,
    type_: I32,

  fn collapse_instantiation_results(self, start: U32, result: I32) -> Unit {
    let _ = while self.instantiation_results.length() {
      length => if self_host_u32_greater(length, start) {
        let _ = self.instantiation_results.pop()
        continue self.instantiation_results.length()
      } else {
        break self_host_semantic_unit()

          self_host_u32_equal(self.instantiation_generics.length, 0u32)
        } else {
          false
        }
        SelfHostResolvedType::SelfType(owner) => if self_host_u64_equal(
          owner,
          declaration,
        ) {
          self_host_u32_equal(self.instantiation_generics.length, 0u32)
        } else {
          false
        }
        SelfHostResolvedType::AppliedType(base, arguments) => match self.resolved.types[
          base
        ] {
          SelfHostResolvedType::NominalType(owner) => if self_host_u64_equal(
            owner,
            declaration,
          ) && self_host_u32_equal(
            arguments.length,
            self.instantiation_generics.length,
          ) {
            let mut index = 0u32
            let _ = while index {
              current => if current < arguments.length {
                self.candidate_type_arguments.push(
                  self.solver.resolved_type(
                    self.resolved.type_arguments[
                      self_host_u32_add(arguments.start, current)
                    ],
                  ),
                )
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            true
          } else {
            false
          }
          _ => false
        }
        _ => false
      }
      SelfHostBodyTypeTerm::BodyAppliedType(base, arguments) => {
        let base_representative = self.solver.representative_type(base)
        match self.solver.type_term(base_representative) {
          SelfHostBodyTypeTerm::BodyResolvedType(resolved_base) => match self.resolved.types[
            resolved_base
          ] {
            SelfHostResolvedType::NominalType(owner) => if self_host_u64_equal(
              owner,
              declaration,
            ) && self_host_u32_equal(
              arguments.length,
              self.instantiation_generics.length,
            ) {
              let mut index = 0u32
              let _ = while index {
                current => if current < arguments.length {
                  self.candidate_type_arguments.push(
                    self.solver.type_argument(
                      self_host_u32_add(arguments.start, current),
                    ),
                  )
                  continue current + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              true
            } else {
              false
            }
            _ => false
          }
          _ => false
        }
      }
      _ => false
    }
  }

  fn inspect_nominal_type(self, type_: I32) -> Option<U64> {
    let representative = self.solver.representative_type(type_)
    match self.solver.type_term(representative) {
      SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => match self.resolved.types[
        resolved_type
      ] {
        SelfHostResolvedType::NominalType(declaration) => Option::Some(declaration)
        SelfHostResolvedType::SelfType(declaration) => Option::Some(declaration)
        SelfHostResolvedType::AppliedType(base, _) => match self.resolved.types[base] {
          SelfHostResolvedType::NominalType(declaration) => Option::Some(declaration)
          _ => Option::None
        }
        _ => Option::None
      }
      SelfHostBodyTypeTerm::BodyAppliedType(base, _) => {
        let base_representative = self.solver.representative_type(base)
        match self.solver.type_term(base_representative) {
          SelfHostBodyTypeTerm::BodyResolvedType(resolved_base) => match self.resolved.types[
            resolved_base
          ] {
            SelfHostResolvedType::NominalType(declaration) => Option::Some(declaration)
            SelfHostResolvedType::SelfType(declaration) => Option::Some(declaration)
            _ => Option::None
          }
          _ => Option::None
        }
      }
      _ => Option::None
    }
  }

  fn collapse_instantiation_results(self, start: U32, result: I32) -> Unit {
    let _ = while self.instantiation_results.length() {
      length => if self_host_u32_greater(length, start) {
        let _ = self_host_array_pop(self.instantiation_results)
        continue self.instantiation_results.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_results.push(result)
  }

  fn finish_signature_product(self, source: U32, start: U32) -> I32 {
    let fields = match self.resolved.types[source] {
      SelfHostResolvedType::ProductType(value) => value
      _ => {
        return self.solver.error_type()
      }
    }
    let values = []
    let mut index = 0u32
    let _ = while index {
      current => if current < fields.length {
        values.push(
          self.instantiation_results[self_host_u32_add(start, current)],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.product_type(values)
  }

  fn finish_signature_application(self, source: U32, start: U32) -> I32 {
    let arguments = match self.resolved.types[source] {
      SelfHostResolvedType::AppliedType(_, value) => value
      _ => {
        return self.solver.error_type()
      }
    }
    let expected_length = self_host_u32_add(
      self_host_u32_add(start, 1u32),
      arguments.length,
    )
    if !self_host_u32_equal(
      self.instantiation_results.length(),
      expected_length,
    ) {
      return self.solver.error_type()
    }
    let base = self.instantiation_results[start]
    let values = []
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        values.push(
          self.instantiation_results[
            self_host_u32_add(self_host_u32_add(start, 1u32), current)
          ],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.applied_type(base, values)
  }

  fn finish_signature_function(self, source: U32, start: U32) -> I32 {
    let parameters = match self.resolved.types[source] {
      SelfHostResolvedType::FunctionType(value, _) => value
      _ => {
        return self.solver.error_type()
      }
    }
    let values = []
    let mut index = 0u32
    let _ = while index {
      current => if current < parameters.length {
        values.push(
          self.instantiation_results[self_host_u32_add(start, current)],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.function_type(
      values,
      self.instantiation_results[self_host_u32_add(start, parameters.length)],
    )
  }

  fn instantiate_signature_type(self, root: U32) -> I32 {
    self.instantiation_tasks.clear()
    self.instantiation_results.clear()
    self.instantiation_tasks.push(
      SelfHostSignatureInstantiationTask::VisitSignatureType(root),
    )
    let _ = while self.instantiation_tasks.length() {
      length => if self_host_u32_greater(length, 0u32) {
        let task = match self_host_array_pop(self.instantiation_tasks) {
          Option::Some(value) => value
          Option::None => {
            return self.solver.error_type()
          }
        }
        match task {
          SelfHostSignatureInstantiationTask::VisitSignatureType(source) => match self.resolved.types[source] {
            SelfHostResolvedType::GenericParameterType(parameter) => {
              let mut imported_index = 4294967295u32
              let mut search = 0u32
              let _ = while search {
                current => if current < self.imported_instantiation_generics.length() {
                  if self_host_u64_equal(
                    self.imported_instantiation_generics[current],
                    parameter,
                  ) {
                    imported_index = current
                    break self_host_semantic_unit()
                  }
                  continue current + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let local = self_host_semantic_id_local(parameter)
              if !self_host_u32_equal(imported_index, 4294967295u32) {
                self.instantiation_results.push(
                  self.candidate_type_arguments[imported_index],
                )
              } else if local >= self.instantiation_generics.start && local < self_host_u32_add(
                self.instantiation_generics.start,
                self.instantiation_generics.length,
              ) {
                self.instantiation_results.push(
                  self.candidate_type_arguments[local - self.instantiation_generics.start],
                )
              } else if local >= self.instantiation_method_generics.start && local < self_host_u32_add(
                self.instantiation_method_generics.start,
                self.instantiation_method_generics.length,
              ) {
                self.instantiation_results.push(
                  self.candidate_type_arguments[
                    self.instantiation_generics.length + local - self.instantiation_method_generics.start
                  ],
                )
              } else {
                self.instantiation_results.push(self.solver.resolved_type(source))
              }
            }
            SelfHostResolvedType::SelfType(owner) => if self_host_u64_equal(
              owner,
              self.instantiation_self_owner,
            ) && self.instantiation_self_type != -1i32 {
              self.instantiation_results.push(self.instantiation_self_type)
            } else {
              self.instantiation_results.push(self.solver.resolved_type(source))
            }
            SelfHostResolvedType::ProductType(fields) => {
              let start = self.instantiation_results.length()
              self.instantiation_tasks.push(
                SelfHostSignatureInstantiationTask::FinishSignatureProduct(source, start),
              )
              let mut index = fields.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.instantiation_tasks.push(
                    SelfHostSignatureInstantiationTask::VisitSignatureType(
                      self.resolved.type_arguments[self_host_u32_add(fields.start, previous)],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostResolvedType::AppliedType(base, arguments) => {
              let start = self.instantiation_results.length()
              self.instantiation_tasks.push(
                SelfHostSignatureInstantiationTask::FinishSignatureApplication(source, start),
              )
              let mut index = arguments.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.instantiation_tasks.push(
                    SelfHostSignatureInstantiationTask::VisitSignatureType(
                      self.resolved.type_arguments[self_host_u32_add(arguments.start, previous)],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
              self.instantiation_tasks.push(
                SelfHostSignatureInstantiationTask::VisitSignatureType(base),
              )
            }
            SelfHostResolvedType::FunctionType(parameters, result) => {
              let start = self.instantiation_results.length()
              self.instantiation_tasks.push(
                SelfHostSignatureInstantiationTask::FinishSignatureFunction(source, start),
              )
              self.instantiation_tasks.push(
                SelfHostSignatureInstantiationTask::VisitSignatureType(result),
              )
              let mut index = parameters.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.instantiation_tasks.push(
                    SelfHostSignatureInstantiationTask::VisitSignatureType(
                      self.resolved.type_arguments[self_host_u32_add(parameters.start, previous)],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => self.instantiation_results.push(self.solver.resolved_type(source))
          }
          SelfHostSignatureInstantiationTask::FinishSignatureProduct(source, start) => {
            let result = self.finish_signature_product(source, start)
            self.collapse_instantiation_results(start, result)
          }
          SelfHostSignatureInstantiationTask::FinishSignatureApplication(source, start) => {
            let result = self.finish_signature_application(source, start)
            self.collapse_instantiation_results(start, result)
          }
          SelfHostSignatureInstantiationTask::FinishSignatureFunction(source, start) => {
            let result = self.finish_signature_function(source, start)
            self.collapse_instantiation_results(start, result)
          }
        }
        continue self.instantiation_tasks.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.assert_solver_invariant(
      self_host_u32_equal(self.instantiation_results.length(), 1u32),
      206u32, 1u32, self.instantiation_results.length(), root,
    )
    if self.resolved.types[root] is SelfHostResolvedType::PrimitiveType(_) {
      let expected = self.solver.resolved_type(root)
      let actual = self_host_basic_i32_at(self.instantiation_results, 0u32)
      if expected != actual {
        let _ = self_host_assert_compiler_invariant_with_failure(false,
          SelfHostInvariantFailure::{
            code: 208u32
            phase: 2u32
            module_id: self.collected.module_id
            declaration: self.body.declaration
            body: self.body.id
            expression: self.body.expressions.start
            expected: u32_into_u64(self_host_body_i32_to_u32(expected))
            actual: u32_into_u64(self_host_body_i32_to_u32(actual))
            detail: u32_into_u64(root)
          }, "primitive signature instantiation changed its type")
      }
    }
    self.instantiation_results[0u32]
  }

  fn local_callable_index_of_declaration(self, declaration: U64) -> Option<U32> {
    let mut index = 0u32
    while index {
      current => if current < self.collected.callables.length() {
        let callable = self_host_collected_callable_identity(
          self.collected.callables[current],
        )
        if self_host_u64_equal(callable.declaration, declaration) {
          return Option::Some(current)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn unique_local_callable_index(self, name: U32) -> Option<U32> {
    let binding = match self.collected.value_binding(name) {
      Option::Some(value) => value
      Option::None => {
        return Option::None
      }
    }
    let candidate = self_host_value_binding_candidate_identity(
      self.collected.value_binding_candidates[binding.head],
    )
    match candidate.next {
      Option::Some(_) => {
        return Option::None
      }
      Option::None => {}
    }
    self.local_callable_index_of_declaration(candidate.declaration)
  }

  fn imported_callable(
    self,

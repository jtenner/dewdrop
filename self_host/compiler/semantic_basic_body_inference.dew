  fn static_owner_matches(self, base: U32, target_type: U32) -> Bool {
    match self.names.expression_references[base] {
      SelfHostBodyNameReference::PrimitiveTypeNameReference(primitive) => {
        // Primitive owners have no nominal declaration. Compare their logical
        // types, not their shared physical carrier or their source spelling.
        match self.resolved.types[target_type] {
          SelfHostResolvedType::PrimitiveType(_) => {
            let snapshot = self.solver.snapshot()
            let same = self.solver.unify(
              self.primitive(primitive),
              self.solver.resolved_type(target_type),
              self_host_expression_type_origin(base, self_host_basic_expression_offset(self.collected.expressions[base])),
            )
            self.solver.rollback(snapshot)
            same
          }
          _ => false
        }
      }
      SelfHostBodyNameReference::ModuleTypeNameReference(owner) => match if self_host_u64_equal(self_host_semantic_id_module(owner), self.collected.module_id) {
        Option::Some(self.resolved.declaration_type(owner))
      } else {
        self.imported.type_declaration_types.get(owner)
      } {
        Option::Some(owner_type) => match self.resolved_nominal_head(owner_type) {
          Option::Some(nominal) => match self.resolved_nominal_head(target_type) {
            Option::Some(candidate) => self_host_u64_equal(nominal, candidate)
            Option::None => false
          }
          Option::None => false
        }
        Option::None => false
      }
      _ => false
    }
  }

  fn constrain_static_call(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
  ) -> Bool {
    let (base, name) = match self.collected.expressions[target] {
      SelfHostHirExpr::QualifiedExpr(base, property, _) => match self.names.expression_references[
        base
      ] {
        SelfHostBodyNameReference::ModuleTypeNameReference(_) => (base, property)
        SelfHostBodyNameReference::PrimitiveTypeNameReference(_) => (base, property)
        _ => return false
      }
      _ => return false
    }
    let method_name = self.collected.name(name)
    let mut selected = 4294967295u32
    let mut first = 18446744073709551615u64
    let mut second = 18446744073709551615u64
    let mut named_count = 0u32
    let mut viable_count = 0u32
    let mut selected_local = 4294967295u32
    let mut method_index = 0u32
    let _ = while method_index {
      current => if current < self.collected.methods.length() {
        let method = self_host_collected_method_identity(self.collected.methods[current])
        if self_host_u32_equal(method.name, name) {
          let parameters = self.collected.parameters_of(method.id)
          let has_receiver = self_host_u32_greater(parameters.length, 0u32) &&
            (self.collected.parameters[parameters.start].kind is SelfHostCollectedParameterKind::ReceiverParameterDecl)
          if !has_receiver {
            let mut implementation = 0u32
            let _ = while implementation {
              candidate => if candidate < self.collected.impls.length() {
                let impl_ = self.collected.impls[candidate]
                if self_host_u64_equal(impl_.declaration, method.parent) && (impl_.trait_type is Option::None) &&
                  self.static_owner_matches(base, self.resolved.impl_target_types[candidate]) {
                  named_count = named_count + 1u32
                  match self.local_callable_index_of_declaration(method.id) {
                    Option::Some(callable) => if self.local_callable_candidate_viable(expression, arguments, offset, callable) {
                      if viable_count == 0u32 {
                        selected_local = callable
                        first = method.id
                      } else if viable_count == 1u32 {
                        second = method.id
                      }
                      viable_count = viable_count + 1u32
                    }
                    Option::None => {}
                  }
                }
                continue candidate + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self.imported.callables.length() {
        let callable = self_host_resolved_imported_callable_at(self.imported.callables, current)
        let has_receiver = callable.parameters.length > 0u32 &&
          self.imported.parameter_receivers[callable.parameters.start]
        if !has_receiver && self_host_basic_string_equal(callable.name, method_name) {
          match callable.kind {
            SelfHostFrozenInterfaceCallableKind::FrozenImplCallable(implementation_id) => match self.imported_implementation(implementation_id) {
              Option::Some(implementation) => if implementation.trait_type is Option::None {
                if self.static_owner_matches(base, implementation.target_type) {
                  named_count = named_count + 1u32
                  if self.imported_callable_candidate_viable(expression, arguments, offset, callable) {
                    if viable_count == 0u32 {
                      selected = current
                      first = callable.declaration
                    } else if viable_count == 1u32 {
                      second = callable.declaration
                    }
                    viable_count = viable_count + 1u32
                  }
                }
              }
              Option::None => {}
            }
            _ => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if named_count == 0u32 {
      return false
    }
    // Names locate candidates. Only owner identity and signature constraints
    // select the declaration; neither module order nor spelling proves an ABI.
    if viable_count == 1u32 {
      if selected_local != 4294967295u32 {
        let _ = self.select_local_callable(expression, target, arguments, offset, selected_local)
      } else {
        let _ = self.commit_imported_callable(
          expression, target, arguments, offset,
          self_host_resolved_imported_callable_at(self.imported.callables, selected),
        )
      }
      // These nodes are now proven namespace/member selectors, not runtime
      // values. Retire their provisional unsupported-expression markers.
      self.unsupported_expressions[self.expression_index(target)] = false
      self.unsupported_expressions[self.expression_index(base)] = false
    } else {
      self.store_call_target(expression, SelfHostBasicCallTarget::ErrorBasicCallTarget, 1u32)
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      if viable_count == 0u32 {
        self.diagnostics.push(SelfHostBodyInferenceDiagnostic::NoMatchingMethod(name, expression, offset))
      } else {
        self.diagnostics.push(SelfHostBodyInferenceDiagnostic::AmbiguousMethod(name, expression, first, second, viable_count, offset))
      }
    }
    self.consumed_member_roots[self.expression_index(target)] = true
    self.consumed_member_roots[self.expression_index(base)] = true
    true
  }

  fn imported_callable_function_type(
    self,
    declaration: U64,
    expression: U32,
    reference: Bool,
  ) -> Option<I32> {
    match self.imported_callable(declaration) {
      Option::Some(callable) => {
        if !reference {
          if self_host_u32_equal(callable.generic_parameters.length, 0u32) {
            return Option::Some(self.solver.resolved_type(callable.function_type))
          }
          return Option::None
        }
        self.begin_imported_signature_instantiation(callable)
        let type_ = self.instantiate_signature_type(callable.function_type)
        self.record_function_reference(expression, declaration)
        Option::Some(type_)
      }
      Option::None => match self.imported.module_value_types.get(declaration) {
        Option::Some(type_) => Option::Some(self.solver.resolved_type(type_))
        Option::None => Option::None
      }
    }
  }

  fn imported_variant_owner_visible(self, declaration: U64) -> Bool {
    match self.imported.scope {
      Option::Some(scope) => scope.declaration_bindings.contains_key(declaration)
      Option::None => false
    }
  }

  fn bare_variant_candidate_count(self, name: String) -> U32 {
    let mut count = 0u32
    for variant in self.collected.variants {
      if self.collected.name(variant.name) == name {
        count = count + 1u32
      }
    }
    for variant in self.imported.variants {
      if self_host_basic_string_equal(variant.name, name) && self.imported_variant_owner_visible(variant.declaration) {
        count = count + 1u32
      }
    }
    count
  }

  fn imported_variant_target(
    self,
    target: U32,
    expected: I32,
  ) -> Option<SelfHostResolvedImportedVariant> {
    let expected_owner = self.inspect_nominal_type(expected)
    let mut declaration = 18446744073709551615u64
    let mut name = ""
    match self.collected.expressions[target] {
      SelfHostHirExpr::QualifiedExpr(base, property, _) => match self.names.expression_references[
        base
      ] {
        SelfHostBodyNameReference::ModuleTypeNameReference(owner) => {
          declaration = owner
          name = self.collected.name(property)
        }
        _ => {}
      }
      SelfHostHirExpr::NameExpr(name_id, _) => match self.names.expression_references[target] {
        SelfHostBodyNameReference::VariantNameReference(_) => {
          name = self.collected.name(name_id)
        }
        _ => {}
      }
      _ => {}
    }
    if name == "" {
      return Option::None
    }
    if declaration == 18446744073709551615u64 && expected_owner is Option::None && self.bare_variant_candidate_count(name) != 1u32 {
      return Option::None
    }
    let mut selected = 4294967295u32
    let mut count = 0u32
    let mut index = 0u32
    let _ = while index {
      current => if current < self.imported.variants.length() {
        let variant = self.imported.variants[current]
        let candidate_name = variant.name
        let owner_matches = self_host_u64_equal(
          declaration,
          18446744073709551615u64,
        ) || self_host_u64_equal(variant.declaration, declaration)
        let expected_matches = match expected_owner {
          Option::Some(owner) => self_host_u64_equal(owner, variant.declaration)
          Option::None => true
        }
        let visible = declaration != 18446744073709551615u64 || self.imported_variant_owner_visible(variant.declaration)
        if visible && owner_matches && expected_matches && self_host_basic_string_equal(
          candidate_name,
          name,
        ) {
          selected = current
          count = count + 1u32
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(count, 1u32) {
      Option::Some(self.imported.variants[selected])
    } else {
      Option::None
    }
  }

  fn record_function_reference(self, expression: U32, declaration: U64) -> Unit {
    let start = self.call_type_arguments.length()
    self_host_basic_copy_i32_values(self.candidate_type_arguments, self.call_type_arguments)
    self.store_call_target(expression, SelfHostBasicCallTarget::SelectedBasicCallTarget(
      declaration,
      SelfHostHirSpan::{
        start: start
        length: self.candidate_type_arguments.length()
      },
    ), 0u32)
  }

  fn local_callable_function_type(self, name: U32, expression: U32, reference: Bool) -> Option<I32> {
    match self.unique_local_callable_index(name) {
      Option::Some(index) => {
        let declaration = self.collected.callables[index].declaration
        if !reference {
          if self_host_u32_equal(self.collected.generic_parameters_of(declaration).length, 0u32) {
            return Option::Some(self.solver.resolved_type(self.resolved.callable_function_types[index]))
          }
          return Option::None
        }
        self.begin_signature_instantiation(declaration)
        let type_ = self.instantiate_signature_type(self.resolved.callable_function_types[index])
        self.record_function_reference(expression, declaration)
        Option::Some(type_)
      }
      Option::None => Option::None
    }
  }

  fn body_signature_type(self, type_: U32) -> I32 {
    match self.resolved.types[type_] {
      SelfHostResolvedType::SelfType(owner) => {
        let mut implementation_index = 0u32
        let _ = while implementation_index {
          current => if current < self.collected.impls.length() {
            if self_host_u64_equal(self.collected.impls[current].declaration, owner) {
              // Inside an implementation, Self is its complete logical target,
              // including generic arguments. Do not reduce it to a carrier.
              return self.solver.resolved_type(self.resolved.impl_target_types[current])
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      _ => {}
    }
    self.solver.resolved_type(type_)
  }

  fn initialize_locals(self) -> Unit {
    let mut local = 0u32
    let _ = while local {
      current => if current < self.name_info.locals.length {
        let info = self_host_body_local_identity(
          self.names.locals[self.name_info.locals.start + current],
        )
        let mut type_ = self.solver.error_type()
        match info.kind {
          SelfHostBodyLocalKind::ParameterLocal => if self.lambda_index != 4294967295u32 {
            let available = self.resolved.lambda_parameter_types.length()
            if self_host_u32_greater(available, info.source) {
              let resolved_type = self.resolved.lambda_parameter_types[info.source]
              if resolved_type < self.resolved.types.length() {
                if self.resolved.types[resolved_type] is SelfHostResolvedType::ErrorType {
                  self.diagnostics.push(
                    SelfHostBodyInferenceDiagnostic::ParameterLocalHasErrorType(
                      self.body.id,
                      current,
                      info.source,
                      resolved_type,
                      info.offset,
                    ),
                  )
                } else {
                  type_ = self.body_signature_type(resolved_type)
                }
              } else {
                self.diagnostics.push(
                  SelfHostBodyInferenceDiagnostic::InvalidParameterResolvedType(
                    self.body.id,
                    current,
                    info.source,
                    resolved_type,
                    self.resolved.types.length(),
                    info.offset,
                  ),
                )
              }
            } else {
              self.diagnostics.push(
                SelfHostBodyInferenceDiagnostic::InvalidParameterLocalSource(
                  self.body.id,
                  current,
                  info.source,
                  available,
                  info.offset,

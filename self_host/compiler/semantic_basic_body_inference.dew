            SelfHostBodyNameReference::ImportedModuleValueNameReference(
              declaration,
            ) => match self.imported_callable_function_type(declaration) {
              Option::Some(function_type) => function_type
              Option::None => self.solver.fresh_variable()
            }
            SelfHostBodyNameReference::ErrorNameReference => self.solver.error_type()
            _ => self.solver.fresh_variable()
          }
          SelfHostHirExpr::ProductExpr(fields, _) => {
            let types = []
            let mut index = 0u32
            let _ = while index {
              field => if field < fields.length {
                types.push(self.expression_type(self.collected.expression_children[fields.start + field]))
                continue field + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self.solver.product_type(types)
          }
          SelfHostHirExpr::ArrayExpr(_, _) => {
            let element = self.solver.fresh_variable()
            match self.collected.lookup_type("Array") {
              Option::Some(declaration) => self.solver.applied_type(
                self.solver.resolved_type(self.resolved.declaration_type(declaration)),
                [element],
              )
              Option::None => self.solver.applied_type(self.solver.fresh_variable(), [element])
            }
          }
          SelfHostHirExpr::LambdaExpr(lambda, _) => if lambda < self.resolved.lambda_function_types.length() {
            self.solver.resolved_type(self.resolved.lambda_function_types[lambda])
          } else {
            self.solver.error_type()
          }
          SelfHostHirExpr::IfExpr(_, _, alternative, _) => if alternative == 4294967295u32 {
            self.primitive(SelfHostPrimitiveType::UnitType)
          } else {
            self.solver.fresh_variable()
          }
          SelfHostHirExpr::AssignmentExpr(_, _, _) => self.primitive(SelfHostPrimitiveType::UnitType)
          SelfHostHirExpr::IndexSetExpr(_, _, _, _) => self.primitive(SelfHostPrimitiveType::UnitType)
          SelfHostHirExpr::PrefixExpr(SelfHostHirPrefixOperator::LogicalNot, _, _) => self.primitive(SelfHostPrimitiveType::BoolType)
          SelfHostHirExpr::BinaryExpr(operator, _, _, _) => match operator {
            SelfHostHirBinaryOperator::LogicalOr => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::LogicalAnd => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::Equal => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::NotEqual => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::Less => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::LessEqual => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::Greater => self.primitive(SelfHostPrimitiveType::BoolType)
            SelfHostHirBinaryOperator::GreaterEqual => self.primitive(SelfHostPrimitiveType::BoolType)
            _ => self.solver.fresh_variable()
          }
          SelfHostHirExpr::WhileExpr(_, _, _) => {
            let control = self.names.expression_controls[current]
            if control != 4294967295u32 && control < self.control_result_types.length() {
              self.control_result_types[control]
            } else {
              self.solver.error_type()
            }
          }
          SelfHostHirExpr::BreakExpr(_, _) => self.primitive(SelfHostPrimitiveType::NeverType)
          SelfHostHirExpr::ContinueExpr(_, _) => self.primitive(SelfHostPrimitiveType::NeverType)
          _ => self.solver.fresh_variable()
        }
        self_host_store_inference_type(
          self.expression_types,
          self.expression_index(current),
          type_,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn initialize_blocks(self) -> Unit {
    let unit = self.primitive(SelfHostPrimitiveType::UnitType)
    let never = self.primitive(SelfHostPrimitiveType::NeverType)
    let mut block = self.body.blocks.start
    let end = self.body.blocks.start + self.body.blocks.length
    let _ = while block {
      current => if current < end {
        let data = self.collected.blocks[current]
        let type_ = if self_host_u32_equal(data.items.length, 0u32) {
          unit
        } else {
          let last_item = self_host_u32_subtract(
            self_host_u32_add(data.items.start, data.items.length),
            1u32,
          )
          match self.collected.block_items[last_item] {
            SelfHostHirBlockItem::LetItem(_, _, _, _, _) => unit
            SelfHostHirBlockItem::ReturnItem(_, _) => never
            SelfHostHirBlockItem::ExpressionItem(expression, _) => self.expression_type(expression)
          }
        }
        self.block_types[self.block_index(current)] = type_
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut expression = self.body.expressions.start
    let expression_end = self.body.expressions.start + self.body.expressions.length
    let _ = while expression {
      current => if current < expression_end {
        match self.collected.expressions[current] {
          SelfHostHirExpr::BlockExpr(block_id, _) => {
            self_host_store_inference_type(
              self.expression_types,
              self.expression_index(current),
              self.block_type(block_id),
            )
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn initialize_patterns(self) -> Unit {
    let mut pattern = self.body.patterns.start
    let end = self.body.patterns.start + self.body.patterns.length
    let _ = while pattern {
      current => if current < end {
        let type_ = match self.collected.patterns[current] {
          SelfHostHirPattern::BindingPattern(_, _) => match self.names.pattern_references[current] {
            SelfHostBodyPatternReference::PatternBindingReference(local) => self.local_types[local]
            _ => self.solver.fresh_variable()
          }
          SelfHostHirPattern::LiteralPattern(expression, _) => self.expression_type(expression)
          SelfHostHirPattern::TuplePattern(base, children, _) => if self_host_u32_equal(
            base,
            4294967295u32,
          ) {
            let fields = []
            let mut index = 0u32
            let _ = while index {
              child => if child < children.length {
                fields.push(self.pattern_type(self.collected.pattern_children[children.start + child]))
                continue child + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self.solver.product_type(fields)
          } else {
            self.solver.fresh_variable()
          }
          _ => self.solver.fresh_variable()
        }
        self.pattern_types[self.pattern_index(current)] = type_
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn local_pattern_variant_target(
    self,
    base: U32,
    expected: I32,
  ) -> Option<U32> {
    let expected_owner = self.inspect_nominal_type(expected)
    match self.collected.patterns[base] {
      SelfHostHirPattern::BindingPattern(name, _) => match self.names.pattern_references[
        base
      ] {
        SelfHostBodyPatternReference::PatternVariantReference(_) => {
          let mut found = 4294967295u32
          let mut count = 0u32
          let mut index = 0u32
          let _ = while index {
            current => if current < self.collected.variants.length() {
              let variant = self.collected.variants[current]
              if self_host_u32_equal(variant.name, name) {
                let owner_matches = match expected_owner {
                  Option::Some(owner) => self_host_u64_equal(
                    owner,
                    variant.declaration,
                  )
                  Option::None => true
                }
                if owner_matches {
                  found = current
                  count = count + 1u32
                }
              }
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if self_host_u32_equal(count, 1u32) {
            Option::Some(found)
          } else {
            Option::None
          }
        }
        _ => Option::None
      }
      SelfHostHirPattern::QualifiedPattern(root, property, _) => match self.names.pattern_references[
        root
      ] {
        SelfHostBodyPatternReference::PatternTypeReference(declaration) => {
          let mut index = 0u32
          while index {
            current => if current < self.collected.variants.length() {
              let variant = self.collected.variants[current]
              if self_host_u64_equal(variant.declaration, declaration) && self_host_u32_equal(
                variant.name,
                property,
              ) {
                return Option::Some(current)
              }
              continue current + 1u32
            } else {
              break Option::None
            }
          }
        }
        _ => Option::None
      }
      _ => Option::None
    }
  }

  fn imported_pattern_variant_target(
    self,
    base: U32,
    expected: I32,
  ) -> Option<SelfHostResolvedImportedVariant> {
    let expected_owner = self.inspect_nominal_type(expected)
    let mut declaration = 18446744073709551615u64
    let mut name = ""
    match self.collected.patterns[base] {
      SelfHostHirPattern::BindingPattern(name_id, _) => match self.names.pattern_references[
        base
      ] {
        SelfHostBodyPatternReference::PatternVariantReference(_) => {
          name = self.collected.name(name_id)
        }
        _ => {}
      }
      SelfHostHirPattern::QualifiedPattern(root, property, _) => match self.names.pattern_references[
        root
      ] {
        SelfHostBodyPatternReference::PatternTypeReference(owner) => {
          declaration = owner
          name = self.collected.name(property)
        }
        _ => {}
      }
      _ => {}
    }
    let mut selected = 4294967295u32
    let mut count = 0u32
    let mut index = 0u32
    let _ = while index {
      current => if current < self.imported.variants.length() {
        let variant = self.imported.variants[current]
        let candidate_name = variant.name
        let explicit_owner = self_host_u64_equal(
          declaration,
          18446744073709551615u64,
        ) || self_host_u64_equal(variant.declaration, declaration)
        let expected_matches = match expected_owner {
          Option::Some(owner) => self_host_u64_equal(owner, variant.declaration)
          Option::None => true
        }
        if explicit_owner && expected_matches && self_host_basic_string_equal(
          candidate_name,
          name,
        ) {
          selected = current
          count = count + 1u32
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(count, 1u32) {
      Option::Some(self.imported.variants[selected])
    } else {
      Option::None
    }
  }

  fn record_imported_pattern_constructor(
    self,
    pattern: U32,
    constructor: U64,
    variant: Bool,
  ) -> Unit {
    let start = self.pattern_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.pattern_type_arguments.push(type_argument)
    }
    self_host_store_basic_pattern_constructor(
      self.pattern_constructors,
      self.pattern_index(pattern),
      SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
        constructor,
        variant,
        SelfHostHirSpan::{
          start: start
          length: self.candidate_type_arguments.length()
        },
      ),
    )
  }

  fn record_pattern_constructor(
    self,
    pattern: U32,
    variant: U32,
    payload: Bool,
  ) -> Unit {
    let start = self.pattern_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.pattern_type_arguments.push(type_argument)
    }
    let constructor = SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
      self.collected.variants[variant].id,
      payload,
      SelfHostHirSpan::{
        start: start
        length: self.candidate_type_arguments.length()
      },
    )
    self_host_store_basic_pattern_constructor(
      self.pattern_constructors,
      self.pattern_index(pattern),
      constructor,
    )
  }

  fn fail_pattern_constructor(self, pattern: U32) -> Unit {
    self_host_store_basic_pattern_constructor(
      self.pattern_constructors,
      self.pattern_index(pattern),
      SelfHostBasicPatternConstructor::ErrorBasicPatternConstructor,
    )
    self.solver.poison_type(self.pattern_type(pattern))
  }

  fn select_imported_unit_variant_pattern(
    self,
    pattern: U32,
    variant: SelfHostResolvedImportedVariant,
    offset: U32,
  ) -> Unit {
    match variant.kind {
      SelfHostCollectedVariantKind::UnitVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(
            pattern,
            variant.variant,
            offset,
          ),
        )
        self.fail_pattern_constructor(pattern)
        return
      }
    }
    if !self.begin_imported_nominal_instantiation(
      variant.declaration,
      self.pattern_type(pattern),
    ) {
      self.fail_pattern_constructor(pattern)
      return
    }
    self.record_imported_pattern_constructor(
      pattern,
      variant.variant,
      true,
    )
  }

  fn select_imported_tuple_variant_pattern(
    self,
    pattern: U32,
    base: U32,
    children: SelfHostHirSpan,
    variant: SelfHostResolvedImportedVariant,
    offset: U32,
  ) -> Unit {
    let expected = self.pattern_type(pattern)
    self_host_store_inference_type(
      self.pattern_types,
      self.pattern_index(base),
      expected,
    )
    match variant.kind {
      SelfHostCollectedVariantKind::TupleVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(
            pattern,
            variant.variant,
            offset,
          ),
        )
        self.fail_pattern_constructor(pattern)
        return
      }
    }
    if !self_host_u32_equal(variant.payload_types.length, children.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::PatternPayloadArityMismatch(
          pattern,
          variant.payload_types.length,
          children.length,
          offset,
        ),
      )
    }
    if !self.begin_imported_nominal_instantiation(
      variant.declaration,
      expected,
    ) {
      self.fail_pattern_constructor(pattern)
      return
    }
    self.record_imported_pattern_constructor(
      pattern,
      variant.variant,
      true,
    )
    let limit = if children.length < variant.payload_types.length {
      children.length
    } else {
      variant.payload_types.length
    }
    let mut index = 0u32
    let _ = while index {
      current => if current < limit {
        let child = self.collected.pattern_children[
          self_host_u32_add(children.start, current)
        ]
        let signature = self.imported.variant_payload_types[
          self_host_u32_add(variant.payload_types.start, current)
        ]
        self.constrain(
          self.pattern_type(child),
          self.instantiate_signature_type(signature),
          self_host_pattern_type_origin(pattern, offset),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn select_local_unit_variant_pattern(
    self,
    pattern: U32,
    variant_index: U32,
    expected: I32,
    offset: U32,
  ) -> Unit {
    let variant = self.collected.variants[variant_index]
    match variant.kind {
      SelfHostCollectedVariantKind::UnitVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(
            pattern,
            variant.id,
            offset,
          ),
        )
        self.fail_pattern_constructor(pattern)
        return
      }
    }
    if !self.begin_nominal_instantiation(variant.declaration, expected) {
      self.fail_pattern_constructor(pattern)
      return
    }
    self.record_pattern_constructor(pattern, variant_index, false)
  }

  fn select_unit_variant_pattern(self, pattern: U32, offset: U32) -> Unit {
    let expected = self.pattern_type(pattern)
    match self.local_pattern_variant_target(pattern, expected) {
      Option::Some(variant_index) => self.select_local_unit_variant_pattern(
        pattern,
        variant_index,
        expected,
        offset,
      )
      Option::None => match self.imported_pattern_variant_target(pattern, expected) {
        Option::Some(variant) => self.select_imported_unit_variant_pattern(
          pattern,
          variant,
          offset,
        )
        Option::None => {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(
              pattern,
              offset,
            ),
          )
          self.fail_pattern_constructor(pattern)
        }
      }
    }
  }

  fn select_local_tuple_variant_pattern(
    self,
    pattern: U32,
    base: U32,
    children: SelfHostHirSpan,
    variant_index: U32,
    expected: I32,
    offset: U32,
  ) -> Unit {
    self_host_store_inference_type(
      self.pattern_types,
      self.pattern_index(base),
      expected,
    )
    let variant = self.collected.variants[variant_index]
    match variant.kind {
      SelfHostCollectedVariantKind::TupleVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(
            pattern,
            variant.id,
            offset,
          ),
        )
        self.fail_pattern_constructor(pattern)
        return
      }
    }
    let payload = self.resolved.variant_payloads[variant_index]
    if !self_host_u32_equal(payload.length, children.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::PatternPayloadArityMismatch(
          pattern,
          payload.length,
          children.length,
          offset,
        ),
      )
    }
    if !self.begin_nominal_instantiation(variant.declaration, expected) {
      self.fail_pattern_constructor(pattern)
      return
    }
    self.record_pattern_constructor(pattern, variant_index, true)
    let limit = if children.length < payload.length {
      children.length
    } else {
      payload.length
    }
    let mut index = 0u32
    let _ = while index {
      current => if current < limit {
        let child = self.collected.pattern_children[
          self_host_u32_add(children.start, current)
        ]
        self.constrain(
          self.pattern_type(child),
          self.instantiate_signature_type(
            self.resolved.signature_type_lists[
              self_host_u32_add(payload.start, current)
            ],
          ),
          self_host_pattern_type_origin(pattern, offset),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn select_tuple_variant_pattern(
    self,
    pattern: U32,
    base: U32,
    children: SelfHostHirSpan,
    offset: U32,
  ) -> Unit {
    let expected = self.pattern_type(pattern)
    match self.local_pattern_variant_target(base, expected) {
      Option::Some(variant_index) => self.select_local_tuple_variant_pattern(
        pattern,
        base,
        children,
        variant_index,
        expected,
        offset,
      )
      Option::None => match self.imported_pattern_variant_target(base, expected) {
        Option::Some(variant) => self.select_imported_tuple_variant_pattern(
          pattern,
          base,
          children,
          variant,
          offset,
        )
        Option::None => {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(
              pattern,
              offset,
            ),
          )
          self.fail_pattern_constructor(pattern)
        }
      }
    }
  }

  fn pattern_field_owner_matches(
    self,
    field: SelfHostCollectedField,
    declaration: U64,
    variant: Option<U64>,
  ) -> Bool {
    if !self_host_u64_equal(field.declaration, declaration) {
      false
    } else {
      match field.variant {
        Option::None => variant is Option::None
        Option::Some(left) => match variant {
          Option::Some(right) => self_host_u64_equal(left, right)
          Option::None => false
        }
      }
    }
  }

  fn select_imported_struct_pattern(
    self,
    pattern: U32,
    fields: SelfHostHirSpan,
    has_rest: Bool,
    declaration: U64,
    variant_id: Option<U64>,
    expected: I32,
    offset: U32,
  ) -> Unit {
    if !self.begin_imported_nominal_instantiation(declaration, expected) {
      self.fail_pattern_constructor(pattern)
      return
    }
    let matched = self_host_inference_bool_slots(self.imported.fields.length())
    let mut index = 0u32
    let _ = while index {
      current => if current < fields.length {
        let pattern_field = self.collected.pattern_fields[
          self_host_u32_add(fields.start, current)
        ]
        let name = self.collected.name(pattern_field.name)
        let mut selected = 4294967295u32
        let mut candidate = 0u32
        let _ = while candidate {
          field_index => if field_index < self.imported.fields.length() {
            let field = self.imported.fields[field_index]
            let field_name = field.name
            if self.imported_field_owner_matches(
              field,
              declaration,
              variant_id,
            ) && self_host_basic_string_equal(field_name, name) {
              selected = field_index
              break self_host_semantic_unit()
            }
            continue field_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        if self_host_u32_equal(selected, 4294967295u32) {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnknownPatternField(
              pattern_field.name,
              pattern,
              pattern_field.offset,
            ),
          )
          self.solver.poison_type(self.pattern_type(pattern_field.pattern))
        } else {
          matched[selected] = true
          self.constrain(
            self.pattern_type(pattern_field.pattern),
            self.instantiate_signature_type(self.imported.fields[selected].type_),
            self_host_pattern_type_origin(pattern, offset),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if !has_rest {
      index = 0u32
      let _ = while index {
        current => if current < self.imported.fields.length() {
          let field = self.imported.fields[current]
          if self.imported_field_owner_matches(
            field,
            declaration,
            variant_id,
          ) && !matched[current] {
            self.diagnostics.push(
              SelfHostBodyInferenceDiagnostic::MissingImportedPatternField(
                field.name,
                pattern,
                offset,
              ),
            )
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    match variant_id {
      Option::Some(variant) => self.record_imported_pattern_constructor(
        pattern,
        variant,
        true,
      )
      Option::None => self.record_imported_pattern_constructor(
        pattern,
        declaration,
        false,
      )
    }
  }

  fn select_struct_pattern(
    self,
    pattern: U32,
    base: U32,
    fields: SelfHostHirSpan,
    has_rest: Bool,
    offset: U32,
  ) -> Unit {
    let expected = self.pattern_type(pattern)
    self_host_store_inference_type(
      self.pattern_types,
      self.pattern_index(base),
      expected,
    )
    match self.names.pattern_references[base] {
      SelfHostBodyPatternReference::PatternTypeReference(declaration) => if !self_host_u64_equal(
        self_host_semantic_id_module(declaration),
        self.collected.module_id,
      ) && self.imported_declaration_is_struct(declaration) {
        self.select_imported_struct_pattern(
          pattern,
          fields,
          has_rest,
          declaration,
          Option::None,
          expected,
          offset,
        )
        return
      }
      _ => {}
    }
    match self.imported_pattern_variant_target(base, expected) {
      Option::Some(variant) => match variant.kind {
        SelfHostCollectedVariantKind::StructVariantDecl => {
          self.select_imported_struct_pattern(
            pattern,
            fields,
            has_rest,
            variant.declaration,
            Option::Some(variant.variant),
            expected,
            offset,
          )
          return
        }
        _ => {}
      }
      Option::None => {}
    }
    let mut declaration = 0u64
    let mut variant_id = Option::None
    let mut valid = false
    match self.names.pattern_references[base] {
      SelfHostBodyPatternReference::PatternTypeReference(value) => if self.declaration_is_struct(
        value,
      ) {
        declaration = value
        valid = true
      }
      _ => match self.local_pattern_variant_target(base, expected) {
        Option::Some(variant_index) => {
          let variant = self.collected.variants[variant_index]
          match variant.kind {
            SelfHostCollectedVariantKind::StructVariantDecl => {
              declaration = variant.declaration
              variant_id = Option::Some(variant.id)
              valid = true
            }
            _ => {}
          }
        }
        Option::None => {}
      }
    }
    if !valid {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(
          pattern,
          offset,
        ),
      )
      self.fail_pattern_constructor(pattern)
      return
    }
    if !self.begin_nominal_instantiation(declaration, expected) {
      self.fail_pattern_constructor(pattern)
      return
    }
    let matched = self_host_inference_bool_slots(self.collected.fields.length())
    let mut field_offset = 0u32
    let _ = while field_offset {
      current => if current < fields.length {
        let pattern_field_index = self_host_u32_add(fields.start, current)
        let pattern_field = self.collected.pattern_fields[pattern_field_index]
        let mut selected = 4294967295u32
        let mut candidate = 0u32
        let _ = while candidate {
          field_index => if field_index < self.collected.fields.length() {
            let field = self.collected.fields[field_index]
            if self.pattern_field_owner_matches(
              field,
              declaration,
              variant_id,
            ) && self_host_u32_equal(field.name, pattern_field.name) {
              selected = field_index
              break self_host_semantic_unit()
            }
            continue field_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        if self_host_u32_equal(selected, 4294967295u32) {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnknownPatternField(
              pattern_field.name,
              pattern,
              pattern_field.offset,
            ),
          )
          self.solver.poison_type(self.pattern_type(pattern_field.pattern))
        } else {
          matched[selected] = true
          self.constrain(
            self.pattern_type(pattern_field.pattern),
            self.instantiate_signature_type(self.resolved.field_types[selected]),
            self_host_pattern_type_origin(pattern, offset),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if !has_rest {
      let mut candidate = 0u32
      let _ = while candidate {
        field_index => if field_index < self.collected.fields.length() {
          let field = self.collected.fields[field_index]
          if self.pattern_field_owner_matches(
            field,
            declaration,
            variant_id,
          ) && !matched[field_index] {
            self.diagnostics.push(
              SelfHostBodyInferenceDiagnostic::MissingPatternField(
                field.name,
                pattern,
                offset,
              ),
            )
          }
          continue field_index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    let start = self.pattern_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.pattern_type_arguments.push(type_argument)
    }
    match variant_id {
      Option::Some(variant) => self_host_store_basic_pattern_constructor(
        self.pattern_constructors,
        self.pattern_index(pattern),
        SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
          variant,
          true,
          SelfHostHirSpan::{
            start: start
            length: self.candidate_type_arguments.length()
          },
        ),
      )
      Option::None => self_host_store_basic_pattern_constructor(
        self.pattern_constructors,
        self.pattern_index(pattern),
        SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
          declaration,
          false,
          SelfHostHirSpan::{
            start: start
            length: self.candidate_type_arguments.length()
          },
        ),
      )
    }
  }

  fn constrain_variant_patterns(self) -> Unit {
    let mut pattern = self.body.patterns.start
    let end = self_host_u32_add(self.body.patterns.start, self.body.patterns.length)
    let _ = while pattern {
      current => if current < end {
        match self.collected.patterns[current] {
          SelfHostHirPattern::TuplePattern(base, _, _) => if !self_host_u32_equal(
            base,
            4294967295u32,
          ) {
            self.consumed_pattern_roots[self.pattern_index(base)] = true
          }
          SelfHostHirPattern::StructPattern(base, _, _, _, _) => {
            self.consumed_pattern_roots[self.pattern_index(base)] = true
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    pattern = self.body.patterns.start
    let _ = while pattern {
      current => if current < end {
        match self.collected.patterns[current] {
          SelfHostHirPattern::TuplePattern(base, children, offset) => if !self_host_u32_equal(
            base,
            4294967295u32,
          ) {
            self.select_tuple_variant_pattern(
              current,
              base,
              children,
              offset,
            )
          }
          SelfHostHirPattern::BindingPattern(_, offset) => if !self.consumed_pattern_roots[
            self.pattern_index(current)
          ] {
            match self.names.pattern_references[current] {
              SelfHostBodyPatternReference::PatternVariantReference(_) => self.select_unit_variant_pattern(
                current,
                offset,
              )
              _ => {}
            }
          }
          SelfHostHirPattern::QualifiedPattern(_, _, offset) => if !self.consumed_pattern_roots[
            self.pattern_index(current)
          ] {
            self.select_unit_variant_pattern(current, offset)
          }
          SelfHostHirPattern::StructPattern(
            base,
            fields,
            has_rest,
            _,
            offset,
          ) => self.select_struct_pattern(
            current,
            base,
            fields,
            has_rest,
            offset,
          )
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_patterns(self) -> Unit {
    let mut pattern = self.body.patterns.start
    let end = self.body.patterns.start + self.body.patterns.length
    let _ = while pattern {
      current => if current < end {
        match self.collected.patterns[current] {
          SelfHostHirPattern::AlternativePattern(_, children, offset) => {
            let mut index = 0u32
            let _ = while index {
              child => if child < children.length {
                let child_pattern = self.collected.pattern_children[children.start + child]
                self.constrain(
                  self.pattern_type(child_pattern),
                  self.pattern_type(current),
                  self_host_pattern_type_origin(current, offset),
                )
                continue child + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostHirPattern::WildcardPattern(_) => {}
          SelfHostHirPattern::BindingPattern(_, _) => {}
          SelfHostHirPattern::RestPattern(_) => {}
          SelfHostHirPattern::LiteralPattern(_, _) => {}
          SelfHostHirPattern::TuplePattern(_, _, _) => {}
          SelfHostHirPattern::QualifiedPattern(_, _, _) => {}
          SelfHostHirPattern::StructPattern(_, _, _, _, _) => {}
          _ => self.solver.poison_type(self.pattern_type(current))
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_block_items(self) -> Unit {
    let unit = self.primitive(SelfHostPrimitiveType::UnitType)
    let mut item = self.body.block_items.start
    let end = self.body.block_items.start + self.body.block_items.length
    let _ = while item {
      current => if current < end {
        match self.collected.block_items[current] {
          SelfHostHirBlockItem::LetItem(_, _, name_offset, value, _) => {
            let local = self.names.block_item_locals[current]
            if local != 4294967295u32 && local < self.local_types.length() {
              self.constrain(
                self.local_types[local],
                self.expression_type(value),
                self_host_local_type_origin(local, name_offset),
              )
            }
          }
          SelfHostHirBlockItem::ReturnItem(value, offset) => if self.callable_index == 4294967295u32 {
            self.diagnostics.push(SelfHostBodyInferenceDiagnostic::ReturnOutsideCallable(offset))
          } else if value == 4294967295u32 {
            self.constrain(unit, self.declared_return_type, self_host_return_type_origin(current, offset))
          } else {
            self.constrain_assignable(
              self.expression_type(value),
              self.declared_return_type,
              self_host_return_type_origin(value, offset),
            )
          }
          SelfHostHirBlockItem::ExpressionItem(_, _) => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_resolved_signature_evidence(
    self,
    actual: I32,
    signature: U32,
    origin: SelfHostTypeConstraintOrigin,
  ) -> Unit {
    let representative = self.solver.representative_type(actual)
    let actual_root = match self.solver.type_term(representative) {
      SelfHostBodyTypeTerm::BodyResolvedType(value) => value
      _ => {
        return
      }
    }
    let actual_types = [actual_root]
    let signature_types = [signature]
    let _ = while actual_types.length() {
      length => if self_host_u32_greater(length, 0u32) {
        let actual_type = match actual_types.pop() {
          Option::Some(value) => value
          Option::None => {
            return
          }
        }
        let signature_type = match signature_types.pop() {
          Option::Some(value) => value
          Option::None => {
            return
          }
        }
        match self.resolved.types[signature_type] {
          SelfHostResolvedType::GenericParameterType(_) => self.constrain(
            self.solver.resolved_type(actual_type),
            self.instantiate_signature_type(signature_type),
            origin,
          )
          SelfHostResolvedType::ProductType(signature_fields) => match self.resolved.types[
            actual_type
          ] {
            SelfHostResolvedType::ProductType(actual_fields) => if self_host_u32_equal(
              actual_fields.length,
              signature_fields.length,
            ) {
              let mut index = signature_fields.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  actual_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(actual_fields.start, previous)
                    ],
                  )
                  signature_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(signature_fields.start, previous)
                    ],
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => {}
          }
          SelfHostResolvedType::AppliedType(_, signature_arguments) => match self.resolved.types[
            actual_type
          ] {
            SelfHostResolvedType::AppliedType(_, actual_arguments) => if self_host_u32_equal(
              actual_arguments.length,
              signature_arguments.length,
            ) {
              let mut index = signature_arguments.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  actual_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(actual_arguments.start, previous)
                    ],
                  )
                  signature_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(signature_arguments.start, previous)
                    ],
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => {}
          }
          SelfHostResolvedType::FunctionType(signature_parameters, signature_result) => match self.resolved.types[
            actual_type
          ] {
            SelfHostResolvedType::FunctionType(actual_parameters, actual_result) => if self_host_u32_equal(
              actual_parameters.length,
              signature_parameters.length,
            ) {
              actual_types.push(actual_result)
              signature_types.push(signature_result)
              let mut index = signature_parameters.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  actual_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(actual_parameters.start, previous)
                    ],
                  )
                  signature_types.push(
                    self.resolved.type_arguments[
                      self_host_u32_add(signature_parameters.start, previous)
                    ],
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => {}
          }
          _ => {}
        }
        continue actual_types.length()
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn select_local_callable(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    callable: U32,
  ) -> Bool {
    let declaration = self.collected.callables[callable].declaration
    self.begin_signature_instantiation(declaration)
    let parameters = self.collected.parameters_of(declaration)
    if !self_host_u32_equal(parameters.length, arguments.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::CallArgumentCountMismatch(
          expression,
          declaration,
          parameters.length,
          arguments.length,
          offset,
        ),
      )
      self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::ErrorBasicCallTarget
      self.solver.poison_type(self.expression_type(expression))
      return true
    }
    let parameter_types = []
    let mut index = 0u32
    let _ = while index {
      current => if current < parameters.length {
        let signature_type = self.resolved.parameter_types[
          self_host_u32_add(parameters.start, current)
        ]
        let parameter_type = self.instantiate_signature_type(signature_type)
        parameter_types.push(parameter_type)
        let argument_type = self.expression_type(
          self.collected.expression_children[arguments.start + current],
        )
        let origin = self_host_call_type_origin(expression, offset)
        self.constrain_assignable(argument_type, parameter_type, origin)
        self.constrain_resolved_signature_evidence(
          argument_type,
          signature_type,
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let result_type = self.instantiate_signature_type(
      self.resolved.callable_return_types[callable],
    )
    self.constrain(
      self.expression_type(expression),
      result_type,
      self_host_call_type_origin(expression, offset),
    )
    self.solver.poison_type(self.expression_type(target))
    let type_argument_start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::SelectedBasicCallTarget(
      declaration,
      SelfHostHirSpan::{
        start: type_argument_start
        length: self.candidate_type_arguments.length()
      },
    )
    true
  }

  fn constrain_unique_direct_local_call(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
  ) -> Bool {
    let name = match self.collected.expressions[target] {
      SelfHostHirExpr::NameExpr(value, _) => value
      _ => {
        return false
      }
    }
    match self.unique_local_callable_index(name) {
      Option::Some(callable) => self.select_local_callable(
        expression,
        target,
        arguments,
        offset,
        callable,
      )
      Option::None => false
    }
  }

  fn local_callable_candidate_viable(
    self,
    expression: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    callable: U32,
  ) -> Bool {
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    if !self_host_u32_equal(parameters.length, arguments.length) {
      return false
    }
    let snapshot = self.solver.snapshot()
    self.begin_signature_instantiation(declaration)
    let origin = self_host_call_type_origin(expression, offset)
    let mut viable = true
    let mut index = 0u32
    let _ = while index {
      current => if viable && current < parameters.length {
        let parameter_type = self.instantiate_signature_type(
          self.resolved.parameter_types[
            self_host_u32_add(parameters.start, current)
          ],
        )
        viable = self.solver.unify(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          parameter_type,
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(
          self.resolved.callable_return_types[callable],
        ),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_overloaded_local_callable(
    self,
    expression: U32,
    target: U32,
    name: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
  ) -> Unit {
    let binding = match self.collected.value_bindings.get(name) {
      Option::Some(value) => value
      Option::None => {
        self.mark_unsupported(expression)
        self.solver.poison_type(self.expression_type(target))
        return
      }
    }
    let mut candidate_index = binding.head
    let mut selected_callable = 4294967295u32
    let mut selected_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut best_generic_count = 4294967295u32
    let mut best_count = 0u32
    let mut searching = true
    let _ = while searching {
      active => if active {
        let candidate = self.collected.value_binding_candidates[candidate_index]
        match self.local_callable_index_of_declaration(candidate.declaration) {
          Option::Some(callable) => if self.local_callable_candidate_viable(
            expression,
            arguments,
            offset,
            callable,
          ) {
            let generic_count = self.collected.generic_parameters_of(
              candidate.declaration,
            ).length
            if generic_count < best_generic_count {
              selected_callable = callable
              selected_declaration = candidate.declaration
              second_declaration = 18446744073709551615u64
              best_generic_count = generic_count
              best_count = 1u32
            } else if self_host_u32_equal(generic_count, best_generic_count) {
              if self_host_u32_equal(best_count, 1u32) {
                second_declaration = candidate.declaration
              }
              best_count = best_count + 1u32
            }
          }
          Option::None => {}
        }
        match candidate.next {
          Option::Some(next) => {
            candidate_index = next
            continue true
          }
          Option::None => break self_host_semantic_unit()
        }
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(best_count, 1u32) {
      let _ = self.select_local_callable(
        expression,
        target,
        arguments,
        offset,
        selected_callable,
      )
    } else {
      self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::ErrorBasicCallTarget
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      if self_host_u32_equal(best_count, 0u32) {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(
            expression,
            name,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::AmbiguousDirectCall(
            expression,
            name,
            selected_declaration,
            second_declaration,
            best_count,
            offset,
          ),
        )
      }
    }
  }

  fn commit_imported_callable(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    callable: SelfHostResolvedImportedCallable,
  ) -> Bool {
    let declaration = callable.declaration
    if !self_host_u32_equal(callable.parameters.length, arguments.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::CallArgumentCountMismatch(
          expression,
          declaration,
          callable.parameters.length,
          arguments.length,
          offset,
        ),
      )
      self_host_store_basic_call_target(
        self.call_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      return true
    }
    self.begin_imported_signature_instantiation(callable)
    let origin = self_host_call_type_origin(expression, offset)
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        let argument = self.collected.expression_children[
          self_host_u32_add(arguments.start, current)
        ]
        let parameter = self.imported.parameter_types[
          self_host_u32_add(callable.parameters.start, current)
        ]
        self.constrain_assignable(
          self.expression_type(argument),
          self.instantiate_signature_type(parameter),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(callable.result_type),
      origin,
    )
    self.solver.poison_type(self.expression_type(target))
    let type_argument_start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    self_host_store_basic_call_target(
      self.call_targets,
      self.expression_index(expression),
      SelfHostBasicCallTarget::SelectedBasicCallTarget(
        declaration,
        SelfHostHirSpan::{
          start: type_argument_start
          length: self.candidate_type_arguments.length()
        },
      ),
    )
    true
  }

  fn imported_callable_candidate_viable(
    self,
    expression: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    callable: SelfHostResolvedImportedCallable,
  ) -> Bool {
    if !self_host_u32_equal(callable.parameters.length, arguments.length) {
      return false
    }
    let snapshot = self.solver.snapshot()
    self.begin_imported_signature_instantiation(callable)
    let origin = self_host_call_type_origin(expression, offset)
    let mut viable = true
    let mut index = 0u32
    let _ = while index {
      current => if viable && current < arguments.length {
        viable = self.solver.unify(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          self.instantiate_signature_type(
            self.imported.parameter_types[
              self_host_u32_add(callable.parameters.start, current)
            ],
          ),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(callable.result_type),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_imported_callable(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    declaration: U64,
  ) -> Bool {
    let reference = match self.imported_callable(declaration) {
      Option::Some(value) => value
      Option::None => {
        return false
      }
    }
    let mut candidate_count = 0u32
    for callable in self.imported.callables {
      let same_module = self_host_u64_equal(
        self_host_semantic_id_module(callable.declaration),
        self_host_semantic_id_module(declaration),
      )
      let candidate_name = callable.name
      let reference_name = reference.name
      let top_level = match callable.kind {
        SelfHostFrozenInterfaceCallableKind::FrozenFunctionCallable => true
        SelfHostFrozenInterfaceCallableKind::FrozenBuiltinCallable(_) => true
        _ => false
      }
      if same_module && top_level && self_host_basic_string_equal(
        candidate_name,
        reference_name,
      ) {
        candidate_count = candidate_count + 1u32
      }
    }
    if self_host_u32_equal(candidate_count, 1u32) {
      return self.commit_imported_callable(
        expression,
        target,
        arguments,
        offset,
        reference,
      )
    }
    let mut selected = 4294967295u32
    let mut first_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut best_generic_count = 4294967295u32
    let mut best_count = 0u32
    let mut index = 0u32
    let _ = while index {
      current => if current < self.imported.callables.length() {
        let callable = self.imported.callables[current]
        let candidate_name = callable.name
        let reference_name = reference.name
        let same_module = self_host_u64_equal(
          self_host_semantic_id_module(callable.declaration),
          self_host_semantic_id_module(declaration),
        )
        let top_level = match callable.kind {
          SelfHostFrozenInterfaceCallableKind::FrozenFunctionCallable => true
          SelfHostFrozenInterfaceCallableKind::FrozenBuiltinCallable(_) => true
          _ => false
        }
        if same_module && top_level && self_host_basic_string_equal(
          candidate_name,
          reference_name,
        ) && self.imported_callable_candidate_viable(
          expression,
          arguments,
          offset,
          callable,
        ) {
          let generic_count = callable.generic_parameters.length
          if generic_count < best_generic_count {
            selected = current
            first_declaration = callable.declaration
            second_declaration = 18446744073709551615u64
            best_generic_count = generic_count
            best_count = 1u32
          } else if self_host_u32_equal(generic_count, best_generic_count) {
            if self_host_u32_equal(best_count, 1u32) {
              second_declaration = callable.declaration
            }
            best_count = best_count + 1u32
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(best_count, 1u32) {
      self.commit_imported_callable(
        expression,
        target,
        arguments,
        offset,
        self.imported.callables[selected],
      )
    } else {
      let name = match self.collected.expressions[target] {
        SelfHostHirExpr::NameExpr(value, _) => value
        SelfHostHirExpr::QualifiedExpr(_, property, _) => property
        _ => 4294967295u32
      }
      self_host_store_basic_call_target(
        self.call_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      if self_host_u32_equal(best_count, 0u32) {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(
            expression,
            name,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::AmbiguousDirectCall(
            expression,
            name,
            first_declaration,
            second_declaration,
            best_count,
            offset,
          ),
        )
      }
      true
    }
  }

  fn constrain_pending_direct_call(self, expression: U32) -> Unit {
    let (target, arguments, offset) = match self.collected.expressions[expression] {
      SelfHostHirExpr::CallExpr(call_target, call_arguments, call_offset) => (
        call_target,
        call_arguments,
        call_offset,
      )
      _ => {
        return
      }
    }
    match self.names.expression_references[target] {
      SelfHostBodyNameReference::ImportedModuleValueNameReference(
        declaration,
      ) => {
        if !self.select_imported_callable(
          expression,
          target,
          arguments,
          offset,
          declaration,
        ) {
          self.mark_unsupported(expression)
          self.solver.poison_type(self.expression_type(target))
        }
        return
      }
      _ => {}
    }
    let name = match self.collected.expressions[target] {
      SelfHostHirExpr::NameExpr(value, _) => value
      _ => {
        self.mark_unsupported(expression)
        self.solver.poison_type(self.expression_type(target))
        return
      }
    }
    let binding = match self.collected.value_bindings.get(name) {
      Option::Some(value) => value
      Option::None => {
        self.mark_unsupported(expression)
        self.solver.poison_type(self.expression_type(target))
        return
      }
    }
    let first = self.collected.value_binding_candidates[binding.head]
    match first.next {
      Option::None => if !self.constrain_unique_direct_local_call(
        expression,
        target,
        arguments,
        offset,
      ) {
        self.mark_unsupported(expression)
        self.solver.poison_type(self.expression_type(target))
      }
      Option::Some(_) => self.select_overloaded_local_callable(
        expression,
        target,
        name,
        arguments,
        offset,
      )
    }
  }

  fn constrain_pending_direct_calls(self) -> Unit {
    for expression in self.pending_direct_calls {
      self.constrain_pending_direct_call(expression)
    }
    self.pending_direct_calls.clear()
  }

  fn resolved_nominal_head(self, type_: U32) -> Option<U64> {
    match self.resolved.types[type_] {
      SelfHostResolvedType::NominalType(declaration) => Option::Some(declaration)
      SelfHostResolvedType::AppliedType(base, _) => match self.resolved.types[base] {
        SelfHostResolvedType::NominalType(declaration) => Option::Some(declaration)
        _ => Option::None
      }
      _ => Option::None
    }
  }

  fn begin_method_instantiation(
    self,
    implementation: U32,
    method: U64,
    receiver_type: I32,
  ) -> I32 {
    let implementation_declaration = self.collected.impls[implementation].declaration
    self.instantiation_generics = self.collected.generic_parameters_of(
      implementation_declaration,
    )
    self.instantiation_method_generics = self.collected.generic_parameters_of(method)
    self.candidate_type_arguments.clear()
    let total = self_host_u32_add(
      self.instantiation_generics.length,
      self.instantiation_method_generics.length,
    )
    let mut index = 0u32
    let _ = while index {
      current => if current < total {
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = implementation_declaration
    self.instantiation_self_type = receiver_type
    self.instantiate_signature_type(
      self.resolved.impl_target_types[implementation],
    )
  }

  fn method_candidate_viable(
    self,
    expression: U32,
    receiver: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Bool {
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    if self_host_u32_equal(parameters.length, 0u32) || !self_host_u32_equal(
      self_host_u32_subtract(parameters.length, 1u32),
      arguments.length,
    ) {
      return false
    }
    let snapshot = self.solver.snapshot()
    let receiver_type = self.expression_type(receiver)
    let target = self.begin_method_instantiation(
      implementation,
      declaration,
      receiver_type,
    )
    let origin = self_host_call_type_origin(expression, offset)
    let mut viable = self.solver.unify(receiver_type, target, origin)
    if viable {
      viable = self.solver.unify(
        receiver_type,
        self.instantiate_signature_type(
          self.resolved.parameter_types[parameters.start],
        ),
        origin,
      )
    }
    let mut index = 0u32
    let _ = while index {
      current => if viable && current < arguments.length {
        viable = self.solver.unify(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          self.instantiate_signature_type(
            self.resolved.parameter_types[
              self_host_u32_add(parameters.start, current + 1u32)
            ],
          ),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(
          self.resolved.callable_return_types[callable],
        ),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_method_candidate(
    self,
    expression: U32,
    target: U32,
    receiver: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Unit {
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    let receiver_type = self.expression_type(receiver)
    let target_type = self.begin_method_instantiation(
      implementation,
      declaration,
      receiver_type,
    )
    let origin = self_host_call_type_origin(expression, offset)
    self.constrain(receiver_type, target_type, origin)
    self.constrain_resolved_signature_evidence(
      receiver_type,
      self.resolved.impl_target_types[implementation],
      origin,
    )
    self.constrain(
      receiver_type,
      self.instantiate_signature_type(
        self.resolved.parameter_types[parameters.start],
      ),
      origin,
    )
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        let signature_type = self.resolved.parameter_types[
          self_host_u32_add(parameters.start, current + 1u32)
        ]
        let actual = self.expression_type(
          self.collected.expression_children[
            self_host_u32_add(arguments.start, current)
          ],
        )
        self.constrain_assignable(
          actual,
          self.instantiate_signature_type(signature_type),
          origin,
        )
        self.constrain_resolved_signature_evidence(actual, signature_type, origin)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(
        self.resolved.callable_return_types[callable],
      ),
      origin,
    )
    let argument_start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::SelectedBasicCallTarget(
      declaration,
      SelfHostHirSpan::{
        start: argument_start
        length: self.candidate_type_arguments.length()
      },
    )
    self.consumed_member_roots[self.expression_index(target)] = true
    self.solver.poison_type(self.expression_type(target))
  }

  fn imported_implementation(
    self,
    declaration: U64,
  ) -> Option<SelfHostResolvedImportedImplementation> {
    for implementation in self.imported.implementations {
      if self_host_u64_equal(implementation.declaration, declaration) {
        return Option::Some(implementation)
      }
    }
    Option::None
  }

  fn imported_method_candidate_viable(
    self,
    expression: U32,
    receiver: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    implementation: SelfHostResolvedImportedImplementation,
    callable: SelfHostResolvedImportedCallable,
  ) -> Bool {
    if !self_host_u32_equal(
      callable.parameters.length,
      self_host_u32_add(arguments.length, 1u32),
    ) {
      return false
    }
    let snapshot = self.solver.snapshot()
    let receiver_type = self.expression_type(receiver)
    self.begin_imported_method_instantiation(
      implementation,
      callable,
      receiver_type,
    )
    let origin = self_host_call_type_origin(expression, offset)
    let mut viable = self.solver.unify(
      receiver_type,
      self.instantiate_signature_type(
        self.imported.parameter_types[callable.parameters.start],
      ),
      origin,
    )
    let mut index = 0u32
    let _ = while index {
      current => if viable && current < arguments.length {
        viable = self.solver.unify(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          self.instantiate_signature_type(
            self.imported.parameter_types[
              self_host_u32_add(callable.parameters.start, current + 1u32)
            ],
          ),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(callable.result_type),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_imported_method_candidate(
    self,
    expression: U32,
    target: U32,
    receiver: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    implementation: SelfHostResolvedImportedImplementation,
    callable: SelfHostResolvedImportedCallable,
  ) -> Unit {
    let receiver_type = self.expression_type(receiver)
    self.begin_imported_method_instantiation(
      implementation,
      callable,
      receiver_type,
    )
    let origin = self_host_call_type_origin(expression, offset)
    self.constrain(
      receiver_type,
      self.instantiate_signature_type(
        self.imported.parameter_types[callable.parameters.start],
      ),
      origin,
    )
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        self.constrain_assignable(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          self.instantiate_signature_type(
            self.imported.parameter_types[
              self_host_u32_add(callable.parameters.start, current + 1u32)
            ],
          ),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(callable.result_type),
      origin,
    )
    let start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    self_host_store_basic_call_target(
      self.call_targets,
      self.expression_index(expression),
      SelfHostBasicCallTarget::SelectedBasicCallTarget(
        callable.declaration,
        SelfHostHirSpan::{
          start: start
          length: self.candidate_type_arguments.length()
        },
      ),
    )
    self.consumed_member_roots[self.expression_index(target)] = true
    self.solver.poison_type(self.expression_type(target))
  }

  fn constrain_imported_method_call(
    self,
    expression: U32,
    target: U32,
    receiver: U32,
    name: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
    receiver_declaration: U64,
  ) -> Bool {
    let method_name = self.collected.name(name)
    let mut selected_callable = 4294967295u32
    let mut selected_implementation = 4294967295u32
    let mut first_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut count = 0u32
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self.imported.callables.length() {
        let callable = self.imported.callables[current]
        let candidate_name = callable.name
        if self_host_basic_string_equal(candidate_name, method_name) {
          match callable.kind {
            SelfHostFrozenInterfaceCallableKind::FrozenImplCallable(
              implementation_declaration,
            ) => match self.imported_implementation(implementation_declaration) {
              Option::Some(implementation) => match implementation.trait_type {
                Option::None => match self.resolved_nominal_head(
                  implementation.target_type,
                ) {
                  Option::Some(owner) => if self_host_u64_equal(
                    owner,
                    receiver_declaration,
                  ) && self.imported_method_candidate_viable(
                    expression,
                    receiver,
                    arguments,
                    offset,
                    implementation,
                    callable,
                  ) {
                    if self_host_u32_equal(count, 0u32) {
                      selected_callable = current
                      let mut implementation_index = 0u32
                      let _ = while implementation_index {
                        candidate => if candidate < self.imported.implementations.length() {
                          if self_host_u64_equal(
                            self.imported.implementations[candidate].declaration,
                            implementation_declaration,
                          ) {
                            selected_implementation = candidate
                            break self_host_semantic_unit()
                          }
                          continue candidate + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                      first_declaration = callable.declaration
                    } else if self_host_u32_equal(count, 1u32) {
                      second_declaration = callable.declaration
                    }
                    count = count + 1u32
                  }
                  Option::None => {}
                }
                Option::Some(_) => {}
              }
              Option::None => {}
            }
            _ => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(count, 0u32) {
      false
    } else if self_host_u32_equal(count, 1u32) {
      self.select_imported_method_candidate(
        expression,
        target,
        receiver,
        arguments,
        offset,
        self.imported.implementations[selected_implementation],
        self.imported.callables[selected_callable],
      )
      true
    } else {
      self_host_store_basic_call_target(
        self.call_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::AmbiguousMethod(
          name,
          expression,
          first_declaration,
          second_declaration,
          count,
          offset,
        ),
      )
      true
    }
  }

  fn constrain_pending_method_call(self, expression: U32) -> Unit {
    let (target, arguments, offset) = match self.collected.expressions[expression] {
      SelfHostHirExpr::CallExpr(call_target, call_arguments, call_offset) => (
        call_target,
        call_arguments,
        call_offset,
      )
      _ => {
        return
      }
    }
    let (receiver, name) = match self.collected.expressions[target] {
      SelfHostHirExpr::FieldExpr(base, method_name, _) => (base, method_name)
      _ => {
        return
      }
    }
    let receiver_declaration = match self.inspect_nominal_type(
      self.expression_type(receiver),
    ) {
      Option::Some(value) => value
      Option::None => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingMethod(
            name,
            expression,
            offset,
          ),
        )
        self.solver.poison_type(self.expression_type(expression))
        self.solver.poison_type(self.expression_type(target))
        return
      }
    }
    let mut selected_impl = 4294967295u32
    let mut selected_callable = 4294967295u32
    let mut selected_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut viable_count = 0u32
    let mut method_index = 0u32
    let _ = while method_index {
      current => if current < self.collected.methods.length() {
        let method = self.collected.methods[current]
        if self_host_u32_equal(method.name, name) {
          let mut implementation = 0u32
          let _ = while implementation {
            impl_index => if impl_index < self.collected.impls.length() {
              let impl_ = self.collected.impls[impl_index]
              if self_host_u64_equal(impl_.declaration, method.parent) {
                match impl_.trait_type {
                  Option::None => match self.resolved_nominal_head(
                    self.resolved.impl_target_types[impl_index],
                  ) {
                    Option::Some(declaration) => if self_host_u64_equal(
                      declaration,
                      receiver_declaration,
                    ) {
                      match self.local_callable_index_of_declaration(method.id) {
                        Option::Some(callable) => if self.method_candidate_viable(
                          expression,
                          receiver,
                          arguments,
                          offset,
                          impl_index,
                          callable,
                        ) {
                          viable_count = viable_count + 1u32
                          if self_host_u32_equal(viable_count, 1u32) {
                            selected_impl = impl_index
                            selected_callable = callable
                            selected_declaration = method.id
                          } else if self_host_u32_equal(viable_count, 2u32) {
                            second_declaration = method.id
                          }
                        }
                        Option::None => {}
                      }
                    }
                    Option::None => {}
                  }
                  Option::Some(_) => {}
                }
              }
              continue impl_index + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(viable_count, 0u32) && self.constrain_imported_method_call(
      expression,
      target,
      receiver,
      name,
      arguments,
      offset,
      receiver_declaration,
    ) {
      return
    }
    if self_host_u32_equal(viable_count, 1u32) {
      self.select_method_candidate(
        expression,
        target,
        receiver,
        arguments,
        offset,
        selected_impl,
        selected_callable,
      )
    } else {
      self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::ErrorBasicCallTarget
      self.solver.poison_type(self.expression_type(expression))
      self.solver.poison_type(self.expression_type(target))
      if self_host_u32_equal(viable_count, 0u32) {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingMethod(
            name,
            expression,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::AmbiguousMethod(
            name,
            expression,
            selected_declaration,
            second_declaration,
            viable_count,
            offset,
          ),
        )
      }
    }
  }

  fn constrain_pending_method_calls(self) -> Unit {
    for expression in self.pending_method_calls {
      self.constrain_pending_method_call(expression)
    }
    self.pending_method_calls.clear()
  }

  fn is_local_variant_target(self, target: U32) -> Bool {
    match self.names.expression_references[target] {
      SelfHostBodyNameReference::VariantNameReference(_) => {
        return true
      }
      _ => {}
    }
    match self.collected.expressions[target] {
      SelfHostHirExpr::QualifiedExpr(base, _, _) => match self.names.expression_references[
        base
      ] {
        SelfHostBodyNameReference::ModuleTypeNameReference(_) => true
        _ => false
      }
      _ => false
    }
  }

  fn local_variant_target(self, target: U32) -> Option<U32> {
    match self.names.expression_references[target] {
      SelfHostBodyNameReference::VariantNameReference(name) => {
        let mut index = 0u32
        let _ = while index {
          current => if current < self.collected.variants.length() {
            if self_host_u32_equal(self.collected.variants[current].name, name) {
              return Option::Some(current)
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      _ => {}
    }
    match self.collected.expressions[target] {
      SelfHostHirExpr::QualifiedExpr(base, property, _) => match self.names.expression_references[
        base
      ] {
        SelfHostBodyNameReference::ModuleTypeNameReference(declaration) => {
          let mut index = 0u32
          while index {
            current => if current < self.collected.variants.length() {
              let variant = self.collected.variants[current]
              if self_host_u64_equal(variant.declaration, declaration) && self_host_u32_equal(
                variant.name,
                property,
              ) {
                return Option::Some(current)
              }
              continue current + 1u32
            } else {
              break Option::None
            }
          }
        }
        _ => Option::None
      }
      _ => Option::None
    }
  }

  fn consume_variant_target(self, target: U32, expression: U32) -> Unit {
    if !self_host_u32_equal(target, expression) {
      self.consumed_member_roots[self.expression_index(target)] = true
      self.solver.poison_type(self.expression_type(target))
    }
    match self.collected.expressions[target] {
      SelfHostHirExpr::QualifiedExpr(base, _, _) => {
        self.consumed_member_roots[self.expression_index(base)] = true
        self.solver.poison_type(self.expression_type(base))
      }
      _ => {}
    }
  }

  fn record_variant_selection(
    self,
    expression: U32,
    variant: U32,
    kind: U32,
  ) -> SelfHostHirSpan {
    let start = self.expression_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.expression_type_arguments.push(type_argument)
    }
    let arguments = SelfHostHirSpan::{
      start: start
      length: self.candidate_type_arguments.length()
    }
    let selection_index = self.expression_index(expression)
    let variant_id = self.collected.variants[variant].id
    let selection = SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
      variant_id,
      kind,
      arguments,
    )
    self_host_store_basic_expression_selection(
      self.expression_selections,
      selection_index,
      selection,
    )
    arguments
  }

  fn record_imported_variant_selection(
    self,
    expression: U32,
    variant: SelfHostResolvedImportedVariant,
    kind: U32,
  ) -> SelfHostHirSpan {
    let start = self.expression_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.expression_type_arguments.push(type_argument)
    }
    let arguments = SelfHostHirSpan::{
      start: start
      length: self.candidate_type_arguments.length()
    }
    self_host_store_basic_expression_selection(
      self.expression_selections,
      self.expression_index(expression),
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
        variant.variant,
        kind,
        arguments,
      ),
    )
    arguments
  }

  fn select_imported_unit_variant_value(
    self,
    expression: U32,
    variant: SelfHostResolvedImportedVariant,
    offset: U32,
  ) -> Unit {
    match variant.kind {
      SelfHostCollectedVariantKind::UnitVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::ConstructionPayloadKindMismatch(
            expression,
            variant.variant,
            offset,
          ),
        )
        self.fail_construction(expression)
        return
      }
    }
    let instance = self.begin_fresh_imported_nominal_instantiation(
      variant.declaration,
    )
    self.constrain(
      self.expression_type(expression),
      instance,
      self_host_expression_type_origin(expression, offset),
    )
    let _ = self.record_imported_variant_selection(expression, variant, 2u32)
    self.consume_variant_target(expression, expression)
  }

  fn select_imported_tuple_variant_call(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    variant: SelfHostResolvedImportedVariant,
    offset: U32,
  ) -> Unit {
    match variant.kind {
      SelfHostCollectedVariantKind::TupleVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::ConstructionPayloadKindMismatch(
            expression,
            variant.variant,
            offset,
          ),
        )
        self.fail_construction(expression)
        self_host_store_basic_call_target(
          self.call_targets,
          self.expression_index(expression),
          SelfHostBasicCallTarget::ErrorBasicCallTarget,
        )
        return
      }
    }
    if !self_host_u32_equal(variant.payload_types.length, arguments.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::ConstructionPayloadArityMismatch(
          expression,
          variant.variant,
          variant.payload_types.length,
          arguments.length,
          offset,
        ),
      )
      self.fail_construction(expression)
      self_host_store_basic_call_target(
        self.call_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      return
    }
    let instance = self.begin_fresh_imported_nominal_instantiation(
      variant.declaration,
    )
    let origin = self_host_call_type_origin(expression, offset)
    self.constrain(self.expression_type(expression), instance, origin)
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        let signature_type = self.imported.variant_payload_types[
          self_host_u32_add(variant.payload_types.start, current)
        ]
        self.constrain_assignable(
          self.expression_type(
            self.collected.expression_children[
              self_host_u32_add(arguments.start, current)
            ],
          ),
          self.instantiate_signature_type(signature_type),
          origin,
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let type_arguments = self.record_imported_variant_selection(
      expression,
      variant,
      1u32,
    )
    self_host_store_basic_call_target(
      self.call_targets,
      self.expression_index(expression),
      SelfHostBasicCallTarget::SelectedBasicCallTarget(
        variant.variant,
        type_arguments,
      ),
    )
    self.consume_variant_target(target, expression)
  }

  fn select_unit_variant_value(
    self,
    expression: U32,
    variant_index: U32,
    offset: U32,
  ) -> Unit {
    let variant = self.collected.variants[variant_index]
    match variant.kind {
      SelfHostCollectedVariantKind::UnitVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::ConstructionPayloadKindMismatch(
            expression,
            variant.id,
            offset,
          ),
        )
        self.fail_construction(expression)
        return
      }
    }
    let instance = self.begin_fresh_nominal_instantiation(variant.declaration)
    self.constrain(
      self.expression_type(expression),
      instance,
      self_host_expression_type_origin(expression, offset),
    )
    let _ = self.record_variant_selection(expression, variant_index, 2u32)
    self.consume_variant_target(expression, expression)
  }

  fn select_tuple_variant_call(
    self,
    expression: U32,
    target: U32,
    arguments: SelfHostHirSpan,
    variant_index: U32,
    offset: U32,
  ) -> Unit {
    let variant = self.collected.variants[variant_index]
    match variant.kind {
      SelfHostCollectedVariantKind::TupleVariantDecl => {}
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::ConstructionPayloadKindMismatch(
            expression,
            variant.id,
            offset,
          ),
        )
        self.fail_construction(expression)
        self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::ErrorBasicCallTarget
        return
      }
    }
    let payload = self.resolved.variant_payloads[variant_index]
    if !self_host_u32_equal(payload.length, arguments.length) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::ConstructionPayloadArityMismatch(
          expression,
          variant.id,
          payload.length,
          arguments.length,
          offset,
        ),
      )
      self.fail_construction(expression)
      self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::ErrorBasicCallTarget
      return
    }
    let instance = self.begin_fresh_nominal_instantiation(variant.declaration)
    let origin = self_host_call_type_origin(expression, offset)
    self.constrain(self.expression_type(expression), instance, origin)
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        let signature_type = self.resolved.signature_type_lists[
          self_host_u32_add(payload.start, current)
        ]
        let actual = self.expression_type(
          self.collected.expression_children[
            self_host_u32_add(arguments.start, current)
          ],
        )
        self.constrain_assignable(
          actual,
          self.instantiate_signature_type(signature_type),
          origin,
        )
        self.constrain_resolved_signature_evidence(actual, signature_type, origin)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let type_arguments = self.record_variant_selection(
      expression,
      variant_index,
      1u32,
    )
    self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::SelectedBasicCallTarget(
      variant.id,
      type_arguments,
    )
    self.consume_variant_target(target, expression)
  }

  fn constrain_pending_variant_calls(self) -> Unit {
    for expression in self.pending_variant_calls {
      match self.collected.expressions[expression] {
        SelfHostHirExpr::CallExpr(target, arguments, offset) => match self.local_variant_target(
          target,
        ) {
          Option::Some(variant) => self.select_tuple_variant_call(
            expression,
            target,
            arguments,
            variant,
            offset,
          )
          Option::None => match self.imported_variant_target(target) {
            Option::Some(variant) => self.select_imported_tuple_variant_call(
              expression,
              target,
              arguments,
              variant,
              offset,
            )
            Option::None => {
              self.mark_unsupported(expression)
              self.solver.poison_type(self.expression_type(target))
            }
          }
        }
        _ => {}
      }
    }
    self.pending_variant_calls.clear()
  }

  fn constrain_pending_variant_values(self) -> Unit {
    for expression in self.pending_variant_values {
      if !self.consumed_member_roots[self.expression_index(expression)] {
        match self.local_variant_target(expression) {
          Option::Some(variant) => self.select_unit_variant_value(
            expression,
            variant,
            self_host_basic_expression_offset(self.collected.expressions[expression]),
          )
          Option::None => match self.imported_variant_target(expression) {
            Option::Some(variant) => self.select_imported_unit_variant_value(
              expression,
              variant,
              self_host_basic_expression_offset(self.collected.expressions[expression]),
            )
            Option::None => self.mark_unsupported(expression)
          }
        }
      }
    }
    self.pending_variant_values.clear()
  }

  fn imported_declaration_is_struct(self, declaration: U64) -> Bool {
    if self.imported.type_declaration_types.get(declaration) is Option::None {
      return false
    }
    for variant in self.imported.variants {
      if self_host_u64_equal(variant.declaration, declaration) {
        return false
      }
    }
    true
  }

  fn declaration_is_struct(self, declaration: U64) -> Bool {
    if !self_host_u64_equal(
      self_host_semantic_id_module(declaration),
      self.collected.module_id,
    ) {
      return false
    }
    let local = self_host_semantic_id_local(declaration)
    if local >= self.collected.declarations.length() {
      return false
    }
    match self.collected.declarations[local].kind {
      SelfHostCollectedDeclKind::StructDecl => true
      _ => false
    }
  }

  fn begin_fresh_nominal_instantiation(self, declaration: U64) -> I32 {
    self.begin_signature_instantiation(declaration)
    let base = self.solver.resolved_type(
      self.resolved.declaration_type(declaration),
    )
    if self_host_u32_equal(self.candidate_type_arguments.length(), 0u32) {
      base
    } else {
      self.solver.applied_type(base, self.candidate_type_arguments)
    }
  }

  fn fail_construction(self, expression: U32) -> Unit {
    self_host_store_basic_expression_selection(
      self.expression_selections,
      self.expression_index(expression),
      SelfHostBasicExpressionSelection::ErrorBasicExpressionSelection,
    )
    self.solver.poison_type(self.expression_type(expression))
  }

  fn imported_field_owner_matches(
    self,
    field: SelfHostResolvedImportedField,
    declaration: U64,
    variant: Option<U64>,
  ) -> Bool {
    if !self_host_u64_equal(field.declaration, declaration) {
      false
    } else {
      match field.variant {
        Option::None => variant is Option::None
        Option::Some(left) => match variant {
          Option::Some(right) => self_host_u64_equal(left, right)
          Option::None => false
        }
      }
    }
  }

  fn select_imported_struct_construction(
    self,
    expression: U32,
    target: U32,
    object_fields: SelfHostHirSpan,
    declaration: U64,
    variant_id: Option<U64>,
    offset: U32,
  ) -> Unit {
    let instance = self.begin_fresh_imported_nominal_instantiation(declaration)
    let origin = self_host_expression_type_origin(expression, offset)
    self.constrain(self.expression_type(expression), instance, origin)
    let matched = self_host_inference_bool_slots(self.imported.fields.length())
    let mut failed = false
    let mut index = 0u32
    let _ = while index {
      current => if current < object_fields.length {
        let object_field_index = self_host_u32_add(object_fields.start, current)
        let object_field = self.collected.object_fields[object_field_index]
        let name = self.collected.name(object_field.name)
        let mut selected = 4294967295u32
        let mut candidate = 0u32
        let _ = while candidate {
          field_index => if field_index < self.imported.fields.length() {
            let field = self.imported.fields[field_index]
            let field_name = field.name
            if self.imported_field_owner_matches(
              field,
              declaration,
              variant_id,
            ) && self_host_basic_string_equal(field_name, name) {
              selected = field_index
              break self_host_semantic_unit()
            }
            continue field_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        if self_host_u32_equal(selected, 4294967295u32) {
          failed = true
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::ErrorBasicObjectFieldTarget
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnknownConstructionField(
              expression,
              object_field.name,
              declaration,
              object_field.offset,
            ),
          )
        } else if matched[selected] {
          failed = true
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::ErrorBasicObjectFieldTarget
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::DuplicateConstructionField(
              expression,
              object_field.name,
              object_field.offset,
            ),
          )
        } else {
          matched[selected] = true
          let field = self.imported.fields[selected]
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::SelectedBasicObjectFieldTarget(
            field.field,
          )
          self.constrain_assignable(
            self.expression_type(object_field.value),
            self.instantiate_signature_type(field.type_),
            origin,
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    index = 0u32
    let _ = while index {
      current => if current < self.imported.fields.length() {
        let field = self.imported.fields[current]
        if self.imported_field_owner_matches(
          field,
          declaration,
          variant_id,
        ) && !matched[current] {
          failed = true
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::MissingImportedConstructionField(
              expression,
              field.name,
              declaration,
              offset,
            ),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if variant_id is Option::Some(_) {
      self.consume_variant_target(target, expression)
    } else {
      self.solver.poison_type(self.expression_type(target))
    }
    if failed {
      self.fail_construction(expression)
    } else {
      let start = self.expression_type_arguments.length()
      for type_argument in self.candidate_type_arguments {
        self.expression_type_arguments.push(type_argument)
      }
      match variant_id {
        Option::Some(variant) => self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
            variant,
            object_fields.length,
            SelfHostHirSpan::{
              start: start
              length: self.candidate_type_arguments.length()
            },
          ),
        )
        Option::None => self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
            declaration,
            SelfHostHirSpan::{
              start: start
              length: self.candidate_type_arguments.length()
            },
          ),
        )
      }
    }
  }

  fn select_struct_construction(
    self,
    expression: U32,
    target: U32,
    fields: SelfHostHirSpan,
    declaration: U64,
    variant_id: Option<U64>,
    offset: U32,
  ) -> Unit {
    let instance_type = self.begin_fresh_nominal_instantiation(declaration)
    let origin = self_host_expression_type_origin(expression, offset)
    self.constrain(self.expression_type(expression), instance_type, origin)
    let matched = self_host_inference_bool_slots(self.collected.fields.length())
    let mut failed = false
    let mut index = 0u32
    let _ = while index {
      current => if current < fields.length {
        let object_field_index = self_host_u32_add(fields.start, current)
        let object_field = self.collected.object_fields[object_field_index]
        let mut selected = 4294967295u32
        let mut field_index = 0u32
        let _ = while field_index {
          candidate => if candidate < self.collected.fields.length() {
            let field = self.collected.fields[candidate]
            if self.pattern_field_owner_matches(
              field,
              declaration,
              variant_id,
            ) && self_host_u32_equal(field.name, object_field.name) {
              selected = candidate
              break self_host_semantic_unit()
            }
            continue candidate + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        if self_host_u32_equal(selected, 4294967295u32) {
          failed = true
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::ErrorBasicObjectFieldTarget
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnknownConstructionField(
              expression,
              object_field.name,
              declaration,
              object_field.offset,
            ),
          )
        } else if matched[selected] {
          failed = true
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::ErrorBasicObjectFieldTarget
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::DuplicateConstructionField(
              expression,
              object_field.name,
              object_field.offset,
            ),
          )
        } else {
          matched[selected] = true
          let field = self.collected.fields[selected]
          self.object_field_targets[object_field_index - self.body.object_fields.start] = SelfHostBasicObjectFieldTarget::SelectedBasicObjectFieldTarget(
            field.id,
          )
          let signature_type = self.resolved.field_types[selected]
          let expected = self.instantiate_signature_type(signature_type)
          let actual = self.expression_type(object_field.value)
          self.constrain_assignable(actual, expected, origin)
          self.constrain_resolved_signature_evidence(
            actual,
            signature_type,
            origin,
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    index = 0u32
    let _ = while index {
      current => if current < self.collected.fields.length() {
        let field = self.collected.fields[current]
        if self.pattern_field_owner_matches(
          field,
          declaration,
          variant_id,
        ) && !matched[current] {
          failed = true
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::MissingConstructionField(
              expression,
              field.name,
              declaration,
              offset,
            ),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    match variant_id {
      Option::Some(_) => self.consume_variant_target(target, expression)
      Option::None => self.solver.poison_type(self.expression_type(target))
    }
    if failed {
      self.fail_construction(expression)
    } else {
      let argument_start = self.expression_type_arguments.length()
      for type_argument in self.candidate_type_arguments {
        self.expression_type_arguments.push(type_argument)
      }
      match variant_id {
        Option::Some(variant) => self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
            variant,
            fields.length,
            SelfHostHirSpan::{
              start: argument_start
              length: self.candidate_type_arguments.length()
            },
          ),
        )
        Option::None => self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
            declaration,
            SelfHostHirSpan::{
              start: argument_start
              length: self.candidate_type_arguments.length()
            },
          ),
        )
      }
    }
  }

  fn constrain_pending_construction(self, expression: U32) -> Unit {
    let (target, fields, offset) = match self.collected.expressions[expression] {
      SelfHostHirExpr::ConstructExpr(value, object_fields, expression_offset) => (
        value,
        object_fields,
        expression_offset,
      )
      _ => {
        return
      }
    }
    match self.local_variant_target(target) {
      Option::Some(variant_index) => {
        let variant = self.collected.variants[variant_index]
        match variant.kind {
          SelfHostCollectedVariantKind::StructVariantDecl => self.select_struct_construction(
            expression,
            target,
            fields,
            variant.declaration,
            Option::Some(variant.id),
            offset,
          )
          _ => {
            self.diagnostics.push(
              SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(
                expression,
                offset,
              ),
            )
            self.fail_construction(expression)
          }
        }
        return
      }
      Option::None => {}
    }
    match self.imported_variant_target(target) {
      Option::Some(variant) => {
        match variant.kind {
          SelfHostCollectedVariantKind::StructVariantDecl => self.select_imported_struct_construction(
            expression,
            target,
            fields,
            variant.declaration,
            Option::Some(variant.variant),
            offset,
          )
          _ => {
            self.diagnostics.push(
              SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(
                expression,
                offset,
              ),
            )
            self.fail_construction(expression)
          }
        }
        return
      }
      Option::None => {}
    }
    let declaration = match self.names.expression_references[target] {
      SelfHostBodyNameReference::ModuleTypeNameReference(value) => value
      _ => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(
            expression,
            offset,
          ),
        )
        self.fail_construction(expression)
        return
      }
    }
    if !self_host_u64_equal(
      self_host_semantic_id_module(declaration),
      self.collected.module_id,
    ) {
      if self.imported_declaration_is_struct(declaration) {
        self.select_imported_struct_construction(
          expression,
          target,
          fields,
          declaration,
          Option::None,
          offset,
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(
            expression,
            offset,
          ),
        )
        self.fail_construction(expression)
      }
      return
    }
    if !self.declaration_is_struct(declaration) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::InvalidConstructionTarget(
          expression,
          offset,
        ),
      )
      self.fail_construction(expression)
      return
    }
    self.select_struct_construction(
      expression,
      target,
      fields,
      declaration,
      Option::None,
      offset,
    )
  }

  fn constrain_pending_constructions(self) -> Unit {
    for expression in self.pending_constructions {
      self.constrain_pending_construction(expression)
    }
    self.pending_constructions.clear()
  }

  fn select_imported_field_expression(
    self,
    expression: U32,
    base_type: I32,
    name: U32,
    declaration: U64,
    offset: U32,
  ) -> Bool {
    let field_name = self.collected.name(name)
    let mut selected = 4294967295u32
    let mut index = 0u32
    let _ = while index {
      current => if current < self.imported.fields.length() {
        let field = self.imported.fields[current]
        let candidate_name = field.name
        if self_host_u64_equal(field.declaration, declaration) && self_host_basic_string_equal(
          candidate_name,
          field_name,
        ) {
          match field.variant {
            Option::None => {
              selected = current
              break self_host_semantic_unit()
            }
            Option::Some(_) => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(selected, 4294967295u32) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::UnknownFieldForType(
          name,
          declaration,
          expression,
          offset,
        ),
      )
      self_host_store_basic_expression_selection(
        self.expression_selections,
        self.expression_index(expression),
        SelfHostBasicExpressionSelection::ErrorBasicExpressionSelection,
      )
      self.solver.poison_type(self.expression_type(expression))
      return true
    }
    if !self.begin_imported_nominal_instantiation(declaration, base_type) {
      return false
    }
    let field = self.imported.fields[selected]
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(field.type_),
      self_host_expression_type_origin(expression, offset),
    )
    self_host_store_basic_expression_selection(
      self.expression_selections,
      self.expression_index(expression),
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        field.field,
        field.mutable_,
      ),
    )
    true
  }

  fn select_field_expression(
    self,
    expression: U32,
    base: U32,
    name: U32,
    offset: U32,
  ) -> Bool {
    let base_type = self.expression_type(base)
    let representative = self.solver.representative_type(base_type)
    match self.solver.type_term(representative) {
      SelfHostBodyTypeTerm::BodyVariableType(_) => {
        return false
      }
      SelfHostBodyTypeTerm::BodyErrorType => {
        self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::ErrorBasicExpressionSelection,
        )
        self.solver.poison_type(self.expression_type(expression))
        return true
      }
      _ => {}
    }
    let declaration = match self.inspect_nominal_type(base_type) {
      Option::Some(value) => value
      Option::None => {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::FieldAccessRequiresNominal(
            expression,
            offset,
          ),
        )
        self_host_store_basic_expression_selection(
          self.expression_selections,
          self.expression_index(expression),
          SelfHostBasicExpressionSelection::ErrorBasicExpressionSelection,
        )
        self.solver.poison_type(self.expression_type(expression))
        return true
      }
    }
    if !self_host_u64_equal(
      self_host_semantic_id_module(declaration),
      self.collected.module_id,
    ) {
      return self.select_imported_field_expression(
        expression,
        base_type,
        name,
        declaration,
        offset,
      )
    }
    let mut field_index = 4294967295u32
    let mut index = 0u32
    let _ = while index {
      current => if current < self.collected.fields.length() {
        let field = self.collected.fields[current]
        if self_host_u64_equal(field.declaration, declaration) && self_host_u32_equal(field.name, name) {
          match field.variant {
            Option::None => {
              field_index = current
              break self_host_semantic_unit()
            }
            Option::Some(_) => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(field_index, 4294967295u32) {
      self.diagnostics.push(
        SelfHostBodyInferenceDiagnostic::UnknownFieldForType(
          name,
          declaration,
          expression,
          offset,
        ),
      )
      self_host_store_basic_expression_selection(
        self.expression_selections,
        self.expression_index(expression),
        SelfHostBasicExpressionSelection::ErrorBasicExpressionSelection,
      )
      self.solver.poison_type(self.expression_type(expression))
      return true
    }
    if !self.begin_nominal_instantiation(declaration, base_type) {
      return false
    }
    let field_type = self.instantiate_signature_type(
      self.resolved.field_types[field_index],
    )
    self.constrain(
      self.expression_type(expression),
      field_type,
      self_host_expression_type_origin(expression, offset),
    )
    let field = self.collected.fields[field_index]
    self_host_store_basic_expression_selection(
      self.expression_selections,
      self.expression_index(expression),
      SelfHostBasicExpressionSelection::FieldBasicExpressionSelection(
        field.id,
        field.mutable_,
      ),
    )
    true
  }

  fn constrain_pending_fields(self) -> Unit {
    let mut pass = 0u32
    let mut progress = true
    let _ = while pass {
      current_pass => if current_pass < self.pending_fields.length() && progress {
        progress = false
        for expression in self.pending_fields {
          if !self.consumed_member_roots[self.expression_index(expression)] {
            match self.expression_selections[self.expression_index(expression)] {
              SelfHostBasicExpressionSelection::NoBasicExpressionSelection => match self.collected.expressions[
                expression
              ] {
                SelfHostHirExpr::FieldExpr(base, name, offset) => if self.select_field_expression(
                  expression,
                  base,
                  name,
                  offset,
                ) {
                  progress = true
                }
                _ => {}
              }
              _ => {}
            }
          }
        }
        continue current_pass + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    for expression in self.pending_fields {
      if !self.consumed_member_roots[self.expression_index(expression)] {
        match self.expression_selections[self.expression_index(expression)] {
          SelfHostBasicExpressionSelection::NoBasicExpressionSelection => self.mark_unsupported(
            expression,
          )
          _ => {}
        }
      }
    }
    self.pending_fields.clear()
  }

  fn constrain_call(self, expression: U32, target: U32, arguments: SelfHostHirSpan, offset: U32) -> Unit {
    if self.is_local_variant_target(target) {
      self.consumed_member_roots[self.expression_index(target)] = true
      match self.collected.expressions[target] {
        SelfHostHirExpr::QualifiedExpr(base, _, _) => {
          self.consumed_member_roots[self.expression_index(base)] = true
        }
        _ => {}
      }
      self.pending_variant_calls.push(expression)
      return
    }
    match self.imported_variant_target(target) {
      Option::Some(_) => {
        self.consumed_member_roots[self.expression_index(target)] = true
        match self.collected.expressions[target] {
          SelfHostHirExpr::QualifiedExpr(base, _, _) => {
            self.consumed_member_roots[self.expression_index(base)] = true
          }
          _ => {}
        }
        self.pending_variant_calls.push(expression)
        return
      }
      Option::None => {}
    }
    match self.collected.expressions[target] {
      SelfHostHirExpr::FieldExpr(_, _, _) => {
        self.consumed_member_roots[self.expression_index(target)] = true
        self.pending_method_calls.push(expression)
        return
      }
      _ => {}
    }
    match self.names.expression_references[target] {
      SelfHostBodyNameReference::ModuleValueNameReference(_) => {
        self.pending_direct_calls.push(expression)
        return
      }
      SelfHostBodyNameReference::ImportedModuleValueNameReference(_) => {
        self.pending_direct_calls.push(expression)
        return
      }
      _ => {}
    }
    let parameters = []
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        parameters.push(self.solver.fresh_variable())
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let function_type = self.solver.function_type(parameters, self.expression_type(expression))
    self.constrain(
      self.expression_type(target),
      function_type,
      self_host_call_type_origin(expression, offset),
    )
    index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        self.constrain_assignable(
          self.expression_type(self.collected.expression_children[arguments.start + current]),
          parameters[current],
          self_host_call_type_origin(expression, offset),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.call_targets[self.expression_index(expression)] = SelfHostBasicCallTarget::FunctionValueBasicCallTarget(
      target,
    )
  }

  fn binary_operator_trait_name(
    self,
    operator: SelfHostHirBinaryOperator,
  ) -> Option<String> {
    match operator {
      SelfHostHirBinaryOperator::LogicalOr => Option::None
      SelfHostHirBinaryOperator::LogicalAnd => Option::None
      SelfHostHirBinaryOperator::BitOr => Option::Some("BitOr")
      SelfHostHirBinaryOperator::BitXor => Option::Some("BitXor")
      SelfHostHirBinaryOperator::BitAnd => Option::Some("BitAnd")
      SelfHostHirBinaryOperator::Equal => Option::Some("Eq")
      SelfHostHirBinaryOperator::NotEqual => Option::Some("Ne")
      SelfHostHirBinaryOperator::Less => Option::Some("Lt")
      SelfHostHirBinaryOperator::LessEqual => Option::Some("Lte")
      SelfHostHirBinaryOperator::Greater => Option::Some("Gt")
      SelfHostHirBinaryOperator::GreaterEqual => Option::Some("Gte")
      SelfHostHirBinaryOperator::ShiftLeft => Option::Some("Shl")
      SelfHostHirBinaryOperator::ShiftRight => Option::Some("Shr")
      SelfHostHirBinaryOperator::Add => Option::Some("Add")
      SelfHostHirBinaryOperator::Subtract => Option::Some("Sub")
      SelfHostHirBinaryOperator::Multiply => Option::Some("Mul")
      SelfHostHirBinaryOperator::Divide => Option::Some("Div")
      SelfHostHirBinaryOperator::Remainder => Option::Some("Rem")
      SelfHostHirBinaryOperator::Exponentiate => Option::Some("Pow")
    }
  }

  fn binary_operator_method_name(
    self,
    operator: SelfHostHirBinaryOperator,
  ) -> Option<String> {
    match operator {
      SelfHostHirBinaryOperator::LogicalOr => Option::None
      SelfHostHirBinaryOperator::LogicalAnd => Option::None
      SelfHostHirBinaryOperator::BitOr => Option::Some("bit_or")
      SelfHostHirBinaryOperator::BitXor => Option::Some("bit_xor")
      SelfHostHirBinaryOperator::BitAnd => Option::Some("bit_and")
      SelfHostHirBinaryOperator::Equal => Option::Some("eq")
      SelfHostHirBinaryOperator::NotEqual => Option::Some("ne")
      SelfHostHirBinaryOperator::Less => Option::Some("lt")
      SelfHostHirBinaryOperator::LessEqual => Option::Some("lte")
      SelfHostHirBinaryOperator::Greater => Option::Some("gt")
      SelfHostHirBinaryOperator::GreaterEqual => Option::Some("gte")
      SelfHostHirBinaryOperator::ShiftLeft => Option::Some("shl")
      SelfHostHirBinaryOperator::ShiftRight => Option::Some("shr")
      SelfHostHirBinaryOperator::Add => Option::Some("add")
      SelfHostHirBinaryOperator::Subtract => Option::Some("sub")
      SelfHostHirBinaryOperator::Multiply => Option::Some("mul")
      SelfHostHirBinaryOperator::Divide => Option::Some("div")
      SelfHostHirBinaryOperator::Remainder => Option::Some("rem")
      SelfHostHirBinaryOperator::Exponentiate => Option::Some("pow")
    }
  }

  fn local_trait_named(self, spelling: String) -> Option<U64> {
    match self.collected.find_name(spelling) {
      Option::Some(name) => self.collected.trait_bindings.get(name)
      Option::None => Option::None
    }
  }

  fn resolved_trait_head(self, type_: U32) -> Option<U64> {
    match self.resolved.types[type_] {
      SelfHostResolvedType::TraitType(declaration) => Option::Some(declaration)
      SelfHostResolvedType::AppliedType(base, _) => match self.resolved.types[base] {
        SelfHostResolvedType::TraitType(declaration) => Option::Some(declaration)
        _ => Option::None
      }
      _ => Option::None
    }
  }

  fn constrain_binary_expression(
    self,
    expression: U32,
    operator: SelfHostHirBinaryOperator,
    left: U32,
    right: U32,
    offset: U32,
  ) -> Unit {
    let trait_name = self.binary_operator_trait_name(operator)
    let method_name = self.binary_operator_method_name(operator)
    match trait_name {
      Option::Some(trait_spelling) => match method_name {
        Option::Some(method_spelling) => match self.local_trait_named(
          trait_spelling,
        ) {
          Option::Some(_) => match self.collected.find_name(method_spelling) {
            Option::Some(_) => {
              self.pending_operators.push(expression)
              return
            }
            Option::None => {}
          }
          Option::None => {}
        }
        Option::None => {}
      }
      Option::None => {}
    }
    let origin = self_host_operator_type_origin(expression, offset)
    match operator {
      SelfHostHirBinaryOperator::LogicalOr => {
        self.constrain(self.expression_type(left), self.primitive(SelfHostPrimitiveType::BoolType), origin)
        self.constrain(self.expression_type(right), self.primitive(SelfHostPrimitiveType::BoolType), origin)
      }
      SelfHostHirBinaryOperator::LogicalAnd => {
        self.constrain(self.expression_type(left), self.primitive(SelfHostPrimitiveType::BoolType), origin)
        self.constrain(self.expression_type(right), self.primitive(SelfHostPrimitiveType::BoolType), origin)
      }
      SelfHostHirBinaryOperator::Equal => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      SelfHostHirBinaryOperator::NotEqual => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      SelfHostHirBinaryOperator::Less => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      SelfHostHirBinaryOperator::LessEqual => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      SelfHostHirBinaryOperator::Greater => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      SelfHostHirBinaryOperator::GreaterEqual => self.constrain(self.expression_type(left), self.expression_type(right), origin)
      _ => {
        self.constrain(self.expression_type(left), self.expression_type(right), origin)
        self.constrain(self.expression_type(expression), self.expression_type(left), origin)
      }
    }
  }

  fn binary_operator_candidate_viable(
    self,
    expression: U32,
    left: U32,
    right: U32,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Bool {
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    if !self_host_u32_equal(parameters.length, 2u32) {
      return false
    }
    let snapshot = self.solver.snapshot()
    let left_type = self.expression_type(left)
    let target = self.begin_method_instantiation(
      implementation,
      declaration,
      left_type,
    )
    let origin = self_host_operator_type_origin(expression, offset)
    let mut viable = self.solver.unify(left_type, target, origin)
    if viable {
      viable = self.solver.unify(left_type, self.expression_type(right), origin)
    }
    if viable {
      viable = self.solver.unify(
        left_type,
        self.instantiate_signature_type(
          self.resolved.parameter_types[parameters.start],
        ),
        origin,
      )
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(right),
        self.instantiate_signature_type(
          self.resolved.parameter_types[
            self_host_u32_add(parameters.start, 1u32)
          ],
        ),
        origin,
      )
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(
          self.resolved.callable_return_types[callable],
        ),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_binary_operator_candidate(
    self,
    expression: U32,
    left: U32,
    right: U32,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Unit {
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    let left_type = self.expression_type(left)
    let target = self.begin_method_instantiation(
      implementation,
      declaration,
      left_type,
    )
    let origin = self_host_operator_type_origin(expression, offset)
    self.constrain(left_type, target, origin)
    self.constrain_resolved_signature_evidence(
      left_type,
      self.resolved.impl_target_types[implementation],
      origin,
    )
    self.constrain(left_type, self.expression_type(right), origin)
    self.constrain(
      left_type,
      self.instantiate_signature_type(
        self.resolved.parameter_types[parameters.start],
      ),
      origin,
    )
    let right_signature = self.resolved.parameter_types[
      self_host_u32_add(parameters.start, 1u32)
    ]
    self.constrain_assignable(
      self.expression_type(right),
      self.instantiate_signature_type(right_signature),
      origin,
    )
    self.constrain_resolved_signature_evidence(
      self.expression_type(right),
      right_signature,
      origin,
    )
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(
        self.resolved.callable_return_types[callable],
      ),
      origin,
    )
    let start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    let target_index = self.expression_index(expression)
    let selected_target = SelfHostBasicCallTarget::SelectedBasicCallTarget(
      declaration,
      SelfHostHirSpan::{
        start: start
        length: self.candidate_type_arguments.length()
      },
    )
    self_host_store_basic_call_target(
      self.operator_targets,
      target_index,
      selected_target,
    )
    return
  }

  fn constrain_pending_binary_operator(self, expression: U32) -> Unit {
    let (operator, left, right, offset) = match self.collected.expressions[expression] {
      SelfHostHirExpr::BinaryExpr(value, left_expression, right_expression, expression_offset) => (
        value,
        left_expression,
        right_expression,
        expression_offset,
      )
      _ => {
        return
      }
    }
    let trait_declaration = match self.binary_operator_trait_name(operator) {
      Option::Some(spelling) => match self.local_trait_named(spelling) {
        Option::Some(value) => value
        Option::None => {
          return
        }
      }
      Option::None => {
        return
      }
    }
    let method_name = match self.binary_operator_method_name(operator) {
      Option::Some(spelling) => match self.collected.find_name(spelling) {
        Option::Some(value) => value
        Option::None => {
          return
        }
      }
      Option::None => {
        return
      }
    }
    let mut selected_impl = 4294967295u32
    let mut selected_callable = 4294967295u32
    let mut selected_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut viable_count = 0u32
    let mut implementation = 0u32
    let _ = while implementation {
      current => if current < self.collected.impls.length() {
        match self.resolved.impl_trait_types[current] {
          Option::Some(trait_type) => match self.resolved_trait_head(trait_type) {
            Option::Some(candidate_trait) => if self_host_u64_equal(
              candidate_trait,
              trait_declaration,
            ) {
              let impl_declaration = self.collected.impls[current].declaration
              let mut method_index = 0u32
              let _ = while method_index {
                method_slot => if method_slot < self.collected.methods.length() {
                  let method = self.collected.methods[method_slot]
                  if self_host_u64_equal(method.parent, impl_declaration) && self_host_u32_equal(
                    method.name,
                    method_name,
                  ) {
                    match self.local_callable_index_of_declaration(method.id) {
                      Option::Some(callable) => if self.binary_operator_candidate_viable(
                        expression,
                        left,
                        right,
                        offset,
                        current,
                        callable,
                      ) {
                        viable_count = viable_count + 1u32
                        if self_host_u32_equal(viable_count, 1u32) {
                          selected_impl = current
                          selected_callable = callable
                          selected_declaration = method.id
                        } else if self_host_u32_equal(viable_count, 2u32) {
                          second_declaration = method.id
                        }
                      }
                      Option::None => {}
                    }
                  }
                  continue method_slot + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            Option::None => {}
          }
          Option::None => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(viable_count, 1u32) {
      self.select_binary_operator_candidate(
        expression,
        left,
        right,
        offset,
        selected_impl,
        selected_callable,
      )
    } else {
      self_host_store_basic_call_target(
        self.operator_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      self.solver.poison_type(self.expression_type(expression))
      if self_host_u32_equal(viable_count, 0u32) {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingOperator(
            expression,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::AmbiguousOperator(
            expression,
            selected_declaration,
            second_declaration,
            viable_count,
            offset,
          ),
        )
      }
    }
  }

  fn index_trait_name(self, expression: U32) -> Option<String> {
    match self.collected.expressions[expression] {
      SelfHostHirExpr::IndexExpr(_, _, _) => Option::Some("IndexedGet")
      SelfHostHirExpr::IndexSetExpr(_, _, _, _) => Option::Some("IndexedSet")
      _ => Option::None
    }
  }

  fn index_method_name(self, expression: U32) -> Option<String> {
    match self.collected.expressions[expression] {
      SelfHostHirExpr::IndexExpr(_, _, _) => Option::Some("indexed_get")
      SelfHostHirExpr::IndexSetExpr(_, _, _, _) => Option::Some("indexed_set")
      _ => Option::None
    }
  }

  fn queue_index_operator(self, expression: U32) -> Bool {
    let trait_name = self.index_trait_name(expression)
    let method_name = self.index_method_name(expression)
    match trait_name {
      Option::Some(trait_spelling) => match method_name {
        Option::Some(method_spelling) => match self.local_trait_named(
          trait_spelling,
        ) {
          Option::Some(_) => match self.collected.find_name(method_spelling) {
            Option::Some(_) => {
              self.pending_operators.push(expression)
              true
            }
            Option::None => false
          }
          Option::None => false
        }
        Option::None => false
      }
      Option::None => false
    }
  }

  fn index_operator_candidate_viable(
    self,
    expression: U32,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Bool {
    let (base, index, value, expected_parameters) = match self.collected.expressions[
      expression
    ] {
      SelfHostHirExpr::IndexExpr(base_expression, index_expression, _) => (
        base_expression,
        index_expression,
        4294967295u32,
        2u32,
      )
      SelfHostHirExpr::IndexSetExpr(
        base_expression,
        index_expression,
        value_expression,
        _,
      ) => (base_expression, index_expression, value_expression, 3u32)
      _ => {
        return false
      }
    }
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    if !self_host_u32_equal(parameters.length, expected_parameters) {
      return false
    }
    let snapshot = self.solver.snapshot()
    let base_type = self.expression_type(base)
    let target = self.begin_method_instantiation(
      implementation,
      declaration,
      base_type,
    )
    let origin = self_host_operator_type_origin(expression, offset)
    let mut viable = self.solver.unify(base_type, target, origin)
    if viable {
      viable = self.solver.unify(
        base_type,
        self.instantiate_signature_type(
          self.resolved.parameter_types[parameters.start],
        ),
        origin,
      )
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(index),
        self.instantiate_signature_type(
          self.resolved.parameter_types[
            self_host_u32_add(parameters.start, 1u32)
          ],
        ),
        origin,
      )
    }
    if viable && !self_host_u32_equal(value, 4294967295u32) {
      viable = self.solver.unify(
        self.expression_type(value),
        self.instantiate_signature_type(
          self.resolved.parameter_types[
            self_host_u32_add(parameters.start, 2u32)
          ],
        ),
        origin,
      )
    }
    if viable {
      viable = self.solver.unify(
        self.expression_type(expression),
        self.instantiate_signature_type(
          self.resolved.callable_return_types[callable],
        ),
        origin,
      )
    }
    self.solver.rollback(snapshot)
    viable
  }

  fn select_index_operator_candidate(
    self,
    expression: U32,
    offset: U32,
    implementation: U32,
    callable: U32,
  ) -> Unit {
    let (base, index, value) = match self.collected.expressions[expression] {
      SelfHostHirExpr::IndexExpr(base_expression, index_expression, _) => (
        base_expression,
        index_expression,
        4294967295u32,
      )
      SelfHostHirExpr::IndexSetExpr(
        base_expression,
        index_expression,
        value_expression,
        _,
      ) => (base_expression, index_expression, value_expression)
      _ => {
        return
      }
    }
    let declaration = self.collected.callables[callable].declaration
    let parameters = self.collected.parameters_of(declaration)
    let base_type = self.expression_type(base)
    let target = self.begin_method_instantiation(
      implementation,
      declaration,
      base_type,
    )
    let origin = self_host_operator_type_origin(expression, offset)
    self.constrain(base_type, target, origin)
    self.constrain_resolved_signature_evidence(
      base_type,
      self.resolved.impl_target_types[implementation],
      origin,
    )
    self.constrain(
      base_type,
      self.instantiate_signature_type(
        self.resolved.parameter_types[parameters.start],
      ),
      origin,
    )
    let index_signature = self.resolved.parameter_types[
      self_host_u32_add(parameters.start, 1u32)
    ]
    self.constrain_assignable(
      self.expression_type(index),
      self.instantiate_signature_type(index_signature),
      origin,
    )
    self.constrain_resolved_signature_evidence(
      self.expression_type(index),
      index_signature,
      origin,
    )
    if !self_host_u32_equal(value, 4294967295u32) {
      let value_signature = self.resolved.parameter_types[
        self_host_u32_add(parameters.start, 2u32)
      ]
      self.constrain_assignable(
        self.expression_type(value),
        self.instantiate_signature_type(value_signature),
        origin,
      )
      self.constrain_resolved_signature_evidence(
        self.expression_type(value),
        value_signature,
        origin,
      )
    }
    self.constrain(
      self.expression_type(expression),
      self.instantiate_signature_type(
        self.resolved.callable_return_types[callable],
      ),
      origin,
    )
    let start = self.call_type_arguments.length()
    for type_argument in self.candidate_type_arguments {
      self.call_type_arguments.push(type_argument)
    }
    let target_index = self.expression_index(expression)
    let selected_target = SelfHostBasicCallTarget::SelectedBasicCallTarget(
      declaration,
      SelfHostHirSpan::{
        start: start
        length: self.candidate_type_arguments.length()
      },
    )
    self_host_store_basic_call_target(
      self.operator_targets,
      target_index,
      selected_target,
    )
    return
  }

  fn constrain_pending_index_operator(self, expression: U32) -> Unit {
    let offset = self_host_basic_expression_offset(
      self.collected.expressions[expression],
    )
    let trait_declaration = match self.index_trait_name(expression) {
      Option::Some(spelling) => match self.local_trait_named(spelling) {
        Option::Some(value) => value
        Option::None => {
          return
        }
      }
      Option::None => {
        return
      }
    }
    let method_name = match self.index_method_name(expression) {
      Option::Some(spelling) => match self.collected.find_name(spelling) {
        Option::Some(value) => value
        Option::None => {
          return
        }
      }
      Option::None => {
        return
      }
    }
    let mut selected_impl = 4294967295u32
    let mut selected_callable = 4294967295u32
    let mut selected_declaration = 18446744073709551615u64
    let mut second_declaration = 18446744073709551615u64
    let mut viable_count = 0u32
    let mut implementation = 0u32
    let _ = while implementation {
      current => if current < self.collected.impls.length() {
        match self.resolved.impl_trait_types[current] {
          Option::Some(trait_type) => match self.resolved_trait_head(trait_type) {
            Option::Some(candidate_trait) => if self_host_u64_equal(
              candidate_trait,
              trait_declaration,
            ) {
              let impl_declaration = self.collected.impls[current].declaration
              let mut method_index = 0u32
              let _ = while method_index {
                method_slot => if method_slot < self.collected.methods.length() {
                  let method = self.collected.methods[method_slot]
                  if self_host_u64_equal(method.parent, impl_declaration) && self_host_u32_equal(
                    method.name,
                    method_name,
                  ) {
                    match self.local_callable_index_of_declaration(method.id) {
                      Option::Some(callable) => if self.index_operator_candidate_viable(
                        expression,
                        offset,
                        current,
                        callable,
                      ) {
                        viable_count = viable_count + 1u32
                        if self_host_u32_equal(viable_count, 1u32) {
                          selected_impl = current
                          selected_callable = callable
                          selected_declaration = method.id
                        } else if self_host_u32_equal(viable_count, 2u32) {
                          second_declaration = method.id
                        }
                      }
                      Option::None => {}
                    }
                  }
                  continue method_slot + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            Option::None => {}
          }
          Option::None => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(viable_count, 1u32) {
      self.select_index_operator_candidate(
        expression,
        offset,
        selected_impl,
        selected_callable,
      )
    } else {
      self_host_store_basic_call_target(
        self.operator_targets,
        self.expression_index(expression),
        SelfHostBasicCallTarget::ErrorBasicCallTarget,
      )
      self.solver.poison_type(self.expression_type(expression))
      if self_host_u32_equal(viable_count, 0u32) {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::NoMatchingOperator(
            expression,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::AmbiguousOperator(
            expression,
            selected_declaration,
            second_declaration,
            viable_count,
            offset,
          ),
        )
      }
    }
  }

  fn constrain_pending_operators(self) -> Unit {
    for expression in self.pending_operators {
      match self.collected.expressions[expression] {
        SelfHostHirExpr::BinaryExpr(_, _, _, _) => self.constrain_pending_binary_operator(
          expression,
        )
        SelfHostHirExpr::IndexExpr(_, _, _) => self.constrain_pending_index_operator(
          expression,
        )
        SelfHostHirExpr::IndexSetExpr(_, _, _, _) => self.constrain_pending_index_operator(
          expression,
        )
        _ => {}
      }
    }
    self.pending_operators.clear()
  }

  fn constrain_match(self, expression: U32, scrutinee: U32, arms: SelfHostHirSpan, offset: U32) -> Unit {
    let expected = self.expression_type(scrutinee)
    let result = self.expression_type(expression)
    let mut index = 0u32
    let _ = while index {
      current => if current < arms.length {
        let arm = self.collected.pattern_arms[self.collected.arm_children[arms.start + current]]
        self.constrain(self.pattern_type(arm.pattern), expected, self_host_pattern_type_origin(arm.pattern, arm.offset))
        if !self_host_u32_equal(arm.guard_condition, 4294967295u32) {
          self.constrain(
            self.expression_type(arm.guard_condition),
            self.primitive(SelfHostPrimitiveType::BoolType),
            self_host_expression_type_origin(arm.guard_condition, arm.offset),
          )
        }
        self.constrain_assignable(
          self.expression_type(arm.body),
          result,
          self_host_expression_type_origin(expression, offset),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_while(self, expression: U32, initial: U32, arms: SelfHostHirSpan, offset: U32) -> Unit {
    let control = self.names.expression_controls[expression]
    if control == 4294967295u32 || control >= self.control_state_types.length() {
      self.solver.poison_type(self.expression_type(expression))
      return
    }
    let state = self.control_state_types[control]
    self.constrain(self.expression_type(initial), state, self_host_expression_type_origin(expression, offset))
    let mut index = 0u32
    let _ = while index {
      current => if current < arms.length {
        let arm = self.collected.pattern_arms[self.collected.arm_children[arms.start + current]]
        self.constrain(self.pattern_type(arm.pattern), state, self_host_pattern_type_origin(arm.pattern, arm.offset))
        if !self_host_u32_equal(arm.guard_condition, 4294967295u32) {
          self.constrain(
            self.expression_type(arm.guard_condition),
            self.primitive(SelfHostPrimitiveType::BoolType),
            self_host_expression_type_origin(arm.guard_condition, arm.offset),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_transfer(self, expression: U32, value: U32, break_: Bool, offset: U32) -> Unit {
    let control = self.names.transfer_targets[expression]
    if control != 4294967295u32 && control < self.control_state_types.length() {
      let expected = if break_ {
        self.control_result_types[control]
      } else {
        self.control_state_types[control]
      }
      self.constrain_assignable(
        self.expression_type(value),
        expected,
        self_host_expression_type_origin(expression, offset),
      )
    }
  }

  fn constrain_expressions(self) -> Unit {
    let mut expression = self.body.expressions.start
    let end = self.body.expressions.start + self.body.expressions.length
    let _ = while expression {
      current => if current < end {
        let offset = self_host_basic_expression_offset(
          self.collected.expressions[current],
        )
        match self.collected.expressions[current] {
          SelfHostHirExpr::ArrayExpr(elements, _) => {
            let representative = self.solver.representative_type(self.expression_type(current))
            let element_type = match self.solver.type_term(representative) {
              SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if arguments.length == 1u32 {
                self.solver.type_argument(arguments.start)
              } else {
                self.solver.error_type()
              }
              _ => self.solver.error_type()
            }
            let mut index = 0u32
            let _ = while index {
              item => if item < elements.length {
                self.constrain(
                  self.expression_type(self.collected.expression_children[elements.start + item]),
                  element_type,
                  self_host_expression_type_origin(current, offset),
                )
                continue item + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostHirExpr::IfExpr(condition, block, alternative, _) => {
            self.constrain(self.expression_type(condition), self.primitive(SelfHostPrimitiveType::BoolType), self_host_expression_type_origin(condition, offset))
            if alternative == 4294967295u32 {
              self.constrain(self.expression_type(current), self.primitive(SelfHostPrimitiveType::UnitType), self_host_expression_type_origin(current, offset))
            } else {
              self.constrain_assignable(self.block_type(block), self.expression_type(current), self_host_expression_type_origin(current, offset))
              self.constrain_assignable(self.expression_type(alternative), self.expression_type(current), self_host_expression_type_origin(current, offset))
            }
          }
          SelfHostHirExpr::PrefixExpr(operator, value, _) => match operator {
            SelfHostHirPrefixOperator::LogicalNot => {
              self.constrain(self.expression_type(value), self.primitive(SelfHostPrimitiveType::BoolType), self_host_operator_type_origin(current, offset))
              self.constrain(self.expression_type(current), self.primitive(SelfHostPrimitiveType::BoolType), self_host_operator_type_origin(current, offset))
            }
            _ => self.constrain(self.expression_type(current), self.expression_type(value), self_host_operator_type_origin(current, offset))
          }
          SelfHostHirExpr::BinaryExpr(operator, left, right, _) => self.constrain_binary_expression(
            current,
            operator,
            left,
            right,
            offset,
          )
          SelfHostHirExpr::CallExpr(target, arguments, _) => self.constrain_call(current, target, arguments, offset)
          SelfHostHirExpr::MatchExpr(scrutinee, arms, _) => self.constrain_match(current, scrutinee, arms, offset)
          SelfHostHirExpr::WhileExpr(initial, arms, _) => self.constrain_while(current, initial, arms, offset)
          SelfHostHirExpr::BreakExpr(value, _) => self.constrain_transfer(current, value, true, offset)
          SelfHostHirExpr::ContinueExpr(value, _) => self.constrain_transfer(current, value, false, offset)
          SelfHostHirExpr::ProductFieldExpr(base, index, arity, _) => {
            if index < arity && arity >= 2u32 && arity <= 32u32 {
              let fields = []
              let mut field = 0u32
              let _ = while field {
                slot => if slot < arity {
                  fields.push(self.solver.fresh_variable())
                  continue slot + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              self.constrain(self.expression_type(base), self.solver.product_type(fields), self_host_expression_type_origin(current, offset))
              self.constrain(self.expression_type(current), fields[index], self_host_expression_type_origin(current, offset))
            } else {
              self.solver.poison_type(self.expression_type(current))
            }
          }
          SelfHostHirExpr::AssignmentExpr(target, value, _) => {
            let mutable_ = match self.names.expression_references[target] {
              SelfHostBodyNameReference::LocalNameReference(local) => self.names.locals[self.name_info.locals.start + local].mutable_
              SelfHostBodyNameReference::ErrorNameReference => false
              _ => {
                self.diagnostics.push(SelfHostBodyInferenceDiagnostic::InvalidAssignmentTarget(current, offset))
                false
              }
            }
            if !mutable_ {
              match self.names.expression_references[target] {
                SelfHostBodyNameReference::LocalNameReference(_) => self.diagnostics.push(SelfHostBodyInferenceDiagnostic::ImmutableAssignmentTarget(current, offset))
                _ => {}
              }
            }
            self.constrain_assignable(self.expression_type(value), self.expression_type(target), self_host_expression_type_origin(current, offset))
          }
          SelfHostHirExpr::ObjectExpr(_, _) => self.mark_unsupported(current)
          SelfHostHirExpr::ConstructExpr(target, _, _) => {
            self.consumed_member_roots[self.expression_index(target)] = true
            self.pending_constructions.push(current)
          }
          SelfHostHirExpr::FieldExpr(_, _, _) => self.pending_fields.push(current)
          SelfHostHirExpr::QualifiedExpr(_, _, _) => match self.local_variant_target(current) {
            Option::Some(_) => self.pending_variant_values.push(current)
            Option::None => match self.imported_variant_target(current) {
              Option::Some(_) => self.pending_variant_values.push(current)
              Option::None => self.mark_unsupported(current)
            }
          }
          SelfHostHirExpr::IndexExpr(_, _, _) => if !self.queue_index_operator(current) {
            self.mark_unsupported(current)
          }
          SelfHostHirExpr::IndexSetExpr(_, _, _, _) => if !self.queue_index_operator(current) {
            self.mark_unsupported(current)
          }
          SelfHostHirExpr::ImportAliasExpr(_, _) => self.mark_unsupported(current)
          SelfHostHirExpr::NameExpr(_, _) => match self.names.expression_references[current] {
            SelfHostBodyNameReference::VariantNameReference(_) => self.pending_variant_values.push(
              current,
            )
            _ => {}
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_control_results(self) -> Unit {
    let has_break = self_host_inference_bool_slots(self.name_info.controls.length)
    let mut expression = self.body.expressions.start
    let end = self.body.expressions.start + self.body.expressions.length
    let _ = while expression {
      current => if current < end {
        match self.collected.expressions[current] {
          SelfHostHirExpr::BreakExpr(_, _) => {
            let control = self.names.transfer_targets[current]
            if control != 4294967295u32 && control < has_break.length() {
              has_break[control] = true
            }
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut control = 0u32
    let _ = while control {
      current => if current < has_break.length() {
        if !has_break[current] {
          self.constrain(
            self.control_result_types[current],
            self.primitive(SelfHostPrimitiveType::NeverType),
            self_host_synthetic_type_origin(current, self.body.offset),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn constrain_root(self) -> Unit {
    self.result_type = match self.body.root {
      SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => self.expression_type(expression)
      SelfHostHirBodyRoot::BlockBodyRoot(block) => self.block_type(block)
    }
    if self.callable_index != 4294967295u32 {
      let mut root_expression = 4294967295u32
      match self.body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => {
          root_expression = expression
        }
        SelfHostHirBodyRoot::BlockBodyRoot(block) => {
          let items = self.collected.blocks[block].items
          if self_host_u32_greater(items.length, 0u32) {
            let last_item = self_host_u32_subtract(
              self_host_u32_add(items.start, items.length),
              1u32,
            )
            match self.collected.block_items[last_item] {
              SelfHostHirBlockItem::ExpressionItem(expression, _) => {
                root_expression = expression
              }
              _ => {}
            }
          }
        }
      }
      if root_expression == 4294967295u32 {
        self.constrain_assignable(
          self.result_type,
          self.declared_return_type,
          self_host_return_type_origin(self_host_semantic_id_local(self.body.id), self.body.offset),
        )
      } else if !self.is_primitive(self.declared_return_type, SelfHostPrimitiveType::UnitType) {
        self.constrain_assignable(
          self.expression_type(root_expression),
          self.declared_return_type,
          self_host_return_type_origin(root_expression, self.body.offset),
        )
      }
    }
  }

  fn is_selected_direct_call_target(self, expression: U32) -> Bool {
    let mut candidate = self.body.expressions.start
    let end = self_host_u32_add(self.body.expressions.start, self.body.expressions.length)
    while candidate {
      current => if current < end {
        match self.collected.expressions[current] {
          SelfHostHirExpr::CallExpr(target, _, _) => if self_host_u32_equal(
            target,
            expression,
          ) {
            match self.call_targets[self.expression_index(current)] {
              SelfHostBasicCallTarget::SelectedBasicCallTarget(_, _) => {
                return true
              }
              _ => {}
            }
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break false
      }
    }
  }

  fn zonk_array(self, values: Array<I32>) -> Unit {
    let mut index = 0u32
    let _ = while index {
      current => if current < values.length() {
        values[current] = self.solver.zonk_type(values[current])
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn finalize(self) -> SelfHostBasicInferredBody {
    self.zonk_array(self.expression_types)
    self.zonk_array(self.local_types)
    self.zonk_array(self.block_types)
    self.zonk_array(self.pattern_types)
    self.zonk_array(self.control_state_types)
    self.zonk_array(self.control_result_types)
    self.zonk_array(self.call_type_arguments)
    self.zonk_array(self.expression_type_arguments)
    self.zonk_array(self.pattern_type_arguments)
    self.result_type = self.solver.zonk_type(self.result_type)
    let mut index = 0u32
    let _ = while index {
      current => if current < self.solver.diagnostic_count() {
        self.diagnostics.push(
          SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(
            self.solver.diagnostic_at(current),
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    index = 0u32
    let _ = while index {
      current => if current < self.expression_types.length() {
        let expression = self.body.expressions.start + current
        if self.unsupported_expressions[current] {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnsupportedExpressionInference(
              expression,
              self_host_basic_expression_offset(
                self.collected.expressions[expression],
              ),
            ),
          )
        } else if self.solver.has_unresolved_variable(self.expression_types[current]) && !self.is_selected_direct_call_target(expression) && !self.consumed_member_roots[current] {
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnresolvedExpressionType(
              expression,
              self_host_basic_expression_offset(
                self.collected.expressions[expression],
              ),
            ),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    index = 0u32
    let _ = while index {
      current => if current < self.local_types.length() {
        if self.solver.has_unresolved_variable(self.local_types[current]) {
          let info = self.names.locals[self.name_info.locals.start + current]
          self.diagnostics.push(
            SelfHostBodyInferenceDiagnostic::UnresolvedLocalType(
              self.body.id,
              current,
              info.offset,
            ),
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    SelfHostBasicInferredBody::{
      body: self.body.id
      root_type: self.result_type
      types: self.solver.types
      type_arguments: self.solver.type_arguments
      expression_types: self.expression_types
      local_types: self.local_types
      block_types: self.block_types
      pattern_types: self.pattern_types
      control_state_types: self.control_state_types
      control_result_types: self.control_result_types
      call_targets: self.call_targets
      operator_targets: self.operator_targets
      expression_selections: self.expression_selections
      object_field_targets: self.object_field_targets
      pattern_constructors: self.pattern_constructors
      call_type_arguments: self.call_type_arguments
      expression_type_arguments: self.expression_type_arguments
      pattern_type_arguments: self.pattern_type_arguments
      unsupported_expressions: self.unsupported_expressions
      diagnostics: self.diagnostics
    }
  }

  fn run(self) -> SelfHostBasicInferredBody {
    self.initialize_locals()
    self.initialize_controls()
    self.initialize_expressions()
    self.initialize_blocks()
    self.initialize_patterns()
    self.declared_return_type = if self.callable_index == 4294967295u32 {
      self.solver.error_type()
    } else {
      self.solver.resolved_type(self.resolved.callable_return_types[self.callable_index])
    }
    self.constrain_patterns()
    self.constrain_block_items()
    self.constrain_expressions()
    self.constrain_control_results()
    self.constrain_root()
    self.constrain_pending_direct_calls()
    self.constrain_pending_variant_calls()
    self.constrain_pending_variant_values()
    self.constrain_pending_constructions()
    self.constrain_pending_method_calls()
    self.constrain_pending_operators()
    self.constrain_pending_fields()
    self.constrain_variant_patterns()
    self.finalize()
  }
}

fn self_host_infer_basic_module_bodies_with_inputs(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  imported: SelfHostBasicImportedInputs,
) -> SelfHostBasicInferredModuleBodies {
  let bodies = []
  let mut index = 0u32
  let _ = while index {
    current => if current < collected.bodies.length() {
      let body = collected.bodies[current]
      let name_info = names.bodies[current]
      bodies.push(
        SelfHostBasicBodyInferencer::new(
          collected,
          resolved,
          names,
          imported,
          body,
          name_info,
        ).run(),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostBasicInferredModuleBodies::{
    module_id: collected.module_id
    bodies: bodies
  }
}

fn self_host_infer_basic_module_bodies(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
) -> SelfHostBasicInferredModuleBodies {
  self_host_infer_basic_module_bodies_with_inputs(
    collected,
    resolved,
    names,
    SelfHostBasicImportedInputs::{
      callables: []
      generic_parameter_ids: []
      parameter_types: []
      parameter_receivers: []
      implementations: []
      fields: []
      variants: []
      variant_payload_types: []
      type_declaration_types: self_host_basic_empty_type_declaration_map()
      type_generic_spans: self_host_empty_u64_span_map()
      module_value_types: self_host_basic_empty_type_declaration_map()
    },
  )
}

fn self_host_infer_basic_module_bodies_with_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  callables: Array<SelfHostResolvedImportedCallable>,
  generic_parameter_ids: Array<U64>,
  parameter_types: Array<U32>,
  parameter_receivers: Array<Bool>,
  implementations: Array<SelfHostResolvedImportedImplementation>,
  fields: Array<SelfHostResolvedImportedField>,
  variants: Array<SelfHostResolvedImportedVariant>,
  variant_payload_types: Array<U32>,
  type_declaration_types: Map<U64, U32>,
  type_generic_spans: Map<U64, SelfHostHirSpan>,
  module_value_types: Map<U64, U32>,
) -> SelfHostBasicInferredModuleBodies {
  self_host_infer_basic_module_bodies_with_inputs(
    collected,
    resolved,
    names,
    SelfHostBasicImportedInputs::{
      callables: callables
      generic_parameter_ids: generic_parameter_ids
      parameter_types: parameter_types
      parameter_receivers: parameter_receivers
      implementations: implementations
      fields: fields
      variants: variants
      variant_payload_types: variant_payload_types
      type_declaration_types: type_declaration_types
      type_generic_spans: type_generic_spans
      module_value_types: module_value_types
    },
  )
}

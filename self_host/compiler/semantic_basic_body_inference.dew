    if !self_host_u32_equal(
      self.instantiation_results.length(),
      expected_length,
    ) {
      return self.solver.error_type()
    }
    let base = self.instantiation_results[start]
    let values = []
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        values.push(
          self.instantiation_results[
            self_host_u32_add(self_host_u32_add(start, 1u32), current)
          ],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.applied_type(base, values)
  }

  fn finish_signature_function(self, source: U32, start: U32) -> I32 {

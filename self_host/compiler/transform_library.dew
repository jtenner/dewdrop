fn ct_ast_source() -> Bytes {
  b"open dew.std.array\n\npub enum ExprNode {\n  Source(String)\n  Unit\n  Integer(I32)\n  Integer64(I64)\n  Unsigned64(U64)\n  Boolean(Bool)\n  Text(String)\n  Name(String)\n  Path(String)\n  Field(ExprNode, String)\n  Index(ExprNode, ExprNode)\n  MethodCall(ExprNode, String, Array<ExprNode>)\n  Prefix(String, ExprNode)\n  Tuple(Array<ExprNode>)\n  Array(Array<ExprNode>)\n  MutableBind(String, ExprNode)\n  Assign(ExprNode, ExprNode)\n  Call(ExprNode, Array<ExprNode>)\n  Binary(String, ExprNode, ExprNode)\n  Block(Array<ExprNode>)\n  Bind(String, ExprNode)\n  Return(ExprNode)\n  If(ExprNode, ExprNode, ExprNode)\n}\n\npub struct FnNode {\n  name: String\n  body: ExprNode\n}\n\npub fn with_body(node: FnNode, body: ExprNode) -> FnNode {\n  FnNode::{\n    name: node.name\n    body: body\n  }\n}\n\npub fn integer(value: I32) -> ExprNode {\n  ExprNode::Integer(value)\n}\n\npub fn source(value: String) -> ExprNode {\n  ExprNode::Source(value)\n}\n\npub fn call(callee: ExprNode, arguments: Array<ExprNode>) -> ExprNode {\n  ExprNode::Call(callee, arguments)\n}\n\nimpl FnNode {\n  fn with_body(self, body: ExprNode) -> FnNode {\n    FnNode::{\n      name: self.name\n      body: body\n    }\n  }\n}\n\nimpl FnNode {\n  fn prepend(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Block([expression, self.body]))\n  }\n  fn append(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Block([self.body, expression]))\n  }\n  fn wrap(self, callee: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Call(callee, [self.body]))\n  }\n  fn returning(self, expression: ExprNode) -> FnNode {\n    self.with_body(ExprNode::Return(expression))\n  }\n}\n\nimpl ExprNode {\n  fn call(self, arguments: Array<ExprNode>) -> ExprNode {\n    ExprNode::Call(self, arguments)\n  }\n  fn binary(self, operator: String, right: ExprNode) -> ExprNode {\n    ExprNode::Binary(operator, self, right)\n  }\n  fn field(self, name: String) -> ExprNode {\n    ExprNode::Field(self, name)\n  }\n  fn index(self, index: ExprNode) -> ExprNode {\n    ExprNode::Index(self, index)\n  }\n  fn method_call(self, name: String, arguments: Array<ExprNode>) -> ExprNode {\n    ExprNode::MethodCall(self, name, arguments)\n  }\n  fn returned(self) -> ExprNode {\n    ExprNode::Return(self)\n  }\n  fn bind(self, name: String) -> ExprNode {\n    ExprNode::Bind(name, self)\n  }\n  fn bind_mut(self, name: String) -> ExprNode {\n    ExprNode::MutableBind(name, self)\n  }\n  fn assign(self, value: ExprNode) -> ExprNode {\n    ExprNode::Assign(self, value)\n  }\n}\n\npub fn unit() -> ExprNode {\n  ExprNode::Unit\n}\n\npub fn integer64(value: I64) -> ExprNode {\n  ExprNode::Integer64(value)\n}\n\npub fn unsigned64(value: U64) -> ExprNode {\n  ExprNode::Unsigned64(value)\n}\n\npub fn text(value: String) -> ExprNode {\n  ExprNode::Text(value)\n}\n\npub fn boolean(value: Bool) -> ExprNode {\n  ExprNode::Boolean(value)\n}\n\npub fn name(value: String) -> ExprNode {\n  ExprNode::Name(value)\n}\n\npub fn path(value: String) -> ExprNode {\n  ExprNode::Path(value)\n}\n\npub fn array(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Array(values)\n}\n\npub fn tuple(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Tuple(values)\n}\n\npub fn block(values: Array<ExprNode>) -> ExprNode {\n  ExprNode::Block(values)\n}\n\npub fn prefix(operator: String, value: ExprNode) -> ExprNode {\n  ExprNode::Prefix(operator, value)\n}\n"
}

fn ct_transform_source() -> Bytes {
  b"pub struct SourceLocation {\n  file_name: String\n  line_no: U32\n  col_no: U32\n}\n\npub struct TransformContext {\n  location: SourceLocation\n  fn_name: String\n  module_name: String\n  parameters_source: String\n  return_type_source: String\n  fresh_name: String\n}\n\npub struct TransformError {\n  message: String\n}\n\npub fn error(message: String) -> TransformError {\n  TransformError::{\n    message: message\n  }\n}\n"
}

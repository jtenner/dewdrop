fn self_host_linked_text_runtime_base(
  link: SelfHostPlannedProgramWasmGCLink,
) -> U32 {
  self_host_u32_add(link.types.length(), link.functions.length())
}

fn self_host_linked_nominal_ref_type(type_index: U32) -> StarshineValue {
  StarshineFfi.ffi_ffi_bridge_nominal_ref_type(
    self_host_u32_to_i32(type_index),
    0i32,
  )
}

fn self_host_linked_append_text_struct_type(
  rec_types: StarshineRecTypes,
  chunk_reference: StarshineValue,
  mutable: Bool,
) -> Unit {
  let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
  let mutability = if mutable {
    StarshineFfi.ffi_lib_Mut_var_()
  } else {
    StarshineFfi.ffi_lib_Mut_const_()
  }
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(chunk_reference),
      mutability,
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        StarshineFfi.ffi_lib_ValType_i32(),
      ),
      mutability,
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        StarshineFfi.ffi_lib_ValType_i32(),
      ),
      mutability,
    ),
  )
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_struct_(fields),
        wasm_ref_null(),
      ),
    ),
  )
}

fn self_host_linked_append_text_runtime_types(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRecTypes,
) -> Unit {
  let base = self_host_linked_text_runtime_base(link)
  let chunks = StarshineFfi.ffi_lib_FieldType_new(
    StarshineFfi.ffi_lib_StorageType_val_type(
      StarshineFfi.ffi_lib_ValType_v128(),
    ),
    StarshineFfi.ffi_lib_Mut_var_(),
  )
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_array(chunks),
        wasm_ref_null(),
      ),
    ),
  )
  let chunk_reference = self_host_linked_nominal_ref_type(base)
  self_host_linked_append_text_struct_type(rec_types, chunk_reference, false)
  self_host_linked_append_text_struct_type(rec_types, chunk_reference, false)
  self_host_linked_append_text_struct_type(rec_types, chunk_reference, false)
  self_host_linked_append_text_struct_type(rec_types, chunk_reference, true)
  self_host_linked_append_text_struct_type(rec_types, chunk_reference, true)
}

fn self_host_linked_array_runtime_base(
  link: SelfHostPlannedProgramWasmGCLink,
) -> U32 {
  self_host_linked_text_runtime_base(link) + 6u32
}

fn self_host_linked_array_wrapper_type(
  link: SelfHostPlannedProgramWasmGCLink,
) -> U32 {
  self_host_linked_array_runtime_base(link) + 6u32
}


fn self_host_linked_pair_runtime_base(link: SelfHostPlannedProgramWasmGCLink) -> U32 {
  self_host_linked_array_runtime_base(link) + 9u32
}

fn self_host_linked_scalar_box_runtime_base(link: SelfHostPlannedProgramWasmGCLink) -> U32 {
  self_host_linked_pair_runtime_base(link) + 36u32
}

fn self_host_linked_runtime_carrier_value_type(
  carrier: I32,
) -> StarshineValue {
  match carrier {
    0 => StarshineFfi.ffi_lib_ValType_i32()
    1 => StarshineFfi.ffi_lib_ValType_i64()
    2 => StarshineFfi.ffi_lib_ValType_f32()
    3 => StarshineFfi.ffi_lib_ValType_f64()
    4 => StarshineFfi.ffi_lib_ValType_v128()
    _ => self_host_linked_eqref_value_type()
  }
}

fn self_host_linked_append_array_backing_type(
  rec_types: StarshineRecTypes,
  value_type: StarshineValue,
) -> Unit {
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_array(
          StarshineFfi.ffi_lib_FieldType_new(
            StarshineFfi.ffi_lib_StorageType_val_type(value_type),
            StarshineFfi.ffi_lib_Mut_var_(),
          ),
        ),
        wasm_ref_null(),
      ),
    ),
  )
}



fn self_host_linked_append_array_runtime_types(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRecTypes,
) -> Unit {
  self_host_linked_append_array_backing_type(
    rec_types,
    StarshineFfi.ffi_lib_ValType_i32(),
  )
  self_host_linked_append_array_backing_type(
    rec_types,
    StarshineFfi.ffi_lib_ValType_i64(),
  )
  self_host_linked_append_array_backing_type(
    rec_types,
    StarshineFfi.ffi_lib_ValType_f32(),
  )
  self_host_linked_append_array_backing_type(
    rec_types,
    StarshineFfi.ffi_lib_ValType_f64(),
  )
  self_host_linked_append_array_backing_type(
    rec_types,
    StarshineFfi.ffi_lib_ValType_v128(),
  )
  self_host_linked_append_array_backing_type(
    rec_types,
    self_host_linked_eqref_value_type(),
  )
  let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        self_host_linked_eqref_value_type(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        StarshineFfi.ffi_lib_ValType_i32(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        StarshineFfi.ffi_lib_ValType_i32(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_struct_(fields),
        wasm_ref_null(),
      ),
    ),
  )
  let iterator_fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    iterator_fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        self_host_linked_eqref_value_type(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    iterator_fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        StarshineFfi.ffi_lib_ValType_i32(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_struct_(iterator_fields),
        wasm_ref_null(),
      ),
    ),
  )
  let map_fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    map_fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        self_host_linked_eqref_value_type(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_field_types_push(
    map_fields,
    StarshineFfi.ffi_lib_FieldType_new(
      StarshineFfi.ffi_lib_StorageType_val_type(
        self_host_linked_eqref_value_type(),
      ),
      StarshineFfi.ffi_lib_Mut_var_(),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_struct_(map_fields),
        wasm_ref_null(),
      ),
    ),
  )
  let mut pair = 0u32
  let _ = while pair {
    current => if current < 36u32 {
      let left = self_host_u32_to_i32(current / 6u32)
      let right = self_host_u32_to_i32(current % 6u32)
      let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
      StarshineFfi.ffi_ffi_bridge_field_types_push(
        fields,
        StarshineFfi.ffi_lib_FieldType_new(
          StarshineFfi.ffi_lib_StorageType_val_type(
            self_host_linked_runtime_carrier_value_type(left),
          ),
          StarshineFfi.ffi_lib_Mut_const_(),
        ),
      )
      StarshineFfi.ffi_ffi_bridge_field_types_push(
        fields,
        StarshineFfi.ffi_lib_FieldType_new(
          StarshineFfi.ffi_lib_StorageType_val_type(
            self_host_linked_runtime_carrier_value_type(right),
          ),
          StarshineFfi.ffi_lib_Mut_const_(),
        ),
      )
      StarshineFfi.ffi_ffi_bridge_rec_types_push(
        rec_types,
        StarshineFfi.ffi_lib_RecType_new(
          StarshineFfi.ffi_lib_SubType_comp_type(
            StarshineFfi.ffi_lib_CompType_struct_(fields),
            wasm_ref_null(),
          ),
        ),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_linked_array_carrier_from_shape(
  shape: SelfHostPlannedValueShape,
) -> I32 {
  match self_host_physical_scalar_shape(shape) {
    I32PlannedValueShape => 0i32
    I64PlannedValueShape => 1i32
    F32PlannedValueShape => 2i32
    F64PlannedValueShape => 3i32
    V128PlannedValueShape => 4i32
    _ => 5i32
  }
}

fn self_host_linked_shape_name(shape: SelfHostPlannedValueShape) -> String {
  match shape {
    ErrorPlannedValueShape => "error"
    UnitPlannedValueShape => "unit"
    I8PlannedValueShape => "i8"
    I16PlannedValueShape => "i16"
    I32PlannedValueShape => "i32"
    I64PlannedValueShape => "i64"
    U8PlannedValueShape => "u8"
    U16PlannedValueShape => "u16"
    U32PlannedValueShape => "u32"
    U64PlannedValueShape => "u64"
    F32PlannedValueShape => "f32"
    F64PlannedValueShape => "f64"
    Swar32PlannedValueShape => "swar32"
    Swar64PlannedValueShape => "swar64"
    V128PlannedValueShape => "v128"
    RefPlannedValueShape => "ref"
    GenericPlannedValueShape => "generic"
    ProductPlannedValueShape(_) => "product"
    NeverPlannedValueShape => "never"
  }
}


fn self_host_linked_conversion_source_is_signed(
  shape: SelfHostPlannedValueShape,
) -> Bool {
  shape is I8PlannedValueShape ||
  shape is I16PlannedValueShape ||
  shape is I32PlannedValueShape ||
  shape is I64PlannedValueShape
}

fn self_host_emit_linked_conversion(
  source: SelfHostPlannedValueShape,
  target: SelfHostPlannedValueShape,
  destination: StarshineInstructions,
) -> Bool {
  if source is ErrorPlannedValueShape &&
    target is ErrorPlannedValueShape {
    return true
  }
  if target is UnitPlannedValueShape {
    if !(source is ErrorPlannedValueShape) &&
      !(source is UnitPlannedValueShape) &&
      !(source is NeverPlannedValueShape) {
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_drop(),
      )
    }
    return true
  }
  let source_scalar = self_host_physical_scalar_shape(source)
  if target is U8PlannedValueShape ||
    target is U16PlannedValueShape ||
    target is U32PlannedValueShape {
    match source_scalar {
      I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_wrap_i64(),
      )
      F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_trunc_f32u(),
      )
      F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_trunc_f64u(),
      )
      I32PlannedValueShape => {}
      _ => {
        return false
      }
    }
    let mask = if target is U8PlannedValueShape {
      255i32
    } else if target is U16PlannedValueShape {
      65535i32
    } else {
      -1i32
    }
    if mask >= 0i32 {
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_const(
          StarshineFfi.ffi_lib_I32_new(mask),
        ),
      )
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_and(),
      )
    }
    return true
  }
  if target is I64PlannedValueShape ||
    target is U64PlannedValueShape {
    match source_scalar {
      I32PlannedValueShape => {
        if self_host_linked_conversion_source_is_signed(source) {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_extend_i32s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_extend_i32u(),
          )
        }
      }
      F32PlannedValueShape => {
        if target is I64PlannedValueShape {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_trunc_f32s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_trunc_f32u(),
          )
        }
      }
      F64PlannedValueShape => {
        if target is I64PlannedValueShape {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_trunc_f64s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_trunc_f64u(),
          )
        }
      }
      I64PlannedValueShape => {}
      _ => {
        return false
      }
    }
    return true
  }
  if target is Swar32PlannedValueShape ||
    target is Swar64PlannedValueShape ||
    target is V128PlannedValueShape {
    return true
  }
  match target {
    I8PlannedValueShape => {
      match source_scalar {
        I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_wrap_i64(),
        )
        F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_trunc_f32s(),
        )
        F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_trunc_f64s(),
        )
        I32PlannedValueShape => {}
        _ => {
        return false
      }
      }
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_extend8s(),
      )
    }
    I16PlannedValueShape => {
      match source_scalar {
        I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_wrap_i64(),
        )
        F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_trunc_f32s(),
        )
        F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_i32_trunc_f64s(),
        )
        I32PlannedValueShape => {}
        _ => {
        return false
      }
      }
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_extend16s(),
      )
    }
    I32PlannedValueShape => match source_scalar {
      I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_wrap_i64(),
      )
      F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_trunc_f32s(),
      )
      F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_i32_trunc_f64s(),
      )
      I32PlannedValueShape => {}
      _ => {
        return false
      }
    }
    F32PlannedValueShape => match source_scalar {
      I32PlannedValueShape => {
        if self_host_linked_conversion_source_is_signed(source) {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_convert_i32s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_convert_i32u(),
          )
        }
      }
      I64PlannedValueShape => {
        if self_host_linked_conversion_source_is_signed(source) {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_convert_i64s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_convert_i64u(),
          )
        }
      }
      F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_f32_demote_f64(),
      )
      F32PlannedValueShape => {}
      _ => {
        return false
      }
    }
    F64PlannedValueShape => match source_scalar {
      I32PlannedValueShape => {
        if self_host_linked_conversion_source_is_signed(source) {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_convert_i32s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_convert_i32u(),
          )
        }
      }
      I64PlannedValueShape => {
        if self_host_linked_conversion_source_is_signed(source) {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_convert_i64s(),
          )
        } else {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_convert_i64u(),
          )
        }
      }
      F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_f64_promote_f32(),
      )
      F64PlannedValueShape => {}
      _ => {
        return false
      }
    }
    _ => {
        return false
      }
  }
  true
}

fn self_host_linked_text_lane(value: Bytes, index: U32) -> I32 {
  if index < value.byte_length() {
    u8_into_i32(value.byte_at(index))
  } else {
    0i32
  }
}

fn self_host_emit_linked_text_constant(
  link: SelfHostPlannedProgramWasmGCLink,
  value: Bytes,
  string_: Bool,
  destination: StarshineInstructions,
) -> Unit {
  let base = self_host_linked_text_runtime_base(link)
  let chunk_count = (value.byte_length() + 15u32) / 16u32
  let _ = while 0u32 {
    chunk => if chunk < chunk_count {
      let start = chunk * 16u32
      StarshineFfi.ffi_ffi_bridge_instructions_push(
        destination,
        StarshineFfi.ffi_lib_Instruction_v128_const(
          self_host_linked_text_lane(value, start),
          self_host_linked_text_lane(value, start + 1u32),
          self_host_linked_text_lane(value, start + 2u32),
          self_host_linked_text_lane(value, start + 3u32),
          self_host_linked_text_lane(value, start + 4u32),
          self_host_linked_text_lane(value, start + 5u32),
          self_host_linked_text_lane(value, start + 6u32),
          self_host_linked_text_lane(value, start + 7u32),
          self_host_linked_text_lane(value, start + 8u32),
          self_host_linked_text_lane(value, start + 9u32),
          self_host_linked_text_lane(value, start + 10u32),
          self_host_linked_text_lane(value, start + 11u32),
          self_host_linked_text_lane(value, start + 12u32),
          self_host_linked_text_lane(value, start + 13u32),
          self_host_linked_text_lane(value, start + 14u32),
          self_host_linked_text_lane(value, start + 15u32),
        ),
      )
      continue chunk + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    destination,
    StarshineFfi.ffi_lib_Instruction_array_new_fixed(
      StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(base)),
      StarshineFfi.ffi_lib_U32_new(self_host_u32_to_i32(chunk_count)),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    destination,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(0i32),
    ),
  )
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    destination,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(value.byte_length())),
    ),
  )
  let type_offset = if string_ {
    1u32
  } else {
    2u32
  }
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    destination,
    StarshineFfi.ffi_lib_Instruction_struct_new(
      StarshineFfi.ffi_lib_TypeIdx_new(
        self_host_u32_to_i32(self_host_u32_add(base, type_offset)),
      ),
    ),
  )
}

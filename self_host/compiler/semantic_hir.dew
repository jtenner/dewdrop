open dew.std.array
open dew.std.bytes

pub struct SelfHostHirSpan {
  start: U32
  length: U32
}

fn self_host_hir_span_identity(span: SelfHostHirSpan) -> SelfHostHirSpan {
  {
    start: span.start
    length: span.length
  }
}

fn self_host_hir_span_at(
  spans: Array<SelfHostHirSpan>,
  index: U32,
) -> SelfHostHirSpan {
  self_host_assert_array_index(
    index,
    spans.length(),
    "compiler HIR span index is outside the span arena",
  )
  self_host_hir_span_identity(spans[index])
}

fn self_host_empty_hir_span(at: U32) -> SelfHostHirSpan {
  {
    start: at
    length: 0u32
  }
}

pub enum SelfHostHirTypeSyntax {
  NamedTypeSyntax(U32, U32)
  QualifiedTypeSyntax(U32, U32, U32, U32)
  ProductTypeSyntax(SelfHostHirSpan, U32)
  AppliedTypeSyntax(U32, SelfHostHirSpan, U32)
  FunctionTypeSyntax(SelfHostHirSpan, U32, U32)
  ComputedTypeSyntax(U32, Bytes, U32)
}

impl SelfHostHirTypeSyntax {
  fn offset(self) -> U32 {
    match self {
      NamedTypeSyntax(_, offset) => offset
      QualifiedTypeSyntax(_, _, offset, _) => offset
      ProductTypeSyntax(_, offset) => offset
      AppliedTypeSyntax(_, _, offset) => offset
      FunctionTypeSyntax(_, _, offset) => offset
      ComputedTypeSyntax(_, _, offset) => offset
    }
  }
}

pub enum SelfHostHirBodyKind {
  ModuleLetBody
  FunctionBody
  ImplMethodBody
}

pub enum SelfHostHirBodyRoot {
  ExpressionBodyRoot(U32)
  BlockBodyRoot(U32)
}

pub struct SelfHostHirBody {
  id: U64
  declaration: U64
  kind: SelfHostHirBodyKind
  root: SelfHostHirBodyRoot
  expressions: SelfHostHirSpan
  expression_children: SelfHostHirSpan
  blocks: SelfHostHirSpan
  block_items: SelfHostHirSpan
  patterns: SelfHostHirSpan
  pattern_children: SelfHostHirSpan
  pattern_arms: SelfHostHirSpan
  arm_children: SelfHostHirSpan
  object_fields: SelfHostHirSpan
  pattern_fields: SelfHostHirSpan
  offset: U32
}

pub struct SelfHostHirLambdaParameter {
  name: U32
  type_: U32
  offset: U32
}

pub struct SelfHostHirLambdaBody {
  root: U32
  expressions: SelfHostHirSpan
  expression_children: SelfHostHirSpan
  blocks: SelfHostHirSpan
  block_items: SelfHostHirSpan
  patterns: SelfHostHirSpan
  pattern_children: SelfHostHirSpan
  pattern_arms: SelfHostHirSpan
  arm_children: SelfHostHirSpan
  object_fields: SelfHostHirSpan
  pattern_fields: SelfHostHirSpan
}

pub struct SelfHostHirLambda {
  id: U32
  parent: U32
  root_body: U64
  parameters: SelfHostHirSpan
  return_type: U32
  body: SelfHostHirLambdaBody
  file: U64
  offset: U32
}

pub struct SelfHostHirObjectField {
  name: U32
  value: U32
  offset: U32
}

fn self_host_hir_object_field_identity(
  field: SelfHostHirObjectField,
) -> SelfHostHirObjectField {
  {
    name: field.name
    value: field.value
    offset: field.offset
  }
}

fn self_host_hir_object_field_at(
  fields: Array<SelfHostHirObjectField>,
  index: U32,
) -> SelfHostHirObjectField {
  self_host_assert_array_index(
    index,
    fields.length(),
    "compiler HIR object-field index is outside the field arena",
  )
  self_host_hir_object_field_identity(fields[index])
}

pub struct SelfHostHirBlockItem {
  kind: U32
  mutable_: Bool
  source_name: U32
  name: U32
  name_offset: U32
  value: U32
  offset: U32
}

fn self_host_hir_block_item_identity(
  item: SelfHostHirBlockItem,
) -> SelfHostHirBlockItem {
  {
    kind: item.kind
    mutable_: item.mutable_
    source_name: item.source_name
    name: item.name
    name_offset: item.name_offset
    value: item.value
    offset: item.offset
  }
}

fn self_host_hir_let_item(
  mutable_: Bool,
  name: U32,
  name_offset: U32,
  value: U32,
  offset: U32,
) -> SelfHostHirBlockItem {
  {
    kind: 0u32
    mutable_: mutable_
    source_name: name
    name: name
    name_offset: name_offset
    value: value
    offset: offset
  }
}

fn self_host_hir_expression_item(
  value: U32,
  offset: U32,
) -> SelfHostHirBlockItem {
  {
    kind: 1u32
    mutable_: false
    source_name: 4294967295u32
    name: 4294967295u32
    name_offset: offset
    value: value
    offset: offset
  }
}

fn self_host_hir_discarded_let_item(
  name: U32,
  value: U32,
  offset: U32,
) -> SelfHostHirBlockItem {
  {
    kind: 1u32
    mutable_: false
    source_name: name
    name: 4294967295u32
    name_offset: offset
    value: value
    offset: offset
  }
}

fn self_host_hir_block_item_is_let(item: SelfHostHirBlockItem) -> Bool {
  self_host_u32_equal(item.kind, 0u32)
}

pub struct SelfHostHirBlock {
  items: SelfHostHirSpan
  offset: U32
}

pub struct SelfHostHirPatternField {
  name: U32
  pattern: U32
  offset: U32
}

fn self_host_hir_pattern_field_identity(
  field: SelfHostHirPatternField,
) -> SelfHostHirPatternField {
  {
    name: field.name
    pattern: field.pattern
    offset: field.offset
  }
}

pub struct SelfHostHirPatternArm {
  pattern: U32
  guard_condition: U32
  body: U32
  offset: U32
}

pub enum SelfHostHirPrefixOperator {
  Positive
  Negative
  LogicalNot
}

pub enum SelfHostHirBinaryOperator {
  LogicalOr
  LogicalAnd
  BitOr
  BitXor
  BitAnd
  Equal
  NotEqual
  Less
  LessEqual
  Greater
  GreaterEqual
  ShiftLeft
  ShiftRight
  Add
  Subtract
  Multiply
  Divide
  Remainder
  Exponentiate
}

fn self_host_hir_prefix_operator(
  operator: SelfHostPrefixOperator,
) -> SelfHostHirPrefixOperator {
  match operator {
    Positive => Positive
    Negative => Negative
    LogicalNot => LogicalNot
  }
}

fn self_host_hir_binary_operator(
  operator: SelfHostBinaryOperator,
) -> SelfHostHirBinaryOperator {
  match operator {
    LogicalOr => LogicalOr
    LogicalAnd => LogicalAnd
    BitOr => BitOr
    BitXor => BitXor
    BitAnd => BitAnd
    Equal => Equal
    NotEqual => NotEqual
    Less => Less
    LessEqual => LessEqual
    Greater => Greater
    GreaterEqual => GreaterEqual
    ShiftLeft => ShiftLeft
    ShiftRight => ShiftRight
    Add => Add
    Subtract => Subtract
    Multiply => Multiply
    Divide => Divide
    Remainder => Remainder
    Exponentiate => Exponentiate
  }
}

pub enum SelfHostHirExpr {
  I8Expr(U64, U32)
  I16Expr(U64, U32)
  I32Expr(U64, U32)
  I64Expr(U64, U32)
  U8Expr(U64, U32)
  U16Expr(U64, U32)
  U32Expr(U64, U32)
  U64Expr(U64, U32)
  F32Expr(F32, U32)
  F64Expr(F64, U32)
  BoolExpr(Bool, U32)
  StringExpr(Bytes, U32)
  BytesExpr(Bytes, U32)
  NameExpr(U32, U32)
  ImportAliasExpr(U32, U32)
  ProductExpr(SelfHostHirSpan, U32)
  TypeBindingExpr(U32, U32)
  ArrayExpr(SelfHostHirSpan, U32)
  LambdaExpr(U32, U32)
  ObjectExpr(SelfHostHirSpan, U32)
  ConstructExpr(U32, SelfHostHirSpan, U32)
  BlockExpr(U32, U32)
  IfExpr(U32, U32, U32, U32)
  MatchExpr(U32, SelfHostHirSpan, U32)
  WhileExpr(U32, SelfHostHirSpan, U32)
  ReturnExpr(U32, U32)
  BreakExpr(U32, U32)
  ContinueExpr(U32, U32)
  PrefixExpr(SelfHostHirPrefixOperator, U32, U32)
  BinaryExpr(SelfHostHirBinaryOperator, U32, U32, U32)
  CallExpr(U32, SelfHostHirSpan, U32)
  FieldExpr(U32, U32, U32)
  QualifiedExpr(U32, U32, U32)
  ProductFieldExpr(U32, U32, U32, U32)
  IndexExpr(U32, U32, U32)
  AssignmentExpr(U32, U32, U32)
  IndexSetExpr(U32, U32, U32, U32)
}

impl SelfHostHirExpr {
  fn offset(self) -> U32 {
    match self {
      I8Expr(_, offset) => offset
      I16Expr(_, offset) => offset
      I32Expr(_, offset) => offset
      I64Expr(_, offset) => offset
      U8Expr(_, offset) => offset
      U16Expr(_, offset) => offset
      U32Expr(_, offset) => offset
      U64Expr(_, offset) => offset
      F32Expr(_, offset) => offset
      F64Expr(_, offset) => offset
      BoolExpr(_, offset) => offset
      StringExpr(_, offset) => offset
      BytesExpr(_, offset) => offset
      NameExpr(_, offset) => offset
      ImportAliasExpr(_, offset) => offset
      ProductExpr(_, offset) => offset
      TypeBindingExpr(_, offset) => offset
      ArrayExpr(_, offset) => offset
      LambdaExpr(_, offset) => offset
      ObjectExpr(_, offset) => offset
      ConstructExpr(_, _, offset) => offset
      BlockExpr(_, offset) => offset
      IfExpr(_, _, _, offset) => offset
      MatchExpr(_, _, offset) => offset
      WhileExpr(_, _, offset) => offset
      ReturnExpr(_, offset) => offset
      BreakExpr(_, offset) => offset
      ContinueExpr(_, offset) => offset
      PrefixExpr(_, _, offset) => offset
      BinaryExpr(_, _, _, offset) => offset
      CallExpr(_, _, offset) => offset
      FieldExpr(_, _, offset) => offset
      QualifiedExpr(_, _, offset) => offset
      ProductFieldExpr(_, _, _, offset) => offset
      IndexExpr(_, _, offset) => offset
      AssignmentExpr(_, _, offset) => offset
      IndexSetExpr(_, _, _, offset) => offset
    }
  }
}

pub enum SelfHostHirPattern {
  WildcardPattern(U32)
  BindingPattern(U32, U32)
  ImportAliasPattern(U32, U32)
  RestPattern(U32)
  LiteralPattern(U32, U32)
  QualifiedPattern(U32, U32, U32)
  TuplePattern(U32, SelfHostHirSpan, U32)
  ProductPattern(SelfHostHirSpan, U32)
  StructPattern(U32, SelfHostHirSpan, Bool, U32, U32)
  AlternativePattern(U32, SelfHostHirSpan, U32)
}

impl SelfHostHirPattern {
  fn offset(self) -> U32 {
    match self {
      WildcardPattern(offset) => offset
      BindingPattern(_, offset) => offset
      ImportAliasPattern(_, offset) => offset
      RestPattern(offset) => offset
      LiteralPattern(_, offset) => offset
      QualifiedPattern(_, _, offset) => offset
      TuplePattern(_, _, offset) => offset
      ProductPattern(_, offset) => offset
      StructPattern(_, _, _, _, offset) => offset
      AlternativePattern(_, _, offset) => offset
    }
  }
}

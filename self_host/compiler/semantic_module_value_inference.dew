open dew.std.array
open dew.std.map
open dew.std.option

pub struct SelfHostInferredModuleValues {
  module_id: U64
  dependencies: SelfHostModuleValueDependencies
  let_declarations: Array<U64>
  let_types: Array<I32>
  types: Array<SelfHostBodyTypeTerm>
  type_arguments: Array<I32>
  diagnostics: Array<SelfHostBodyInferenceDiagnostic>
}

impl SelfHostInferredModuleValues {
  fn type_term(self, type_: I32) -> SelfHostBodyTypeTerm {
    if type_ < -1i32 {
      SelfHostBodyTypeTerm::BodyResolvedType(
        self_host_body_i32_to_u32(-type_ - 2i32),
      )
    } else if type_ >= 0i32 {
      self.types[self_host_body_i32_to_u32(type_)]
    } else {
      SelfHostBodyTypeTerm::BodyErrorType
    }
  }
}

fn self_host_module_value_body_index(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Option<U32> {
  let mut index = 0u32
  while index {
    current => if current < collected.bodies.length() {
      if self_host_u64_equal(collected.bodies[current].declaration, declaration) {
        break Option::Some(current)
      }
      continue current + 1u32
    } else {
      break Option::None
    }
  }
}

fn self_host_module_value_declaration_offset(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> U32 {
  match collected.declaration_reference(declaration) {
    Option::Some(reference) => match reference {
      SelfHostCollectedDeclarationReference::TopLevel(value) => value.offset
      SelfHostCollectedDeclarationReference::Method(value) => value.offset
    }
    Option::None => 0u32
  }
}

fn self_host_module_value_type_slots() -> Map<U64, I32> {
  Map::empty()
}

fn self_host_module_value_inputs_with_slots(
  imported: SelfHostBasicImportedInputs,
  local_types: Map<U64, I32>,
) -> SelfHostBasicImportedInputs {
  SelfHostBasicImportedInputs::{
    resolved_imports: imported.resolved_imports
    scope: imported.scope
    callables: imported.callables
    generic_parameter_ids: imported.generic_parameter_ids
    parameter_types: imported.parameter_types
    parameter_receivers: imported.parameter_receivers
    implementations: imported.implementations
    fields: imported.fields
    variants: imported.variants
    variant_payload_types: imported.variant_payload_types
    type_declaration_types: imported.type_declaration_types
    type_generic_spans: imported.type_generic_spans
    module_value_types: imported.module_value_types
    local_module_value_types: local_types
    local_module_value_terms: []
    local_module_value_arguments: []
    local_module_value_types_are_solver_local: true
  }
}

fn self_host_infer_module_values_with_inputs(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  imported: SelfHostBasicImportedInputs,
) -> SelfHostInferredModuleValues {
  let dependencies = self_host_analyze_module_value_dependencies(collected, names)
  let declarations = []
  let let_types = self_host_inference_i32_slots(collected.lets.length(), 0i32)
  let slots = self_host_module_value_type_slots()
  let solver = SelfHostLocalTypeSolver::new(resolved)
  solver.member_types = self_host_body_member_type_context(collected, resolved, imported)
  let diagnostics = []
  let mut declaration_index = 0u32
  let _ = while declaration_index {
    current => if current < collected.lets.length() {
      declarations.push(
        self_host_collected_let_identity(collected.lets[current]).declaration,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut scc_index = 0u32
  let _ = while scc_index {
    current_scc => if current_scc < dependencies.sccs.length() {
      let scc = self_host_hir_span_identity(dependencies.sccs[current_scc])
      let mut member = 0u32
    let _ = while member {
      current => if current < scc.length {
        let declaration = dependencies.scc_declaration(
          self_host_u32_add(scc.start, current),
        )
        slots[declaration] = solver.fresh_variable()
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let inferencers = []
    member = 0u32
    let _ = while member {
      current => if current < scc.length {
        let declaration = dependencies.scc_declaration(
          self_host_u32_add(scc.start, current),
        )
        match self_host_module_value_body_index(collected, declaration) {
          Option::Some(body_index) => {
            let body = collected.bodies[body_index]
            let inferencer = SelfHostBasicBodyInferencer::new_with_solver(
              collected,
              resolved,
              names,
              self_host_module_value_inputs_with_slots(imported, slots),
              body,
              names.bodies[body_index],
              solver,
            )
            inferencer.constrain_body()
            let _ = solver.unify(
              inferencer.result_type,
              match slots.get(declaration) {
                Option::Some(type_) => type_
                Option::None => solver.error_type()
              },
              self_host_synthetic_type_origin(
                self_host_semantic_id_local(declaration),
                self_host_module_value_declaration_offset(collected, declaration),
              ),
            )
            inferencers.push(inferencer)
          }
          Option::None => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let unresolved = self_host_module_value_bool_slots(scc.length)
    member = 0u32
    let _ = while member {
      current => if current < scc.length {
        let declaration = dependencies.scc_declaration(
          self_host_u32_add(scc.start, current),
        )
        let slot = match slots.get(declaration) {
          Option::Some(type_) => type_
          Option::None => solver.error_type()
        }
        unresolved[current] = solver.has_unresolved_variable(slot)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    member = 0u32
    let _ = while member {
      current => if current < scc.length {
        let declaration = dependencies.scc_declaration(
          self_host_u32_add(scc.start, current),
        )
        let slot = match slots.get(declaration) {
          Option::Some(type_) => type_
          Option::None => solver.error_type()
        }
        if unresolved[current] {
          solver.poison_type(slot)
          diagnostics.push(SelfHostBodyInferenceDiagnostic::UnresolvedModuleValue(
            declaration,
            self_host_module_value_declaration_offset(collected, declaration),
          ))
        }
        match self_host_module_value_let_index(collected, declaration) {
          Option::Some(let_index) => {
            let_types[let_index] = solver.zonk_type(slot)
          }
          Option::None => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
      inferencers.clear()
      continue current_scc + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut solver_diagnostic = 0u32
  let _ = while solver_diagnostic {
    current => if current < solver.diagnostic_count() {
      diagnostics.push(SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(
        solver.diagnostic_at(current),
      ))
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostInferredModuleValues::{
    module_id: collected.module_id
    dependencies: dependencies
    let_declarations: declarations
    let_types: let_types
    types: solver.types
    type_arguments: solver.type_arguments
    diagnostics: diagnostics
  }
}

fn self_host_infer_module_values(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
) -> SelfHostInferredModuleValues {
  self_host_infer_module_values_with_inputs(
    collected,
    resolved,
    names,
    SelfHostBasicImportedInputs::{
      resolved_imports: Option::None
      scope: Option::None
      callables: []
      generic_parameter_ids: []
      parameter_types: []
      parameter_receivers: []
      implementations: []
      fields: []
      variants: []
      variant_payload_types: []
      type_declaration_types: self_host_basic_empty_type_declaration_map()
      type_generic_spans: self_host_empty_u64_span_map()
      module_value_types: self_host_basic_empty_type_declaration_map()
      local_module_value_types: self_host_basic_empty_local_module_value_map()
      local_module_value_terms: []
      local_module_value_arguments: []
      local_module_value_types_are_solver_local: false
    },
  )
}

fn self_host_infer_module_values_with_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  callables: Array<SelfHostResolvedImportedCallable>,
  generic_parameter_ids: Array<U64>,
  parameter_types: Array<U32>,
  parameter_receivers: Array<Bool>,
  implementations: Array<SelfHostResolvedImportedImplementation>,
  fields: Array<SelfHostResolvedImportedField>,
  variants: Array<SelfHostResolvedImportedVariant>,
  variant_payload_types: Array<U32>,
  type_declaration_types: Map<U64, U32>,
  type_generic_spans: Map<U64, SelfHostHirSpan>,
  module_value_types: Map<U64, U32>,
) -> SelfHostInferredModuleValues {
  self_host_infer_module_values_with_inputs(
    collected,
    resolved,
    names,
    SelfHostBasicImportedInputs::{
      resolved_imports: Option::None
      scope: Option::None
      callables: callables
      generic_parameter_ids: generic_parameter_ids
      parameter_types: parameter_types
      parameter_receivers: parameter_receivers
      implementations: implementations
      fields: fields
      variants: variants
      variant_payload_types: variant_payload_types
      type_declaration_types: type_declaration_types
      type_generic_spans: type_generic_spans
      module_value_types: module_value_types
      local_module_value_types: self_host_basic_empty_local_module_value_map()
      local_module_value_terms: []
      local_module_value_arguments: []
      local_module_value_types_are_solver_local: false
    },
  )
}

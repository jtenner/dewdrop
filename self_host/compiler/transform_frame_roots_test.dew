test "checked transform roots transitive module initializer instances" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{ path: "app.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nimport runtime.helpers as @runtime_helpers\n\nlet base = @runtime_helpers.identity(40i32)\nlet answer = base + @runtime_helpers.identity(2i32)\n\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(answer))\n}\n\n#replace\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    }, {
      path: "runtime.helpers"
      files: [{ path: "helper.dew"
        source: b"import dew.std.types as @types\n\npub fn identity<t>(value: t) -> t {\n  if @types.is_unit::<t>() {\n    value\n  } else {\n    value\n  }\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      let source = ct_test_all_source(expanded.modules[0u32])
      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "checked transform roots omit unused entries with imported annotation aliases" {
  let manifest = SelfHostProgramManifest::{
    modules: [
    { path: "example.app"
      files: [{ path: "app.dew"
        source: b"import example.macros as @entry\n#@entry.replace\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    },

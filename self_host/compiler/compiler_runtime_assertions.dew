// Shared runtime checks for compiler arena and parallel-array contracts.
// Keep these checks at typed API boundaries so invalid compiler state traps
// before an unchecked Wasm array access loses the source-level invariant.
import dew.std.wasm.intrinsics as @wasm

pub struct SelfHostInvariantFailure {
  code: U32
  phase: U32
  module_id: U64
  declaration: U64
  body: U64
  expression: U32
  expected: U64
  actual: U64
  detail: U64
}

fn self_host_invariant_failure_is_present() -> Bool {
  @wasm.wasm_u64_load(0u32) == 4919706420659244884u64 &&
    @wasm.wasm_u64_load(8u32) == 1u64
}

fn self_host_record_invariant_failure(
  failure: SelfHostInvariantFailure,
) -> Unit {
  // The compiler and Facet runtimes reserve low memory as transient scratch.
  // Write the magic last so a partial write never looks like a complete record.
  // The trap follows immediately, so no later guest operation can reuse it.
  @wasm.wasm_u64_store(8u32, 1u64)
  @wasm.wasm_u32_store(16u32, failure.code)
  @wasm.wasm_u32_store(20u32, failure.phase)
  @wasm.wasm_u64_store(24u32, failure.module_id)
  @wasm.wasm_u64_store(32u32, failure.declaration)
  @wasm.wasm_u64_store(40u32, failure.body)
  @wasm.wasm_u32_store(48u32, failure.expression)
  @wasm.wasm_u64_store(56u32, failure.expected)
  @wasm.wasm_u64_store(64u32, failure.actual)
  @wasm.wasm_u64_store(72u32, failure.detail)
  @wasm.wasm_u64_store(0u32, 4919706420659244884u64)
}

fn self_host_clear_invariant_failure() -> Unit {
  @wasm.wasm_u64_store(0u32, 0u64)
}

pub fn self_host_invariant_failure_code() -> U32 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u32_load(16u32)
  } else {
    0u32
  }
}

pub fn self_host_invariant_failure_phase() -> U32 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u32_load(20u32)
  } else {
    0u32
  }
}

pub fn self_host_invariant_failure_module_id() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(24u32)
  } else {
    0u64
  }
}

pub fn self_host_invariant_failure_declaration() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(32u32)
  } else {
    0u64
  }
}

pub fn self_host_invariant_failure_body() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(40u32)
  } else {
    0u64
  }
}

pub fn self_host_invariant_failure_expression() -> U32 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u32_load(48u32)
  } else {
    4294967295u32
  }
}

pub fn self_host_invariant_failure_expected() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(56u32)
  } else {
    0u64
  }
}

pub fn self_host_invariant_failure_actual() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(64u32)
  } else {
    0u64
  }
}

pub fn self_host_invariant_failure_detail() -> U64 {
  if self_host_invariant_failure_is_present() {
    @wasm.wasm_u64_load(72u32)
  } else {
    0u64
  }
}

fn self_host_assert_compiler_invariant_with_failure(
  condition: Bool,
  failure: SelfHostInvariantFailure,
  message: String,
) -> Bool {
  if condition {
    true
  } else {
    // Formatting and assert output use the same low-memory scratch area.
    // Nothing may run between publishing this record and trapping. The host
    // renders the numeric context after it catches the trap.
    let _ = message
    self_host_record_invariant_failure(failure)
    unreachable()
  }
}

fn self_host_assert_compiler_invariant(
  condition: Bool,
  message: String,
) -> Bool {
  self_host_assert_compiler_invariant_with_failure(
    condition,
    SelfHostInvariantFailure::{
      code: 1u32
      phase: 0u32
      module_id: 0u64
      declaration: 0u64
      body: 0u64
      expression: 4294967295u32
      expected: 0u64
      actual: 0u64
      detail: 0u64
    },
    message,
  )
}

fn self_host_assert_array_index(
  index: U32,
  length: U32,
  message: String,
) -> Bool {
  self_host_assert_compiler_invariant(
    self_host_array_index_is_valid(index, length),
    message,
  )
}

fn self_host_array_index_is_valid(index: U32, length: U32) -> Bool {
  // Keep this comparison behind a typed boundary. A raw U32 comparison can
  // otherwise lose its unsigned proof while the self-host compiler recovers
  // an expression shape from a shared i32 Wasm carrier.
  self_host_u32_greater(length, index)
}

fn self_host_array_span_is_valid(
  start: U32,
  count: U32,
  length: U32,
) -> Bool {
  if self_host_u32_greater(start, length) {
    false
  } else {
    !self_host_u32_greater(count, length - start)
  }
}

fn self_host_checked_relative_index(
  index: U32,
  span: SelfHostHirSpan,
  arena_length: U32,
) -> Option<U32> {
  if !self_host_array_span_is_valid(span.start, span.length, arena_length) ||
    index < span.start {
    return Option::None
  }
  let relative = index - span.start
  if relative < span.length {
    Option::Some(relative)
  } else {
    Option::None
  }
}

fn self_host_assert_array_span(
  start: U32,
  count: U32,
  length: U32,
  message: String,
) -> Bool {
  self_host_assert_compiler_invariant(
    self_host_array_span_is_valid(start, count, length),
    message,
  )
}

fn self_host_assert_parallel_array_lengths(
  left: U32,
  right: U32,
  message: String,
) -> Bool {
  self_host_assert_compiler_invariant(
    self_host_u32_equal(left, right),
    message,
  )
}

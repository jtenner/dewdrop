open dew.std.array

// Select one alternative before evaluating the shared arm guard. A failed
// guard proceeds to the next arm, not to another alternative in this arm.
fn self_host_emit_reference_pattern_alternatives(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  first: U32,
  remaining: SelfHostHirSpan,
  scratch: U32,
  destination: StarshineInstructions,
) -> Option<String> {
  self_host_assert_array_span(remaining.start, remaining.length, module_.pattern_children.length(), "ARN-101 alternative patterns")
  let candidates = [first]
  let _ = while 0u32 {
    index => if index < remaining.length {
      candidates.push(module_.pattern_children[remaining.start + index])
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut tail = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(tail, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(0i32)))
  let _ = while candidates.length() {
    length => if length > 0u32 {
      let index = length - 1u32
      let candidate = candidates[index]
      self_host_assert_array_index(candidate, module_.patterns.length(), "ARN-104 alternative pattern")
      let pattern = self_host_specialized_pattern(link, canonical, module_, module_.patterns[candidate])
      let predicate = StarshineFfi.ffi_ffi_bridge_instructions_new()
      let bindings = StarshineFfi.ffi_ffi_bridge_instructions_new()
      let trivial = match pattern.source {
        WildcardPattern(_) => true
        ProductPattern(children, _) => children.length == 0u32
        _ => false
      }
      if trivial || pattern.reference is PatternBindingReference(_) {
        StarshineFfi.ffi_ffi_bridge_instructions_push(predicate, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(1i32)))
        match pattern.reference {
          PatternBindingReference(local) => if !(pattern.shape is UnitPlannedValueShape) {
            let slot = match self_host_linked_i32_local_slot(canonical, module_, body, local) {
              Some(value) => value
              None => return Some("alternative binding has no physical local")
            }
            self_host_emit_pattern_path(link, scratch, [], bindings)
            StarshineFfi.ffi_ffi_bridge_instructions_push(bindings, StarshineFfi.ffi_lib_Instruction_local_set(StarshineFfi.ffi_lib_LocalIdx_new(self_host_u32_to_i32(slot))))
          }
          _ => {}
        }
      } else {
        let type_index = match self_host_pattern_nested_type(link, module_, pattern) {
          Some(value) => value
          None => return Some("alternative has no exact reference pattern type")
        }
        self_host_emit_pattern_path(link, scratch, [], predicate)
        StarshineFfi.ffi_ffi_bridge_instructions_push(predicate, StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(self_host_u32_to_i32(type_index)))
        match self_host_emit_nested_pattern_tests(link, canonical, module_, pattern, type_index, scratch, [], predicate) {
          Some(error) => return Some(error)
          None => {}
        }
        match self_host_emit_nested_pattern_bindings(link, module_, body, canonical, pattern, type_index, scratch, [], bindings, true) {
          Some(error) => return Some(error)
          None => {}
        }
      }
      StarshineFfi.ffi_ffi_bridge_instructions_push(bindings, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(1i32)))
      StarshineFfi.ffi_ffi_bridge_instructions_push(predicate, StarshineFfi.ffi_ffi_bridge_instruction_if(self_host_linked_block_type(I32PlannedValueShape), bindings, tail))
      tail = predicate
      continue index
    } else {
      break self_host_semantic_unit()
    }
  }
  StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_block(self_host_linked_block_type(I32PlannedValueShape), StarshineFfi.ffi_lib_Expr_new(tail)))
  None
}

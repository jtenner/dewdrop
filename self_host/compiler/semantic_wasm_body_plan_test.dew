test "missing physical field identity retains exact diagnostic context" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Cell {\n  value: I32\n}\npub fn read(cell: Cell) -> I32 {\n  cell.value\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, program))
  let mut checked = 0u32
  for plan in program.bodies {
    let module_ = link.fragments.specialization.lowering.modules[plan.module_index]
    let body = match self_host_body_lookup_for_plan(module_, plan) {
      Some(value) => value
      None => {
        assert(false, "source body must be present")
        unreachable()
      }
    }
    for source in plan.expressions {
      if source.selected_field != 0u64 {
        let valid = []
        self_host_verify_body_field_owner(link, plan, module_, body, source, valid)
        assert(valid.length() == 0u32, "the selected field starts valid")
        let missing = {
          expression: source.expression
          value: source.value
          carrier: source.carrier
          conflict_expected: source.conflict_expected
          conflict_actual: source.conflict_actual
          receiver_expression: source.receiver_expression
          receiver_logical_type: source.receiver_logical_type
          receiver_nominal_owner: source.receiver_nominal_owner
          receiver_physical_heap_type: source.receiver_physical_heap_type
          selected_field: 0u64
          selected_type_index: source.selected_type_index
          selected_field_index: source.selected_field_index
          selected_storage: source.selected_storage
          selected_reference_cast: source.selected_reference_cast
          call_function_index: source.call_function_index
        }
        let diagnostics = []
        self_host_verify_body_field_owner(link, plan, module_, body, missing, diagnostics)
        assert(diagnostics.length() == 1u32, "one changed field yields one diagnostic")
        let failure = diagnostics[0u32]
        assert(failure.code == 608u32, "BOD-608 must not be zero")
        assert(failure.module_id == plan.module_id && failure.declaration == plan.declaration && failure.body == plan.body, "source owner context")
        assert(failure.expression == source.expression && failure.source_offset == module_.expressions[source.expression].offset, "exact source expression and offset")
        assert(failure.physical_function_index == plan.physical_function_index && failure.specialization == plan.specialization && failure.specialization_key == plan.specialization_key, "physical target context")
        assert(failure.expected is EqRefBodyCarrier && failure.actual is UnresolvedBodyCarrier, "expected and actual evidence")
        assert(failure.context == "field access has no exact physical field identity", "failure text is preserved")
        checked = checked + 1u32
      }
    }
  }
  assert(checked == 1u32, "one field selection was mutated")
}

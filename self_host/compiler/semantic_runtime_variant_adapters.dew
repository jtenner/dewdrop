open dew.std.option

pub enum SelfHostRuntimeVariantAdapter {
  RuntimeResultOk
  RuntimeResultErr
}

fn self_host_empty_runtime_variant_adapters() -> Map<U64, SelfHostRuntimeVariantAdapter> {
  Map::empty()
}

fn self_host_runtime_adapter_variants(module_: SelfHostCollectedModule) -> Array<SelfHostCollectedVariant> {
  module_.variants
}

fn self_host_runtime_adapter_owner(module_: SelfHostCollectedModule, declaration: U64) -> SelfHostCollectedDeclaration {
  array_get_unchecked(module_.declarations, self_host_semantic_id_local(declaration))
}

fn self_host_plan_runtime_variant_adapters(
  fragments: SelfHostPlannedProgramWasmGCFragments,
) -> Map<U64, SelfHostRuntimeVariantAdapter> {
  let adapters = self_host_empty_runtime_variant_adapters()
  let program = fragments.specialization.lowering.collected
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < program.module_paths.length() {
      let path = program.module_paths[current]
      if path == "dew.std.result" {
        let module_ = program.modules.at(current)
        for source in self_host_runtime_adapter_variants(module_) {
          let variant = self_host_collected_variant_identity(source)
          let owner = self_host_runtime_adapter_owner(module_, variant.declaration)
          let owner_name = module_.name(owner.name)
          let name = module_.name(variant.name)
          let adapter = if owner_name == "Result" {
            if name == "Ok" {
              Option::Some(SelfHostRuntimeVariantAdapter::RuntimeResultOk)
            } else if name == "Err" {
              Option::Some(SelfHostRuntimeVariantAdapter::RuntimeResultErr)
            } else {
              Option::None
            }
          } else {
            Option::None
          }
          match adapter {
            Option::Some(value) => {
              let valid = (variant.kind is SelfHostCollectedVariantKind::TupleVariantDecl) &&
                self_host_u32_equal(variant.payload_types.length, 1u32)
              let _ = self_host_assert_compiler_invariant(valid, "runtime variant adapter has an invalid payload declaration")
              adapters[variant.id] = value
            }
            Option::None => {}
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  adapters
}

fn self_host_pattern_constructor_declaration(
  module_: SelfHostPlannedModuleLowering,
  pattern: SelfHostPlannedPattern,
) -> U64 {
  match pattern.selected_constructor {
    SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(declaration, _, _) => return declaration
    _ => {}
  }
  match pattern.source {
    SelfHostHirPattern::TuplePattern(target, _, _) => if target < module_.patterns.length() {
      match module_.patterns[target].selected_constructor {
        SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(declaration, _, _) => return declaration
        _ => {}
      }
    }
    _ => {}
  }
  0u64
}

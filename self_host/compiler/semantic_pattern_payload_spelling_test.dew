test "missing user payload evidence cannot be repaired by variant suffixes" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(
      b"enum Local<t, e> {\n  UserSome(t)\n  UserOk(t)\n  UserErr(e)\n}\npub fn run(value: Local<I64, I64>) -> I64 {\n  match value {\n    Local::UserSome(item) => item\n    Local::UserOk(item) => item\n    Local::UserErr(item) => item\n  }\n}\n",
    ),
    false,
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let indexes = self_host_build_physical_body_indexes(link)
  let missing = self_host_body_physical_value(indexes, -1i32, UnresolvedBodyCarrier, 0u64)
  let mut checked = 0u32
  for pattern in module_.patterns {
    if pattern.source is TuplePattern(_, _, _) {
      let present = self_host_body_pattern_payload_value(link, indexes, module_, pattern, 0u32, missing)
      assert(!(present.carrier is UnresolvedBodyCarrier), "the declared payload has physical storage evidence")
      let absent = self_host_body_pattern_payload_value(link, indexes, module_, pattern, 1u32, missing)
      assert(absent.carrier is UnresolvedBodyCarrier, "an absent payload must not use a generic slot selected by spelling")
      checked = checked + 1u32
    }
  }
  assert(checked == 3u32, "inspect all selected user payloads")
}

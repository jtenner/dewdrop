open dew.std.option

fn self_host_outlined_builtin_assert(
  module_: SelfHostPlannedModuleWasmGCFragments,
  function_: SelfHostPlannedWasmFunctionFragment,
  condition: Bool,
  code: U32,
  expected: U64,
  actual: U64,
  detail: U64,
) -> Unit {
  let _ = self_host_assert_compiler_invariant_with_failure(condition,
    {
      code: code
      phase: 7u32
      module_id: module_.module_id
      declaration: function_.declaration
      body: 0u64
      expression: 4294967295u32
      expected: expected
      actual: actual
      detail: detail
    },
    "outlined builtin signature must match its instruction contract",
  )
}

fn self_host_verify_outlined_builtin(
  module_: SelfHostPlannedModuleWasmGCFragments,
  function_: SelfHostPlannedWasmFunctionFragment,
  name: Bytes,
) -> Option<String> {
  let values = module_.function_value_types
  let parameters = function_.parameters
  let results = function_.results
  self_host_outlined_builtin_assert(module_, function_,
    self_host_array_span_is_valid(parameters.start, parameters.length, values.length()),
    101u32, u32_into_u64(values.length()),
    (u32_into_u64(parameters.start) << 32u64) | u32_into_u64(parameters.length), 0u64,
  )
  self_host_outlined_builtin_assert(module_, function_,
    self_host_array_span_is_valid(results.start, results.length, values.length()),
    101u32, u32_into_u64(values.length()),
    (u32_into_u64(results.start) << 32u64) | u32_into_u64(results.length), 1u64,
  )
  self_host_outlined_builtin_assert(module_, function_, results.length <= 1u32,
    709u32, 1u64, u32_into_u64(results.length), 0u64,
  )
  let actual_result = if results.length == 0u32 {
    UnitBodyCarrier
  } else {
    self_host_body_carrier_from_value_type(values[results.start])
  }
  if name.equals(b"unsafe.bitcast") {
    self_host_outlined_builtin_assert(module_, function_, parameters.length == 1u32,
      703u32, 1u64, u32_into_u64(parameters.length), 0u64,
    )
    let input = self_host_body_carrier_from_value_type(values[parameters.start])
    let scalar = match input {
      I32BodyCarrier => true
      I64BodyCarrier => true
      F32BodyCarrier => true
      F64BodyCarrier => true
      V128BodyCarrier => true
      _ => false
    }
    self_host_outlined_builtin_assert(module_, function_, scalar && self_host_body_carrier_equal(input, actual_result),
      709u32, self_host_body_carrier_code(input), self_host_body_carrier_code(actual_result), 0u64,
    )
    return None
  }
  let signature = match self_host_raw_intrinsic_signature(name) {
    Some(value) => value
    None => return Some("outlined builtin needs an explicit instruction stack contract")
  }
  self_host_outlined_builtin_assert(module_, function_, parameters.length == signature.inputs.length(),
    703u32, u32_into_u64(signature.inputs.length()), u32_into_u64(parameters.length), 0u64,
  )
  while 0u32 {
    index if index < parameters.length => {
      let actual = self_host_body_carrier_from_value_type(values[parameters.start + index])
      let expected = signature.inputs[index]
      self_host_outlined_builtin_assert(module_, function_, self_host_body_carrier_equal(actual, expected),
        705u32, self_host_body_carrier_code(expected), self_host_body_carrier_code(actual), u32_into_u64(index),
      )
      continue index + 1u32
    }
    _ => break ()
  }
  // An unreachable instruction has Wasm's polymorphic result, not Unit flow.
  if !(signature.result is NeverBodyCarrier) {
    self_host_outlined_builtin_assert(module_, function_, self_host_body_carrier_equal(actual_result, signature.result),
      709u32, self_host_body_carrier_code(signature.result), self_host_body_carrier_code(actual_result), 0u64,
    )
  }
  None
}

fn self_host_append_outlined_builtin(
  module_: SelfHostPlannedModuleWasmGCFragments,
  function_: SelfHostPlannedWasmFunctionFragment,
  name: Bytes,
  functions: StarshineFunctions,
) -> Option<String> {
  match self_host_verify_outlined_builtin(module_, function_, name) {
    Some(error) => return Some(error)
    None => {}
  }
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  while 0u32 {
    index if index < function_.parameters.length => {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions,
        StarshineFfi.ffi_lib_Instruction_local_get(StarshineFfi.ffi_lib_LocalIdx_new(self_host_u32_to_i32(index))),
      )
      continue index + 1u32
    }
    _ => break ()
  }
  if !self_host_emit_linked_builtin(name, instructions) {
    return Some("outlined builtin instruction has no emitter")
  }
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions,
    StarshineFfi.ffi_lib_Func_new(StarshineFfi.ffi_lib_Locals_empty(), StarshineFfi.ffi_lib_Expr_new(instructions)),
  )
  None
}

open dew.std.array
open dew.std.bytes
open dew.std.fixed_array
open dew.std.fs
open dew.std.fs.wasi
open dew.std.option
open dew.std.path
open dew.std.process
open dew.std.process.wasi
open dew.std.result
open dew.std.string

fn self_host_error(process: WasiProcess, message: String) -> U32 {
  let _written = process_write_stderr(
    process,
    "self-host smoke: ".concat(message).concat("\n").as_bytes(),
  )
  1u32
}

fn self_host_compile_request_semantic_plan(
  request: SelfHostCompileRequest,
) -> Result<SelfHostPlannedProgramWasmGCLink, String> {
  let collected = self_host_collect_program_manifest(7200u64, request.manifest)
  if self_host_u32_greater(collected.diagnostics.length(), 0u32) {
    return Result::Err("compile request manifest is invalid")
  }
  let frozen = self_host_freeze_program_signature_interfaces(collected)
  if self_host_u32_greater(frozen.import_diagnostics.length(), 0u32) ||
    self_host_u32_greater(frozen.path_diagnostics.length(), 0u32) {
    return Result::Err("compile request imports are invalid")
  }
  match collected.module_index(request.root_module) {
    Option::None => Result::Err("compile request root module is missing")
    Option::Some(_) => Result::Ok(
      self_host_plan_program_wasmgc_link(
        self_host_plan_program_wasmgc_fragments(
          self_host_plan_program_specialization(
            self_host_plan_program_lowering(frozen),
            request.test_mode,
          ),
        ),
        request.test_mode,
      ),
    )
  }
}

fn self_host_fingerprint_matches(
  expected: FixedArray<U8>,
  actual: Bytes,
) -> Bool {
  if actual.byte_length() != expected.length() {
    false
  } else {
    while 0u32 {
      index if index < expected.length() => {
        if expected.get_unchecked(index) != actual.byte_at(index) {
          break false
        } else {
          continue index + 1u32
        }
      }
      _ => break true
    }
  }
}

pub fn main() -> U32 {
  let process = wasi_process()
  match process_arguments(process, 8u32, 4096u32) {
    Result::Err(_) => self_host_error(process, "cannot read process arguments")
    Result::Ok(arguments) => {
      if arguments.length() != 2u32 {
        self_host_error(process, "usage: COMPILER REQUEST")
      } else {
        match relative_path(arguments.get_unchecked(1u32)) {
          Result::Err(_) => self_host_error(process, "request path is not relative")
          Result::Ok(request_path) => {
            let filesystem = wasi_file_system(3u32)
            match fs_read_file(filesystem, request_path, 268435456u32) {
              Result::Err(_) => self_host_error(process, "cannot read compile request")
              Result::Ok(request_bytes) =>
                match decode_self_host_compile_request(request_bytes) {
                  Result::Err(error) => self_host_error(process, error)
                  Result::Ok(request) => {
                    let fingerprint = starshine_compiler_fingerprint(
                      request.starshine_provider,
                    )
                    if !self_host_fingerprint_matches(
                      fingerprint,
                      request.compiler_fingerprint,
                    ) {
                      self_host_error(process, "compiler fingerprint mismatch")
                    } else {
                      match self_host_compile_request_semantic_plan(request) {
                        Result::Err(error) => self_host_error(process, error)
                        Result::Ok(_plan) => match request.root_source() {
                        Option::None => self_host_error(process, "root module has no source file")
                        Option::Some(source) => match parse_self_host_i32_source(source) {
                        Result::Err(error) => self_host_error(process, error)
                        Result::Ok(value) =>
                          match build_self_host_i32_module(value) {
                            Result::Err(error) => self_host_error(process, error)
                            Result::Ok(output) =>
                              match relative_path(request.output_path) {
                                Result::Err(_) =>
                                  self_host_error(process, "output path is not relative")
                                Result::Ok(output_path) =>
                                  match fs_write_file(filesystem, output_path, output) {
                                    Result::Err(_) =>
                                      self_host_error(process, "cannot write output module")
                                    Result::Ok(_) => 0u32
                                  }
                              }
                          }
                        }
                      }
                    }
                  }
                }
            }
          }
        }
      }
    }
  }
}
}

test "foreign host imports keep namespace metadata through physical planning" {
  let invalid = self_host_collect_bytes(5502u64,
    b"foreign import \"link:provider\" as Host {\n  fn call() -> Unit = \"call\"\n}\n",
  )
  assert(invalid.diagnostics.length() == 1u32, "reserved host namespace must be diagnostic")
  assert(invalid.diagnostics[0u32] is ReservedForeignHostNamespace(_, _), "host imports must not become linked providers")
  let link = self_host_physical_test_named_import_link("app.host",
    b"foreign import \"custom.host\" as Host {\n  fn host_send(value: I64) -> I32 = \"send\"\n}\npub fn send(value: I64) -> I32 {\n  Host.host_send(value)\n}\n",
    b"open app.host\npub fn run() -> I32 {\n  send(7i64)\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
  let mut found = false
  for module_ in link.fragments.modules {
    for function_ in module_.functions {
      match function_.kind {
        PlannedWasmImportedFunction(namespace, field) => {
          assert(namespace.equals(b"custom.host"), "host import namespace must be exact")
          assert(field.equals(b"send"), "host import field must be exact")
          found = true
        }
        _ => {}
      }
    }
  }
  assert(found, "host import must reach the physical plan")
}

test "imported method candidates accept Never and reject wrong scalar arguments" {
  let runtime = b"impl Unit {\n  fn consume(self, value: I64) -> I64 {\n    value\n  }\n}\n"
  let link = self_host_physical_test_named_import_link("app.methods", runtime,
    b"open app.methods\npub fn run() -> I32 {\n  ().consume(return 7i32)\n  0i32\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
  let wrong = self_host_physical_test_named_import_link("app.methods", runtime,
    b"open app.methods\npub fn run() -> I64 {\n  ().consume(true)\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(wrong.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "wrong argument must stay diagnostic")
  assert(module_.inferred.diagnostics[0u32] is NoMatchingMethod(_, _, _), "wrong scalar is not assignable")
}

test "outer imported method supplies the result type of an inner conversion" {
  let link = self_host_physical_test_named_import_link(
    "app.conversions",
    b"pub trait Convert<t> {\n  fn convert(self) -> t\n}\nimpl Convert<U32> for U32 {\n  fn convert(self) -> U32 {\n    self\n  }\n}\nimpl Convert<U64> for U32 {\n  fn convert(self) -> U64 {\n    17u64\n  }\n}\npub struct Sink {}\nimpl Sink {\n  fn accept(self, value: U64) -> U64 {\n    value\n  }\n}\n",
    b"open app.conversions\npub fn run(value: U32) -> U64 {\n  let sink = Sink::{}\n  sink.accept((value % 251u32).convert())\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
}

test "retrying a method cannot hide a true result type ambiguity" {
  let link = self_host_physical_test_named_import_link(
    "app.conversions",
    b"pub trait Convert<t> {\n  fn convert(self) -> t\n}\nimpl Convert<U32> for U32 {\n  fn convert(self) -> U32 {\n    self\n  }\n}\nimpl Convert<U64> for U32 {\n  fn convert(self) -> U64 {\n    17u64\n  }\n}\n",
    b"open app.conversions\npub fn run(value: U32) -> Unit {\n  value.convert()\n  ()\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "one unresolved ambiguity remains")
  assert(module_.inferred.diagnostics[0u32] is AmbiguousMethod(_, _, _, _, 2u32, _), "both valid conversions must stay visible")
}

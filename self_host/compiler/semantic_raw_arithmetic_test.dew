fn self_host_assert_invalid_raw_arithmetic(source: Bytes) -> Unit {
  let fragments = self_host_physical_test_fragments(source)
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(_) => assert(false, "raw arithmetic accepted a wrong carrier")
    Result::Err(error) => assert(error.contains("raw intrinsic") && error.contains("carrier does not match its opcode"), error)
  }
}

test "raw arithmetic rejects incorrect first and second operands and results" {
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I64, right: I32) -> I32 = \"i32.add\"\npub fn main(left: I64, right: I32) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I64) -> I32 = \"i32.add\"\npub fn main(left: I32, right: I64) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I32) -> I64 = \"i32.add\"\npub fn main(left: I32, right: I32) -> I64 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I64, right: I32) -> I32 = \"i32.sub\"\npub fn main(left: I64, right: I32) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I64) -> I32 = \"i32.sub\"\npub fn main(left: I32, right: I64) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I32) -> I64 = \"i32.sub\"\npub fn main(left: I32, right: I32) -> I64 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I64, right: I32) -> I32 = \"i32.le_s\"\npub fn main(left: I64, right: I32) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I64) -> I32 = \"i32.le_s\"\npub fn main(left: I32, right: I64) -> I32 {\n  operation(left, right)\n}\n",
  )
  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: I32, right: I32) -> I64 = \"i32.le_s\"\npub fn main(left: I32, right: I32) -> I64 {\n  operation(left, right)\n}\n",

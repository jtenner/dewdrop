  self_host_assert_invalid_raw_arithmetic(
    b"builtin operation(left: F64, right: F64) -> I32 = \"f64.div\"\npub fn main(left: F64, right: F64) -> I32 {\n  operation(left, right)\n}\n",
  )
}

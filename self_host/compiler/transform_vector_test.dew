test "Wasm vector oracle 576-623" {
  let machine = ct_machine(ct_test_plan(b""))
  assert(ct_vector_test_equal(machine, ct_vector_intrinsic(machine, "i32x4.trunc_sat_f64x2_s_zero", [CtValue::Vector(9223372036854775808u64, 0u64)]), CtValue::Vector(0u64, 0u64)), "i32x4.trunc_sat_f64x2_s_zero")

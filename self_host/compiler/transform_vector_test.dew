  assert(ct_vector_test_equal(machine, ct_vector_intrinsic(machine, "i32x4.trunc_sat_f64x2_s_zero", [CtValue::Vector(9218868437227405378u64, 18442240474082181120u64)]), CtValue::Vector(9223372036854775808u64, 0u64)), "i32x4.trunc_sat_f64x2_s_zero")

fn ct_vector_test_equal(machine: CtMachine, actual: CtValue, expected: CtValue) -> Bool {
  if machine.error.byte_length() != 0u32 {
    return false
  }
  match (actual, expected) {
    (Vector(al, ah), Vector(bl, bh)) => al == bl && ah == bh
    (Floating(a, _), Floating(b, _)) => a == b
    _ => ct_raw_bits(machine, actual) == ct_raw_bits(machine, expected)
  }
}
test "Wasm vector oracle 0-47" {
  let machine = ct_machine(ct_test_plan(b""))
  assert(ct_vector_test_equal(machine, ct_vector_intrinsic(machine, "v128.not", [CtValue::Vector(9259399738665533311u64, 18410434353617240319u64)]), CtValue::Vector(9187344335044018304u64, 36309720092311296u64)), "v128.not")

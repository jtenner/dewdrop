fn self_host_test_call_target_update() -> (SelfHostPlannedBodyLowering, Array<SelfHostPlannedPhysicalExpressionCarrier>) {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"fn keep(value: I64) -> I64 {\n  value\n}\npub fn run() -> I64 {\n  keep(42i64)\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid target update source")
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid target update plan")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let expressions = program.bodies[1u32].expressions.copy()
  assert(body.declaration == ((5100u64 << 32u64) | 1u64), "caller declaration")
  assert(body.expressions.start == 1u32 && body.expressions.length == 3u32, "caller expression span")
  assert(expressions.length() == 3u32 && expressions[2u32].expression == 3u32, "stored call identity")
  assert(expressions[2u32].call_function_index == 0u32, "selected linked callee")
  (body, expressions)
}

fn self_host_test_expression_call_target(source: SelfHostPlannedPhysicalExpressionCarrier, target: U32) -> SelfHostPlannedPhysicalExpressionCarrier {
  SelfHostPlannedPhysicalExpressionCarrier::{
    expression: source.expression
    value: source.value
    carrier: source.carrier
    conflict_expected: source.conflict_expected
    conflict_actual: source.conflict_actual
    receiver_expression: source.receiver_expression
    receiver_logical_type: source.receiver_logical_type
    receiver_nominal_owner: source.receiver_nominal_owner
    receiver_physical_heap_type: source.receiver_physical_heap_type
    selected_field: source.selected_field
    selected_type_index: source.selected_type_index
    selected_field_index: source.selected_field_index
    selected_storage: source.selected_storage
    selected_reference_cast: source.selected_reference_cast
    call_function_index: target
  }
}

fn self_host_test_canonical_target_fixture() -> (SelfHostPlannedProgramWasmGCLink, SelfHostPlannedProgramWasmBodyPlan) {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"fn keep(value: I64) -> I64 {\n  value\n}\npub fn run() -> I64 {\n  keep(42i64)\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid canonical call fixture")
  (link, program)
}

test "canonical target lookup uses the saved call target" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  match self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration) {
    Option::Some(value) => assert(value == 2u32, "exact saved callee uses the encoded function handle")
    Option::None => assert(false, "valid call has a saved target")
  }
}

test "canonical target lookup cannot replace a missing body plan" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  assert(self_host_linked_canonical_call_index(Option::None, link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration) is Option::None, "link metadata cannot replace the missing body plan")
}

test "canonical target lookup cannot replace a missing expression target" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  plan.expressions[2u32] = self_host_test_expression_call_target(plan.expressions[2u32], 4294967295u32)
  assert(self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration) is Option::None, "the link table must not repair a missing frozen target")
}

test "canonical target lookup cannot replace a missing call recipe" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  let _ = plan.calls.pop()
  assert(self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration) is Option::None, "a target without a recipe cannot emit")
}

test "canonical target lookup rejects the wrong caller specialization" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  assert(self_host_linked_canonical_call_index(Option::Some(plan), link, body, 0u32, 3u32, module_.bodies[0u32].declaration) is Option::None, "caller specialization is part of the saved identity")
}

test "ABI-701 emitted target cannot change to another linked function" expect_trap "unreachable" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  plan.expressions[2u32] = self_host_test_expression_call_target(plan.expressions[2u32], 1u32)
  let _ = self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration)
}

test "ABI-701 emitted calls require one saved recipe" expect_trap "unreachable" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  plan.calls.push(plan.calls[0u32])
  let _ = self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration)
}

test "LNK-502 emitted target must be in the linked function table" expect_trap "unreachable" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  plan.expressions[2u32] = self_host_test_expression_call_target(plan.expressions[2u32], 99u32)
  let _ = self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, module_.bodies[0u32].declaration)
}

test "ABI-701 emitted calls retain the selected declaration" expect_trap "unreachable" {
  let (link, program) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = program.bodies[1u32]
  let _ = self_host_linked_canonical_call_index(Option::Some(plan), link, body, plan.specialization, 3u32, body.declaration)
}

test "ARN-102 indirect call targets belong to the caller body" expect_trap "unreachable" {
  let (link, _) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  self_host_require_runtime_call_target(module_, module_.bodies[1u32], 3u32, 0u32)
}

test "BOD-607 missing emitted targets retain the caller context" expect_trap "unreachable" {
  let (link, _) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  self_host_missing_emitted_call_target(module_, module_.bodies[1u32], 3u32, 1u32)
}

test "tuple call arguments retain their single physical reference" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"fn first(pair: (I64, I64)) -> I64 {\n  let (left, _) = pair\n  left\n}\npub fn run() -> I64 {\n  first((42i64, 1i64))\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, "valid tuple call before testing its recipe")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[1u32]
  let plan = physical.bodies[1u32]
  let mut checked = 0u32
  for expression in plan.expressions {
    if module_.expressions[expression.expression].kind is SelfHostPlannedExpressionKind::PlannedProductNew(_) {
      let evaluations = []
      let operands = []
      assert(self_host_body_plan_call_argument(module_, body, plan.expressions,
        expression.expression, evaluations, operands,
      ), "tuple call falls through")
      assert(evaluations.length() == 1u32, "one logical tuple evaluation")
      assert(operands.length() == 1u32, "a tuple is not an implicit argument spread")
      assert(self_host_body_call_operand_expression(operands[0u32]) == expression.expression, "operand is the tuple, not a tuple field")
      checked = checked + 1u32
    }
  }
  assert(checked == 1u32, "one tuple argument checked")
}

test "BOD-610 call evaluation cannot reconstruct a missing body plan" expect_trap "unreachable" {
  let (link, _) = self_host_test_canonical_target_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let _ = self_host_linked_i32_push_call_evaluations(Option::None, link, module_,
    module_.bodies[1u32], 3u32, SelfHostHirSpan::{
      start: 0u32
      length: 0u32
    }, 2u32, StarshineFfi.ffi_ffi_bridge_instructions_new(), [], [], 0u32, true,
  )
}

test "call target updates allow an identical fact without mutation" {
  let (body, expressions) = self_host_test_call_target_update()
  assert(!self_host_body_plan_set_call_function(body, expressions, 3u32, 0u32), "identical target adds no fact")
  assert(expressions[2u32].call_function_index == 0u32, "selected target remains exact")
}

test "missing call target evidence cannot replace a known target" {
  let (body, expressions) = self_host_test_call_target_update()
  assert(!self_host_body_plan_set_call_function(body, expressions, 3u32, 4294967295u32), "missing evidence adds no fact")
  assert(expressions[2u32].call_function_index == 0u32, "missing evidence cannot erase a target")
}

test "a pending call target increases only when a target is supplied" {
  let (body, expressions) = self_host_test_call_target_update()
  expressions[2u32] = self_host_test_expression_call_target(expressions[2u32], 4294967295u32)
  assert(!self_host_body_plan_set_call_function(body, expressions, 3u32, 4294967295u32), "missing target stays missing")
  assert(expressions[2u32].call_function_index == 4294967295u32, "no first-function fallback")
  assert(self_host_body_plan_set_call_function(body, expressions, 3u32, 0u32), "known target adds a fact")
  assert(expressions[2u32].call_function_index == 0u32, "exact supplied target")
}

test "SPC-303 call target updates reject concrete disagreement" expect_trap "unreachable" {
  let (body, expressions) = self_host_test_call_target_update()
  let _ = self_host_body_plan_set_call_function(body, expressions, 3u32, 1u32)
}

test "ARN-102 call target updates reject another body's expression" expect_trap "unreachable" {
  let (body, expressions) = self_host_test_call_target_update()
  let _ = self_host_body_plan_set_call_function(body, expressions, 0u32, 0u32)
}

test "ARN-103 call target updates require the complete expression table" expect_trap "unreachable" {
  let (body, expressions) = self_host_test_call_target_update()
  let _ = expressions.pop()
  let _ = self_host_body_plan_set_call_function(body, expressions, 3u32, 0u32)
}

test "ARN-106 call target updates check the stored expression identity" expect_trap "unreachable" {
  let (body, expressions) = self_host_test_call_target_update()
  expressions[2u32] = self_host_test_physical_expression_id(expressions[2u32], 2u32)
  let _ = self_host_body_plan_set_call_function(body, expressions, 3u32, 0u32)
}

test "a missing generic method mapping cannot be repaired from its receiver" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Box<t> {\n  value: t\n}\nimpl<t> Box<t> {\n  fn get(self) -> t {\n    self.value\n  }\n}\npub fn run(value: Box<I64>) -> I64 {\n  value.get()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid generic method link")
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid generic method body plan before mutation")
  assert(link.specialized_calls.length() == 1u32, "one exact generic method mapping")
  let call = link.specialized_calls[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[self_host_semantic_id_local(call.caller_body)]
  let indexes = self_host_build_physical_body_indexes(link)
  let original = self_host_body_seed_expression(link, indexes, module_, body,
    call.caller_specialization, call.expression,
  )
  assert(original.call_function_index == call.function_index, "seed retains the exact selected function")
  assert(link.call_index.heads.remove(call.caller_body), "remove just the caller's exact mapping")
  let missing = self_host_body_seed_expression(link, indexes, module_, body,
    call.caller_specialization, call.expression,
  )
  assert(missing.call_function_index == 4294967295u32, "a unique receiver-compatible function is not an exact mapping")
  let mut checked = 0u32
  for plan in program.bodies {
    if plan.body == call.caller_body && plan.specialization == call.caller_specialization {
      let diagnostics = []
      self_host_verify_body_call_arguments(link, plan, module_, body, missing,
        SelfHostHirSpan::{
          start: 0u32
          length: 0u32
        }, diagnostics,
      )
      assert(diagnostics.length() == 1u32, "missing target has one call diagnostic")
      let failure = diagnostics[0u32]
      assert(failure.code == 607u32 && failure.context == "call target is missing", "exact missing-target diagnostic")
      assert(failure.module_id == plan.module_id && failure.declaration == plan.declaration && failure.body == plan.body, "exact caller identity")
      assert(failure.expression == call.expression && failure.source_offset == module_.expressions[call.expression].offset, "exact call expression and source offset")
      assert(failure.physical_function_index == plan.physical_function_index && failure.specialization == plan.specialization && failure.specialization_key == plan.specialization_key, "exact physical caller")
      assert(failure.entity == 0u64 && failure.expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier && failure.actual is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier, "missing evidence is not fabricated")
      checked = checked + 1u32
    }
  }
  assert(checked == 1u32, "the mutated caller was verified")
}

open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.string

fn self_host_interface_string_equal_at(
  left: String,
  right: String,
  index: U32,
  length: U32,
) -> Bool {
  if index >= length {
    true
  } else if left.byte_at(index) != right.byte_at(index) {
    false
  } else {
    self_host_interface_string_equal_at(
      left,
      right,
      index + 1u32,
      length,
    )
  }
}

fn self_host_interface_string_equal(left: String, right: String) -> Bool {
  let length = left.byte_length()
  length == right.byte_length() && self_host_interface_string_equal_at(
    left,
    right,
    0u32,
    length,
  )
}

fn self_host_interface_string_at(
  values: Array<String>,
  index: U32,
) -> String {
  array_get_unchecked(values, index)
}

fn self_host_module_interface_u32_at(
  values: Array<U32>,
  index: U32,
) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_module_path_index(
  module_paths: Array<String>,
  path: String,
) -> U32 {
  let mut found = 4294967295u32
  let mut index = 0u32
  while index {
    current => if current < module_paths.length() {
      if self_host_interface_string_equal(
        self_host_interface_string_at(module_paths, current),
        path,
      ) {
        found = current
        break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  found
}

pub enum SelfHostFrozenInterfaceDeclarationKind {
  FrozenTypeDeclaration
  FrozenTraitDeclaration
  FrozenValueDeclaration
}

pub struct SelfHostFrozenInterfaceDeclaration {
  declaration: U64
  name: String
  kind: SelfHostFrozenInterfaceDeclarationKind
  source_kind: SelfHostCollectedDeclKind
  generic_parameter_count: U32
  generic_parameters: SelfHostHirSpan
  semantic_type: U32
  location: SelfHostSourceLocation
}

pub enum SelfHostFrozenInterfaceCallableKind {
  FrozenBuiltinCallable(Bytes)
  FrozenFunctionCallable
  FrozenTraitCallable(U64)
  FrozenImplCallable(U64)
}

pub struct SelfHostFrozenInterfaceField {
  field: U64
  declaration: U64
  variant: Option<U64>
  mutable_: Bool
  name: String
  type_: U32
  location: SelfHostSourceLocation
}

pub struct SelfHostFrozenInterfaceVariant {
  variant: U64
  declaration: U64
  kind: SelfHostCollectedVariantKind
  name: String
  payload_types: SelfHostHirSpan
  location: SelfHostSourceLocation
}

pub struct SelfHostFrozenInterfaceParameter {
  parameter: U64
  name: String
  type_: U32
  receiver: Bool
  location: SelfHostSourceLocation
}

pub struct SelfHostFrozenInterfaceCallable {
  declaration: U64
  name: String
  kind: SelfHostFrozenInterfaceCallableKind
  generic_parameters: SelfHostHirSpan
  parameters: SelfHostHirSpan
  result_type: U32
  function_type: U32
  location: SelfHostSourceLocation
}

pub struct SelfHostFrozenInterfaceImplementation {
  declaration: U64
  generic_parameters: SelfHostHirSpan
  trait_type: Option<U32>
  target_type: U32
  location: SelfHostSourceLocation
}

pub struct SelfHostFrozenModuleInterface {
  module_id: U64
  path: String
  resolved_types: SelfHostResolvedModuleTypes
  generic_parameter_bounds: Array<SelfHostHirSpan>
  declarations: Array<SelfHostFrozenInterfaceDeclaration>
  fields: Array<SelfHostFrozenInterfaceField>
  variants: Array<SelfHostFrozenInterfaceVariant>
  variant_payload_types: Array<U32>
  callables: Array<SelfHostFrozenInterfaceCallable>
  parameters: Array<SelfHostFrozenInterfaceParameter>
  implementations: Array<SelfHostFrozenInterfaceImplementation>
}

fn self_host_frozen_module_interface_identity(
  value: SelfHostFrozenModuleInterface,
) -> SelfHostFrozenModuleInterface {
  SelfHostFrozenModuleInterface::{
    module_id: value.module_id
    path: value.path
    resolved_types: value.resolved_types
    generic_parameter_bounds: value.generic_parameter_bounds
    declarations: value.declarations
    fields: value.fields
    variants: value.variants
    variant_payload_types: value.variant_payload_types
    callables: value.callables
    parameters: value.parameters
    implementations: value.implementations
  }
}

pub struct SelfHostFrozenInterfaceList {
  values: Array<SelfHostFrozenModuleInterface>
}

impl SelfHostFrozenInterfaceList {
  fn new() -> SelfHostFrozenInterfaceList {
    SelfHostFrozenInterfaceList::{
      values: []
    }
  }

  fn push(self, interface_: SelfHostFrozenModuleInterface) -> Unit {
    self.values.push(interface_)
  }

  fn set(
    self,
    index: U32,
    interface_: SelfHostFrozenModuleInterface,
  ) -> Unit {
    self.values[index] = interface_
  }

  fn length(self) -> U32 {
    self.values.length()
  }

  fn at(self, index: U32) -> SelfHostFrozenModuleInterface {
    self_host_frozen_module_interface_identity(self.values[index])
  }
}

impl SelfHostFrozenModuleInterface {
  fn resolved_diagnostic_count(self) -> U32 {
    self.resolved_types.diagnostic_count()
  }

  fn resolved_parameter_type(self, index: U32) -> U32 {
    self.resolved_types.parameter_type(index)
  }

  fn resolved_type_at(self, index: U32) -> SelfHostResolvedType {
    self.resolved_types.type_at(index)
  }

  fn resolved_type_count(self) -> U32 {
    self.resolved_types.types.length()
  }

  fn resolved_type_argument(self, index: U32) -> U32 {
    self.resolved_types.type_arguments[index]
  }

  fn resolved_generic_parameter_type(self, index: U32) -> U32 {
    self.resolved_types.generic_parameter_types[index]
  }

  fn resolved_generic_bound_type(self, index: U32) -> U32 {
    self.resolved_types.generic_bound_types[index]
  }

  fn generic_parameter_bound_at(self, index: U32) -> SelfHostHirSpan {
    self.generic_parameter_bounds[index]
  }

  fn declaration_count(self) -> U32 {
    self.declarations.length()
  }

  fn declaration_at(self, index: U32) -> SelfHostFrozenInterfaceDeclaration {
    self.declarations[index]
  }

  fn field_count(self) -> U32 {
    self.fields.length()
  }

  fn field_at(self, index: U32) -> SelfHostFrozenInterfaceField {
    self.fields[index]
  }

  fn variant_count(self) -> U32 {
    self.variants.length()
  }

  fn variant_at(self, index: U32) -> SelfHostFrozenInterfaceVariant {
    self.variants[index]
  }

  fn variant_payload_type(self, index: U32) -> U32 {
    self.variant_payload_types[index]
  }

  fn callable_count(self) -> U32 {
    self.callables.length()
  }

  fn callable_at(self, index: U32) -> SelfHostFrozenInterfaceCallable {
    self.callables[index]
  }

  fn callable_named(
    self,
    name: String,
  ) -> Option<SelfHostFrozenInterfaceCallable> {
    let mut index = 0u32
    while index {
      current => if current < self.callable_count() {
        let callable = self.callable_at(current)
        if callable.name == name {
          break Option::Some(callable)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn parameter_count(self) -> U32 {
    self.parameters.length()
  }

  fn parameter_at(self, index: U32) -> SelfHostFrozenInterfaceParameter {
    self.parameters[index]
  }

  fn implementation_count(self) -> U32 {
    self.implementations.length()
  }

  fn implementation_at(
    self,
    index: U32,
  ) -> SelfHostFrozenInterfaceImplementation {
    self.implementations[index]
  }

  fn declaration_named(
    self,
    name: String,
    kind: SelfHostFrozenInterfaceDeclarationKind,
  ) -> Option<U64> {
    let mut index = 0u32
    while index {
      current => if current < self.declaration_count() {
        let declaration = self.declaration_at(current)
        if self_host_interface_string_equal(declaration.name, name) &&
          self_host_frozen_kind_equal(declaration.kind, kind) {
          break Option::Some(declaration.declaration)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }
}

fn self_host_frozen_kind_equal(
  left: SelfHostFrozenInterfaceDeclarationKind,
  right: SelfHostFrozenInterfaceDeclarationKind,
) -> Bool {
  match left {
    SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration => right is SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration
    SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration => right is SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration
    SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration => right is SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration
  }
}

fn self_host_freeze_declaration_kind(
  kind: SelfHostCollectedDeclKind,
) -> Option<SelfHostFrozenInterfaceDeclarationKind> {
  match kind {
    SelfHostCollectedDeclKind::StructDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
    )
    SelfHostCollectedDeclKind::EnumDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
    )
    SelfHostCollectedDeclKind::TypeAliasDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
    )
    SelfHostCollectedDeclKind::ForeignTypeDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
    )
    SelfHostCollectedDeclKind::TraitDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration,
    )
    SelfHostCollectedDeclKind::BuiltinDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration,
    )
    SelfHostCollectedDeclKind::FunctionDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration,
    )
    SelfHostCollectedDeclKind::LetDecl => Option::Some(
      SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration,
    )
    _ => Option::None
  }
}

fn self_host_alias_semantic_type(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  declaration: U64,
) -> U32 {
  let mut index = 0u32
  while index {
    current => if current < collected.aliases.length() {
      if self_host_u64_equal(
        collected.aliases[current].declaration,
        declaration,
      ) {
        break resolved.alias_target_types[current]
      }
      continue current + 1u32
    } else {
      break resolved.error_type
    }
  }
}

fn self_host_frozen_exported_declaration(
  exported: Map<U64, Bool>,
  declaration: U64,
) -> Bool {
  exported.get(declaration) is Option::Some(_)
}

fn self_host_frozen_impl_trait_declaration(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
) -> Option<U64> {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      SelfHostResolvedType::TraitType(declaration) => break Option::Some(
        declaration,
      )
      SelfHostResolvedType::AppliedType(base, _) => continue base
      _ => break Option::None
    }
  }
}

fn self_host_frozen_impl_target_is_owned(
  resolved: SelfHostResolvedModuleTypes,
  owner: U64,
  root: U32,
) -> Bool {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      SelfHostResolvedType::NominalType(declaration) => break self_host_semantic_modules_share_package(
        owner,
        self_host_semantic_id_module(declaration),
      )
      SelfHostResolvedType::PrimitiveType(_) => break self_host_semantic_module_is_standard_package(
        owner,
      )
      SelfHostResolvedType::AppliedType(base, _) => continue base
      SelfHostResolvedType::ErrorType => break true
      _ => break false
    }
  }
}

fn self_host_frozen_trait_impl_is_owned(
  resolved: SelfHostResolvedModuleTypes,
  owner: U64,
  trait_type: U32,
  target_type: U32,
) -> Bool {
  match self_host_frozen_impl_trait_declaration(resolved, trait_type) {
    Option::Some(declaration) => self_host_semantic_modules_share_package(
      owner,
      self_host_semantic_id_module(declaration),
    ) || self_host_frozen_impl_target_is_owned(resolved, owner, target_type)
    Option::None => true
  }
}

// This recursive check keeps each type index on its U32 source carrier.
// The depth limit rejects malformed recursive interface evidence at compile time.
fn self_host_frozen_impl_type_visible_at(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
  exported: Map<U64, Bool>,
  depth: U32,
) -> Bool {
  if depth >= 1024u32 || root >= resolved.types.length() {
    return false
  }
  match resolved.types[root] {
    SelfHostResolvedType::ErrorType => false
    SelfHostResolvedType::NominalType(declaration) => self_host_semantic_id_module(
      declaration,
    ) != resolved.module_id || self_host_frozen_exported_declaration(
      exported,
      declaration,
    )
    SelfHostResolvedType::TraitType(declaration) => self_host_semantic_id_module(
      declaration,
    ) != resolved.module_id || self_host_frozen_exported_declaration(
      exported,
      declaration,
    )
    SelfHostResolvedType::ProductType(fields) => {
      let mut index = 0u32
      let _ = while index {
        current => if current < fields.length {
          let child = self_host_u32_add(fields.start, current)
          if child >= resolved.type_arguments.length() ||
            !self_host_frozen_impl_type_visible_at(
              resolved,
              resolved.type_arguments[child],
              exported,
              depth + 1u32,
            ) {
            return false
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      true
    }
    SelfHostResolvedType::AppliedType(base, arguments) => {
      if !self_host_frozen_impl_type_visible_at(
        resolved,
        base,
        exported,
        depth + 1u32,
      ) {
        return false
      }
      let mut index = 0u32
      let _ = while index {
        current => if current < arguments.length {
          let child = self_host_u32_add(arguments.start, current)
          if child >= resolved.type_arguments.length() ||
            !self_host_frozen_impl_type_visible_at(
              resolved,
              resolved.type_arguments[child],
              exported,
              depth + 1u32,
            ) {
            return false
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      true
    }
    SelfHostResolvedType::FunctionType(parameters, result) => {
      if !self_host_frozen_impl_type_visible_at(
        resolved,
        result,
        exported,
        depth + 1u32,
      ) {
        return false
      }
      let mut index = 0u32
      let _ = while index {
        current => if current < parameters.length {
          let child = self_host_u32_add(parameters.start, current)
          if child >= resolved.type_arguments.length() ||
            !self_host_frozen_impl_type_visible_at(
              resolved,
              resolved.type_arguments[child],
              exported,
              depth + 1u32,
            ) {
            return false
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      true
    }
    _ => true
  }
}

fn self_host_frozen_impl_type_visible(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
  exported: Map<U64, Bool>,
) -> Bool {
  self_host_frozen_impl_type_visible_at(resolved, root, exported, 0u32)
}

fn self_host_frozen_callable_kind(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> SelfHostFrozenInterfaceCallableKind {
  match collected.declaration_reference(declaration) {
    Option::Some(reference) => match reference {
      SelfHostCollectedDeclarationReference::Method(method) => match method.kind {
        SelfHostCollectedMethodKind::TraitMethodDecl => SelfHostFrozenInterfaceCallableKind::FrozenTraitCallable(
          method.parent,
        )
        SelfHostCollectedMethodKind::ImplMethodDecl => SelfHostFrozenInterfaceCallableKind::FrozenImplCallable(
          method.parent,
        )
        SelfHostCollectedMethodKind::ForeignLibraryMemberDecl => SelfHostFrozenInterfaceCallableKind::FrozenFunctionCallable
      }
      SelfHostCollectedDeclarationReference::TopLevel(declaration_info) => {
        let mut index = 0u32
        let mut builtin_name = Option::None
        let _ = while index {
          current => if current < collected.builtins.length() {
            let candidate = collected.builtins[current]
            if self_host_u64_equal(candidate.declaration, declaration_info.id) {
              builtin_name = Option::Some(candidate.builtin_name)
              break self_host_semantic_unit()
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        match builtin_name {
          Option::Some(name) => SelfHostFrozenInterfaceCallableKind::FrozenBuiltinCallable(
            name,
          )
          Option::None => SelfHostFrozenInterfaceCallableKind::FrozenFunctionCallable
        }
      }
    }
    Option::None => SelfHostFrozenInterfaceCallableKind::FrozenFunctionCallable
  }
}

fn self_host_frozen_declaration_location(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> U32 {
  if self_host_semantic_id_module(declaration) != collected.module_id {
    return 4294967295u32
  }
  let local = self_host_semantic_id_local(declaration)
  if local >= collected.declaration_locations.length() {
    4294967295u32
  } else {
    collected.declaration_locations[local]
  }
}

fn self_host_frozen_callable_name(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> String {
  let location = self_host_frozen_declaration_location(collected, declaration)
  if location < 2147483648u32 {
    if location < collected.declarations.length() {
      collected.name(collected.declaration_at(location).name)
    } else {
      ""
    }
  } else {
    let method_index = location & 2147483647u32
    if method_index < collected.methods.length() {
      collected.name(collected.method_at(method_index).name)
    } else {
      ""
    }
  }
}

fn self_host_frozen_declaration_offset(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> U32 {
  let location = self_host_frozen_declaration_location(collected, declaration)
  if location < 2147483648u32 {
    if location < collected.declarations.length() {
      collected.declaration_at(location).offset
    } else {
      0u32
    }
  } else {
    let method_index = location & 2147483647u32
    if method_index < collected.methods.length() {
      collected.method_at(method_index).offset
    } else {
      0u32
    }
  }
}

fn self_host_frozen_callable_exported(
  collected: SelfHostCollectedModule,
  declaration: U64,
  exported_declarations: Map<U64, Bool>,
  exported_implementations: Map<U64, Bool>,
) -> Bool {
  if collected.declaration_is_test_only(declaration) ||
    self_host_semantic_id_module(declaration) != collected.module_id {
    return false
  }
  let local = self_host_semantic_id_local(declaration)
  if local >= collected.declaration_locations.length() {
    return false
  }
  let location = collected.declaration_locations[local]
  if location < 2147483648u32 {
    if location >= collected.declarations.length() {
      false
    } else {
      let value = collected.declaration_at(location)
      self_host_frozen_exported_declaration(
        exported_declarations,
        value.id,
      )
    }
  } else {
    let method_index = location & 2147483647u32
    if method_index >= collected.methods.length() {
      false
    } else {
      let method = collected.method_at(method_index)
      match method.kind {
        SelfHostCollectedMethodKind::TraitMethodDecl => self_host_frozen_exported_declaration(
          exported_declarations,
          method.parent,
        )
        SelfHostCollectedMethodKind::ImplMethodDecl => self_host_frozen_exported_declaration(
          exported_implementations,
          method.parent,
        )
        SelfHostCollectedMethodKind::ForeignLibraryMemberDecl => method.visibility is SelfHostSemanticVisibility::Public
      }
    }
  }
}

fn self_host_freeze_module_signature_interface(
  path: String,
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
) -> SelfHostFrozenModuleInterface {
  let declarations = []
  let exported_declarations = self_host_empty_u64_bool_map()
  let mut declaration_index = 0u32
  let _ = while declaration_index {
    current => if current < collected.declarations.length() {
      let declaration = self_host_collected_declaration_identity(
        collected.declarations[current],
      )
    if declaration.visibility is SelfHostSemanticVisibility::Public &&
      !collected.declaration_is_test_only(declaration.id) &&
      !self_host_u32_equal(declaration.name, 4294967295u32) {
      match self_host_freeze_declaration_kind(declaration.kind) {
        Option::Some(kind) => {
          let semantic_type = if declaration.kind is SelfHostCollectedDeclKind::TypeAliasDecl {
            self_host_alias_semantic_type(collected, resolved, declaration.id)
          } else {
            resolved.declaration_type(declaration.id)
          }
          exported_declarations.set(declaration.id, true)
          declarations.push(SelfHostFrozenInterfaceDeclaration::{
            declaration: declaration.id
            name: collected.name(declaration.name)
            kind: kind
            source_kind: declaration.kind
            generic_parameter_count: collected.generic_parameters_of(
              declaration.id,
            ).length
            generic_parameters: collected.generic_parameters_of(declaration.id)
            semantic_type: semantic_type
            location: SelfHostSourceLocation::{
              file: collected.declaration_files[
                self_host_semantic_id_local(declaration.id)
              ]
              offset: declaration.offset
            }
          })
        }
        Option::None => {}
      }
    }
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut method_index = 0u32
  let _ = while method_index {
    current => if current < collected.methods.length() {
      let method = self_host_collected_method_identity(collected.methods[current])
    if method.kind is SelfHostCollectedMethodKind::ForeignLibraryMemberDecl &&
      method.visibility is SelfHostSemanticVisibility::Public &&
      !collected.declaration_is_test_only(method.id) &&
      !self_host_u32_equal(method.name, 4294967295u32) {
      declarations.push(SelfHostFrozenInterfaceDeclaration::{
        declaration: method.id
        name: collected.name(method.name)
        kind: SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration
        source_kind: SelfHostCollectedDeclKind::FunctionDecl
        generic_parameter_count: collected.generic_parameters_of(method.id).length
        generic_parameters: collected.generic_parameters_of(method.id)
        semantic_type: resolved.declaration_type(method.id)
        location: SelfHostSourceLocation::{
          file: collected.declaration_files[self_host_semantic_id_local(method.id)]
          offset: method.offset
        }
      })
    }
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let fields = []
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < collected.fields.length() {
      let field = self_host_collected_field_identity(collected.fields[current])
      if self_host_frozen_exported_declaration(
        exported_declarations,
        field.declaration,
      ) {
        fields.push(SelfHostFrozenInterfaceField::{
          field: field.id
          declaration: field.declaration
          variant: field.variant
          mutable_: field.mutable_
          name: collected.name(field.name)
          type_: resolved.field_types[current]
          location: SelfHostSourceLocation::{
            file: collected.declaration_files[
              self_host_semantic_id_local(field.declaration)
            ]
            offset: field.offset
          }
        })
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let variants = []
  let variant_payload_types = []
  let mut variant_index = 0u32
  let _ = while variant_index {
    current_variant => if current_variant < collected.variants.length() {
      let variant = self_host_collected_variant_identity(
        collected.variants[current_variant],
      )
      if self_host_frozen_exported_declaration(
        exported_declarations,
        variant.declaration,
      ) {
        let payload_start = variant_payload_types.length()
        let source_payload = resolved.variant_payloads[current_variant]
      let mut payload_index = 0u32
      let _ = while payload_index {
        current => if current < source_payload.length {
          variant_payload_types.push(
            resolved.signature_type_lists[
              self_host_u32_add(source_payload.start, current)
            ],
          )
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
        variants.push(SelfHostFrozenInterfaceVariant::{
          variant: variant.id
          declaration: variant.declaration
          kind: variant.kind
          name: collected.name(variant.name)
          payload_types: SelfHostHirSpan::{
            start: payload_start
            length: variant_payload_types.length() - payload_start
          }
          location: SelfHostSourceLocation::{
            file: collected.declaration_files[
              self_host_semantic_id_local(variant.declaration)
            ]
            offset: variant.offset
          }
        })
      }
      continue current_variant + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let exported_implementations = self_host_empty_u64_bool_map()
  let mut implementation_index = 0u32
  let mut implementation_export_index = 0u32
  let _ = while implementation_export_index {
    current => if current < collected.impls.length() {
      let implementation = self_host_collected_impl_identity(
        collected.impls[current],
      )
    if !implementation.foreign_ &&
      !collected.declaration_is_test_only(implementation.declaration) &&
      self_host_frozen_impl_type_visible(
        resolved,
        resolved.impl_target_types[implementation_index],
        exported_declarations,
      ) {
      let trait_visible = match resolved.impl_trait_types[implementation_index] {
        Option::Some(type_) => self_host_frozen_impl_type_visible(
          resolved,
          type_,
          exported_declarations,
        )
        Option::None => true
      }
      let package_owned = match resolved.impl_trait_types[implementation_index] {
        Option::Some(type_) => self_host_frozen_trait_impl_is_owned(
          resolved,
          collected.module_id,
          type_,
          resolved.impl_target_types[implementation_index],
        )
        Option::None => true
      }
      if trait_visible && package_owned {
        exported_implementations.set(implementation.declaration, true)
      }
    }
    implementation_index = implementation_index + 1u32
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let generic_parameter_bounds = []
  let mut generic_parameter_index = 0u32
  let _ = while generic_parameter_index {
    current => if current < collected.generic_parameters.length() {
      let parameter = self_host_collected_generic_parameter_identity(
        collected.generic_parameters[current],
      )
    generic_parameter_bounds.push(parameter.bounds)
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let parameters = []
  let callables = []
  let mut callable_index = 0u32
  let _ = while callable_index {
    current => if current < collected.callables.length() {
      let callable = self_host_collected_callable_identity(
        collected.callables[current],
      )
    if self_host_frozen_callable_exported(
      collected,
      callable.declaration,
      exported_declarations,
      exported_implementations,
    ) {
      let source_parameters = collected.parameters_of(callable.declaration)
      let parameter_start = parameters.length()
      let mut parameter_offset = 0u32
      let _ = while parameter_offset {
        current => if current < source_parameters.length {
          let parameter_index = self_host_u32_add(
            source_parameters.start,
            current,
          )
          let parameter = self_host_collected_parameter_identity(
            collected.parameters[parameter_index],
          )
          parameters.push(SelfHostFrozenInterfaceParameter::{
            parameter: parameter.id
            name: collected.name(parameter.name)
            type_: resolved.parameter_types[parameter_index]
            receiver: parameter.kind is SelfHostCollectedParameterKind::ReceiverParameterDecl
            location: SelfHostSourceLocation::{
              file: collected.declaration_files[
                self_host_semantic_id_local(parameter.declaration)
              ]
              offset: parameter.offset
            }
          })
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let callable_name = self_host_frozen_callable_name(
        collected,
        callable.declaration,
      )
      let callable_offset = self_host_frozen_declaration_offset(
        collected,
        callable.declaration,
      )
      callables.push(SelfHostFrozenInterfaceCallable::{
        declaration: callable.declaration
        name: callable_name
        kind: self_host_frozen_callable_kind(collected, callable.declaration)
        generic_parameters: collected.generic_parameters_of(callable.declaration)
        parameters: SelfHostHirSpan::{
          start: parameter_start
          length: parameters.length() - parameter_start
        }
        result_type: resolved.callable_return_types[callable_index]
        function_type: resolved.callable_function_types[callable_index]
        location: SelfHostSourceLocation::{
          file: collected.declaration_files[
            self_host_semantic_id_local(callable.declaration)
          ]
          offset: callable_offset
        }
      })
    }
    callable_index = callable_index + 1u32
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let implementations = []
  implementation_index = 0u32
  let mut implementation_freeze_index = 0u32
  let _ = while implementation_freeze_index {
    current => if current < collected.impls.length() {
      let implementation = self_host_collected_impl_identity(
        collected.impls[current],
      )
    if self_host_frozen_exported_declaration(
      exported_implementations,
      implementation.declaration,
    ) {
      let implementation_offset = self_host_frozen_declaration_offset(
        collected,
        implementation.declaration,
      )
      implementations.push(SelfHostFrozenInterfaceImplementation::{
        declaration: implementation.declaration
        generic_parameters: collected.generic_parameters_of(
          implementation.declaration,
        )
        trait_type: resolved.impl_trait_types[implementation_index]
        target_type: resolved.impl_target_types[implementation_index]
        location: SelfHostSourceLocation::{
          file: collected.declaration_files[
            self_host_semantic_id_local(implementation.declaration)
          ]
          offset: implementation_offset
        }
      })
    }
    implementation_index = implementation_index + 1u32
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostFrozenModuleInterface::{
    module_id: collected.module_id
    path: path
    resolved_types: resolved
    generic_parameter_bounds: generic_parameter_bounds
    declarations: declarations
    fields: fields
    variants: variants
    variant_payload_types: variant_payload_types
    callables: callables
    parameters: parameters
    implementations: implementations
  }
}

pub enum SelfHostImportScopeDiagnostic {
  UnavailableImportedInterface(U64, String, U64, U32)
  DuplicateImportedAlias(U64, String, U64, U32)
  AmbiguousImportedType(U64, String, U64, U64)
  AmbiguousImportedTrait(U64, String, U64, U64)
  AmbiguousImportedValue(U64, String, U64, U64)
}

pub struct SelfHostImportedDeclarationBinding {
  declaration: U64
  source_kind: SelfHostCollectedDeclKind
  generic_parameter_count: U32
  generic_parameters: SelfHostHirSpan
  interface_index: U32
  semantic_type: U32
}

pub struct SelfHostModuleImportScope {
  module_id: U64
  module_paths: Array<String>
  declarations: Array<SelfHostImportedDeclarationBinding>
  declaration_bindings: Map<U64, U32>
  imported_interfaces: Array<U32>
  type_bindings: Map<String, U32>
  trait_bindings: Map<String, U32>
  value_bindings: Map<String, U32>
  alias_bindings: Map<String, U32>
  interfaces: SelfHostFrozenInterfaceList
  diagnostics: Array<SelfHostImportScopeDiagnostic>
}

fn self_host_empty_u64_u32_map() -> Map<U64, U32> {
  Map::empty()
}

fn self_host_empty_u64_bool_map() -> Map<U64, Bool> {
  Map::empty()
}

fn self_host_empty_string_u32_map() -> Map<String, U32> {
  Map::empty()
}

fn self_host_interface_resolved_types(
  interfaces: SelfHostFrozenInterfaceList,
  interface_index: U32,
) -> SelfHostResolvedModuleTypes {
  interfaces.at(interface_index).resolved_types
}

fn self_host_interface_slot_declaration_count(
  interfaces: SelfHostFrozenInterfaceList,
  interface_index: U32,
) -> U32 {
  interfaces.at(interface_index).declaration_count()
}

fn self_host_interface_slot_declaration(
  interfaces: SelfHostFrozenInterfaceList,
  interface_index: U32,
  declaration_index: U32,
) -> SelfHostFrozenInterfaceDeclaration {
  interfaces.at(interface_index).declaration_at(declaration_index)
}

impl SelfHostModuleImportScope {
  fn lookup_alias(self, name: String) -> Option<U32> {
    match self.alias_bindings.get(name) {
      Option::Some(value) => if value < 4294967294u32 {
        Option::Some(value)
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }

  fn lookup_type(
    self,
    name: String,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    match self.type_bindings.get(name) {
      Option::Some(index) => if index < 4294967294u32 {
        Option::Some(self.declarations[index])
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }

  fn lookup_trait(
    self,
    name: String,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    match self.trait_bindings.get(name) {
      Option::Some(index) => if index < 4294967294u32 {
        Option::Some(self.declarations[index])
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }

  fn lookup_opened_value(self, name: String) -> Option<U64> {
    match self.value_bindings.get(name) {
      Option::Some(index) => if index < 4294967294u32 {
        Option::Some(self.declarations[index].declaration)
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }

  fn opened_value_is_ambiguous(self, name: String) -> Bool {
    match self.value_bindings.get(name) {
      Option::Some(index) => index == 4294967294u32
      Option::None => false
    }
  }

  fn type_is_ambiguous(self, name: String) -> Bool {
    match self.type_bindings.get(name) {
      Option::Some(index) => index == 4294967294u32
      Option::None => false
    }
  }

  fn trait_is_ambiguous(self, name: String) -> Bool {
    match self.trait_bindings.get(name) {
      Option::Some(index) => index == 4294967294u32
      Option::None => false
    }
  }

  fn binding_for_declaration(
    self,
    declaration: U64,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    match self.declaration_bindings.get(declaration) {
      Option::Some(index) => Option::Some(self.declarations[index])
      Option::None => Option::None
    }
  }

  fn lookup_module_declaration(
    self,
    interface_index: U32,
    name: String,
    kind: SelfHostFrozenInterfaceDeclarationKind,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    if interface_index >= self.interfaces.length() {
      Option::None
    } else {
      let mut index = 0u32
      let count = self_host_interface_slot_declaration_count(
        self.interfaces,
        interface_index,
      )
      while index {
        current => if current < count {
          let declaration = self_host_interface_slot_declaration(
            self.interfaces,
            interface_index,
            current,
          )
          if self_host_interface_string_equal(declaration.name, name) &&
            self_host_frozen_kind_equal(declaration.kind, kind) {
            break self.binding_for_declaration(declaration.declaration)
          }
          continue current + 1u32
        } else {
          break Option::None
        }
      }
    }
  }

  fn lookup_module_type(
    self,
    interface_index: U32,
    name: String,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    self.lookup_module_declaration(
      interface_index,
      name,
      SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
    )
  }

  fn lookup_module_trait(
    self,
    interface_index: U32,
    name: String,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    self.lookup_module_declaration(
      interface_index,
      name,
      SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration,
    )
  }

  fn lookup_module_value(
    self,
    interface_index: U32,
    name: String,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    self.lookup_module_declaration(
      interface_index,
      name,
      SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration,
    )
  }
}

struct SelfHostImportScopeBuilder {
  module_id: U64
  declarations: Array<SelfHostImportedDeclarationBinding>
  declaration_bindings: Map<U64, U32>
  imported_interfaces: Array<U32>
  type_bindings: Map<String, U32>
  trait_bindings: Map<String, U32>
  value_bindings: Map<String, U32>
  alias_bindings: Map<String, U32>
  interfaces: SelfHostFrozenInterfaceList
  diagnostics: Array<SelfHostImportScopeDiagnostic>
  imported: Array<Bool>
  opened: Array<Bool>
}

impl SelfHostImportScopeBuilder {
  fn new(
    module_id: U64,
    module_paths: Array<String>,
    interfaces: SelfHostFrozenInterfaceList,
  ) -> SelfHostImportScopeBuilder {
    SelfHostImportScopeBuilder::{
      module_id: module_id
      declarations: []
      declaration_bindings: self_host_empty_u64_u32_map()
      imported_interfaces: []
      type_bindings: self_host_empty_string_u32_map()
      trait_bindings: self_host_empty_string_u32_map()
      value_bindings: self_host_empty_string_u32_map()
      alias_bindings: self_host_empty_string_u32_map()
      interfaces: interfaces
      diagnostics: []
      imported: self_host_bool_slots(module_paths.length(), false)
      opened: self_host_bool_slots(module_paths.length(), false)
    }
  }

  fn register_declaration(
    self,
    interface_index: U32,
    declaration: SelfHostFrozenInterfaceDeclaration,
  ) -> U32 {
    match self.declaration_bindings.get(declaration.declaration) {
      Option::Some(index) => index
      Option::None => {
        let index = self.declarations.length()
        let binding = SelfHostImportedDeclarationBinding::{
          declaration: declaration.declaration
          source_kind: declaration.source_kind
          generic_parameter_count: declaration.generic_parameter_count
          generic_parameters: declaration.generic_parameters
          interface_index: interface_index
          semantic_type: declaration.semantic_type
        }
        self.declarations.push(binding)
        self.declaration_bindings.set(declaration.declaration, index)
        index
      }
    }
  }

  fn expose_declaration(
    self,
    interface_index: U32,
    declaration: SelfHostFrozenInterfaceDeclaration,
  ) -> Unit {
    let previous_binding = if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration {
      self.trait_bindings.get(declaration.name)
    } else if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration {
      self.type_bindings.get(declaration.name)
    } else {
      self.value_bindings.get(declaration.name)
    }
    let index = self.register_declaration(interface_index, declaration)
    match previous_binding {
      Option::None => if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration {
        self.trait_bindings.set(declaration.name, index)
      } else if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration {
        self.type_bindings.set(declaration.name, index)
      } else {
        self.value_bindings.set(declaration.name, index)
      }
      Option::Some(previous_index) => if previous_index < 4294967294u32 {
        let previous = self.declarations[previous_index]
        if !self_host_u64_equal(
          previous.declaration,
          declaration.declaration,
        ) {
          let same_interface_overload = declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenValueDeclaration && previous.source_kind is SelfHostCollectedDeclKind::FunctionDecl && declaration.source_kind is SelfHostCollectedDeclKind::FunctionDecl && self_host_u32_equal(
            previous.interface_index,
            interface_index,
          )
          if same_interface_overload {
            return
          }
          if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration {
            self.trait_bindings.set(declaration.name, 4294967294u32)
          } else if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration {
            self.type_bindings.set(declaration.name, 4294967294u32)
          } else {
            self.value_bindings.set(declaration.name, 4294967294u32)
          }
          if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTraitDeclaration {
            self.diagnostics.push(
              SelfHostImportScopeDiagnostic::AmbiguousImportedTrait(
                self.module_id,
                declaration.name,
                previous.declaration,
                declaration.declaration,
              ),
            )
          } else if declaration.kind is SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration {
            self.diagnostics.push(
              SelfHostImportScopeDiagnostic::AmbiguousImportedType(
                self.module_id,
                declaration.name,
                previous.declaration,
                declaration.declaration,
              ),
            )
          } else {
            self.diagnostics.push(
              SelfHostImportScopeDiagnostic::AmbiguousImportedValue(
                self.module_id,
                declaration.name,
                previous.declaration,
                declaration.declaration,
              ),
            )
          }
        }
      }
    }
  }

  fn import_interface(
    self,
    interface_index: U32,
    open_names: Bool,
  ) -> Unit {
    if !self.imported[interface_index] {
      self.imported[interface_index] = true
      self.imported_interfaces.push(interface_index)
      let mut index = 0u32
      let count = self_host_interface_slot_declaration_count(
        self.interfaces,
        interface_index,
      )
      let _ = while index {
        current => if current < count {
          let declaration = self_host_interface_slot_declaration(
            self.interfaces,
            interface_index,
            current,
          )
          let _ = self.register_declaration(interface_index, declaration)
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    if open_names && !self.opened[interface_index] {
      self.opened[interface_index] = true
      let mut index = 0u32
      let count = self_host_interface_slot_declaration_count(
        self.interfaces,
        interface_index,
      )
      let _ = while index {
        current => if current < count {
          let declaration = self_host_interface_slot_declaration(
            self.interfaces,
            interface_index,
            current,
          )
          self.expose_declaration(interface_index, declaration)
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }

  fn add_alias(
    self,
    alias: String,
    dependency: U32,
    file: U64,
    offset: U32,
  ) -> Unit {
    match self.alias_bindings.get(alias) {
      Option::None => self.alias_bindings.set(alias, dependency)
      Option::Some(previous) => if previous != dependency {
        self.alias_bindings.set(alias, 4294967295u32)
        self.diagnostics.push(
          SelfHostImportScopeDiagnostic::DuplicateImportedAlias(
            self.module_id,
            alias,
            file,
            offset,
          ),
        )
      }
    }
  }

  fn finish(
    self,
    module_paths: Array<String>,
  ) -> SelfHostModuleImportScope {
    SelfHostModuleImportScope::{
      module_id: self.module_id
      module_paths: module_paths
      declarations: self.declarations
      declaration_bindings: self.declaration_bindings
      imported_interfaces: self.imported_interfaces
      type_bindings: self.type_bindings
      trait_bindings: self.trait_bindings
      value_bindings: self.value_bindings
      alias_bindings: self.alias_bindings
      interfaces: self.interfaces
      diagnostics: self.diagnostics
    }
  }
}

fn self_host_wildcard_import_matches(
  prefix: String,
  candidate: String,
) -> Bool {
  candidate.starts_with(prefix.concat("."))
}

fn self_host_build_module_import_scope(
  collected: SelfHostCollectedModule,
  module_index: U32,
  module_paths: Array<String>,
  interfaces: SelfHostFrozenInterfaceList,
) -> SelfHostModuleImportScope {
  let builder = SelfHostImportScopeBuilder::new(
    collected.module_id,
    module_paths,
    interfaces,
  )
  let mut import_index = 0u32
  let _ = while import_index {
    current_import => if current_import < collected.imports.length() {
      let import_ = self_host_collected_import_identity(
        collected.imports[current_import],
      )
      if import_.wildcard {
        let mut dependency = 0u32
        let _ = while dependency {
          current => if current < module_paths.length() {
            if current != module_index && self_host_wildcard_import_matches(
              import_.path,
              module_paths[current],
            ) {
              builder.import_interface(current, true)
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      } else {
        let import_path = import_.path
        let dependency = self_host_module_path_index(
          module_paths,
          import_.path,
        )
        if dependency < module_paths.length() {
          match import_.import_alias {
            Option::Some(alias) => builder.add_alias(
              alias,
              dependency,
              import_.file,
              import_.import_alias_offset,
            )
            Option::None => {}
          }
          builder.import_interface(dependency, import_.open_)
        } else {
          builder.diagnostics.push(
            SelfHostImportScopeDiagnostic::UnavailableImportedInterface(
              collected.module_id,
              import_path,
              import_.file,
              import_.offset,
            ),
          )
        }
      }
      continue current_import + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.finish(module_paths)
}

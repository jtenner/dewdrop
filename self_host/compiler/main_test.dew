open dew.std.testing

test "compiler fingerprint comparison accepts equal bytes and rejects differences" {
  let expected = FixedArray::make(32u32, 0u8)
  expected.set_unchecked(31u32, 4u8)
  assert(
    self_host_fingerprint_matches(
      expected,
      b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04",
    ),
    "equal fingerprint rejected",
  )
  assert(
    !self_host_fingerprint_matches(
      expected,
      b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x05",
    ),
    "different fingerprint accepted",
  )
  assert(
    !self_host_fingerprint_matches(expected, b"\x00"),
    "short fingerprint accepted",
  )
}

fn self_host_initializer_link_fixture() -> SelfHostPlannedProgramWasmGCLink {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"let answer = 42i64\npub fn main() -> I64 {\n  answer\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid global initializer source")
  assert(link.initializers.length() == 1u32, "one linked initializer")
  assert(self_host_validate_program_wasmgc_link(link) is Option::None, "valid link before mutation")
  link
}

fn self_host_initializer_link_mutation(kind: U32) -> Unit {
  let link = self_host_initializer_link_fixture()
  let original = link.initializers[0u32]
  link.initializers[0u32] = SelfHostPlannedProgramInitializer::{
    module_index: if kind == 0u32 {
      99u32
    } else {
      original.module_index
    }
    declaration: if kind == 1u32 {
      original.declaration + 1u64
    } else {
      original.declaration
    }
    body: if kind == 2u32 {
      original.body + 1u64
    } else {
      original.body
    }
    shape: if kind == 3u32 {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    } else if kind == 4u32 {
      SelfHostPlannedValueShape::I32PlannedValueShape
    } else if kind == 8u32 {
      SelfHostPlannedValueShape::GenericPlannedValueShape
    } else {
      original.shape
    }
    test_only: if kind == 5u32 {
      !original.test_only
    } else {
      original.test_only
    }
    global_index: if kind == 6u32 {
      original.global_index + 1u32
    } else {
      original.global_index
    }
    order: if kind == 7u32 {
      original.order + 1u32
    } else {
      original.order
    }
  }
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "LNK-504 initializer module matches its source step" expect_trap "unreachable" {
  self_host_initializer_link_mutation(0u32)
}

test "LNK-504 initializer declaration matches its source step" expect_trap "unreachable" {
  self_host_initializer_link_mutation(1u32)
}

test "ARN-106 initializer body matches its source step" expect_trap "unreachable" {
  self_host_initializer_link_mutation(2u32)
}

test "SPC-301 initializer shape cannot contain an error" expect_trap "unreachable" {
  self_host_initializer_link_mutation(3u32)
}

test "ABI-709 initializer shape matches its source type" expect_trap "unreachable" {
  self_host_initializer_link_mutation(4u32)
}

test "ARN-106 initializer test role matches its source step" expect_trap "unreachable" {
  self_host_initializer_link_mutation(5u32)
}

test "LNK-502 initializer global index matches its table slot" expect_trap "unreachable" {
  self_host_initializer_link_mutation(6u32)
}

test "LNK-502 initializer order matches its source schedule" expect_trap "unreachable" {
  self_host_initializer_link_mutation(7u32)
}

test "ARN-103 initializer table cannot lose a global" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let _ = link.initializers.pop()
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "ARN-103 initializer table cannot duplicate a global" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  link.initializers.push(link.initializers[0u32])
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "SPC-301 initializer shape cannot remain generic" expect_trap "unreachable" {
  self_host_initializer_link_mutation(8u32)
}

test "BOD-610 initializer body must be present" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.bodies[0u32].body == link.initializers[0u32].body, "first body initializes the global")
  let _ = module_.bodies.remove(0u32)
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "LNK-502 initializer links cannot outlive their source steps" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  link.fragments.specialization.lowering.modules[0u32].initialization.steps.clear()
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "LNK-502 every selected source initializer must have a link" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let steps = link.fragments.specialization.lowering.modules[0u32].initialization.steps
  steps.push(steps[0u32])
  let _ = self_host_validate_program_wasmgc_link(link)
}

test "initializer links retain test inclusion and Unit source values" {
  let manifest = SelfHostProgramManifest::{
    modules: [
    SelfHostManifestModule::{
      path: "app.initializers"
      files: [
        SelfHostManifestFile::{
          path: "main.dew"
          source: b"let effect = ()\nlet answer = 42i64\npub fn main() -> I64 {\n  answer\n}\n"
          test_only: false
        },
        SelfHostManifestFile::{
          path: "extra_test.dew"
          source: b"let extra = 7i64\n"
          test_only: true
        },
      ]
    },
    ]
  }
  let lowering = self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(
    self_host_collect_program_manifest(5100u64, manifest)))
  let fragments = self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, true))
  let normal = self_host_plan_program_wasmgc_link(fragments, false)
  let testing = self_host_plan_program_wasmgc_link(fragments, true)
  assert(normal.initializers.length() == 2u32 && !normal.emit_tests, "normal Unit and scalar globals")
  assert(testing.initializers.length() == 3u32 && testing.emit_tests, "test global explicitly included")
  assert(self_host_validate_program_wasmgc_link(normal) is Option::None, "normal source schedule is complete")
  assert(self_host_validate_program_wasmgc_link(testing) is Option::None, "test source schedule is complete")
  match build_self_host_linked_i32_module(normal, 5100u64) {
    Result::Ok(bytes) => assert(bytes.byte_length() > 0u32, "Unit and scalar initializers emit valid Wasm")
    Result::Err(error) => assert(false, error)
  }
}

test "initializer function handles retain both compiler index offsets" {
  let link = self_host_initializer_link_fixture()
  let initializer = link.initializers[0u32]
  assert(self_host_initializer_function_index(5100u64, initializer, 7u32, 3u32) == 10u32, "logical function slot before two reserved handles")
  assert(self_host_initializer_function_index(5100u64, initializer, 4294967292u32, 0u32) == 4294967292u32, "last nonsentinel handle is representable")
}

test "LNK-502 initializer function handles cannot reach the missing sentinel" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let _ = self_host_initializer_function_index(5100u64, link.initializers[0u32], 4294967293u32, 0u32)
}

test "LNK-502 initializer function handle addition cannot wrap" expect_trap "unreachable" {
  let link = self_host_initializer_link_fixture()
  let _ = self_host_initializer_function_index(5100u64, link.initializers[0u32], 4294967295u32, 1u32)
}

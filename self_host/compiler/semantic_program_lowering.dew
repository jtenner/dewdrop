open dew.std.array
open dew.std.option
open dew.std.string_builder

fn self_host_program_collected_module_at(
  collected: SelfHostCollectedProgram,
  index: U32,
) -> SelfHostCollectedModule {
  collected.modules.at(index)
}

fn self_host_program_bool_at(values: Array<Bool>, index: U32) -> Bool {
  array_get_unchecked(values, index)
}

fn self_host_program_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_program_planned_module_at(
  values: Array<SelfHostPlannedModuleLowering>,
  index: U32,
) -> SelfHostPlannedModuleLowering {
  array_get_unchecked(values, index)
}

fn self_host_program_u32_set(
  values: Array<U32>,
  index: U32,
  value: U32,
) -> Unit {
  array_set_unchecked(values, index, value)
}

fn self_host_program_bool_set(
  values: Array<Bool>,
  index: U32,
  value: Bool,
) -> Unit {
  array_set_unchecked(values, index, value)
}

pub struct SelfHostProgramLoweringIndex {
  module_ids: Array<U64>
}

impl SelfHostProgramLoweringIndex {
  fn module_index(self, module_id: U64) -> Option<U32> {
    if self_host_u32_greater(self.module_ids.length(), 0u32) {
      let base = self.module_ids[0u32]
      if module_id >= base {
        let relative = module_id - base
        if relative <= 4294967295u64 {
          let direct = u64_into_u32(relative)
          if direct < self.module_ids.length() && self_host_u64_equal(
            self.module_ids[direct],
            module_id,
          ) {
            return Option::Some(direct)
          }
        }
      }
    }
    let mut index = 0u32
    while index {
      current => if current < self.module_ids.length() {
        if self_host_u64_equal(self.module_ids[current], module_id) {
          break Option::Some(current)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn declaration_owner(self, declaration: U64) -> Option<U32> {
    self.module_index(self_host_semantic_id_module(declaration))
  }

  fn body_owner(self, body: U64) -> Option<U32> {
    self.module_index(self_host_semantic_id_module(body))
  }
}

pub struct SelfHostProgramModuleGraph {
  dependencies: Array<SelfHostHirSpan>
  dependency_modules: Array<U32>
  sccs: Array<SelfHostHirSpan>
  scc_modules: Array<U32>
  module_scc: Array<U32>
}

pub struct SelfHostPlannedProgramLowering {
  raw_arrays: SelfHostRawArrayContracts
  collected: SelfHostCollectedProgram
  modules: Array<SelfHostPlannedModuleLowering>
  index: SelfHostProgramLoweringIndex
  graph: SelfHostProgramModuleGraph
  elided_trait_wrappers: Array<U64>
  compile_time: SelfHostCompileTimeProgramContext
}

fn self_host_program_imported_interface_count(
  scope: SelfHostModuleImportScope,
) -> U32 {
  scope.imported_interfaces.length()
}

fn self_host_program_imported_interface(
  scope: SelfHostModuleImportScope,
  index: U32,
) -> U32 {
  scope.imported_interfaces[index]
}

fn self_host_program_module_dependencies(
  frozen: SelfHostFrozenSignatureProgram,
) -> (Array<SelfHostHirSpan>, Array<U32>) {
  let spans = []
  let values = []
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < frozen.collected.modules.length() {
      let scope = frozen.import_scopes.at(current)
      let imported_count = self_host_program_imported_interface_count(scope)
      let start = values.length()
      let mut candidate = 0u32
      let _ = while candidate {
        dependency => if dependency < frozen.collected.modules.length() {
          let mut present = false
          let mut imported_index = 0u32
          let _ = while imported_index {
            imported => if imported < imported_count {
              if self_host_u32_equal(
                self_host_program_imported_interface(scope, imported),
                dependency,
              ) {
                present = true
              }
              continue imported + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if present && !self_host_u32_equal(dependency, current) {
            values.push(dependency)
          }
          continue dependency + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      spans.push(SelfHostHirSpan::{
        start: start
        length: values.length() - start
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  (spans, values)
}

fn self_host_program_module_sccs(
  dependencies: Array<SelfHostHirSpan>,
  dependency_modules: Array<U32>,
) -> (Array<SelfHostHirSpan>, Array<U32>, Array<U32>) {
  let module_count = dependencies.length()
  if self_host_u32_equal(module_count, 0u32) {
    return ([], [], [])
  }
  let visited = self_host_bool_slots(module_count, false)
  let work_nodes = self_host_u32_slots(0u32, 0u32)
  let work_finish = self_host_bool_slots(0u32, false)
  let finish_order = self_host_u32_slots(0u32, 0u32)
  let mut start = 0u32
  let _ = while start {
    current_start => if current_start < module_count {
      if !self_host_program_bool_at(visited, current_start) {
        work_nodes.push(current_start)
        work_finish.push(false)
        let _ = while work_nodes.length() {
          length => if self_host_u32_greater(length, 0u32) {
            let item_index = length - 1u32
            let item = self_host_program_u32_at(work_nodes, item_index)
            work_nodes.truncate(item_index)
            let finish_index = work_finish.length() - 1u32
            let finishing = self_host_program_bool_at(
              work_finish,
              finish_index,
            )
            work_finish.truncate(finish_index)
            if finishing {
              finish_order.push(item)
            } else if !self_host_program_bool_at(visited, item) {
              self_host_program_bool_set(visited, item, true)
              work_nodes.push(item)
              work_finish.push(true)
              let edges = dependencies[item]
              let mut edge = edges.length
              let _ = while edge {
                remaining => if self_host_u32_greater(remaining, 0u32) {
                  let next = remaining - 1u32
                  let dependency = self_host_program_u32_at(
                    dependency_modules,
                    self_host_u32_add(edges.start, next),
                  )
                  if !self_host_program_bool_at(visited, dependency) {
                    work_nodes.push(dependency)
                    work_finish.push(false)
                  }
                  continue next
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            continue work_nodes.length()
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_start + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }

  let reverse_counts = self_host_u32_slots(module_count, 0u32)
  let mut source = 0u32
  let _ = while source {
    current_source => if current_source < module_count {
      let edges = dependencies[current_source]
      let mut edge = 0u32
      let _ = while edge {
        current_edge => if current_edge < edges.length {
          let dependency = self_host_program_u32_at(
            dependency_modules,
            self_host_u32_add(edges.start, current_edge),
          )
          self_host_program_u32_set(
            reverse_counts,
            dependency,
            self_host_program_u32_at(reverse_counts, dependency) + 1u32,
          )
          continue current_edge + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_source + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let reverse_offsets = self_host_u32_slots(module_count + 1u32, 0u32)
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < module_count {
      self_host_program_u32_set(
        reverse_offsets,
        current + 1u32,
        self_host_program_u32_at(reverse_offsets, current) +
          self_host_program_u32_at(reverse_counts, current),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let reverse_cursor = self_host_u32_slots(module_count, 0u32)
  module_index = 0u32
  let _ = while module_index {
    current => if current < module_count {
      self_host_program_u32_set(
        reverse_cursor,
        current,
        self_host_program_u32_at(reverse_offsets, current),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let reverse_edges = self_host_u32_slots(
    self_host_program_u32_at(reverse_offsets, module_count),
    0u32,
  )
  source = 0u32
  let _ = while source {
    current_source => if current_source < module_count {
      let edges = dependencies[current_source]
      let mut edge = 0u32
      let _ = while edge {
        current_edge => if current_edge < edges.length {
          let dependency = self_host_program_u32_at(
            dependency_modules,
            self_host_u32_add(edges.start, current_edge),
          )
          let destination = self_host_program_u32_at(
            reverse_cursor,
            dependency,
          )
          self_host_program_u32_set(
            reverse_edges,
            destination,
            current_source,
          )
          self_host_program_u32_set(
            reverse_cursor,
            dependency,
            destination + 1u32,
          )
          continue current_edge + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_source + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }

  let assigned = self_host_bool_slots(module_count, false)
  let raw_component_of = self_host_u32_slots(
    module_count,
    4294967295u32,
  )
  let raw_sizes = self_host_u32_slots(0u32, 0u32)
  let mut order_index = finish_order.length()
  let _ = while order_index {
    remaining => if self_host_u32_greater(remaining, 0u32) {
      let next = remaining - 1u32
      let component_start = self_host_program_u32_at(finish_order, next)
      if !self_host_program_bool_at(assigned, component_start) {
        let raw_component = raw_sizes.length()
        let mut component_size = 0u32
        work_nodes.clear()
        work_nodes.push(component_start)
        self_host_program_bool_set(assigned, component_start, true)
        let _ = while work_nodes.length() {
          length => if self_host_u32_greater(length, 0u32) {
            let item_index = length - 1u32
            let module_ = self_host_program_u32_at(work_nodes, item_index)
            work_nodes.truncate(item_index)
            self_host_program_u32_set(
              raw_component_of,
              module_,
              raw_component,
            )
            component_size = component_size + 1u32
            let edge_start = self_host_program_u32_at(
              reverse_offsets,
              module_,
            )
            let edge_end = self_host_program_u32_at(
              reverse_offsets,
              module_ + 1u32,
            )
            let mut edge = edge_start
            let _ = while edge {
              current_edge => if current_edge < edge_end {
                let dependent = self_host_program_u32_at(
                  reverse_edges,
                  current_edge,
                )
                if !self_host_program_bool_at(assigned, dependent) {
                  self_host_program_bool_set(assigned, dependent, true)
                  work_nodes.push(dependent)
                }
                continue current_edge + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            continue work_nodes.length()
          } else {
            break self_host_semantic_unit()
          }
        }
        raw_sizes.push(component_size)
      }
      continue next
    } else {
      break self_host_semantic_unit()
    }
  }

  let sccs = []
  let component_cursor = self_host_u32_slots(raw_sizes.length(), 0u32)
  let mut component = 0u32
  let mut member_start = 0u32
  let _ = while component {
    ordered_component => if ordered_component < raw_sizes.length() {
      let raw_component = raw_sizes.length() - ordered_component - 1u32
      let component_size = self_host_program_u32_at(
        raw_sizes,
        raw_component,
      )
      sccs.push(SelfHostHirSpan::{
        start: member_start
        length: component_size
      })
      self_host_program_u32_set(
        component_cursor,
        ordered_component,
        member_start,
      )
      member_start = member_start + component_size
      continue ordered_component + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let scc_modules = self_host_u32_slots(module_count, 0u32)
  let module_scc = self_host_u32_slots(module_count, 0u32)
  module_index = 0u32
  let _ = while module_index {
    current => if current < module_count {
      let raw_component = self_host_program_u32_at(raw_component_of, current)
      let ordered_component = raw_sizes.length() - raw_component - 1u32
      let destination = self_host_program_u32_at(
        component_cursor,
        ordered_component,
      )
      self_host_program_u32_set(scc_modules, destination, current)
      self_host_program_u32_set(module_scc, current, ordered_component)
      self_host_program_u32_set(
        component_cursor,
        ordered_component,
        destination + 1u32,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  (sccs, scc_modules, module_scc)
}

fn self_host_plan_program_module_graph(
  frozen: SelfHostFrozenSignatureProgram,
) -> SelfHostProgramModuleGraph {
  let (dependencies, dependency_modules) = self_host_program_module_dependencies(
    frozen,
  )
  let (sccs, scc_modules, module_scc) = self_host_program_module_sccs(
    dependencies,
    dependency_modules,
  )
  SelfHostProgramModuleGraph::{
    dependencies: dependencies
    dependency_modules: dependency_modules
    sccs: sccs
    scc_modules: scc_modules
    module_scc: module_scc
  }
}

fn self_host_infer_program_module_bodies(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  names: SelfHostResolvedModuleNames,
) -> SelfHostBasicInferredModuleBodies {
  self_host_infer_basic_module_bodies_with_imports(
    collected,
    imports.resolved,
    names,
    imports.scope,
    imports.callables,
    imports.generic_parameter_ids,
    imports.parameter_types,
    imports.parameter_receivers,
    imports.implementations,
    imports.fields,
    imports.variants,
    imports.variant_payload_types,
    imports.type_declaration_types,
    imports.type_generic_spans,
    imports.module_value_types,
    imports,
  )
}

fn self_host_infer_program_module_values(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  names: SelfHostResolvedModuleNames,
) -> SelfHostInferredModuleValues {
  self_host_infer_module_values_with_imports(
    collected,
    imports.resolved,
    names,
    imports.callables,
    imports.generic_parameter_ids,
    imports.parameter_types,
    imports.parameter_receivers,
    imports.implementations,
    imports.fields,
    imports.variants,
    imports.variant_payload_types,
    imports.type_declaration_types,
    imports.type_generic_spans,
    imports.module_value_types,
  )
}

fn self_host_program_lowering_reference_name(
  reference: SelfHostBodyNameReference,
) -> String {
  match reference {
    SelfHostBodyNameReference::NoNameReference => "none"
    SelfHostBodyNameReference::ErrorNameReference => "error"
    SelfHostBodyNameReference::LocalNameReference(_) => "local"
    SelfHostBodyNameReference::LambdaCaptureNameReference(_) => "capture"
    SelfHostBodyNameReference::ModuleValueNameReference(_) => "module-value"
    SelfHostBodyNameReference::ImportedModuleValueNameReference(_) => "imported-value"
    SelfHostBodyNameReference::ImportedModuleNameReference(_) => "imported-module"
    SelfHostBodyNameReference::ForeignLibraryNameReference(_) => "foreign-library"
    SelfHostBodyNameReference::PrimitiveTypeNameReference(_) => "primitive-type"
    SelfHostBodyNameReference::ModuleTypeNameReference(_) => "module-type"
    SelfHostBodyNameReference::ModuleTraitNameReference(_) => "module-trait"
    SelfHostBodyNameReference::VariantNameReference(_) => "variant"
  }
}

fn self_host_program_type_diagnostic_text(
  collected: SelfHostCollectedModule,
  diagnostic: SelfHostTypeDiagnostic,
) -> String {
  let message = StringBuilder::new()
  match diagnostic {
    SelfHostTypeDiagnostic::ReservedTypeName(_, name, offset) => {
      message.append("reserved-type name=")
      message.append(collected.name(name))
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::UnknownType(name, owner, offset) => {
      message.append("unknown-type name=")
      message.append(collected.name(name))
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::UnknownTrait(name, owner, offset) => {
      message.append("unknown-trait name=")
      message.append(collected.name(name))
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::AmbiguousImportedType(name, owner, offset) => {
      message.append("ambiguous-imported-type name=")
      message.append(collected.name(name))
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::AmbiguousImportedTrait(name, owner, offset) => {
      message.append("ambiguous-imported-trait name=")
      message.append(collected.name(name))
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::ExpectedTraitType(_, owner, offset) => {
      message.append("expected-trait owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::TypeArityMismatch(_, expected, actual, owner, offset) => {
      message.append("type-arity expected=")
      message.append_u32(expected)
      message.append(" actual=")
      message.append_u32(actual)
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::TypeNotApplicable(_, owner, offset) => {
      message.append("type-not-applicable owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::SelfOutsideContext(owner, offset) => {
      message.append("self-outside-context owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::AliasCycle(_, offset) => {
      message.append("alias-cycle offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::AliasExpansionLimit(owner, work, offset) => {
      message.append("alias-expansion-limit owner=")
      message.append_u64(owner)
      message.append(" work=")
      message.append_u32(work)
      message.append(" offset=")
      message.append_u32(offset)
    }
    SelfHostTypeDiagnostic::ComputedTypeFailure(owner, detail, offset) => {
      message.append(detail)
      message.append(" owner=")
      message.append_u64(owner)
      message.append(" offset=")
      message.append_u32(offset)
    }
  }
  message.finish()
}

fn self_host_program_lowering_name_at(
  module_: SelfHostPlannedModuleLowering,
  name: U32,
) -> String {
  if name < module_.names.length() {
    module_.names[name]
  } else {
    ""
  }
}

fn self_host_program_lowering_expression_error(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  context: String,
) -> String {
  let planned = module_.expressions[expression]
  let message = StringBuilder::new()
  message.append("program lowering ")
  message.append(context)
  message.append(" module=")
  message.append_u64(module_.module_id)
  message.append(" declaration=")
  message.append_u64(body.declaration)
  message.append(" body=")
  message.append_u64(body.body)
  message.append(" expression=")
  message.append_u32(expression)
  message.append(" type=")
  message.append_i32(planned.type_)
  message.append(" nominal=")
  message.append_u64(planned.nominal)
  message.append(" reference=")
  message.append(self_host_program_lowering_reference_name(planned.reference))
  message.append(" source_name=")
  message.append(self_host_program_lowering_name_at(module_, planned.source_name))
  message.append(" offset=")
  message.append_u32(planned.offset)
  message.append(" locals=")
  let mut local_offset = 0u32
  let _ = while local_offset {
    current => if current < body.locals.length && current < 8u32 {
      let index = self_host_u32_add(body.locals.start, current)
      if index < module_.locals.length() {
        let local = module_.locals[index]
        if self_host_u32_greater(current, 0u32) {
          message.append(",")
        }
        message.append_u32(local.local_id)
        message.append(":")
        message.append_u32(local.offset)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  message.append(" items=")
  match body.root {
    SelfHostHirBodyRoot::BlockBodyRoot(block) => if block < module_.blocks.length() {
      let items = module_.blocks[block].items
      let mut item_offset = 0u32
      let _ = while item_offset {
        current => if current < items.length && current < 12u32 {
          let item_index = self_host_u32_add(items.start, current)
          if item_index < module_.block_items.length() {
            if self_host_u32_greater(current, 0u32) {
              message.append(",")
            }
            match module_.block_items[item_index].kind {
              SelfHostPlannedBlockItemKind::PlannedLetItem(local, _, value) => {
                message.append("let:")
                message.append_u32(local)
                message.append(":")
                message.append_u32(value)
              }
              SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => {
                message.append("expression:")
                message.append_u32(value)
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    _ => {}
  }
  message.finish()
}

// This gate stops invalid body lowering before specialization can recover or hide it.
fn self_host_validate_program_lowering(
  lowering: SelfHostPlannedProgramLowering,
) -> Option<String> {
  match self_host_raw_array_contract_error(lowering.raw_arrays) {
    Option::Some(error) => return Option::Some(error)
    Option::None => {}
  }
  if lowering.compile_time.diagnostics.length() > 0u32 {
    return Option::Some(lowering.compile_time.diagnostics[0u32])
  }
  match self_host_validate_collected_program_storage(lowering.collected) {
    Option::Some(error) => {
      let message = StringBuilder::new()
      message.append("program lowering changed collected storage: ")
      message.append(error)
      return Option::Some(message.finish())
    }
    Option::None => {}
  }
  let mut module_index = 0u32
  let _ = while module_index {
    current_module => if current_module < lowering.modules.length() {
      let module_ = lowering.modules[current_module]
      let callable_lookup_length = module_.functions.callable_by_declaration.length()
      let callable_lookup_backing = self_host_u32_array_backing_length(
        module_.functions.callable_by_declaration,
      )
      if self_host_u32_greater(
        callable_lookup_length,
        callable_lookup_backing,
      ) {
        let message = StringBuilder::new()
        message.append("program lowering callable lookup backing is shorter than its logical length module=")
        message.append_u64(module_.module_id)
        message.append(" length=")
        message.append_u32(callable_lookup_length)
        message.append(" backing=")
        message.append_u32(callable_lookup_backing)
        return Option::Some(message.finish())
      }
      let callable_length = module_.functions.callables.length()
      let callable_backing = self_host_callable_array_backing_length(
        module_.functions.callables,
      )
      if self_host_u32_greater(callable_length, callable_backing) {
        let message = StringBuilder::new()
        message.append("program lowering callable backing is shorter than its logical length module=")
        message.append_u64(module_.module_id)
        message.append(" length=")
        message.append_u32(callable_length)
        message.append(" backing=")
        message.append_u32(callable_backing)
        return Option::Some(message.finish())
      }
      let exact_resolved = self_host_resolved_module_types_identity(
        module_.resolved_types,
      )
      let mut callable_index = 0u32
      let _ = while callable_index {
        current_callable => if current_callable < callable_length {
          let callable = self_host_planned_callable_identity(
            module_.functions.callables[current_callable],
          )
          let mut parameter_offset = 0u32
          let _ = while parameter_offset {
            current_parameter => if current_parameter < callable.parameters.length {
              let parameter_index = self_host_u32_add(
                callable.parameters.start,
                current_parameter,
              )
              if parameter_index >= module_.functions.parameters.length() {
                let message = StringBuilder::new()
                message.append("program lowering callable parameter is outside its arena module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(callable.declaration)
                message.append(" parameter=")
                message.append_u32(current_parameter)
                message.append(" index=")
                message.append_u32(parameter_index)
                message.append(" arena=")
                message.append_u32(module_.functions.parameters.length())
                return Option::Some(message.finish())
              }
              let parameter = self_host_planned_parameter_identity(
                module_.functions.parameters[parameter_index],
              )
              if !self_host_u64_equal(
                parameter.declaration,
                callable.declaration,
              ) {
                let message = StringBuilder::new()
                message.append("program lowering callable parameter has the wrong owner module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(callable.declaration)
                message.append(" parameter=")
                message.append_u32(current_parameter)
                message.append(" index=")
                message.append_u32(parameter_index)
                message.append(" owner=")
                message.append_u64(parameter.declaration)
                message.append(" type=")
                message.append_u32(parameter.type_)
                return Option::Some(message.finish())
              }
              if !self_host_u32_greater(
                exact_resolved.types.length(),
                parameter.type_,
              ) {
                let message = StringBuilder::new()
                message.append("program lowering callable parameter type is outside its arena module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(callable.declaration)
                message.append(" name=")
                message.append(bytes_to_string(callable.name))
                message.append(" parameter=")
                message.append_u32(current_parameter)
                message.append(" index=")
                message.append_u32(parameter_index)
                message.append(" source_parameter=")
                message.append_u64(parameter.parameter)
                message.append(" type=")
                message.append_u32(parameter.type_)
                message.append(" error_type=")
                message.append_u32(exact_resolved.error_type)
                message.append(" type_count=")
                message.append_u32(exact_resolved.types.length())
                return Option::Some(message.finish())
              }
              if exact_resolved.types[parameter.type_] is SelfHostResolvedType::ErrorType {
                let message = StringBuilder::new()
                message.append("program lowering callable parameter resolved to error module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(callable.declaration)
                message.append(" name=")
                message.append(bytes_to_string(callable.name))
                message.append(" parameter=")
                message.append_u32(current_parameter)
                message.append(" source_parameter=")
                message.append_u64(parameter.parameter)
                message.append(" planned_type=")
                message.append_u32(parameter.type_)
                let collected_module = self_host_program_collected_module_at(
                  lowering.collected,
                  current_module,
                )
                let mut source_index = 0u32
                let _ = while source_index {
                  source => if source < collected_module.parameters.length() {
                    let source_parameter = self_host_collected_parameter_identity(
                      collected_module.parameters[source],
                    )
                    if self_host_u64_equal(source_parameter.id, parameter.parameter) {
                      message.append(" source_type_syntax=")
                      message.append_u32(source_parameter.type_)
                      if source_parameter.type_ < collected_module.type_syntax.length() {
                        match collected_module.type_syntax[source_parameter.type_] {
                          SelfHostHirTypeSyntax::NamedTypeSyntax(name, _) => {
                            message.append(":named:")
                            message.append(collected_module.name(name))
                          }
                          SelfHostHirTypeSyntax::QualifiedTypeSyntax(_, name, _, _) => {
                            message.append(":qualified:")
                            message.append(collected_module.name(name))
                          }
                          SelfHostHirTypeSyntax::AppliedTypeSyntax(_, arguments, _) => {
                            message.append(":applied:")
                            message.append_u32(arguments.length)
                          }
                          SelfHostHirTypeSyntax::ProductTypeSyntax(fields, _) => {
                            message.append(":product:")
                            message.append_u32(fields.length)
                          }
                          SelfHostHirTypeSyntax::FunctionTypeSyntax(parameters, _, _) => {
                            message.append(":function:")
                            message.append_u32(parameters.length)
                          }
                          SelfHostHirTypeSyntax::ComputedTypeSyntax(target, _, _) => {
                            message.append(":computed:")
                            message.append_u32(target)
                          }
                        }
                      }
                      break self_host_semantic_unit()
                    }
                    continue source + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                message.append(" type_diagnostics=")
                message.append_u32(exact_resolved.diagnostics.length())
                if self_host_u32_greater(exact_resolved.diagnostics.length(), 0u32) {
                  message.append(" first_diagnostic=")
                  message.append(self_host_program_type_diagnostic_text(
                    collected_module,
                    exact_resolved.diagnostics[0u32],
                  ))
                  match exact_resolved.diagnostics[0u32] {
                    SelfHostTypeDiagnostic::UnknownType(name, _, _) => {
                      let spelling = collected_module.name(name)
                      let debug_frozen = self_host_freeze_program_signature_interfaces(
                        lowering.collected,
                      )
                      let scope = debug_frozen.import_scopes.at(current_module)
                      message.append(" scope_lookup=")
                      match scope.lookup_type(spelling) {
                        Option::Some(_) => message.append("found")
                        Option::None => message.append("missing")
                      }
                      message.append(" scope_ambiguous=")
                      if scope.type_is_ambiguous(spelling) {
                        message.append("true")
                      } else {
                        message.append("false")
                      }
                      let imported_count = self_host_program_imported_interface_count(scope)
                      message.append(" imported_interfaces=")
                      message.append_u32(imported_count)
                      let mut imported = 0u32
                      let _ = while imported {
                        current_import => if current_import < imported_count {
                          let interface_index = self_host_program_imported_interface(
                            scope,
                            current_import,
                          )
                          message.append(";")
                          message.append_u32(interface_index)
                          message.append(":")
                          if interface_index < debug_frozen.collected.module_paths.length() {
                            message.append(debug_frozen.collected.module_paths[interface_index])
                          } else {
                            message.append("invalid")
                          }
                          message.append(":declarations=")
                          if interface_index < debug_frozen.interfaces.length() {
                            message.append_u32(
                              self_host_interface_slot_declaration_count(
                                debug_frozen.interfaces,
                                interface_index,
                              ),
                            )
                            message.append(":declares_type=")
                            match scope.lookup_module_type(interface_index, spelling) {
                              Option::Some(_) => message.append("bound")
                              Option::None => match debug_frozen.interfaces.at(
                                interface_index,
                              ).declaration_named(
                                spelling,
                                SelfHostFrozenInterfaceDeclarationKind::FrozenTypeDeclaration,
                              ) {
                                Option::Some(_) => message.append("unbound")
                                Option::None => message.append("missing")
                              }
                            }
                          } else {
                            message.append("invalid")
                          }
                          continue current_import + 1u32
                        } else {
                          break self_host_semantic_unit()
                          }
                      }
                      message.append(" source_imports=")
                      message.append_u32(collected_module.import_count())
                      let mut source_import = 0u32
                      let _ = while source_import {
                        current_import => if current_import < collected_module.import_count() {
                          let import_ = self_host_collected_import_identity(
                            collected_module.import_at(current_import),
                          )
                          message.append(";")
                          message.append(import_.path)
                          message.append(":open=")
                          if import_.open_ {
                            message.append("true")
                          } else {
                            message.append("false")
                          }
                          continue current_import + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                    }
                    _ => {}
                  }
                }
                return Option::Some(message.finish())
              }
              continue current_parameter + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue current_callable + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut callable_local = 0u32
      let _ = while callable_local {
        current_local => if current_local < callable_lookup_length {
          let callable_index = module_.functions.callable_by_declaration[
            current_local
          ]
          if !self_host_u32_equal(callable_index, 4294967295u32) &&
            !self_host_u32_greater(callable_length, callable_index) {
            let message = StringBuilder::new()
            message.append("program lowering callable lookup reaches outside logical callable storage module=")
            message.append_u64(module_.module_id)
            message.append(" local=")
            message.append_u32(current_local)
            message.append(" index=")
            message.append_u32(callable_index)
            message.append(" length=")
            message.append_u32(callable_length)
            return Option::Some(message.finish())
          }
          if !self_host_u32_equal(callable_index, 4294967295u32) &&
            !self_host_u32_greater(callable_backing, callable_index) {
            let message = StringBuilder::new()
            message.append("program lowering callable lookup reaches outside physical callable storage module=")
            message.append_u64(module_.module_id)
            message.append(" local=")
            message.append_u32(current_local)
            message.append(" index=")
            message.append_u32(callable_index)
            message.append(" length=")
            message.append_u32(callable_length)
            message.append(" backing=")
            message.append_u32(callable_backing)
            return Option::Some(message.finish())
          }
          continue current_local + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut object_field_index = 0u32
      let _ = while object_field_index {
        current_field => if current_field < module_.object_fields.length() {
          let field = self_host_planned_object_field_at(
            module_.object_fields,
            current_field,
          )
          if field.value >= module_.expressions.length() {
            let message = StringBuilder::new()
            message.append("program lowering object field value is outside its expression arena module=")
            message.append_u64(module_.module_id)
            message.append(" field_index=")
            message.append_u32(current_field)
            message.append(" field=")
            message.append_u64(field.field)
            message.append(" value=")
            message.append_u32(field.value)
            message.append(" expression_count=")
            message.append_u32(module_.expressions.length())
            message.append(" offset=")
            message.append_u32(field.offset)
            return Option::Some(message.finish())
          }
          continue current_field + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut arm_index = 0u32
      let _ = while arm_index {
        current_arm => if current_arm < module_.pattern_arms.length() {
          let arm = self_host_planned_pattern_arm_at(
            module_.pattern_arms,
            current_arm,
          )
          if arm.pattern >= module_.patterns.length() {
            let message = StringBuilder::new()
            message.append("program lowering pattern arm root is outside its pattern arena module=")
            message.append_u64(module_.module_id)
            message.append(" arm=")
            message.append_u32(current_arm)
            message.append(" pattern=")
            message.append_u32(arm.pattern)
            message.append(" pattern_count=")
            message.append_u32(module_.patterns.length())
            message.append(" offset=")
            message.append_u32(arm.offset)
            return Option::Some(message.finish())
          }
          if arm.body >= module_.expressions.length() {
            let message = StringBuilder::new()
            message.append("program lowering pattern arm body is outside its expression arena module=")
            message.append_u64(module_.module_id)
            message.append(" arm=")
            message.append_u32(current_arm)
            message.append(" body=")
            message.append_u32(arm.body)
            message.append(" expression_count=")
            message.append_u32(module_.expressions.length())
            message.append(" offset=")
            message.append_u32(arm.offset)
            return Option::Some(message.finish())
          }
          if !self_host_u32_equal(arm.guard_condition, 4294967295u32) &&
            arm.guard_condition >= module_.expressions.length() {
            let message = StringBuilder::new()
            message.append("program lowering pattern arm guard is outside its expression arena module=")
            message.append_u64(module_.module_id)
            message.append(" arm=")
            message.append_u32(current_arm)
            message.append(" guard=")
            message.append_u32(arm.guard_condition)
            message.append(" expression_count=")
            message.append_u32(module_.expressions.length())
            message.append(" offset=")
            message.append_u32(arm.offset)
            return Option::Some(message.finish())
          }
          continue current_arm + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut body_index = 0u32
      let _ = while body_index {
        current_body => if current_body < module_.bodies.length() {
          let body = module_.bodies[current_body]
          let mut block_offset = 0u32
          let _ = while block_offset {
            current_block => if current_block < body.blocks.length {
              let block_index = self_host_u32_add(
                body.blocks.start,
                current_block,
              )
              if block_index >= module_.blocks.length() {
                return Option::Some("program lowering body block is outside its arena")
              }
              let items = module_.blocks[block_index].items
              let mut item_offset = 0u32
              let _ = while item_offset {
                current_item => if current_item < items.length {
                  let item_index = self_host_u32_add(items.start, current_item)
                  if item_index >= module_.block_items.length() {
                    return Option::Some("program lowering block item is outside its arena")
                  }
                  match module_.block_items[item_index].kind {
                    SelfHostPlannedBlockItemKind::PlannedLetItem(
                      local,
                      _,
                      _,
                    ) => if self_host_u32_equal(local, 4294967295u32) ||
                      local >= body.locals.length {
                      // Every let item must have one local before lowering starts.
                      let message = StringBuilder::new()
                      message.append("program lowering let item has no resolved local module=")
                      message.append_u64(module_.module_id)
                      message.append(" declaration=")
                      message.append_u64(body.declaration)
                      message.append(" body=")
                      message.append_u64(body.body)
                      message.append(" block=")
                      message.append_u32(block_index)
                      message.append(" item=")
                      message.append_u32(item_index)
                      message.append(" local=")
                      message.append_u32(local)
                      message.append(" local_count=")
                      message.append_u32(body.locals.length)
                      message.append(" offset=")
                      message.append_u32(module_.block_items[item_index].offset)
                      return Option::Some(message.finish())
                    }
                    _ => {}
                  }
                  continue current_item + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              continue current_block + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          let expression_end = self_host_u32_add(
            body.expressions.start,
            body.expressions.length,
          )
          if body.expressions.start > module_.expressions.length() ||
            expression_end > module_.expressions.length() ||
            expression_end < body.expressions.start {
            let message = StringBuilder::new()
            message.append("program lowering body expression span is outside its arena module=")
            message.append_u64(module_.module_id)
            message.append(" declaration=")
            message.append_u64(body.declaration)
            message.append(" body=")
            message.append_u64(body.body)
            message.append(" start=")
            message.append_u32(body.expressions.start)
            message.append(" length=")
            message.append_u32(body.expressions.length)
            message.append(" arena=")
            message.append_u32(module_.expressions.length())
            return Option::Some(message.finish())
          }
          let mut expression = body.expressions.start
          let _ = while expression {
            current_expression => if current_expression < expression_end {
              let planned = self_host_planned_expression_at(
                module_.expressions,
                current_expression,
              )
              match planned.kind {
                SelfHostPlannedExpressionKind::PlannedPoisonExpression => match planned.reference {
                  SelfHostBodyNameReference::LocalNameReference(_) => return Option::Some(
                    self_host_program_lowering_expression_error(
                      module_,
                      body,
                      current_expression,
                      "lost a local value",
                    ),
                  )
                  SelfHostBodyNameReference::LambdaCaptureNameReference(_) => return Option::Some(
                    self_host_program_lowering_expression_error(
                      module_,
                      body,
                      current_expression,
                      "lost a captured value",
                    ),
                  )
                  _ => if !self_host_u64_equal(planned.nominal, 0u64) {
                    return Option::Some(
                      self_host_program_lowering_expression_error(
                        module_,
                        body,
                        current_expression,
                        "has a typed poison value",
                      ),
                    )
                  }
                }
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                  receiver,
                  _,
                ) => if receiver >= module_.expressions.length() {
                  return Option::Some(
                    self_host_program_lowering_expression_error(
                      module_,
                      body,
                      current_expression,
                      "has a field receiver outside its arena",
                    ),
                  )
                } else if self_host_planned_expression_at(
                  module_.expressions,
                  receiver,
                ).kind is SelfHostPlannedExpressionKind::PlannedPoisonExpression {
                  let namespace_receiver = self_host_body_name_reference_is_namespace(
                    self_host_planned_expression_at(
                      module_.expressions,
                      receiver,
                    ).reference,
                  )
                  if !namespace_receiver {
                    return Option::Some(
                      self_host_program_lowering_expression_error(
                        module_,
                        body,
                        receiver,
                        "has a poison runtime method receiver",
                      ),
                    )
                  }
                }
                _ => {}
              }
              continue current_expression + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue current_body + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

// This gate checks physical collection storage before interface freezing reads it.
fn self_host_validate_collected_program_storage(
  collected_program: SelfHostCollectedProgram,
) -> Option<String> {
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < collected_program.modules.length() {
      let collected = self_host_program_collected_module_at(
        collected_program,
        current,
      )
      let location_length = collected.declaration_locations.length()
      let location_capacity = collected.declaration_locations.capacity()
      let location_backing = if self_host_u32_equal(location_length, 0u32) {
        0u32
      } else {
        self_host_u32_array_backing_length(collected.declaration_locations)
      }
      if self_host_u32_greater(location_length, location_backing) {
        let message = StringBuilder::new()
        message.append("collected declaration location backing is shorter than its logical length module=")
        message.append_u64(collected.module_id)
        message.append(" length=")
        message.append_u32(location_length)
        message.append(" capacity=")
        message.append_u32(location_capacity)
        message.append(" backing=")
        message.append_u32(location_backing)
        message.append(" declarations=")
        message.append_u32(collected.declarations.length())
        message.append(" methods=")
        message.append_u32(collected.methods.length())
        return Option::Some(message.finish())
      }
      let declaration_length = collected.declarations.length()
      let declaration_capacity = collected.declarations.capacity()
      let declaration_backing = if self_host_u32_equal(
        declaration_length,
        0u32,
      ) {
        0u32
      } else {
        self_host_declaration_array_backing_length(collected.declarations)
      }
      if self_host_u32_greater(declaration_length, declaration_backing) {
        let message = StringBuilder::new()
        message.append("collected declaration backing is shorter than its logical length module=")
        message.append_u64(collected.module_id)
        message.append(" length=")
        message.append_u32(declaration_length)
        message.append(" capacity=")
        message.append_u32(declaration_capacity)
        message.append(" backing=")
        message.append_u32(declaration_backing)
        return Option::Some(message.finish())
      }
      let method_length = collected.methods.length()
      let method_capacity = collected.methods.capacity()
      let method_backing = if self_host_u32_equal(method_length, 0u32) {
        0u32
      } else {
        self_host_method_array_backing_length(collected.methods)
      }
      if self_host_u32_greater(method_length, method_backing) {
        let message = StringBuilder::new()
        message.append("collected method backing is shorter than its logical length module=")
        message.append_u64(collected.module_id)
        message.append(" length=")
        message.append_u32(method_length)
        message.append(" capacity=")
        message.append_u32(method_capacity)
        message.append(" backing=")
        message.append_u32(method_backing)
        return Option::Some(message.finish())
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

// This gate checks collected body arenas before name resolution consumes them.
fn self_host_validate_collected_program_bodies(
  frozen: SelfHostFrozenSignatureProgram,
) -> Option<String> {
  let mut module_index = 0u32
  let _ = while module_index {
    current_module => if current_module < frozen.collected.modules.length() {
      let collected = self_host_program_collected_module_at(
        frozen.collected,
        current_module,
      )
      let declaration_count = self_host_u32_add(
        collected.declarations.length(),
        collected.methods.length(),
      )
      if !self_host_u32_equal(
        collected.declaration_locations.length(),
        declaration_count,
      ) {
        let message = StringBuilder::new()
        message.append("collected declaration location arena length mismatch module=")
        message.append_u64(collected.module_id)
        message.append(" locations=")
        message.append_u32(collected.declaration_locations.length())
        message.append(" declarations=")
        message.append_u32(collected.declarations.length())
        message.append(" methods=")
        message.append_u32(collected.methods.length())
        return Option::Some(message.finish())
      }
      let mut declaration_index = 0u32
      let _ = while declaration_index {
        current => if current < collected.declarations.length() {
          let declaration = collected.declarations[current]
          let local = self_host_semantic_id_local(declaration.id)
          if !self_host_u32_greater(
            collected.declaration_locations.length(),
            local,
          ) || !self_host_u32_equal(
            collected.declaration_locations[local],
            current,
          ) {
            let message = StringBuilder::new()
            message.append("collected declaration location does not map to its owner module=")
            message.append_u64(collected.module_id)
            message.append(" index=")
            message.append_u32(current)
            message.append(" local=")
            message.append_u32(local)
            message.append(" declaration=")
            message.append_u64(declaration.id)
            return Option::Some(message.finish())
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut method_index = 0u32
      let _ = while method_index {
        current => if current < collected.methods.length() {
          let method = collected.methods[current]
          let local = self_host_semantic_id_local(method.id)
          let expected = 2147483648u32 | current
          if !self_host_u32_greater(
            collected.declaration_locations.length(),
            local,
          ) || !self_host_u32_equal(
            collected.declaration_locations[local],
            expected,
          ) {
            let message = StringBuilder::new()
            message.append("collected method location does not map to its owner module=")
            message.append_u64(collected.module_id)
            message.append(" index=")
            message.append_u32(current)
            message.append(" local=")
            message.append_u32(local)
            message.append(" expected=")
            message.append_u32(expected)
            message.append(" method=")
            message.append_u64(method.id)
            return Option::Some(message.finish())
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut body_index = 0u32
      let _ = while body_index {
        current_body => if current_body < collected.bodies.length() {
          let body = collected.bodies[current_body]
          let expression_end = self_host_u32_add(
            body.expressions.start,
            body.expressions.length,
          )
          let block_end = self_host_u32_add(body.blocks.start, body.blocks.length)
          let item_end = self_host_u32_add(
            body.block_items.start,
            body.block_items.length,
          )
          if self_host_u32_greater(
            body.blocks.start,
            collected.blocks.length(),
          ) || self_host_u32_greater(
            block_end,
            collected.blocks.length(),
          ) || self_host_u32_greater(body.blocks.start, block_end) ||
            self_host_u32_greater(
              body.block_items.start,
              collected.block_items.length(),
            ) || self_host_u32_greater(
              item_end,
              collected.block_items.length(),
            ) || self_host_u32_greater(body.block_items.start, item_end) {
            let message = StringBuilder::new()
            message.append("collected body arena span is invalid module=")
            message.append_u64(collected.module_id)
            message.append(" declaration=")
            message.append_u64(body.declaration)
            message.append(" body=")
            message.append_u64(body.id)
            message.append(" block_start=")
            message.append_u32(body.blocks.start)
            message.append(" block_length=")
            message.append_u32(body.blocks.length)
            message.append(" block_arena=")
            message.append_u32(collected.blocks.length())
            message.append(" item_start=")
            message.append_u32(body.block_items.start)
            message.append(" item_length=")
            message.append_u32(body.block_items.length)
            message.append(" item_arena=")
            message.append_u32(collected.block_items.length())
            return Option::Some(message.finish())
          }
          match body.root {
            SelfHostHirBodyRoot::BlockBodyRoot(root) => {
              if self_host_u32_greater(body.blocks.start, root) ||
                !self_host_u32_greater(block_end, root) {
                let message = StringBuilder::new()
                message.append("collected block body root is outside its body span module=")
                message.append_u64(collected.module_id)
                message.append(" declaration=")
                message.append_u64(body.declaration)
                message.append(" body=")
                message.append_u64(body.id)
                message.append(" root=")
                message.append_u32(root)
                message.append(" block_start=")
                message.append_u32(body.blocks.start)
                message.append(" block_length=")
                message.append_u32(body.blocks.length)
                return Option::Some(message.finish())
              }
              let mut block = body.blocks.start
              let _ = while block {
                current_block => if current_block < block_end {
                  let items = collected.blocks[current_block].items
                  let block_item_end = self_host_u32_add(
                    items.start,
                    items.length,
                  )
                  if self_host_u32_greater(
                    body.block_items.start,
                    items.start,
                  ) || self_host_u32_greater(block_item_end, item_end) ||
                    self_host_u32_greater(items.start, block_item_end) {
                    let message = StringBuilder::new()
                    message.append("collected block items are outside their body span module=")
                    message.append_u64(collected.module_id)
                    message.append(" declaration=")
                    message.append_u64(body.declaration)
                    message.append(" body=")
                    message.append_u64(body.id)
                    message.append(" block=")
                    message.append_u32(current_block)
                    message.append(" item_start=")
                    message.append_u32(items.start)
                    message.append(" item_length=")
                    message.append_u32(items.length)
                    message.append(" body_item_start=")
                    message.append_u32(body.block_items.start)
                    message.append(" body_item_length=")
                    message.append_u32(body.block_items.length)
                    return Option::Some(message.finish())
                  }
                  let mut item = items.start
                  let _ = while item {
                    current_item => if current_item < block_item_end {
                      let source = collected.block_items[current_item]
                      if self_host_u32_greater(source.kind, 1u32) ||
                        self_host_u32_greater(
                          body.expressions.start,
                          source.value,
                        ) || !self_host_u32_greater(
                          expression_end,
                          source.value,
                        ) || self_host_hir_block_item_is_let(source) && (
                          self_host_u32_equal(source.name, 4294967295u32) ||
                          !self_host_u32_greater(
                            collected.names.length(),
                            source.name,
                          )
                        ) || !self_host_hir_block_item_is_let(source) &&
                        !self_host_u32_equal(
                          source.source_name,
                          4294967295u32,
                        ) && (
                          !self_host_u32_greater(
                            collected.names.length(),
                            source.source_name,
                          ) || !self_host_semantic_string_equals(
                            collected.name(source.source_name),
                            "_",
                          )
                        ) {
                        // Each item must keep one explicit kind and source value.
                        let message = StringBuilder::new()
                        message.append("collected block item contract failed module=")
                        message.append_u64(collected.module_id)
                        message.append(" declaration=")
                        message.append_u64(body.declaration)
                        message.append(" body=")
                        message.append_u64(body.id)
                        message.append(" block=")
                        message.append_u32(current_block)
                        message.append(" item=")
                        message.append_u32(current_item)
                        message.append(" kind=")
                        message.append_u32(source.kind)
                        message.append(" name=")
                        message.append_u32(source.name)
                        message.append(" source_name=")
                        message.append_u32(source.source_name)
                        message.append(" value=")
                        message.append_u32(source.value)
                        message.append(" offset=")
                        message.append_u32(source.offset)
                        return Option::Some(message.finish())
                      }
                      continue current_item + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                  continue current_block + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => {
              if self_host_u32_greater(body.expressions.start, expression) ||
                !self_host_u32_greater(expression_end, expression) {
                let message = StringBuilder::new()
                message.append("collected expression body root is outside its body span module=")
                message.append_u64(collected.module_id)
                message.append(" declaration=")
                message.append_u64(body.declaration)
                message.append(" body=")
                message.append_u64(body.id)
                message.append(" root=")
                message.append_u32(expression)
                message.append(" expression_start=")
                message.append_u32(body.expressions.start)
                message.append(" expression_length=")
                message.append_u32(body.expressions.length)
                return Option::Some(message.finish())
              }
            }
          }
          continue current_body + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_plan_program_lowering(
  frozen: SelfHostFrozenSignatureProgram,
) -> SelfHostPlannedProgramLowering {
  let graph = self_host_plan_program_module_graph(frozen)
  let planned_indices = []
  let planned_modules = []
  let mut scc_index = 0u32
  let _ = while scc_index {
    current_scc => if current_scc < graph.sccs.length() {
      let scc = self_host_hir_span_identity(graph.sccs[current_scc])
      let mut member = 0u32
    let _ = while member {
      current => if current < scc.length {
        let module_index = graph.scc_modules[
          self_host_u32_add(scc.start, current)
        ]
        let collected = frozen.collected.modules.at(module_index)
        let imports = self_host_resolve_module_imports(
          frozen.interfaces.at(module_index).resolved_types,
          frozen.import_scopes.at(module_index),
        )
        let names = self_host_resolve_module_names_with_imports(
          collected,
          imports.scope,
        )
        let module_values = self_host_infer_program_module_values(
          collected,
          imports,
          names,
        )
        let basic = self_host_infer_program_module_bodies(
          collected,
          imports,
          names,
        )
        let planned = self_host_plan_module_lowering_with_imports(
          collected,
          imports.resolved,
          self_host_plan_module_type_layouts(collected, imports.resolved),
          self_host_plan_module_initialization(collected, module_values),
          self_host_plan_module_functions(collected, imports.resolved),
          names,
          imports,
          self_host_merge_module_inference(basic),
          self_host_analyze_basic_module_flows_with_imports(
            collected,
            imports.resolved,
            basic,
            imports.variants,
          ),
        )
        planned_indices.push(module_index)
        planned_modules.push(planned)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
      continue current_scc + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let modules = []
  let module_ids = []
  let mut output_index = 0u32
  while output_index {
    current_output => if current_output < frozen.collected.modules.length() {
      let mut planned_index = 0u32
      while planned_index {
        current_planned => if current_planned < planned_indices.length() {
          if self_host_u32_equal(
            self_host_program_u32_at(planned_indices, current_planned),
            current_output,
          ) {
            let module_ = self_host_program_planned_module_at(
              planned_modules,
              current_planned,
            )
            module_ids.push(module_.module_id)
            modules.push(module_)
            break self_host_semantic_unit()
          }
          continue current_planned + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_output + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result = SelfHostPlannedProgramLowering::{
    raw_arrays: self_host_bind_raw_array_contracts(modules)
    collected: frozen.collected
    modules: modules
    index: SelfHostProgramLoweringIndex::{
      module_ids: module_ids
    }
    graph: graph
    elided_trait_wrappers: []
    compile_time: self_host_compile_time_program_context(frozen, modules)
  }
  self_host_fold_program_compile_time_queries(result)
  result
}

// These compiler-only intrinsics read the physical Wasm Array length.
builtin self_host_u32_array_backing_length(
  value: Array<U32>,
) -> U32 = "dew_array_backing_length_i32"

builtin self_host_declaration_array_backing_length(
  value: Array<SelfHostCollectedDeclaration>,
) -> U32 = "dew_array_backing_length_ref"

builtin self_host_method_array_backing_length(
  value: Array<SelfHostCollectedMethod>,
) -> U32 = "dew_array_backing_length_ref"

builtin self_host_callable_array_backing_length(
  value: Array<SelfHostPlannedCallable>,
) -> U32 = "dew_array_backing_length_ref"

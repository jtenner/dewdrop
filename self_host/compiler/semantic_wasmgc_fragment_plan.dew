open dew.std.option
open dew.std.map
open dew.std.bytes_builder

pub enum SelfHostPlannedWasmValueType {
  WasmI32Value
  WasmI64Value
  WasmF32Value
  WasmF64Value
  WasmV128Value
  WasmNullableEqRefValue
  WasmNullableFuncRefValue
}

pub enum SelfHostPlannedWasmStorageType {
  WasmI32Storage
  WasmI64Storage
  WasmF32Storage
  WasmF64Storage
  WasmV128Storage
  WasmNullableEqRefStorage
  WasmNullableFuncRefStorage
}

pub enum SelfHostPlannedWasmPhysicalTypeKind {
  PlannedWasmStructType(U64)
  PlannedWasmForeignMarkerType(U64)
  PlannedWasmEnumBaseType(U64)
  PlannedWasmEnumMarkerType(U64, U64, U32, U32)
  PlannedWasmEnumSubtypeType(U64, U64, U32)
  PlannedWasmClosureType
  PlannedWasmCaptureCellType(U32, U32)
  PlannedWasmLambdaClosureType(U32, U32)
}

pub struct SelfHostPlannedWasmPhysicalType {
  kind: SelfHostPlannedWasmPhysicalTypeKind
  type_index: U32
  fields: SelfHostHirSpan
  offset: U32
}

pub enum SelfHostPlannedWasmFieldRole {
  WasmStructField(U64)
  WasmVariantPayloadField(U64, U32)
  WasmClosureEntryField
  WasmCaptureCellValueField(U32)
  WasmLambdaCaptureField(U32, U32)
}

pub struct SelfHostPlannedWasmField {
  role: SelfHostPlannedWasmFieldRole
  declaration: U64
  physical_index: U32
  storage: SelfHostPlannedWasmStorageType
  mutable_: Bool
  exact_nominal: Bool
  offset: U32
}

pub enum SelfHostPlannedWasmFunctionKind {
  PlannedWasmImportedFunction(Bytes, Bytes)
  PlannedWasmInlineBuiltinFunction(Bytes)
  PlannedWasmDefinedFunction(U64)
  PlannedWasmDefinedLambdaFunction(U32)
  PlannedWasmSignatureOnlyFunction
}

pub struct SelfHostPlannedWasmFunctionFragment {
  declaration: U64
  kind: SelfHostPlannedWasmFunctionKind
  direct_builtin: Bytes
  parameters: SelfHostHirSpan
  results: SelfHostHirSpan
  specialization: U32
  elided: Bool
  offset: U32
}

fn self_host_planned_wasm_function_fragment_identity(
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> SelfHostPlannedWasmFunctionFragment {
  SelfHostPlannedWasmFunctionFragment::{
    declaration: fragment.declaration
    kind: fragment.kind
    direct_builtin: fragment.direct_builtin
    parameters: fragment.parameters
    results: fragment.results
    specialization: fragment.specialization
    elided: fragment.elided
    offset: fragment.offset
  }
}

pub struct SelfHostPlannedModuleWasmGCFragments {
  module_id: U64
  physical_types: Array<SelfHostPlannedWasmPhysicalType>
  fields: Array<SelfHostPlannedWasmField>
  functions: Array<SelfHostPlannedWasmFunctionFragment>
  function_value_types: Array<SelfHostPlannedWasmValueType>
  type_index_by_declaration: Array<U32>
  function_by_declaration: Array<U32>
  closure_type_index: U32
  capture_cell_type_indices: Array<U32>
  lambda_closure_type_indices: Array<U32>
  lambda_function_indices: Array<U32>
}

pub struct SelfHostPlannedProgramWasmGCFragments {
  specialization: SelfHostProgramSpecializationPlan
  modules: Array<SelfHostPlannedModuleWasmGCFragments>
}

fn self_host_wasmgc_value_type(
  shape: SelfHostPlannedValueShape,
) -> Option<SelfHostPlannedWasmValueType> {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::UnitPlannedValueShape => Option::None
    SelfHostPlannedValueShape::NeverPlannedValueShape => Option::None
    SelfHostPlannedValueShape::I32PlannedValueShape => Option::Some(SelfHostPlannedWasmValueType::WasmI32Value)
    SelfHostPlannedValueShape::I64PlannedValueShape => Option::Some(SelfHostPlannedWasmValueType::WasmI64Value)
    SelfHostPlannedValueShape::F32PlannedValueShape => Option::Some(SelfHostPlannedWasmValueType::WasmF32Value)
    SelfHostPlannedValueShape::F64PlannedValueShape => Option::Some(SelfHostPlannedWasmValueType::WasmF64Value)
    SelfHostPlannedValueShape::V128PlannedValueShape => Option::Some(SelfHostPlannedWasmValueType::WasmV128Value)
    _ => Option::Some(SelfHostPlannedWasmValueType::WasmNullableEqRefValue)
  }
}

fn self_host_wasmgc_storage_type(
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedWasmStorageType {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostPlannedWasmStorageType::WasmI32Storage
    SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostPlannedWasmStorageType::WasmI64Storage
    SelfHostPlannedValueShape::F32PlannedValueShape => SelfHostPlannedWasmStorageType::WasmF32Storage
    SelfHostPlannedValueShape::F64PlannedValueShape => SelfHostPlannedWasmStorageType::WasmF64Storage
    SelfHostPlannedValueShape::V128PlannedValueShape => SelfHostPlannedWasmStorageType::WasmV128Storage
    _ => SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage
  }
}

fn self_host_wasmgc_field_storage_type(
  module_: SelfHostPlannedModuleLowering,
  field: SelfHostPlannedFieldLayout,
) -> SelfHostPlannedWasmStorageType {
  // The declared type is the field carrier proof. Inference must not override it.
  let declared_shape = self_host_planned_resolved_value_shape(
    module_.resolved_types,
    field.type_,
  )
  let shape = if declared_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    field.shape
  } else {
    declared_shape
  }
  self_host_wasmgc_storage_type(shape)
}

fn self_host_wasmgc_payload_storage_type(
  module_: SelfHostPlannedModuleLowering,
  payload: SelfHostHirSpan,
  index: U32,
) -> SelfHostPlannedWasmStorageType {
  let shape = module_.type_layouts.payload_shapes[
    self_host_u32_add(payload.start, index)
  ]
  let declared_shape = self_host_planned_resolved_value_shape(
    module_.resolved_types,
    module_.type_layouts.payload_types[
      self_host_u32_add(payload.start, index)
    ],
  )
  if declared_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    self_host_wasmgc_storage_type(shape)
  } else {
    self_host_wasmgc_storage_type(declared_shape)
  }
}

fn self_host_wasmgc_append_shape(
  output: Array<SelfHostPlannedWasmValueType>,
  shape: SelfHostPlannedValueShape,
) -> Unit {
  match shape {
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => output.push(
      SelfHostPlannedWasmValueType::WasmNullableEqRefValue,
    )
    _ => match self_host_wasmgc_value_type(shape) {
      Option::Some(value) => output.push(value)
      Option::None => {}
    }
  }
}

fn self_host_wasmgc_u32_slots(length: U32) -> Array<U32> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_wasmgc_layout_at(
  values: Array<SelfHostPlannedNominalLayout>,
  index: U32,
) -> SelfHostPlannedNominalLayout {
  array_get_unchecked(values, index)
}

fn self_host_wasmgc_payload_type_at(
  values: Array<U32>,
  index: U32,
) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_wasmgc_payload_exact_nominal(
  module_: SelfHostPlannedModuleLowering,
  payload: SelfHostHirSpan,
  payload_index: U32,
) -> Bool {
  let type_index = self_host_u32_add(payload.start, payload_index)
  if type_index >= module_.type_layouts.payload_types.length() {
    return false
  }
  let resolved_type = self_host_wasmgc_payload_type_at(
    module_.type_layouts.payload_types,
    type_index,
  )
  let runtime_base = match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::PrimitiveType(_) => true
    SelfHostResolvedType::AppliedType(base, _) => match module_.resolved_types.type_at(
      base,
    ) {
      SelfHostResolvedType::PrimitiveType(_) => true
      _ => false
    }
    _ => false
  }
  if runtime_base {
    return false
  }
  let nominal = self_host_linked_resolved_nominal_declaration(
    module_,
    resolved_type,
  )
  if self_host_u64_equal(nominal, 0u64) ||
    !self_host_u64_equal(
      self_host_semantic_id_module(nominal),
      module_.module_id,
    ) {
    return false
  }
  let mut layout_index = 0u32
  while layout_index {
    current => if current < module_.type_layouts.layouts.length() {
      let layout = self_host_wasmgc_layout_at(
        module_.type_layouts.layouts,
        current,
      )
      if self_host_u64_equal(layout.declaration, nominal) {
        return match layout.kind {
          SelfHostPlannedNominalLayoutKind::PlannedStructLayout(fields) =>
            fields.length > 0u32
          SelfHostPlannedNominalLayoutKind::PlannedEnumLayout(_) => true
          SelfHostPlannedNominalLayoutKind::PlannedForeignTypeLayout => false
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_wasmgc_plan_types(
  module_: SelfHostPlannedModuleLowering,
  required: Map<U64, Bool>,
  raw_arrays: Map<U64, Bool>,
  physical_types: Array<SelfHostPlannedWasmPhysicalType>,
  fields: Array<SelfHostPlannedWasmField>,
  type_lookup: Array<U32>,
) -> Unit {
  for layout in module_.type_layouts.layouts {
    if required.contains_key(layout.declaration) && !raw_arrays.contains_key(layout.declaration) {
      self_host_wasmgc_plan_type(module_, layout, physical_types, fields, type_lookup)
    }
  }
}

fn self_host_wasmgc_plan_type(
  module_: SelfHostPlannedModuleLowering,
  layout: SelfHostPlannedNominalLayout,
  physical_types: Array<SelfHostPlannedWasmPhysicalType>,
  fields: Array<SelfHostPlannedWasmField>,
  type_lookup: Array<U32>,
) -> Unit {
  let type_index = physical_types.length()
  type_lookup[self_host_semantic_id_local(layout.declaration)] = type_index
  match layout.kind {
    SelfHostPlannedNominalLayoutKind::PlannedStructLayout(field_span) => {
      let start = fields.length()
      let mut field = 0u32
      let _ = while field {
        current => if current < field_span.length {
          let source = self_host_planned_field_layout_at(
            module_.type_layouts.fields,
            self_host_u32_add(field_span.start, current),
          )
          fields.push(SelfHostPlannedWasmField::{
            role: SelfHostPlannedWasmFieldRole::WasmStructField(source.field)
            declaration: source.field
            physical_index: current
            storage: match self_host_specialization_canonical_scalar(
              self_host_planned_resolved_value_shape(
                module_.resolved_types,
                source.type_,
              ),
            ) {
              SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostPlannedWasmStorageType::WasmI32Storage
              SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostPlannedWasmStorageType::WasmI64Storage
              SelfHostPlannedValueShape::F32PlannedValueShape => SelfHostPlannedWasmStorageType::WasmF32Storage
              SelfHostPlannedValueShape::F64PlannedValueShape => SelfHostPlannedWasmStorageType::WasmF64Storage
              SelfHostPlannedValueShape::V128PlannedValueShape => SelfHostPlannedWasmStorageType::WasmV128Storage
              _ => SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage
            }
            mutable_: source.mutable_
            exact_nominal: false
            offset: source.offset
          })
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      physical_types.push(SelfHostPlannedWasmPhysicalType::{
        kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(layout.declaration)
        type_index: type_index
        fields: SelfHostHirSpan::{
          start: start
          length: fields.length() - start
        }
        offset: layout.offset
      })
    }
    SelfHostPlannedNominalLayoutKind::PlannedForeignTypeLayout => physical_types.push(
      SelfHostPlannedWasmPhysicalType::{
        kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmForeignMarkerType(layout.declaration)
        type_index: type_index
        fields: SelfHostHirSpan::{
          start: fields.length()
          length: 0u32
        }
        offset: layout.offset
      },
    )
    SelfHostPlannedNominalLayoutKind::PlannedEnumLayout(variants) => {
      physical_types.push(SelfHostPlannedWasmPhysicalType::{
        kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(layout.declaration)
        type_index: type_index
        fields: SelfHostHirSpan::{
          start: fields.length()
          length: 0u32
        }
        offset: layout.offset
      })
      let mut marker_super = type_index
      let mut variant = 0u32
      let _ = while variant {
        current => if current < variants.length {
          let source = module_.type_layouts.variants[
            self_host_u32_add(variants.start, current)
          ]
          let field_start = fields.length()
          match source.payload {
            SelfHostPlannedVariantPayloadLayout::PlannedUnitVariantLayout => {}
            SelfHostPlannedVariantPayloadLayout::PlannedTupleVariantLayout(payload) => {
              let mut item = 0u32
              let _ = while item {
                payload_index => if payload_index < payload.length {
                  fields.push(SelfHostPlannedWasmField::{
                    role: SelfHostPlannedWasmFieldRole::WasmVariantPayloadField(
                      source.variant,
                      payload_index,
                    )
                    declaration: source.variant
                    physical_index: payload_index
                    storage: self_host_wasmgc_payload_storage_type(
                      module_,
                      payload,
                      payload_index,
                    )
                    mutable_: false
                    exact_nominal: self_host_wasmgc_payload_exact_nominal(
                      module_,
                      payload,
                      payload_index,
                    )
                    offset: source.offset
                  })
                  continue payload_index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostPlannedVariantPayloadLayout::PlannedStructVariantLayout(payload) => {
              let mut item = 0u32
              let _ = while item {
                payload_index => if payload_index < payload.length {
                  let field = self_host_planned_field_layout_at(
                    module_.type_layouts.fields,
                    self_host_u32_add(payload.start, payload_index),
                  )
                  fields.push(SelfHostPlannedWasmField::{
                    role: SelfHostPlannedWasmFieldRole::WasmStructField(field.field)
                    declaration: field.field
                    physical_index: payload_index
                    storage: self_host_wasmgc_field_storage_type(module_, field)
                    mutable_: field.mutable_
                    exact_nominal: false
                    offset: field.offset
                  })
                  continue payload_index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
          }
          let marker_index = physical_types.length()
          physical_types.push(SelfHostPlannedWasmPhysicalType::{
            kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumMarkerType(
              layout.declaration,
              source.variant,
              source.tag,
              marker_super,
            )
            type_index: marker_index
            fields: SelfHostHirSpan::{
              start: field_start
              length: 0u32
            }
            offset: source.offset
          })
          marker_super = marker_index
          physical_types.push(SelfHostPlannedWasmPhysicalType::{
            kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
              layout.declaration,
              source.variant,
              source.tag,
            )
            type_index: physical_types.length()
            fields: SelfHostHirSpan::{
              start: field_start
              length: fields.length() - field_start
            }
            offset: source.offset
          })
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
}

fn self_host_wasmgc_resolved_type_is_direct_generic(
  type_: SelfHostResolvedType,
) -> Bool {
  type_ is SelfHostResolvedType::GenericParameterType(_)
}

fn self_host_wasmgc_specialized_resolved_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: U32,
  generic_parameters: SelfHostCallableGenericParameters,
  request: SelfHostProgramSpecializationRequest,
  shapes: Array<SelfHostPlannedValueShape>,
  fallback: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  if type_ >= module_.resolved_types.types.length() {
    return fallback
  }
  let resolved_type = module_.resolved_types.types[type_]
  if self_host_wasmgc_resolved_type_is_direct_generic(resolved_type) {
    match resolved_type {
      SelfHostResolvedType::GenericParameterType(parameter) => {
      match generic_parameters.slot(parameter) {
        Option::Some(relative) => if relative < request.shapes.length {
          let shape = self_host_u32_add(request.shapes.start, relative)
          if shape < shapes.length() {
            return shapes[shape]
          }
        }
        Option::None => {}
      }
      fallback
      }
      _ => fallback
    }
  } else {
  match resolved_type {
    SelfHostResolvedType::ProductType(fields) => {
      if fields.start > module_.resolved_types.type_arguments.length() ||
        fields.length > module_.resolved_types.type_arguments.length() - fields.start {
        return fallback
      }
      let specialized = []
      let mut field = 0u32
      let _ = while field {
        current => if current < fields.length {
          let field_type = module_.resolved_types.type_arguments[
            self_host_u32_add(fields.start, current)
          ]
          let field_fallback = match fallback {
            SelfHostPlannedValueShape::ProductPlannedValueShape(values) => if current < values.length() {
              values[current]
            } else {
              self_host_planned_resolved_value_shape(
                module_.resolved_types,
                field_type,
              )
            }
            _ => self_host_planned_resolved_value_shape(
              module_.resolved_types,
              field_type,
            )
          }
          specialized.push(self_host_wasmgc_specialized_resolved_shape(
            module_,
            field_type,
            generic_parameters,
            request,
            shapes,
            field_fallback,
          ))
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      SelfHostPlannedValueShape::ProductPlannedValueShape(specialized)
    }
    _ => fallback
  }
  }
}

fn self_host_wasmgc_specialized_shape(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  request: Option<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  type_: U32,
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  match request {
    Option::Some(value) => self_host_wasmgc_specialized_resolved_shape(
      module_,
      type_,
      self_host_program_specialization_callable_generics(callable),
      value,
      shapes,
      shape,
    )
    Option::None => shape
  }
}

fn self_host_wasmgc_function_kind(
  callable: SelfHostPlannedCallable,
) -> SelfHostPlannedWasmFunctionKind {
  match callable.kind {
    SelfHostPlannedCallableKind::PlannedBuiltinCallable(name) => if self_host_is_compile_time_builtin(name) {
      SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction
    } else {
      SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(name)
    }
    SelfHostPlannedCallableKind::PlannedForeignCallable(library, field, host_import) => {
      let namespace = if host_import {
        library
      } else {
        let name = BytesBuilder::new()
        name.append(b"link:")
        name.append(library)
        name.finish()
      }
      SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(namespace, field)
    }
    SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body)
    SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, body) => match body {
      Option::Some(value) => SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(value)
      Option::None => SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction
    }
    _ => SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction
  }
}

fn self_host_wasmgc_append_function(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  direct_builtin: Bytes,
  reachable: Bool,
  request: Option<SelfHostProgramSpecializationRequest>,
  request_index: U32,
  shapes: Array<SelfHostPlannedValueShape>,
  functions: Array<SelfHostPlannedWasmFunctionFragment>,
  value_types: Array<SelfHostPlannedWasmValueType>,
) -> Unit {
  let parameter_start = value_types.length()
  let deferred = request is Option::None && self_host_query_projected_signature(module_, callable)
  let parameter_count = if deferred {
    0u32
  } else {
    callable.parameters.length
  }
  let mut parameter = 0u32
  let _ = while parameter {
    current => if current < parameter_count {
      let source = module_.functions.parameters[
        self_host_u32_add(callable.parameters.start, current)
      ]
      let parameter_shape = if source.receiver {
        // The receiver is the owner value. An owner type argument can change
        // fields and results, but it cannot replace the receiver reference.
        source.shape
      } else {
        self_host_wasmgc_specialized_shape(
          module_,
          callable,
          request,
          shapes,
          source.type_,
          source.shape,
        )
      }
      self_host_wasmgc_append_shape(
        value_types,
        parameter_shape,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result_start = value_types.length()
  if !deferred {
  self_host_wasmgc_append_shape(
    value_types,
    self_host_wasmgc_specialized_shape(
      module_,
      callable,
      request,
      shapes,
      callable.result_type,
      callable.result_shape,
    ),
  )
  }
  functions.push(SelfHostPlannedWasmFunctionFragment::{
    declaration: callable.declaration
    kind: self_host_wasmgc_function_kind(callable)
    direct_builtin: direct_builtin
    parameters: SelfHostHirSpan::{
      start: parameter_start
      length: result_start - parameter_start
    }
    results: SelfHostHirSpan::{
      start: result_start
      length: value_types.length() - result_start
    }
    specialization: request_index
    elided: !reachable || request is Option::None && self_host_u32_greater(
      self_host_program_specialization_callable_generics(callable).length,
      0u32,
    )
    offset: callable.offset
  })
}

fn self_host_wasmgc_append_lambda_function(
  module_: SelfHostPlannedModuleLowering,
  lambda: SelfHostPlannedLambdaLowering,
  functions: Array<SelfHostPlannedWasmFunctionFragment>,
  value_types: Array<SelfHostPlannedWasmValueType>,
) -> Unit {
  self_host_wasmgc_append_lambda_function_for_request(module_, lambda, Option::None, 4294967295u32, [], functions, value_types)
}

fn self_host_wasmgc_append_lambda_function_for_request(
  module_: SelfHostPlannedModuleLowering,
  lambda: SelfHostPlannedLambdaLowering,
  request: Option<SelfHostProgramSpecializationRequest>,
  request_index: U32,
  shapes: Array<SelfHostPlannedValueShape>,
  functions: Array<SelfHostPlannedWasmFunctionFragment>,
  value_types: Array<SelfHostPlannedWasmValueType>,
) -> Unit {
  let parameter_start = value_types.length()
  value_types.push(SelfHostPlannedWasmValueType::WasmNullableEqRefValue)
  let owner = self_host_program_specialization_body(module_, lambda.root_body)
  let declaration = match owner {
    Option::Some(body) => body.declaration
    Option::None => 0u64
  }
  let _ = self_host_assert_compiler_invariant_with_failure(
    owner is Option::Some(_) &&
      self_host_array_span_is_valid(lambda.locals.start, lambda.locals.length, module_.locals.length()) &&
      !self_host_u32_greater(lambda.parameter_count, lambda.locals.length),
    SelfHostInvariantFailure::{
      code: 401u32
      phase: 4u32
      module_id: module_.module_id
      declaration: declaration
      body: lambda.root_body
      expression: 4294967295u32
      expected: u32_into_u64(lambda.locals.length)
      actual: u32_into_u64(lambda.parameter_count)
      detail: u32_into_u64(lambda.lambda)
    },
    "lambda parameters must belong to a valid local span and source body",
  )
  let mut parameter = 0u32
  let _ = while parameter {
    current => if current < lambda.parameter_count {
      let local_index = self_host_u32_add(lambda.locals.start, current)
      let local = self_host_body_planned_local_identity(module_.locals[local_index])
      let _ = self_host_assert_compiler_invariant_with_failure(
        local.kind is SelfHostBodyLocalKind::ParameterLocal &&
          self_host_u64_equal(local.body, lambda.root_body) &&
          self_host_u32_equal(local.lambda, lambda.lambda) &&
          self_host_u32_equal(local.local_id, current),
        SelfHostInvariantFailure::{
          code: 401u32
          phase: 4u32
          module_id: module_.module_id
          declaration: declaration
          body: lambda.root_body
          expression: 4294967295u32
          expected: u32_into_u64(current)
          actual: u32_into_u64(local.local_id)
          detail: u32_into_u64(local_index)
        },
        "lambda parameters must retain source order and lambda ownership",
      )
      self_host_wasmgc_append_shape(value_types, self_host_lambda_physical_shape(module_, lambda,
        self_host_lambda_request_shape(module_, request, shapes, local.type_, local.shape), current,
      ))
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let result_start = value_types.length()
  self_host_wasmgc_append_shape(value_types, self_host_lambda_physical_shape(module_, lambda,
    self_host_lambda_request_shape(module_, request, shapes, lambda.root_type, lambda.result_shape), 4294967295u32,
  ))
  functions.push(SelfHostPlannedWasmFunctionFragment::{
    declaration: declaration
    kind: SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
      lambda.lambda,
    )
    direct_builtin: b""
    parameters: SelfHostHirSpan::{
      start: parameter_start
      length: result_start - parameter_start
    }
    results: SelfHostHirSpan::{
      start: result_start
      length: value_types.length() - result_start
    }
    specialization: request_index
    elided: false
    offset: 0u32
  })
}

fn self_host_wasmgc_plan_closures(
  module_: SelfHostPlannedModuleLowering,
  physical_types: Array<SelfHostPlannedWasmPhysicalType>,
  fields: Array<SelfHostPlannedWasmField>,
  capture_cell_indices: Array<U32>,
  lambda_type_indices: Array<U32>,
) -> U32 {
  let closure_index = physical_types.length()
  let closure_field = fields.length()
  fields.push(SelfHostPlannedWasmField::{
    role: SelfHostPlannedWasmFieldRole::WasmClosureEntryField
    declaration: 0u64
    physical_index: 0u32
    storage: SelfHostPlannedWasmStorageType::WasmNullableFuncRefStorage
    mutable_: false
    exact_nominal: false
    offset: 0u32
  })
  physical_types.push(SelfHostPlannedWasmPhysicalType::{
    kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmClosureType
    type_index: closure_index
    fields: SelfHostHirSpan::{
      start: closure_field
      length: 1u32
    }
    offset: 0u32
  })
  let mut local_index = 0u32
  let _ = while local_index {
    current => if current < module_.locals.length() {
      let local = module_.locals[current]
      if self_host_local_needs_capture_cell(module_, local) && !self_host_lambda_owner_is_generic(module_, local.body) {
        let type_index = physical_types.length()
        let field_start = fields.length()
        fields.push(SelfHostPlannedWasmField::{
          role: SelfHostPlannedWasmFieldRole::WasmCaptureCellValueField(current)
          declaration: 0u64
          physical_index: 0u32
          storage: self_host_wasmgc_storage_type(local.shape)
          mutable_: true
          exact_nominal: false
          offset: local.offset
        })
        physical_types.push(SelfHostPlannedWasmPhysicalType::{
          kind: SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmCaptureCellType(current, 4294967295u32)
          type_index: type_index
          fields: SelfHostHirSpan::{
            start: field_start
            length: 1u32
          }
          offset: local.offset
        })
        capture_cell_indices[current] = type_index
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut lambda_index = 0u32
  let _ = while lambda_index {
    current => if current < module_.lambdas.length() {
      let lambda = module_.lambdas[current]
      if !self_host_lambda_owner_is_generic(module_, lambda.root_body) && self_host_compile_time_lambda_is_live(module_, lambda.lambda) {
        lambda_type_indices[current] = self_host_wasmgc_append_lambda_closure(module_, lambda, Option::None, 4294967295u32, [], physical_types, fields)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  closure_index
}

fn self_host_plan_program_wasmgc_fragments(
  specialization: SelfHostProgramSpecializationPlan,
) -> SelfHostPlannedProgramWasmGCFragments {
  let modules = []
  let reachable = self_host_program_specialization_seen()
  for declaration in specialization.reachable_declarations {
    reachable.set(declaration, true)
  }
  let required_types = self_host_program_physical_type_demand(specialization, reachable)
  let mut module_index = 0u32
  let _ = while module_index {
    current => if current < specialization.lowering.modules.length() {
      let source = specialization.lowering.modules[current]
      let physical_types = []
      let fields = []
      let functions = []
      let value_types = []
      let type_lookup = self_host_wasmgc_u32_slots(
        source.type_layouts.layout_by_declaration.length(),
      )
      let function_lookup = self_host_wasmgc_u32_slots(
        source.functions.callable_by_declaration.length(),
      )
      let capture_cell_indices = self_host_wasmgc_u32_slots(
        source.locals.length(),
      )
      let lambda_type_indices = self_host_wasmgc_u32_slots(
        source.lambdas.length(),
      )
      let lambda_function_indices = self_host_wasmgc_u32_slots(
        source.lambdas.length(),
      )
      self_host_wasmgc_plan_types(source, required_types, specialization.lowering.raw_arrays.declarations, physical_types, fields, type_lookup)
      let closure_type_index = self_host_wasmgc_plan_closures(
        source,
        physical_types,
        fields,
        capture_cell_indices,
        lambda_type_indices,
      )
      for callable in source.functions.callables {
        let function_index = functions.length()
        // Prove forwarding once. Call verification and emission only read the
        // frozen result; neither phase walks or rewrites a target body.
        let direct_builtin = match self_host_raw_forwarding_builtin(
          specialization.lowering,
          source,
          callable.declaration,
        ) {
          Option::Some(name) => name
          Option::None => b""
        }
        self_host_wasmgc_append_function(
          source,
          callable,
          direct_builtin,
          reachable.contains_key(callable.declaration),
          Option::None,
          4294967295u32,
          specialization.shapes,
          functions,
          value_types,
        )
        function_lookup[self_host_semantic_id_local(callable.declaration)] = function_index
      }
      let mut lambda_index = 0u32
      let _ = while lambda_index {
        lambda => if lambda < source.lambdas.length() {
          if !self_host_lambda_owner_is_generic(source, source.lambdas[lambda].root_body) && self_host_compile_time_lambda_is_live(source, source.lambdas[lambda].lambda) {
            lambda_function_indices[lambda] = functions.length()
            self_host_wasmgc_append_lambda_function(
              source,
              source.lambdas[lambda],
              functions,
              value_types,
            )
          }
          continue lambda + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut request_index = 0u32
      let _ = while request_index {
        request => if request < specialization.requests.length() {
          let selected = specialization.requests[request]
          if self_host_semantic_id_module(selected.declaration) == source.module_id {
            let instance = self_host_program_function_lowering(specialization.lowering, current, request)
            match self_host_program_specialization_callable(
              instance,
              selected.declaration,
            ) {
              Option::Some(callable) => self_host_wasmgc_append_function(
                instance,
                callable,
                b"",
                true,
                Option::Some(selected),
                request,
                specialization.shapes,
                functions,
                value_types,
              )
              Option::None => {}
            }
            self_host_wasmgc_append_specialized_lambdas(self_host_program_function_lowering(specialization.lowering, current, request), selected, request, specialization.shapes, physical_types, fields, functions, value_types)
          }
          continue request + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      modules.push(SelfHostPlannedModuleWasmGCFragments::{
        module_id: source.module_id
        physical_types: physical_types
        fields: fields
        functions: functions
        function_value_types: value_types
        type_index_by_declaration: type_lookup
        function_by_declaration: function_lookup
        closure_type_index: closure_type_index
        capture_cell_type_indices: capture_cell_indices
        lambda_closure_type_indices: lambda_type_indices
        lambda_function_indices: lambda_function_indices
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostPlannedProgramWasmGCFragments::{
    specialization: specialization
    modules: modules
  }
}

// Allocate in frozen record order, which also defines physical slot offsets.
// Source-kind checks verify the recipe; they do not select a new storage type.
fn self_host_linked_physical_scratch_value(plan: SelfHostPlannedPhysicalBodyCarrierPlan, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, scratch: SelfHostPlannedPhysicalScratchCarrier) -> SelfHostPlannedPhysicalValueInfo {
  let canonical = Some(plan)
  let _ = self_host_physical_scratch_body(canonical, module_, body, scratch.expression, scratch.ordinal)
  match module_.expressions[scratch.expression].kind {
    PlannedConstruct(_, _, _), PlannedObjectNew(_) => return self_host_constructor_scratch_value(canonical, module_, body, scratch.expression, scratch.ordinal)
    PlannedBuiltinCall(name, _, _, _, _) => if name.equals(b"array_new") {
      if scratch.ordinal != 0u32 {
        self_host_physical_scratch_failure(module_, body, scratch.expression, 7u32, 403u32, 1u64, u32_into_u64(scratch.ordinal), 0u64)
      }
      return self_host_raw_array_length_scratch(canonical, module_, body, scratch.expression)
    } else {
      self_host_physical_scratch_failure(module_, body, scratch.expression, 7u32, 606u32, 1u64, 0u64, u32_into_u64(scratch.ordinal))
    }
    PlannedMatchExpression(_, _),
    PlannedWhileExpression(_, _, _),
    PlannedFunctionValueCall(_, _, _),
    PlannedProductField(_, _, _),
    PlannedArrayLiteral(_) => {}
    _ => self_host_physical_scratch_failure(module_, body, scratch.expression, 7u32, 606u32, 1u64, 0u64, u32_into_u64(scratch.ordinal))
  }
  if scratch.ordinal != 0u32 {
    self_host_physical_scratch_failure(module_, body, scratch.expression, 7u32, 403u32, 1u64, u32_into_u64(scratch.ordinal), 0u64)
  }
  self_host_require_physical_scratch(plan, module_, body, scratch.expression, scratch.ordinal, scratch.value.carrier)
}

open dew.std.map
open dew.std.option

fn self_host_specialization_index_failure(declaration: U64, caller_body: U64, expression: U32, code: U32, expected: U64, actual: U64, detail: U64) -> Never {
  let context_id = if caller_body == 0u64 {
    declaration
  } else {
    caller_body
  }
  self_host_assert_compiler_invariant_with_failure(false, {
    code: code
    phase: 5u32
    module_id: self_host_semantic_id_module(context_id)
    declaration: declaration
    body: caller_body
    expression: expression
    expected: expected
    actual: actual
    detail: detail
  }, "specialization lookup requires valid arenas and exact declaration-local entries")
  unreachable()
}

// This module owns specialization worklist cursors and request indexes.
// The planner supplies arenas. These APIs keep all parallel-array checks in
// one place and prevent callers from restarting a completed queue scan.
fn self_host_program_specialization_queue_reachable(
  reachable: Array<U64>,
  declaration_work: Array<U64>,
  declaration_queued: Map<U64, Bool>,
  start: U32,
) -> U32 {
  self_host_assert_compiler_invariant(
    !self_host_u32_greater(start, reachable.length()),
    "compiler specialization reachable cursor is outside the arena",
  )
  let _ = while start {
    current => if current < reachable.length() {
      let declaration = reachable[current]
      if !declaration_queued.contains_key(declaration) {
        declaration_queued.set(declaration, true)
        declaration_work.push(declaration)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  reachable.length()
}

fn self_host_program_specialization_request_matches(
  request: SelfHostProgramSpecializationRequest,
  requests_shapes: Array<SelfHostPlannedValueShape>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
  request_index: U32,
  caller_body: U64,
  expression: U32,
) -> Bool {
  if request.declaration != declaration {
    self_host_specialization_index_failure(declaration, caller_body, expression, 302u32,
      declaration, request.declaration, u32_into_u64(request_index))
  }
  if !self_host_array_span_is_valid(request.shapes.start, request.shapes.length, requests_shapes.length()) {
    self_host_specialization_index_failure(declaration, caller_body, expression, 101u32,
      u32_into_u64(requests_shapes.length()), u32_into_u64(request.shapes.length), u32_into_u64(request.shapes.start))
  }
  while 0u32 {
    shape_index if shape_index < request.shapes.length => {
      let error = self_host_specialization_shape_error(requests_shapes[request.shapes.start + shape_index])
      if error != 0u32 {
        self_host_specialization_index_failure(declaration, caller_body, expression, 301u32,
          0u64, u32_into_u64(error), (1u64 << 32u64) | u32_into_u64(shape_index))
      }
      continue shape_index + 1u32
    }
    _ => break ()
  }
  if request.shapes.length != candidates.length() {
    return false
  }
  let mut index = 0u32
  let _ = while index {
    current => if current < request.shapes.length {
      if !self_host_specialization_shapes_equal(
        requests_shapes[self_host_u32_add(request.shapes.start, current)],
        candidates[current],
      ) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_program_specialization_add_request(
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
) -> U32 {
  self_host_program_specialization_add_request_with_evidence(requests, shapes, request_head_by_declaration, request_next, declaration, candidates, [])
}

fn self_host_program_specialization_add_request_with_evidence(
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
  evidence_types: Array<SelfHostSpecializationEvidenceType>,
) -> U32 {
  self_host_program_specialization_add_request_at_call(
    requests, shapes, request_head_by_declaration, request_next,
    declaration, candidates, evidence_types, 0u64, 4294967295u32,
  )
}

// Unknown and poison are logical evidence, never physical ABI certificates.
// Walk product fields too; checking only the outer shape would admit poison.
fn self_host_specialization_shape_error(root: SelfHostPlannedValueShape) -> U32 {
  let work = [root]
  while work.length() {
    length if length > 0u32 => {
      let shape = match work.pop() {
        Some(value) => value
        None => {
          self_host_assert_compiler_invariant(false, "specialization shape work stack lost an entry")
          unreachable()
        }
      }
      match shape {
        GenericPlannedValueShape => return 1u32
        ErrorPlannedValueShape => return 2u32
        ProductPlannedValueShape(fields) => {
          for field in fields {
            work.push(field)
          }
        }
        _ => {}
      }
      continue work.length()
    }
    _ => break 0u32
  }
}

fn self_host_program_specialization_add_request_at_call(
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
  evidence_types: Array<SelfHostSpecializationEvidenceType>,
  caller_body: U64,
  expression: U32,
) -> U32 {
  // Check before a duplicate lookup can return early or any arena is changed.
  if request_next.length() != requests.length() {
    self_host_specialization_index_failure(declaration, caller_body, expression, 103u32,
      u32_into_u64(requests.length()), u32_into_u64(request_next.length()), 0u64)
  }
  // Validate before lookup or mutation: an invalid shape must not deduplicate
  // against an earlier reference-shaped request.
  let context_id = if caller_body == 0u64 {
    declaration
  } else {
    caller_body
  }
  let _ = while 0u32 {
    index if index < candidates.length() => {
      let error = self_host_specialization_shape_error(candidates[index])
      self_host_assert_compiler_invariant_with_failure(
        error == 0u32,
        {
          code: 301u32
          phase: 5u32
          module_id: self_host_semantic_id_module(context_id)
          declaration: declaration
          body: caller_body
          expression: expression
          expected: 0u64
          actual: u32_into_u64(error)
          detail: u32_into_u64(index)
        },
        "physical specialization requires concrete shapes (1=generic, 2=error)",
      )
      continue index + 1u32
    }
    _ => break ()
  }
  let missing = 4294967295u32
  let previous_head = match request_head_by_declaration.get(declaration) {
    Some(index) => index
    None => missing
  }
  let mut request_index = previous_head
  while request_index {
    current => if !self_host_u32_equal(current, missing) {
      if current >= requests.length() {
        self_host_specialization_index_failure(declaration, caller_body, expression, 105u32,
          u32_into_u64(requests.length()), u32_into_u64(current), 1u64)
      }
      // Appending a request can only point at an older record. Strict descent
      // proves termination and rejects cycles even on an immediate cache hit.
      let next = request_next[current]
      if next != missing && next >= current {
        self_host_specialization_index_failure(declaration, caller_body, expression, 108u32,
          u32_into_u64(current), u32_into_u64(next), u32_into_u64(current))
      }
      if self_host_program_specialization_request_matches(
        requests[current],
        shapes,
        declaration,
        candidates,
        current,
        caller_body,
        expression,
      ) && self_host_specialization_evidence_types_equal(requests[current].evidence_types, evidence_types) {
        break current
      }
      continue request_next[current]
    } else {
      let start = shapes.length()
      let mut shape_index = 0u32
      let _ = while shape_index {
        current => if current < candidates.length() {
          let candidate = candidates[current]
          shapes.push(self_host_specialization_canonical_shape(candidate))
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let new_index = requests.length()
      let evidence_copy = self_host_empty_specialization_evidence_types()
      for evidence in evidence_types {
        evidence_copy.push(evidence)
      }
      requests.push({
        declaration: declaration
        evidence_types: evidence_copy
        shapes: {
          start: start
          length: candidates.length()
        }
      })
      request_next.push(previous_head)
      request_head_by_declaration.set(declaration, new_index)
      if request_next.length() != requests.length() {
        self_host_specialization_index_failure(declaration, caller_body, expression, 103u32,
          u32_into_u64(requests.length()), u32_into_u64(request_next.length()), 0u64)
      }
      break new_index
    }
  }
}

open dew.std.testing
open dew.std.array

fn self_host_assert_relative_capture_module(module_: SelfHostPlannedModuleLowering) -> Unit {
  assert(module_.inferred.diagnostics.length() == 0u32, "capture reads and mutable writes must infer without errors")
  assert(module_.lambdas.length() == 2u32, "two independent lambdas")
  let first = module_.lambdas[0u32]
  let second = module_.lambdas[1u32]
  assert(self_host_u32_equal(first.captures.length, 1u32) && self_host_u32_equal(second.captures.length, 1u32), "each lambda captures one value")
  assert(self_host_u32_greater(second.captures.start, first.captures.start), "the second capture span is not at zero")
  assert(module_.captures[first.captures.start].shape is SelfHostPlannedValueShape::I64PlannedValueShape, "first capture retains I64")
  assert(module_.captures[second.captures.start].shape is SelfHostPlannedValueShape::I32PlannedValueShape, "second capture retains I32")
  assert(module_.captures[second.captures.start].mutable_, "the second capture retains its own mutability")
}

test "later lambda capture reads and writes use relative capture IDs" {
  let lowering = self_host_physical_test_lowering(
    b"fn first(held: I64) -> fn() -> I64 {\n  fn() -> I64 {\n    held\n  }\n}\nfn second(seed: I32) -> fn() -> I32 {\n  let mut value = seed\n  fn() -> I32 {\n    value = value + 1i32\n    value\n  }\n}\n",
  )
  self_host_assert_relative_capture_module(lowering.modules[0u32])
}

fn self_host_assert_immutable_capture_diagnostic(module_: SelfHostPlannedModuleLowering) -> Unit {
  let diagnostics = module_.inferred.diagnostics
  assert(diagnostics.length() == 1u32, "only the immutable capture write is invalid")
  assert(diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::ImmutableAssignmentTarget(_, _), "the error must identify immutable assignment")
}

test "later immutable lambda capture cannot borrow earlier capture mutability" {
  let lowering = self_host_physical_test_lowering(
    b"fn first(seed: I32) -> fn() -> I32 {\n  let mut held = seed\n  fn() -> I32 {\n    held = held + 1i32\n    held\n  }\n}\nfn second(value: I32) -> fn() -> I32 {\n  fn() -> I32 {\n    value = 1i32\n    value\n  }\n}\n",
  )
  self_host_assert_immutable_capture_diagnostic(lowering.modules[0u32])
}

test "integer bit instructions match Wasm widths and counts" {
  let machine = ct_machine(ct_test_plan(b""))
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.clz", [ct_number(0u64, "I32")])) == 32u64, "i32.clz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.clz", [ct_number(1u64, "I32")])) == 31u64, "i32.clz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.clz", [ct_number(4294967295u64, "I32")])) == 0u64, "i32.clz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.clz", [ct_number(0u64, "I64")])) == 64u64, "i64.clz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.clz", [ct_number(1u64, "I64")])) == 63u64, "i64.clz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.ctz", [ct_number(0u64, "I32")])) == 32u64, "i32.ctz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.ctz", [ct_number(2147483648u64, "I32")])) == 31u64, "i32.ctz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.ctz", [ct_number(0u64, "I64")])) == 64u64, "i64.ctz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.ctz", [ct_number(9223372036854775808u64, "I64")])) == 63u64, "i64.ctz")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.popcnt", [ct_number(4294967295u64, "I32")])) == 32u64, "i32.popcnt")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.popcnt", [ct_number(18446744073709551615u64, "I64")])) == 64u64, "i64.popcnt")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.popcnt", [ct_number(0u64, "I64")])) == 0u64, "i64.popcnt")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.rotl", [ct_number(305419896u64, "I32"), ct_number(36u64, "I32")])) == 591751041u64, "i32.rotl")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.rotr", [ct_number(305419896u64, "I32"), ct_number(36u64, "I32")])) == 2166572391u64, "i32.rotr")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i32.rotl", [ct_number(305419896u64, "I32"), ct_number(32u64, "I32")])) == 305419896u64, "i32.rotl")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.rotl", [ct_number(1311768467139281697u64, "I64"), ct_number(68u64, "I64")])) == 2541551400518955537u64, "i64.rotl")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.rotr", [ct_number(1311768467139281697u64, "I64"), ct_number(68u64, "I64")])) == 1234907033803052082u64, "i64.rotr")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.rotr", [ct_number(1311768467139281697u64, "I64"), ct_number(64u64, "I64")])) == 1311768467139281697u64, "i64.rotr")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.extend8_s", [ct_number(128u64, "I64")])) == 18446744073709551488u64, "i64.extend8_s")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.extend16_s", [ct_number(32768u64, "I64")])) == 18446744073709518848u64, "i64.extend16_s")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.extend32_s", [ct_number(2147483648u64, "I64")])) == 18446744071562067968u64, "i64.extend32_s")
  assert(ct_raw_bits(machine, ct_scalar_bit_intrinsic(machine, "i64.extend8_s", [ct_number(18446744073709486207u64, "I64")])) == 127u64, "i64.extend8_s")
}

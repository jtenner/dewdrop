fn self_host_module_graph_invariant_fixture() -> SelfHostProgramModuleGraph {
  SelfHostProgramModuleGraph::{
    dependencies: [
      self_host_graph_test_span(0u32, 0u32),
      self_host_graph_test_span(0u32, 1u32),
      self_host_graph_test_span(1u32, 1u32),
    ]
    dependency_modules: [0u32, 1u32]
    sccs: [
      self_host_graph_test_span(0u32, 1u32),
      self_host_graph_test_span(1u32, 1u32),
      self_host_graph_test_span(2u32, 1u32),
    ]
    scc_modules: [0u32, 1u32, 2u32]
    module_scc: [0u32, 1u32, 2u32]
  }
}

test "module graph verification accepts ordered dependencies cycles and empties" {
  let graph = self_host_module_graph_invariant_fixture()
  self_host_verify_program_module_graph(graph, 3u32)
  graph.dependency_modules[0u32] = 2u32
  graph.sccs[1u32] = self_host_graph_test_span(1u32, 2u32)
  graph.sccs.truncate(2u32)
  graph.module_scc[2u32] = 1u32
  self_host_verify_program_module_graph(graph, 3u32)
  self_host_verify_program_module_graph(SelfHostProgramModuleGraph::{
    dependencies: []
    dependency_modules: []
    sccs: []
    scc_modules: []
    module_scc: []
  }, 0u32)
}

test "LNK-501 repeated SCC module is rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.scc_modules[1u32] = 0u32
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 missing SCC module is rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.scc_modules.truncate(2u32)
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 reversed dependency order is rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.dependency_modules[0u32] = 2u32
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 overlapping SCC spans are rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.sccs[1u32] = self_host_graph_test_span(0u32, 1u32)
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 dependency span overflow is rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.dependencies[1u32] = self_host_graph_test_span(4294967295u32, 1u32)
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 out of range dependency is rejected" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.dependency_modules[0u32] = 3u32
  self_host_verify_program_module_graph(graph, 3u32)
}

test "LNK-501 stored component identity must match" expect_trap "unreachable" {
  let graph = self_host_module_graph_invariant_fixture()
  graph.module_scc[1u32] = 2u32
  self_host_verify_program_module_graph(graph, 3u32)
}

fn self_host_graph_test_span(start: U32, length: U32) -> SelfHostHirSpan {
  SelfHostHirSpan::{
    start: start
    length: length
  }
}

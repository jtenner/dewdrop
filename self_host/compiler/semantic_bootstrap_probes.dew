// Pure, deterministic checks that the host can run in each bootstrap compiler.
// Keep the returned values separate: a wrong but valid Wasm program must not
// turn a semantic check into a successful compile.
pub fn self_host_bootstrap_primitive_probe() -> U32 {
  let interner = SelfHostResolvedTypeInterner::new()
  let mut failures = 0u32
  if interner.primitive_types.length() != 42u32 {
    failures = failures + 128u32
  }
  let _ = while 0u32 {
    index => if index < interner.primitive_types.length() {
      let type_ = interner.primitive_types[index]
      match interner.types[type_] {
        SelfHostResolvedType::PrimitiveType(primitive) => if primitive.rank() != index {
          failures = failures + 1u32
        }
        _ => {
          failures = failures + 1u32
        }
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  failures
}

pub fn self_host_bootstrap_solver_probe() -> U32 {
  let collected = self_host_collect_bytes(80u64, b"fn accept(value: I32) -> U32 {\n  0u32\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  let solver = SelfHostLocalTypeSolver::new(resolved)
  let signed = solver.resolved_type(resolved.primitive(SelfHostPrimitiveType::I32Type))
  let unsigned = solver.resolved_type(resolved.primitive(SelfHostPrimitiveType::U32Type))
  let origin = self_host_synthetic_type_origin(0u32, 1u32)
  let mut failures = resolved.diagnostic_count()
  if signed == unsigned || signed == -1i32 || unsigned == -1i32 {
    failures = failures + 1u32
  }
  if solver.unify(signed, unsigned, origin) {
    failures = failures + 2u32
  }
  if !solver.unify(signed, signed, origin) {
    failures = failures + 4u32
  }
  let variable = solver.fresh_variable()
  let snapshot = solver.snapshot()
  if !solver.unify(variable, signed, origin) {
    failures = failures + 8u32
  }
  if solver.unify(variable, unsigned, origin) {
    failures = failures + 16u32
  }
  solver.rollback(snapshot)
  if !solver.unify(variable, unsigned, origin) {
    failures = failures + 32u32
  }
  failures
}

struct SelfHostBootstrapImportCheck {
  failures: U32
  detail: Option<String>
}

pub fn self_host_bootstrap_import_probe() -> U32 {
  self_host_bootstrap_import_check().failures
}

fn self_host_bootstrap_import_check() -> SelfHostBootstrapImportCheck {
  let collected = self_host_collect_program_manifest(5500u64, SelfHostProgramManifest::{
    modules: [
      SelfHostManifestModule::{
        path: "app.types"
        files: [SelfHostManifestFile::{
          path: "types.dew"
          source: b"pub trait Into<t> {\n  fn into(self) -> t\n}\nimpl Into<U32> for U32 {\n  fn into(self) -> U32 {\n    self\n  }\n}\nimpl Into<I64> for U32 {\n  fn into(self) -> I64 {\n    1i64\n  }\n}\npub struct Pair<a, b> {}\n"
          test_only: false
        }]
      },
      SelfHostManifestModule::{
        path: "app.main"
        files: [SelfHostManifestFile::{
          path: "main.dew"
          source: b"open app.types\nfn accept(value: Pair<I32, U32>) -> Unit {}\npub fn run(value: U32) -> I64 {\n  value.into()\n}\n"
          test_only: false
        }]
      },
    ]
  })
  let mut failures = collected.diagnostics.length()
  for module_ in collected.modules.values {
    failures = failures + module_.diagnostic_count()
  }
  let frozen = self_host_freeze_program_signature_interfaces(collected)
  let source = frozen.interfaces.at(0u32)
  let destination = frozen.interfaces.at(1u32)
  let source_types = self_host_resolved_module_types_identity(source.resolved_types)
  let destination_types = self_host_resolved_module_types_identity(destination.resolved_types)
  let importer = SelfHostInterfaceTypeImporter::new(destination_types, frozen.interfaces)
  let imported = importer.import_type(0u32, source_types.primitive(SelfHostPrimitiveType::I32Type))
  if imported != destination_types.primitive(SelfHostPrimitiveType::I32Type) {
    failures = failures + 256u32
  }
  let imports = self_host_resolve_module_imports(destination_types, frozen.import_scopes.at(1u32))
  let mut implementation_index = 0u32
  for raw_implementation in imports.implementations {
    let _ = raw_implementation
    let implementation = self_host_resolved_imported_implementation_at(imports.implementations, implementation_index)
    implementation_index = implementation_index + 1u32
    if implementation.target_type != destination_types.primitive(SelfHostPrimitiveType::U32Type) {
      failures = failures + 512u32
    }
  }
  let mut callable_index = 0u32
  for raw_callable in imports.callables {
    let _ = raw_callable
    let callable = self_host_resolved_imported_callable_at(imports.callables, callable_index)
    callable_index = callable_index + 1u32
    if callable.result_type == destination_types.error_type {
      failures = failures + 1024u32
    }
    let _ = while 0u32 {
      source_index => if source_index < source.callable_count() {
        let source_callable = source.callable_at(source_index)
        if self_host_u64_equal(source_callable.declaration, callable.declaration) {
          let expected = importer.import_type(0u32, source_callable.result_type)
          if expected != callable.result_type {
            failures = failures + 2048u32
          }
        }
        continue source_index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  let lowering = self_host_plan_program_lowering(frozen)
  for raw_module in lowering.modules {
    let module_ = self_host_planned_module_lowering_identity(raw_module)
    failures = failures + module_.resolved_types.diagnostics.length() + module_.inferred.diagnostics.length()
  }
  SelfHostBootstrapImportCheck::{
    failures: failures
    detail: self_host_validate_program_inference(lowering)
  }
}

pub fn self_host_bootstrap_body_probe() -> U32 {
  let collected = self_host_collect_bytes(80u64, b"fn invalid(value: U32) -> I64 {\n  value\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  let mut errors = 0u32
  for body in inferred.bodies {
    errors = errors + body.diagnostic_count()
  }
  if errors == 1u32 {
    0u32
  } else {
    errors + 1u32
  }
}

open dew.std.array
open dew.std.option

fn self_host_module_value_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_module_value_bool_slots(length: U32) -> Array<Bool> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_module_value_u32_slots(length: U32, value: U32) -> Array<U32> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push(value)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

pub struct SelfHostModuleValueDependencies {
  module_id: U64
  let_dependencies: Array<SelfHostHirSpan>
  dependency_declarations: Array<U64>
  sccs: Array<SelfHostHirSpan>
  scc_declarations: Array<U64>
}

impl SelfHostModuleValueDependencies {
  fn dependency_span(self, index: U32) -> SelfHostHirSpan {
    self.let_dependencies[index]
  }

  fn dependency_declaration(self, index: U32) -> U64 {
    self.dependency_declarations[index]
  }

  fn scc_count(self) -> U32 {
    self.sccs.length()
  }

  fn scc_at(self, index: U32) -> SelfHostHirSpan {
    self.sccs[index]
  }

  fn scc_declaration(self, index: U32) -> U64 {
    self.scc_declarations[index]
  }
}

fn self_host_module_value_body(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Option<SelfHostHirBody> {
  let limit = array_length(collected.bodies)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let body = array_get_unchecked(collected.bodies, current)
      if self_host_u64_equal(body.declaration, declaration) {
        return Some(body)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  None
}

fn self_host_module_value_declaration(
  collected: SelfHostCollectedModule,
  name: U32,
) -> Option<U64> {
  match collected.value_binding(name) {
    Some(binding) => Some(
      collected.value_binding_candidates[binding.head].declaration,
    )
    None => None
  }
}

fn self_host_module_value_let_index(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Option<U32> {
  let mut index = 0u32
  while index {
    current => if current < collected.lets.length() {
      if self_host_u64_equal(
        collected.lets[current].declaration,
        declaration,
      ) {
        break Some(current)
      }
      continue current + 1u32
    } else {
      break None
    }
  }
}

fn self_host_module_value_insert_sorted_unique(
  values: Array<U32>,
  value: U32,
) -> Unit {
  let mut position = 0u32
  let _ = while position {
    current => if current < values.length() {
      if self_host_u32_equal(values[current], value) {
        return
      }
      if self_host_u32_greater(values[current], value) {
        break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values.push(value)
  let mut cursor = values.length() - 1u32
  let _ = while cursor {
    current => if self_host_u32_greater(current, position) {
      values[current] = values[current - 1u32]
      continue current - 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values[position] = value
}

fn self_host_collect_module_value_dependencies(
  collected: SelfHostCollectedModule,
  names: SelfHostResolvedModuleNames,
) -> (Array<SelfHostHirSpan>, Array<U64>) {
  let spans = []
  let declarations = []
  let scratch = []
  let mut value_index = 0u32
  let _ = while value_index {
    current_value => if current_value < collected.lets.length() {
      let value = self_host_collected_let_identity(
        collected.lets[current_value],
      )
      scratch.clear()
    match self_host_module_value_body(collected, value.declaration) {
      Some(body) => {
        let mut expression = body.expressions.start
        let end = self_host_u32_add(
          body.expressions.start,
          body.expressions.length,
        )
        let _ = while expression {
          current => if current < end {
            match names.expression_reference_at(current) {
              ModuleValueNameReference(name) => match self_host_module_value_declaration(
                collected,
                name,
              ) {
                Some(declaration) => match self_host_module_value_let_index(
                  collected,
                  declaration,
                ) {
                  Some(dependency) => self_host_module_value_insert_sorted_unique(
                    scratch,
                    dependency,
                  )
                  None => {}
                }
                None => {}
              }
              _ => {}
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      None => {}
    }
      let start = declarations.length()
      let mut dependency_index = 0u32
      let _ = while dependency_index {
        current_dependency => if current_dependency < scratch.length() {
          let dependency = self_host_module_value_u32_at(
            scratch,
            current_dependency,
          )
          declarations.push(
            self_host_collected_let_identity(
              collected.lets[dependency],
            ).declaration,
          )
          continue current_dependency + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      spans.push({
        start: start
        length: declarations.length() - start
      })
      continue current_value + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  (spans, declarations)
}

// Use the shared iterative graph walk. Repeated reachability scans made a
// 1024-value chain take minutes before any body constraints could be checked.
fn self_host_find_module_value_sccs(
  collected: SelfHostCollectedModule,
  dependencies: Array<SelfHostHirSpan>,
  dependency_declarations: Array<U64>,
) -> (Array<SelfHostHirSpan>, Array<U64>) {
  let indices = self_host_empty_u64_u32_map()
  let _ = while 0u32 {
    index if index < collected.lets.length() => {
      indices.set(collected.lets[index].declaration, index)
      continue index + 1u32
    }
    _ => break ()
  }
  let edges = []
  for declaration in dependency_declarations {
    match indices.get(declaration) {
      Some(index) => edges.push(index)
      None => {
        self_host_assert_compiler_invariant(false, "module value dependency must name a collected initializer")
        unreachable()
      }
    }
  }
  let (sccs, members, _) = self_host_program_module_sccs(dependencies, edges)
  let declarations = []
  for member in members {
    declarations.push(collected.lets[member].declaration)
  }
  (sccs, declarations)
}

fn self_host_analyze_module_value_dependencies(
  collected: SelfHostCollectedModule,
  names: SelfHostResolvedModuleNames,
) -> SelfHostModuleValueDependencies {
  let (let_dependencies, dependency_declarations) = self_host_collect_module_value_dependencies(
    collected,
    names,
  )
  let (sccs, scc_declarations) = self_host_find_module_value_sccs(
    collected,
    let_dependencies,
    dependency_declarations,
  )
  {
    module_id: collected.module_id
    let_dependencies: let_dependencies
    dependency_declarations: dependency_declarations
    sccs: sccs
    scc_declarations: scc_declarations
  }
}

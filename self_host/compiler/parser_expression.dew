open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.result
open dew.std.string

fn self_host_empty_expressions() -> Array<SelfHostExpr> {
  new()
}

fn self_host_empty_object_fields() -> Array<SelfHostObjectField> {
  new()
}

fn self_host_empty_parameters() -> Array<SelfHostFnParameter> {
  new()
}

fn self_host_binary_operator(
  symbol: U32,
) -> Option<SelfHostBinaryOperator> {
  if symbol == 24u32 {
    Some(LogicalOr)
  } else if symbol == 23u32 {
    Some(LogicalAnd)
  } else if symbol == 34u32 {
    Some(BitOr)
  } else if symbol == 6u32 {
    Some(BitXor)
  } else if symbol == 33u32 {
    Some(BitAnd)
  } else if symbol == 16u32 {
    Some(Equal)
  } else if symbol == 18u32 {
    Some(NotEqual)
  } else if symbol == 29u32 {
    Some(Less)
  } else if symbol == 19u32 {
    Some(LessEqual)
  } else if symbol == 30u32 {
    Some(Greater)
  } else if symbol == 20u32 {
    Some(GreaterEqual)
  } else if symbol == 21u32 {
    Some(ShiftLeft)
  } else if symbol == 22u32 {
    Some(ShiftRight)
  } else if symbol == 7u32 {
    Some(Add)
  } else if symbol == 8u32 {
    Some(Subtract)
  } else if symbol == 9u32 {
    Some(Multiply)
  } else if symbol == 10u32 {
    Some(Divide)
  } else if symbol == 12u32 {
    Some(Remainder)
  } else if symbol == 11u32 {
    Some(Exponentiate)
  } else {
    None
  }
}

fn self_host_binary_symbol_precedence(symbol: U32) -> U32 {
  if symbol == 24u32 {
    3u32
  } else if symbol == 23u32 {
    4u32
  } else if symbol == 34u32 {
    5u32
  } else if symbol == 6u32 {
    6u32
  } else if symbol == 33u32 {
    7u32
  } else if symbol == 16u32 || symbol == 18u32 {
    8u32
  } else if symbol == 29u32 || symbol == 19u32 ||
    symbol == 30u32 || symbol == 20u32 {
    9u32
  } else if symbol == 21u32 || symbol == 22u32 {
    10u32
  } else if symbol == 7u32 || symbol == 8u32 {
    11u32
  } else if symbol == 9u32 || symbol == 10u32 || symbol == 12u32 {
    12u32
  } else {
    13u32
  }
}

fn self_host_binary_symbol_is_comparison(symbol: U32) -> Bool {
  symbol == 16u32 || symbol == 18u32 || symbol == 29u32 ||
    symbol == 19u32 || symbol == 30u32 || symbol == 20u32
}

fn self_host_parser_fail_expression(parser: SelfHostParser) -> Unit {
  self_host_parser_fail(
    parser,
    ExpectedExpression(
      self_host_parser_peek(parser),
      self_host_parser_offset(parser),
    ),
  )
}

fn self_host_expression_stops(
  token: SelfHostToken,
  stop_left_brace: Bool,
) -> Bool {
  if token.kind is Newline {
    true
  } else {
    let symbol_code = self_host_token_symbol_code(token.kind)
    symbol_code == 25u32 || symbol_code == 1u32 ||
      symbol_code == 5u32 || symbol_code == 3u32 ||
      symbol_code == 17u32 || symbol_code == 15u32 ||
      (symbol_code == 2u32 && stop_left_brace)
  }
}

fn self_host_parse_call_arguments(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<Array<SelfHostExpr>> {
  let arguments = self_host_empty_expressions()
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Some(arguments)
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Some(argument) => {
        arguments.push(argument)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(parser, 1u32) {
          break Some(arguments)
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            break Some(arguments)
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            ExpectedDelimiter(
              "call separator or )",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break None
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_array_expression(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostExpr> {
  let values = self_host_empty_expressions()
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 5u32) {
    return Some(ArrayExpr(values, open_offset))
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Some(value) => {
        values.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(
          parser,
          5u32,
        ) {
          break Some(ArrayExpr(values, open_offset))
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            5u32,
          ) {
            break Some(ArrayExpr(values, open_offset))
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            ExpectedDelimiter(
              "array separator or ]",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break None
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_group_expression(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostExpr> {
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Some(BlockExpr({
      items: self_host_empty_block_items()
      offset: open_offset
    }))
  } else {
  }
  let first = match self_host_parse_expression_context(parser, 0u32, false) {
    Some(value) => value
    None => {
      return None
    }
  }
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Some(first)
  } else if !self_host_parser_consume_symbol(
    parser,
    25u32,
  ) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "product separator or )",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return None
  } else {
  }
  let values = self_host_empty_expressions()
  values.push(first)
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Some(value) => {
        values.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(parser, 1u32) {
          if values.length() < 2u32 || values.length() > 32u32 {
            self_host_parser_fail(
              parser,
              InvalidProductArity(
                values.length(),
                open_offset,
              ),
            )
            break None
          } else {
            break Some(
              ProductExpr(values, open_offset),
            )
          }
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            if values.length() < 2u32 || values.length() > 32u32 {
              self_host_parser_fail(
                parser,
                InvalidProductArity(
                  values.length(),
                  open_offset,
                ),
              )
              break None
            } else {
              break Some(
                ProductExpr(values, open_offset),
              )
            }
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            ExpectedDelimiter(
              "product separator or )",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break None
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_object_fields(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<Array<SelfHostObjectField>> {
  let fields = self_host_empty_object_fields()
  if self_host_parser_consume_symbol(parser, 3u32) {
    return Some(fields)
  } else {
  }
  if !self_host_parser_consume_newline(parser) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "object body newline",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      if self_host_parser_consume_symbol(parser, 3u32) {
        break Some(fields)
      } else {
      }
      let pair = match self_host_parser_identifier(
        parser,
        BindingName,
      ) {
        Some(value) => value
        None => break None
      }
      let (name, offset) = pair
      if !self_host_parser_expect_symbol(
        parser,
        13u32,
        Colon,
      ) {
        break None
      } else {
      }
      match self_host_parse_expression_context(parser, 0u32, false) {
        Some(value) => fields.push({
          name: name
          value: value
          offset: offset
        })
        None => break None
      }
      if !self_host_parser_finish_line(parser) {
        break None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      continue 0u32
    }
  }
  result
}

fn self_host_parse_explicit_type_arguments(
  parser: SelfHostParser,
) -> Option<Array<SelfHostTypeExpr>> {
  let arguments = self_host_empty_types()
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => match self_host_parse_type(parser) {
      Some(value) => {
        arguments.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_type_closer(parser) {
          break Some(arguments)
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_type_closer(parser) {
            break Some(arguments)
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail_expected(
            parser,
            TypeArgumentSeparatorOrClose,
          )
          break None
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_primary(parser: SelfHostParser) -> Option<SelfHostExpr> {
  let token = match self_host_parser_peek(parser) {
    Some(value) => value
    None => {
      self_host_parser_fail_expression(parser)
      return None
    }
  }
  match token.kind {
    Newline => {
      self_host_parser_fail_expression(parser)
      None
    }
    Error(error) => {
      parser.index = parser.index + 1u32
      self_host_parser_fail(
        parser,
        Lexical(error, token.offset),
      )
      None
    }
    _ => {
      let symbol_code = self_host_token_symbol_code(token.kind)
      if symbol_code == 7u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Some(value) => Some(
            PrefixExpr(
              Positive,
              value,
              token.offset,
            ),
          )
          None => None
        }
      } else if symbol_code == 8u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Some(value) => Some(
            PrefixExpr(
              Negative,
              value,
              token.offset,
            ),
          )
          None => None
        }
      } else if symbol_code == 32u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Some(value) => Some(
            PrefixExpr(
              LogicalNot,
              value,
              token.offset,
            ),
          )
          None => None
        }
      } else if symbol_code == 0u32 {
        parser.index = parser.index + 1u32
        self_host_parse_group_expression(parser, token.offset)
      } else if symbol_code == 4u32 {
        parser.index = parser.index + 1u32
        self_host_parse_array_expression(parser, token.offset)
      } else if symbol_code == 2u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_object_fields(parser, token.offset) {
          Some(fields) => Some(
            ObjectExpr(fields, token.offset),
          )
          None => None
        }
      } else {
        let keyword_code = self_host_token_keyword_code(token.kind)
        if keyword_code == 0u32 {
          parser.index = parser.index + 1u32
          self_host_parse_lambda_expression(parser, token.offset)
        } else if keyword_code == 14u32 {
          parser.index = parser.index + 1u32
          self_host_parse_if_expression(parser, token.offset)
        } else if keyword_code == 16u32 {
          parser.index = parser.index + 1u32
          self_host_parse_match_expression(parser, token.offset)
        } else if keyword_code == 18u32 {
          parser.index = parser.index + 1u32
          self_host_parse_while_expression(parser, token.offset)
        } else if keyword_code == 7u32 {
          parser.index = parser.index + 1u32
          self_host_parse_for_expression(parser, token.offset)
        } else if keyword_code == 20u32 {
          parser.index = parser.index + 1u32
          let value = match self_host_parser_peek(parser) {
            None => Some(None)
            Some(next) => if self_host_token_kind_is_symbol(
              next.kind,
              3u32,
            ) || next.kind is Newline {
              Some(None)
            } else {
              match self_host_parse_expression_context(parser, 0u32, false) {
                Some(expression) => Some(
                  Some(expression),
                )
                None => None
              }
            }
          }
          match value {
            Some(return_value) => Some(
              ReturnExpr(return_value, token.offset),
            )
            None => None
          }
        } else if keyword_code == 22u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_expression_context(parser, 0u32, false) {
            Some(value) => Some(
              BreakExpr(value, token.offset),
            )
            None => None
          }
        } else if keyword_code == 23u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_expression_context(parser, 0u32, false) {
            Some(value) => Some(
              ContinueExpr(value, token.offset),
            )
            None => None
          }
        } else {
          match self_host_token_expression(token) {
            Some(value) => {
              parser.index = parser.index + 1u32
              Some(value)
            }
            None => {
              self_host_parser_fail_expression(parser)
              None
            }
          }
        }
      }
    }
  }
}

fn self_host_parse_expression_context(
  parser: SelfHostParser,
  minimum_precedence: U32,
  stop_left_brace: Bool,
) -> Option<SelfHostExpr> {
  self_host_parser_skip_newlines(parser)
  let mut left = match self_host_parse_primary(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  let mut left_comparison = 0u32
  let result = while 0u32 {
    _ => match self_host_parser_peek(parser) {
      None => break Some(left)
      Some(token) => if self_host_expression_stops(
        token,
        stop_left_brace,
      ) {
        break Some(left)
      } else {
        let symbol_code = self_host_token_symbol_code(token.kind)
        if symbol_code == 0u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_call_arguments(parser, token.offset) {
            Some(arguments) => {
              left = CallExpr(left, arguments, token.offset)
              left_comparison = 0u32
              continue 0u32
            }
            None => break None
          }
        } else if symbol_code == 4u32 {
          parser.index = parser.index + 1u32
          let index = match self_host_parse_expression_context(
            parser,
            0u32,
            false,
          ) {
            Some(value) => value
            None => break None
          }
          self_host_parser_skip_newlines(parser)
          if !self_host_parser_consume_symbol(parser, 5u32) {
            self_host_parser_fail(
              parser,
              ExpectedDelimiter(
                "]",
                self_host_parser_peek(parser),
                token.offset,
              ),
            )
            break None
          }
          left = IndexExpr(left, index, token.offset)
          left_comparison = 0u32
          continue 0u32
        } else if symbol_code == 27u32 {
          parser.index = parser.index + 1u32
          self_host_parser_skip_newlines(parser)
          match self_host_parser_identifier(
            parser,
            BindingName,
          ) {
            Some(pair) => {
              let (name, _name_offset) = pair
              left = match left {
                ImportAliasExpr(_, _) =>
                  QualifiedExpr(left, name, token.offset)
                _ => FieldExpr(left, name, token.offset)
              }
              left_comparison = 0u32
              continue 0u32
            }
            None => break None
          }
        } else if symbol_code == 14u32 {
          parser.index = parser.index + 1u32
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(parser, 2u32) {
            match self_host_parse_object_fields(parser, token.offset) {
              Some(fields) => {
                left = ConstructExpr(left, fields, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              None => break None
            }
          } else if self_host_parser_consume_symbol(parser, 29u32) {
            let type_arguments = match self_host_parse_explicit_type_arguments(
              parser,
            ) {
              Some(value) => value
              None => break None
            }
            self_host_parser_skip_newlines(parser)
            let call_offset = self_host_parser_offset(parser)
            if !self_host_parser_consume_symbol(parser, 0u32) {
              self_host_parser_fail(
                parser,
                ExpectedDelimiter(
                  "explicit type call (",
                  self_host_parser_peek(parser),
                  call_offset,
                ),
              )
              break None
            }
            match self_host_parse_call_arguments(parser, call_offset) {
              Some(arguments) => {
                left = ExplicitTypeCallExpr(
                  left,
                  type_arguments,
                  arguments,
                  call_offset,
                )
                left_comparison = 0u32
                continue 0u32
              }
              None => break None
            }
          } else {
            match self_host_parser_identifier(
              parser,
              BindingName,
            ) {
              Some(pair) => {
                let (name, _name_offset) = pair
                left = QualifiedExpr(left, name, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              None => break None
            }
          }
        } else {
          let keyword_code = self_host_token_keyword_code(token.kind)
          if keyword_code == 17u32 {
            if 8u32 < minimum_precedence {
              break Some(left)
            }
            parser.index = parser.index + 1u32
            match self_host_parse_pattern_context(
              parser,
              false,
              stop_left_brace,
            ) {
              Some(pattern) => {
                left = IsExpr(left, pattern, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              None => break None
            }
          } else {
            match self_host_binary_operator(symbol_code) {
              Some(operator) => {
                let precedence = self_host_binary_symbol_precedence(symbol_code)
                let comparison = self_host_binary_symbol_is_comparison(
                  symbol_code,
                )
                if precedence < minimum_precedence {
                  break Some(left)
                } else if comparison && left_comparison != 0u32 {
                  self_host_parser_fail(
                    parser,
                    ChainedComparison(token.offset),
                  )
                  break None
                }
                parser.index = parser.index + 1u32
                let next_precedence = if symbol_code == 11u32 {
                  precedence
                } else {
                  precedence + 1u32
                }
                match self_host_parse_expression_context(
                  parser,
                  next_precedence,
                  stop_left_brace,
                ) {
                  Some(right) => {
                    if symbol_code == 23u32 && stop_left_brace {
                      let original_left = left
                      left = match left {
                        IsExpr(
                          scrutinee,
                          pattern,
                          is_offset,
                        ) => IsGuardExpr(
                          scrutinee,
                          pattern,
                          right,
                          is_offset,
                        )
                        IsGuardExpr(
                          scrutinee,
                          pattern,
                          existing,
                          is_offset,
                        ) => IsGuardExpr(
                          scrutinee,
                          pattern,
                          BinaryExpr(
                            LogicalAnd,
                            existing,
                            right,
                            token.offset,
                          ),
                          is_offset,
                        )
                        _ => BinaryExpr(
                          operator,
                          original_left,
                          right,
                          token.offset,
                        )
                      }
                    } else {
                      left = BinaryExpr(
                        operator,
                        left,
                        right,
                        token.offset,
                      )
                    }
                    left_comparison = if comparison {
                      1u32
                    } else {
                      0u32
                    }
                    continue 0u32
                  }
                  None => break None
                }
              }
              None => break Some(left)
            }
          }
        }
      }
    }
  }
  result
}

pub fn self_host_parse_expression_source(
  source: Bytes,
) -> Result<SelfHostExpr, SelfHostParseError> {
  let parser = self_host_parser_new(source)
  match self_host_parse_expression_context(parser, 0u32, false) {
    Some(expression) => {
      self_host_parser_skip_newlines(parser)
      if parser.index != parser.tokens.length() {
        self_host_parser_fail(
          parser,
          ExpectedDelimiter(
            "end of expression",
            self_host_parser_peek(parser),
            self_host_parser_offset(parser),
          ),
        )
      } else {
      }
      match parser.diagnostic {
        Some(diagnostic) => Err(diagnostic.error)
        None => Ok(expression)
      }
    }
    None => match parser.diagnostic {
      Some(diagnostic) => Err(diagnostic.error)
      None => Err(
        ExpectedExpression(None, 0u32),
      )
    }
  }
}

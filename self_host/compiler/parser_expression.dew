open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.result
open dew.std.string

fn self_host_empty_expressions() -> Array<SelfHostExpr> {
  Array::new()
}

fn self_host_empty_object_fields() -> Array<SelfHostObjectField> {
  Array::new()
}

fn self_host_empty_parameters() -> Array<SelfHostFnParameter> {
  Array::new()
}

fn self_host_binary_operator(
  symbol: U32,
) -> Option<SelfHostBinaryOperator> {
  if symbol == 24u32 {
    Option::Some(SelfHostBinaryOperator::LogicalOr)
  } else if symbol == 23u32 {
    Option::Some(SelfHostBinaryOperator::LogicalAnd)
  } else if symbol == 34u32 {
    Option::Some(SelfHostBinaryOperator::BitOr)
  } else if symbol == 6u32 {
    Option::Some(SelfHostBinaryOperator::BitXor)
  } else if symbol == 33u32 {
    Option::Some(SelfHostBinaryOperator::BitAnd)
  } else if symbol == 16u32 {
    Option::Some(SelfHostBinaryOperator::Equal)
  } else if symbol == 18u32 {
    Option::Some(SelfHostBinaryOperator::NotEqual)
  } else if symbol == 29u32 {
    Option::Some(SelfHostBinaryOperator::Less)
  } else if symbol == 19u32 {
    Option::Some(SelfHostBinaryOperator::LessEqual)
  } else if symbol == 30u32 {
    Option::Some(SelfHostBinaryOperator::Greater)
  } else if symbol == 20u32 {
    Option::Some(SelfHostBinaryOperator::GreaterEqual)
  } else if symbol == 21u32 {
    Option::Some(SelfHostBinaryOperator::ShiftLeft)
  } else if symbol == 22u32 {
    Option::Some(SelfHostBinaryOperator::ShiftRight)
  } else if symbol == 7u32 {
    Option::Some(SelfHostBinaryOperator::Add)
  } else if symbol == 8u32 {
    Option::Some(SelfHostBinaryOperator::Subtract)
  } else if symbol == 9u32 {
    Option::Some(SelfHostBinaryOperator::Multiply)
  } else if symbol == 10u32 {
    Option::Some(SelfHostBinaryOperator::Divide)
  } else if symbol == 12u32 {
    Option::Some(SelfHostBinaryOperator::Remainder)
  } else if symbol == 11u32 {
    Option::Some(SelfHostBinaryOperator::Exponentiate)
  } else {
    Option::None
  }
}

fn self_host_binary_symbol_precedence(symbol: U32) -> U32 {
  if symbol == 24u32 {
    3u32
  } else if symbol == 23u32 {
    4u32
  } else if symbol == 34u32 {
    5u32
  } else if symbol == 6u32 {
    6u32
  } else if symbol == 33u32 {
    7u32
  } else if symbol == 16u32 || symbol == 18u32 {
    8u32
  } else if symbol == 29u32 || symbol == 19u32 ||
    symbol == 30u32 || symbol == 20u32 {
    9u32
  } else if symbol == 21u32 || symbol == 22u32 {
    10u32
  } else if symbol == 7u32 || symbol == 8u32 {
    11u32
  } else if symbol == 9u32 || symbol == 10u32 || symbol == 12u32 {
    12u32
  } else {
    13u32
  }
}

fn self_host_binary_symbol_is_comparison(symbol: U32) -> Bool {
  symbol == 16u32 || symbol == 18u32 || symbol == 29u32 ||
    symbol == 19u32 || symbol == 30u32 || symbol == 20u32
}

fn self_host_parser_fail_expression(parser: SelfHostParser) -> Unit {
  self_host_parser_fail(
    parser,
    SelfHostParseError::ExpectedExpression(
      self_host_parser_peek(parser),
      self_host_parser_offset(parser),
    ),
  )
}

fn self_host_expression_stops(
  token: SelfHostToken,
  stop_left_brace: Bool,
) -> Bool {
  if token.kind is SelfHostTokenKind::Newline {
    true
  } else {
    let symbol_code = self_host_token_symbol_code(token.kind)
    symbol_code == 25u32 || symbol_code == 1u32 ||
      symbol_code == 5u32 || symbol_code == 3u32 ||
      symbol_code == 17u32 || symbol_code == 15u32 ||
      (symbol_code == 2u32 && stop_left_brace)
  }
}

fn self_host_parse_call_arguments(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<Array<SelfHostExpr>> {
  let arguments = self_host_empty_expressions()
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Option::Some(arguments)
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Option::Some(argument) => {
        arguments.push(argument)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(parser, 1u32) {
          break Option::Some(arguments)
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            break Option::Some(arguments)
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            SelfHostParseError::ExpectedDelimiter(
              "call separator or )",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break Option::None
        }
      }
      Option::None => break Option::None
    }
  }
  result
}

fn self_host_parse_array_expression(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostExpr> {
  let values = self_host_empty_expressions()
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 5u32) {
    return Option::Some(SelfHostExpr::ArrayExpr(values, open_offset))
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Option::Some(value) => {
        values.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(
          parser,
          5u32,
        ) {
          break Option::Some(SelfHostExpr::ArrayExpr(values, open_offset))
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            5u32,
          ) {
            break Option::Some(SelfHostExpr::ArrayExpr(values, open_offset))
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            SelfHostParseError::ExpectedDelimiter(
              "array separator or ]",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break Option::None
        }
      }
      Option::None => break Option::None
    }
  }
  result
}

fn self_host_parse_group_expression(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostExpr> {
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Option::Some(SelfHostExpr::BlockExpr(SelfHostBlock::{
      items: self_host_empty_block_items()
      offset: open_offset
    }))
  } else {
  }
  let first = match self_host_parse_expression_context(parser, 0u32, false) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Option::Some(first)
  } else if !self_host_parser_consume_symbol(
    parser,
    25u32,
  ) {
    self_host_parser_fail(
      parser,
      SelfHostParseError::ExpectedDelimiter(
        "product separator or )",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return Option::None
  } else {
  }
  let values = self_host_empty_expressions()
  values.push(first)
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => match self_host_parse_expression_context(parser, 0u32, false) {
      Option::Some(value) => {
        values.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(parser, 1u32) {
          if values.length() < 2u32 || values.length() > 32u32 {
            self_host_parser_fail(
              parser,
              SelfHostParseError::InvalidProductArity(
                values.length(),
                open_offset,
              ),
            )
            break Option::None
          } else {
            break Option::Some(
              SelfHostExpr::ProductExpr(values, open_offset),
            )
          }
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            if values.length() < 2u32 || values.length() > 32u32 {
              self_host_parser_fail(
                parser,
                SelfHostParseError::InvalidProductArity(
                  values.length(),
                  open_offset,
                ),
              )
              break Option::None
            } else {
              break Option::Some(
                SelfHostExpr::ProductExpr(values, open_offset),
              )
            }
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            SelfHostParseError::ExpectedDelimiter(
              "product separator or )",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break Option::None
        }
      }
      Option::None => break Option::None
    }
  }
  result
}

fn self_host_parse_object_fields(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<Array<SelfHostObjectField>> {
  let fields = self_host_empty_object_fields()
  if self_host_parser_consume_symbol(parser, 3u32) {
    return Option::Some(fields)
  } else {
  }
  if !self_host_parser_consume_newline(parser) {
    self_host_parser_fail(
      parser,
      SelfHostParseError::ExpectedDelimiter(
        "object body newline",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return Option::None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      if self_host_parser_consume_symbol(parser, 3u32) {
        break Option::Some(fields)
      } else {
      }
      let pair = match self_host_parser_identifier(
        parser,
        SelfHostDeclarationExpectation::BindingName,
      ) {
        Option::Some(value) => value
        Option::None => break Option::None
      }
      let (name, offset) = pair
      if !self_host_parser_expect_symbol(
        parser,
        13u32,
        SelfHostDeclarationExpectation::Colon,
      ) {
        break Option::None
      } else {
      }
      match self_host_parse_expression_context(parser, 0u32, false) {
        Option::Some(value) => fields.push(SelfHostObjectField::{
          name: name
          value: value
          offset: offset
        })
        Option::None => break Option::None
      }
      if !self_host_parser_finish_line(parser) {
        break Option::None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      continue 0u32
    }
  }
  result
}

fn self_host_parse_explicit_type_arguments(
  parser: SelfHostParser,
) -> Option<Array<SelfHostTypeExpr>> {
  let arguments = self_host_empty_types()
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => match self_host_parse_type(parser) {
      Option::Some(value) => {
        arguments.push(value)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_type_closer(parser) {
          break Option::Some(arguments)
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_type_closer(parser) {
            break Option::Some(arguments)
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail_expected(
            parser,
            SelfHostDeclarationExpectation::TypeArgumentSeparatorOrClose,
          )
          break Option::None
        }
      }
      Option::None => break Option::None
    }
  }
  result
}

fn self_host_parse_primary(parser: SelfHostParser) -> Option<SelfHostExpr> {
  let token = match self_host_parser_peek(parser) {
    Option::Some(value) => value
    Option::None => {
      self_host_parser_fail_expression(parser)
      return Option::None
    }
  }
  match token.kind {
    SelfHostTokenKind::Newline => {
      self_host_parser_fail_expression(parser)
      Option::None
    }
    SelfHostTokenKind::Error(error) => {
      parser.index = parser.index + 1u32
      self_host_parser_fail(
        parser,
        SelfHostParseError::Lexical(error, token.offset),
      )
      Option::None
    }
    _ => {
      let symbol_code = self_host_token_symbol_code(token.kind)
      if symbol_code == 7u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Option::Some(value) => Option::Some(
            SelfHostExpr::PrefixExpr(
              SelfHostPrefixOperator::Positive,
              value,
              token.offset,
            ),
          )
          Option::None => Option::None
        }
      } else if symbol_code == 8u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Option::Some(value) => Option::Some(
            SelfHostExpr::PrefixExpr(
              SelfHostPrefixOperator::Negative,
              value,
              token.offset,
            ),
          )
          Option::None => Option::None
        }
      } else if symbol_code == 32u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_expression_context(parser, 14u32, true) {
          Option::Some(value) => Option::Some(
            SelfHostExpr::PrefixExpr(
              SelfHostPrefixOperator::LogicalNot,
              value,
              token.offset,
            ),
          )
          Option::None => Option::None
        }
      } else if symbol_code == 0u32 {
        parser.index = parser.index + 1u32
        self_host_parse_group_expression(parser, token.offset)
      } else if symbol_code == 4u32 {
        parser.index = parser.index + 1u32
        self_host_parse_array_expression(parser, token.offset)
      } else if symbol_code == 2u32 {
        parser.index = parser.index + 1u32
        match self_host_parse_object_fields(parser, token.offset) {
          Option::Some(fields) => Option::Some(
            SelfHostExpr::ObjectExpr(fields, token.offset),
          )
          Option::None => Option::None
        }
      } else {
        let keyword_code = self_host_token_keyword_code(token.kind)
        if keyword_code == 0u32 {
          parser.index = parser.index + 1u32
          self_host_parse_lambda_expression(parser, token.offset)
        } else if keyword_code == 14u32 {
          parser.index = parser.index + 1u32
          self_host_parse_if_expression(parser, token.offset)
        } else if keyword_code == 16u32 {
          parser.index = parser.index + 1u32
          self_host_parse_match_expression(parser, token.offset)
        } else if keyword_code == 18u32 {
          parser.index = parser.index + 1u32
          self_host_parse_while_expression(parser, token.offset)
        } else if keyword_code == 7u32 {
          parser.index = parser.index + 1u32
          self_host_parse_for_expression(parser, token.offset)
        } else if keyword_code == 20u32 {
          parser.index = parser.index + 1u32
          let value = match self_host_parser_peek(parser) {
            Option::None => Option::Some(Option::None)
            Option::Some(next) => if self_host_token_kind_is_symbol(
              next.kind,
              3u32,
            ) || next.kind is SelfHostTokenKind::Newline {
              Option::Some(Option::None)
            } else {
              match self_host_parse_expression_context(parser, 0u32, false) {
                Option::Some(expression) => Option::Some(
                  Option::Some(expression),
                )
                Option::None => Option::None
              }
            }
          }
          match value {
            Option::Some(return_value) => Option::Some(
              SelfHostExpr::ReturnExpr(return_value, token.offset),
            )
            Option::None => Option::None
          }
        } else if keyword_code == 22u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_expression_context(parser, 0u32, false) {
            Option::Some(value) => Option::Some(
              SelfHostExpr::BreakExpr(value, token.offset),
            )
            Option::None => Option::None
          }
        } else if keyword_code == 23u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_expression_context(parser, 0u32, false) {
            Option::Some(value) => Option::Some(
              SelfHostExpr::ContinueExpr(value, token.offset),
            )
            Option::None => Option::None
          }
        } else {
          match self_host_token_expression(token) {
            Option::Some(value) => {
              parser.index = parser.index + 1u32
              Option::Some(value)
            }
            Option::None => {
              self_host_parser_fail_expression(parser)
              Option::None
            }
          }
        }
      }
    }
  }
}

fn self_host_parse_expression_context(
  parser: SelfHostParser,
  minimum_precedence: U32,
  stop_left_brace: Bool,
) -> Option<SelfHostExpr> {
  self_host_parser_skip_newlines(parser)
  let mut left = match self_host_parse_primary(parser) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let mut left_comparison = 0u32
  let result = while 0u32 {
    _ => match self_host_parser_peek(parser) {
      Option::None => break Option::Some(left)
      Option::Some(token) => if self_host_expression_stops(
        token,
        stop_left_brace,
      ) {
        break Option::Some(left)
      } else {
        let symbol_code = self_host_token_symbol_code(token.kind)
        if symbol_code == 0u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_call_arguments(parser, token.offset) {
            Option::Some(arguments) => {
              left = SelfHostExpr::CallExpr(left, arguments, token.offset)
              left_comparison = 0u32
              continue 0u32
            }
            Option::None => break Option::None
          }
        } else if symbol_code == 4u32 {
          parser.index = parser.index + 1u32
          let index = match self_host_parse_expression_context(
            parser,
            0u32,
            false,
          ) {
            Option::Some(value) => value
            Option::None => break Option::None
          }
          self_host_parser_skip_newlines(parser)
          if !self_host_parser_consume_symbol(parser, 5u32) {
            self_host_parser_fail(
              parser,
              SelfHostParseError::ExpectedDelimiter(
                "]",
                self_host_parser_peek(parser),
                token.offset,
              ),
            )
            break Option::None
          }
          left = SelfHostExpr::IndexExpr(left, index, token.offset)
          left_comparison = 0u32
          continue 0u32
        } else if symbol_code == 27u32 {
          parser.index = parser.index + 1u32
          self_host_parser_skip_newlines(parser)
          match self_host_parser_identifier(
            parser,
            SelfHostDeclarationExpectation::BindingName,
          ) {
            Option::Some(pair) => {
              let (name, _name_offset) = pair
              left = match left {
                SelfHostExpr::ImportAliasExpr(_, _) =>
                  SelfHostExpr::QualifiedExpr(left, name, token.offset)
                _ => SelfHostExpr::FieldExpr(left, name, token.offset)
              }
              left_comparison = 0u32
              continue 0u32
            }
            Option::None => break Option::None
          }
        } else if symbol_code == 14u32 {
          parser.index = parser.index + 1u32
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(parser, 2u32) {
            match self_host_parse_object_fields(parser, token.offset) {
              Option::Some(fields) => {
                left = SelfHostExpr::ConstructExpr(left, fields, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              Option::None => break Option::None
            }
          } else if self_host_parser_consume_symbol(parser, 29u32) {
            let type_arguments = match self_host_parse_explicit_type_arguments(
              parser,
            ) {
              Option::Some(value) => value
              Option::None => break Option::None
            }
            self_host_parser_skip_newlines(parser)
            let call_offset = self_host_parser_offset(parser)
            if !self_host_parser_consume_symbol(parser, 0u32) {
              self_host_parser_fail(
                parser,
                SelfHostParseError::ExpectedDelimiter(
                  "explicit type call (",
                  self_host_parser_peek(parser),
                  call_offset,
                ),
              )
              break Option::None
            }
            match self_host_parse_call_arguments(parser, call_offset) {
              Option::Some(arguments) => {
                left = SelfHostExpr::ExplicitTypeCallExpr(
                  left,
                  type_arguments,
                  arguments,
                  call_offset,
                )
                left_comparison = 0u32
                continue 0u32
              }
              Option::None => break Option::None
            }
          } else {
            match self_host_parser_identifier(
              parser,
              SelfHostDeclarationExpectation::BindingName,
            ) {
              Option::Some(pair) => {
                let (name, _name_offset) = pair
                left = SelfHostExpr::QualifiedExpr(left, name, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              Option::None => break Option::None
            }
          }
        } else {
          let keyword_code = self_host_token_keyword_code(token.kind)
          if keyword_code == 17u32 {
            if 8u32 < minimum_precedence {
              break Option::Some(left)
            }
            parser.index = parser.index + 1u32
            match self_host_parse_pattern_context(
              parser,
              false,
              stop_left_brace,
            ) {
              Option::Some(pattern) => {
                left = SelfHostExpr::IsExpr(left, pattern, token.offset)
                left_comparison = 0u32
                continue 0u32
              }
              Option::None => break Option::None
            }
          } else {
            match self_host_binary_operator(symbol_code) {
              Option::Some(operator) => {
                let precedence = self_host_binary_symbol_precedence(symbol_code)
                let comparison = self_host_binary_symbol_is_comparison(
                  symbol_code,
                )
                if precedence < minimum_precedence {
                  break Option::Some(left)
                } else if comparison && left_comparison != 0u32 {
                  self_host_parser_fail(
                    parser,
                    SelfHostParseError::ChainedComparison(token.offset),
                  )
                  break Option::None
                }
                parser.index = parser.index + 1u32
                let next_precedence = if symbol_code == 11u32 {
                  precedence
                } else {
                  precedence + 1u32
                }
                match self_host_parse_expression_context(
                  parser,
                  next_precedence,
                  stop_left_brace,
                ) {
                  Option::Some(right) => {
                    if symbol_code == 23u32 && stop_left_brace {
                      let original_left = left
                      left = match left {
                        SelfHostExpr::IsExpr(
                          scrutinee,
                          pattern,
                          is_offset,
                        ) => SelfHostExpr::IsGuardExpr(
                          scrutinee,
                          pattern,
                          right,
                          is_offset,
                        )
                        SelfHostExpr::IsGuardExpr(
                          scrutinee,
                          pattern,
                          existing,
                          is_offset,
                        ) => SelfHostExpr::IsGuardExpr(
                          scrutinee,
                          pattern,
                          SelfHostExpr::BinaryExpr(
                            SelfHostBinaryOperator::LogicalAnd,
                            existing,
                            right,
                            token.offset,
                          ),
                          is_offset,
                        )
                        _ => SelfHostExpr::BinaryExpr(
                          operator,
                          original_left,
                          right,
                          token.offset,
                        )
                      }
                    } else {
                      left = SelfHostExpr::BinaryExpr(
                        operator,
                        left,
                        right,
                        token.offset,
                      )
                    }
                    left_comparison = if comparison {
                      1u32
                    } else {
                      0u32
                    }
                    continue 0u32
                  }
                  Option::None => break Option::None
                }
              }
              Option::None => break Option::Some(left)
            }
          }
        }
      }
    }
  }
  result
}

pub fn self_host_parse_expression_source(
  source: Bytes,
) -> Result<SelfHostExpr, SelfHostParseError> {
  let parser = self_host_parser_new(source)
  match self_host_parse_expression_context(parser, 0u32, false) {
    Option::Some(expression) => {
      self_host_parser_skip_newlines(parser)
      if parser.index != parser.tokens.length() {
        self_host_parser_fail(
          parser,
          SelfHostParseError::ExpectedDelimiter(
            "end of expression",
            self_host_parser_peek(parser),
            self_host_parser_offset(parser),
          ),
        )
      } else {
      }
      match parser.diagnostic {
        Option::Some(diagnostic) => Result::Err(diagnostic.error)
        Option::None => Result::Ok(expression)
      }
    }
    Option::None => match parser.diagnostic {
      Option::Some(diagnostic) => Result::Err(diagnostic.error)
      Option::None => Result::Err(
        SelfHostParseError::ExpectedExpression(Option::None, 0u32),
      )
    }
  }
}

  DeclarationKeyword
  ImportPathSegment
  ImportAlias
  ImportWildcard
  BuiltinName
  BindingName
  TraitName
  StructName
  StructFieldName
  StructBodyNewline
  EnumName
  TypeAliasName
  EnumBodyNewline
  EnumVariantName
  EnumVariantPayloadOrLineEnd
  EnumVariantBodyNewline
  EnumVariantFieldName
  VariantTypeSeparatorOrClose
  FunctionName
  TestName
  TestExpectedTrap
  FunctionBodyNewline
  ImplMemberKeyword
  ForeignTypeName
  ForeignLibraryName
  ForeignLibraryAlias
  ForeignLibraryMemberKeyword
  ForeignLibraryExportName
  ForOrLeftBrace
  TraitMethodKeyword
  TraitMethodName
  TraitBodyNewline
  TypeParameter
  TypeParameterSeparatorOrClose
  TypeBound
  DeriveName
  DeriveSeparatorOrClose
  TypeArgumentSeparatorOrClose
  LeftParen
  LeftBrace
  ParameterName
  Colon
  ParameterSeparatorOrClose
  Type
  Arrow
  Equal
  BuiltinString
  LineEnd
}

pub enum SelfHostParseError {
  ExpectedDeclaration(SelfHostDeclarationExpectation, Option<SelfHostToken>, U32)
  ExpectedExpression(Option<SelfHostToken>, U32)
  ExpectedPattern(Option<SelfHostToken>, U32)
  Lexical(SelfHostLexError, U32)
  ImportAfterDeclaration(U32)
  ReceiverMustBeFirst(U32)
  InvalidReceiverType(SelfHostTypeExpr, U32)
  UnexpectedTypeCloser(U32)
  UnclosedTrait(U32)
  UnclosedFunction(U32)
  UnclosedImpl(U32)
  UnclosedStruct(U32)
  UnclosedEnum(U32)
  UnclosedTupleVariant(U32)
  UnclosedStructVariant(U32)
  EmptyTupleVariant(U32)
  InvalidProductTypeArity(U32, U32)
  UnclosedProductType(U32)
  PublicImplNotAllowed(U32)
  ForeignImplRequiresTrait(U32)
  PublicForeignLibraryNotAllowed(U32)
  PublicForeignLibraryMemberNotAllowed(U32)
  GenericForeignLibraryMemberNotAllowed(U32)
  ReceiverForeignLibraryMemberNotAllowed(U32)
  ForeignLibraryMemberBodyNotAllowed(U32)
  ExpectedDelimiter(String, Option<SelfHostToken>, U32)
  UnclosedExpression(String, U32)
  ChainedComparison(U32)
  InvalidProductArity(U32, U32)
  RestPatternNotAllowed(U32)
  DuplicateRestPattern(U32)
  EmptyTuplePattern(U32)
  UsingDoubleDispose(String, U32)
  UsingValueEscape(String, U32)
}

impl SelfHostParseError {
  fn offset(self) -> U32 {
    match self {
      ExpectedDeclaration(_, _, offset) => offset
      ExpectedExpression(_, offset) => offset
      ExpectedPattern(_, offset) => offset
      Lexical(_, offset) => offset
      ImportAfterDeclaration(offset) => offset
      ReceiverMustBeFirst(offset) => offset
      InvalidReceiverType(_, offset) => offset
      UnexpectedTypeCloser(offset) => offset
      UnclosedTrait(offset) => offset
      UnclosedFunction(offset) => offset
      UnclosedImpl(offset) => offset
      UnclosedStruct(offset) => offset
      UnclosedEnum(offset) => offset
      UnclosedTupleVariant(offset) => offset
      UnclosedStructVariant(offset) => offset
      EmptyTupleVariant(offset) => offset
      InvalidProductTypeArity(_, offset) => offset
      UnclosedProductType(offset) => offset
      PublicImplNotAllowed(offset) => offset
      ForeignImplRequiresTrait(offset) => offset
      PublicForeignLibraryNotAllowed(offset) => offset
      PublicForeignLibraryMemberNotAllowed(offset) => offset
      GenericForeignLibraryMemberNotAllowed(offset) => offset
      ReceiverForeignLibraryMemberNotAllowed(offset) => offset
      ForeignLibraryMemberBodyNotAllowed(offset) => offset
      ExpectedDelimiter(_, _, offset) => offset
      UnclosedExpression(_, offset) => offset
      ChainedComparison(offset) => offset
      InvalidProductArity(_, offset) => offset
      RestPatternNotAllowed(offset) => offset
      DuplicateRestPattern(offset) => offset
      EmptyTuplePattern(offset) => offset
      UsingDoubleDispose(_, offset) => offset
      UsingValueEscape(_, offset) => offset
    }
  }
}

fn self_host_parse_error_kind(error: SelfHostParseError) -> U32 {
  if error is ExpectedDeclaration(_, _, _) {
    0u32
  } else if error is ExpectedExpression(_, _) {
    1u32
  } else if error is ExpectedPattern(_, _) {
    2u32
  } else if error is Lexical(_, _) {
    3u32
  } else if error is ImportAfterDeclaration(_) {
    4u32
  } else {
    5u32
  }
}

pub enum SelfHostDiagnosticSeverity {
  Error
  Warning
  Info
  Hint
}

pub struct SelfHostParseDiagnostic {
  severity: SelfHostDiagnosticSeverity
  error: SelfHostParseError
}

pub enum SelfHostParseEvent {
  Declaration(SelfHostDeclaration, U32)
  Diagnostic(SelfHostDiagnosticSeverity, SelfHostParseError, U32, U32, U32, String)
}

pub struct SelfHostParsedModule {
  events: Array<SelfHostParseEvent>
}

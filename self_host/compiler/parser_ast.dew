open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.string

// This helper keeps the Array element type visible at each pop call.
// The backend uses the type argument as compile-time carrier proof.
fn self_host_array_pop<t>(values: Array<t>) -> Option<t> {
  let length = values.length()
  if length == 0u32 {
    None
  } else {
    let index = length - 1u32
    let value = values.get_unchecked(index)
    values.truncate(index)
    Some(value)
  }
}

pub enum SelfHostDeclarationVisibility {
  ModuleVisible
  Public
}

pub enum SelfHostPrefixOperator {
  Positive
  Negative
  LogicalNot
}

pub enum SelfHostBinaryOperator {
  LogicalOr
  LogicalAnd
  BitOr
  BitXor
  BitAnd
  Equal
  NotEqual
  Less
  LessEqual
  Greater
  GreaterEqual
  ShiftLeft
  ShiftRight
  Add
  Subtract
  Multiply
  Divide
  Remainder
  Exponentiate
}

pub enum SelfHostTypeExpr {
  NamedType(String, U32)
  QualifiedType(String, String, U32, U32)
  ProductType(Array<SelfHostTypeExpr>, U32)
  AppliedType(SelfHostTypeExpr, Array<SelfHostTypeExpr>, U32)
  FunctionType(Array<SelfHostTypeExpr>, SelfHostTypeExpr, U32)
  ComputedType(SelfHostTypeExpr, Bytes, U32)
}

impl SelfHostTypeExpr {
  fn offset(self) -> U32 {
    match self {
      NamedType(_, offset) => offset
      QualifiedType(_, _, offset, _) => offset
      ProductType(_, offset) => offset
      AppliedType(_, _, offset) => offset
      FunctionType(_, _, offset) => offset
      ComputedType(_, _, offset) => offset
    }
  }
}

pub struct SelfHostTypeParameter {
  name: String
  bounds: Array<SelfHostTypeExpr>
  offset: U32
}

impl SelfHostTypeParameter {
  fn bound_count(self) -> U32 {
    self.bounds.length()
  }

  fn bound_at(self, index: U32) -> SelfHostTypeExpr {
    self.bounds[index]
  }
}

pub struct SelfHostDeriveRequest {
  name: String
  offset: U32
}

fn self_host_derive_request_name_at(
  values: Array<SelfHostDeriveRequest>,
  index: U32,
) -> String {
  self_host_assert_array_index(
    index,
    values.length(),
    "compiler derive-request index is outside the parser arena",
  )
  values[index].name
}

fn self_host_derive_request_offset_at(
  values: Array<SelfHostDeriveRequest>,
  index: U32,
) -> U32 {
  self_host_assert_array_index(
    index,
    values.length(),
    "compiler derive-request index is outside the parser arena",
  )
  values[index].offset
}


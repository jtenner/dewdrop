pub enum SelfHostPattern {
  WildcardPattern(U32)
  BindingPattern(String, U32)
  ImportAliasPattern(String, U32)
  RestPattern(U32)
  LiteralPattern(SelfHostExpr, U32)
  QualifiedPattern(SelfHostPattern, String, U32)
  TuplePattern(SelfHostPattern, Array<SelfHostPattern>, U32)
  ProductPattern(Array<SelfHostPattern>, U32)
  StructPattern(SelfHostPattern, Array<SelfHostPatternField>, Option<U32>, U32)
  AlternativePattern(SelfHostPattern, Array<SelfHostPattern>, U32)
}

impl SelfHostPattern {
  fn offset(self) -> U32 {
    match self {
      WildcardPattern(offset) => offset
      BindingPattern(_, offset) => offset
      ImportAliasPattern(_, offset) => offset
      RestPattern(offset) => offset
      LiteralPattern(_, offset) => offset
      QualifiedPattern(_, _, offset) => offset
      TuplePattern(_, _, offset) => offset
      ProductPattern(_, offset) => offset
      StructPattern(_, _, _, offset) => offset
      AlternativePattern(_, _, offset) => offset
    }
  }
}

pub struct SelfHostPatternArm {
  pattern: SelfHostPattern
  guard_condition: Option<SelfHostExpr>
  body: SelfHostExpr
  offset: U32
}

pub enum SelfHostExpr {
  I8Expr(U64, U32)
  I16Expr(U64, U32)
  I32Expr(U64, U32)
  I64Expr(U64, U32)
  U8Expr(U64, U32)
  U16Expr(U64, U32)
  U32Expr(U64, U32)
  U64Expr(U64, U32)
  F32Expr(F32, U32)
  F64Expr(F64, U32)
  BoolExpr(Bool, U32)
  StringExpr(Bytes, U32)
  BytesExpr(Bytes, U32)
  NameExpr(String, U32)
  ImportAliasExpr(String, U32)
  ProductExpr(Array<SelfHostExpr>, U32)
  ArrayExpr(Array<SelfHostExpr>, U32)
  LambdaExpr(Array<SelfHostFnParameter>, SelfHostTypeExpr, SelfHostBlock, U32)
  ObjectExpr(Array<SelfHostObjectField>, U32)
  ConstructExpr(SelfHostExpr, Array<SelfHostObjectField>, U32)
  BlockExpr(SelfHostBlock)
  IfExpr(SelfHostExpr, SelfHostBlock, Option<SelfHostExpr>, U32)
  MatchExpr(SelfHostExpr, Array<SelfHostPatternArm>, U32)
  IsExpr(SelfHostExpr, SelfHostPattern, U32)
  IsGuardExpr(SelfHostExpr, SelfHostPattern, SelfHostExpr, U32)
  WhileExpr(SelfHostExpr, Array<SelfHostPatternArm>, U32)
  ReturnExpr(Option<SelfHostExpr>, U32)
  BreakExpr(SelfHostExpr, U32)
  ContinueExpr(SelfHostExpr, U32)
  PrefixExpr(SelfHostPrefixOperator, SelfHostExpr, U32)
  BinaryExpr(SelfHostBinaryOperator, SelfHostExpr, SelfHostExpr, U32)
  CallExpr(SelfHostExpr, Array<SelfHostExpr>, U32)
  ExplicitTypeCallExpr(SelfHostExpr, Array<SelfHostTypeExpr>, Array<SelfHostExpr>, U32)
  FieldExpr(SelfHostExpr, String, U32)
  QualifiedExpr(SelfHostExpr, String, U32)
  ProductFieldExpr(SelfHostExpr, U32, U32, U32)
  IndexExpr(SelfHostExpr, SelfHostExpr, U32)
}

impl SelfHostExpr {
  fn offset(self) -> U32 {
    match self {
      I8Expr(_, offset) => offset
      I16Expr(_, offset) => offset
      I32Expr(_, offset) => offset
      I64Expr(_, offset) => offset
      U8Expr(_, offset) => offset
      U16Expr(_, offset) => offset
      U32Expr(_, offset) => offset
      U64Expr(_, offset) => offset
      F32Expr(_, offset) => offset
      F64Expr(_, offset) => offset
      BoolExpr(_, offset) => offset
      StringExpr(_, offset) => offset
      BytesExpr(_, offset) => offset
      NameExpr(_, offset) => offset
      ImportAliasExpr(_, offset) => offset
      ProductExpr(_, offset) => offset
      ArrayExpr(_, offset) => offset
      LambdaExpr(_, _, _, offset) => offset
      ObjectExpr(_, offset) => offset
      ConstructExpr(_, _, offset) => offset
      BlockExpr(block) => block.offset
      IfExpr(_, _, _, offset) => offset
      MatchExpr(_, _, offset) => offset
      IsExpr(_, _, offset) => offset
      IsGuardExpr(_, _, _, offset) => offset
      WhileExpr(_, _, offset) => offset
      ReturnExpr(_, offset) => offset
      BreakExpr(_, offset) => offset
      ContinueExpr(_, offset) => offset
      PrefixExpr(_, _, offset) => offset
      BinaryExpr(_, _, _, offset) => offset
      CallExpr(_, _, offset) => offset
      ExplicitTypeCallExpr(_, _, _, offset) => offset
      FieldExpr(_, _, offset) => offset
      QualifiedExpr(_, _, offset) => offset
      ProductFieldExpr(_, _, _, offset) => offset
      IndexExpr(_, _, offset) => offset
    }
  }
}

pub struct SelfHostBlockItem {
  kind: U32
  type_binding: Option<SelfHostTypeExpr>
  mutable_: Bool
  name: String
  name_offset: U32
  target: SelfHostExpr
  value: SelfHostExpr
  offset: U32
}

fn self_host_let_block_item(
  mutable_: Bool,
  name: String,
  name_offset: U32,
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostBlockItem {
  {
    kind: 0u32
    type_binding: None
    mutable_: mutable_
    name: name
    name_offset: name_offset
    target: value
    value: value
    offset: offset
  }
}

fn self_host_assignment_block_item(
  target: SelfHostExpr,
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostBlockItem {
  {
    kind: 1u32
    type_binding: None
    mutable_: false
    name: ""
    name_offset: offset
    target: target
    value: value
    offset: offset
  }
}

fn self_host_index_set_block_item(
  target: SelfHostExpr,
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostBlockItem {
  {
    kind: 2u32
    type_binding: None
    mutable_: false
    name: ""
    name_offset: offset
    target: target
    value: value
    offset: offset
  }
}

fn self_host_expression_block_item(
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostBlockItem {
  {
    kind: 3u32
    type_binding: None
    mutable_: false
    name: ""
    name_offset: offset
    target: value
    value: value
    offset: offset
  }
}

fn self_host_block_item_is_let(item: SelfHostBlockItem) -> Bool {
  self_host_u32_equal(item.kind, 0u32)
}

fn self_host_type_binding_block_item(name: String, type_: SelfHostTypeExpr, offset: U32) -> SelfHostBlockItem {
  {
    kind: 4u32
    type_binding: Some(type_)
    mutable_: false
    name: name
    name_offset: offset
    target: BoolExpr(false, offset)
    value: BoolExpr(false, offset)
    offset: offset
  }
}

fn self_host_block_item_is_assignment(item: SelfHostBlockItem) -> Bool {
  self_host_u32_equal(item.kind, 1u32)
}

fn self_host_block_item_is_index_set(item: SelfHostBlockItem) -> Bool {
  self_host_u32_equal(item.kind, 2u32)
}

fn self_host_block_item_is_expression(item: SelfHostBlockItem) -> Bool {
  self_host_u32_equal(item.kind, 3u32)
}


open dew.std.array
open dew.std.bytes
open dew.std.map
open dew.std.option

pub struct SelfHostCompileTimeInstance {
  declaration: U64
  evidence_types: Array<SelfHostSpecializationEvidenceType>
  module_: SelfHostPlannedModuleLowering
  guarded_evidence: Map<U32, Array<SelfHostCompileTimeTraitWitness>>
}

fn self_host_empty_guarded_evidence() -> Map<U32, Array<SelfHostCompileTimeTraitWitness>> {
  Map::empty()
}

pub struct SelfHostCompileTimeProgramContext {
  frozen: SelfHostFrozenSignatureProgram
  targets: Map<U64, Bytes>
  sensitive: Map<U64, Bool>
  // Runtime adapters may need logical keys without compile-time branch work.
  logical_arguments: Map<U64, Bool>
  instances: Map<U32, SelfHostCompileTimeInstance>
  diagnostics: Array<String>
}

fn self_host_compile_time_target_map() -> Map<U64, Bytes> {
  Map::empty()
}

fn self_host_compile_time_caller_map() -> Map<U64, Array<U64>> {
  Map::empty()
}

fn self_host_compile_time_instance_map() -> Map<U32, SelfHostCompileTimeInstance> {
  Map::empty()
}

// Request indices belong to one specialization run. Frozen source facts may be
// shared, but selected bodies and diagnostics must not change an earlier plan.
fn self_host_compile_time_planning_lowering(lowering: SelfHostPlannedProgramLowering) -> SelfHostPlannedProgramLowering {
  let source = lowering.compile_time
  let diagnostics = source.diagnostics.copy()
  let sensitive = self_host_empty_u64_bool_map()
  for module_ in lowering.modules {
    for callable in module_.functions.callables {
      if source.sensitive.contains_key(callable.declaration) {
        sensitive.set(callable.declaration, true)
      }
    }
  }
  let context = SelfHostCompileTimeProgramContext::{
    frozen: source.frozen
    targets: source.targets
    sensitive: sensitive
    logical_arguments: source.logical_arguments
    instances: self_host_compile_time_instance_map()
    diagnostics: diagnostics
  }
  SelfHostPlannedProgramLowering::{
    raw_arrays: lowering.raw_arrays
    collected: lowering.collected
    modules: lowering.modules
    index: lowering.index
    graph: lowering.graph
    elided_trait_wrappers: lowering.elided_trait_wrappers
    compile_time: context
  }
}

fn self_host_empty_compile_time_owners() -> Array<U64> {
  []
}

fn self_host_is_compile_time_builtin(name: Bytes) -> Bool {
  self_host_compile_time_type_query_arity(name) is Option::Some(_) ||
  self_host_computed_type_builtin(name) || name == b"types.static_assert"
}

fn self_host_compile_time_program_context(frozen: SelfHostFrozenSignatureProgram, modules: Array<SelfHostPlannedModuleLowering>) -> SelfHostCompileTimeProgramContext {
  let targets = self_host_compile_time_target_map()
  let sensitive = self_host_empty_u64_bool_map()
  let callers = self_host_compile_time_caller_map()
  let work = self_host_empty_compile_time_owners()
  let logical_arguments = self_host_empty_u64_bool_map()
  let logical_work = self_host_empty_compile_time_owners()
  let mut module_index = 0u32
  for module_ in modules {
    let projections = self_host_query_module_has_projections(module_)
    if projections {
      let collected = frozen.collected.modules.at(module_index)
      for body in module_.bodies {
        for expression in self_host_compile_time_owned_expressions(module_, body) {
          match self_host_query_binding_type(collected, module_, expression) {
            Option::Some(type_) => if self_host_query_has_projection(module_, -self_host_body_u32_to_i32(type_) - 2i32) && !sensitive.contains_key(body.declaration) {
              sensitive.set(body.declaration, true)
              work.push(body.declaration)
            }
            Option::None => {}
          }
        }
      }
    }
    for callable in module_.functions.callables {
      if projections && self_host_query_projected_signature(module_, callable) && !sensitive.contains_key(callable.declaration) {
        sensitive.set(callable.declaration, true)
        work.push(callable.declaration)
      }
      match callable.kind {
        SelfHostPlannedCallableKind::PlannedBuiltinCallable(name) => if self_host_is_compile_time_builtin(name) {
          targets.set(callable.declaration, name)
        } else if name.starts_with(b"dew_map_") && !logical_arguments.contains_key(callable.declaration) {
          // These remaining runtime adapters consume logical key identity:
          // String equality is not the same operation as eqref identity.
          // Keep that identity through ordinary generic forwarding bodies.
          logical_arguments.set(callable.declaration, true)
          logical_work.push(callable.declaration)
        }
        _ => {}
      }
    }
    module_index = module_index + 1u32
  }
  if targets.length() > 0u32 || sensitive.length() > 0u32 || logical_arguments.length() > 0u32 {
    for module_ in modules {
      let projections = self_host_query_module_has_projections(module_)
      for body in module_.bodies {
        let owned = self_host_compile_time_owned_expressions(module_, body)
        let _ = while 0u32 {
          offset => if offset < owned.length() {
            let expression = module_.expressions[owned[offset]]
            if projections && self_host_query_has_projection(module_, expression.type_) && !sensitive.contains_key(body.declaration) {
              sensitive.set(body.declaration, true)
              work.push(body.declaration)
            }
            match self_host_program_specialization_call_recipe(expression) {
              Option::Some(recipe) => {
                if targets.contains_key(recipe.target) && !sensitive.contains_key(body.declaration) {
                  sensitive.set(body.declaration, true)
                  work.push(body.declaration)
                }
                match callers.get(recipe.target) {
                  Option::Some(values) => values.push(body.declaration)
                  Option::None => callers.set(recipe.target, [body.declaration])
                }
              }
              Option::None => {}
            }
            continue offset + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
    }
  }
  self_host_compile_time_mark_callers(callers, sensitive, work)
  self_host_compile_time_mark_callers(callers, logical_arguments, logical_work)
  SelfHostCompileTimeProgramContext::{
    frozen: frozen
    targets: targets
    sensitive: sensitive
    logical_arguments: logical_arguments
    instances: self_host_compile_time_instance_map()
    diagnostics: []
  }
}

fn self_host_compile_time_mark_callers(callers: Map<U64, Array<U64>>, sensitive: Map<U64, Bool>, work: Array<U64>) -> Unit {
  let _ = while work.length() {
    length => if length > 0u32 {
      let target = work[length - 1u32]
      work.truncate(length - 1u32)
      match callers.get(target) {
        Option::Some(values) => for caller in values {
          if !sensitive.contains_key(caller) {
            sensitive.set(caller, true)
            work.push(caller)
          }
        }
        Option::None => {}
      }
      continue work.length()
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_compile_time_evidence_type(value: SelfHostSpecializationEvidenceType) -> SelfHostCompileTimeType {
  match value {
    SelfHostSpecializationEvidenceType::UnknownSpecializationEvidenceType => SelfHostCompileTimeType::UnknownCompileTimeType
    SelfHostSpecializationEvidenceType::PrimitiveSpecializationEvidenceType(value) => SelfHostCompileTimeType::PrimitiveCompileTimeType(value)
    SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(value) => SelfHostCompileTimeType::NominalCompileTimeType(value)
    SelfHostSpecializationEvidenceType::StructuralSpecializationEvidenceType(value) => value
  }
}

fn self_host_compile_time_to_evidence_type(value: SelfHostCompileTimeType) -> SelfHostSpecializationEvidenceType {
  match value {
    SelfHostCompileTimeType::PrimitiveCompileTimeType(value) => SelfHostSpecializationEvidenceType::PrimitiveSpecializationEvidenceType(value)
    SelfHostCompileTimeType::NominalCompileTimeType(value) => SelfHostSpecializationEvidenceType::NominalSpecializationEvidenceType(value)
    _ => SelfHostSpecializationEvidenceType::StructuralSpecializationEvidenceType(value)
  }
}

fn self_host_compile_time_caller_bindings(caller: Option<SelfHostPlannedCallable>, specialization: U32, requests: Array<SelfHostProgramSpecializationRequest>) -> SelfHostCompileTimeBindings {
  let bindings = self_host_empty_compile_time_bindings()
  if specialization < requests.length() {
    let request = requests[specialization]
    match caller {
      Option::Some(callable) => if callable.declaration == request.declaration {
        let parameters = self_host_program_specialization_callable_generics(callable)
        let _ = while 0u32 {
          offset => if offset < parameters.length && offset < request.evidence_types.length() {
            bindings.parameters.set(self_host_make_semantic_id(parameters.module_id, parameters.local(offset)), self_host_compile_time_evidence_type(request.evidence_types[offset]))
            continue offset + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
  }
  bindings
}

open dew.std.testing
open dew.std.string_builder

fn self_host_generic_raw_builtin_test_link(source: Bytes) -> SelfHostPlannedProgramWasmGCLink {
  let collected = self_host_collect_program_manifest(5110u64, {
    modules: [{
      path: "app.main"
      files: [{
        path: "main.dew"
        source: source
        test_only: false
      }]
    }]
  })
  assert(collected.diagnostics.length() == 0u32, "generic raw builtin manifest parses")
  assert(collected.modules.at(0u32).diagnostic_count() == 0u32, "generic raw builtin source parses and collects")
  let lowering = self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(collected))
  for value in lowering.modules {
    let module_ = self_host_planned_module_lowering_identity(value)
    if module_.inferred.diagnostics.length() > 0u32 {
      let diagnostic = module_.inferred.diagnostics[0u32]
      let report = StringBuilder::new()
      report.append("generic raw builtin inference diagnostic: ")
      report.append(self_host_inference_diagnostic_name(diagnostic))
      report.append(" offset=")
      report.append_u32(diagnostic.offset())
      assert(false, report.finish())
    }
  }
  self_host_plan_program_wasmgc_link(self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, false)), false)
}

test "generic raw reference equality uses concrete direct and outlined signatures" {
  let link = self_host_generic_raw_builtin_test_link(
    b"builtin same<a, b>(left: a, right: b) -> Bool = \"ref.eq\"\npub fn main(left: String, right: Bytes) -> Bool {\n  same(left, right)\n}\npub fn callback() -> fn(String, Bytes) -> Bool {\n  same\n}\n",
  )
  assert(link.diagnostics.length() == 0u32, "generic raw builtin links")
  match build_self_host_linked_i32_module(link, 5110u64) {
    Ok(_) => {}
    Err(error) => assert(false, error)
  }
}

test "generic raw reference equality accepts closure reference operands" {
  let link = self_host_generic_raw_builtin_test_link(
    b"builtin same<a, b>(left: a, right: b) -> Bool = \"ref.eq\"\npub fn main(left: fn(I32) -> I32, right: fn(U32) -> U32) -> Bool {\n  same(left, right)\n}\n",
  )
  assert(link.diagnostics.length() == 0u32, "generic raw builtin links")
  match build_self_host_linked_i32_module(link, 5110u64) {
    Ok(_) => {}
    Err(error) => assert(false, error)
  }
}

test "generic numeric builtin keeps its concrete instruction signature" {
  let link = self_host_generic_raw_builtin_test_link(
    b"builtin plus<t>(left: t, right: t) -> t = \"i32.add\"\npub fn main() -> I32 {\n  plus(20i32, 22i32)\n}\n",
  )
  assert(link.diagnostics.length() == 0u32, "generic raw builtin links")
  match build_self_host_linked_i32_module(link, 5110u64) {
    Ok(_) => {}
    Err(error) => assert(false, error)
  }
}

test "generic raw builtin rejects scalar references and wrong results" {
  for source in [
    b"builtin same<a, b>(left: a, right: b) -> Bool = \"ref.eq\"\npub fn main() -> Bool {\n  same(1i32, 2i32)\n}\n",
    b"builtin same<a, b>(left: a, right: b) -> Bool = \"ref.eq\"\npub fn main(value: String) -> Bool {\n  same(value, 2i64)\n}\n",
    b"builtin same<a, b>(left: a, right: b) -> I64 = \"ref.eq\"\npub fn main(left: String, right: Bytes) -> I64 {\n  same(left, right)\n}\n",
    b"builtin plus<t>(left: t, right: t) -> t = \"i32.add\"\npub fn main() -> I64 {\n  plus(20i64, 22i64)\n}\n"
  ] {
    let link = self_host_generic_raw_builtin_test_link(source)
    match build_self_host_linked_i32_module(link, 5110u64) {
      Ok(_) => assert(false, "generic raw builtin accepted an invalid concrete signature")
      Err(error) => assert(error.contains("raw intrinsic input or result carrier does not match its opcode"), error)
    }
  }
}

test "generic raw builtin rejects wrong operand counts" {
  let link = self_host_generic_raw_builtin_test_link(
    b"builtin same<t>(value: t) -> Bool = \"ref.eq\"\npub fn main(value: String) -> Bool {\n  same(value)\n}\n",
  )
  match build_self_host_linked_i32_module(link, 5110u64) {
    Ok(_) => assert(false, "generic raw builtin accepted a wrong operand count")
    Err(error) => assert(error.contains("raw intrinsic operand count does not match its opcode"), error)
  }
}

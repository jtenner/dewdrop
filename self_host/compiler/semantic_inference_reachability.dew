open dew.std.array
open dew.std.map
open dew.std.option

// Copy source storage, but keep every semantic ID and the frozen name arena.
fn self_host_clone_selected_source(source: SelfHostCollectedModule) -> SelfHostCollectedModule {
  SelfHostCollectedModule::{
    module_id: source.module_id
    files: source.files
    file_paths: source.file_paths
    file_sources: source.file_sources
    test_files: source.test_files
    declaration_files: source.declaration_files
    body_files: source.body_files
    names: source.names
    declarations: source.declarations
    methods: source.methods
    declaration_locations: source.declaration_locations
    fields: source.fields
    variants: source.variants
    generic_parameters: source.generic_parameters
    parameters: source.parameters
    generic_parameter_spans: source.generic_parameter_spans
    generic_bounds: source.generic_bounds
    parameter_spans: source.parameter_spans
    callables: source.callables
    tests: source.tests
    imports: source.imports
    builtins: source.builtins
    lets: source.lets
    aliases: source.aliases
    derives: source.derives
    impls: source.impls
    foreign_types: source.foreign_types
    foreign_libraries: source.foreign_libraries
    foreign_functions: source.foreign_functions
    type_syntax: source.type_syntax
    type_syntax_files: source.type_syntax_files
    type_arguments: source.type_arguments
    lambda_parameters: source.lambda_parameters
    lambda_parameter_files: source.lambda_parameter_files
    lambdas: source.lambdas
    bodies: source.bodies
    body_by_declaration: source.body_by_declaration
    expressions: source.expressions.copy()
    expression_files: source.expression_files
    expression_children: source.expression_children
    explicit_call_type_argument_spans: source.explicit_call_type_argument_spans
    explicit_call_type_arguments: source.explicit_call_type_arguments
    blocks: source.blocks.copy()
    block_files: source.block_files
    block_items: source.block_items
    block_item_files: source.block_item_files
    object_fields: source.object_fields
    object_field_files: source.object_field_files
    patterns: source.patterns
    pattern_files: source.pattern_files
    pattern_children: source.pattern_children
    pattern_fields: source.pattern_fields
    pattern_field_files: source.pattern_field_files
    pattern_arms: source.pattern_arms
    pattern_arm_files: source.pattern_arm_files
    arm_children: source.arm_children
    diagnostics: source.diagnostics
    name_lookup: source.name_lookup
    type_bindings: source.type_bindings
    trait_bindings: source.trait_bindings
    value_bindings: source.value_bindings
    value_binding_candidates: source.value_binding_candidates
    foreign_library_by_alias: source.foreign_library_by_alias
  }
}

fn self_host_clear_inference_span(span: SelfHostHirSpan, arena: Array<Bool>) -> Unit {
  self_host_assert_array_span(span.start, span.length, arena.length(), "ARN-101 selected inference owner")
  let _ = while 0u32 {
    index => if index < span.length {
      arena[span.start + index] = false
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

struct SelfHostSelectedInferenceSource {
  collected: SelfHostCollectedModule
  source: SelfHostCollectedModule
  live: SelfHostInferenceReachability
  conditions: Map<U32, Bool>
  plan: SelfHostPlannedModuleLowering
}

impl SelfHostSelectedInferenceSource {
  fn guard_expression_children(self, span: SelfHostHirSpan, work: Array<SelfHostCompileTimeGuardWalk>) -> Unit {
    self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.expression_children.length()), "ARN-101 guarded expression children")
    let _ = while 0u32 {
      index => if index < span.length {
        work.push(SelfHostCompileTimeGuardWalk::GuardExpression(self.collected.expression_children[span.start + index]))
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn guard_object_fields(self, span: SelfHostHirSpan, work: Array<SelfHostCompileTimeGuardWalk>) -> Unit {
    self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.object_fields.length()), "ARN-101 guarded object fields")
    let _ = while 0u32 {
      index => if index < span.length {
        work.push(SelfHostCompileTimeGuardWalk::GuardExpression(self.collected.object_fields[span.start + index].value))
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn walk(self, root: SelfHostCompileTimeGuardWalk) -> Unit {
    let work = [root]
    let _ = while work.length() {
      count => if count > 0u32 {
        let item = work[count - 1u32]
        work.truncate(count - 1u32)
        match item {
          SelfHostCompileTimeGuardWalk::GuardBlock(block) => {
            self_host_assert_array_index(block, self.collected.blocks.length(), "ARN-104 guarded block")
            if self.live.blocks[block] {
              continue work.length()
            }
            self.live.blocks[block] = true
            let original = self.collected.blocks[block]
            let length = self.plan.blocks[block].items.length
            self_host_assert_compiler_invariant(length <= original.items.length, "ARN-101 selected inference block prefix")
            let span = SelfHostHirSpan::{
              start: original.items.start
              length: length
            }
            self.source.blocks[block] = SelfHostHirBlock::{
              items: span
              offset: original.offset
            }
            self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.block_items.length()), "ARN-101 guarded block items")
            let _ = while 0u32 {
              index => if index < span.length {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(self.collected.block_items[span.start + index].value))
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostCompileTimeGuardWalk::GuardPattern(pattern) => if pattern != 4294967295u32 {
            self_host_assert_array_index(pattern, self.collected.patterns.length(), "ARN-104 guarded pattern")
            if self.live.patterns[pattern] {
              continue work.length()
            }
            self.live.patterns[pattern] = true
            match self.collected.patterns[pattern] {
              SelfHostHirPattern::LiteralPattern(value, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirPattern::QualifiedPattern(root, _, _) => work.push(SelfHostCompileTimeGuardWalk::GuardPattern(root))
              SelfHostHirPattern::TuplePattern(root, span, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardPattern(root))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_children.length()), "ARN-101 guarded pattern children")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(SelfHostCompileTimeGuardWalk::GuardPattern(self.collected.pattern_children[span.start + index]))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              SelfHostHirPattern::AlternativePattern(root, span, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardPattern(root))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_children.length()), "ARN-101 guarded pattern children")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(SelfHostCompileTimeGuardWalk::GuardPattern(self.collected.pattern_children[span.start + index]))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              SelfHostHirPattern::StructPattern(root, span, _, _, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardPattern(root))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_fields.length()), "ARN-101 guarded pattern fields")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(SelfHostCompileTimeGuardWalk::GuardPattern(self.collected.pattern_fields[span.start + index].pattern))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              _ => {}
            }
          }
          SelfHostCompileTimeGuardWalk::GuardExpression(expression) => if expression != 4294967295u32 {
            self_host_assert_array_index(expression, self.live.expressions.length(), "ARN-104 selected inference expression")
            if self.live.expressions[expression] {
              continue work.length()
            }
            self.live.expressions[expression] = true
            let mut original = expression
            let _ = while 0u32 {
              hops => {
                self_host_assert_compiler_invariant(hops <= self.collected.expressions.length(), "ARN-104 selected alternative cycle")
                match self.collected.expressions[original] {
                  SelfHostHirExpr::IfExpr(_, block, alternative, offset) => match self.conditions.get(original) {
                    Option::Some(selected) => if selected {
                      self.source.expressions[expression] = SelfHostHirExpr::BlockExpr(block, offset)
                      break self_host_semantic_unit()
                    } else {
                      if alternative == 4294967295u32 {
                        self.source.expressions[expression] = SelfHostHirExpr::ProductExpr(self_host_empty_hir_span(0u32), offset)
                        break self_host_semantic_unit()
                      }
                      self_host_assert_array_index(alternative, self.collected.expressions.length(), "ARN-104 selected alternative")
                      original = alternative
                      self.source.expressions[expression] = self.collected.expressions[original]
                      continue hops + 1u32
                    }
                    Option::None => break self_host_semantic_unit()
                  }
                  _ => break self_host_semantic_unit()
                }
              }
            }
            let planned = self.plan.expressions[expression]
            match self.source.expressions[expression] {
              SelfHostHirExpr::BinaryExpr(operator, _, _, offset) => if operator is SelfHostHirBinaryOperator::LogicalAnd || operator is SelfHostHirBinaryOperator::LogicalOr {
                match planned.kind {
                  SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
                    self.source.expressions[expression] = SelfHostHirExpr::BoolExpr(value, offset)
                  }
                  _ => {}
                }
              }
              _ => {}
            }
            match planned.kind {
              SelfHostPlannedExpressionKind::PlannedEvaluationSequence(prefix) => if !planned.flow.falls_through {
                self_host_assert_array_span(prefix.start, prefix.length, self.plan.expression_children.length(), "ARN-101 selected inference operand prefix")
                let _ = while 0u32 {
                  index => if index < prefix.length {
                    work.push(SelfHostCompileTimeGuardWalk::GuardExpression(self.plan.expression_children[prefix.start + index]))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                match self.source.expressions[expression] {
                  SelfHostHirExpr::CallExpr(target, _, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(target))
                  _ => {}
                }
                continue work.length()
              }
              _ => {}
            }
            match self.source.expressions[expression] {
              SelfHostHirExpr::ProductExpr(span, _) => self.guard_expression_children(span, work)
              SelfHostHirExpr::ArrayExpr(span, _) => self.guard_expression_children(span, work)
              SelfHostHirExpr::ObjectExpr(span, _) => self.guard_object_fields(span, work)
              SelfHostHirExpr::ConstructExpr(target, span, _) => {
                self.guard_object_fields(span, work)
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(target))
              }
              SelfHostHirExpr::BlockExpr(block, _) => work.push(SelfHostCompileTimeGuardWalk::GuardBlock(block))
              SelfHostHirExpr::IfExpr(condition, block, alternative, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(condition))
                work.push(SelfHostCompileTimeGuardWalk::GuardBlock(block))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(alternative))
              }
              SelfHostHirExpr::MatchExpr(value, arms, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(arms.start, arms.length, self.collected.arm_children.length()), "ARN-101 guarded arms")
                let _ = while 0u32 {
                  index => if index < arms.length {
                    let id = self.collected.arm_children[arms.start + index]
                    self_host_assert_array_index(id, self.collected.pattern_arms.length(), "ARN-104 guarded arm")
                    let arm = self.collected.pattern_arms[id]
                    work.push(SelfHostCompileTimeGuardWalk::GuardPattern(arm.pattern))
                    work.push(SelfHostCompileTimeGuardWalk::GuardExpression(arm.guard_condition))
                    work.push(SelfHostCompileTimeGuardWalk::GuardExpression(arm.body))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              SelfHostHirExpr::WhileExpr(value, arms, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(arms.start, arms.length, self.collected.arm_children.length()), "ARN-101 guarded arms")
                let _ = while 0u32 {
                  index => if index < arms.length {
                    let id = self.collected.arm_children[arms.start + index]
                    self_host_assert_array_index(id, self.collected.pattern_arms.length(), "ARN-104 guarded arm")
                    let arm = self.collected.pattern_arms[id]
                    work.push(SelfHostCompileTimeGuardWalk::GuardPattern(arm.pattern))
                    work.push(SelfHostCompileTimeGuardWalk::GuardExpression(arm.guard_condition))
                    work.push(SelfHostCompileTimeGuardWalk::GuardExpression(arm.body))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              SelfHostHirExpr::LambdaExpr(lambda, _) => work.push(SelfHostCompileTimeGuardWalk::GuardBlock(self.collected.lambdas[lambda].body.root))
              SelfHostHirExpr::ReturnExpr(value, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::BreakExpr(value, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::ContinueExpr(value, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::PrefixExpr(_, value, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::FieldExpr(value, _, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::QualifiedExpr(value, _, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::ProductFieldExpr(value, _, _, _) => work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              SelfHostHirExpr::BinaryExpr(_, left, right, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(left))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(right))
              }
              SelfHostHirExpr::IndexExpr(left, right, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(left))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(right))
              }
              SelfHostHirExpr::AssignmentExpr(left, right, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(left))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(right))
              }
              SelfHostHirExpr::CallExpr(target, arguments, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(target))
                self.guard_expression_children(arguments, work)
              }
              SelfHostHirExpr::IndexSetExpr(target, index, value, _) => {
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(target))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(index))
                work.push(SelfHostCompileTimeGuardWalk::GuardExpression(value))
              }
              _ => {}
            }
          }
        }
        continue work.length()
      } else {
        break self_host_semantic_unit()
      }
    }
  }

}

fn self_host_selected_inference_source(collected: SelfHostCollectedModule, names: SelfHostResolvedModuleNames, declaration: U64, conditions: Map<U32, Bool>, plan: SelfHostPlannedModuleLowering) -> SelfHostSelectedInferenceSource {
  let live = SelfHostInferenceReachability::{
    declaration: declaration
    expressions: self_host_inference_bool_slots(collected.expressions.length())
    blocks: self_host_inference_bool_slots(collected.blocks.length())
    patterns: self_host_inference_bool_slots(collected.patterns.length())
    locals: self_host_inference_bool_slots(names.locals.length())
    type_substitutions: self_host_empty_semantic_ids()
  }
  for arena in [live.expressions, live.blocks, live.patterns, live.locals] {
    let _ = while 0u32 {
      index => if index < arena.length() {
        arena[index] = true
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  let mut body_index = 4294967295u32
  let _ = while 0u32 {
    index => if index < collected.bodies.length() {
      if collected.bodies[index].declaration == declaration {
        body_index = index
        break self_host_semantic_unit()
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_assert_array_index(body_index, collected.bodies.length(), "BOD-612 selected source body")
  let root = collected.bodies[body_index]
  self_host_clear_inference_span(root.expressions, live.expressions)
  self_host_clear_inference_span(root.blocks, live.blocks)
  self_host_clear_inference_span(root.patterns, live.patterns)
  self_host_clear_inference_span(names.bodies[body_index].locals, live.locals)
  for lambda in collected.lambdas {
    if lambda.root_body == root.id {
      self_host_clear_inference_span(lambda.body.expressions, live.expressions)
      self_host_clear_inference_span(lambda.body.blocks, live.blocks)
      self_host_clear_inference_span(lambda.body.patterns, live.patterns)
      self_host_assert_array_index(lambda.id, names.lambdas.length(), "ARN-106 selected lambda")
      self_host_clear_inference_span(names.lambdas[lambda.id].locals, live.locals)
    }
  }
  let selected = SelfHostSelectedInferenceSource::{
    collected: collected
    source: self_host_clone_selected_source(collected)
    live: live
    conditions: conditions
    plan: plan
  }
  match root.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => selected.walk(SelfHostCompileTimeGuardWalk::GuardExpression(expression))
    SelfHostHirBodyRoot::BlockBodyRoot(block) => selected.walk(SelfHostCompileTimeGuardWalk::GuardBlock(block))
  }
  let _ = while 0u32 {
    index => if index < names.locals.length() {
      if !live.locals[index] {
        let local = names.locals[index]
        live.locals[index] = match local.kind {
          SelfHostBodyLocalKind::ParameterLocal => true
          SelfHostBodyLocalKind::LetLocal => {
            self_host_assert_array_index(local.source, collected.block_items.length(), "ARN-104 selected let local")
            let value = collected.block_items[local.source].value
            self_host_assert_array_index(value, live.expressions.length(), "ARN-104 selected let value")
            live.expressions[value]
          }
          SelfHostBodyLocalKind::PatternLocal => {
            self_host_assert_array_index(local.source, live.patterns.length(), "ARN-104 selected pattern local")
            live.patterns[local.source]
          }
        }
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  selected
}

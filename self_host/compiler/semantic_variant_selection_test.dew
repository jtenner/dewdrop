open dew.std.array
open dew.std.option
open dew.std.testing

fn self_host_variant_infer_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostResolvedModuleTypes,
  SelfHostResolvedModuleNames,
  SelfHostBasicInferredModuleBodies,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  (collected, resolved, names, inferred)
}

fn self_host_variant_find_call(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
) -> U32 {
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  while expression {
    current => if current < end {
      match collected.expressions[current] {
        CallExpr(_, _, _) => {
          return current
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break 4294967295u32
    }
  }
}

fn self_host_variant_find_construction(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
) -> U32 {
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  while expression {
    current => if current < end {
      match collected.expressions[current] {
        ConstructExpr(_, _, _) => {
          return current
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break 4294967295u32
    }
  }
}

fn self_host_variant_find_qualified(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
) -> U32 {
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  while expression {
    current => if current < end {
      match collected.expressions[current] {
        QualifiedExpr(_, _, _) => {
          return current
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break 4294967295u32
    }
  }
}

fn self_host_variant_assert_primitive(
  body: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
  primitive: SelfHostPrimitiveType,
  message: String,
) -> Unit {
  match body.type_term(type_) {
    BodyResolvedType(resolved_type) => assert(
      resolved_type == resolved.primitive(primitive),
      message,
    )
    _ => assert(false, message)
  }
}

test "variant selection resolves tuple and unit constructors" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    870u64,
    b"enum Maybe<t> {\n  None\n  Some(t)\n}\nfn some() -> Maybe<I32> {\n  Maybe::Some(1)\n}\nfn none() -> Maybe<I32> {\n  Maybe::None\n}\n",
  )
  let some_hir = collected.bodies[0u32]
  let none_hir = collected.bodies[1u32]
  let some_body = inferred.bodies[0u32]
  let none_body = inferred.bodies[1u32]
  let call = self_host_variant_find_call(collected, some_hir)
  let call_target = match collected.expressions[call] {
    CallExpr(target, _, _) => target
    _ => 4294967295u32
  }
  match collected.expressions[call_target] {
    QualifiedExpr(base, property, _) => match names.expression_references[base] {
      ModuleTypeNameReference(declaration) => {
        assert(
          self_host_u64_equal(collected.variants[1u32].declaration, declaration),
          "tuple variant owner",
        )
        assert(
          self_host_u32_equal(collected.variants[1u32].name, property),
          "tuple variant name",
        )
      }
      NoNameReference => assert(false, "tuple base no reference")
      _ => assert(false, "tuple base wrong reference")
    }
    _ => assert(false, "tuple target not qualified")
  }
  let qualified = self_host_variant_find_qualified(collected, none_hir)
  assert(some_body.diagnostic_count() == 0u32, "tuple variant diagnostics")
  assert(none_body.diagnostic_count() == 0u32, "unit variant diagnostics")
  match some_body.call_target(some_hir, call) {
    SelectedBasicCallTarget(_, _) => {}
    BoundTraitBasicCallTarget(_, _, _, _) => assert(false, "tuple variant bound trait call target")
    NoBasicCallTarget => assert(false, "tuple variant no call target")
    ErrorBasicCallTarget => assert(false, "tuple variant error call target")
    FunctionValueBasicCallTarget(_) => assert(false, "tuple variant function call target")
  }
  match some_body.expression_selection(some_hir, call) {
    VariantConstructionBasicExpressionSelection(
      variant,
      kind,
      arguments,
    ) => {
      assert(variant == collected.variants[1u32].id, "Some variant")
      assert(kind == 1u32, "tuple variant kind")
      assert(arguments.length == 1u32, "tuple variant arguments")
      self_host_variant_assert_primitive(
        some_body,
        resolved,
        some_body.expression_type_arguments[arguments.start],
        I32Type,
        "Some generic I32",
      )
    }
    NoBasicExpressionSelection => assert(false, "tuple variant no selection")
    ErrorBasicExpressionSelection => assert(false, "tuple variant error selection")
    DeferredBasicExpressionSelection => assert(false, "tuple variant deferred selection")
    FieldBasicExpressionSelection(_, _, _) => assert(false, "tuple variant field selection")
    StructConstructionBasicExpressionSelection(_, _) => assert(false, "tuple variant struct selection")
  }
  match none_body.expression_selection(none_hir, qualified) {
    VariantConstructionBasicExpressionSelection(
      variant,
      kind,
      arguments,
    ) => {
      assert(variant == collected.variants[0u32].id, "None variant")
      assert(kind == 2u32, "unit variant kind")
      assert(arguments.length == 1u32, "unit variant arguments")
      self_host_variant_assert_primitive(
        none_body,
        resolved,
        none_body.expression_type_arguments[arguments.start],
        I32Type,
        "None generic I32",
      )
    }
    _ => assert(false, "unit variant selection")
  }
}

test "variant selection infers unqualified constructors from context" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    879u64,
    b"enum Small {\n  None\n  Some(I32)\n}\nenum Wide {\n  None\n  Some(I64)\n}\nfn small() -> Small {\n  Some(1)\n}\nfn wide() -> Wide {\n  Some(2i64)\n}\nfn read(value: Small) -> I32 {\n  match value {\n    Some(item) => item\n    None => 0\n  }\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let small_hir = collected.bodies[0u32]
  let wide_hir = collected.bodies[1u32]
  let read_hir = collected.bodies[2u32]
  let small_body = match inferred.body(small_hir.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let wide_body = match inferred.body(wide_hir.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let read_body = match inferred.body(read_hir.id) {
    Some(value) => value
    None => {
      return
    }
  }
  assert(small_body.diagnostic_count() == 0u32, "unqualified Small diagnostics")
  assert(wide_body.diagnostic_count() == 0u32, "unqualified Wide diagnostics")
  assert(read_body.diagnostic_count() == 0u32, "unqualified pattern diagnostics")
  let small_call = self_host_variant_find_call(collected, small_hir)
  let wide_call = self_host_variant_find_call(collected, wide_hir)
  match small_body.expression_selection(small_hir, small_call) {
    VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => assert(variant == collected.variants[1u32].id, "unqualified Small::Some")
    _ => assert(false, "unqualified Small selection")
  }
  match wide_body.expression_selection(wide_hir, wide_call) {
    VariantConstructionBasicExpressionSelection(
      variant,
      _,
      _,
    ) => assert(variant == collected.variants[3u32].id, "unqualified Wide::Some")
    _ => assert(false, "unqualified Wide selection")
  }
  let mut selected = 0u32
  let mut pattern = read_hir.patterns.start
  let end = self_host_u32_add(read_hir.patterns.start, read_hir.patterns.length)
  let _ = while pattern {
    current => if current < end {
      match read_body.pattern_constructor(read_hir, current) {
        SelectedBasicPatternConstructor(
          variant,
          _,
          _,
        ) => {
          assert(
            variant == collected.variants[0u32].id ||
              variant == collected.variants[1u32].id,
            "unqualified pattern owner",
          )
          selected = selected + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(selected == 2u32, "unqualified selected patterns")
}

test "return expressions and unqualified constructors infer from context" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    889u64,
    b"enum Result<t, e> {\n  Ok(t)\n  Err(e)\n}\nenum Option<t> {\n  Some(t)\n  None\n}\nenum Unique {\n  Only(I32)\n}\nfn sample(value: Result<I32, String>) -> Option<I32> {\n  match value {\n    Ok(val) => return None\n    Err(_) => ()\n  }\n  Some(42)\n}\nfn unique_without_context() -> Unit {\n  let selected = Only(1)\n  ()\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let body = match inferred.body(collected.bodies[0u32].id) {
    Some(value) => value
    None => {
      assert(false, "missing inferred body")
      return
    }
  }
  assert(body.diagnostic_count() == 0u32, "return constructor diagnostics")
  let unique_body = match inferred.body(collected.bodies[1u32].id) {
    Some(value) => value
    None => {
      assert(false, "missing unique inferred body")
      return
    }
  }
  assert(unique_body.diagnostic_count() == 0u32, "unique constructor diagnostics")
}

test "variant selection resolves struct variant construction" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    878u64,
    b"enum Message<t> {\n  Data {\n    value: t\n  }\n}\nfn make() -> Message<I32> {\n  Message::Data::{\n    value: 7\n  }\n}\n",
  )
  let _ = names.module_id
  let hir_body = collected.bodies[0u32]
  let body = inferred.bodies[0u32]
  assert(body.diagnostic_count() == 0u32, "struct variant construction diagnostics")
  let expression = self_host_variant_find_construction(collected, hir_body)
  match body.expression_selection(hir_body, expression) {
    VariantConstructionBasicExpressionSelection(
      variant,
      field_count,
      arguments,
    ) => {
      assert(variant == collected.variants[0u32].id, "struct variant id")
      assert(field_count == 1u32, "struct variant field count")
      assert(arguments.length == 1u32, "struct variant arguments")
      self_host_variant_assert_primitive(
        body,
        resolved,
        body.expression_type_arguments[arguments.start],
        I32Type,
        "struct variant I32",
      )
    }
    _ => assert(false, "struct variant selection")
  }
}

test "variant selection resolves tuple and unit patterns" {
  let (collected, resolved, _, inferred) = self_host_variant_infer_source(
    873u64,
    b"enum Maybe<t> {\n  None\n  Some(t)\n}\nfn read(value: Maybe<I32>) -> I32 {\n  match value {\n    Maybe::Some(item) => item\n    Maybe::None => 0\n  }\n}\n",
  )
  let hir_body = collected.bodies[0u32]
  let body = inferred.bodies[0u32]
  assert(body.diagnostic_count() == 0u32, "variant pattern diagnostics")
  let mut selected = 0u32
  let mut pattern = hir_body.patterns.start
  let end = self_host_u32_add(hir_body.patterns.start, hir_body.patterns.length)
  let _ = while pattern {
    current => if current < end {
      match body.pattern_constructor(hir_body, current) {
        SelectedBasicPatternConstructor(
          _,
          _,
          arguments,
        ) => {
          selected = selected + 1u32
          assert(arguments.length == 1u32, "pattern generic arguments")
          self_host_variant_assert_primitive(
            body,
            resolved,
            body.pattern_type_arguments[arguments.start],
            I32Type,
            "pattern generic I32",
          )
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(selected == 2u32, "two selected pattern constructors")
}

fn self_host_variant_assert_one_struct_pattern(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
) -> Unit {
  assert(inferred.bodies.length() == 1u32, "struct pattern body count")
  let hir_body = collected.bodies[0u32]
  let body = inferred.bodies[0u32]
  assert(body.diagnostic_count() == 0u32, "struct pattern diagnostics")
  let mut selected = 0u32
  let mut pattern = hir_body.patterns.start
  let end = self_host_u32_add(hir_body.patterns.start, hir_body.patterns.length)
  let _ = while pattern {
    current => if current < end {
      match body.pattern_constructor(hir_body, current) {
        SelectedBasicPatternConstructor(
          _,
          _,
          arguments,
        ) => {
          selected = selected + 1u32
          assert(arguments.length == 1u32, "struct pattern arguments")
          self_host_variant_assert_primitive(
            body,
            resolved,
            body.pattern_type_arguments[arguments.start],
            I32Type,
            "struct pattern I32",
          )
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(selected == 1u32, "selected struct pattern")
}

test "variant selection resolves struct patterns" {
  let (collected, resolved, _, inferred) = self_host_variant_infer_source(
    875u64,
    b"struct Box<t> {\n  value: t\n}\nfn read(value: Box<I32>) -> I32 {\n  match value {\n    Box {\n      value: item\n    } => item\n  }\n}\n",
  )
  self_host_variant_assert_one_struct_pattern(collected, resolved, inferred)
}

test "variant selection resolves struct-variant patterns" {
  let (collected, resolved, _, inferred) = self_host_variant_infer_source(
    877u64,
    b"enum Message<t> {\n  Data {\n    value: t\n  }\n}\nfn read(value: Message<I32>) -> I32 {\n  match value {\n    Message::Data {\n      value: item\n    } => item\n  }\n}\n",
  )
  self_host_variant_assert_one_struct_pattern(collected, resolved, inferred)
}

test "variant selection diagnoses struct pattern fields" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    876u64,
    b"struct Pair {\n  left: I32\n  right: I32\n}\nfn read(value: Pair) -> I32 {\n  match value {\n    Pair {\n      missing: _\n      ...\n    } => 0\n  }\n}\n",
  )
  let _ = collected.module_id
  let _ = resolved.module_id
  let _ = names.module_id
  let hir_body = collected.bodies[0u32]
  let body = match inferred.body(hir_body.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let mut count = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < body.diagnostic_count() {
      match body.diagnostic_at(current) {
        UnknownPatternField(_, _, _) => {
          count = count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(count == 1u32, "unknown pattern field diagnostic")
}

test "variant selection diagnoses pattern payload arity" {
  let (collected, resolved, names, inferred) = self_host_variant_infer_source(
    874u64,
    b"enum Maybe {\n  Some(I32)\n}\nfn read(value: Maybe) -> I32 {\n  match value {\n    Maybe::Some(_, _) => 0\n  }\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let hir_body = collected.bodies[0u32]
  let body = match inferred.body(hir_body.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let mut count = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < body.diagnostic_count() {
      match body.diagnostic_at(current) {
        PatternPayloadArityMismatch(_, _, _, _) => {
          count = count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(count == 1u32, "pattern arity diagnostic")
}

test "variant selection diagnoses payload kind and arity" {
  let (kind_collected, kind_resolved, kind_names, kind_mismatch) = self_host_variant_infer_source(
    871u64,
    b"enum Maybe {\n  None\n}\nfn bad() -> Maybe {\n  Maybe::None()\n}\n",
  )
  let (arity_collected, arity_resolved, arity_names, arity_mismatch) = self_host_variant_infer_source(
    872u64,
    b"enum Maybe {\n  Some(I32)\n}\nfn bad() -> Maybe {\n  Maybe::Some()\n}\n",
  )
  let _ = kind_resolved.module_id
  let _ = kind_names.module_id
  let _ = arity_resolved.module_id
  let _ = arity_names.module_id
  let kind_hir = kind_collected.bodies[0u32]
  let arity_hir = arity_collected.bodies[0u32]
  let kind_body = match kind_mismatch.body(kind_hir.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let arity_body = match arity_mismatch.body(arity_hir.id) {
    Some(value) => value
    None => {
      return
    }
  }
  let mut kind_count = 0u32
  let mut arity_count = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < kind_body.diagnostic_count() {
      match kind_body.diagnostic_at(current) {
        ConstructionPayloadKindMismatch(_, _, _) => {
          kind_count = kind_count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  index = 0u32
  let _ = while index {
    current => if current < arity_body.diagnostic_count() {
      match arity_body.diagnostic_at(current) {
        ConstructionPayloadArityMismatch(_, _, _, _, _) => {
          arity_count = arity_count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(kind_count == 1u32, "payload kind diagnostic")
  assert(arity_count == 1u32, "payload arity diagnostic")
}

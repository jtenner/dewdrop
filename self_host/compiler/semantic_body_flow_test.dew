test "body flow matrix stability nested mutable enum guard" {
  let (_, flows) = self_host_flow_source(
    1024u64, b"struct Flag {\n  mut value: Bool\n}\nenum Box {\n  Wrap(Flag)\n}\nfn read(flag: Flag) -> I32 {\n  match Wrap(flag) {\n    Wrap(Flag {\n      value: true\n    }) => 10\n    _ if false => 20\n    Wrap(Flag {\n      value: false\n    }) => 30\n  }\n}\n",
  )
  assert(self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 1u32, "mutable path needs a fallback")
}

test "body flow matrix stability nested mutable product guard" {
  let (_, flows) = self_host_flow_source(
    1025u64, b"struct Flag {\n  mut value: Bool\n}\nfn read(flag: Flag) -> I32 {\n  match (flag, true) {\n    (Flag {\n      value: true\n    }, _) => 10\n    _ if false => 20\n    (Flag {\n      value: false\n    }, _) => 30\n  }\n}\n",
  )
  assert(self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 1u32, "mutable path needs a fallback")
}

test "body flow matrix stability nested mutable immutable field guard" {
  let (_, flows) = self_host_flow_source(
    1026u64, b"struct Flag {\n  mut value: Bool\n}\nstruct Holder {\n  flag: Flag\n}\nfn read(flag: Flag) -> I32 {\n  match Holder::{\n    flag: flag\n  } {\n    Holder {\n      flag: Flag {\n      value: true\n    }\n    } => 10\n    _ if false => 20\n    Holder {\n      flag: Flag {\n      value: false\n    }\n    } => 30\n  }\n}\n",
  )
  assert(self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 1u32, "mutable path needs a fallback")
}

test "body flow matrix stability mutable wildcard stable field guard" {
  let (_, flows) = self_host_flow_source(
    1027u64, b"struct Pair {\n  mut changing: Bool\n  stable: Bool\n}\nfn read(value: Pair) -> I32 {\n  match value {\n    Pair {\n      changing: _\n      stable: true\n    } => 10\n    _ if false => 20\n    Pair {\n      changing: _\n      stable: false\n    } => 30\n  }\n}\n",
  )
  assert(flows.bodies[0u32].diagnostics.length() == 0u32, "stable coverage stays complete")
}

test "body flow matrix stability imported mutable guard" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nfn read(flag: Flag) -> I32 {\n  match flag {\n    Flag {\n      value: true\n    } => 10\n    _ if false => 20\n    Flag {\n      value: false\n    } => 30\n  }\n}\n",
    b"pub struct Flag {\n  mut value: Bool\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let imports = fixture.imports
  let names = self_host_resolve_module_names_with_imports(collected, imports.scope)
  let inferred = self_host_infer_basic_module_bodies_with_imports(
    collected,
    imports.resolved,
    names,
    imports.scope,
    imports.callables,
    imports.generic_parameter_ids,
    imports.parameter_types,
    imports.parameter_receivers,
    imports.implementations,
    imports.fields,
    imports.variants,
    imports.variant_payload_types,
    imports.type_declaration_types,
    imports.type_generic_spans,
    imports.module_value_types,
    imports,
  )
  let flows = self_host_analyze_basic_module_flows_with_field_imports(
    collected,
    imports.resolved,
    inferred,
    imports.variants,
    imports.fields,
  )
  assert(inferred.bodies[0u32].diagnostics.length() == 0u32, "valid imported field patterns")
  assert(self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 1u32, "mutable imported path needs fallback")
}


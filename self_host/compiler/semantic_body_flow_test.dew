test "body flow matrix stability mutable functional loop guard" {
  let (_, flows) = self_host_flow_source(
    1032u64, b"struct Flag {\n  mut value: Bool\n}\nfn read(flag: Flag) -> I32 {\n  while flag {\n    Flag {\n      value: true\n    } => break 10\n    _ if false => break 20\n    Flag {\n      value: false\n    } => break 30\n  }\n}\n",
  )
  let flow = flows.bodies[flows.bodies.length() - 1u32]
  assert(flow.diagnostics.length() == 1u32, "one loop coverage diagnostic")
  assert(flow.diagnostics[0u32] is NonExhaustiveFunctionalLoop(_, _, _), "mutable loop needs fallback")
}

test "body flow matrix stability mutable selected string comparison" {
  let (_, flows) = self_host_flow_source(
    1033u64, b"trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\nimpl Eq for String {\n  fn eq(self, right: String) -> Bool {\n    false\n  }\n}\nstruct Flag {\n  mut value: Bool\n}\nfn read(flag: Flag, text: String) -> I32 {\n  match (flag, text) {\n    (Flag {\n      value: true\n    }, _) => 10\n    (_, \"x\") => 20\n    (Flag {\n      value: false\n    }, _) => 30\n  }\n}\n",
  )
  let flow = flows.bodies[flows.bodies.length() - 1u32]
  assert(self_host_flow_non_exhaustive_count(flow) == 1u32, "effectful mutable proof needs fallback")
}

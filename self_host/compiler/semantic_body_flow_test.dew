test "body flow nested pattern matrix reports its depth budget" {
  let (_, flows) = self_host_flow_source(
    1013u64, b"fn read(value: (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, (Bool, Bool)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) -> I32 {\n  match value {\n    (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, true))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) => 1\n    (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, (_, false))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) => 2\n  }\n}\n",
  )
  let flow = flows.bodies[0u32]
  assert(flow.diagnostics.length() == 1u32, "one budget diagnostic")
  assert(flow.missing_cases.length() == 0u32, "budget is not a missing pattern")
  match flow.diagnostics[0u32] {
    PatternCoverageBudgetExceeded(_, cells, depth, _) => {
      assert(cells == 65536u32 && depth == 64u32, "reported work limits")
    }
    _ => assert(false, "expected a visible coverage budget error")
  }
}

test "body flow matrix variant collection charges unrelated visits" {
  let collected = self_host_collect_bytes(1014u64, b"enum Noise {\n  N0\n  N1\n  N2\n  N3\n  N4\n  N5\n  N6\n  N7\n  N8\n  N9\n  N10\n  N11\n  N12\n  N13\n  N14\n  N15\n  N16\n  N17\n  N18\n  N19\n  N20\n  N21\n  N22\n  N23\n  N24\n  N25\n  N26\n  N27\n  N28\n  N29\n  N30\n  N31\n}\nenum Bit {\n  Zero\n  One\n}\nfn read(value: Bit) -> I32 {\n  match value {\n    Zero => 0\n    One => 1\n  }\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, self_host_resolve_module_names(collected))
  let analyzer = SelfHostBodyFlowAnalyzer::new(collected, resolved, collected.bodies[0u32], inferred.bodies[0u32], [], [])
  let declaration = match collected.lookup_type("Bit") {
    Some(value) => value
    None => unreachable()
  }
  let work = SelfHostPatternCoverageWork::{
    remaining: 3u32
    exhausted: false
  }
  assert(analyzer.matrix_enum_variants(declaration, work) is None, "unrelated visits exhaust budget")
  assert(work.exhausted && work.remaining == 0u32, "bounded before Bit entries")
  assert(!work.spend(0u32), "exhaustion stays visible")
}

test "body flow matrix stability mutable guard" {

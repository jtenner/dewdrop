open dew.std.testing

fn self_host_flow_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostAnalyzedModuleFlows,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  let flows = self_host_analyze_basic_module_flows(collected, resolved, inferred)
  (collected, flows)
}

fn self_host_flow_has_unreachable(
  flow: SelfHostAnalyzedBodyFlow,
) -> Bool {
  for diagnostic in flow.diagnostics {
    match diagnostic {
      UnreachableBlockItem(_, _, _) => {
        return true
      }
      _ => {}
    }
  }
  false
}

fn self_host_flow_non_exhaustive_count(
  flow: SelfHostAnalyzedBodyFlow,
) -> U32 {
  let mut count = 0u32
  for diagnostic in flow.diagnostics {
    match diagnostic {
      NonExhaustiveMatch(_, _, _) => {
        count = self_host_u32_add(count, 1u32)
      }
      _ => {}
    }
  }
  count
}

fn self_host_flow_redundant_count(
  flow: SelfHostAnalyzedBodyFlow,
) -> U32 {
  let mut count = 0u32
  for diagnostic in flow.diagnostics {
    match diagnostic {
      RedundantPatternArm(_, _) => {
        count = self_host_u32_add(count, 1u32)
      }
      _ => {}
    }
  }
  count
}

fn self_host_flow_loop_fallthrough_count(
  flow: SelfHostAnalyzedBodyFlow,
) -> U32 {
  let mut count = 0u32
  for diagnostic in flow.diagnostics {
    match diagnostic {
      FunctionalLoopArmFallsThrough(_, _) => {
        count = self_host_u32_add(count, 1u32)
      }
      _ => {}
    }
  }
  count
}

fn self_host_assert_one_missing_bool_false(
  flow: SelfHostAnalyzedBodyFlow,
) -> Unit {
  assert(flow.missing_cases.length() == 1u32, "one missing Bool case")
  match flow.missing_cases[0u32] {
    MissingBoolCase(false) => {}
    _ => assert(false, "missing false case")
  }
}

fn self_host_assert_one_missing_variant(
  flow: SelfHostAnalyzedBodyFlow,
) -> Unit {
  assert(flow.missing_cases.length() == 1u32, "one missing variant")
  match flow.missing_cases[0u32] {
    MissingVariantCase(_) => {}
    _ => assert(false, "missing variant case")
  }
}

test "body flow bit flags preserve every exit kind" {
  let source = {
    falls_through: true
    returns: true
    breaks: true
    continues: true
    diverges: true
  }
  let encoded = self_host_flow_encode(source)
  assert(encoded == 31u32, "all flow flags encoded")
  let decoded = self_host_flow_decode(encoded)
  assert(decoded.falls_through, "fallthrough flag")
  assert(decoded.returns, "return flag")
  assert(decoded.breaks, "break flag")
  assert(decoded.continues, "continue flag")
  assert(decoded.diverges, "diverge flag")
}

test "body flow diagnoses unreachable block items" {
  let (_, flows) = self_host_flow_source(
    970u64,
    b"fn run() -> I32 {\n  return 1\n  2\n}\n",
  )
  let flow = flows.bodies[0u32]
  assert(flow.flow.returns, "body returns")
  assert(!flow.flow.falls_through, "body does not fall through")
  assert(self_host_flow_has_unreachable(flow), "unreachable item")
}

test "body flow keeps selected direct calls reachable" {
  let (_, flows) = self_host_flow_source(
    982u64,
    b"fn helper() -> I32 {\n  1\n}\nfn run() -> I32 {\n  let value = helper()\n  value\n}\n",
  )
  let flow = flows.bodies[1u32]
  assert(flow.flow.falls_through, "direct call falls through")
  assert(!self_host_flow_has_unreachable(flow), "direct call continuation")
}

test "body flow keeps named function values reachable" {
  let (_, flows) = self_host_flow_source(
    983u64,
    b"fn apply(callback: fn(I32) -> I32) -> I32 {\n  let value = callback(1)\n  value\n}\n",
  )
  let flow = flows.bodies[0u32]
  assert(flow.flow.falls_through, "function value call falls through")
  assert(!self_host_flow_has_unreachable(flow), "function value continuation")
}

test "body flow stops after Never-returning calls" {
  let (_, flows) = self_host_flow_source(
    984u64,
    b"fn stop() -> Never {\n  stop()\n}\nfn run() -> I32 {\n  stop()\n  1\n}\n",
  )
  let flow = flows.bodies[1u32]
  assert(!flow.flow.falls_through, "Never call does not fall through")
  assert(flow.flow.diverges, "Never call diverges")
  assert(self_host_flow_has_unreachable(flow), "Never call stops block")
}

test "body flow handles a return without a value" {
  let (_, flows) = self_host_flow_source(
    981u64,
    b"fn stop() -> Unit {\n  return\n}\n",
  )
  let flow = flows.bodies[0u32]
  assert(flow.flow.returns, "bare return returns")
  assert(!flow.flow.falls_through, "bare return does not fall through")
  assert(!self_host_flow_has_unreachable(flow), "bare return reachable")
}

test "body flow recognizes exhaustive bool matches" {
  let (_, flows) = self_host_flow_source(
    971u64,
    b"fn choose(value: Bool) -> I32 {\n  match value {\n    false => 0\n    true => 1\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 0u32,
    "exhaustive bool match",
  )
}

test "body flow flattens alternative pattern coverage" {
  let (_, bool_flows) = self_host_flow_source(
    979u64,
    b"fn choose(value: Bool) -> I32 {\n  match value {\n    false, true => 1\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(bool_flows.bodies[0u32]) == 0u32,
    "alternative Bool coverage",
  )
  let (_, enum_flows) = self_host_flow_source(
    980u64,
    b"enum Choice {\n  First\n  Second\n}\nfn read(value: Choice) -> I32 {\n  match value {\n    Choice::First, Choice::Second => 0\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(enum_flows.bodies[0u32]) == 0u32,
    "alternative enum coverage",
  )
}

test "body flow recognizes local enum exhaustiveness" {
  let (_, complete) = self_host_flow_source(
    976u64,
    b"enum Maybe {\n  None\n  Some(I32)\n}\nfn read(value: Maybe) -> I32 {\n  match value {\n    Maybe::None => 0\n    Maybe::Some(item) => item\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(complete.bodies[0u32]) == 0u32,
    "complete enum match",
  )
  let (_, missing) = self_host_flow_source(
    977u64,
    b"enum Maybe {\n  None\n  Some(I32)\n}\nfn read(value: Maybe) -> I32 {\n  match value {\n    Maybe::None => 0\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(missing.bodies[0u32]) == 1u32,
    "missing enum variant",
  )
  self_host_assert_one_missing_variant(missing.bodies[0u32])
}

test "body flow suppresses coverage cascades after invalid patterns" {
  let (_, flows) = self_host_flow_source(
    978u64,
    b"enum Maybe {\n  Some(I32)\n}\nfn read(value: Maybe) -> I32 {\n  match value {\n    Maybe::Some(_, _) => 0\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 0u32,
    "invalid pattern suppresses coverage cascade",
  )
}

test "body flow diagnoses functional loop arm fallthrough" {
  let (_, flows) = self_host_flow_source(
    974u64,
    b"fn finish(initial: I32) -> I32 {\n  while initial {\n    value => value\n  }\n}\n",
  )
  assert(
    self_host_flow_loop_fallthrough_count(flows.bodies[0u32]) == 1u32,
    "loop arm fallthrough",
  )
}

test "body flow analyzes lambda bodies" {
  let (_, flows) = self_host_flow_source(
    975u64,
    b"fn make() -> fn(I32) -> I32 {\n  fn(value: I32) -> I32 {\n    value\n  }\n}\n",
  )
  assert(flows.lambdas.length() == 1u32, "lambda flow count")
  assert(flows.lambdas[0u32].flow.falls_through, "lambda falls through")
}

test "product coverage does not treat a short unit variant as a binding" {
  let (_, missing) = self_host_flow_source(
    985u64,
    b"enum Choice {\n  Missing\n  Present(I32)\n}\nfn choose(value: (Choice, I32)) -> I32 {\n  match value {\n    (Missing, _) => 0\n  }\n}\n",
  )
  assert(self_host_flow_non_exhaustive_count(missing.bodies[0u32]) == 1u32, "missing product case is diagnosed")
  let (_, complete) = self_host_flow_source(
    986u64,
    b"enum Choice {\n  Missing\n  Present(I32)\n}\nfn choose(value: (Choice, I32)) -> I32 {\n  match value {\n    (Missing, _) => 0\n    (_, result) => result\n  }\n}\n",
  )
  assert(self_host_flow_non_exhaustive_count(complete.bodies[0u32]) == 0u32, "product binding covers the remaining cases")
  assert(self_host_flow_redundant_count(complete.bodies[0u32]) == 0u32, "product binding is not redundant")
}

test "body flow diagnoses non-exhaustive and redundant match arms" {
  let (_, missing) = self_host_flow_source(
    972u64,
    b"fn choose(value: Bool) -> I32 {\n  match value {\n    true => 1\n  }\n}\n",
  )
  assert(
    self_host_flow_non_exhaustive_count(missing.bodies[0u32]) == 1u32,
    "missing false",
  )
  self_host_assert_one_missing_bool_false(missing.bodies[0u32])
  let (_, redundant) = self_host_flow_source(
    973u64,
    b"fn choose(value: Bool) -> I32 {\n  match value {\n    _ => 1\n    true => 2\n  }\n}\n",
  )
  assert(
    self_host_flow_redundant_count(redundant.bodies[0u32]) == 1u32,
    "redundant arm",
  )
}

test "body flow recognizes imported enum exhaustiveness" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nfn read(value: Maybe) -> I32 {\n  match value {\n    Maybe::None => 0\n    Maybe::Some(item) => item\n  }\n}\n",
    b"pub enum Maybe {\n  None\n  Some(I32)\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let imports = fixture.imports
  let names = self_host_resolve_module_names_with_imports(collected, imports.scope)
  let inferred = self_host_infer_basic_module_bodies_with_imports(
    collected,
    imports.resolved,
    names,
    imports.scope,
    imports.callables,
    imports.generic_parameter_ids,
    imports.parameter_types,
    imports.parameter_receivers,
    imports.implementations,
    imports.fields,
    imports.variants,
    imports.variant_payload_types,
    imports.type_declaration_types,
    imports.type_generic_spans,
    imports.module_value_types,
    imports,
  )
  let flows = self_host_analyze_basic_module_flows_with_imports(
    collected,
    imports.resolved,
    inferred,
    imports.variants,
  )
  assert(
    self_host_flow_non_exhaustive_count(flows.bodies[0u32]) == 0u32,
    "complete imported enum match",
  )
}

test "body flow opaque type coverage requires an unconditional catch-all" {
  let sources = [
    b"fn run<t>(value: t) -> I32 {\n  match value {\n  }\n}\n",
    b"fn run<t>(value: t) -> I32 {\n  match value {\n    _ if false => 42\n  }\n}\n",
    b"trait Mark {\n}\nfn run(value: Mark) -> I32 {\n  match value {\n    _ if false => 42\n  }\n}\n",
    b"fn run<t>(value: t) -> I32 {\n  while value {\n    _ if false => break 42\n  }\n}\n",
  ]
  for source in sources {
    let (_, flows) = self_host_flow_source(989u64, source)
    let flow = flows.bodies[0u32]
    assert(flow.diagnostics.length() == 1u32, "one missing coverage diagnostic")
    assert(flow.missing_cases.length() == 1u32, "one missing catch-all")
    match flow.missing_cases[0u32] {
      MissingCatchAllCase => {}
      _ => assert(false, "opaque type needs a catch-all")
    }
  }
}

test "body flow opaque type coverage accepts unconditional catch-all patterns" {
  let sources = [
    b"fn run<t>(value: t) -> I32 {\n  match value {\n    _ => 42\n  }\n}\n",
    b"trait Mark {\n}\nfn run(value: Mark) -> I32 {\n  match value {\n    _ => 42\n  }\n}\n",
    b"fn run<t>(value: t) -> I32 {\n  while value {\n    _ => break 42\n  }\n}\n",
  ]
  for source in sources {
    let (_, flows) = self_host_flow_source(990u64, source)
    assert(flows.bodies[0u32].diagnostics.length() == 0u32, "complete opaque coverage")
  }
}


open dew.std.option
open dew.std.result
open dew.std.map

// Use the same checked logical search as inference and compile-time queries.
// There is no separate solver-based fallback or physical-shape search here.
fn self_host_trait_evidence_search(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  index: SelfHostModuleImplIndex,
) -> SelfHostCompileTimeEvidenceSearch {
  {
    lowering: None
    collected: collected
    resolved: imports.resolved
    imports: imports
    index: index
    active: []
    budget: {
      steps: 0u32
    }
    associated_scopes: empty()
    associated_only: false
    include_test_impls: false
  }
}

fn self_host_select_trait_evidence_with_search(
  search: SelfHostCompileTimeEvidenceSearch,
  trait_type: U32,
  target_type: U32,
) -> Result<Option<SelfHostCompileTimeTraitWitness>, String> {
  let bindings = self_host_empty_compile_time_bindings()
  let trait_ = match search.read(trait_type, bindings) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let target = match search.read(target_type, bindings) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  search.witness(target, trait_)
}

fn self_host_select_trait_evidence(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  index: SelfHostModuleImplIndex,
  trait_type: U32,
  target_type: U32,
) -> Result<Option<SelfHostCompileTimeTraitWitness>, String> {
  self_host_select_trait_evidence_with_search(
    self_host_trait_evidence_search(collected, imports, index),
    trait_type,
    target_type,
  )
}

pub struct SelfHostTraitEvidenceNode {
  implementation: U64
  arguments: SelfHostHirSpan
  prerequisites: SelfHostHirSpan
}

pub struct SelfHostTraitEvidenceTree {
  root: Option<U32>
  nodes: Array<SelfHostTraitEvidenceNode>
  children: Array<U32>
  arguments: Array<SelfHostCompileTimeType>
}

fn self_host_append_trait_evidence_node(
  search: SelfHostCompileTimeEvidenceSearch,
  witness: SelfHostCompileTimeTraitWitness,
  nodes: Array<SelfHostTraitEvidenceNode>,
  children: Array<U32>,
  arguments: Array<SelfHostCompileTimeType>,
) -> Result<U32, String> {
  let declaration = witness.implementation.declaration
  let local = self_host_semantic_id_module(declaration) == search.collected.module_id
  let generics = if local {
    search.collected.generic_parameters_of(declaration)
  } else {
    match search.imports.implementation(declaration) {
      Some(imported) => imported.generic_bounds
      None => return Err("CT-010 missing imported implementation identity")
    }
  }
  let argument_start = arguments.length()
  let arena_length = if local {
    search.collected.generic_parameters.length()
  } else {
    search.imports.generic_parameter_ids.length()
  }
  if !self_host_array_span_is_valid(generics.start, generics.length, arena_length) {
    return Err("CT-010 invalid trait evidence generic parameter span")
  }
  let _ = while 0u32 {
    offset => if offset < generics.length {
      let parameter = if local {
        search.collected.generic_parameters[generics.start + offset].id
      } else {
        search.imports.generic_parameter_ids[generics.start + offset]
      }
      match witness.bindings.parameters.get(parameter) {
        Some(type_) => arguments.push(type_)
        None => return Err("CT-011 unresolved implementation type argument")
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let direct_children = self_host_empty_semantic_ids()
  for child in witness.prerequisites {
    match self_host_append_trait_evidence_node(search, child, nodes, children, arguments) {
      Ok(node) => direct_children.push(node)
      Err(error) => return Err(error)
    }
  }
  let prerequisite_start = children.length()
  for child in direct_children {
    children.push(child)
  }
  let node = nodes.length()
  nodes.push({
    implementation: declaration
    arguments: {
      start: argument_start
      length: generics.length
    }
    prerequisites: {
      start: prerequisite_start
      length: direct_children.length()
    }
  })
  Ok(node)
}

fn self_host_select_trait_evidence_tree(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  index: SelfHostModuleImplIndex,
  trait_type: U32,
  target_type: U32,
) -> Result<SelfHostTraitEvidenceTree, String> {
  let search = self_host_trait_evidence_search(collected, imports, index)
  let selected = match self_host_select_trait_evidence_with_search(search, trait_type, target_type) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let nodes = []
  let children = self_host_empty_semantic_ids()
  let arguments = self_host_empty_compile_time_types()
  let root = match selected {
    Some(witness) => match self_host_append_trait_evidence_node(search, witness, nodes, children, arguments) {
      Ok(node) => Some(node)
      Err(error) => return Err(error)
    }
    None => None
  }
  Ok({
    root: root
    nodes: nodes
    children: children
    arguments: arguments
  })
}

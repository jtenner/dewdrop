open dew.std.array
open dew.std.option
open dew.std.testing

test "basic inference compaction removes unreachable solver terms" {
  let collected = self_host_collect_bytes(
    930u64,
    b"fn identity<t>(value: t) -> t {\n  value\n}\nfn run() -> I32 {\n  identity(1)\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  let body = match inferred.body(collected.bodies[1u32].id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let baseline = self_host_compact_basic_inferred_body(body)
  let dead_argument_start = body.type_arguments.length()
  body.type_arguments.push(-2i32)
  body.types.push(SelfHostBodyTypeTerm::BodyVariableType(4000u32))
  body.types.push(SelfHostBodyTypeTerm::BodyAppliedType(
    -2i32,
    SelfHostHirSpan::{
      start: dead_argument_start
      length: 1u32
    },
  ))
  let compact = self_host_compact_basic_inferred_body(body)
  assert(
    self_host_u32_equal(compact.types.length(), baseline.types.length()),
    "dead type removal",
  )
  assert(
    self_host_u32_equal(
      compact.type_arguments.length(),
      baseline.type_arguments.length(),
    ),
    "dead argument removal",
  )
  assert(compact.root_type == baseline.root_type, "stable root type")
}

test "basic inference compaction keeps every published positive type valid" {
  let collected = self_host_collect_bytes(
    931u64,
    b"fn run(value: (I32, I64)) -> (I32, I64) {\n  let (left, right) = value\n  (left, right)\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_compact_basic_module_bodies(
    self_host_infer_basic_module_bodies(collected, resolved, names),
  )
  let body = match inferred.body(collected.bodies[0u32].id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let hir_body = collected.bodies[0u32]
  let type_count = self_host_compact_basic_type_count(body)
  let mut expression = hir_body.expressions.start
  let end = self_host_u32_add(
    hir_body.expressions.start,
    hir_body.expressions.length,
  )
  let _ = while expression {
    current => if current < end {
      let type_ = body.expression_type(hir_body, current)
      if type_ > 0i32 {
        assert(
          self_host_body_i32_to_u32(type_) < type_count,
          "expression type range",
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

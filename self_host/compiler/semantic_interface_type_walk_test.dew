open dew.std.testing

fn self_host_interface_walk_fixture() -> SelfHostResolvedModuleTypes {
  self_host_resolve_module_types(self_host_collect_bytes(6000u64, b""))
}

test "interface type visibility walks beyond 1024 levels" {
  let resolved = self_host_interface_walk_fixture()
  let mut root = resolved.primitive(SelfHostPrimitiveType::I32Type)
  let _ = while 0u32 {
    depth => if depth < 1025u32 {
      let start = resolved.type_arguments.length()
      resolved.type_arguments.push(root)
      root = resolved.types.length()
      resolved.types.push(SelfHostResolvedType::ProductType(SelfHostHirSpan::{
        start: start
        length: 1u32
      }))
      continue depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(self_host_frozen_impl_type_visible(resolved, root, Map::empty()), "finite deep type is visible")
}

test "interface type visibility permits shared children and checks private owners" {
  let resolved = self_host_interface_walk_fixture()
  let leaf = resolved.primitive(SelfHostPrimitiveType::I32Type)
  let start = resolved.type_arguments.length()
  resolved.type_arguments.push(leaf)
  resolved.type_arguments.push(leaf)
  let root = resolved.types.length()
  resolved.types.push(SelfHostResolvedType::ProductType(SelfHostHirSpan::{
    start: start
    length: 2u32
  }))
  let exported = Map::empty()
  assert(self_host_frozen_impl_type_visible(resolved, root, exported), "shared child is not a cycle")
  let owner = self_host_make_semantic_id(6000u64, 17u32)
  resolved.types[leaf] = SelfHostResolvedType::NominalType(owner)
  assert(!self_host_frozen_impl_type_visible(resolved, root, exported), "private owner remains private")
  exported.set(owner, true)
  assert(self_host_frozen_impl_type_visible(resolved, root, exported), "exported owner is visible")
  let projection = resolved.types.length()
  resolved.types.push(SelfHostResolvedType::MemberTypeProjection(leaf, b"types.field_type", "field"))
  assert(!self_host_frozen_impl_type_visible(resolved, projection, Map::empty()), "projection does not expose a private owner")
  assert(self_host_frozen_impl_type_visible(resolved, projection, exported), "projection checks owner visibility")
}

test "EVD-211 interface type cycles retain the type identity" expect_trap "unreachable" {
  let resolved = self_host_interface_walk_fixture()
  let root = resolved.primitive(SelfHostPrimitiveType::I32Type)
  let start = resolved.type_arguments.length()
  resolved.type_arguments.push(resolved.error_type)
  resolved.type_arguments.push(root)
  assert(self_host_frozen_impl_type_visible(resolved, root, Map::empty()), "valid graph before one-field mutation")
  resolved.types[root] = SelfHostResolvedType::ProductType(SelfHostHirSpan::{
    start: start
    length: 2u32
  })
  let _ = self_host_frozen_impl_type_visible(resolved, root, Map::empty())
}

test "ARN-101 interface type child spans are owned" expect_trap "unreachable" {
  let resolved = self_host_interface_walk_fixture()
  let root = resolved.primitive(SelfHostPrimitiveType::I32Type)
  assert(self_host_frozen_impl_type_visible(resolved, root, Map::empty()), "valid graph before one-field mutation")
  resolved.types[root] = SelfHostResolvedType::ProductType(SelfHostHirSpan::{
    start: resolved.type_arguments.length()
    length: 1u32
  })
  let _ = self_host_frozen_impl_type_visible(resolved, root, Map::empty())
}

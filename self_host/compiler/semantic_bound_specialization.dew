open dew.std.option

// Trait dispatch needs logical identity even when two types share eqref or i32.
// Applied/generic implementation evidence needs a structural proof; Unknown
// deliberately cannot select an implementation at this boundary.
pub enum SelfHostSpecializationEvidenceType {
  UnknownSpecializationEvidenceType
  NominalSpecializationEvidenceType(U64)
  PrimitiveSpecializationEvidenceType(SelfHostPrimitiveType)
  StructuralSpecializationEvidenceType(SelfHostCompileTimeType)
}

fn self_host_specialization_request_evidence_types(request: SelfHostProgramSpecializationRequest) -> Array<SelfHostSpecializationEvidenceType> {
  request.evidence_types
}

fn self_host_empty_specialization_evidence_types() -> Array<SelfHostSpecializationEvidenceType> {
  []
}

fn self_host_specialization_evidence_type_equal(left: SelfHostSpecializationEvidenceType, right: SelfHostSpecializationEvidenceType) -> Bool {
  match left {
    UnknownSpecializationEvidenceType => right is UnknownSpecializationEvidenceType
    NominalSpecializationEvidenceType(owner) => match right {
      NominalSpecializationEvidenceType(other) => self_host_u64_equal(owner, other)
      _ => false
    }
    PrimitiveSpecializationEvidenceType(primitive) => match right {
      PrimitiveSpecializationEvidenceType(other) => primitive.rank() == other.rank()
      _ => false
    }
    StructuralSpecializationEvidenceType(value) => match right {
      StructuralSpecializationEvidenceType(other) => match self_host_compile_time_types_equal(value, other) {
        Ok(equal) => equal
        Err(message) => {
          self_host_assert_compiler_invariant(false, message)
          unreachable()
        }
      }
      _ => false
    }
  }
}

fn self_host_specialization_evidence_types_equal(left: Array<SelfHostSpecializationEvidenceType>, right: Array<SelfHostSpecializationEvidenceType>) -> Bool {
  if left.length() != right.length() {
    return false
  }
  let _ = while 0u32 {
    index => if index < left.length() {
      if !self_host_specialization_evidence_type_equal(left[index], right[index]) {
        return false
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_specialization_resolved_evidence_type(module_: SelfHostPlannedModuleLowering, type_: U32) -> SelfHostSpecializationEvidenceType {
  match module_.resolved_types.types[type_] {
    NominalType(owner) => NominalSpecializationEvidenceType(owner)
    PrimitiveType(primitive) => PrimitiveSpecializationEvidenceType(primitive)
    _ => UnknownSpecializationEvidenceType
  }
}

fn self_host_specialization_parameter_evidence_type(caller: Option<SelfHostPlannedCallable>, specialization: U32, requests: Array<SelfHostProgramSpecializationRequest>, parameter: U64) -> SelfHostSpecializationEvidenceType {
  if specialization < requests.length() {
    match caller {
      Some(callable) => if self_host_u64_equal(callable.declaration, requests[specialization].declaration) && self_host_u64_equal(self_host_semantic_id_module(parameter), self_host_semantic_id_module(callable.declaration)) {
        let generics = self_host_program_specialization_callable_generics(callable)
        match generics.slot(parameter) {
          Some(relative) => {
          let types = self_host_specialization_request_evidence_types(requests[specialization])
          if relative < types.length() {
            return types[relative]
          }
          }
          None => {}
        }
      }
      _ => {}
    }
  }
  UnknownSpecializationEvidenceType
}

fn self_host_program_specialization_call_evidence_types(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, caller: Option<SelfHostPlannedCallable>, specialization: U32, requests: Array<SelfHostProgramSpecializationRequest>, target: U64, arguments: SelfHostHirSpan) -> Array<SelfHostSpecializationEvidenceType> {
  let result = self_host_empty_specialization_evidence_types()
  if lowering.compile_time.sensitive.contains_key(target) {
    let bindings = self_host_compile_time_caller_bindings(caller, specialization, requests)
    match self_host_read_compile_time_arguments(module_, arguments, bindings) {
      Ok(types) => {
        let reduced = match self_host_reduce_compile_time_projection_list(lowering, types, 0u32) {
          Ok(values) => values
          Err(message) => {
            lowering.compile_time.diagnostics.push(message)
            return result
          }
        }
        for type_ in reduced {
          result.push(self_host_compile_time_to_evidence_type(type_))
        }
      }
      Err(message) => {
        self_host_assert_compiler_invariant(false, message)
        unreachable()
      }
    }
    return result
  }
  let owner = match lowering.index.declaration_owner(target) {
    Some(owner) => owner
    None => return result
  }
  let callable = match self_host_program_specialization_callable(lowering.modules[owner], target) {
    Some(callable) => callable
    None => return result
  }
  let generics = self_host_program_specialization_callable_generics(callable)
  let collected = self_host_program_collected_module_at(lowering.collected, owner)
  let mut has_evidence = false
  let _ = while 0u32 {
    index => if index < arguments.length {
      let mut identity = UnknownSpecializationEvidenceType
      if index < generics.length {
        let parameter = collected.generic_parameter_at(generics.local(index))
        let bounds = parameter.bounds
        if self_host_u32_greater(bounds.length, 0u32) {
          has_evidence = true
          let type_ = self_host_program_specialization_call_type_argument(module_, arguments.start + index)
          match self_host_program_specialization_resolved_type(module_, type_) {
            Some(resolved) => match module_.resolved_types.types[resolved] {
              GenericParameterType(parameter) => {
                identity = self_host_specialization_parameter_evidence_type(caller, specialization, requests, parameter)
              }
              _ => {
                identity = self_host_specialization_resolved_evidence_type(module_, resolved)
              }
            }
            None => {}
          }
        }
      }
      result.push(identity)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if !has_evidence {
    result.clear()
  }
  result
}

fn self_host_program_specialization_bound_target(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, offset: U32, caller: Option<SelfHostPlannedCallable>, specialization: U32, requests: Array<SelfHostProgramSpecializationRequest>, target: U64) -> U64 {
  if offset >= body.expressions.length {
    return target
  }
  let expression = self_host_program_specialization_expression(module_, self_host_u32_add(body.expressions.start, offset))
  if !(expression.call_target is BoundTraitBasicCallTarget(_, _, _, _)) {
    return target
  }
  let requirement = match self_host_program_specialization_program_callable(lowering, target) {
    Some(callable) => callable
    None => return target
  }
  let trait_ = match requirement.kind {
    PlannedTraitMethodCallable(trait_) => trait_
    _ => return target
  }
  let mut receiver = UnknownSpecializationEvidenceType
  // The lowered expression already owns its exact inference target. Re-reading
  // the parent body's job at a lambda-relative offset selects unrelated data.
  match expression.call_target {
    BoundTraitBasicCallTarget(method, parameter, bound, _) => if self_host_u64_equal(method, target) && module_.resolved_types.types[bound] is TraitType(_) {
      receiver = self_host_specialization_parameter_evidence_type(caller, specialization, requests, parameter)
    }
    _ => {}
  }
  if receiver is UnknownSpecializationEvidenceType {
    return target
  }
  let mut selected = target
  let mut count = 0u32
  let mut module_index = 0u32
  for raw_module in lowering.modules {
    let candidate_module = self_host_planned_module_lowering_identity(raw_module)
    let collected = self_host_program_collected_module_at(lowering.collected, module_index)
    module_index = module_index + 1u32
    let mut implementation_index = 0u32
    for raw_impl in collected.impls {
      let implementation = self_host_collected_impl_identity(raw_impl)
      let index = implementation_index
      implementation_index = implementation_index + 1u32
      match candidate_module.resolved_types.impl_trait_types[index] {
        Some(type_) => match candidate_module.resolved_types.types[type_] {
          TraitType(candidate_trait) => if self_host_u64_equal(candidate_trait, trait_) {
            let generics = collected.generic_parameters_of(implementation.declaration)
            if self_host_u32_greater(generics.length, 0u32) {
              // A generic competitor requires a prerequisite proof, not a guess.
              return target
            }
            if self_host_specialization_evidence_type_equal(receiver, self_host_specialization_resolved_evidence_type(candidate_module, candidate_module.resolved_types.impl_target_types[index])) {
              for raw_method in candidate_module.functions.callables {
                let method = self_host_planned_callable_identity(raw_method)
                match method.kind {
                  PlannedImplMethodCallable(owner, Some(_)) => if self_host_u64_equal(owner, implementation.declaration) && method.name.equals(requirement.name) {
                    if self_host_u32_greater(method.generic_parameters.length, 0u32) {
                      return target
                    }
                    count = count + 1u32
                    selected = method.declaration
                  }
                  _ => {}
                }
              }
            }
          }
          _ => {}
        }
        None => {}
      }
    }
  }
  if count == 1u32 {
    selected
  } else {
    target
  }
}

fn self_host_linked_bound_call_declaration_matches(link: SelfHostPlannedProgramWasmGCLink, caller_body: U64, specialization: U32, expression: U32, requirement: U64, function_index: U32) -> Bool {
  if function_index >= link.functions.length() {
    return false
  }
  let function_ = self_host_planned_program_wasm_function_identity(link.functions[function_index])
  if !self_host_u32_equal(function_.function_index, function_index) {
    return false
  }
  let lowering = link.fragments.specialization.lowering
  let owner = match lowering.index.body_owner(caller_body) {
    Some(owner) => owner
    None => return false
  }
  let module_ = self_host_planned_module_lowering_identity(lowering.modules[owner])
  let body = match self_host_program_specialization_body(module_, caller_body) {
    Some(body) => body
    None => return false
  }
  if expression < body.expressions.start || expression - body.expressions.start >= body.expressions.length {
    return false
  }
  let caller = self_host_program_specialization_callable(module_, body.declaration)
  let verified = self_host_program_specialization_bound_target(lowering, module_, body, expression - body.expressions.start, caller, specialization, link.fragments.specialization.requests, requirement)
  !self_host_u64_equal(verified, requirement) && self_host_u64_equal(verified, function_.declaration) && self_host_linked_function_declaration_module_matches(link, function_index, verified)
}

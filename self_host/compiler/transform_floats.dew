builtin ct_host_f32_abs(v0: F32) -> F32 = "f32.abs"
builtin ct_host_f32_neg(v0: F32) -> F32 = "f32.neg"
builtin ct_host_f32_sqrt(v0: F32) -> F32 = "f32.sqrt"

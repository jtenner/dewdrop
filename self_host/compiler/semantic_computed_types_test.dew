open dew.std.testing

test "deferred member call inference preserves exact generic owners" {
  let lowering = self_host_physical_test_lowering(
    b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box<t> {\n item: t\n}\nfn keep<t>(value: member<t>(\"item\")) -> member<t>(\"item\") {\n value\n}\nfn forward<t>(value: member<t>(\"item\")) -> member<t>(\"item\") {\n keep::<t>(value)\n}\npub fn main() -> I64 {\n forward::<Box<I64>>(42i64)\n}\n",
  )
  for module_ in lowering.modules {
    assert(module_.inferred.diagnostics.length() == 0u32, "projected calls and generic forwarding infer without errors")
  }
}

test "deferred member owner may come from a later argument" {
  let lowering = self_host_physical_test_lowering(
    b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box<t> {\n item: t\n}\nfn keep<t>(value: member<t>(\"item\"), owner: t) -> member<t>(\"item\") {\n value\n}\npub fn main() -> I64 {\n keep(42i64, Box::{\n item: 0i64\n })\n}\n",
  )
  for module_ in lowering.modules {
    assert(module_.inferred.diagnostics.length() == 0u32, "member equations wait for the owner argument")
  }
}

test "member projection cannot infer an owner or hide rollback" {
  let fixture = self_host_unification_test_types()
  let solver = SelfHostLocalTypeSolver::new(fixture.resolved)
  let owner = solver.fresh_variable()
  let projection = solver.member_projection_type(owner, b"types.field_type", "item")
  let origin = self_host_call_type_origin(17u32, 91u32)
  let snapshot = solver.snapshot()
  assert(!solver.unify(owner, projection, origin), "projection owner cycles must fail")
  assert(solver.diagnostics[0u32] is InfiniteLocalType(_, _, _), "exact occurs-check diagnostic")
  solver.rollback(snapshot)
  assert(solver.diagnostics.length() == 0u32, "rollback restores diagnostics")
  assert(solver.has_unresolved_variable(projection), "rollback restores the unknown owner")
  assert(solver.zonk_type(projection) == projection, "unknown projection remains structural")
  assert(!solver.unify(projection, solver.resolved_type(fixture.resolved.primitive(I64Type)), origin), "member projection is not injective")
  assert(solver.representative_type(owner) == owner, "output type cannot choose its owner")
}

test "invalid member owner keeps the exact constraint origin" {
  let fixture = self_host_unification_test_types()
  let solver = SelfHostLocalTypeSolver::new(fixture.resolved)
  let scalar = solver.resolved_type(fixture.resolved.primitive(I64Type))
  let projection = solver.member_projection_type(scalar, b"types.field_type", "item")
  let origin = self_host_call_type_origin(11u32, 73u32)
  assert(!solver.unify(projection, scalar, origin), "scalar member owner is invalid")
  match solver.diagnostics[0u32] {
    InvalidLocalMemberProjection(type_, message, actual_origin) => {
      assert(type_ == projection && message == "CT-032 member type query requires a struct or enum", "exact member diagnostic")
      assert(self_host_type_origin_equal(origin, actual_origin), "exact call origin")
    }
    _ => assert(false, "expected member diagnostic")
  }
}

test "local computed type bindings keep block and lambda scope" {
  let lowering = self_host_physical_test_lowering(
    b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box<t> {\n item: t\n}\nfn identity<t>(value: t) -> t {\n value\n}\npub fn main() -> I64 {\n type Item = member<Box<I64>>(\"item\")\n let read = fn(value: Item) -> Item {\n type Inner = Item\n identity::<Inner>(value)\n }\n if true {\n type Item = I32\n identity::<Item>(1i32)\n } else {\n 0i32\n }\n read(identity::<Item>(2i64))\n}\n",
  )
  match self_host_validate_program_lowering(lowering) {
    Some(error) => assert(false, error)
    None => {}
  }
  assert(lowering.modules[0u32].lambdas.length() == 1u32, "one lambda")
  assert(lowering.modules[0u32].lambdas[0u32].result_shape is I64PlannedValueShape, "local type aliases are real I64 types")
}

test "unused local type bindings still diagnose invalid types" {
  let collected = self_host_collect_bytes(24720u64, b"fn main() -> Unit {\n type Missing = UnknownType\n}\n")
  assert(collected.diagnostics.length() == 0u32, "local type syntax")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostic_count() > 0u32, "unused aliases must still resolve their type")
}

test "computed field types substitute each owner without leaking scratch state" {
  let collected = self_host_collect_bytes(
    24710u64,
    b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box<t> {\n item: t\n}\ntype First = member<Box<I32>>(\"item\")\ntype Second = member::<Box<I64>>(\"item\")\nfn use(a: First, b: Second) -> Unit {}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "computed field syntax")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostic_count() == 0u32, "computed field resolution")
  assert(resolved.parameter_types[1u32] == resolved.primitive(I32Type), "first member type")
  assert(resolved.parameter_types[2u32] == resolved.primitive(I64Type), "second member type")
}

test "computed variant payloads preserve order and the empty product" {
  let collected = self_host_collect_bytes(
    24711u64,
    b"builtin payload<t>(name: String) -> Type = \"types.variant_payload_types\"\nenum Choice<t> {\n Empty\n Pair(t, I32)\n Named {\n first: I64\n second: t\n }\n}\nfn use(a: payload<Choice<I64>>(\"Pair\"), b: payload<Choice<I32>>(\"Named\"), c: payload<Choice<I32>>(\"Empty\")) -> Unit {}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "computed payload syntax")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostic_count() == 0u32, "computed payload resolution")
  assert(resolved.parameter_types[1u32] == resolved.parameter_types[2u32], "tuple and named source order")
  match resolved.types[resolved.parameter_types[1u32]] {
    ProductType(span) => {
      assert(span.length == 2u32, "two payloads")
      assert(resolved.type_arguments[span.start] == resolved.primitive(I64Type), "first payload")
      assert(resolved.type_arguments[span.start + 1u32] == resolved.primitive(I32Type), "second payload")
    }
    _ => assert(false, "payload must be a product")
  }
  match resolved.types[resolved.parameter_types[3u32]] {
    ProductType(span) => assert(span.length == 0u32, "unit variant has no payload")
    _ => assert(false, "empty payload must remain a product")
  }
}

test "computed imported members preserve generic identity" {
  let fixture = self_host_imported_semantics_fixture(
    b"import app.library as @lib\nfn use(a: @lib.member<@lib.Box<I64>>(\"item\")) -> I64 {\n a\n}\n",
    b"pub builtin member<t>(name: String) -> Type = \"types.field_type\"\npub struct Box<t> {\n item: t\n}\n",
  )
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "member imports")
  let resolved = fixture.frozen.interfaces.at(0u32).resolved_types
  assert(resolved.diagnostic_count() == 0u32, "imported member resolution")
  assert(resolved.parameter_types[0u32] == resolved.primitive(I64Type), "imported generic member")
}

test "computed types report missing members and cycles at source" {
  for entry in [
    (b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box {\n item: I32\n}\ntype Missing = member<Box>(\"other\")\n", "CT-032 no such member: other"),
    (b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box {\n item: member<Box>(\"item\")\n}\n", "CT-033 cyclic computed type"),
    (b"fn member<t>(name: String) -> I32 {\n 0\n}\nstruct Box {}\ntype Invalid = member<Box>(\"item\")\n", "CT-030 ordinary functions cannot be used as types"),
    (b"builtin member<t>(name: I32) -> Type = \"types.field_type\"\nstruct Box {}\ntype Invalid = member<Box>(\"item\")\n", "CT-031 type queries require a String selector and return Type"),
  ] {
    let (source, expected) = entry
    let collected = self_host_collect_bytes(24712u64, source)
    assert(collected.diagnostics.length() == 0u32, "negative computed type syntax")
    let resolved = self_host_resolve_module_types(collected)
    let mut found = false
    for diagnostic in resolved.diagnostics {
      match diagnostic {
        ComputedTypeFailure(owner, message, offset) => {
          assert(owner != 0u64 && offset > 0u32, "computed error context")
          if message == expected {
            found = true
          }
        }
        _ => self_host_semantic_unit()
      }
    }
    assert(found, "computed error must remain visible")
  }
}

test "computed parser keeps split generic closers and rejects non-string selectors" {
  let collected = self_host_collect_bytes(
    24713u64,
    b"struct Box<t> {}\nfn identity<t>(value: t) -> t {\n value\n}\nfn use(value: Box<I64>) -> Box<I64> {\n identity::<Box<I64>>(value)\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "ordinary nested generic call syntax")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostic_count() == 0u32, "ordinary nested generic call types")
  match self_host_parse_type_source(b"member<I64>(1)") {
    Err(_) => {}
    Ok(_) => assert(false, "non-string selector must be a parse error")
  }
}

test "computed generic aliases normalize explicit call arguments" {
  let collected = self_host_collect_bytes(
    24714u64,
    b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nstruct Box<t> {\n item: t\n}\ntype Item<t> = member<Box<t>>(\"item\")\nfn identity<t>(value: t) -> t {\n value\n}\nfn use(value: Item<I64>) -> member<Box<I64>>(\"item\") {\n identity::<Item<I64>>(value)\n}\n",
  )
  assert(collected.diagnostic_count() == 0u32, "generic projection alias syntax")
  let resolved = self_host_resolve_module_types(collected)
  for diagnostic in resolved.diagnostics {
    match diagnostic {
      ComputedTypeFailure(_, message, _) => assert(false, message)
      _ => assert(false, "unexpected generic projection diagnostic")
    }
  }
  assert(resolved.explicit_call_type_arguments.length() == 1u32, "one explicit logical argument")
  assert(resolved.explicit_call_type_arguments[0u32] == resolved.primitive(I64Type), "generic projection alias must normalize to I64")
}

test "imported computed builtins normalize generic aliases in calls" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nstruct Box<t> {\n item: t\n}\ntype Item<t> = member<Box<t>>(\"item\")\nfn identity<t>(value: t) -> t {\n value\n}\nfn use(value: Item<I64>) -> member<Box<I64>>(\"item\") {\n identity::<Item<I64>>(value)\n}\n",
    b"pub builtin member<t>(name: String) -> Type = \"types.field_type\"\n",
  )
  let resolved = fixture.frozen.interfaces.at(0u32).resolved_types
  for diagnostic in resolved.diagnostics {
    match diagnostic {
      ComputedTypeFailure(_, message, _) => assert(false, message)
      _ => assert(false, "unexpected imported generic projection diagnostic")
    }
  }
  assert(resolved.explicit_call_type_arguments.length() == 1u32, "one imported query call type argument")
  assert(resolved.explicit_call_type_arguments[0u32] == resolved.primitive(I64Type), "imported generic projection alias must normalize to I64")
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  for diagnostic in lowering.modules[0u32].inferred.diagnostics {
    assert(false, self_host_inference_diagnostic_name(diagnostic))
  }
  for type_ in lowering.modules[0u32].inferred.call_type_arguments {
    match self_host_read_compile_time_type(lowering.modules[0u32], type_, self_host_empty_compile_time_bindings(), 0u32) {
      Ok(value) => self_host_test_query_bool(b"types.type_equal", [value, PrimitiveCompileTimeType(I64Type)], true)
      Err(error) => assert(false, error)
    }
  }
}

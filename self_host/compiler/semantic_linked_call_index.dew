open dew.std.map
open dew.std.option

pub struct SelfHostLinkedCallIndex {
  plain_functions: Map<U64, U32>
  heads: Map<U64, U32>
  keys: Array<U64>
  functions: Array<U32>
  next: Array<U32>
  bodies: Array<U64>
}

fn self_host_linked_call_index_get(index: SelfHostLinkedCallIndex, body: U64, specialization: U32, expression: U32) -> Option<U32> {
  self_host_body_specialized_call_index_get(
    index, body, self_host_body_call_key(specialization, expression),
  )
}

fn self_host_build_linked_call_index(
  functions: Array<SelfHostPlannedProgramWasmFunction>,
  calls: Array<SelfHostPlannedProgramSpecializedCallLink>,
) -> SelfHostLinkedCallIndex {
  let index = {
    plain_functions: self_host_body_empty_u64_u32_map()
    heads: self_host_body_empty_u64_u32_map()
    keys: []
    functions: []
    next: []
    bodies: []
  }
  for function_ in functions {
    if self_host_u32_equal(function_.specialization, 4294967295u32) &&
      self_host_u32_equal(function_.lambda, 4294967295u32) &&
      !self_host_u64_equal(function_.declaration, 0u64) {
      match index.plain_functions.get(function_.declaration) {
        Some(previous) => {
          let _ = self_host_assert_compiler_invariant_with_failure(
            self_host_u32_equal(previous, function_.function_index),
            {
              code: 504u32
              phase: 5u32
              module_id: self_host_semantic_id_module(function_.declaration)
              declaration: function_.declaration
              body: 0u64
              expression: 4294967295u32
              expected: u32_into_u64(previous)
              actual: u32_into_u64(function_.function_index)
              detail: u32_into_u64(function_.fragment_index)
            },
            "one declaration has two plain linked functions",
          )
        }
        None => index.plain_functions.set(function_.declaration, function_.function_index)
      }
    }
  }
  for call in calls {
    self_host_body_specialized_call_index_append(index, call.caller_body,
      self_host_body_call_key(call.caller_specialization, call.expression), call.function_index)
  }
  index
}

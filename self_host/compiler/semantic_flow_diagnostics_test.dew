open dew.std.option
open dew.std.string
open dew.std.testing

fn self_host_flow_gate_test_lowering(source: Bytes) -> SelfHostPlannedProgramLowering {
  self_host_plan_program_lowering(
    self_host_freeze_program_signature_interfaces(
      self_host_collect_program_manifest(8200u64, {
        modules: [{
          path: "app.main"
          files: [{
            path: "main.dew"
            source: source
            test_only: false
          }]
        }]
      }),
    ),
  )
}

fn self_host_flow_gate_test_error(
  lowering: SelfHostPlannedProgramLowering,
  kind: String,
  source: String,
) -> Unit {
  match self_host_validate_program_lowering(lowering) {
    Some(message) => {
      assert(message.contains(kind), message)
      assert(message.contains("module=8200"), message)
      assert(message.contains(source), message)
      assert(message.contains("offset="), message)
    }
    None => assert(false, "source flow error must stop lowering")
  }
}

test "flow gate rejects a missing match case" {
  let lowering = self_host_flow_gate_test_lowering(
    b"pub fn read(value: Bool) -> I32 {\n  match value {\n    true => 42\n  }\n}\n",
  )
  assert(lowering.modules[0u32].flow_diagnostics.length() == 1u32, "one source flow error")
  assert(lowering.modules[0u32].flow_diagnostics[0u32] is NonExhaustiveMatch(_, _, _), "missing match case")
  assert(self_host_validate_program_inference(lowering) is None, "valid types")
  self_host_flow_gate_test_error(lowering, "non-exhaustive match", "expression=")
}

test "flow gate rejects a missing functional loop case" {
  let lowering = self_host_flow_gate_test_lowering(
    b"pub fn read(value: Bool) -> I32 {\n  while value {\n    true => break 42\n  }\n}\n",
  )
  assert(lowering.modules[0u32].flow_diagnostics.length() == 1u32, "one source loop error")
  assert(lowering.modules[0u32].flow_diagnostics[0u32] is NonExhaustiveFunctionalLoop(_, _, _), "missing loop case")
  assert(self_host_validate_program_inference(lowering) is None, "valid loop types")
  self_host_flow_gate_test_error(lowering, "non-exhaustive functional loop", "expression=")
}

test "flow gate rejects functional loop fallthrough" {
  let lowering = self_host_flow_gate_test_lowering(
    b"pub fn read(value: I32) -> I32 {\n  while value {\n    current => current\n  }\n}\n",
  )
  assert(lowering.modules[0u32].flow_diagnostics.length() == 1u32, "one source fallthrough error")
  assert(lowering.modules[0u32].flow_diagnostics[0u32] is FunctionalLoopArmFallsThrough(_, _), "loop falls through")
  self_host_flow_gate_test_error(lowering, "functional loop arm falls through", "arm=")
}

test "flow gate rejects coverage budget errors and accepts warnings" {
  let lowering = self_host_flow_gate_test_lowering(b"pub fn read() -> I32 {\n  42\n}\n")
  assert(self_host_validate_program_lowering(lowering) is None, "valid source")
  let diagnostics = lowering.modules[0u32].flow_diagnostics
  diagnostics.push(RedundantPatternArm(0u32, 0u32))
  diagnostics.push(UnreachableBlockItem(0u32, 0u32, 0u32))
  assert(self_host_validate_program_lowering(lowering) is None, "warnings must permit lowering")
  diagnostics.push(PatternCoverageBudgetExceeded(0u32, 65536u32, 64u32, 0u32))
  self_host_flow_gate_test_error(lowering, "pattern coverage budget exceeded", "expression=")
}

open dew.std.option

fn self_host_program_root_body(module_: SelfHostPlannedModuleLowering, declaration: U64) -> Option<SelfHostPlannedBodyLowering> {
  let body = match self_host_program_specialization_callable(module_, declaration) {
    Some(callable) => self_host_program_specialization_callable_body(callable)
    None => {
      let local = self_host_semantic_id_local(declaration)
      if local >= module_.initialization.declaration_steps.length() {
        return None
      }
      let step = module_.initialization.declaration_steps[local]
      if step >= module_.initialization.steps.length() {
        return None
      }
      match module_.initialization.steps[step].kind {
        PlannedInitializeModuleValue(owner, body, _) if owner == declaration => Some(body)
        _ => None
      }
    }
  }
  match body {
    Some(body) => self_host_program_specialization_body(module_, body)
    None => None
  }
}

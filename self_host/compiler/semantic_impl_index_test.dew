open dew.std.testing

fn self_host_impl_index_source(source: Bytes) -> SelfHostModuleImplIndex {
  let collected = self_host_collect_bytes(910u64, source)
  let resolved = self_host_resolve_module_types(collected)
  self_host_index_module_implementations(collected, resolved)
}

test "trait method signatures compare substituted tuple fields" {
  let valid = self_host_impl_index_source(
    b"trait Convert<t> {\n  fn convert(self, value: (t, I64)) -> (t, I64)\n}\nstruct Item {}\nimpl Convert<I32> for Item {\n  fn convert(self, value: (I32, I64)) -> (I32, I64) {\n    value\n  }\n}\n",
  )
  assert(valid.diagnostic_count() == 0u32, "substituted tuple signature")
  let invalid = self_host_impl_index_source(
    b"trait Convert<t> {\n  fn convert(self, value: (t, I64)) -> (t, I64)\n}\nstruct Item {}\nimpl Convert<I32> for Item {\n  fn convert(self, value: (I32, Bool)) -> (I32, Bool) {\n    value\n  }\n}\n",
  )
  let mut parameters = 0u32
  let mut results = 0u32
  for diagnostic in invalid.diagnostics {
    match diagnostic {
      TraitMethodParameterTypeMismatch(_, _, _, _) => {
        parameters = parameters + 1u32
      }
      TraitMethodReturnTypeMismatch(_, _, _) => {
        results = results + 1u32
      }
      _ => assert(false, "unexpected tuple signature diagnostic")
    }
  }
  assert(parameters == 1u32, "exact parameter mismatch")
  assert(results == 1u32, "exact result mismatch")
}

test "implementation index accepts distinct concrete heads" {
  let index = self_host_impl_index_source(
    b"pub trait Mark {}\npub struct Box<t> {}\nimpl Mark for Box<I32> {}\nimpl Mark for Box<I64> {}\n",
  )
  assert(index.implementations.length() == 2u32, "implementation count")
  assert(index.diagnostic_count() == 0u32, "distinct implementation diagnostics")
  assert(index.implementations[0u32].coherent, "first coherent")
  assert(index.implementations[1u32].coherent, "second coherent")
}

test "implementation index ranks strict generic specialization" {
  let index = self_host_impl_index_source(
    b"pub trait Mark {}\npub struct Box<t> {}\nimpl<t> Mark for Box<t> {}\nimpl Mark for Box<I32> {}\n",
  )
  assert(index.diagnostic_count() == 0u32, "specialization diagnostics")
  assert(index.implementations[0u32].coherent, "general coherent")
  assert(index.implementations[1u32].coherent, "specific coherent")
  assert(
    self_host_u32_equal(index.implementations[1u32].specificity, 1u32),
    "specificity",
  )
}

test "implementation index diagnoses equivalent generic overlap" {
  let index = self_host_impl_index_source(
    b"pub trait Mark {}\npub struct Box<t> {}\nimpl<t> Mark for Box<t> {}\nimpl<u> Mark for Box<u> {}\n",
  )
  let mut overlap = 0u32
  for diagnostic in index.diagnostics {
    match diagnostic {
      OverlappingTraitImpl(_, _, _, _, _) => {
        overlap = overlap + 1u32
      }
      _ => {}
    }
  }
  assert(overlap == 1u32, "overlap diagnostic")
  assert(!index.implementations[0u32].coherent, "first overlap incoherent")
  assert(!index.implementations[1u32].coherent, "second overlap incoherent")
}

test "implementation index diagnoses duplicate inherent methods" {
  let index = self_host_impl_index_source(
    b"pub struct Box {}\nimpl Box {\n  fn value(self) -> I32 {\n    1\n  }\n}\nimpl Box {\n  fn value(self) -> I32 {\n    2\n  }\n}\n",
  )
  let mut duplicate = 0u32
  let mut diagnostic = 0u32
  let _ = while diagnostic {
    current => if current < index.diagnostic_count() {
      match index.diagnostic_at(current) {
        DuplicateInherentMethod(_, _, _, _) => {
          duplicate = duplicate + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(duplicate == 1u32, "duplicate method diagnostic")
}

test "implementation index diagnoses missing and unknown trait methods" {
  let missing = self_host_impl_index_source(
    b"pub trait Read {\n  fn read(self) -> I32\n}\npub struct Box {}\nimpl Read for Box {}\n",
  )
  let unknown = self_host_impl_index_source(
    b"pub trait Read {}\npub struct Box {}\nimpl Read for Box {\n  fn extra(self) -> I32 {\n    1\n  }\n}\n",
  )
  let mut missing_count = 0u32
  for diagnostic in missing.diagnostics {
    match diagnostic {
      MissingTraitMethod(_, _, _) => {
        missing_count = missing_count + 1u32
      }
      _ => {}
    }
  }
  let mut unknown_count = 0u32
  for diagnostic in unknown.diagnostics {
    match diagnostic {
      UnknownTraitImplMethod(_, _, _) => {
        unknown_count = unknown_count + 1u32
      }
      _ => {}
    }
  }
  assert(missing_count == 1u32, "missing trait method")
  assert(unknown_count == 1u32, "unknown trait method")
}

test "implementation index diagnoses trait method shape mismatches" {
  let index = self_host_impl_index_source(
    b"pub trait Read {\n  fn read(self, value: I32) -> I32\n}\npub struct Box {}\nimpl Read for Box {\n  fn read(value: I32) -> I32 {\n    value\n  }\n}\n",
  )
  let mut receiver = 0u32
  let mut arity = 0u32
  for diagnostic in index.diagnostics {
    match diagnostic {
      TraitMethodReceiverMismatch(_, _, _) => {
        receiver = receiver + 1u32
      }
      TraitMethodParameterCountMismatch(_, _, _, _, _) => {
        arity = arity + 1u32
      }
      _ => {}
    }
  }
  assert(receiver == 1u32, "receiver mismatch")
  assert(arity == 1u32, "parameter mismatch")
}

test "implementation index validates substituted trait method signatures" {
  let valid = self_host_impl_index_source(
    b"pub trait Convert<t> {\n  fn convert<u>(self, input: u) -> t\n}\npub struct Box<t> {}\nimpl<t> Convert<t> for Box<t> {\n  fn convert<u>(self, input: u) -> t {\n    self_host_semantic_unit()\n  }\n}\n",
  )
  let mismatch = self_host_impl_index_source(
    b"pub trait Read {\n  fn read(self, input: I32) -> I32\n}\npub struct Box {}\nimpl Read for Box {\n  fn read(self, input: String) -> String {\n    input\n  }\n}\n",
  )
  let mut parameter_mismatch = 0u32
  let mut return_mismatch = 0u32
  for diagnostic in mismatch.diagnostics {
    match diagnostic {
      TraitMethodParameterTypeMismatch(_, _, _, _) => {
        parameter_mismatch = parameter_mismatch + 1u32
      }
      TraitMethodReturnTypeMismatch(_, _, _) => {
        return_mismatch = return_mismatch + 1u32
      }
      _ => {}
    }
  }
  assert(valid.diagnostic_count() == 0u32, "substituted signature")
  assert(parameter_mismatch == 1u32, "parameter type mismatch")
  assert(return_mismatch == 1u32, "return type mismatch")
}

test "implementation index publishes coherent method dispatch" {
  let index = self_host_impl_index_source(
    b"pub trait Read {\n  fn read(self) -> I32\n}\npub struct Box {}\nimpl Read for Box {\n  fn read(self) -> I32 {\n    1\n  }\n}\nimpl Box {\n  fn clear(self) -> Unit {\n  }\n}\n",
  )
  assert(index.diagnostic_count() == 0u32, "dispatch diagnostics")
  assert(index.methods.length() == 2u32, "indexed methods")
  assert(index.method_dispatch.length() == 2u32, "method dispatch")
  assert(index.trait_method_dispatch.length() == 1u32, "trait dispatch")
  assert(
    index.methods[index.trait_method_dispatch[0u32].method_index].requirement is Some(_),
    "trait requirement",
  )
}

test "implementation index omits incoherent method dispatch" {
  let index = self_host_impl_index_source(
    b"pub trait Read {\n  fn read(self) -> I32\n}\npub struct Box {}\nimpl Read for Box {\n  fn read(self) -> String {\n    \"bad\"\n  }\n}\n",
  )
  assert(index.method_dispatch.length() == 0u32, "incoherent dispatch")
  assert(index.trait_method_dispatch.length() == 0u32, "incoherent trait dispatch")
}

test "implementation index merges imported evidence and dispatch" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run(value: Box) -> I32 {\n  value.mark()\n}\n",
    b"pub trait Mark {\n  fn mark(self) -> I32\n}\npub struct Box {}\nimpl Mark for Box {\n  fn mark(self) -> I32 {\n    1\n  }\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  assert(index.implementations.length() == 1u32, "imported implementation")
  assert(index.methods.length() == 1u32, "imported method")
  assert(index.method_dispatch.length() == 1u32, "imported dispatch")
  assert(index.trait_method_dispatch.length() == 1u32, "imported trait dispatch")
}

test "implementation index diagnoses orphan imported trait implementations" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nimpl Mark for Item {}\n",
    b"pub trait Mark {}\npub struct Item {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let scope = fixture.imports.scope
  let resolved = self_host_resolve_module_types_with_imports(collected, scope)
  let index = self_host_index_module_implementations(collected, resolved)
  let mut orphan = 0u32
  let mut diagnostic = 0u32
  let _ = while diagnostic {
    current => if current < index.diagnostic_count() {
      match index.diagnostic_at(current) {
        OrphanTraitImpl(_, _, _, _) => {
          orphan = orphan + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(orphan == 1u32, "orphan diagnostic")
}

test "implementation index rejects invalid target heads" {
  let index = self_host_impl_index_source(
    b"pub trait Mark {}\nimpl<t> Mark for t {}\n",
  )
  let mut invalid = 0u32
  let mut diagnostic = 0u32
  let _ = while diagnostic {
    current => if current < index.diagnostic_count() {
      match index.diagnostic_at(current) {
        InvalidImplTargetHead(_, _) => {
          invalid = invalid + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(invalid == 1u32, "invalid target diagnostic")
}

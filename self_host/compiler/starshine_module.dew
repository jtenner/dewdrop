        SelfHostLinkedI32EmitTask::EmitLinkedI32If(
          destination,
          consequent,
          alternative,
          result_shape,
        ) => {
          let block_type = self_host_linked_block_type(result_shape)
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_if(
              block_type,
              consequent,
              alternative,
            ),
          )
          // Wasm erases Never to a void signature. Retain the logical proof
          // after a call_ref dispatch, so an enclosing value join cannot fall
          // through with an empty stack if a Never function were to return.
          if result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
            StarshineFfi.ffi_ffi_bridge_instructions_push(destination,
              StarshineFfi.ffi_lib_Instruction_unreachable_(),
            )
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Loop(
          destination,
          outer_body,
          loop_body,
          result_shape,

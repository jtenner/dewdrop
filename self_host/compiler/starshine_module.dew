        SelfHostLinkedI32EmitTask::EmitLinkedI32If(
          destination,
          consequent,
          alternative,
          result_shape,
        ) => {
          let block_type = self_host_linked_block_type(result_shape)
          StarshineFfi.ffi_ffi_bridge_instructions_push(

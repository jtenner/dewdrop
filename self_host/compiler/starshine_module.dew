            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
              link,
              field_link,
            )
            Option::None => 0u64
          }
        } else {
          0u64
        }
        _ => 0u64
      }
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => self_host_linked_direct_call_result_nominal_declaration(
      link,
      module_,
      body,
      declaration,
      target,
      arguments,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => self_host_linked_unresolved_method_call_result_nominal_declaration(
      link,
      module_,
      body,
      subject,
    )
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_match_subject_nominal_declaration(
          link,
          module_,
          body,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      subject,
      0u32,
    ) {
      self_host_linked_match_subject_nominal_declaration(
        link,
        module_,
        body,
        self_host_u32_subtract(subject, 1u32),
      )
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(source) => if !self_host_u32_equal(source, subject) {
        self_host_linked_match_subject_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
      } else {
        0u64
      }
      Option::None => self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        subject,
      )
    }
    _ => 0u64
  }
}

fn self_host_linked_pattern_subject_nominals(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
) -> Array<U64> {
  let values = []
  let mut pattern_index = 0u32
  let _ = while pattern_index {
    current => if current < module_.patterns.length() {
      values.push(0u64)

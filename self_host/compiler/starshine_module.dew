                  consequent,
                  alternative,
                  SelfHostPlannedValueShape::I32PlannedValueShape,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              _ => {
                let string_comparison = (operator is SelfHostHirBinaryOperator::Equal ||
                  operator is SelfHostHirBinaryOperator::NotEqual) && (
                  self_host_linked_expression_is_string_value(
                    module_,
                    left,
                  ) && self_host_linked_expression_is_string_value(
                    module_,
                    right,
                  )
                )
                if string_comparison {
                  return Option::Some("BOD-607 String comparison has no selected Eq or Ne target")
                }
                let emitted_right_shape = self_host_body_carrier_shape(
                  self_host_linked_exact_emitted_expression_carrier(
                    canonical_body_plan,
                    link,
                    module_,
                    body,
                    caller_specialization,
                    right,
                  ),
                )
                let inferred_right_shape = if !(emitted_right_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                  emitted_right_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                ) && !(emitted_right_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  emitted_right_shape
                } else {
                  match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    right,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      right,
                    )
                  }
                }
                let emitted_left_shape = self_host_body_carrier_shape(
                  self_host_linked_exact_emitted_expression_carrier(
                    canonical_body_plan,
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                  ),
                )
                let inferred_left_shape = if !(emitted_left_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                  emitted_left_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                ) && !(emitted_left_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  emitted_left_shape
                } else {
                  match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      left,
                    )
                  }
                }
                let left_shape = if left < module_.expressions.length() {
                  match module_.expressions[left].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_loop_binding_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      local,
                    ) {
                      Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                        Option::Some(shape),
                        inferred_left_shape,
                      )
                      Option::None => match self_host_linked_match_binding_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        local,
                      ) {
                        Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                          Option::Some(shape),
                          inferred_left_shape,
                        )
                        Option::None => match self_host_linked_local_declared_shape(
                          module_,
                          body,
                          local,
                        ) {
                          Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                            Option::Some(shape),
                            inferred_left_shape,
                          )
                          Option::None => match self_host_linked_local_parameter_shape(
                            link,
                            module_,
                            body,
                            caller_specialization,
                            local,
                          ) {
                            Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                              Option::Some(shape),
                              inferred_left_shape,
                            )
                            Option::None => inferred_left_shape
                          }
                        }
                      }
                    }
                    _ => inferred_left_shape
                  }
                } else {
                  inferred_left_shape
                }
                // Equality can retain a broad reference shape on one generic
                // operand after the other operand proves the scalar carrier.
                // Prefer that concrete scalar proof before selecting ref.eq.
                let binary_shape = self_host_linked_binary_operand_shape(
                  left_shape,
                  inferred_right_shape,
                )
                match self_host_physical_scalar_shape(binary_shape) {
                  SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                    right,
                    binary_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                  ) {
                    Result::Ok(unsigned_) => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                        operator,
                        unsigned_,
                        destination,
                      ),
                    )
                    Result::Err(error) => return Option::Some(error)
                  }
                  SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                      operator,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                      operator,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::RefPlannedValueShape => if operator is SelfHostHirBinaryOperator::Equal ||
                    operator is SelfHostHirBinaryOperator::NotEqual {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefBinary(
                      operator,
                      destination,
                    ))
                  } else {
                    let expected_binary_shape = self_host_linked_expression_expected_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    )
                    let reference_binary_shape = match self_host_physical_scalar_shape(
                      inferred_right_shape,
                    ) {
                      SelfHostPlannedValueShape::I32PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::I64PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::F32PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::F64PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::V128PlannedValueShape => inferred_right_shape
                      _ => match self_host_physical_scalar_shape(
                        expected_binary_shape,
                      ) {
                        SelfHostPlannedValueShape::I32PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::I64PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::F32PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::F64PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::V128PlannedValueShape => expected_binary_shape
                        _ => self_host_planned_merged_body_value_shape(
                          module_.resolved_types,
                          module_.inferred,
                          planned.type_,
                        )
                      }
                    }
                    match self_host_physical_scalar_shape(
                      reference_binary_shape,
                    ) {
                      SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        left,
                        right,
                        reference_binary_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                      ) {
                        Result::Ok(unsigned_) => tasks.push(
                          SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                            operator,
                            unsigned_,
                            destination,
                          ),
                        )
                        Result::Err(error) => return Option::Some(error)
                      }
                      SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                        SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                          operator,
                          destination,
                        ),
                      )
                      SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                        SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                          operator,
                          destination,
                        ),
                      )
                      SelfHostPlannedValueShape::I32PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        left,
                        right,
                        self_host_linked_i32_unsigned_shape(reference_binary_shape),
                      ) {
                        Result::Ok(unsigned_) => tasks.push(
                          SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                            operator,
                            unsigned_,
                            destination,
                          ),
                        )
                        Result::Err(error) => return Option::Some(error)
                      }
                      _ => {
                        let message = StringBuilder::new()
                        message.append("linked reference binary operator is unsupported module=")
                        message.append_u64(module_.module_id)
                        message.append(" declaration=")
                        message.append_u64(body.declaration)
                        message.append(" name=")
                        message.append(bytes_to_string(self_host_linked_declaration_name(
                          link,
                          body.declaration,
                        )))
                        message.append(" body=")
                        message.append_u64(body.body)
                        message.append(" expression=")
                        message.append_u32(expression)
                        message.append(" left=")
                        message.append_u32(left)
                        if left < module_.expressions.length() {
                          message.append(":")
                          message.append(self_host_body_expression_kind_name(
                            module_.expressions[left].kind,
                          ))
                          message.append(":type=")
                          message.append_i32(self_host_planned_expression_at(module_.expressions, left).type_)
                          message.append(":nominal=")
                          message.append_u64(module_.expressions[left].nominal)
                        }
                        message.append(" right=")
                        message.append_u32(right)
                        if right < module_.expressions.length() {
                          message.append(":")
                          message.append(self_host_body_expression_kind_name(
                            module_.expressions[right].kind,
                          ))
                          message.append(":type=")
                          message.append_i32(self_host_planned_expression_at(module_.expressions, right).type_)
                          message.append(":nominal=")
                          message.append_u64(module_.expressions[right].nominal)
                        }
                        message.append(" inferred_left=")
                        message.append(self_host_linked_shape_name(inferred_left_shape))
                        message.append(" inferred_right=")
                        message.append(self_host_linked_shape_name(inferred_right_shape))
                        message.append(" emitted_left=")
                        message.append(self_host_linked_shape_name(emitted_left_shape))
                        message.append(" emitted_right=")
                        message.append(self_host_linked_shape_name(emitted_right_shape))
                        message.append(" expected=")
                        message.append(self_host_linked_shape_name(expected_binary_shape))
                        message.append(" fallback=")
                        message.append(self_host_linked_shape_name(reference_binary_shape))
                        if left < module_.expressions.length() {
                          match module_.expressions[left].kind {
                            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(left_target, _) => {
                              let field_target = if left_target < module_.expressions.length() &&
                                module_.expressions[left_target].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                                self_host_u32_greater(left_target, 0u32) {
                                self_host_u32_subtract(left_target, 1u32)
                              } else {
                                left_target
                              }
                              message.append(" left_target=")
                              message.append_u32(left_target)
                              message.append(":field=")
                              message.append_u32(field_target)
                              if field_target < module_.expressions.length() {
                                message.append(":")
                                message.append(self_host_body_expression_kind_name(
                                  module_.expressions[field_target].kind,
                                ))
                                match module_.expressions[field_target].kind {
                                  SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => {
                                    let exact_receiver = if receiver < module_.expressions.length() &&
                                      module_.expressions[receiver].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                                      self_host_u32_greater(receiver, 0u32) {
                                      self_host_u32_subtract(receiver, 1u32)
                                    } else {
                                      receiver
                                    }
                                    message.append(":method=")
                                    if name < self_host_linked_module_name_count(module_) {
                                      message.append(self_host_linked_module_name_at(module_, name))
                                    } else {
                                      message.append("invalid")
                                    }
                                    message.append(":receiver=")
                                    message.append_u32(receiver)
                                    message.append(":exact_receiver=")
                                    message.append_u32(exact_receiver)
                                    if exact_receiver < module_.expressions.length() {
                                      message.append(":")
                                      message.append(self_host_body_expression_kind_name(
                                        self_host_planned_expression_at(
                                          module_.expressions,
                                          exact_receiver,
                                        ).kind,
                                      ))
                                      message.append(":type=")
                                      message.append_i32(self_host_planned_expression_at(
                                        module_.expressions,
                                        exact_receiver,
                                      ).type_)
                                    }
                                    message.append(":heap=")
                                    match self_host_linked_canonical_expression_heap_type(
                                      canonical_body_plan,
                                      module_,
                                      body,
                                      exact_receiver,
                                    ) {
                                      Option::Some(type_index) => message.append_u32(type_index)
                                      Option::None => message.append("none")
                                    }
                                    message.append(":argument=")
                                    match self_host_linked_expression_container_argument_shape(
                                      link,
                                      module_,
                                      body,
                                      exact_receiver,
                                      0u32,
                                    ) {
                                      Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                      Option::None => message.append("none")
                                    }
                                    match self_host_planned_expression_at(
                                      module_.expressions,
                                      exact_receiver,
                                    ).kind {
                                      SelfHostPlannedExpressionKind::PlannedLocalGet(local) => {
                                        message.append(":local=")
                                        message.append_u32(local)
                                        let receiver_type = self_host_planned_expression_at(
                                          module_.expressions,
                                          exact_receiver,
                                        ).type_
                                        if !(receiver_type < 0i32) {
                                          let inferred_index = self_host_i32_to_u32(receiver_type)
                                          let exact_inferred = self_host_merged_module_inference_identity(
                                            module_.inferred,
                                          )
                                          if inferred_index < exact_inferred.types.length() {
                                            message.append(":inferred_term=")
                                            match exact_inferred.types[inferred_index] {
                                              SelfHostBodyTypeTerm::BodyMemberTypeProjection(owner, _, _) => {
                                                message.append("member-projection:")
                                                message.append_i32(owner)
                                              }
                                              SelfHostBodyTypeTerm::BodyAppliedType(base, arguments) => {
                                                message.append("applied:")
                                                message.append_i32(base)
                                                message.append(":")
                                                message.append_u32(arguments.start)
                                                message.append("+")
                                                message.append_u32(arguments.length)
                                              }
                                              SelfHostBodyTypeTerm::BodyResolvedType(resolved) => {
                                                message.append("resolved:")
                                                message.append_u32(resolved)
                                              }
                                              SelfHostBodyTypeTerm::BodyVariableType(variable) => {
                                                message.append("variable:")
                                                message.append_u32(variable)
                                              }
                                              SelfHostBodyTypeTerm::BodyErrorType => message.append("error")
                                              SelfHostBodyTypeTerm::BodyProductType(_) => message.append("product")
                                              SelfHostBodyTypeTerm::BodyFunctionType(_, _) => message.append("function")
                                            }
                                          }
                                        }
                                        message.append(":local_argument=")
                                        match self_host_linked_local_first_type_argument_shape(
                                          module_,
                                          body,
                                          local,
                                        ) {
                                          Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                          Option::None => message.append("none")
                                        }
                                        message.append(":parameter_argument=")
                                        match self_host_linked_local_parameter_argument_shape(
                                          link,
                                          module_,
                                          body,
                                          local,
                                          0u32,
                                        ) {
                                          Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                          Option::None => message.append("none")
                                        }
                                        message.append(":parameter_position=")
                                        match self_host_linked_local_parameter_position(
                                          module_,
                                          body,
                                          local,
                                        ) {
                                          Option::Some(pair) => {
                                            let (position, count) = pair
                                            message.append_u32(position)
                                            message.append("/")
                                            message.append_u32(count)
                                            match link.fragments.specialization.lowering.index.declaration_owner(
                                              body.declaration,
                                            ) {
                                              Option::Some(owner) => {
                                                message.append(":owner=")
                                                message.append_u32(owner)
                                                if owner < link.fragments.specialization.lowering.modules.length() {
                                                  let callable_module = link.fragments.specialization.lowering.modules[owner]
                                                  match self_host_program_specialization_callable(
                                                    callable_module,
                                                    body.declaration,
                                                  ) {
                                                    Option::Some(callable) => {
                                                      message.append(":callable_parameters=")
                                                      message.append_u32(callable.parameters.start)
                                                      message.append("+")
                                                      message.append_u32(callable.parameters.length)
                                                      let parameter_index = self_host_u32_add(
                                                        callable.parameters.start,
                                                        position,
                                                      )
                                                      if parameter_index < callable_module.functions.parameters.length() {
                                                        let parameter = self_host_planned_parameter_identity(
                                                          callable_module.functions.parameters[parameter_index],
                                                        )
                                                        message.append(":parameter_type=")
                                                        message.append_u32(parameter.type_)
                                                        if parameter.type_ < self_host_linked_resolved_type_count(
                                                          callable_module,
                                                        ) {
                                                          match callable_module.resolved_types.type_at(
                                                            parameter.type_,
                                                          ) {
                                                              SelfHostResolvedType::AppliedType(base, arguments) => {
                                                                message.append(":applied=")
                                                                message.append_u32(base)
                                                                message.append(":arguments=")
                                                                message.append_u32(arguments.start)
                                                                message.append("+")
                                                                message.append_u32(arguments.length)
                                                              }
                                                              SelfHostResolvedType::NominalType(declaration) => {
                                                                message.append(":nominal=")
                                                                message.append_u64(declaration)
                                                              }
                                                              SelfHostResolvedType::PrimitiveType(_) => message.append(":primitive")
                                                              SelfHostResolvedType::ErrorType => message.append(":error")
                                                              SelfHostResolvedType::MemberTypeProjection(_, _, _) => message.append(":member-projection")
                                                              SelfHostResolvedType::TraitType(_) => message.append(":trait")
                                                              SelfHostResolvedType::SelfType(_) => message.append(":self")
                                                              SelfHostResolvedType::ProductType(_) => message.append(":product")
                                                              SelfHostResolvedType::FunctionType(_, _) => message.append(":function")
                                                              SelfHostResolvedType::GenericParameterType(_) => message.append(":generic")
                                                          }
                                                        }
                                                      }
                                                    }
                                                    Option::None => message.append(":callable=none")
                                                  }
                                                }
                                              }
                                              Option::None => message.append(":owner=none")
                                            }
                                          }
                                          Option::None => message.append("none")
                                        }
                                      }
                                      _ => {}
                                    }
                                  }
                                  _ => {}
                                }
                              }
                            }
                            _ => {}
                          }
                        }
                        return Option::Some(message.finish())
                      }
                    }
                  }
                  _ => match self_host_linked_integer_binary_unsigned_proof(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                    right,
                    self_host_linked_i32_unsigned_shape(left_shape),
                  ) {
                    Result::Ok(unsigned_) => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                        operator,
                        unsigned_,
                        destination,
                      ),
                    )
                    Result::Err(error) => return Option::Some(error)
                  }
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
            }
            SelfHostPlannedExpressionKind::PlannedDeferredExpression => {
              return Option::Some("CT-041 deferred source check reached emission")
            }
            SelfHostPlannedExpressionKind::PlannedDeadExpression => {
              return Option::Some("BOD-610 dead expression reached emission")
            }
            SelfHostPlannedExpressionKind::PlannedPoisonExpression => {
              let message = StringBuilder::new()
              message.append("linked emitter reached a poisoned expression module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" declaration_name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(
                link,
                body.declaration,
              )))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" offset=")
              message.append_u32(planned.offset)
              message.append(" source_name=")
              message.append_u32(planned.source_name)
              if planned.source_name < self_host_linked_module_name_count(module_) {
                message.append(":")
                message.append(self_host_linked_module_name_at(
                  module_,
                  planned.source_name,
                ))
              }
              message.append(self_host_linked_non_value_parent_context(
                module_,
                body,
                expression,
              ))
              return Option::Some(message.finish())
            }
            SelfHostPlannedExpressionKind::PlannedConsumedExpression => {
              let message = StringBuilder::new()
              message.append("linked emitter reached a consumed expression module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" declaration_name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(
                link,
                body.declaration,
              )))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" offset=")
              message.append_u32(planned.offset)
              message.append(" source_name=")
              message.append_u32(planned.source_name)
              if planned.source_name < self_host_linked_module_name_count(module_) {
                message.append(":")
                message.append(self_host_linked_module_name_at(
                  module_,
                  planned.source_name,
                ))
              }
              message.append(self_host_linked_non_value_parent_context(
                module_,
                body,
                expression,
              ))
              return Option::Some(message.finish())
            }
            SelfHostPlannedExpressionKind::PlannedStringConst(value) => self_host_emit_linked_text_constant(
              link,
              value,
              true,
              destination,
            )
            SelfHostPlannedExpressionKind::PlannedUnitConst => {}
            SelfHostPlannedExpressionKind::PlannedStringArrayConst(values) => {
              for value in values {
                self_host_emit_linked_text_constant(link, value, true, destination)
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_array_new_fixed(
                  StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(self_host_linked_array_runtime_base(link) + 5u32)),
                  StarshineFfi.ffi_lib_U32_new(self_host_u32_to_i32(values.length())),
                ),
              )
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(values.length()))))
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(values.length()))))
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_struct_new(StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(self_host_linked_array_wrapper_type(link)))))
            }
            SelfHostPlannedExpressionKind::PlannedBytesConst(value) => self_host_emit_linked_text_constant(
              link,
              value,
              false,
              destination,
            )
            SelfHostPlannedExpressionKind::PlannedCaptureGet(capture) => {
              let plan = match canonical_body_plan {
                Option::Some(value) => value
                Option::None => return Option::Some("capture read has no frozen body plan")
              }
              match self_host_emit_capture_get(link, plan, capture, true, destination) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
            }
            SelfHostPlannedExpressionKind::PlannedFunctionReference(declaration) => {

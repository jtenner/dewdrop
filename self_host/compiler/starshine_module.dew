                          Option::Some(shape) => {
                            canonical_payload_hint = shape
                          }
                          Option::None => match self_host_linked_local_scalar_use_shape(
                            link,
                            module_,
                            body,
                            caller_specialization,
                            local_id,
                          ) {
                            Option::Some(shape) => {
                              canonical_payload_hint = shape
                            }
                            Option::None => match self_host_linked_local_declared_shape(
                              module_,
                              body,
                              local_id,
                            ) {
                              Option::Some(shape) => if !(
                                shape is SelfHostPlannedValueShape::ErrorPlannedValueShape

            SelfHostHirPattern::AlternativePattern(first, remaining, _) => {
              match self_host_emit_reference_pattern_alternatives(link, module_, body, canonical_body_plan, first, remaining, scratch, destination) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}

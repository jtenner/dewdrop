fn self_host_linked_local_initializer_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let _ = module_.module_id
  if local_id >= body.local_initializers.length() {
    return Option::None
  }
  let value = self_host_body_u32_at(body.local_initializers, local_id)
  if self_host_u32_equal(value, 4294967295u32) {
    Option::None
  } else {
    Option::Some(value)
  }
}

fn self_host_linked_local_assignment_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let _ = module_.module_id
  if local_id >= body.local_assignments.length() {
    return Option::None
  }
  let value = self_host_body_u32_at(body.local_assignments, local_id)
  if self_host_u32_equal(value, 4294967295u32) {

                      link,
                      canonical_body_plan,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                      fields,
                      type_index,
                      tasks,
                      expression_depths,
                      destination,
                      depth,
                    ) {
                      Option::None => {}
                      Option::Some(error) => {
                        return Option::Some(error)
                      }
                    }
                  }
                  Option::None => {
                    return Option::Some("linked variant constructor has no physical type")
                  }
                }
              }
              _ => {
                let inferred_constructor_type = match self_host_linked_infer_constructor_type_index_by_target_name(
                link,
                module_,
                body,
                caller_specialization,
                target,
                fields,
              ) {
                Option::Some(type_index) => Option::Some(type_index)
                Option::None => self_host_linked_infer_constructor_type_index(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  if !self_host_u64_equal(
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  )
                } else if target < module_.expressions.length() &&
                  !self_host_u64_equal(
                    self_host_linked_expression_nominal_declaration(
                      link,
                      module_,
                      body,
                      target,
                    ),
                    0u64,
                  ) {
                  self_host_linked_expression_nominal_declaration(
                    link,
                    module_,
                    body,
                    target,
                  )
                } else if !self_host_u64_equal(
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                } else {
                  planned.nominal
                  },
                  fields,
                )
                }
                match inferred_constructor_type {
                Option::Some(type_index) => match self_host_linked_schedule_object_constructor(
                  link,
                  canonical_body_plan,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                  fields,
                  type_index,
                  tasks,
                  expression_depths,
                  destination,
                  depth,
                ) {
                  Option::Some(error) => {
                    return Option::Some(error)
                  }
                  Option::None => {}
                }
                Option::None => {
                  let message = StringBuilder::new()
                  message.append("linked constructor selection is unresolved module=")
                  message.append_u64(module_.module_id)
                  message.append(" body=")
                  message.append_u64(body.body)
                  message.append(" declaration=")
                  message.append_u64(body.declaration)
                  message.append(" name=")
                  match self_host_program_specialization_callable(
                    module_,
                    body.declaration,
                  ) {
                    Option::Some(callable) => message.append(
                      bytes_to_string(callable.name),
                    )
                    Option::None => {}
                  }
                  message.append(" expression=")
                  message.append_u32(expression)
                  message.append(" target=")
                  message.append_u32(target)
                  message.append(" nominal=")
                  message.append_u64(planned.nominal)
                  message.append(" fields=")
                  message.append_u32(fields.length)
                  message.append(" source_name=")
                  message.append_u32(planned.source_name)
                  if self_host_array_index_is_valid(
                    planned.source_name,
                    self_host_linked_module_name_count(module_),
                  ) {
                    message.append(":")
                    message.append(
                      self_host_linked_module_name_at(
                        module_,
                        planned.source_name,
                      ),
                    )
                  }
                  message.append(" target_kind=")
                  if self_host_array_index_is_valid(
                    target,
                    module_.expressions.length(),
                  ) {
                    message.append(
                      self_host_body_expression_kind_name(
                        module_.expressions[target].kind,
                      ),
                    )
                  } else {
                    message.append("out-of-bounds")
                  }
                  message.append(" expected_nominal=")
                  message.append_u64(
                    self_host_linked_expression_expected_nominal(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    ),
                  )
                  message.append(" body_result=")
                  message.append(if self_host_linked_is_body_result_expression(
                    module_,
                    body,
                    expression,
                  ) {
                    "true"
                  } else {
                    "false"
                  })
                  let body_end = self_host_u32_add(
                    body.expressions.start,
                    body.expressions.length,
                  )
                  let mut diagnostic_parent = self_host_u32_add(
                    expression,
                    1u32,
                  )
                  let _ = while diagnostic_parent {
                    parent_index => if parent_index < body_end && self_host_array_index_is_valid(
                      parent_index,
                      module_.expressions.length(),
                    ) {
                      match module_.expressions[parent_index].kind {
                        SelfHostPlannedExpressionKind::PlannedDirectCall(
                          parent_declaration,
                          _,
                          parent_arguments,
                          _,
                        ) => {
                          let parent_position = self_host_linked_argument_position(
                            module_,
                            parent_arguments,
                            expression,
                          )
                          if parent_position >= 0i32 {
                            message.append(" direct_argument_of=")
                            message.append_u32(parent_index)
                            message.append(":")
                            message.append_u64(parent_declaration)
                            message.append(":")
                            message.append(bytes_to_string(
                              self_host_linked_declaration_name(
                                link,
                                parent_declaration,
                              ),
                            ))
                            message.append(":position=")
                            message.append_u32(
                              self_host_i32_to_u32(parent_position),
                            )
                            message.append(":type=")
                            message.append_i32(
                              module_.expressions[parent_index].type_,
                            )
                            message.append(":body_result=")
                            message.append(if self_host_linked_is_body_result_expression(
                              module_,
                              body,
                              parent_index,
                            ) {
                              "true"
                            } else {
                              "false"
                            })
                            break self_host_semantic_unit()
                          }
                        }
                        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
                          parent_target,
                          parent_arguments,
                        ) => {
                          if self_host_u32_equal(
                            parent_target,
                            expression,
                          ) {
                            message.append(" call_target_of=")
                            message.append_u32(parent_index)
                            break self_host_semantic_unit()
                          }
                          let parent_position = self_host_linked_argument_position(
                            module_,
                            parent_arguments,
                            expression,
                          )
                          if parent_position >= 0i32 {
                            message.append(" unresolved_argument_of=")
                            message.append_u32(parent_index)
                            message.append(":position=")
                            message.append_u32(
                              self_host_i32_to_u32(parent_position),
                            )
                            message.append(":type=")
                            message.append_i32(
                              module_.expressions[parent_index].type_,
                            )
                            message.append(":body_result=")
                            message.append(if self_host_linked_is_body_result_expression(
                              module_,
                              body,
                              parent_index,
                            ) {
                              "true"
                            } else {
                              "false"
                            })
                            break self_host_semantic_unit()
                          }
                        }
                        _ => {}
                      }
                      continue self_host_u32_add(parent_index, 1u32)
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                  return Option::Some(message.finish())
                }
                }
              }
              }
              }
            }
            SelfHostPlannedExpressionKind::PlannedFieldGet(
              field,
              base,
              _,
            ) => match self_host_linked_canonical_field(
              canonical_body_plan,
              expression,
            ) {
              Option::Some(field_link) => {
                match self_host_linked_assert_field_get_carrier(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                  field,
                  field_link,
                ) {
                  Option::Some(error) => return Option::Some(error)
                  Option::None => {}
                }
                let value_carrier = self_host_linked_exact_emitted_expression_carrier(canonical_body_plan, link, module_, body, caller_specialization, expression)
                if value_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination))
                }
                match self_host_linked_erased_field_box_type(link, field, value_carrier) {
                  Option::Some(type_) => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(type_, 0u32, destination))
                  Option::None => {}
                }
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                  field_link.type_index,
                  field_link.field_index,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Option::Some("linked struct field read has no physical field")
              }
            }
            SelfHostPlannedExpressionKind::PlannedFieldSet(
              field,
              base,
              value,
            ) => match self_host_linked_struct_field(link, field) {
              Option::Some(field_link) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructSet(
                  field_link.type_index,
                  field_link.field_index,
                  destination,
                ))
                let value_carrier = self_host_linked_exact_emitted_expression_carrier(canonical_body_plan, link, module_, body, caller_specialization, value)
                if value_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier {
                  if !self_host_linked_physical_erased_unit_field(link, field, field_link) {
                    return Option::Some("linked Unit field write has no declared erased storage certificate")
                  }
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
                }
                match self_host_linked_erased_field_box_type(link, field, value_carrier) {
                  Option::Some(type_) => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(type_, destination))
                  Option::None => {}
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefCast(
                  field_link.type_index,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Option::Some("linked struct field write has no physical field")
              }
            }
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              declaration,
              target,
              arguments,
              _,
            ) => match match module_.expressions[expression].selection {
              SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
                _,
                _,
                _,
              ) => Option::None
              _ => self_host_linked_canonical_call_index(
                canonical_body_plan,
                link,
                body,
                caller_specialization,
                expression,
                declaration,
              )
            } {
              Option::Some(function_index) => {
                // Inline only a proved raw forwarding body. Keep its physical
                // function for exports and function references, and check the
                // frozen call recipe before replacing this direct call.
                if module_.expressions[expression].flow.falls_through {
                  match self_host_linked_builtin_name(link, declaration) {
                    Option::Some(raw_name) => if raw_name.equals(b"unsafe.bitcast") || self_host_raw_intrinsic_signature(raw_name) is Option::Some(_) {
                      match self_host_linked_assert_call_arguments(link, canonical_body_plan, module_, body, caller_specialization, expression, function_index, arguments) {
                        Option::Some(error) => return Option::Some(error)
                        Option::None => {}
                      }
                      match self_host_raw_intrinsic_error(raw_name, canonical_body_plan, module_, expression, arguments) {
                        Option::Some(error) => return Option::Some(error.description())
                        Option::None => {}
                      }
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedBuiltin(raw_name, destination))
                      match self_host_linked_i32_push_arguments(module_, arguments, destination, tasks, expression_depths, depth) {
                        Option::Some(error) => return Option::Some(error)
                        Option::None => {}
                      }
                      continue tasks.length()
                    }
                    Option::None => {}
                  }
                }
                if self_host_linked_builtin_name(link, declaration) is Option::None ||
                  self_host_linked_call_has_erased_specialization(canonical_body_plan, link, expression) {
                  match self_host_linked_schedule_frozen_call(canonical_body_plan, link, module_, body, caller_specialization, expression, function_index, arguments, destination, tasks, expression_depths, depth) {
                    Option::Some(error) => return Option::Some(error)
                    Option::None => {}
                  }
                  continue tasks.length()
                }
                let declaration_name = self_host_linked_declaration_name(
                  link,
                  declaration,
                )
                // A module-qualified call has no run-time receiver. The owner name is
                // syntax used to select the declaration, even when the selected
                // physical function has a first parameter.
                let direct_target_is_static_module = self_host_linked_call_target_is_namespace_selection(
                  module_,
                  target,
                )
                let direct_array_receiver = if self_host_linked_declaration_has_receiver(link, declaration) {
                  self_host_body_call_receiver_expression(link, module_, expression, declaration)
                } else if self_host_u32_greater(
                  arguments.length,
                  0u32,
                ) && arguments.start < module_.expression_children.length() {
                  module_.expression_children[arguments.start]
                } else {
                  4294967295u32
                }
                let specialized_shape = self_host_linked_physical_function_specialization_shape(
                  link,
                  function_index,
                )
                let direct_parameter_receiver_element_shape = if self_host_array_index_is_valid(
                  direct_array_receiver,
                  module_.expressions.length(),
                ) {
                  match module_.expressions[direct_array_receiver].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_parameter_argument_shape(
                      link,
                      module_,
                      body,
                      local,
                      0u32,
                    ) {
                      Option::Some(shape) => Option::Some(
                        self_host_body_specialization_shape(
                          link,
                          caller_specialization,
                          shape,
                        ),
                      )
                      Option::None => Option::None
                    }
                    _ => Option::None
                  }
                } else {
                  Option::None
                }
                let usage_shape = if !self_host_u32_equal(
                  direct_array_receiver,
                  4294967295u32,
                ) {
                  self_host_linked_array_value_use_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    canonical_body_plan,
                    direct_array_receiver,
                  )
                } else {
                  Option::None
                }
                let element_shape = match usage_shape {
                  Option::Some(shape) => shape
                  Option::None => if !(
                    specialized_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                  ) {
                    specialized_shape
                  } else {
                  match self_host_linked_call_first_type_argument_shape(
                    module_,
                    planned,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => match self_host_linked_call_base_element_shape(
                      module_,
                      arguments,
                    ) {
                      Option::Some(shape) => shape
                      Option::None => planned.shape
                    }
                  }
                }
                }
                let raw_array_get = match self_host_linked_builtin_name(link, declaration) {
                  Option::Some(name) => name.equals(b"array.get")
                  Option::None => false
                }
                let receiver_element_nominal = if !self_host_u32_equal(
                  direct_array_receiver,
                  4294967295u32,
                ) {
                  self_host_linked_expression_container_element_nominal_declaration(
                    link,
                    module_,
                    body,
                    direct_array_receiver,
                  )
                } else {
                  0u64
                }
                let source_receiver_element_shape = if !self_host_u32_equal(
                  direct_array_receiver,
                  4294967295u32,
                ) {
                  self_host_linked_expression_source_container_element_shape(
                    link,
                    module_,
                    body,
                    direct_array_receiver,
                  )
                } else {
                  Option::None
                }
                let helper_specialization_shape = if self_host_linked_declaration_name(
                  link,
                  body.declaration,
                ).equals(b"self_host_array_pop") {
                  self_host_body_specialization_shape(
                    link,
                    caller_specialization,
                    SelfHostPlannedValueShape::GenericPlannedValueShape,
                  )
                } else {
                  SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                let selected_element_shape = if !(
                  helper_specialization_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                ) && !(
                  helper_specialization_shape is SelfHostPlannedValueShape::GenericPlannedValueShape
                ) {
                  helper_specialization_shape
                } else {
                match direct_parameter_receiver_element_shape {
                  Option::Some(shape) => shape
                  Option::None => if !self_host_u64_equal(
                  receiver_element_nominal,
                  0u64,
                ) {
                  SelfHostPlannedValueShape::RefPlannedValueShape
                } else if source_receiver_element_shape is Option::Some(_) {
                  match source_receiver_element_shape {
                    Option::Some(shape) => shape
                    Option::None => element_shape
                  }
                } else if raw_array_get {
                  let contextual = self_host_linked_expression_expected_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                  if contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                    element_shape
                  } else {
                    contextual
                  }
                } else {
                  element_shape
                }
                }
                }
                let separate_array_receiver = raw_array_get && self_host_u32_equal(
                  arguments.length,
                  1u32,
                ) && !self_host_u32_equal(
                  direct_array_receiver,
                  4294967295u32,
                )
                if (self_host_u32_equal(arguments.length, 2u32) || separate_array_receiver) &&
                  raw_array_get {
                  let specialized_selected_element_shape = self_host_body_specialization_shape(
                    link,
                    caller_specialization,
                    selected_element_shape,
                  )
                  let _refined_direct_array_get = self_host_linked_refine_canonical_expression_shape(
                    canonical_body_plan,
                    expression,
                    specialized_selected_element_shape,
                  )
                  match self_host_linked_assert_array_get_carrier(
                    canonical_body_plan,
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                    specialized_selected_element_shape,
                  ) {
                    Option::Some(error) => return Option::Some(error)
                    Option::None => {}
                  }
                  let array_expression = if separate_array_receiver {
                    direct_array_receiver
                  } else if arguments.start < module_.expression_children.length() {
                    module_.expression_children[arguments.start]
                  } else {
                    4294967295u32
                  }
                  let index_child = if separate_array_receiver {
                    arguments.start
                  } else {
                    self_host_u32_add(arguments.start, 1u32)
                  }
                  if self_host_u32_equal(array_expression, 4294967295u32) ||
                    index_child >= module_.expression_children.length() {
                    return Option::Some("linked fixed-array get arguments are outside their arena")
                  }
                  let array_type = self_host_u32_add(
                    self_host_linked_array_runtime_base(link),
                    self_host_i32_to_u32(
                      self_host_linked_array_carrier_from_shape(
                        specialized_selected_element_shape,
                      ),
                    ),
                  )
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedFixedArrayGet(
                    array_type,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    module_.expression_children[index_child],
                    destination,
                    depth,
                  )
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedFixedArrayGetPrefix(
                    array_type,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    array_expression,
                    destination,
                    depth,
                  )
                } else {
                  let first_argument_is_consumed = if self_host_u32_greater(
                    arguments.length,
                    0u32,
                  ) && arguments.start < module_.expression_children.length() {
                    let first_argument = module_.expression_children[arguments.start]
                    first_argument < module_.expressions.length() && module_.expressions[
                      first_argument
                    ].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression
                  } else {
                    false
                  }
                  let missing_receiver = (!direct_target_is_static_module && !self_host_linked_physical_function_is_import(
                    link,
                    function_index,
                  ) && self_host_linked_physical_function_has_receiver(
                    link,
                    function_index,
                  )) || first_argument_is_consumed
                  let mut receiver_expression = if missing_receiver &&
                    target < module_.expressions.length() {
                    match module_.expressions[target].kind {
                      SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => base
                      SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => base
                      SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                        target,
                        0u32,
                      ) {
                        target - 1u32
                      } else {
                        4294967295u32
                      }
                      _ => target
                    }
                  } else {
                    4294967295u32
                  }
                  let mut logical_not_after_call = false
                  if receiver_expression < module_.expressions.length() {
                    match module_.expressions[receiver_expression].kind {
                      SelfHostPlannedExpressionKind::PlannedPrefixExpression(
                        SelfHostHirPrefixOperator::LogicalNot,
                        operand,
                      ) => {
                        receiver_expression = operand
                        logical_not_after_call = true
                      }
                      _ => {}
                    }
                  }
                  let emit_physical_call = self_host_linked_i32_planned_call_emits(
                    canonical_body_plan,
                    expression,
                  )
                  if emit_physical_call {
                    if logical_not_after_call {
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                        SelfHostHirPrefixOperator::LogicalNot,
                        destination,
                      ))
                    }
                    match self_host_linked_assert_call_arguments(
                      link,
                      canonical_body_plan,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                      function_index,
                      arguments,
                    ) {
                      Option::Some(error) => return Option::Some(error)
                      Option::None => {}
                    }
                    self_host_linked_schedule_call_result_adapter(
                      canonical_body_plan,
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                      function_index,
                      tasks,
                      destination,
                    )
                    // The selected function returns its declared physical
                    // result. FixedArray factories already return a raw array;
                    // their source name cannot authorize an Array-wrapper read.
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                      function_index,
                      destination,
                    ))
                  }
                  match self_host_linked_i32_push_planned_arguments(
                    canonical_body_plan,
                    link,
                    module_,
                    expression,
                    arguments,
                    function_index,
                    destination,
                    tasks,
                    expression_depths,
                    depth,
                  ) {
                    Option::Some(error) => {
                      return Option::Some(error)
                    }
                    Option::None => {}
                  }
                  if missing_receiver {
                    if receiver_expression < module_.expressions.length() && (
                      module_.expressions[receiver_expression].kind is SelfHostPlannedExpressionKind::PlannedPoisonExpression ||
                        module_.expressions[receiver_expression].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression
                    ) {
                      let message = StringBuilder::new()
                      message.append("linked direct call selected a non-value receiver declaration=")
                      message.append_u64(declaration)
                      message.append(" declaration_name=")
                      message.append(bytes_to_string(declaration_name))
                      message.append(" call=")
                      message.append_u32(expression)
                      message.append(" target=")
                      message.append_u32(target)
                      message.append(" target_reference=")
                      message.append(self_host_program_lowering_reference_name(
                        module_.expressions[target].reference,
                      ))
                      message.append(" target_source_name=")
                      message.append(self_host_program_lowering_name_at(
                        module_,
                        module_.expressions[target].source_name,
                      ))
                      message.append(" receiver=")
                      message.append_u32(receiver_expression)
                      message.append(" receiver_reference=")
                      message.append(self_host_program_lowering_reference_name(
                        module_.expressions[receiver_expression].reference,
                      ))
                      message.append(" receiver_source_name=")
                      message.append(self_host_program_lowering_name_at(
                        module_,
                        module_.expressions[receiver_expression].source_name,
                      ))
                      return Option::Some(message.finish())
                    }
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      receiver_expression,
                      destination,
                      depth,
                    )
                  }
                }
              }
              Option::None => match match module_.expressions[expression].selection {
                SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
                  _,
                  _,
                  _,
                ) => Option::None
                _ => self_host_linked_builtin_name(
                  link,
                  declaration,
                )
              } {
                Option::Some(name) => {
                  if self_host_program_link_is_runtime_builtin(name) {
                    let function_index = self_host_linked_runtime_function_index(
                      link,
                      name,
                    )
                    if function_index < 0i32 {
                      return Option::Some("linked runtime direct call has no physical function")
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                      self_host_i32_to_u32(function_index),
                      destination,
                    ))
                  } else {
                    match self_host_raw_intrinsic_error(name, canonical_body_plan, module_, expression, arguments) {
                      Option::Some(error) => return Option::Some(error.description())
                      Option::None => {}
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedBuiltin(
                      name,
                      destination,
                    ))
                  }
                  match self_host_linked_i32_push_arguments(
                    module_,
                    arguments,
                    destination,
                    tasks,
                    expression_depths,
                    depth,
                  ) {
                    Option::Some(error) => {
                      return Option::Some(error)
                    }
                    Option::None => {}
                  }
                }
                Option::None => match self_host_linked_expression_variant_type(
                  link,
                  canonical_body_plan,
                  module_,
                  body,
                  caller_specialization,
                  planned,
                  declaration,
                  arguments,
                ) {
                  Option::Some(type_index) => {
                    let selected_type_index = type_index
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                      selected_type_index,
                      destination,
                    ))
                    let result_error_first = self_host_linked_array_runtime_base(
                      link,
                    ) + 24u32
                    if selected_type_index >= result_error_first &&
                      selected_type_index < result_error_first + 6u32 {
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedResultErrorIdentity(
                        destination,
                      ))
                    }
                    match self_host_linked_schedule_variant_arguments(
                      link,
                      canonical_body_plan,
                      module_,
                      body,
                      caller_specialization,
                      arguments,
                      selected_type_index,
                      destination,
                      tasks,
                      expression_depths,
                      depth,
                    ) {
                      Option::Some(error) => {
                        return Option::Some(error)
                      }
                      Option::None => {}
                    }
                  }
                  Option::None => {
                    let message = StringBuilder::new()
                    message.append(self_host_linked_missing_call_error(
                      link,
                      declaration,
                    ))
                    message.append(" expression=")
                    message.append_u32(expression)
                    message.append(" target=")
                    message.append_u32(target)
                    if target < module_.expressions.length() && self_host_u32_greater(
                      self_host_linked_module_name_count(module_),
                      module_.expressions[target].source_name,
                    ) {
                      let target_name = self_host_linked_module_name_at(
                        module_,
                        module_.expressions[target].source_name,
                      )
                      message.append(" target_name=")
                      message.append(target_name)
                    }
                    return Option::Some(message.finish())
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedBinaryExpression(operator, left, right) => match operator {
              SelfHostHirBinaryOperator::LogicalAnd => {
                match self_host_linked_assert_logical_operands(
                  canonical_body_plan,
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                  left,
                  right,
                ) {
                  Option::Some(error) => return Option::Some(error)
                  Option::None => {}
                }
                let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
                let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  alternative,
                  StarshineFfi.ffi_lib_Instruction_i32_const(
                    StarshineFfi.ffi_lib_I32_new(0i32),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                  destination,
                  consequent,
                  alternative,
                  SelfHostPlannedValueShape::I32PlannedValueShape,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  consequent,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              SelfHostHirBinaryOperator::LogicalOr => {
                match self_host_linked_assert_logical_operands(
                  canonical_body_plan,
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                  left,
                  right,
                ) {
                  Option::Some(error) => return Option::Some(error)
                  Option::None => {}
                }
                let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
                let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  consequent,
                  StarshineFfi.ffi_lib_Instruction_i32_const(
                    StarshineFfi.ffi_lib_I32_new(1i32),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                  destination,
                  consequent,
                  alternative,
                  SelfHostPlannedValueShape::I32PlannedValueShape,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              _ => {
                let string_comparison = (operator is SelfHostHirBinaryOperator::Equal ||
                  operator is SelfHostHirBinaryOperator::NotEqual) && (
                  self_host_linked_expression_is_string_value(
                    module_,
                    left,
                  ) && self_host_linked_expression_is_string_value(
                    module_,
                    right,
                  )
                )
                if string_comparison {
                  return Option::Some("BOD-607 String comparison has no selected Eq or Ne target")
                }
                let emitted_right_shape = self_host_body_carrier_shape(
                  self_host_linked_exact_emitted_expression_carrier(
                    canonical_body_plan,
                    link,
                    module_,
                    body,
                    caller_specialization,
                    right,
                  ),
                )
                let inferred_right_shape = if !(emitted_right_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                  emitted_right_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                ) && !(emitted_right_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  emitted_right_shape
                } else {
                  match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    right,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      right,
                    )
                  }
                }
                let emitted_left_shape = self_host_body_carrier_shape(
                  self_host_linked_exact_emitted_expression_carrier(
                    canonical_body_plan,
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                  ),
                )
                let inferred_left_shape = if !(emitted_left_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                  emitted_left_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                ) && !(emitted_left_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  emitted_left_shape
                } else {
                  match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      left,
                    )
                  }
                }
                let left_shape = if left < module_.expressions.length() {
                  match module_.expressions[left].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_loop_binding_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      local,
                    ) {
                      Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                        Option::Some(shape),
                        inferred_left_shape,
                      )
                      Option::None => match self_host_linked_match_binding_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        local,
                      ) {
                        Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                          Option::Some(shape),
                          inferred_left_shape,
                        )
                        Option::None => match self_host_linked_local_declared_shape(
                          module_,
                          body,
                          local,
                        ) {
                          Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                            Option::Some(shape),
                            inferred_left_shape,
                          )
                          Option::None => match self_host_linked_local_parameter_shape(
                            link,
                            module_,
                            body,
                            caller_specialization,
                            local,
                          ) {
                            Option::Some(shape) => self_host_linked_source_or_inferred_item_shape(
                              Option::Some(shape),
                              inferred_left_shape,
                            )
                            Option::None => inferred_left_shape
                          }
                        }
                      }
                    }
                    _ => inferred_left_shape
                  }
                } else {
                  inferred_left_shape
                }
                // Equality can retain a broad reference shape on one generic
                // operand after the other operand proves the scalar carrier.
                // Prefer that concrete scalar proof before selecting ref.eq.
                let binary_shape = self_host_linked_binary_operand_shape(
                  left_shape,
                  inferred_right_shape,
                )
                match self_host_specialization_canonical_scalar(binary_shape) {
                  SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                    right,
                    binary_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                  ) {
                    Result::Ok(unsigned_) => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                        operator,
                        unsigned_,
                        destination,
                      ),
                    )
                    Result::Err(error) => return Option::Some(error)
                  }
                  SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                      operator,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                      operator,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::RefPlannedValueShape => if operator is SelfHostHirBinaryOperator::Equal ||
                    operator is SelfHostHirBinaryOperator::NotEqual {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefBinary(
                      operator,
                      destination,
                    ))
                  } else {
                    let expected_binary_shape = self_host_linked_expression_expected_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    )
                    let reference_binary_shape = match self_host_specialization_canonical_scalar(
                      inferred_right_shape,
                    ) {
                      SelfHostPlannedValueShape::I32PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::I64PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::F32PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::F64PlannedValueShape => inferred_right_shape
                      SelfHostPlannedValueShape::V128PlannedValueShape => inferred_right_shape
                      _ => match self_host_specialization_canonical_scalar(
                        expected_binary_shape,
                      ) {
                        SelfHostPlannedValueShape::I32PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::I64PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::F32PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::F64PlannedValueShape => expected_binary_shape
                        SelfHostPlannedValueShape::V128PlannedValueShape => expected_binary_shape
                        _ => self_host_planned_merged_body_value_shape(
                          module_.resolved_types,
                          module_.inferred,
                          planned.type_,
                        )
                      }
                    }
                    match self_host_specialization_canonical_scalar(
                      reference_binary_shape,
                    ) {
                      SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        left,
                        right,
                        reference_binary_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                      ) {
                        Result::Ok(unsigned_) => tasks.push(
                          SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                            operator,
                            unsigned_,
                            destination,
                          ),
                        )
                        Result::Err(error) => return Option::Some(error)
                      }
                      SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                        SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                          operator,
                          destination,
                        ),
                      )
                      SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                        SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                          operator,
                          destination,
                        ),
                      )
                      SelfHostPlannedValueShape::I32PlannedValueShape => match self_host_linked_integer_binary_unsigned_proof(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        left,
                        right,
                        self_host_linked_i32_unsigned_shape(reference_binary_shape),
                      ) {
                        Result::Ok(unsigned_) => tasks.push(
                          SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                            operator,
                            unsigned_,
                            destination,
                          ),
                        )
                        Result::Err(error) => return Option::Some(error)
                      }
                      _ => {
                        let message = StringBuilder::new()
                        message.append("linked reference binary operator is unsupported module=")
                        message.append_u64(module_.module_id)
                        message.append(" declaration=")
                        message.append_u64(body.declaration)
                        message.append(" name=")
                        message.append(bytes_to_string(self_host_linked_declaration_name(
                          link,
                          body.declaration,
                        )))
                        message.append(" body=")
                        message.append_u64(body.body)
                        message.append(" expression=")
                        message.append_u32(expression)
                        message.append(" left=")
                        message.append_u32(left)
                        if left < module_.expressions.length() {
                          message.append(":")
                          message.append(self_host_body_expression_kind_name(
                            module_.expressions[left].kind,
                          ))
                          message.append(":type=")
                          message.append_i32(self_host_planned_expression_at(module_.expressions, left).type_)
                          message.append(":nominal=")
                          message.append_u64(module_.expressions[left].nominal)
                        }
                        message.append(" right=")
                        message.append_u32(right)
                        if right < module_.expressions.length() {
                          message.append(":")
                          message.append(self_host_body_expression_kind_name(
                            module_.expressions[right].kind,
                          ))
                          message.append(":type=")
                          message.append_i32(self_host_planned_expression_at(module_.expressions, right).type_)
                          message.append(":nominal=")
                          message.append_u64(module_.expressions[right].nominal)
                        }
                        message.append(" inferred_left=")
                        message.append(self_host_linked_shape_name(inferred_left_shape))
                        message.append(" inferred_right=")
                        message.append(self_host_linked_shape_name(inferred_right_shape))
                        message.append(" emitted_left=")
                        message.append(self_host_linked_shape_name(emitted_left_shape))
                        message.append(" emitted_right=")
                        message.append(self_host_linked_shape_name(emitted_right_shape))
                        message.append(" expected=")
                        message.append(self_host_linked_shape_name(expected_binary_shape))
                        message.append(" fallback=")
                        message.append(self_host_linked_shape_name(reference_binary_shape))
                        if left < module_.expressions.length() {
                          match module_.expressions[left].kind {
                            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(left_target, _) => {
                              let field_target = if left_target < module_.expressions.length() &&
                                module_.expressions[left_target].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                                self_host_u32_greater(left_target, 0u32) {
                                self_host_u32_subtract(left_target, 1u32)
                              } else {
                                left_target
                              }
                              message.append(" left_target=")
                              message.append_u32(left_target)
                              message.append(":field=")
                              message.append_u32(field_target)
                              if field_target < module_.expressions.length() {
                                message.append(":")
                                message.append(self_host_body_expression_kind_name(
                                  module_.expressions[field_target].kind,
                                ))
                                match module_.expressions[field_target].kind {
                                  SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => {
                                    let exact_receiver = if receiver < module_.expressions.length() &&
                                      module_.expressions[receiver].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                                      self_host_u32_greater(receiver, 0u32) {
                                      self_host_u32_subtract(receiver, 1u32)
                                    } else {
                                      receiver
                                    }
                                    message.append(":method=")
                                    if name < self_host_linked_module_name_count(module_) {
                                      message.append(self_host_linked_module_name_at(module_, name))
                                    } else {
                                      message.append("invalid")
                                    }
                                    message.append(":receiver=")
                                    message.append_u32(receiver)
                                    message.append(":exact_receiver=")
                                    message.append_u32(exact_receiver)
                                    if exact_receiver < module_.expressions.length() {
                                      message.append(":")
                                      message.append(self_host_body_expression_kind_name(
                                        self_host_planned_expression_at(
                                          module_.expressions,
                                          exact_receiver,
                                        ).kind,
                                      ))
                                      message.append(":type=")
                                      message.append_i32(self_host_planned_expression_at(
                                        module_.expressions,
                                        exact_receiver,
                                      ).type_)
                                    }
                                    message.append(":heap=")
                                    match self_host_linked_canonical_expression_heap_type(
                                      canonical_body_plan,
                                      module_,
                                      body,
                                      exact_receiver,
                                    ) {
                                      Option::Some(type_index) => message.append_u32(type_index)
                                      Option::None => message.append("none")
                                    }
                                    message.append(":argument=")
                                    match self_host_linked_expression_container_argument_shape(
                                      link,
                                      module_,
                                      body,
                                      exact_receiver,
                                      0u32,
                                    ) {
                                      Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                      Option::None => message.append("none")
                                    }
                                    match self_host_planned_expression_at(
                                      module_.expressions,
                                      exact_receiver,
                                    ).kind {
                                      SelfHostPlannedExpressionKind::PlannedLocalGet(local) => {
                                        message.append(":local=")
                                        message.append_u32(local)
                                        let receiver_type = self_host_planned_expression_at(
                                          module_.expressions,
                                          exact_receiver,
                                        ).type_
                                        if !(receiver_type < 0i32) {
                                          let inferred_index = self_host_i32_to_u32(receiver_type)
                                          let exact_inferred = self_host_merged_module_inference_identity(
                                            module_.inferred,
                                          )
                                          if inferred_index < exact_inferred.types.length() {
                                            message.append(":inferred_term=")
                                            match exact_inferred.types[inferred_index] {
                                              SelfHostBodyTypeTerm::BodyMemberTypeProjection(owner, _, _) => {
                                                message.append("member-projection:")
                                                message.append_i32(owner)
                                              }
                                              SelfHostBodyTypeTerm::BodyAppliedType(base, arguments) => {
                                                message.append("applied:")
                                                message.append_i32(base)
                                                message.append(":")
                                                message.append_u32(arguments.start)
                                                message.append("+")
                                                message.append_u32(arguments.length)
                                              }
                                              SelfHostBodyTypeTerm::BodyResolvedType(resolved) => {
                                                message.append("resolved:")
                                                message.append_u32(resolved)
                                              }
                                              SelfHostBodyTypeTerm::BodyVariableType(variable) => {
                                                message.append("variable:")
                                                message.append_u32(variable)
                                              }
                                              SelfHostBodyTypeTerm::BodyErrorType => message.append("error")
                                              SelfHostBodyTypeTerm::BodyProductType(_) => message.append("product")
                                              SelfHostBodyTypeTerm::BodyFunctionType(_, _) => message.append("function")
                                            }
                                          }
                                        }
                                        message.append(":local_argument=")
                                        match self_host_linked_local_first_type_argument_shape(
                                          module_,
                                          body,
                                          local,
                                        ) {
                                          Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                          Option::None => message.append("none")
                                        }
                                        message.append(":parameter_argument=")
                                        match self_host_linked_local_parameter_argument_shape(
                                          link,
                                          module_,
                                          body,
                                          local,
                                          0u32,
                                        ) {
                                          Option::Some(shape) => message.append(self_host_linked_shape_name(shape))
                                          Option::None => message.append("none")
                                        }
                                        message.append(":parameter_position=")
                                        match self_host_linked_local_parameter_position(
                                          module_,
                                          body,
                                          local,
                                        ) {
                                          Option::Some(pair) => {
                                            let (position, count) = pair
                                            message.append_u32(position)
                                            message.append("/")
                                            message.append_u32(count)
                                            match link.fragments.specialization.lowering.index.declaration_owner(
                                              body.declaration,
                                            ) {
                                              Option::Some(owner) => {
                                                message.append(":owner=")
                                                message.append_u32(owner)
                                                if owner < link.fragments.specialization.lowering.modules.length() {
                                                  let callable_module = link.fragments.specialization.lowering.modules[owner]
                                                  match self_host_program_specialization_callable(
                                                    callable_module,
                                                    body.declaration,
                                                  ) {
                                                    Option::Some(callable) => {
                                                      message.append(":callable_parameters=")
                                                      message.append_u32(callable.parameters.start)
                                                      message.append("+")
                                                      message.append_u32(callable.parameters.length)
                                                      let parameter_index = self_host_u32_add(
                                                        callable.parameters.start,
                                                        position,
                                                      )
                                                      if parameter_index < callable_module.functions.parameters.length() {
                                                        let parameter = self_host_planned_parameter_identity(
                                                          callable_module.functions.parameters[parameter_index],
                                                        )
                                                        message.append(":parameter_type=")
                                                        message.append_u32(parameter.type_)
                                                        if parameter.type_ < self_host_linked_resolved_type_count(
                                                          callable_module,
                                                        ) {
                                                          match callable_module.resolved_types.type_at(
                                                            parameter.type_,
                                                          ) {
                                                              SelfHostResolvedType::AppliedType(base, arguments) => {
                                                                message.append(":applied=")
                                                                message.append_u32(base)
                                                                message.append(":arguments=")
                                                                message.append_u32(arguments.start)
                                                                message.append("+")
                                                                message.append_u32(arguments.length)
                                                              }
                                                              SelfHostResolvedType::NominalType(declaration) => {
                                                                message.append(":nominal=")
                                                                message.append_u64(declaration)
                                                              }
                                                              SelfHostResolvedType::PrimitiveType(_) => message.append(":primitive")
                                                              SelfHostResolvedType::ErrorType => message.append(":error")
                                                              SelfHostResolvedType::MemberTypeProjection(_, _, _) => message.append(":member-projection")
                                                              SelfHostResolvedType::TraitType(_) => message.append(":trait")
                                                              SelfHostResolvedType::SelfType(_) => message.append(":self")
                                                              SelfHostResolvedType::ProductType(_) => message.append(":product")
                                                              SelfHostResolvedType::FunctionType(_, _) => message.append(":function")
                                                              SelfHostResolvedType::GenericParameterType(_) => message.append(":generic")
                                                          }
                                                        }
                                                      }
                                                    }
                                                    Option::None => message.append(":callable=none")
                                                  }
                                                }
                                              }
                                              Option::None => message.append(":owner=none")
                                            }
                                          }
                                          Option::None => message.append("none")
                                        }
                                      }
                                      _ => {}
                                    }
                                  }
                                  _ => {}
                                }
                              }
                            }
                            _ => {}
                          }
                        }
                        return Option::Some(message.finish())
                      }
                    }
                  }
                  _ => match self_host_linked_integer_binary_unsigned_proof(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    left,
                    right,
                    self_host_linked_i32_unsigned_shape(left_shape),
                  ) {
                    Result::Ok(unsigned_) => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                        operator,
                        unsigned_,
                        destination,
                      ),
                    )
                    Result::Err(error) => return Option::Some(error)
                  }
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
            }
            SelfHostPlannedExpressionKind::PlannedDeferredExpression => {
              return Option::Some("CT-041 deferred source check reached emission")
            }
            SelfHostPlannedExpressionKind::PlannedDeadExpression => {
              return Option::Some("BOD-610 dead expression reached emission")
            }
            SelfHostPlannedExpressionKind::PlannedPoisonExpression => {
              // A self-hosted inference pass can lose the selection record for
              // a qualified unit variant such as Option::None. The preserved
              // source name and the unique zero-field physical subtype are a
              // sufficient certificate to emit the constructor. Do not apply
              // this recovery to payload variants or ambiguous names.
              match self_host_linked_zero_arity_variant_type(
                link,
                canonical_body_plan,
                module_,
                body,
                caller_specialization,
                planned,
              ) {
                Option::Some(type_index) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                    type_index,
                    destination,
                  ))
                  continue tasks.length()
                }
                Option::None => {}
              }
              let message = StringBuilder::new()
              message.append("linked emitter reached a poisoned expression module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" declaration_name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(
                link,
                body.declaration,
              )))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" offset=")
              message.append_u32(planned.offset)
              message.append(" source_name=")
              message.append_u32(planned.source_name)
              if planned.source_name < self_host_linked_module_name_count(module_) {
                message.append(":")
                message.append(self_host_linked_module_name_at(
                  module_,
                  planned.source_name,
                ))
              }
              message.append(self_host_linked_non_value_parent_context(
                module_,
                body,
                expression,
              ))
              return Option::Some(message.finish())
            }
            SelfHostPlannedExpressionKind::PlannedConsumedExpression => {
              let message = StringBuilder::new()
              message.append("linked emitter reached a consumed expression module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" declaration_name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(
                link,
                body.declaration,
              )))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" offset=")
              message.append_u32(planned.offset)
              message.append(" source_name=")
              message.append_u32(planned.source_name)
              if planned.source_name < self_host_linked_module_name_count(module_) {
                message.append(":")
                message.append(self_host_linked_module_name_at(
                  module_,
                  planned.source_name,
                ))
              }
              message.append(self_host_linked_non_value_parent_context(
                module_,
                body,
                expression,
              ))
              return Option::Some(message.finish())
            }
            SelfHostPlannedExpressionKind::PlannedStringConst(value) => self_host_emit_linked_text_constant(
              link,
              value,
              true,
              destination,
            )
            SelfHostPlannedExpressionKind::PlannedUnitConst => {}
            SelfHostPlannedExpressionKind::PlannedStringArrayConst(values) => {
              for value in values {
                self_host_emit_linked_text_constant(link, value, true, destination)
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_array_new_fixed(
                  StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(self_host_linked_array_runtime_base(link) + 5u32)),
                  StarshineFfi.ffi_lib_U32_new(self_host_u32_to_i32(values.length())),
                ),
              )
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(values.length()))))
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(values.length()))))
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_struct_new(StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(self_host_linked_array_wrapper_type(link)))))
            }
            SelfHostPlannedExpressionKind::PlannedBytesConst(value) => self_host_emit_linked_text_constant(
              link,
              value,
              false,
              destination,
            )
            SelfHostPlannedExpressionKind::PlannedCaptureGet(capture) => {
              let plan = match canonical_body_plan {
                Option::Some(value) => value
                Option::None => return Option::Some("capture read has no frozen body plan")
              }
              match self_host_emit_capture_get(link, plan, capture, true, destination) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
            }
            SelfHostPlannedExpressionKind::PlannedFunctionReference(declaration) => {
              match self_host_emit_planned_function_reference(link, canonical_body_plan, expression, declaration, destination) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
            }
            SelfHostPlannedExpressionKind::PlannedModuleValueGet(
              declaration,
            ) => match self_host_linked_global_index(link, declaration) {
              Option::Some(global_index) => StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_global_get(
                  StarshineFfi.ffi_lib_GlobalIdx_new(
                    self_host_u32_to_i32(global_index),
                  ),
                ),
              )
              Option::None => match self_host_linked_function_reference_index(
                link,
                module_,
                planned,
                declaration,
              ) {
                Option::Some(function_index) => {
                  let module_index = match self_host_linked_module_index_by_id(
                    link,
                    module_.module_id,
                  ) {
                    Option::Some(value) => value
                    Option::None => {
                      return Option::Some("linked function reference module is missing")
                    }
                  }
                  let closure_type = match self_host_linked_closure_base_type_index(
                    link,
                    module_index,
                  ) {
                    Option::Some(value) => value
                    Option::None => {
                      return Option::Some("linked function reference has no closure type")
                    }
                  }
                  StarshineFfi.ffi_ffi_bridge_instructions_push(
                    destination,
                    StarshineFfi.ffi_lib_Instruction_ref_func(
                      StarshineFfi.ffi_lib_FuncIdx_new(
                        self_host_u32_to_i32(
                          self_host_linked_emitted_function_index(function_index),
                        ),
                      ),
                    ),
                  )
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                    closure_type,
                    destination,
                  ))
                }
                Option::None => {
                  return Option::Some("linked module value has no global")
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedEvaluationSequence(children) => {
              self_host_assert_array_span(children.start, children.length, module_.expression_children.length(), "ARN-101 evaluation sequence")
              self_host_assert_compiler_invariant(!planned.flow.falls_through && children.length > 0u32, "BOD-611 evaluation sequence must not fall through")
              let _ = while children.length {
                remaining => if remaining > 0u32 {
                  let offset = remaining - 1u32
                  let child = module_.expression_children[children.start + offset]
                  if remaining == children.length {
                    self_host_linked_i32_schedule_expression(tasks, expression_depths, child, destination, depth)
                  } else {
                    self_host_linked_i32_schedule_discarded_expression(tasks, expression_depths, child, destination, depth)
                  }
                  continue offset
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedProductNew(children) => {
              let materialized_product_type = self_host_linked_canonical_materialized_local_type(
                canonical_body_plan,
                module_,
                body,
                expression,
              )
              let consumer_product_type = self_host_linked_product_new_consumer_pair_type(
                link,
                module_,
                body,
                caller_specialization,
                expression,
              )
              let canonical_product_type = match consumer_product_type {
                Option::Some(type_index) => Option::Some(type_index)
                Option::None => match materialized_product_type {
                  Option::Some(type_index) => Option::Some(type_index)
                  Option::None => self_host_linked_canonical_type(
                    canonical_body_plan,
                    expression,
                  )
                }
              }
              if self_host_u32_greater(children.length, 1u32) {
                let mut pair_start = 0u32
                let _ = while pair_start {
                  current_pair => if self_host_u32_add(current_pair, 1u32) < children.length {
                    let left_index = self_host_u32_add(children.start, current_pair)
                    if left_index >= module_.expression_children.length() {
                      return Option::Some("linked tuple child is outside its arena")
                    }
                    let left_expression = module_.expression_children[left_index]
                    let inferred_left_shape = self_host_linked_product_child_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      left_expression,
                    )
                    let left_shape = match self_host_linked_canonical_expression_shape(
                      canonical_body_plan,
                      left_expression,
                    ) {
                      Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                        shape
                      } else {
                        inferred_left_shape
                      }
                      Option::None => inferred_left_shape
                    }
                    let left = self_host_linked_array_carrier_from_shape(left_shape)
                    let right = if self_host_u32_equal(
                      self_host_u32_add(current_pair, 2u32),
                      children.length,
                    ) {
                      let right_index = self_host_u32_add(left_index, 1u32)
                      if right_index >= module_.expression_children.length() {
                        return Option::Some("linked tuple child is outside its arena")
                      }
                      let right_expression = module_.expression_children[right_index]
                      let inferred_right_shape = self_host_linked_product_child_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        right_expression,
                      )
                      let right_shape = match self_host_linked_canonical_expression_shape(
                        canonical_body_plan,
                        right_expression,
                      ) {
                        Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                          shape
                        } else {
                          inferred_right_shape
                        }
                        Option::None => inferred_right_shape
                      }
                      self_host_linked_array_carrier_from_shape(right_shape)
                    } else {
                      5i32
                    }
                    let inferred_pair_type = self_host_linked_array_runtime_base(link) + 30u32 +
                      self_host_i32_to_u32(left * 6i32 + right)
                    let pair_type = if self_host_u32_equal(children.length, 2u32) &&
                      self_host_u32_equal(current_pair, 0u32) {
                      match canonical_product_type {
                        Option::Some(type_index) => type_index
                        Option::None => inferred_pair_type
                      }
                    } else {
                      inferred_pair_type
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                      pair_type,
                      destination,
                    ))
                    continue current_pair + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              let mut child = children.length
              let _ = while child {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  let child_index = self_host_u32_add(children.start, previous)
                  if child_index >= module_.expression_children.length() {
                    return Option::Some("linked tuple child is outside its arena")
                  }
                  let child_expression = module_.expression_children[child_index]
                  if module_.expressions[child_expression].shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
                    // The existing boxed-pair layout has a reference field for
                    // logical Unit. Materialize its explicit null marker only
                    // inside this product; the Unit evaluation emits no value.
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    module_.expression_children[child_index],
                    destination,
                    depth,
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedArrayLiteral(children) => {
              let mut carrier = 5i32
              if self_host_u32_greater(children.length, 0u32) {
                let first_index = children.start
                if first_index < module_.expression_children.length() {
                  let first = module_.expression_children[first_index]
                  if first < module_.expressions.length() {
                    carrier = self_host_linked_array_carrier_from_shape(
                      self_host_linked_array_push_item_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        first,
                      ),
                    )
                  }
                }
              } else {
                match self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  expression,
                ) {
                  Option::Some(shape) => {
                    carrier = self_host_linked_array_carrier_from_shape(shape)
                  }
                  Option::None => match self_host_linked_array_literal_use_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    canonical_body_plan,
                    expression,
                  ) {
                    Option::Some(shape) => {
                      carrier = self_host_linked_array_carrier_from_shape(shape)
                    }
                    Option::None => {}
                  }
                }
              }
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayLiteral(
                self_host_linked_array_runtime_base(link) + self_host_i32_to_u32(carrier),
                self_host_linked_array_wrapper_type(link),
                children.length,
                destination,
              ))
              let mut child = children.length
              let _ = while child {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  let child_index = self_host_u32_add(children.start, previous)
                  if child_index >= module_.expression_children.length() {
                    return Option::Some("linked array literal child is outside its arena")
                  }
                  match self_host_linked_canonical_expression_shape(canonical_body_plan, module_.expression_children[child_index]) {
                    Option::Some(shape) => if shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
                      // Only storage receives this marker. Evaluate the Unit
                      // child first, with its effects and control flow intact.
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
                    }
                    Option::None => return Option::Some("BOD-610 array literal child has no frozen shape")
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    module_.expression_children[child_index],
                    destination,
                    depth,
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLambdaClosure(lambda_id) => {
              let module_index = match self_host_linked_module_index_by_id(
                link,
                module_.module_id,
              ) {
                Option::Some(value) => value
                Option::None => {
                  return Option::Some("linked lambda module is missing")
                }
              }
              let lambda_position = match self_host_linked_lambda_position(
                module_,
                lambda_id,
              ) {
                Option::Some(value) => value
                Option::None => {
                  return Option::Some("linked lambda lowering is missing")
                }
              }
              let lambda = module_.lambdas[lambda_position]
              let plan = match canonical_body_plan {
                Option::Some(value) => value
                Option::None => return Option::Some("closure creation has no frozen body plan")
              }
              let closure = match self_host_body_plan_expression(plan, expression) {
                Option::Some(value) => value
                Option::None => return Option::Some("closure creation has no frozen expression plan")
              }
              if !self_host_lambda_construction_target_matches(link, plan, closure, lambda_id) {
                return Option::Some("closure construction target differs from its frozen lambda identity")
              }
              let type_index = closure.selected_type_index
              let function_index = self_host_linked_physical_function_index(closure.call_function_index)
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_ref_func(
                  StarshineFfi.ffi_lib_FuncIdx_new(
                    self_host_u32_to_i32(
                      self_host_linked_emitted_function_index(function_index),
                    ),
                  ),
                ),
              )
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                type_index,
                destination,
              ))
              let mut capture_index = 0u32
              while capture_index {
                _ => if capture_index < lambda.captures.length {
                let capture = module_.captures[self_host_u32_add(lambda.captures.start, capture_index)]
                match self_host_emit_closure_capture(link, plan, body, capture, destination) {
                  Option::Some(error) => return Option::Some(error)
                  Option::None => {}
                }
                capture_index = capture_index + 1u32
                continue capture_index
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedObjectNew(_) => {
              return Option::Some("linked object values are not emitted yet")
            }
            SelfHostPlannedExpressionKind::PlannedOperatorCall(
              declaration,
              _,
              left,
              right,
              _,
            ) => match self_host_linked_canonical_call_index(
              canonical_body_plan,
              link,
              body,
              caller_specialization,
              expression,
              declaration,
            ) {
              Option::Some(function_index) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                  function_index,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Option::Some("linked operator call has no physical function")
              }
            }
            SelfHostPlannedExpressionKind::PlannedBuiltinCall(
              name,
              declaration,
              target,
              arguments,
              _,
            ) => {
              if name.equals(b"array.new_default") {
                if arguments.length != 1u32 || !self_host_array_span_is_valid(arguments.start, arguments.length, module_.expression_children.length()) {
                  return Option::Some("ABI-703 raw array.new_default needs one length")
                }
                let shape = match self_host_raw_array_expression_element_shape(link, module_, caller_specialization, expression) {
                  Option::Some(value) => value
                  Option::None => return Option::Some("SPC-301 raw array.new_default element type is not concrete")
                }
                let array_type = self_host_linked_array_runtime_base(link) + self_host_i32_to_u32(self_host_linked_array_carrier_from_shape(shape))
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayNewDefault(array_type, destination))
                self_host_linked_i32_schedule_expression(tasks, expression_depths, module_.expression_children[arguments.start], destination, depth)
                continue tasks.length()
              }
              if name.equals(b"array.copy") {
                if arguments.length != 5u32 || !self_host_array_span_is_valid(arguments.start, arguments.length, module_.expression_children.length()) {
                  return Option::Some("ABI-703 raw array.copy needs five operands")
                }
                let array_expression = module_.expression_children[arguments.start]
                let shape = match self_host_raw_array_expression_element_shape(link, module_, caller_specialization, array_expression) {
                  Option::Some(value) => value
                  Option::None => return Option::Some("SPC-301 raw array.copy element type is not concrete")
                }
                let array_type = self_host_linked_array_runtime_base(link) + self_host_i32_to_u32(self_host_linked_array_carrier_from_shape(shape))
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayCopy(array_type, destination))
                while 5u32 {
                  remaining if remaining > 0u32 => {
                    let operand = remaining - 1u32
                    if operand == 0u32 || operand == 2u32 {
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefCast(array_type, destination))
                    }
                    self_host_linked_i32_schedule_expression(tasks, expression_depths, module_.expression_children[arguments.start + operand], destination, depth)
                    continue operand
                  }
                  _ => break self_host_semantic_unit()
                }
                continue tasks.length()
              }
              if name.equals(b"array_new") {
                if !self_host_u32_equal(arguments.length, 2u32) ||
                  self_host_u32_add(arguments.start, 1u32) >= module_.expression_children.length() {
                  return Option::Some("linked raw array new needs length and value")
                }
                let length_expression = module_.expression_children[arguments.start]
                let value_expression = module_.expression_children[
                  self_host_u32_add(arguments.start, 1u32)
                ]
                let value_shape = self_host_body_specialization_shape_for_type(
                  link,
                  module_,
                  caller_specialization,
                  module_.expressions[value_expression].type_,
                  module_.expressions[value_expression].shape,
                )
                let array_type = self_host_linked_array_runtime_base(link) +
                  self_host_i32_to_u32(
                    match self_host_raw_array_storage_carrier(value_shape) {
                      Option::Some(carrier) => carrier
                      Option::None => return Option::Some("SPC-301 raw array.new element type is not concrete")
                    },
                  )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayNew(
                  array_type,
                  destination,

  }
  Option::None
}

fn self_host_linked_is_body_result_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  let mut current_expression = expression
  let mut depth = 0u32
  let _ = while depth {
    current_depth => if current_depth < 8u32 {
      match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(root) => if self_host_u32_equal(
          root,
          current_expression,
        ) {
          return true
        }
        _ => {}
      }
      let mut direct_parent = 4294967295u32
      let mut direct_relative = 0u32
      let _ = while direct_relative {
        current => if current < body.expressions.length {
          let candidate = self_host_u32_add(body.expressions.start, current)
          if self_host_array_index_is_valid(
            candidate,
            module_.expressions.length(),
          ) {
            match module_.expressions[candidate].kind {
              SelfHostPlannedExpressionKind::PlannedIfExpression(
                _,
                _,
                else_expression,
              ) => if self_host_u32_equal(
                else_expression,
                current_expression,
              ) {
                direct_parent = candidate
              }
              _ => {}
            }
          }
          continue self_host_u32_add(current, 1u32)
        } else {
          break self_host_semantic_unit()
        }
      }
      if !self_host_u32_equal(direct_parent, 4294967295u32) {
        current_expression = direct_parent
        continue self_host_u32_add(current_depth, 1u32)
      }
      let mut containing_block = 4294967295u32
      let mut relative_block = 0u32
      let _ = while relative_block {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          if block_index < module_.blocks.length() {
            let block = module_.blocks[block_index]
            if self_host_u32_greater(block.items.length, 0u32) {
              let item_index = self_host_u32_subtract(
                self_host_u32_add(block.items.start, block.items.length),
                1u32,
              )
              if item_index < module_.block_items.length() {
                match module_.block_items[item_index].kind {
                  SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if self_host_u32_equal(
                    value,
                    current_expression,
                  ) {
                    containing_block = block_index
                  }
                  _ => {}
                }
              }
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_equal(containing_block, 4294967295u32) {
        return false
      }
      match body.root {
        SelfHostHirBodyRoot::BlockBodyRoot(root_block) => if self_host_u32_equal(
          root_block,
          containing_block,
        ) {
          return true
        }
        _ => {}
      }
      let mut parent = 4294967295u32
      let mut relative_expression = 0u32
      let _ = while relative_expression {
        current => if current < body.expressions.length {
          let candidate = self_host_u32_add(body.expressions.start, current)
          match module_.expressions[candidate].kind {
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => if self_host_u32_equal(
              block,
              containing_block,
            ) {
              parent = candidate
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              _,
              then_block,
              _,
            ) => if self_host_u32_equal(then_block, containing_block) {
              parent = candidate
            }
            _ => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_equal(parent, 4294967295u32) {
        return false
      }
      current_expression = parent
      continue current_depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_match_returns_special_binding(
  module_: SelfHostPlannedModuleLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          if self_host_u32_greater(
            module_.patterns.length(),
            source.pattern,
          ) && self_host_u32_greater(
            module_.expressions.length(),
            source.body,
          ) {
            let mut result_body = source.body
            match module_.expressions[source.body].kind {
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item < module_.block_items.length() {
                    match module_.block_items[item].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => {
                        result_body = expression
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => {}
            }
            let pattern = self_host_planned_pattern_at(
              module_.patterns,
              source.pattern,
            )
            let name = self_host_linked_pattern_name(module_, pattern)
            if name == "Some" || name == "Ok" || name == "Err" {
              match pattern.source {
                SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
                  children.length,
                  0u32,
                ) && self_host_u32_greater(
                  module_.pattern_children.length(),
                  children.start,
                ) {
                  let binding_pattern = module_.pattern_children[children.start]
                  if self_host_u32_greater(
                    module_.patterns.length(),
                    binding_pattern,
                  ) {
                    match self_host_planned_pattern_at(module_.patterns, binding_pattern).reference {
                      SelfHostBodyPatternReference::PatternBindingReference(
                        local_id,
                      ) => match module_.expressions[result_body].kind {
                        SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                          candidate,
                          local_id,
                        ) {
                          return true
                        }
                        _ => {}
                      }
                      _ => {}
                    }
                  }
                }
                _ => {}
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_match_only_binding_falls_through(
  module_: SelfHostPlannedModuleLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut found = false
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          let mut value = source.body
          if value < module_.expressions.length() {
            match module_.expressions[value].kind {
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item < module_.block_items.length() {
                    match module_.block_items[item].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => {
                        value = expression
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => {}
            }
          }
          if value < module_.expressions.length() && module_.expressions[value].flow.falls_through {
            match module_.expressions[value].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => if self_host_linked_pattern_binds_local(
                module_,
                source.pattern,
                local_id,
              ) {
                found = true
              } else {
                return false
              }
              _ => return false
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  found
}

fn self_host_linked_match_direct_binding_declared_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          if self_host_u32_greater(
            module_.patterns.length(),
            source.pattern,
          ) && self_host_u32_greater(
            module_.expressions.length(),
            source.body,
          ) {
            match module_.expressions[source.body].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => if self_host_linked_pattern_binds_local(
                module_,
                source.pattern,
                local_id,
              ) {
                match self_host_linked_local_direct_pattern_subject_shape(
                  link,
                  module_,
                  body,
                  local_id,
                ) {
                  Option::Some(shape) => return Option::Some(shape)
                  Option::None => {}
                }
                match self_host_linked_match_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  local_id,
                ) {
                  Option::Some(shape) => return Option::Some(shape)
                  Option::None => {}
                }
                let mut local = 0u32
                let _ = while local {
                  position => if position < body.locals.length {
                    let index = self_host_u32_add(body.locals.start, position)
                    if index < module_.locals.length() && self_host_u32_equal(
                      self_host_body_planned_local_identity(module_.locals[index]).local_id,
                      local_id,
                    ) {
                      let planned_local = self_host_body_planned_local_identity(module_.locals[index])
                      if !self_host_u64_equal(
                        self_host_linked_type_owner_module_id(
                          link,
                          module_,
                          planned_local.type_,
                        ),
                        0u64,
                      ) {
                        return Option::Some(SelfHostPlannedValueShape::RefPlannedValueShape)
                      }
                      let shape = self_host_planned_merged_body_value_shape(
                        module_.resolved_types,
                        module_.inferred,
                        planned_local.type_,
                      )
                      if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                        return Option::Some(shape)
                      }
                    }
                    continue position + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              _ => {}
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_special_match_scalar_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  if !self_host_linked_match_returns_special_binding(module_, arms) {
    return Option::None
  }
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let arm_source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          let arm_body = arm_source.body
          if arm_source.flow.falls_through && arm_body < module_.expressions.length() &&
            module_.expressions[arm_body].flow.falls_through {
            let shape = match module_.expressions[arm_body].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local) => {
                let expected_arm_shape = self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arm_body,
                )
                match self_host_specialization_canonical_scalar(expected_arm_shape) {
                  SelfHostPlannedValueShape::I32PlannedValueShape => expected_arm_shape
                  SelfHostPlannedValueShape::I64PlannedValueShape => expected_arm_shape
                  SelfHostPlannedValueShape::F32PlannedValueShape => expected_arm_shape
                  SelfHostPlannedValueShape::F64PlannedValueShape => expected_arm_shape
                  SelfHostPlannedValueShape::V128PlannedValueShape => expected_arm_shape
                  _ => match self_host_linked_match_binding_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    local,
                  ) {
                    Option::Some(value) => value
                    Option::None => match self_host_linked_local_direct_pattern_subject_shape(
                      link,
                      module_,
                      body,
                      local,
                    ) {
                      Option::Some(value) => value
                      Option::None => self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arm_body,
                      )
                    }
                  }
                }
              }
              _ => self_host_linked_backend_expression_shape(
                link,
                module_,
                body,
                caller_specialization,
                arm_body,
              )
            }
            match self_host_specialization_canonical_scalar(shape) {
              SelfHostPlannedValueShape::I32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::I64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::V128PlannedValueShape => {
                return Option::Some(shape)
              }
              _ => {}
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_special_match_initializer_physical_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(initializer) => if initializer < module_.expressions.length() {
      match module_.expressions[initializer].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => match self_host_linked_single_nested_special_match_result_shape(
          link,
          module_,
          body,
          caller_specialization,
          arms,
        ) {
          Option::Some(shape) => Option::Some(shape)
          Option::None => match self_host_linked_expression_container_element_shape(
            link,
            module_,
            body,
            subject,
          ) {
          Option::Some(payload_hint) => {
            if self_host_linked_match_returns_special_binding(module_, arms) {
              return Option::Some(payload_hint)
            }
            let mut arm = 0u32
            let _ = while arm {
              current => if current < arms.length {
                let child = self_host_u32_add(arms.start, current)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
                    if source.flow.falls_through && self_host_u32_greater(
                      module_.expressions.length(),
                      source.body,
                    ) {
                      match module_.expressions[source.body].kind {
                        SelfHostPlannedExpressionKind::PlannedLocalGet(binding) => if self_host_linked_pattern_binds_local(
                          module_,
                          source.pattern,
                          binding,
                        ) {
                          match self_host_linked_pattern_binding_shape(
                            link,
                            module_,
                            source.pattern,
                            binding,
                            payload_hint,
                          ) {
                            Option::Some(shape) => {
                              return Option::Some(shape)
                            }
                            Option::None => {}
                          }
                        }
                        _ => {}
                      }
                    }
                  }
                }
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            Option::None
          }
          Option::None => Option::None
          }
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_special_match_binds_local(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
          let mut arm = 0u32

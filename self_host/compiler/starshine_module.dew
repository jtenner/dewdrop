}

fn self_host_linked_declared_field_value_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> U64 {
  if self_host_u64_equal(field, 0u64) {
    return 0u64
  }
  for module_ in link.fragments.specialization.lowering.modules {
    for layout_field in module_.type_layouts.fields {
      if self_host_u64_equal(layout_field.field, field) {
        return self_host_linked_resolved_nominal_declaration(
          module_,
          layout_field.type_,
        )
      }
    }
  }
  0u64
}

fn self_host_linked_field_value_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, field.type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      if field.field_index < physical.fields.length {
        let physical_field = self_host_linked_physical_field_at(
          physical_module,
          self_host_u32_add(physical.fields.start, field.field_index),
        )
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        match physical_field.role {
          SelfHostPlannedWasmFieldRole::WasmVariantPayloadField(
            variant,
            payload_index,
          ) => {
            for layout_variant in lowering_module.type_layouts.variants {
              if self_host_u64_equal(layout_variant.variant, variant) {
                let payload = match layout_variant.payload {
                  SelfHostPlannedVariantPayloadLayout::PlannedTupleVariantLayout(span) => span
                  SelfHostPlannedVariantPayloadLayout::PlannedStructVariantLayout(span) => span
                  SelfHostPlannedVariantPayloadLayout::PlannedUnitVariantLayout => SelfHostHirSpan::{
                    start: 0u32
                    length: 0u32
                  }
                }
                if payload_index < payload.length {
                  let index = self_host_u32_add(payload.start, payload_index)
                  if index < lowering_module.type_layouts.payload_types.length() {
                    let nominal = self_host_linked_resolved_nominal_declaration(
                      lowering_module,
                      lowering_module.type_layouts.payload_types[index],
                    )
                    if !self_host_u64_equal(nominal, 0u64) {
                      return nominal
                    }
                  }
                }
              }
            }
          }
          _ => {}
        }
        for layout_field in lowering_module.type_layouts.fields {
          if self_host_u64_equal(
            layout_field.field,
            physical_field.declaration,
          ) {
            return self_host_linked_resolved_nominal_declaration(
              lowering_module,
              layout_field.type_,
            )
          }
        }
      }
    }
  }
  0u64
}

fn self_host_linked_field_by_type_name(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  name: String,
) -> Option<SelfHostLinkedWasmFieldLink> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      let mut field_index = 0u32
      let _ = while field_index {
        current => if current < physical.fields.length {
          let field = self_host_linked_physical_field_at(
            physical_module,
            self_host_u32_add(physical.fields.start, current),
          )
          match self_host_linked_field_name(link, field.declaration) {
            Option::Some(candidate) => if candidate == name {
              return Option::Some(SelfHostLinkedWasmFieldLink::{
                type_index: type_index
                field_index: field.physical_index
              })
            }
            Option::None => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_pair_type_for_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  shape: SelfHostPlannedValueShape,
) -> Option<U32> {
  match shape {
    SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => if self_host_u32_equal(
      fields.length(),
      2u32,
    ) {
      let left = self_host_linked_array_carrier_from_shape(fields[0u32])
      let right = self_host_linked_array_carrier_from_shape(fields[1u32])
      Option::Some(
        self_host_linked_array_runtime_base(link) + 30u32 + self_host_i32_to_u32(
          left * 6i32 + right,
        ),
      )
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_product_child_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_match_binding_shape(
        link,
        module_,
        body,
        caller_specialization,
        local_id,
      ) {
        Option::Some(shape) => {
          return shape
        }
        Option::None => match self_host_linked_loop_binding_shape(
          link,
          module_,
          body,
          caller_specialization,
          local_id,
        ) {
          Option::Some(shape) => {
            return shape
          }
          Option::None => {}
        }
      }
      _ => {}
    }
  }
  self_host_linked_backend_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
}

fn self_host_linked_product_new_consumer_pair_type(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Option<U32> {
  let mut local_id = 4294967295u32
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_linked_expression_wraps_expression(
                  module_,
                  value,
                  expression,
                ) {
                  local_id = candidate
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(local_id, 4294967295u32) {
    return Option::None
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let candidate = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[candidate].kind {
        SelfHostPlannedExpressionKind::PlannedProductField(base, _, count) => if self_host_u32_equal(
          count,
          2u32,
        ) && base < module_.expressions.length() {
          match module_.expressions[base].kind {
            SelfHostPlannedExpressionKind::PlannedLocalGet(candidate_local) => if self_host_u32_equal(
              candidate_local,
              local_id,
            ) {
              return self_host_linked_pair_type_for_projection(
                link,
                module_,
                body,
                caller_specialization,
                base,
              )
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_pair_type_for_product_new_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Option<U32> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  let candidate = match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
      let block = module_.blocks[block_index]
      if self_host_u32_greater(block.items.length, 0u32) {
        let item_index = self_host_u32_add(
          block.items.start,
          self_host_u32_subtract(block.items.length, 1u32),
        )
        if item_index < module_.block_items.length() {
          match module_.block_items[item_index].kind {
            SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => value
            _ => expression
          }
        } else {
          expression
        }
      } else {
        expression
      }
    } else {
      expression
    }
    _ => expression
  }
  if candidate >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[candidate].kind {
    SelfHostPlannedExpressionKind::PlannedProductNew(children) => if self_host_u32_equal(
      children.length,
      2u32,
    ) && self_host_u32_add(children.start, 1u32) < module_.expression_children.length() {
      let left = self_host_linked_array_carrier_from_shape(
        self_host_linked_product_child_shape(
          link,
          module_,
          body,
          caller_specialization,
          module_.expression_children[children.start],
        ),
      )
      let right = self_host_linked_array_carrier_from_shape(
        self_host_linked_product_child_shape(
          link,
          module_,
          body,
          caller_specialization,
          module_.expression_children[self_host_u32_add(children.start, 1u32)],
        ),
      )
      Option::Some(
        self_host_linked_array_runtime_base(link) + 30u32 +
          self_host_i32_to_u32(left * 6i32 + right),
      )
    } else {
      Option::None
    }
    _ => Option::None
  }
}


fn self_host_linked_type_argument_nominal_declaration(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  argument: U32,
) -> U64 {
  if type_ < -1i32 {
    return self_host_body_resolved_type_argument_nominal_owner(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
      argument,
    )
  }
  if type_ < 0i32 {
    return 0u64
  }
  let exact_inferred = self_host_merged_module_inference_identity(
    module_.inferred,
  )
  let index = self_host_i32_to_u32(type_)
  if index >= exact_inferred.types.length() {
    return 0u64
  }
  match exact_inferred.types[index] {
    SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      argument,
    ) && self_host_u32_add(arguments.start, argument) < exact_inferred.type_arguments.length() {
      self_host_linked_type_nominal_declaration(
        module_,
        exact_inferred.type_arguments[
          self_host_u32_add(arguments.start, argument)
        ],
      )
    } else {
      0u64
    }
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => self_host_body_resolved_type_argument_nominal_owner(
      module_,
      resolved,
      argument,
    )
    _ => 0u64
  }
}

fn self_host_linked_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if type_ < -1i32 {
    return self_host_linked_resolved_type_argument_shape(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
      argument,
    )
  }
  if type_ < 0i32 {
    return Option::None
  }
  let exact_inferred = self_host_merged_module_inference_identity(
    module_.inferred,
  )
  let index = self_host_i32_to_u32(type_)
  if index >= exact_inferred.types.length() {
    return Option::None
  }
  match exact_inferred.types[index] {
    SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      argument,
    ) && self_host_u32_add(
      arguments.start,
      argument,
    ) < exact_inferred.type_arguments.length() {
      Option::Some(
        self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          exact_inferred,
          exact_inferred.type_arguments[
            self_host_u32_add(arguments.start, argument)
          ],
        ),
      )
    } else {
      Option::None
    }
    SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => self_host_linked_resolved_type_argument_shape(
      module_,
      resolved_type,
      argument,
    )
    _ => Option::None
  }
}

fn self_host_linked_type_nested_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  outer_argument: U32,
  inner_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if type_ < -1i32 {

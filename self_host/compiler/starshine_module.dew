        ) {
          Option::Some(shape) => shape
          Option::None => self_host_linked_static_expression_shape(
            link,
            module_,
            expression,
          )
        }
        Option::None => self_host_linked_static_expression_shape(
          link,
          module_,
          expression,
        )
      }
    } else {
      self_host_linked_static_expression_shape(link, module_, expression)
    }
    _ => self_host_linked_static_expression_shape(link, module_, expression)
  }
}


              // emission runs after this pass and must read the same carrier.
              let carrier = self_host_linked_scalar_local_carrier(local_shape)
              canonical.local_values[materialized_local_slot] = self_host_body_value_with_carrier(
                canonical.local_values[materialized_local_slot],
                carrier,
              )
              canonical.locals[materialized_local_slot] = carrier
            }
            Option::None => {}
          }
          match canonical_body_plan {
            Option::Some(canonical) => if materialized_local_slot < canonical.local_values.length() {
              let canonical_shape = self_host_body_carrier_shape(
                canonical.local_values[materialized_local_slot].carrier,
              )
              if !(canonical_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                canonical_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
              ) && self_host_linked_array_carrier_from_shape(canonical_shape) !=
                self_host_linked_array_carrier_from_shape(local_shape) {
                let message = StringBuilder::new()
                message.append("linked local allocation invariant failed module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(body.declaration)
                message.append(" name=")
                message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                message.append(" body=")
                message.append_u64(body.body)
                message.append(" specialization=")
                message.append_u32(caller_specialization)
                message.append(" local=")
                message.append_u32(planned_local.local_id)
                message.append(" canonical=")
                message.append(self_host_linked_shape_name(canonical_shape))
                message.append(" selected=")
                message.append(self_host_linked_shape_name(local_shape))
                message.append(" logical_type=")
                message.append_i32(planned_local.type_)
                message.append(" planned_shape=")
                message.append(self_host_linked_shape_name(planned_local.shape))
                message.append(" initializer=")
                match self_host_linked_local_initializer_expression(
                  module_,
                  body,
                  planned_local.local_id,
                ) {
                  Option::Some(initializer) => {
                    message.append_u32(initializer)
                    message.append(":")
                    message.append(self_host_body_expression_kind_name(module_.expressions[initializer].kind))
                  }
                  Option::None => message.append("none")
                }
                let mut pattern_offset = 0u32
                let _ = while pattern_offset {
                  candidate_offset => if candidate_offset < body.patterns.length {
                    let candidate_index = self_host_u32_add(
                      body.patterns.start,
                      candidate_offset,
                    )
                    if candidate_index < module_.patterns.length() {
                      let candidate = self_host_planned_pattern_at(module_.patterns, candidate_index)
                      if self_host_linked_pattern_binds_local(
                        module_,
                        candidate_index,
                        planned_local.local_id,
                      ) {
                        message.append(" pattern=")
                        message.append_u32(candidate_index)
                        message.append(":")
                        message.append(self_host_linked_pattern_name(module_, candidate))
                        message.append(":type=")
                        message.append_i32(candidate.type_)
                        message.append(":shape=")
                        message.append(self_host_linked_shape_name(candidate.shape))
                        match candidate.selected_constructor {
                          SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
                            constructor,
                            variant,
                            _,
                          ) => {
                            message.append(":constructor=")
                            message.append_u64(constructor)
                            message.append(":variant=")
                            if variant {
                              message.append("true")
                            } else {
                              message.append("false")
                            }
                          }
                          _ => message.append(":constructor=none")
                        }
                        match self_host_linked_pattern_variant_type(
                          link,
                          module_,
                          candidate,
                          SelfHostPlannedValueShape::ErrorPlannedValueShape,
                          0u64,
                        ) {
                          Option::Some(type_index) => {
                            message.append(":physical_type=")
                            message.append_u32(type_index)
                          }
                          Option::None => message.append(":physical_type=none")
                        }
                      }
                    }
                    continue candidate_offset + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                return Result::Err(message.finish())
              }
            }
            Option::None => {}
          }
          match exact_index_operand_shape {
            Option::Some(index_shape) => if self_host_linked_array_carrier_from_shape(
              index_shape,
            ) != self_host_linked_array_carrier_from_shape(local_shape) {
              let message = StringBuilder::new()
              message.append("linked exact index local allocation invariant failed module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" specialization=")
              message.append_u32(caller_specialization)
              message.append(" local=")
              message.append_u32(planned_local.local_id)
              message.append(" local_slot=")
              message.append_u32(materialized_local_slot)
              message.append(" expected=")
              message.append(self_host_linked_shape_name(index_shape))
              message.append(" selected=")
              message.append(self_host_linked_shape_name(local_shape))
              return Result::Err(message.finish())
            }
            Option::None => {}
          }
          match exact_array_push_item_shape {
            Option::Some(push_shape) => if !(
              push_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
            ) && !(push_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
              self_host_linked_array_carrier_from_shape(push_shape) !=
                self_host_linked_array_carrier_from_shape(local_shape) {
              // The Array push runtime must accept the declared local carrier.
              let message = StringBuilder::new()
              message.append("linked Array push local carrier invariant failed module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" specialization=")
              message.append_u32(caller_specialization)
              message.append(" local=")
              message.append_u32(planned_local.local_id)
              message.append(" local_slot=")
              message.append_u32(materialized_local_slot)
              message.append(" declared=")
              message.append(self_host_linked_shape_name(local_shape))
              message.append(" push=")
              message.append(self_host_linked_shape_name(push_shape))
              return Result::Err(message.finish())
            }
            Option::None => {}
          }
          if !self_host_linked_scalar_append_local_type(locals, local_shape) {
            return Result::Err("linked local type is outside the scalar subset")
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => {
          let mut position = 0u32
          while position {
            index if index < fields.length => {
              let child = module_.object_fields[fields.start + index].value
              let carrier = self_host_linked_exact_emitted_expression_carrier(canonical_body_plan, link, module_, body, caller_specialization, child)
              let shape = if carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier || carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
                // A Unit source is evaluated, then a null storage marker is saved.
                SelfHostPlannedValueShape::RefPlannedValueShape
              } else {
                self_host_body_carrier_shape(carrier)
              }
              if !self_host_linked_scalar_append_local_type(locals, shape) {
                return Result::Err("constructor evaluation has no concrete scratch carrier")
              }
              continue index + 1u32
            }
            _ => break self_host_semantic_unit()
          }
        }
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, _) => {
          let subject_shape = self_host_body_carrier_shape(
            self_host_linked_exact_emitted_expression_carrier(
              canonical_body_plan,
              link,
              module_,
              body,
              caller_specialization,
              subject,
            ),
          )
          let inferred_scratch_shape = self_host_linked_scratch_shape(
            link,
            module_,
            body,
            caller_specialization,
            expression,
          )
          let scratch_shape = if !(subject_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
            subject_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
          ) && !(subject_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
            subject_shape
          } else {
            match self_host_linked_canonical_scratch_shape(
              canonical_body_plan,
              expression,
              0u32,
            ) {
              Option::Some(shape) => shape
              Option::None => if inferred_scratch_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                SelfHostPlannedValueShape::I32PlannedValueShape
              } else {
                inferred_scratch_shape
              }
            }
          }
          if !self_host_linked_scalar_append_local_type(
            locals,
            scratch_shape,
          ) {
            return Result::Err("linked match scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, _) => {
          let initial_shape = self_host_body_carrier_shape(
            self_host_linked_exact_emitted_expression_carrier(
              canonical_body_plan,
              link,
              module_,
              body,
              caller_specialization,
              initial,
            ),
          )
          let inferred_scratch_shape = self_host_linked_scratch_shape(
            link,
            module_,
            body,
            caller_specialization,
            expression,
          )
          let scratch_shape = if !(initial_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
            initial_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
          ) && !(initial_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
            initial_shape
          } else {
            match self_host_linked_canonical_scratch_shape(
              canonical_body_plan,
              expression,
              0u32,
            ) {
              Option::Some(shape) => if self_host_specialization_canonical_scalar(
                shape,
              ) is SelfHostPlannedValueShape::RefPlannedValueShape && !(
                inferred_scratch_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) && !(
                self_host_specialization_canonical_scalar(inferred_scratch_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
              ) {
                inferred_scratch_shape
              } else {
                shape
              }
              Option::None => if inferred_scratch_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                SelfHostPlannedValueShape::I32PlannedValueShape
              } else {
                inferred_scratch_shape
              }
            }
          }
          if !self_host_linked_scalar_append_local_type(
            locals,
            scratch_shape,
          ) {
            return Result::Err("linked loop scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => {
          if !self_host_linked_scalar_append_local_type(
            locals,
            SelfHostPlannedValueShape::RefPlannedValueShape,
          ) {
            return Result::Err("linked function-value scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedProductField(
          base,
          field,
          count,
        ) => {
          let inferred_scratch_shape = if self_host_u32_equal(count, 2u32) {
            match self_host_linked_preferred_pair_type_for_projection(
              link,
              module_,
              body,
              caller_specialization,
              base,
            ) {
              Option::Some(type_index) => match self_host_linked_pair_field_shape(
                link,
                type_index,
                field,
              ) {
                Option::Some(shape) => shape
                Option::None => match self_host_linked_physical_field_shape(
                  link,
                  type_index,
                  field,
                ) {
                  Option::Some(shape) => shape
                  Option::None => module_.expressions[expression].shape
                }
              }
              Option::None => module_.expressions[expression].shape
            }
          } else {
            module_.expressions[expression].shape
          }
          let certified_scratch_shape = self_host_linked_canonical_scratch_shape(
            canonical_body_plan,
            expression,
            0u32,
          )
          let scratch_shape = match certified_scratch_shape {
            Option::Some(shape) => shape
            Option::None => inferred_scratch_shape
          }
          match certified_scratch_shape {
            Option::Some(expected_shape) => if self_host_program_representation_shape_carrier_code(
              self_host_specialization_canonical_scalar(expected_shape),
            ) != self_host_program_representation_shape_carrier_code(
              self_host_specialization_canonical_scalar(scratch_shape),
            ) {
              // A product projection scratch local must use its certified result carrier.
              let message = StringBuilder::new()
              message.append("linked product projection scratch carrier mismatch module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" specialization=")
              message.append_u32(caller_specialization)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" base=")
              message.append_u32(base)
              message.append(" field=")
              message.append_u32(field)
              message.append(" count=")
              message.append_u32(count)
              message.append(" source_shape=")
              message.append(self_host_program_representation_shape_name(
                module_.expressions[expression].shape,
              ))
              message.append(" expected=")
              message.append(self_host_program_representation_shape_name(
                expected_shape,
              ))
              message.append(" actual=")
              message.append(self_host_program_representation_shape_name(
                inferred_scratch_shape,
              ))
              return Result::Err(message.finish())
            }
            Option::None => {}
          }
          if !self_host_linked_scalar_append_local_type(locals, scratch_shape) {
            return Result::Err("linked tuple-field scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
          if !self_host_linked_scalar_append_local_type(
            locals,
            SelfHostPlannedValueShape::RefPlannedValueShape,
          ) {
            return Result::Err("linked array-literal scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedBuiltinCall(name, _, _, _, _) => if name.equals(b"array_new") {
          if !self_host_linked_scalar_append_local_type(locals, SelfHostPlannedValueShape::I32PlannedValueShape) {
            return Result::Err("linked raw array length scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, arguments, _) => if self_host_linked_is_direct_self_host_array_pop(
          module_,
          expression,
        ) {
          if !self_host_linked_append_array_runtime_scratch(locals) {
            return Result::Err("linked self-host pop scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
          if self_host_linked_is_unresolved_iterator_next(module_, expression) {
            if !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) {
              return Result::Err("linked iterator scratch type is unsupported")
            }
          } else if self_host_linked_is_unresolved_array_push(
            module_,
            expression,
          ) {
            if !self_host_linked_append_array_runtime_scratch(locals) {
              return Result::Err("linked array push scratch type is unsupported")
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut capture_local = 0u32
  while capture_local {
    _ => if capture_local < body.locals.length {
    let local = self_host_body_planned_local_identity(module_.locals[body.locals.start + capture_local])
    if self_host_local_needs_capture_cell(module_, local) && !self_host_linked_local_is_erased(canonical_body_plan, module_, body, local.local_id) {
      if !self_host_linked_scalar_append_local_type(locals, SelfHostPlannedValueShape::RefPlannedValueShape) {
        return Result::Err("captured local cell storage is unsupported")
      }
    }
    capture_local = capture_local + 1u32
    continue capture_local
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(locals)
}

fn self_host_linked_i32_declared_local_count(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let mut count = 0u32
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() && !(
        self_host_body_planned_local_identity(module_.locals[source]).kind is SelfHostBodyLocalKind::ParameterLocal
      ) {
        count = self_host_u32_add(count, 1u32)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_u32_add(
    count,
    self_host_linked_i32_scratch_count(module_, body),
  )
}

fn self_host_linked_starshine_validation_error(
  link: SelfHostPlannedProgramWasmGCLink,
) -> String {
  let message = StringBuilder::new()
  message.append(self_host_starshine_validation_error(
    "Starshine rejected the linked self-host output module",
  ))
  let emitted = StarshineFfi.ffi_ffi_bridge_validation_error_function_index()
  if emitted >= 0i32 {
    let logical = self_host_i32_to_u32(emitted)
    let physical = self_host_linked_physical_function_index(logical)
    message.append(" linked_function=")
    message.append_u32(logical)
    message.append(" name=")
    message.append(bytes_to_string(
      self_host_linked_physical_function_name(link, physical),
    ))
    message.append(" module=")
    message.append_u64(self_host_linked_physical_function_module_id(
      link,
      physical,
    ))
    for function_ in link.functions {
      if self_host_u32_equal(function_.function_index, logical) {
        message.append(" declaration=")
        message.append_u64(function_.declaration)
        message.append(" specialization=")
        message.append_u32(function_.specialization)
      }
    }
  }
  message.finish()
}

fn self_host_encode_linked_i32_module(
  module_: StarshineModule,
  link: SelfHostPlannedProgramWasmGCLink,
) -> Result<Bytes, String> {
  let fact_module = StarshineFfi.ffi_ffi_bridge_module_with_dewdrop_compiler_facts(
    module_,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(fact_module) == 0i32 {
    Result::Err(self_host_linked_starshine_validation_error(link))
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(fact_module)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the linked self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => {
          self_host_append_linked_function_names(output, link)
          break Result::Ok(output.finish())
        }
      }
    }
  }
}

fn self_host_linked_append_import_name(
  builder: StarshineImportBuilder,
  value: Bytes,
  module_name: Bool,
) -> Unit {
  let _ = while 0u32 {
    index => if index < value.byte_length() {
      let byte = u8_into_i32(value.byte_at(index))
      if module_name {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_module_byte(
          builder,
          byte,
        )
      } else {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_field_byte(
          builder,
          byte,
        )
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}





fn self_host_linked_emitted_local_carrier_error(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  local_id: U32,
  expression: U32,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> String {
  let message = StringBuilder::new()
  message.append("emitted local carrier mismatch module=")
  message.append_u64(plan.module_id)
  message.append(" declaration=")
  message.append_u64(plan.declaration)
  message.append(" name=")
  message.append(bytes_to_string(self_host_linked_declaration_name(
    link,
    plan.declaration,
  )))
  message.append(" body=")
  message.append_u64(plan.body)
  message.append(" specialization=")
  message.append_u32(plan.specialization)
  message.append(" local=")
  message.append_u32(local_id)
  message.append(" expression=")
  message.append_u32(expression)
  if expression < module_.expressions.length() {
    message.append(":")
    message.append(self_host_body_expression_kind_name(
      module_.expressions[expression].kind,
    ))
  }
  message.append(" expected=")
  message.append(self_host_body_carrier_name(expected))
  message.append(" actual=")
  message.append(self_host_body_carrier_name(actual))
  message.finish()
}

fn self_host_linked_emitted_local_carriers_match(
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Bool {
  expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    actual is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    actual is SelfHostWasmBodyCarrier::NeverBodyCarrier ||
    self_host_body_carrier_equal(expected, actual)
}

fn self_host_linked_certified_array_method_function(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
  explicit_argument_count: U32,
  selected_declaration: U64,
) -> U32 {
  let mut declaration = selected_declaration
  if self_host_u64_equal(declaration, 0u64) {
  let mut candidate_module_index = 0u32
  let _ = while candidate_module_index {
    current_module => if current_module < link.fragments.specialization.lowering.modules.length() {
      let candidate_module = link.fragments.specialization.lowering.modules[current_module]
      let functions = self_host_planned_module_functions_identity(
        candidate_module.functions,
      )
      let mut callable_index = 0u32
      let _ = while callable_index {
        current_callable => if current_callable < functions.callables.length() {
          let callable = self_host_planned_callable_identity(
            functions.callables[current_callable],
          )
          let owner = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
      if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) &&
        self_host_u32_equal(
          callable.parameters.length,
          explicit_argument_count,
        ) && self_host_u64_equal(
          self_host_semantic_id_module(owner),
          link.array_module_id,
        ) {
        if !self_host_u64_equal(declaration, 0u64) && !self_host_u64_equal(
          declaration,
          callable.declaration,
        ) {
          return 4294967295u32
        }
            declaration = callable.declaration
          }
          continue current_callable + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  }
  let desired_shape = match self_host_linked_expression_container_element_shape(
    link,
    module_,
    body,
    receiver,
  ) {
    Option::Some(shape) => shape
    Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let desired_carrier = self_host_linked_array_carrier_from_shape(desired_shape)
  if self_host_u64_equal(declaration, 0u64) {
    return 4294967295u32
  }
  let mut specialized = 4294967295u32
  let mut canonical = 4294967295u32
  let mut function_index = 0u32
  let _ = while function_index {
    current => if current < link.functions.length() {
      let function_ = link.functions[current]
      if self_host_linked_named_function_matches(function_, declaration) {
      let physical = self_host_linked_physical_function_index(
        function_.function_index,
      )
      let specialization_shape = self_host_linked_physical_function_specialization_shape(
        link,
        physical,
      )
      let carrier = self_host_linked_array_carrier_from_shape(
        specialization_shape,
      )
      if desired_carrier < 0i32 || desired_carrier == carrier {
        if self_host_u32_equal(function_.specialization, 4294967295u32) {
          if !self_host_u32_equal(canonical, 4294967295u32) && !self_host_u32_equal(
            canonical,
            function_.function_index,
          ) {
            return 4294967295u32
          }
          canonical = function_.function_index
        } else {
          if !self_host_u32_equal(specialized, 4294967295u32) && !self_host_u32_equal(
            specialized,
            function_.function_index,
          ) {
            return 4294967295u32
          }
          specialized = function_.function_index
        }
      }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if !self_host_u32_equal(specialized, 4294967295u32) {
    specialized
  } else {
    canonical
  }
}

fn self_host_certify_one_physical_method_call_error(
  link: SelfHostPlannedProgramWasmGCLink,
  body_plan: SelfHostPlannedProgramWasmBodyPlan,
) -> Option<String> {
  for plan in body_plan.bodies {
    if plan.module_index < link.fragments.specialization.lowering.modules.length() {
      let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
      match self_host_body_lookup_for_plan(module_, plan) {
        Option::Some(body) => for expression_plan in plan.expressions {
          if self_host_u32_equal(
            expression_plan.call_function_index,
            4294967295u32,
          ) {
            match module_.expressions[expression_plan.expression].kind {
              SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
                target,
                arguments,
              ) => if target < module_.expressions.length() {
                match module_.expressions[target].kind {
                  SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                    receiver,
                    name_index,
                  ) => if name_index < self_host_linked_module_name_count(module_) {
                    let receiver_type = self_host_linked_canonical_expression_heap_type(
                      Option::Some(plan),
                      module_,
                      body,
                      receiver,
                    )
                    let receiver_element_shape = self_host_linked_expression_container_element_shape(
                      link,
                      module_,
                      body,
                      receiver,
                    )
                    let receiver_has_array_element = match receiver_element_shape {
                      Option::Some(shape) => !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape)
                      Option::None => false
                    }
                    let receiver_is_array = self_host_linked_expression_is_array_value(
                      link,
                      module_,
                      body,
                      receiver,
                    )
                    let name = self_host_linked_module_name_at(
                      module_,
                      name_index,
                    )
                    let selected_method_declaration = match module_.expressions[
                      expression_plan.expression
                    ].call_target {
                      SelfHostBasicCallTarget::SelectedBasicCallTarget(
                        declaration,
                        _,
                      ) => declaration
                      _ => 0u64
                    }
                    let selected_array_method = if self_host_u64_equal(
                      selected_method_declaration,
                      0u64,
                    ) {
                      false
                    } else if !self_host_u64_equal(
                      self_host_linked_declaration_owner_module_id(
                        link,
                        selected_method_declaration,
                      ),
                      link.array_module_id,
                    ) {
                      false
                    } else {
                      self_host_linked_declaration_name(
                        link,
                        selected_method_declaration,
                      ).ends_with(name.as_bytes())
                    }
                    match receiver_type {
                      Option::Some(type_index) => if name == "iter" && (
                        self_host_u32_equal(
                          type_index,
                          self_host_linked_array_wrapper_type(link),
                        ) || receiver_has_array_element || receiver_is_array ||
                          selected_array_method
                      ) {
                        let function_index = self_host_linked_certified_array_method_function(
                          link,
                          module_,
                          body,
                          receiver,
                          name,
                          arguments.length,
                          selected_method_declaration,
                        )
                        if self_host_u32_equal(
                          function_index,
                          4294967295u32,
                        ) {
                          let message = StringBuilder::new()
                          message.append("physical method certification has no unique Array target module=")
                          message.append_u64(plan.module_id)
                          message.append(" declaration=")
                          message.append_u64(plan.declaration)
                          message.append(" name=")
                          message.append(bytes_to_string(self_host_linked_declaration_name(
                            link,
                            plan.declaration,
                          )))
                          message.append(" expression=")
                          message.append_u32(expression_plan.expression)
                          message.append(" method=")
                          message.append(name)
                          for candidate_module in link.fragments.specialization.lowering.modules {
                            for callable in candidate_module.functions.callables {
                              if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) {
                                let owner = self_host_linked_resolved_nominal_declaration(
                                  candidate_module,
                                  callable.self_type,
                                )
                                if self_host_u64_equal(
                                  self_host_semantic_id_module(owner),
                                  link.array_module_id,
                                ) {
                                  message.append(" candidate_declaration=")
                                  message.append_u64(callable.declaration)
                                  for function_ in link.functions {
                                    if self_host_u64_equal(
                                      function_.declaration,
                                      callable.declaration,
                                    ) {
                                      message.append(":function=")
                                      message.append_u32(function_.function_index)
                                      message.append(":specialization=")
                                      message.append_u32(function_.specialization)
                                      message.append(":shape=")
                                      message.append(self_host_linked_shape_name(
                                        self_host_linked_physical_function_specialization_shape(
                                          link,
                                          self_host_linked_physical_function_index(
                                            function_.function_index,
                                          ),
                                        ),
                                      ))
                                    }
                                  }
                                }
                              }
                            }
                          }
                          let _ = self_host_body_plan_set_call_function(
                            body,
                            plan.expressions,
                            expression_plan.expression,
                            4294967294u32,
                          )
                        return Option::Some(message.finish())
                        }
                        let _ = self_host_body_plan_set_call_function(
                          body,
                          plan.expressions,
                          expression_plan.expression,
                          function_index,
                        )
                      } else if name == "iter" {
                        let message = StringBuilder::new()
                        message.append("physical method certification has no Array receiver proof module=")
                        message.append_u64(plan.module_id)
                        message.append(" declaration=")
                        message.append_u64(plan.declaration)
                        message.append(" name=")
                        message.append(bytes_to_string(self_host_linked_declaration_name(
                          link,
                          plan.declaration,
                        )))
                        message.append(" expression=")
                        message.append_u32(expression_plan.expression)
                        message.append(" receiver=")
                        message.append_u32(receiver)
                        message.append(" receiver_type=")
                        message.append_u32(type_index)
                        match self_host_body_plan_expression(plan, receiver) {
                          Option::Some(receiver_plan) => {
                            message.append(" nominal=")
                            message.append_u64(receiver_plan.value.nominal_owner)
                            message.append(" heap=")
                            message.append_u32(receiver_plan.value.physical_heap_type)
                            message.append(" carrier=")
                            message.append(self_host_body_carrier_name(
                              receiver_plan.value.carrier,
                            ))
                            message.append(" selected_field=")
                            message.append_u64(receiver_plan.selected_field)
                            for field_module in link.fragments.specialization.lowering.modules {
                              for layout_field in field_module.type_layouts.fields {
                                if self_host_u64_equal(
                                  layout_field.field,
                                  receiver_plan.selected_field,
                                ) {
                                  message.append(" field_module=")
                                  message.append_u64(field_module.module_id)
                                  message.append(" field_type=")
                                  message.append_u32(layout_field.type_)
                                  message.append(" field_nominal=")
                                  message.append_u64(self_host_linked_resolved_nominal_declaration(
                                    field_module,
                                    layout_field.type_,
                                  ))
                                }
                              }
                            }
                          }
                          Option::None => message.append(" receiver_plan=missing")
                        }
                        let _ = self_host_body_plan_set_call_function(
                          body,
                          plan.expressions,
                          expression_plan.expression,
                          4294967294u32,
                        )
                        return Option::Some(message.finish())
                      }
                      Option::None => if name == "iter" && (
                        receiver_has_array_element || receiver_is_array ||
                          selected_array_method
                      ) {
                        let function_index = self_host_linked_certified_array_method_function(
                          link,
                          module_,
                          body,
                          receiver,
                          name,
                          arguments.length,
                          selected_method_declaration,
                        )
                        if self_host_u32_equal(
                          function_index,
                          4294967295u32,
                        ) {
                          let message = StringBuilder::new()
                          message.append("physical method certification has no unique Array target method=")
                          message.append(name)
                          message.append(" selected_declaration=")
                          message.append_u64(selected_method_declaration)
                          message.append(" array_module=")
                          message.append_u64(link.array_module_id)
                          message.append(" receiver=")
                          message.append_u32(receiver)
                          match receiver_element_shape {
                            Option::Some(shape) => {
                              message.append(" element_shape=")
                              message.append(self_host_linked_shape_name(shape))
                              message.append(" element_carrier=")
                              message.append_i32(
                                self_host_linked_array_carrier_from_shape(shape),
                              )
                            }
                            Option::None => message.append(" element_shape=none")
                          }
                          for candidate_module in link.fragments.specialization.lowering.modules {
                            for callable in candidate_module.functions.callables {
                              if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) {
                                let owner = self_host_linked_resolved_nominal_declaration(
                                  candidate_module,
                                  callable.self_type,
                                )
                                if self_host_u64_equal(
                                  self_host_semantic_id_module(owner),
                                  link.array_module_id,
                                ) {
                                  message.append(" declaration=")
                                  message.append_u64(callable.declaration)
                                  for function_ in link.functions {
                                    if self_host_u64_equal(
                                      function_.declaration,
                                      callable.declaration,
                                    ) {
                                      message.append(":function=")
                                      message.append_u32(function_.function_index)
                                      message.append(":specialization=")
                                      message.append_u32(function_.specialization)
                                    }
                                  }
                                }
                              }
                            }
                          }
                          let _ = self_host_body_plan_set_call_function(
                            body,
                            plan.expressions,
                            expression_plan.expression,
                            4294967294u32,
                          )
                        return Option::Some(message.finish())
                        }
                        let _ = self_host_body_plan_set_call_function(
                          body,
                          plan.expressions,
                          expression_plan.expression,
                          function_index,
                        )
                      } else if name == "iter" {
                        let message = StringBuilder::new()
                        message.append("physical method certification has no receiver type module=")
                        message.append_u64(plan.module_id)
                        message.append(" declaration=")
                        message.append_u64(plan.declaration)
                        message.append(" name=")
                        message.append(bytes_to_string(self_host_linked_declaration_name(
                          link,
                          plan.declaration,
                        )))
                        message.append(" expression=")
                        message.append_u32(expression_plan.expression)
                        message.append(" receiver=")
                        message.append_u32(receiver)
                        match self_host_body_plan_expression(plan, receiver) {
                          Option::Some(receiver_plan) => {
                            message.append(" nominal=")
                            message.append_u64(receiver_plan.value.nominal_owner)
                            message.append(" heap=")
                            message.append_u32(receiver_plan.value.physical_heap_type)
                            message.append(" carrier=")
                            message.append(self_host_body_carrier_name(
                              receiver_plan.value.carrier,
                            ))
                            message.append(" selected_field=")
                            message.append_u64(receiver_plan.selected_field)
                            if receiver < module_.expressions.length() {
                              message.append(" receiver_kind=")
                              message.append(self_host_body_expression_kind_name(
                                module_.expressions[receiver].kind,
                              ))
                              if receiver > 0u32 {
                                let previous = receiver - 1u32
                                message.append(" previous=")
                                message.append_u32(previous)
                                message.append(":")
                                message.append(self_host_body_expression_kind_name(
                                  module_.expressions[previous].kind,
                                ))
                                message.append(":type=")
                                message.append_i32(self_host_planned_expression_at(module_.expressions, previous).type_)
                                message.append(":name=")
                                if self_host_u32_greater(
                                  self_host_linked_module_name_count(module_),
                                  module_.expressions[previous].source_name,
                                ) {
                                  message.append(self_host_linked_module_name_at(
                                    module_,
                                    module_.expressions[previous].source_name,
                                  ))
                                }
                                match module_.expressions[previous].kind {
                                  SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
                                    let tail = self_host_body_block_tail_expression(
                                      module_,
                                      block,
                                    )
                                    message.append(":tail=")
                                    message.append_u32(tail)
                                    if tail < module_.expressions.length() {
                                      message.append(":")
                                      message.append(self_host_body_expression_kind_name(
                                        module_.expressions[tail].kind,
                                      ))
                                    }
                                  }
                                  _ => {}
                                }
                              }
                              if receiver > 1u32 {
                                let previous = receiver - 2u32
                                message.append(" previous2=")
                                message.append_u32(previous)
                                message.append(":")
                                message.append(self_host_body_expression_kind_name(
                                  module_.expressions[previous].kind,
                                ))
                                message.append(":type=")
                                message.append_i32(self_host_planned_expression_at(module_.expressions, previous).type_)
                                message.append(":name=")
                                if self_host_u32_greater(
                                  self_host_linked_module_name_count(module_),
                                  module_.expressions[previous].source_name,
                                ) {
                                  message.append(self_host_linked_module_name_at(
                                    module_,
                                    module_.expressions[previous].source_name,
                                  ))
                                }
                              }
                              if receiver > 2u32 {
                                let previous = receiver - 3u32
                                message.append(" previous3=")
                                message.append_u32(previous)
                                message.append(":")
                                message.append(self_host_body_expression_kind_name(
                                  module_.expressions[previous].kind,
                                ))
                                message.append(":type=")
                                message.append_i32(self_host_planned_expression_at(module_.expressions, previous).type_)
                                message.append(":name=")
                                if self_host_u32_greater(
                                  self_host_linked_module_name_count(module_),
                                  module_.expressions[previous].source_name,
                                ) {
                                  message.append(self_host_linked_module_name_at(
                                    module_,
                                    module_.expressions[previous].source_name,
                                  ))
                                }
                              }
                              match module_.expressions[receiver].kind {
                                SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                                  message.append(" local=")
                                  message.append_u32(local_id)
                                  let local_slot = self_host_body_local_slot(
                                    module_,
                                    body,
                                    local_id,
                                  )
                                  message.append(" local_slot=")
                                  message.append_u32(local_slot)
                                  if local_slot < body.locals.length {
                                    let local_index = self_host_u32_add(
                                      body.locals.start,
                                      local_slot,
                                    )
                                    if local_index < module_.locals.length() {
                                      let planned_local = self_host_body_planned_local_identity(
                                        module_.locals[local_index],
                                      )
                                      message.append(" local_type=")
                                      message.append_i32(planned_local.type_)
                                      message.append(" local_nominal=")
                                      message.append_u64(planned_local.nominal)
                                      message.append(" local_owner=")
                                      message.append_u64(
                                        self_host_linked_type_nominal_declaration(
                                          module_,
                                          planned_local.type_,
                                        ),
                                      )
                                      message.append(" local_kind=")
                                      match planned_local.kind {
                                        SelfHostBodyLocalKind::ParameterLocal => message.append("parameter")
                                        SelfHostBodyLocalKind::LetLocal => message.append("let")
                                        SelfHostBodyLocalKind::PatternLocal => message.append("pattern")
                                      }
                                      if !(planned_local.type_ < 0i32) {
                                        let type_index = self_host_i32_to_u32(
                                          planned_local.type_,
                                        )
                                        if type_index < module_.inferred.types.length() {
                                          message.append(" local_type_term=")
                                          match module_.inferred.types[type_index] {
                                            SelfHostBodyTypeTerm::BodyMemberTypeProjection(owner, _, _) => {
                                              message.append("member-projection:")
                                              message.append_i32(owner)
                                            }
                                            SelfHostBodyTypeTerm::BodyErrorType => message.append("error")
                                            SelfHostBodyTypeTerm::BodyResolvedType(resolved) => {
                                              message.append("resolved:")
                                              message.append_u32(resolved)
                                              message.append(":owner:")
                                              message.append_u64(
                                                self_host_linked_resolved_nominal_declaration(
                                                  module_,
                                                  resolved,
                                                ),
                                              )
                                            }
                                            SelfHostBodyTypeTerm::BodyVariableType(variable) => {
                                              message.append("variable:")
                                              message.append_u32(variable)
                                            }
                                            SelfHostBodyTypeTerm::BodyProductType(_) => message.append("product")
                                            SelfHostBodyTypeTerm::BodyAppliedType(base, _) => {
                                              message.append("applied:")
                                              message.append_i32(base)
                                              message.append(":owner:")
                                              message.append_u64(
                                                self_host_linked_type_nominal_declaration(
                                                  module_,
                                                  base,
                                                ),
                                              )
                                            }
                                            SelfHostBodyTypeTerm::BodyFunctionType(_, _) => message.append("function")
                                          }
                                        }
                                      }
                                    }
                                  }
                                  match self_host_linked_local_parameter_position(
                                    module_,
                                    body,
                                    local_id,
                                  ) {
                                    Option::Some(pair) => {
                                      let (position, count) = pair
                                      message.append(" parameter_position=")
                                      message.append_u32(position)
                                      message.append(" parameter_count=")
                                      message.append_u32(count)
                                      match self_host_program_specialization_callable(
                                        module_,
                                        body.declaration,
                                      ) {
                                        Option::Some(callable) => {
                                          let exact_callable = self_host_planned_callable_identity(
                                            callable,
                                          )
                                          message.append(" callable_parameters=")
                                          message.append_u32(exact_callable.parameters.start)
                                          message.append(":")
                                          message.append_u32(exact_callable.parameters.length)
                                          message.append(" parameter_nominal=")
                                          message.append_u64(
                                            self_host_linked_callable_parameter_nominal_from_callable(
                                              module_,
                                              exact_callable,
                                              position,
                                              count,
                                            ),
                                          )
                                          if position < exact_callable.parameters.length {
                                            let parameter_index = self_host_u32_add(
                                              exact_callable.parameters.start,
                                              position,
                                            )
                                            if parameter_index < module_.functions.parameters.length() {
                                              let parameter = self_host_planned_parameter_identity(
                                                module_.functions.parameters[parameter_index],
                                              )
                                              message.append(" parameter_type=")
                                              message.append_u32(parameter.type_)
                                              message.append(" resolved_type_count=")
                                              message.append_u32(
                                                self_host_linked_resolved_type_count(module_),
                                              )
                                              if parameter.type_ < self_host_linked_resolved_type_count(
                                                module_,
                                              ) {
                                                message.append(" parameter_type_kind=")
                                                match module_.resolved_types.type_at(
                                                  parameter.type_,
                                                ) {
                                                  SelfHostResolvedType::ErrorType => message.append("error")
                                                  SelfHostResolvedType::MemberTypeProjection(_, _, _) => message.append("member-projection")
                                                  SelfHostResolvedType::NominalType(owner) => {
                                                    message.append("nominal:")
                                                    message.append_u64(owner)
                                                  }
                                                  SelfHostResolvedType::TraitType(owner) => {
                                                    message.append("trait:")
                                                    message.append_u64(owner)
                                                  }
                                                  SelfHostResolvedType::SelfType(owner) => {
                                                    message.append("self:")
                                                    message.append_u64(owner)
                                                  }
                                                  SelfHostResolvedType::AppliedType(base, _) => {
                                                    message.append("applied:")
                                                    message.append_u32(base)
                                                    message.append(":owner:")
                                                    message.append_u64(
                                                      self_host_linked_resolved_nominal_declaration(
                                                        module_,
                                                        base,
                                                      ),
                                                    )
                                                  }
                                                  SelfHostResolvedType::PrimitiveType(_) => message.append("primitive")
                                                  SelfHostResolvedType::ProductType(_) => message.append("product")
                                                  SelfHostResolvedType::FunctionType(_, _) => message.append("function")
                                                  SelfHostResolvedType::GenericParameterType(_) => message.append("generic")
                                                }
                                              }
                                            }
                                          }
                                        }
                                        Option::None => message.append(" callable=none")
                                      }
                                    }
                                    Option::None => message.append(" parameter_position=none")
                                  }
                                  match self_host_linked_local_source_expression(
                                    module_,
                                    body,
                                    local_id,
                                  ) {
                                    Option::Some(source) => {
                                      message.append(" source=")
                                      message.append_u32(source)
                                      if source < module_.expressions.length() {
                                        message.append(":")
                                        message.append(self_host_body_expression_kind_name(
                                          module_.expressions[source].kind,
                                        ))
                                      }
                                    }
                                    Option::None => message.append(" source=none")
                                  }
                                }
                                _ => {}
                              }
                            }
                          }
                          Option::None => message.append(" receiver_plan=missing")
                        }
                        let _ = self_host_body_plan_set_call_function(
                          body,
                          plan.expressions,
                          expression_plan.expression,
                          4294967294u32,
                        )
                        return Option::Some(message.finish())
                      }
                    }
                  }
                  _ => {}
                }
              }
              _ => {}
            }
          }
        }
        Option::None => {}
      }
    }
  }
  Option::None
}

fn self_host_certify_physical_method_calls(
  link: SelfHostPlannedProgramWasmGCLink,
  body_plan: SelfHostPlannedProgramWasmBodyPlan,
) -> Option<String> {
  let report = StringBuilder::new()
  let mut error_count = 0u32
  let error_limit = 10000u32
  let _ = while error_count {
    current => if current < error_limit {
      match self_host_certify_one_physical_method_call_error(link, body_plan) {
        Option::Some(error) => {
          if self_host_u32_greater(current, 0u32) {
            report.append("\n")
          }
          report.append(error)
          error_count = current + 1u32
          continue error_count
        }
        Option::None => break self_host_semantic_unit()
      }
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(error_count, 0u32) {
    Option::None
  } else {
    let message = StringBuilder::new()
    message.append("physical method certification: ")
    message.append_u32(error_count)
    message.append(" error(s)\n")
    message.append(report.finish())
    Option::Some(message.finish())
  }
}

fn self_host_validate_emitted_local_carriers(
  link: SelfHostPlannedProgramWasmGCLink,
  body_plan: SelfHostPlannedProgramWasmBodyPlan,
) -> Option<String> {
  for plan in body_plan.bodies {
    if plan.module_index < link.fragments.specialization.lowering.modules.length() {
      let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
      match self_host_body_lookup_for_plan(module_, plan) {
        Option::Some(body) => {
          for expression_plan in plan.expressions {
            match module_.expressions[expression_plan.expression].kind {
              SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
                let slot = self_host_body_local_slot(module_, body, local_id)
                if slot < plan.local_values.length() {
                  let expected = plan.local_values[slot].carrier
                  let actual = self_host_linked_exact_emitted_expression_carrier(
                    Option::Some(plan),
                    link,
                    module_,
                    body,
                    plan.specialization,
                    value,
                  )
                  if !self_host_linked_emitted_local_carriers_match(
                    expected,
                    actual,
                  ) {
                    // Local emission must use the carrier that body planning certified.
                    return Option::Some(self_host_linked_emitted_local_carrier_error(
                      link,
                      plan,
                      module_,
                      local_id,
                      value,
                      expected,
                      actual,
                    ))
                  }
                }
              }
              _ => {}
            }
          }
          let mut block_offset = 0u32
          let _ = while block_offset {
            current_block => if current_block < body.blocks.length {
              let block_index = self_host_u32_add(
                body.blocks.start,
                current_block,
              )
              if block_index < module_.blocks.length() {
                let items = module_.blocks[block_index].items
                let mut item_offset = 0u32
                let _ = while item_offset {
                  current_item => if current_item < items.length {
                    let item_index = self_host_u32_add(items.start, current_item)
                    if item_index < module_.block_items.length() {
                      match module_.block_items[item_index].kind {
                        SelfHostPlannedBlockItemKind::PlannedLetItem(
                          local_id,
                          _,
                          initializer,
                        ) => {
                          let slot = self_host_body_local_slot(
                            module_,
                            body,
                            local_id,
                          )
                          if slot < plan.local_values.length() {
                            let expected = plan.local_values[slot].carrier
                            let actual = self_host_linked_exact_emitted_expression_carrier(
                              Option::Some(plan),
                              link,
                              module_,
                              body,
                              plan.specialization,
                              initializer,
                            )
                            if !self_host_linked_emitted_local_carriers_match(
                              expected,
                              actual,
                            ) {
                              // A let initializer must fit its certified physical local.
                              return Option::Some(self_host_linked_emitted_local_carrier_error(
                                link,
                                plan,
                                module_,
                                local_id,
                                initializer,
                                expected,
                                actual,
                              ))
                            }
                          }
                        }
                        _ => {}
                      }
                    }
                    continue current_item + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              continue current_block + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        Option::None => {}
      }
    }
  }
  Option::None
}

fn build_self_host_linked_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<Bytes, String> {
  self_host_assert_program_capture_metadata(link.fragments.specialization.lowering, 7u32)
  let body_plan = self_host_plan_program_wasm_bodies(link)
  if self_host_u32_greater(body_plan.diagnostics.length(), 0u32) {
    return Result::Err(
      self_host_program_wasm_body_failure_report(link, body_plan),
    )
  }
  let method_call_certification = self_host_certify_physical_method_calls(
    link,
    body_plan,
  )
  match method_call_certification {
    Option::Some(error) => return Result::Err(error)
    Option::None => {}
  }
  let root_function_candidate = self_host_linked_i32_main_function_index(
    link,
    root_module,
  )
  let root_function_index = if root_function_candidate == 4294967295u32 {
    return Result::Err("linked root function must exist before module emission")
  } else {
    root_function_candidate
  }
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
      let function_value_signatures = []
      let physical_type_error = self_host_linked_append_physical_types(
        link,
        rec_types,
      )
      match physical_type_error {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let imports = StarshineFfi.ffi_ffi_bridge_imports_new()
      let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
      let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
      let globals = StarshineFfi.ffi_ffi_bridge_global_builder_new()
      let function_references = StarshineFfi.ffi_ffi_bridge_function_reference_builder_new()
      let mut linked_function_emit_index = 0u32
      let _ = while linked_function_emit_index {
        current => if current < link.functions.length() {
          let linked_function = self_host_planned_program_wasm_function_identity(
            link.functions[current],
          )
        let fragment_module = link.fragments.modules[linked_function.module_index]
        if !self_host_u32_greater(
          fragment_module.functions.length(),
          linked_function.fragment_index,
        ) {
          return Result::Err("linked I32 function fragment is outside its arena")
        }
        let fragment = fragment_module.functions[linked_function.fragment_index]
        let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
        let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.parameters,
          parameters,
        ) {
          return Result::Err("linked function parameters are outside the emitter subset")
        }
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.results,
          results,
        ) {
          return Result::Err("linked function results are outside the emitter subset")
        }
        let function_type = StarshineFfi.ffi_lib_CompType_func(
          parameters,
          results,
        )
        let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
          function_type,
          wasm_ref_null(),
        )
        StarshineFfi.ffi_ffi_bridge_rec_types_push(
          rec_types,
          StarshineFfi.ffi_lib_RecType_new(subtype),
        )
        let function_type_index = self_host_u32_add(
          link.types.length(),
          linked_function.function_index,
        )
        StarshineFfi.ffi_ffi_bridge_FunctionReferenceBuilder_push(
          function_references,
          self_host_u32_to_i32(
            self_host_linked_emitted_function_index(
              self_host_linked_physical_function_index(
                linked_function.function_index,
              ),
            ),
          ),
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(
            library,
            field,
          ) => {
            let builder = StarshineFfi.ffi_ffi_bridge_import_builder_new(
              self_host_u32_to_i32(function_type_index),
            )
            self_host_linked_append_import_name(builder, library, true)
            self_host_linked_append_import_name(builder, field, false)
            StarshineFfi.ffi_ffi_bridge_imports_push_builder(
              imports,
              builder,
            )
          }
          _ => StarshineFfi.ffi_ffi_bridge_type_indices_push(
            type_indices,
            StarshineFfi.ffi_lib_TypeIdx_new(
              self_host_u32_to_i32(function_type_index),
            ),
          )
        }
                continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_linked_append_text_runtime_types(link, rec_types)
      self_host_linked_append_array_runtime_types(link, rec_types)
      self_host_linked_append_erased_field_box_types(rec_types)
      let function_value_signature_error = self_host_linked_append_function_value_signatures(
        link,
        rec_types,
        function_value_signatures,
      )
      match function_value_signature_error {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let initializer_type_index = self_host_linked_text_runtime_base(link) +
        77u32 + function_value_signatures.length() * 2u32
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        self_host_linked_append_function_value_type(
          rec_types,
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
        )
        let mut initializer_signature = 0u32
        let _ = while initializer_signature {
          current => if current < link.initializers.length() + 1u32 {
            StarshineFfi.ffi_ffi_bridge_type_indices_push(
              type_indices,
              StarshineFfi.ffi_lib_TypeIdx_new(
                self_host_u32_to_i32(initializer_type_index),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let mut initializer_emit_index = 0u32
        let _ = while initializer_emit_index {
          current => if current < link.initializers.length() {
            let initializer = self_host_planned_program_initializer_identity(
              link.initializers[current],
            )
          StarshineFfi.ffi_ffi_bridge_GlobalBuilder_push(
            globals,
            self_host_linked_array_carrier_from_shape(initializer.shape),
          )
                    continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      let mut body_emit_function_index = 0u32
      let _ = while body_emit_function_index {
        current => if current < link.functions.length() {
          let linked_function = self_host_planned_program_wasm_function_identity(
            link.functions[current],
          )
        let canonical_body_plan = self_host_program_wasm_body_plan_for_function(
          body_plan,
          self_host_linked_physical_function_index(linked_function.function_index),
        )
        let fragment_module = link.fragments.modules[linked_function.module_index]
        let fragment = self_host_program_link_fragment_function(
          fragment_module,
          linked_function.fragment_index,
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body_id) => {
            let lowering_module = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
            let body = match self_host_linked_i32_body(lowering_module, body_id) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked function body is missing")
              }
            }
            let result_shape = self_host_linked_specialized_function_result_shape(
              link,
              linked_function,
              fragment_module,
              fragment,
            )
            // Allocate locals from the frozen plan before emitting instructions.
            let locals = match self_host_linked_scalar_locals(
              link,
              canonical_body_plan,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              canonical_body_plan,
              function_value_signatures,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
              instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(_, _) => {}
          SelfHostPlannedWasmFunctionKind::PlannedWasmOutlinedBuiltinFunction(name) => {
            match self_host_append_outlined_builtin(fragment_module, fragment, name, functions) {
              Option::Some(error) => return Result::Err(error)
              Option::None => {}
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(name) => {
            if !self_host_linked_append_runtime_function(
              link,
              functions,
              name,
            ) {
              return Result::Err(bytes_to_string(name))
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
            lambda_id,
          ) => {
            let lowering_module = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
            let body = match self_host_linked_lambda_body(
              lowering_module,
              lambda_id,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked lambda function body is missing")
              }
            }
            let result_shape = self_host_linked_specialized_function_result_shape(
              link,
              linked_function,
              fragment_module,
              fragment,
            )
            let locals = match self_host_linked_scalar_locals(
              link,
              canonical_body_plan,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              canonical_body_plan,
              function_value_signatures,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
              instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction => {
            return Result::Err("linked signature-only function was assigned a physical function")
          }
        }
                continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        let mut initializer_position = 0u32
        let _ = while initializer_position {
          current => if current < link.initializers.length() {
            let initializer = link.initializers[current]
            let lowering_module = self_host_linked_lowering_module_at(
              link,
              initializer.module_index,
            )
            let body = match self_host_linked_i32_body(
              lowering_module,
              initializer.body,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked initializer body is missing")
              }
            }
            let initializer_locals = match self_host_linked_scalar_locals(
              link,
              self_host_program_wasm_body_plan_for_identity(body_plan, lowering_module.module_id, body.body, 4294967295u32),
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let initializer_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              self_host_program_wasm_body_plan_for_identity(body_plan, lowering_module.module_id, body.body, 4294967295u32),
              function_value_signatures,
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
              initializer_instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              initializer_instructions,
              StarshineFfi.ffi_lib_Instruction_global_set(
                StarshineFfi.ffi_lib_GlobalIdx_new(
                  self_host_u32_to_i32(initializer.global_index),
                ),
              ),
            )
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                initializer_locals,
                StarshineFfi.ffi_lib_Expr_new(initializer_instructions),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let start_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
        let mut start_call = 0u32
        let _ = while start_call {
          current => if current < link.initializers.length() {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              start_instructions,
              StarshineFfi.ffi_lib_Instruction_call(
                StarshineFfi.ffi_lib_FuncIdx_new(
                  self_host_u32_to_i32(
                    link.functions.length() + current,
                  ),
                ),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        StarshineFfi.ffi_ffi_bridge_funcs_push(
          functions,
          StarshineFfi.ffi_lib_Func_new(
            StarshineFfi.ffi_lib_Locals_empty(),
            StarshineFfi.ffi_lib_Expr_new(start_instructions),
          ),
        )
      }
      // Local finalization can refine generic carriers. Check the completed
      // plan after all function and initializer locals have been selected.
      match self_host_validate_emitted_local_carriers(link, body_plan) {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
      let import_section = StarshineFfi.ffi_lib_ImportSec_new(imports)
      let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
      let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
      let typed_module = StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      )
      let imported_module = StarshineFfi.ffi_lib_Module_with_import_sec(
        typed_module,
        import_section,
      )
      let coded_module = StarshineFfi.ffi_lib_Module_with_code_sec(
        StarshineFfi.ffi_lib_Module_with_func_sec(
          imported_module,
          function_section,
        ),
        code_section,
      )
      let global_module = StarshineFfi.ffi_ffi_bridge_module_with_globals(
        StarshineFfi.ffi_ffi_bridge_module_with_default_memory(coded_module),
        globals,
      )
      let started_module = if self_host_u32_greater(
        link.initializers.length(),
        0u32,
      ) {
        StarshineFfi.ffi_ffi_bridge_module_with_start_function(
          global_module,
          self_host_u32_to_i32(
            link.functions.length() + link.initializers.length(),
          ),
        )
      } else {
        global_module
      }
      self_host_encode_linked_i32_module(
        StarshineFfi.ffi_ffi_bridge_module_with_declarative_functions(
          StarshineFfi.ffi_ffi_bridge_module_with_compiler_exports(
            started_module,
            self_host_u32_to_i32(root_function_index),
          ),
          function_references,
        ),
        link,
      )
}

pub fn build_self_host_linked_root_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_index: U32,
) -> Result<Bytes, String> {
  let modules = link.fragments.specialization.lowering.modules
  if root_index >= modules.length() {
    let message = StringBuilder::new()
    message.append("linked root module index is outside its arena index=")
    message.append_u32(root_index)
    message.append(" modules=")
    message.append_u32(modules.length())
    Result::Err(message.finish())
  } else {
    build_self_host_linked_i32_module(link, modules[root_index].module_id)
  }
}

          link,
          module_,
          body,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedIfExpression(_, then_block, else_expression) => {
      let then_tail = self_host_body_block_tail_expression(module_, then_block)
      let then_nominal = if self_host_u32_equal(then_tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          then_tail,
        )
      }
      if !self_host_u64_equal(then_nominal, 0u64) {
        then_nominal
      } else {
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          else_expression,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
      let mut selected = 0u64
      let mut arm = 0u32
      let _ = while arm {
        current => if current < arms.length {
          let child = self_host_u32_add(arms.start, current)
          if child < module_.arm_children.length() {
            let arm_index = module_.arm_children[child]
            if arm_index < module_.pattern_arms.length() {

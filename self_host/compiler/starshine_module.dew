          } else {
            break self_host_semantic_unit()
          }
          _ => break self_host_semantic_unit()
        }
      } else {
        break self_host_semantic_unit()
      }
    }
    if source_target < module_.expressions.length() {
      let target_nominal = self_host_linked_expression_container_element_nominal_declaration(
        link,
        module_,
        body,
        source_target,
      )
      if !self_host_u64_equal(target_nominal, 0u64) {
        return target_nominal
      }
      match module_.expressions[source_target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
          let target_nominal = self_host_linked_expression_container_element_nominal_declaration(
            link,
            module_,
            body,
            base,
          )
          if !self_host_u64_equal(target_nominal, 0u64) {
            return target_nominal
          }
        }
        _ => {}
      }
    }
    if self_host_u32_greater(arguments.length, 0u32) &&
      arguments.start < module_.expression_children.length() {
      return self_host_linked_expression_container_element_nominal_declaration(
        link,
        module_,
        body,
        module_.expression_children[arguments.start],

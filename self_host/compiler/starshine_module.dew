            Option::None => {
              return 0u64
            }
          }
        } else {
          return 0u64
        }
        _ => {
          return 0u64
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_expression_container_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(value) => {
            expression = value
            continue current + 1u32
          }
          Option::None => {}
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(elements) => if self_host_u32_equal(
          argument,
          0u32,
        ) && self_host_u32_greater(elements.length, 0u32) &&
          elements.start < module_.expression_children.length() {
          let child = module_.expression_children[elements.start]
          let shape = self_host_linked_static_expression_shape(
            link,
            module_,
            child,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(shape)
          }
        }
        _ => {}
      }
      match self_host_linked_type_argument_shape(
        module_,
        planned.type_,
        argument,
      ) {
        Option::Some(shape) => {
          return Option::Some(shape)
        }
        Option::None => {}
      }
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(value) => {
            expression = value
          }
          Option::None => {
            return Option::None
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          return self_host_linked_callable_result_element_shape(
            link,
            declaration,
          )
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
          link,
          module_,
          body,
          field,
          base,
        ) {
          Option::Some(field_link) => {
            return self_host_linked_field_container_argument_shape(
              link,
              field_link,
              argument,
            )
          }
          Option::None => {
            return Option::None
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          match self_host_linked_field_by_name(
            link,
            self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              base,
            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => {
              return self_host_linked_field_container_argument_shape(
                link,
                field_link,
                argument,
              )
            }
            Option::None => {
              return Option::None
            }
          }
        } else {
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
              name < self_host_linked_module_name_count(module_) {
              let method_name = self_host_linked_module_name_at(module_, name)
              match self_host_linked_method_result_argument_shape_for_receiver(
                link,
                module_,
                body,
                base,
                method_name,
                argument,
              ) {
                Option::Some(shape) => {
                  return Option::Some(shape)
                }
                Option::None => if method_name == "iter" {
                  expression = base
                } else {
                  return Option::None
                }
              }
            } else {
              return Option::None
            }
            _ => {
              return Option::None
            }
          }
        } else {
          return Option::None
        }
        _ => {
          return Option::None
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_expression_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Option<SelfHostPlannedValueShape> {
  self_host_linked_expression_container_argument_shape(
    link,
    module_,
    body,
    root,
    0u32,
  )
}

fn self_host_linked_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if type_ < -1i32 {
    return self_host_linked_resolved_type_argument_shape(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
      argument,
    )
  }
  if type_ < 0i32 {
    return Option::None
  }
  let index = self_host_i32_to_u32(type_)
  if index >= module_.inferred.types.length() {
    return Option::None
  }
  match module_.inferred.types[index] {
    SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      argument,
    ) && self_host_u32_add(
      arguments.start,
      argument,
    ) < module_.inferred.type_arguments.length() {
      Option::Some(
        self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          module_.inferred,
          module_.inferred.type_arguments[
            self_host_u32_add(arguments.start, argument)
          ],
        ),
      )
    } else {
      Option::None
    }
    SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => self_host_linked_resolved_type_argument_shape(
      module_,
      resolved_type,
      argument,
    )
    _ => Option::None
  }
}

fn self_host_linked_type_first_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> Option<SelfHostPlannedValueShape> {
  self_host_linked_type_argument_shape(module_, type_, 0u32)
}

fn self_host_linked_call_base_element_shape(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  if !self_host_u32_greater(arguments.length, 0u32) ||
    arguments.start >= module_.expression_children.length() {
    return Option::None
  }
  let base = module_.expression_children[arguments.start]
  if base >= module_.expressions.length() {
    return Option::None
  }
  self_host_linked_type_first_argument_shape(
    module_,
    module_.expressions[base].type_,
  )
}

fn self_host_linked_call_first_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  planned: SelfHostPlannedExpression,
) -> Option<SelfHostPlannedValueShape> {
  if !self_host_u32_greater(planned.call_type_arguments.length, 0u32) ||
    planned.call_type_arguments.start >= module_.inferred.call_type_arguments.length() {
    return Option::None
  }
  Option::Some(
    self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      module_.inferred.call_type_arguments[planned.call_type_arguments.start],
    ),
  )
}

fn self_host_linked_specialization_first_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
) -> Option<SelfHostPlannedValueShape> {
  if self_host_u32_equal(linked_function.specialization, 4294967295u32) ||
    linked_function.specialization >= link.fragments.specialization.requests.length() {
    return Option::None
  }
  let request = link.fragments.specialization.requests[
    linked_function.specialization
  ]
  if !self_host_u32_greater(request.shapes.length, 0u32) ||
    !self_host_u32_greater(
      link.fragments.specialization.shapes.length(),
      request.shapes.start,
    ) {
    Option::None
  } else {
    Option::Some(
      link.fragments.specialization.shapes[request.shapes.start],
    )
  }
}

fn self_host_linked_function_name(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
) -> Bytes {
  let module_ = link.fragments.specialization.lowering.modules[
    linked_function.module_index
  ]
  match self_host_program_specialization_callable(
    module_,
    linked_function.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
}

fn self_host_linked_function_returns_array_element(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> Bool {
  let body_id = match fragment.kind {
    SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(value) => value
    _ => {
      return false
    }
  }
  let module_ = link.fragments.specialization.lowering.modules[
    linked_function.module_index
  ]
  let body = match self_host_linked_i32_body(module_, body_id) {
    Option::Some(value) => value
    Option::None => {
      return false
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression_index = self_host_u32_add(body.expressions.start, current)
      if expression_index < module_.expressions.length() {
        match module_.expressions[expression_index].kind {
          SelfHostPlannedExpressionKind::PlannedBuiltinCall(name, _, _, _, _) => if name.equals(
            b"array_get",
          ) {
            return true
          }
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            _,
            _,
          ) => match self_host_linked_builtin_name(link, declaration) {
            Option::Some(name) => if name.equals(b"array_get") {
              return true
            }
            Option::None => {}
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
            let source_name = module_.expressions[target].source_name
            if source_name < self_host_linked_module_name_count(module_) {
              let name = self_host_linked_module_name_at(module_, source_name)
              if name == "wasm_array_get" || name == "array_get" {
                return true
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let expression = match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(value) => value
    SelfHostHirBodyRoot::BlockBodyRoot(block) => {
      if block >= module_.blocks.length() {
        return false
      }
      let planned_block = module_.blocks[block]
      if !self_host_u32_greater(planned_block.items.length, 0u32) {
        return false
      }
      let item = self_host_u32_add(
        planned_block.items.start,
        self_host_u32_subtract(planned_block.items.length, 1u32),
      )
      if item >= module_.block_items.length() {
        return false
      }
      match module_.block_items[item].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => value
        SelfHostPlannedBlockItemKind::PlannedReturnItem(value) => value
        _ => {
          return false
        }
      }
    }
  }
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(name, _, _, _, _) => name.equals(
      b"array_get",
    )
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => match self_host_linked_builtin_name(
      link,
      declaration,
    ) {
      Option::Some(name) => name.equals(b"array_get")
      Option::None => false
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      let source_name = module_.expressions[target].source_name
      if source_name < self_host_linked_module_name_count(module_) {
        let name = self_host_linked_module_name_at(module_, source_name)
        name == "wasm_array_get" || name == "array_get"
      } else {
        false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_specialized_function_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
  module_: SelfHostPlannedModuleWasmGCFragments,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> SelfHostPlannedValueShape {
  let fallback = self_host_linked_fragment_result_shape(module_, fragment)
  let name = self_host_linked_function_name(link, linked_function)
  if (name.ends_with(b"get_unchecked") || name.ends_with(b"indexed_get") ||
    self_host_linked_function_returns_array_element(
      link,
      linked_function,
      fragment,
    )) && fallback is SelfHostPlannedValueShape::RefPlannedValueShape {
    match self_host_linked_specialization_first_shape(link, linked_function) {
      Option::Some(shape) => shape
      Option::None => fallback
    }
  } else {
    fallback
  }
}

fn self_host_linked_fragment_result_shape(
  module_: SelfHostPlannedModuleWasmGCFragments,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> SelfHostPlannedValueShape {
  if !self_host_u32_greater(fragment.results.length, 0u32) {
    SelfHostPlannedValueShape::UnitPlannedValueShape
  } else if fragment.results.start < module_.function_value_types.length() {
    self_host_linked_wasm_value_shape(
      module_.function_value_types[fragment.results.start],
    )
  } else {
    SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_i32_append_value_type(
  values: StarshineRef110,
  value: SelfHostPlannedWasmValueType,
) -> Bool {
  match value {
    SelfHostPlannedWasmValueType::WasmI32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedWasmValueType::WasmI64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedWasmValueType::WasmF32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedWasmValueType::WasmF64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedWasmValueType::WasmV128Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedWasmValueType::WasmNullableFuncRefValue => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_funcref_value_type(),
    )
  }
  true
}

fn self_host_linked_i32_append_value_types(
  module_: SelfHostPlannedModuleWasmGCFragments,
  span: SelfHostHirSpan,
  values: StarshineRef110,
) -> Bool {
  let mut index = 0u32
  let _ = while index {
    current => if current < span.length {
      let source = self_host_u32_add(span.start, current)
      if source >= module_.function_value_types.length() ||
        !self_host_linked_i32_append_value_type(
          values,
          module_.function_value_types[source],
        ) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_linked_append_shape_value_types(
  values: StarshineRef110,
  shape: SelfHostPlannedValueShape,
) -> Unit {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::UnitPlannedValueShape => {}
    SelfHostPlannedValueShape::NeverPlannedValueShape => {}
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
    _ => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
  }
}

fn self_host_linked_append_resolved_value_type(
  resolved: SelfHostResolvedModuleTypes,
  type_: U32,
  values: StarshineRef110,
) -> Unit {
  self_host_linked_append_shape_value_types(
    values,
    self_host_planned_resolved_value_shape(resolved, type_),
  )
}

fn self_host_linked_function_value_signature(
  signatures: Array<SelfHostLinkedFunctionValueSignature>,
  module_id: U64,
  expression: U32,
) -> Option<SelfHostLinkedFunctionValueSignature> {
  for signature in signatures {
    if self_host_u64_equal(signature.module_id, module_id) &&
      self_host_u32_equal(signature.expression, expression) {
      return Option::Some(signature)
    }
  }
  Option::None
}

fn self_host_linked_append_body_value_type(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  values: StarshineRef110,
) -> Unit {
  self_host_linked_append_shape_value_types(
    values,
    self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      type_,
    ),
  )
}

fn self_host_linked_append_resolved_function_signature(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  direct_parameters: StarshineRef110,
  entry_parameters: StarshineRef110,
  direct_results: StarshineRef110,
  entry_results: StarshineRef110,
) -> Bool {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return false
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::FunctionType(parameter_types, result_type) => {
      let mut parameter = 0u32
      let _ = while parameter {
        current => if current < parameter_types.length {
          let argument_index = self_host_u32_add(
            parameter_types.start,
            current,
          )
          if argument_index >= self_host_linked_resolved_type_argument_count(module_) {
            return false
          }
          let argument_type = self_host_linked_resolved_type_argument_at(
            module_,
            argument_index,
          )
          self_host_linked_append_resolved_value_type(
            module_.resolved_types,
            argument_type,
            direct_parameters,
          )
          self_host_linked_append_resolved_value_type(
            module_.resolved_types,
            argument_type,
            entry_parameters,
          )
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_linked_append_resolved_value_type(
        module_.resolved_types,
        result_type,
        direct_results,
      )
      self_host_linked_append_resolved_value_type(
        module_.resolved_types,
        result_type,
        entry_results,
      )
      true
    }
    _ => false
  }
}

fn self_host_linked_append_body_function_signature(
  module_: SelfHostPlannedModuleLowering,
  body_type: I32,
  direct_parameters: StarshineRef110,
  entry_parameters: StarshineRef110,
  direct_results: StarshineRef110,
  entry_results: StarshineRef110,
) -> Bool {
  if body_type < -1i32 {
    return self_host_linked_append_resolved_function_signature(
      module_,
      self_host_i32_to_u32(-body_type - 2i32),
      direct_parameters,
      entry_parameters,
      direct_results,
      entry_results,
    )
  }
  if body_type < 0i32 {
    return false
  }
  let type_index = self_host_i32_to_u32(body_type)
  if type_index >= module_.inferred.types.length() {
    return false
  }
  match module_.inferred.types[type_index] {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => self_host_linked_append_resolved_function_signature(
      module_,
      resolved_type,
      direct_parameters,
      entry_parameters,
      direct_results,
      entry_results,
    )
    SelfHostBodyTypeTerm::BodyFunctionType(parameter_types, result_type) => {
      let mut parameter = 0u32
      let _ = while parameter {
        current => if current < parameter_types.length {
          let argument_index = self_host_u32_add(
            parameter_types.start,
            current,
          )
          if argument_index >= module_.inferred.type_arguments.length() {
            return false
          }
          let argument_type = module_.inferred.type_arguments[argument_index]
          self_host_linked_append_body_value_type(
            module_,
            argument_type,
            direct_parameters,
          )
          self_host_linked_append_body_value_type(
            module_,
            argument_type,
            entry_parameters,
          )
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_linked_append_body_value_type(
        module_,
        result_type,
        direct_results,
      )
      self_host_linked_append_body_value_type(
        module_,
        result_type,
        entry_results,
      )
      true
    }
    _ => false
  }
}

fn self_host_linked_append_function_value_type(
  rec_types: StarshineRef33,
  parameters: StarshineRef110,
  results: StarshineRef110,
) -> Unit {
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_func(parameters, results),
        wasm_ref_null(),
      ),
    ),
  )
}

fn self_host_linked_function_value_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= self_host_linked_expression_count(module_) {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = self_host_linked_expression_at(module_, expression)
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      for body in module_.bodies {
        if expression >= body.expressions.start && expression < self_host_u32_add(
          body.expressions.start,
          body.expressions.length,
        ) {
          let mut local = 0u32
          let _ = while local {
            current => if current < body.locals.length {
              let source = self_host_u32_add(body.locals.start, current)
              if source < module_.locals.length() {
                let planned_local = module_.locals[source]
                if self_host_u32_equal(planned_local.local_id, local_id) {
                  match self_host_linked_loop_binding_shape(
                    link,
                    module_,
                    body,
                    0u32,
                    local_id,
                  ) {
                    Option::Some(shape) => {
                      return shape
                    }
                    Option::None => {}
                  }
                  if !(planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return planned_local.shape
                  }
                  let inferred = self_host_planned_merged_body_value_shape(
                    module_.resolved_types,
                    module_.inferred,
                    planned_local.type_,
                  )
                  if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return inferred
                  }
                  match self_host_linked_local_initializer_shape(
                    link,
                    module_,
                    body,
                    0u32,
                    local_id,
                  ) {
                    Option::Some(shape) => {
                      return shape
                    }
                    Option::None => match self_host_linked_local_assignment_shape(
                      link,
                      module_,
                      body,
                      0u32,
                      local_id,
                    ) {
                      Option::Some(shape) => {
                        return shape
                      }
                      Option::None => match self_host_linked_match_binding_shape(
                        link,
                        module_,
                        body,
                        0u32,
                        local_id,
                      ) {
                        Option::Some(shape) => {
                          return shape
                        }
                        Option::None => match self_host_linked_loop_binding_shape(
                          link,
                          module_,
                          body,
                          0u32,
                          local_id,
                        ) {
                          Option::Some(shape) => {
                            return shape
                          }
                          Option::None => {}
                        }
                      }
                    }
                  }
                }
              }
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
      }
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_callable_function_index(link, declaration) {
      Option::Some(function_index) => self_host_linked_physical_function_result_shape(
        link,
        function_index,
      )
      Option::None => self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < self_host_linked_expression_count(module_) {
      match self_host_linked_expression_at(module_, target).kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => if name < self_host_linked_module_name_count(module_) {
          match self_host_linked_method_call_index(
            link,
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(function_index) => self_host_linked_physical_function_result_shape(
              link,
              function_index,
            )
            Option::None => self_host_planned_merged_body_value_shape(
              module_.resolved_types,
              module_.inferred,
              planned.type_,
            )
          }
        } else {
          self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            planned.type_,
          )
        }
        _ => self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          module_.inferred,
          planned.type_,
        )
      }
    } else {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < self_host_linked_expression_count(module_) &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_at(module_, base).nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => shape
          Option::None => self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            planned.type_,
          )
        }
        Option::None => self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          module_.inferred,
          planned.type_,
        )
      }
    } else {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    _ => self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      planned.type_,
    )
  }
}

fn self_host_linked_function_value_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= self_host_linked_expression_count(module_) {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = self_host_linked_expression_at(module_, expression)
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if target < self_host_linked_expression_count(module_) {
      let mut callable_target = target
      match self_host_linked_expression_at(module_, target).kind {
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          callable_target = operand
        }
        _ => {}
      }
      if callable_target < self_host_linked_expression_count(module_) {
        let source_name = self_host_linked_expression_at(
          module_,
          callable_target,
        ).source_name
        if source_name < self_host_linked_module_name_count(module_) {
          match self_host_linked_callable_by_name(
            link,
            self_host_linked_module_name_at(module_, source_name),
          ) {
            Option::Some(callable) => match self_host_linked_callable_function_index(
              link,
              callable.declaration,
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
            Option::None => {}
          }
        }
      }
    }
    _ => {}
  }
  for body in module_.bodies {
    if expression >= body.expressions.start && expression < self_host_u32_add(
      body.expressions.start,
      body.expressions.length,
    ) {
      let mut relative_block = 0u32
      let _ = while relative_block {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          if block_index < module_.blocks.length() {
            let block = module_.blocks[block_index]
            let mut relative_item = 0u32
            let _ = while relative_item {
              current_item => if current_item < block.items.length {
                let item_index = self_host_u32_add(block.items.start, current_item)
                if item_index < module_.block_items.length() {
                  match module_.block_items[item_index].kind {
                    SelfHostPlannedBlockItemKind::PlannedLetItem(
                      local_id,
                      _,
                      value,
                    ) => if self_host_u32_equal(value, expression) {
                      let mut local = 0u32
                      let _ = while local {
                        current => if current < body.locals.length {
                          let source = self_host_u32_add(body.locals.start, current)
                          if source < module_.locals.length() {
                            let planned_local = module_.locals[source]
                            if self_host_u32_equal(planned_local.local_id, local_id) {
                              if !(planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                return planned_local.shape
                              }
                              let inferred = self_host_planned_merged_body_value_shape(
                                module_.resolved_types,
                                module_.inferred,
                                planned_local.type_,
                              )
                              if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                return inferred
                              }
                            }
                          }
                          continue current + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                    }
                    _ => {}
                  }
                }
                continue current_item + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          continue current_block + 1u32

          match pattern.source {
            SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
              children.length,
              0u32,
            ) && children.start < module_.pattern_children.length() {
              let child = module_.pattern_children[children.start]
              if child < module_.patterns.length() {
                match self_host_planned_pattern_at(module_.patterns, child).reference {
                  SelfHostBodyPatternReference::PatternBindingReference(local_id) => {
                    let mut resolved_payload_hint = !(
                      canonical_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape
                    )
                    let child_shape = self_host_planned_pattern_at(module_.patterns, child).shape
                    if !resolved_payload_hint && !(
                      child_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                    ) && !(
                      self_host_physical_scalar_shape(child_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
                    ) {
                      canonical_payload_hint = child_shape
                      resolved_payload_hint = true
                    }
                    if !resolved_payload_hint {
                    match canonical_body_plan {
                      Option::Some(plan) => match self_host_body_plan_pattern_payload_value(
                        plan,
                        module_,
                        body,
                        arm.pattern,
                      ) {
                        Option::Some(value) => if !self_host_u64_equal(
                          value.nominal_owner,
                          0u64,
                        ) || !(
                          value.carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
                        ) {
                          canonical_payload_hint = self_host_body_carrier_shape(
                            value.carrier,
                          )
                          resolved_payload_hint = true
                        }
                        Option::None => {}
                      }
                      Option::None => {}
                    }

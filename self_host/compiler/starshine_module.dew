      self_host_u32_equal(arguments.length, 1u32) {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => name < self_host_linked_module_name_count(
          module_,
        ) && self_host_linked_module_name_at(module_, name) == "push"
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_local_is_pattern(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.locals.length {
      let index = self_host_u32_add(body.locals.start, current)
      if index < module_.locals.length() {
        let local = module_.locals[index]
        if self_host_u32_equal(local.local_id, local_id) {
          return local.kind is SelfHostBodyLocalKind::PatternLocal
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_specialized_call_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      let shape = self_host_linked_physical_function_result_shape(
        link,
        self_host_linked_physical_function_index(call.function_index),
      )
      if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
        return Option::Some(shape)
      }
    }
  }
  Option::None
}

fn self_host_linked_unresolved_get_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) &&
          self_host_linked_module_name_at(module_, name) == "get_unchecked" {
          let direct_owner = self_host_linked_type_owner_module_id(
            link,
            module_,
            module_.expressions[base].type_,
          )
          let owner = if self_host_u64_equal(direct_owner, 0u64) {
            self_host_linked_expression_container_owner_module_id(
              link,
              module_,
              body,
              base,
            )
          } else {
            direct_owner
          }
          let argument = if self_host_u64_equal(owner, 7205u64) {
            1u32
          } else {
            0u32
          }
          self_host_linked_expression_container_argument_shape(
            link,
            module_,
            body,
            base,
            argument,
          )
        } else {
          Option::None
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_array_push_item_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  item: U32,
) -> SelfHostPlannedValueShape {
  if item < module_.expressions.length() {
    match self_host_linked_specialized_call_result_shape(
      link,
      body.body,
      caller_specialization,
      item,
    ) {
      Option::Some(shape) => {
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
          !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
          !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
          return shape
        }
      }
      Option::None => {}
    }
    match module_.expressions[item].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => if self_host_linked_local_is_pattern(
        module_,
        body,
        local_id,
      ) {
        match self_host_linked_loop_binding_shape(
          link,
          module_,
          body,
          caller_specialization,
          local_id,
        ) {
          Option::Some(shape) => {
            return shape
          }
          Option::None => match self_host_linked_match_binding_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
          ) {
            Option::Some(shape) => {
              return shape
            }
            Option::None => {}
          }
        }
      } else {
        match self_host_linked_local_initializer_shape(
          link,
          module_,
          body,
          caller_specialization,
          local_id,
        ) {
          Option::Some(shape) => {
            return shape
          }
          Option::None => match self_host_linked_local_assignment_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
          ) {
            Option::Some(shape) => {
              return shape
            }
            Option::None => {}
          }
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
        match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
            module_,
          ) {
            match self_host_linked_method_call_index_for_receiver(
              link,
              module_,
              body,
              base,
              self_host_linked_module_name_at(module_, name),
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
          }
          _ => {}
        }
      }
      SelfHostPlannedExpressionKind::PlannedDirectCall(
        declaration,
        _,
        _,
        _,
      ) => match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        item,
        declaration,
      ) {
        Option::Some(function_index) => {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
            !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
            return shape
          }
        }
        Option::None => {}
      }
      SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
        let shape = self_host_linked_variant_payload_shape(
          link,
          module_,
          body,
          item,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
        let shape = self_host_linked_variant_payload_shape(
          link,
          module_,
          body,
          item,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      _ => {}
    }
    let shape = self_host_linked_backend_expression_shape(
      link,
      module_,
      body,
      caller_specialization,
      item,
    )
    if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
      return shape
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_unresolved_array_push_item_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {

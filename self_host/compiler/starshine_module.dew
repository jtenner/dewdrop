fn self_host_linked_pattern_local_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
          let mut binds = false
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() &&
                  self_host_linked_pattern_binds_local(
                    module_,
                    self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                    local_id,
                  ) {
                  binds = true
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if binds && subject < module_.expressions.length() {
            match self_host_linked_type_nested_argument_shape(
              module_,
              self_host_planned_expression_at(module_.expressions, subject).type_,
              0u32,
              0u32,
            ) {
              Option::Some(shape) => return Option::Some(shape)
              Option::None => {}
            }
            match module_.expressions[subject].kind {
              SelfHostPlannedExpressionKind::PlannedDirectCall(
                declaration,
                _,
                _,
                _,
              ) => match self_host_linked_callable_result_nested_argument_shape(
                link,
                declaration,
                0u32,
                0u32,
              ) {
                Option::Some(shape) => return Option::Some(shape)
                Option::None => {}
              }
              _ => {}
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_expression_source_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            if self_host_u32_equal(source, expression) {
              return Option::None
            }
            expression = source
          }
          Option::None => return self_host_linked_pattern_local_container_element_shape(
            link,
            module_,
            body,
            local_id,
          )
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field(
          link,
          field,
        ) {
          Option::Some(field_link) => return self_host_linked_field_container_element_shape(
            link,
            field_link,
          )
          Option::None => return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          match self_host_linked_field_by_name(
            link,
            self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              base,
            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => return self_host_linked_field_container_element_shape(
              link,
              field_link,
            )
            Option::None => return Option::None
          }
        } else {
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          target,
          arguments,
          _,
        ) => if self_host_linked_declaration_name(link, declaration).ends_with(b"iter") {
          let mut receiver = 4294967295u32
          if target < module_.expressions.length() {
            match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => {
                receiver = base
              }
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
                receiver = base
              }
              SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                target,
                0u32,
              ) {
                receiver = self_host_u32_subtract(target, 1u32)
              }
              _ => {}
            }
          }
          if self_host_u32_equal(receiver, 4294967295u32) && self_host_u32_greater(
            arguments.length,
            0u32,
          ) && arguments.start < module_.expression_children.length() {
            receiver = module_.expression_children[arguments.start]
          }
          if self_host_u32_equal(receiver, 4294967295u32) {
            return self_host_linked_callable_result_element_shape(link, declaration)
          }
          match self_host_linked_expression_source_container_element_shape(
            link,
            module_,
            body,
            receiver,
          ) {
            Option::Some(shape) => return Option::Some(shape)
            Option::None => return self_host_linked_expression_container_element_shape(
              link,
              module_,
              body,
              receiver,
            )
          }
        } else {
          return self_host_linked_callable_result_element_shape(
            link,
            declaration,
          )
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(elements) => if self_host_u32_greater(
          elements.length,
          0u32,
        ) && elements.start < module_.expression_children.length() {
          return Option::Some(
            self_host_linked_static_expression_shape(
              link,
              module_,
              module_.expression_children[elements.start],
            ),
          )
        } else {
          return Option::None
        }
        _ => return Option::None
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_expression_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,

}

fn self_host_linked_layout_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.type_layouts.layouts.length()
}

fn self_host_linked_layout_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedNominalLayout {
  module_.type_layouts.layouts[index]
}

fn self_host_linked_nominal_is_type_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  nominal: U64,
) -> Bool {
  for module_ in link.fragments.specialization.lowering.modules {
    let mut layout_index = 0u32
    let _ = while layout_index {
      current => if current < self_host_linked_layout_count(module_) {
        let layout = self_host_linked_layout_at(module_, current)
        if self_host_u64_equal(layout.declaration, nominal) {
          return true
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  false
}

fn self_host_linked_field_by_name(
  link: SelfHostPlannedProgramWasmGCLink,
  nominal: U64,
  name: String,
) -> Option<SelfHostLinkedWasmFieldLink> {
  if !self_host_u64_equal(nominal, 0u64) {
    let nominal_is_type_declaration = self_host_linked_nominal_is_type_declaration(
      link,
      nominal,
    )
    for linked_type in link.types {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      let nominal_match = match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(
          declaration,
        ) => !self_host_u64_equal(declaration, 0u64) && self_host_u64_equal(
          declaration,
          nominal,
        )
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
          declaration,
          variant,
          _,
        ) => self_host_u64_equal(declaration, nominal) || (
          !nominal_is_type_declaration && self_host_u64_equal(variant, nominal)
        )
        _ => false
      }
      if nominal_match {
        let mut field_index = 0u32
        let _ = while field_index {
          current => if current < physical.fields.length {
            let field = self_host_linked_physical_field_at(
              physical_module,
              self_host_u32_add(physical.fields.start, current),
            )
            match self_host_linked_field_name(link, field.declaration) {
              Option::Some(candidate) => if candidate == name {
                return Option::Some(SelfHostLinkedWasmFieldLink::{
                  type_index: linked_type.type_index
                  field_index: field.physical_index
                })
              }
              Option::None => {}
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
    }
  }
  // A field name without its nominal owner is not a physical field proof.
  Option::None
}

fn self_host_linked_struct_field_for_base(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  field: U64,
  base: U32,
) -> Option<SelfHostLinkedWasmFieldLink> {
  let nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    base,
  )
  if !self_host_u64_equal(nominal, 0u64) {
    match self_host_linked_field_name(link, field) {
      Option::Some(name) => match self_host_linked_field_by_name(
        link,
        nominal,
        name,
      ) {
        Option::Some(field_link) => {
          return Option::Some(field_link)
        }
        Option::None => {}
      }
      Option::None => {}
    }
  }
  self_host_linked_struct_field(link, field)
}

fn self_host_linked_storage_shape(
  storage: SelfHostPlannedWasmStorageType,
) -> SelfHostPlannedValueShape {
  match storage {
    SelfHostPlannedWasmStorageType::WasmI32Storage => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedWasmStorageType::WasmI64Storage => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedWasmStorageType::WasmF32Storage => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedWasmStorageType::WasmF64Storage => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedWasmStorageType::WasmV128Storage => SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedWasmStorageType::WasmNullableFuncRefStorage => SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_linked_physical_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  field_index: U32,
) -> Option<SelfHostPlannedValueShape> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        module_,
        linked_type.fragment_index,
      )
      let mut index = 0u32
      let _ = while index {
        current => if current < physical.fields.length {
          let field = self_host_linked_physical_field_at(
            module_,
            self_host_u32_add(physical.fields.start, current),
          )
          if self_host_u32_equal(field.physical_index, field_index) {
            return Option::Some(self_host_linked_storage_shape(field.storage))
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_struct_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> Option<SelfHostPlannedValueShape> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    let mut relative = 0u32
    let _ = while relative {
      current => if current < physical.fields.length {
        let source = self_host_linked_physical_field_at(
          module_,
          self_host_u32_add(physical.fields.start, current),
        )
        match source.role {
          SelfHostPlannedWasmFieldRole::WasmStructField(candidate) => if self_host_u64_equal(
            candidate,
            field,
          ) {
            return Option::Some(self_host_linked_storage_shape(source.storage))
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_struct_field(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> Option<SelfHostLinkedWasmFieldLink> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    let mut relative = 0u32
    let _ = while relative {
      current => if current < physical.fields.length {
        let source = self_host_linked_physical_field_at(
          module_,
          self_host_u32_add(physical.fields.start, current),
        )
        match source.role {
          SelfHostPlannedWasmFieldRole::WasmStructField(candidate) => if self_host_u64_equal(
            candidate,
            field,
          ) {
            return Option::Some(SelfHostLinkedWasmFieldLink::{
              type_index: linked_type.type_index
              field_index: source.physical_index
            })
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_body_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.bodies.length()
}

fn self_host_linked_body_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedBodyLowering {
  module_.bodies[index]
}

fn self_host_linked_i32_main_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<SelfHostLinkedRootExpression, String> {
  let mut module_index = 0u32
  let mut owner = 4294967295u32
  let lowering_modules = link.fragments.specialization.lowering.modules
  let _ = while module_index {
    current => if current < lowering_modules.length() {
      if self_host_u64_equal(lowering_modules[current].module_id, root_module) {
        owner = current
        break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(owner, 4294967295u32) {
    return Result::Err("linked root module is missing")
  }
  let module_ = lowering_modules[owner]
  let mut selected_body = 0u64
  let mut selected_declaration = 0u64
  let mut found_body = false
  let functions = module_.functions.callables
  let function_count = array_length(functions)
  let mut function_index = 0u32
  let _ = while function_index {
    current_function => if current_function < function_count {
      let callable = self_host_planned_callable_identity(
        array_get_unchecked(functions, current_function),
      )
      if callable.main_code == 1296124238u32 {
        match callable.kind {
          SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => {
            selected_body = body
            selected_declaration = callable.declaration
            found_body = true
          }
          _ => {}
        }
      }
      continue current_function + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if !found_body {
    if functions.length() == 0u32 {
      return Result::Err("linked root module has no callables")
    }
    let message = StringBuilder::new()
    message.append("linked root module has callables but no main function module=")
    message.append_u64(module_.module_id)
    message.append(" callable_count=")
    message.append_u32(function_count)
    let mut named_main_index = 0u32
    let _ = while named_main_index {
      current => if current < function_count {
        let callable = self_host_planned_callable_identity(
          array_get_unchecked(functions, current),
        )
        if callable.name.equals(b"main") || callable.name.equals(b"_start") ||
          callable.name.equals(b"self_host_main_string_concat") {
          message.append(" named_entry=")
          message.append_u32(current)
          message.append(":")
          message.append_u64(callable.declaration)
          message.append(":name=")
          message.append(bytes_to_string(callable.name))
          message.append(":main=")
          if callable.is_main {
            message.append("true")
          } else {
            message.append("false")
          }
          message.append(":main_code=")
          message.append_u32(callable.main_code)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut diagnostic_index = 0u32
    let _ = while diagnostic_index {
      current => if current < function_count && current < 16u32 {
        let callable = self_host_planned_callable_identity(
          array_get_unchecked(functions, current),
        )
        message.append(" callable=")
        message.append_u32(current)
        message.append(":")
        message.append(bytes_to_string(callable.name))
        message.append(":")
        message.append_u64(callable.declaration)
        message.append(":main=")
        if callable.is_main {
          message.append("true")
        } else {
          message.append("false")
        }
        message.append(":main_code=")
        message.append_u32(callable.main_code)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    return Result::Err(message.finish())
  }
  let mut selected_index = 4294967295u32
  let mut candidate_index = 0u32
  let _ = while candidate_index {
    current => if current < module_.bodies.length() {
      if self_host_u64_equal(module_.bodies[current].body, selected_body) {
        selected_index = current
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(selected_index, 4294967295u32) {
    return Result::Err("linked main function has no body")
  }
  let selected = module_.bodies[selected_index]
  let expression_index = match self_host_linked_root_expression(module_, selected) {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked main body is not a scalar expression")
    }
  }
  if expression_index >= module_.expressions.length() {
    return Result::Err("linked main expression is outside its arena")
  }
  let function_index = match self_host_program_link_function(
    link.functions,
    selected_declaration,
    4294967295u32,
  ) {
    Option::Some(value) => value
    Option::None => return Result::Err("linked main callable has no function")
  }
  Result::Ok(SelfHostLinkedRootExpression::{
    root_module_index: owner
    root_body_index: selected_index
    root_body_id: selected_body
    root_function_index: function_index
  })
}

fn self_host_linked_i32_main_function_index(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> U32 {
  let lowering = link.fragments.specialization.lowering
  let mut owner = 4294967295u32
  let mut module_scan_index = 0u32
  let _ = while module_scan_index {
    current => if current < lowering.modules.length() {
      let module_ = self_host_planned_module_lowering_identity(
        lowering.modules[current],
      )
      if self_host_u64_equal(module_.module_id, root_module) {
        owner = current
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut selected_declaration = 18446744073709551615u64
  let mut selected_function_index = 4294967295u32
  if owner < lowering.modules.length() {
    let module_ = self_host_planned_module_lowering_identity(
      lowering.modules[owner],
    )
    let functions = self_host_planned_module_functions_identity(
      module_.functions,
    )
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < functions.callables.length() {
        let callable = self_host_planned_callable_identity(
          functions.callables[current],
        )
        if callable.main_code == 1296124238u32 {
          match callable.kind {
            SelfHostPlannedCallableKind::PlannedFunctionCallable(_) => {
              selected_declaration = callable.declaration
            }
            _ => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    match self_host_program_link_function(
      link.functions,
      selected_declaration,
      4294967295u32,
    ) {
      Option::Some(function_index) => {
        selected_function_index = function_index
      }
      Option::None => {}
    }
  }
  selected_function_index
}

fn self_host_emit_linked_i32_binary(
  instructions: StarshineInstructions,
  operator: SelfHostHirBinaryOperator,
  unsigned_: Bool,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::BitOr => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_or())
    SelfHostHirBinaryOperator::BitXor => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_xor())
    SelfHostHirBinaryOperator::BitAnd => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_and())
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ne())
    SelfHostHirBinaryOperator::Less => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_lt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_lt_s())
    }
    SelfHostHirBinaryOperator::LessEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_le_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_le_s())
    }
    SelfHostHirBinaryOperator::Greater => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_gt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_gt_s())
    }
    SelfHostHirBinaryOperator::GreaterEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ge_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ge_s())
    }
    SelfHostHirBinaryOperator::ShiftLeft => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shl())
    SelfHostHirBinaryOperator::ShiftRight => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shr_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shr_s())
    }
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_mul())
    SelfHostHirBinaryOperator::Divide => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_div_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_div_s())
    }
    SelfHostHirBinaryOperator::Remainder => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_rem_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_rem_s())
    }
    _ => {
      return false
    }
  }
  true
}


open dew.std.bytes
open dew.std.bytes_builder
open dew.std.option
open dew.std.result
open dew.std.string_builder
open dew.std.text_runtime
open dew.std.wasm.intrinsics

fn self_host_i32_to_u32(value: I32) -> U32 {
  value.into()
}

fn self_host_i32_to_u8(value: I32) -> U8 {
  value.into()
}

fn self_host_encode_i32_function(
  instructions: StarshineRef45,
  local_count: U32,
) -> Result<Bytes, String> {
  let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
  let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
  StarshineFfi.ffi_ffi_bridge_val_types_push(
    results,
    StarshineFfi.ffi_lib_ValType_i32(),
  )
  let function_type = StarshineFfi.ffi_lib_CompType_func(parameters, results)
  let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
    function_type,
    wasm_ref_null(),
  )
  let rec_type = StarshineFfi.ffi_lib_RecType_new(subtype)
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
  StarshineFfi.ffi_ffi_bridge_rec_types_push(rec_types, rec_type)
  let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
  let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
  StarshineFfi.ffi_ffi_bridge_type_indices_push(
    type_indices,
    StarshineFfi.ffi_lib_TypeIdx_new(0i32),
  )
  let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
  let expression = StarshineFfi.ffi_lib_Expr_new(instructions)
  let locals = if self_host_u32_equal(local_count, 0u32) {
    StarshineFfi.ffi_lib_Locals_empty()
  } else {
    StarshineFfi.ffi_lib_Locals_single(
      local_count.into(),
      StarshineFfi.ffi_lib_ValType_i32(),
    )
  }
  let function_ = StarshineFfi.ffi_lib_Func_new(locals, expression)
  let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions, function_)
  let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
  let module_ = StarshineFfi.ffi_lib_Module_with_code_sec(
    StarshineFfi.ffi_lib_Module_with_func_sec(
      StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      ),
      function_section,
    ),
    code_section,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(module_) == 0i32 {
    Result::Err("Starshine rejected the self-host output module")
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(module_)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

pub fn build_self_host_i32_module(value: I32) -> Result<Bytes, String> {
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    instructions,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(value),
    ),
  )
  self_host_encode_i32_function(instructions, 0u32)
}

fn self_host_u64_to_i32(value: U64) -> I32 {
  value.into()
}

fn self_host_linked_root_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Option<U32> {
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => Option::Some(expression)
    SelfHostHirBodyRoot::BlockBodyRoot(block_index) => {
      if block_index >= module_.blocks.length() {
        return Option::None
      }
      let block = module_.blocks[block_index]
      if self_host_u32_equal(block.items.length, 0u32) {
        return Option::None
      }
      let item_index = self_host_u32_add(
        block.items.start,
        self_host_u32_subtract(block.items.length, 1u32),
      )
      if item_index >= module_.block_items.length() {
        return Option::None
      }
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => Option::Some(expression)
        SelfHostPlannedBlockItemKind::PlannedReturnItem(expression) => Option::Some(expression)
        _ => Option::None
      }
    }
  }
}

struct SelfHostLinkedRootExpression {
  module_index: U32
  body_index: U32
}

struct SelfHostLinkedWasmFieldLink {
  type_index: U32
  field_index: U32
}

struct SelfHostLinkedI32LoopLink {
  control: U32
  state_slot: U32
  block_depth: U32
  loop_depth: U32
}

struct SelfHostLinkedFunctionValueSignature {
  module_id: U64
  expression: U32
  direct_type_index: U32
  entry_type_index: U32
}

enum SelfHostLinkedI32EmitTask {
  VisitLinkedI32Expression(U32, StarshineRef45)
  EmitLinkedI32Prefix(SelfHostHirPrefixOperator, StarshineRef45)
  EmitLinkedI64Prefix(SelfHostHirPrefixOperator, StarshineRef45)
  EmitLinkedF32Prefix(SelfHostHirPrefixOperator, StarshineRef45)
  EmitLinkedF64Prefix(SelfHostHirPrefixOperator, StarshineRef45)
  EmitLinkedI32Binary(SelfHostHirBinaryOperator, Bool, StarshineRef45)
  EmitLinkedI64Binary(SelfHostHirBinaryOperator, Bool, StarshineRef45)
  EmitLinkedF32Binary(SelfHostHirBinaryOperator, StarshineRef45)
  EmitLinkedF64Binary(SelfHostHirBinaryOperator, StarshineRef45)
  EmitLinkedRefBinary(SelfHostHirBinaryOperator, StarshineRef45)
  EmitLinkedBuiltin(Bytes, StarshineRef45)
  EmitLinkedConversion(
    SelfHostPlannedValueShape,
    SelfHostPlannedValueShape,
    StarshineRef45,
  )
  EmitLinkedArrayBuiltin(Bytes, U32, StarshineRef45)
  EmitLinkedArrayEmpty(U32, StarshineRef45)
  EmitLinkedMapEmpty(U32, StarshineRef45)
  EmitLinkedArrayIterNext(U32, I32, U32, StarshineRef45)
  EmitLinkedArrayPush(U32, I32, U32, StarshineRef45)
  EmitLinkedArraySetPrefix(U32, U32, StarshineRef45)
  EmitLinkedArraySet(U32, StarshineRef45)
  EmitLinkedFixedArrayGetPrefix(U32, StarshineRef45)
  EmitLinkedFixedArrayGet(U32, StarshineRef45)
  EmitLinkedMapContainsKey(U32, I32, U32, StarshineRef45)
  EmitLinkedMapGet(U32, I32, I32, U32, StarshineRef45)
  EmitLinkedMapSet(U32, I32, I32, U32, StarshineRef45)
  EmitLinkedI32Call(U32, StarshineRef45)
  PrepareLinkedFunctionValueCall(U32, StarshineRef45)
  EmitLinkedFunctionValueCall(
    U32,
    U32,
    U32,
    U32,
    SelfHostHirSpan,
    SelfHostPlannedValueShape,
    U32,
    StarshineRef45,
  )
  FinishLinkedFunctionValueCall(U32, U32, U32, StarshineRef45)
  EmitLinkedProductField(U32, U32, U32, StarshineRef45)
  EmitLinkedLocalGet(U32, StarshineRef45)
  EmitLinkedStructNew(U32, StarshineRef45)
  EmitLinkedStructGet(U32, U32, StarshineRef45)
  EmitLinkedRefCast(U32, StarshineRef45)
  EmitLinkedStructSet(U32, U32, StarshineRef45)
  EmitLinkedI32If(
    StarshineRef45,
    StarshineRef45,
    StarshineRef45,
    SelfHostPlannedValueShape,
  )
  EmitLinkedI32Loop(
    StarshineRef45,
    StarshineRef45,
    StarshineRef45,
    SelfHostPlannedValueShape,
  )
  EmitLinkedI32Break(U32, U32, StarshineRef45)
  EmitLinkedI32Continue(U32, U32, StarshineRef45)
  VisitLinkedI32MatchArms(
    SelfHostHirSpan,
    U32,
    U32,
    StarshineRef45,
    U32,
    SelfHostPlannedValueShape,
    SelfHostPlannedValueShape,
  )
  VisitLinkedI32Block(U32, StarshineRef45)
  EmitLinkedI32LocalSet(U32, StarshineRef45)
  EmitLinkedI32Return(StarshineRef45)
  EmitLinkedI32Drop(StarshineRef45)
  EmitLinkedUnreachable(StarshineRef45)
}

fn self_host_linked_block_type(
  shape: SelfHostPlannedValueShape,
) -> StarshineRef0 {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::RefPlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedValueShape::GenericPlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    _ => StarshineFfi.ffi_lib_BlockType_void_()
  }
}

fn self_host_linked_block_result_shape(
  module_: SelfHostPlannedModuleLowering,
  block: U32,
) -> SelfHostPlannedValueShape {
  if block >= module_.blocks.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let planned_block = module_.blocks[block]
  if !self_host_u32_greater(planned_block.items.length, 0u32) {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let item_index = self_host_u32_add(
    planned_block.items.start,
    self_host_u32_subtract(planned_block.items.length, 1u32),
  )
  if item_index >= module_.block_items.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  match module_.block_items[item_index].kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => if expression < module_.expressions.length() {
      module_.expressions[expression].shape
    } else {
      SelfHostPlannedValueShape::UnitPlannedValueShape
    }
    SelfHostPlannedBlockItemKind::PlannedReturnItem(_) => SelfHostPlannedValueShape::NeverPlannedValueShape
    _ => SelfHostPlannedValueShape::UnitPlannedValueShape
  }
}

fn self_host_linked_recovered_expression_shape(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let planned = module_.expressions[expression]
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut relative = 0u32
      let _ = while relative {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = module_.locals[local_index]
            if self_host_u32_equal(local.local_id, local_id) {
              if local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                return self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  local.type_,
                )
              }
              return local.shape
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_if_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expected_result_shape: SelfHostPlannedValueShape,
  expression: U32,
  planned: SelfHostPlannedExpression,
  then_block: U32,
  else_expression: U32,
) -> SelfHostPlannedValueShape {
  if !planned.flow.falls_through && !self_host_linked_expression_is_let_value(
    module_,
    body,
    expression,
  ) {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let inferred_result_shape = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    planned.type_,
  )
  let let_value_shape = self_host_linked_let_value_shape(
    module_,
    body,
    expression,
  )
  let fallback = match let_value_shape {
    Option::Some(shape) => shape
    Option::None => if !(inferred_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
      inferred_result_shape
    } else if body.result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    expected_result_shape
    } else {
      body.result_shape
    }
  }
  let planned_then_shape = self_host_linked_block_result_shape(
    module_,
    then_block,
  )
  let then_shape = if then_block < module_.blocks.length() && self_host_u32_greater(
    module_.blocks[then_block].items.length,
    0u32,
  ) {
    let item_index = self_host_u32_add(
      module_.blocks[then_block].items.start,
      self_host_u32_subtract(module_.blocks[then_block].items.length, 1u32),
    )
    if item_index < module_.block_items.length() {
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => match self_host_linked_exact_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          value,
        ) {
          Option::Some(shape) => shape
          Option::None => if planned_then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            self_host_linked_backend_expression_shape(
              link,
              module_,
              body,
              caller_specialization,
              value,
            )
          } else {
            planned_then_shape
          }
        }
        SelfHostPlannedBlockItemKind::PlannedReturnItem(_) => SelfHostPlannedValueShape::NeverPlannedValueShape
        _ => planned_then_shape
      }
    } else {
      planned_then_shape
    }
  } else {
    planned_then_shape
  }
  let planned_else_shape = self_host_linked_recovered_expression_shape(
    module_,
    body,
    else_expression,
  )
  let else_shape = match self_host_linked_exact_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    else_expression,
  ) {
    Option::Some(shape) => shape
    Option::None => if planned_else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      self_host_linked_backend_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        else_expression,
      )
    } else {
      planned_else_shape
    }
  }
  if then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape &&
    else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    SelfHostPlannedValueShape::UnitPlannedValueShape
  } else if then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    if else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      else_shape
    }
  } else if else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    if then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      then_shape
    }
  } else if !(then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
    !(then_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
    !(then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
    self_host_linked_array_carrier_from_shape(then_shape) ==
      self_host_linked_array_carrier_from_shape(else_shape) {
    then_shape
  } else if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    planned.shape
  } else if then_shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
    else_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
    SelfHostPlannedValueShape::UnitPlannedValueShape
  } else if then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    if else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      else_shape
    }
  } else {
    then_shape
  }
}

fn self_host_linked_i32_schedule_expression(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  expression: U32,
  instructions: StarshineRef45,
  depth: U32,
) -> Unit {
  if expression < depths.length() {
    depths[expression] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
    expression,
    instructions,
  ))
}

fn self_host_linked_i32_schedule_block(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  block: U32,
  instructions: StarshineRef45,
  depth: U32,
) -> Unit {
  if block < depths.length() {
    depths[block] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
    block,
    instructions,
  ))
}

fn self_host_linked_i32_loop_link(
  links: Array<SelfHostLinkedI32LoopLink>,
  control: U32,
) -> Option<SelfHostLinkedI32LoopLink> {
  for link in links {
    if self_host_u32_equal(link.control, control) {
      return Option::Some(link)
    }
  }
  Option::None
}

fn self_host_linked_struct_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, owner) {
      let module_ = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        module_,
        linked_type.fragment_index,
      )
      match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(candidate) => if self_host_u64_equal(
          candidate,
          declaration,
        ) {
          return Option::Some(linked_type.type_index)
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_variant_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  variant: U64,
) -> Option<U32> {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(
    variant,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, owner) {
      let module_ = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        module_,
        linked_type.fragment_index,
      )
      match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
          _,
          candidate,
          _,
        ) => if self_host_u64_equal(candidate, variant) {
          return Option::Some(linked_type.type_index)
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_static_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression_index: U32,
) -> SelfHostPlannedValueShape {
  if expression_index >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let expression = module_.expressions[expression_index]
  if !(expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return expression.shape
  }
  let inferred = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    expression.type_,
  )
  if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return inferred
  }
  match expression.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => inferred
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        module_.expressions[base].nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => shape
          Option::None => inferred
        }
        Option::None => inferred
      }
    } else {
      inferred
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        module_.expressions[base].type_,
      ) {
        Option::Some(shape) => shape
        Option::None => inferred
      }
    } else {
      inferred
    }
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => SelfHostPlannedValueShape::RefPlannedValueShape
    _ => inferred
  }
}

fn self_host_linked_unresolved_method_call_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {

fn self_host_linked_is_body_result_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  let mut current_expression = expression
  let mut depth = 0u32
  let _ = while depth {
    current_depth => if current_depth < 8u32 {
      match body.root {
        SelfHostHirBodyRoot::ExpressionBodyRoot(root) => if self_host_u32_equal(
          root,
          current_expression,
        ) {
          return true
        }
        _ => {}
      }
      let mut direct_parent = 4294967295u32
      let mut direct_relative = 0u32
      let _ = while direct_relative {
        current => if current < body.expressions.length {
          let candidate = self_host_u32_add(body.expressions.start, current)
          if self_host_array_index_is_valid(
            candidate,
            module_.expressions.length(),
          ) {
            match module_.expressions[candidate].kind {
              SelfHostPlannedExpressionKind::PlannedIfExpression(
                _,
                _,
                else_expression,
              ) => if self_host_u32_equal(
                else_expression,
                current_expression,
              ) {
                direct_parent = candidate
              }
              _ => {}
            }
          }
          continue self_host_u32_add(current, 1u32)
        } else {
          break self_host_semantic_unit()
        }
      }
      if !self_host_u32_equal(direct_parent, 4294967295u32) {
        current_expression = direct_parent
        continue self_host_u32_add(current_depth, 1u32)
      }
      let mut containing_block = 4294967295u32
      let mut relative_block = 0u32
      let _ = while relative_block {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          if block_index < module_.blocks.length() {
            let block = module_.blocks[block_index]
            if self_host_u32_greater(block.items.length, 0u32) {
              let item_index = self_host_u32_subtract(
                self_host_u32_add(block.items.start, block.items.length),
                1u32,
              )
              if item_index < module_.block_items.length() {
                match module_.block_items[item_index].kind {
                  SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if self_host_u32_equal(
                    value,
                    current_expression,
                  ) {
                    containing_block = block_index
                  }
                  _ => {}
                }
              }
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_equal(containing_block, 4294967295u32) {
        return false
      }
      match body.root {
        SelfHostHirBodyRoot::BlockBodyRoot(root_block) => if self_host_u32_equal(
          root_block,
          containing_block,
        ) {
          return true
        }
        _ => {}
      }
      let mut parent = 4294967295u32
      let mut relative_expression = 0u32
      let _ = while relative_expression {
        current => if current < body.expressions.length {
          let candidate = self_host_u32_add(body.expressions.start, current)
          match module_.expressions[candidate].kind {
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => if self_host_u32_equal(
              block,
              containing_block,
            ) {
              parent = candidate
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              _,
              then_block,
              _,
            ) => if self_host_u32_equal(then_block, containing_block) {
              parent = candidate
            }
            _ => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_equal(parent, 4294967295u32) {
        return false
      }
      current_expression = parent
      continue current_depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}


        current_expression => if current_expression < self_host_linked_expression_count(module_) {
          let expression = self_host_linked_expression_at(
            module_,
            current_expression,
          )
          match expression.kind {
            SelfHostPlannedExpressionKind::PlannedFunctionValueCall(
              target,
              arguments,
              _,
            ) => if self_host_linked_function_value_signature(
              signatures,
              module_.module_id,
              current_expression,
            ) is Option::None {
              let direct_parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
              let entry_parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
              let direct_results = StarshineFfi.ffi_ffi_bridge_val_types_new()
              let entry_results = StarshineFfi.ffi_ffi_bridge_val_types_new()
              StarshineFfi.ffi_ffi_bridge_val_types_push(
                entry_parameters,
                self_host_linked_eqref_value_type(),
              )
              let target_signature = target < self_host_linked_expression_count(module_) &&
                self_host_linked_append_body_function_signature(
                  module_,
                  self_host_linked_expression_at(module_, target).type_,
                  direct_parameters,
                  entry_parameters,
                  direct_results,
                  entry_results,
                )
              if !target_signature {
                let mut argument = 0u32
                let _ = while argument {
                  current => if current < arguments.length {
                    let child_index = self_host_u32_add(arguments.start, current)
                    if child_index >= module_.expression_children.length() {
                      return Result::Err("linked function-value argument is outside its arena")
                    }
                    let child = module_.expression_children[child_index]
                    if child >= self_host_linked_expression_count(module_) {
                      return Result::Err("linked function-value argument expression is outside its arena")
                    }
                    let child_shape = self_host_linked_function_value_argument_shape(
                      link,
                      module_,
                      child,
                    )
                    self_host_linked_append_shape_value_types(
                      direct_parameters,
                      child_shape,
                    )
                    self_host_linked_append_shape_value_types(
                      entry_parameters,
                      child_shape,
                    )
                    continue current + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                let result_shape = self_host_linked_function_value_result_shape(
                  link,
                  module_,
                  current_expression,
                )
                self_host_linked_append_shape_value_types(
                  direct_results,
                  result_shape,
                )
                self_host_linked_append_shape_value_types(
                  entry_results,
                  result_shape,
                )
              }
              let direct_type = next_type
              self_host_linked_append_function_value_type(
                rec_types,
                direct_parameters,
                direct_results,
              )
              next_type = next_type + 1u32
              let entry_type = next_type
              self_host_linked_append_function_value_type(
                rec_types,
                entry_parameters,
                entry_results,
              )
              next_type = next_type + 1u32
              signatures.push(SelfHostLinkedFunctionValueSignature::{
                module_id: module_.module_id
                expression: current_expression
                direct_type_index: direct_type
                entry_type_index: entry_type
              })
            }
            _ => {}
          }
          continue current_expression + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}


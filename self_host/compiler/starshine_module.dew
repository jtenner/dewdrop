  Option::None
}

fn self_host_linked_argument_position(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
  expression: U32,
) -> I32 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < arguments.length {
      let index = self_host_u32_add(arguments.start, current)
      if index < module_.expression_children.length() && self_host_linked_expression_wraps_expression(
        module_,
        module_.expression_children[index],
        expression,
      ) {
        return self_host_u32_to_i32(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  -1i32
}




fn self_host_linked_callable_parameter_nominal_from_callable(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  position: U32,
  argument_count: U32,
) -> U64 {
  let exact_callable = self_host_planned_callable_identity(callable)
  let includes_receiver = exact_callable.has_receiver && self_host_u32_equal(
    argument_count,
    self_host_u32_add(exact_callable.parameters.length, 1u32),
  )
  if includes_receiver && self_host_u32_equal(position, 0u32) {
    return self_host_linked_resolved_nominal_declaration(
      module_,
      exact_callable.self_type,
    )
  }
  let parameter_position = if includes_receiver {
    self_host_u32_subtract(position, 1u32)
  } else {
    position
  }
  if parameter_position < exact_callable.parameters.length {
    let parameter_index = self_host_u32_add(
      exact_callable.parameters.start,
      parameter_position,
    )
    if parameter_index < module_.functions.parameters.length() {
      let parameter = self_host_planned_parameter_identity(
        module_.functions.parameters[parameter_index],
      )
      return self_host_linked_resolved_nominal_declaration(
        module_,
        parameter.type_,
      )
    }
  }
  0u64
}

fn self_host_linked_callable_parameter_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  position: U32,
  argument_count: U32,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let callable_module = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(
        callable_module,
        declaration,
      ) {
        Option::Some(callable) => {
          let nominal = self_host_linked_callable_parameter_nominal_from_callable(
            callable_module,
            callable,
            position,
            argument_count,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            return nominal
          }
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
  0u64
}


fn self_host_linked_canonical_parent_call_argument_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  match canonical {
    Option::Some(plan) => {
      let body_end = self_host_u32_add(
        body.expressions.start,
        body.expressions.length,
      )
      let mut parent = self_host_u32_add(expression, 1u32)
      let _ = while parent {
        parent_index => if parent_index < body_end &&
          parent_index < module_.expressions.length() {
          let parent_arguments = match module_.expressions[parent_index].kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              _,
              _,
              arguments,
              _,
            ) => Option::Some(arguments)
            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
              _,
              arguments,
            ) => Option::Some(arguments)
            _ => Option::None
          }
          match parent_arguments {
            Option::Some(arguments) => {
              let position = self_host_linked_argument_position(
                module_,
                arguments,
                expression,
              )
              if position >= 0i32 {
                match self_host_body_plan_expression(plan, parent_index) {
                  Option::Some(parent_plan) => if !self_host_u32_equal(
                    parent_plan.call_function_index,
                    4294967295u32,
                  ) {
                    let physical = self_host_linked_physical_function_index(
                      parent_plan.call_function_index,
                    )
                    let parameter_count = self_host_linked_physical_function_parameter_count(
                      link,
                      physical,
                    )
                    if parameter_count >= arguments.length {
                      return Option::Some(
                        self_host_linked_physical_function_parameter_shape(
                          link,
                          physical,
                          self_host_u32_add(
                            parameter_count - arguments.length,
                            self_host_i32_to_u32(position),
                          ),
                        ),
                      )
                    }
                  }
                  Option::None => {}
                }
              }
            }
            Option::None => {}
          }
          continue parent_index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    Option::None => {}
  }
  Option::None
}

fn self_host_linked_expression_expected_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  let body_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut parent = self_host_u32_add(expression, 1u32)
  let _ = while parent {
    parent_index => if parent_index < body_end {
      if parent_index < module_.expressions.length() {
        let parent = module_.expressions[parent_index]
        match parent.kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            arguments,
            _,
          ) => {
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 {
              match self_host_linked_i32_call_index(
                link,
                body.body,
                caller_specialization,
                parent_index,
                declaration,
              ) {
                Option::Some(function_index) => {
                  let parameter_count = self_host_linked_physical_function_parameter_count(
                    link,
                    function_index,
                  )
                  if parameter_count >= arguments.length {
                    return self_host_linked_physical_function_parameter_shape(
                      link,
                      function_index,
                      self_host_u32_add(
                        parameter_count - arguments.length,
                        self_host_i32_to_u32(position),
                      ),
                    )
                  }
                }
                Option::None => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target,
            arguments,
          ) => {
            if target < module_.expressions.length() {
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                  base,
                  _,
                ) => if self_host_u32_equal(base, expression) {
                  return SelfHostPlannedValueShape::RefPlannedValueShape
                }
                _ => {}
              }
            }
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 && target < module_.expressions.length() {
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                  receiver,
                  name,
                ) => if name < self_host_linked_module_name_count(module_) {
                  let method_name = self_host_linked_module_name_at(module_, name)
                  let owner = self_host_linked_expression_container_owner_module_id(
                    link,
                    module_,
                    body,
                    receiver,
                  )
                  let array_like = self_host_u64_equal(owner, link.array_module_id) ||
                    self_host_linked_expression_is_fixed_array_value(
                      link,
                      module_,
                      body,
                      receiver,
                    )
                  let explicit_position = self_host_i32_to_u32(position)
                  if array_like && (method_name == "get" || method_name == "get_unchecked" ||
                    method_name == "set" || method_name == "set_unchecked" ||
                    method_name == "insert") && self_host_u32_equal(
                    explicit_position,
                    0u32,
                  ) {
                    return SelfHostPlannedValueShape::I32PlannedValueShape
                  }
                  let receiver_argument = if self_host_u64_equal(owner, link.map_module_id) && (
                    method_name == "get" || method_name == "contains_key" ||
                    method_name == "remove" || method_name == "set" ||
                    method_name == "insert"
                  ) {
                    if self_host_u32_equal(explicit_position, 0u32) {
                      0u32
                    } else {
                      1u32
                    }
                  } else if array_like && ((method_name == "push" && self_host_u32_equal(
                    explicit_position,
                    0u32,
                  )) || ((method_name == "set" || method_name == "set_unchecked" ||
                    method_name == "insert") && self_host_u32_equal(
                    explicit_position,
                    1u32,
                  ))) {
                    0u32
                  } else {
                    4294967295u32
                  }
                  if !self_host_u32_equal(receiver_argument, 4294967295u32) {
                    match self_host_linked_unresolved_receiver_argument_shape(
                      link,
                      module_,
                      body,
                      parent_index,
                      receiver_argument,
                    ) {
                      Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                        shape is SelfHostPlannedValueShape::GenericPlannedValueShape
                      ) {
                        return shape
                      }
                      Option::None => {}
                    }
                    return SelfHostPlannedValueShape::ErrorPlannedValueShape
                  }
                }
                _ => {}
              }
              match self_host_linked_i32_call_index(
                link,
                body.body,
                caller_specialization,
                parent_index,
                0u64,
              ) {
                Option::Some(function_index) => {
                  let parameter_count = self_host_linked_physical_function_parameter_count(
                    link,
                    function_index,
                  )
                  if parameter_count >= arguments.length {
                    return self_host_linked_physical_function_parameter_shape(
                      link,
                      function_index,
                      self_host_u32_add(
                        parameter_count - arguments.length,
                        self_host_i32_to_u32(position),
                      ),
                    )
                  }
                }
                Option::None => {}
              }
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => if name < self_host_linked_module_name_count(
                  module_,
                ) {
                  match self_host_linked_method_call_index_for_receiver_arity(
                    link,
                    module_,
                    body,
                    receiver,
                    self_host_linked_module_name_at(module_, name),
                    arguments.length,
                  ) {
                    Option::Some(function_index) => {
                      let parameter_count = self_host_linked_physical_function_parameter_count(
                        link,
                        function_index,
                      )
                      if parameter_count >= arguments.length {
                        return self_host_linked_physical_function_parameter_shape(
                          link,
                          function_index,
                          self_host_u32_add(
                            parameter_count - arguments.length,
                            self_host_i32_to_u32(position),
                          ),
                        )
                      }
                    }
                    Option::None => {}
                  }
                }
                _ => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedIndexGet(
            _,
            index,
            _,
          ) => if self_host_u32_equal(index, expression) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          SelfHostPlannedExpressionKind::PlannedIndexSet(
            _,
            index,
            _,
            _,
          ) => if self_host_u32_equal(index, expression) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          SelfHostPlannedExpressionKind::PlannedConstruct(
            _,
            fields,
            _,
          ) => {
            let mut position = 0u32
            let _ = while position {
              current_field => if current_field < fields.length {
                let object_index = self_host_u32_add(fields.start, current_field)
                if object_index < module_.object_fields.length() {
                  let object_field = self_host_planned_object_field_at(
                    module_.object_fields,
                    object_index,
                  )
                  if self_host_u32_equal(object_field.value, expression) {
                    match self_host_linked_struct_field_shape(
                      link,
                      object_field.field,
                    ) {
                      Option::Some(shape) => {
                        return shape
                      }
                      Option::None => if self_host_u32_greater(
                        self_host_linked_module_name_count(module_),
                        object_field.name,
                      ) {
                        let field_name = self_host_linked_module_name_at(
                          module_,
                          object_field.name,
                        )
                        let selected_field = match self_host_linked_infer_constructor_type_index(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          parent.nominal,
                          fields,
                        ) {
                          Option::Some(type_index) => match self_host_linked_field_by_type_name(
                            link,
                            type_index,
                            field_name,
                          ) {
                            Option::Some(field_link) => Option::Some(field_link)
                            Option::None => self_host_linked_field_by_name(
                              link,
                              parent.nominal,
                              field_name,
                            )
                          }
                          Option::None => self_host_linked_field_by_name(
                            link,
                            parent.nominal,
                            field_name,
                          )
                        }
                        match selected_field {
                          Option::Some(field_link) => match self_host_linked_physical_field_shape(
                            link,
                            field_link.type_index,
                            field_link.field_index,
                          ) {
                            Option::Some(shape) => {
                              return shape
                            }
                            Option::None => {}
                          }
                          Option::None => {}
                        }
                      }
                    }
                  }
                }
                continue current_field + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedBinaryExpression(
            operator,
            left,
            right,
          ) => {
            let in_left = self_host_linked_expression_wraps_expression(
              module_,
              left,
              expression,
            )
            let in_right = self_host_linked_expression_wraps_expression(
              module_,
              right,
              expression,
            )
            if in_left || in_right {
              match operator {
                SelfHostHirBinaryOperator::LogicalOr => {
                  return SelfHostPlannedValueShape::I32PlannedValueShape
                }
                SelfHostHirBinaryOperator::LogicalAnd => {
                  return SelfHostPlannedValueShape::I32PlannedValueShape
                }
                _ => {}
              }
              let mut sibling = left
              if in_left {
                sibling = right
              }
              let sibling_shape = self_host_linked_recovered_expression_shape(
                module_,
                body,
                sibling,
              )
              if !(sibling_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                sibling_shape is SelfHostPlannedValueShape::GenericPlannedValueShape
              ) && !(sibling_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) && !(
                sibling_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
              ) {
                return sibling_shape
              }
              match operator {
                SelfHostHirBinaryOperator::Equal => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                SelfHostHirBinaryOperator::NotEqual => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                SelfHostHirBinaryOperator::Less => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                SelfHostHirBinaryOperator::LessEqual => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                SelfHostHirBinaryOperator::Greater => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                SelfHostHirBinaryOperator::GreaterEqual => {
                  return SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
                _ => {
                  let result_shape = self_host_linked_recovered_expression_shape(
                    module_,
                    body,
                    parent_index,
                  )
                  if !(result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                    result_shape is SelfHostPlannedValueShape::GenericPlannedValueShape
                  ) {
                    return result_shape
                  }
                }
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedOperatorCall(
            declaration,
            _,
            left,
            right,
            _,
          ) => if self_host_linked_expression_wraps_expression(
            module_,
            left,
            expression,
          ) || self_host_linked_expression_wraps_expression(
            module_,
            right,
            expression,
          ) {
            match self_host_linked_i32_call_index(
              link,
              body.body,
              caller_specialization,
              parent_index,
              declaration,
            ) {
              Option::Some(function_index) => {
                let parameter = if self_host_linked_expression_wraps_expression(
                  module_,
                  left,
                  expression,
                ) {
                  0u32
                } else {
                  1u32
                }
                return self_host_linked_physical_function_parameter_shape(
                  link,
                  function_index,
                  parameter,
                )
              }
              Option::None => return SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
          }
          _ => {}
        }
      }
      continue parent_index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  let mut selected_shape = SelfHostPlannedValueShape::ErrorPlannedValueShape
                  let mut relative_use = 0u32
                  let _ = while relative_use {
                    current_use => if current_use < body.expressions.length {
                      let use_expression = self_host_u32_add(
                        body.expressions.start,
                        current_use,
                      )
                      if use_expression < module_.expressions.length() {
                        match module_.expressions[use_expression].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(
                            candidate,
                          ) => if self_host_u32_equal(candidate, local_id) {
                            let shape = self_host_linked_expression_expected_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              use_expression,
                            )
                            if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                              if self_host_physical_scalar_shape(
                                shape,
                              ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                                return shape
                              }
                              if selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                                selected_shape = shape
                              }
                            }
                          }
                          _ => {}
                        }
                      }
                      continue current_use + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                  if !(selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return selected_shape
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_backend_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = module_.expressions[expression]
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(
      operator,
      left,
      _,
    ) => match operator {
      SelfHostHirBinaryOperator::LogicalOr => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::LogicalAnd => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Equal => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::NotEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Less => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::LessEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Greater => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::GreaterEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      _ => {
        let shape = self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          left,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        self_host_planned_expression_at(module_.expressions, base).type_,
      ) {
        Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
        Option::None => match self_host_linked_expression_container_element_shape(
          link,
          module_,
          body,
          base,
        ) {
          Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return shape
          }
          Option::None => {}
        }
      }
    }
    _ => {}
  }
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    if self_host_linked_expression_is_let_value(module_, body, expression) {
      let contextual = self_host_linked_expression_expected_shape(
        link,
        module_,
        body,
        caller_specialization,
        expression,
      )
      if !(contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
        !(contextual is SelfHostPlannedValueShape::UnitPlannedValueShape) {
        return contextual
      }
    }
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => {
        return shape
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        module_.expressions[base].nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => {
            return shape
          }
          Option::None => {}
        }
        Option::None => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      expression,
      declaration,
    ) {
      Option::Some(function_index) => {
        let shape = self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
      match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        0u64,
      ) {
        Option::Some(function_index) => {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return shape
          }
        }
        Option::None => if target < module_.expressions.length() {
          let source_name = module_.expressions[target].source_name
          if self_host_u32_greater(
            self_host_linked_module_name_count(module_),
            source_name,
          ) {
            let name = self_host_linked_module_name_at(module_, source_name)
            if name == "new" || name == "with_capacity" || name == "make" ||
              name == "empty" {
              return SelfHostPlannedValueShape::RefPlannedValueShape
            }
          }
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if target < module_.expressions.length() {
      let mut callable_target = target
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          callable_target = operand
        }
        _ => {}
      }
      if callable_target < module_.expressions.length() {
        let source_name = module_.expressions[callable_target].source_name
        if source_name < self_host_linked_module_name_count(module_) {
          match self_host_linked_callable_by_name(
            link,
            self_host_linked_module_name_at(module_, source_name),
          ) {
            Option::Some(callable) => match self_host_linked_callable_function_index(
              link,
              callable.declaration,
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
            Option::None => {}
          }
        }
      }
    }
    _ => {}
  }
  let contextual_shape = self_host_linked_expression_expected_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
  if !(contextual_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return contextual_shape
  }
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, body.body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      for function_ in link.functions {
        if self_host_u32_equal(function_.function_index, call.function_index) {
          let fragment_module = link.fragments.modules[function_.module_index]
          let fragment = self_host_program_link_fragment_function(
            fragment_module,
            function_.fragment_index,
          )
          return self_host_linked_specialized_function_result_shape(
            link,
            function_,
            fragment_module,
            fragment,
          )
        }
      }
    }
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => SelfHostPlannedValueShape::I8PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => SelfHostPlannedValueShape::I16PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => SelfHostPlannedValueShape::U8PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => SelfHostPlannedValueShape::U16PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => SelfHostPlannedValueShape::U32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => SelfHostPlannedValueShape::U64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut relative = 0u32
      let _ = while relative {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = self_host_body_planned_local_identity(module_.locals[local_index])
            if self_host_u32_equal(local.local_id, local_id) {
              match self_host_linked_loop_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              if !(local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return local.shape
              }
              let inferred = self_host_planned_merged_body_value_shape(
                module_.resolved_types,
                module_.inferred,
                local.type_,
              )
              if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return inferred
              }
              match self_host_linked_local_initializer_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              match self_host_linked_local_assignment_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              match self_host_linked_loop_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              return SelfHostPlannedValueShape::I32PlannedValueShape
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      SelfHostPlannedValueShape::I32PlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          let method_name = self_host_linked_module_name_at(module_, name)
          if method_name == "get_unchecked" {
            let contextual = self_host_linked_expression_expected_shape(
              link,
              module_,
              body,
              caller_specialization,
              expression,
            )
            if !(contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
              return contextual
            }
            if self_host_u64_equal(module_.expressions[base].nominal, 0u64) {
              return SelfHostPlannedValueShape::I32PlannedValueShape
            }
            SelfHostPlannedValueShape::ErrorPlannedValueShape
          } else {
            match self_host_linked_method_call_index(link, method_name) {
              Option::Some(function_index) => self_host_linked_physical_function_result_shape(
                link,
                function_index,
              )
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
          }
        } else {
          SelfHostPlannedValueShape::ErrorPlannedValueShape
        }
        _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
      }
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        self_host_planned_expression_at(module_.expressions, base).type_,
      ) {
        Option::Some(shape) => shape
        Option::None => match self_host_linked_expression_container_element_shape(
          link,
          module_,
          body,
          base,
        ) {
          Option::Some(shape) => shape
          Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
        }
      }
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_callable_function_index(link, declaration) {
      Option::Some(function_index) => self_host_linked_physical_function_result_shape(
        link,
        function_index,
      )
      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_local_initializer_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(candidate, local_id) {
                  let shape = if value < module_.expressions.length() {
                    let planned_value = module_.expressions[value]
                    match planned_value.kind {
                      SelfHostPlannedExpressionKind::PlannedIfExpression(
                        _,
                        then_block,
                        else_expression,
                      ) => self_host_linked_if_result_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        body.result_shape,
                        value,
                        planned_value,
                        then_block,
                        else_expression,
                      )
                      SelfHostPlannedExpressionKind::PlannedMatchExpression(
                        _,
                        arms,
                      ) => match self_host_linked_match_fallthrough_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arms,
                      ) {
                        Option::Some(result_shape) => result_shape
                        Option::None => self_host_linked_backend_expression_shape(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          value,
                        )
                      }
                      SelfHostPlannedExpressionKind::PlannedProductField(
                        base,
                        field,
                        _,
                      ) => match self_host_linked_product_field_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        base,
                        field,
                      ) {
                        Option::Some(field_shape) => field_shape
                        Option::None => self_host_linked_backend_expression_shape(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          value,
                        )
                      }
                      _ => self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        value,
                      )
                    }
                  } else {
                    SelfHostPlannedValueShape::ErrorPlannedValueShape
                  }
                  if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return Option::Some(shape)
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_assignment_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalSet(candidate, value) => if self_host_u32_equal(
          candidate,
          local_id,
        ) {
          let shape = self_host_linked_backend_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            value,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(shape)
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_match_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut selected_shape = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(value, arms) => {
          let contextual_payload_hint = SelfHostPlannedValueShape::ErrorPlannedValueShape
          let map_payload_hint = self_host_linked_map_get_value_shape(
            link,
            module_,
            body,
            value,
          )
          let fallback_payload_hint = match map_payload_hint {
            Option::Some(shape) => shape
            Option::None => match self_host_linked_expression_container_element_shape(
              link,
              module_,
              body,
              value,
            ) {
              Option::Some(shape) => shape
              Option::None => match if value < module_.expressions.length() {
                match self_host_linked_type_first_argument_shape(
                  module_,
                  self_host_planned_expression_at(module_.expressions, value).type_,
                ) {
                  Option::Some(shape) => Option::Some(shape)
                  Option::None => match module_.expressions[value].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(subject_local) => self_host_linked_local_first_type_argument_shape(
                      module_,
                      body,
                      subject_local,
                    )
                    _ => Option::None
                  }
                }
              } else {
                Option::None
              } {
                Option::Some(shape) => shape
                Option::None => match self_host_linked_match_binding_use_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => match self_host_physical_scalar_shape(
                    contextual_payload_hint,
                  ) {
                    SelfHostPlannedValueShape::I32PlannedValueShape => contextual_payload_hint
                    SelfHostPlannedValueShape::I64PlannedValueShape => contextual_payload_hint
                    SelfHostPlannedValueShape::F32PlannedValueShape => contextual_payload_hint
                    SelfHostPlannedValueShape::F64PlannedValueShape => contextual_payload_hint
                    SelfHostPlannedValueShape::V128PlannedValueShape => contextual_payload_hint
                    _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
                  }
                }
              }
            }
          }
          let inferred_payload_hint = match map_payload_hint {
            // Map.get binds V. Its receiver's first argument is K, so it must
            // not replace the exact Map value shape.
            Option::Some(_) => fallback_payload_hint
            Option::None => match self_host_linked_match_subject_receiver_element_shape(
              link,
              module_,
              body,
              value,
            ) {
              Option::Some(shape) => shape
              Option::None => fallback_payload_hint
            }
          }
          let payload_hint = inferred_payload_hint
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                  local_id,
                ) {
                  let root_pattern_index = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                  if root_pattern_index < module_.patterns.length() {
                    let root_pattern = self_host_planned_pattern_at(module_.patterns, root_pattern_index)
                    match root_pattern.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root_pattern,
                        payload_hint,
                        self_host_linked_match_subject_nominal_declaration(
                          link,
                          module_,
                          body,
                          value,
                        ),
                      ) {
                        Option::Some(type_index) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[child_index]
                                if child_pattern_index < module_.patterns.length() {
                                  match self_host_planned_pattern_at(module_.patterns, child_pattern_index).reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(candidate, local_id) {
                                      match self_host_linked_physical_field_shape(
                                        link,
                                        type_index,
                                        current_child,
                                      ) {
                                        Option::Some(field_shape) => if self_host_physical_scalar_shape(
                                          field_shape,
                                        ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                                          return Option::Some(field_shape)
                                        } else if selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                                          selected_shape = field_shape
                                        }
                                        Option::None => {}
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[child_index]
                                if child_pattern_index < module_.patterns.length() {
                                  match self_host_planned_pattern_at(module_.patterns, child_pattern_index).reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(candidate, local_id) && !(
                                      payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape
                                    ) {
                                      if self_host_physical_scalar_shape(
                                        payload_hint,
                                      ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                                        return Option::Some(payload_hint)
                                      }
                                      if selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                                        selected_shape = payload_hint
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                      }
                      _ => {}
                    }
                    match root_pattern.source {
                      SelfHostHirPattern::TuplePattern(_, _, _) => {
                        continue position + 1u32
                      }
                      _ => {}
                    }
                  }
                  let shape = match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    value,
                  ) {
                    Option::Some(result_shape) => result_shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      value,
                    )
                  }
                  if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    if self_host_physical_scalar_shape(
                      shape,
                    ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                      return Option::Some(shape)
                    }
                    if selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                      selected_shape = shape
                    }
                  } else {
                    return Option::Some(
                      SelfHostPlannedValueShape::RefPlannedValueShape,
                    )
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    Option::None
  } else {
    Option::Some(selected_shape)
  }
}



fn self_host_linked_loop_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, arms) => {
          let payload_hint = match self_host_linked_iterator_next_element_shape(
            link,
            module_,
            body,
            initial,
          ) {
            Option::Some(shape) => shape
            Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                  local_id,
                ) {
                  let root_pattern_index = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                  if root_pattern_index < module_.patterns.length() {
                    let root_pattern = self_host_planned_pattern_at(module_.patterns, root_pattern_index)
                    match root_pattern.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root_pattern,
                        payload_hint,
                        0u64,
                      ) {
                        Option::Some(type_index) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[child_index]
                                if child_pattern_index < module_.patterns.length() {
                                  match self_host_planned_pattern_at(module_.patterns, child_pattern_index).reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(candidate, local_id) {
                                      if !(payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                        return Option::Some(payload_hint)
                                      }
                                      match self_host_linked_physical_field_shape(
                                        link,
                                        type_index,
                                        current_child,
                                      ) {
                                        Option::Some(field_shape) => {
                                          return Option::Some(field_shape)
                                        }
                                        Option::None => {}
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                  if initial < module_.expressions.length() {
                    let shape = self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      initial,
                    )
                    if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                      return Option::Some(shape)
                    }
                  }
                  return Option::Some(
                    SelfHostPlannedValueShape::RefPlannedValueShape,
                  )
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}





fn self_host_linked_starshine_validation_error(
  link: SelfHostPlannedProgramWasmGCLink,
) -> String {
  let message = StringBuilder::new()
  message.append(self_host_starshine_validation_error(
    "Starshine rejected the linked self-host output module",
  ))
  let emitted = StarshineFfi.ffi_ffi_bridge_validation_error_function_index()
  if emitted >= 0i32 {
    let logical = self_host_i32_to_u32(emitted)
    let physical = self_host_linked_physical_function_index(logical)
    message.append(" linked_function=")
    message.append_u32(logical)
    message.append(" name=")
    message.append(bytes_to_string(
      self_host_linked_physical_function_name(link, physical),
    ))
    message.append(" module=")
    message.append_u64(self_host_linked_physical_function_module_id(
      link,
      physical,
    ))
    for function_ in link.functions {
      if self_host_u32_equal(function_.function_index, logical) {
        message.append(" declaration=")
        message.append_u64(function_.declaration)
        message.append(" specialization=")
        message.append_u32(function_.specialization)
      }
    }
  }
  message.finish()
}

fn self_host_encode_linked_i32_module(
  module_: StarshineModule,
  link: SelfHostPlannedProgramWasmGCLink,
) -> Result<Bytes, String> {
  let fact_module = StarshineFfi.ffi_ffi_bridge_module_with_dewdrop_compiler_facts(
    module_,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(fact_module) == 0i32 {
    Result::Err(self_host_linked_starshine_validation_error(link))
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(fact_module)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the linked self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => {
          self_host_append_linked_function_names(output, link)
          break Result::Ok(output.finish())
        }
      }
    }
  }
}

fn self_host_linked_append_import_name(
  builder: StarshineImportBuilder,
  value: Bytes,
  module_name: Bool,
) -> Unit {
  let _ = while 0u32 {
    index => if index < value.byte_length() {
      let byte = u8_into_i32(value.byte_at(index))
      if module_name {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_module_byte(
          builder,
          byte,
        )
      } else {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_field_byte(
          builder,
          byte,
        )
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}





fn self_host_linked_emitted_local_carrier_error(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  local_id: U32,
  expression: U32,
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> String {
  let message = StringBuilder::new()
  message.append("emitted local carrier mismatch module=")
  message.append_u64(plan.module_id)
  message.append(" declaration=")
  message.append_u64(plan.declaration)
  message.append(" name=")
  message.append(bytes_to_string(self_host_linked_declaration_name(
    link,
    plan.declaration,
  )))
  message.append(" body=")
  message.append_u64(plan.body)
  message.append(" specialization=")
  message.append_u32(plan.specialization)
  message.append(" local=")
  message.append_u32(local_id)
  message.append(" expression=")
  message.append_u32(expression)
  if expression < module_.expressions.length() {
    message.append(":")
    message.append(self_host_body_expression_kind_name(
      module_.expressions[expression].kind,
    ))
  }
  message.append(" expected=")
  message.append(self_host_body_carrier_name(expected))
  message.append(" actual=")
  message.append(self_host_body_carrier_name(actual))
  message.finish()
}

fn self_host_linked_emitted_local_carriers_match(
  expected: SelfHostWasmBodyCarrier,
  actual: SelfHostWasmBodyCarrier,
) -> Bool {
  expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    actual is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
    actual is SelfHostWasmBodyCarrier::NeverBodyCarrier ||
    self_host_body_carrier_equal(expected, actual)
}


fn self_host_validate_emitted_local_carriers(
  link: SelfHostPlannedProgramWasmGCLink,
  body_plan: SelfHostPlannedProgramWasmBodyPlan,
) -> Option<String> {
  for plan in body_plan.bodies {
    if plan.module_index < link.fragments.specialization.lowering.modules.length() {
      let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
      match self_host_body_lookup_for_plan(module_, plan) {
        Option::Some(body) => {
          for expression_plan in plan.expressions {
            match module_.expressions[expression_plan.expression].kind {
              SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => {
                let slot = self_host_body_local_slot(module_, body, local_id)
                if slot < plan.local_values.length() {
                  let expected = plan.local_values[slot].carrier
                  let actual = self_host_linked_exact_emitted_expression_carrier(
                    Option::Some(plan),
                    link,
                    module_,
                    body,
                    plan.specialization,
                    value,
                  )
                  if !self_host_linked_emitted_local_carriers_match(
                    expected,
                    actual,
                  ) {
                    // Local emission must use the carrier that body planning certified.
                    return Option::Some(self_host_linked_emitted_local_carrier_error(
                      link,
                      plan,
                      module_,
                      local_id,
                      value,
                      expected,
                      actual,
                    ))
                  }
                }
              }
              _ => {}
            }
          }
          let mut block_offset = 0u32
          let _ = while block_offset {
            current_block => if current_block < body.blocks.length {
              let block_index = self_host_u32_add(
                body.blocks.start,
                current_block,
              )
              if block_index < module_.blocks.length() {
                let items = module_.blocks[block_index].items
                let mut item_offset = 0u32
                let _ = while item_offset {
                  current_item => if current_item < items.length {
                    let item_index = self_host_u32_add(items.start, current_item)
                    if item_index < module_.block_items.length() {
                      match module_.block_items[item_index].kind {
                        SelfHostPlannedBlockItemKind::PlannedLetItem(
                          local_id,
                          _,
                          initializer,
                        ) => {
                          let slot = self_host_body_local_slot(
                            module_,
                            body,
                            local_id,
                          )
                          if slot < plan.local_values.length() {
                            let expected = plan.local_values[slot].carrier
                            let actual = self_host_linked_exact_emitted_expression_carrier(
                              Option::Some(plan),
                              link,
                              module_,
                              body,
                              plan.specialization,
                              initializer,
                            )
                            if !self_host_linked_emitted_local_carriers_match(
                              expected,
                              actual,
                            ) {
                              // A let initializer must fit its certified physical local.
                              return Option::Some(self_host_linked_emitted_local_carrier_error(
                                link,
                                plan,
                                module_,
                                local_id,
                                initializer,
                                expected,
                                actual,
                              ))
                            }
                          }
                        }
                        _ => {}
                      }
                    }
                    continue current_item + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              continue current_block + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        Option::None => {}
      }
    }
  }
  Option::None
}

fn build_self_host_linked_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<Bytes, String> {
  self_host_assert_program_capture_metadata(link.fragments.specialization.lowering, 7u32)
  let body_plan = self_host_plan_program_wasm_bodies(link)
  if self_host_u32_greater(body_plan.diagnostics.length(), 0u32) {
    return Result::Err(
      self_host_program_wasm_body_failure_report(link, body_plan),
    )
  }
  self_host_assert_frozen_body_plan(body_plan)
  let root_function_candidate = self_host_linked_i32_main_function_index(
    link,
    root_module,
  )
  let root_function_index = if root_function_candidate == 4294967295u32 {
    return Result::Err("linked root function must exist before module emission")
  } else {
    root_function_candidate
  }
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
      let function_value_signatures = []
      let physical_type_error = self_host_linked_append_physical_types(
        link,
        rec_types,
      )
      match physical_type_error {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let imports = StarshineFfi.ffi_ffi_bridge_imports_new()
      let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
      let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
      let globals = StarshineFfi.ffi_ffi_bridge_global_builder_new()
      let function_references = StarshineFfi.ffi_ffi_bridge_function_reference_builder_new()
      let mut linked_function_emit_index = 0u32
      let _ = while linked_function_emit_index {
        current => if current < link.functions.length() {
          let linked_function = self_host_planned_program_wasm_function_identity(
            link.functions[current],
          )
        let fragment_module = link.fragments.modules[linked_function.module_index]
        if !self_host_u32_greater(
          fragment_module.functions.length(),
          linked_function.fragment_index,
        ) {
          return Result::Err("linked I32 function fragment is outside its arena")
        }
        let fragment = fragment_module.functions[linked_function.fragment_index]
        let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
        let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.parameters,
          parameters,
        ) {
          return Result::Err("linked function parameters are outside the emitter subset")
        }
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.results,
          results,
        ) {
          return Result::Err("linked function results are outside the emitter subset")
        }
        let function_type = StarshineFfi.ffi_lib_CompType_func(
          parameters,
          results,
        )
        let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
          function_type,
          wasm_ref_null(),
        )
        StarshineFfi.ffi_ffi_bridge_rec_types_push(
          rec_types,
          StarshineFfi.ffi_lib_RecType_new(subtype),
        )
        let function_type_index = self_host_u32_add(
          link.types.length(),
          linked_function.function_index,
        )
        StarshineFfi.ffi_ffi_bridge_FunctionReferenceBuilder_push(
          function_references,
          self_host_u32_to_i32(
            self_host_linked_emitted_function_index(
              self_host_linked_physical_function_index(
                linked_function.function_index,
              ),
            ),
          ),
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(
            library,
            field,
          ) => {
            let builder = StarshineFfi.ffi_ffi_bridge_import_builder_new(
              self_host_u32_to_i32(function_type_index),
            )
            self_host_linked_append_import_name(builder, library, true)
            self_host_linked_append_import_name(builder, field, false)
            StarshineFfi.ffi_ffi_bridge_imports_push_builder(
              imports,
              builder,
            )
          }
          _ => StarshineFfi.ffi_ffi_bridge_type_indices_push(
            type_indices,
            StarshineFfi.ffi_lib_TypeIdx_new(
              self_host_u32_to_i32(function_type_index),
            ),
          )
        }
                continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_linked_append_text_runtime_types(link, rec_types)
      self_host_linked_append_array_runtime_types(link, rec_types)
      self_host_linked_append_erased_field_box_types(rec_types)
      self_host_append_packed_array_types(rec_types)
      let function_value_signature_error = self_host_linked_append_function_value_signatures(
        link,
        rec_types,
        function_value_signatures,
      )
      match function_value_signature_error {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let initializer_type_index = self_host_linked_function_value_type_base(link) +
        function_value_signatures.length() * 2u32
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        self_host_linked_append_function_value_type(
          rec_types,
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
        )
        let mut initializer_signature = 0u32
        let _ = while initializer_signature {
          current => if current < link.initializers.length() + 1u32 {
            StarshineFfi.ffi_ffi_bridge_type_indices_push(
              type_indices,
              StarshineFfi.ffi_lib_TypeIdx_new(
                self_host_u32_to_i32(initializer_type_index),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let mut initializer_emit_index = 0u32
        let _ = while initializer_emit_index {
          current => if current < link.initializers.length() {
            let initializer = self_host_planned_program_initializer_identity(
              link.initializers[current],
            )
          if self_host_initializer_has_storage(initializer.shape) {
            StarshineFfi.ffi_ffi_bridge_GlobalBuilder_push(
              globals,
              self_host_linked_array_carrier_from_shape(initializer.shape),
            )
          }
                    continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      let mut body_emit_function_index = 0u32
      let _ = while body_emit_function_index {
        current => if current < link.functions.length() {
          let linked_function = self_host_planned_program_wasm_function_identity(
            link.functions[current],
          )
        let canonical_body_plan = self_host_program_wasm_body_plan_for_function(
          body_plan,
          self_host_linked_physical_function_index(linked_function.function_index),
        )
        let fragment_module = link.fragments.modules[linked_function.module_index]
        let fragment = self_host_program_link_fragment_function(
          fragment_module,
          linked_function.fragment_index,
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body_id) => {
            let lowering_module = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
            let body = match self_host_linked_i32_body(lowering_module, body_id) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked function body is missing")
              }
            }
            let result_shape = self_host_linked_specialized_function_result_shape(
              link,
              linked_function,
              fragment_module,
              fragment,
            )
            // Allocate locals from the frozen plan before emitting instructions.
            let locals = match self_host_linked_scalar_locals(
              link,
              canonical_body_plan,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              canonical_body_plan,
              function_value_signatures,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
              instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(_, _) => {}
          SelfHostPlannedWasmFunctionKind::PlannedWasmOutlinedBuiltinFunction(name) => {
            match self_host_append_outlined_builtin(fragment_module, fragment, name, functions) {
              Option::Some(error) => return Result::Err(error)
              Option::None => {}
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmOutlinedHeapFunction(recipe) => {
            match self_host_append_outlined_raw_heap_instruction(link, fragment_module, fragment, recipe, functions) {
              Option::Some(error) => return Result::Err(error)
              Option::None => {}
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmInlineHeapFunction(_) => return Result::Err("inline heap instruction cannot occupy a physical function slot")
          SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(name) => {
            if !self_host_linked_append_runtime_function(
              link,
              functions,
              name,
            ) {
              return Result::Err(bytes_to_string(name))
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
            lambda_id,
          ) => {
            let lowering_module = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
            let body = match self_host_linked_lambda_body(
              lowering_module,
              lambda_id,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked lambda function body is missing")
              }
            }
            let result_shape = self_host_linked_specialized_function_result_shape(
              link,
              linked_function,
              fragment_module,
              fragment,
            )
            let locals = match self_host_linked_scalar_locals(
              link,
              canonical_body_plan,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              canonical_body_plan,
              function_value_signatures,
              lowering_module,
              body,
              result_shape,
              linked_function.specialization,
              instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction => {
            return Result::Err("linked signature-only function was assigned a physical function")
          }
        }
                continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        let mut initializer_position = 0u32
        let _ = while initializer_position {
          current => if current < link.initializers.length() {
            let initializer = link.initializers[current]
            let lowering_module = self_host_linked_lowering_module_at(
              link,
              initializer.module_index,
            )
            let body = match self_host_linked_i32_body(
              lowering_module,
              initializer.body,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked initializer body is missing")
              }
            }
            let initializer_locals = match self_host_linked_scalar_locals(
              link,
              self_host_program_wasm_body_plan_for_identity(body_plan, lowering_module.module_id, body.body, 4294967295u32),
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            let initializer_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              self_host_program_wasm_body_plan_for_identity(body_plan, lowering_module.module_id, body.body, 4294967295u32),
              function_value_signatures,
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
              initializer_instructions,
            ) {
              Option::Some(error) => {
                return Result::Err(error)
              }
              Option::None => {}
            }
            if self_host_initializer_has_storage(initializer.shape) {
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                initializer_instructions,
                StarshineFfi.ffi_lib_Instruction_global_set(
                  StarshineFfi.ffi_lib_GlobalIdx_new(
                    self_host_u32_to_i32(initializer.global_index),
                  ),
                ),
              )
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                initializer_locals,
                StarshineFfi.ffi_lib_Expr_new(initializer_instructions),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let start_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
        let mut start_call = 0u32
        let _ = while start_call {
          current => if current < link.initializers.length() {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              start_instructions,
              StarshineFfi.ffi_lib_Instruction_call(
                StarshineFfi.ffi_lib_FuncIdx_new(
                  self_host_u32_to_i32(
                    link.functions.length() + current,
                  ),
                ),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        StarshineFfi.ffi_ffi_bridge_funcs_push(
          functions,
          StarshineFfi.ffi_lib_Func_new(
            StarshineFfi.ffi_lib_Locals_empty(),
            StarshineFfi.ffi_lib_Expr_new(start_instructions),
          ),
        )
      }
      // Emission must not change any verified body fact or operand recipe.
      self_host_assert_frozen_body_plan(body_plan)
      match self_host_validate_emitted_local_carriers(link, body_plan) {
        Option::Some(error) => return Result::Err(error)
        Option::None => {}
      }
      let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
      let import_section = StarshineFfi.ffi_lib_ImportSec_new(imports)
      let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
      let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
      let typed_module = StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      )
      let imported_module = StarshineFfi.ffi_lib_Module_with_import_sec(
        typed_module,
        import_section,
      )
      let coded_module = StarshineFfi.ffi_lib_Module_with_code_sec(
        StarshineFfi.ffi_lib_Module_with_func_sec(
          imported_module,
          function_section,
        ),
        code_section,
      )
      let global_module = StarshineFfi.ffi_ffi_bridge_module_with_globals(
        StarshineFfi.ffi_ffi_bridge_module_with_default_memory(coded_module),
        globals,
      )
      let started_module = if self_host_u32_greater(
        link.initializers.length(),
        0u32,
      ) {
        StarshineFfi.ffi_ffi_bridge_module_with_start_function(
          global_module,
          self_host_u32_to_i32(
            link.functions.length() + link.initializers.length(),
          ),
        )
      } else {
        global_module
      }
      self_host_encode_linked_i32_module(
        StarshineFfi.ffi_ffi_bridge_module_with_declarative_functions(
          StarshineFfi.ffi_ffi_bridge_module_with_compiler_exports(
            started_module,
            self_host_u32_to_i32(root_function_index),
          ),
          function_references,
        ),
        link,
      )
}

pub fn build_self_host_linked_root_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_index: U32,
) -> Result<Bytes, String> {
  let modules = link.fragments.specialization.lowering.modules
  if root_index >= modules.length() {
    let message = StringBuilder::new()
    message.append("linked root module index is outside its arena index=")
    message.append_u32(root_index)
    message.append(" modules=")
    message.append_u32(modules.length())
    Result::Err(message.finish())
  } else {
    build_self_host_linked_i32_module(link, modules[root_index].module_id)
  }
}

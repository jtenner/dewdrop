        SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
          arms,
          subject,
          arm_offset,
          scratch,
          destination,
          depth,
          result_shape,
          payload_hint,
          logical_result_shape,
        ) => {
          if arm_offset >= arms.length {
            return Option::Some("linked I32 match has no remaining arm")
          }
          let child_index = self_host_u32_add(arms.start, arm_offset)
          if child_index >= module_.arm_children.length() {
            return Option::Some("linked I32 match arm is outside its child arena")
          }
          let arm_index = module_.arm_children[child_index]
          if arm_index >= module_.pattern_arms.length() {
            return Option::Some("linked I32 match arm is outside its arena")
          }
          let arm = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          match self_host_linked_canonical_expression_shape(
            canonical_body_plan,
            arm.body,
          ) {
            Option::Some(arm_shape) => if !(arm_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
              arm_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
            ) && !(logical_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
              logical_result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
            ) && self_host_linked_array_carrier_from_shape(arm_shape) !=
              self_host_linked_array_carrier_from_shape(logical_result_shape) {
              let message = StringBuilder::new()
              message.append("linked match arm result invariant failed module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" subject=")
              message.append_u32(subject)
              message.append(" arm=")
              message.append_u32(arm_index)
              message.append(" expression=")
              message.append_u32(arm.body)
              message.append(" expected=")
              message.append(self_host_linked_shape_name(logical_result_shape))
              message.append(" actual=")
              message.append(self_host_linked_shape_name(arm_shape))
              return Option::Some(message.finish())
            }
            Option::None => {}
          }
          if !self_host_u32_greater(
            module_.patterns.length(),
            arm.pattern,
          ) {
            return Option::Some("linked I32 match pattern is outside its arena")
          }
          let pattern = self_host_specialized_pattern(link, canonical_body_plan, module_, module_.patterns[arm.pattern])
          let subject_nominal = if self_host_u32_greater(
            pattern_subject_nominals.length(),
            arm.pattern,
          ) {
            pattern_subject_nominals[arm.pattern]
          } else {
            0u64
          }
          let mut condition = 4294967295u32
          let mut condition_ready = false
          let mut variant_type = 4294967295u32
          let mut catch_all = false
          let exact_subject_payload_hint = match self_host_linked_map_get_value_shape(
            link,
            module_,
            body,
            subject,
          ) {
            Option::Some(shape) => shape
            Option::None => match self_host_linked_match_subject_receiver_element_shape(
              link,
              module_,
              body,
              subject,
            ) {
              Option::Some(shape) => shape
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
          }
          let canonical_map_payload_hint = self_host_linked_canonical_map_get_value_shape(
            canonical_body_plan,
            link,
            module_,
            body,
            subject,
          )
          let planned_payload_hint = match canonical_body_plan {
            Option::Some(plan) => match self_host_body_plan_pattern_payload_value(
              plan,
              module_,
              body,
              arm.pattern,
            ) {
              Option::Some(value) => self_host_body_carrier_shape(value.carrier)
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
            Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          let mut canonical_payload_hint = match canonical_map_payload_hint {
            Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
              shape
            } else if !(planned_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
              planned_payload_hint
            } else if exact_subject_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              payload_hint
            } else {
              exact_subject_payload_hint
            }
            Option::None => if !(planned_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
              planned_payload_hint
            } else if exact_subject_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              payload_hint
            } else {
              exact_subject_payload_hint
            }
          }
          let mut direct_binding_result = false
          match pattern.source {
            SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
              children.length,
              0u32,
            ) && children.start < module_.pattern_children.length() {
              let child = module_.pattern_children[children.start]
              if child < module_.patterns.length() {
                match self_host_planned_pattern_at(module_.patterns, child).reference {
                  SelfHostBodyPatternReference::PatternBindingReference(local_id) => if self_host_linked_expression_wraps_local(
                    module_,
                    arm.body,
                    local_id,
                  ) {
                    direct_binding_result = true
                  }
                  _ => {}
                }
              }
            }
            _ => {}
          }
          // A different arm returning its payload does not constrain this
          // arm's payload. In particular Result<Bool, String>::Err is still
          // a reference when Ok returns the match's Boolean result.
          if canonical_body_plan is Option::None && direct_binding_result && !(result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
            result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
          ) && !(result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) && !(
            self_host_physical_scalar_shape(
              result_shape,
            ) is SelfHostPlannedValueShape::RefPlannedValueShape
          ) {
            canonical_payload_hint = result_shape

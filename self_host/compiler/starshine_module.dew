                // Dew evaluates length before value; array.new consumes value
                // before length. A call-local slot keeps both orders exact,
                // including nested constructors and side-effecting arguments.
                let length_local = self_host_linked_i32_scratch_slot(canonical_body_plan, link, module_, body, expression)
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedLocalGet(length_local, destination))
                if value_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
                  // Storage marker only: the source Unit expression still runs.
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value_expression,
                  destination,
                  depth,
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(length_local, destination))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  length_expression,
                  destination,
                  depth,
                )
                continue tasks.length()
              }
              if name.equals(b"array_len") {
                if !self_host_u32_equal(arguments.length, 1u32) ||
                  arguments.start >= module_.expression_children.length() {
                  return Option::Some("linked raw array length needs one array")
                }
                let array_expression = module_.expression_children[arguments.start]
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayLen(
                  destination,
                ))
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRawArrayCast(
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  array_expression,
                  destination,
                  depth,
                )
                continue tasks.length()
              }
              if name.equals(b"array_set") {
                if !self_host_u32_equal(arguments.length, 3u32) ||
                  self_host_u32_add(arguments.start, 2u32) >= module_.expression_children.length() {
                  return Option::Some("linked raw array set needs array index and value")
                }
                let value_expression = module_.expression_children[
                  self_host_u32_add(arguments.start, 2u32)
                ]

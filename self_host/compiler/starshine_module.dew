}

fn self_host_linked_schedule_object_constructor(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  fields: SelfHostHirSpan,
  type_index: U32,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  destination: StarshineRef45,
  depth: U32,
) -> Result<Unit, String> {
  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
    type_index,
    destination,
  ))
  let mut linked_position = 4294967295u32
  let mut linked_module = 0u32
  let mut linked_fragment = 0u32
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      linked_position = linked_type.type_index
      linked_module = linked_type.module_index
      linked_fragment = linked_type.fragment_index
    }
  }
  if self_host_u32_equal(linked_position, 4294967295u32) {
    return Result::Err("linked constructor type is missing")
  }
  let physical_module = link.fragments.modules[linked_module]
  let physical = self_host_linked_physical_type_at(
    physical_module,
    linked_fragment,
  )
  let used = []
  let mut used_index = 0u32
  let _ = while used_index {
    current => if current < fields.length {
      used.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut field_position = physical.fields.length
  let _ = while field_position {
    current => if self_host_u32_greater(current, 0u32) {
      let previous = current - 1u32
      let physical_field = self_host_linked_physical_field_at(
        physical_module,
        self_host_u32_add(physical.fields.start, previous),
      )
      let mut found = 4294967295u32
      let mut source_position = 0u32
      let _ = while source_position {
        source => if source < fields.length {
          let object_index = self_host_u32_add(fields.start, source)
          if object_index < module_.object_fields.length() {
            let source_field = module_.object_fields[object_index]
            let same_declaration = !self_host_u64_equal(
              source_field.field,
              0u64,
            ) && !self_host_u64_equal(
              physical_field.declaration,
              0u64,
            ) && self_host_u64_equal(
              source_field.field,
              physical_field.declaration,
            )
            let same_name = if !self_host_u64_equal(
              physical_field.declaration,
              0u64,
            ) && self_host_u32_greater(
              self_host_linked_module_name_count(module_),
              source_field.name,
            ) {
              match self_host_linked_module_field_name(
                link,
                physical_module.module_id,
                physical_field.declaration,
              ) {
                Option::Some(name) => name == self_host_linked_module_name_at(
                  module_,
                  source_field.name,
                )
                Option::None => false
              }
            } else {
              false
            }
            if self_host_u32_equal(found, 4294967295u32) && !used[source] &&
              (same_declaration || same_name) &&
              self_host_linked_constructor_field_shape_matches(
                link,
                module_,
                body,
                caller_specialization,
                source_field,
                physical_field,
              ) {
              found = source_field.value
              used[source] = true
            }
          }
          continue source + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if self_host_u32_equal(found, 4294967295u32) && previous < fields.length &&
        !used[previous] {
        let object_index = self_host_u32_add(fields.start, previous)
        if object_index < module_.object_fields.length() {
          let source_field = module_.object_fields[object_index]
          if self_host_linked_constructor_field_shape_matches(
            link,
            module_,
            body,
            caller_specialization,
            source_field,
            physical_field,
          ) {
            found = source_field.value
            used[previous] = true
          }
        }
      }
      if self_host_u32_equal(found, 4294967295u32) {
        return Result::Err("linked constructor field is missing")
      }
      self_host_linked_i32_schedule_expression(
        tasks,
        expression_depths,
        found,
        destination,
        depth,
      )
      continue previous
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}


fn self_host_linked_pattern_binding_use_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  pattern: SelfHostPlannedPattern,
) -> Option<SelfHostPlannedValueShape> {
  let local_id = match pattern.source {
    SelfHostHirPattern::TuplePattern(_, children, _) => if self_host_u32_greater(
      children.length,
      0u32,
    ) && children.start < module_.pattern_children.length() {
      let child = module_.pattern_children[children.start]
      if child < module_.patterns.length() {
        match self_host_planned_pattern_at(module_.patterns, child).reference {
          SelfHostBodyPatternReference::PatternBindingReference(value) => value
          _ => 4294967295u32
        }
      } else {
        4294967295u32
      }
    } else {
      4294967295u32
    }
    _ => 4294967295u32
  }
  if self_host_u32_equal(local_id, 4294967295u32) {
    return Option::None
  }
  match self_host_linked_local_call_argument_shape(
    link,
    module_,
    body,
    caller_specialization,
    local_id,
  ) {
    Option::Some(shape) => {
      return Option::Some(shape)
    }
    Option::None => {}
  }
  let mut fallback = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
          candidate,
          local_id,
        ) {
          let shape = self_host_linked_expression_expected_shape(
            link,
            module_,
            body,
            caller_specialization,
            expression,
          )
          match self_host_specialization_canonical_scalar(shape) {
            SelfHostPlannedValueShape::RefPlannedValueShape => {
              return Option::Some(shape)
            }
            SelfHostPlannedValueShape::I32PlannedValueShape => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              fallback = shape
            }
            SelfHostPlannedValueShape::I64PlannedValueShape => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              fallback = shape
            }
            SelfHostPlannedValueShape::F32PlannedValueShape => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              fallback = shape
            }
            SelfHostPlannedValueShape::F64PlannedValueShape => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              fallback = shape
            }
            SelfHostPlannedValueShape::V128PlannedValueShape => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              fallback = shape
            }
            _ => if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape &&
              !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
              !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
              fallback = shape
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if fallback is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    Option::None
  } else {
    Option::Some(fallback)
  }
}


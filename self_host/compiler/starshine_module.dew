          StarshineFfi.ffi_lib_Instruction_ref_cast(0i32, StarshineFfi.ffi_lib_HeapType_abs(StarshineFfi.ffi_lib_AbsHeapType_array())),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedArrayLen(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_array_len(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedArraySet(
          array_type,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_array_set(
            StarshineFfi.ffi_lib_TypeIdx_new(
              self_host_u32_to_i32(array_type),
            ),

fn self_host_linked_i32_scratch_count(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let mut count = 0u32
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => if self_host_linked_is_direct_map_write_candidate(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 19u32)
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => if self_host_linked_is_unresolved_iterator_next(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 1u32)
        } else if self_host_linked_is_unresolved_map_get(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 5u32)
        } else if self_host_linked_is_unresolved_map_contains_key(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 4u32)
        } else if self_host_linked_is_unresolved_map_write(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 19u32)
        } else if self_host_linked_is_unresolved_array_push(
          module_,
          expression,
        ) {
          count = self_host_u32_add(count, 11u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  count
}


              caller_specialization,
              arm_body,
            )
            match self_host_specialization_canonical_scalar(shape) {
              SelfHostPlannedValueShape::I32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::I64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::V128PlannedValueShape => {
                return Option::Some(shape)
              }
              _ => {}
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_special_match_initializer_physical_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(initializer) => if initializer < module_.expressions.length() {
      match module_.expressions[initializer].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => match self_host_linked_single_nested_special_match_result_shape(
          link,
          module_,
          body,
          arms,
        ) {
          Option::Some(shape) => Option::Some(shape)
          Option::None => match self_host_linked_expression_container_element_shape(
            link,
            module_,
            body,
            subject,
          ) {
          Option::Some(payload_hint) => {
            if self_host_linked_match_returns_special_binding(module_, arms) {
              return Option::Some(payload_hint)
            }
            let mut arm = 0u32
            let _ = while arm {
              current => if current < arms.length {
                let child = self_host_u32_add(arms.start, current)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let source = module_.pattern_arms[arm_index]
                    if source.flow.falls_through && self_host_u32_greater(
                      module_.expressions.length(),
                      source.body,
                    ) {
                      match module_.expressions[source.body].kind {
                        SelfHostPlannedExpressionKind::PlannedLocalGet(binding) => if self_host_linked_pattern_binds_local(
                          module_,
                          source.pattern,
                          binding,
                        ) {
                          match self_host_linked_pattern_binding_shape(
                            link,
                            module_,
                            source.pattern,
                            binding,
                            payload_hint,
                          ) {
                            Option::Some(shape) => {
                              return Option::Some(shape)
                            }
                            Option::None => {}
                          }
                        }
                        _ => {}
                      }
                    }
                  }
                }
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            Option::None
          }
          Option::None => Option::None
          }
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_special_match_binds_local(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let pattern_index = module_.pattern_arms[arm_index].pattern
                  if pattern_index < module_.patterns.length() &&
                    self_host_linked_pattern_binds_local(
                      module_,
                      pattern_index,
                      local_id,
                    ) {
                    let name = self_host_linked_pattern_name(
                      module_,
                      module_.patterns[pattern_index],
                    )
                    if name == "Some" || name == "Ok" || name == "Err" {
                      return true
                    }
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_special_match_subject_payload_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let pattern_index = module_.pattern_arms[arm_index].pattern
                  if self_host_linked_pattern_binds_local(
                    module_,
                    pattern_index,
                    local_id,
                  ) {
                    match self_host_linked_expression_container_element_shape(
                      link,
                      module_,
                      body,
                      subject,
                    ) {
                      Option::Some(shape) => {
                        return Option::Some(shape)
                      }
                      Option::None => {}
                    }
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_special_scalar_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
          let mut binds = false
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() &&
                  self_host_linked_pattern_binds_local(
                    module_,
                    module_.pattern_arms[arm_index].pattern,
                    local_id,
                  ) {
                  binds = true
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if binds {
            match self_host_linked_special_match_scalar_result_shape(
              link,
              module_,
              body,
              caller_specialization,
              arms,
            ) {
              Option::Some(shape) => {
                return Option::Some(shape)
              }
              Option::None => {}
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_argument_position(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
  expression: U32,
) -> I32 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < arguments.length {
      let index = self_host_u32_add(arguments.start, current)
      if index < module_.expression_children.length() && self_host_u32_equal(
        module_.expression_children[index],
        expression,
      ) {
        return self_host_u32_to_i32(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  -1i32
}

fn self_host_linked_callable_parameter_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  position: U32,
  argument_count: U32,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let callable_module = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(
        callable_module,
        declaration,
      ) {
        Option::Some(callable) => {
          let includes_receiver = callable.has_receiver && self_host_u32_equal(
            argument_count,
            self_host_u32_add(callable.parameters.length, 1u32),
          )
          if includes_receiver && self_host_u32_equal(position, 0u32) {
            return self_host_linked_resolved_nominal_declaration(
              callable_module,
              callable.self_type,
            )
          }
          let parameter_position = if includes_receiver {
            self_host_u32_subtract(position, 1u32)
          } else {
            position
          }
          if parameter_position < callable.parameters.length {
            let parameter_index = self_host_u32_add(
              callable.parameters.start,
              parameter_position,
            )
            if parameter_index < callable_module.functions.parameters.length() {
              self_host_linked_resolved_nominal_declaration(
                callable_module,
                callable_module.functions.parameters[parameter_index].type_,
              )
            } else {
              0u64
            }
          } else {
            0u64
          }
        }
        Option::None => 0u64
      }
    }
    Option::None => 0u64
  }
}

fn self_host_linked_expression_expected_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> U64 {
  let body_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut parent = self_host_u32_add(expression, 1u32)
  let _ = while parent {
    parent_index => if parent_index < body_end {
      if parent_index < module_.expressions.length() {
        match module_.expressions[parent_index].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            arguments,
            _,
          ) => {
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 {
              let nominal = self_host_linked_callable_parameter_nominal(
                link,
                declaration,
                self_host_i32_to_u32(position),
                arguments.length,
              )
              if !self_host_u64_equal(nominal, 0u64) {
                return nominal
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target,
            arguments,
          ) => if target < module_.expressions.length() {
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 {
              match self_host_linked_i32_call_index(
                link,
                body.body,
                caller_specialization,
                parent_index,
                0u64,
              ) {
                Option::Some(function_index) => for function_ in link.functions {
                  if self_host_u32_equal(
                    self_host_linked_physical_function_index(
                      function_.function_index,
                    ),
                    function_index,
                  ) {
                    let nominal = self_host_linked_callable_parameter_nominal(
                      link,
                      function_.declaration,
                      self_host_i32_to_u32(position),
                      arguments.length,
                    )
                    if !self_host_u64_equal(nominal, 0u64) {
                      return nominal
                    }
                  }
                }
                Option::None => {}
              }
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                  base,
                  name,
                ) => if name < self_host_linked_module_name_count(module_) {
                  match self_host_linked_method_call_index_for_receiver(
                    link,
                    module_,
                    body,
                    base,
                    self_host_linked_module_name_at(module_, name),
                  ) {
                    Option::Some(function_index) => for function_ in link.functions {
                      if self_host_u32_equal(
                        self_host_linked_physical_function_index(
                          function_.function_index,
                        ),
                        function_index,
                      ) {
                        let nominal = self_host_linked_callable_parameter_nominal(
                          link,
                          function_.declaration,
                          self_host_i32_to_u32(position),
                          arguments.length,
                        )
                        if !self_host_u64_equal(nominal, 0u64) {
                          return nominal
                        }
                      }
                    }
                    Option::None => {}
                  }
                }
                _ => {}
              }
              let source_name = module_.expressions[target].source_name
              if self_host_u32_greater(
                self_host_linked_module_name_count(module_),
                source_name,
              ) {
                match self_host_linked_callable_by_name(
                  link,
                  self_host_linked_module_name_at(module_, source_name),
                ) {
                  Option::Some(callable) => {
                    let nominal = self_host_linked_callable_parameter_nominal(
                      link,
                      callable.declaration,
                      self_host_i32_to_u32(position),
                      arguments.length,
                    )
                    if !self_host_u64_equal(nominal, 0u64) {
                      return nominal
                    }
                  }
                  Option::None => {}
                }
              }
            }
          }
          _ => {}
        }
      }
      continue parent_index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_expression_expected_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  let body_end = self_host_u32_add(
    body.expressions.start,
    body.expressions.length,
  )
  let mut parent = self_host_u32_add(expression, 1u32)
  let _ = while parent {
    parent_index => if parent_index < body_end {
      if parent_index < module_.expressions.length() {
        let parent = module_.expressions[parent_index]
        match parent.kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            arguments,
            _,
          ) => {
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 {
              match self_host_linked_i32_call_index(
                link,
                body.body,
                caller_specialization,
                parent_index,
                declaration,
              ) {
                Option::Some(function_index) => {
                  return self_host_linked_physical_function_parameter_shape(
                    link,
                    function_index,
                    self_host_i32_to_u32(position),
                  )
                }
                Option::None => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target,
            arguments,
          ) => {
            if target < module_.expressions.length() {
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                  base,
                  _,
                ) => if self_host_u32_equal(base, expression) {
                  return SelfHostPlannedValueShape::RefPlannedValueShape
                }
                _ => {}
              }
            }
            let position = self_host_linked_argument_position(
              module_,
              arguments,
              expression,
            )
            if position >= 0i32 && target < module_.expressions.length() {
              match module_.expressions[target].kind {
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => if name < self_host_linked_module_name_count(
                  module_,
                ) {
                  match self_host_linked_method_call_index(
                    link,
                    self_host_linked_module_name_at(module_, name),
                  ) {
                    Option::Some(function_index) => {
                      return self_host_linked_physical_function_parameter_shape(
                        link,
                        function_index,
                        self_host_i32_to_u32(position) + 1u32,
                      )
                    }
                    Option::None => {}
                  }
                }
                _ => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedIndexGet(
            _,
            index,
            _,
          ) => if self_host_u32_equal(index, expression) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          SelfHostPlannedExpressionKind::PlannedIndexSet(
            _,
            index,
            _,
            _,
          ) => if self_host_u32_equal(index, expression) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          SelfHostPlannedExpressionKind::PlannedConstruct(
            _,
            fields,
            _,
          ) => {
            let mut position = 0u32
            let _ = while position {
              current_field => if current_field < fields.length {
                let object_index = self_host_u32_add(fields.start, current_field)
                if object_index < module_.object_fields.length() {
                  let object_field = module_.object_fields[object_index]
                  if self_host_u32_equal(object_field.value, expression) {
                    match self_host_linked_struct_field_shape(
                      link,
                      object_field.field,
                    ) {
                      Option::Some(shape) => {
                        return shape
                      }
                      Option::None => if self_host_u32_greater(
                        self_host_linked_module_name_count(module_),
                        object_field.name,
                      ) {
                        let field_name = self_host_linked_module_name_at(
                          module_,
                          object_field.name,
                        )
                        let selected_field = match self_host_linked_infer_constructor_type_index(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          parent.nominal,
                          fields,
                        ) {
                          Option::Some(type_index) => match self_host_linked_field_by_type_name(
                            link,
                            type_index,
                            field_name,
                          ) {
                            Option::Some(field_link) => Option::Some(field_link)
                            Option::None => self_host_linked_field_by_name(
                              link,
                              parent.nominal,
                              field_name,
                            )
                          }
                          Option::None => self_host_linked_field_by_name(
                            link,
                            parent.nominal,
                            field_name,
                          )
                        }
                        match selected_field {
                          Option::Some(field_link) => match self_host_linked_physical_field_shape(
                            link,
                            field_link.type_index,
                            field_link.field_index,
                          ) {
                            Option::Some(shape) => {
                              return shape
                            }
                            Option::None => {}
                          }
                          Option::None => {}
                        }
                      }
                    }
                  }
                }
                continue current_field + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedBinaryExpression(
            _,
            left,
            right,
          ) => if self_host_u32_equal(left, expression) || self_host_u32_equal(
            right,
            expression,
          ) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          SelfHostPlannedExpressionKind::PlannedOperatorCall(
            _,
            _,
            left,
            right,
            _,
          ) => if self_host_u32_equal(left, expression) || self_host_u32_equal(
            right,
            expression,
          ) {
            return SelfHostPlannedValueShape::I32PlannedValueShape
          }
          _ => {}
        }
      }
      continue parent_index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  let mut relative_use = 0u32
                  let _ = while relative_use {
                    current_use => if current_use < body.expressions.length {
                      let use_expression = self_host_u32_add(
                        body.expressions.start,
                        current_use,
                      )
                      if use_expression < module_.expressions.length() {
                        match module_.expressions[use_expression].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(
                            candidate,
                          ) => if self_host_u32_equal(candidate, local_id) {
                            let shape = self_host_linked_expression_expected_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              use_expression,
                            )
                            if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                              return shape
                            }
                          }
                          _ => {}
                        }
                      }
                      continue current_use + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_backend_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = module_.expressions[expression]
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(
      operator,
      left,
      _,
    ) => match operator {
      SelfHostHirBinaryOperator::LogicalOr => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::LogicalAnd => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Equal => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::NotEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Less => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::LessEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::Greater => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      SelfHostHirBinaryOperator::GreaterEqual => {
        return SelfHostPlannedValueShape::I32PlannedValueShape
      }
      _ => {
        let shape = self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          left,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        module_.expressions[base].type_,
      ) {
        Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
        Option::None => match self_host_linked_expression_container_element_shape(
          link,
          module_,
          body,
          base,
        ) {
          Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return shape
          }
          Option::None => {}
        }
      }
    }
    _ => {}
  }
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    if self_host_linked_expression_is_let_value(module_, body, expression) {
      let contextual = self_host_linked_expression_expected_shape(
        link,
        module_,
        body,
        caller_specialization,
        expression,
      )
      if !(contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
        !(contextual is SelfHostPlannedValueShape::UnitPlannedValueShape) {
        return contextual
      }
    }
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => {
        return shape
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        module_.expressions[base].nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => {
            return shape
          }
          Option::None => {}
        }
        Option::None => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      expression,
      declaration,
    ) {
      Option::Some(function_index) => {
        let shape = self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
      match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        0u64,
      ) {
        Option::Some(function_index) => {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return shape
          }
        }
        Option::None => if target < module_.expressions.length() {
          let source_name = module_.expressions[target].source_name
          if self_host_u32_greater(
            self_host_linked_module_name_count(module_),
            source_name,
          ) {
            let name = self_host_linked_module_name_at(module_, source_name)
            if name == "new" || name == "with_capacity" || name == "make" ||
              name == "empty" {
              return SelfHostPlannedValueShape::RefPlannedValueShape
            }
          }
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if target < module_.expressions.length() {
      let mut callable_target = target
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          callable_target = operand
        }
        _ => {}
      }
      if callable_target < module_.expressions.length() {
        let source_name = module_.expressions[callable_target].source_name
        if source_name < self_host_linked_module_name_count(module_) {
          match self_host_linked_callable_by_name(
            link,
            self_host_linked_module_name_at(module_, source_name),
          ) {
            Option::Some(callable) => match self_host_linked_callable_function_index(
              link,
              callable.declaration,
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
            Option::None => {}
          }
        }
      }
    }
    _ => {}
  }
  let contextual_shape = self_host_linked_expression_expected_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
  if !(contextual_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return contextual_shape
  }
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, body.body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      for function_ in link.functions {
        if self_host_u32_equal(function_.function_index, call.function_index) {
          let fragment_module = link.fragments.modules[function_.module_index]
          let fragment = self_host_program_link_fragment_function(
            fragment_module,
            function_.fragment_index,
          )
          return self_host_linked_specialized_function_result_shape(
            link,
            function_,
            fragment_module,
            fragment,
          )
        }
      }
    }
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => SelfHostPlannedValueShape::I8PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => SelfHostPlannedValueShape::I16PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => SelfHostPlannedValueShape::U8PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => SelfHostPlannedValueShape::U16PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => SelfHostPlannedValueShape::U32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => SelfHostPlannedValueShape::U64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut relative = 0u32
      let _ = while relative {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = module_.locals[local_index]
            if self_host_u32_equal(local.local_id, local_id) {
              match self_host_linked_loop_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              if !(local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return local.shape
              }
              let inferred = self_host_planned_merged_body_value_shape(
                module_.resolved_types,
                module_.inferred,
                local.type_,
              )
              if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return inferred
              }
              match self_host_linked_local_initializer_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              match self_host_linked_local_assignment_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              match self_host_linked_loop_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => {}
              }
              return SelfHostPlannedValueShape::I32PlannedValueShape
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      SelfHostPlannedValueShape::I32PlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          let method_name = self_host_linked_module_name_at(module_, name)
          if method_name == "get_unchecked" {
            let contextual = self_host_linked_expression_expected_shape(
              link,
              module_,
              body,
              caller_specialization,
              expression,
            )
            if !(contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
              return contextual
            }
            if self_host_u64_equal(module_.expressions[base].nominal, 0u64) {
              return SelfHostPlannedValueShape::I32PlannedValueShape
            }
            SelfHostPlannedValueShape::ErrorPlannedValueShape
          } else {
            match self_host_linked_method_call_index(link, method_name) {
              Option::Some(function_index) => self_host_linked_physical_function_result_shape(
                link,
                function_index,
              )
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
          }
        } else {
          SelfHostPlannedValueShape::ErrorPlannedValueShape
        }
        _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
      }
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        module_.expressions[base].type_,
      ) {
        Option::Some(shape) => shape
        Option::None => match self_host_linked_expression_container_element_shape(
          link,
          module_,
          body,
          base,
        ) {
          Option::Some(shape) => shape
          Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
        }
      }
    } else {
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_callable_function_index(link, declaration) {
      Option::Some(function_index) => self_host_linked_physical_function_result_shape(
        link,
        function_index,
      )
      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_local_initializer_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(candidate, local_id) {
                  let shape = if value < module_.expressions.length() {
                    let planned_value = module_.expressions[value]
                    match planned_value.kind {
                      SelfHostPlannedExpressionKind::PlannedIfExpression(
                        _,
                        then_block,
                        else_expression,
                      ) => self_host_linked_if_result_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        body.result_shape,
                        value,
                        planned_value,
                        then_block,
                        else_expression,
                      )
                      SelfHostPlannedExpressionKind::PlannedMatchExpression(
                        _,
                        arms,
                      ) => match self_host_linked_match_fallthrough_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arms,
                      ) {
                        Option::Some(result_shape) => result_shape
                        Option::None => self_host_linked_backend_expression_shape(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          value,
                        )
                      }
                      SelfHostPlannedExpressionKind::PlannedProductField(
                        base,
                        field,
                        _,
                      ) => match self_host_linked_product_field_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        base,
                        field,
                      ) {
                        Option::Some(field_shape) => field_shape
                        Option::None => self_host_linked_backend_expression_shape(
                          link,
                          module_,
                          body,
                          caller_specialization,
                          value,
                        )
                      }
                      _ => self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        value,
                      )
                    }
                  } else {
                    SelfHostPlannedValueShape::ErrorPlannedValueShape
                  }
                  if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return Option::Some(shape)
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_assignment_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalSet(candidate, value) => if self_host_u32_equal(
          candidate,
          local_id,
        ) {
          let shape = self_host_linked_backend_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            value,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(shape)
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_match_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(value, arms) => {
          let contextual_payload_hint = match self_host_specialization_canonical_scalar(
            body.result_shape,
          ) {
            SelfHostPlannedValueShape::I32PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
              link,
              module_,
              body,
              caller_specialization,
              arms,
            ) {
              Option::Some(shape) => shape
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
            SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
              link,
              module_,
              body,
              caller_specialization,
              arms,
            ) {
              Option::Some(shape) => shape
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
            _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          let payload_hint = match self_host_linked_map_get_value_shape(
            link,
            module_,
            body,
            value,
          ) {
            Option::Some(shape) => shape
            Option::None => match self_host_linked_expression_container_element_shape(
              link,
              module_,
              body,
              value,
            ) {
              Option::Some(shape) => shape
              Option::None => match self_host_specialization_canonical_scalar(
                contextual_payload_hint,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => contextual_payload_hint
                SelfHostPlannedValueShape::I64PlannedValueShape => contextual_payload_hint
                SelfHostPlannedValueShape::F32PlannedValueShape => contextual_payload_hint
                SelfHostPlannedValueShape::F64PlannedValueShape => contextual_payload_hint
                SelfHostPlannedValueShape::V128PlannedValueShape => contextual_payload_hint
                _ => match self_host_linked_match_binding_use_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                }
              }
            }
          }
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  module_.pattern_arms[arm_index].pattern,
                  local_id,
                ) {
                  let root_pattern_index = module_.pattern_arms[arm_index].pattern
                  if root_pattern_index < module_.patterns.length() {
                    let root_pattern = module_.patterns[root_pattern_index]
                    match root_pattern.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root_pattern,
                        payload_hint,
                        self_host_linked_match_subject_nominal_declaration(
                          link,
                          module_,
                          body,
                          value,
                        ),
                      ) {
                        Option::Some(type_index) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[child_index]
                                if child_pattern_index < module_.patterns.length() {
                                  match module_.patterns[child_pattern_index].reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(candidate, local_id) {
                                      match self_host_linked_physical_field_shape(
                                        link,
                                        type_index,
                                        current_child,
                                      ) {
                                        Option::Some(field_shape) => {
                                          return Option::Some(field_shape)
                                        }
                                        Option::None => {}
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                  let shape = match self_host_linked_exact_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    value,
                  ) {
                    Option::Some(result_shape) => result_shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      value,
                    )
                  }
                  if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return Option::Some(shape)
                  }
                  return Option::Some(
                    SelfHostPlannedValueShape::RefPlannedValueShape,
                  )
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_map_match_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local: SelfHostPlannedLocal,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(value, arms) => match self_host_linked_map_get_value_shape(
          link,
          module_,
          body,
          value,
        ) {
          Option::Some(payload_hint) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() {
                  let root_index = module_.pattern_arms[arm_index].pattern
                  if root_index < module_.patterns.length() {
                    let root = module_.patterns[root_index]
                    match root.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root,
                        payload_hint,
                        0u64,
                      ) {
                        Option::Some(type_index) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[
                                  child_index
                                ]
                                if child_pattern_index < module_.patterns.length() {
                                  let child_pattern = module_.patterns[
                                    child_pattern_index
                                  ]
                                  match child_pattern.reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(
                                      candidate,
                                      local.local_id,
                                    ) {
                                      return Option::Some(payload_hint)
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          }
          Option::None => {}
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_map_match_initializer_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(initializer) => if initializer < module_.expressions.length() {
      match module_.expressions[initializer].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(
          value,
          arms,
        ) => match self_host_linked_map_get_value_shape(
          link,
          module_,
          body,
          value,
        ) {
          Option::Some(shape) => self_host_linked_scoped_match_result_shape(
            link,
            module_,
            body,
            caller_specialization,
            arms,
            shape,
          )
          Option::None => Option::None
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_loop_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, arms) => {
          let payload_hint = match self_host_linked_iterator_next_element_shape(
            link,
            module_,
            body,
            initial,
          ) {
            Option::Some(shape) => shape
            Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  module_.pattern_arms[arm_index].pattern,
                  local_id,
                ) {
                  let root_pattern_index = module_.pattern_arms[arm_index].pattern
                  if root_pattern_index < module_.patterns.length() {
                    let root_pattern = module_.patterns[root_pattern_index]
                    match root_pattern.source {
                      SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
                        link,
                        module_,
                        root_pattern,
                        payload_hint,
                        0u64,
                      ) {
                        Option::Some(type_index) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            current_child => if current_child < children.length {
                              let child_index = self_host_u32_add(
                                children.start,
                                current_child,
                              )
                              if child_index < module_.pattern_children.length() {
                                let child_pattern_index = module_.pattern_children[child_index]
                                if child_pattern_index < module_.patterns.length() {
                                  match module_.patterns[child_pattern_index].reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(
                                      candidate,
                                    ) => if self_host_u32_equal(candidate, local_id) {
                                      if !(payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                        return Option::Some(payload_hint)
                                      }
                                      match self_host_linked_physical_field_shape(
                                        link,
                                        type_index,
                                        current_child,
                                      ) {
                                        Option::Some(field_shape) => {
                                          return Option::Some(field_shape)
                                        }
                                        Option::None => {}
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue current_child + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        Option::None => {}
                      }
                      _ => {}
                    }
                  }
                  if initial < module_.expressions.length() {
                    let shape = self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      initial,
                    )
                    if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                      return Option::Some(shape)
                    }
                  }
                  return Option::Some(
                    SelfHostPlannedValueShape::RefPlannedValueShape,
                  )
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_scalar_append_local_type(
  locals: StarshineRef293,
  shape: SelfHostPlannedValueShape,
) -> Bool {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::UnitPlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::NeverPlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    _ => StarshineFfi.ffi_lib_Locals_push(
      locals,
      self_host_linked_eqref_value_type(),
    )
  }
  true
}

fn self_host_linked_append_map_write_scratch(
  locals: StarshineRef293,
) -> Bool {
  self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I64PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::F32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::F64PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::V128PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I64PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::F32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::F64PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::V128PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::I32PlannedValueShape,
  ) && self_host_linked_scalar_append_local_type(
    locals,
    SelfHostPlannedValueShape::RefPlannedValueShape,
  )
}

fn self_host_linked_scalar_locals(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expected_result_shape: SelfHostPlannedValueShape,
  caller_specialization: U32,
) -> Result<StarshineRef293, String> {
  let locals = StarshineFfi.ffi_lib_Locals_empty()
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() {
        let planned_local = module_.locals[source]
        if !(planned_local.kind is SelfHostBodyLocalKind::ParameterLocal) {
          let product_field_shape = match self_host_linked_local_initializer_expression(
            module_,
            body,
            planned_local.local_id,
          ) {
            Option::Some(initializer) => if initializer < module_.expressions.length() {
              match module_.expressions[initializer].kind {
                SelfHostPlannedExpressionKind::PlannedProductField(
                  base,
                  field,
                  count,
                ) => if self_host_u32_equal(count, 2u32) {
                  match self_host_linked_preferred_pair_type_for_projection(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    base,
                  ) {
                    Option::Some(type_index) => match self_host_linked_pair_field_shape(
                      link,
                      type_index,
                      field,
                    ) {
                      Option::Some(shape) => Option::Some(shape)
                      Option::None => self_host_linked_physical_field_shape(
                        link,
                        type_index,
                        field,
                      )
                    }
                    Option::None => self_host_linked_local_initializer_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      planned_local.local_id,
                    )
                  }
                } else if self_host_u32_greater(count, 1u32) && field < count {
                  let target_pair = if self_host_u32_equal(
                    self_host_u32_add(field, 1u32),
                    count,
                  ) {
                    self_host_u32_subtract(count, 2u32)
                  } else {
                    field
                  }
                  let target_field = if self_host_u32_equal(
                    self_host_u32_add(field, 1u32),
                    count,
                  ) {
                    1u32
                  } else {
                    0u32
                  }
                  match self_host_linked_product_pair_type_for_projection(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    base,
                    count,
                    target_pair,
                  ) {
                    Option::Some(type_index) => self_host_linked_pair_field_shape(
                      link,
                      type_index,
                      target_field,
                    )
                    Option::None => self_host_linked_local_initializer_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      planned_local.local_id,
                    )
                  }
                } else {
                  self_host_linked_local_initializer_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    planned_local.local_id,
                  )
                }
                _ => Option::None
              }
            } else {
              Option::None
            }
            Option::None => Option::None
          }
          let call_initializer_shape = match self_host_linked_local_initializer_expression(
            module_,
            body,
            planned_local.local_id,
          ) {
            Option::Some(initializer) => if initializer < module_.expressions.length() {
              match module_.expressions[initializer].kind {
                SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => {
                  let shape = self_host_linked_array_push_item_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    initializer,
                  )
                  if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                    self_host_linked_specialized_call_result_shape(
                      link,
                      body.body,
                      caller_specialization,
                      initializer,
                    )
                  } else {
                    Option::Some(shape)
                  }
                }
                SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => match self_host_linked_unresolved_get_result_shape(
                  link,
                  module_,
                  body,
                  initializer,
                ) {
                  Option::Some(shape) => Option::Some(shape)
                  Option::None => if self_host_linked_is_unresolved_get_unchecked(
                    module_,
                    initializer,
                  ) {
                    self_host_linked_local_scalar_use_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      planned_local.local_id,
                    )
                  } else {
                    let shape = self_host_linked_array_push_item_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      initializer,
                    )
                    if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                      self_host_linked_specialized_call_result_shape(
                        link,
                        body.body,
                        caller_specialization,
                        initializer,
                      )
                    } else {
                      Option::Some(shape)
                    }
                  }
                }
                _ => Option::None
              }
            } else {
              Option::None
            }
            Option::None => Option::None
          }
          let field_initializer_shape = match self_host_linked_local_initializer_expression(
            module_,
            body,
            planned_local.local_id,
          ) {
            Option::Some(initializer) => if initializer < module_.expressions.length() {
              match module_.expressions[initializer].kind {
                SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
                  let shape = self_host_linked_variant_payload_shape(
                    link,
                    module_,
                    body,
                    initializer,
                  )
                  if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                    Option::None
                  } else {
                    Option::Some(shape)
                  }
                }
                SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
                  let shape = self_host_linked_variant_payload_shape(
                    link,
                    module_,
                    body,
                    initializer,
                  )
                  if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                    Option::None
                  } else {
                    Option::Some(shape)
                  }
                }
                _ => Option::None
              }
            } else {
              Option::None
            }
            Option::None => Option::None
          }
          let loop_binding_shape = self_host_linked_loop_binding_shape(
            link,
            module_,
            body,
            caller_specialization,
            planned_local.local_id,
          )
          let match_binding_shape = self_host_linked_map_match_binding_shape(
            link,
            module_,
            body,
            planned_local,
          )
          let special_match_subject_shape = self_host_linked_special_match_subject_payload_shape(
            link,
            module_,
            body,
            planned_local.local_id,
          )
          let scalar_match_binding_shape = if self_host_linked_special_match_binds_local(
            module_,
            body,
            planned_local.local_id,
          ) {
            match special_match_subject_shape {
              Option::Some(shape) => Option::Some(shape)
              Option::None => match self_host_linked_local_call_argument_shape(
                link,
                module_,
                body,
                caller_specialization,
                planned_local.local_id,
              ) {
                Option::Some(shape) => Option::Some(shape)
                Option::None => match self_host_linked_local_scalar_use_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                ) {
                  Option::Some(shape) => Option::Some(shape)
                  Option::None => match self_host_specialization_canonical_scalar(
                expected_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => self_host_linked_special_scalar_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                )
                SelfHostPlannedValueShape::I64PlannedValueShape => self_host_linked_special_scalar_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                )
                SelfHostPlannedValueShape::F32PlannedValueShape => self_host_linked_special_scalar_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                )
                SelfHostPlannedValueShape::F64PlannedValueShape => self_host_linked_special_scalar_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                )
                SelfHostPlannedValueShape::V128PlannedValueShape => self_host_linked_special_scalar_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                )
                _ => Option::None
              }
              }
              }
            }
          } else {
            Option::None
          }
          let map_match_initializer_shape = self_host_linked_map_match_initializer_shape(
            link,
            module_,
            body,
            caller_specialization,
            planned_local.local_id,
          )
          let runtime_reference_shape = self_host_linked_local_runtime_reference_shape(
            module_,
            body,
            planned_local.local_id,
          )
          let match_subject_reference_shape = self_host_linked_local_match_subject_reference_shape(
            module_,
            body,
            planned_local.local_id,
          )
          let special_match_initializer_shape = self_host_linked_special_match_initializer_physical_shape(
            link,
            module_,
            body,
            planned_local.local_id,
          )
          let local_shape = match product_field_shape {
            Option::Some(shape) => shape
            Option::None => match field_initializer_shape {
              Option::Some(shape) => shape
              Option::None => match call_initializer_shape {
                Option::Some(shape) => shape
                Option::None => match special_match_initializer_shape {
              Option::Some(shape) => shape
              Option::None => match runtime_reference_shape {
                Option::Some(shape) => shape
                Option::None => match match_subject_reference_shape {
                  Option::Some(shape) => shape
                  Option::None => match scalar_match_binding_shape {
                    Option::Some(shape) => shape
                    Option::None => match loop_binding_shape {
                    Option::Some(shape) => shape
                    Option::None => match match_binding_shape {
                      Option::Some(shape) => shape
                      Option::None => match map_match_initializer_shape {
                    Option::Some(shape) => shape
                    Option::None => if planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              let inferred_shape = self_host_planned_merged_body_value_shape(
                module_.resolved_types,
                module_.inferred,
                planned_local.type_,
              )
              if inferred_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                match self_host_linked_local_initializer_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  planned_local.local_id,
                ) {
                  Option::Some(shape) => shape
                  Option::None => match self_host_linked_local_assignment_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    planned_local.local_id,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => match self_host_linked_match_binding_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      planned_local.local_id,
                    ) {
                      Option::Some(shape) => shape
                      Option::None => match self_host_linked_loop_binding_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        planned_local.local_id,
                      ) {
                        Option::Some(shape) => shape
                        Option::None => SelfHostPlannedValueShape::I32PlannedValueShape
                      }
                    }
                  }
                }
              } else {
                inferred_shape
              }
                    } else {
                      planned_local.shape
                    }
                  }
                }
              }
            }
            }
            }
            }
            }
            }
          }
          if !self_host_linked_scalar_append_local_type(locals, local_shape) {
            return Result::Err("linked local type is outside the scalar subset")
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
          let inferred_scratch_shape = self_host_linked_scratch_shape(
            link,
            module_,
            body,
            caller_specialization,
            expression,
          )
          let scratch_shape = if inferred_scratch_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            SelfHostPlannedValueShape::I32PlannedValueShape
          } else {
            inferred_scratch_shape
          }
          if !self_host_linked_scalar_append_local_type(
            locals,
            scratch_shape,
          ) {
            return Result::Err("linked match scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {
          let inferred_scratch_shape = self_host_linked_scratch_shape(
            link,
            module_,
            body,
            caller_specialization,
            expression,
          )
          let scratch_shape = if inferred_scratch_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            SelfHostPlannedValueShape::I32PlannedValueShape
          } else {
            inferred_scratch_shape
          }
          if !self_host_linked_scalar_append_local_type(
            locals,
            scratch_shape,
          ) {
            return Result::Err("linked loop scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => {
          if !self_host_linked_scalar_append_local_type(
            locals,
            SelfHostPlannedValueShape::RefPlannedValueShape,
          ) {
            return Result::Err("linked function-value scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedProductField(
          base,
          field,
          count,
        ) => {
          let scratch_shape = if self_host_u32_equal(count, 2u32) {
            match self_host_linked_preferred_pair_type_for_projection(
              link,
              module_,
              body,
              caller_specialization,
              base,
            ) {
              Option::Some(type_index) => match self_host_linked_pair_field_shape(
                link,
                type_index,
                field,
              ) {
                Option::Some(shape) => shape
                Option::None => match self_host_linked_physical_field_shape(
                  link,
                  type_index,
                  field,
                ) {
                  Option::Some(shape) => shape
                  Option::None => module_.expressions[expression].shape
                }
              }
              Option::None => module_.expressions[expression].shape
            }
          } else {
            module_.expressions[expression].shape
          }
          if !self_host_linked_scalar_append_local_type(locals, scratch_shape) {
            return Result::Err("linked tuple-field scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
          if !self_host_linked_scalar_append_local_type(
            locals,
            SelfHostPlannedValueShape::RefPlannedValueShape,
          ) {
            return Result::Err("linked array-literal scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => if self_host_linked_is_direct_map_write_candidate(
          module_,
          expression,
        ) {
          if !self_host_linked_append_map_write_scratch(locals) {
            return Result::Err("linked direct map write scratch type is unsupported")
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
          if self_host_linked_is_unresolved_iterator_next(module_, expression) {
            if !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) {
              return Result::Err("linked iterator scratch type is unsupported")
            }
          } else if self_host_linked_is_unresolved_map_get(
            module_,
            expression,
          ) {
            let key_shape = match self_host_linked_unresolved_receiver_argument_shape(
              link,
              module_,
              body,
              expression,
              0u32,
            ) {
              Option::Some(shape) => shape
              Option::None => self_host_linked_unresolved_call_first_argument_shape(
                module_,
                expression,
              )
            }
            if !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              key_shape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I32PlannedValueShape,
            ) {
              return Result::Err("linked map get scratch type is unsupported")
            }
          } else if self_host_linked_is_unresolved_map_contains_key(
            module_,
            expression,
          ) {
            if !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              self_host_linked_unresolved_call_first_argument_shape(
                module_,
                expression,
              ),
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I32PlannedValueShape,
            ) {
              return Result::Err("linked map lookup scratch type is unsupported")
            }
          } else if self_host_linked_is_unresolved_map_write(
            module_,
            expression,
          ) {
            if !self_host_linked_append_map_write_scratch(locals) {
              return Result::Err("linked map write scratch type is unsupported")
            }
          } else if self_host_linked_is_unresolved_array_push(
            module_,
            expression,
          ) {
            if !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I32PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I64PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::F32PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::F64PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::V128PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I32PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::I32PlannedValueShape,
            ) || !self_host_linked_scalar_append_local_type(
              locals,
              SelfHostPlannedValueShape::RefPlannedValueShape,
            ) {
              return Result::Err("linked array push scratch type is unsupported")
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(locals)
}

fn self_host_linked_i32_declared_local_count(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let mut count = 0u32
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() && !(
        module_.locals[source].kind is SelfHostBodyLocalKind::ParameterLocal
      ) {
        count = self_host_u32_add(count, 1u32)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_u32_add(
    count,
    self_host_linked_i32_scratch_count(module_, body),
  )
}

fn self_host_encode_linked_i32_module(
  module_: StarshineRef78,
) -> Result<Bytes, String> {
  if StarshineFfi.ffi_ffi_bridge_validate_module(module_) == 0i32 {
    Result::Err("Starshine rejected the linked self-host output module")
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(module_)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the linked self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

fn self_host_linked_append_import_name(
  builder: StarshineRef1481,
  value: Bytes,
  module_name: Bool,
) -> Unit {
  let _ = while 0u32 {
    index => if index < value.byte_length() {
      let byte = u8_into_i32(value.byte_at(index))
      if module_name {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_module_byte(
          builder,
          byte,
        )
      } else {
        StarshineFfi.ffi_ffi_bridge_ImportBuilder_push_field_byte(
          builder,
          byte,
        )
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn build_self_host_linked_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<Bytes, String> {
  match self_host_linked_i32_main_expression(link, root_module) {
    Result::Err(error) => Result::Err(error)
    Result::Ok(_) => {
      let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
      let function_value_signatures = []
      match self_host_linked_append_physical_types(link, rec_types) {
        Result::Err(error) => {
          return Result::Err(error)
        }
        Result::Ok(_) => {}
      }
      let imports = StarshineFfi.ffi_ffi_bridge_imports_new()
      let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
      let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
      let globals = StarshineFfi.ffi_ffi_bridge_global_builder_new()
      let function_references = StarshineFfi.ffi_ffi_bridge_function_reference_builder_new()
      let wasi_write_import = StarshineFfi.ffi_ffi_bridge_import_builder_new(
        self_host_u32_to_i32(
          self_host_u32_add(link.types.length(), link.functions.length()),
        ),
      )
      self_host_linked_append_import_name(
        wasi_write_import,
        b"wasi_snapshot_preview1",
        true,
      )
      self_host_linked_append_import_name(wasi_write_import, b"fd_write", false)
      StarshineFfi.ffi_ffi_bridge_imports_push_builder(
        imports,
        wasi_write_import,
      )
      let wasi_read_import = StarshineFfi.ffi_ffi_bridge_import_builder_new(
        self_host_u32_to_i32(
          self_host_u32_add(
            self_host_u32_add(link.types.length(), link.functions.length()),
            1u32,
          ),
        ),
      )
      self_host_linked_append_import_name(
        wasi_read_import,
        b"wasi_snapshot_preview1",
        true,
      )
      self_host_linked_append_import_name(wasi_read_import, b"fd_read", false)
      StarshineFfi.ffi_ffi_bridge_imports_push_builder(
        imports,
        wasi_read_import,
      )
      for linked_function in link.functions {
        let fragment_module = link.fragments.modules[linked_function.module_index]
        if !self_host_u32_greater(
          fragment_module.functions.length(),
          linked_function.fragment_index,
        ) {
          return Result::Err("linked I32 function fragment is outside its arena")
        }
        let fragment = fragment_module.functions[linked_function.fragment_index]
        let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
        let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.parameters,
          parameters,
        ) {
          return Result::Err("linked function parameters are outside the emitter subset")
        }
        let function_name = self_host_linked_function_name(link, linked_function)
        if (function_name.ends_with(b"get_unchecked") || function_name.ends_with(
          b"indexed_get",
        ) || self_host_linked_function_returns_array_element(
          link,
          linked_function,
          fragment,
        )) && self_host_u32_equal(fragment.results.length, 1u32) {
          self_host_linked_append_shape_value_types(
            results,
            self_host_linked_specialized_function_result_shape(
              link,
              linked_function,
              fragment_module,
              fragment,
            ),
          )
        } else if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.results,
          results,
        ) {
          return Result::Err("linked function results are outside the emitter subset")
        }
        let function_type = StarshineFfi.ffi_lib_CompType_func(
          parameters,
          results,
        )
        let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
          function_type,
          wasm_ref_null(),
        )
        StarshineFfi.ffi_ffi_bridge_rec_types_push(
          rec_types,
          StarshineFfi.ffi_lib_RecType_new(subtype),
        )
        let function_type_index = self_host_u32_add(
          link.types.length(),
          linked_function.function_index,
        )
        StarshineFfi.ffi_ffi_bridge_FunctionReferenceBuilder_push(
          function_references,
          self_host_u32_to_i32(
            self_host_linked_physical_function_index(
              linked_function.function_index,
            ),
          ),
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(
            library,
            field,
          ) => {
            let builder = StarshineFfi.ffi_ffi_bridge_import_builder_new(
              self_host_u32_to_i32(function_type_index),
            )
            self_host_linked_append_import_name(builder, library, true)
            self_host_linked_append_import_name(builder, field, false)
            StarshineFfi.ffi_ffi_bridge_imports_push_builder(
              imports,
              builder,
            )
          }
          _ => StarshineFfi.ffi_ffi_bridge_type_indices_push(
            type_indices,
            StarshineFfi.ffi_lib_TypeIdx_new(
              self_host_u32_to_i32(function_type_index),
            ),
          )
        }
      }
      let mut wasi_signature = 0u32
      let _ = while wasi_signature {
        current => if current < 2u32 {
          let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
          let mut parameter = 0u32
          let _ = while parameter {
            position => if position < 4u32 {
              StarshineFfi.ffi_ffi_bridge_val_types_push(
                parameters,
                StarshineFfi.ffi_lib_ValType_i32(),
              )
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
          StarshineFfi.ffi_ffi_bridge_val_types_push(
            results,
            StarshineFfi.ffi_lib_ValType_i32(),
          )
          self_host_linked_append_function_value_type(
            rec_types,
            parameters,
            results,
          )
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      self_host_linked_append_text_runtime_types(link, rec_types)
      self_host_linked_append_array_runtime_types(link, rec_types)
      match self_host_linked_append_function_value_signatures(
        link,
        rec_types,
        function_value_signatures,
      ) {
        Result::Err(error) => {
          return Result::Err(error)
        }
        Result::Ok(_) => {}
      }
      let initializer_type_index = self_host_linked_text_runtime_base(link) +
        72u32 + function_value_signatures.length() * 2u32
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        self_host_linked_append_function_value_type(
          rec_types,
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
          StarshineFfi.ffi_ffi_bridge_val_types_new(),
        )
        let mut initializer_signature = 0u32
        let _ = while initializer_signature {
          current => if current < link.initializers.length() + 1u32 {
            StarshineFfi.ffi_ffi_bridge_type_indices_push(
              type_indices,
              StarshineFfi.ffi_lib_TypeIdx_new(
                self_host_u32_to_i32(initializer_type_index),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        for initializer in link.initializers {
          StarshineFfi.ffi_ffi_bridge_GlobalBuilder_push(
            globals,
            self_host_linked_array_carrier_from_shape(initializer.shape),
          )
        }
      }
      for linked_function in link.functions {
        let fragment_module = link.fragments.modules[linked_function.module_index]
        let fragment = self_host_program_link_fragment_function(
          fragment_module,
          linked_function.fragment_index,
        )
        match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(body_id) => {
            let lowering_module = link.fragments.specialization.lowering.modules[
              linked_function.module_index
            ]
            let body = match self_host_linked_i32_body(lowering_module, body_id) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked function body is missing")
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              function_value_signatures,
              lowering_module,
              body,
              self_host_linked_specialized_function_result_shape(
                link,
                linked_function,
                fragment_module,
                fragment,
              ),
              linked_function.specialization,
              instructions,
            ) {
              Result::Err(error) => {
                return Result::Err(error)
              }
              Result::Ok(_) => {}
            }
            let locals = match self_host_linked_scalar_locals(
              link,
              lowering_module,
              body,
              self_host_linked_specialized_function_result_shape(
                link,
                linked_function,
                fragment_module,
                fragment,
              ),
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(_, _) => {}
          SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(name) => {
            let carrier = self_host_linked_runtime_function_carrier(
              link,
              linked_function,
              fragment_module,
              fragment,
            )
            if !self_host_linked_append_runtime_function(
              link,
              functions,
              name,
              carrier,
              self_host_linked_runtime_second_carrier(
                link,
                linked_function,
                fragment_module,
                fragment,
                carrier,
              ),
            ) {
              return Result::Err(bytes_to_string(name))
            }
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
            lambda_id,
          ) => {
            let lowering_module = link.fragments.specialization.lowering.modules[
              linked_function.module_index
            ]
            let body = match self_host_linked_lambda_body(
              lowering_module,
              lambda_id,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked lambda function body is missing")
              }
            }
            let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              function_value_signatures,
              lowering_module,
              body,
              self_host_linked_specialized_function_result_shape(
                link,
                linked_function,
                fragment_module,
                fragment,
              ),
              linked_function.specialization,
              instructions,
            ) {
              Result::Err(error) => {
                return Result::Err(error)
              }
              Result::Ok(_) => {}
            }
            let locals = match self_host_linked_scalar_locals(
              link,
              lowering_module,
              body,
              self_host_linked_specialized_function_result_shape(
                link,
                linked_function,
                fragment_module,
                fragment,
              ),
              linked_function.specialization,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                locals,
                StarshineFfi.ffi_lib_Expr_new(instructions),
              ),
            )
          }
          SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction => {
            return Result::Err("linked signature-only function was assigned a physical function")
          }
        }
      }
      if self_host_u32_greater(link.initializers.length(), 0u32) {
        let mut initializer_position = 0u32
        let _ = while initializer_position {
          current => if current < link.initializers.length() {
            let initializer = link.initializers[current]
            let lowering_module = self_host_linked_lowering_module_at(
              link,
              initializer.module_index,
            )
            let body = match self_host_linked_i32_body(
              lowering_module,
              initializer.body,
            ) {
              Option::Some(value) => value
              Option::None => {
                return Result::Err("linked initializer body is missing")
              }
            }
            let initializer_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
            match self_host_emit_linked_i32_expression(
              link,
              function_value_signatures,
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
              initializer_instructions,
            ) {
              Result::Err(error) => {
                return Result::Err(error)
              }
              Result::Ok(_) => {}
            }
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              initializer_instructions,
              StarshineFfi.ffi_lib_Instruction_global_set(
                StarshineFfi.ffi_lib_GlobalIdx_new(
                  self_host_u32_to_i32(initializer.global_index),
                ),
              ),
            )
            let initializer_locals = match self_host_linked_scalar_locals(
              link,
              lowering_module,
              body,
              initializer.shape,
              4294967295u32,
            ) {
              Result::Ok(value) => value
              Result::Err(error) => {
                return Result::Err(error)
              }
            }
            StarshineFfi.ffi_ffi_bridge_funcs_push(
              functions,
              StarshineFfi.ffi_lib_Func_new(
                initializer_locals,
                StarshineFfi.ffi_lib_Expr_new(initializer_instructions),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let start_instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
        let mut start_call = 0u32
        let _ = while start_call {
          current => if current < link.initializers.length() {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              start_instructions,
              StarshineFfi.ffi_lib_Instruction_call(
                StarshineFfi.ffi_lib_FuncIdx_new(
                  self_host_u32_to_i32(
                    link.functions.length() + current + 2u32,
                  ),
                ),
              ),
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        StarshineFfi.ffi_ffi_bridge_funcs_push(
          functions,
          StarshineFfi.ffi_lib_Func_new(
            StarshineFfi.ffi_lib_Locals_empty(),
            StarshineFfi.ffi_lib_Expr_new(start_instructions),
          ),
        )
      }
      let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
      let import_section = StarshineFfi.ffi_lib_ImportSec_new(imports)
      let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
      let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
      let typed_module = StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      )
      let imported_module = StarshineFfi.ffi_lib_Module_with_import_sec(
        typed_module,
        import_section,
      )
      let coded_module = StarshineFfi.ffi_lib_Module_with_code_sec(
        StarshineFfi.ffi_lib_Module_with_func_sec(
          imported_module,
          function_section,
        ),
        code_section,
      )
      let global_module = StarshineFfi.ffi_ffi_bridge_module_with_globals(
        StarshineFfi.ffi_ffi_bridge_module_with_default_memory(coded_module),
        globals,
      )
      let started_module = if self_host_u32_greater(
        link.initializers.length(),
        0u32,
      ) {
        StarshineFfi.ffi_ffi_bridge_module_with_start_function(
          global_module,
          self_host_u32_to_i32(
            link.functions.length() + link.initializers.length() + 2u32,
          ),
        )
      } else {
        global_module
      }
      self_host_encode_linked_i32_module(
        StarshineFfi.ffi_ffi_bridge_module_with_declarative_functions(
          started_module,
          function_references,
        ),
      )
    }
  }
}

pub fn build_self_host_linked_root_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_index: U32,
) -> Result<Bytes, String> {
  let modules = link.fragments.specialization.lowering.modules
  if root_index >= modules.length() {
    Result::Err("linked root module index is outside its arena")
  } else {
    build_self_host_linked_i32_module(link, modules[root_index].module_id)
  }
}

    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
          let planned_nominal = match canonical {
            Option::Some(plan) => match self_host_body_plan_expression(
              plan,
              subject,
            ) {
              Option::Some(value) => value.value.nominal_owner
              Option::None => 0u64
            }
            Option::None => 0u64
          }
          let nominal = if !self_host_u64_equal(planned_nominal, 0u64) {
            planned_nominal
          } else {
            self_host_linked_match_subject_nominal_declaration(
              link,
              module_,
              body,
              subject,
            )
          }
          if !self_host_u64_equal(nominal, 0u64) {
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root < values.length() {
                      values[root] = nominal
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}


fn self_host_linked_pattern_local_container_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() &&
                  self_host_linked_pattern_binds_local(
                    module_,
                    self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                    local_id,
                  ) {
                  let nominal = self_host_linked_expression_result_argument_nominal_declaration(
                    link,
                    module_,
                    body,
                    subject,
                    0u32,
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    match link.fragments.specialization.lowering.index.declaration_owner(
                      nominal,
                    ) {
                      Option::Some(owner) => return link.fragments.specialization.lowering.modules[
                        owner
                      ].module_id
                      Option::None => {}
                    }
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_expression_container_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> U64 {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      let owner = self_host_linked_type_owner_module_id(
        link,
        module_,
        planned.type_,
      )
      if !self_host_u64_equal(owner, 0u64) {
        return owner
      }
      let nominal = self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        expression,
      )
      if !self_host_u64_equal(nominal, 0u64) {
        match link.fragments.specialization.lowering.index.declaration_owner(
          nominal,
        ) {
          Option::Some(module_index) => return link.fragments.specialization.lowering.modules[
            module_index
          ].module_id
          Option::None => {}
        }
      }
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return 0u64
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(value) => {
            expression = value
          }
          Option::None => {
            return self_host_linked_pattern_local_container_owner_module_id(
              link,
              module_,
              body,
              local_id,
            )
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          return self_host_linked_callable_result_owner_module_id(
            link,
            declaration,
          )
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field(
          link,
          field,
        ) {
          Option::Some(field_link) => {
            return self_host_linked_field_container_owner_module_id(
              link,
              field_link,
            )
          }
          Option::None => {
            return 0u64
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          match self_host_linked_field_by_name(
            link,
            self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              base,
            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => {
              return self_host_linked_field_container_owner_module_id(
                link,
                field_link,
              )
            }
            Option::None => {
              return 0u64
            }
          }
        } else {
          return 0u64
        }
        _ => {
          return 0u64
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_expression_container_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
          match self_host_linked_type_argument_shape(
            module_,
            planned.type_,
            argument,
          ) {
            Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
              shape is SelfHostPlannedValueShape::GenericPlannedValueShape
            ) && !(
              self_host_physical_scalar_shape(shape) is SelfHostPlannedValueShape::RefPlannedValueShape
            ) {
              return Option::Some(shape)
            }
            Option::None => {}
          }
          match self_host_linked_local_source_expression(
            module_,
            body,
            local_id,
          ) {
            Option::Some(value) => {
              expression = value
              continue current + 1u32
            }
            Option::None => match self_host_linked_local_parameter_argument_shape(
              link,
              module_,
              body,
              local_id,
              argument,
            ) {
              Option::Some(shape) => return Option::Some(shape)
              Option::None => {}
            }
          }
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(elements) => if self_host_u32_equal(
          argument,
          0u32,
        ) && self_host_u32_greater(elements.length, 0u32) &&
          elements.start < module_.expression_children.length() {
          let child = module_.expression_children[elements.start]
          let shape = self_host_linked_static_expression_shape(
            link,
            module_,
            child,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(shape)
          }
        }
        _ => {}
      }
      match self_host_linked_type_argument_shape(
        module_,
        planned.type_,
        argument,
      ) {
        Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          shape is SelfHostPlannedValueShape::GenericPlannedValueShape
        ) {
          return Option::Some(shape)
        }
        Option::None => {}
      }
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(value) => {
            expression = value
          }
          Option::None => {
            return Option::None
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          return self_host_linked_callable_result_element_shape(
            link,
            declaration,
          )
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
          link,
          module_,
          body,
          field,
          base,
        ) {
          Option::Some(field_link) => {
            return self_host_linked_field_container_argument_shape(
              link,
              field_link,
              argument,
            )
          }
          Option::None => {
            return Option::None
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          match self_host_linked_field_by_name(
            link,
            self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              base,
            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => {
              return self_host_linked_field_container_argument_shape(
                link,
                field_link,
                argument,
              )
            }
            Option::None => {
              return Option::None
            }
          }
        } else {
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
              name < self_host_linked_module_name_count(module_) {
              let method_name = self_host_linked_module_name_at(module_, name)
              match self_host_linked_method_result_argument_shape_for_receiver(
                link,
                module_,
                body,
                base,
                method_name,
                argument,
              ) {
                Option::Some(shape) => {
                  return Option::Some(shape)
                }
                Option::None => if method_name == "iter" {
                  expression = base
                } else {
                  return Option::None
                }
              }
            } else {
              return Option::None
            }
            _ => {
              return Option::None
            }
          }
        } else {
          return Option::None
        }
        _ => {
          return Option::None
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_match_subject_receiver_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  subject: U32,
) -> Option<SelfHostPlannedValueShape> {
  if subject >= module_.expressions.length() {
    return Option::None
  }
  // Map<K, V>.get returns V. The generic receiver-element fallback below
  // reads argument 0, which is K for Map and T for Array.
  match self_host_linked_map_get_value_shape(
    link,
    module_,
    body,
    subject,
  ) {
    Option::Some(shape) => return Option::Some(shape)
    Option::None => {}
  }
  let mut base = 4294967295u32
  match module_.expressions[subject].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => {
          base = value
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, name) => if name < self_host_linked_module_name_count(module_) {
          let method = self_host_linked_module_name_at(module_, name)
          if method == "pop" || method == "next" || method == "get" {
            base = if value < module_.expressions.length() &&
              module_.expressions[value].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
              self_host_u32_greater(value, 0u32) {
              self_host_u32_subtract(value, 1u32)
            } else {
              value
            }
          }
        }
        _ => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(
      name,
      _,
      _,
      arguments,
      _,
    ) => if (name.ends_with(b"pop") || name.ends_with(b"next") || name.ends_with(b"get")) &&
      self_host_u32_greater(arguments.length, 0u32) &&
      arguments.start < module_.expression_children.length() {
      base = module_.expression_children[arguments.start]
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => {
      let name = self_host_linked_declaration_name(link, declaration)
      if name.ends_with(b"pop") || name.ends_with(b"next") || name.ends_with(b"get") {
        if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => {
              base = if value < module_.expressions.length() &&
                module_.expressions[value].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                self_host_u32_greater(value, 0u32) {
                self_host_u32_subtract(value, 1u32)
              } else {
                value
              }
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => {
              base = if value < module_.expressions.length() &&
                module_.expressions[value].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                self_host_u32_greater(value, 0u32) {
                self_host_u32_subtract(value, 1u32)
              } else {
                value
              }
            }
            _ => {}
          }
        }
        if self_host_u32_equal(base, 4294967295u32) &&
          self_host_u32_greater(arguments.length, 0u32) &&
          arguments.start < module_.expression_children.length() {
          base = module_.expression_children[arguments.start]
        }
        if self_host_u32_equal(base, 4294967295u32) &&
          self_host_u32_greater(target, 0u32) {
          base = self_host_u32_subtract(target, 1u32)
        }
      }
    }
    _ => {}
  }
  if self_host_u32_equal(base, 4294967295u32) {
    return Option::None
  }
  match self_host_linked_expression_source_container_element_shape(
    link,
    module_,
    body,
    base,
  ) {
    Option::Some(shape) => Option::Some(shape)
    Option::None => self_host_linked_expression_container_element_shape(
      link,
      module_,
      body,
      base,
    )
  }
}

fn self_host_linked_expression_preferred_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,

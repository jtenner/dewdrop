          StarshineFfi.ffi_lib_Instruction_local_set(
            StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedFunctionValueCall(
          scratch,
          closure_type,
          direct_type,
          entry_type,
          arguments,
          result_shape,
          call_depth,
          destination,
        ) => {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_local_get(
              StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
              self_host_u32_to_i32(closure_type),
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_struct_get(
              StarshineFfi.ffi_lib_TypeIdx_new(
                self_host_u32_to_i32(closure_type),
              ),
              0i32,
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(
              self_host_u32_to_i32(direct_type),
            ),
          )
          let direct = StarshineFfi.ffi_ffi_bridge_instructions_new()
          let captured = StarshineFfi.ffi_ffi_bridge_instructions_new()
          tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
            destination,
            direct,
            captured,
            result_shape,
          ))
          tasks.push(SelfHostLinkedI32EmitTask::FinishLinkedFunctionValueCall(
            scratch,
            closure_type,
            entry_type,
            captured,
          ))
          match self_host_linked_i32_push_arguments(
            module_,
            arguments,
            captured,
            tasks,
            expression_depths,
            call_depth,
          ) {
            Result::Err(error) => {
              return Result::Err(error)
            }
            Result::Ok(_) => {}
          }
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            captured,
            StarshineFfi.ffi_lib_Instruction_local_get(
              StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
            ),
          )
          tasks.push(SelfHostLinkedI32EmitTask::FinishLinkedFunctionValueCall(
            scratch,
            closure_type,
            direct_type,
            direct,
          ))
          match self_host_linked_i32_push_arguments(
            module_,
            arguments,
            direct,
            tasks,
            expression_depths,
            call_depth,
          ) {
            Result::Err(error) => {
              return Result::Err(error)
            }
            Result::Ok(_) => {}
          }
        }
        SelfHostLinkedI32EmitTask::FinishLinkedFunctionValueCall(
          scratch,
          closure_type,
          function_type,
          destination,

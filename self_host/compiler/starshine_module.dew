  } else {
    Option::Some(value)
  }
}

fn self_host_linked_local_is_read(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let local_slot = self_host_body_local_slot(module_, body, local_id)
  if local_slot < body.locals.length && self_host_local_has_capture(module_, module_.locals[body.locals.start + local_slot]) {
    return true
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
            candidate,
            local_id,
          ) {
            return true
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_local_source_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(value) => Option::Some(value)
    Option::None => self_host_linked_local_assignment_expression(
      module_,
      body,
      local_id,
    )
  }
}

fn self_host_linked_runtime_reference_constructor(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  let planned = module_.expressions[expression]
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => return true
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => return true
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => return true
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => return true
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => return true
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => return true
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => return true
    _ => {}
  }
  match planned.selection {
    SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(_, _),
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => true
    _ => false
  }
}


fn self_host_linked_local_runtime_reference_shape(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(expression) => if self_host_linked_runtime_reference_constructor(
      module_,
      expression,
    ) {
      return Option::Some(SelfHostPlannedValueShape::RefPlannedValueShape)
    }
    Option::None => {}
  }
  match self_host_linked_local_assignment_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(expression) => if self_host_linked_runtime_reference_constructor(
      module_,
      expression,
    ) {
      Option::Some(SelfHostPlannedValueShape::RefPlannedValueShape)
    } else {
      Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_expression_container_element_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  let container_type = self_host_planned_expression_at(module_.expressions, expression).type_
  let container_owner = self_host_linked_type_nominal_declaration(
    module_,
    container_type,
  )
  let typed_element_owner = self_host_linked_type_argument_nominal_declaration(
    module_,
    container_type,
    if self_host_linked_declaration_name(link, container_owner).ends_with(b"Map") {
      1u32
    } else {
      0u32
    },
  )
  if !self_host_u64_equal(typed_element_owner, 0u64) {
    return typed_element_owner
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      expression,
      0u32,
    ) {
      self_host_linked_expression_container_element_nominal_declaration(
        link,
        module_,
        body,
        self_host_u32_subtract(expression, 1u32),
      )
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_expression_container_element_nominal_declaration(
          link,
          module_,
          body,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
      link,
      module_,
      body,
      field,
      base,
    ) {
      Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
        link,
        field_link,
      )
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
      module_,
    ) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
          link,
          field_link,
        )
        Option::None => 0u64
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => self_host_linked_callable_result_element_nominal_declaration(
      link,
      declaration,
    )
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(source) => if self_host_u32_equal(source, expression) {
        0u64
      } else {
        self_host_linked_expression_container_element_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
      }
      Option::None => self_host_linked_local_parameter_argument_nominal_declaration(
        link,
        module_,
        body,
        local_id,
        0u32,
      )
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          let method = self_host_linked_module_name_at(module_, name)
          if method == "iter" || method == "next" || method == "pop" {
            self_host_linked_expression_container_element_nominal_declaration(
              link,
              module_,
              body,
              base,
            )
          } else {
            0u64
          }
        } else {
          0u64
        }
        _ => 0u64
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => self_host_linked_match_subject_nominal_declaration(
      link,
      module_,
      body,
      expression,
    )
    _ => 0u64
  }
}

fn self_host_linked_loop_binding_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, arms) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                  local_id,
                ) {
                  let nominal = self_host_linked_expression_container_element_nominal_declaration(
                    link,
                    module_,
                    body,
                    initial,
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_local_parameter_position(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<(U32, U32)> {
  let exact_module = self_host_planned_module_lowering_identity(module_)
  let exact_body = self_host_planned_body_lowering_identity(body)
  let mut position = 0u32
  let mut count = 0u32
  let mut count_relative = 0u32
  let _ = while count_relative {
    current => if current < exact_body.locals.length {
      let index = self_host_u32_add(exact_body.locals.start, current)
      if index < exact_module.locals.length() {
        let local = self_host_body_planned_local_identity(
          exact_module.locals[index],
        )
        if local.kind is SelfHostBodyLocalKind::ParameterLocal {
          count = self_host_u32_add(count, 1u32)
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < exact_body.locals.length {
      let index = self_host_u32_add(exact_body.locals.start, current)
      if index < exact_module.locals.length() {
        let local = self_host_body_planned_local_identity(
          exact_module.locals[index],
        )
        if local.kind is SelfHostBodyLocalKind::ParameterLocal {
          if self_host_u32_equal(local.local_id, local_id) {
            return Option::Some((position, count))
          }
          position = self_host_u32_add(position, 1u32)
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_callable_parameter_argument_shape_from_callable(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  position: U32,
  argument_count: U32,
  type_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let exact_callable = self_host_planned_callable_identity(callable)
  let includes_receiver = exact_callable.has_receiver && self_host_u32_equal(
    argument_count,
    self_host_u32_add(exact_callable.parameters.length, 1u32),
  )
  if includes_receiver && self_host_u32_equal(position, 0u32) {
    return self_host_linked_resolved_type_argument_shape(
      module_,
      exact_callable.self_type,
      type_argument,
    )
  }
  let parameter_position = if includes_receiver {
    self_host_u32_subtract(position, 1u32)
  } else {
    position
  }
  if parameter_position < exact_callable.parameters.length {
    let parameter_index = self_host_u32_add(
      exact_callable.parameters.start,
      parameter_position,
    )
    if parameter_index < module_.functions.parameters.length() {
      let parameter = self_host_planned_parameter_identity(
        module_.functions.parameters[parameter_index],
      )
      return self_host_linked_resolved_type_argument_shape(
        module_,
        parameter.type_,
        type_argument,
      )
    }
  }
  Option::None
}

fn self_host_linked_physical_function_parameter_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
  explicit_position: U32,
  explicit_argument_count: U32,
  type_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => {
      let module_ = link.fragments.specialization.lowering.modules[
        function_.module_index
      ]
      match self_host_program_specialization_callable(
        module_,
        function_.declaration,
      ) {
        Option::Some(callable) => {
          let receiver_offset = if callable.has_receiver {
            1u32
          } else {
            0u32
          }
          self_host_linked_callable_parameter_argument_shape_from_callable(
            module_,
            callable,
            self_host_u32_add(explicit_position, receiver_offset),
            self_host_u32_add(explicit_argument_count, receiver_offset),
            type_argument,
          )
        }
        Option::None => Option::None
      }
    }
    Option::None => Option::None
  }
}

fn self_host_linked_local_call_container_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
  type_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      let arguments = match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, span, _) => span
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, span) => span
        _ => SelfHostHirSpan::{
          start: 0u32
          length: 0u32
        }
      }
      let mut position = 0u32
      let _ = while position {
        item => if item < arguments.length {
          let child_index = self_host_u32_add(arguments.start, item)
          if child_index < module_.expression_children.length() {
            let child = module_.expression_children[child_index]
            if child < module_.expressions.length() {
              match module_.expressions[child].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  let mut function_index = 4294967295u32
                  match module_.expressions[expression].kind {
                    SelfHostPlannedExpressionKind::PlannedDirectCall(
                      declaration,
                      _,
                      _,
                      _,
                    ) => match self_host_linked_i32_call_index(
                      link,
                      body.body,
                      caller_specialization,
                      expression,
                      declaration,
                    ) {
                      Option::Some(value) => {
                        function_index = value
                      }
                      Option::None => {}
                    }
                    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
                      target,
                      _,
                    ) => match self_host_linked_i32_call_index(
                      link,
                      body.body,
                      caller_specialization,
                      expression,
                      0u64,
                    ) {
                      Option::Some(value) => {
                        function_index = value
                      }
                      Option::None => if target < module_.expressions.length() {
                        match module_.expressions[target].kind {
                          SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                            base,
                            name,
                          ) => if name < self_host_linked_module_name_count(module_) {
                            match self_host_linked_method_call_index_for_receiver(
                              link,
                              module_,
                              body,
                              base,
                              self_host_linked_module_name_at(module_, name),
                            ) {
                              Option::Some(value) => {
                        function_index = value
                      }
                              Option::None => {}
                            }
                          }
                          _ => {}
                        }
                      }
                    }
                    _ => {}
                  }
                  if !self_host_u32_equal(function_index, 4294967295u32) {
                    match self_host_linked_physical_function_parameter_argument_shape(
                      link,
                      function_index,
                      item,
                      arguments.length,
                      type_argument,
                    ) {
                      Option::Some(shape) => return Option::Some(shape)
                      Option::None => {}
                    }
                  }
                }
                _ => {}
              }
            }
          }
          continue item + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_parameter_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
  type_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let pair = match self_host_linked_local_parameter_position(
    module_,
    body,
    local_id,
  ) {
    Option::Some(value) => value
    Option::None => return Option::None
  }
  let (position, count) = pair
  match link.fragments.specialization.lowering.index.declaration_owner(
    body.declaration,
  ) {
    Option::Some(owner) => {
      let callable_module = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(
        callable_module,
        body.declaration,
      ) {
        Option::Some(callable) => match self_host_linked_callable_parameter_argument_shape_from_callable(
          callable_module,
          callable,
          position,
          count,
          type_argument,
        ) {
          Option::Some(shape) => return Option::Some(shape)
          Option::None => {}
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
  for candidate_module in link.fragments.specialization.lowering.modules {
    for callable in candidate_module.functions.callables {
      if self_host_u64_equal(callable.declaration, body.declaration) {
        match self_host_linked_callable_parameter_argument_shape_from_callable(
          candidate_module,
          callable,
          position,
          count,
          type_argument,
        ) {
          Option::Some(shape) => return Option::Some(shape)
          Option::None => {}
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_callable_parameter_argument_nominal_from_callable(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  position: U32,
  argument_count: U32,
  type_argument: U32,
) -> U64 {
  let exact_callable = self_host_planned_callable_identity(callable)
  let includes_receiver = exact_callable.has_receiver && self_host_u32_equal(
    argument_count,
    self_host_u32_add(exact_callable.parameters.length, 1u32),
  )
  if includes_receiver && self_host_u32_equal(position, 0u32) {
    return self_host_body_resolved_type_argument_nominal_owner(
      module_,
      exact_callable.self_type,
      type_argument,
    )
  }
  let parameter_position = if includes_receiver {
    self_host_u32_subtract(position, 1u32)
  } else {
    position
  }
  if parameter_position < exact_callable.parameters.length {
    let parameter_index = self_host_u32_add(
      exact_callable.parameters.start,
      parameter_position,
    )
    if parameter_index < module_.functions.parameters.length() {
      let parameter = self_host_planned_parameter_identity(
        module_.functions.parameters[parameter_index],
      )
      return self_host_body_resolved_type_argument_nominal_owner(
        module_,
        parameter.type_,
        type_argument,
      )
    }
  }
  0u64
}


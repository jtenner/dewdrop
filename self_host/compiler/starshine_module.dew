              Option::None => {}
            }
          }
          match pattern.source {
            SelfHostHirPattern::WildcardPattern(_) => {
              catch_all = true
            }
            SelfHostHirPattern::BindingPattern(_, _) => match self_host_linked_pattern_variant_type(
              link,
              module_,
              pattern,
              canonical_payload_hint,
              subject_nominal,

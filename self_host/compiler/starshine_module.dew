                  SelfHostPlannedValueShape::F64PlannedValueShape => expected_arm_shape
                  SelfHostPlannedValueShape::V128PlannedValueShape => expected_arm_shape
                  _ => match self_host_linked_match_binding_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    local,
                  ) {
                    Option::Some(value) => value
                    Option::None => match self_host_linked_local_direct_pattern_subject_shape(
                      link,
                      module_,
                      body,
                      local,
                    ) {
                      Option::Some(value) => value
                      Option::None => self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arm_body,
                      )

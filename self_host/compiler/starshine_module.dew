  let _ = while used_index {
    current => if current < fields.length {
      used.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut physical_index = 0u32
  let _ = while physical_index {
    current => if current < physical.fields.length {
      let physical_field = self_host_linked_physical_field_at(
        physical_module,
        self_host_u32_add(physical.fields.start, current),
      )
      let mut found = false
      let mut source_index = 0u32
      let _ = while source_index {
        source => if source < fields.length {
          let object_index = self_host_u32_add(fields.start, source)
          if object_index < module_.object_fields.length() {
            let source_field = module_.object_fields[object_index]
            let same_declaration = !self_host_u64_equal(
              source_field.field,
              0u64,
            ) && !self_host_u64_equal(
              physical_field.declaration,
              0u64,
            ) && self_host_u64_equal(
              source_field.field,
              physical_field.declaration,
            )
            let same_name = if !self_host_u64_equal(
              physical_field.declaration,
              0u64,
            ) && self_host_u32_greater(
              self_host_linked_module_name_count(module_),
              source_field.name,
            ) {
              match self_host_linked_module_field_name(
                link,
                physical_module.module_id,
                physical_field.declaration,
              ) {
                Option::Some(name) => name == self_host_linked_module_name_at(
                  module_,
                  source_field.name,
                )
                Option::None => false
              }
            } else {
              false
            }
            if !found && !used[source] && (same_declaration || same_name) &&
              self_host_linked_constructor_field_shape_matches(
                link,
                module_,
                body,
                caller_specialization,
                source_field,
                physical_field,
              ) {
              found = true
              used[source] = true
            }
          }
          continue source + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if !found {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}


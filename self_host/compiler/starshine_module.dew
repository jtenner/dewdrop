fn self_host_linked_callable_result_argument_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  argument: U32,
) -> U64 {
  for module_ in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        module_,
      ) {
        let callable = self_host_program_specialization_callable_at(
          module_,
          current,
        )
        if self_host_u64_equal(callable.declaration, declaration) {
          let nominal = self_host_body_resolved_type_argument_nominal_owner(
            module_,
            callable.result_type,
            argument,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            return nominal
          }
        }
        continue self_host_u32_add(current, 1u32)
      } else {
        break self_host_semantic_unit()
      }
    }
    for callable in module_.functions.callables {
      if self_host_u64_equal(callable.declaration, declaration) {
        let nominal = self_host_body_resolved_type_argument_nominal_owner(
          module_,
          callable.result_type,
          argument,
        )
        if !self_host_u64_equal(nominal, 0u64) {
          return nominal
        }
      }
    }
  }
  0u64
}

fn self_host_linked_expression_result_argument_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  argument: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => self_host_linked_callable_result_argument_nominal_declaration(
      link,
      declaration,
      argument,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
      let selected = match module_.expressions[expression].call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => Option::Some(declaration)
        _ => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
              module_,
            ) {
              match self_host_linked_method_call_index_for_receiver(
                link,
                module_,
                body,
                base,
                self_host_linked_module_name_at(module_, name),
              ) {
                Option::Some(physical) => if self_host_u32_greater(physical, 1u32) {
                  let logical = self_host_u32_subtract(physical, 2u32)
                  let mut declaration = 0u64
                  for function_ in link.functions {
                    if self_host_u32_equal(function_.function_index, logical) {
                      declaration = function_.declaration
                    }
                  }
                  if self_host_u64_equal(declaration, 0u64) {
                    Option::None
                  } else {
                    Option::Some(declaration)
                  }
                } else {
                  Option::None
                }
                Option::None => Option::None
              }
            } else {
              Option::None
            }
            _ => Option::None
          }
        } else {
          Option::None
        }
      }
      match selected {
        Option::Some(declaration) => self_host_linked_callable_result_argument_nominal_declaration(
          link,
          declaration,
          argument,
        )
        Option::None => 0u64
      }
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
      link,
      module_,
      body,
      field,
      base,
    ) {
      Option::Some(field_link) => self_host_linked_field_container_argument_nominal_declaration(
        link,
        field_link,
        argument,
      )
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
      module_,
    ) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => self_host_linked_field_container_argument_nominal_declaration(
          link,
          field_link,
          argument,
        )
        Option::None => 0u64
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_source_expression(
      module_,
      body,
      local,
    ) {
      Option::Some(source) => self_host_linked_expression_result_argument_nominal_declaration(
        link,
        module_,
        body,
        source,
        argument,
      )
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      expression,
      0u32,
    ) {
      self_host_linked_expression_result_argument_nominal_declaration(
        link,
        module_,
        body,
        self_host_u32_subtract(expression, 1u32),
        argument,
      )
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_expression_result_argument_nominal_declaration(
          link,
          module_,
          body,
          tail,
          argument,
        )
      }
    }
    _ => 0u64
  }
}

fn self_host_linked_callable_result_element_nominal_declaration(

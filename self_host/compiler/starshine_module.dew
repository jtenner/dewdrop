fn self_host_linked_local_array_push_item_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => if self_host_u32_equal(
            arguments.length,
            1u32,
          ) && arguments.start < module_.expression_children.length() &&
            target < module_.expressions.length() {
            match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => if name < self_host_linked_module_name_count(
                module_,
              ) && self_host_linked_module_name_at(module_, name) == "push" {
                let raw_item = module_.expression_children[arguments.start]
                let item = if raw_item < module_.expressions.length() &&
                  module_.expressions[raw_item].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                  self_host_u32_greater(raw_item, 0u32) {
                  self_host_u32_subtract(raw_item, 1u32)
                } else {
                  raw_item
                }
                if item < module_.expressions.length() {
                  match module_.expressions[item].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_linked_local_sources_local(
                      module_,
                      body,
                      candidate,
                      local_id,
                    ) {
                      match self_host_linked_canonical_container_argument_shape(
                        canonical,
                        link,
                        module_,
                        body,
                        receiver,
                        0u32,
                      ) {
                        Option::Some(shape) => return Option::Some(shape)
                        Option::None => return self_host_linked_expression_container_element_shape(
                          link,
                          module_,
                          body,
                          receiver,
                        )
                      }
                    }
                    _ => {}
                  }
                }
              }
              _ => {}
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_index_operand_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        let index_expression = match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedIndexGet(base, index, target) => if self_host_u64_equal(
            self_host_linked_expression_container_owner_module_id(
              link,
              module_,
              body,
              base,
            ),
            link.array_module_id,
          ) || self_host_linked_expression_is_array_value(
            link,
            module_,
            body,
            base,
          ) || match target {
            SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => self_host_linked_declaration_name(
              link,
              declaration,
            ).ends_with(b"get_unchecked") || match self_host_linked_i32_call_index(
              link,
              body.body,
              caller_specialization,
              expression,
              declaration,
            ) {
              Option::Some(function_index) => self_host_u64_equal(
                self_host_linked_physical_function_module_id(link, function_index),
                link.array_module_id,
              ) || self_host_linked_physical_function_returns_array_element_by_index(
                link,
                function_index,
              )
              Option::None => false
            }
            _ => false
          } || ((target is SelfHostBasicCallTarget::NoBasicCallTarget ||
            target is SelfHostBasicCallTarget::ErrorBasicCallTarget) && !self_host_linked_expression_is_map_value(
            link,
            module_,
            body,
            base,
          )) {
            index
          } else {
            4294967295u32
          }
          SelfHostPlannedExpressionKind::PlannedIndexSet(base, index, _, target) => if self_host_u64_equal(
            self_host_linked_expression_container_owner_module_id(
              link,
              module_,
              body,
              base,
            ),
            link.array_module_id,
          ) || self_host_linked_expression_is_array_value(
            link,
            module_,
            body,
            base,
          ) || match target {
            SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => self_host_linked_declaration_name(
              link,
              declaration,
            ).ends_with(b"set_unchecked") || match self_host_linked_i32_call_index(
              link,
              body.body,
              caller_specialization,
              expression,
              declaration,
            ) {
              Option::Some(function_index) => self_host_u64_equal(
                self_host_linked_physical_function_module_id(link, function_index),
                link.array_module_id,
              )
              Option::None => false
            }
            _ => false
          } || ((target is SelfHostBasicCallTarget::NoBasicCallTarget ||
            target is SelfHostBasicCallTarget::ErrorBasicCallTarget) && !self_host_linked_expression_is_map_value(
            link,
            module_,
            body,
            base,
          )) {
            index
          } else {
            4294967295u32
          }
          _ => 4294967295u32
        }
        if index_expression < module_.expressions.length() {
          match module_.expressions[index_expression].kind {
            SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_linked_local_sources_local(
              module_,
              body,
              candidate,
              local_id,
            ) {
              return Option::Some(SelfHostPlannedValueShape::I32PlannedValueShape)
            }
            _ => {}
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_has_canonical_constructor_reference_use(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return false
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, arguments, _) => if self_host_linked_expression_is_variant_call(
            link,
            body.body,
            expression,
          ) {
            match self_host_body_plan_expression(
              plan,
              expression,
            ) {
            Option::Some(parent) => if !self_host_u32_equal(
              parent.selected_type_index,
              4294967295u32,
            ) {
              let mut argument = 0u32
              let _ = while argument {
                position => if position < arguments.length {
                  let child = self_host_u32_add(arguments.start, position)
                  if child < module_.expression_children.length() {
                    let raw_value = module_.expression_children[child]

  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut local_offset = 0u32
      let _ = while local_offset {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = self_host_body_planned_local_identity(module_.locals[local_index])
            if self_host_u32_equal(local.local_id, local_id) {
              if !self_host_u64_equal(local.nominal, 0u64) {
                return local.nominal
              }
              let local_type_nominal = self_host_linked_type_nominal_declaration(
                module_,
                local.type_,
              )
              if !self_host_u64_equal(local_type_nominal, 0u64) {
                return local_type_nominal
              }
              if local.kind is SelfHostBodyLocalKind::ParameterLocal {
                let parameter_nominal = self_host_linked_local_parameter_nominal_declaration(
                  link,
                  module_,
                  body,
                  local_id,
                )
                if !self_host_u64_equal(parameter_nominal, 0u64) {
                  return parameter_nominal
                }
              }
              if local.kind is SelfHostBodyLocalKind::ParameterLocal &&
                self_host_u32_equal(local_id, 0u32) {
                match self_host_program_specialization_callable(
                  module_,
                  body.declaration,
                ) {
                  Option::Some(callable) => if callable.has_receiver {
                    let receiver_nominal = self_host_linked_resolved_nominal_declaration(
                      module_,
                      callable.self_type,
                    )
                    if !self_host_u64_equal(receiver_nominal, 0u64) {
                      return receiver_nominal
                    }
                  }
                  Option::None => {}
                }
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let loop_nominal = self_host_linked_loop_binding_nominal_declaration(
        link,
        module_,
        body,
        local_id,
      )
      if !self_host_u64_equal(loop_nominal, 0u64) {
        return loop_nominal
      }
      let pattern_nominal = self_host_linked_local_direct_pattern_nominal(
        link,
        module_,
        body,
        local_id,
      )
      if !self_host_u64_equal(pattern_nominal, 0u64) {
        return pattern_nominal
      }
      match self_host_linked_local_source_expression(
        module_,
        body,
        local_id,
      ) {
        Option::Some(source) => self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
        Option::None => 0u64
      }
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => self_host_linked_direct_call_result_nominal_declaration(
      link,
      module_,
      body,
      declaration,
      target,
      arguments,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
      let method_nominal = self_host_linked_unresolved_method_call_result_nominal_declaration(
        link,
        module_,
        body,
        expression,
      )
      if !self_host_u64_equal(method_nominal, 0u64) {
        return method_nominal
      }
      let declaration = match planned.call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
        _ => self_host_body_qualified_call_declaration(
          link,
          module_,
          expression,
        )
      }
      if self_host_u64_equal(declaration, 0u64) {
        0u64
      } else {
        self_host_linked_callable_result_nominal_declaration(
          link,
          declaration,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, selection) => match selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
        declaration,
        _,
      ) => declaration
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
        declaration,
        _,
        _,
      ) => declaration
      _ => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {

open dew.std.bytes
open dew.std.bytes_builder
open dew.std.option
open dew.std.result
open dew.std.wasm.intrinsics

fn self_host_i32_to_u32(value: I32) -> U32 {
  value.into()
}

fn self_host_i32_to_u8(value: I32) -> U8 {
  value.into()
}

fn self_host_encode_i32_function(
  instructions: StarshineRef125,
) -> Result<Bytes, String> {
  let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
  let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
  StarshineFfi.ffi_ffi_bridge_val_types_push(
    results,
    StarshineFfi.ffi_lib_ValType_i32(),
  )
  let function_type = StarshineFfi.ffi_lib_CompType_func(parameters, results)
  let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
    function_type,
    wasm_ref_null(),
  )
  let rec_type = StarshineFfi.ffi_lib_RecType_new(subtype)
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
  StarshineFfi.ffi_ffi_bridge_rec_types_push(rec_types, rec_type)
  let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
  let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
  StarshineFfi.ffi_ffi_bridge_type_indices_push(
    type_indices,
    StarshineFfi.ffi_lib_TypeIdx_new(0i32),
  )
  let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
  let expression = StarshineFfi.ffi_lib_Expr_new(instructions)
  let function_ = StarshineFfi.ffi_lib_Func_new(
    StarshineFfi.ffi_lib_Locals_empty(),
    expression,
  )
  let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions, function_)
  let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
  let module_ = StarshineFfi.ffi_lib_Module_with_code_sec(
    StarshineFfi.ffi_lib_Module_with_func_sec(
      StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      ),
      function_section,
    ),
    code_section,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(module_) == 0i32 {
    Result::Err("Starshine rejected the self-host output module")
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(module_)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

pub fn build_self_host_i32_module(value: I32) -> Result<Bytes, String> {
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    instructions,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(value),
    ),
  )
  self_host_encode_i32_function(instructions)
}

fn self_host_u64_to_i32(value: U64) -> I32 {
  value.into()
}

fn self_host_linked_root_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Option<U32> {
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => Option::Some(expression)
    SelfHostHirBodyRoot::BlockBodyRoot(block_index) => {
      if block_index >= module_.blocks.length() {
        return Option::None
      }
      let block = module_.blocks[block_index]
      if self_host_u32_equal(block.items.length, 0u32) {
        return Option::None
      }
      let item_index = self_host_u32_add(
        block.items.start,
        self_host_u32_subtract(block.items.length, 1u32),
      )
      if item_index >= module_.block_items.length() {
        return Option::None
      }
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => Option::Some(expression)
        SelfHostPlannedBlockItemKind::PlannedReturnItem(expression) => Option::Some(expression)
        _ => Option::None
      }
    }
  }
}

struct SelfHostLinkedRootExpression {
  module_index: U32
  expression: U32
}

enum SelfHostLinkedI32EmitTask {
  VisitLinkedI32Expression(U32)
  EmitLinkedI32Prefix(SelfHostHirPrefixOperator)
  EmitLinkedI32Binary(SelfHostHirBinaryOperator)
}

fn self_host_linked_i32_main_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<SelfHostLinkedRootExpression, String> {
  let mut module_index = 0u32
  let mut found_module = Option::None
  let lowering_modules = link.fragments.specialization.lowering.modules
  let _ = while module_index {
    current => if current < lowering_modules.length() {
      if self_host_u64_equal(lowering_modules[current].module_id, root_module) {
        found_module = Option::Some(current)
        break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let owner = match found_module {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked root module is missing")
    }
  }
  let module_ = lowering_modules[owner]
  let mut body_id = Option::None
  let functions = module_.functions.callables
  for callable in functions {
    if self_host_bytes_equal(callable.name, b"main") {
      match callable.kind {
        SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => {
          body_id = Option::Some(body)
        }
        _ => {}
      }
    }
  }
  let selected_body = match body_id {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked root module has no main function")
    }
  }
  let mut body = Option::None
  for candidate in module_.bodies {
    if self_host_u64_equal(candidate.body, selected_body) {
      body = Option::Some(candidate)
    }
  }
  let selected = match body {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked main function has no body")
    }
  }
  let expression_index = match self_host_linked_root_expression(module_, selected) {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked main body is not a scalar expression")
    }
  }
  if expression_index >= module_.expressions.length() {
    return Result::Err("linked main expression is outside its arena")
  }
  Result::Ok(SelfHostLinkedRootExpression::{
    module_index: owner
    expression: expression_index
  })
}

fn self_host_emit_linked_i32_binary(
  instructions: StarshineRef125,
  operator: SelfHostHirBinaryOperator,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::BitOr => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_or())
    SelfHostHirBinaryOperator::BitXor => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_xor())
    SelfHostHirBinaryOperator::BitAnd => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_and())
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ne())
    SelfHostHirBinaryOperator::Less => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_lt_s())
    SelfHostHirBinaryOperator::LessEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_le_s())
    SelfHostHirBinaryOperator::Greater => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_gt_s())
    SelfHostHirBinaryOperator::GreaterEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ge_s())
    SelfHostHirBinaryOperator::ShiftLeft => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shl())
    SelfHostHirBinaryOperator::ShiftRight => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shr_s())
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_mul())
    SelfHostHirBinaryOperator::Divide => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_div_s())
    SelfHostHirBinaryOperator::Remainder => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_rem_s())
    _ => {
      return false
    }
  }
  true
}

fn self_host_emit_linked_i32_expression(
  module_: SelfHostPlannedModuleLowering,
  root: U32,
  instructions: StarshineRef125,
) -> Result<Unit, String> {
  let tasks = [SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(root)]
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match tasks.pop() {
        Option::Some(value) => value
        Option::None => SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(4294967295u32)
      }
      match task {
        SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(expression) => {
          if expression >= module_.expressions.length() {
            return Result::Err("linked I32 expression is outside its arena")
          }
          match module_.expressions[expression].kind {
            SelfHostPlannedExpressionKind::PlannedI32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              instructions,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
              let mut constant = 0i32
              if value {
                constant = 1i32
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                instructions,
                StarshineFfi.ffi_lib_Instruction_i32_const(
                  StarshineFfi.ffi_lib_I32_new(constant),
                ),
              )
            }
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(operator, operand) => {
              match operator {
                SelfHostHirPrefixOperator::Positive => tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(operand))
                SelfHostHirPrefixOperator::Negative => {
                  StarshineFfi.ffi_ffi_bridge_instructions_push(
                    instructions,
                    StarshineFfi.ffi_lib_Instruction_i32_const(
                      StarshineFfi.ffi_lib_I32_new(0i32),
                    ),
                  )
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(operator))
                  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(operand))
                }
                SelfHostHirPrefixOperator::LogicalNot => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(operator))
                  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(operand))
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedBinaryExpression(operator, left, right) => {
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(operator))
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(right))
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(left))
            }
            _ => {
              return Result::Err("linked main expression is outside the I32 emitter subset")
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(operator) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            instructions,
            StarshineFfi.ffi_lib_Instruction_i32_sub(),
          )
          SelfHostHirPrefixOperator::LogicalNot => StarshineFfi.ffi_ffi_bridge_instructions_push(
            instructions,
            StarshineFfi.ffi_lib_Instruction_i32_eqz(),
          )
          SelfHostHirPrefixOperator::Positive => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(operator) => if !self_host_emit_linked_i32_binary(
          instructions,
          operator,
        ) {
          return Result::Err("linked I32 binary operator is unsupported")
        }
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}

pub fn build_self_host_linked_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<Bytes, String> {
  match self_host_linked_i32_main_expression(link, root_module) {
    Result::Err(error) => Result::Err(error)
    Result::Ok(selected) => {
      let modules = link.fragments.specialization.lowering.modules
      let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
      match self_host_emit_linked_i32_expression(
        modules[selected.module_index],
        selected.expression,
        instructions,
      ) {
        Result::Err(error) => Result::Err(error)
        Result::Ok(_) => self_host_encode_i32_function(instructions)
      }
    }
  }
}

pub fn build_self_host_linked_root_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_index: U32,
) -> Result<Bytes, String> {
  let modules = link.fragments.specialization.lowering.modules
  if root_index >= modules.length() {
    Result::Err("linked root module index is outside its arena")
  } else {
    build_self_host_linked_i32_module(link, modules[root_index].module_id)
  }
}

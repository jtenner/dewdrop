          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,

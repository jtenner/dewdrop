fn self_host_linked_call_base_element_shape(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  if !self_host_u32_greater(arguments.length, 0u32) ||
    arguments.start >= module_.expression_children.length() {
    return Option::None
  }
  let base = module_.expression_children[arguments.start]
  if base >= module_.expressions.length() {
    return Option::None
  }
  self_host_linked_type_first_argument_shape(
    module_,
    self_host_planned_expression_at(module_.expressions, base).type_,
  )
}

fn self_host_linked_call_first_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  planned: SelfHostPlannedExpression,
) -> Option<SelfHostPlannedValueShape> {
  if !self_host_u32_greater(planned.call_type_arguments.length, 0u32) ||
    planned.call_type_arguments.start >= module_.inferred.call_type_arguments.length() {
    return Option::None
  }
  Option::Some(
    self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      module_.inferred.call_type_arguments[planned.call_type_arguments.start],
    ),
  )
}

fn self_host_linked_specialization_first_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
) -> Option<SelfHostPlannedValueShape> {
  if self_host_u32_equal(linked_function.specialization, 4294967295u32) ||
    linked_function.specialization >= link.fragments.specialization.requests.length() {
    return Option::None
  }
  let request = link.fragments.specialization.requests[
    linked_function.specialization
  ]
  if !self_host_u32_greater(request.shapes.length, 0u32) ||
    !self_host_u32_greater(
      link.fragments.specialization.shapes.length(),
      request.shapes.start,
    ) {
    Option::None
  } else {
    Option::Some(
      link.fragments.specialization.shapes[request.shapes.start],
    )
  }
}

fn self_host_linked_function_name(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
) -> Bytes {
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
  match self_host_program_specialization_callable(
    module_,
    linked_function.declaration,
  ) {
    Option::Some(callable) => callable.name
    Option::None => b""
  }
}

fn self_host_linked_function_returns_array_element(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> Bool {
  let body_id = match fragment.kind {
    SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(value) => value
    _ => {
      return false
    }
  }
  let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, linked_function.module_index, linked_function.specialization)
  let body = match self_host_linked_i32_body(module_, body_id) {
    Option::Some(value) => value
    Option::None => {
      return false
    }
  }
  // Only the returned expression proves the result carrier. An array load in
  // an unrelated statement does not make the function return an array element.
  let expression = match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(value) => value
    SelfHostHirBodyRoot::BlockBodyRoot(block) => {
      if block >= module_.blocks.length() {
        return false
      }
      let planned_block = module_.blocks[block]
      if !self_host_u32_greater(planned_block.items.length, 0u32) {
        return false
      }
      let item = self_host_u32_add(
        planned_block.items.start,
        self_host_u32_subtract(planned_block.items.length, 1u32),
      )
      if item >= module_.block_items.length() {
        return false
      }
      match module_.block_items[item].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => value
        _ => {
          return false
        }
      }
    }
  }
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(name, _, _, _, _) => name.equals(
      b"array_get",
    )
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => match self_host_linked_builtin_name(
      link,
      declaration,
    ) {
      Option::Some(name) => name.equals(b"array_get")
      Option::None => false
    }
    _ => false
  }
}

fn self_host_linked_specialized_function_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  linked_function: SelfHostPlannedProgramWasmFunction,
  module_: SelfHostPlannedModuleWasmGCFragments,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> SelfHostPlannedValueShape {
  // Specialization is complete before linking. The fragment is the ABI
  // certificate; neither a method name nor an element shape can replace it.
  let _ = link
  let _ = linked_function
  self_host_linked_fragment_result_shape(module_, fragment)
}

fn self_host_linked_fragment_result_shape(
  module_: SelfHostPlannedModuleWasmGCFragments,
  fragment: SelfHostPlannedWasmFunctionFragment,
) -> SelfHostPlannedValueShape {
  if !self_host_u32_greater(fragment.results.length, 0u32) {
    SelfHostPlannedValueShape::UnitPlannedValueShape
  } else if fragment.results.start < module_.function_value_types.length() {
    self_host_linked_wasm_value_shape(
      module_.function_value_types[fragment.results.start],
    )
  } else {
    SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_i32_append_value_type(
  values: StarshineValueTypes,
  value: SelfHostPlannedWasmValueType,
) -> Bool {
  match value {
    SelfHostPlannedWasmValueType::WasmI32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedWasmValueType::WasmI64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedWasmValueType::WasmF32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedWasmValueType::WasmF64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedWasmValueType::WasmV128Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedWasmValueType::WasmNullableFuncRefValue => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_funcref_value_type(),
    )
  }
  true
}

fn self_host_linked_i32_append_value_types(
  module_: SelfHostPlannedModuleWasmGCFragments,
  span: SelfHostHirSpan,
  values: StarshineValueTypes,
) -> Bool {
  let mut index = 0u32
  let _ = while index {
    current => if current < span.length {
      let source = self_host_u32_add(span.start, current)
      if source >= module_.function_value_types.length() ||
        !self_host_linked_i32_append_value_type(
          values,
          module_.function_value_types[source],
        ) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_linked_append_shape_value_types(
  values: StarshineValueTypes,
  shape: SelfHostPlannedValueShape,
) -> Unit {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::UnitPlannedValueShape => {}
    SelfHostPlannedValueShape::NeverPlannedValueShape => {}
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
    _ => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
  }
}


fn self_host_linked_function_value_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= self_host_linked_expression_count(module_) {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = self_host_linked_expression_at(module_, expression)
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
    self_host_specialization_canonical_scalar(planned.shape) is SelfHostPlannedValueShape::RefPlannedValueShape
  ) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      for body in module_.bodies {
        if expression >= body.expressions.start && expression < self_host_u32_add(
          body.expressions.start,
          body.expressions.length,
        ) {
          let mut local = 0u32
          let _ = while local {
            current => if current < body.locals.length {
              let source = self_host_u32_add(body.locals.start, current)
              if source < module_.locals.length() {
                let planned_local = self_host_body_planned_local_identity(module_.locals[source])
                if self_host_u32_equal(planned_local.local_id, local_id) {
                  match self_host_linked_loop_binding_shape(
                    link,
                    module_,
                    body,
                    0u32,
                    local_id,
                  ) {
                    Option::Some(shape) => {
                      return shape
                    }
                    Option::None => {}
                  }
                  if !(planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return planned_local.shape
                  }
                  let inferred = self_host_planned_merged_body_value_shape(
                    module_.resolved_types,
                    module_.inferred,
                    planned_local.type_,
                  )
                  if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return inferred
                  }
                  match self_host_linked_local_initializer_shape(
                    link,
                    module_,
                    body,
                    0u32,
                    local_id,
                  ) {
                    Option::Some(shape) => {
                      return shape
                    }
                    Option::None => match self_host_linked_local_assignment_shape(
                      link,
                      module_,
                      body,
                      0u32,
                      local_id,
                    ) {
                      Option::Some(shape) => {
                        return shape
                      }
                      Option::None => match self_host_linked_match_binding_shape(
                        link,
                        module_,
                        body,
                        0u32,
                        local_id,
                      ) {
                        Option::Some(shape) => {
                          return shape
                        }
                        Option::None => match self_host_linked_loop_binding_shape(
                          link,
                          module_,
                          body,
                          0u32,
                          local_id,
                        ) {
                          Option::Some(shape) => {
                            return shape
                          }
                          Option::None => {}
                        }
                      }
                    }
                  }
                }
              }
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
      }
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_callable_function_index(link, declaration) {
      Option::Some(function_index) => self_host_linked_physical_function_result_shape(
        link,
        function_index,
      )
      Option::None => self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < self_host_linked_expression_count(module_) {
      match self_host_linked_expression_at(module_, target).kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => if name < self_host_linked_module_name_count(module_) {
          match self_host_linked_method_call_index(
            link,
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(function_index) => self_host_linked_physical_function_result_shape(
              link,
              function_index,
            )
            Option::None => self_host_planned_merged_body_value_shape(
              module_.resolved_types,
              module_.inferred,
              planned.type_,
            )
          }
        } else {
          self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            planned.type_,
          )
        }
        _ => self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          module_.inferred,
          planned.type_,
        )
      }
    } else {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < self_host_linked_expression_count(module_) &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_at(module_, base).nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => shape
          Option::None => self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            planned.type_,
          )
        }
        Option::None => self_host_planned_merged_body_value_shape(
          module_.resolved_types,
          module_.inferred,
          planned.type_,
        )
      }
    } else {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        planned.type_,
      )
    }
    _ => self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      planned.type_,
    )
  }
}

fn self_host_linked_function_value_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= self_host_linked_expression_count(module_) {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = self_host_linked_expression_at(module_, expression)
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if target < self_host_linked_expression_count(module_) {
      let mut callable_target = target
      match self_host_linked_expression_at(module_, target).kind {
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          callable_target = operand
        }
        _ => {}
      }
      if callable_target < self_host_linked_expression_count(module_) {
        let source_name = self_host_linked_expression_at(
          module_,
          callable_target,
        ).source_name
        if source_name < self_host_linked_module_name_count(module_) {
          match self_host_linked_callable_by_name(
            link,
            self_host_linked_module_name_at(module_, source_name),
          ) {
            Option::Some(callable) => match self_host_linked_callable_function_index(
              link,
              callable.declaration,
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
            Option::None => {}
          }
        }
      }
    }
    _ => {}
  }
  for body in module_.bodies {
    if expression >= body.expressions.start && expression < self_host_u32_add(
      body.expressions.start,
      body.expressions.length,
    ) {
      let mut relative_block = 0u32
      let _ = while relative_block {
        current_block => if current_block < body.blocks.length {
          let block_index = self_host_u32_add(body.blocks.start, current_block)
          if block_index < module_.blocks.length() {
            let block = module_.blocks[block_index]
            let mut relative_item = 0u32
            let _ = while relative_item {
              current_item => if current_item < block.items.length {
                let item_index = self_host_u32_add(block.items.start, current_item)
                if item_index < module_.block_items.length() {
                  match module_.block_items[item_index].kind {
                    SelfHostPlannedBlockItemKind::PlannedLetItem(
                      local_id,
                      _,
                      value,
                    ) => if self_host_u32_equal(value, expression) {
                      let mut local = 0u32
                      let _ = while local {
                        current => if current < body.locals.length {
                          let source = self_host_u32_add(body.locals.start, current)
                          if source < module_.locals.length() {
                            let planned_local = self_host_body_planned_local_identity(module_.locals[source])
                            if self_host_u32_equal(planned_local.local_id, local_id) {
                              if !(planned_local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                return planned_local.shape
                              }
                              let inferred = self_host_planned_merged_body_value_shape(
                                module_.resolved_types,
                                module_.inferred,
                                planned_local.type_,
                              )
                              if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                                return inferred
                              }
                            }
                          }
                          continue current + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                    }
                    _ => {}
                  }
                }
                continue current_item + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          continue current_block + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let expected = self_host_linked_expression_expected_shape(
        link,
        module_,
        body,
        0u32,
        expression,
      )
      if !(expected is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
        return expected
      }
    }
  }
  self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    planned.type_,
  )
}

fn self_host_linked_i32_body(
  module_: SelfHostPlannedModuleLowering,
  body: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  for candidate in module_.bodies {
    if self_host_u64_equal(candidate.body, body) {
      return Option::Some(candidate)
    }
  }
  Option::None
}

fn self_host_linked_lambda_body(
  module_: SelfHostPlannedModuleLowering,
  lambda_id: U32,
) -> Option<SelfHostPlannedBodyLowering> {
  for lambda in module_.lambdas {
    if self_host_u32_equal(lambda.lambda, lambda_id) {
      return Option::Some(SelfHostPlannedBodyLowering::{
        body: lambda.root_body
        declaration: 18446744073709551615u64
        kind: SelfHostHirBodyKind::FunctionBody
        root: lambda.root
        root_type: lambda.root_type
        root_shape: lambda.root_shape
        result_shape: lambda.result_shape
        flow: lambda.flow
        locals: lambda.locals
        local_initializers: lambda.local_initializers
        local_assignments: lambda.local_assignments
        expressions: lambda.expressions
        blocks: lambda.blocks
        patterns: lambda.patterns
        pattern_arms: lambda.pattern_arms
      })
    }
  }
  Option::None
}

fn self_host_linked_pattern_binds_local(
  module_: SelfHostPlannedModuleLowering,
  root: U32,
  local_id: U32,
) -> Bool {
  let pending = [root]
  let _ = while pending.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let pattern_index = match self_host_array_pop(pending) {
        Option::Some(value) => value
        Option::None => 4294967295u32
      }
      if pattern_index < module_.patterns.length() {
        let pattern = self_host_planned_pattern_at(module_.patterns, pattern_index)
        match pattern.reference {
          SelfHostBodyPatternReference::PatternBindingReference(candidate) => if self_host_u32_equal(
            candidate,
            local_id,
          ) {
            return true
          }
          _ => {}
        }
        match pattern.source {
          SelfHostHirPattern::ProductPattern(children, _) => {
            self_host_assert_array_span(children.start, children.length, module_.pattern_children.length(), "ARN-101 product binding children")
            let _ = while 0u32 {
              index => if index < children.length {
                pending.push(module_.pattern_children[children.start + index])
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostHirPattern::AlternativePattern(first, children, _) => {
            pending.push(first)
            self_host_assert_array_span(children.start, children.length, module_.pattern_children.length(), "ARN-101 alternative binding children")
            let _ = while 0u32 {
              index => if index < children.length {
                pending.push(module_.pattern_children[children.start + index])
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostHirPattern::StructPattern(_, fields, _, _, _) => {
            self_host_assert_array_span(fields.start, fields.length, module_.pattern_fields.length(), "ARN-101 named binding fields")
            let _ = while 0u32 {
              index => if index < fields.length {
                pending.push(module_.pattern_fields[fields.start + index].pattern)
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostHirPattern::TuplePattern(_, children, _) => {
            let mut child = 0u32
            let _ = while child {
              current => if current < children.length {
                let position = self_host_u32_add(children.start, current)
                if position < module_.pattern_children.length() {
                  pending.push(module_.pattern_children[position])
                }
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue pending.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_local_is_direct_pattern_binding(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root < module_.patterns.length() {
                      match self_host_planned_pattern_at(module_.patterns, root).reference {
                        SelfHostBodyPatternReference::PatternBindingReference(candidate) => if self_host_u32_equal(
                          candidate,
                          local_id,
                        ) {
                          return true
                        }
                        _ => {}
                      }
                      match self_host_planned_pattern_at(module_.patterns, root).source {
                        SelfHostHirPattern::TuplePattern(_, children, _) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            offset => if offset < children.length {
                              let position = self_host_u32_add(children.start, offset)
                              if position < module_.pattern_children.length() {
                                let child_pattern = module_.pattern_children[position]
                                if child_pattern < module_.patterns.length() {
                                  match self_host_planned_pattern_at(module_.patterns, child_pattern).reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(candidate) => if self_host_u32_equal(
                                      candidate,
                                      local_id,
                                    ) {
                                      return true
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue offset + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        _ => {}
                      }
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_local_sources_local(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  candidate: U32,
  source_local: U32,
) -> Bool {
  let mut local = candidate
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 {
      if self_host_u32_equal(local, source_local) {
        return true
      }
      match self_host_linked_local_source_expression(module_, body, local) {
        Option::Some(source) => if source < module_.expressions.length() {
          match module_.expressions[source].kind {
            SelfHostPlannedExpressionKind::PlannedLocalGet(next) => {
              local = next
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              _,
              then_block,
              else_expression,
            ) => {
              let then_tail = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              return (!self_host_u32_equal(then_tail, 4294967295u32) &&
                self_host_linked_expression_wraps_local(
                  module_,
                  then_tail,
                  source_local,
                )) || self_host_linked_expression_wraps_local(
                module_,
                else_expression,
                source_local,
              )
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
              let mut arm = 0u32
              let _ = while arm {
                position => if position < arms.length {
                  let child = self_host_u32_add(arms.start, position)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      let tail = self_host_body_block_tail_expression(
                        module_,
                        self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).body,
                      )
                      if !self_host_u32_equal(tail, 4294967295u32) &&
                        self_host_linked_expression_wraps_local(
                          module_,
                          tail,
                          source_local,
                        ) {
                        return true
                      }
                    }
                  }
                  continue position + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              return false
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(_) => return self_host_linked_expression_wraps_local(
              module_,
              source,
              source_local,
            )
            _ => return false
          }
        } else {
          return false
        }
        Option::None => return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_local_direct_pattern_subject_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
            let mut actual_subject = subject
            let mut source_depth = 0u32
            let _ = while source_depth {
              depth => if depth < 8u32 && actual_subject < module_.expressions.length() {
                match module_.expressions[actual_subject].kind {
                  SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                    actual_subject,
                    0u32,
                  ) {
                    actual_subject = self_host_u32_subtract(actual_subject, 1u32)
                    continue depth + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                  SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
                    let tail = self_host_body_block_tail_expression(module_, block)
                    if !self_host_u32_equal(tail, 4294967295u32) {
                      actual_subject = tail
                      continue depth + 1u32
                    }
                    break self_host_semantic_unit()
                  }
                  SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_source_expression(
                    module_,
                    body,
                    local,
                  ) {
                    Option::Some(source) => {
                      actual_subject = source
                      continue depth + 1u32
                    }
                    Option::None => break self_host_semantic_unit()
                  }
                  _ => break self_host_semantic_unit()
                }
              } else {
                break self_host_semantic_unit()
              }
            }
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root < module_.patterns.length() {
                      match self_host_planned_pattern_at(module_.patterns, root).source {
                        SelfHostHirPattern::TuplePattern(_, children, _) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            offset => if offset < children.length {
                              let position = self_host_u32_add(children.start, offset)
                              if position < module_.pattern_children.length() {
                                let child_pattern = module_.pattern_children[position]
                                if child_pattern < module_.patterns.length() {
                                  match self_host_planned_pattern_at(module_.patterns, child_pattern).reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(candidate) => if self_host_u32_equal(
                                      candidate,
                                      local_id,
                                    ) {
                                      match self_host_linked_map_get_value_shape(
                                        link,
                                        module_,
                                        body,
                                        actual_subject,
                                      ) {
                                        Option::Some(shape) => return Option::Some(shape)
                                        Option::None => match self_host_linked_match_subject_receiver_element_shape(
                                          link,
                                          module_,
                                          body,
                                          actual_subject,
                                        ) {
                                          Option::Some(shape) => return Option::Some(shape)
                                          Option::None => if actual_subject < module_.expressions.length() {
                                            match module_.expressions[actual_subject].kind {
                                              SelfHostPlannedExpressionKind::PlannedDirectCall(
                                                declaration,
                                                _,
                                                _,
                                                _,
                                              ) => {
                                                let name = self_host_linked_pattern_name(
                                                  module_,
                                                  self_host_planned_pattern_at(module_.patterns, root),
                                                )
                                                let argument = if name == "Err" {
                                                  1u32
                                                } else {
                                                  0u32
                                                }
                                                match self_host_linked_type_argument_shape(
                                                  module_,
                                                  self_host_planned_expression_at(module_.expressions, actual_subject).type_,
                                                  argument,
                                                ) {
                                                  Option::Some(shape) => if !(
                                                    shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                                                  ) {
                                                    return Option::Some(shape)
                                                  }
                                                  Option::None => {}
                                                }
                                                return self_host_linked_callable_result_argument_shape(
                                                  link,
                                                  declaration,
                                                  argument,
                                                )
                                              }
                                              _ => return Option::None
                                            }
                                          } else {
                                            return Option::None
                                          }
                                        }
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue offset + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        _ => {}
                      }
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_direct_pattern_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root < module_.patterns.length() {
                      match self_host_planned_pattern_at(module_.patterns, root).source {
                        SelfHostHirPattern::TuplePattern(_, children, _) => {
                          let mut child_offset = 0u32
                          let _ = while child_offset {
                            offset => if offset < children.length {
                              let position = self_host_u32_add(children.start, offset)
                              if position < module_.pattern_children.length() {
                                let child_pattern = module_.pattern_children[position]
                                if child_pattern < module_.patterns.length() {
                                  let pattern = self_host_planned_pattern_at(module_.patterns, child_pattern)
                                  match pattern.reference {
                                    SelfHostBodyPatternReference::PatternBindingReference(candidate) => if self_host_u32_equal(
                                      candidate,
                                      local_id,
                                    ) {
                                      let pattern_name = self_host_linked_pattern_name(
                                        module_,
                                        self_host_planned_pattern_at(module_.patterns, root),
                                      )
                                      let result_argument = if pattern_name == "Err" {
                                        1u32
                                      } else {
                                        0u32
                                      }
                                      if subject < module_.expressions.length() {
                                        let type_argument_nominal = self_host_linked_type_argument_nominal_declaration(
                                          module_,
                                          self_host_planned_expression_at(module_.expressions, subject).type_,
                                          result_argument,
                                        )
                                        if !self_host_u64_equal(type_argument_nominal, 0u64) {
                                          return type_argument_nominal
                                        }
                                      }
                                      let result_nominal = self_host_linked_expression_result_argument_nominal_declaration(
                                        link,
                                        module_,
                                        body,
                                        subject,
                                        result_argument,
                                      )
                                      if !self_host_u64_equal(result_nominal, 0u64) {
                                        return result_nominal
                                      }
                                      let declared = self_host_linked_type_nominal_declaration(
                                        module_,
                                        pattern.type_,
                                      )
                                      if !self_host_u64_equal(declared, 0u64) {
                                        return declared
                                      }
                                      let subject_nominal = self_host_linked_match_subject_nominal_declaration(
                                        link,
                                        module_,
                                        body,
                                        subject,
                                      )
                                      match self_host_linked_pattern_variant_type(
                                        link,
                                        module_,
                                        self_host_planned_pattern_at(module_.patterns, root),
                                        SelfHostPlannedValueShape::ErrorPlannedValueShape,
                                        subject_nominal,
                                      ) {
                                        Option::Some(type_index) => {
                                          let field_nominal = self_host_linked_field_value_nominal_declaration(
                                            link,
                                            SelfHostLinkedWasmFieldLink::{
                                              type_index: type_index
                                              field_index: offset
                                            },
                                          )
                                          if !self_host_u64_equal(field_nominal, 0u64) {
                                            return field_nominal
                                          }
                                        }
                                        Option::None => {}
                                      }
                                    }
                                    _ => {}
                                  }
                                }
                              }
                              continue offset + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        _ => {}
                      }
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}


fn self_host_linked_append_function_value_signatures(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRef33,
  signatures: Array<SelfHostLinkedFunctionValueSignature>,
) -> Result<Unit, String> {
  let mut next_type = self_host_linked_text_runtime_base(link) + 72u32
  let mut module_index = 0u32
  let _ = while module_index {
    current_module => if current_module < self_host_linked_lowering_module_count(link) {
      let module_ = self_host_linked_lowering_module_at(link, current_module)
      let mut expression_index = 0u32

fn self_host_linked_variant_type_by_owner_name_and_arity(
  link: SelfHostPlannedProgramWasmGCLink,
  owner: U64,
  name: String,
  arity: U32,
) -> Option<U32> {
  for linked_type in link.types {
    let physical_module = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      physical_module,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        variant,
        _,
      ) => if self_host_u64_equal(declaration, owner) &&
        self_host_u32_equal(physical.fields.length, arity) {
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        let mut named_index = 0u32
        let _ = while named_index {
          current => if current < self_host_linked_named_variant_count(
            lowering_module,
          ) {
            let named = self_host_linked_named_variant_at(
              lowering_module,
              current,
            )
            if self_host_u64_equal(named.declaration, variant) &&
              named.name == name {
              return Option::Some(linked_type.type_index)
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      _ => {}
    }
  }
  Option::None
}


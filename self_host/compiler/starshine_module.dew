fn self_host_linked_expression_container_element_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
      link,
      module_,
      body,
      field,
      base,
    ) {
      Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
        link,
        field_link,
      )
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
      module_,
    ) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
          link,
          field_link,
        )
        Option::None => 0u64
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(source) => if self_host_u32_equal(source, expression) {
        0u64
      } else {
        self_host_linked_expression_container_element_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
      }
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          let method = self_host_linked_module_name_at(module_, name)
          if method == "iter" || method == "next" {
            self_host_linked_expression_container_element_nominal_declaration(
              link,
              module_,
              body,
              base,
            )
          } else {
            0u64
          }
        } else {
          0u64
        }
        _ => 0u64
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => self_host_linked_match_subject_nominal_declaration(
      link,
      module_,
      body,
      expression,
    )
    _ => 0u64
  }
}

fn self_host_linked_loop_binding_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, arms) => {
          let mut arm = 0u32
          let _ = while arm {
            position => if position < arms.length {
              let child = self_host_u32_add(arms.start, position)
              if child < module_.arm_children.length() {
                let arm_index = module_.arm_children[child]
                if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                  module_,
                  module_.pattern_arms[arm_index].pattern,
                  local_id,
                ) {
                  let nominal = self_host_linked_expression_container_element_nominal_declaration(
                    link,
                    module_,
                    body,
                    initial,
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
              }
              continue position + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_expression_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  let planned = module_.expressions[expression]
  if !self_host_u64_equal(planned.nominal, 0u64) {
    return planned.nominal
  }
  let type_nominal = self_host_linked_type_nominal_declaration(
    module_,
    planned.type_,
  )
  if !self_host_u64_equal(type_nominal, 0u64) {
    return type_nominal
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut local_offset = 0u32
      let _ = while local_offset {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = module_.locals[local_index]
            if self_host_u32_equal(local.local_id, local_id) {
              if !self_host_u64_equal(local.nominal, 0u64) {
                return local.nominal
              }
              let local_type_nominal = self_host_linked_type_nominal_declaration(
                module_,
                local.type_,
              )
              if !self_host_u64_equal(local_type_nominal, 0u64) {
                return local_type_nominal
              }
              if local.kind is SelfHostBodyLocalKind::ParameterLocal &&
                self_host_u32_equal(local_id, 0u32) {
                match self_host_program_specialization_callable(
                  module_,
                  body.declaration,
                ) {
                  Option::Some(callable) => if callable.has_receiver {
                    let receiver_nominal = self_host_linked_resolved_nominal_declaration(
                      module_,
                      callable.self_type,
                    )
                    if !self_host_u64_equal(receiver_nominal, 0u64) {
                      return receiver_nominal
                    }
                  }
                  Option::None => {}
                }
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let loop_nominal = self_host_linked_loop_binding_nominal_declaration(
        link,
        module_,
        body,
        local_id,
      )
      if !self_host_u64_equal(loop_nominal, 0u64) {
        return loop_nominal
      }
      match self_host_linked_local_source_expression(
        module_,
        body,
        local_id,
      ) {
        Option::Some(source) => self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
        Option::None => 0u64
      }
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => self_host_linked_match_subject_nominal_declaration(
      link,
      module_,
      body,
      expression,
    )
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field(
      link,
      field,
    ) {
      Option::Some(field_link) => self_host_linked_field_value_nominal_declaration(
        link,
        field_link,
      )
      Option::None => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      let base_nominal = self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        base,
      )
      match self_host_linked_field_by_name(
        link,
        base_nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => self_host_linked_field_value_nominal_declaration(
          link,
          field_link,
        )
        Option::None => 0u64
      }
    } else {
      0u64
    }
    _ => 0u64
  }
}


              name < self_host_linked_module_name_count(module_) {
              match module_.expressions[base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  let nominal = self_host_linked_callable_receiver_nominal_by_name(
                    link,
                    self_host_linked_module_name_at(module_, name),
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
                _ => {}
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_let_value_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  let mut local_offset = 0u32
                  let _ = while local_offset {
                    current_local => if current_local < body.locals.length {
                      let local_index = self_host_u32_add(
                        body.locals.start,
                        current_local,
                      )
                      if local_index < module_.locals.length() {
                        let local = module_.locals[local_index]
                        if self_host_u32_equal(local.local_id, local_id) {
                          if !self_host_u64_equal(local.nominal, 0u64) {
                            return local.nominal
                          }
                          let nominal = self_host_linked_type_nominal_declaration(
                            module_,
                            local.type_,
                          )
                          if !self_host_u64_equal(nominal, 0u64) {
                            return nominal
                          }
                          let usage_nominal = self_host_linked_local_usage_nominal(
                            link,
                            module_,
                            body,
                            local_id,
                          )
                          if !self_host_u64_equal(usage_nominal, 0u64) {
                            return usage_nominal
                          }
                        }
                      }
                      continue current_local + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_linked_pattern_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  pattern_index: U32,
  local_id: U32,
  payload_hint: SelfHostPlannedValueShape,
) -> Option<SelfHostPlannedValueShape> {
  if pattern_index >= module_.patterns.length() {
    return Option::None
  }
  let root_pattern = module_.patterns[pattern_index]
  match root_pattern.source {
    SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
      link,
      module_,
      root_pattern,
      payload_hint,
      0u64,
    ) {
      Option::Some(type_index) => {
        let mut child_offset = 0u32
        let _ = while child_offset {
          current_child => if current_child < children.length {
            let child_index = self_host_u32_add(children.start, current_child)
            if child_index < module_.pattern_children.length() {
              let child_pattern_index = module_.pattern_children[child_index]
              if child_pattern_index < module_.patterns.length() {
                match module_.patterns[child_pattern_index].reference {
                  SelfHostBodyPatternReference::PatternBindingReference(
                    candidate,
                  ) => if self_host_u32_equal(candidate, local_id) {
                    return self_host_linked_physical_field_shape(
                      link,
                      type_index,
                      current_child,
                    )
                  }
                  _ => {}
                }
              }
            }
            continue current_child + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
    _ => {}
  }
  Option::None
}

fn self_host_linked_match_fallthrough_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let arm_body = module_.pattern_arms[arm_index].body
          if arm_body < module_.expressions.length() {
            let body_expression = module_.expressions[arm_body]
            match body_expression.kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                match self_host_linked_match_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  local_id,
                ) {
                  Option::Some(shape) => {
                    return Option::Some(shape)
                  }
                  Option::None => {
                    return Option::Some(
                      self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arm_body,
                      ),
                    )
                  }
                }
              }
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if value < module_.expressions.length() {
                        match module_.expressions[value].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                            match self_host_linked_match_binding_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              local_id,
                            ) {
                              Option::Some(shape) => {
                                return Option::Some(shape)
                              }
                              Option::None => {
                                return Option::Some(
                                  self_host_linked_backend_expression_shape(
                                    link,
                                    module_,
                                    body,
                                    caller_specialization,
                                    value,
                                  ),
                                )
                              }
                            }
                          }
                          _ => if module_.expressions[value].flow.falls_through {
                            let shape = match self_host_linked_exact_expression_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              value,
                            ) {
                              Option::Some(result_shape) => result_shape
                              Option::None => self_host_linked_backend_expression_shape(
                                link,
                                module_,
                                body,
                                caller_specialization,
                                value,
                              )
                            }
                            if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                              !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                              return Option::Some(shape)
                            }
                          }
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => if body_expression.flow.falls_through {
                let shape = match self_host_linked_exact_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arm_body,
                ) {
                  Option::Some(result_shape) => result_shape
                  Option::None => self_host_linked_backend_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    arm_body,
                  )
                }
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  return Option::Some(shape)
                }
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_single_nested_special_match_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  let mut selected = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut found = false
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = module_.pattern_arms[arm_index]
          if self_host_u32_greater(
            module_.expressions.length(),
            source.body,
          ) {
            match module_.expressions[source.body].kind {
              SelfHostPlannedExpressionKind::PlannedMatchExpression(
                subject,
                nested_arms,
              ) => if self_host_linked_match_returns_special_binding(
                module_,
                nested_arms,
              ) {
                match self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  subject,
                ) {
                  Option::Some(shape) => {
                    if found && self_host_linked_array_carrier_from_shape(
                      selected,
                    ) != self_host_linked_array_carrier_from_shape(shape) {
                      return Option::None
                    }
                    selected = shape
                    found = true
                  }
                  Option::None => {
                    return Option::None
                  }
                }
              } else if source.flow.falls_through {
                return Option::None
              }
              _ => if source.flow.falls_through {
                return Option::None
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if found {
    Option::Some(selected)
  } else {
    Option::None
  }
}

fn self_host_linked_scoped_match_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
  payload_hint: SelfHostPlannedValueShape,
) -> Option<SelfHostPlannedValueShape> {
  let mut selected = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut found = false
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let arm_body = module_.pattern_arms[arm_index].body
          if arm_body < module_.expressions.length() {
            let mut value = arm_body
            let mut falls_through = module_.expressions[arm_body].flow.falls_through
            match module_.expressions[arm_body].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(
                        expression,
                      ) => {
                        value = expression
                        if expression < module_.expressions.length() {
                          falls_through = module_.expressions[
                            expression
                          ].flow.falls_through
                          match module_.expressions[expression].kind {
                            SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                              falls_through = true
                            }
                            _ => {}
                          }
                        }
                      }
                      SelfHostPlannedBlockItemKind::PlannedReturnItem(_) => {
                        falls_through = false
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => {}
            }
            if falls_through && value < module_.expressions.length() {
              let shape = match module_.expressions[value].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_pattern_binding_shape(
                  link,
                  module_,
                  module_.pattern_arms[arm_index].pattern,
                  local_id,
                  payload_hint,
                ) {
                  Option::Some(binding_shape) => binding_shape
                  Option::None => if self_host_linked_pattern_binds_local(
                    module_,
                    module_.pattern_arms[arm_index].pattern,
                    local_id,
                  ) {
                    payload_hint
                  } else {
                    self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      value,
                    )
                  }
                }
                _ => self_host_linked_backend_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  value,
                )
              }
              if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                if found && self_host_linked_array_carrier_from_shape(selected) !=
                  self_host_linked_array_carrier_from_shape(shape) {
                  return Option::None
                }
                selected = shape
                found = true
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if found {
    Option::Some(selected)
  } else {
    Option::None
  }
}

fn self_host_linked_match_has_fallthrough_arm(
  module_: SelfHostPlannedModuleLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let body = module_.pattern_arms[arm_index].body
          if body < module_.expressions.length() {
            let body_expression = module_.expressions[body]
            if body_expression.flow.falls_through {
              return true
            }
            match body_expression.kind {
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if value < module_.expressions.length() {
                        match module_.expressions[value].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                            return true
                          }
                          _ => {}
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
              SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) => {}
              SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {}
              SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {}
              SelfHostPlannedExpressionKind::PlannedBreakExpression(_, _) => {}
              SelfHostPlannedExpressionKind::PlannedContinueExpression(_, _) => {}
              _ => {
                return true
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_match_uses_reference_patterns(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let pattern_index = module_.pattern_arms[arm_index].pattern
          if pattern_index < module_.patterns.length() {
            let pattern = module_.patterns[pattern_index]
            match pattern.source {
              SelfHostHirPattern::QualifiedPattern(_, _, _) => match self_host_linked_pattern_variant_type(
                link,
                module_,
                pattern,
                SelfHostPlannedValueShape::ErrorPlannedValueShape,
                0u64,
              ) {
                Option::Some(_) => {
                  return true
                }
                Option::None => {}
              }
              SelfHostHirPattern::TuplePattern(_, _, _) => match self_host_linked_pattern_variant_type(
                link,
                module_,
                pattern,
                SelfHostPlannedValueShape::ErrorPlannedValueShape,
                0u64,
              ) {
                Option::Some(_) => {
                  return true
                }
                Option::None => {}
              }
              _ => {}
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_field_container_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, field.type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      if field.field_index < physical.fields.length {
        let physical_field = self_host_linked_physical_field_at(
          physical_module,
          self_host_u32_add(physical.fields.start, field.field_index),
        )
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        for layout_field in lowering_module.type_layouts.fields {
          if self_host_u64_equal(
            layout_field.field,
            physical_field.declaration,
          ) {
            return self_host_linked_resolved_type_argument_shape(
              lowering_module,
              layout_field.type_,
              argument,
            )
          }
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_field_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
) -> Option<SelfHostPlannedValueShape> {
  self_host_linked_field_container_argument_shape(link, field, 0u32)
}

fn self_host_linked_field_container_element_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, field.type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      if field.field_index < physical.fields.length {
        let physical_field = self_host_linked_physical_field_at(
          physical_module,
          self_host_u32_add(physical.fields.start, field.field_index),
        )
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        for layout_field in lowering_module.type_layouts.fields {
          if self_host_u64_equal(
            layout_field.field,
            physical_field.declaration,
          ) {
            match lowering_module.resolved_types.type_at(layout_field.type_) {
              SelfHostResolvedType::AppliedType(_, arguments) => if self_host_u32_greater(
                arguments.length,
                0u32,
              ) && arguments.start < lowering_module.resolved_types.type_arguments.length() {
                return self_host_linked_resolved_nominal_declaration(
                  lowering_module,
                  lowering_module.resolved_types.type_arguments[arguments.start],
                )
              }
              _ => {}
            }
          }
        }
      }
    }
  }
  0u64
}


  if !self_host_u64_equal(declared, 0u64) {
    return declared
  }
  let name = self_host_linked_declaration_name(link, declaration)
  if name.ends_with(b"get_unchecked") || name.ends_with(b"indexed_get") {
    let mut source_target = target
    let mut target_depth = 0u32
    let _ = while target_depth {
      current => if current < 8u32 && source_target < module_.expressions.length() {
        match module_.expressions[source_target].kind {
          SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
            source_target,
            0u32,
          ) {
            source_target = self_host_u32_subtract(source_target, 1u32)
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
          _ => break self_host_semantic_unit()
        }
      } else {
        break self_host_semantic_unit()
      }
    }
    if source_target < module_.expressions.length() {
      let target_nominal = self_host_linked_expression_container_element_nominal_declaration(
        link,
        module_,
        body,
        source_target,
      )
      if !self_host_u64_equal(target_nominal, 0u64) {
        return target_nominal
      }
      match module_.expressions[source_target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
          let target_nominal = self_host_linked_expression_container_element_nominal_declaration(
            link,
            module_,
            body,
            base,
          )
          if !self_host_u64_equal(target_nominal, 0u64) {
            return target_nominal
          }
        }
        _ => {}
      }
    }
    if self_host_u32_greater(arguments.length, 0u32) &&
      arguments.start < module_.expression_children.length() {
      return self_host_linked_expression_container_element_nominal_declaration(
        link,
        module_,
        body,
        module_.expression_children[arguments.start],
      )
    }
  }
  0u64
}

fn self_host_linked_unresolved_method_call_result_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          let method_name = self_host_linked_module_name_at(module_, name)
          if method_name == "get_unchecked" || method_name == "indexed_get" {
            let element_nominal = self_host_linked_expression_container_element_nominal_declaration(
              link,
              module_,
              body,
              base,
            )
            if !self_host_u64_equal(element_nominal, 0u64) {
              return element_nominal
            }
          }
          match self_host_linked_method_call_index_for_receiver(
            link,
            module_,
            body,
            base,
            method_name,
          ) {
            Option::Some(physical) => if self_host_u32_greater(physical, 1u32) {
              let logical = self_host_u32_subtract(physical, 2u32)
              for function_ in link.functions {
                if self_host_u32_equal(function_.function_index, logical) {
                  return self_host_linked_callable_result_nominal_declaration(
                    link,
                    function_.declaration,
                  )
                }
              }
              0u64
            } else {
              0u64
            }
            Option::None => 0u64
          }
        } else {
          0u64
        }
        _ => 0u64
      }
    } else {
      0u64
    }
    _ => 0u64
  }
}

fn self_host_linked_expression_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  if expression >= module_.expressions.length() {
    return 0u64
  }
  let planned = module_.expressions[expression]
  if !self_host_u64_equal(planned.nominal, 0u64) {
    return planned.nominal
  }
  let type_nominal = self_host_linked_type_nominal_declaration(
    module_,
    planned.type_,
  )
  if !self_host_u64_equal(type_nominal, 0u64) {
    return type_nominal
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut local_offset = 0u32
      let _ = while local_offset {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = self_host_body_planned_local_identity(module_.locals[local_index])
            if self_host_u32_equal(local.local_id, local_id) {
              if !self_host_u64_equal(local.nominal, 0u64) {
                return local.nominal
              }
              let local_type_nominal = self_host_linked_type_nominal_declaration(
                module_,
                local.type_,
              )
              if !self_host_u64_equal(local_type_nominal, 0u64) {
                return local_type_nominal
              }
              if local.kind is SelfHostBodyLocalKind::ParameterLocal {
                let parameter_nominal = self_host_linked_local_parameter_nominal_declaration(
                  link,
                  module_,
                  body,
                  local_id,
                )
                if !self_host_u64_equal(parameter_nominal, 0u64) {
                  return parameter_nominal
                }
              }
              if local.kind is SelfHostBodyLocalKind::ParameterLocal &&
                self_host_u32_equal(local_id, 0u32) {
                match self_host_program_specialization_callable(
                  module_,
                  body.declaration,
                ) {
                  Option::Some(callable) => if callable.has_receiver {
                    let receiver_nominal = self_host_linked_resolved_nominal_declaration(
                      module_,
                      callable.self_type,
                    )
                    if !self_host_u64_equal(receiver_nominal, 0u64) {
                      return receiver_nominal
                    }
                  }
                  Option::None => {}
                }
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let loop_nominal = self_host_linked_loop_binding_nominal_declaration(
        link,
        module_,
        body,
        local_id,
      )
      if !self_host_u64_equal(loop_nominal, 0u64) {
        return loop_nominal
      }
      let pattern_nominal = self_host_linked_local_direct_pattern_nominal(
        link,
        module_,
        body,
        local_id,
      )
      if !self_host_u64_equal(pattern_nominal, 0u64) {
        return pattern_nominal
      }
      match self_host_linked_local_source_expression(
        module_,
        body,
        local_id,
      ) {
        Option::Some(source) => self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
        Option::None => 0u64
      }
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => self_host_linked_direct_call_result_nominal_declaration(
      link,
      module_,
      body,
      declaration,
      target,
      arguments,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
      let method_nominal = self_host_linked_unresolved_method_call_result_nominal_declaration(
        link,
        module_,
        body,
        expression,
      )
      if !self_host_u64_equal(method_nominal, 0u64) {
        return method_nominal
      }
      let declaration = match planned.call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
        _ => self_host_body_qualified_call_declaration(
          link,
          module_,
          expression,
        )
      }
      if self_host_u64_equal(declaration, 0u64) {
        0u64
      } else {
        self_host_linked_callable_result_nominal_declaration(
          link,
          declaration,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, selection) => match selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
        declaration,
        _,
      ) => declaration
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
        declaration,
        _,
        _,
      ) => declaration
      _ => 0u64
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedIfExpression(_, then_block, else_expression) => {
      let then_tail = self_host_body_block_tail_expression(module_, then_block)
      let then_nominal = if self_host_u32_equal(then_tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          then_tail,
        )
      }
      if !self_host_u64_equal(then_nominal, 0u64) {
        then_nominal
      } else {
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          else_expression,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
      let mut selected = 0u64
      let mut arm = 0u32
      let _ = while arm {
        current => if current < arms.length {
          let child = self_host_u32_add(arms.start, current)
          if child < module_.arm_children.length() {
            let arm_index = module_.arm_children[child]
            if arm_index < module_.pattern_arms.length() {
              let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
              if source.flow.falls_through {
                let nominal = self_host_linked_expression_nominal_declaration(
                  link,
                  module_,
                  body,
                  source.body,
                )
                if !self_host_u64_equal(nominal, 0u64) {
                  if !self_host_u64_equal(selected, 0u64) && !self_host_u64_equal(
                    selected,
                    nominal,
                  ) {
                    return 0u64
                  }
                  selected = nominal
                }
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      selected
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => self_host_linked_match_subject_nominal_declaration(
      link,
      module_,
      body,
      expression,
    )
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => {
      let declared = self_host_linked_declared_field_value_nominal_declaration(
        link,
        field,
      )
      if !self_host_u64_equal(declared, 0u64) {
        declared
      } else {
        match self_host_linked_struct_field(link, field) {
          Option::Some(field_link) => self_host_linked_field_value_nominal_declaration(
            link,
            field_link,
          )
          Option::None => 0u64
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      let base_nominal = self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        base,
      )
      match self_host_linked_field_by_name(
        link,
        base_nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => self_host_linked_field_value_nominal_declaration(
          link,
          field_link,
        )
        Option::None => 0u64
      }
    } else {
      0u64
    }
    _ => 0u64
  }
}

fn self_host_linked_match_subject_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  subject: U32,
) -> U64 {
  if subject >= module_.expressions.length() {
    return 0u64
  }
  let planned = module_.expressions[subject]
  if !self_host_u64_equal(planned.nominal, 0u64) {
    return planned.nominal

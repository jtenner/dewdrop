fn self_host_linked_i32_unsigned_shape(
  shape: SelfHostPlannedValueShape,
) -> Bool {
  match shape {
    SelfHostPlannedValueShape::U8PlannedValueShape => true
    SelfHostPlannedValueShape::U16PlannedValueShape => true
    SelfHostPlannedValueShape::U32PlannedValueShape => true
    _ => false
  }
}

fn self_host_linked_integer_unsigned_shape(
  shape: SelfHostPlannedValueShape,
) -> Bool {
  self_host_linked_i32_unsigned_shape(shape) ||
    shape is SelfHostPlannedValueShape::U64PlannedValueShape
}

fn self_host_linked_integer_signed_shape(
  shape: SelfHostPlannedValueShape,
) -> Bool {
  shape is SelfHostPlannedValueShape::I8PlannedValueShape ||
    shape is SelfHostPlannedValueShape::I16PlannedValueShape ||
    shape is SelfHostPlannedValueShape::I32PlannedValueShape ||
    shape is SelfHostPlannedValueShape::I64PlannedValueShape
}

fn self_host_linked_declared_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> Option<SelfHostPlannedValueShape> {
  for module_ in link.fragments.specialization.lowering.modules {
    let fields = module_.type_layouts.fields
    let mut index = 0u32
    let _ = while index {
      current => if current < fields.length() {
        let layout = self_host_planned_field_layout_at(fields, current)
        if self_host_u64_equal(layout.field, field) {
          return Option::Some(layout.shape)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_logical_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  depth: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() || depth >= 8u32 {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let planned = module_.expressions[expression]
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_declared_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => return shape
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_callable_declared_result_shape(
      link,
      declaration,
    ) {
      Option::Some(shape) => return shape
      Option::None => {}
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => match planned.call_target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(
        declaration,
        _,
      ) => match self_host_linked_callable_declared_result_shape(
        link,
        declaration,
      ) {
        Option::Some(shape) => return shape
        Option::None => {}
      }
      _ => {}
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_initializer_expression(
      module_,
      body,
      local,
    ) {
      Option::Some(initializer) => {
        let shape = self_host_linked_logical_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          initializer,
          depth + 1u32,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      Option::None => match self_host_linked_local_declared_shape(
        module_,
        body,
        local,
      ) {
        Option::Some(shape) => return shape
        Option::None => match self_host_linked_local_parameter_shape(
          link,
          module_,
          body,
          caller_specialization,
          local,
        ) {
          Option::Some(shape) => return shape
          Option::None => {}
        }
      }
    }
    _ => {}
  }
  let _ = caller_specialization
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    planned.type_,
  )
}

// This compile-time assertion keeps the source integer meaning after the
// physical plan merges signed and unsigned values into one Wasm carrier.
// A signed and unsigned pair is not valid. The compiler must stop before it
// emits an instruction with an unproved sign mode.
fn self_host_linked_integer_binary_unsigned_proof(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  left: U32,
  right: U32,
  fallback: Bool,
) -> Result<Bool, String> {
  let logical_left = self_host_linked_logical_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    left,
    0u32,
  )
  let logical_right = self_host_linked_logical_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    right,
    0u32,
  )
  let left_unsigned = self_host_linked_integer_unsigned_shape(logical_left)
  let right_unsigned = self_host_linked_integer_unsigned_shape(logical_right)
  let left_signed = self_host_linked_integer_signed_shape(logical_left)
  let right_signed = self_host_linked_integer_signed_shape(logical_right)
  if (left_unsigned && right_signed) || (right_unsigned && left_signed) {
    Result::Err("linked integer binary operands have different sign modes")
  } else if left_unsigned || right_unsigned {
    Result::Ok(true)
  } else {
    Result::Ok(fallback)
  }
}


// Receiver source types are the primary proof for Array pop carriers.
// Call substitutions and match uses are fallback proofs only.

fn self_host_linked_iterator_next_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) &&
          self_host_linked_module_name_at(module_, name) == "next" {
          let inferred = match self_host_linked_type_first_argument_shape(
            module_,
            self_host_planned_expression_at(module_.expressions, base).type_,
          ) {
            Option::Some(shape) => shape
            Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          Option::Some(
            self_host_linked_source_or_inferred_item_shape(
              self_host_linked_expression_preferred_container_element_shape(
                link,
                module_,
                body,
                base,
              ),
              inferred,
            ),
          )
        } else {
          Option::None
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_iterator_pattern_use_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  initial: U32,
) -> Option<SelfHostPlannedValueShape> {
  let initial_source = if initial < module_.expressions.length() &&
    module_.expressions[initial].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
    self_host_u32_greater(initial, 0u32) {
    self_host_u32_subtract(initial, 1u32)
  } else {
    initial
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, candidate, arms) => {
          let candidate_source = if candidate < module_.expressions.length() &&
            module_.expressions[candidate].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
            self_host_u32_greater(candidate, 0u32) {
            self_host_u32_subtract(candidate, 1u32)
          } else {
            candidate
          }
          if self_host_u32_equal(candidate_source, initial_source) {
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root_index = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root_index < module_.patterns.length() {
                      let root = self_host_planned_pattern_at(module_.patterns, root_index)
                      let children = match root.source {
                        SelfHostHirPattern::TuplePattern(_, span, _) => span
                        _ => SelfHostHirSpan::{
                          start: 0u32
                          length: 0u32
                        }
                      }
                      let mut pattern = 0u32
                      let _ = while pattern {
                        offset => if offset < children.length {
                          let pattern_child = self_host_u32_add(children.start, offset)
                          if pattern_child < module_.pattern_children.length() {
                            let pattern_index = module_.pattern_children[pattern_child]
                            if pattern_index < module_.patterns.length() {
                              match self_host_planned_pattern_at(module_.patterns, pattern_index).reference {
                                SelfHostBodyPatternReference::PatternBindingReference(local) => match self_host_linked_local_index_operand_shape(
                                  link,
                                  module_,
                                  body,
                                  caller_specialization,
                                  local,
                                ) {
                                  Option::Some(shape) => return Option::Some(shape)
                                  Option::None => match self_host_linked_local_scalar_use_shape(
                                    link,
                                    module_,
                                    body,
                                    caller_specialization,
                                    local,
                                  ) {
                                    Option::Some(shape) => if !(
                                      self_host_physical_scalar_shape(shape) is SelfHostPlannedValueShape::RefPlannedValueShape
                                    ) {
                                      return Option::Some(shape)
                                    }
                                    Option::None => {}
                                  }
                                }
                                _ => {}
                              }
                            }
                          }
                          continue offset + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_unresolved_receiver_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
          let receiver = if base < module_.expressions.length() &&
            module_.expressions[base].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
            self_host_u32_greater(base, 0u32) {
            self_host_u32_subtract(base, 1u32)
          } else {
            base
          }
          self_host_linked_expression_container_argument_shape(
            link,
            module_,
            body,
            receiver,
            argument,
          )
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_is_unresolved_get_unchecked(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => name < self_host_linked_module_name_count(
          module_,
        ) && self_host_linked_module_name_at(module_, name) == "get_unchecked"
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_is_unresolved_map_get(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => name < self_host_linked_module_name_count(
          module_,
        ) && self_host_linked_module_name_at(module_, name) == "get"
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_exact_call_result_payload_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  root: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if root >= module_.expressions.length() {
    return Option::None
  }
  let call_index = match module_.expressions[root].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      root,
      declaration,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
      let exact_call = self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        root,
        0u64,
      )
      match exact_call {
        Option::Some(value) => Option::Some(value)
        Option::None => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(module_) {
              self_host_linked_method_call_index_for_receiver(
                link,
                module_,
                body,
                base,
                self_host_linked_module_name_at(module_, name),
              )
            } else {
              Option::None
            }
            _ => Option::None
          }
        } else {
          Option::None
        }
      }
    }
    _ => Option::None
  }
  match call_index {
    Option::Some(function_index) => self_host_linked_physical_result_argument_shape(
        link,
        function_index,
        argument,
      )
    Option::None => Option::None
  }
}

fn self_host_linked_map_get_value_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      if self_host_linked_is_unresolved_map_get(module_, expression) {
        return self_host_linked_unresolved_receiver_argument_shape(
          link,
          module_,
          body,
          expression,
          1u32,
        )
      }
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          target,
          arguments,
          _,
        ) => if self_host_linked_declaration_name(
          link,
          declaration,
        ).ends_with(b"get") {
          let mut receiver = 4294967295u32
          if target < module_.expressions.length() {
            match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => {
                receiver = base
              }
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
                receiver = base
              }
              SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                target,
                0u32,
              ) {
                receiver = self_host_u32_subtract(target, 1u32)
              }
              _ => {}
            }
          }
          if self_host_u32_equal(receiver, 4294967295u32) &&
            self_host_u32_greater(arguments.length, 0u32) &&
            arguments.start < module_.expression_children.length() {
            receiver = module_.expression_children[arguments.start]
          }
          if self_host_u32_equal(receiver, 4294967295u32) {
            return Option::None
          }
          return self_host_linked_expression_container_argument_shape(
            link,
            module_,
            body,
            receiver,
            1u32,
          )
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => {
            return Option::None
          }
        }
        _ => {
          return Option::None
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}



fn self_host_linked_is_unresolved_array_push(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => if target < module_.expressions.length() &&
      self_host_u32_equal(arguments.length, 1u32) {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => name < self_host_linked_module_name_count(
          module_,
        ) && self_host_linked_module_name_at(module_, name) == "push"
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_local_is_pattern(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.locals.length {
      let index = self_host_u32_add(body.locals.start, current)
      if index < module_.locals.length() {
        let local = self_host_body_planned_local_identity(module_.locals[index])
        if self_host_u32_equal(local.local_id, local_id) {
          return local.kind is SelfHostBodyLocalKind::PatternLocal
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_specialized_call_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      let shape = self_host_linked_physical_function_result_shape(
        link,
        self_host_linked_physical_function_index(call.function_index),
      )
      if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
        return Option::Some(shape)
      }
    }
  }
  Option::None
}

fn self_host_linked_direct_receiver_expression(
  module_: SelfHostPlannedModuleLowering,
  target: U32,
) -> Option<U32> {
  if target >= module_.expressions.length() {
    return Option::None
  }
  let base = self_host_planned_expression_at(module_.expressions, target).member_base
  if base < module_.expressions.length() &&
    !self_host_body_name_reference_is_namespace(module_.expressions[base].reference) {
    Option::Some(base)
  } else {
    Option::None
  }
}

fn self_host_linked_selected_call_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  declaration: U64,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_linked_i32_call_index(
    link,
    caller_body,
    caller_specialization,
    expression,
    declaration,
  ) {
    Option::Some(function_index) => {
      let shape = self_host_linked_physical_function_result_shape(link, function_index)
      if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
        Option::None
      } else {
        Option::Some(shape)
      }
    }
    Option::None => Option::None
  }
}

fn self_host_linked_unresolved_get_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      let mut name = module_.expressions[target].source_name
      let base = match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, field_name) => {
          name = field_name
          value
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          target,
          0u32,
        ) {
          target - 1u32
        } else {
          return Option::None
        }
        _ => {
          return Option::None
        }
      }
      if base < module_.expressions.length() &&
        name < self_host_linked_module_name_count(module_) &&
        self_host_linked_module_name_at(module_, name) == "get_unchecked" {
        let direct_owner = self_host_linked_type_owner_module_id(
          link,
          module_,
          self_host_planned_expression_at(module_.expressions, base).type_,
        )
        let owner = if self_host_u64_equal(direct_owner, 0u64) {
          self_host_linked_expression_container_owner_module_id(
            link,
            module_,
            body,
            base,
          )
        } else {
          direct_owner
        }
        let argument = if self_host_u64_equal(owner, link.map_module_id) {
          1u32
        } else {
          0u32
        }
        self_host_linked_unresolved_receiver_argument_shape(
          link,
          module_,
          body,
          expression,
          argument,
        )
      } else {
        Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_array_push_item_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  item: U32,
) -> SelfHostPlannedValueShape {
  if item < module_.expressions.length() {
    match module_.expressions[item].kind {
      SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
        item,
        0u32,
      ) {
        return self_host_linked_array_push_item_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          self_host_u32_subtract(item, 1u32),
        )
      }
      SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
        let tail = self_host_body_block_tail_expression(module_, block)
        if !self_host_u32_equal(tail, 4294967295u32) {
          return self_host_linked_array_push_item_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            tail,
          )
        }
      }
      _ => {}
    }
    // An index read uses the container element carrier at emission time.
    // Do not let a broad generic call result replace a concrete scalar carrier.
    match module_.expressions[item].kind {
      SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => match self_host_linked_expression_source_container_element_shape(
        link,
        module_,
        body,
        base,
      ) {
        Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          shape is SelfHostPlannedValueShape::NeverPlannedValueShape
        ) {
          return shape
        }
        Option::None => if !(
          self_host_physical_scalar_shape(
            module_.expressions[item].shape,
          ) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) {
          return module_.expressions[item].shape
        }
      }
      _ => {}
    }
    match self_host_linked_specialized_call_result_shape(
      link,
      body.body,
      caller_specialization,
      item,
    ) {
      Option::Some(shape) => {
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
          !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
          !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
          return shape
        }
      }
      Option::None => {}
    }
    let physical_item_shape = self_host_linked_variant_payload_shape(
      link,
      module_,
      body,
      item,
    )
    if !(physical_item_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
      physical_item_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
    ) && !(physical_item_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
      return physical_item_shape
    }
    match module_.expressions[item].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
        match self_host_linked_local_index_operand_shape(
          link,
          module_,
          body,
          caller_specialization,
          local_id,
        ) {
          Option::Some(shape) => if !(
            self_host_physical_scalar_shape(shape) is SelfHostPlannedValueShape::RefPlannedValueShape
          ) {
            return shape
          }
          Option::None => {}
        }
        if self_host_linked_local_is_pattern(
          module_,
          body,
          local_id,
        ) {
          match self_host_linked_loop_binding_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
          ) {
            Option::Some(shape) => {
              return shape
            }
            Option::None => match self_host_linked_match_binding_shape(
              link,
              module_,
              body,
              caller_specialization,
              local_id,
            ) {
              Option::Some(shape) => {
                return shape
              }
              Option::None => {}
            }
          }
        } else {
          match self_host_linked_local_initializer_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
          ) {
            Option::Some(shape) => {
              return shape
            }
            Option::None => match self_host_linked_local_assignment_shape(
              link,
              module_,
              body,
              caller_specialization,
              local_id,
            ) {
              Option::Some(shape) => {
                return shape
              }
              Option::None => {}
            }
          }
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
        match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
            module_,
          ) {
            match self_host_linked_method_call_index_for_receiver(
              link,
              module_,
              body,
              base,
              self_host_linked_module_name_at(module_, name),
            ) {
              Option::Some(function_index) => {
                let shape = self_host_linked_physical_function_result_shape(
                  link,
                  function_index,
                )
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
                  return shape
                }
              }
              Option::None => {}
            }
          }
          _ => {}
        }
      }
      SelfHostPlannedExpressionKind::PlannedDirectCall(
        declaration,
        _,
        _,
        _,
      ) => match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        item,
        declaration,
      ) {
        Option::Some(function_index) => {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
            !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
            return shape
          }
        }
        Option::None => {}
      }
      SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
        let shape = self_host_linked_variant_payload_shape(
          link,
          module_,
          body,
          item,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
        let shape = self_host_linked_variant_payload_shape(
          link,
          module_,
          body,
          item,
        )
        if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return shape
        }
      }
      _ => {}
    }
    let shape = self_host_linked_backend_expression_shape(
      link,
      module_,
      body,
      caller_specialization,
      item,
    )
    if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
      return shape
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_unresolved_array_push_item_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
        if self_host_u32_greater(arguments.length, 0u32) &&
          arguments.start < module_.expression_children.length() {
          let item = module_.expression_children[arguments.start]
          if item < module_.expressions.length() {
            match module_.expressions[item].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                match self_host_linked_local_initializer_expression(
                  module_,
                  body,
                  local_id,
                ) {
                  Option::Some(initializer) => if initializer < module_.expressions.length() {
                    match module_.expressions[initializer].kind {
                      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
                        initializer_target,
                        _,
                      ) => if initializer_target < module_.expressions.length() {
                        match module_.expressions[initializer_target].kind {
                          SelfHostPlannedExpressionKind::PlannedUnresolvedField(
                            initializer_base,
                            initializer_name,
                          ) => if initializer_name < self_host_linked_module_name_count(
                            module_,
                          ) {
                            match self_host_linked_method_call_index_for_receiver(
                              link,
                              module_,
                              body,
                              initializer_base,
                              self_host_linked_module_name_at(
                                module_,
                                initializer_name,
                              ),
                            ) {
                              Option::Some(function_index) => {
                                let shape = self_host_linked_physical_function_result_shape(
                                  link,
                                  function_index,
                                )
                                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                                  shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                                ) {
                                  return shape
                                }
                              }
                              Option::None => {}
                            }
                          }
                          _ => {}
                        }
                      }
                      _ => {}
                    }
                  }
                  Option::None => {}
                }
                match self_host_linked_local_scalar_use_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  local_id,
                ) {
                  Option::Some(shape) => {
                    return shape
                  }
                  Option::None => match self_host_linked_local_declared_shape(
                    module_,
                    body,
                    local_id,
                  ) {
                    Option::Some(shape) => {
                      return shape
                    }
                    Option::None => match self_host_linked_local_runtime_reference_shape(
                      module_,
                      body,
                      local_id,
                    ) {
                      Option::Some(shape) => {
                        return shape
                      }
                      Option::None => match self_host_linked_match_binding_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        local_id,
                      ) {
                        Option::Some(shape) => if self_host_physical_scalar_shape(
                          shape,
                        ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                          return shape
                        }
                        Option::None => {}
                      }
                    }
                  }
                }
              }
              _ => {}
            }
          }
        }
        if self_host_u32_greater(arguments.length, 0u32) &&
          arguments.start < module_.expression_children.length() {
          let item = module_.expression_children[arguments.start]
          let item_shape = self_host_linked_array_push_item_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            item,
          )
          if !(item_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return item_shape
          }
        }
        if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
              name < self_host_linked_module_name_count(module_) &&
              self_host_linked_module_name_at(module_, name) == "push" {
              match self_host_linked_expression_container_element_shape(
                link,
                module_,
                body,
                base,
              ) {
                Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                  return shape
                }
                Option::None => {}
              }
            }
            _ => {}
          }
        }
        if self_host_u32_greater(arguments.length, 0u32) &&
          arguments.start < module_.expression_children.length() {
          let item = module_.expression_children[arguments.start]
          if item < module_.expressions.length() {
            match module_.expressions[item].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_loop_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => match self_host_linked_match_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  local_id,
                ) {
                  Option::Some(shape) => {
                    return shape
                  }
                  Option::None => {}
                }
              }
              _ => {}
            }
          }
        }
        if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
              name < self_host_linked_module_name_count(module_) &&
              self_host_linked_module_name_at(module_, name) == "push" {
              match self_host_linked_expression_container_element_shape(
                link,
                module_,
                body,
                base,
              ) {
                Option::Some(shape) => {
                  return shape
                }
                Option::None => match self_host_linked_type_first_argument_shape(
                  module_,
                  self_host_planned_expression_at(module_.expressions, base).type_,
                ) {
                  Option::Some(shape) => {
                    return shape
                  }
                  Option::None => {}
                }
              }
            }
            _ => {}
          }
        }
        if self_host_u32_greater(arguments.length, 0u32) &&
          arguments.start < module_.expression_children.length() {
          let item = module_.expression_children[arguments.start]
          let shape = self_host_linked_backend_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            item,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return shape
          }
        }
      }
      _ => {}
    }
  }
  SelfHostPlannedValueShape::I32PlannedValueShape
}

fn self_host_linked_expression_is_map_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => {
            return false
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          let name = self_host_linked_declaration_name(link, declaration)
          return name.starts_with(b"dew_map_") || name.ends_with(b"_map") ||
            self_host_u64_equal(
              self_host_linked_callable_result_owner_module_id(
                link,
                declaration,
              ),
              link.map_module_id,
            )
        }
        SelfHostPlannedExpressionKind::PlannedBuiltinCall(
          name,
          _,
          _,
          _,
          _,
        ) => {
          return name.starts_with(b"dew_map_")
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
          return false
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
          return false
        }
        _ => {
          return false
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_array_constructor_name(name: Bytes) -> Bool {
  name.equals(b"new") || name.equals(b"with_capacity") ||
    name.equals(b"array_new") || name.equals(b"array_with_capacity")
}

fn self_host_linked_expression_is_array_constructor_at(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  depth: U32,
) -> Bool {
  if depth >= 8u32 || expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      expression,
      0u32,
    ) {
      self_host_linked_expression_is_array_constructor_at(
        link,
        module_,
        self_host_u32_subtract(expression, 1u32),
        depth + 1u32,
      )
    } else {
      false
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_linked_expression_is_array_constructor_at(
      link,
      module_,
      self_host_body_block_tail_expression(module_, block),
      depth + 1u32,
    )
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => true
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      result_declaration,
      _,
      _,
      _,
    ) => self_host_u64_equal(
      self_host_linked_declaration_owner_module_id(
        link,
        result_declaration,
      ),
      link.array_module_id,
    ) && self_host_linked_array_constructor_name(
      self_host_linked_declaration_name(link, result_declaration),
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
      let result_declaration = match module_.expressions[expression].call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
        _ => self_host_body_qualified_call_declaration(
          link,
          module_,
          expression,
        )
      }
      !self_host_u64_equal(result_declaration, 0u64) && self_host_u64_equal(
        self_host_linked_declaration_owner_module_id(
          link,
          result_declaration,
        ),
        link.array_module_id,
      ) && self_host_linked_array_constructor_name(
        self_host_linked_declaration_name(link, result_declaration),
      )
    }
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(name, _, _, _, _) => self_host_linked_array_constructor_name(
      name,
    )
    _ => false
  }
}

fn self_host_linked_callable_body_returns_array_value(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Bool {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(value) => value
    Option::None => return false
  }
  if owner >= link.fragments.specialization.lowering.modules.length() {
    return false
  }
  let module_ = link.fragments.specialization.lowering.modules[owner]
  let callable = match self_host_program_specialization_callable(
    module_,
    declaration,
  ) {
    Option::Some(value) => value
    Option::None => return false
  }
  let body_id = match self_host_program_specialization_callable_body(callable) {
    Option::Some(value) => value
    Option::None => return false
  }
  let body = match self_host_program_specialization_body(module_, body_id) {
    Option::Some(value) => value
    Option::None => return false
  }
  let expression = match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(value) => value
    SelfHostHirBodyRoot::BlockBodyRoot(block) => self_host_body_block_tail_expression(
      module_,
      block,
    )
  }
  self_host_linked_expression_is_array_constructor_at(
    link,
    module_,
    expression,
    0u32,
  )
}

fn self_host_linked_expression_is_array_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      let result_nominal = self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        expression,
      )
      if !self_host_u64_equal(result_nominal, 0u64) && self_host_u64_equal(
        self_host_linked_declaration_owner_module_id(link, result_nominal),
        link.array_module_id,
      ) {
        return true
      }
      match planned.call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => if self_host_u64_equal(
          self_host_linked_callable_result_owner_module_id(link, declaration),
          link.array_module_id,
        ) {
          return true
        }
        _ => {}
      }
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return false
        }
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          expression = self_host_body_block_tail_expression(module_, block)
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
          return true
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => {
            return false
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          return self_host_u64_equal(
            self_host_linked_callable_result_owner_module_id(
              link,
              declaration,
            ),
            link.array_module_id,
          ) || self_host_linked_callable_body_returns_array_value(
            link,
            declaration,
          )
        }
        _ => {
          return false
        }
      }
      continue current + 1u32
    } else {
      break false
    }
  }
  false
}

fn self_host_linked_array_literal_use_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  literal: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut local_id = 4294967295u32
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut item = 0u32
        let _ = while item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(value, literal) {
                  local_id = candidate
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if self_host_linked_is_unresolved_array_push(module_, expression) {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => if target < module_.expressions.length() {
            match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
                let mut same = self_host_u32_equal(base, literal)
                if !same && !self_host_u32_equal(
                  local_id,
                  4294967295u32,
                ) && base < module_.expressions.length() {
                  same = self_host_linked_expression_wraps_local(
                    module_,
                    base,
                    local_id,
                  )
                }
                if same && self_host_u32_greater(arguments.length, 0u32) &&
                  arguments.start < module_.expression_children.length() {
                  let item_expression = module_.expression_children[arguments.start]
                  let inferred_shape = match self_host_linked_expression_container_element_shape(
                    link,
                    module_,
                    body,
                    base,
                  ) {
                    Option::Some(value) => value
                    Option::None => self_host_linked_array_push_item_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      item_expression,
                    )
                  }
                  let shape = self_host_linked_canonical_or_inferred_shape(
                    canonical,
                    item_expression,
                    inferred_shape,
                  )
                  if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                    return Option::Some(shape)
                  }
                }
              }
              _ => {}
            }
          }
          _ => {}
        }
      } else {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            target,
            arguments,
            _,
          ) => if self_host_linked_declaration_name(
            link,
            declaration,
          ).ends_with(b"push") && target < module_.expressions.length() {
            let method_base = match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => value
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => value
              SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                target,
                0u32,
              ) {
                self_host_u32_subtract(target, 1u32)
              } else {
                4294967295u32
              }
              _ => 4294967295u32
            }
            let base = if !self_host_u32_equal(method_base, 4294967295u32) {
              method_base
            } else if self_host_u32_equal(arguments.length, 2u32) &&
              arguments.start < module_.expression_children.length() {
              module_.expression_children[arguments.start]
            } else {
              4294967295u32
            }
            let mut same = self_host_u32_equal(base, literal)
            if !same && !self_host_u32_equal(
              local_id,
              4294967295u32,
            ) && base < module_.expressions.length() {
              same = self_host_linked_expression_wraps_local(
                module_,
                base,
                local_id,
              )
            }
            let item_index = if self_host_u32_equal(arguments.length, 2u32) {
              self_host_u32_add(arguments.start, 1u32)
            } else {
              arguments.start
            }
            if same && self_host_u32_greater(arguments.length, 0u32) &&
              item_index < module_.expression_children.length() {
              let item_expression = module_.expression_children[item_index]
              let inferred_shape = match self_host_linked_expression_container_element_shape(
                link,
                module_,
                body,
                base,
              ) {
                Option::Some(value) => value
                Option::None => self_host_linked_array_push_item_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  item_expression,
                )
              }
              let shape = self_host_linked_canonical_or_inferred_shape(
                canonical,
                item_expression,
                inferred_shape,
              )
              if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return Option::Some(shape)
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedIndexSet(
            base,
            _,
            value,
            _,
          ) => {
            let mut same = self_host_u32_equal(base, literal)
            if !same && !self_host_u32_equal(local_id, 4294967295u32) &&
              base < module_.expressions.length() {
              same = self_host_linked_expression_wraps_local(
                module_,
                base,
                local_id,
              )
            }
            if same && value < module_.expressions.length() {
              let recovered_shape = self_host_linked_call_argument_shape(
                link,
                canonical,
                module_,
                body,
                caller_specialization,
                value,
              )
              let inferred_shape = if recovered_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                self_host_linked_static_expression_shape(link, module_, value)
              } else {
                recovered_shape
              }
              let shape = self_host_linked_canonical_or_inferred_shape(
                canonical,
                value,
                inferred_shape,
              )
              if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return Option::Some(shape)
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedBuiltinCall(
            builtin_name,
            _,
            target,
            arguments,
            _,
          ) => if builtin_name.ends_with(b"push") && target < module_.expressions.length() {
            let method_base = match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => value
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => value
              SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
                target,
                0u32,
              ) {
                self_host_u32_subtract(target, 1u32)
              } else {
                4294967295u32
              }
              _ => 4294967295u32
            }
            let base = if !self_host_u32_equal(method_base, 4294967295u32) {
              method_base
            } else if self_host_u32_equal(arguments.length, 2u32) &&
              arguments.start < module_.expression_children.length() {
              module_.expression_children[arguments.start]
            } else {
              4294967295u32
            }
            let mut same = self_host_u32_equal(base, literal)
            if !same && !self_host_u32_equal(local_id, 4294967295u32) &&
              base < module_.expressions.length() {
              same = self_host_linked_expression_wraps_local(
                module_,
                base,
                local_id,
              )
            }
            let item_index = if self_host_u32_equal(arguments.length, 2u32) {
              self_host_u32_add(arguments.start, 1u32)
            } else {
              arguments.start
            }
            if same && self_host_u32_greater(arguments.length, 0u32) &&
              item_index < module_.expression_children.length() {
              let item_expression = module_.expression_children[item_index]
              let inferred_shape = self_host_linked_array_push_item_expression_shape(
                link,
                module_,
                body,
                caller_specialization,
                item_expression,
              )
              let shape = self_host_linked_canonical_or_inferred_shape(
                canonical,
                item_expression,
                inferred_shape,
              )
              if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                return Option::Some(shape)
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_array_value_use_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  root: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut source = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && source < module_.expressions.length() {
      match module_.expressions[source].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
          match self_host_linked_local_call_container_argument_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
            0u32,
          ) {
            Option::Some(shape) => return Option::Some(shape)
            Option::None => {}
          }
          match self_host_linked_local_source_expression(
            module_,
            body,
            local_id,
          ) {
            Option::Some(value) => {
              source = value
            }
            Option::None => {
              break self_host_semantic_unit()
            }
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
              module_,
            ) && self_host_linked_module_name_at(module_, name) == "iter" {
              source = base
            } else {
              break self_host_semantic_unit()
            }
            _ => {
              break self_host_semantic_unit()
            }
          }
        } else {
          break self_host_semantic_unit()
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          target,
          arguments,
          _,
        ) => if self_host_linked_declaration_name(link, declaration).ends_with(b"iter") {
          if target < module_.expressions.length() {
            match module_.expressions[target].kind {
              SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => {
                source = base
              }
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
                source = base
              }
              _ => if self_host_u32_greater(arguments.length, 0u32) && arguments.start < module_.expression_children.length() {
                source = module_.expression_children[arguments.start]
              } else {
                break self_host_semantic_unit()
              }
            }
          } else if self_host_u32_greater(arguments.length, 0u32) && arguments.start < module_.expression_children.length() {
            source = module_.expression_children[arguments.start]
          } else {
            break self_host_semantic_unit()
          }
        } else {
          break self_host_semantic_unit()
        }
        _ => {
          break self_host_semantic_unit()
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_linked_array_literal_use_shape(
    link,
    module_,
    body,
    caller_specialization,
    canonical,
    source,
  )
}



fn self_host_linked_i32_scratch_count(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let plan = self_host_physical_scratch_plan(canonical, module_, body, 4294967295u32, 0u32)
  plan.scratches.length()
}

fn self_host_linked_expression_wraps_local(
  module_: SelfHostPlannedModuleLowering,
  root: U32,
  local_id: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => return self_host_u32_equal(
          candidate,
          local_id,
        )
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            return false
          }
          expression = tail
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return false
        }
        SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, operand) => {
          expression = operand
        }
        _ => return false
      }
      continue current + 1u32
    } else {
      break false
    }
  }
  false
}

fn self_host_linked_expression_is_string_constant(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedStringConst(_) => return true
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return false
        }
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            return false
          }
          expression = tail
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => return false
        }
        _ => return false
      }
      continue current + 1u32
    } else {
      break false
    }
  }
  false
}

fn self_host_linked_expression_is_string_value(module_: SelfHostPlannedModuleLowering, expression: U32) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  // String identity comes from the resolved logical type, not whether an
  // operand happens to be a literal. Eqref is only its physical carrier.
  self_host_u32_equal(self_host_linked_body_primitive_rank(module_, module_.expressions[expression].type_), 9u32)
}

fn self_host_linked_expression_wraps_expression(
  module_: SelfHostPlannedModuleLowering,
  root: U32,
  target: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      if self_host_u32_equal(expression, target) {
        return true
      }
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            return false
          }
          expression = tail
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          return false
        }
        _ => return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_expression_is_let_value(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(_, _, value) => if self_host_linked_expression_wraps_expression(
                  module_,
                  value,
                  expression,
                ) {
                  return true
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_let_value_shape(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_linked_expression_wraps_expression(
                  module_,
                  value,
                  expression,
                ) {
                  let mut local_offset = 0u32
                  let _ = while local_offset {
                    current_local => if current_local < body.locals.length {
                      let local_index = self_host_u32_add(
                        body.locals.start,
                        current_local,
                      )
                      if local_index < module_.locals.length() {
                        let local = self_host_body_planned_local_identity(module_.locals[local_index])
                        if self_host_u32_equal(local.local_id, local_id) {
                          if !(local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                            return Option::Some(local.shape)
                          }
                          let inferred = self_host_planned_merged_body_value_shape(
                            module_.resolved_types,
                            module_.inferred,
                            local.type_,
                          )
                          if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                            return Option::Some(inferred)
                          }
                        }
                      }
                      continue current_local + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_canonical_materialized_local_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return Option::None
  }
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_linked_expression_wraps_expression(
                  module_,
                  value,
                  expression,
                ) {
                  let slot = self_host_body_local_slot(module_, body, local_id)
                  if slot < plan.local_values.length() {
                    return Option::Some(self_host_body_carrier_shape(
                      plan.local_values[slot].carrier,
                    ))
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let candidate = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[candidate].kind {
        SelfHostPlannedExpressionKind::PlannedLocalSet(local_id, value) => if self_host_linked_expression_wraps_expression(
          module_,
          value,
          expression,
        ) {
          let slot = self_host_body_local_slot(module_, body, local_id)
          if slot < plan.local_values.length() {
            return Option::Some(self_host_body_carrier_shape(
              plan.local_values[slot].carrier,
            ))
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_canonical_materialized_local_type(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<U32> {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return Option::None
  }
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_linked_expression_wraps_expression(
                  module_,
                  value,
                  expression,
                ) {
                  let slot = self_host_body_local_slot(module_, body, local_id)
                  if slot < plan.local_values.length() && !self_host_u32_equal(
                    plan.local_values[slot].physical_heap_type,
                    4294967295u32,
                  ) {
                    return Option::Some(plan.local_values[slot].physical_heap_type)
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}


fn self_host_linked_callable_receiver_nominal_by_name(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
) -> U64 {
  let mut selected = 0u64
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) {
          let nominal = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            if !self_host_u64_equal(selected, 0u64) &&
              !self_host_u64_equal(selected, nominal) {
              return 0u64
            }
            selected = nominal
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  selected
}

fn self_host_linked_local_usage_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(
              base,
              name,
            ) => if base < module_.expressions.length() &&
              name < self_host_linked_module_name_count(module_) {
              match module_.expressions[base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  let nominal = self_host_linked_callable_receiver_nominal_by_name(
                    link,
                    self_host_linked_module_name_at(module_, name),
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
                _ => {}
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}


fn self_host_linked_pattern_binding_shape_for_subject(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  pattern_index: U32,
  local_id: U32,
  payload_hint: SelfHostPlannedValueShape,
  subject_nominal: U64,
) -> Option<SelfHostPlannedValueShape> {
  if pattern_index >= module_.patterns.length() {
    return Option::None
  }
  let root_pattern = self_host_planned_pattern_at(module_.patterns, pattern_index)
  match root_pattern.source {
    SelfHostHirPattern::TuplePattern(_, children, _) => match self_host_linked_pattern_variant_type(
      link,
      module_,
      root_pattern,
      payload_hint,
      subject_nominal,
    ) {
      Option::Some(type_index) => {
        let mut child_offset = 0u32
        let _ = while child_offset {
          current_child => if current_child < children.length {
            let child_index = self_host_u32_add(children.start, current_child)
            if child_index < module_.pattern_children.length() {
              let child_pattern_index = module_.pattern_children[child_index]
              if child_pattern_index < module_.patterns.length() {
                match self_host_planned_pattern_at(module_.patterns, child_pattern_index).reference {
                  SelfHostBodyPatternReference::PatternBindingReference(
                    candidate,
                  ) => if self_host_u32_equal(candidate, local_id) {
                    return self_host_linked_physical_field_shape(
                      link,
                      type_index,
                      self_host_linked_variant_payload_field_index(
                        link,
                        type_index,
                        current_child,
                      ),
                    )
                  }
                  _ => {}
                }
              }
            }
            continue current_child + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
    _ => {}
  }
  Option::None
}

fn self_host_linked_pattern_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  pattern_index: U32,
  local_id: U32,
  payload_hint: SelfHostPlannedValueShape,
) -> Option<SelfHostPlannedValueShape> {
  self_host_linked_pattern_binding_shape_for_subject(
    link,
    module_,
    pattern_index,
    local_id,
    payload_hint,
    0u64,
  )
}

fn self_host_linked_match_fallthrough_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let arm_body = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).body
          if arm_body < module_.expressions.length() {
            let body_expression = module_.expressions[arm_body]
            match body_expression.kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                match self_host_linked_local_direct_pattern_subject_shape(
                  link,
                  module_,
                  body,
                  local_id,
                ) {
                  Option::Some(shape) => {
                    return Option::Some(shape)
                  }
                  Option::None => {}
                }
                match self_host_linked_match_binding_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  local_id,
                ) {
                  Option::Some(shape) => {
                    return Option::Some(shape)
                  }
                  Option::None => {
                    return Option::Some(
                      self_host_linked_backend_expression_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arm_body,
                      ),
                    )
                  }
                }
              }
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if value < module_.expressions.length() {
                        match module_.expressions[value].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                            match self_host_linked_local_direct_pattern_subject_shape(
                              link,
                              module_,
                              body,
                              local_id,
                            ) {
                              Option::Some(shape) => {
                                return Option::Some(shape)
                              }
                              Option::None => {}
                            }
                            match self_host_linked_match_binding_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              local_id,
                            ) {
                              Option::Some(shape) => {
                                return Option::Some(shape)
                              }
                              Option::None => {
                                return Option::Some(
                                  self_host_linked_backend_expression_shape(
                                    link,
                                    module_,
                                    body,
                                    caller_specialization,
                                    value,
                                  ),
                                )
                              }
                            }
                          }
                          _ => if module_.expressions[value].flow.falls_through {
                            let shape = match self_host_linked_exact_expression_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              value,
                            ) {
                              Option::Some(result_shape) => result_shape
                              Option::None => self_host_linked_backend_expression_shape(
                                link,
                                module_,
                                body,
                                caller_specialization,
                                value,
                              )
                            }
                            if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                              !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                              return Option::Some(shape)
                            }
                          }
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => if body_expression.flow.falls_through {
                let shape = match self_host_linked_exact_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arm_body,
                ) {
                  Option::Some(result_shape) => result_shape
                  Option::None => self_host_linked_backend_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    arm_body,
                  )
                }
                if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  return Option::Some(shape)
                }
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_single_nested_special_match_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Option<SelfHostPlannedValueShape> {
  let mut selected = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut found = false
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          if self_host_u32_greater(
            module_.expressions.length(),
            source.body,
          ) {
            let mut nested_body = source.body
            match module_.expressions[source.body].kind {
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item < module_.block_items.length() {
                    match module_.block_items[item].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => {
                        nested_body = expression
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => {}
            }
            if nested_body < module_.expressions.length() {
            match module_.expressions[nested_body].kind {
              SelfHostPlannedExpressionKind::PlannedMatchExpression(
                subject,
                nested_arms,
              ) => {
                let nested_shape = match self_host_linked_match_direct_binding_declared_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  nested_arms,
                ) {
                  Option::Some(shape) => Option::Some(shape)
                  Option::None => if self_host_linked_match_returns_special_binding(
                    module_,
                    nested_arms,
                  ) {
                    self_host_linked_expression_container_element_shape(
                      link,
                      module_,
                      body,
                      subject,
                    )
                  } else {
                    Option::None
                  }
                }
                match nested_shape {
                  Option::Some(shape) => {
                    if found && self_host_linked_array_carrier_from_shape(
                      selected,
                    ) != self_host_linked_array_carrier_from_shape(shape) {
                      return Option::None
                    }
                    selected = shape
                    found = true
                  }
                  Option::None => if module_.expressions[nested_body].flow.falls_through {
                    return Option::None
                  }
                }
              }
              _ => if module_.expressions[nested_body].flow.falls_through {
                return Option::None
              }
            }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if found {
    Option::Some(selected)
  } else {
    Option::None
  }
}

fn self_host_linked_scoped_match_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
  payload_hint: SelfHostPlannedValueShape,
) -> Option<SelfHostPlannedValueShape> {
  let mut selected = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let mut found = false
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let arm_body = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).body
          if arm_body < module_.expressions.length() {
            let mut value = arm_body
            let mut falls_through = module_.expressions[arm_body].flow.falls_through
            match module_.expressions[arm_body].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                falls_through = true
              }
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(
                        expression,
                      ) => {
                        value = expression
                        if expression < module_.expressions.length() {
                          falls_through = module_.expressions[
                            expression
                          ].flow.falls_through
                          match module_.expressions[expression].kind {
                            SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                              falls_through = true
                            }
                            SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                              falls_through = true
                            }
                            _ => {}
                          }
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
              _ => {}
            }
            if falls_through && value < module_.expressions.length() {
              let shape = match module_.expressions[value].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_pattern_binding_shape(
                  link,
                  module_,
                  self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                  local_id,
                  payload_hint,
                ) {
                  Option::Some(binding_shape) => binding_shape
                  Option::None => if self_host_linked_pattern_binds_local(
                    module_,
                    self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                    local_id,
                  ) {
                    payload_hint
                  } else {
                    self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      value,
                    )
                  }
                }
                _ => self_host_linked_backend_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  value,
                )
              }
              if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                if found && self_host_linked_array_carrier_from_shape(selected) !=
                  self_host_linked_array_carrier_from_shape(shape) {
                  return Option::None
                }
                selected = shape
                found = true
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if found {
    Option::Some(selected)
  } else {
    Option::None
  }
}

fn self_host_linked_match_has_fallthrough_arm(
  module_: SelfHostPlannedModuleLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let body = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).body
          if body < module_.expressions.length() {
            let body_expression = module_.expressions[body]
            if body_expression.flow.falls_through {
              return true
            }
            match body_expression.kind {
              SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => if block_index < module_.blocks.length() {
                let block = module_.blocks[block_index]
                if self_host_u32_greater(block.items.length, 0u32) {
                  let item_index = self_host_u32_add(
                    block.items.start,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  if item_index < module_.block_items.length() {
                    match module_.block_items[item_index].kind {
                      SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => if value < module_.expressions.length() {
                        match module_.expressions[value].kind {
                          SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {
                            return true
                          }
                          SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                            return true
                          }
                          _ => {}
                        }
                      }
                      _ => {}
                    }
                  }
                }
              }
              SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) => {}
              SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {}
              SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {}
              SelfHostPlannedExpressionKind::PlannedBreakExpression(_, _) => {}
              SelfHostPlannedExpressionKind::PlannedContinueExpression(_, _) => {}
              _ => {
                return true
              }
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}


fn self_host_linked_field_container_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, field.type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      if field.field_index < physical.fields.length {
        let physical_field = self_host_linked_physical_field_at(
          physical_module,
          self_host_u32_add(physical.fields.start, field.field_index),
        )
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        for layout_field in lowering_module.type_layouts.fields {
          if self_host_u64_equal(
            layout_field.field,
            physical_field.declaration,
          ) {
            return self_host_linked_resolved_type_argument_shape(
              lowering_module,
              layout_field.type_,
              argument,
            )
          }
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_field_container_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
) -> Option<SelfHostPlannedValueShape> {

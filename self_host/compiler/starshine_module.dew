          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_product_pair_type_for_projection(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  base: U32,
  count: U32,
  pair_start: U32,
) -> Option<U32> {
  if count < 2u32 || self_host_u32_add(pair_start, 1u32) >= count {
    return Option::None
  }
  match self_host_linked_product_pair_type_for_match_result(
    link,
    module_,
    body,
    caller_specialization,
    base,
    count,
    pair_start,
  ) {
    Option::Some(type_index) => {
      return Option::Some(type_index)
    }
    Option::None => {}
  }
  let left_shape = match self_host_linked_product_projection_field_shape(
    link,
    module_,
    body,
    caller_specialization,
    base,
    count,
    pair_start,
  ) {
    Option::Some(shape) => shape
    Option::None => match self_host_linked_product_field_shape(
      link,
      module_,
      body,
      caller_specialization,
      base,
      pair_start,
    ) {
      Option::Some(shape) => shape
      Option::None => {
        return Option::None
      }
    }
  }
  let right_carrier = if self_host_u32_equal(
    self_host_u32_add(pair_start, 2u32),
    count,
  ) {
    match self_host_linked_product_projection_field_shape(
      link,
      module_,
      body,
      caller_specialization,
      base,
      count,
      self_host_u32_add(pair_start, 1u32),
    ) {
      Option::Some(shape) => self_host_linked_array_carrier_from_shape(shape)
      Option::None => match self_host_linked_product_field_shape(
        link,
        module_,
        body,
        caller_specialization,
        base,
        self_host_u32_add(pair_start, 1u32),
      ) {
        Option::Some(shape) => self_host_linked_array_carrier_from_shape(shape)
        Option::None => {
          return Option::None
        }
      }
    }
  } else {
    5i32
  }
  Option::Some(
    self_host_linked_pair_runtime_base(link) + self_host_i32_to_u32(
      self_host_linked_array_carrier_from_shape(left_shape) * 6i32 +
        right_carrier,
    ),
  )
}

fn self_host_linked_pair_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  field: U32,
) -> Option<SelfHostPlannedValueShape> {
  let first = self_host_linked_pair_runtime_base(link)
  if type_index < first || type_index >= first + 36u32 || field >= 2u32 {
    return Option::None
  }
  let pair = type_index - first
  let carrier = if self_host_u32_equal(field, 0u32) {
    pair / 6u32
  } else {
    pair % 6u32
  }
  Option::Some(match carrier {
    0u32 => SelfHostPlannedValueShape::I32PlannedValueShape
    1u32 => SelfHostPlannedValueShape::I64PlannedValueShape
    2u32 => SelfHostPlannedValueShape::F32PlannedValueShape
    3u32 => SelfHostPlannedValueShape::F64PlannedValueShape
    4u32 => SelfHostPlannedValueShape::V128PlannedValueShape
    _ => SelfHostPlannedValueShape::RefPlannedValueShape
  })
}

fn self_host_linked_expression_binding_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  local_id,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  let mut relative_local = 0u32
                  let _ = while relative_local {
                    current_local => if current_local < body.locals.length {
                      let local_index = self_host_u32_add(
                        body.locals.start,
                        current_local,
                      )
                      if local_index < module_.locals.length() {
                        let local = self_host_body_planned_local_identity(module_.locals[local_index])
                        if self_host_u32_equal(local.local_id, local_id) {
                          if !(local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
                            return Option::Some(local.shape)
                          }
                          let contextual = self_host_linked_expression_expected_shape(
                            link,
                            module_,
                            body,
                            caller_specialization,
                            expression,
                          )
                          if !(contextual is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                            !(contextual is SelfHostPlannedValueShape::UnitPlannedValueShape) {
                            return Option::Some(contextual)
                          }
                        }
                      }
                      continue current_local + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_product_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  base: U32,
  field: U32,
) -> Option<SelfHostPlannedValueShape> {
  if base >= module_.expressions.length() {
    return Option::None
  }
  let planned_base = module_.expressions[base]
  let base_shape = match planned_base.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_initializer_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(initializer) => if initializer < module_.expressions.length() {
        match module_.expressions[initializer].kind {
          SelfHostPlannedExpressionKind::PlannedMatchExpression(
            subject,
            _,
          ) => if subject < module_.expressions.length() {
            match self_host_linked_type_first_argument_shape(
              module_,
              self_host_planned_expression_at(module_.expressions, subject).type_,
            ) {
              Option::Some(shape) => shape
              Option::None => match self_host_linked_local_initializer_shape(
                link,
                module_,
                body,
                caller_specialization,
                local_id,
              ) {
                Option::Some(shape) => shape
                Option::None => self_host_linked_backend_expression_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  base,
                )
              }
            }
          } else {
            self_host_linked_backend_expression_shape(
              link,
              module_,
              body,
              caller_specialization,
              base,
            )
          }
          _ => match self_host_linked_local_initializer_shape(
            link,
            module_,
            body,
            caller_specialization,
            local_id,
          ) {
            Option::Some(shape) => shape
            Option::None => self_host_linked_backend_expression_shape(
              link,
              module_,
              body,
              caller_specialization,
              base,
            )
          }
        }
      } else {
        self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          base,
        )
      }
      Option::None => match self_host_linked_local_initializer_shape(
        link,
        module_,
        body,
        caller_specialization,
        local_id,
      ) {
        Option::Some(shape) => shape
        Option::None => self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          base,
        )
      }
    }
    _ => self_host_linked_backend_expression_shape(
      link,
      module_,
      body,
      caller_specialization,
      base,
    )
  }
  match base_shape {
    SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => if field < fields.length() {
      Option::Some(fields[field])
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_pair_type_for_projection(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  base: U32,
) -> Option<U32> {
  let mut left = -1i32
  let mut right = -1i32
  let mut base_local = 4294967295u32
  if base < module_.expressions.length() {
    match module_.expressions[base].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
        base_local = local_id
      }
      _ => {}
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      if expression < module_.expressions.length() {
        let planned = module_.expressions[expression]
        match planned.kind {
          SelfHostPlannedExpressionKind::PlannedProductField(
            candidate_base,
            field,
            count,
          ) => {
            let mut same_base = self_host_u32_equal(candidate_base, base)
            if !same_base && !self_host_u32_equal(
              base_local,
              4294967295u32,
            ) && candidate_base < module_.expressions.length() {
              match module_.expressions[candidate_base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                  same_base = self_host_u32_equal(local_id, base_local)
                }
                _ => {}
              }
            }
            if same_base && self_host_u32_equal(count, 2u32) {
              match self_host_linked_expression_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                expression,
              ) {
                Option::Some(binding_shape) => {
                  let carrier = self_host_linked_array_carrier_from_shape(
                    binding_shape,
                  )
                  if self_host_u32_equal(field, 0u32) {
                    left = carrier
                  } else if self_host_u32_equal(field, 1u32) {
                    right = carrier
                  }
                }
                Option::None => if (self_host_u32_equal(field, 0u32) && left < 0i32) ||
                  (self_host_u32_equal(field, 1u32) && right < 0i32) {
                  let shape = match self_host_linked_product_field_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    candidate_base,
                    field,
                  ) {
                    Option::Some(field_shape) => field_shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    )
                  }
                  let carrier = self_host_linked_array_carrier_from_shape(shape)
                  if self_host_u32_equal(field, 0u32) {
                    left = carrier
                  } else if self_host_u32_equal(field, 1u32) {
                    right = carrier
                  }
                }
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if left >= 0i32 && right >= 0i32 {
    Option::Some(
      self_host_linked_pair_runtime_base(link) + self_host_i32_to_u32(
        left * 6i32 + right,
      ),
    )
  } else {
    Option::None
  }
}

fn self_host_linked_pair_type_for_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<U32> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  let planned = module_.expressions[expression]
  match self_host_linked_pair_type_for_shape(link, planned.shape) {
    Option::Some(type_index) => {
      return Option::Some(type_index)
    }
    Option::None => {}
  }
  match self_host_linked_pair_type_for_shape(
    link,
    self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      planned.type_,
    ),
  ) {
    Option::Some(type_index) => {
      return Option::Some(type_index)
    }
    Option::None => {}
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut local = 0u32
      let _ = while local {
        current => if current < body.locals.length {
          let source = self_host_u32_add(body.locals.start, current)
          if source < module_.locals.length() {
            let planned_local = self_host_body_planned_local_identity(module_.locals[source])
            if self_host_u32_equal(planned_local.local_id, local_id) {
              match self_host_linked_pair_type_for_shape(
                link,
                planned_local.shape,
              ) {
                Option::Some(type_index) => {
                  return Option::Some(type_index)
                }
                Option::None => {}
              }
              match self_host_linked_pair_type_for_shape(
                link,
                self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  planned_local.type_,
                ),
              ) {
                Option::Some(type_index) => {
                  return Option::Some(type_index)
                }
                Option::None => {}
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      match self_host_linked_local_initializer_expression(
        module_,
        body,
        local_id,
      ) {
        Option::Some(initializer) => if initializer < module_.expressions.length() {
          match module_.expressions[initializer].kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              declaration,
              _,
              _,
              _,
            ) => match self_host_linked_callable_declared_result_shape(
              link,
              declaration,
            ) {
              Option::Some(shape) => match self_host_linked_pair_type_for_shape(
                link,
                shape,
              ) {
                Option::Some(type_index) => return Option::Some(type_index)
                Option::None => {}
              }
              Option::None => {}
            }
            _ => {}
          }
        }
        Option::None => {}
      }
    }
    _ => {}
  }
  Option::None
}

fn self_host_linked_exact_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      expression,
      declaration,
    ) {
      Option::Some(function_index) => {
        let shape = self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
          Option::None
        } else {
          Option::Some(shape)
        }
      }
      Option::None => Option::None
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => self_host_linked_struct_field_shape(
      link,
      field,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        )
        Option::None => Option::None
      }
    } else {
      Option::None
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => {
      let declaration = match module_.expressions[expression].call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
        _ => 0u64
      }
      match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        declaration,
      ) {
        Option::Some(function_index) => {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            Option::None
          } else {
            Option::Some(shape)
          }
        }
        Option::None => Option::None
      }
    }
    _ => Option::None
  }
}



fn self_host_linked_i32_scratch_slot(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  let _ = link
  self_host_physical_scratch_slot(canonical, module_, body, expression, 0u32)
}


fn self_host_linked_physical_function_index(function_index: U32) -> U32 {
  let _ = self_host_assert_compiler_invariant_with_failure(
    function_index <= 4294967292u32,
    SelfHostInvariantFailure::{
      code: 502u32
      phase: 6u32
      module_id: 0u64
      declaration: 0u64
      body: 0u64
      expression: 4294967295u32
      expected: 4294967292u64
      actual: u32_into_u64(function_index)
      detail: 0u64
    },
    "function handle encoding must leave the missing sentinel reserved",
  )
  self_host_u32_add(function_index, 2u32)
}

fn self_host_linked_emitted_function_index(function_index: U32) -> U32 {
  let _ = self_host_assert_compiler_invariant_with_failure(
    function_index >= 2u32 && function_index != 4294967295u32,
    SelfHostInvariantFailure::{
      code: 105u32
      phase: 7u32
      module_id: 0u64
      declaration: 0u64
      body: 0u64
      expression: 4294967295u32
      expected: 2u64
      actual: u32_into_u64(function_index)
      detail: 0u64
    },
    "emitted function requires a present tagged function handle",
  )
  self_host_u32_subtract(function_index, 2u32)
}

fn self_host_linked_physical_function(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Option<SelfHostPlannedProgramWasmFunction> {
  if physical_function_index < 2u32 {
    return Option::None
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  if logical >= link.functions.length() {
    return Option::None
  }
  let function_ = link.functions[logical]
  if !self_host_u32_equal(function_.function_index, logical) {
    return Option::None
  }
  Option::Some(function_)
}

fn self_host_linked_physical_function_name(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bytes {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => self_host_linked_function_name(link, function_)
    Option::None => b""
  }
}

fn self_host_linked_physical_function_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> U64 {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => link.fragments.specialization.lowering.modules[function_.module_index].module_id
    Option::None => 0u64
  }
}

fn self_host_linked_physical_function_has_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => self_host_linked_declaration_has_receiver(link, function_.declaration)
    Option::None => false
  }
}

fn self_host_linked_physical_function_is_import(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => {
      let fragment_module = link.fragments.modules[function_.module_index]
      self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      ).kind is SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(_, _)
    }
    Option::None => false
  }
}

fn self_host_linked_physical_function_parameter_count(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> U32 {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => {
      let fragment_module = link.fragments.modules[function_.module_index]
      self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      ).parameters.length
    }
    Option::None => 0u32
  }
}

fn self_host_linked_physical_function_parameter_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
  parameter: U32,
) -> SelfHostPlannedValueShape {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      if parameter < fragment.parameters.length {
        let index = self_host_u32_add(fragment.parameters.start, parameter)
        if index < fragment_module.function_value_types.length() {
          return self_host_linked_wasm_value_shape(
            fragment_module.function_value_types[index],
          )
        }
      }
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_physical_function_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> SelfHostPlannedValueShape {
  match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(function_) => {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      self_host_linked_specialized_function_result_shape(
        link,
        function_,
        fragment_module,
        fragment,
      )
    }
    Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_physical_function_specialization_shape_at(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
  position: U32,
) -> SelfHostPlannedValueShape {
  let function_ = match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(value) => value
    Option::None => return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  if !self_host_u32_equal(function_.specialization, 4294967295u32) &&
      self_host_u32_greater(
        link.fragments.specialization.requests.length(),
        function_.specialization,
      ) {
      let request = link.fragments.specialization.requests[function_.specialization]
      if position < request.shapes.length {
        let index = self_host_u32_add(request.shapes.start, position)
        if index < link.fragments.specialization.shapes.length() {
          return link.fragments.specialization.shapes[index]
        }
      }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_physical_function_specialization_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> SelfHostPlannedValueShape {
  let function_ = match self_host_linked_physical_function(link, physical_function_index) {
    Option::Some(value) => value
    Option::None => return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  match self_host_linked_specialization_first_shape(link, function_) {
    Option::Some(shape) => shape
    Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_physical_function_returns_generic_ref(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  if physical_function_index < 2u32 {
    return false
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      if self_host_u32_equal(fragment.results.length, 1u32) &&
        fragment.results.start < fragment_module.function_value_types.length() {
        return fragment_module.function_value_types[fragment.results.start] is SelfHostPlannedWasmValueType::WasmNullableEqRefValue
      }
    }
  }
  false
}


fn self_host_linked_function_has_result(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
) -> Bool {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      return self_host_u32_greater(fragment.results.length, 0u32)
    }
  }
  true
}

fn self_host_linked_expression_is_pattern_arm_body(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.pattern_arms.length {
      let arm = self_host_u32_add(body.pattern_arms.start, current)
      if arm < module_.pattern_arms.length() && self_host_u32_equal(
        self_host_planned_pattern_arm_at(module_.pattern_arms, arm).body,
        expression,
      ) {
        return true
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_block_emits_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  block_index: U32,
) -> Bool {
  if block_index >= module_.blocks.length() {
    return false
  }
  let block = module_.blocks[block_index]
  if !block.flow.falls_through || !self_host_u32_greater(
    block.items.length,
    0u32,
  ) {
    return false
  }
  let item_index = self_host_u32_add(
    block.items.start,
    self_host_u32_subtract(block.items.length, 1u32),
  )
  if item_index >= module_.block_items.length() {
    return false
  }
  match module_.block_items[item_index].kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => self_host_linked_expression_emits_value(
      link,
      module_,
      body,
      caller_specialization,
      value,
    )
    _ => false
  }
}

fn self_host_linked_expression_emits_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  let planned = module_.expressions[expression]
  if planned.shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
    planned.shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    return false
  }
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, body.body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      return self_host_linked_function_has_result(link, call.function_index)
    }
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => {
      for function_ in link.functions {
        if self_host_linked_named_function_matches(function_, declaration) {
          return self_host_linked_function_has_result(
            link,
            function_.function_index,
          )
        }
      }
      true
    }
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if target < module_.expressions.length() &&
      self_host_u32_greater(
        self_host_linked_module_name_count(module_),
        module_.expressions[target].source_name,
      ) {
      let name = self_host_linked_module_name_at(
        module_,
        module_.expressions[target].source_name,
      )
      if name == "unreachable" || name == "string_builder_append" ||
        name == "string_builder_append_view" || name == "string_builder_append_ascii" ||
        name == "string_builder_append_scalar" || name == "bytes_builder_append" ||
        name == "bytes_builder_append_byte" {
        false
      } else {
        match self_host_linked_callable_by_name(link, name) {
          Option::Some(callable) => match self_host_linked_callable_function_index(
            link,
            callable.declaration,
          ) {
            Option::Some(function_index) => self_host_linked_function_has_result(
              link,
              function_index,
            )
            Option::None => true
          }
          Option::None => true
        }
      }
    } else {
      true
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          let method_name = self_host_linked_module_name_at(module_, name)
          if method_name == "clear" || method_name == "push" ||
            method_name == "set_unchecked" {
            return false
          }
          let direct = self_host_linked_i32_call_index(
            link,
            body.body,
            caller_specialization,
            expression,
            0u64,
          )
          let result_shape = match direct {
            Option::Some(function_index) => self_host_linked_physical_function_result_shape(
              link,
              function_index,
            )
            Option::None => match self_host_linked_method_call_index(
              link,
              self_host_linked_module_name_at(module_, name),
            ) {
              Option::Some(function_index) => self_host_linked_physical_function_result_shape(
                link,
                function_index,
              )
              Option::None => planned.shape
            }
          }
          !(result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
          !(result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape)
        } else {
          true
        }
        _ => true
      }
    } else {
      true
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => self_host_linked_block_emits_value(
      link,
      module_,
      body,
      caller_specialization,
      block_index,
    )
    SelfHostPlannedExpressionKind::PlannedIfExpression(
      _,
      then_block,
      else_expression,
    ) => {
      let result_shape = self_host_linked_if_result_shape(
        link,
        module_,
        body,
        caller_specialization,
        body.result_shape,
        expression,
        planned,
        then_block,
        else_expression,
      )
      !(result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
        !(result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape)
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
      if self_host_linked_match_has_unit_fallthrough_arm(
        link,
        module_,
        body,
        caller_specialization,
        expression,
        arms,
      ) {
        return false
      }
      let mut arm = 0u32
      let _ = while arm {
        current => if current < arms.length {
          let child = self_host_u32_add(arms.start, current)
          if child < module_.arm_children.length() {
            let arm_index = module_.arm_children[child]
            if arm_index < module_.pattern_arms.length() {
              let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
              if source.flow.falls_through && self_host_linked_expression_emits_value(
                link,
                module_,
                body,
                caller_specialization,
                source.body,
              ) {
                return true
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      false
    }
    SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => false
    SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => false
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, _, _) => false
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _) => false
    _ => true
  }
}

fn self_host_linked_expression_returns_variant_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  if self_host_linked_expression_is_variant_call(
    link,
    body.body,
    expression,
  ) || self_host_linked_runtime_reference_constructor(module_, expression) {
    return true
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      !self_host_u32_equal(tail, 4294967295u32) && self_host_linked_expression_returns_variant_value(
        link,
        module_,
        body,
        tail,
      )
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => self_host_linked_match_returns_variant_value(
      link,
      module_,
      body,
      arms,
    )
    _ => false
  }
}

fn self_host_linked_match_returns_variant_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          if source.flow.falls_through && self_host_linked_expression_returns_variant_value(
            link,
            module_,
            body,
            source.body,
          ) {
            return true
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_match_has_unit_fallthrough_arm(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  arms: SelfHostHirSpan,
) -> Bool {
  match self_host_linked_let_value_shape(module_, body, expression) {
    Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
      !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
      !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
      return false
    }
    Option::None => {}
  }
  let mut variant_arm = 0u32
  let _ = while variant_arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          let value = match module_.expressions[source.body].kind {
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_body_block_tail_expression(
              module_,
              block,
            )
            _ => source.body
          }
          if source.flow.falls_through && (
            self_host_linked_expression_is_variant_call(
              link,
              body.body,
              source.body,
            ) || (!self_host_u32_equal(value, 4294967295u32) &&
              self_host_linked_runtime_reference_constructor(module_, value))
          ) {
            return false
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          if source.flow.falls_through && !self_host_linked_expression_emits_value(
            link,
            module_,
            body,
            caller_specialization,
            source.body,
          ) {
            let recovered_shape = match self_host_linked_exact_expression_shape(
              link,
              module_,
              body,
              caller_specialization,
              source.body,
            ) {
              Option::Some(shape) => shape
              Option::None => self_host_linked_backend_expression_shape(
                link,
                module_,
                body,
                caller_specialization,
                source.body,
              )
            }
            if recovered_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape ||
              recovered_shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
              recovered_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
              return true
            }
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}



fn self_host_linked_physical_function_returns_array_element_by_index(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  for function_ in link.functions {
    if self_host_u32_equal(
      self_host_linked_physical_function_index(function_.function_index),
      physical_function_index,
    ) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      return self_host_linked_function_returns_array_element(
        link,
        function_,
        fragment,
      )
    }
  }
  false
}

fn self_host_linked_call_returns_array_element(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> Bool {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      for function_ in link.functions {
        if self_host_u32_equal(function_.function_index, call.function_index) {
          let fragment_module = link.fragments.modules[function_.module_index]
          let fragment = self_host_program_link_fragment_function(
            fragment_module,
            function_.fragment_index,
          )
          return self_host_linked_function_returns_array_element(
            link,
            function_,
            fragment,
          )
        }
      }
    }
  }
  false
}


fn self_host_linked_expression_is_variant_call(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  expression: U32,
) -> Bool {
  let module_index = match link.fragments.specialization.lowering.index.body_owner(
    caller_body,
  ) {
    Option::Some(value) => value
    Option::None => return false
  }
  if module_index >= link.fragments.specialization.lowering.modules.length() {
    return false
  }
  let module_ = link.fragments.specialization.lowering.modules[module_index]
  if expression < module_.expressions.length() {
      let callable_variant_selection = match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => true
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => true
        _ => false
      }
      if callable_variant_selection {
        match module_.expressions[expression].selection {
          SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
            _,
            _,
            _,
          ) => return true
          _ => {}
        }
        let target = match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(_, value, _, _) => value
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
          _ => 4294967295u32
        }
        if target < module_.expressions.length() {
          match module_.expressions[target].selection {
            SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
              _,
              _,
              _,
            ) => return true
            _ => {}
          }
        }
      }
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if !self_host_u32_equal(tail, 4294967295u32) && self_host_linked_expression_is_variant_call(
            link,
            caller_body,
            tail,
          ) {
            return true
          }
        }
        SelfHostPlannedExpressionKind::PlannedConstruct(_, _, selection) => match selection {
          SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(_, _, _) => return true
          _ => {}
        }
        _ => {}
      }
  }
  false
}

fn self_host_linked_function_declaration_module_matches(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
  declaration: U64,
) -> Bool {
  if self_host_u64_equal(declaration, 0u64) {
    return true
  }
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => if self_host_array_index_is_valid(
      function_index,
      link.functions.length(),
    ) {
      let function_ = link.functions[function_index]
      return self_host_u32_equal(
        function_.function_index,
        function_index,
      ) && self_host_u32_equal(
        function_.module_index,
        owner,
      ) && self_host_linked_named_function_matches(function_, declaration)
    }
    Option::None => {
      return false
    }
  }
  false
}

fn self_host_linked_i32_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  declaration: U64,
) -> Option<U32> {
  if self_host_linked_expression_is_variant_call(
    link,
    caller_body,
    expression,
  ) {
    return Option::None
  }
  match self_host_linked_call_index_get(link.call_index, caller_body, caller_specialization, expression) {
    Option::Some(function_index) => {
      if self_host_linked_function_declaration_module_matches(link, function_index, declaration) || self_host_linked_bound_call_declaration_matches(link, caller_body, caller_specialization, expression, declaration, function_index) {
        return Option::Some(self_host_linked_physical_function_index(function_index))
      }
      return Option::None
    }
    Option::None => {}
  }
  match link.call_index.plain_functions.get(declaration) {
    Option::Some(function_index) => if self_host_linked_function_declaration_module_matches(link, function_index, declaration) {
      return Option::Some(self_host_linked_physical_function_index(function_index))
    }
    Option::None => {}
  }
  // A specialized function is valid only with an exact call-site record.
  // Link order must not select a physical ABI.
  Option::None
}

fn self_host_linked_builtin_name(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<Bytes> {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => if self_host_u32_greater(
      link.fragments.modules.length(),
      owner,
    ) {
      let module_ = link.fragments.modules[owner]
      let index = self_host_fragment_function_index(module_, declaration)
      if index == 4294967295u32 {
        return Option::None
      }
      let fragment = self_host_program_link_fragment_function(module_, index)
      if !self_host_bytes_equal(fragment.direct_builtin, b"") {
        return Option::Some(self_host_raw_array_canonical_opcode(fragment.direct_builtin))
      }
      match fragment.kind {
        SelfHostPlannedWasmFunctionKind::PlannedWasmInlineHeapFunction(recipe),
        SelfHostPlannedWasmFunctionKind::PlannedWasmOutlinedHeapFunction(recipe) => return Option::Some(recipe.opcode())
        SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(name) => {
          return Option::Some(self_host_raw_array_canonical_opcode(name))
        }
        _ => return Option::None
      }
    }
    Option::None => {}
  }
  Option::None
}

fn self_host_linked_module_name_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.names.length()
}

fn self_host_linked_module_name_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> String {
  module_.names[index]
}

fn self_host_linked_callable_by_name(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
) -> Option<SelfHostPlannedCallable> {
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if self_host_bytes_equal_string(callable.name, name) {
          return Option::Some(callable)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}


fn self_host_linked_callable_function_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  if self_host_u64_equal(declaration, 0u64) {
    return Option::None
  }
  for function_ in link.functions {
    if self_host_linked_named_function_matches(function_, declaration) &&
      self_host_linked_function_declaration_module_matches(
        link,
        function_.function_index,
        declaration,
      ) {
      return Option::Some(
          self_host_linked_physical_function_index(function_.function_index),
        )
    }
  }
  Option::None
}


fn self_host_linked_declaration_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => link.fragments.specialization.lowering.modules[
      owner
    ].module_id
    Option::None => 0u64
  }
}

fn self_host_linked_declaration_has_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Bool {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      link.fragments.specialization.lowering.modules[owner],
      declaration,
    ) {
      Option::Some(callable) => callable.has_receiver
      Option::None => false
    }
    Option::None => false
  }
}

fn self_host_linked_declaration_name(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Bytes {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      link.fragments.specialization.lowering.modules[owner],
      declaration,
    ) {
      Option::Some(callable) => callable.name
      Option::None => b""
    }
    Option::None => b""
  }
}


fn self_host_linked_call_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
      Option::Some(planned) => if link.erased_fields.get(planned.selected_field) is Option::Some(true) {
        return self_host_body_carrier_shape(planned.value.carrier)
      }
      Option::None => {}
    }
    Option::None => {}
  }
  if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => match canonical {
        Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
          Option::Some(planned) => match planned.selected_storage {
            Option::Some(storage) => return self_host_linked_storage_shape(storage)
            Option::None => if !self_host_u64_equal(planned.selected_field, 0u64) {
              match self_host_linked_struct_field_shape(link, planned.selected_field) {
                Option::Some(shape) => return shape
                Option::None => if planned.selected_type_index != 4294967295u32 && planned.selected_field_index != 4294967295u32 {
                  match self_host_linked_physical_field_shape(
                    link,
                    planned.selected_type_index,
                    planned.selected_field_index,
                  ) {
                    Option::Some(shape) => return shape
                    Option::None => {}
                  }
                }
              }
            } else if planned.selected_type_index != 4294967295u32 && planned.selected_field_index != 4294967295u32 {
              match self_host_linked_physical_field_shape(
                link,
                planned.selected_type_index,
                planned.selected_field_index,
              ) {
                Option::Some(shape) => return shape
                Option::None => {}
              }
            }
          }
          Option::None => {}
        }
        Option::None => {}
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => match canonical {
        Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
          Option::Some(planned) => match planned.selected_storage {
            Option::Some(storage) => return self_host_linked_storage_shape(storage)
            Option::None => if !self_host_u64_equal(planned.selected_field, 0u64) {
              match self_host_linked_struct_field_shape(link, planned.selected_field) {
                Option::Some(shape) => return shape
                Option::None => if planned.selected_type_index != 4294967295u32 && planned.selected_field_index != 4294967295u32 {
                  match self_host_linked_physical_field_shape(
                    link,
                    planned.selected_type_index,
                    planned.selected_field_index,
                  ) {
                    Option::Some(shape) => return shape
                    Option::None => {}
                  }
                }
              }
            } else if planned.selected_type_index != 4294967295u32 && planned.selected_field_index != 4294967295u32 {
              match self_host_linked_physical_field_shape(
                link,
                planned.selected_type_index,
                planned.selected_field_index,
              ) {
                Option::Some(shape) => return shape
                Option::None => {}
              }
            }
          }
          Option::None => {}
        }
        Option::None => {}
      }
      _ => {}
    }
  }
  if self_host_linked_is_unresolved_get_unchecked(module_, expression) {
    match self_host_linked_canonical_parent_call_argument_shape(
      canonical,
      link,
      module_,
      body,
      expression,
    ) {
      Option::Some(shape) => {
        let carrier = self_host_body_carrier_from_shape(shape)
        if !(carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
          carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
        ) && !(carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
          return shape
        }
      }
      Option::None => {}
    }
  }
  let call_shape = if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(
        declaration,
        _,
        _,
        _,
      ) => match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        declaration,
      ) {
        Option::Some(function_index) => self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
      }
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        0u64,
      ) {
        Option::Some(function_index) => self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
      }
      SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, _, _, _) => match canonical {
        Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
          Option::Some(planned) => if self_host_u32_equal(
            planned.call_function_index,
            4294967295u32,
          ) {
            SelfHostPlannedValueShape::ErrorPlannedValueShape
          } else {
            self_host_linked_physical_function_result_shape(
              link,
              self_host_linked_physical_function_index(
                planned.call_function_index,
              ),
            )
          }
          Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
        }
        Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
      }
      _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
  } else {
    SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let call_carrier = self_host_body_carrier_from_shape(call_shape)
  if !(call_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
    call_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
  ) && !(call_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) {
    return call_shape
  }
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
      Option::Some(planned) => {
        let canonical_shape = self_host_body_carrier_shape(planned.carrier)
        if !(canonical_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          canonical_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
        ) && (!(
          self_host_physical_scalar_shape(
            canonical_shape,
          ) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) || !self_host_u64_equal(planned.value.nominal_owner, 0u64) || !self_host_u32_equal(
          planned.value.physical_heap_type,
          4294967295u32,
        )) {
          return canonical_shape
        }
      }
      Option::None => {}
    }
    Option::None => {}
  }
  match self_host_linked_exact_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  ) {
    Option::Some(shape) => return shape
    Option::None => {}
  }
  if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_source_expression(
        module_,
        body,
        local,
      ) {
        Option::Some(source) => {
          let source_shape = self_host_linked_call_argument_shape(
            link,
            canonical,
            module_,
            body,
            caller_specialization,
            source,
          )
          if !(source_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
            self_host_physical_scalar_shape(source_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
          ) {
            return source_shape
          }
          match self_host_linked_local_declared_shape(module_, body, local) {
            Option::Some(declared) => if !(
              declared is SelfHostPlannedValueShape::ErrorPlannedValueShape
            ) && !(
              self_host_physical_scalar_shape(declared) is SelfHostPlannedValueShape::RefPlannedValueShape
            ) {
              return declared
            }
            Option::None => {}
          }
          if !(source_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return source_shape
          }
        }
        Option::None => match self_host_linked_local_parameter_shape(
          link,
          module_,
          body,
          caller_specialization,
          local,
        ) {
          Option::Some(shape) => return shape
          Option::None => match self_host_linked_local_declared_shape(
            module_,
            body,
            local,
          ) {
            Option::Some(shape) => return shape
            Option::None => {}
          }
        }
      }
      _ => {}
    }
  }
  self_host_linked_backend_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
}






fn self_host_linked_method_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
) -> Option<U32> {
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if self_host_bytes_equal_string(callable.name, name) {
          for function_ in link.functions {
            if self_host_u64_equal(function_.declaration, callable.declaration) {
              return Option::Some(
          self_host_linked_physical_function_index(function_.function_index),
        )
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_resolved_primitive_rank(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
) -> U32 {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return 0u32
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::PrimitiveType(primitive) => primitive.rank() + 1u32
    _ => 0u32
  }
}

fn self_host_linked_body_primitive_rank(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> U32 {
  let mut current = type_
  let mut depth = 0u32
  let _ = while depth {
    step => if step < 8u32 {
      if current < -1i32 {
        return self_host_linked_resolved_primitive_rank(
          module_,
          self_host_body_i32_to_u32(-current - 2i32),
        )
      } else if current < 0i32 {
        return 0u32
      }
      let index = self_host_body_i32_to_u32(current)
      if index >= module_.inferred.types.length() {
        return 0u32
      }
      let mut resolved_type = 4294967295u32
      let mut next_type = -1i32
      match module_.inferred.types[index] {
        SelfHostBodyTypeTerm::BodyResolvedType(value) => {
          resolved_type = value
        }
        SelfHostBodyTypeTerm::BodyAppliedType(base, _) => {
          next_type = base
        }
        _ => {}
      }
      if !self_host_u32_equal(resolved_type, 4294967295u32) {
        return self_host_linked_resolved_primitive_rank(
          module_,
          resolved_type,
        )
      }
      if next_type >= 0i32 {
        current = next_type
        continue step + 1u32
      }
      return 0u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u32
}

// A nonnegative result selects semantic key equality instead of carrier
// equality. String is primitive rank 8, encoded here as rank + 1.

fn self_host_linked_method_call_index_for_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
) -> Option<U32> {
  let inferred_receiver_nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    receiver,
  )
  let receiver_primitive = if receiver < module_.expressions.length() {
    self_host_linked_body_primitive_rank(
      module_,
      self_host_planned_expression_at(module_.expressions, receiver).type_,
    )
  } else {
    0u32
  }
  let receiver_nominal = if self_host_u64_equal(
    inferred_receiver_nominal,
    0u64,
  ) && self_host_u32_equal(receiver_primitive, 0u32) {
    self_host_linked_callable_receiver_nominal_by_name(link, name)
  } else {
    inferred_receiver_nominal
  }
  if !self_host_u64_equal(receiver_nominal, 0u64) || !self_host_u32_equal(
    receiver_primitive,
    0u32,
  ) {
    for candidate_module in link.fragments.specialization.lowering.modules {
      let mut callable_index = 0u32
      let _ = while callable_index {
        current => if current < self_host_program_specialization_callable_count(
          candidate_module,
        ) {
          let callable = self_host_program_specialization_callable_at(
            candidate_module,
            current,
          )
          let candidate_nominal = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
          let candidate_primitive = self_host_linked_resolved_primitive_rank(
            candidate_module,
            callable.self_type,
          )
          if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) && (
            (!self_host_u64_equal(receiver_nominal, 0u64) && self_host_u64_equal(
              candidate_nominal,
              receiver_nominal,
            )) || (!self_host_u32_equal(receiver_primitive, 0u32) && self_host_u32_equal(
              candidate_primitive,
              receiver_primitive,
            ))
          ) {
            for function_ in link.functions {
              if self_host_u64_equal(
                function_.declaration,
                callable.declaration,
              ) {
                return Option::Some(self_host_linked_physical_function_index(
                  function_.function_index,
                ))
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
  self_host_linked_method_call_index(link, name)
}

fn self_host_linked_method_call_index_for_receiver_arity(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
  explicit_argument_count: U32,
) -> Option<U32> {
  let receiver_nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    receiver,
  )
  let receiver_primitive = if receiver < module_.expressions.length() {
    self_host_linked_body_primitive_rank(
      module_,
      self_host_planned_expression_at(module_.expressions, receiver).type_,
    )
  } else {
    0u32
  }
  let mut selected_declaration = 0u64
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) &&
          self_host_u32_equal(callable.parameters.length, explicit_argument_count) {
          let candidate_nominal = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
          let candidate_primitive = self_host_linked_resolved_primitive_rank(
            candidate_module,
            callable.self_type,
          )
          if (!self_host_u64_equal(receiver_nominal, 0u64) && self_host_u64_equal(
            receiver_nominal,
            candidate_nominal,
          )) || (!self_host_u32_equal(receiver_primitive, 0u32) && self_host_u32_equal(
            receiver_primitive,
            candidate_primitive,
          )) {
            if !self_host_u64_equal(selected_declaration, 0u64) && !self_host_u64_equal(
              selected_declaration,
              callable.declaration,
            ) {
              return self_host_linked_method_call_index_for_receiver(
                link,
                module_,
                body,
                receiver,
                name,
              )
            }
            selected_declaration = callable.declaration
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  if self_host_u64_equal(selected_declaration, 0u64) {
    return self_host_linked_method_call_index_for_receiver(
      link,
      module_,
      body,
      receiver,
      name,
    )
  }
  let mut selected_function = 4294967295u32
  for function_ in link.functions {
    if self_host_u64_equal(function_.declaration, selected_declaration) {
      let physical = self_host_linked_physical_function_index(function_.function_index)
      if self_host_u32_equal(selected_function, 4294967295u32) {
        selected_function = physical
      }
    }
  }
  if self_host_u32_equal(selected_function, 4294967295u32) {
    self_host_linked_method_call_index_for_receiver(
      link,
      module_,
      body,
      receiver,
      name,
    )
  } else {
    Option::Some(selected_function)
  }
}

fn self_host_linked_method_result_argument_shape_for_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let inferred_receiver_nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    receiver,
  )
  let receiver_nominal = if self_host_u64_equal(
    inferred_receiver_nominal,
    0u64,
  ) {
    self_host_linked_callable_receiver_nominal_by_name(link, name)
  } else {
    inferred_receiver_nominal
  }
  if self_host_u64_equal(receiver_nominal, 0u64) {
    return Option::None
  }
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && self_host_bytes_equal_string(callable.name, name) &&
          self_host_u64_equal(
            self_host_linked_resolved_nominal_declaration(
              candidate_module,
              callable.self_type,
            ),
            receiver_nominal,
          ) && self_host_u32_equal(
            self_host_program_specialization_callable_generics(callable).length,
            0u32,
          ) {
          return self_host_linked_resolved_type_argument_shape(
            candidate_module,
            callable.result_type,
            argument,
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}



fn self_host_linked_logical_operand_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  operand: U32,
) -> SelfHostWasmBodyCarrier {
  let mut selected_operand = operand
  let mut selected_depth = 0u32
  let _ = while selected_depth {
    current => if current < 8u32 && selected_operand < module_.expressions.length() {
      match module_.expressions[selected_operand].kind {
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            break self_host_semantic_unit()
          }
          selected_operand = tail
          continue current + 1u32
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          selected_operand,
          0u32,
        ) {
          selected_operand = selected_operand - 1u32
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
        _ => break self_host_semantic_unit()
      }
    } else {
      break self_host_semantic_unit()
    }
  }
  if selected_operand < module_.expressions.length() {
    let selected_call = match module_.expressions[selected_operand].kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(
        declaration,
        _,
        _,
        _,
      ) => self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        selected_operand,
        declaration,
      )
      SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        selected_operand,
        0u64,
      )
      _ => Option::None
    }
    match selected_call {
      Option::Some(function_index) => {
        let physical = self_host_body_carrier_from_shape(
          self_host_linked_physical_function_result_shape(
            link,
            function_index,
          ),
        )
        if !(physical is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
          return physical
        }
      }
      Option::None => {}
    }
  }
  let exact = self_host_linked_exact_emitted_expression_carrier(
    canonical,
    link,
    module_,
    body,
    caller_specialization,
    operand,
  )
  if !(exact is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
    return exact
  }
  if operand < module_.expressions.length() {
    let planned = self_host_body_carrier_from_shape(
      module_.expressions[operand].shape,
    )
    if !(planned is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
      return planned
    }
    return self_host_body_carrier_from_shape(
      self_host_linked_backend_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        operand,
      ),
    )
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_linked_assert_logical_operands(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  left: U32,
  right: U32,
) -> Option<String> {
  let left_carrier = self_host_linked_logical_operand_carrier(
    canonical,
    link,
    module_,
    body,
    caller_specialization,
    left,
  )
  let right_carrier = self_host_linked_logical_operand_carrier(
    canonical,
    link,
    module_,
    body,
    caller_specialization,
    right,
  )
  let left_invalid = !(left_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
    left_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
  ) && !(left_carrier is SelfHostWasmBodyCarrier::I32BodyCarrier)
  let right_invalid = !(right_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
    right_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
  ) && !(right_carrier is SelfHostWasmBodyCarrier::I32BodyCarrier)
  if left_invalid || right_invalid {
    // Logical operands must each leave one I32 condition on the stack.
    let message = StringBuilder::new()
    message.append("linked logical operand carrier invariant failed module=")
    message.append_u64(module_.module_id)
    message.append(" declaration=")
    message.append_u64(body.declaration)
    message.append(" name=")
    message.append(bytes_to_string(self_host_linked_declaration_name(
      link,
      body.declaration,
    )))
    message.append(" body=")
    message.append_u64(body.body)
    message.append(" specialization=")
    message.append_u32(caller_specialization)
    message.append(" expression=")
    message.append_u32(expression)
    message.append(" left=")
    message.append_u32(left)
    if left < module_.expressions.length() {
      message.append(":")
      message.append(self_host_body_expression_kind_name(
        module_.expressions[left].kind,
      ))
      message.append(":")
      message.append(self_host_program_representation_shape_name(
        module_.expressions[left].shape,
      ))
    }
    message.append(" left_carrier=")
    message.append(self_host_body_carrier_name(left_carrier))
    message.append(" right=")
    message.append_u32(right)
    if right < module_.expressions.length() {
      message.append(":")
      message.append(self_host_body_expression_kind_name(
        module_.expressions[right].kind,
      ))
      message.append(":")
      message.append(self_host_program_representation_shape_name(
        module_.expressions[right].shape,
      ))
    }
    message.append(" right_carrier=")
    message.append(self_host_body_carrier_name(right_carrier))
    return Option::Some(message.finish())
  }
  Option::None
}

fn self_host_linked_assert_array_get_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  selected_shape: SelfHostPlannedValueShape,
) -> Option<String> {
  let expected = self_host_linked_exact_emitted_expression_carrier(
    canonical,
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
  let actual = self_host_body_carrier_from_shape(selected_shape)
  if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
    expected is SelfHostWasmBodyCarrier::NeverBodyCarrier
  ) && !(actual is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
    !self_host_body_carrier_equal(expected, actual) {
    let message = StringBuilder::new()
    message.append("linked Array get carrier mismatch module=")
    message.append_u64(module_.module_id)
    message.append(" declaration=")
    message.append_u64(body.declaration)
    message.append(" name=")
    message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
    message.append(" specialization=")
    message.append_u32(caller_specialization)
    message.append(" expression=")
    message.append_u32(expression)
    message.append(" expected=")
    message.append(self_host_body_carrier_name(expected))
    message.append(" actual=")
    message.append(self_host_body_carrier_name(actual))
    if expression < module_.expressions.length() {
      message.append(" kind=")
      message.append(self_host_body_expression_kind_name(
        module_.expressions[expression].kind,
      ))
      message.append(" variant=")
      message.append(if self_host_linked_expression_is_variant_call(
        link,
        body.body,
        expression,
      ) {
        "true"
      } else {
        "false"
      })
      message.append(" ref_constructor=")
      message.append(if self_host_linked_runtime_reference_constructor(
        module_,
        expression,
      ) {
        "true"
      } else {
        "false"
      })
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          target,
          _,
          _,
        ) => {
          message.append(" target=")
          message.append_u32(target)
          match self_host_linked_direct_receiver_expression(module_, target) {
            Option::Some(receiver) => {
              message.append(" receiver=")
              message.append_u32(receiver)
              match self_host_linked_canonical_expression_heap_type(
                canonical,
                module_,
                body,
                receiver,
              ) {
                Option::Some(type_index) => {
                  message.append(" heap_type=")
                  message.append_u32(type_index)
                  message.append(" heap_carrier=")
                  message.append(self_host_body_carrier_name(
                    self_host_linked_fixed_array_body_carrier_from_type(
                      link,
                      type_index,
                    ),
                  ))
                }
                Option::None => message.append(" heap_type=none")
              }
            }
            Option::None => message.append(" receiver=none")
          }
          match self_host_linked_callable_declared_result_shape(
            link,
            declaration,
          ) {
            Option::Some(shape) => {
              message.append(" declared=")
              message.append(self_host_program_representation_shape_name(shape))
            }
            Option::None => message.append(" declared=none")
          }
          match self_host_linked_canonical_expression_shape(canonical, expression) {
            Option::Some(shape) => {
              message.append(" canonical=")
              message.append(self_host_program_representation_shape_name(shape))
            }
            Option::None => message.append(" canonical=none")
          }
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => {
          message.append(" target=")
          message.append_u32(target)
          message.append(" target_name=")
          if target < module_.expressions.length() {
            let target_source_name = module_.expressions[target].source_name
            if target_source_name < self_host_linked_module_name_count(module_) {
              message.append(self_host_linked_module_name_at(
                module_,
                target_source_name,
              ))
            } else {
              message.append("none")
            }
          } else {
            message.append("none")
          }
        }
        _ => {}
      }
    }
    return Option::Some(message.finish())
  }
  Option::None
}

fn self_host_linked_assert_planned_call_operands(
  link: SelfHostPlannedProgramWasmGCLink,
  plan: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
  function_index: U32,
  call: SelfHostPhysicalCallPlan,
) -> Option<String> {
  if !self_host_u32_equal(call.physical_function, function_index) {
    let message = StringBuilder::new()
    message.append("ABI-701 planned call target differs from emitted target expression=")
    message.append_u32(expression)
    message.append(" planned=")
    message.append_u32(call.physical_function)
    message.append(" emitted=")
    message.append_u32(function_index)
    return Option::Some(message.finish())
  }
  if !call.emits_call {
    return Option::Some("ABI-708 a non-returning argument reached call emission")
  }
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    function_index,
  )
  if !self_host_u32_equal(parameter_count, call.operands.length) {
    let message = StringBuilder::new()
    message.append("ABI-703 physical call operand count mismatch expression=")
    message.append_u32(expression)
    message.append(" parameters=")
    message.append_u32(parameter_count)
    message.append(" operands=")
    message.append_u32(call.operands.length)
    return Option::Some(message.finish())
  }
  let mut operand = 0u32
  let _ = while operand {
    current => if current < call.operands.length {
      let source_index = self_host_u32_add(call.operands.start, current)
      if source_index >= plan.call_operands.length() {
        return Option::Some("ABI-704 physical call operand is outside its arena")
      }
      let source = plan.call_operands[source_index]
      let source_expression = self_host_body_call_operand_expression(source)
      let expected = self_host_body_carrier_from_shape(
        self_host_linked_physical_function_parameter_shape(
          link,
          function_index,
          current,
        ),
      )
      match self_host_body_plan_expression(plan, source_expression) {
        Option::Some(actual) => if actual.carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
          actual.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
          return Option::Some("ABI-708 erased value reached physical call emission")
        } else if actual.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
          actual.carrier is SelfHostWasmBodyCarrier::ConflictingBodyCarrier ||
          !self_host_body_carrier_equal(expected, actual.carrier) {
          let message = StringBuilder::new()
          message.append("ABI-705 physical call operand carrier mismatch expression=")
          message.append_u32(expression)
          message.append(" operand=")
          message.append_u32(current)
          message.append(" source=")
          message.append_u32(source_expression)
          message.append(" expected=")
          message.append(self_host_body_carrier_name(expected))
          message.append(" actual=")
          message.append(self_host_body_carrier_name(actual.carrier))
          return Option::Some(message.finish())
        }
        Option::None => return Option::Some(
          "ABI-704 physical call operand has no expression plan",
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = module_
  Option::None
}

fn self_host_linked_assert_call_arguments(
  link: SelfHostPlannedProgramWasmGCLink,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  function_index: U32,
  arguments: SelfHostHirSpan,
) -> Option<String> {
  let parameter_count = self_host_linked_physical_function_parameter_count(
    link,
    function_index,
  )
  let contextual_expected_result = self_host_linked_expression_expected_shape(
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
  let expected_result = if expression < module_.expressions.length() {
    match module_.expressions[expression].kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(
        declaration,
        _,
        _,
        _,
      ) => match self_host_linked_callable_declared_result_shape(
        link,
        declaration,
      ) {
        Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
          contextual_expected_result
        } else {
          shape
        }
        Option::None => contextual_expected_result
      }
      _ => contextual_expected_result
    }
  } else {
    contextual_expected_result
  }
  let physical_result = self_host_linked_physical_function_result_shape(
    link,
    function_index,
  )
  let expected_result_carrier = self_host_body_carrier_from_shape(expected_result)
  let physical_result_carrier = self_host_body_carrier_from_shape(physical_result)
  if !(expected_result_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
    expected_result_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
  ) && !(expected_result_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && (
    physical_result_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
      physical_result_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
      physical_result_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
  ) {
    // A value-producing call must have one physical result before emission.
    let message = StringBuilder::new()
    message.append("linked call result carrier invariant failed module=")
    message.append_u64(module_.module_id)
    message.append(" declaration=")
    message.append_u64(body.declaration)
    message.append(" name=")
    message.append(bytes_to_string(self_host_linked_declaration_name(
      link,
      body.declaration,
    )))
    message.append(" body=")
    message.append_u64(body.body)
    message.append(" specialization=")
    message.append_u32(caller_specialization)
    message.append(" expression=")
    message.append_u32(expression)
    if expression < module_.expressions.length() {
      message.append(":")
      message.append(self_host_body_expression_kind_name(
        module_.expressions[expression].kind,
      ))
      message.append(" source_shape=")
      message.append(self_host_program_representation_shape_name(
        module_.expressions[expression].shape,
      ))
    }
    message.append(" function=")
    message.append_u32(function_index)
    message.append(":")
    message.append(bytes_to_string(self_host_linked_physical_function_name(
      link,
      function_index,
    )))
    message.append(" expected=")
    message.append(self_host_body_carrier_name(expected_result_carrier))
    message.append(" actual=")
    message.append(self_host_body_carrier_name(physical_result_carrier))
    return Option::Some(message.finish())
  }
  match canonical {
    Option::Some(plan) => match self_host_body_call_plan(plan, expression) {
      Option::Some(call) => return self_host_linked_assert_planned_call_operands(
        link,
        plan,
        module_,
        expression,
        function_index,
        call,
      )
      Option::None => {}
    }
    Option::None => {}
  }
  if parameter_count < arguments.length {
    let message = StringBuilder::new()
    message.append("linked call argument count invariant failed module=")
    message.append_u64(module_.module_id)
    message.append(" declaration=")
    message.append_u64(body.declaration)
    message.append(" body=")
    message.append_u64(body.body)
    message.append(" expression=")
    message.append_u32(expression)
    message.append(" function=")
    message.append_u32(function_index)
    message.append(" parameters=")
    message.append_u32(parameter_count)
    message.append(" arguments=")
    message.append_u32(arguments.length)
    return Option::Some(message.finish())
  }
  let parameter_offset = parameter_count - arguments.length
  let mut argument = 0u32
  let _ = while argument {
    current => if current < arguments.length {
      let child = self_host_u32_add(arguments.start, current)
      if child >= module_.expression_children.length() {
        return Option::Some("linked call argument invariant has an invalid child")
      }
      let argument_expression = module_.expression_children[child]
      let actual = self_host_linked_call_argument_shape(
        link,
        canonical,
        module_,
        body,
        caller_specialization,
        argument_expression,
      )
      let expected = self_host_linked_physical_function_parameter_shape(
        link,
        function_index,
        self_host_u32_add(parameter_offset, current),
      )
      let planned_exact_actual_carrier = self_host_linked_exact_emitted_expression_carrier(
        canonical,
        link,
        module_,
        body,
        caller_specialization,
        argument_expression,
      )
      let exact_actual_carrier = if argument_expression < module_.expressions.length() {
        match module_.expressions[argument_expression].kind {
          SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_index_operand_shape(
            link,
            module_,
            body,
            caller_specialization,
            local,
          ) {
            Option::Some(shape) => {
              let recovered = self_host_body_carrier_from_shape(shape)
              if !(recovered is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                recovered is SelfHostWasmBodyCarrier::EqRefBodyCarrier
              ) {
                recovered
              } else {
                planned_exact_actual_carrier
              }
            }
            Option::None => planned_exact_actual_carrier
          }
          _ => planned_exact_actual_carrier
        }
      } else {
        planned_exact_actual_carrier
      }
      let expected_carrier = self_host_body_carrier_from_shape(expected)
      if !(exact_actual_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
        exact_actual_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
      ) && !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) &&
        !self_host_body_carrier_equal(expected_carrier, exact_actual_carrier) {
        // A call operand must use the carrier of its physical parameter.
        let message = StringBuilder::new()
        message.append("linked exact call argument carrier invariant failed module=")
        message.append_u64(module_.module_id)
        message.append(" declaration=")
        message.append_u64(body.declaration)
        message.append(" name=")
        message.append(bytes_to_string(self_host_linked_declaration_name(
          link,
          body.declaration,
        )))
        message.append(" body=")
        message.append_u64(body.body)
        message.append(" specialization=")
        message.append_u32(caller_specialization)
        message.append(" expression=")
        message.append_u32(expression)
        message.append(" argument=")
        message.append_u32(current)
        message.append(" argument_expression=")
        message.append_u32(argument_expression)
        message.append(":")
        if argument_expression < module_.expressions.length() {
          message.append(self_host_body_expression_kind_name(
            module_.expressions[argument_expression].kind,
          ))
        }
        message.append(" function=")
        message.append_u32(function_index)
        message.append(":")
        message.append(bytes_to_string(self_host_linked_physical_function_name(
          link,
          function_index,
        )))
        message.append(" function_module=")
        message.append_u64(self_host_linked_physical_function_module_id(
          link,
          function_index,
        ))
        if expression < module_.expressions.length() {
          match module_.expressions[expression].kind {
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              call_declaration,
              call_target,
              _,
              _,
            ) => {
              message.append(" call_declaration=")
              message.append_u64(call_declaration)
              message.append(" call_module=")
              message.append_u64(self_host_semantic_id_module(call_declaration))
              message.append(" call_has_receiver=")
              message.append(if self_host_linked_declaration_has_receiver(
                link,
                call_declaration,
              ) {
                "true"
              } else {
                "false"
              })
              message.append(" call_target=")
              message.append_u32(call_target)
              if call_target < module_.expressions.length() {
                message.append(":")
                message.append(self_host_body_expression_kind_name(
                  module_.expressions[call_target].kind,
                ))
              }
            }
            _ => {}
          }
        }
        message.append(" expected=")
        message.append(self_host_body_carrier_name(expected_carrier))
        message.append(" actual=")
        message.append(self_host_body_carrier_name(exact_actual_carrier))
        return Option::Some(message.finish())
      }
      if actual is SelfHostPlannedValueShape::ErrorPlannedValueShape && !(
        expected is SelfHostPlannedValueShape::ErrorPlannedValueShape
      ) {
        let message = StringBuilder::new()
        message.append("linked call argument unresolved invariant failed module=")
        message.append_u64(module_.module_id)
        message.append(" declaration=")
        message.append_u64(body.declaration)
        message.append(" name=")
        message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
        message.append(" body=")
        message.append_u64(body.body)
        message.append(" specialization=")
        message.append_u32(caller_specialization)
        message.append(" expression=")
        message.append_u32(expression)
        message.append(" argument=")
        message.append_u32(current)
        message.append(" argument_expression=")
        message.append_u32(argument_expression)
        message.append(":")
        if argument_expression < module_.expressions.length() {
          message.append(self_host_body_expression_kind_name(module_.expressions[argument_expression].kind))
        }
        message.append(" function=")
        message.append_u32(function_index)
        message.append(":")
        message.append(bytes_to_string(self_host_linked_physical_function_name(link, function_index)))
        message.append(" expected=")
        message.append(self_host_linked_shape_name(expected))
        return Option::Some(message.finish())
      }
      if !(actual is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
        expected is SelfHostPlannedValueShape::ErrorPlannedValueShape
      ) && self_host_linked_array_carrier_from_shape(actual) !=
        self_host_linked_array_carrier_from_shape(expected) {
        let message = StringBuilder::new()
        message.append("linked call argument carrier invariant failed module=")
        message.append_u64(module_.module_id)
        message.append(" declaration=")
        message.append_u64(body.declaration)
        message.append(" name=")
        message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
        message.append(" body=")
        message.append_u64(body.body)
        message.append(" specialization=")
        message.append_u32(caller_specialization)
        message.append(" expression=")
        message.append_u32(expression)
        message.append(" argument=")
        message.append_u32(current)
        message.append(" argument_expression=")
        message.append_u32(argument_expression)
        if argument_expression < module_.expressions.length() {
          message.append(":")
          message.append(self_host_body_expression_kind_name(
            module_.expressions[argument_expression].kind,
          ))
          message.append(" source_shape=")
          message.append(self_host_linked_shape_name(
            module_.expressions[argument_expression].shape,
          ))
        }
        message.append(" exact=")
        message.append(self_host_body_carrier_name(exact_actual_carrier))
        message.append(" function=")
        message.append_u32(function_index)
        message.append(":")
        message.append(bytes_to_string(self_host_linked_physical_function_name(link, function_index)))
        message.append(" expected=")
        message.append(self_host_linked_shape_name(expected))
        message.append(" actual=")
        message.append(self_host_linked_shape_name(actual))
        match canonical {
          Option::Some(plan) => match self_host_body_plan_expression(
            plan,
            argument_expression,
          ) {
            Option::Some(planned_argument) => {
              message.append(" canonical=")
              message.append(self_host_body_carrier_name(
                planned_argument.carrier,
              ))
              message.append(" planned_function=")
              message.append_u32(planned_argument.call_function_index)
              if planned_argument.call_function_index != 4294967295u32 {
                let planned_physical = self_host_linked_physical_function_index(
                  planned_argument.call_function_index,
                )
                message.append(":")
                message.append(self_host_linked_shape_name(
                  self_host_linked_physical_function_result_shape(
                    link,
                    planned_physical,
                  ),
                ))
              }
            }
            Option::None => message.append(" canonical=missing-expression")
          }
          Option::None => message.append(" canonical=missing-body")
        }
        return Option::Some(message.finish())
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_i32_push_arguments(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
  instructions: StarshineInstructions,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
) -> Option<String> {
  let mut argument = arguments.length
  let _ = while argument {
    current => if self_host_u32_greater(current, 0u32) {
      let previous = current - 1u32
      let child = self_host_u32_add(arguments.start, previous)
      if child >= module_.expression_children.length() {
        return Option::Some("linked I32 call argument is outside its arena")
      }
      self_host_linked_i32_schedule_expression(
        tasks,
        expression_depths,
        module_.expression_children[child],
        instructions,
        depth,
      )
      continue previous
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}


fn self_host_linked_i32_push_planned_arguments(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  arguments: SelfHostHirSpan,
  function_index: U32,
  instructions: StarshineInstructions,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
) -> Option<String> {
  self_host_linked_i32_push_call_evaluations(canonical, link, module_, body, expression,
    arguments, function_index, instructions, tasks, expression_depths, depth, false,
  )
}

fn self_host_linked_i32_push_call_evaluations(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  arguments: SelfHostHirSpan,
  function_index: U32,
  instructions: StarshineInstructions,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
  include_receiver: Bool,
) -> Option<String> {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => self_host_call_read_failure(module_.module_id, body.declaration, body.body,
      expression, 610u32, 1u64, 0u64, 0u64)
  }
  let call = match self_host_body_call_plan(plan, expression) {
    Option::Some(value) => value
    Option::None => return Option::Some(
      "ABI-704 emitted call has no physical operand recipe",
    )
  }
  if !self_host_u32_equal(call.physical_function, function_index) {
    return Option::Some("ABI-701 planned and emitted call targets differ")
  }
  let mut evaluation = call.evaluations.length
  let _ = while evaluation {
    current => if current > 0u32 {
      let previous = current - 1u32
      let index = self_host_u32_add(call.evaluations.start, previous)
      if index >= plan.call_evaluations.length() {
        return Option::Some("ABI-702 call evaluation is outside its arena")
      }
      let source_expression = plan.call_evaluations[index]
      let receiver = source_expression == call.receiver_expression
      if include_receiver || !receiver {
        match self_host_body_plan_expression(plan, source_expression) {
          Option::Some(source_plan) => if source_plan.carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier {
            self_host_linked_i32_schedule_discarded_expression(
              tasks,
              expression_depths,
              source_expression,
              instructions,
              depth,
            )
          } else {
            self_host_linked_i32_schedule_expression(
              tasks,
              expression_depths,
              source_expression,
              instructions,
              depth,
            )
          }
          Option::None => return Option::Some(
            "ABI-704 call evaluation has no expression plan",
          )
        }
      }
      continue previous
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_i32_planned_call_emits(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
) -> Bool {
  match canonical {
    Option::Some(plan) => match self_host_body_call_plan(plan, expression) {
      Option::Some(call) => call.emits_call
      Option::None => true
    }
    Option::None => true
  }
}

fn self_host_linked_schedule_frozen_call(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  specialization: U32,
  expression: U32,
  function_index: U32,
  arguments: SelfHostHirSpan,
  destination: StarshineInstructions,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
) -> Option<String> {
  match canonical {
    Option::Some(plan) => if self_host_body_call_plan(plan, expression) is Option::None {
      return Option::Some("ABI-704 call is missing its frozen evaluation recipe")
    }
    Option::None => return Option::Some("BOD-610 call is missing its frozen body plan")
  }
  if self_host_linked_i32_planned_call_emits(canonical, expression) {
    match self_host_linked_assert_call_arguments(link, canonical, module_, body, specialization, expression, function_index, arguments) {
      Option::Some(error) => return Option::Some(error)
      Option::None => {}
    }
    self_host_linked_schedule_call_result_adapter(canonical, link, module_, body, specialization, expression, function_index, tasks, destination)
    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(function_index, destination))
  }
  self_host_linked_i32_push_call_evaluations(canonical, link, module_, body, expression, arguments, function_index, destination, tasks, expression_depths, depth, true)
}

fn self_host_linked_call_has_erased_specialization(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  expression: U32,
) -> Bool {
  match canonical {
    Option::Some(plan) => match self_host_body_call_plan(plan, expression) {
      Option::Some(call) => if call.specialization != 4294967295u32 {
        let request = link.fragments.specialization.requests[call.specialization]
        while 0u32 {
          index if index < request.shapes.length => {
            if link.fragments.specialization.shapes[request.shapes.start + index] is SelfHostPlannedValueShape::UnitPlannedValueShape {
              return true
            }
            continue index + 1u32
          }
          _ => break self_host_semantic_unit()
        }
      }
      Option::None => {}
    }
    Option::None => {}
  }
  false
}

fn self_host_body_plan_expression_from_optional(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
) -> Option<SelfHostPlannedPhysicalExpressionCarrier> {
  match canonical {
    Option::Some(plan) => self_host_body_plan_expression(plan, expression)
    Option::None => Option::None
  }
}

fn self_host_linked_canonical_field(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
) -> Option<SelfHostLinkedWasmFieldLink> {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(planned) => if !self_host_u64_equal(
        planned.selected_field,
        0u64,
      ) && planned.selected_type_index != 4294967295u32 &&
        planned.selected_field_index != 4294967295u32 {
        return Option::Some(SelfHostLinkedWasmFieldLink::{
          type_index: planned.selected_type_index
          field_index: planned.selected_field_index
        })
      }
      Option::None => {}
    }
    Option::None => {}
  }
  Option::None
}

fn self_host_linked_canonical_type(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
) -> Option<U32> {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(planned) => if planned.selected_type_index != 4294967295u32 {
        Option::Some(planned.selected_type_index)
      } else if planned.value.physical_heap_type != 4294967295u32 {
        Option::Some(planned.value.physical_heap_type)
      } else {
        Option::None
      }
      Option::None => Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_canonical_expression_heap_type(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<U32> {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return Option::None
  }
  let mut current = expression
  let mut depth = 0u32
  let _ = while depth {
    level => if level < 8u32 && current < module_.expressions.length() {
      match module_.expressions[current].kind {
        SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => match self_host_body_plan_expression(
          plan,
          current,
        ) {
          Option::Some(planned) => if !self_host_u32_equal(
            planned.value.physical_heap_type,
            4294967295u32,
          ) {
            // A field expression uses its result heap type, not its receiver type.
            return Option::Some(planned.value.physical_heap_type)
          }
          Option::None => {}
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => match self_host_body_plan_expression(
          plan,
          current,
        ) {
          Option::Some(planned) => if !self_host_u32_equal(
            planned.value.physical_heap_type,
            4294967295u32,
          ) {
            // A resolved field plan uses its result heap type before emission.
            return Option::Some(planned.value.physical_heap_type)
          }
          Option::None => {}
        }
        _ => {}
      }
      match self_host_linked_canonical_type(canonical, current) {
        Option::Some(type_index) => return Option::Some(type_index)
        Option::None => {}
      }
      match module_.expressions[current].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
          let slot = self_host_body_local_slot(module_, body, local_id)
          if slot < plan.local_values.length() && !self_host_u32_equal(
            plan.local_values[slot].physical_heap_type,
            4294967295u32,
          ) {
            return Option::Some(plan.local_values[slot].physical_heap_type)
          }
          return Option::None
        }
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          current,
          0u32,
        ) {
          current = current - 1u32
          continue level + 1u32
        }
        _ => {}
      }
      break self_host_semantic_unit()
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_expression_is_fixed_array_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  _body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  let planned = module_.expressions[expression]
  let owner = if planned.nominal != 0u64 {
    planned.nominal
  } else {
    self_host_linked_type_nominal_declaration(module_, planned.type_)
  }
  self_host_linked_is_raw_array_owner(link, owner)
}

fn self_host_linked_canonical_expression_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(value) => Option::Some(
        self_host_body_carrier_shape(value.carrier),
      )
      Option::None => Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_linked_refine_canonical_expression_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
  shape: SelfHostPlannedValueShape,
) -> Bool {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return false
  }
  let carrier = self_host_body_carrier_from_shape(shape)
  if carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return false
  }
  // A canonical plan has passed the planner's freeze point. Emission may
  // check its evidence, but must never repair or replace that evidence.
  match self_host_body_plan_expression(plan, expression) {
    Option::Some(source) => {
      if !self_host_body_carrier_equal(source.carrier, carrier) {
        let _ = self_host_assert_compiler_invariant_with_failure(
          false,
          SelfHostInvariantFailure::{
            code: 605u32
            phase: 6u32
            module_id: plan.module_id
            declaration: plan.declaration
            body: plan.body
            expression: expression
            expected: self_host_body_carrier_code(source.carrier)
            actual: self_host_body_carrier_code(carrier)
            detail: u32_into_u64(plan.physical_function_index)
          },
          "emission attempted to change a frozen carrier",
        )
      }
    }
    Option::None => {
      let _ = self_host_assert_compiler_invariant_with_failure(
        false,
        SelfHostInvariantFailure::{
          code: 606u32
          phase: 6u32
          module_id: plan.module_id
          declaration: plan.declaration
          body: plan.body
          expression: expression
          expected: u32_into_u64(plan.expressions.length())
          actual: u32_into_u64(expression)
          detail: u32_into_u64(plan.physical_function_index)
        },
        "emission expression is absent from the frozen plan",
      )
    }
  }
  false
}

fn self_host_linked_canonical_or_inferred_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
  inferred: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(planned) => {
        let shape = self_host_body_carrier_shape(planned.carrier)
        if !self_host_u64_equal(planned.value.nominal_owner, 0u64) ||
          planned.value.physical_heap_type != 4294967295u32 || !(
          self_host_physical_scalar_shape(shape) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) {
          shape
        } else if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          self_host_physical_scalar_shape(inferred) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) {
          inferred
        } else {
          shape
        }
      }
      Option::None => inferred
    }
    Option::None => inferred
  }
}

fn self_host_linked_canonical_container_argument_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match canonical {
        Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
          Option::Some(value) => if !self_host_u64_equal(value.selected_field, 0u64) {
            match self_host_linked_struct_field(link, value.selected_field) {
              Option::Some(field) => return self_host_linked_field_container_argument_shape(
                link,
                field,
                argument,
              )
              Option::None => {}
            }
          }
          Option::None => {}
        }
        Option::None => {}
      }
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => return Option::None
        }
        _ => return Option::None
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}



fn self_host_linked_canonical_map_get_value_shape(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Option<SelfHostPlannedValueShape> {
  if root >= module_.expressions.length() {
    return Option::None
  }
  let mut receiver = 4294967295u32
  match module_.expressions[root].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(module_) &&
          self_host_linked_module_name_at(module_, name) == "get" {
          receiver = base
        }
        _ => {}
      }
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => if self_host_linked_declaration_name(link, declaration).ends_with(b"get") {
      if target < module_.expressions.length() {
        match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => {
            receiver = base
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => {
            receiver = base
          }
          _ => {}
        }
      }
      if self_host_u32_equal(receiver, 4294967295u32) &&
        self_host_u32_greater(arguments.length, 0u32) &&
        arguments.start < module_.expression_children.length() {
        receiver = module_.expression_children[arguments.start]
      }
    }
    _ => {}
  }
  if self_host_u32_equal(receiver, 4294967295u32) {
    Option::None
  } else {
    self_host_linked_canonical_container_argument_shape(
      canonical,
      link,
      module_,
      body,
      receiver,
      1u32,
    )
  }
}


fn self_host_linked_source_or_inferred_item_shape(
  source: Option<SelfHostPlannedValueShape>,
  inferred: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  match source {
    Option::Some(shape) => if self_host_physical_scalar_shape(
      shape,
    ) is SelfHostPlannedValueShape::RefPlannedValueShape && !(
      inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape
    ) && !(
      self_host_physical_scalar_shape(inferred) is SelfHostPlannedValueShape::RefPlannedValueShape
    ) {
      inferred
    } else {
      shape
    }
    Option::None => inferred
  }
}





fn self_host_emit_linked_i32_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  canonical_body_plan: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  function_value_signatures: Array<SelfHostLinkedFunctionValueSignature>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expected_result_shape: SelfHostPlannedValueShape,
  caller_specialization: U32,
  instructions: StarshineInstructions,
) -> Option<String> {
  match self_host_emit_capture_parameters(link, canonical_body_plan, module_, body, instructions) {
    Option::Some(error) => return Option::Some(error)
    Option::None => {}
  }
  let mut invariant_relative = 0u32
  let _ = while invariant_relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      let mut function_index = 4294967295u32
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => match self_host_linked_canonical_call_index(
          canonical_body_plan,
          link,
          body,
          caller_specialization,
          expression,
          declaration,
        ) {
          Option::Some(value) => {
            function_index = value
          }
          Option::None => {}
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => match self_host_linked_canonical_call_index(
          canonical_body_plan,
          link,
          body,
          caller_specialization,
          expression,
          0u64,
        ) {
          Option::Some(value) => {
            function_index = value
          }
          Option::None => {}
        }
        SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, target) => match target {
          SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => match self_host_linked_canonical_call_index(
            canonical_body_plan,
            link,
            body,
            caller_specialization,
            expression,
            declaration,
          ) {
            Option::Some(value) => {
            function_index = value
          }
            Option::None => {}
          }
          _ => {}
        }
        _ => {}
      }
      if !self_host_u32_equal(function_index, 4294967295u32) {
        match self_host_linked_canonical_expression_shape(
          canonical_body_plan,
          expression,
        ) {
          Option::Some(expected) => {
            let actual = self_host_linked_physical_function_result_shape(
              link,
              function_index,
            )
            if !(expected is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
              expected is SelfHostPlannedValueShape::NeverPlannedValueShape
            ) && !(actual is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
              self_host_linked_array_carrier_from_shape(expected) !=
                self_host_linked_array_carrier_from_shape(actual) {
              let message = StringBuilder::new()
              message.append("linked call ABI invariant failed module=")
              message.append_u64(module_.module_id)
              message.append(" declaration=")
              message.append_u64(body.declaration)
              message.append(" name=")
              message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
              message.append(" body=")
              message.append_u64(body.body)
              message.append(" specialization=")
              message.append_u32(caller_specialization)
              message.append(" expression=")
              message.append_u32(expression)
              message.append(" kind=")
              message.append(self_host_body_expression_kind_name(module_.expressions[expression].kind))
              message.append(" function=")
              message.append_u32(function_index)
              message.append(":")
              message.append(bytes_to_string(self_host_linked_physical_function_name(link, function_index)))
              match canonical_body_plan {
                Option::Some(plan) => match self_host_body_plan_expression(
                  plan,
                  expression,
                ) {
                  Option::Some(planned_call) => {
                    message.append(" planned_function=")
                    message.append_u32(planned_call.call_function_index)
                    if planned_call.call_function_index != 4294967295u32 {
                      let planned_physical = self_host_linked_physical_function_index(
                        planned_call.call_function_index,
                      )
                      message.append(":")
                      message.append(bytes_to_string(self_host_linked_physical_function_name(
                        link,
                        planned_physical,
                      )))
                      message.append(":result=")
                      message.append(self_host_linked_shape_name(
                        self_host_linked_physical_function_result_shape(
                          link,
                          planned_physical,
                        ),
                      ))
                    }
                  }
                  Option::None => {}
                }
                Option::None => {}
              }
              message.append(" expected=")
              message.append(self_host_linked_shape_name(expected))
              message.append(" actual=")
              message.append(self_host_linked_shape_name(actual))
              return Option::Some(message.finish())
            }
          }
          Option::None => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let tasks = []
  let discarded_expressions = self_host_inference_bool_slots(
    module_.expressions.length(),
  )
  let expression_depths = self_host_program_link_u32_slots(
    module_.expressions.length(),
  )
  let block_depths = self_host_program_link_u32_slots(module_.blocks.length())
  let loop_links = []
  let pattern_subject_nominals = self_host_linked_pattern_subject_nominals(
    link,
    module_,
    body,
    canonical_body_plan,
  )
  let discard_body_result = expected_result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(root) => if discard_body_result {
      self_host_linked_i32_schedule_discarded_expression(
        tasks,
        expression_depths,
        root,
        instructions,
        0u32,
      )
    } else {
      self_host_linked_i32_schedule_expression(
        tasks,
        expression_depths,
        root,
        instructions,
        0u32,
      )
    }
    SelfHostHirBodyRoot::BlockBodyRoot(root) => self_host_linked_i32_schedule_block(
      tasks,
      block_depths,
      root,
      instructions,
      0u32,
      discard_body_result,
    )
  }
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match self_host_array_pop(tasks) {
        Option::Some(value) => value
        Option::None => SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          4294967295u32,
          instructions,
        )
      }
      match task {
        SelfHostLinkedI32EmitTask::VisitLinkedI32DiscardedExpression(
          expression,
          destination,
        ) => {
          if expression < discarded_expressions.length() {
            discarded_expressions[expression] = true
          }
          // Control nodes discard their own children. Every other value is
          // discarded here, including a direct scalar match arm.
          let controls_discard = expression < module_.expressions.length() && (
            module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) ||
              module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) ||
              module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) ||
              module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedBlockExpression(_)
          )
          if !controls_discard && self_host_linked_planned_expression_emits_value(
            canonical_body_plan, link, module_, body, caller_specialization, expression,
          ) {
            tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination))
          }
          tasks.push(SelfHostLinkedI32EmitTask::ClearLinkedI32Discard(
            expression,
          ))
          tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
            expression,
            destination,
          ))
        }
        SelfHostLinkedI32EmitTask::ClearLinkedI32Discard(expression) => if expression < discarded_expressions.length() {
          discarded_expressions[expression] = false
        }
        SelfHostLinkedI32EmitTask::EmitLinkedArrayLiteral(array_type, wrapper_type, length, destination) => {
          StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_array_new_fixed(
            StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(array_type)),
            StarshineFfi.ffi_lib_U32_new(self_host_u32_to_i32(length)),
          ))
          StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(length))))
          StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(self_host_u32_to_i32(length))))
          StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_struct_new(StarshineFfi.ffi_lib_TypeIdx_new(self_host_u32_to_i32(wrapper_type))))
        }
        SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          expression,
          destination,
        ) => {
          if self_host_u32_equal(expression, 4294967295u32) {
            continue tasks.length()
          }
          if expression >= module_.expressions.length() {
            let message = StringBuilder::new()
            message.append("linked I32 expression is outside its arena: ")
            message.append_u32(expression)
            return Option::Some(message.finish())
          }
          let planned = module_.expressions[expression]
          let depth = if expression < expression_depths.length() && !self_host_u32_equal(
            expression_depths[expression],
            4294967295u32,
          ) {
            expression_depths[expression]
          } else {
            0u32
          }
          match self_host_variant_constructor_arguments(planned) {
            Option::Some(arguments) => {
              self_host_schedule_planned_variant_constructor(canonical_body_plan, module_, body, expression, arguments, tasks, expression_depths, destination, depth)
              continue tasks.length()
            }
            Option::None => {}
          }
          match planned.kind {
            SelfHostPlannedExpressionKind::PlannedI8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f32_const(
                StarshineFfi.ffi_lib_F32_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f64_const(
                StarshineFfi.ffi_lib_F64_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
              let mut constant = 0i32
              if value {
                constant = 1i32
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_i32_const(
                  StarshineFfi.ffi_lib_I32_new(constant),
                ),
              )
            }
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(operator, operand) => {
              match operator {
                SelfHostHirPrefixOperator::Positive => self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  operand,
                  destination,
                  depth,
                )
                SelfHostHirPrefixOperator::Negative => {
                  let prefix_shape = self_host_body_carrier_shape(
                    self_host_linked_exact_emitted_expression_carrier(
                      canonical_body_plan,
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    ),
                  )
                  match self_host_physical_scalar_shape(prefix_shape) {
                    SelfHostPlannedValueShape::I64PlannedValueShape => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i64_const(
                          StarshineFfi.ffi_lib_I64_new(0i64),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
                        operator,
                        destination,
                      ))
                    }
                    SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
                        operator,
                        destination,
                      ),
                    )
                    SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
                        operator,
                        destination,
                      ),
                    )
                    _ => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i32_const(
                          StarshineFfi.ffi_lib_I32_new(0i32),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                        operator,
                        destination,
                      ))
                    }
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
                SelfHostHirPrefixOperator::LogicalNot => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                    operator,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_i32_local_slot(
              canonical_body_plan,
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => {
                match self_host_linked_local_capture_cell(link, canonical_body_plan, module_, body, local) {
                  Option::Some(cell) => {
                    self_host_emit_capture_local_get(cell.local_slot, destination)
                    self_host_emit_capture_field_get(cell.storage, cell.type_index, 0u32, destination)
                  }
                  Option::None => self_host_emit_capture_local_get(slot, destination)
                }
              }
              Option::None => {
                if !self_host_linked_local_is_erased(canonical_body_plan, module_, body, local) {
                  return Option::Some("linked local read has no physical slot")
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(local, value) => match self_host_linked_i32_local_slot(
              canonical_body_plan,
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => {
                match self_host_linked_local_capture_cell(link, canonical_body_plan, module_, body, local) {
                  Option::Some(cell) => {
                    self_host_emit_capture_local_get(cell.local_slot, destination)
                    StarshineFfi.ffi_ffi_bridge_instructions_push(destination,
                      StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(self_host_u32_to_i32(cell.type_index)),
                    )
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructSet(cell.type_index, 0u32, destination))
                  }
                  Option::None => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(slot, destination))
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
              }
              Option::None => {
                if !self_host_linked_local_is_erased(canonical_body_plan, module_, body, local) {
                  return Option::Some("linked local write has no physical slot")
                }
                self_host_linked_i32_schedule_expression(tasks, expression_depths, value, destination, depth)
              }
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
              let discard_block_final = expression < discarded_expressions.length() &&
                discarded_expressions[expression]
              self_host_linked_i32_schedule_block(
                tasks,
                block_depths,
                block,
                destination,
                depth,
                discard_block_final,
              )
            }
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              condition,
              then_block,
              else_expression,
            ) => {
              if !module_.expressions[condition].flow.falls_through {
                self_host_linked_i32_schedule_expression(tasks, expression_depths, condition, destination, depth)
                continue tasks.length()
              }
              let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let discarded_unit_if = expression < discarded_expressions.length() && discarded_expressions[
                expression
              ]
              let mut result_shape = if discarded_unit_if {
                SelfHostPlannedValueShape::UnitPlannedValueShape
              } else {
                match self_host_linked_canonical_expression_shape(canonical_body_plan, expression) {
                  Option::Some(shape) => shape
                  Option::None => return Option::Some("BOD-610 if expression has no frozen result type")
                }
              }
              let then_tail = self_host_body_block_tail_expression(
                module_,
                then_block,
              )
              let exact_then_carrier = if then_block < module_.blocks.length() &&
                module_.blocks[then_block].flow.falls_through && !self_host_u32_equal(
                  then_tail,
                  4294967295u32,
                ) {
                self_host_linked_exact_emitted_expression_carrier(
                  canonical_body_plan,
                  link,
                  module_,
                  body,
                  caller_specialization,
                  then_tail,
                )
              } else {
                SelfHostWasmBodyCarrier::NeverBodyCarrier
              }
              let exact_else_carrier = if else_expression < module_.expressions.length() &&
                module_.expressions[else_expression].flow.falls_through {
                self_host_linked_exact_emitted_expression_carrier(
                  canonical_body_plan,
                  link,
                  module_,
                  body,
                  caller_specialization,
                  else_expression,
                )
              } else {
                SelfHostWasmBodyCarrier::NeverBodyCarrier
              }
              let mut discard_if_result = result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
              if !discard_if_result && !(exact_then_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                exact_then_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
              ) && !(exact_then_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && !(
                exact_else_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
              ) && !(exact_else_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) && !(
                exact_else_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
              ) {
                if !self_host_body_carrier_equal(
                  exact_then_carrier,
                  exact_else_carrier,
                ) {
                  let message = StringBuilder::new()
                  message.append("linked if exact branch carrier invariant failed module=")
                  message.append_u64(module_.module_id)
                  message.append(" declaration=")
                  message.append_u64(body.declaration)
                  message.append(" name=")
                  message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                  message.append(" body=")
                  message.append_u64(body.body)
                  message.append(" specialization=")
                  message.append_u32(caller_specialization)
                  message.append(" expression=")
                  message.append_u32(expression)
                  message.append(" then_expression=")
                  message.append_u32(then_tail)
                  message.append(" else_expression=")
                  message.append_u32(else_expression)
                  message.append(" selected=")
                  message.append(self_host_linked_shape_name(result_shape))
                  message.append(" then=")
                  message.append(self_host_linked_shape_name(
                    self_host_body_carrier_shape(exact_then_carrier),
                  ))
                  if then_tail < module_.expressions.length() {
                    message.append(":")
                    message.append(self_host_body_expression_kind_name(
                      module_.expressions[then_tail].kind,
                    ))
                    message.append(":")
                    message.append(self_host_linked_shape_name(
                      module_.expressions[then_tail].shape,
                    ))
                    match module_.expressions[then_tail].kind {
                      SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                        message.append(":local=")
                        message.append_u32(local_id)
                        let local_slot = self_host_body_local_slot(
                          module_,
                          body,
                          local_id,
                        )
                        message.append(":slot=")
                        message.append_u32(local_slot)
                        let local_index = self_host_u32_add(
                          body.locals.start,
                          local_slot,
                        )
                        if local_slot < body.locals.length && local_index < module_.locals.length() {
                          let local = self_host_body_planned_local_identity(
                            module_.locals[local_index],
                          )
                          message.append(":declared_type=")
                          message.append_i32(local.type_)
                          message.append(":declared_shape=")
                          message.append(self_host_linked_shape_name(local.shape))
                          message.append(":declared_owner=")
                          message.append_u64(local.nominal)
                          message.append(":local_offset=")
                          message.append_u32(local.offset)
                        }
                        match self_host_linked_local_initializer_expression(
                          module_,
                          body,
                          local_id,
                        ) {
                          Option::Some(initializer) => {
                            message.append(":initializer=")
                            message.append_u32(initializer)
                            if initializer < module_.expressions.length() {
                              message.append(":")
                              message.append(self_host_body_expression_kind_name(
                                module_.expressions[initializer].kind,
                              ))
                              message.append(":")
                              message.append(self_host_linked_shape_name(
                                module_.expressions[initializer].shape,
                              ))
                              message.append(":type=")
                              message.append_i32(module_.expressions[initializer].type_)
                              message.append(":owner=")
                              message.append_u64(module_.expressions[initializer].nominal)
                              message.append(":offset=")
                              message.append_u32(module_.expressions[initializer].offset)
                              match module_.expressions[initializer].kind {
                                SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => {
                                  message.append(":base=")
                                  message.append_u32(base)
                                  message.append(":field_name=")
                                  if name < self_host_linked_module_name_count(module_) {
                                    message.append(self_host_linked_module_name_at(module_, name))
                                  } else {
                                    message.append("<invalid>")
                                  }
                                }
                                _ => {}
                              }
                              match canonical_body_plan {
                                Option::Some(plan) => match self_host_body_plan_expression(
                                  plan,
                                  initializer,
                                ) {
                                  Option::Some(initializer_plan) => {
                                    message.append(":canonical=")
                                    message.append(self_host_body_carrier_name(
                                      initializer_plan.carrier,
                                    ))
                                    message.append(":selected_field=")
                                    message.append_u64(initializer_plan.selected_field)
                                    message.append(":selected_type=")
                                    message.append_u32(initializer_plan.selected_type_index)
                                    message.append(":selected_field_index=")
                                    message.append_u32(initializer_plan.selected_field_index)
                                  }
                                  Option::None => message.append(":canonical=none")
                                }
                                Option::None => message.append(":canonical_plan=none")
                              }
                            }
                          }
                          Option::None => message.append(":initializer=none")
                        }
                        message.append(":canonical_local=")
                        message.append(self_host_body_carrier_name(
                          self_host_linked_canonical_local_carrier(
                            canonical_body_plan,
                            module_,
                            body,
                            local_id,
                          ),
                        ))
                      }
                      _ => {}
                    }
                  }
                  let mut diagnostic_parent = self_host_u32_add(expression, 1u32)
                  let diagnostic_end = self_host_u32_add(
                    body.expressions.start,
                    body.expressions.length,
                  )
                  let _ = while diagnostic_parent {
                    candidate => if candidate < diagnostic_end &&
                      candidate < module_.expressions.length() {
                      match module_.expressions[candidate].kind {
                        SelfHostPlannedExpressionKind::PlannedConstruct(_, fields, _) => {
                          let mut field_offset = 0u32
                          let _ = while field_offset {
                            current_field => if current_field < fields.length {
                              let field_index = self_host_u32_add(
                                fields.start,
                                current_field,
                              )
                              if field_index < module_.object_fields.length() &&
                                self_host_linked_expression_wraps_expression(
                                  module_,
                                  module_.object_fields[field_index].value,
                                  expression,
                                ) {
                                message.append(" constructor_parent=")
                                message.append_u32(candidate)
                                match canonical_body_plan {
                                  Option::Some(plan) => match self_host_body_plan_expression(
                                    plan,
                                    candidate,
                                  ) {
                                    Option::Some(parent_plan) => {
                                      message.append(":type=")
                                      message.append_u32(parent_plan.selected_type_index)
                                    }
                                    Option::None => message.append(":type=none")
                                  }
                                  Option::None => message.append(":plan=none")
                                }
                              }
                              continue current_field + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        SelfHostPlannedExpressionKind::PlannedObjectNew(fields) => {
                          let mut field_offset = 0u32
                          let _ = while field_offset {
                            current_field => if current_field < fields.length {
                              let field_index = self_host_u32_add(
                                fields.start,
                                current_field,
                              )
                              if field_index < module_.object_fields.length() &&
                                self_host_linked_expression_wraps_expression(
                                  module_,
                                  module_.object_fields[field_index].value,
                                  expression,
                                ) {
                                message.append(" object_parent=")
                                message.append_u32(candidate)
                                match canonical_body_plan {
                                  Option::Some(plan) => match self_host_body_plan_expression(
                                    plan,
                                    candidate,
                                  ) {
                                    Option::Some(parent_plan) => {
                                      message.append(":type=")
                                      message.append_u32(parent_plan.selected_type_index)
                                    }
                                    Option::None => message.append(":type=none")
                                  }
                                  Option::None => message.append(":plan=none")
                                }
                              }
                              continue current_field + 1u32
                            } else {
                              break self_host_semantic_unit()
                            }
                          }
                        }
                        _ => {}
                      }
                      continue candidate + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                  message.append(" else=")
                  message.append(self_host_linked_shape_name(
                    self_host_body_carrier_shape(exact_else_carrier),
                  ))
                  if else_expression < module_.expressions.length() {
                    message.append(":")
                    message.append(self_host_body_expression_kind_name(
                      module_.expressions[else_expression].kind,
                    ))
                    message.append(":")
                    message.append(self_host_linked_shape_name(
                      module_.expressions[else_expression].shape,
                    ))
                  }
                  return Option::Some(message.finish())
                }
                let selected_carrier = self_host_body_carrier_from_shape(
                  result_shape,
                )
                if !self_host_body_carrier_equal(
                  selected_carrier,
                  exact_then_carrier,
                ) {
                  result_shape = self_host_body_carrier_shape(
                    exact_then_carrier,
                  )
                }
              }
              if !discard_if_result && !(exact_then_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                exact_then_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
              ) && !(exact_then_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && exact_else_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
                result_shape = self_host_body_carrier_shape(exact_then_carrier)
              } else if !discard_if_result && !(exact_else_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                exact_else_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
              ) && !(exact_else_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && exact_then_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
                result_shape = self_host_body_carrier_shape(exact_else_carrier)
              }
              let selected_if_carrier = self_host_body_carrier_from_shape(
                result_shape,
              )
              let then_carrier_conflict = !discard_if_result && !(exact_then_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                exact_then_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
              ) && !(exact_then_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && !self_host_body_carrier_equal(
                selected_if_carrier,
                exact_then_carrier,
              )
              let else_carrier_conflict = !discard_if_result && !(exact_else_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                exact_else_carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier
              ) && !(exact_else_carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier) && !self_host_body_carrier_equal(
                selected_if_carrier,
                exact_else_carrier,
              )
              if then_carrier_conflict || else_carrier_conflict {
                let message = StringBuilder::new()
                message.append("linked if result carrier invariant failed module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(body.declaration)
                message.append(" name=")
                message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                message.append(" body=")
                message.append_u64(body.body)
                message.append(" specialization=")
                message.append_u32(caller_specialization)
                message.append(" expression=")
                message.append_u32(expression)
                message.append(" then_expression=")
                message.append_u32(then_tail)
                if then_tail < module_.expressions.length() {
                  message.append(":")
                  message.append(self_host_body_expression_kind_name(
                    module_.expressions[then_tail].kind,
                  ))
                  message.append(":type=")
                  message.append_i32(self_host_planned_expression_at(module_.expressions, then_tail).type_)
                  message.append(":planned=")
                  message.append(self_host_linked_shape_name(
                    module_.expressions[then_tail].shape,
                  ))
                  message.append(":source=")
                  message.append_u32(module_.expressions[then_tail].source_name)
                  if self_host_u32_greater(
                    module_.names.length(),
                    module_.expressions[then_tail].source_name,
                  ) {
                    message.append(":")
                    message.append(module_.names[
                      module_.expressions[then_tail].source_name
                    ])
                  }
                }
                message.append(" else_expression=")
                message.append_u32(else_expression)
                if else_expression < module_.expressions.length() {
                  message.append(":")
                  message.append(self_host_body_expression_kind_name(
                    module_.expressions[else_expression].kind,
                  ))
                  match module_.expressions[else_expression].kind {
                    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
                      let else_tail = self_host_body_block_tail_expression(
                        module_,
                        block,
                      )
                      message.append(":tail=")
                      message.append_u32(else_tail)
                      if else_tail < module_.expressions.length() {
                        message.append(":")
                        message.append(self_host_body_expression_kind_name(
                          module_.expressions[else_tail].kind,
                        ))
                        message.append(":type=")
                        message.append_i32(self_host_planned_expression_at(module_.expressions, else_tail).type_)
                        message.append(":planned=")
                        message.append(self_host_linked_shape_name(
                          module_.expressions[else_tail].shape,
                        ))
                        message.append(":source=")
                        message.append_u32(module_.expressions[else_tail].source_name)
                        if self_host_u32_greater(
                          module_.names.length(),
                          module_.expressions[else_tail].source_name,
                        ) {
                          message.append(":")
                          message.append(module_.names[
                            module_.expressions[else_tail].source_name
                          ])
                        }
                        match module_.expressions[else_tail].kind {
                          SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => {
                            message.append(":planned=")
                            message.append(self_host_linked_shape_name(
                              module_.expressions[else_tail].shape,
                            ))
                            message.append(":backend=")
                            message.append(self_host_linked_shape_name(
                              self_host_linked_backend_expression_shape(
                                link,
                                module_,
                                body,
                                caller_specialization,
                                else_tail,
                              ),
                            ))
                            message.append(":expected=")
                            message.append(self_host_linked_shape_name(
                              self_host_linked_expression_expected_shape(
                                link,
                                module_,
                                body,
                                caller_specialization,
                                else_tail,
                              ),
                            ))
                            message.append(":base=")
                            message.append_u32(base)
                            message.append(":base_kind=")
                            message.append(self_host_body_expression_kind_name(
                              module_.expressions[base].kind,
                            ))
                            message.append(":base_type=")
                            message.append_i32(self_host_planned_expression_at(module_.expressions, base).type_)
                            message.append(":base_owner=")
                            message.append_u64(self_host_linked_expression_container_owner_module_id(
                              link,
                              module_,
                              body,
                              base,
                            ))
                            message.append(":base_usage=")
                            match self_host_linked_array_value_use_shape(
                              link,
                              module_,
                              body,
                              caller_specialization,
                              canonical_body_plan,
                              base,
                            ) {
                              Option::Some(shape) => message.append(
                                self_host_linked_shape_name(shape),
                              )
                              Option::None => message.append("none")
                            }
                            message.append(":materialized=")
                            match self_host_linked_canonical_materialized_local_shape(
                              canonical_body_plan,
                              module_,
                              body,
                              else_tail,
                            ) {
                              Option::Some(shape) => message.append(
                                self_host_linked_shape_name(shape),
                              )
                              Option::None => message.append("none")
                            }
                            message.append(":target=")
                            match module_.expressions[else_tail].kind {
                              SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, target) => match target {
                                SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => {
                                  message.append_u64(declaration)
                                  message.append(":function=")
                                  match self_host_linked_canonical_call_index(
                                    canonical_body_plan,
                                    link,
                                    body,
                                    caller_specialization,
                                    else_tail,
                                    declaration,
                                  ) {
                                    Option::Some(function_index) => {
                                      message.append_u32(function_index)
                                      message.append(":specialization_shape=")
                                      message.append(self_host_linked_shape_name(
                                        self_host_linked_physical_function_specialization_shape(
                                          link,
                                          function_index,
                                        ),
                                      ))
                                      message.append(":result_shape=")
                                      message.append(self_host_linked_shape_name(
                                        self_host_linked_physical_function_result_shape(
                                          link,
                                          function_index,
                                        ),
                                      ))
                                    }
                                    Option::None => message.append("none")
                                  }
                                }
                                _ => message.append("unselected")
                              }
                              _ => message.append("not-index")
                            }
                            message.append(":base_argument=")
                            match self_host_linked_type_first_argument_shape(
                              module_,
                              self_host_planned_expression_at(module_.expressions, base).type_,
                            ) {
                              Option::Some(shape) => message.append(
                                self_host_linked_shape_name(shape),
                              )
                              Option::None => message.append("none")
                            }
                          }
                          _ => {}
                        }
                      }
                    }
                    _ => {}
                  }
                }
                message.append(" selected=")
                message.append(self_host_linked_shape_name(result_shape))
                message.append(" then=")
                message.append(self_host_linked_shape_name(
                  self_host_body_carrier_shape(exact_then_carrier),
                ))
                message.append(" else=")
                message.append(self_host_linked_shape_name(
                  self_host_body_carrier_shape(exact_else_carrier),
                ))
                return Option::Some(message.finish())
              }
              if !planned.flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  destination,
                ))
              }
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                destination,
                consequent,
                alternative,
                result_shape,
              ))
              let result_has_value = !(
                result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
              ) && !(
                result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
              )
              if result_has_value && else_expression < module_.expressions.length() && !module_.expressions[
                else_expression
              ].flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  alternative,
                ))
              }
              if discard_if_result {
                self_host_linked_i32_schedule_discarded_expression(
                  tasks,
                  expression_depths,
                  else_expression,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
              } else {
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  else_expression,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
              }
              if result_has_value && then_block < module_.blocks.length() && !module_.blocks[
                then_block
              ].flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  consequent,
                ))
              }
              self_host_linked_i32_schedule_block(
                tasks,
                block_depths,
                then_block,
                consequent,
                self_host_u32_add(depth, 1u32),
                discard_if_result,
              )
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                condition,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(
              value,
              arms,
            ) => {
              if !module_.expressions[value].flow.falls_through {
                self_host_linked_i32_schedule_expression(tasks, expression_depths, value, destination, depth)
                continue tasks.length()
              }
              let scratch = self_host_linked_i32_scratch_slot(
                  canonical_body_plan,
                  link,
                module_,
                body,
                expression,
              )
              let inferred_match_result_shape = match self_host_linked_match_fallthrough_shape(
                link,
                module_,
                body,
                caller_specialization,
                arms,
              ) {
                Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  expected_result_shape
                } else {
                  shape
                }
                Option::None => if !self_host_linked_match_has_fallthrough_arm(
                  module_,
                  arms,
                ) {
                  SelfHostPlannedValueShape::UnitPlannedValueShape
                } else if planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  expected_result_shape
                } else {
                  planned.shape
                }
              }
              let map_value_shape = match self_host_linked_map_get_value_shape(
                link,
                module_,
                body,
                value,
              ) {
                Option::Some(shape) => Option::Some(shape)
                Option::None => self_host_linked_canonical_map_get_value_shape(
                  canonical_body_plan,
                  link,
                  module_,
                  body,
                  value,
                )
              }
              let inferred_match_subject_payload_shape = match map_value_shape {
                Option::Some(shape) => Option::Some(shape)
                Option::None => match self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  value,
                ) {
                  Option::Some(shape) => Option::Some(shape)
                  Option::None => if value < module_.expressions.length() {
                    match self_host_linked_type_first_argument_shape(
                      module_,
                      self_host_planned_expression_at(module_.expressions, value).type_,
                    ) {
                      Option::Some(shape) => Option::Some(shape)
                      Option::None => match module_.expressions[value].kind {
                        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => self_host_linked_local_first_type_argument_shape(
                          module_,
                          body,
                          local_id,
                        )
                        _ => Option::None
                      }
                    }
                  } else {
                    Option::None
                  }
                }
              }
              let match_subject_payload_shape = match self_host_linked_match_subject_receiver_element_shape(
                link,
                module_,
                body,
                value,
              ) {
                Option::Some(shape) => Option::Some(shape)
                Option::None => inferred_match_subject_payload_shape
              }
              let scoped_match_result_shape = match map_value_shape {
                Option::Some(payload_shape) => self_host_linked_scoped_match_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                  payload_shape,
                )
                Option::None => Option::None
              }
              let recovered_match_result_shape = match self_host_linked_let_value_shape(
                module_,
                body,
                expression,
              ) {
                Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  match scoped_match_result_shape {
                    Option::Some(scoped_shape) => scoped_shape
                    Option::None => inferred_match_result_shape
                  }
                } else {
                  shape
                }
                Option::None => match scoped_match_result_shape {
                  Option::Some(scoped_shape) => scoped_shape
                  Option::None => inferred_match_result_shape
                }
              }
              let contextual_match_result_shape = match self_host_physical_scalar_shape(
                expected_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_expression_expected_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                }
                SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_expression_expected_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                }
                SelfHostPlannedValueShape::F32PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                SelfHostPlannedValueShape::F64PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                SelfHostPlannedValueShape::V128PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                _ => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
              }
              let contextual_or_recovered_match_result_shape = match self_host_physical_scalar_shape(
                contextual_match_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::I64PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::F32PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::F64PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::V128PlannedValueShape => contextual_match_result_shape
                _ => recovered_match_result_shape
              }
              let direct_expected_match_result_shape = self_host_linked_expression_expected_shape(
                link,
                module_,
                body,
                caller_specialization,
                expression,
              )
              let static_match_result_shape = self_host_linked_backend_expression_shape(
                link,
                module_,
                body,
                caller_specialization,
                expression,
              )
              let scalar_arm_context_shape = match self_host_physical_scalar_shape(
                direct_expected_match_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => direct_expected_match_result_shape
                SelfHostPlannedValueShape::I64PlannedValueShape => direct_expected_match_result_shape
                SelfHostPlannedValueShape::F32PlannedValueShape => direct_expected_match_result_shape
                SelfHostPlannedValueShape::F64PlannedValueShape => direct_expected_match_result_shape
                SelfHostPlannedValueShape::V128PlannedValueShape => direct_expected_match_result_shape
                _ => static_match_result_shape
              }
              let raw_exact_scalar_arm_result_shape = match self_host_physical_scalar_shape(
                scalar_arm_context_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
                SelfHostPlannedValueShape::I64PlannedValueShape => self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
                SelfHostPlannedValueShape::F32PlannedValueShape => self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
                SelfHostPlannedValueShape::F64PlannedValueShape => self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
                SelfHostPlannedValueShape::V128PlannedValueShape => self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
                _ => Option::None
              }
              let exact_scalar_arm_result_shape = match raw_exact_scalar_arm_result_shape {
                Option::Some(shape) => match self_host_physical_scalar_shape(
                  direct_expected_match_result_shape,
                ) {
                  SelfHostPlannedValueShape::I32PlannedValueShape => if self_host_physical_scalar_shape(
                    shape,
                  ) is SelfHostPlannedValueShape::I32PlannedValueShape {
                    Option::Some(shape)
                  } else {
                    Option::None
                  }
                  SelfHostPlannedValueShape::I64PlannedValueShape => if self_host_physical_scalar_shape(
                    shape,
                  ) is SelfHostPlannedValueShape::I64PlannedValueShape {
                    Option::Some(shape)
                  } else {
                    Option::None
                  }
                  SelfHostPlannedValueShape::F32PlannedValueShape => if self_host_physical_scalar_shape(
                    shape,
                  ) is SelfHostPlannedValueShape::F32PlannedValueShape {
                    Option::Some(shape)
                  } else {
                    Option::None
                  }
                  SelfHostPlannedValueShape::F64PlannedValueShape => if self_host_physical_scalar_shape(
                    shape,
                  ) is SelfHostPlannedValueShape::F64PlannedValueShape {
                    Option::Some(shape)
                  } else {
                    Option::None
                  }
                  SelfHostPlannedValueShape::V128PlannedValueShape => if self_host_physical_scalar_shape(
                    shape,
                  ) is SelfHostPlannedValueShape::V128PlannedValueShape {
                    Option::Some(shape)
                  } else {
                    Option::None
                  }
                  _ => Option::Some(shape)
                }
                Option::None => Option::None
              }
              let nested_special_match_result_shape = self_host_linked_single_nested_special_match_result_shape(
                link,
                module_,
                body,
                caller_specialization,
                arms,
              )
              let match_result_shape = match exact_scalar_arm_result_shape {
                Option::Some(shape) => shape
                Option::None => match nested_special_match_result_shape {
                Option::Some(shape) => shape
                Option::None => if self_host_linked_match_has_unit_fallthrough_arm(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                  arms,
                ) {
                  SelfHostPlannedValueShape::UnitPlannedValueShape
                } else if self_host_linked_match_returns_special_binding(
                  module_,
                  arms,
                ) {
                  match match_subject_payload_shape {
                    Option::Some(shape) => shape
                    Option::None => contextual_or_recovered_match_result_shape
                  }
                } else {
                  contextual_or_recovered_match_result_shape
                }
              }
              }
              let selected_match_result_shape = self_host_linked_canonical_or_inferred_shape(
                canonical_body_plan,
                expression,
                match_result_shape,
              )
              let match_payload_hint = match match_subject_payload_shape {
                Option::Some(shape) => shape
                Option::None => if self_host_linked_match_returns_special_binding(
                    module_,
                    arms,
                  ) {
                    match self_host_physical_scalar_shape(
                      selected_match_result_shape,
                    ) {
                      SelfHostPlannedValueShape::I32PlannedValueShape => selected_match_result_shape
                      SelfHostPlannedValueShape::I64PlannedValueShape => selected_match_result_shape
                      SelfHostPlannedValueShape::F32PlannedValueShape => selected_match_result_shape
                      SelfHostPlannedValueShape::F64PlannedValueShape => selected_match_result_shape
                      SelfHostPlannedValueShape::V128PlannedValueShape => selected_match_result_shape
                      _ => match self_host_linked_match_binding_use_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arms,
                      ) {
                        Option::Some(shape) => shape
                        Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                      }
                    }
                  } else {
                    match self_host_linked_match_binding_use_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      arms,
                    ) {
                      Option::Some(shape) => shape
                      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                    }
                  }
              }
              let special_binding_result = self_host_linked_match_returns_special_binding(
                module_,
                arms,
              )
              let direct_binding_declared_shape = if special_binding_result {
                self_host_linked_match_direct_binding_declared_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                )
              } else {
                Option::None
              }
              let usable_direct_binding_shape = match direct_binding_declared_shape {
                Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  Option::Some(shape)
                } else {
                  Option::None
                }
                Option::None => Option::None
              }
              let binding_subject_shape = if self_host_linked_match_only_binding_falls_through(
                module_,
                arms,
              ) {
                match_subject_payload_shape
              } else {
                Option::None
              }
              let usable_binding_subject_shape = match binding_subject_shape {
                Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
                  !(shape is SelfHostPlannedValueShape::NeverPlannedValueShape) {
                  Option::Some(shape)
                } else {
                  Option::None
                }
                Option::None => Option::None
              }
              let fallback_selected_match_result_shape = if (selected_match_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape ||
                selected_match_result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
                selected_match_result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) && !(
                match_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) && !(match_result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) && !(
                match_result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
              ) {
                match_result_shape
              } else {
                selected_match_result_shape
              }
              let match_returns_variant_value = self_host_linked_match_returns_variant_value(
                link,
                module_,
                body,
                arms,
              )
              let inferred_final_match_result_shape = if match_returns_variant_value {
                SelfHostPlannedValueShape::RefPlannedValueShape
              } else {
                match exact_scalar_arm_result_shape {
                Option::Some(shape) => shape
                Option::None => match usable_direct_binding_shape {
                Option::Some(shape) => shape
                Option::None => match usable_binding_subject_shape {
                Option::Some(shape) => shape
                Option::None => if !(
                  match_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                ) && !(
                  match_result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
                ) && !(match_result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) && !(
                  self_host_physical_scalar_shape(match_result_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
                ) {
                  match_result_shape
                } else if special_binding_result &&
                self_host_physical_scalar_shape(
                  match_payload_hint,
                ) is SelfHostPlannedValueShape::RefPlannedValueShape {
                match_payload_hint
              } else if !(
                inferred_match_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) && !(
                self_host_physical_scalar_shape(inferred_match_result_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
              ) {
                inferred_match_result_shape
              } else if special_binding_result && !(
                match_payload_hint is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) {
                match_payload_hint
              } else {
                fallback_selected_match_result_shape
              }
              }
              }
              }
              }
              let logical_match_result_shape = match self_host_linked_canonical_expression_shape(
                  canonical_body_plan,
                  expression,
                ) {
                  Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape ||
                    shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
                    inferred_final_match_result_shape
                  } else {
                    shape
                  }
                  Option::None => inferred_final_match_result_shape
              }
              let final_match_result_shape = if expression < discarded_expressions.length() && discarded_expressions[
                expression
              ] {
                SelfHostPlannedValueShape::UnitPlannedValueShape
              } else {
                logical_match_result_shape
              }
              // A structured block does not export its unreachable stack state.
              // Preserve proven divergence at the enclosing value join.
              if !planned.flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  destination,
                ))
              }
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                value,
                0u32,
                scratch,
                destination,
                depth,
                final_match_result_shape,
                match_payload_hint,
                logical_match_result_shape,
              ))
              let subject_shape = self_host_linked_call_argument_shape(link, canonical_body_plan, module_, body, caller_specialization, value)
              if !(subject_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                  scratch,
                  destination,
                ))
              }
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedWhileExpression(
              control,
              initial,
              arms,
            ) => {
              if !module_.expressions[initial].flow.falls_through {
                self_host_linked_i32_schedule_expression(tasks, expression_depths, initial, destination, depth)
                continue tasks.length()
              }
              let scratch = self_host_linked_i32_scratch_slot(
                  canonical_body_plan,
                  link,
                module_,
                body,
                expression,
              )
              let outer_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let loop_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              loop_links.push(SelfHostLinkedI32LoopLink::{

            ) && candidate_base < module_.expressions.length() {
              match module_.expressions[candidate_base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                  same_base = self_host_u32_equal(local_id, base_local)
                }
                _ => {}
              }
            }
            if same_base && self_host_u32_equal(count, 2u32) {
              match self_host_linked_expression_binding_shape(
                link,
                module_,
                body,
                caller_specialization,
                expression,
              ) {
                Option::Some(binding_shape) => {
                  let carrier = self_host_linked_array_carrier_from_shape(
                    binding_shape,
                  )
                  if self_host_u32_equal(field, 0u32) {
                    left = carrier
                  } else if self_host_u32_equal(field, 1u32) {
                    right = carrier
                  }
                }
                Option::None => if (self_host_u32_equal(field, 0u32) && left < 0i32) ||
                  (self_host_u32_equal(field, 1u32) && right < 0i32) {
                  let shape = match self_host_linked_product_field_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    candidate_base,
                    field,
                  ) {
                    Option::Some(field_shape) => field_shape
                    Option::None => self_host_linked_backend_expression_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      expression,
                    )
                  }
                  let carrier = self_host_linked_array_carrier_from_shape(shape)
                  if self_host_u32_equal(field, 0u32) {
                    left = carrier
                  } else if self_host_u32_equal(field, 1u32) {
                    right = carrier
                  }
                }
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if left >= 0i32 && right >= 0i32 {
    Option::Some(
      self_host_linked_array_runtime_base(link) + 30u32 + self_host_i32_to_u32(
        left * 6i32 + right,
      ),
    )
  } else {
    Option::None
  }
}

fn self_host_linked_pair_type_for_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<U32> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  let planned = module_.expressions[expression]
  match self_host_linked_pair_type_for_shape(link, planned.shape) {
    Option::Some(type_index) => {
      return Option::Some(type_index)
    }
    Option::None => {}
  }
  match self_host_linked_pair_type_for_shape(
    link,
    self_host_planned_merged_body_value_shape(
      module_.resolved_types,
      module_.inferred,
      planned.type_,
    ),
  ) {
    Option::Some(type_index) => {
      return Option::Some(type_index)
    }
    Option::None => {}
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut local = 0u32
      let _ = while local {
        current => if current < body.locals.length {
          let source = self_host_u32_add(body.locals.start, current)
          if source < module_.locals.length() {
            let planned_local = module_.locals[source]
            if self_host_u32_equal(planned_local.local_id, local_id) {
              match self_host_linked_pair_type_for_shape(
                link,
                planned_local.shape,
              ) {
                Option::Some(type_index) => {
                  return Option::Some(type_index)
                }
                Option::None => {}
              }
              match self_host_linked_pair_type_for_shape(
                link,
                self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  planned_local.type_,
                ),
              ) {
                Option::Some(type_index) => {
                  return Option::Some(type_index)
                }
                Option::None => {}
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    _ => {}
  }
  Option::None
}

fn self_host_linked_exact_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      _,
      _,
      _,
    ) => match self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      expression,
      declaration,
    ) {
      Option::Some(function_index) => {
        let shape = self_host_linked_physical_function_result_shape(
          link,
          function_index,
        )
        if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
          Option::None
        } else {
          Option::Some(shape)
        }
      }
      Option::None => Option::None
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => self_host_linked_struct_field_shape(
      link,
      field,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        )
        Option::None => Option::None
      }
    } else {
      Option::None
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => match self_host_linked_i32_call_index(
      link,
      body.body,
      caller_specialization,
      expression,
      0u64,
    ) {
      Option::Some(function_index) => {
        let name = self_host_linked_physical_function_name(
          link,
          function_index,
        )
        if name.ends_with(b"get_unchecked") || name.ends_with(b"indexed_get") {
          Option::None
        } else {
          let shape = self_host_linked_physical_function_result_shape(
            link,
            function_index,
          )
          if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            Option::None
          } else {
            Option::Some(shape)
          }
        }
      }
      Option::None => Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_scratch_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostPlannedValueShape {
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedMatchExpression(value, arms) => match self_host_linked_exact_expression_shape(
      link,
      module_,
      body,
      caller_specialization,
      value,
    ) {
      Option::Some(shape) => shape
      Option::None => match self_host_linked_specialized_call_result_shape(
        link,
        body.body,
        caller_specialization,
        value,
      ) {
        Option::Some(shape) => shape
        Option::None => if !self_host_u64_equal(
        self_host_linked_match_subject_nominal_declaration(
          link,
          module_,
          body,
          value,
        ),
        0u64,
      ) || self_host_linked_match_uses_reference_patterns(
        link,
        module_,
        arms,
      ) {
        SelfHostPlannedValueShape::RefPlannedValueShape
      } else if value < module_.expressions.length() {
        self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          value,
        )
        } else {
          SelfHostPlannedValueShape::I32PlannedValueShape
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedWhileExpression(_, initial, _) => if initial < module_.expressions.length() {
      let initial_shape = self_host_linked_backend_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        initial,
      )
      if initial_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape &&
        self_host_linked_is_unresolved_iterator_next(module_, initial) {
        SelfHostPlannedValueShape::RefPlannedValueShape
      } else {
        initial_shape
      }
    } else {
      SelfHostPlannedValueShape::I32PlannedValueShape
    }
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => module_.expressions[expression].shape
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => if self_host_linked_is_unresolved_iterator_next(
      module_,
      expression,
    ) || self_host_linked_is_unresolved_map_get(
      module_,
      expression,
    ) || self_host_linked_is_unresolved_map_contains_key(
      module_,
      expression,
    ) || self_host_linked_is_unresolved_array_push(
      module_,
      expression,
    ) {
      SelfHostPlannedValueShape::RefPlannedValueShape
    } else {
      SelfHostPlannedValueShape::I32PlannedValueShape
    }
    _ => SelfHostPlannedValueShape::I32PlannedValueShape
  }
}

fn self_host_linked_body_parameter_offset(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let _ = module_.module_id
  if self_host_u64_equal(body.declaration, 18446744073709551615u64) {
    1u32
  } else {
    0u32
  }
}

fn self_host_linked_i32_scratch_slot(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  let mut count = 0u32
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let candidate = self_host_u32_add(body.expressions.start, current)
      if self_host_u32_equal(candidate, expression) {
        return self_host_u32_add(
          self_host_linked_body_parameter_offset(module_, body),
          self_host_u32_add(body.locals.length, count),
        )
      }
      match module_.expressions[candidate].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => if self_host_linked_is_direct_map_write_candidate(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 19u32)
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => if self_host_linked_is_unresolved_iterator_next(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 1u32)
        } else if self_host_linked_is_unresolved_map_get(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 5u32)
        } else if self_host_linked_is_unresolved_map_contains_key(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 4u32)
        } else if self_host_linked_is_unresolved_map_write(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 19u32)
        } else if self_host_linked_is_unresolved_array_push(
          module_,
          candidate,
        ) {
          count = self_host_u32_add(count, 11u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_u32_add(
    self_host_linked_body_parameter_offset(module_, body),
    self_host_u32_add(body.locals.length, count),
  )
}

fn self_host_linked_i32_local_slot(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let mut offset = 0u32
  let _ = while offset {
    current => if current < body.locals.length {
      let local = module_.locals[self_host_u32_add(body.locals.start, current)]
      if self_host_u32_equal(local.local_id, local_id) {
        return Option::Some(
          self_host_u32_add(
            self_host_linked_body_parameter_offset(module_, body),
            current,
          ),
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_physical_function_index(function_index: U32) -> U32 {
  self_host_u32_add(function_index, 2u32)
}

fn self_host_linked_physical_function_name(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bytes {
  if physical_function_index < 2u32 {
    return b""
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      return self_host_linked_function_name(link, function_)
    }
  }
  b""
}

fn self_host_linked_physical_function_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> U64 {
  if physical_function_index < 2u32 {
    return 0u64
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      return link.fragments.specialization.lowering.modules[
        function_.module_index
      ].module_id
    }
  }
  0u64
}

fn self_host_linked_physical_function_has_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  if physical_function_index < 2u32 {
    return false
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      return self_host_linked_declaration_has_receiver(
        link,
        function_.declaration,
      )
    }
  }
  false
}

fn self_host_linked_physical_function_parameter_count(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> U32 {
  if physical_function_index < 2u32 {
    return 0u32
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      return fragment.parameters.length
    }
  }
  0u32
}

fn self_host_linked_physical_function_parameter_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
  parameter: U32,
) -> SelfHostPlannedValueShape {
  if physical_function_index < 2u32 {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      if parameter < fragment.parameters.length {
        let index = self_host_u32_add(fragment.parameters.start, parameter)
        if index < fragment_module.function_value_types.length() {
          return self_host_linked_wasm_value_shape(
            fragment_module.function_value_types[index],
          )
        }
      }
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_physical_function_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> SelfHostPlannedValueShape {
  if physical_function_index < 2u32 {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      return self_host_linked_specialized_function_result_shape(
        link,
        function_,
        fragment_module,
        fragment,
      )
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_physical_function_specialization_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> SelfHostPlannedValueShape {
  if physical_function_index < 2u32 {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      match self_host_linked_specialization_first_shape(link, function_) {
        Option::Some(shape) => {
          return shape
        }
        Option::None => {}
      }
    }
  }
  SelfHostPlannedValueShape::ErrorPlannedValueShape
}

fn self_host_linked_physical_function_returns_generic_ref(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> Bool {
  if physical_function_index < 2u32 {
    return false
  }
  let logical = self_host_u32_subtract(physical_function_index, 2u32)
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      if self_host_u32_equal(fragment.results.length, 1u32) &&
        fragment.results.start < fragment_module.function_value_types.length() {
        return fragment_module.function_value_types[fragment.results.start] is SelfHostPlannedWasmValueType::WasmNullableEqRefValue
      }
    }
  }
  false
}

fn self_host_linked_call_base_has_no_struct_layout(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
) -> Bool {
  if !self_host_u32_greater(arguments.length, 0u32) ||
    arguments.start >= module_.expression_children.length() {
    return false
  }
  let base = module_.expression_children[arguments.start]
  if base >= module_.expressions.length() {
    return false
  }
  self_host_linked_struct_type_index(
    link,
    module_.expressions[base].nominal,
  ) is Option::None
}

fn self_host_linked_function_has_result(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
) -> Bool {
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, function_index) {
      let fragment_module = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        function_.fragment_index,
      )
      return self_host_u32_greater(fragment.results.length, 0u32)
    }
  }
  true
}

fn self_host_linked_block_emits_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  block_index: U32,
) -> Bool {
  if block_index >= module_.blocks.length() {
    return false
  }
  let block = module_.blocks[block_index]
  if !block.flow.falls_through || !self_host_u32_greater(
    block.items.length,
    0u32,
  ) {
    return false
  }
  let item_index = self_host_u32_add(
    block.items.start,
    self_host_u32_subtract(block.items.length, 1u32),
  )
  if item_index >= module_.block_items.length() {
    return false
  }
  match module_.block_items[item_index].kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => self_host_linked_expression_emits_value(
      link,
      module_,
      body,
      caller_specialization,
      value,
    )
    _ => false
  }
}

fn self_host_linked_expression_emits_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  let planned = module_.expressions[expression]
  if planned.shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
    planned.shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    return false
  }
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, body.body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      return self_host_linked_function_has_result(link, call.function_index)
    }
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => {
      for function_ in link.functions {
        if self_host_u64_equal(function_.declaration, declaration) {
          return self_host_linked_function_has_result(
            link,
            function_.function_index,
          )
        }
      }
      true
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          let method_name = self_host_linked_module_name_at(module_, name)
          if method_name == "clear" || method_name == "push" ||
            method_name == "set_unchecked" {
            return false
          }
          let direct = self_host_linked_i32_call_index(
            link,
            body.body,
            caller_specialization,
            expression,
            0u64,
          )
          let result_shape = match direct {
            Option::Some(function_index) => self_host_linked_physical_function_result_shape(
              link,
              function_index,
            )
            Option::None => match self_host_linked_method_call_index(
              link,
              self_host_linked_module_name_at(module_, name),
            ) {
              Option::Some(function_index) => self_host_linked_physical_function_result_shape(
                link,
                function_index,
              )
              Option::None => planned.shape
            }
          }
          !(result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
          !(result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape)
        } else {
          true
        }
        _ => true
      }
    } else {
      true
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block_index) => self_host_linked_block_emits_value(
      link,
      module_,
      body,
      caller_specialization,
      block_index,
    )
    SelfHostPlannedExpressionKind::PlannedIfExpression(
      _,
      then_block,
      else_expression,
    ) => {
      let result_shape = self_host_linked_if_result_shape(
        link,
        module_,
        body,
        caller_specialization,
        body.result_shape,
        expression,
        planned,
        then_block,
        else_expression,
      )
      !(result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
        !(result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape)
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
      if self_host_linked_match_has_unit_fallthrough_arm(
        link,
        module_,
        body,
        caller_specialization,
        arms,
      ) {
        return false
      }
      let mut arm = 0u32
      let _ = while arm {
        current => if current < arms.length {
          let child = self_host_u32_add(arms.start, current)
          if child < module_.arm_children.length() {
            let arm_index = module_.arm_children[child]
            if arm_index < module_.pattern_arms.length() {
              let source = module_.pattern_arms[arm_index]
              if source.flow.falls_through && self_host_linked_expression_emits_value(
                link,
                module_,
                body,
                caller_specialization,
                source.body,
              ) {
                return true
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      false
    }
    SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => false
    SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => false
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, _, _) => false
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, _) => false
    _ => true
  }
}

fn self_host_linked_match_has_unit_fallthrough_arm(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  arms: SelfHostHirSpan,
) -> Bool {
  let mut arm = 0u32
  let _ = while arm {
    current => if current < arms.length {
      let child = self_host_u32_add(arms.start, current)
      if child < module_.arm_children.length() {
        let arm_index = module_.arm_children[child]
        if arm_index < module_.pattern_arms.length() {
          let source = module_.pattern_arms[arm_index]
          if source.flow.falls_through && !self_host_linked_expression_emits_value(
            link,
            module_,
            body,
            caller_specialization,
            source.body,
          ) {
            return true
          }
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_linked_call_target_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> U64 {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      for function_ in link.functions {
        if self_host_u32_equal(function_.function_index, call.function_index) {
          return link.fragments.specialization.lowering.modules[
            function_.module_index
          ].module_id
        }
      }
    }
  }
  0u64
}

fn self_host_linked_call_returns_generic_ref(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> Bool {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      return self_host_linked_physical_function_returns_generic_ref(
        link,
        self_host_linked_physical_function_index(call.function_index),
      )
    }
  }
  false
}

fn self_host_linked_call_returns_array_element(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
) -> Bool {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      for function_ in link.functions {
        if self_host_u32_equal(function_.function_index, call.function_index) {
          let fragment_module = link.fragments.modules[function_.module_index]
          let fragment = self_host_program_link_fragment_function(
            fragment_module,
            function_.fragment_index,
          )
          return self_host_linked_function_returns_array_element(
            link,
            function_,
            fragment,
          )
        }
      }
    }
  }
  false
}

fn self_host_linked_global_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  for initializer in link.initializers {
    if self_host_u64_equal(initializer.declaration, declaration) {
      return Option::Some(initializer.global_index)
    }
  }
  Option::None
}

fn self_host_linked_expression_is_variant_call(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  expression: U32,
) -> Bool {
  for module_ in link.fragments.specialization.lowering.modules {
    let mut owns_body = false
    for body in module_.bodies {
      if self_host_u64_equal(body.body, caller_body) {
        owns_body = true
      }
    }
    if owns_body && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, _, _) => if target < module_.expressions.length() {
          let source_name = module_.expressions[target].source_name
          if source_name < self_host_linked_module_name_count(module_) {
            let name = self_host_linked_module_name_at(module_, source_name)
            if name == "Some" || name == "None" || name == "Ok" || name == "Err" ||
              self_host_linked_variant_type_by_name(link, name) is Option::Some(_) {
              return true
            }
          }
        }
        _ => {}
      }
    }
  }
  false
}

fn self_host_linked_function_declaration_module_matches(
  link: SelfHostPlannedProgramWasmGCLink,
  function_index: U32,
  declaration: U64,
) -> Bool {
  if self_host_u64_equal(declaration, 0u64) {
    return true
  }
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => for function_ in link.functions {
      if self_host_u32_equal(function_.function_index, function_index) {
        return self_host_u32_equal(function_.module_index, owner)
      }
    }
    Option::None => {
      return false
    }
  }
  false
}

fn self_host_linked_i32_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  declaration: U64,
) -> Option<U32> {
  if self_host_linked_expression_is_variant_call(
    link,
    caller_body,
    expression,
  ) {
    return Option::None
  }
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) &&
      self_host_linked_function_declaration_module_matches(
        link,
        call.function_index,
        declaration,
      ) {
      return Option::Some(
        self_host_linked_physical_function_index(call.function_index),
      )
    }
  }
  let mut fallback = 4294967295u32
  for function_ in link.functions {
    if self_host_u64_equal(function_.declaration, declaration) &&
      self_host_linked_function_declaration_module_matches(
        link,
        function_.function_index,
        declaration,
      ) {
      if self_host_u32_equal(function_.specialization, 4294967295u32) {
        return Option::Some(
          self_host_linked_physical_function_index(function_.function_index),
        )
      }
      if self_host_u32_equal(fallback, 4294967295u32) {
        fallback = function_.function_index
      }
    }
  }
  if self_host_u32_equal(fallback, 4294967295u32) {
    Option::None
  } else {
    Option::Some(self_host_linked_physical_function_index(fallback))
  }
}

fn self_host_linked_builtin_name(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<Bytes> {
  for module_ in link.fragments.modules {
    let mut index = 0u32
    let _ = while index {
      current => if current < module_.functions.length() {
        let fragment = self_host_program_link_fragment_function(
          module_,
          current,
        )
        if self_host_u64_equal(fragment.declaration, declaration) {
          match fragment.kind {
            SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(
              name,
            ) => {
              return Option::Some(name)
            }
            _ => {}
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_module_name_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.names.length()
}

fn self_host_linked_module_name_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> String {
  module_.names[index]
}

fn self_host_linked_callable_by_name(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
) -> Option<SelfHostPlannedCallable> {
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if bytes_to_string(callable.name) == name {
          return Option::Some(callable)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_callable_by_name_and_result_nominal(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
  nominal: U64,
) -> Option<SelfHostPlannedCallable> {
  if self_host_u64_equal(nominal, 0u64) {
    return Option::None
  }
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if bytes_to_string(callable.name) == name && self_host_u64_equal(
          self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.result_type,
          ),
          nominal,
        ) {
          return Option::Some(callable)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_callable_function_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  if self_host_u64_equal(declaration, 0u64) {
    return Option::None
  }
  for function_ in link.functions {
    if self_host_u64_equal(function_.declaration, declaration) &&
      self_host_linked_function_declaration_module_matches(
        link,
        function_.function_index,
        declaration,
      ) {
      return Option::Some(
          self_host_linked_physical_function_index(function_.function_index),
        )
    }
  }
  Option::None
}

fn self_host_linked_function_reference_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  planned: SelfHostPlannedExpression,
  declaration: U64,
) -> Option<U32> {
  match self_host_linked_callable_function_index(link, declaration) {
    Option::Some(value) => {
      return Option::Some(value)
    }
    Option::None => {}
  }
  if planned.source_name < self_host_linked_module_name_count(module_) {
    match self_host_linked_callable_by_name(
      link,
      self_host_linked_module_name_at(module_, planned.source_name),
    ) {
      Option::Some(callable) => self_host_linked_callable_function_index(
        link,
        callable.declaration,
      )
      Option::None => Option::None
    }
  } else {
    Option::None
  }
}

fn self_host_linked_declaration_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => link.fragments.specialization.lowering.modules[
      owner
    ].module_id
    Option::None => 0u64
  }
}

fn self_host_linked_declaration_has_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Bool {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      link.fragments.specialization.lowering.modules[owner],
      declaration,
    ) {
      Option::Some(callable) => callable.has_receiver
      Option::None => false
    }
    Option::None => false
  }
}

fn self_host_linked_declaration_name(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Bytes {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      link.fragments.specialization.lowering.modules[owner],
      declaration,
    ) {
      Option::Some(callable) => callable.name
      Option::None => b""
    }
    Option::None => b""
  }
}

fn self_host_linked_map_runtime_name(method_name: Bytes) -> Bytes {
  if method_name.equals(b"length") {
    b"dew_map_length"
  } else if method_name.equals(b"get") {
    b"dew_map_get"
  } else if method_name.equals(b"get_unchecked") {
    b"dew_map_get_unchecked"
  } else if method_name.equals(b"insert") {
    b"dew_map_insert"
  } else if method_name.equals(b"set") {
    b"dew_map_set"
  } else if method_name.equals(b"contains_key") {
    b"dew_map_contains_key"
  } else {
    b""
  }
}

fn self_host_linked_method_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  name: String,
) -> Option<U32> {
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if bytes_to_string(callable.name) == name {
          for function_ in link.functions {
            if self_host_u64_equal(function_.declaration, callable.declaration) {
              return Option::Some(
          self_host_linked_physical_function_index(function_.function_index),
        )
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_method_call_index_for_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
) -> Option<U32> {
  let receiver_nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    receiver,
  )
  if !self_host_u64_equal(receiver_nominal, 0u64) {
    for candidate_module in link.fragments.specialization.lowering.modules {
      let mut callable_index = 0u32
      let _ = while callable_index {
        current => if current < self_host_program_specialization_callable_count(
          candidate_module,
        ) {
          let callable = self_host_program_specialization_callable_at(
            candidate_module,
            current,
          )
          if callable.has_receiver && bytes_to_string(callable.name) == name &&
            self_host_u64_equal(
              self_host_linked_resolved_nominal_declaration(
                candidate_module,
                callable.self_type,
              ),
              receiver_nominal,
            ) {
            for function_ in link.functions {
              if self_host_u64_equal(
                function_.declaration,
                callable.declaration,
              ) {
                return Option::Some(self_host_linked_physical_function_index(
                  function_.function_index,
                ))
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
  self_host_linked_method_call_index(link, name)
}

fn self_host_linked_method_result_argument_shape_for_receiver(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  receiver: U32,
  name: String,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let receiver_nominal = self_host_linked_expression_nominal_declaration(
    link,
    module_,
    body,
    receiver,
  )
  if self_host_u64_equal(receiver_nominal, 0u64) {
    return Option::None
  }
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && bytes_to_string(callable.name) == name &&
          self_host_u64_equal(
            self_host_linked_resolved_nominal_declaration(
              candidate_module,
              callable.self_type,
            ),
            receiver_nominal,
          ) && self_host_u32_equal(
            self_host_program_specialization_callable_generics(callable).length,
            0u32,
          ) {
          return self_host_linked_resolved_type_argument_shape(
            candidate_module,
            callable.result_type,
            argument,
          )
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_trait_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
  declaration: U64,
) -> Option<U32> {
  let target_name = match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      link.fragments.specialization.lowering.modules[owner],
      declaration,
    ) {
      Option::Some(callable) => callable.name
      Option::None => {
        return Option::None
      }
    }
    Option::None => {
      return Option::None
    }
  }
  let mut selected_implementation = 0u64
  match module_.evidence.evidence_body(body.declaration) {
    Option::Some(evidence_body) => if expression >= body.expressions.start {
      let relative = expression - body.expressions.start
      if relative < evidence_body.expression_evidence_count() {
        let span = evidence_body.expression_evidence_at(relative)
        if self_host_u32_greater(span.length, 0u32) &&
          self_host_u32_greater(evidence_body.evidence_count(), span.start) {
          selected_implementation = evidence_body.evidence_at(span.start).implementation
        }
      }
    }
    Option::None => {}
  }
  let mut fallback = 4294967295u32
  for candidate_module in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        match callable.kind {
          SelfHostPlannedCallableKind::PlannedImplMethodCallable(
            implementation,
            _,
          ) => if callable.name.equals(target_name) &&
            (self_host_u64_equal(selected_implementation, 0u64) ||
              self_host_u64_equal(selected_implementation, implementation)) {
            for function_ in link.functions {
              if self_host_u64_equal(function_.declaration, callable.declaration) {
                if self_host_u64_equal(selected_implementation, implementation) {
                  return Option::Some(
                    self_host_linked_physical_function_index(
                      function_.function_index,
                    ),
                  )
                }
                if self_host_u32_equal(fallback, 4294967295u32) {
                  fallback = function_.function_index
                }
              }
            }
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  if self_host_u32_equal(fallback, 4294967295u32) {
    Option::None
  } else {
    Option::Some(self_host_linked_physical_function_index(fallback))
  }
}

fn self_host_linked_missing_call_error(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> String {
  for module_ in link.fragments.modules {
    let mut index = 0u32
    let _ = while index {
      current => if current < module_.functions.length() {
        let fragment = self_host_program_link_fragment_function(
          module_,
          current,
        )
        if self_host_u64_equal(fragment.declaration, declaration) {
          return match fragment.kind {
            SelfHostPlannedWasmFunctionKind::PlannedWasmImportedFunction(_, _) => "linked imported call target was not assigned a function"
            SelfHostPlannedWasmFunctionKind::PlannedWasmInlineBuiltinFunction(_) => "linked builtin call target was not assigned a function"
            SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(_) => "linked defined call target was not assigned a function"
            SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(_) => "linked lambda call target was not assigned a function"
            SelfHostPlannedWasmFunctionKind::PlannedWasmSignatureOnlyFunction => "linked signature-only call target has no body"
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  let message = StringBuilder::new()
  message.append("linked call target declaration is absent from fragments: ")
  message.append_u64(declaration)
  message.finish()
}

fn self_host_linked_i32_push_arguments(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
  instructions: StarshineRef45,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
) -> Result<Unit, String> {
  let mut argument = arguments.length
  let _ = while argument {
    current => if self_host_u32_greater(current, 0u32) {
      let previous = current - 1u32
      let child = self_host_u32_add(arguments.start, previous)
      if child >= module_.expression_children.length() {
        return Result::Err("linked I32 call argument is outside its arena")
      }
      self_host_linked_i32_schedule_expression(
        tasks,
        expression_depths,
        module_.expression_children[child],
        instructions,
        depth,
      )
      continue previous
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_emit_linked_i32_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  function_value_signatures: Array<SelfHostLinkedFunctionValueSignature>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expected_result_shape: SelfHostPlannedValueShape,
  caller_specialization: U32,
  instructions: StarshineRef45,
) -> Result<Unit, String> {
  let tasks = []
  let expression_depths = self_host_program_link_u32_slots(
    module_.expressions.length(),
  )
  let block_depths = self_host_program_link_u32_slots(module_.blocks.length())
  let loop_links = []
  let pattern_subject_nominals = self_host_linked_pattern_subject_nominals(
    link,
    module_,
    body,
  )
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(root) => self_host_linked_i32_schedule_expression(
      tasks,
      expression_depths,
      root,
      instructions,
      0u32,
    )
    SelfHostHirBodyRoot::BlockBodyRoot(root) => self_host_linked_i32_schedule_block(
      tasks,
      block_depths,
      root,
      instructions,
      0u32,
    )
  }
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match tasks.pop() {
        Option::Some(value) => value
        Option::None => SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          4294967295u32,
          instructions,
        )
      }
      match task {
        SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          expression,
          destination,
        ) => {
          if self_host_u32_equal(expression, 4294967295u32) {
            continue tasks.length()
          }
          if expression >= module_.expressions.length() {
            let message = StringBuilder::new()
            message.append("linked I32 expression is outside its arena: ")
            message.append_u32(expression)
            return Result::Err(message.finish())
          }
          let planned = module_.expressions[expression]
          let depth = if expression < expression_depths.length() && !self_host_u32_equal(
            expression_depths[expression],
            4294967295u32,
          ) {
            expression_depths[expression]
          } else {
            0u32
          }
          match planned.kind {
            SelfHostPlannedExpressionKind::PlannedI8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f32_const(
                StarshineFfi.ffi_lib_F32_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f64_const(
                StarshineFfi.ffi_lib_F64_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
              let mut constant = 0i32
              if value {
                constant = 1i32
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_i32_const(
                  StarshineFfi.ffi_lib_I32_new(constant),
                ),
              )
            }
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(operator, operand) => {
              match operator {
                SelfHostHirPrefixOperator::Positive => self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  operand,
                  destination,
                  depth,
                )
                SelfHostHirPrefixOperator::Negative => {
                  match self_host_specialization_canonical_scalar(planned.shape) {
                    SelfHostPlannedValueShape::I64PlannedValueShape => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i64_const(
                          StarshineFfi.ffi_lib_I64_new(0i64),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
                        operator,
                        destination,
                      ))
                    }
                    SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
                        operator,
                        destination,
                      ),
                    )
                    SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
                        operator,
                        destination,
                      ),
                    )
                    _ => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i32_const(
                          StarshineFfi.ffi_lib_I32_new(0i32),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                        operator,
                        destination,
                      ))
                    }
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
                SelfHostHirPrefixOperator::LogicalNot => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                    operator,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_i32_local_slot(
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_local_get(
                  StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                ),
              )
              Option::None => {
                return Result::Err("linked I32 local read has no physical slot")
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(local, value) => match self_host_linked_i32_local_slot(
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                  slot,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Result::Err("linked I32 local write has no physical slot")
              }
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_linked_i32_schedule_block(
              tasks,
              block_depths,
              block,
              destination,
              depth,
            )
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              condition,
              then_block,
              else_expression,
            ) => {
              let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let result_shape = self_host_linked_if_result_shape(
                link,
                module_,
                body,
                caller_specialization,
                expected_result_shape,
                expression,
                planned,
                then_block,
                else_expression,
              )
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                destination,
                consequent,
                alternative,
                result_shape,
              ))
              let result_has_value = !(
                result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
              ) && !(
                result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
              )
              if result_has_value && else_expression < module_.expressions.length() && !module_.expressions[
                else_expression
              ].flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  alternative,
                ))
              }
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                else_expression,
                alternative,
                self_host_u32_add(depth, 1u32),
              )
              if result_has_value && then_block < module_.blocks.length() && !module_.blocks[
                then_block
              ].flow.falls_through {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(
                  consequent,
                ))
              }
              self_host_linked_i32_schedule_block(
                tasks,
                block_depths,
                then_block,
                consequent,
                self_host_u32_add(depth, 1u32),
              )
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                condition,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(
              value,
              arms,
            ) => {
              let scratch = self_host_linked_i32_scratch_slot(
                module_,
                body,
                expression,
              )
              let inferred_match_result_shape = match self_host_linked_match_fallthrough_shape(
                link,
                module_,
                body,
                caller_specialization,
                arms,
              ) {
                Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  expected_result_shape
                } else {
                  shape
                }
                Option::None => if !self_host_linked_match_has_fallthrough_arm(
                  module_,
                  arms,
                ) {
                  SelfHostPlannedValueShape::UnitPlannedValueShape
                } else if planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  expected_result_shape
                } else {
                  planned.shape
                }
              }
              let map_value_shape = self_host_linked_map_get_value_shape(
                link,
                module_,
                body,
                value,
              )
              let match_subject_payload_shape = match map_value_shape {
                Option::Some(shape) => Option::Some(shape)
                Option::None => self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  value,
                )
              }
              let scoped_match_result_shape = match map_value_shape {
                Option::Some(payload_shape) => self_host_linked_scoped_match_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                  payload_shape,
                )
                Option::None => Option::None
              }
              let recovered_match_result_shape = match self_host_linked_let_value_shape(
                module_,
                body,
                expression,
              ) {
                Option::Some(shape) => if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  match scoped_match_result_shape {
                    Option::Some(scoped_shape) => scoped_shape
                    Option::None => inferred_match_result_shape
                  }
                } else {
                  shape
                }
                Option::None => match scoped_match_result_shape {
                  Option::Some(scoped_shape) => scoped_shape
                  Option::None => inferred_match_result_shape
                }
              }
              let contextual_match_result_shape = match self_host_specialization_canonical_scalar(
                expected_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_expression_expected_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                }
                SelfHostPlannedValueShape::I64PlannedValueShape => match self_host_linked_special_match_scalar_result_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  arms,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_expression_expected_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                }
                SelfHostPlannedValueShape::F32PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                SelfHostPlannedValueShape::F64PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                SelfHostPlannedValueShape::V128PlannedValueShape => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
                _ => self_host_linked_expression_expected_shape(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  expression,
                )
              }
              let contextual_or_recovered_match_result_shape = match self_host_specialization_canonical_scalar(
                contextual_match_result_shape,
              ) {
                SelfHostPlannedValueShape::I32PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::I64PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::F32PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::F64PlannedValueShape => contextual_match_result_shape
                SelfHostPlannedValueShape::V128PlannedValueShape => contextual_match_result_shape
                _ => recovered_match_result_shape
              }
              let nested_special_match_result_shape = self_host_linked_single_nested_special_match_result_shape(
                link,
                module_,
                body,
                arms,
              )
              let match_result_shape = if self_host_linked_match_has_unit_fallthrough_arm(
                link,
                module_,
                body,
                caller_specialization,
                arms,
              ) {
                SelfHostPlannedValueShape::UnitPlannedValueShape
              } else {
                match nested_special_match_result_shape {
                Option::Some(shape) => shape
                Option::None => if self_host_linked_match_returns_special_binding(
                  module_,
                  arms,
                ) {
                  match match_subject_payload_shape {
                    Option::Some(shape) => shape
                    Option::None => contextual_or_recovered_match_result_shape
                  }
                } else {
                  contextual_or_recovered_match_result_shape
                }
                }
              }
              let match_payload_hint = match match_subject_payload_shape {
                Option::Some(shape) => shape
                Option::None => if self_host_linked_match_returns_special_binding(
                    module_,
                    arms,
                  ) {
                    match self_host_specialization_canonical_scalar(
                      match_result_shape,
                    ) {
                      SelfHostPlannedValueShape::I32PlannedValueShape => match_result_shape
                      SelfHostPlannedValueShape::I64PlannedValueShape => match_result_shape
                      SelfHostPlannedValueShape::F32PlannedValueShape => match_result_shape
                      SelfHostPlannedValueShape::F64PlannedValueShape => match_result_shape
                      SelfHostPlannedValueShape::V128PlannedValueShape => match_result_shape
                      _ => match self_host_linked_match_binding_use_shape(
                        link,
                        module_,
                        body,
                        caller_specialization,
                        arms,
                      ) {
                        Option::Some(shape) => shape
                        Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                      }
                    }
                  } else {
                    match self_host_linked_match_binding_use_shape(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      arms,
                    ) {
                      Option::Some(shape) => shape
                      Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
                    }
                  }
              }
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                0u32,
                scratch,
                destination,
                depth,
                match_result_shape,
                match_payload_hint,
              ))
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                scratch,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedWhileExpression(
              control,
              initial,
              arms,
            ) => {
              let scratch = self_host_linked_i32_scratch_slot(
                module_,
                body,
                expression,
              )
              let outer_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let loop_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              loop_links.push(SelfHostLinkedI32LoopLink::{
                control: control
                state_slot: scratch
                block_depth: depth
                loop_depth: self_host_u32_add(depth, 1u32)
              })
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Loop(
                destination,
                outer_body,
                loop_body,
                if !planned.flow.falls_through {
                  SelfHostPlannedValueShape::UnitPlannedValueShape
                } else if planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  expected_result_shape
                } else {
                  planned.shape
                },
              ))
              let loop_payload_hint = match self_host_linked_iterator_next_element_shape(
                link,
                module_,
                body,
                initial,
              ) {
                Option::Some(shape) => shape
                Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
              }
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                0u32,
                scratch,
                loop_body,
                self_host_u32_add(depth, 2u32),
                SelfHostPlannedValueShape::UnitPlannedValueShape,
                loop_payload_hint,
              ))
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                scratch,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                initial,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedBreakExpression(
              control,
              value,
            ) => {
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Break(
                control,
                depth,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedContinueExpression(
              control,
              value,
            ) => {
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Continue(
                control,
                depth,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedConstruct(
              target,
              fields,
              selection,
            ) => match selection {
              SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
                declaration,
                _,
              ) => match self_host_linked_infer_constructor_type_index(
                link,
                module_,
                body,
                caller_specialization,
                if target < module_.expressions.length() && !self_host_u64_equal(
                  self_host_linked_expression_nominal_declaration(
                    link,
                    module_,
                    body,
                    target,
                  ),
                  0u64,
                ) {
                  self_host_linked_expression_nominal_declaration(
                    link,
                    module_,
                    body,
                    target,
                  )
                } else if !self_host_u64_equal(
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  )
                } else if !self_host_u64_equal(
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                } else if self_host_u64_equal(planned.nominal, 0u64) {
                  declaration
                } else {
                  planned.nominal
                },
                fields,
              ) {
                Option::Some(type_index) => match self_host_linked_schedule_object_constructor(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  fields,
                  type_index,
                  tasks,
                  expression_depths,
                  destination,
                  depth,
                ) {
                  Result::Ok(_) => {}
                  Result::Err(error) => {
                    return Result::Err(error)
                  }
                }
                Option::None => {
                  return Result::Err("linked struct constructor has no physical type")
                }
              }
              SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
                variant_declaration,
                _,
                _,
              ) => {
                match self_host_linked_infer_constructor_type_index(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  variant_declaration,
                  fields,
                ) {
                  Option::Some(type_index) => match self_host_linked_schedule_object_constructor(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    fields,
                    type_index,
                    tasks,
                    expression_depths,
                    destination,
                    depth,
                  ) {
                    Result::Ok(_) => {}
                    Result::Err(error) => {
                      return Result::Err(error)
                    }
                  }
                  Option::None => {
                    return Result::Err("linked variant constructor has no physical type")
                  }
                }
              }
              _ => match self_host_linked_infer_constructor_type_index(
                link,
                module_,
                body,
                caller_specialization,
                if !self_host_u64_equal(
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_array_push_item_expected_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  )
                } else if target < module_.expressions.length() &&
                  !self_host_u64_equal(
                    self_host_linked_expression_nominal_declaration(
                      link,
                      module_,
                      body,
                      target,
                    ),
                    0u64,
                  ) {
                  self_host_linked_expression_nominal_declaration(
                    link,
                    module_,
                    body,
                    target,
                  )
                } else if !self_host_u64_equal(
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  ),
                  0u64,
                ) {
                  self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                } else {
                  planned.nominal
                },
                fields,
              ) {
                Option::Some(type_index) => match self_host_linked_schedule_object_constructor(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  fields,
                  type_index,
                  tasks,

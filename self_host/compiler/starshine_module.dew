              _ => self_host_linked_backend_expression_shape(
                link,
                module_,
                body,
                caller_specialization,
                arm_body,
              )
            }
            match self_host_physical_scalar_shape(shape) {
              SelfHostPlannedValueShape::I32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::I64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F32PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::F64PlannedValueShape => {
                return Option::Some(shape)
              }
              SelfHostPlannedValueShape::V128PlannedValueShape => {
                return Option::Some(shape)
              }
              _ => {}

  }
  let name = self_host_linked_declaration_name(link, declaration)
  if name.ends_with(b"get_unchecked") || name.ends_with(b"indexed_get") {
    let mut source_target = target
    let mut target_depth = 0u32
    let _ = while target_depth {
      current => if current < 8u32 && source_target < module_.expressions.length() {
        match module_.expressions[source_target].kind {

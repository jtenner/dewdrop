open dew.std.bytes
open dew.std.bytes_builder
open dew.std.option
open dew.std.result
open dew.std.wasm.intrinsics

fn self_host_i32_to_u32(value: I32) -> U32 {
  value.into()
}

fn self_host_i32_to_u8(value: I32) -> U8 {
  value.into()
}

fn self_host_encode_i32_function(
  instructions: StarshineRef125,
  local_count: U32,
) -> Result<Bytes, String> {
  let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
  let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
  StarshineFfi.ffi_ffi_bridge_val_types_push(
    results,
    StarshineFfi.ffi_lib_ValType_i32(),
  )
  let function_type = StarshineFfi.ffi_lib_CompType_func(parameters, results)
  let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
    function_type,
    wasm_ref_null(),
  )
  let rec_type = StarshineFfi.ffi_lib_RecType_new(subtype)
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
  StarshineFfi.ffi_ffi_bridge_rec_types_push(rec_types, rec_type)
  let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
  let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
  StarshineFfi.ffi_ffi_bridge_type_indices_push(
    type_indices,
    StarshineFfi.ffi_lib_TypeIdx_new(0i32),
  )
  let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
  let expression = StarshineFfi.ffi_lib_Expr_new(instructions)
  let locals = if self_host_u32_equal(local_count, 0u32) {
    StarshineFfi.ffi_lib_Locals_empty()
  } else {
    StarshineFfi.ffi_lib_Locals_single(
      local_count.into(),
      StarshineFfi.ffi_lib_ValType_i32(),
    )
  }
  let function_ = StarshineFfi.ffi_lib_Func_new(locals, expression)
  let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions, function_)
  let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
  let module_ = StarshineFfi.ffi_lib_Module_with_code_sec(
    StarshineFfi.ffi_lib_Module_with_func_sec(
      StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      ),
      function_section,
    ),
    code_section,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(module_) == 0i32 {
    Result::Err("Starshine rejected the self-host output module")
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(module_)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

pub fn build_self_host_i32_module(value: I32) -> Result<Bytes, String> {
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    instructions,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(value),
    ),
  )
  self_host_encode_i32_function(instructions, 0u32)
}

fn self_host_u64_to_i32(value: U64) -> I32 {
  value.into()
}

fn self_host_linked_root_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Option<U32> {
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => Option::Some(expression)
    SelfHostHirBodyRoot::BlockBodyRoot(block_index) => {
      if block_index >= module_.blocks.length() {
        return Option::None
      }
      let block = module_.blocks[block_index]
      if self_host_u32_equal(block.items.length, 0u32) {
        return Option::None
      }
      let item_index = self_host_u32_add(
        block.items.start,
        self_host_u32_subtract(block.items.length, 1u32),
      )
      if item_index >= module_.block_items.length() {
        return Option::None
      }
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => Option::Some(expression)
        SelfHostPlannedBlockItemKind::PlannedReturnItem(expression) => Option::Some(expression)
        _ => Option::None
      }
    }
  }
}

struct SelfHostLinkedRootExpression {
  module_index: U32
  body_index: U32
}

struct SelfHostLinkedWasmFieldLink {
  type_index: U32
  field_index: U32
}

struct SelfHostLinkedI32LoopLink {
  control: U32
  state_slot: U32
  block_depth: U32
  loop_depth: U32
}

enum SelfHostLinkedI32EmitTask {
  VisitLinkedI32Expression(U32, StarshineRef125)
  EmitLinkedI32Prefix(SelfHostHirPrefixOperator, StarshineRef125)
  EmitLinkedI64Prefix(SelfHostHirPrefixOperator, StarshineRef125)
  EmitLinkedF32Prefix(SelfHostHirPrefixOperator, StarshineRef125)
  EmitLinkedF64Prefix(SelfHostHirPrefixOperator, StarshineRef125)
  EmitLinkedI32Binary(SelfHostHirBinaryOperator, Bool, StarshineRef125)
  EmitLinkedI64Binary(SelfHostHirBinaryOperator, Bool, StarshineRef125)
  EmitLinkedF32Binary(SelfHostHirBinaryOperator, StarshineRef125)
  EmitLinkedF64Binary(SelfHostHirBinaryOperator, StarshineRef125)
  EmitLinkedI32Call(U32, StarshineRef125)
  EmitLinkedStructNew(U32, StarshineRef125)
  EmitLinkedStructGet(U32, U32, StarshineRef125)
  EmitLinkedStructSet(U32, U32, StarshineRef125)
  EmitLinkedI32If(StarshineRef125, StarshineRef125, StarshineRef125, Bool)
  EmitLinkedI32Loop(StarshineRef125, StarshineRef125, StarshineRef125)
  EmitLinkedI32Break(U32, U32, StarshineRef125)
  EmitLinkedI32Continue(U32, U32, StarshineRef125)
  VisitLinkedI32MatchArms(SelfHostHirSpan, U32, U32, StarshineRef125, U32, Bool)
  VisitLinkedI32Block(U32, StarshineRef125)
  EmitLinkedI32LocalSet(U32, StarshineRef125)
  EmitLinkedI32Return(StarshineRef125)
  EmitLinkedI32Drop(StarshineRef125)
}

fn self_host_linked_i32_schedule_expression(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  expression: U32,
  instructions: StarshineRef125,
  depth: U32,
) -> Unit {
  if expression < depths.length() {
    depths[expression] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
    expression,
    instructions,
  ))
}

fn self_host_linked_i32_schedule_block(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  block: U32,
  instructions: StarshineRef125,
  depth: U32,
) -> Unit {
  if block < depths.length() {
    depths[block] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
    block,
    instructions,
  ))
}

fn self_host_linked_i32_loop_link(
  links: Array<SelfHostLinkedI32LoopLink>,
  control: U32,
) -> Option<SelfHostLinkedI32LoopLink> {
  for link in links {
    if self_host_u32_equal(link.control, control) {
      return Option::Some(link)
    }
  }
  Option::None
}

fn self_host_linked_struct_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(candidate) => if self_host_u64_equal(
        candidate,
        declaration,
      ) {
        return Option::Some(linked_type.type_index)
      }
      _ => {}
    }
  }
  Option::None
}

fn self_host_linked_struct_field(
  link: SelfHostPlannedProgramWasmGCLink,
  field: U64,
) -> Option<SelfHostLinkedWasmFieldLink> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    let mut relative = 0u32
    let _ = while relative {
      current => if current < physical.fields.length {
        let source = self_host_linked_physical_field_at(
          module_,
          self_host_u32_add(physical.fields.start, current),
        )
        match source.role {
          SelfHostPlannedWasmFieldRole::WasmStructField(candidate) => if self_host_u64_equal(
            candidate,
            field,
          ) {
            return Option::Some(SelfHostLinkedWasmFieldLink::{
              type_index: linked_type.type_index
              field_index: source.physical_index
            })
          }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_i32_main_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<SelfHostLinkedRootExpression, String> {
  let mut module_index = 0u32
  let mut found_module = Option::None
  let lowering_modules = link.fragments.specialization.lowering.modules
  let _ = while module_index {
    current => if current < lowering_modules.length() {
      if self_host_u64_equal(lowering_modules[current].module_id, root_module) {
        found_module = Option::Some(current)
        break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let owner = match found_module {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked root module is missing")
    }
  }
  let module_ = lowering_modules[owner]
  let mut body_id = Option::None
  let functions = module_.functions.callables
  for callable in functions {
    if self_host_bytes_equal(callable.name, b"main") {
      match callable.kind {
        SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => {
          body_id = Option::Some(body)
        }
        _ => {}
      }
    }
  }
  let selected_body = match body_id {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked root module has no main function")
    }
  }
  let mut body_index = Option::None
  let mut candidate_index = 0u32
  let _ = while candidate_index {
    current => if current < module_.bodies.length() {
      if self_host_u64_equal(module_.bodies[current].body, selected_body) {
        body_index = Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let selected_index = match body_index {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked main function has no body")
    }
  }
  let selected = module_.bodies[selected_index]
  let expression_index = match self_host_linked_root_expression(module_, selected) {
    Option::Some(value) => value
    Option::None => {
      return Result::Err("linked main body is not a scalar expression")
    }
  }
  if expression_index >= module_.expressions.length() {
    return Result::Err("linked main expression is outside its arena")
  }
  Result::Ok(SelfHostLinkedRootExpression::{
    module_index: owner
    body_index: selected_index
  })
}

fn self_host_emit_linked_i32_binary(
  instructions: StarshineRef125,
  operator: SelfHostHirBinaryOperator,
  unsigned_: Bool,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::BitOr => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_or())
    SelfHostHirBinaryOperator::BitXor => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_xor())
    SelfHostHirBinaryOperator::BitAnd => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_and())
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ne())
    SelfHostHirBinaryOperator::Less => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_lt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_lt_s())
    }
    SelfHostHirBinaryOperator::LessEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_le_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_le_s())
    }
    SelfHostHirBinaryOperator::Greater => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_gt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_gt_s())
    }
    SelfHostHirBinaryOperator::GreaterEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ge_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_ge_s())
    }
    SelfHostHirBinaryOperator::ShiftLeft => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shl())
    SelfHostHirBinaryOperator::ShiftRight => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shr_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_shr_s())
    }
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_mul())
    SelfHostHirBinaryOperator::Divide => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_div_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_div_s())
    }
    SelfHostHirBinaryOperator::Remainder => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_rem_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i32_rem_s())
    }
    _ => {
      return false
    }
  }
  true
}

fn self_host_u64_to_i64(value: U64) -> I64 {
  value.into()
}

fn self_host_emit_linked_i64_binary(
  instructions: StarshineRef125,
  operator: SelfHostHirBinaryOperator,
  unsigned_: Bool,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::BitOr => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_or())
    SelfHostHirBinaryOperator::BitXor => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_xor())
    SelfHostHirBinaryOperator::BitAnd => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_and())
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_ne())
    SelfHostHirBinaryOperator::Less => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_lt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_lt_s())
    }
    SelfHostHirBinaryOperator::LessEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_le_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_le_s())
    }
    SelfHostHirBinaryOperator::Greater => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_gt_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_gt_s())
    }
    SelfHostHirBinaryOperator::GreaterEqual => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_ge_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_ge_s())
    }
    SelfHostHirBinaryOperator::ShiftLeft => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_shl())
    SelfHostHirBinaryOperator::ShiftRight => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_shr_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_shr_s())
    }
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_mul())
    SelfHostHirBinaryOperator::Divide => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_div_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_div_s())
    }
    SelfHostHirBinaryOperator::Remainder => if unsigned_ {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_rem_u())
    } else {
      StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_i64_rem_s())
    }
    _ => {
      return false
    }
  }
  true
}

fn self_host_emit_linked_f32_binary(
  instructions: StarshineRef125,
  operator: SelfHostHirBinaryOperator,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_ne())
    SelfHostHirBinaryOperator::Less => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_lt())
    SelfHostHirBinaryOperator::LessEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_le())
    SelfHostHirBinaryOperator::Greater => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_gt())
    SelfHostHirBinaryOperator::GreaterEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_ge())
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_mul())
    SelfHostHirBinaryOperator::Divide => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f32_div())
    _ => {
      return false
    }
  }
  true
}

fn self_host_emit_linked_f64_binary(
  instructions: StarshineRef125,
  operator: SelfHostHirBinaryOperator,
) -> Bool {
  match operator {
    SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_eq())
    SelfHostHirBinaryOperator::NotEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_ne())
    SelfHostHirBinaryOperator::Less => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_lt())
    SelfHostHirBinaryOperator::LessEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_le())
    SelfHostHirBinaryOperator::Greater => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_gt())
    SelfHostHirBinaryOperator::GreaterEqual => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_ge())
    SelfHostHirBinaryOperator::Add => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_add())
    SelfHostHirBinaryOperator::Subtract => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_sub())
    SelfHostHirBinaryOperator::Multiply => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_mul())
    SelfHostHirBinaryOperator::Divide => StarshineFfi.ffi_ffi_bridge_instructions_push(instructions, StarshineFfi.ffi_lib_Instruction_f64_div())
    _ => {
      return false
    }
  }
  true
}

fn self_host_linked_i32_unsigned_shape(
  shape: SelfHostPlannedValueShape,
) -> Bool {
  match shape {
    SelfHostPlannedValueShape::U8PlannedValueShape => true
    SelfHostPlannedValueShape::U16PlannedValueShape => true
    SelfHostPlannedValueShape::U32PlannedValueShape => true
    _ => false
  }
}

fn self_host_linked_i32_scratch_count(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let mut count = 0u32
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  count
}

fn self_host_linked_i32_scratch_slot(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U32 {
  let mut count = 0u32
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let candidate = self_host_u32_add(body.expressions.start, current)
      if self_host_u32_equal(candidate, expression) {
        return self_host_u32_add(body.locals.length, count)
      }
      match module_.expressions[candidate].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        SelfHostPlannedExpressionKind::PlannedWhileExpression(_, _, _) => {
          count = self_host_u32_add(count, 1u32)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_u32_add(body.locals.length, count)
}

fn self_host_linked_i32_local_slot(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let mut offset = 0u32
  let _ = while offset {
    current => if current < body.locals.length {
      let local = module_.locals[self_host_u32_add(body.locals.start, current)]
      if self_host_u32_equal(local.local_id, local_id) {
        return Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_i32_call_index(
  link: SelfHostPlannedProgramWasmGCLink,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  declaration: U64,
) -> Option<U32> {
  for call in link.specialized_calls {
    if self_host_u64_equal(call.caller_body, caller_body) &&
      self_host_u32_equal(call.caller_specialization, caller_specialization) &&
      self_host_u32_equal(call.expression, expression) {
      return Option::Some(call.function_index)
    }
  }
  for function_ in link.functions {
    if self_host_u64_equal(function_.declaration, declaration) &&
      self_host_u32_equal(function_.specialization, 4294967295u32) {
      return Option::Some(function_.function_index)
    }
  }
  Option::None
}

fn self_host_linked_i32_push_arguments(
  module_: SelfHostPlannedModuleLowering,
  arguments: SelfHostHirSpan,
  instructions: StarshineRef125,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  expression_depths: Array<U32>,
  depth: U32,
) -> Result<Unit, String> {
  let mut argument = arguments.length
  let _ = while argument {
    current => if self_host_u32_greater(current, 0u32) {
      let previous = current - 1u32
      let child = self_host_u32_add(arguments.start, previous)
      if child >= module_.expression_children.length() {
        return Result::Err("linked I32 call argument is outside its arena")
      }
      self_host_linked_i32_schedule_expression(
        tasks,
        expression_depths,
        module_.expression_children[child],
        instructions,
        depth,
      )
      continue previous
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_emit_linked_i32_expression(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  instructions: StarshineRef125,
) -> Result<Unit, String> {
  let tasks = []
  let expression_depths = self_host_program_link_u32_slots(
    module_.expressions.length(),
  )
  let block_depths = self_host_program_link_u32_slots(module_.blocks.length())
  let loop_links = []
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(root) => self_host_linked_i32_schedule_expression(
      tasks,
      expression_depths,
      root,
      instructions,
      0u32,
    )
    SelfHostHirBodyRoot::BlockBodyRoot(root) => self_host_linked_i32_schedule_block(
      tasks,
      block_depths,
      root,
      instructions,
      0u32,
    )
  }
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match tasks.pop() {
        Option::Some(value) => value
        Option::None => SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          4294967295u32,
          instructions,
        )
      }
      match task {
        SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
          expression,
          destination,
        ) => {
          if expression >= module_.expressions.length() {
            return Result::Err("linked I32 expression is outside its arena")
          }
          let planned = module_.expressions[expression]
          let depth = if expression < expression_depths.length() && !self_host_u32_equal(
            expression_depths[expression],
            4294967295u32,
          ) {
            expression_depths[expression]
          } else {
            0u32
          }
          match planned.kind {
            SelfHostPlannedExpressionKind::PlannedI8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU8Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU16Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_const(
                StarshineFfi.ffi_lib_I32_new(self_host_u64_to_i32(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedI64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedU64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i64_const(
                StarshineFfi.ffi_lib_I64_new(self_host_u64_to_i64(value)),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF32Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f32_const(
                StarshineFfi.ffi_lib_F32_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedF64Const(value) => StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_f64_const(
                StarshineFfi.ffi_lib_F64_new(value),
              ),
            )
            SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
              let mut constant = 0i32
              if value {
                constant = 1i32
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_i32_const(
                  StarshineFfi.ffi_lib_I32_new(constant),
                ),
              )
            }
            SelfHostPlannedExpressionKind::PlannedPrefixExpression(operator, operand) => {
              match operator {
                SelfHostHirPrefixOperator::Positive => self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  operand,
                  destination,
                  depth,
                )
                SelfHostHirPrefixOperator::Negative => {
                  match self_host_specialization_canonical_scalar(planned.shape) {
                    SelfHostPlannedValueShape::I64PlannedValueShape => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i64_const(
                          StarshineFfi.ffi_lib_I64_new(0i64),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
                        operator,
                        destination,
                      ))
                    }
                    SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
                        operator,
                        destination,
                      ),
                    )
                    SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                      SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
                        operator,
                        destination,
                      ),
                    )
                    _ => {
                      StarshineFfi.ffi_ffi_bridge_instructions_push(
                        destination,
                        StarshineFfi.ffi_lib_Instruction_i32_const(
                          StarshineFfi.ffi_lib_I32_new(0i32),
                        ),
                      )
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                        operator,
                        destination,
                      ))
                    }
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
                SelfHostHirPrefixOperator::LogicalNot => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
                    operator,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    operand,
                    destination,
                    depth,
                  )
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_i32_local_slot(
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_local_get(
                  StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                ),
              )
              Option::None => {
                return Result::Err("linked I32 local read has no physical slot")
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(local, value) => match self_host_linked_i32_local_slot(
              module_,
              body,
              local,
            ) {
              Option::Some(slot) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                  slot,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Result::Err("linked I32 local write has no physical slot")
              }
            }
            SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_linked_i32_schedule_block(
              tasks,
              block_depths,
              block,
              destination,
              depth,
            )
            SelfHostPlannedExpressionKind::PlannedIfExpression(
              condition,
              then_block,
              else_expression,
            ) => match self_host_specialization_canonical_scalar(planned.shape) {
              SelfHostPlannedValueShape::I32PlannedValueShape => {
                let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
                let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                  destination,
                  consequent,
                  alternative,
                  true,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  else_expression,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_block(
                  tasks,
                  block_depths,
                  then_block,
                  consequent,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  condition,
                  destination,
                  depth,
                )
              }
              _ => {
                return Result::Err("linked if result is outside the I32 emitter subset")
              }
            }
            SelfHostPlannedExpressionKind::PlannedMatchExpression(
              value,
              arms,
            ) => {
              let scratch = self_host_linked_i32_scratch_slot(
                module_,
                body,
                expression,
              )
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                0u32,
                scratch,
                destination,
                depth,
                true,
              ))
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                scratch,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedWhileExpression(
              control,
              initial,
              arms,
            ) => {
              let scratch = self_host_linked_i32_scratch_slot(
                module_,
                body,
                expression,
              )
              let outer_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              let loop_body = StarshineFfi.ffi_ffi_bridge_instructions_new()
              loop_links.push(SelfHostLinkedI32LoopLink::{
                control: control
                state_slot: scratch
                block_depth: depth
                loop_depth: self_host_u32_add(depth, 1u32)
              })
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Loop(
                destination,
                outer_body,
                loop_body,
              ))
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                0u32,
                scratch,
                loop_body,
                self_host_u32_add(depth, 2u32),
                false,
              ))
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                scratch,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                initial,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedBreakExpression(
              control,
              value,
            ) => {
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Break(
                control,
                depth,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedContinueExpression(
              control,
              value,
            ) => {
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Continue(
                control,
                depth,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                value,
                destination,
                depth,
              )
            }
            SelfHostPlannedExpressionKind::PlannedConstruct(
              _,
              fields,
              selection,
            ) => match selection {
              SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(
                declaration,
                _,
              ) => match self_host_linked_struct_type_index(link, declaration) {
                Option::Some(type_index) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
                    type_index,
                    destination,
                  ))
                  let mut linked_position = 4294967295u32
                  let mut linked_module = 0u32
                  let mut linked_fragment = 0u32
                  for linked_type in link.types {
                    if self_host_u32_equal(linked_type.type_index, type_index) {
                      linked_position = linked_type.type_index
                      linked_module = linked_type.module_index
                      linked_fragment = linked_type.fragment_index
                    }
                  }
                  if self_host_u32_equal(linked_position, 4294967295u32) {
                    return Result::Err("linked struct constructor type is missing")
                  }
                  let physical_module = link.fragments.modules[linked_module]
                  let physical = self_host_linked_physical_type_at(
                    physical_module,
                    linked_fragment,
                  )
                  let mut field_position = physical.fields.length
                  let _ = while field_position {
                    current => if self_host_u32_greater(current, 0u32) {
                      let previous = current - 1u32
                      let physical_field = self_host_linked_physical_field_at(
                        physical_module,
                        self_host_u32_add(physical.fields.start, previous),
                      )
                      let mut found = 4294967295u32
                      let mut source_position = 0u32
                      let _ = while source_position {
                        source => if source < fields.length {
                          let object_index = self_host_u32_add(fields.start, source)
                          if object_index < module_.object_fields.length() && self_host_u64_equal(
                            module_.object_fields[object_index].field,
                            physical_field.declaration,
                          ) {
                            found = module_.object_fields[object_index].value
                          }
                          continue source + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                      if self_host_u32_equal(found, 4294967295u32) {
                        return Result::Err("linked struct constructor field is missing")
                      }
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        found,
                        destination,
                        depth,
                      )
                      continue previous
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                Option::None => {
                  return Result::Err("linked struct constructor has no physical type")
                }
              }
              _ => {
                return Result::Err("linked constructor is outside the struct subset")
              }
            }
            SelfHostPlannedExpressionKind::PlannedFieldGet(
              field,
              base,
              _,
            ) => match self_host_linked_struct_field(link, field) {
              Option::Some(field_link) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                  field_link.type_index,
                  field_link.field_index,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Result::Err("linked struct field read has no physical field")
              }
            }
            SelfHostPlannedExpressionKind::PlannedFieldSet(
              field,
              base,
              value,
            ) => match self_host_linked_struct_field(link, field) {
              Option::Some(field_link) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructSet(
                  field_link.type_index,
                  field_link.field_index,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
              Option::None => {
                return Result::Err("linked struct field write has no physical field")
              }
            }
            SelfHostPlannedExpressionKind::PlannedDirectCall(
              declaration,
              _,
              arguments,
              _,
            ) => match self_host_linked_i32_call_index(
              link,
              body.body,
              caller_specialization,
              expression,
              declaration,
            ) {
              Option::Some(function_index) => {
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                  function_index,
                  destination,
                ))
                match self_host_linked_i32_push_arguments(
                  module_,
                  arguments,
                  destination,
                  tasks,
                  expression_depths,
                  depth,
                ) {
                  Result::Err(error) => {
                    return Result::Err(error)
                  }
                  Result::Ok(_) => {}
                }
              }
              Option::None => {
                return Result::Err("linked I32 call has no physical function")
              }
            }
            SelfHostPlannedExpressionKind::PlannedBinaryExpression(operator, left, right) => match operator {
              SelfHostHirBinaryOperator::LogicalAnd => {
                let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
                let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  alternative,
                  StarshineFfi.ffi_lib_Instruction_i32_const(
                    StarshineFfi.ffi_lib_I32_new(0i32),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                  destination,
                  consequent,
                  alternative,
                  true,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  consequent,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              SelfHostHirBinaryOperator::LogicalOr => {
                let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
                let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  consequent,
                  StarshineFfi.ffi_lib_Instruction_i32_const(
                    StarshineFfi.ffi_lib_I32_new(1i32),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                  destination,
                  consequent,
                  alternative,
                  true,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  alternative,
                  self_host_u32_add(depth, 1u32),
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
              _ => {
                let left_shape = module_.expressions[left].shape
                match self_host_specialization_canonical_scalar(left_shape) {
                  SelfHostPlannedValueShape::I64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                      operator,
                      left_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                      operator,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                      operator,
                      destination,
                    ),
                  )
                  _ => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                    operator,
                    self_host_linked_i32_unsigned_shape(left_shape),
                    destination,
                  ))
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  right,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  left,
                  destination,
                  depth,
                )
              }
            }
            _ => {
              return Result::Err("linked main expression is outside the I32 emitter subset")
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_sub(),
          )
          SelfHostHirPrefixOperator::LogicalNot => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_eqz(),
          )
          SelfHostHirPrefixOperator::Positive => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_sub(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i32_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Result::Err("linked I32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i64_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Result::Err("linked I64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f32_binary(destination, operator) {
          return Result::Err("linked F32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f64_binary(destination, operator) {
          return Result::Err("linked F64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
          type_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_new(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
          type_index,
          field_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_get(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
            field_index.into(),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructSet(
          type_index,
          field_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_set(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
            field_index.into(),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
          function_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_call(
            StarshineFfi.ffi_lib_FuncIdx_new(
              self_host_u32_to_i32(function_index),
            ),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32If(
          destination,
          consequent,
          alternative,
          result_,
        ) => {
          let block_type = if result_ {
            StarshineFfi.ffi_lib_BlockType_val_type(
              StarshineFfi.ffi_lib_ValType_i32(),
            )
          } else {
            StarshineFfi.ffi_lib_BlockType_void_()
          }
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_if(
              block_type,
              consequent,
              alternative,
            ),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Loop(
          destination,
          outer_body,
          loop_body,
        ) => {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            outer_body,
            StarshineFfi.ffi_lib_Instruction_loop_(
              StarshineFfi.ffi_lib_BlockType_void_(),
              StarshineFfi.ffi_lib_Expr_new(loop_body),
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            outer_body,
            StarshineFfi.ffi_lib_Instruction_unreachable_(),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_block(
              StarshineFfi.ffi_lib_BlockType_val_type(
                StarshineFfi.ffi_lib_ValType_i32(),
              ),
              StarshineFfi.ffi_lib_Expr_new(outer_body),
            ),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Break(
          control,
          depth,
          destination,
        ) => match self_host_linked_i32_loop_link(loop_links, control) {
          Option::Some(link_) => {
            let relative = self_host_u32_subtract(
              self_host_u32_subtract(depth, link_.block_depth),
              1u32,
            )
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_br(
                StarshineFfi.ffi_lib_LabelIdx_new(relative.into()),
              ),
            )
          }
          Option::None => {
            return Result::Err("linked I32 break has no loop target")
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Continue(
          control,
          depth,
          destination,
        ) => match self_host_linked_i32_loop_link(loop_links, control) {
          Option::Some(link_) => {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_local_set(
                StarshineFfi.ffi_lib_LocalIdx_new(link_.state_slot.into()),
              ),
            )
            let relative = self_host_u32_subtract(
              self_host_u32_subtract(depth, link_.loop_depth),
              1u32,
            )
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_br(
                StarshineFfi.ffi_lib_LabelIdx_new(relative.into()),
              ),
            )
          }
          Option::None => {
            return Result::Err("linked I32 continue has no loop target")
          }
        }
        SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
          arms,
          arm_offset,
          scratch,
          destination,
          depth,
          result_,
        ) => {
          if arm_offset >= arms.length {
            return Result::Err("linked I32 match has no remaining arm")
          }
          let child_index = self_host_u32_add(arms.start, arm_offset)
          if child_index >= module_.arm_children.length() {
            return Result::Err("linked I32 match arm is outside its child arena")
          }
          let arm_index = module_.arm_children[child_index]
          if arm_index >= module_.pattern_arms.length() {
            return Result::Err("linked I32 match arm is outside its arena")
          }
          let arm = module_.pattern_arms[arm_index]
          if !self_host_u32_greater(
            module_.patterns.length(),
            arm.pattern,
          ) {
            return Result::Err("linked I32 match pattern is outside its arena")
          }
          let pattern = module_.patterns[arm.pattern]
          let mut condition = 4294967295u32
          let mut catch_all = false
          match pattern.source {
            SelfHostHirPattern::WildcardPattern(_) => {
              catch_all = true
            }
            SelfHostHirPattern::BindingPattern(_, _) => {
              catch_all = true
              match pattern.reference {
                SelfHostBodyPatternReference::PatternBindingReference(local) => match self_host_linked_i32_local_slot(
                  module_,
                  body,
                  local,
                ) {
                  Option::Some(slot) => {
                    StarshineFfi.ffi_ffi_bridge_instructions_push(
                      destination,
                      StarshineFfi.ffi_lib_Instruction_local_get(
                        StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                      ),
                    )
                    StarshineFfi.ffi_ffi_bridge_instructions_push(
                      destination,
                      StarshineFfi.ffi_lib_Instruction_local_set(
                        StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                      ),
                    )
                  }
                  Option::None => {
                    return Result::Err("linked I32 pattern binding has no physical slot")
                  }
                }
                _ => {
                  return Result::Err("linked I32 binding pattern has no local")
                }
              }
            }
            SelfHostHirPattern::LiteralPattern(expression, _) => {
              condition = expression
            }
            _ => {
              return Result::Err("linked I32 pattern is outside the scalar subset")
            }
          }
          if catch_all && self_host_u32_equal(
            arm.guard_condition,
            4294967295u32,
          ) {
            self_host_linked_i32_schedule_expression(
              tasks,
              expression_depths,
              arm.body,
              destination,
              depth,
            )
          } else {
            let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
            let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
            tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
              destination,
              consequent,
              alternative,
              result_,
            ))
            let next_arm = self_host_u32_add(arm_offset, 1u32)
            if next_arm < arms.length {
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                next_arm,
                scratch,
                alternative,
                self_host_u32_add(depth, 1u32),
                result_,
              ))
            } else {
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                alternative,
                StarshineFfi.ffi_lib_Instruction_unreachable_(),
              )
            }
            self_host_linked_i32_schedule_expression(
              tasks,
              expression_depths,
              arm.body,
              consequent,
              self_host_u32_add(depth, 1u32),
            )
            if catch_all {
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                arm.guard_condition,
                destination,
                depth,
              )
            } else {
              if !self_host_u32_equal(
                arm.guard_condition,
                4294967295u32,
              ) {
                return Result::Err("linked literal match guards are not emitted yet")
              }
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                SelfHostHirBinaryOperator::Equal,
                false,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                condition,
                destination,
                depth,
              )
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_local_get(
                  StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                ),
              )
            }
          }
        }
        SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
          block_index,
          destination,
        ) => {
          if block_index >= module_.blocks.length() {
            return Result::Err("linked I32 block is outside its arena")
          }
          let block = module_.blocks[block_index]
          let depth = if block_index < block_depths.length() && !self_host_u32_equal(
            block_depths[block_index],
            4294967295u32,
          ) {
            block_depths[block_index]
          } else {
            0u32
          }
          let mut item = block.items.length
          let _ = while item {
            current => if self_host_u32_greater(current, 0u32) {
              let previous = current - 1u32
              let item_index = self_host_u32_add(block.items.start, previous)
              if item_index >= module_.block_items.length() {
                return Result::Err("linked I32 block item is outside its arena")
              }
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(local, _, value) => match self_host_linked_i32_local_slot(
                  module_,
                  body,
                  local,
                ) {
                  Option::Some(slot) => {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                      slot,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                  }
                  Option::None => {
                    return Result::Err("linked I32 let has no physical slot")
                  }
                }
                SelfHostPlannedBlockItemKind::PlannedReturnItem(value) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Return(
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    value,
                    destination,
                    depth,
                  )
                }
                SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => {
                  if !self_host_u32_equal(
                    previous,
                    self_host_u32_subtract(block.items.length, 1u32),
                  ) {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(
                      destination,
                    ))
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    value,
                    destination,
                    depth,
                  )
                }
              }
              continue previous
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
          slot,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_local_set(
            StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Return(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_return_(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_drop(),
        )
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_linked_eqref_value_type() -> StarshineRef0 {
  StarshineFfi.ffi_lib_ValType_ref_null(
    StarshineFfi.ffi_lib_HeapType_abs(
      StarshineFfi.ffi_lib_AbsHeapType_eq(),
    ),
  )
}

fn self_host_linked_scalar_storage_value_type(
  storage: SelfHostPlannedWasmStorageType,
) -> Option<StarshineRef0> {
  match storage {
    SelfHostPlannedWasmStorageType::WasmI32Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedWasmStorageType::WasmI64Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedWasmStorageType::WasmF32Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedWasmStorageType::WasmF64Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedWasmStorageType::WasmV128Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage => Option::Some(
      self_host_linked_eqref_value_type(),
    )
  }
}

fn self_host_linked_physical_type_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.physical_types.length()
}

fn self_host_linked_physical_type_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmPhysicalType {
  module_.physical_types[index]
}

fn self_host_linked_physical_field_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.fields.length()
}

fn self_host_linked_physical_field_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmField {
  module_.fields[index]
}

fn self_host_linked_enum_base_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(candidate) => if self_host_u64_equal(
        candidate,
        declaration,
      ) {
        return Option::Some(linked_type.type_index)
      }
      _ => {}
    }
  }
  Option::None
}

fn self_host_linked_append_physical_types(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRef180,
) -> Result<Unit, String> {
  for linked_type in link.types {
    let fragment_module = link.fragments.modules[linked_type.module_index]
    if !self_host_u32_greater(
      self_host_linked_physical_type_count(fragment_module),
      linked_type.fragment_index,
    ) {
      return Result::Err("linked physical type is outside its arena")
    }
    let physical = self_host_linked_physical_type_at(
      fragment_module,
      linked_type.fragment_index,
    )
    let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
    let mut field = 0u32
    let _ = while field {
      current => if current < physical.fields.length {
        let source_index = self_host_u32_add(physical.fields.start, current)
        if !self_host_u32_greater(
          self_host_linked_physical_field_count(fragment_module),
          source_index,
        ) {
          return Result::Err("linked physical field is outside its arena")
        }
        let source = self_host_linked_physical_field_at(
          fragment_module,
          source_index,
        )
        let value_type = match self_host_linked_scalar_storage_value_type(
          source.storage,
        ) {
          Option::Some(value) => value
          Option::None => {
            return Result::Err("linked reference field type is not emitted yet")
          }
        }
        let mutable_ = if source.mutable_ {
          StarshineFfi.ffi_lib_Mut_var_()
        } else {
          StarshineFfi.ffi_lib_Mut_const_()
        }
        StarshineFfi.ffi_ffi_bridge_field_types_push(
          fields,
          StarshineFfi.ffi_lib_FieldType_new(
            StarshineFfi.ffi_lib_StorageType_val_type(value_type),
            mutable_,
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let component = StarshineFfi.ffi_lib_CompType_struct_(fields)
    let subtype = match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(_) => {
        let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
        StarshineFfi.ffi_lib_SubType_new(
          0i32,
          supers,
          component,
          wasm_ref_null(),
        )
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        _,
        _,
      ) => match self_host_linked_enum_base_type_index(link, declaration) {
        Option::Some(base) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(base.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            1i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Result::Err("linked enum subtype has no base type")
        }
      }
      _ => StarshineFfi.ffi_lib_SubType_comp_type(
        component,
        wasm_ref_null(),
      )
    }
    StarshineFfi.ffi_ffi_bridge_rec_types_push(
      rec_types,
      StarshineFfi.ffi_lib_RecType_new(subtype),
    )
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_linked_i32_append_value_type(
  values: StarshineRef46,
  value: SelfHostPlannedWasmValueType,
) -> Bool {
  match value {
    SelfHostPlannedWasmValueType::WasmI32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedWasmValueType::WasmI64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedWasmValueType::WasmF32Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedWasmValueType::WasmF64Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedWasmValueType::WasmV128Value => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => StarshineFfi.ffi_ffi_bridge_val_types_push(
      values,
      self_host_linked_eqref_value_type(),
    )
  }
  true
}

fn self_host_linked_i32_append_value_types(
  module_: SelfHostPlannedModuleWasmGCFragments,
  span: SelfHostHirSpan,
  values: StarshineRef46,
) -> Bool {
  let mut index = 0u32
  let _ = while index {
    current => if current < span.length {
      let source = self_host_u32_add(span.start, current)
      if source >= module_.function_value_types.length() ||
        !self_host_linked_i32_append_value_type(
          values,
          module_.function_value_types[source],
        ) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_linked_i32_body(
  module_: SelfHostPlannedModuleLowering,
  body: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  for candidate in module_.bodies {
    if self_host_u64_equal(candidate.body, body) {
      return Option::Some(candidate)
    }
  }
  Option::None
}

fn self_host_linked_scalar_append_local_type(
  locals: StarshineRef348,
  shape: SelfHostPlannedValueShape,
) -> Bool {
  match self_host_specialization_canonical_scalar(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_lib_Locals_push(
      locals,
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::UnitPlannedValueShape => {}
    SelfHostPlannedValueShape::NeverPlannedValueShape => {}
    _ => StarshineFfi.ffi_lib_Locals_push(
      locals,
      self_host_linked_eqref_value_type(),
    )
  }
  true
}

fn self_host_linked_scalar_locals(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Result<StarshineRef348, String> {
  let locals = StarshineFfi.ffi_lib_Locals_empty()
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() && !(
        module_.locals[source].kind is SelfHostBodyLocalKind::ParameterLocal
      ) && !self_host_linked_scalar_append_local_type(
        locals,
        module_.locals[source].shape,
      ) {
        return Result::Err("linked local type is outside the scalar subset")
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let scratch_count = self_host_linked_i32_scratch_count(module_, body)
  let mut scratch = 0u32
  let _ = while scratch {
    current => if current < scratch_count {
      StarshineFfi.ffi_lib_Locals_push(
        locals,
        StarshineFfi.ffi_lib_ValType_i32(),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(locals)
}

fn self_host_linked_i32_declared_local_count(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> U32 {
  let mut count = 0u32
  let mut local = 0u32
  let _ = while local {
    current => if current < body.locals.length {
      let source = self_host_u32_add(body.locals.start, current)
      if source < module_.locals.length() && !(
        module_.locals[source].kind is SelfHostBodyLocalKind::ParameterLocal
      ) {
        count = self_host_u32_add(count, 1u32)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_u32_add(
    count,
    self_host_linked_i32_scratch_count(module_, body),
  )
}

fn self_host_encode_linked_i32_module(
  module_: StarshineRef207,
) -> Result<Bytes, String> {
  if StarshineFfi.ffi_ffi_bridge_validate_module(module_) == 0i32 {
    Result::Err("Starshine rejected the linked self-host output module")
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(module_)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the linked self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

pub fn build_self_host_linked_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_module: U64,
) -> Result<Bytes, String> {
  match self_host_linked_i32_main_expression(link, root_module) {
    Result::Err(error) => Result::Err(error)
    Result::Ok(_) => {
      if self_host_u32_greater(link.imported_function_count, 0u32) {
        return Result::Err("linked I32 imports are not emitted yet")
      }
      let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
      match self_host_linked_append_physical_types(link, rec_types) {
        Result::Err(error) => {
          return Result::Err(error)
        }
        Result::Ok(_) => {}
      }
      let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
      let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
      for linked_function in link.functions {
        let fragment_module = link.fragments.modules[linked_function.module_index]
        if !self_host_u32_greater(
          fragment_module.functions.length(),
          linked_function.fragment_index,
        ) {
          return Result::Err("linked I32 function fragment is outside its arena")
        }
        let fragment = fragment_module.functions[linked_function.fragment_index]
        let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
        let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
        if !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.parameters,
          parameters,
        ) || !self_host_linked_i32_append_value_types(
          fragment_module,
          fragment.results,
          results,
        ) {
          return Result::Err("linked function signature is outside the I32 emitter subset")
        }
        let function_type = StarshineFfi.ffi_lib_CompType_func(
          parameters,
          results,
        )
        let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
          function_type,
          wasm_ref_null(),
        )
        StarshineFfi.ffi_ffi_bridge_rec_types_push(
          rec_types,
          StarshineFfi.ffi_lib_RecType_new(subtype),
        )
        StarshineFfi.ffi_ffi_bridge_type_indices_push(
          type_indices,
          StarshineFfi.ffi_lib_TypeIdx_new(
            self_host_u32_to_i32(self_host_u32_add(
              link.types.length(),
              linked_function.function_index,
            )),
          ),
        )
        let body_id = match fragment.kind {
          SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedFunction(value) => value
          _ => {
            return Result::Err("linked function has no I32 body emitter")
          }
        }
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_function.module_index
        ]
        let body = match self_host_linked_i32_body(lowering_module, body_id) {
          Option::Some(value) => value
          Option::None => {
            return Result::Err("linked function body is missing")
          }
        }
        let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
        match self_host_emit_linked_i32_expression(
          link,
          lowering_module,
          body,
          linked_function.specialization,
          instructions,
        ) {
          Result::Err(error) => {
            return Result::Err(error)
          }
          Result::Ok(_) => {}
        }
        let locals = match self_host_linked_scalar_locals(
          lowering_module,
          body,
        ) {
          Result::Ok(value) => value
          Result::Err(error) => {
            return Result::Err(error)
          }
        }
        StarshineFfi.ffi_ffi_bridge_funcs_push(
          functions,
          StarshineFfi.ffi_lib_Func_new(
            locals,
            StarshineFfi.ffi_lib_Expr_new(instructions),
          ),
        )
      }
      let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
      let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
      let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
      self_host_encode_linked_i32_module(
        StarshineFfi.ffi_lib_Module_with_code_sec(
          StarshineFfi.ffi_lib_Module_with_func_sec(
            StarshineFfi.ffi_lib_Module_with_type_sec(
              StarshineFfi.ffi_ffi_bridge_module_new(),
              type_section,
            ),
            function_section,
          ),
          code_section,
        ),
      )
    }
  }
}

pub fn build_self_host_linked_root_i32_module(
  link: SelfHostPlannedProgramWasmGCLink,
  root_index: U32,
) -> Result<Bytes, String> {
  let modules = link.fragments.specialization.lowering.modules
  if root_index >= modules.length() {
    Result::Err("linked root module index is outside its arena")
  } else {
    build_self_host_linked_i32_module(link, modules[root_index].module_id)
  }
}

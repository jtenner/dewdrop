  match module_.expressions[candidate].kind {
    SelfHostPlannedExpressionKind::PlannedProductNew(children) => if self_host_u32_equal(
      children.length,
      count,
    ) {
      let left_index = self_host_u32_add(children.start, pair_start)
      if left_index >= module_.expression_children.length() {
        return Option::None
      }
      let left = self_host_linked_array_carrier_from_shape(
        self_host_linked_product_child_shape(
          link,
          module_,
          body,
          caller_specialization,
          module_.expression_children[left_index],
        ),
      )
      let right = if self_host_u32_equal(
        self_host_u32_add(pair_start, 2u32),
        count,
      ) {
        let right_index = self_host_u32_add(left_index, 1u32)
        if right_index >= module_.expression_children.length() {
          return Option::None
        }
        self_host_linked_array_carrier_from_shape(
          self_host_linked_product_child_shape(
            link,
            module_,
            body,
            caller_specialization,
            module_.expression_children[right_index],
          ),
        )
      } else {
        5i32
      }
      Option::Some(
        self_host_linked_array_runtime_base(link) + 30u32 +
          self_host_i32_to_u32(left * 6i32 + right),
      )
    } else {
      Option::None
    }
    _ => Option::None

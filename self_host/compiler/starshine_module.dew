  link: SelfHostPlannedProgramWasmGCLink,
  field: SelfHostLinkedWasmFieldLink,
) -> U64 {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, field.type_index) {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      if field.field_index < physical.fields.length {
        let physical_field = self_host_linked_physical_field_at(
          physical_module,
          self_host_u32_add(physical.fields.start, field.field_index),
        )
        let lowering_module = link.fragments.specialization.lowering.modules[
          linked_type.module_index
        ]
        for layout_field in lowering_module.type_layouts.fields {
          if self_host_u64_equal(
            layout_field.field,
            physical_field.declaration,
          ) {
            return self_host_linked_type_owner_module_id(
              link,
              lowering_module,
              -self_host_u32_to_i32(layout_field.type_) - 2i32,
            )
          }
        }
      }
    }
  }
  0u64
}


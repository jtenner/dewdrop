fn self_host_linked_is_direct_map_write_candidate(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      _,
      target,
      arguments,
      _,
    ) => if self_host_u32_equal(arguments.length, 2u32) &&
      target < module_.expressions.length() {
      let source_name = module_.expressions[target].source_name
      if self_host_u32_greater(
        self_host_linked_module_name_count(module_),
        source_name,
      ) {
        let method_name = self_host_linked_module_name_at(
          module_,
          source_name,
        )
        method_name == "set" || method_name == "insert"
      } else {
        false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_is_unresolved_map_write(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
      target,
      arguments,
    ) => if target < module_.expressions.length() && self_host_u32_equal(
      arguments.length,
      2u32,
    ) {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(
          _,
          name,
        ) => if name < self_host_linked_module_name_count(module_) {
          let method_name = self_host_linked_module_name_at(module_, name)
          method_name == "set" || method_name == "insert"
        } else {
          false
        }
        _ => false
      }
    } else {
      false
    }
    _ => false
  }
}

fn self_host_linked_is_unresolved_array_push(

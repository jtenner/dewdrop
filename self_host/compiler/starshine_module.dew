fn self_host_linked_expression_is_map_value(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> Bool {
  let mut expression = root
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      let planned = module_.expressions[expression]
      match planned.kind {
        SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
          module_,
          body,
          local_id,
        ) {
          Option::Some(source) => {
            expression = source
          }
          Option::None => {
            return false
          }
        }
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          declaration,
          _,
          _,
          _,
        ) => {
          let name = self_host_linked_declaration_name(link, declaration)
          return name.starts_with(b"dew_map_") || name.ends_with(b"_map") ||
            self_host_u64_equal(
              self_host_linked_callable_result_owner_module_id(
                link,
                declaration,
              ),
              7205u64,
            )
        }
        SelfHostPlannedExpressionKind::PlannedBuiltinCall(
          name,
          _,
          _,
          _,
          _,
        ) => {
          return name.starts_with(b"dew_map_")
        }
        SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
          return false
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
          return false
        }
        _ => {
          return false
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}


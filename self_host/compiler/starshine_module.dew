}

fn self_host_linked_constructor_source_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  source: SelfHostPlannedObjectField,
) -> SelfHostPlannedValueShape {
  if source.value >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let source_expression = module_.expressions[source.value]
  match source_expression.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_initializer_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(initializer) => match self_host_linked_unresolved_method_call_result_shape(
        link,
        module_,
        body,
        initializer,
      ) {
        Option::Some(shape) => shape
        Option::None => match self_host_linked_specialized_call_result_shape(
          link,
          body.body,
          caller_specialization,
          initializer,
        ) {
          Option::Some(shape) => shape
          Option::None => match self_host_linked_exact_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            initializer,
          ) {
            Option::Some(shape) => shape
            Option::None => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              self_host_linked_static_expression_shape(
                link,
                module_,
                source.value,
              )
            } else {
              source_expression.shape
            }
          }
        }
      }
      Option::None => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
        self_host_linked_static_expression_shape(
          link,
          module_,
          source.value,
        )
      } else {
        source_expression.shape
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        source_expression.type_,
      )
    } else {
      source_expression.shape
    }
    _ => self_host_linked_static_expression_shape(
      link,
      module_,
      source.value,
    )
  }
}

fn self_host_linked_constructor_field_shape_matches(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  source: SelfHostPlannedObjectField,
  physical: SelfHostPlannedWasmField,
) -> Bool {
  let source_shape = self_host_linked_constructor_source_field_shape(
    link,
    module_,
    body,
    caller_specialization,
    source,
  )
  if source_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    return true
  }
  let physical_shape = self_host_linked_storage_shape(physical.storage)
  match self_host_specialization_canonical_scalar(source_shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => physical_shape is SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I64PlannedValueShape => physical_shape is SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::F32PlannedValueShape => physical_shape is SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedValueShape::F64PlannedValueShape => physical_shape is SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedValueShape::V128PlannedValueShape => physical_shape is SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostPlannedValueShape::UnitPlannedValueShape => false
    SelfHostPlannedValueShape::NeverPlannedValueShape => true
    _ => physical_shape is SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_linked_constructor_type_matches(

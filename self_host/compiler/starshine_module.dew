  parameter: U32,
) -> Option<SelfHostPlannedValueShape> {
  let resolved_type = if body_type < -1i32 {
    self_host_i32_to_u32(-body_type - 2i32)
  } else if body_type >= 0i32 {
    let index = self_host_i32_to_u32(body_type)
    if index >= module_.inferred.types.length() {
      return Option::None
    }
    match module_.inferred.types[index] {
      SelfHostBodyTypeTerm::BodyResolvedType(value) => value
      _ => return Option::None
    }
  } else {
    return Option::None
  }
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return Option::None
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::FunctionType(parameters, _) => if parameter < parameters.length {
      let index = self_host_u32_add(parameters.start, parameter)
      if index < self_host_linked_resolved_type_argument_count(module_) {
        let type_ = self_host_linked_resolved_type_argument_at(module_, index)
        Option::Some(
          self_host_planned_merged_body_value_shape(
            module_.resolved_types,
            module_.inferred,
            -self_host_u32_to_i32(type_) - 2i32,
          ),
        )
      } else {
        Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_local_call_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      let arguments = match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(
          _,
          _,
          target_arguments,
          _,
        ) => target_arguments
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
          _,
          target_arguments,
        ) => target_arguments
        SelfHostPlannedExpressionKind::PlannedFunctionValueCall(
          _,
          target_arguments,
          _,
        ) => target_arguments
        _ => SelfHostHirSpan::{
          start: 0u32
          length: 0u32
        }
      }
      let mut matching_position = 4294967295u32
      let mut matching_receiver = false
      let target = match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedDirectCall(_, value, _, _) => value
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
        _ => 4294967295u32
      }
      if target < module_.expressions.length() {
        let base = match module_.expressions[target].kind {
          SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => value
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => value
          _ => 4294967295u32
        }
        if base < module_.expressions.length() {
          match module_.expressions[base].kind {
            SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
              candidate,
              local_id,
            ) {
              matching_position = 0u32
              matching_receiver = true
            }
            _ => {}
          }
        }
      }
      let mut argument = 0u32
      let _ = while argument {
        position => if position < arguments.length {
          let child_index = self_host_u32_add(arguments.start, position)
          if child_index < module_.expression_children.length() {
            let child = module_.expression_children[child_index]
            if child < module_.expressions.length() {
              match module_.expressions[child].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  matching_position = position
                }
                _ => {}
              }
            }
          }
          continue position + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if !self_host_u32_equal(matching_position, 4294967295u32) {
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedFunctionValueCall(
            function_target,
            _,
            _,
          ) => if function_target < module_.expressions.length() {
            let shallow_shape = self_host_linked_local_function_value_argument_shape(
              module_,
              body,
              local_id,
            )
            if self_host_physical_scalar_shape(
              shallow_shape,
            ) is SelfHostPlannedValueShape::RefPlannedValueShape {
              return Option::Some(shallow_shape)
            }
            match self_host_linked_body_function_parameter_shape(
              module_,
              self_host_planned_expression_at(module_.expressions, function_target).type_,
              matching_position,
            ) {
              Option::Some(shape) => if self_host_physical_scalar_shape(

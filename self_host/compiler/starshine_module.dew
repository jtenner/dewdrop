                      match self_host_linked_i32_push_arguments(
                        module_,
                        arguments,
                        destination,
                        tasks,
                        expression_depths,
                        depth,
                      ) {
                        Result::Err(error) => {
                          return Result::Err(error)
                        }
                        Result::Ok(_) => {}
                      }
                      if self_host_u32_greater(
                        self_host_linked_physical_function_parameter_count(
                          link,
                          function_index,
                        ),
                        arguments.length,
                      ) && self_host_u32_greater(target, 0u32) {
                        self_host_linked_i32_schedule_expression(
                          tasks,
                          expression_depths,
                          target - 1u32,
                          destination,
                          depth,
                        )
                      }
                      continue tasks.length()
                    }
                    Option::None => {}
                  }
                  let source_name = module_.expressions[target].source_name
                  if source_name >= self_host_linked_module_name_count(module_) {
                    return Result::Err("linked unresolved poison call target")
                  }
                  let name = self_host_linked_module_name_at(module_, source_name)
                  let contextual_nominal = self_host_linked_let_value_nominal(
                    link,
                    module_,
                    body,
                    expression,
                  )
                  let argument_nominal = self_host_linked_expression_expected_nominal(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    expression,
                  )
                  let expected_nominal = if !self_host_u64_equal(
                    planned.nominal,
                    0u64,
                  ) {
                    planned.nominal
                  } else if !self_host_u64_equal(contextual_nominal, 0u64) {
                    contextual_nominal
                  } else if !self_host_u64_equal(argument_nominal, 0u64) {
                    argument_nominal
                  } else if self_host_u32_greater(target, 0u32) {
                    self_host_linked_expression_nominal_declaration(
                      link,
                      module_,
                      body,
                      target - 1u32,
                    )
                  } else {
                    0u64
                  }
                  let selected_callable = match self_host_linked_callable_by_name_and_result_nominal(
                    link,
                    name,
                    expected_nominal,
                  ) {
                    Option::Some(callable) => Option::Some(callable)
                    Option::None => self_host_linked_callable_by_name(link, name)
                  }
                  match selected_callable {
                    Option::Some(callable) => {
                      match callable.kind {
                        SelfHostPlannedCallableKind::PlannedBuiltinCallable(
                          builtin_name,
                        ) => if self_host_program_link_is_runtime_builtin(
                          builtin_name,
                        ) {
                          match self_host_linked_callable_function_index(
                            link,
                            callable.declaration,
                          ) {
                            Option::Some(function_index) => tasks.push(
                              SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                                function_index,
                                destination,
                              ),
                            )
                            Option::None => {
                              let message = StringBuilder::new()
                              message.append("linked unresolved runtime callable has no function: ")
                              message.append(name)
                              return Result::Err(message.finish())
                            }
                          }
                        } else {
                          tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedBuiltin(
                            builtin_name,
                            destination,
                          ))
                        }
                        _ => match self_host_linked_callable_function_index(
                          link,
                          callable.declaration,
                        ) {
                          Option::Some(function_index) => tasks.push(
                            SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                              function_index,
                              destination,
                            ),
                          )
                          Option::None => {
                            let runtime_name = if name == "new" {
                              b"dew_array_new"
                            } else if name == "with_capacity" {
                              b"dew_array_with_capacity"
                            } else if name == "make" {
                              b"dew_array_make"
                            } else if name == "empty" {
                              b"dew_map_empty"
                            } else {
                              b""
                            }
                            let runtime_index = if runtime_name.byte_length() > 0u32 {
                              self_host_linked_runtime_function_index(
                                link,
                                runtime_name,
                              )
                            } else {
                              -1i32
                            }
                            if runtime_index < 0i32 {
                              if name == "new" {
                                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArrayEmpty(
                                  self_host_linked_array_wrapper_type(link),
                                  destination,
                                ))
                              } else if name == "empty" {
                                if !self_host_u32_equal(arguments.length, 0u32) {
                                  return Result::Err("linked map empty has explicit arguments")
                                }
                                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedMapEmpty(
                                  self_host_linked_array_runtime_base(link),
                                  destination,
                                ))
                              } else {
                                let message = StringBuilder::new()
                                message.append("linked unresolved callable has no function: ")
                                message.append(name)
                                return Result::Err(message.finish())
                              }
                            } else {
                              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                                self_host_i32_to_u32(runtime_index),
                                destination,
                              ))
                            }
                          }
                        }
                      }
                      match self_host_linked_i32_push_arguments(
                        module_,
                        arguments,
                        destination,
                        tasks,
                        expression_depths,
                        depth,
                      ) {
                        Result::Err(error) => {
                          return Result::Err(error)
                        }
                        Result::Ok(_) => {}
                      }
                    }
                    Option::None => {
                      let message = StringBuilder::new()
                      message.append("linked unresolved poison call target: ")
                      message.append(name)
                      return Result::Err(message.finish())
                    }
                  }
                }
                _ => {
                  return Result::Err("linked unresolved scalar or aggregate call target")
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(
              base,
              name,
            ) => {
              if base >= module_.expressions.length() ||
                name >= self_host_linked_module_name_count(module_) {
                return Result::Err("linked unresolved field is outside its arena")
              }
              let base_nominal = self_host_linked_expression_nominal_declaration(
                link,
                module_,
                body,
                base,
              )
              match self_host_linked_field_by_name(
                link,
                base_nominal,
                self_host_linked_module_name_at(module_, name),
              ) {
                Option::Some(field_link) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                    field_link.type_index,
                    field_link.field_index,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    base,
                    destination,
                    depth,
                  )
                }
                Option::None => {
                  let message = StringBuilder::new()
                  message.append("linked unresolved field has no physical field: ")
                  message.append(self_host_linked_module_name_at(module_, name))
                  return Result::Err(message.finish())
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedProductField(
              base,
              field,
              count,
            ) => {
              if field >= count {
                return Result::Err("linked tuple field is outside its product")
              }
              if self_host_u32_equal(count, 2u32) {
                let pair_type = match self_host_linked_pair_type_for_match_result(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  base,
                ) {
                  Option::Some(type_index) => Option::Some(type_index)
                  Option::None => match self_host_linked_pair_type_for_projection(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    base,
                  ) {
                    Option::Some(type_index) => Option::Some(type_index)
                    Option::None => self_host_linked_pair_type_for_expression(
                      link,
                      module_,
                      body,
                      base,
                    )
                  }
                }
                match pair_type {
                  Option::Some(type_index) => {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                      type_index,
                      field,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      base,
                      destination,
                      depth,
                    )
                  }
                  Option::None => {
                    return Result::Err("linked tuple projection has no pair type")
                  }
                }
              } else if self_host_u32_greater(count, 1u32) {
                let target_pair = if self_host_u32_equal(
                  self_host_u32_add(field, 1u32),
                  count,
                ) {
                  self_host_u32_subtract(count, 2u32)
                } else {
                  field
                }
                let target_field = if self_host_u32_equal(
                  self_host_u32_add(field, 1u32),
                  count,
                ) {
                  1u32
                } else {
                  0u32
                }
                let target_type = match self_host_linked_product_pair_type_for_projection(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  base,
                  count,
                  target_pair,
                ) {
                  Option::Some(type_index) => type_index
                  Option::None => {
                    return Result::Err("linked tuple projection has no nested pair type")
                  }
                }
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                  target_type,
                  target_field,
                  destination,
                ))
                let mut pair = target_pair
                let _ = while pair {
                  current_pair => if self_host_u32_greater(current_pair, 0u32) {
                    let previous = self_host_u32_subtract(current_pair, 1u32)
                    let pair_type = match self_host_linked_product_pair_type_for_projection(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      base,
                      count,
                      previous,
                    ) {
                      Option::Some(type_index) => type_index
                      Option::None => {
                        return Result::Err("linked tuple traversal has no pair type")
                      }
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                      pair_type,
                      1u32,
                      destination,
                    ))
                    continue previous
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              } else {
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
            }
            SelfHostPlannedExpressionKind::PlannedIndexGet(
              base,
              index,
              target,
            ) => {
              let container_owner = self_host_linked_expression_container_owner_module_id(
                link,
                module_,
                body,
                base,
              )
              let element_shape = match self_host_linked_type_first_argument_shape(
                module_,
                module_.expressions[base].type_,
              ) {
                Option::Some(shape) => shape
                Option::None => match self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  base,
                ) {
                  Option::Some(shape) => shape
                  Option::None => planned.shape
                }
              }
              if self_host_u64_equal(container_owner, 7204u64) && !(
                element_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) {
                let runtime_base = self_host_linked_array_runtime_base(link)
                let array_type = self_host_u32_add(
                  runtime_base,
                  self_host_i32_to_u32(
                    self_host_linked_array_carrier_from_shape(element_shape),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedFixedArrayGet(
                  array_type,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  index,
                  destination,
                  depth,
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArraySetPrefix(
                  self_host_u32_add(runtime_base, 6u32),
                  array_type,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              } else {
                match target {
                  SelfHostBasicCallTarget::SelectedBasicCallTarget(
                    declaration,
                    _,
                  ) => match self_host_linked_i32_call_index(
                    link,
                    body.body,
                    caller_specialization,
                    expression,
                    declaration,
                  ) {
                    Option::Some(function_index) => {
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                        function_index,
                        destination,
                      ))
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        index,
                        destination,
                        depth,
                      )
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        base,
                        destination,
                        depth,
                      )
                    }
                    Option::None => {
                      return Result::Err("linked index read has no physical function")
                    }
                  }
                  _ => {
                    let function_index = self_host_linked_runtime_function_index_for_carrier(
                      link,
                      b"dew_array_get_unchecked",
                      self_host_linked_array_carrier_from_shape(planned.shape),
                    )
                    if function_index < 0i32 {
                      return Result::Err("linked index read target is unresolved")
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                      self_host_i32_to_u32(function_index),
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      index,
                      destination,
                      depth,
                    )
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      base,
                      destination,
                      depth,
                    )
                  }
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => {
              return Result::Err("linked local writes are not emitted yet")
            }
            SelfHostPlannedExpressionKind::PlannedCaptureSet(_, _) => {
              return Result::Err("linked capture writes are not emitted yet")
            }
            SelfHostPlannedExpressionKind::PlannedIndexSet(
              base,
              index,
              value,
              target,
            ) => {
              if value >= module_.expressions.length() || base >= module_.expressions.length() {
                return Result::Err("linked index write operand is outside its arena")
              }
              let container_owner = self_host_linked_expression_container_owner_module_id(
                link,
                module_,
                body,
                base,
              )
              let element_shape = match self_host_linked_type_first_argument_shape(
                module_,
                module_.expressions[base].type_,
              ) {
                Option::Some(shape) => shape
                Option::None => match self_host_linked_expression_container_element_shape(
                  link,
                  module_,
                  body,
                  base,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_backend_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    value,
                  )
                }
              }
              if self_host_u64_equal(container_owner, 7204u64) && !(
                element_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
              ) {
                let runtime_base = self_host_linked_array_runtime_base(link)
                let array_type = self_host_u32_add(
                  runtime_base,
                  self_host_i32_to_u32(
                    self_host_linked_array_carrier_from_shape(element_shape),
                  ),
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArraySet(
                  array_type,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  value,
                  destination,
                  depth,
                )
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  index,
                  destination,
                  depth,
                )
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArraySetPrefix(
                  self_host_u32_add(runtime_base, 6u32),
                  array_type,
                  destination,
                ))
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              } else {
                match target {
                  SelfHostBasicCallTarget::SelectedBasicCallTarget(
                    declaration,
                    _,
                  ) => match self_host_linked_i32_call_index(
                    link,
                    body.body,
                    caller_specialization,
                    expression,
                    declaration,
                  ) {
                    Option::Some(function_index) => {
                      tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                        function_index,
                        destination,
                      ))
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        value,
                        destination,
                        depth,
                      )
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        index,
                        destination,
                        depth,
                      )
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        base,
                        destination,
                        depth,
                      )
                    }
                    Option::None => {
                      return Result::Err("linked index write has no physical function")
                    }
                  }
                  _ => {
                    let wrapper_type = self_host_linked_array_wrapper_type(link)
                    let array_type = self_host_u32_add(
                      self_host_linked_array_runtime_base(link),
                      self_host_i32_to_u32(
                        self_host_linked_array_carrier_from_shape(element_shape),
                      ),
                    )
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArraySet(
                      array_type,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      index,
                      destination,
                      depth,
                    )
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedArraySetPrefix(
                      wrapper_type,
                      array_type,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      base,
                      destination,
                      depth,
                    )
                  }
                }
              }
            }
            _ => {
              return Result::Err("linked expression is outside the current emitter subset")
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_sub(),
          )
          SelfHostHirPrefixOperator::LogicalNot => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_eqz(),
          )
          SelfHostHirPrefixOperator::Positive => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_sub(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i32_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Result::Err("linked I32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i64_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Result::Err("linked I64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f32_binary(destination, operator) {
          return Result::Err("linked F32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f64_binary(destination, operator) {
          return Result::Err("linked F64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRefBinary(
          operator,
          destination,
        ) => match operator {
          SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_ref_eq(),
          )
          SelfHostHirBinaryOperator::NotEqual => {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_ref_eq(),
            )
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_eqz(),
            )
          }
          _ => {
            return Result::Err("linked reference binary operator is unsupported")
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedProductField(
          field,
          count,
          scratch,
          destination,
        ) => {
          if field >= count {
            return Result::Err("linked tuple field is outside its product")
          }
          let mut position = count
          let _ = while position {
            current => if self_host_u32_greater(current, 0u32) {
              let previous = current - 1u32
              if self_host_u32_equal(previous, field) {
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_local_set(
                    StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                  ),
                )
              } else {
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_drop(),
                )
              }
              continue previous
            } else {
              break self_host_semantic_unit()
            }
          }
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_local_get(
              StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
            ),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedLocalGet(
          local,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_local_get(
            StarshineFfi.ffi_lib_LocalIdx_new(local.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
          type_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_new(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
          type_index,
          field_index,
          destination,
        ) => {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
              self_host_u32_to_i32(type_index),
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_struct_get(
              StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
              field_index.into(),
            ),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRefCast(
          type_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
            self_host_u32_to_i32(type_index),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructSet(
          type_index,
          field_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_set(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
            field_index.into(),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedBuiltin(
          name,
          destination,
        ) => if !self_host_emit_linked_builtin(name, destination) {
          return Result::Err(bytes_to_string(name))
        }
        SelfHostLinkedI32EmitTask::EmitLinkedConversion(
          source,
          target,
          destination,
        ) => if !self_host_emit_linked_conversion(
          source,
          target,
          destination,

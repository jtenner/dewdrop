      match module_.expressions[base].kind {
        SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field(
          link,
          field,
        ) {
          Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
            link,
            field_link,
          )
          Option::None => 0u64
        }
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => if receiver < module_.expressions.length() &&
          name < self_host_linked_module_name_count(module_) {
          match self_host_linked_field_by_name(
            link,
            self_host_linked_expression_nominal_declaration(
              link,
              module_,
              body,
              receiver,
            ),
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(field_link) => self_host_linked_field_container_element_nominal_declaration(
              link,
              field_link,
            )
            Option::None => 0u64
          }
        } else {
          0u64
        }
        _ => 0u64
      }
      }
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      arguments,
      _,
    ) => self_host_linked_direct_call_result_nominal_declaration(
      link,
      module_,
      body,
      declaration,
      target,
      arguments,
    )
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => self_host_linked_unresolved_method_call_result_nominal_declaration(
      link,
      module_,
      body,
      subject,
    )
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        0u64
      } else {
        self_host_linked_match_subject_nominal_declaration(
          link,
          module_,
          body,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      subject,
      0u32,
    ) {
      self_host_linked_match_subject_nominal_declaration(
        link,
        module_,
        body,
        self_host_u32_subtract(subject, 1u32),
      )
    } else {
      0u64
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_source_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(source) => if !self_host_u32_equal(source, subject) {
        self_host_linked_match_subject_nominal_declaration(
          link,
          module_,
          body,
          source,
        )
      } else {
        0u64
      }
      Option::None => self_host_linked_expression_nominal_declaration(
        link,
        module_,
        body,
        subject,
      )
    }
    _ => 0u64
  }
}

fn self_host_linked_pattern_subject_nominals(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
) -> Array<U64> {
  let values = []
  let mut pattern_index = 0u32
  let _ = while pattern_index {
    current => if current < module_.patterns.length() {
      values.push(0u64)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
          let planned_nominal = match canonical {
            Option::Some(plan) => match self_host_body_plan_expression(
              plan,
              subject,
            ) {
              Option::Some(value) => value.value.nominal_owner
              Option::None => 0u64
            }
            Option::None => 0u64
          }
          let nominal = if !self_host_u64_equal(planned_nominal, 0u64) {
            planned_nominal
          } else {
            self_host_linked_match_subject_nominal_declaration(
              link,
              module_,
              body,
              subject,
            )
          }
          if !self_host_u64_equal(nominal, 0u64) {
            let mut arm = 0u32
            let _ = while arm {
              position => if position < arms.length {
                let child = self_host_u32_add(arms.start, position)
                if child < module_.arm_children.length() {
                  let arm_index = module_.arm_children[child]
                  if arm_index < module_.pattern_arms.length() {
                    let root = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                    if root < values.length() {
                      values[root] = nominal
                    }
                  }
                }
                continue position + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_linked_canonical_pattern_local_container_owner_module_id(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  root: U32,
) -> U64 {
  let mut expression = root
  let mut depth = 0u32
  let mut local_id = 4294967295u32
  let _ = while depth {
    current => if current < 8u32 && expression < module_.expressions.length() {
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          expression,
          0u32,
        ) {
          expression = self_host_u32_subtract(expression, 1u32)
        } else {
          break self_host_semantic_unit()
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => {
          local_id = candidate
          break self_host_semantic_unit()
        }
        _ => break self_host_semantic_unit()
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(local_id, 4294967295u32) {
    return 0u64
  }
  match canonical {
    Option::Some(plan) => {
      let mut relative = 0u32
      let _ = while relative {
        current => if current < body.expressions.length {
          let match_expression = self_host_u32_add(body.expressions.start, current)
          match module_.expressions[match_expression].kind {
            SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => {
              let mut binds = false
              let mut arm = 0u32
              let _ = while arm {
                position => if position < arms.length {
                  let child = self_host_u32_add(arms.start, position)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() &&
                      self_host_linked_pattern_binds_local(
                        module_,
                        self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                        local_id,
                      ) {
                      binds = true
                      match self_host_body_plan_pattern_payload_value(
                        plan,
                        module_,
                        body,
                        self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                      ) {
                        Option::Some(value) => if !self_host_u64_equal(
                          value.nominal_owner,
                          0u64,
                        ) {
                          match link.fragments.specialization.lowering.index.declaration_owner(
                            value.nominal_owner,
                          ) {
                            Option::Some(owner) => return link.fragments.specialization.lowering.modules[
                              owner
                            ].module_id
                            Option::None => {}
                          }
                        }
                        Option::None => {}
                      }
                    }
                  }
                  continue position + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              if binds {
                match self_host_body_plan_expression(plan, subject) {
                  Option::Some(subject_plan) => if !self_host_u32_equal(
                    subject_plan.call_function_index,
                    4294967295u32,
                  ) {
                    let mut declaration = 0u64
                    for function_ in link.functions {
                      if self_host_u32_equal(
                        function_.function_index,
                        subject_plan.call_function_index,
                      ) {
                        declaration = function_.declaration
                      }
                    }
                    if !self_host_u64_equal(declaration, 0u64) {
                      let nominal = self_host_linked_callable_result_argument_nominal_declaration(
                        link,
                        declaration,
                        0u32,
                      )
                      if !self_host_u64_equal(nominal, 0u64) {
                        match link.fragments.specialization.lowering.index.declaration_owner(
                          nominal,
                        ) {
                          Option::Some(owner) => return link.fragments.specialization.lowering.modules[
                            owner
                          ].module_id
                          Option::None => {}
                        }
                      }
                    }
                  }
                  Option::None => {}
                }
              }
            }
            _ => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    Option::None => {}
  }
  0u64
}


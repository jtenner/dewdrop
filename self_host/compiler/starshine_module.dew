open dew.std.array
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.option
open dew.std.result
open dew.std.string
open dew.std.string_builder
open dew.std.text_runtime
open dew.std.wasm.intrinsics

fn self_host_i32_to_u32(value: I32) -> U32 {
  value.into()
}

fn self_host_i32_to_u8(value: I32) -> U8 {
  value.into()
}

fn self_host_starshine_validation_error(prefix: String) -> String {
  let message = StringBuilder::new()
  message.append(prefix)
  let function_index = StarshineFfi.ffi_ffi_bridge_validation_error_function_index()
  if function_index >= 0i32 {
    message.append(" function=")
    message.append_i32(function_index)
  }
  let length = self_host_i32_to_u32(
    StarshineFfi.ffi_ffi_bridge_validation_error_byte_length(),
  )
  if length > 0u32 {
    let detail = BytesBuilder::with_capacity(length)
    while 0u32 {
      index if index < length => {
        detail.append_byte(self_host_i32_to_u8(
          StarshineFfi.ffi_ffi_bridge_validation_error_byte_at(index.into()),
        ))
        continue index + 1u32
      }
      _ => break self_host_semantic_unit()
    }
    message.append(": ")
    message.append(bytes_to_string(detail.finish()))
  }
  message.finish()
}

fn self_host_encode_i32_function(
  instructions: StarshineInstructions,
  local_count: U32,
) -> Result<Bytes, String> {
  let parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
  let results = StarshineFfi.ffi_ffi_bridge_val_types_new()
  StarshineFfi.ffi_ffi_bridge_val_types_push(
    results,
    StarshineFfi.ffi_lib_ValType_i32(),
  )
  let function_type = StarshineFfi.ffi_lib_CompType_func(parameters, results)
  let subtype = StarshineFfi.ffi_lib_SubType_comp_type(
    function_type,
    wasm_ref_null(),
  )
  let rec_type = StarshineFfi.ffi_lib_RecType_new(subtype)
  let rec_types = StarshineFfi.ffi_ffi_bridge_rec_types_new()
  StarshineFfi.ffi_ffi_bridge_rec_types_push(rec_types, rec_type)
  let type_section = StarshineFfi.ffi_lib_TypeSec_new(rec_types)
  let type_indices = StarshineFfi.ffi_ffi_bridge_type_indices_new()
  StarshineFfi.ffi_ffi_bridge_type_indices_push(
    type_indices,
    StarshineFfi.ffi_lib_TypeIdx_new(0i32),
  )
  let function_section = StarshineFfi.ffi_lib_FuncSec_new(type_indices)
  let expression = StarshineFfi.ffi_lib_Expr_new(instructions)
  let locals = if self_host_u32_equal(local_count, 0u32) {
    StarshineFfi.ffi_lib_Locals_empty()
  } else {
    StarshineFfi.ffi_lib_Locals_single(
      local_count.into(),
      StarshineFfi.ffi_lib_ValType_i32(),
    )
  }
  let function_ = StarshineFfi.ffi_lib_Func_new(locals, expression)
  let functions = StarshineFfi.ffi_ffi_bridge_funcs_new()
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions, function_)
  let code_section = StarshineFfi.ffi_lib_CodeSec_new(functions)
  let module_ = StarshineFfi.ffi_lib_Module_with_code_sec(
    StarshineFfi.ffi_lib_Module_with_func_sec(
      StarshineFfi.ffi_lib_Module_with_type_sec(
        StarshineFfi.ffi_ffi_bridge_module_new(),
        type_section,
      ),
      function_section,
    ),
    code_section,
  )
  let fact_module = StarshineFfi.ffi_ffi_bridge_module_with_dewdrop_compiler_facts(
    module_,
  )
  if StarshineFfi.ffi_ffi_bridge_validate_module(fact_module) == 0i32 {
    Result::Err(self_host_starshine_validation_error(
      "Starshine rejected the self-host output module",
    ))
  } else {
    let encoded = StarshineFfi.ffi_ffi_bridge_encode_module(fact_module)
    if StarshineFfi.ffi_ffi_bridge_EncodedModule_is_ok(encoded) == 0i32 {
      Result::Err("Starshine could not encode the self-host output module")
    } else {
      let length = self_host_i32_to_u32(
        StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_length(encoded),
      )
      let output = BytesBuilder::with_capacity(length)
      while 0u32 {
        index if index < length => {
          output.append_byte(self_host_i32_to_u8(
            StarshineFfi.ffi_ffi_bridge_EncodedModule_byte_at(
              encoded,
              index.into(),
            ),
          ))
          continue index + 1u32
        }
        _ => break Result::Ok(output.finish())
      }
    }
  }
}

pub fn build_self_host_i32_module(value: I32) -> Result<Bytes, String> {
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(
    instructions,
    StarshineFfi.ffi_lib_Instruction_i32_const(
      StarshineFfi.ffi_lib_I32_new(value),
    ),
  )
  self_host_encode_i32_function(instructions, 0u32)
}

fn self_host_u64_to_i32(value: U64) -> I32 {
  value.into()
}

fn self_host_linked_root_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
) -> Option<U32> {
  match body.root {
    SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => Option::Some(expression)
    SelfHostHirBodyRoot::BlockBodyRoot(block_index) => {
      if block_index >= module_.blocks.length() {
        return Option::None
      }
      let block = module_.blocks[block_index]
      if self_host_u32_equal(block.items.length, 0u32) {
        return Option::None
      }
      let item_index = self_host_u32_add(
        block.items.start,
        self_host_u32_subtract(block.items.length, 1u32),
      )
      if item_index >= module_.block_items.length() {
        return Option::None
      }
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => Option::Some(expression)
        _ => Option::None
      }
    }
  }
}

struct SelfHostLinkedRootExpression {
  root_module_index: U32
  root_body_index: U32
  root_body_id: U64
  root_function_index: U32
}


struct SelfHostLinkedWasmFieldLink {
  type_index: U32
  field_index: U32
}

struct SelfHostLinkedI32LoopLink {
  control: U32
  state_slot: U32
  block_depth: U32
  loop_depth: U32
}

struct SelfHostLinkedFunctionValueSignature {
  module_id: U64
  specialization: U32
  expression: U32
  direct_type_index: U32
  entry_type_index: U32
  result_shape: SelfHostPlannedValueShape
}

enum SelfHostLinkedI32EmitTask {
  VisitLinkedI32Expression(U32, StarshineInstructions)
  VisitLinkedI32DiscardedExpression(U32, StarshineInstructions)
  ClearLinkedI32Discard(U32)
  EmitLinkedI32Prefix(SelfHostHirPrefixOperator, StarshineInstructions)
  EmitLinkedI64Prefix(SelfHostHirPrefixOperator, StarshineInstructions)
  EmitLinkedF32Prefix(SelfHostHirPrefixOperator, StarshineInstructions)
  EmitLinkedF64Prefix(SelfHostHirPrefixOperator, StarshineInstructions)
  EmitLinkedI32Binary(SelfHostHirBinaryOperator, Bool, StarshineInstructions)
  EmitLinkedI64Binary(SelfHostHirBinaryOperator, Bool, StarshineInstructions)
  EmitLinkedF32Binary(SelfHostHirBinaryOperator, StarshineInstructions)
  EmitLinkedF64Binary(SelfHostHirBinaryOperator, StarshineInstructions)
  EmitLinkedRefBinary(SelfHostHirBinaryOperator, StarshineInstructions)
  EmitLinkedBuiltin(Bytes, StarshineInstructions)
  EmitLinkedConversion(
    SelfHostPlannedValueShape,
    SelfHostPlannedValueShape,
    StarshineInstructions,
  )
  EmitLinkedArrayNew(U32, StarshineInstructions)
  EmitLinkedArrayNewDefault(U32, StarshineInstructions)
  EmitLinkedArrayCopy(U32, StarshineInstructions)
  EmitLinkedRawArrayCast(StarshineInstructions)
  EmitLinkedArrayLen(StarshineInstructions)
  EmitLinkedArrayLiteral(U32, U32, U32, StarshineInstructions)
  EmitLinkedArraySet(U32, StarshineInstructions)
  EmitLinkedFixedArrayGetPrefix(U32, StarshineInstructions)
  EmitLinkedRawArrayGet(SelfHostRawArrayStorage, StarshineInstructions)
  EmitLinkedI32Call(U32, StarshineInstructions)
  PrepareLinkedFunctionValueCall(U32, StarshineInstructions)
  EmitLinkedFunctionValueCall(
    U32,
    U32,
    U32,
    U32,
    SelfHostHirSpan,
    SelfHostPlannedValueShape,
    U32,
    StarshineInstructions,
  )
  FinishLinkedFunctionValueCall(U32, U32, U32, StarshineInstructions)
  EmitLinkedProductField(U32, U32, U32, StarshineInstructions)
  EmitLinkedLocalGet(U32, StarshineInstructions)
  EmitLinkedRefNull(StarshineInstructions)
  EmitLinkedStructNew(U32, StarshineInstructions)
  EmitLinkedStructGet(U32, U32, StarshineInstructions)
  EmitLinkedRawStructGet(U32, U32, StarshineInstructions)
  EmitLinkedRawRefCast(U32, StarshineInstructions)
  EmitLinkedRefCast(U32, StarshineInstructions)
  EmitLinkedStructSet(U32, U32, StarshineInstructions)
  EmitLinkedI32If(
    StarshineInstructions,
    StarshineInstructions,
    StarshineInstructions,
    SelfHostPlannedValueShape,
  )
  EmitLinkedI32Loop(
    StarshineInstructions,
    StarshineInstructions,
    StarshineInstructions,
    SelfHostPlannedValueShape,
  )
  EmitLinkedI32Break(U32, U32, StarshineInstructions)
  EmitLinkedI32Continue(U32, U32, Bool, StarshineInstructions)
  VisitLinkedI32MatchArms(
    SelfHostHirSpan,
    U32,
    U32,
    U32,
    StarshineInstructions,
    U32,
    SelfHostPlannedValueShape,
    SelfHostPlannedValueShape,
    SelfHostPlannedValueShape,
  )
  VisitLinkedI32Block(U32, StarshineInstructions, Bool)
  EmitLinkedI32LocalSet(U32, StarshineInstructions)
  EmitLinkedI32Return(StarshineInstructions)
  EmitLinkedI32Drop(StarshineInstructions)
  EmitLinkedUnreachable(StarshineInstructions)
}

fn self_host_linked_block_type(
  shape: SelfHostPlannedValueShape,
) -> StarshineValue {
  match self_host_physical_scalar_shape(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedValueShape::I64PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedValueShape::F32PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedValueShape::F64PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedValueShape::V128PlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedValueShape::RefPlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedValueShape::GenericPlannedValueShape => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedValueShape::ProductPlannedValueShape(_) => StarshineFfi.ffi_lib_BlockType_val_type(
      self_host_linked_eqref_value_type(),
    )
    _ => StarshineFfi.ffi_lib_BlockType_void_()
  }
}

fn self_host_linked_block_result_shape(
  module_: SelfHostPlannedModuleLowering,
  block: U32,
) -> SelfHostPlannedValueShape {
  if block >= module_.blocks.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let planned_block = module_.blocks[block]
  if !self_host_u32_greater(planned_block.items.length, 0u32) {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let item_index = self_host_u32_add(
    planned_block.items.start,
    self_host_u32_subtract(planned_block.items.length, 1u32),
  )
  if item_index >= module_.block_items.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  match module_.block_items[item_index].kind {
    SelfHostPlannedBlockItemKind::PlannedExpressionItem(expression) => if expression < module_.expressions.length() {
      module_.expressions[expression].shape
    } else {
      SelfHostPlannedValueShape::UnitPlannedValueShape
    }
    _ => SelfHostPlannedValueShape::UnitPlannedValueShape
  }
}

fn self_host_linked_recovered_expression_shape(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let planned = module_.expressions[expression]
  if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return planned.shape
  }
  match planned.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let mut relative = 0u32
      let _ = while relative {
        current => if current < body.locals.length {
          let local_index = self_host_u32_add(body.locals.start, current)
          if local_index < module_.locals.length() {
            let local = self_host_body_planned_local_identity(module_.locals[local_index])
            if self_host_u32_equal(local.local_id, local_id) {
              if local.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                return self_host_planned_merged_body_value_shape(
                  module_.resolved_types,
                  module_.inferred,
                  local.type_,
                )
              }
              return local.shape
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      SelfHostPlannedValueShape::ErrorPlannedValueShape
    }
    _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

fn self_host_linked_array_body_carrier_from_shape(
  shape: SelfHostPlannedValueShape,
) -> SelfHostWasmBodyCarrier {
  match self_host_linked_array_carrier_from_shape(shape) {
    0i32 => SelfHostWasmBodyCarrier::I32BodyCarrier
    1i32 => SelfHostWasmBodyCarrier::I64BodyCarrier
    2i32 => SelfHostWasmBodyCarrier::F32BodyCarrier
    3i32 => SelfHostWasmBodyCarrier::F64BodyCarrier
    4i32 => SelfHostWasmBodyCarrier::V128BodyCarrier
    _ => SelfHostWasmBodyCarrier::EqRefBodyCarrier
  }
}

fn self_host_linked_fixed_array_body_carrier_from_type(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
) -> SelfHostWasmBodyCarrier {
  let base = self_host_linked_array_runtime_base(link)
  if type_index < base || type_index >= self_host_u32_add(base, 6u32) {
    return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  match type_index - base {
    0u32 => SelfHostWasmBodyCarrier::I32BodyCarrier
    1u32 => SelfHostWasmBodyCarrier::I64BodyCarrier
    2u32 => SelfHostWasmBodyCarrier::F32BodyCarrier
    3u32 => SelfHostWasmBodyCarrier::F64BodyCarrier
    4u32 => SelfHostWasmBodyCarrier::V128BodyCarrier
    _ => SelfHostWasmBodyCarrier::EqRefBodyCarrier
  }
}

fn self_host_linked_canonical_local_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> SelfHostWasmBodyCarrier {
  match canonical {
    Option::Some(plan) => {
      let slot = self_host_body_local_slot(module_, body, local_id)
      if slot < plan.locals.length() {
        plan.locals[slot]
      } else {
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
    }
    Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
}

fn self_host_linked_canonical_or_declared_local_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> SelfHostWasmBodyCarrier {
  let canonical_carrier = self_host_linked_canonical_local_carrier(
    canonical,
    module_,
    body,
    local_id,
  )
  if !(canonical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
    return canonical_carrier
  }
  match self_host_linked_local_declared_shape(module_, body, local_id) {
    Option::Some(shape) => self_host_body_carrier_from_shape(shape)
    Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
}

fn self_host_linked_concrete_shape_carrier(
  shape: SelfHostPlannedValueShape,
) -> SelfHostWasmBodyCarrier {
  if shape is SelfHostPlannedValueShape::ProductPlannedValueShape(_) {
    return SelfHostWasmBodyCarrier::EqRefBodyCarrier
  }
  match self_host_physical_scalar_shape(shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedValueShape::F32PlannedValueShape => SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostPlannedValueShape::F64PlannedValueShape => SelfHostWasmBodyCarrier::F64BodyCarrier
    SelfHostPlannedValueShape::V128PlannedValueShape => SelfHostWasmBodyCarrier::V128BodyCarrier
    SelfHostPlannedValueShape::UnitPlannedValueShape => SelfHostWasmBodyCarrier::UnitBodyCarrier
    SelfHostPlannedValueShape::NeverPlannedValueShape => SelfHostWasmBodyCarrier::NeverBodyCarrier
    SelfHostPlannedValueShape::RefPlannedValueShape => if shape is SelfHostPlannedValueShape::RefPlannedValueShape {
      SelfHostWasmBodyCarrier::EqRefBodyCarrier
    } else {
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    _ => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
}

fn self_host_linked_static_expression_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostWasmBodyCarrier {
  self_host_linked_concrete_shape_carrier(
    self_host_linked_static_expression_shape(link, module_, expression),
  )
}

fn self_host_linked_canonical_or_static_expression_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> SelfHostWasmBodyCarrier {
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(
      plan,
      expression,
    ) {
      Option::Some(value) => if value.carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
        value.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
        self_host_linked_static_expression_carrier(link, module_, expression)
      } else {
        value.carrier
      }
      Option::None => self_host_linked_static_expression_carrier(
        link,
        module_,
        expression,
      )
    }
    Option::None => self_host_linked_static_expression_carrier(
      link,
      module_,
      expression,
    )
  }
}

fn self_host_linked_canonical_field_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  expression: U32,
) -> SelfHostWasmBodyCarrier {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let planned = match self_host_body_plan_expression(plan, expression) {
    Option::Some(value) => value
    Option::None => return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  if link.erased_fields.get(planned.selected_field) is Option::Some(true) {
    return planned.value.carrier
  }
  match planned.selected_storage {
    Option::Some(storage) => return self_host_body_carrier_from_shape(
      self_host_linked_storage_shape(storage),
    )
    Option::None => {}
  }
  if !self_host_u64_equal(planned.selected_field, 0u64) {
    match self_host_linked_struct_field_shape(link, planned.selected_field) {
      Option::Some(shape) => return self_host_body_carrier_from_shape(shape)
      Option::None => {}
    }
  }
  if !self_host_u32_equal(planned.selected_type_index, 4294967295u32) && !(
    self_host_u32_equal(planned.selected_field_index, 4294967295u32)
  ) {
    match self_host_linked_physical_field_shape(
      link,
      planned.selected_type_index,
      planned.selected_field_index,
    ) {
      Option::Some(shape) => return self_host_body_carrier_from_shape(shape)
      Option::None => {}
    }
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_linked_canonical_branch_expected_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> SelfHostWasmBodyCarrier {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let mut parent = self_host_u32_add(expression, 1u32)
  let _ = while parent {
    current => if current < end && current < module_.expressions.length() {
      match module_.expressions[current].kind {
        SelfHostPlannedExpressionKind::PlannedIfExpression(
          _,
          then_block,
          else_expression,
        ) => {
          let then_tail = self_host_body_block_tail_expression(module_, then_block)
          if self_host_u32_equal(expression, then_tail) || self_host_u32_equal(
            expression,
            else_expression,
          ) {
            match self_host_body_plan_expression(plan, current) {
              Option::Some(value) => return value.carrier
              Option::None => return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
            }
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
}

fn self_host_linked_binary_operand_shape(
  left: SelfHostPlannedValueShape,
  right: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  let left_scalar = self_host_physical_scalar_shape(left)
  let right_scalar = self_host_physical_scalar_shape(right)
  match left_scalar {
    SelfHostPlannedValueShape::RefPlannedValueShape => match right_scalar {
      SelfHostPlannedValueShape::I32PlannedValueShape => right
      SelfHostPlannedValueShape::I64PlannedValueShape => right
      SelfHostPlannedValueShape::F32PlannedValueShape => right
      SelfHostPlannedValueShape::F64PlannedValueShape => right
      SelfHostPlannedValueShape::V128PlannedValueShape => right
      _ => left
    }
    _ => left
  }
}

fn self_host_linked_exact_emitted_expression_carrier(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
) -> SelfHostWasmBodyCarrier {
  if expression < module_.expressions.length() &&
    module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) &&
    module_.expressions[expression].shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
    // Product projection consumes the stored Unit marker; it emits no value.
    return SelfHostWasmBodyCarrier::UnitBodyCarrier
  }
  if expression >= module_.expressions.length() {
    return SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
  }
  match canonical {
    Option::Some(plan) => match self_host_body_plan_expression(plan, expression) {
      Option::Some(planned) => if link.erased_fields.get(planned.selected_field) is Option::Some(true) ||
        module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) ||
        module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, _, _) ||
        planned.value.carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier ||
        planned.value.carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
        // Erasure and non-returning flow are fixed facts. Array storage and
        // name-based recovery cannot turn them into reference operands.
        return planned.value.carrier
      }
      Option::None => {}
    }
    Option::None => {}
  }
  if self_host_linked_expression_is_variant_call(
    link,
    body.body,
    expression,
  ) || self_host_linked_runtime_reference_constructor(module_, expression) {
    // A variant expression returns the constructed object. Its payload can use
    // a scalar carrier, but the expression result is always a reference.
    return SelfHostWasmBodyCarrier::EqRefBodyCarrier
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedPrefixExpression(operator, operand) => if operator is SelfHostHirPrefixOperator::LogicalNot {
      SelfHostWasmBodyCarrier::I32BodyCarrier
    } else {
      self_host_linked_exact_emitted_expression_carrier(
        canonical,
        link,
        module_,
        body,
        caller_specialization,
        operand,
      )
    }
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      expression,
      0u32,
    ) {
      self_host_linked_exact_emitted_expression_carrier(
        canonical,
        link,
        module_,
        body,
        caller_specialization,
        self_host_u32_subtract(expression, 1u32),
      )
    } else {
      SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
      let tail = self_host_body_block_tail_expression(module_, block)
      if self_host_u32_equal(tail, 4294967295u32) {
        SelfHostWasmBodyCarrier::UnitBodyCarrier
      } else {
        self_host_linked_exact_emitted_expression_carrier(
          canonical,
          link,
          module_,
          body,
          caller_specialization,
          tail,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
      let branch_expected_carrier = self_host_linked_canonical_branch_expected_carrier(
        canonical,
        module_,
        body,
        expression,
      )
      if !(branch_expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
        branch_expected_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
      ) {
        return branch_expected_carrier
      }
      let expected_carrier = self_host_linked_concrete_shape_carrier(
        self_host_linked_expression_expected_shape(
          link,
          module_,
          body,
          caller_specialization,
          expression,
        ),
      )
      if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
        expected_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
      ) {
        return expected_carrier
      }
      match self_host_linked_local_initializer_expression(
        module_,
        body,
        local_id,
      ) {
      Option::Some(initializer) => if initializer < module_.expressions.length() && !self_host_u32_equal(
        initializer,
        expression,
      ) {
        let initializer_carrier = self_host_linked_exact_emitted_expression_carrier(
          canonical,
          link,
          module_,
          body,
          caller_specialization,
          initializer,
        )
        if !(initializer_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
          initializer_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
        ) {
          initializer_carrier
        } else {
          let local_carrier = self_host_linked_canonical_or_declared_local_carrier(
            canonical,
            module_,
            body,
            local_id,
          )
          if !(local_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            local_carrier
          } else {
            initializer_carrier
          }
        }
      } else {
        self_host_linked_canonical_or_declared_local_carrier(
          canonical,
          module_,
          body,
          local_id,
        )
      }
      Option::None => self_host_linked_canonical_or_declared_local_carrier(
        canonical,
        module_,
        body,
        local_id,
      )
      }
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, target) => match self_host_linked_expression_source_container_element_shape(
      link,
      module_,
      body,
      base,
    ) {
      Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
        shape is SelfHostPlannedValueShape::NeverPlannedValueShape
      ) {
        self_host_linked_array_body_carrier_from_shape(shape)
      } else {
        SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      Option::None => {
        let planned_shape = module_.expressions[expression].shape
        if !(planned_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          planned_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
        ) && !(
          self_host_physical_scalar_shape(planned_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) {
          return self_host_linked_array_body_carrier_from_shape(planned_shape)
        }
        let backend_shape = self_host_linked_backend_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          expression,
        )
        if !(backend_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
          backend_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
        ) && !(
          self_host_physical_scalar_shape(backend_shape) is SelfHostPlannedValueShape::RefPlannedValueShape
        ) {
          return self_host_linked_array_body_carrier_from_shape(backend_shape)
        }
        match self_host_linked_canonical_expression_shape(
          canonical,
          expression,
        ) {
        Option::Some(shape) => {
          let carrier = self_host_linked_array_body_carrier_from_shape(shape)
          if carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier ||
            carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier {
            SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
          } else {
            carrier
          }
        }
        Option::None => {
          let call_argument_shape = self_host_linked_call_first_type_argument_shape(
            module_,
            module_.expressions[expression],
          )
          let selected_shape = match target {
            SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => match self_host_linked_i32_call_index(
              link,
              body.body,
              caller_specialization,
              expression,
              declaration,
            ) {
              Option::Some(function_index) => self_host_linked_physical_function_specialization_shape(
                link,
                function_index,
              )
              Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
            }
            _ => SelfHostPlannedValueShape::ErrorPlannedValueShape
          }
          match call_argument_shape {
            Option::Some(shape) => if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
              shape is SelfHostPlannedValueShape::NeverPlannedValueShape
            ) {
              return self_host_linked_array_body_carrier_from_shape(shape)
            }
            Option::None => {}
          }
          if !(selected_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
            selected_shape is SelfHostPlannedValueShape::NeverPlannedValueShape
          ) {
            self_host_linked_array_body_carrier_from_shape(selected_shape)
          } else if !self_host_u64_equal(
            self_host_linked_expression_container_element_nominal_declaration(
              link,
              module_,
              body,
              base,
            ),
            0u64,
          ) {
            SelfHostWasmBodyCarrier::EqRefBodyCarrier
          } else {
            match self_host_linked_expression_container_element_shape(
              link,
              module_,
              body,
              base,
            ) {
              Option::Some(shape) => self_host_linked_array_body_carrier_from_shape(shape)
              Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
            }
          }
        }
      }
      }
    }
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
      link,
      module_,
      body,
      field,
      base,
    ) {
      Option::Some(field_link) => match self_host_linked_physical_field_shape(
        link,
        field_link.type_index,
        field_link.field_index,
      ) {
        Option::Some(shape) => self_host_body_carrier_from_shape(shape)
        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => {
      let resolved_carrier = match self_host_linked_exact_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        expression,
      ) {
        Option::Some(shape) => self_host_linked_concrete_shape_carrier(shape)
        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      if !(resolved_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
        resolved_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
      ) {
        // A field resolved from the receiver nominal is more precise than a
        // broad cached reference selection.
        return resolved_carrier
      }
      let expected_carrier = self_host_linked_concrete_shape_carrier(
        self_host_linked_expression_expected_shape(
          link,
          module_,
          body,
          caller_specialization,
          expression,
        ),
      )
      if !(expected_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
        expected_carrier is SelfHostWasmBodyCarrier::EqRefBodyCarrier
      ) {
        return expected_carrier
      }
      let canonical_carrier = self_host_linked_canonical_field_carrier(
        canonical,
        link,
        expression,
      )
      if !(canonical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
        return canonical_carrier
      }
      resolved_carrier
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(
      declaration,
      target,
      _,
      _,
    ) => match self_host_linked_selected_call_result_shape(
      link,
      body.body,
      caller_specialization,
      expression,
      declaration,
    ) {
      Option::Some(shape) => self_host_body_carrier_from_shape(shape)
      Option::None => match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        declaration,
      ) {
        Option::Some(function_index) => self_host_body_carrier_from_shape(
          self_host_linked_physical_function_result_shape(link, function_index),
        )
        Option::None => self_host_linked_canonical_or_static_expression_carrier(
          canonical,
          link,
          module_,
          expression,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
      match self_host_linked_unresolved_get_result_shape(
        link,
        module_,
        body,
        expression,
      ) {
        Option::Some(shape) => {
          let specialized_shape = self_host_body_specialization_shape(
            link,
            caller_specialization,
            shape,
          )
          let carrier = self_host_linked_array_body_carrier_from_shape(
            specialized_shape,
          )
          if !(carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
            return carrier
          }
        }
        Option::None => {}
      }
      let field_target = if target < module_.expressions.length() &&
        module_.expressions[target].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
        self_host_u32_greater(target, 0u32) {
        self_host_u32_subtract(target, 1u32)
      } else {
        target
      }
      if field_target < module_.expressions.length() {
        match module_.expressions[field_target].kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedField(receiver, name) => if receiver < module_.expressions.length() &&
            name < self_host_linked_module_name_count(module_) {
            let receiver_type = match self_host_linked_canonical_expression_heap_type(
              canonical,
              module_,
              body,
              receiver,
            ) {
              Option::Some(value) => value
              Option::None => 4294967295u32
            }
            let array_base = self_host_linked_array_runtime_base(link)
            let receiver_is_fixed_array = receiver_type >= array_base && receiver_type < self_host_u32_add(
              array_base,
              6u32,
            )
            let method_name = self_host_linked_module_name_at(module_, name)
            if method_name == "get_unchecked" && self_host_u32_equal(
              arguments.length,
              1u32,
            ) && receiver_is_fixed_array {
              return self_host_linked_fixed_array_body_carrier_from_type(
                link,
                receiver_type,
              )
            }
            if self_host_u32_equal(arguments.length, 0u32) && method_name == "length" && (
              receiver_is_fixed_array ||
                self_host_linked_expression_is_map_value(
                  link,
                  module_,
                  body,
                  receiver,
                )
            ) {
              return SelfHostWasmBodyCarrier::I32BodyCarrier
            }
          }
          _ => {}
        }
      }
      match self_host_linked_i32_call_index(
        link,
        body.body,
        caller_specialization,
        expression,
        0u64,
      ) {
        Option::Some(function_index) => self_host_body_carrier_from_shape(
          self_host_linked_physical_function_result_shape(link, function_index),
        )
        Option::None => self_host_linked_canonical_or_static_expression_carrier(
          canonical,
          link,
          module_,
          expression,
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => SelfHostWasmBodyCarrier::EqRefBodyCarrier
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) => self_host_body_carrier_from_shape(
      self_host_linked_function_value_result_shape(link, module_, expression),
    )
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, _, _) => self_host_linked_concrete_shape_carrier(
      self_host_linked_backend_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        expression,
      ),
    )
    SelfHostPlannedExpressionKind::PlannedMatchExpression(_, arms) => {
      let canonical_carrier = match self_host_body_plan_expression_from_optional(
        canonical,
        expression,
      ) {
        Option::Some(value) => value.carrier
        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      if !(canonical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
        canonical_carrier
      } else {
        match self_host_linked_scoped_match_result_shape(
          link,
          module_,
          body,
          caller_specialization,
          arms,
          SelfHostPlannedValueShape::ErrorPlannedValueShape,
        ) {
          Option::Some(shape) => self_host_linked_concrete_shape_carrier(shape)
          Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
        }
      }
    }
    SelfHostPlannedExpressionKind::PlannedIfExpression(_, then_block, else_expression) => {
      let canonical_carrier = match self_host_body_plan_expression_from_optional(
        canonical,
        expression,
      ) {
        Option::Some(value) => value.carrier
        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      if !(canonical_carrier is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) {
        canonical_carrier
      } else {
        self_host_linked_concrete_shape_carrier(
          self_host_linked_if_result_shape(
            link,
            module_,
            body,
            caller_specialization,
            SelfHostPlannedValueShape::ErrorPlannedValueShape,
            expression,
            module_.expressions[expression],
            then_block,
            else_expression,
          ),
        )
      }
    }
    SelfHostPlannedExpressionKind::PlannedProductField(base, field, _) => match self_host_linked_preferred_pair_type_for_projection(
      link,
      module_,
      body,
      caller_specialization,
      base,
    ) {
      Option::Some(type_index) => match self_host_linked_pair_field_shape(
        link,
        type_index,
        field,
      ) {
        Option::Some(shape) => self_host_linked_concrete_shape_carrier(shape)
        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
      }
      Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
    }
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => SelfHostWasmBodyCarrier::I32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => SelfHostWasmBodyCarrier::I64BodyCarrier
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => SelfHostWasmBodyCarrier::F32BodyCarrier
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => SelfHostWasmBodyCarrier::F64BodyCarrier
    _ => self_host_linked_static_expression_carrier(link, module_, expression)
  }
}

fn self_host_linked_assert_field_get_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  field: U64,
  field_link: SelfHostLinkedWasmFieldLink,
) -> Option<String> {
  if expression >= module_.expressions.length() {
    return Option::Some("linked field carrier assertion has an invalid expression")
  }
  let logical_shape = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    self_host_planned_expression_at(module_.expressions, expression).type_,
  )
  let expected_shape = self_host_body_specialization_shape_for_type(link, module_, caller_specialization, module_.expressions[expression].type_, logical_shape)
  let actual_shape = match self_host_linked_physical_field_shape(
    link,
    field_link.type_index,
    field_link.field_index,
  ) {
    Option::Some(shape) => shape
    Option::None => {
      return Option::Some("linked field carrier assertion has no physical field shape")
    }
  }
  let expected = self_host_body_carrier_from_shape(expected_shape)
  let actual = self_host_body_carrier_from_shape(actual_shape)
  if expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier {
    return Option::None
  }
  if self_host_body_carrier_equal(expected, actual) || (actual is SelfHostWasmBodyCarrier::EqRefBodyCarrier && self_host_linked_erased_field_box_type(link, field, expected) is Option::Some(_)) {
    return Option::None
  }
  if expected is SelfHostWasmBodyCarrier::UnitBodyCarrier && self_host_linked_physical_erased_unit_field(link, field, field_link) {
    return Option::None
  }
  // Field emission must use the carrier of the resolved expression type.
  let message = StringBuilder::new()
  message.append("linked field get carrier invariant failed module=")
  message.append_u64(module_.module_id)
  message.append(" declaration=")
  message.append_u64(body.declaration)
  message.append(" name=")
  message.append(bytes_to_string(self_host_linked_declaration_name(
    link,
    body.declaration,
  )))
  message.append(" body=")
  message.append_u64(body.body)
  message.append(" specialization=")
  message.append_u32(caller_specialization)
  message.append(" expression=")
  message.append_u32(expression)
  message.append(" field=")
  message.append_u64(field)
  message.append(" physical_type=")
  message.append_u32(field_link.type_index)
  message.append(" physical_field=")
  message.append_u32(field_link.field_index)
  message.append(" logical_type=")
  message.append_i32(self_host_planned_expression_at(module_.expressions, expression).type_)
  message.append(" expected=")
  message.append(self_host_body_carrier_name(expected))
  message.append(" actual=")
  message.append(self_host_body_carrier_name(actual))
  Option::Some(message.finish())
}

fn self_host_linked_if_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expected_result_shape: SelfHostPlannedValueShape,
  expression: U32,
  planned: SelfHostPlannedExpression,
  then_block: U32,
  else_expression: U32,
) -> SelfHostPlannedValueShape {
  if !planned.flow.falls_through && !self_host_linked_expression_is_let_value(
    module_,
    body,
    expression,
  ) {
    return SelfHostPlannedValueShape::UnitPlannedValueShape
  }
  let inferred_result_shape = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    planned.type_,
  )
  let let_value_shape = self_host_linked_let_value_shape(
    module_,
    body,
    expression,
  )
  let fallback = match let_value_shape {
    Option::Some(shape) => shape
    Option::None => if !(inferred_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
      inferred_result_shape
    } else if body.result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    expected_result_shape
    } else {
      body.result_shape
    }
  }
  let planned_then_shape = self_host_linked_block_result_shape(
    module_,
    then_block,
  )
  let recovered_then_shape = if then_block < module_.blocks.length() && self_host_u32_greater(
    module_.blocks[then_block].items.length,
    0u32,
  ) {
    let item_index = self_host_u32_add(
      module_.blocks[then_block].items.start,
      self_host_u32_subtract(module_.blocks[then_block].items.length, 1u32),
    )
    if item_index < module_.block_items.length() {
      match module_.block_items[item_index].kind {
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => match self_host_linked_exact_expression_shape(
          link,
          module_,
          body,
          caller_specialization,
          value,
        ) {
          Option::Some(shape) => shape
          Option::None => if planned_then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
            self_host_linked_backend_expression_shape(
              link,
              module_,
              body,
              caller_specialization,
              value,
            )
          } else {
            planned_then_shape
          }
        }
        _ => planned_then_shape
      }
    } else {
      planned_then_shape
    }
  } else {
    planned_then_shape
  }
  let then_tail = self_host_body_block_tail_expression(module_, then_block)
  let then_shape = if !self_host_u32_equal(then_tail, 4294967295u32) && self_host_linked_expression_returns_variant_value(
    link,
    module_,
    body,
    then_tail,
  ) {
    SelfHostPlannedValueShape::RefPlannedValueShape
  } else {
    recovered_then_shape
  }
  let planned_else_shape = self_host_linked_recovered_expression_shape(
    module_,
    body,
    else_expression,
  )
  let recovered_else_shape = match self_host_linked_exact_expression_shape(
    link,
    module_,
    body,
    caller_specialization,
    else_expression,
  ) {
    Option::Some(shape) => shape
    Option::None => if planned_else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      self_host_linked_backend_expression_shape(
        link,
        module_,
        body,
        caller_specialization,
        else_expression,
      )
    } else {
      planned_else_shape
    }
  }
  let else_shape = if self_host_linked_expression_returns_variant_value(
    link,
    module_,
    body,
    else_expression,
  ) {
    SelfHostPlannedValueShape::RefPlannedValueShape
  } else {
    recovered_else_shape
  }
  if then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape &&
    else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    SelfHostPlannedValueShape::UnitPlannedValueShape
  } else if then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    if else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      else_shape
    }
  } else if else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape {
    if then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      then_shape
    }
  } else if !(then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
    !(then_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
    !(then_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::UnitPlannedValueShape) &&
    !(else_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
    self_host_linked_array_carrier_from_shape(then_shape) ==
      self_host_linked_array_carrier_from_shape(else_shape) {
    then_shape
  } else if !(planned.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    planned.shape
  } else if then_shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
    else_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
    let then_tail = self_host_body_block_tail_expression(module_, then_block)
    let then_returns_variant = !self_host_u32_equal(then_tail, 4294967295u32) && self_host_linked_expression_returns_variant_value(
      link,
      module_,
      body,
      then_tail,
    )
    let else_returns_variant = self_host_linked_expression_returns_variant_value(
      link,
      module_,
      body,
      else_expression,
    )
    if self_host_linked_expression_is_let_value(module_, body, expression) && (
      self_host_physical_scalar_shape(then_shape) is SelfHostPlannedValueShape::RefPlannedValueShape ||
      self_host_physical_scalar_shape(else_shape) is SelfHostPlannedValueShape::RefPlannedValueShape ||
      self_host_physical_scalar_shape(fallback) is SelfHostPlannedValueShape::RefPlannedValueShape
    ) {
      SelfHostPlannedValueShape::RefPlannedValueShape
    } else if then_returns_variant || else_returns_variant {
      SelfHostPlannedValueShape::RefPlannedValueShape
    } else {
      SelfHostPlannedValueShape::UnitPlannedValueShape
    }
  } else if then_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    if else_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      fallback
    } else {
      else_shape
    }
  } else {
    then_shape
  }
}

fn self_host_linked_i32_schedule_expression(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  expression: U32,
  instructions: StarshineInstructions,
  depth: U32,
) -> Unit {
  if expression < depths.length() {
    depths[expression] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Expression(
    expression,
    instructions,
  ))
}

fn self_host_linked_i32_schedule_discarded_expression(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  expression: U32,
  instructions: StarshineInstructions,
  depth: U32,
) -> Unit {
  // An absent optional transfer payload is not an expression to emit or drop.
  if expression == 4294967295u32 {
    return
  }
  if expression < depths.length() {
    depths[expression] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32DiscardedExpression(
    expression,
    instructions,
  ))
}

fn self_host_linked_non_value_parent_context(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  child: U32,
) -> String {
  let message = StringBuilder::new()
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let mut sought = child
  let mut level = 0u32
  let _ = while level {
    current_level => if current_level < 3u32 {
      let mut found_parent = 4294967295u32
      let mut found_kind = ""
      let mut parent = body.expressions.start
      let _ = while parent {
        current => if current < end && current < module_.expressions.length() {
          match module_.expressions[current].kind {
            SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => if self_host_u32_equal(
              base,
              sought,
            ) {
              found_parent = current
              found_kind = "field-get"
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => if self_host_u32_equal(
              base,
              sought,
            ) {
              found_parent = current
              found_kind = "unresolved-field"
            }
            SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, _, _) => if self_host_u32_equal(
              target,
              sought,
            ) {
              found_parent = current
              found_kind = "direct-call-target"
            }
            SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, _, _) => if self_host_u32_equal(
              target,
              sought,
            ) {
              found_parent = current
              found_kind = "function-call-target"
            }
            SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if self_host_u32_equal(
              target,
              sought,
            ) {
              found_parent = current
              found_kind = "unresolved-call-target"
            }
            _ => {}
          }
          if found_parent < module_.expressions.length() {
            break self_host_semantic_unit()
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if found_parent >= module_.expressions.length() {
        break self_host_semantic_unit()
      }
      message.append(" parent=")
      message.append(found_kind)
      message.append(":")
      message.append_u32(found_parent)
      message.append(" parent_source_name=")
      message.append(self_host_program_lowering_name_at(
        module_,
        module_.expressions[found_parent].source_name,
      ))
      sought = found_parent
      continue current_level + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  message.finish()
}


fn self_host_linked_call_target_is_namespace_selection(
  module_: SelfHostPlannedModuleLowering,
  target: U32,
) -> Bool {
  if target >= module_.expressions.length() {
    return false
  }
  let namespace = match module_.expressions[target].kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => base
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => base
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
      target,
      0u32,
    ) {
      target - 1u32
    } else {
      target
    }
    SelfHostPlannedExpressionKind::PlannedPoisonExpression => if self_host_u32_greater(
      target,
      0u32,
    ) {
      target - 1u32
    } else {
      target
    }
    _ => target
  }
  if namespace >= module_.expressions.length() {
    return false
  }
  let root = match module_.expressions[namespace].kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(_, base, _) => base
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => base
    _ => namespace
  }
  root < module_.expressions.length() &&
    self_host_body_name_reference_is_namespace(
      module_.expressions[root].reference,
    )
}

fn self_host_linked_i32_schedule_block(
  tasks: Array<SelfHostLinkedI32EmitTask>,
  depths: Array<U32>,
  block: U32,
  instructions: StarshineInstructions,
  depth: U32,
  discard_final: Bool,
) -> Unit {
  if block < depths.length() {
    depths[block] = depth
  }
  tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
    block,
    instructions,
    discard_final,
  ))
}

fn self_host_linked_i32_loop_link(
  links: Array<SelfHostLinkedI32LoopLink>,
  control: U32,
) -> Option<SelfHostLinkedI32LoopLink> {
  for link in links {
    if self_host_u32_equal(link.control, control) {
      return Option::Some(link)
    }
  }
  Option::None
}

fn self_host_linked_program_type_at(
  values: Array<SelfHostPlannedProgramWasmType>,
  index: U32,
) -> SelfHostPlannedProgramWasmType {
  array_get_unchecked(values, index)
}

fn self_host_linked_struct_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let mut index = 0u32
  while index {
    current => if current < link.types.length() {
      let linked_type = self_host_linked_program_type_at(link.types, current)
      if self_host_u32_equal(linked_type.module_index, owner) {
        let module_ = link.fragments.modules[linked_type.module_index]
        let physical = self_host_linked_physical_type_at(
          module_,
          linked_type.fragment_index,
        )
        match physical.kind {
          SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(candidate) => if self_host_u64_equal(
            candidate,
            declaration,
          ) {
            return Option::Some(linked_type.type_index)
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}


fn self_host_linked_nominal_field_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  allow_struct: Bool,
) -> Option<U32> {
  if self_host_linked_is_raw_array_owner(link, declaration) {
    return Option::None
  }
  if allow_struct {
    match self_host_linked_struct_type_index(link, declaration) {
      Option::Some(type_index) => return Option::Some(type_index)
      Option::None => {}
    }
  }
  match self_host_linked_enum_base_type_index(link, declaration) {
    Option::Some(type_index) => return Option::Some(type_index)
    Option::None => {}
  }
  Option::None
}

fn self_host_linked_variant_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  variant: U64,
) -> Option<U32> {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(
    variant,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, owner) {
      let module_ = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        module_,
        linked_type.fragment_index,
      )
      match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
          _,
          candidate,
          _,
        ) => if self_host_u64_equal(candidate, variant) {
          return Option::Some(linked_type.type_index)
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_static_expression_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  expression_index: U32,
) -> SelfHostPlannedValueShape {
  if expression_index >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let expression = module_.expressions[expression_index]
  if !(expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return expression.shape
  }
  let inferred = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    expression.type_,
  )
  if !(inferred is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
    return inferred
  }
  match expression.kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => match self_host_linked_struct_field_shape(
      link,
      field,
    ) {
      Option::Some(shape) => shape
      Option::None => inferred
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        module_.expressions[base].nominal,
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field) => match self_host_linked_physical_field_shape(
          link,
          field.type_index,
          field.field_index,
        ) {
          Option::Some(shape) => shape
          Option::None => inferred
        }
        Option::None => inferred
      }
    } else {
      inferred
    }
    SelfHostPlannedExpressionKind::PlannedIndexGet(base, _, _) => if base < module_.expressions.length() {
      match self_host_linked_type_first_argument_shape(
        module_,
        self_host_planned_expression_at(module_.expressions, base).type_,
      ) {
        Option::Some(shape) => shape
        Option::None => inferred
      }
    } else {
      inferred
    }
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedProductNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedObjectNew(_) => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) => SelfHostPlannedValueShape::RefPlannedValueShape
    _ => inferred
  }
}

fn self_host_linked_unresolved_method_call_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> Option<SelfHostPlannedValueShape> {
  if expression >= module_.expressions.length() {
    return Option::None
  }
  match module_.expressions[expression].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
      match module_.expressions[target].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if name < self_host_linked_module_name_count(
          module_,
        ) {
          match self_host_linked_method_call_index_for_receiver(
            link,
            module_,
            body,
            base,
            self_host_linked_module_name_at(module_, name),
          ) {
            Option::Some(function_index) => {
              let shape = self_host_linked_physical_function_result_shape(
                link,
                function_index,
              )
              if shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                Option::None
              } else {
                Option::Some(shape)
              }
            }
            Option::None => Option::None
          }
        } else {
          Option::None
        }
        _ => Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_constructor_source_field_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  source: SelfHostPlannedObjectField,
) -> SelfHostPlannedValueShape {
  if source.value >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let source_expression = module_.expressions[source.value]
  match source_expression.kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => match self_host_linked_local_initializer_expression(
      module_,
      body,
      local_id,
    ) {
      Option::Some(initializer) => match self_host_linked_unresolved_method_call_result_shape(
        link,
        module_,
        body,
        initializer,
      ) {
        Option::Some(shape) => shape
        Option::None => match self_host_linked_specialized_call_result_shape(
          link,
          body.body,
          caller_specialization,
          initializer,
        ) {
          Option::Some(shape) => shape
          Option::None => match self_host_linked_exact_expression_shape(
            link,
            module_,
            body,
            caller_specialization,
            initializer,
          ) {
            Option::Some(shape) => shape
            Option::None => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
              self_host_linked_static_expression_shape(
                link,
                module_,
                source.value,
              )
            } else {
              source_expression.shape
            }
          }
        }
      }
      Option::None => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
        self_host_linked_static_expression_shape(
          link,
          module_,
          source.value,
        )
      } else {
        source_expression.shape
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _) => if source_expression.shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
      self_host_planned_merged_body_value_shape(
        module_.resolved_types,
        module_.inferred,
        source_expression.type_,
      )
    } else {
      source_expression.shape
    }
    _ => self_host_linked_static_expression_shape(
      link,
      module_,
      source.value,
    )
  }
}

fn self_host_linked_constructor_field_shape_matches(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  source: SelfHostPlannedObjectField,
  physical: SelfHostPlannedWasmField,
) -> Bool {
  let source_shape = self_host_linked_constructor_source_field_shape(
    link,
    module_,
    body,
    caller_specialization,
    source,
  )
  if source_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
    return true
  }
  let physical_shape = self_host_physical_scalar_shape(self_host_linked_storage_shape(physical.storage))
  if self_host_linked_erased_field_box_type(link, physical.declaration, self_host_body_carrier_from_shape(source_shape)) is Option::Some(_) {
    return physical_shape is SelfHostPlannedValueShape::RefPlannedValueShape
  }
  match self_host_physical_scalar_shape(source_shape) {
    SelfHostPlannedValueShape::I32PlannedValueShape => physical_shape is SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I64PlannedValueShape => physical_shape is SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::F32PlannedValueShape => physical_shape is SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedValueShape::F64PlannedValueShape => physical_shape is SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedValueShape::V128PlannedValueShape => physical_shape is SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostPlannedValueShape::UnitPlannedValueShape => self_host_linked_erased_field_unit_storage(link, physical.declaration, physical.storage, SelfHostWasmBodyCarrier::UnitBodyCarrier)
    SelfHostPlannedValueShape::NeverPlannedValueShape => true
    _ => physical_shape is SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_linked_bool_at(values: Array<Bool>, index: U32) -> Bool {
  array_get_unchecked(values, index)
}

fn self_host_linked_bool_set(
  values: Array<Bool>,
  index: U32,
  value: Bool,
) -> Unit {
  array_set_unchecked(values, index, value)
}

fn self_host_linked_constructor_type_matches(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  physical_module: SelfHostPlannedModuleWasmGCFragments,
  physical: SelfHostPlannedWasmPhysicalType,
  fields: SelfHostHirSpan,
) -> Bool {
  if !self_host_u32_equal(physical.fields.length, fields.length) {
    return false
  }
  let used = []
  let mut used_index = 0u32
  let _ = while used_index {
    current => if current < fields.length {
      used.push(false)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut physical_index = 0u32
  let _ = while physical_index {
    current => if current < physical.fields.length {
      let physical_field = self_host_linked_physical_field_at(
        physical_module,
        self_host_u32_add(physical.fields.start, current),
      )
      let mut found = false
      let mut source_index = 0u32
      let _ = while source_index {
        source => if source < fields.length {
          let object_index = self_host_u32_add(fields.start, source)
          if object_index < module_.object_fields.length() {
            let source_field = self_host_planned_object_field_at(
              module_.object_fields,
              object_index,
            )
            let exact_declaration = !self_host_u64_equal(
              source_field.field,
              0u64,
            ) && !self_host_u64_equal(
              physical_field.declaration,
              0u64,
            ) && self_host_u64_equal(
              source_field.field,
              physical_field.declaration,
            )
            let same_declaration = exact_declaration || (
              source_field.name < self_host_linked_module_name_count(module_) &&
              match self_host_linked_field_name(
                link,
                physical_field.declaration,
              ) {
                Option::Some(destination_name) => self_host_linked_module_name_at(
                  module_,
                  source_field.name,
                ) == destination_name
                Option::None => false
              }
            )
            if !found && !self_host_linked_bool_at(used, source) && same_declaration &&
              self_host_linked_constructor_field_shape_matches(
                link,
                module_,
                body,
                caller_specialization,
                source_field,
                physical_field,
              ) {
              found = true
              self_host_linked_bool_set(used, source, true)
            }
          }
          continue source + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      if !found {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}


fn self_host_linked_infer_constructor_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  nominal: U64,
  fields: SelfHostHirSpan,
) -> Option<U32> {
  if !self_host_u64_equal(nominal, 0u64) {
    for linked_type in link.types {
      let physical_module = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        physical_module,
        linked_type.fragment_index,
      )
      let matches_nominal = match physical.kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmStructType(
          declaration,
        ) => !self_host_u64_equal(declaration, 0u64) && self_host_u64_equal(
          declaration,
          nominal,
        )
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
          declaration,
          variant,
          _,
        ) => (!self_host_u64_equal(declaration, 0u64) && self_host_u64_equal(
          declaration,
          nominal,
        )) || (!self_host_u64_equal(variant, 0u64) && self_host_u64_equal(
          variant,
          nominal,
        ))
        _ => false
      }
      if matches_nominal && self_host_linked_constructor_type_matches(
        link,
        module_,
        body,
        caller_specialization,
        physical_module,
        physical,
        fields,
      ) {
        return Option::Some(linked_type.type_index)
      }
    }
  }
  let mut selected = 4294967295u32
  for linked_type in link.types {
    let physical_module = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      physical_module,
      linked_type.fragment_index,
    )
    if self_host_linked_constructor_type_matches(
      link,
      module_,
      body,
      caller_specialization,
      physical_module,
      physical,
      fields,
    ) {
      if selected != 4294967295u32 && !self_host_u32_equal(
        selected,
        linked_type.type_index,
      ) {
        return Option::None
      }
      selected = linked_type.type_index
    }
  }
  if selected == 4294967295u32 {
    Option::None
  } else {
    Option::Some(selected)
  }
}



fn self_host_linked_physical_function_result_count(
  link: SelfHostPlannedProgramWasmGCLink,
  physical_function_index: U32,
) -> U32 {
  if physical_function_index < 2u32 {
    return 0u32
  }
  let logical = physical_function_index - 2u32
  for function_ in link.functions {
    if self_host_u32_equal(function_.function_index, logical) {
      let module_ = link.fragments.modules[function_.module_index]
      let fragment = self_host_program_link_fragment_function(
        module_,
        function_.fragment_index,
      )
      return fragment.results.length
    }
  }
  0u32
}

fn self_host_linked_schedule_call_result_adapter(
  canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  caller_specialization: U32,
  expression: U32,
  function_index: U32,
  tasks: Array<SelfHostLinkedI32EmitTask>,
  destination: StarshineInstructions,
) -> Unit {
  let carrier = self_host_linked_exact_emitted_expression_carrier(
    canonical,
    link,
    module_,
    body,
    caller_specialization,
    expression,
  )
  let planned = module_.expressions[expression]
  let semantic_result_shape = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    planned.type_,
  )
  if carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier && !planned.flow.falls_through {
    // A zero-result Wasm call does not itself make the caller unreachable.
    // Retain the verified Dew divergence proof after the call instruction.
    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(destination))
    return
  }
  let semantic_result_is_unit = semantic_result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape ||
    planned.shape is SelfHostPlannedValueShape::UnitPlannedValueShape
  if self_host_u32_equal(
    self_host_linked_physical_function_result_count(link, function_index),
    0u32,
  ) && !semantic_result_is_unit && !(carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier) && !(
    carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier
  ) {
    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
  }
}




fn self_host_linked_pattern_name(
  module_: SelfHostPlannedModuleLowering,
  pattern: SelfHostPlannedPattern,
) -> String {
  let mut name = 4294967295u32
  match pattern.source {
    SelfHostHirPattern::QualifiedPattern(_, candidate, _) => {
      name = candidate
    }
    SelfHostHirPattern::TuplePattern(target, _, _) => if target < module_.patterns.length() {
      match self_host_planned_pattern_at(module_.patterns, target).source {
        SelfHostHirPattern::QualifiedPattern(_, candidate, _) => {
          name = candidate
        }
        SelfHostHirPattern::BindingPattern(candidate, _) => {
          name = candidate
        }
        _ => {}
      }
    }
    _ => {}
  }
  if name < self_host_linked_module_name_count(module_) {
    self_host_linked_module_name_at(module_, name)
  } else {
    ""
  }
}



fn self_host_linked_pattern_variant_type(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  pattern: SelfHostPlannedPattern,
  payload_hint: SelfHostPlannedValueShape,
  _subject_nominal: U64,
) -> Option<U32> {
  if pattern.source is SelfHostHirPattern::StructPattern(_, _, _, _, _) {
    match pattern.selected_constructor {
      SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(declaration, variant, _) => {
        // Named fields can belong to a struct or an enum variant. Use the
        // selected constructor kind, not a failed lookup or the source name.
        if !variant {
          return self_host_linked_struct_type_index(link, declaration)
        }
      }
      _ => return Option::None
    }
  }
  let declaration = self_host_pattern_constructor_declaration(module_, pattern)
  self_host_linked_variant_type_index(link, declaration)
}

fn self_host_linked_variant_payload_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> SelfHostPlannedValueShape {
  if expression >= module_.expressions.length() {
    return SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
  let mut source = expression
  let mut depth = 0u32
  let _ = while depth {
    current => if current < 8u32 && source < module_.expressions.length() {
      match module_.expressions[source].kind {
        SelfHostPlannedExpressionKind::PlannedConsumedExpression => if self_host_u32_greater(
          source,
          0u32,
        ) {
          source = self_host_u32_subtract(source, 1u32)
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
        SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => {
          let tail = self_host_body_block_tail_expression(module_, block)
          if self_host_u32_equal(tail, 4294967295u32) {
            break self_host_semantic_unit()
          }
          source = tail
          continue current + 1u32
        }
        SelfHostPlannedExpressionKind::PlannedLocalGet(local) => match self_host_linked_local_source_expression(
          module_,
          body,
          local,
        ) {
          Option::Some(value) => {
            source = value
            continue current + 1u32
          }
          Option::None => break self_host_semantic_unit()
        }
        _ => break self_host_semantic_unit()
      }
    } else {
      break self_host_semantic_unit()
    }
  }
  match module_.expressions[source].kind {
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, base, _) => match self_host_linked_struct_field_for_base(
      link,
      module_,
      body,
      field,
      base,
    ) {
      Option::Some(field_link) => match self_host_linked_physical_field_shape(
        link,
        field_link.type_index,
        field_link.field_index,
      ) {
        Option::Some(shape) => shape
        Option::None => self_host_linked_static_expression_shape(link, module_, source)
      }
      Option::None => self_host_linked_static_expression_shape(link, module_, source)
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => if self_host_linked_expression_is_variant_call(
      link,
      body.body,
      source,
    ) {
      SelfHostPlannedValueShape::RefPlannedValueShape
    } else {
      match self_host_linked_callable_declared_result_shape(
        link,
        declaration,
      ) {
        Option::Some(shape) => shape
        Option::None => self_host_linked_static_expression_shape(link, module_, source)
      }
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(_, _) => match self_host_linked_unresolved_method_call_result_shape(
      link,
      module_,
      body,
      source,
    ) {
      Option::Some(shape) => shape
      Option::None => self_host_linked_static_expression_shape(link, module_, source)
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => if base < module_.expressions.length() &&
      name < self_host_linked_module_name_count(module_) {
      match self_host_linked_field_by_name(
        link,
        self_host_linked_expression_nominal_declaration(
          link,
          module_,
          body,
          base,
        ),
        self_host_linked_module_name_at(module_, name),
      ) {
        Option::Some(field_link) => match self_host_linked_physical_field_shape(
          link,
          field_link.type_index,
          field_link.field_index,
        ) {
          Option::Some(shape) => shape
          Option::None => self_host_linked_static_expression_shape(link, module_, source)
        }
        Option::None => self_host_linked_static_expression_shape(link, module_, source)
      }
    } else {
      self_host_linked_static_expression_shape(link, module_, source)
    }
    _ => self_host_linked_static_expression_shape(link, module_, source)
  }
}







fn self_host_linked_variant_payload_field(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  payload_index: U32,
) -> Option<SelfHostLinkedWasmFieldLink> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.type_index, type_index) {
      let module_ = link.fragments.modules[linked_type.module_index]
      let physical = self_host_linked_physical_type_at(
        module_,
        linked_type.fragment_index,
      )
      let mut index = 0u32
      let _ = while index {
        current => if current < physical.fields.length {
          let field = self_host_linked_physical_field_at(
            module_,
            self_host_u32_add(physical.fields.start, current),
          )
          match field.role {
            SelfHostPlannedWasmFieldRole::WasmVariantPayloadField(
              _,
              source_index,
            ) => if self_host_u32_equal(source_index, payload_index) {
              return Option::Some(SelfHostLinkedWasmFieldLink::{
                type_index: type_index
                field_index: field.physical_index
              })
            }
            _ => {}
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }
  Option::None
}

fn self_host_linked_variant_payload_field_index(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  payload_index: U32,
) -> U32 {
  match self_host_linked_variant_payload_field(
    link,
    type_index,
    payload_index,
  ) {
    Option::Some(field) => field.field_index
    Option::None => payload_index
  }
}





fn self_host_linked_named_field_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.named_fields.length()
}


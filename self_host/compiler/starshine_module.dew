                              link,
                              runtime_name,
                              self_host_linked_array_carrier_from_shape(planned.shape),
                            )
                          } else {
                            -1i32
                          }
                          let runtime_index = if selected_runtime_index < 0i32 &&
                            runtime_name.byte_length() > 0u32 {
                            self_host_linked_runtime_function_index(link, runtime_name)
                          } else {
                            selected_runtime_index
                          }
                          if runtime_index < 0i32 {

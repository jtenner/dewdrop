  caller_specialization: U32,
  physical_module: SelfHostPlannedModuleWasmGCFragments,
  physical: SelfHostPlannedWasmPhysicalType,
  fields: SelfHostHirSpan,
) -> Bool {
  if !self_host_u32_equal(physical.fields.length, fields.length) {

                  link,
                  inferred_owner,
                  self_host_linked_module_name_at(module_, name),
                )
              }
              let planned_field = match inferred_field {
                Option::Some(field_link) => Option::Some(field_link)
                Option::None => match self_host_linked_canonical_field(
                  canonical_body_plan,
                  expression,
                ) {
                  Option::Some(field_link) => Option::Some(field_link)
                  Option::None => {
                    let planned_base = self_host_body_plan_expression_from_optional(
                      canonical_body_plan,
                      base,
                    )
                    let field_name = self_host_linked_module_name_at(module_, name)
                    match planned_base {
                      Option::Some(base_plan) => if base_plan.value.physical_heap_type != 4294967295u32 {
                        match self_host_linked_field_by_type_name(
                          link,
                          base_plan.value.physical_heap_type,
                          field_name,
                        ) {
                          Option::Some(field_link) => Option::Some(field_link)
                          Option::None => self_host_linked_field_by_name(
                            link,
                            base_plan.value.nominal_owner,
                            field_name,
                          )
                        }
                      } else {
                        self_host_linked_field_by_name(
                          link,
                          base_plan.value.nominal_owner,
                          field_name,
                        )
                      }
                      Option::None => Option::None
                    }
                  }
                }
              }
              match planned_field {
                Option::Some(field_link) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                    field_link.type_index,
                    field_link.field_index,
                    destination,
                  ))
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    base,
                    destination,
                    depth,
                  )
                }
                Option::None => {
                  let message = StringBuilder::new()
                  message.append("canonical physical field plan is missing: ")
                  message.append(self_host_linked_module_name_at(module_, name))
                  message.append(" module=")
                  message.append_u64(module_.module_id)
                  message.append(" body=")
                  message.append_u64(body.body)
                  message.append(" declaration=")
                  message.append_u64(body.declaration)
                  message.append(" declaration_name=")
                  message.append(bytes_to_string(self_host_linked_declaration_name(
                    link,
                    body.declaration,
                  )))
                  message.append(" expression=")
                  message.append_u32(expression)
                  message.append(" base=")
                  message.append_u32(base)
                  message.append(" owner=")
                  message.append_u64(self_host_linked_expression_nominal_declaration(
                    link,
                    module_,
                    body,
                    base,
                  ))
                  match self_host_body_plan_expression_from_optional(
                    canonical_body_plan,
                    base,
                  ) {
                    Option::Some(base_plan) => {
                      message.append(" planned_owner=")
                      message.append_u64(base_plan.value.nominal_owner)
                      message.append(" planned_heap=")
                      message.append_u32(base_plan.value.physical_heap_type)
                    }
                    Option::None => {}
                  }
                  match module_.expressions[base].kind {
                    SelfHostPlannedExpressionKind::PlannedLocalGet(local_id) => {
                      message.append(" local=")
                      message.append_u32(local_id)
                      let mut local_offset = 0u32
                      let _ = while local_offset {
                        current => if current < body.locals.length {
                          let local_index = self_host_u32_add(
                            body.locals.start,
                            current,
                          )
                          if local_index < module_.locals.length() && self_host_u32_equal(
                            self_host_body_planned_local_identity(module_.locals[local_index]).local_id,
                            local_id,
                          ) {
                            message.append(" local_type=")
                            message.append_i32(self_host_body_planned_local_identity(module_.locals[local_index]).type_)
                            message.append(" local_nominal=")
                            message.append_u64(self_host_body_planned_local_identity(module_.locals[local_index]).nominal)
                            let local_type = self_host_body_planned_local_identity(module_.locals[local_index]).type_
                            if local_type >= 0i32 && self_host_i32_to_u32(local_type) < module_.inferred.types.length() {
                              match module_.inferred.types[
                                self_host_i32_to_u32(local_type)
                              ] {
                                SelfHostBodyTypeTerm::BodyResolvedType(value) => {
                                  message.append(" resolved=")
                                  message.append_u32(value)
                                }
                                SelfHostBodyTypeTerm::BodyVariableType(value) => {
                                  message.append(" variable=")
                                  message.append_u32(value)
                                }
                                SelfHostBodyTypeTerm::BodyAppliedType(value, arguments) => {
                                  message.append(" applied=")
                                  message.append_i32(value)
                                  message.append(" arguments=")
                                  message.append_u32(arguments.start)
                                  message.append(":")
                                  message.append_u32(arguments.length)
                                }
                                _ => {}
                              }
                            }
                            match self_host_linked_local_initializer_expression(
                              module_,
                              body,
                              local_id,
                            ) {
                              Option::Some(initializer) => {
                                message.append(" initializer=")
                                message.append_u32(initializer)
                              }
                              Option::None => {}
                            }
                            let mut match_offset = 0u32
                            let _ = while match_offset {
                              match_current => if match_current < body.expressions.length {
                                let match_expression = self_host_u32_add(
                                  body.expressions.start,
                                  match_current,
                                )
                                match module_.expressions[match_expression].kind {
                                  SelfHostPlannedExpressionKind::PlannedMatchExpression(
                                    subject,
                                    arms,
                                  ) => {
                                    let mut arm = 0u32
                                    let _ = while arm {
                                      arm_current => if arm_current < arms.length {
                                        let arm_child = self_host_u32_add(
                                          arms.start,
                                          arm_current,
                                        )
                                        if arm_child < module_.arm_children.length() {
                                          let arm_index = module_.arm_children[arm_child]
                                          if arm_index < module_.pattern_arms.length() && self_host_linked_pattern_binds_local(
                                            module_,
                                            self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern,
                                            local_id,
                                          ) {
                                            message.append(" match_subject=")
                                            message.append_u32(subject)
                                            message.append(" pattern=")
                                            message.append(self_host_linked_pattern_name(
                                              module_,
                                              module_.patterns[
                                                self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index).pattern
                                              ],
                                            ))
                                            if subject < module_.expressions.length() {
                                              match module_.expressions[subject].kind {
                                                SelfHostPlannedExpressionKind::PlannedDirectCall(
                                                  declaration,
                                                  _,
                                                  _,
                                                  _,
                                                ) => {
                                                  message.append(" declaration=")
                                                  message.append_u64(declaration)
                                                  match self_host_program_specialization_callable(
                                                    module_,
                                                    declaration,
                                                  ) {
                                                    Option::Some(callable) => {
                                                      message.append(" result_type=")
                                                      message.append_u32(callable.result_type)
                                                      message.append(" result_arg_owner=")
                                                      message.append_u64(self_host_body_resolved_type_argument_nominal_owner(
                                                        module_,
                                                        callable.result_type,
                                                        0u32,
                                                      ))
                                                    }
                                                    Option::None => {}
                                                  }
                                                }
                                                _ => {}
                                              }
                                            }
                                          }
                                        }
                                        continue arm_current + 1u32
                                      } else {
                                        break self_host_semantic_unit()
                                      }
                                    }
                                  }
                                  _ => {}
                                }
                                continue match_current + 1u32
                              } else {
                                break self_host_semantic_unit()
                              }
                            }
                            break self_host_semantic_unit()
                          }
                          continue current + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                    }
                    _ => {}
                  }
                  return Option::Some(message.finish())
                }
              }
            }
            SelfHostPlannedExpressionKind::PlannedProductField(
              base,
              field,
              count,
            ) => {
              if field >= count {
                return Option::Some("linked tuple field is outside its product")
              }
              if planned.shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
                // Unbox the Unit marker without exposing a stack operand.
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination))
              }
              if self_host_u32_equal(count, 2u32) {
                let pair_type = match self_host_linked_pair_type_for_match_result(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  base,
                ) {
                  Option::Some(type_index) => Option::Some(type_index)
                  Option::None => match self_host_linked_pair_type_for_projection(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    base,
                  ) {
                    Option::Some(type_index) => Option::Some(type_index)
                    Option::None => self_host_linked_pair_type_for_expression(
                      link,
                      module_,
                      body,
                      base,
                    )
                  }
                }
                match pair_type {
                  Option::Some(type_index) => {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                      type_index,
                      field,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      base,
                      destination,
                      depth,
                    )
                  }
                  Option::None => {
                    let message = StringBuilder::new()
                    message.append("linked tuple projection has no pair type module=")
                    message.append_u64(module_.module_id)
                    message.append(" declaration=")
                    message.append_u64(body.declaration)
                    message.append(" name=")
                    message.append(bytes_to_string(self_host_linked_declaration_name(
                      link,
                      body.declaration,
                    )))
                    message.append(" body=")
                    message.append_u64(body.body)
                    message.append(" expression=")
                    message.append_u32(expression)
                    message.append(" base=")
                    message.append_u32(base)
                    message.append(" field=")
                    message.append_u32(field)
                    message.append(" count=")
                    message.append_u32(count)
                    if base < module_.expressions.length() {
                      message.append(" base_type=")
                      message.append_i32(self_host_planned_expression_at(module_.expressions, base).type_)
                      message.append(" base_nominal=")
                      message.append_u64(module_.expressions[base].nominal)
                      message.append(" base_source_name=")
                      message.append_u32(module_.expressions[base].source_name)
                      if self_host_u32_greater(
                        module_.names.length(),
                        module_.expressions[base].source_name,
                      ) {
                        message.append(":")
                        message.append(module_.names[
                          module_.expressions[base].source_name
                        ])
                      }
                    }
                    return Option::Some(message.finish())
                  }
                }
              } else if self_host_u32_greater(count, 1u32) {
                let target_pair = if self_host_u32_equal(
                  self_host_u32_add(field, 1u32),
                  count,
                ) {
                  self_host_u32_subtract(count, 2u32)
                } else {
                  field
                }
                let target_field = if self_host_u32_equal(
                  self_host_u32_add(field, 1u32),
                  count,
                ) {
                  1u32
                } else {
                  0u32
                }
                let target_type = match self_host_linked_product_pair_type_for_projection(
                  link,
                  module_,
                  body,
                  caller_specialization,
                  base,
                  count,
                  target_pair,
                ) {
                  Option::Some(type_index) => type_index
                  Option::None => {
                    return Option::Some("linked tuple projection has no nested pair type")
                  }
                }
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                  target_type,
                  target_field,
                  destination,
                ))
                let mut pair = target_pair
                let _ = while pair {
                  current_pair => if self_host_u32_greater(current_pair, 0u32) {
                    let previous = self_host_u32_subtract(current_pair, 1u32)
                    let pair_type = match self_host_linked_product_pair_type_for_projection(
                      link,
                      module_,
                      body,
                      caller_specialization,
                      base,
                      count,
                      previous,
                    ) {
                      Option::Some(type_index) => type_index
                      Option::None => {
                        return Option::Some("linked tuple traversal has no pair type")
                      }
                    }
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
                      pair_type,
                      1u32,
                      destination,
                    ))
                    continue previous
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              } else {
                self_host_linked_i32_schedule_expression(
                  tasks,
                  expression_depths,
                  base,
                  destination,
                  depth,
                )
              }
            }
            SelfHostPlannedExpressionKind::PlannedIndexGet(
              _,
              _,
              target,
            ) => {
              let declaration = match target {
                SelfHostBasicCallTarget::SelectedBasicCallTarget(value, _) => value
                _ => return Option::Some("BOD-607 index read has no selected declaration")
              }
              let function_index = match self_host_linked_canonical_call_index(
                canonical_body_plan,
                link,
                body,
                caller_specialization,
                expression,
                declaration,
              ) {
                Option::Some(value) => value
                Option::None => return Option::Some("BOD-607 index read has no frozen target")
              }
              // The frozen recipe contains the receiver and index, in source
              // order. An indexed trait method is an ordinary call.
              let arguments = SelfHostHirSpan::{
                start: 0u32
                length: 0u32
              }
              match self_host_linked_schedule_frozen_call(
                canonical_body_plan, link, module_, body, caller_specialization,
                expression, function_index, arguments, destination, tasks,
                expression_depths, depth,
              ) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
            }
            SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => {
              return Option::Some("linked local writes are not emitted yet")
            }
            SelfHostPlannedExpressionKind::PlannedCaptureSet(capture, value) => {
              let plan = match canonical_body_plan {
                Option::Some(value) => value
                Option::None => return Option::Some("capture write has no frozen body plan")
              }
              if self_host_capture_write_is_erased(link, plan, capture) {
                self_host_linked_i32_schedule_expression(tasks, expression_depths, value, destination, depth)
              } else {
              let cell = match self_host_capture_write_type(link, plan, capture) {
                Option::Some(value) => value
                Option::None => return Option::Some("capture write has no mutable physical cell")
              }
              match self_host_emit_capture_get(link, plan, capture, false, destination) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
              StarshineFfi.ffi_ffi_bridge_instructions_push(destination,
                StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(self_host_u32_to_i32(cell)),
              )
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructSet(cell, 0u32, destination))
              self_host_linked_i32_schedule_expression(tasks, expression_depths, value, destination, depth)
              }
            }
            SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, target) => {
              let function_index = match target {
                SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => match self_host_linked_canonical_call_index(
                  canonical_body_plan, link, body, caller_specialization, expression, declaration,
                ) {
                  Option::Some(value) => value
                  Option::None => return Option::Some("BOD-607 index write has no frozen target")
                }
                _ => return Option::Some("BOD-607 index write has no declaration")
              }
              match self_host_linked_schedule_frozen_call(
                canonical_body_plan, link, module_, body, caller_specialization,
                expression, function_index, SelfHostHirSpan::{
                  start: 0u32
                  length: 0u32
                }, destination, tasks, expression_depths, depth,
              ) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
            }
            _ => {
              return Option::Some("linked expression is outside the current emitter subset")
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_sub(),
          )
          SelfHostHirPrefixOperator::LogicalNot => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i32_eqz(),
          )
          SelfHostHirPrefixOperator::Positive => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_i64_sub(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f32_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Prefix(
          operator,
          destination,
        ) => match operator {
          SelfHostHirPrefixOperator::Negative => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_f64_neg(),
          )
          _ => {}
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i32_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Option::Some("linked I32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
          operator,
          unsigned_,
          destination,
        ) => if !self_host_emit_linked_i64_binary(
          destination,
          operator,
          unsigned_,
        ) {
          return Option::Some("linked I64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f32_binary(destination, operator) {
          return Option::Some("linked F32 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
          operator,
          destination,
        ) => if !self_host_emit_linked_f64_binary(destination, operator) {
          return Option::Some("linked F64 binary operator is unsupported")
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRefBinary(
          operator,
          destination,
        ) => match operator {
          SelfHostHirBinaryOperator::Equal => StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_ref_eq(),
          )
          SelfHostHirBinaryOperator::NotEqual => {
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_ref_eq(),
            )
            StarshineFfi.ffi_ffi_bridge_instructions_push(
              destination,
              StarshineFfi.ffi_lib_Instruction_i32_eqz(),
            )
          }
          _ => {
            return Option::Some("linked reference binary operator is unsupported")
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedProductField(
          field,
          count,
          scratch,
          destination,
        ) => {
          if field >= count {
            return Option::Some("linked tuple field is outside its product")
          }
          let mut position = count
          let _ = while position {
            current => if self_host_u32_greater(current, 0u32) {
              let previous = current - 1u32
              if self_host_u32_equal(previous, field) {
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_local_set(
                    StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                  ),
                )
              } else {
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_drop(),
                )
              }
              continue previous
            } else {
              break self_host_semantic_unit()
            }
          }
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_lib_Instruction_local_get(
              StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
            ),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedLocalGet(
          local,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_local_get(
            StarshineFfi.ffi_lib_LocalIdx_new(local.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_ref_null(
            StarshineFfi.ffi_lib_HeapType_abs(
              StarshineFfi.ffi_lib_AbsHeapType_eq(),
            ),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructNew(
          type_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_new(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructGet(
          type_index,
          field_index,
          destination,
        ) => {
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
              self_host_u32_to_i32(type_index),
            ),
          )
          StarshineFfi.ffi_ffi_bridge_instructions_push(
            destination,
            self_host_linked_struct_get_instruction(link, type_index, field_index),
          )
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRawStructGet(type_index, field_index, destination) => {
          self_host_emit_raw_struct_get(type_index, field_index, destination)
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRawRefCast(type_index, destination) => {
          self_host_emit_raw_ref_cast(type_index, destination)
        }
        SelfHostLinkedI32EmitTask::EmitLinkedRefCast(
          type_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
            self_host_u32_to_i32(type_index),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedStructSet(
          type_index,
          field_index,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_struct_set(
            StarshineFfi.ffi_lib_TypeIdx_new(type_index.into()),
            field_index.into(),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedBuiltin(
          name,
          destination,
        ) => if !self_host_emit_linked_builtin(name, destination) {
          return Option::Some(bytes_to_string(name))
        }
        SelfHostLinkedI32EmitTask::EmitLinkedConversion(
          source,
          target,
          destination,
        ) => if !self_host_emit_linked_conversion(
          source,
          target,
          destination,
        ) {
          let message = StringBuilder::new()
          message.append("linked conversion shapes are unsupported: ")
          message.append(self_host_linked_shape_name(source))
          message.append(" -> ")
          message.append(self_host_linked_shape_name(target))
          return Option::Some(message.finish())
        }
        SelfHostLinkedI32EmitTask::EmitLinkedArrayNew(
          array_type,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_array_new(
            StarshineFfi.ffi_lib_TypeIdx_new(array_type.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedArrayNewDefault(array_type, destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,

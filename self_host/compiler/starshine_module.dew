          let arm_source = self_host_planned_pattern_arm_at(module_.pattern_arms, arm_index)
          let arm_body = arm_source.body
          if arm_source.flow.falls_through && arm_body < module_.expressions.length() &&
            module_.expressions[arm_body].flow.falls_through {
            let shape = match module_.expressions[arm_body].kind {
              SelfHostPlannedExpressionKind::PlannedLocalGet(local) => {
                let expected_arm_shape = self_host_linked_expression_expected_shape(
                  link,
                  module_,

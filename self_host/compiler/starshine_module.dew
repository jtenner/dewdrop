              condition_ready = true
            }
            SelfHostHirPattern::ProductPattern(children, _) => {
              if children.length == 0u32 {
                catch_all = true
              } else {
                variant_type = match self_host_product_pattern_type(link, pattern) {
                  Option::Some(value) => value
                  Option::None => return Option::Some("product pattern has no exact physical type")
                }
                StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_lib_Instruction_local_get(StarshineFfi.ffi_lib_LocalIdx_new(scratch.into())))
                StarshineFfi.ffi_ffi_bridge_instructions_push(destination, StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(self_host_u32_to_i32(variant_type)))
                condition_ready = true
              }
            }
            SelfHostHirPattern::TuplePattern(_, _, _) => match self_host_linked_pattern_variant_type(
              link,
              module_,
              pattern,
              canonical_payload_hint,
              subject_nominal,
            ) {
              Option::Some(type_index) => {
                variant_type = type_index
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_local_get(
                    StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                  ),
                )
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(
                    self_host_u32_to_i32(type_index),
                  ),
                )
                condition_ready = true
              }
              Option::None => {
                let message = StringBuilder::new()
                message.append("linked payload pattern has no variant type module=")
                message.append_u64(module_.module_id)
                message.append(" declaration=")
                message.append_u64(body.declaration)
                message.append(" name=")
                message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                message.append(" body=")
                message.append_u64(body.body)
                message.append(" subject=")
                message.append_u32(subject)
                if subject < module_.expressions.length() {
                  message.append(":")
                  message.append(self_host_body_expression_kind_name(module_.expressions[subject].kind))
                  message.append(":type=")
                  message.append_i32(self_host_planned_expression_at(module_.expressions, subject).type_)
                }
                message.append(" subject_nominal=")
                message.append_u64(subject_nominal)
                message.append(":")
                message.append(bytes_to_string(self_host_linked_declaration_name(
                  link,
                  subject_nominal,
                )))
                if subject < module_.expressions.length() {
                  match module_.expressions[subject].kind {
                    SelfHostPlannedExpressionKind::PlannedDirectCall(
                      declaration,
                      target,
                      arguments,
                      _,
                    ) => {
                      message.append(" direct=")
                      message.append_u64(declaration)
                      message.append(":")
                      message.append(bytes_to_string(self_host_linked_declaration_name(
                        link,
                        declaration,
                      )))
                      message.append(":target=")
                      message.append_u32(target)
                      if target < module_.expressions.length() {
                        message.append(":")
                        message.append(self_host_body_expression_kind_name(module_.expressions[target].kind))
                        if module_.expressions[target].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression &&
                          self_host_u32_greater(target, 0u32) {
                          message.append(":previous=")
                          message.append_u32(self_host_u32_subtract(target, 1u32))
                          message.append(":")
                          message.append(self_host_body_expression_kind_name(module_.expressions[
                            self_host_u32_subtract(target, 1u32)
                          ].kind))
                        }
                      }
                      message.append(":arguments=")
                      message.append_u32(arguments.length)
                    }
                    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
                      message.append(" target=")
                      message.append_u32(target)
                      message.append(":")
                      message.append(self_host_body_expression_kind_name(module_.expressions[target].kind))
                      match module_.expressions[target].kind {
                        SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, name) => {
                          message.append(":base=")
                          message.append_u32(base)
                          if base < module_.expressions.length() {
                            message.append(":")
                            message.append(self_host_body_expression_kind_name(module_.expressions[base].kind))
                          }
                          message.append(":method=")
                          if name < self_host_linked_module_name_count(module_) {
                            message.append(self_host_linked_module_name_at(module_, name))
                          } else {
                            message.append("invalid")
                          }
                          message.append(":element_nominal=")
                          message.append_u64(self_host_linked_expression_container_element_nominal_declaration(
                            link,
                            module_,
                            body,
                            base,
                          ))
                        }
                        _ => {}
                      }
                    }
                    _ => {}
                  }
                }
                message.append(" pattern=")
                message.append_u32(arm.pattern)
                message.append(":")
                let missing_pattern_name = self_host_linked_pattern_name(module_, pattern)
                message.append(missing_pattern_name)
                message.append(":declaration=")
                message.append_u64(self_host_pattern_constructor_declaration(module_, pattern))
                return Option::Some(message.finish())
              }
            }
            _ => {
              return Option::Some("linked pattern kind is unsupported")
            }
          }
          if condition_ready && variant_type != 4294967295u32 {
            match self_host_emit_nested_pattern_tests(link, canonical_body_plan, module_, pattern, variant_type, scratch, [], destination) {
              Option::Some(error) => return Option::Some(error)
              Option::None => {}
            }
          }
          if catch_all && self_host_u32_equal(
            arm.guard_condition,
            4294967295u32,
          ) {
            if result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
              self_host_linked_i32_schedule_discarded_expression(
                tasks,
                expression_depths,
                arm.body,
                destination,
                depth,
              )
            } else {
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                arm.body,
                destination,
                depth,
              )
            }
          } else {
            let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
            let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
            let guarded_pattern = !catch_all && arm.guard_condition != 4294967295u32
            let binding_destination = if guarded_pattern {
              StarshineFfi.ffi_ffi_bridge_instructions_new()
            } else {
              consequent
            }
            tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
              destination,
              consequent,
              alternative,
              result_shape,
            ))
            if !self_host_u32_equal(variant_type, 4294967295u32) {
              match self_host_emit_nested_pattern_bindings(link, module_, body, canonical_body_plan, pattern, variant_type, scratch, [], binding_destination, false) {
                Option::Some(error) => return Option::Some(error)
                Option::None => {}
              }
              match pattern.source {
                SelfHostHirPattern::TuplePattern(_, children, _) => {
                  let mut child_offset = 0u32
                  let _ = while child_offset {
                    current_child => if current_child < children.length {
                      let physical_child = self_host_linked_variant_payload_field_index(
                        link,
                        variant_type,
                        current_child,
                      )
                      let child_index = self_host_u32_add(
                        children.start,
                        current_child,
                      )
                      if child_index < module_.pattern_children.length() {
                        let child_pattern_index = module_.pattern_children[
                          child_index
                        ]
                        if child_pattern_index < module_.patterns.length() {
                          let child_pattern = module_.patterns[
                            child_pattern_index
                          ]
                          match child_pattern.reference {
                            SelfHostBodyPatternReference::PatternBindingReference(
                              local,
                            ) => match self_host_linked_i32_local_slot(
                              canonical_body_plan,
                              module_,
                              body,
                              local,
                            ) {
                              Option::Some(slot) => {
                                if self_host_linked_expression_wraps_local(
                                  module_,
                                  arm.body,
                                  local,
                                ) {
                                  match self_host_linked_physical_field_shape(
                                        link,
                                        variant_type,
                                        physical_child,
                                      ) {
                                    Option::Some(field_shape) => if !(
                                      logical_result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                                    ) && !(logical_result_shape is SelfHostPlannedValueShape::NeverPlannedValueShape) &&
                                      self_host_linked_array_carrier_from_shape(field_shape) !=
                                        self_host_linked_array_carrier_from_shape(logical_result_shape) &&
                                      !(self_host_linked_pattern_payload_box_type(link, variant_type, physical_child, self_host_body_carrier_from_shape(logical_result_shape)) is Option::Some(_)) {
                                      let message = StringBuilder::new()
                                      message.append("linked binding match payload/result invariant failed module=")
                                      message.append_u64(module_.module_id)
                                      message.append(" declaration=")
                                      message.append_u64(body.declaration)
                                      message.append(" name=")
                                      message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                                      message.append(" body=")
                                      message.append_u64(body.body)
                                      message.append(" subject=")
                                      message.append_u32(subject)
                                      message.append(" pattern=")
                                      message.append_u32(arm.pattern)
                                      message.append(":")
                                      message.append(self_host_linked_pattern_name(module_, pattern))
                                      message.append(" field=")
                                      message.append_u32(current_child)
                                      message.append(" local=")
                                      message.append_u32(local)
                                      message.append(" expected=")
                                      message.append(self_host_linked_shape_name(logical_result_shape))
                                      message.append(" actual=")
                                      message.append(self_host_linked_shape_name(field_shape))
                                      return Option::Some(message.finish())
                                    }
                                    Option::None => {}
                                  }
                                }
                                match canonical_body_plan {
                                  Option::Some(plan) => {
                                    let local_plan_slot = self_host_body_local_slot(
                                      module_,
                                      body,
                                      local,
                                    )
                                    if local_plan_slot < plan.local_values.length() {
                                      let expected = plan.local_values[local_plan_slot].carrier
                                      let actual = match self_host_linked_physical_field_shape(
                                        link,
                                        variant_type,
                                        physical_child,
                                      ) {
                                        Option::Some(shape) => self_host_body_carrier_from_shape(shape)
                                        Option::None => SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                                      }
                                      if !(expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier) && !(
                                        actual is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier
                                      ) && !self_host_body_carrier_equal(expected, actual) &&
                                        !(self_host_linked_pattern_payload_box_type(link, variant_type, physical_child, expected) is Option::Some(_)) {
                                        let message = StringBuilder::new()
                                        message.append("linked pattern payload store invariant failed module=")
                                        message.append_u64(module_.module_id)
                                        message.append(" declaration=")
                                        message.append_u64(body.declaration)
                                        message.append(" name=")
                                        message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                                        message.append(" body=")
                                        message.append_u64(body.body)
                                        message.append(" subject=")
                                        message.append_u32(subject)
                                        message.append(" pattern=")
                                        message.append_u32(arm.pattern)
                                        message.append(":")
                                        message.append(self_host_linked_pattern_name(module_, pattern))
                                        message.append(" field=")
                                        message.append_u32(current_child)
                                        message.append(" local=")
                                        message.append_u32(local)
                                        message.append(" expected=")
                                        message.append(self_host_linked_shape_name(
                                          self_host_body_carrier_shape(expected),
                                        ))
                                        message.append(" actual=")
                                        message.append(self_host_linked_shape_name(
                                          self_host_body_carrier_shape(actual),
                                        ))
                                        return Option::Some(message.finish())
                                      }
                                    }
                                  }
                                  Option::None => {}
                                }
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  binding_destination,
                                  StarshineFfi.ffi_lib_Instruction_local_get(
                                    StarshineFfi.ffi_lib_LocalIdx_new(
                                      scratch.into(),
                                    ),
                                  ),
                                )
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  binding_destination,
                                  StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
                                    self_host_u32_to_i32(variant_type),
                                  ),
                                )
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  binding_destination,
                                  self_host_linked_struct_get_instruction(link, variant_type, physical_child),
                                )
                                self_host_emit_pattern_payload_unbox(link, variant_type, physical_child,
                                  self_host_linked_canonical_local_carrier(canonical_body_plan, module_, body, local), binding_destination)
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  binding_destination,
                                  StarshineFfi.ffi_lib_Instruction_local_set(
                                    StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                                  ),
                                )
                              }
                              Option::None => {
                                match canonical_body_plan {
                                  Option::Some(plan) => {
                                    let local_slot = self_host_body_local_slot(module_, body, local)
                                    if local_slot < plan.local_values.length() &&
                                      plan.local_values[local_slot].carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier &&
                                      self_host_unit_pattern_binding_has_storage(link, module_, plan.specialization,
                                        pattern, child_pattern, variant_type, physical_child) {
                                      // A declared Unit payload has a checked storage marker,
                                      // but no local.get/struct.get/local.set stack operand.
                                      continue current_child + 1u32
                                    }
                                  }
                                  Option::None => {}
                                }
                                return Option::Some("linked tuple pattern binding has no local")
                              }
                            }
                            _ => {}
                          }
                        }
                      }
                      continue current_child + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            let next_arm = self_host_u32_add(arm_offset, 1u32)
            if next_arm < arms.length {
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                subject,
                next_arm,
                scratch,
                alternative,
                self_host_u32_add(depth, 1u32),
                result_shape,
                payload_hint,
                logical_result_shape,
              ))
            } else {
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                alternative,
                StarshineFfi.ffi_lib_Instruction_unreachable_(),
              )
            }
            if result_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
              self_host_linked_i32_schedule_discarded_expression(
                tasks,
                expression_depths,
                arm.body,
                consequent,
                self_host_u32_add(depth, 1u32),
              )
            } else {
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                arm.body,
                consequent,
                self_host_u32_add(depth, 1u32),
              )
            }
            if guarded_pattern {
              // A guard runs only after the complete pattern matched and its
              // locals were bound. Keep one shared next-arm path, so a chain
              // of guarded arms grows linearly rather than duplicating tails.
              let guard_false = StarshineFfi.ffi_ffi_bridge_instructions_new()
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                guard_false,
                StarshineFfi.ffi_lib_Instruction_i32_const(StarshineFfi.ffi_lib_I32_new(0i32)),
              )
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
                destination, binding_destination, guard_false,
                SelfHostPlannedValueShape::I32PlannedValueShape,
              ))
              self_host_linked_i32_schedule_expression(
                tasks, expression_depths, arm.guard_condition,
                binding_destination, self_host_u32_add(depth, 1u32),
              )
            }
            if catch_all {
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                arm.guard_condition,
                destination,
                depth,
              )
            } else if !condition_ready {

              if self_host_linked_expression_is_string_constant(
                module_,
                body,
                condition,
              ) {
                let function_index = match canonical_body_plan {
                  Option::Some(plan) => self_host_emitted_string_pattern_target(link, plan, module_, arm.pattern, condition)
                  Option::None => return Option::Some("BOD-610 String pattern has no physical body plan")
                }
                tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Call(
                  function_index,
                  destination,
                ))
              } else {
                let condition_shape = self_host_linked_call_argument_shape(
                  link,
                  canonical_body_plan,
                  module_,
                  body,
                  caller_specialization,
                  condition,
                )
                let subject_shape = match self_host_linked_canonical_expression_shape(
                  canonical_body_plan,
                  subject,
                ) {
                  Option::Some(shape) => shape
                  Option::None => self_host_linked_backend_expression_shape(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    subject,
                  )
                }
                if !(condition_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) && !(
                  subject_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape
                ) && self_host_linked_array_carrier_from_shape(condition_shape) !=
                  self_host_linked_array_carrier_from_shape(subject_shape) {
                  let message = StringBuilder::new()
                  message.append("linked literal match carrier invariant failed module=")
                  message.append_u64(module_.module_id)
                  message.append(" declaration=")
                  message.append_u64(body.declaration)
                  message.append(" name=")
                  message.append(bytes_to_string(self_host_linked_declaration_name(link, body.declaration)))
                  message.append(" body=")
                  message.append_u64(body.body)
                  message.append(" subject=")
                  message.append_u32(subject)
                  message.append(" condition=")
                  message.append_u32(condition)
                  message.append(" subject_shape=")
                  message.append(self_host_linked_shape_name(subject_shape))
                  message.append(" condition_shape=")
                  message.append(self_host_linked_shape_name(condition_shape))
                  return Option::Some(message.finish())
                }
                let comparison_shape = if condition_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape {
                  subject_shape
                } else {
                  condition_shape
                }
                match self_host_physical_scalar_shape(comparison_shape) {
                  SelfHostPlannedValueShape::I64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedI64Binary(
                      SelfHostHirBinaryOperator::Equal,
                      comparison_shape is SelfHostPlannedValueShape::U64PlannedValueShape,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F32PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF32Binary(
                      SelfHostHirBinaryOperator::Equal,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::F64PlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedF64Binary(
                      SelfHostHirBinaryOperator::Equal,
                      destination,
                    ),
                  )
                  SelfHostPlannedValueShape::RefPlannedValueShape => tasks.push(
                    SelfHostLinkedI32EmitTask::EmitLinkedRefBinary(
                      SelfHostHirBinaryOperator::Equal,
                      destination,
                    ),
                  )
                  _ => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                    SelfHostHirBinaryOperator::Equal,
                    self_host_linked_i32_unsigned_shape(comparison_shape),
                    destination,
                  ))
                }
              }
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                condition,
                destination,
                depth,
              )
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_local_get(
                  StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                ),
              )
            }
          }
        }
        SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
          block_index,
          destination,
          discard_final,
        ) => {
          if block_index >= module_.blocks.length() {
            return Option::Some("linked I32 block is outside its arena")
          }
          let block = module_.blocks[block_index]
          let depth = if block_index < block_depths.length() && !self_host_u32_equal(
            block_depths[block_index],
            4294967295u32,
          ) {
            block_depths[block_index]
          } else {
            0u32
          }
          let mut item = block.items.length
          let _ = while item {
            current => if self_host_u32_greater(current, 0u32) {
              let previous = current - 1u32
              let item_index = self_host_u32_add(block.items.start, previous)
              if item_index >= module_.block_items.length() {
                return Option::Some("linked I32 block item is outside its arena")
              }
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(local, _, value) => if self_host_linked_local_is_erased(canonical_body_plan, module_, body, local) || !self_host_linked_local_is_read(
                  module_,
                  body,
                  local,
                ) {
                  self_host_linked_i32_schedule_discarded_expression(
                    tasks,
                    expression_depths,
                    value,
                    destination,
                    depth,
                  )
                } else {
                  match self_host_linked_i32_local_slot(
                    canonical_body_plan,
                    module_,
                    body,
                    local,
                  ) {
                    Option::Some(slot) => {
                      match self_host_linked_local_capture_cell(link, canonical_body_plan, module_, body, local) {
                        Option::Some(cell) => {
                          tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(cell.local_slot, destination))
                          tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(cell.type_index, destination))
                        }
                        Option::None => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(slot, destination))
                      }
                      self_host_linked_i32_schedule_expression(
                        tasks,
                        expression_depths,
                        value,
                        destination,
                        depth,
                      )
                    }
                    Option::None => {
                      return Option::Some("linked I32 let has no physical slot")
                    }
                  }
                }
                SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => {
                  let nonfinal = !self_host_u32_equal(
                    previous,
                    self_host_u32_subtract(block.items.length, 1u32),
                  )
                  let value_required = self_host_linked_expression_is_pattern_arm_body(
                    module_,
                    body,
                    value,
                  )
                  let discarded_use = (nonfinal || discard_final) && !value_required
                  if discarded_use {
                    self_host_linked_i32_schedule_discarded_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                  } else {
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                  }
                }
              }
              continue previous
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
          slot,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_local_set(
            StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Return(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_return_(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_drop(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_unreachable_(),
        )
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_eqref_value_type() -> StarshineValue {
  StarshineFfi.ffi_lib_ValType_ref_null(
    StarshineFfi.ffi_lib_HeapType_abs(
      StarshineFfi.ffi_lib_AbsHeapType_eq(),
    ),
  )
}

fn self_host_linked_funcref_value_type() -> StarshineValue {
  StarshineFfi.ffi_lib_ValType_ref_null(
    StarshineFfi.ffi_lib_HeapType_abs(
      StarshineFfi.ffi_lib_AbsHeapType_func(),
    ),
  )
}


fn self_host_linked_physical_type_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.physical_types.length()
}

fn self_host_linked_physical_type_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmPhysicalType {
  module_.physical_types[index]
}

fn self_host_linked_physical_field_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.fields.length()
}

fn self_host_linked_physical_field_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmField {
  module_.fields[index]
}

fn self_host_linked_fragment_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
  fragment_index: U32,
) -> Option<U32> {
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, module_index) &&
      self_host_u32_equal(linked_type.fragment_index, fragment_index) {
      return Option::Some(linked_type.type_index)
    }
  }
  Option::None
}

fn self_host_linked_enum_base_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(candidate) => if self_host_u64_equal(
        candidate,
        declaration,
      ) {
        return Option::Some(linked_type.type_index)
      }
      _ => {}
    }
  }
  Option::None
}

fn self_host_linked_enum_marker_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  variant: U64,
) -> Option<U32> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumMarkerType(
        candidate_declaration,
        candidate_variant,
        _,
        _,
      ) => if self_host_u64_equal(candidate_declaration, declaration) &&
        self_host_u64_equal(candidate_variant, variant) {
        return Option::Some(linked_type.type_index)
      }
      _ => {}
    }
  }
  Option::None
}


fn self_host_linked_lowering_module_at(
  link: SelfHostPlannedProgramWasmGCLink,
  index: U32,
) -> SelfHostPlannedModuleLowering {
  link.fragments.specialization.lowering.modules[index]
}

fn self_host_linked_expression_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.expressions.length()
}

fn self_host_linked_expression_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedExpression {
  module_.expressions[index]
}

fn self_host_linked_resolved_type_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.resolved_types.types.length()
}

fn self_host_linked_resolved_type_argument_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.resolved_types.type_arguments.length()
}

fn self_host_linked_resolved_type_argument_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> U32 {
  module_.resolved_types.type_arguments[index]
}

fn self_host_linked_module_index_by_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_id: U64,
) -> Option<U32> {
  let modules = link.fragments.specialization.lowering.modules
  let mut index = 0u32
  let _ = while index {
    current => if current < modules.length() {
      if self_host_u64_equal(modules[current].module_id, module_id) {
        return Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_lambda_position(
  module_: SelfHostPlannedModuleLowering,
  lambda_id: U32,
) -> Option<U32> {
  let mut index = 0u32
  let _ = while index {
    current => if current < module_.lambdas.length() {
      if self_host_u32_equal(module_.lambdas[current].lambda, lambda_id) {
        return Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}



fn self_host_linked_lambda_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
  lambda_position: U32,
  specialization: U32,
) -> Option<U32> {
  let module_ = self_host_linked_lowering_module_at(link, module_index)
  if lambda_position >= module_.lambdas.length() {
    return Option::None
  }
  let lambda = module_.lambdas[lambda_position]
  let fragment_module = self_host_body_fragment_module(link, module_index)
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, module_index) {
      match fragment_module.physical_types[linked_type.fragment_index].kind {
        SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(id, request) => {
          if self_host_u32_equal(id, lambda.lambda) && self_host_u32_equal(request, specialization) {
            return Option::Some(linked_type.type_index)
          }
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_lambda_function_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
  lambda_id: U32,
  specialization: U32,
) -> Option<U32> {
  for linked_function in link.functions {
    if self_host_u32_equal(linked_function.module_index, module_index) && self_host_u32_equal(linked_function.specialization, specialization) {
      let fragment_module = link.fragments.modules[module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        linked_function.fragment_index,
      )
      match fragment.kind {
        SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
          candidate,
        ) => if self_host_u32_equal(candidate, lambda_id) {
          return Option::Some(
            self_host_linked_physical_function_index(
              linked_function.function_index,
            ),
          )
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_closure_base_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
) -> Option<U32> {
  let fragment_module = link.fragments.modules[module_index]
  if self_host_u32_equal(fragment_module.closure_type_index, 4294967295u32) {
    return Option::None
  }
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, module_index) &&
      self_host_u32_equal(
        linked_type.fragment_index,
        fragment_module.closure_type_index,
      ) {
      return Option::Some(linked_type.type_index)
    }
  }
  Option::None
}

fn self_host_linked_append_physical_types(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRecTypes,
) -> Option<String> {
  let mut emitted_type_index = 0u32
  for linked_type in link.types {
    if !self_host_u32_equal(linked_type.type_index, emitted_type_index) {
      let message = StringBuilder::new()
      message.append("linked physical type order mismatch expected=")
      message.append_u32(emitted_type_index)
      message.append(" actual=")
      message.append_u32(linked_type.type_index)
      return Option::Some(message.finish())
    }
    emitted_type_index = self_host_u32_add(emitted_type_index, 1u32)
    let fragment_module = link.fragments.modules[linked_type.module_index]
    if !self_host_u32_greater(
      self_host_linked_physical_type_count(fragment_module),
      linked_type.fragment_index,
    ) {
      return Option::Some("linked physical type is outside its arena")
    }
    let physical = self_host_linked_physical_type_at(
      fragment_module,
      linked_type.fragment_index,
    )
    let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
    let mut field = 0u32
    let _ = while field {
      current => if current < physical.fields.length {
        let source_index = self_host_u32_add(physical.fields.start, current)
        if !self_host_u32_greater(
          self_host_linked_physical_field_count(fragment_module),
          source_index,
        ) {
          return Option::Some("linked physical field is outside its arena")
        }
        let source = self_host_linked_physical_field_at(
          fragment_module,
          source_index,
        )
        match source.role {
          SelfHostPlannedWasmFieldRole::WasmStructField(field_declaration) => match self_host_linked_declared_field_shape(
            link,
            field_declaration,
          ) {
            Option::Some(expected) => if !self_host_linked_field_storage_matches_shape(
              link,
              field_declaration,
              source.storage,
              expected,
            ) {
              let message = StringBuilder::new()
              message.append("linked type emission field carrier mismatch type=")
              message.append_u32(linked_type.type_index)
              message.append(" field=")
              message.append_u64(field_declaration)
              message.append(" expected=")
              message.append(self_host_program_representation_shape_name(expected))
              message.append(" actual=")
              message.append(self_host_program_representation_shape_name(
                self_host_program_representation_storage_shape(source.storage),
              ))
              return Option::Some(message.finish())
            }
            Option::None => {}
          }
          _ => {}
        }
        let is_variant_payload = match source.role {
          SelfHostPlannedWasmFieldRole::WasmVariantPayloadField(_, _) => true
          _ => false
        }
        let value_type = if is_variant_payload && source.exact_nominal &&
          source.storage is SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage {
          let nominal = self_host_linked_field_value_nominal_declaration(
            link,
            SelfHostLinkedWasmFieldLink::{
              type_index: linked_type.type_index
              field_index: source.physical_index
            },
          )
          match self_host_linked_nominal_field_type_index(
            link,
            nominal,
            source.exact_nominal,
          ) {
            Option::Some(type_index) => if type_index < linked_type.type_index {
              self_host_linked_nominal_ref_type(type_index)
            } else {
              self_host_linked_eqref_value_type()
            }
            Option::None => self_host_linked_eqref_value_type()
          }
        } else {
          let storage_code = self_host_program_representation_storage_code(
            source.storage,
          )
          if storage_code == 1i32 {
            StarshineFfi.ffi_lib_ValType_i64()
          } else if storage_code == 2i32 {
            StarshineFfi.ffi_lib_ValType_f32()
          } else if storage_code == 3i32 {
            StarshineFfi.ffi_lib_ValType_f64()
          } else if storage_code == 4i32 {
            StarshineFfi.ffi_lib_ValType_v128()
          } else if storage_code == 5i32 {
            self_host_linked_eqref_value_type()
          } else if storage_code == 6i32 {
            self_host_linked_funcref_value_type()
          } else {
            StarshineFfi.ffi_lib_ValType_i32()
          }
        }
        let mutable_ = if source.mutable_ {
          StarshineFfi.ffi_lib_Mut_var_()
        } else {
          StarshineFfi.ffi_lib_Mut_const_()
        }
        StarshineFfi.ffi_ffi_bridge_field_types_push(
          fields,
          StarshineFfi.ffi_lib_FieldType_new(
            self_host_field_storage_type(source.storage, value_type),
            mutable_,
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let component = StarshineFfi.ffi_lib_CompType_struct_(fields)
    let subtype = match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(_) => {
        let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
        StarshineFfi.ffi_lib_SubType_new(
          0i32,
          supers,
          component,
          wasm_ref_null(),
        )
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmClosureType => {
        let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
        StarshineFfi.ffi_lib_SubType_new(
          0i32,
          supers,
          component,
          wasm_ref_null(),
        )
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(_, _) => match self_host_linked_closure_base_type_index(
        link,
        linked_type.module_index,
      ) {
        Option::Some(base) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(base.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            1i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Option::Some("linked lambda closure has no closure base type")
        }
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumMarkerType(
        _,
        _,
        _,
        super_fragment,
      ) => match self_host_linked_fragment_type_index(
        link,
        linked_type.module_index,
        super_fragment,
      ) {
        Option::Some(super_type) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(super_type.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            0i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Option::Some("linked enum marker has no super type")
        }
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        variant,
        _,
      ) => match self_host_linked_enum_marker_type_index(
        link,
        declaration,
        variant,
      ) {
        Option::Some(base) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(base.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            1i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Option::Some("linked enum subtype has no marker type")
        }
      }
      _ => StarshineFfi.ffi_lib_SubType_comp_type(
        component,
        wasm_ref_null(),
      )
    }
    StarshineFfi.ffi_ffi_bridge_rec_types_push(
      rec_types,
      StarshineFfi.ffi_lib_RecType_new(subtype),
    )
  }
  Option::None
}

fn self_host_linked_wasm_value_shape(
  value: SelfHostPlannedWasmValueType,
) -> SelfHostPlannedValueShape {
  match value {
    SelfHostPlannedWasmValueType::WasmI32Value => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedWasmValueType::WasmI64Value => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedWasmValueType::WasmF32Value => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedWasmValueType::WasmF64Value => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedWasmValueType::WasmV128Value => SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedWasmValueType::WasmNullableFuncRefValue => SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_linked_resolved_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return Option::None
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::AppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      argument,
    ) && self_host_u32_add(
      arguments.start,
      argument,
    ) < self_host_linked_resolved_type_argument_count(module_) {
      Option::Some(
        self_host_planned_resolved_value_shape(
          module_.resolved_types,
          self_host_linked_resolved_type_argument_at(
            module_,
            self_host_u32_add(arguments.start, argument),
          ),
        ),
      )
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_resolved_nested_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  outer_argument: U32,
  inner_argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return Option::None
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::AppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      outer_argument,
    ) && self_host_u32_add(arguments.start, outer_argument) <
      self_host_linked_resolved_type_argument_count(module_) {
      self_host_linked_resolved_type_argument_shape(
        module_,
        self_host_linked_resolved_type_argument_at(
          module_,
          self_host_u32_add(arguments.start, outer_argument),
        ),
        inner_argument,
      )
    } else {
      Option::None
    }
    _ => Option::None
  }
}


fn self_host_linked_resolved_nominal_declaration(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
) -> U64 {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return 0u64
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::NominalType(declaration) => declaration
    SelfHostResolvedType::AppliedType(base, _) => self_host_linked_resolved_nominal_declaration(
      module_,
      base,
    )
    _ => 0u64
  }
}

fn self_host_linked_type_nominal_declaration(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> U64 {
  let exact_inferred = self_host_merged_module_inference_identity(
    module_.inferred,
  )
  if type_ < -1i32 {
    return self_host_linked_resolved_nominal_declaration(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
    )
  }
  if type_ < 0i32 {
    return 0u64
  }
  let index = self_host_i32_to_u32(type_)
  if index >= exact_inferred.types.length() {
    return 0u64
  }
  match exact_inferred.types[index] {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => self_host_linked_resolved_nominal_declaration(
      module_,
      resolved,
    )
    SelfHostBodyTypeTerm::BodyAppliedType(base, _) => self_host_linked_type_nominal_declaration(
      module_,
      base,
    )
    _ => 0u64
  }
}

fn self_host_linked_type_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> U64 {
  let declaration = self_host_linked_type_nominal_declaration(module_, type_)
  if self_host_u64_equal(declaration, 0u64) {
    return 0u64
  }
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => link.fragments.specialization.lowering.modules[
      owner
    ].module_id
    Option::None => 0u64
  }
}


fn self_host_linked_callable_declared_result_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<SelfHostPlannedValueShape> {
  for module_ in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        module_,
      ) {
        let callable = self_host_program_specialization_callable_at(
          module_,
          current,
        )
        if self_host_u64_equal(callable.declaration, declaration) {
          if !(callable.result_shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(callable.result_shape)
          }
          let shape = self_host_planned_resolved_value_shape(
            module_.resolved_types,
            callable.result_type,
          )
          if !(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
            return Option::Some(shape)
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  Option::None
}

fn self_host_linked_callable_result_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => {
          let nominal = self_host_linked_resolved_nominal_declaration(
            module_,
            callable.result_type,
          )
          return nominal
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
  for module_ in link.fragments.specialization.lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        module_,
      ) {
        let callable = self_host_program_specialization_callable_at(
          module_,
          current,
        )
        if self_host_u64_equal(callable.declaration, declaration) {
          let nominal = self_host_linked_resolved_nominal_declaration(
            module_,
            callable.result_type,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            return nominal
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  for module_ in link.fragments.specialization.lowering.modules {
    for callable in module_.functions.callables {
      if self_host_u64_equal(callable.declaration, declaration) {
        let nominal = self_host_linked_resolved_nominal_declaration(
          module_,
          callable.result_type,
        )
        if !self_host_u64_equal(nominal, 0u64) {
          return nominal
        }
      }
    }
  }
  0u64
}

fn self_host_linked_callable_result_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => self_host_linked_type_owner_module_id(
          link,
          module_,
          -self_host_u32_to_i32(callable.result_type) - 2i32,
        )
        Option::None => 0u64
      }
    }
    Option::None => 0u64
  }
}

fn self_host_linked_callable_result_argument_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => match self_host_linked_resolved_type_argument_shape(
          module_,
          callable.result_type,
          argument,
        ) {
          Option::Some(shape) => return Option::Some(shape)
          Option::None => {}
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
  for module_ in link.fragments.specialization.lowering.modules {
    match self_host_program_specialization_callable(module_, declaration) {
      Option::Some(callable) => match self_host_linked_resolved_type_argument_shape(
        module_,
        callable.result_type,
        argument,
      ) {
        Option::Some(shape) => return Option::Some(shape)
        Option::None => {}
      }
      Option::None => {}
    }
    for callable in module_.functions.callables {
      if self_host_u64_equal(callable.declaration, declaration) {
        match self_host_linked_resolved_type_argument_shape(
          module_,
          callable.result_type,
          argument,
        ) {
          Option::Some(shape) => return Option::Some(shape)
          Option::None => {}
        }
      }
    }
  }
  Option::None
}


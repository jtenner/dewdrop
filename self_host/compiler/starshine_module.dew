                }
                SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => {
                  return Result::Err("linked unresolved lambda call target")
                }
                SelfHostPlannedExpressionKind::PlannedProductField(_, _, _) => {
                  return Result::Err("linked unresolved product-field call target")
                }
                SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, _) => {
                  return Result::Err("linked unresolved index-read call target")
                }
                SelfHostPlannedExpressionKind::PlannedFieldGet(_, _, _) => {
                  return Result::Err("linked unresolved selected-field call target")
                }
                SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => {
                  return Result::Err("linked unresolved direct-call call target")
                }
                SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => {
                  return Result::Err("linked unresolved builtin-call call target")
                }
                SelfHostPlannedExpressionKind::PlannedConsumedExpression => {
                  return Result::Err("linked unresolved consumed call target")
                }
                SelfHostPlannedExpressionKind::PlannedPoisonExpression => {
                  match self_host_linked_i32_call_index(
                    link,

        SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
          arms,
          arm_offset,
          scratch,
          destination,
          depth,
          result_shape,
          payload_hint,
        ) => {
          if arm_offset >= arms.length {
            return Result::Err("linked I32 match has no remaining arm")
          }
          let child_index = self_host_u32_add(arms.start, arm_offset)
          if child_index >= module_.arm_children.length() {
            return Result::Err("linked I32 match arm is outside its child arena")
          }
          let arm_index = module_.arm_children[child_index]
          if arm_index >= module_.pattern_arms.length() {
            return Result::Err("linked I32 match arm is outside its arena")
          }
          let arm = module_.pattern_arms[arm_index]
          if !self_host_u32_greater(
            module_.patterns.length(),
            arm.pattern,
          ) {
            return Result::Err("linked I32 match pattern is outside its arena")
          }
          let pattern = module_.patterns[arm.pattern]
          let subject_nominal = if self_host_u32_greater(
            pattern_subject_nominals.length(),
            arm.pattern,
          ) {
            pattern_subject_nominals[arm.pattern]
          } else {
            0u64
          }
          let mut condition = 4294967295u32
          let mut condition_ready = false
          let mut variant_type = 4294967295u32
          let mut catch_all = false
          match pattern.source {
            SelfHostHirPattern::WildcardPattern(_) => {
              catch_all = true
            }
            SelfHostHirPattern::BindingPattern(_, _) => {
              catch_all = true
              match pattern.reference {
                SelfHostBodyPatternReference::PatternBindingReference(local) => match self_host_linked_i32_local_slot(
                  module_,
                  body,
                  local,
                ) {
                  Option::Some(slot) => {
                    StarshineFfi.ffi_ffi_bridge_instructions_push(
                      destination,
                      StarshineFfi.ffi_lib_Instruction_local_get(
                        StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                      ),
                    )
                    StarshineFfi.ffi_ffi_bridge_instructions_push(
                      destination,
                      StarshineFfi.ffi_lib_Instruction_local_set(
                        StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                      ),
                    )
                  }
                  Option::None => {
                    return Result::Err("linked I32 pattern binding has no physical slot")
                  }
                }
                _ => {
                  return Result::Err("linked I32 binding pattern has no local")
                }
              }
            }
            SelfHostHirPattern::LiteralPattern(expression, _) => {
              condition = expression
            }
            SelfHostHirPattern::QualifiedPattern(_, _, _) => match self_host_linked_pattern_variant_type(
              link,
              module_,
              pattern,
              payload_hint,
              subject_nominal,
            ) {
              Option::Some(type_index) => {
                variant_type = type_index
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_local_get(
                    StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                  ),
                )
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(
                    self_host_u32_to_i32(type_index),
                  ),
                )
                condition_ready = true
              }
              Option::None => {
                return Result::Err("linked qualified pattern has no variant type")
              }
            }
            SelfHostHirPattern::TuplePattern(_, _, _) => match self_host_linked_pattern_variant_type(
              link,
              module_,
              pattern,
              payload_hint,
              subject_nominal,
            ) {
              Option::Some(type_index) => {
                variant_type = type_index
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_lib_Instruction_local_get(
                    StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                  ),
                )
                StarshineFfi.ffi_ffi_bridge_instructions_push(
                  destination,
                  StarshineFfi.ffi_ffi_bridge_instruction_ref_test_nominal(
                    self_host_u32_to_i32(type_index),
                  ),
                )
                condition_ready = true
              }
              Option::None => {
                let message = StringBuilder::new()
                message.append("linked payload pattern has no variant type: ")
                message.append(self_host_linked_pattern_name(module_, pattern))
                return Result::Err(message.finish())
              }
            }
            _ => {
              return Result::Err("linked pattern kind is unsupported")
            }
          }
          if catch_all && self_host_u32_equal(
            arm.guard_condition,
            4294967295u32,
          ) {
            self_host_linked_i32_schedule_expression(
              tasks,
              expression_depths,
              arm.body,
              destination,
              depth,
            )
          } else {
            let consequent = StarshineFfi.ffi_ffi_bridge_instructions_new()
            let alternative = StarshineFfi.ffi_ffi_bridge_instructions_new()
            tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32If(
              destination,
              consequent,
              alternative,
              result_shape,
            ))
            if !self_host_u32_equal(variant_type, 4294967295u32) {
              match pattern.source {
                SelfHostHirPattern::TuplePattern(_, children, _) => {
                  let mut child_offset = 0u32
                  let _ = while child_offset {
                    current_child => if current_child < children.length {
                      let child_index = self_host_u32_add(
                        children.start,
                        current_child,
                      )
                      if child_index < module_.pattern_children.length() {
                        let child_pattern_index = module_.pattern_children[
                          child_index
                        ]
                        if child_pattern_index < module_.patterns.length() {
                          let child_pattern = module_.patterns[
                            child_pattern_index
                          ]
                          match child_pattern.reference {
                            SelfHostBodyPatternReference::PatternBindingReference(
                              local,
                            ) => match self_host_linked_i32_local_slot(
                              module_,
                              body,
                              local,
                            ) {
                              Option::Some(slot) => {
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  consequent,
                                  StarshineFfi.ffi_lib_Instruction_local_get(
                                    StarshineFfi.ffi_lib_LocalIdx_new(
                                      scratch.into(),
                                    ),
                                  ),
                                )
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  consequent,
                                  StarshineFfi.ffi_ffi_bridge_instruction_ref_cast_nominal(
                                    self_host_u32_to_i32(variant_type),
                                  ),
                                )
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  consequent,
                                  StarshineFfi.ffi_lib_Instruction_struct_get(
                                    StarshineFfi.ffi_lib_TypeIdx_new(
                                      self_host_u32_to_i32(variant_type),
                                    ),
                                    self_host_u32_to_i32(current_child),
                                  ),
                                )
                                StarshineFfi.ffi_ffi_bridge_instructions_push(
                                  consequent,
                                  StarshineFfi.ffi_lib_Instruction_local_set(
                                    StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
                                  ),
                                )
                              }
                              Option::None => {
                                return Result::Err("linked tuple pattern binding has no local")
                              }
                            }
                            _ => {}
                          }
                        }
                      }
                      continue current_child + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
                _ => {}
              }
            }
            let next_arm = self_host_u32_add(arm_offset, 1u32)
            if next_arm < arms.length {
              tasks.push(SelfHostLinkedI32EmitTask::VisitLinkedI32MatchArms(
                arms,
                next_arm,
                scratch,
                alternative,
                self_host_u32_add(depth, 1u32),
                result_shape,
                payload_hint,
              ))
            } else {
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                alternative,
                StarshineFfi.ffi_lib_Instruction_unreachable_(),
              )
            }
            self_host_linked_i32_schedule_expression(
              tasks,
              expression_depths,
              arm.body,
              consequent,
              self_host_u32_add(depth, 1u32),
            )
            if catch_all {
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                arm.guard_condition,
                destination,
                depth,
              )
            } else if !condition_ready {
              if !self_host_u32_equal(
                arm.guard_condition,
                4294967295u32,
              ) {
                return Result::Err("linked literal match guards are not emitted yet")
              }
              tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Binary(
                SelfHostHirBinaryOperator::Equal,
                false,
                destination,
              ))
              self_host_linked_i32_schedule_expression(
                tasks,
                expression_depths,
                condition,
                destination,
                depth,
              )
              StarshineFfi.ffi_ffi_bridge_instructions_push(
                destination,
                StarshineFfi.ffi_lib_Instruction_local_get(
                  StarshineFfi.ffi_lib_LocalIdx_new(scratch.into()),
                ),
              )
            }
          }
        }
        SelfHostLinkedI32EmitTask::VisitLinkedI32Block(
          block_index,
          destination,
        ) => {
          if block_index >= module_.blocks.length() {
            return Result::Err("linked I32 block is outside its arena")
          }
          let block = module_.blocks[block_index]
          let depth = if block_index < block_depths.length() && !self_host_u32_equal(
            block_depths[block_index],
            4294967295u32,
          ) {
            block_depths[block_index]
          } else {
            0u32
          }
          let mut item = block.items.length
          let _ = while item {
            current => if self_host_u32_greater(current, 0u32) {
              let previous = current - 1u32
              let item_index = self_host_u32_add(block.items.start, previous)
              if item_index >= module_.block_items.length() {
                return Result::Err("linked I32 block item is outside its arena")
              }
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(local, _, value) => match self_host_linked_i32_local_slot(
                  module_,
                  body,
                  local,
                ) {
                  Option::Some(slot) => {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
                      slot,
                      destination,
                    ))
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                  }
                  Option::None => {
                    return Result::Err("linked I32 let has no physical slot")
                  }
                }
                SelfHostPlannedBlockItemKind::PlannedReturnItem(value) => {
                  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Return(
                    destination,
                  ))
                  if !self_host_u32_equal(value, 4294967295u32) {
                    self_host_linked_i32_schedule_expression(
                      tasks,
                      expression_depths,
                      value,
                      destination,
                      depth,
                    )
                  }
                }
                SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => {
                  if !self_host_u32_equal(
                    previous,
                    self_host_u32_subtract(block.items.length, 1u32),
                  ) && self_host_linked_expression_emits_value(
                    link,
                    module_,
                    body,
                    caller_specialization,
                    value,
                  ) {
                    tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(
                      destination,
                    ))
                  }
                  self_host_linked_i32_schedule_expression(
                    tasks,
                    expression_depths,
                    value,
                    destination,
                    depth,
                  )
                }
              }
              continue previous
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        SelfHostLinkedI32EmitTask::EmitLinkedI32LocalSet(
          slot,
          destination,
        ) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_local_set(
            StarshineFfi.ffi_lib_LocalIdx_new(slot.into()),
          ),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Return(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_return_(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedI32Drop(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_drop(),
        )
        SelfHostLinkedI32EmitTask::EmitLinkedUnreachable(destination) => StarshineFfi.ffi_ffi_bridge_instructions_push(
          destination,
          StarshineFfi.ffi_lib_Instruction_unreachable_(),
        )
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_linked_eqref_value_type() -> StarshineRef0 {
  StarshineFfi.ffi_lib_ValType_ref_null(
    StarshineFfi.ffi_lib_HeapType_abs(
      StarshineFfi.ffi_lib_AbsHeapType_eq(),
    ),
  )
}

fn self_host_linked_funcref_value_type() -> StarshineRef0 {
  StarshineFfi.ffi_lib_ValType_ref_null(
    StarshineFfi.ffi_lib_HeapType_abs(
      StarshineFfi.ffi_lib_AbsHeapType_func(),
    ),
  )
}

fn self_host_linked_scalar_storage_value_type(
  storage: SelfHostPlannedWasmStorageType,
) -> Option<StarshineRef0> {
  match storage {
    SelfHostPlannedWasmStorageType::WasmI32Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_i32(),
    )
    SelfHostPlannedWasmStorageType::WasmI64Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_i64(),
    )
    SelfHostPlannedWasmStorageType::WasmF32Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_f32(),
    )
    SelfHostPlannedWasmStorageType::WasmF64Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_f64(),
    )
    SelfHostPlannedWasmStorageType::WasmV128Storage => Option::Some(
      StarshineFfi.ffi_lib_ValType_v128(),
    )
    SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage => Option::Some(
      self_host_linked_eqref_value_type(),
    )
    SelfHostPlannedWasmStorageType::WasmNullableFuncRefStorage => Option::Some(
      self_host_linked_funcref_value_type(),
    )
  }
}

fn self_host_linked_physical_type_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.physical_types.length()
}

fn self_host_linked_physical_type_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmPhysicalType {
  module_.physical_types[index]
}

fn self_host_linked_physical_field_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.fields.length()
}

fn self_host_linked_physical_field_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> SelfHostPlannedWasmField {
  module_.fields[index]
}

fn self_host_linked_enum_base_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<U32> {
  for linked_type in link.types {
    let module_ = link.fragments.modules[linked_type.module_index]
    let physical = self_host_linked_physical_type_at(
      module_,
      linked_type.fragment_index,
    )
    match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(candidate) => if self_host_u64_equal(
        candidate,
        declaration,
      ) {
        return Option::Some(linked_type.type_index)
      }
      _ => {}
    }
  }
  Option::None
}

fn self_host_linked_lowering_module_count(
  link: SelfHostPlannedProgramWasmGCLink,
) -> U32 {
  link.fragments.specialization.lowering.modules.length()
}

fn self_host_linked_lowering_module_at(
  link: SelfHostPlannedProgramWasmGCLink,
  index: U32,
) -> SelfHostPlannedModuleLowering {
  link.fragments.specialization.lowering.modules[index]
}

fn self_host_linked_expression_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.expressions.length()
}

fn self_host_linked_expression_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedExpression {
  module_.expressions[index]
}

fn self_host_linked_resolved_type_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.resolved_types.types.length()
}

fn self_host_linked_resolved_type_argument_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.resolved_types.type_arguments.length()
}

fn self_host_linked_resolved_type_argument_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> U32 {
  module_.resolved_types.type_arguments[index]
}

fn self_host_linked_module_index_by_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_id: U64,
) -> Option<U32> {
  let modules = link.fragments.specialization.lowering.modules
  let mut index = 0u32
  let _ = while index {
    current => if current < modules.length() {
      if self_host_u64_equal(modules[current].module_id, module_id) {
        return Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_lambda_position(
  module_: SelfHostPlannedModuleLowering,
  lambda_id: U32,
) -> Option<U32> {
  let mut index = 0u32
  let _ = while index {
    current => if current < module_.lambdas.length() {
      if self_host_u32_equal(module_.lambdas[current].lambda, lambda_id) {
        return Option::Some(current)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_lambda_closure_type_count(
  module_: SelfHostPlannedModuleWasmGCFragments,
) -> U32 {
  module_.lambda_closure_type_indices.length()
}

fn self_host_linked_lambda_closure_type_at(
  module_: SelfHostPlannedModuleWasmGCFragments,
  index: U32,
) -> U32 {
  module_.lambda_closure_type_indices[index]
}

fn self_host_linked_lambda_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
  lambda_position: U32,
) -> Option<U32> {
  let fragment_module = link.fragments.modules[module_index]
  if lambda_position >= self_host_linked_lambda_closure_type_count(
    fragment_module,
  ) {
    return Option::None
  }
  let fragment_index = self_host_linked_lambda_closure_type_at(
    fragment_module,
    lambda_position,
  )
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, module_index) &&
      self_host_u32_equal(linked_type.fragment_index, fragment_index) {
      return Option::Some(linked_type.type_index)
    }
  }
  Option::None
}

fn self_host_linked_lambda_function_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
  lambda_id: U32,
) -> Option<U32> {
  for linked_function in link.functions {
    if self_host_u32_equal(linked_function.module_index, module_index) {
      let fragment_module = link.fragments.modules[module_index]
      let fragment = self_host_program_link_fragment_function(
        fragment_module,
        linked_function.fragment_index,
      )
      match fragment.kind {
        SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(
          candidate,
        ) => if self_host_u32_equal(candidate, lambda_id) {
          return Option::Some(
            self_host_linked_physical_function_index(
              linked_function.function_index,
            ),
          )
        }
        _ => {}
      }
    }
  }
  Option::None
}

fn self_host_linked_closure_base_type_index(
  link: SelfHostPlannedProgramWasmGCLink,
  module_index: U32,
) -> Option<U32> {
  let fragment_module = link.fragments.modules[module_index]
  if self_host_u32_equal(fragment_module.closure_type_index, 4294967295u32) {
    return Option::None
  }
  for linked_type in link.types {
    if self_host_u32_equal(linked_type.module_index, module_index) &&
      self_host_u32_equal(
        linked_type.fragment_index,
        fragment_module.closure_type_index,
      ) {
      return Option::Some(linked_type.type_index)
    }
  }
  Option::None
}

fn self_host_linked_append_physical_types(
  link: SelfHostPlannedProgramWasmGCLink,
  rec_types: StarshineRef33,
) -> Result<Unit, String> {
  for linked_type in link.types {
    let fragment_module = link.fragments.modules[linked_type.module_index]
    if !self_host_u32_greater(
      self_host_linked_physical_type_count(fragment_module),
      linked_type.fragment_index,
    ) {
      return Result::Err("linked physical type is outside its arena")
    }
    let physical = self_host_linked_physical_type_at(
      fragment_module,
      linked_type.fragment_index,
    )
    let fields = StarshineFfi.ffi_ffi_bridge_field_types_new()
    let mut field = 0u32
    let _ = while field {
      current => if current < physical.fields.length {
        let source_index = self_host_u32_add(physical.fields.start, current)
        if !self_host_u32_greater(
          self_host_linked_physical_field_count(fragment_module),
          source_index,
        ) {
          return Result::Err("linked physical field is outside its arena")
        }
        let source = self_host_linked_physical_field_at(
          fragment_module,
          source_index,
        )
        let value_type = match self_host_linked_scalar_storage_value_type(
          source.storage,
        ) {
          Option::Some(value) => value
          Option::None => {
            return Result::Err("linked reference field type is not emitted yet")
          }
        }
        let mutable_ = if source.mutable_ {
          StarshineFfi.ffi_lib_Mut_var_()
        } else {
          StarshineFfi.ffi_lib_Mut_const_()
        }
        StarshineFfi.ffi_ffi_bridge_field_types_push(
          fields,
          StarshineFfi.ffi_lib_FieldType_new(
            StarshineFfi.ffi_lib_StorageType_val_type(value_type),
            mutable_,
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let component = StarshineFfi.ffi_lib_CompType_struct_(fields)
    let subtype = match physical.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumBaseType(_) => {
        let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
        StarshineFfi.ffi_lib_SubType_new(
          0i32,
          supers,
          component,
          wasm_ref_null(),
        )
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmClosureType => {
        let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
        StarshineFfi.ffi_lib_SubType_new(
          0i32,
          supers,
          component,
          wasm_ref_null(),
        )
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(_) => match self_host_linked_closure_base_type_index(
        link,
        linked_type.module_index,
      ) {
        Option::Some(base) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(base.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            1i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Result::Err("linked lambda closure has no closure base type")
        }
      }
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmEnumSubtypeType(
        declaration,
        _,
        _,
      ) => match self_host_linked_enum_base_type_index(link, declaration) {
        Option::Some(base) => {
          let supers = StarshineFfi.ffi_ffi_bridge_type_indices_new()
          StarshineFfi.ffi_ffi_bridge_type_indices_push(
            supers,
            StarshineFfi.ffi_lib_TypeIdx_new(base.into()),
          )
          StarshineFfi.ffi_lib_SubType_new(
            1i32,
            supers,
            component,
            wasm_ref_null(),
          )
        }
        Option::None => {
          return Result::Err("linked enum subtype has no base type")
        }
      }
      _ => StarshineFfi.ffi_lib_SubType_comp_type(
        component,
        wasm_ref_null(),
      )
    }
    StarshineFfi.ffi_ffi_bridge_rec_types_push(
      rec_types,
      StarshineFfi.ffi_lib_RecType_new(subtype),
    )
  }
  Result::Ok(self_host_semantic_unit())
}

fn self_host_linked_wasm_value_shape(
  value: SelfHostPlannedWasmValueType,
) -> SelfHostPlannedValueShape {
  match value {
    SelfHostPlannedWasmValueType::WasmI32Value => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedWasmValueType::WasmI64Value => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedWasmValueType::WasmF32Value => SelfHostPlannedValueShape::F32PlannedValueShape
    SelfHostPlannedWasmValueType::WasmF64Value => SelfHostPlannedValueShape::F64PlannedValueShape
    SelfHostPlannedWasmValueType::WasmV128Value => SelfHostPlannedValueShape::V128PlannedValueShape
    SelfHostPlannedWasmValueType::WasmNullableEqRefValue => SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_linked_resolved_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return Option::None
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::AppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      argument,
    ) && self_host_u32_add(
      arguments.start,
      argument,
    ) < self_host_linked_resolved_type_argument_count(module_) {
      Option::Some(
        self_host_planned_resolved_value_shape(
          module_.resolved_types,
          self_host_linked_resolved_type_argument_at(
            module_,
            self_host_u32_add(arguments.start, argument),
          ),
        ),
      )
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_linked_resolved_first_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
) -> Option<SelfHostPlannedValueShape> {
  self_host_linked_resolved_type_argument_shape(module_, resolved_type, 0u32)
}

fn self_host_linked_resolved_nominal_declaration(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
) -> U64 {
  if resolved_type >= self_host_linked_resolved_type_count(module_) {
    return 0u64
  }
  match module_.resolved_types.type_at(resolved_type) {
    SelfHostResolvedType::NominalType(declaration) => declaration
    SelfHostResolvedType::AppliedType(base, _) => self_host_linked_resolved_nominal_declaration(
      module_,
      base,
    )
    _ => 0u64
  }
}

fn self_host_linked_type_nominal_declaration(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> U64 {
  if type_ < -1i32 {
    return self_host_linked_resolved_nominal_declaration(
      module_,
      self_host_i32_to_u32(-type_ - 2i32),
    )
  }
  if type_ < 0i32 {
    return 0u64
  }
  let index = self_host_i32_to_u32(type_)
  if index >= module_.inferred.types.length() {
    return 0u64
  }
  match module_.inferred.types[index] {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => self_host_linked_resolved_nominal_declaration(
      module_,
      resolved,
    )
    SelfHostBodyTypeTerm::BodyAppliedType(base, _) => self_host_linked_type_nominal_declaration(
      module_,
      base,
    )
    _ => 0u64
  }
}

fn self_host_linked_type_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> U64 {
  let declaration = self_host_linked_type_nominal_declaration(module_, type_)
  if self_host_u64_equal(declaration, 0u64) {
    return 0u64
  }
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => link.fragments.specialization.lowering.modules[
      owner
    ].module_id
    Option::None => 0u64
  }
}

fn self_host_linked_callable_result_nominal_declaration(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => self_host_linked_resolved_nominal_declaration(
          module_,
          callable.result_type,
        )
        Option::None => 0u64
      }
    }
    Option::None => 0u64
  }
}

fn self_host_linked_callable_result_owner_module_id(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> U64 {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => self_host_linked_type_owner_module_id(
          link,
          module_,
          -self_host_u32_to_i32(callable.result_type) - 2i32,
        )
        Option::None => 0u64
      }
    }
    Option::None => 0u64
  }
}

fn self_host_linked_callable_result_element_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  declaration: U64,
) -> Option<SelfHostPlannedValueShape> {
  match link.fragments.specialization.lowering.index.declaration_owner(
    declaration,
  ) {
    Option::Some(owner) => {
      let module_ = link.fragments.specialization.lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => self_host_linked_resolved_first_type_argument_shape(
          module_,
          callable.result_type,
        )
        Option::None => Option::None
      }
    }
    Option::None => Option::None
  }
}

fn self_host_linked_local_initializer_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(candidate, local_id) {
                  return Option::Some(value)
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_assignment_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedLocalSet(candidate, value) => if self_host_u32_equal(
          candidate,
          local_id,
        ) {
          return Option::Some(value)
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_source_expression(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<U32> {
  match self_host_linked_local_initializer_expression(
    module_,
    body,
    local_id,
  ) {
    Option::Some(value) => Option::Some(value)
    Option::None => self_host_linked_local_assignment_expression(
      module_,
      body,
      local_id,
    )
  }
}

fn self_host_linked_runtime_reference_constructor(
  module_: SelfHostPlannedModuleLowering,
  expression: U32,
) -> Bool {
  if expression >= module_.expressions.length() {
    return false
  }
  let planned = module_.expressions[expression]
  if !self_host_u32_greater(
    self_host_linked_module_name_count(module_),
    planned.source_name,
  ) {
    return false
  }
  let name = self_host_linked_module_name_at(module_, planned.source_name)
  if name != "Some" && name != "None" && name != "Ok" && name != "Err" {
    return false
  }
  true
}

fn self_host_linked_local_match_subject_reference_shape(
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  local_id: U32,
) -> Option<SelfHostPlannedValueShape> {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let expression = self_host_u32_add(body.expressions.start, current)
      match module_.expressions[expression].kind {
        SelfHostPlannedExpressionKind::PlannedMatchExpression(subject, arms) => if subject < module_.expressions.length() {
          match module_.expressions[subject].kind {
            SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
              candidate,
              local_id,
            ) {
              let mut arm = 0u32
              let _ = while arm {
                position => if position < arms.length {
                  let child = self_host_u32_add(arms.start, position)
                  if child < module_.arm_children.length() {
                    let arm_index = module_.arm_children[child]
                    if arm_index < module_.pattern_arms.length() {
                      let pattern_index = module_.pattern_arms[arm_index].pattern
                      if pattern_index < module_.patterns.length() {
                        let name = self_host_linked_pattern_name(
                          module_,
                          module_.patterns[pattern_index],
                        )
                        if name == "Some" || name == "None" || name == "Ok" || name == "Err" {
                          return Option::Some(
                            SelfHostPlannedValueShape::RefPlannedValueShape,
                          )
                        }
                      }
                    }
                  }
                  continue position + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_linked_local_runtime_reference_shape(

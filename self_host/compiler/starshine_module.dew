  let index = self_host_i32_to_u32(type_)
  if index >= exact_inferred.types.length() {
    return Option::None
  }
  match exact_inferred.types[index] {
    SelfHostBodyTypeTerm::BodyAppliedType(_, arguments) => if self_host_u32_greater(
      arguments.length,
      outer_argument,
    ) && self_host_u32_add(arguments.start, outer_argument) <
      exact_inferred.type_arguments.length() {
      self_host_linked_type_argument_shape(

open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

pub struct SelfHostCompileTimeBindings {
  parameters: Map<U64, SelfHostCompileTimeType>
  selves: Map<U64, SelfHostCompileTimeType>
}

fn self_host_empty_compile_time_bindings() -> SelfHostCompileTimeBindings {
  {
    parameters: empty()
    selves: empty()
  }
}

fn self_host_read_compile_time_resolved_type(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
  bindings: SelfHostCompileTimeBindings,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  self_host_read_compile_time_resolved_arena(module_.resolved_types, index, bindings, depth)
}

fn self_host_read_compile_time_resolved_arena(
  resolved: SelfHostResolvedModuleTypes,
  index: U32,
  bindings: SelfHostCompileTimeBindings,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  self_host_read_compile_time_resolved_arena_with_self(resolved, index, bindings, depth, 18446744073709551615u64, None)
}

fn self_host_read_compile_time_resolved_arena_with_self(
  resolved: SelfHostResolvedModuleTypes,
  index: U32,
  bindings: SelfHostCompileTimeBindings,
  depth: U32,
  self_owner: U64,
  self_type: Option<SelfHostCompileTimeType>,
) -> Result<SelfHostCompileTimeType, String> {
  if depth >= 256u32 {
    return Err("CT-002 type query nesting limit exceeded")
  }
  if index >= resolved.types.length() {
    return Err("CT-002 resolved query type index is outside its arena")
  }
  let type_ = resolved.types[index]
  let span = match type_ {
    ErrorType => return Err("CT-002 erroneous type query argument")
    MemberTypeProjection(owner, operation, selector) => return match self_host_read_compile_time_resolved_arena_with_self(resolved, owner, bindings, depth + 1u32, self_owner, self_type) {
      Ok(value) => Ok(MemberProjectionCompileTimeType(value, operation, selector))
      Err(error) => Err(error)
    }
    PrimitiveType(primitive) => return Ok(PrimitiveCompileTimeType(primitive))
    NominalType(id) => return Ok(NominalCompileTimeType(id))
    TraitType(id) => return Ok(TraitCompileTimeType(id))
    GenericParameterType(id) => return Ok(match bindings.parameters.get(id) {
      Some(value) => value
      None => ParameterCompileTimeType(id)
    })
    SelfType(id) => return Ok(match if id == self_owner {
      self_type
    } else {
      bindings.selves.get(id)
    } {
      Some(value) => value
      None => ParameterCompileTimeType(id)
    })
    ProductType(span) => span
    AppliedType(_, span) => span
    FunctionType(span, _) => span
  }
  if !self_host_array_span_is_valid(span.start, span.length, resolved.type_arguments.length()) {
    return Err("CT-002 resolved query arguments are outside their arena")
  }
  let fields = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_resolved_arena_with_self(resolved, resolved.type_arguments[span.start + offset], bindings, depth + 1u32, self_owner, self_type) {
        Ok(value) => fields.push(value)
        Err(error) => return Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match type_ {
    ProductType(_) => Ok(ProductCompileTimeType(fields))
    AppliedType(base, _) => match self_host_read_compile_time_resolved_arena_with_self(resolved, base, bindings, depth + 1u32, self_owner, self_type) {
      Ok(value) => Ok(AppliedCompileTimeType(value, fields))
      Err(error) => Err(error)
    }
    FunctionType(_, result) => match self_host_read_compile_time_resolved_arena_with_self(resolved, result, bindings, depth + 1u32, self_owner, self_type) {
      Ok(value) => Ok(FunctionCompileTimeType(fields, value))
      Err(error) => Err(error)
    }
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 resolved query type changed kind")
      unreachable()
    }
  }
}

fn self_host_read_compile_time_type(
  module_: SelfHostPlannedModuleLowering,
  index: I32,
  bindings: SelfHostCompileTimeBindings,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  if depth >= 256u32 {
    return Err("CT-002 type query nesting limit exceeded")
  }
  if index < -1i32 {
    // Add before negation: the minimum I32 must not overflow.
    return self_host_read_compile_time_resolved_type(module_, self_host_body_i32_to_u32(-(index + 2i32)), bindings, depth + 1u32)
  }
  if index < 0i32 || self_host_body_i32_to_u32(index) >= module_.inferred.types.length() {
    return Err("CT-002 query body type is outside its arena")
  }
  let type_ = module_.inferred.types[self_host_body_i32_to_u32(index)]
  let span = match type_ {
    BodyMemberTypeProjection(owner, operation, selector) => return match self_host_read_compile_time_type(module_, owner, bindings, depth + 1u32) {
      Ok(owner) => Ok(MemberProjectionCompileTimeType(owner, operation, selector))
      Err(error) => Err(error)
    }
    BodyErrorType => return Err("CT-002 erroneous type query argument")
    BodyVariableType(_) => return Ok(UnknownCompileTimeType)
    BodyResolvedType(resolved) => return self_host_read_compile_time_resolved_type(module_, resolved, bindings, depth + 1u32)
    BodyProductType(span) => span
    BodyAppliedType(_, span) => span
    BodyFunctionType(span, _) => span
  }
  if !self_host_array_span_is_valid(span.start, span.length, module_.inferred.type_arguments.length()) {
    return Err("CT-002 query body arguments are outside their arena")
  }
  let fields = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_type(module_, module_.inferred.type_arguments[span.start + offset], bindings, depth + 1u32) {
        Ok(value) => fields.push(value)
        Err(error) => return Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match type_ {
    BodyProductType(_) => Ok(ProductCompileTimeType(fields))
    BodyAppliedType(base, _) => match self_host_read_compile_time_type(module_, base, bindings, depth + 1u32) {
      Ok(value) => Ok(AppliedCompileTimeType(value, fields))
      Err(error) => Err(error)
    }
    BodyFunctionType(_, result) => match self_host_read_compile_time_type(module_, result, bindings, depth + 1u32) {
      Ok(value) => Ok(FunctionCompileTimeType(fields, value))
      Err(error) => Err(error)
    }
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 query body type changed kind")
      unreachable()
    }
  }
}

fn self_host_read_compile_time_arguments(module_: SelfHostPlannedModuleLowering, span: SelfHostHirSpan, bindings: SelfHostCompileTimeBindings) -> Result<Array<SelfHostCompileTimeType>, String> {
  if !self_host_array_span_is_valid(span.start, span.length, module_.inferred.call_type_arguments.length()) {
    return Err("CT-002 query call arguments are outside their arena")
  }
  let result = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_type(module_, module_.inferred.call_type_arguments[span.start + offset], bindings, 0u32) {
        Ok(value) => result.push(value)
        Err(error) => return Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Ok(result)
}

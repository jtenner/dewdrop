open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

fn self_host_empty_compile_time_bindings() -> Map<U64, SelfHostCompileTimeType> {
  Map::empty()
}

fn self_host_read_compile_time_resolved_type(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
  bindings: Map<U64, SelfHostCompileTimeType>,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  if depth >= 256u32 {
    return Result::Err("CT-002 type query nesting limit exceeded")
  }
  if index >= module_.resolved_types.types.length() {
    return Result::Err("CT-002 resolved query type index is outside its arena")
  }
  let type_ = module_.resolved_types.types[index]
  let span = match type_ {
    SelfHostResolvedType::ErrorType => return Result::Err("CT-002 erroneous type query argument")
    SelfHostResolvedType::MemberTypeProjection(owner, operation, selector) => return match self_host_read_compile_time_resolved_type(module_, owner, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::MemberProjectionCompileTimeType(value, operation, selector))
      Result::Err(error) => Result::Err(error)
    }
    SelfHostResolvedType::PrimitiveType(primitive) => return Result::Ok(SelfHostCompileTimeType::PrimitiveCompileTimeType(primitive))
    SelfHostResolvedType::NominalType(id) => return Result::Ok(SelfHostCompileTimeType::NominalCompileTimeType(id))
    SelfHostResolvedType::TraitType(id) => return Result::Ok(SelfHostCompileTimeType::TraitCompileTimeType(id))
    SelfHostResolvedType::GenericParameterType(id) => return Result::Ok(match bindings.get(id) {
      Option::Some(value) => value
      Option::None => SelfHostCompileTimeType::ParameterCompileTimeType(id)
    })
    SelfHostResolvedType::SelfType(id) => return Result::Ok(match bindings.get(id) {
      Option::Some(value) => value
      Option::None => SelfHostCompileTimeType::ParameterCompileTimeType(id)
    })
    SelfHostResolvedType::ProductType(span) => span
    SelfHostResolvedType::AppliedType(_, span) => span
    SelfHostResolvedType::FunctionType(span, _) => span
  }
  if !self_host_array_span_is_valid(span.start, span.length, module_.resolved_types.type_arguments.length()) {
    return Result::Err("CT-002 resolved query arguments are outside their arena")
  }
  let fields = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_resolved_type(module_, module_.resolved_types.type_arguments[span.start + offset], bindings, depth + 1u32) {
        Result::Ok(value) => fields.push(value)
        Result::Err(error) => return Result::Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match type_ {
    SelfHostResolvedType::ProductType(_) => Result::Ok(SelfHostCompileTimeType::ProductCompileTimeType(fields))
    SelfHostResolvedType::AppliedType(base, _) => match self_host_read_compile_time_resolved_type(module_, base, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::AppliedCompileTimeType(value, fields))
      Result::Err(error) => Result::Err(error)
    }
    SelfHostResolvedType::FunctionType(_, result) => match self_host_read_compile_time_resolved_type(module_, result, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::FunctionCompileTimeType(fields, value))
      Result::Err(error) => Result::Err(error)
    }
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 resolved query type changed kind")
      unreachable()
    }
  }
}

fn self_host_read_compile_time_type(
  module_: SelfHostPlannedModuleLowering,
  index: I32,
  bindings: Map<U64, SelfHostCompileTimeType>,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  if depth >= 256u32 {
    return Result::Err("CT-002 type query nesting limit exceeded")
  }
  if index < -1i32 {
    // Add before negation: the minimum I32 must not overflow.
    return self_host_read_compile_time_resolved_type(module_, self_host_body_i32_to_u32(-(index + 2i32)), bindings, depth + 1u32)
  }
  if index < 0i32 || self_host_body_i32_to_u32(index) >= module_.inferred.types.length() {
    return Result::Err("CT-002 query body type is outside its arena")
  }
  let type_ = module_.inferred.types[self_host_body_i32_to_u32(index)]
  let span = match type_ {
    SelfHostBodyTypeTerm::BodyErrorType => return Result::Err("CT-002 erroneous type query argument")
    SelfHostBodyTypeTerm::BodyVariableType(_) => return Result::Ok(SelfHostCompileTimeType::UnknownCompileTimeType)
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => return self_host_read_compile_time_resolved_type(module_, resolved, bindings, depth + 1u32)
    SelfHostBodyTypeTerm::BodyProductType(span) => span
    SelfHostBodyTypeTerm::BodyAppliedType(_, span) => span
    SelfHostBodyTypeTerm::BodyFunctionType(span, _) => span
  }
  if !self_host_array_span_is_valid(span.start, span.length, module_.inferred.type_arguments.length()) {
    return Result::Err("CT-002 query body arguments are outside their arena")
  }
  let fields = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_type(module_, module_.inferred.type_arguments[span.start + offset], bindings, depth + 1u32) {
        Result::Ok(value) => fields.push(value)
        Result::Err(error) => return Result::Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match type_ {
    SelfHostBodyTypeTerm::BodyProductType(_) => Result::Ok(SelfHostCompileTimeType::ProductCompileTimeType(fields))
    SelfHostBodyTypeTerm::BodyAppliedType(base, _) => match self_host_read_compile_time_type(module_, base, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::AppliedCompileTimeType(value, fields))
      Result::Err(error) => Result::Err(error)
    }
    SelfHostBodyTypeTerm::BodyFunctionType(_, result) => match self_host_read_compile_time_type(module_, result, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::FunctionCompileTimeType(fields, value))
      Result::Err(error) => Result::Err(error)
    }
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 query body type changed kind")
      unreachable()
    }
  }
}

fn self_host_read_compile_time_arguments(module_: SelfHostPlannedModuleLowering, span: SelfHostHirSpan, bindings: Map<U64, SelfHostCompileTimeType>) -> Result<Array<SelfHostCompileTimeType>, String> {
  if !self_host_array_span_is_valid(span.start, span.length, module_.inferred.call_type_arguments.length()) {
    return Result::Err("CT-002 query call arguments are outside their arena")
  }
  let result = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_type(module_, module_.inferred.call_type_arguments[span.start + offset], bindings, 0u32) {
        Result::Ok(value) => result.push(value)
        Result::Err(error) => return Result::Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Result::Ok(result)
}

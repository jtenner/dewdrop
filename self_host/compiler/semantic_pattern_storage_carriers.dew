// A stored null marker for a logical Unit payload is not a reference value
// supplied to the binding. Require the selected field's storage certificate.
fn self_host_body_pattern_field_carrier(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  type_index: U32,
  field_index: U32,
  logical_type: I32,
) -> SelfHostWasmBodyCarrier {
  self_host_body_pattern_field_carrier_for_shape(link, type_index, field_index,
    self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, logical_type))
}

fn self_host_body_pattern_field_carrier_for_shape(
  link: SelfHostPlannedProgramWasmGCLink,
  type_index: U32,
  field_index: U32,
  logical_shape: SelfHostPlannedValueShape,
) -> SelfHostWasmBodyCarrier {
  let carrier = self_host_body_physical_field_carrier(link, type_index, field_index)
  if logical_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
    for linked_type in link.types {
      if linked_type.type_index == type_index {
        let fragment = link.fragments.modules[linked_type.module_index]
        let physical = fragment.physical_types[linked_type.fragment_index]
        self_host_assert_compiler_invariant(self_host_array_span_is_valid(physical.fields.start, physical.fields.length, fragment.fields.length()), "FRG-403 pattern payload storage span")
        if field_index < physical.fields.length {
          let field = fragment.fields[physical.fields.start + field_index]
          let unit = SelfHostWasmBodyCarrier::UnitBodyCarrier
          if self_host_linked_variant_unit_storage(link, field, unit) ||
            self_host_linked_erased_field_unit_storage(link, field.declaration, field.storage, unit) {
            return unit
          }
        }
      }
    }
  }
  carrier
}

fn self_host_unit_pattern_binding_has_storage(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleLowering,
  specialization: U32,
  pattern: SelfHostPlannedPattern,
  child: SelfHostPlannedPattern,
  type_index: U32,
  field_index: U32,
) -> Bool {
  let shape = self_host_body_specialization_shape_for_type(
    link, module_, specialization, child.type_,
    self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, child.type_),
  )
  if !(shape is SelfHostPlannedValueShape::UnitPlannedValueShape) {
    return false
  }
  let carrier = self_host_body_pattern_field_carrier_for_shape(link, type_index, field_index, shape)
  if carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier {
    return true
  }
  // These existing adapter types live outside the source fragment table. Their
  // reference payload is a null marker for Unit. Require the selected variant
  // identity and its exact Unit layout, not merely an eqref carrier or a name.
  let declaration = self_host_pattern_constructor_declaration(module_, pattern)
  match link.runtime_variant_adapters.get(declaration) {
    Option::Some(SelfHostRuntimeVariantAdapter::RuntimeOptionSome),
    Option::Some(SelfHostRuntimeVariantAdapter::RuntimeResultOk),
    Option::Some(SelfHostRuntimeVariantAdapter::RuntimeResultErr) => {
      match pattern.source {
        SelfHostHirPattern::TuplePattern(_, children, _) => if children.length != 1u32 {
          return false
        }
        _ => return false
      }
      if field_index != self_host_linked_variant_payload_field_index(link, type_index, 0u32) {
        return false
      }
      match self_host_linked_pattern_variant_type(link, module_, pattern, shape, 0u64) {
        Option::Some(expected) => expected == type_index
        Option::None => false
      }
    }
    _ => false
  }
}

test "solver accepts nested snapshots without mutations" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let outer = solver.snapshot()
  let inner = solver.snapshot()
  solver.commit(inner)
  solver.rollback(outer)
  assert(solver.snapshot_count() == 0u32, "snapshots must close in order")
}


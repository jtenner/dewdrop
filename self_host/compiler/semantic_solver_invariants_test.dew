test "solver nested committed changes restore parents sizes and bindings" {
  let fixture = self_host_unification_test_types()
  let solver = SelfHostLocalTypeSolver::new(fixture.resolved)
  let a = solver.fresh_variable()
  let b = solver.fresh_variable()
  let scalar = solver.resolved_type(fixture.resolved.primitive(SelfHostPrimitiveType::I32Type))
  let parents = solver.variable_parents.copy()
  let sizes = solver.variable_sizes.copy()
  let bindings = solver.variable_bindings.copy()
  let variables = solver.variable_types.copy()
  let type_count = solver.type_count()
  let outer = solver.snapshot()
  let origin = self_host_synthetic_type_origin(0u32, 1u32)
  assert(solver.unify(a, b, origin), "union inside outer snapshot")
  let inner = solver.snapshot()
  assert(solver.unify(b, scalar, origin), "bind inside inner snapshot")
  let _ = solver.product_type([solver.fresh_variable(), a])
  solver.commit(inner)
  solver.rollback(outer)
  assert(solver.variable_count() == 2u32, "variable arena restored")
  let _ = while 0u32 {
    index => if index < 2u32 {
      assert(solver.variable_parents[index] == parents[index], "parent contents restored")
      assert(solver.variable_sizes[index] == sizes[index], "size contents restored")
      assert(solver.variable_bindings[index] == bindings[index], "binding contents restored")
      assert(solver.variable_types[index] == variables[index], "variable types restored")
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(solver.type_count() == type_count, "type arena restored")
  assert(solver.type_arguments.length() == 0u32, "argument arena restored")
  assert(solver.diagnostic_count() == 0u32, "diagnostics restored")
  assert(solver.snapshot_count() == 0u32, "snapshots closed")
  assert(solver.undo_count() == 0u32, "undo records consumed")
  solver.assert_type_caches()
  solver.assert_undo_arrays()
}

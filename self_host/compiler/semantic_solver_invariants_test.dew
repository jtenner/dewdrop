test "SOL-204 nested snapshots with identical state are distinct" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let outer = solver.snapshot()
  let _ = solver.snapshot()
  solver.commit(outer)
}

test "SOL-204 a committed snapshot cannot be replayed" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let old = solver.snapshot()
  solver.commit(old)
  let _ = solver.snapshot()
  solver.rollback(old)
}

test "SOL-204 commit requires an open snapshot" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let old = solver.snapshot()
  solver.commit(old)
  solver.commit(old)
}

test "SOL-205 undo arrays must remain parallel" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.fresh_variable()
  let snapshot = solver.snapshot()
  solver.set_variable_binding(0u32, 0i32)
  solver.undo_indices.clear()
  solver.rollback(snapshot)
}


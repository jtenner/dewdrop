test "SOL-204 rollback cannot invent missing arena contents" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.product_type([0i32])
  let snapshot = solver.snapshot()

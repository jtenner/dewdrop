  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.fresh_variable()
  let _ = solver.fresh_variable()
  let _ = solver.union_variables(0u32, 1u32)
  solver.variable_parents[0u32] = 1u32
  let _ = solver.find_variable_root(0u32)
}

test "SOL-202 parents must stay in the variable arena" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.fresh_variable()
  solver.variable_parents[0u32] = 1u32
  let _ = solver.find_variable_root(0u32)
}

test "SOL-203 union size cannot overflow" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.fresh_variable()
  let _ = solver.fresh_variable()
  solver.variable_sizes[0u32] = 4294967295u32
  let _ = solver.union_variables(0u32, 1u32)
}

test "SOL-207 resolved type encoding cannot overflow" expect_trap "unreachable" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let _ = solver.resolved_type(2147483647u32)
}

test "resolved type encoding round trips at the signed limit" {
  let solver = SelfHostLocalTypeSolver::new(self_host_unification_test_types().resolved)
  let encoded = solver.resolved_type(2147483646u32)
  assert(encoded == -2147483648i32, "last encodable resolved type")
  assert(solver.decoded_resolved_type(encoded) == 2147483646u32, "decode the last encodable type")
}


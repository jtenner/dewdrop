fn self_host_verify_outlined_raw_array_get(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleWasmGCFragments,
  function_: SelfHostPlannedWasmFunctionFragment,
  recipe: SelfHostRawArrayGetRecipe,
) -> SelfHostRawArrayStorage {
  self_host_outlined_builtin_assert(module_, function_, self_host_raw_array_opcode(recipe.opcode) == 2u32,
    714u32, 2u64, u32_into_u64(self_host_raw_array_opcode(recipe.opcode)), 0u64)
  let storage = match self_host_linked_raw_array_storage(link, recipe.element_shape) {
    Option::Some(value) => value
    Option::None => {
      self_host_outlined_builtin_assert(module_, function_, false, 301u32,
        1u64, 0u64, 0u64)
      unreachable()
    }
  }
  let values = module_.function_value_types
  let parameters = function_.parameters
  let results = function_.results
  self_host_outlined_builtin_assert(module_, function_,
    self_host_array_span_is_valid(parameters.start, parameters.length, values.length()),
    101u32, u32_into_u64(values.length()), u32_into_u64(parameters.length), u32_into_u64(parameters.start))
  self_host_outlined_builtin_assert(module_, function_,
    self_host_array_span_is_valid(results.start, results.length, values.length()),
    101u32, u32_into_u64(values.length()), u32_into_u64(results.length), u32_into_u64(results.start))
  self_host_outlined_builtin_assert(module_, function_, parameters.length == 2u32,
    703u32, 2u64, u32_into_u64(parameters.length), 0u64)
  let array = self_host_body_carrier_from_value_type(values[parameters.start])
  self_host_outlined_builtin_assert(module_, function_, array is SelfHostWasmBodyCarrier::EqRefBodyCarrier,
    705u32, 9u64, self_host_body_carrier_code(array), 0u64)
  let index = self_host_body_carrier_from_value_type(values[parameters.start + 1u32])
  self_host_outlined_builtin_assert(module_, function_, index is SelfHostWasmBodyCarrier::I32BodyCarrier,
    705u32, 4u64, self_host_body_carrier_code(index), 1u64)
  let unit = recipe.element_shape is SelfHostPlannedValueShape::UnitPlannedValueShape
  let result_count = if unit {
    0u32
  } else {
    1u32
  }
  self_host_outlined_builtin_assert(module_, function_, results.length == result_count,
    709u32, u32_into_u64(result_count), u32_into_u64(results.length), 0u64)
  if !unit {
    let expected = self_host_body_carrier_from_shape(recipe.element_shape)
    let actual = self_host_body_carrier_from_value_type(values[results.start])
    self_host_outlined_builtin_assert(module_, function_, self_host_body_carrier_equal(expected, actual),
      709u32, self_host_body_carrier_code(expected), self_host_body_carrier_code(actual), 0u64)
  }
  storage
}

fn self_host_append_outlined_raw_array_get(
  link: SelfHostPlannedProgramWasmGCLink,
  module_: SelfHostPlannedModuleWasmGCFragments,
  function_: SelfHostPlannedWasmFunctionFragment,
  recipe: SelfHostRawArrayGetRecipe,
  functions: StarshineFunctions,
) -> Option<String> {
  let storage = self_host_verify_outlined_raw_array_get(link, module_, function_, recipe)
  let instructions = StarshineFfi.ffi_ffi_bridge_instructions_new()
  StarshineFfi.ffi_ffi_bridge_instructions_push(instructions,
    StarshineFfi.ffi_lib_Instruction_local_get(StarshineFfi.ffi_lib_LocalIdx_new(0i32)))
  // The self-host function ABI is erased. The recipe gives the exact raw heap
  // and read signedness; validate it before the array instruction.
  self_host_emit_raw_ref_cast(storage.type_index, instructions)
  StarshineFfi.ffi_ffi_bridge_instructions_push(instructions,
    StarshineFfi.ffi_lib_Instruction_local_get(StarshineFfi.ffi_lib_LocalIdx_new(1i32)))
  self_host_emit_raw_array_get(storage, instructions)
  if recipe.element_shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
    StarshineFfi.ffi_ffi_bridge_instructions_push(instructions,
      StarshineFfi.ffi_lib_Instruction_drop())
  }
  // Products already use the self-host boxed ABI and need no unboxing here.
  StarshineFfi.ffi_ffi_bridge_funcs_push(functions,
    StarshineFfi.ffi_lib_Func_new(StarshineFfi.ffi_lib_Locals_empty(), StarshineFfi.ffi_lib_Expr_new(instructions)))
  Option::None
}

open dew.std.map
open dew.std.option

fn self_host_call_index_failure(body: U64, key: U64, code: U32, expected: U64, actual: U64, detail: U64) -> Never {
  self_host_assert_compiler_invariant_with_failure(false, SelfHostInvariantFailure::{
    code: code
    phase: 5u32
    module_id: self_host_semantic_id_module(body)
    declaration: 0u64
    body: body
    expression: u64_into_u32(key)
    expected: expected
    actual: actual
    detail: detail
  }, "linked call index requires parallel, body-owned, decreasing chains and exact targets")
  unreachable()
}

fn self_host_check_call_index_arrays(index: SelfHostLinkedCallIndex, body: U64, key: U64) -> Unit {
  let length = index.keys.length()
  if index.functions.length() != length {
    self_host_call_index_failure(body, key, 103u32,
      u32_into_u64(length), u32_into_u64(index.functions.length()), 1u64)
  }
  if index.next.length() != length {
    self_host_call_index_failure(body, key, 103u32,
      u32_into_u64(length), u32_into_u64(index.next.length()), 2u64)
  }
  if index.bodies.length() != length {
    self_host_call_index_failure(body, key, 103u32,
      u32_into_u64(length), u32_into_u64(index.bodies.length()), 3u64)
  }
}

// A flat typed chain avoids nested generic maps. Appends retain the owning
// body beside each entry, and links always point to older entries of that body.
fn self_host_body_specialized_call_index_append(
  index: SelfHostLinkedCallIndex,
  body: U64,
  key: U64,
  function_index: U32,
) -> Unit {
  self_host_check_call_index_arrays(index, body, key)
  if function_index == 4294967295u32 {
    self_host_call_index_failure(body, key, 504u32,
      1u64, u32_into_u64(function_index), u32_into_u64(index.keys.length()))
  }
  match self_host_body_specialized_call_index_get(index, body, key) {
    Option::Some(previous) => {
      if previous != function_index {
        self_host_call_index_failure(body, key, 303u32,
          u32_into_u64(previous), u32_into_u64(function_index), key >> 32u64)
      }
      return ()
    }
    Option::None => {}
  }
  let position = index.keys.length()
  let previous = match index.heads.get(body) {
    Option::Some(value) => value
    Option::None => 4294967295u32
  }
  index.keys.push(key)
  index.functions.push(function_index)
  index.next.push(previous)
  index.bodies.push(body)
  index.heads.set(body, position)
}

fn self_host_body_specialized_call_index_get(
  index: SelfHostLinkedCallIndex,
  body: U64,
  key: U64,
) -> Option<U32> {
  self_host_check_call_index_arrays(index, body, key)
  let missing = 4294967295u32
  let current = match index.heads.get(body) {
    Option::Some(value) => value
    Option::None => missing
  }
  while current {
    position if position != missing => {
      if position >= index.keys.length() {
        self_host_call_index_failure(body, key, 105u32,
          u32_into_u64(index.keys.length()), u32_into_u64(position), 0u64)
      }
      if index.bodies[position] != body {
        self_host_call_index_failure(body, key, 106u32,
          body, index.bodies[position], u32_into_u64(position))
      }
      let next = index.next[position]
      if next != missing {
        if next >= position {
          self_host_call_index_failure(body, key, 108u32,
            u32_into_u64(position), u32_into_u64(next), u32_into_u64(position))
        }
        if index.bodies[next] != body {
          self_host_call_index_failure(body, key, 106u32,
            body, index.bodies[next], u32_into_u64(next))
        }
      }
      let target = index.functions[position]
      if target == missing {
        self_host_call_index_failure(body, key, 504u32,
          1u64, u32_into_u64(target), u32_into_u64(position))
      }
      // Validate the visited entry and its edge before an exact hit can return.
      if index.keys[position] == key {
        break Option::Some(target)
      }
      continue next
    }
    _ => break Option::None
  }
}

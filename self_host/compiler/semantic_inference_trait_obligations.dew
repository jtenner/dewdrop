open dew.std.option
open dew.std.result

impl SelfHostBasicBodyInferencer {
  fn obligation_search(self) -> SelfHostCompileTimeEvidenceSearch {
    match self.trait_obligation_search {
      Option::Some(search) => return search
      Option::None => {}
    }
    let scope = match self.imported.scope {
      Option::Some(scope) => scope
      Option::None => self_host_build_module_import_scope(self.collected, 0u32, [], SelfHostFrozenInterfaceList::new())
    }
    let imports = match self.imported.resolved_imports {
      Option::Some(imports) => imports
      Option::None => self_host_resolve_module_imports(self.resolved, scope)
    }
    let search = SelfHostCompileTimeEvidenceSearch::{
      lowering: Option::None
      collected: self.collected
      resolved: self.resolved
      imports: imports
      index: self_host_index_module_implementations_with_imports(self.collected, imports)
      active: []
      budget: SelfHostCompileTimeEvidenceBudget::{
        steps: 0u32
      }
      associated_scopes: Map::empty()
      associated_only: false
      include_test_impls: self.collected.declaration_is_test_only(self.body.declaration)
    }
    self.trait_obligation_search = Option::Some(search)
    search
  }

  fn check_inference_trait_obligation(self, expression: U32, target: I32, bound: I32) -> Result<Bool, String> {
    let bindings = self_host_empty_compile_time_bindings()
    let expected = match self_host_read_compile_time_solver_type(self.solver, bound, bindings, 0u32) {
      Result::Ok(value) => value
      Result::Err(error) => return Result::Err(error)
    }
    let proofs = self.guarded_trait_bounds(expression, target)
    match self.solver.type_term(self.solver.representative_type(target)) {
      SelfHostBodyTypeTerm::BodyResolvedType(type_) => match self.resolved.types[type_] {
        SelfHostResolvedType::GenericParameterType(parameter) => if self_host_semantic_id_module(parameter) == self.collected.module_id {
          let span = self.collected.generic_parameter_at(self_host_semantic_id_local(parameter)).bounds
          self_host_assert_array_span(span.start, span.length, self.resolved.generic_bound_types.length(), "ARN-101 declared obligation bounds")
          let _ = while 0u32 {
            index => if index < span.length {
              proofs.push(self.resolved.generic_bound_types[span.start + index])
              continue index + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        _ => {}
      }
      _ => {}
    }
    for proof in proofs {
      let actual = match self_host_read_compile_time_resolved_arena(self.resolved, proof, bindings, 0u32) {
        Result::Ok(value) => value
        Result::Err(error) => return Result::Err(error)
      }
      match self_host_compile_time_types_equal(actual, expected) {
        Result::Ok(equal) => if equal {
          return Result::Ok(true)
        }
        Result::Err(error) => return Result::Err(error)
      }
    }
    let actual = match self_host_read_compile_time_solver_type(self.solver, target, bindings, 0u32) {
      Result::Ok(value) => value
      Result::Err(error) => return Result::Err(error)
    }
    match self_host_compile_time_types_concrete([actual, expected]) {
      Result::Ok(concrete) => if !concrete {
        return Result::Ok(false)
      }
      Result::Err(error) => return Result::Err(error)
    }
    let search = self.obligation_search()
    self_host_assert_compiler_invariant(search.active.length() == 0u32, "INV-001 completed inference trait search")
    search.budget.steps = 0u32
    search.search(actual, expected)
  }

  fn validate_selected_method_bounds(self, expression: U32, declaration: U64, owner_count: U32, method_count: U32, offset: U32) -> Unit {
    let local = self_host_semantic_id_module(declaration) == self.collected.module_id
    let required = if local {
      self.local_generics_require_evidence(declaration)
    } else {
      match self.imported_callable(declaration) {
        Option::Some(callable) => callable.requires_evidence
        Option::None => false
      }
    }
    if !required {
      return
    }
    let search = self.obligation_search()
    let generics = if local {
      self.collected.generic_parameters_of(declaration)
    } else {
      match search.imports.callable(declaration) {
        Option::Some(callable) => callable.generic_bounds
        Option::None => {
          self_host_assert_compiler_invariant(false, "LNK-504 method obligation declaration missing")
          unreachable()
        }
      }
    }
    self_host_assert_compiler_invariant(generics.length == method_count, "SPC-303 method obligation generic count")
    self_host_assert_array_span(owner_count, method_count, self.candidate_type_arguments.length(), "ARN-101 method obligation type arguments")
    let _ = while 0u32 {
      index => if index < method_count {
        let bounds = if local {
          self.collected.generic_parameters[generics.start + index].bounds
        } else {
          search.imports.generic_parameter_bounds[generics.start + index]
        }
        let types = if local {
          self.resolved.generic_bound_types
        } else {
          search.imports.generic_bound_types
        }
        self_host_assert_array_span(bounds.start, bounds.length, types.length(), "ARN-101 method obligation bound types")
        let target = self.candidate_type_arguments[owner_count + index]
        let _ = while 0u32 {
          bound_index => if bound_index < bounds.length {
            let bound = self.instantiate_signature_type(types[bounds.start + bound_index])
            let message = match self.check_inference_trait_obligation(expression, target, bound) {
              Result::Ok(valid) => if valid || self.defer_expression_check(expression, [target, bound]) {
                Option::None
              } else {
                Option::Some("EVD-214 unsatisfied method trait bound")
              }
              Result::Err(error) => Option::Some(error)
            }
            match message {
              Option::Some(message) => self.diagnostics.push(SelfHostBodyInferenceDiagnostic::TraitObligationFailure(declaration, expression, message, offset))
              Option::None => {}
            }
            continue bound_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
}

fn self_host_read_compile_time_solver_type(
  solver: SelfHostLocalTypeSolver,
  index: I32,
  bindings: SelfHostCompileTimeBindings,
  depth: U32,
) -> Result<SelfHostCompileTimeType, String> {
  if depth >= 256u32 {
    return Result::Err("CT-002 type query nesting limit exceeded")
  }
  let index = solver.representative_type(index)
  if index < -1i32 {
    // Add before negation: the minimum I32 must not overflow.
    return self_host_read_compile_time_resolved_arena(solver.resolved, self_host_body_i32_to_u32(-(index + 2i32)), bindings, depth + 1u32)
  }
  if index < 0i32 || self_host_body_i32_to_u32(index) >= solver.types.length() {
    return Result::Err("CT-002 query body type is outside its arena")
  }
  let type_ = solver.types[self_host_body_i32_to_u32(index)]
  let span = match type_ {
    SelfHostBodyTypeTerm::BodyMemberTypeProjection(owner, operation, selector) => return match self_host_read_compile_time_solver_type(solver, owner, bindings, depth + 1u32) {
      Result::Ok(owner) => Result::Ok(SelfHostCompileTimeType::MemberProjectionCompileTimeType(owner, operation, selector))
      Result::Err(error) => Result::Err(error)
    }
    SelfHostBodyTypeTerm::BodyErrorType => return Result::Err("CT-002 erroneous type query argument")
    SelfHostBodyTypeTerm::BodyVariableType(_) => return Result::Ok(SelfHostCompileTimeType::UnknownCompileTimeType)
    SelfHostBodyTypeTerm::BodyResolvedType(resolved) => return self_host_read_compile_time_resolved_arena(solver.resolved, resolved, bindings, depth + 1u32)
    SelfHostBodyTypeTerm::BodyProductType(span) => span
    SelfHostBodyTypeTerm::BodyAppliedType(_, span) => span
    SelfHostBodyTypeTerm::BodyFunctionType(span, _) => span
  }
  if !self_host_array_span_is_valid(span.start, span.length, solver.type_arguments.length()) {
    return Result::Err("CT-002 query body arguments are outside their arena")
  }
  let fields = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    offset => if offset < span.length {
      match self_host_read_compile_time_solver_type(solver, solver.type_arguments[span.start + offset], bindings, depth + 1u32) {
        Result::Ok(value) => fields.push(value)
        Result::Err(error) => return Result::Err(error)
      }
      continue offset + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  match type_ {
    SelfHostBodyTypeTerm::BodyProductType(_) => Result::Ok(SelfHostCompileTimeType::ProductCompileTimeType(fields))
    SelfHostBodyTypeTerm::BodyAppliedType(base, _) => match self_host_read_compile_time_solver_type(solver, base, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::AppliedCompileTimeType(value, fields))
      Result::Err(error) => Result::Err(error)
    }
    SelfHostBodyTypeTerm::BodyFunctionType(_, result) => match self_host_read_compile_time_solver_type(solver, result, bindings, depth + 1u32) {
      Result::Ok(value) => Result::Ok(SelfHostCompileTimeType::FunctionCompileTimeType(fields, value))
      Result::Err(error) => Result::Err(error)
    }
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 query body type changed kind")
      unreachable()
    }
  }
}

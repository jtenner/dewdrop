test "basic body inference reports direct call arity mismatches" {
  let (_, _, _, inferred) = self_host_basic_infer_source(
    833u64,
    b"fn inc(value: I32) -> I32 {\n  value + 1\n}\nfn use() -> I32 {\n  inc()\n}\n",
  )
  let body = inferred.bodies[1u32]
  let mut arity = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < self_host_basic_inference_diagnostic_count(body) {
      match self_host_basic_inference_diagnostic_at(body, current) {
        CallArgumentCountMismatch(_, _, _, _, _) => {
          arity = arity + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(arity == 1u32, "one arity diagnostic")
}

test "basic body inference constrains typed array literals" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    832u64,
    b"struct Array<t> {}\nfn values() -> Array<I32> {\n  [1, 2, 3]\n}\n",
  )
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "array diagnostics")
  match body.type_term(body.root_type) {
    BodyAppliedType(_, arguments) => {
      assert(arguments.length == 1u32, "array argument count")
      self_host_assert_basic_primitive(
        body,
        resolved,
        body.type_arguments[arguments.start],
        I32Type,
        "array element I32",
      )
    }
    BodyResolvedType(type_) => match resolved.types[type_] {
      AppliedType(_, arguments) => assert(
        arguments.length == 1u32,
        "resolved array argument count",
      )
      _ => assert(false, "expected resolved array")
    }
    _ => assert(false, "expected array application")
  }
}


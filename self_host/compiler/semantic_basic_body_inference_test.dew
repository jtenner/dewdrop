open dew.std.string_builder
open dew.std.testing

fn self_host_basic_infer_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostResolvedModuleTypes,
  SelfHostResolvedModuleNames,
  SelfHostBasicInferredModuleBodies,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  (collected, resolved, names, inferred)
}

test "basic inference copies exact scalar carriers by index" {
  assert(self_host_basic_u32_at([7u32], 0u32) == 7u32, "indexed U32")
  let destination = []
  self_host_basic_copy_i32_values([-7i32, 11i32], destination)
  assert(destination.length() == 2u32, "copied I32 count")
  assert(destination[0u32] == -7i32, "copied first I32")
  assert(destination[1u32] == 11i32, "copied second I32")
}

fn self_host_assert_basic_primitive(
  body: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
  primitive: SelfHostPrimitiveType,
  message: String,
) -> Unit {
  match body.type_term(type_) {
    BodyResolvedType(resolved_type) => assert(
      resolved_type == resolved.primitive(primitive),
      message,
    )
    _ => assert(false, message)
  }
}

test "basic body inference resolves literals parameters lets and returns" {
  let (collected, resolved, names, inferred) = self_host_basic_infer_source(
    81u64,
    b"fn next(value: I32) -> I32 {\n  let result = value + 1\n  result\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "type diagnostics")
  assert(names.diagnostics.length() == 0u32, "name diagnostics")
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "inference diagnostics")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "root I32",
  )
  assert(body.local_types.length() == 2u32, "parameter and let locals")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.local_types[1u32],
    I32Type,
    "let I32",
  )
}

test "loop item fields keep their exact declaration identity" {
  let (collected, resolved, names, inferred) = self_host_basic_infer_source(
    811u64,
    b"struct Recipe {\n  declaration: U64\n  builtin_name: Bytes\n}\nfn find(recipes: Array<Recipe>, declaration: U64) -> Option<Bytes> {\n  for recipe in recipes {\n    if recipe.declaration == declaration {\n      return Some(recipe.builtin_name)\n    }\n  }\n  None\n}\nenum Option<t> {\n  Some(t)\n  None\n}\nstruct Array<t> {\n  item: t\n}\nstruct ArrayIter<t> {\n  item: t\n  mut done: Bool\n}\nimpl<t> Array<t> {\n  fn iter(self) -> ArrayIter<t> {\n    {\n      item: self.item\n      done: false\n    }\n  }\n}\nimpl<t> ArrayIter<t> {\n  fn next(self) -> Option<t> {\n    if self.done {\n      None\n    } else {\n      self.done = true\n      Some(self.item)\n    }\n  }\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "type diagnostics")
  assert(names.diagnostics.length() == 0u32, "name diagnostics")
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "inference diagnostics")
  let mut declaration_field = 0u64
  let mut builtin_name_field = 0u64
  for field in collected.fields {
    let name = collected.name(field.name)
    if name == "declaration" {
      declaration_field = field.id
    } else if name == "builtin_name" {
      builtin_name_field = field.id
    }
  }
  let mut found_declaration = false
  let mut found_builtin_name = false
  for selection in body.expression_selections {
    match selection {
      FieldBasicExpressionSelection(
        field,
        _,
        owner,
      ) => {
        if self_host_u64_equal(field, declaration_field) {
          found_declaration = self_host_u64_equal(
            owner,
            collected.fields[0u32].declaration,
          )
        }
        if self_host_u64_equal(field, builtin_name_field) {
          found_builtin_name = self_host_u64_equal(
            owner,
            collected.fields[0u32].declaration,
          )
        }
      }
      _ => {}
    }
  }
  assert(found_declaration, "declaration field identity")
  assert(found_builtin_name, "builtin name field identity")
}

test "basic body inference handles products destructuring and branches" {
  let (collected, resolved, names, inferred) = self_host_basic_infer_source(
    82u64,
    b"fn choose(flag: Bool) -> I32 {\n  let pair = (1, true)\n  let (first, _) = pair\n  if flag {\n    first\n  } else {\n    4\n  }\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "type diagnostics")
  assert(names.diagnostics.length() == 0u32, "name diagnostics")
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "product inference diagnostics")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "branch result I32",
  )
}

test "basic body inference constrains function-value calls" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    83u64,
    b"fn apply(callback: fn(I32) -> I32, value: I32) -> I32 {\n  callback(value)\n}\n",
  )
  assert(inferred.bodies.length() == 1u32, "body count")
  for body in inferred.bodies {
    assert(body.diagnostics.length() == 0u32, "call inference diagnostics")
    self_host_assert_basic_primitive(
      body,
      resolved,
      body.root_type,
      I32Type,
      "call result I32",
    )
  }
}

test "basic body inference selects non-generic direct calls" {
  let (collected, resolved, _, inferred) = self_host_basic_infer_source(
    831u64,
    b"fn inc(value: I32) -> I32 {\n  value + 1\n}\nfn use() -> I32 {\n  inc(4)\n}\n",
  )
  let hir_body = collected.bodies[1u32]
  let body = inferred.bodies[1u32]
  assert(body.diagnostics.length() == 0u32, "direct call diagnostics")
  let call = match hir_body.root {
    BlockBodyRoot(block) => {
      let item = collected.block_items[collected.blocks[block].items.start]
      if self_host_hir_block_item_is_let(item) {
        4294967295u32
      } else {
        item.value
      }
    }
    ExpressionBodyRoot(expression) => expression
  }
  match body.call_target(hir_body, call) {
    SelectedBasicCallTarget(declaration, type_arguments) => {
      assert(
        declaration == collected.callables[0u32].declaration,
        "selected inc",
      )
      assert(type_arguments.length == 0u32, "non-generic call arguments")
    }
    _ => assert(false, "selected direct target")
  }
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "direct call result",
  )
}

test "basic body inference instantiates generic direct calls freshly" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    834u64,
    b"fn identity<t>(value: t) -> t {\n  value\n}\nfn use() -> Bool {\n  let number = identity(1)\n  if number == 1 {\n    identity(true)\n  } else {\n    false\n  }\n}\n",
  )
  let body = inferred.bodies[1u32]
  assert(body.diagnostics.length() == 0u32, "generic call diagnostics")
  assert(body.call_type_arguments.length() == 2u32, "generic argument count")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.call_type_arguments[0u32],
    I32Type,
    "first generic call argument",
  )
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.call_type_arguments[1u32],
    BoolType,
    "second generic call argument",
  )
}


}

test "basic body inference constrains functional loop state and result" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    85u64,
    b"fn finish(initial: I32) -> I32 {\n  while initial {\n    value if value == 0 => break value\n    value => continue value - 1\n  }\n}\n",
  )
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "loop diagnostics")
  assert(body.control_state_types.length() == 1u32, "control count")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.control_state_types[0u32],
    I32Type,
    "loop state I32",
  )
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.control_result_types[0u32],
    I32Type,
    "loop result I32",
  )
}

fn self_host_deep_generic_call_source(depth: U32) -> Bytes {
  let builder = StringBuilder::new()
  builder.append("struct Box<t> {}\nbuiltin consume<t>(value: ")
  let mut index = 0u32
  let _ = while index {
    current => if current < depth {
      builder.append("Box<")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.append("t")
  index = 0u32
  let _ = while index {
    current => if current < depth {
      builder.append(">")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.append(") -> t = \"consume\"\nfn use(value: ")
  index = 0u32
  let _ = while index {
    current => if current < depth {
      builder.append("Box<")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.append("I32")
  index = 0u32
  let _ = while index {
    current => if current < depth {
      builder.append(">")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.append(") -> I32 {\n  consume(value)\n}\n")
  builder.finish().as_bytes()
}

test "generic signature instantiation remains iterative at depth 1024" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    851u64,
    self_host_deep_generic_call_source(1024u32),
  )
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "deep generic diagnostics")
  assert(body.call_type_arguments.length() == 1u32, "deep generic arguments")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.call_type_arguments[0u32],
    I32Type,
    "deep generic I32",
  )
}

fn self_host_basic_deep_local_source(count: U32) -> Bytes {
  let builder = StringBuilder::new()
  builder.append("fn deep(initial: I32) -> I32 {\n")
  let mut index = 0u32
  let _ = while index {
    current => if current < count {
      builder.append("  let value_")
      builder.append_u32(current)
      builder.append(" = ")
      if current == 0u32 {
        builder.append("initial")
      } else {
        builder.append("value_")
        builder.append_u32(current - 1u32)
      }
      builder.append("\n")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.append("  value_")
  builder.append_u32(count - 1u32)
  builder.append("\n}\n")
  builder.finish().as_bytes()
}

test "basic body inference remains iterative for 1024 sequential locals" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    852u64,
    self_host_basic_deep_local_source(1024u32),
  )
  let body = inferred.bodies[0u32]
  assert(body.local_types.length() == 1025u32, "deep local count")
  assert(body.diagnostics.length() == 0u32, "deep inference diagnostics")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "deep root I32",
  )
}

test "basic body inference reports mismatches bounds and mutability" {
  let (_, _, _, inferred) = self_host_basic_infer_source(
    86u64,
    b"fn bad(value: I32) -> I32 {\n  let fixed = 1\n  fixed = true\n  true\n}\n",
  )
  let body = inferred.bodies[0u32]
  let mut mismatch = 0u32
  let mut immutable = 0u32
  let mut range = 0u32
  let mut diagnostic_index = 0u32
  let _ = while diagnostic_index {
    current => if current < self_host_basic_inference_diagnostic_count(body) {
      match self_host_basic_inference_diagnostic_at(body, current) {
        BodyConstraintDiagnostic(_) => {
          mismatch = mismatch + 1u32
        }
        ImmutableAssignmentTarget(_, _) => {
          immutable = immutable + 1u32
        }
        NumericLiteralOutOfRange(_, _, _) => {
          range = range + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(mismatch > 0u32, "type mismatch")
  assert(immutable == 1u32, "immutable assignment")
  assert(range == 0u32, "no numeric range diagnostic")
}

fn self_host_assert_capture_free_lambda(
  lambda: SelfHostBasicInferredLambda,
  resolved: SelfHostResolvedModuleTypes,
) -> Unit {
  let body = lambda.body
  assert(body.diagnostics.length() == 0u32, "lambda diagnostics")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "lambda result I32",
  )
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.local_types[0u32],
    I32Type,
    "lambda parameter I32",
  )
}

test "basic inference constrains capture-free lambda bodies" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    849u64,
    b"fn make() -> fn(I32) -> I32 {\n  fn(value: I32) -> I32 {\n    value + 1\n  }\n}\n",
  )
  assert(inferred.lambdas.length() == 1u32, "lambda count")
  self_host_assert_capture_free_lambda(inferred.lambdas[0u32], resolved)
}

fn self_host_assert_lambda_capture_type(
  lambda: SelfHostBasicInferredLambda,
  resolved: SelfHostResolvedModuleTypes,
) -> Unit {
  let body = lambda.body
  assert(body.diagnostics.length() == 0u32, "capture lambda diagnostics")
  assert(body.capture_types.length() == 1u32, "one capture type")
  self_host_assert_basic_primitive(
    body,
    resolved,
    body.capture_types[0u32],
    I32Type,
    "capture I32",
  )
}

test "basic lambda inference publishes constrained capture types" {
  let (_, resolved, _, inferred) = self_host_basic_infer_source(
    850u64,
    b"fn make(seed: I32) -> fn(I32) -> I32 {\n  fn(value: I32) -> I32 {\n    seed + value\n  }\n}\n",
  )
  assert(inferred.lambdas.length() == 1u32, "capture lambda count")
  self_host_assert_lambda_capture_type(inferred.lambdas[0u32], resolved)
}

fn self_host_lambda_has_diagnostics(
  lambda: SelfHostBasicInferredLambda,
) -> Bool {
  lambda.body.diagnostics.length() > 0u32
}

test "lambda capture routing preserves outer rigid types" {
  let (_, _, _, inferred) = self_host_basic_infer_source(
    851u64,
    b"fn make(seed: Bool) -> fn() -> I32 {\n  fn() -> I32 {\n    seed\n  }\n}\n",
  )
  assert(
    self_host_lambda_has_diagnostics(inferred.lambdas[0u32]),
    "capture mismatch diagnostic",
  )
}

test "lambda capture routing imports structural local types" {
  let (_, _, _, inferred) = self_host_basic_infer_source(
    852u64,
    b"struct Box<t> {}\nbuiltin box<t>(value: t) -> Box<t> = \"box\"\nfn make() -> fn() -> Box<I32> {\n  let captured = box(true)\n  fn() -> Box<I32> {\n    captured\n  }\n}\n",
  )
  assert(
    self_host_lambda_has_diagnostics(inferred.lambdas[0u32]),
    "structural capture mismatch diagnostic",
  )
}

test "nested lambda capture routing imports parent structural locals" {
  let (_, _, _, inferred) = self_host_basic_infer_source(
    853u64,
    b"struct Box<t> {}\nbuiltin box<t>(value: t) -> Box<t> = \"box\"\nfn make() -> fn() -> fn() -> Box<I32> {\n  fn() -> fn() -> Box<I32> {\n    let captured = box(true)\n    fn() -> Box<I32> {\n      captured\n    }\n  }\n}\n",
  )
  assert(inferred.lambdas.length() == 2u32, "nested lambda count")
  assert(
    self_host_lambda_has_diagnostics(inferred.lambdas[1u32]),
    "nested structural capture mismatch diagnostic",
  )
}

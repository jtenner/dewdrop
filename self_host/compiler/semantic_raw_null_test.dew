open dew.std.testing
open dew.std.string_builder

fn self_host_raw_null_test_link(source: Bytes) -> SelfHostPlannedProgramWasmGCLink {
  let collected = self_host_collect_program_manifest(5100u64, {
    modules: [{
      path: "app.main"
      files: [{
        path: "main.dew"
        source: source
        test_only: false
      }]
    }]
  })
  assert(collected.diagnostics.length() == 0u32, "raw-null manifest parses")
  assert(collected.modules.at(0u32).diagnostic_count() == 0u32, "raw-null source parses and collects")
  let lowering = self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(collected))
  for value in lowering.modules {
    let module_ = self_host_planned_module_lowering_identity(value)
    if module_.inferred.diagnostics.length() > 0u32 {
      let diagnostic = module_.inferred.diagnostics[0u32]
      let report = StringBuilder::new()
      report.append("raw-null inference diagnostic: ")
      report.append(self_host_inference_diagnostic_name(diagnostic))
      report.append(" offset=")
      report.append_u32(diagnostic.offset())
      assert(false, report.finish())
    }
  }
  self_host_plan_program_wasmgc_link(self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, false)), false)
}

fn self_host_assert_raw_null_emits(source: Bytes) -> Unit {
  let link = self_host_raw_null_test_link(source)
  match build_self_host_linked_i32_module(link, 5100u64) {
    Ok(_) => {}
    Err(error) => assert(false, error)
  }
}

test "raw null tests and assertions emit validated reference instructions" {
  self_host_assert_raw_null_emits(
    b"builtin check(value: String) -> Bool = \"ref_is_null\"\npub fn main(value: String) -> Bool {\n check(value)\n}\n",
  )
  self_host_assert_raw_null_emits(
    b"builtin check(value: String) -> String = \"ref_as_non_null\"\npub fn main(value: String) -> String {\n check(value)\n}\n",
  )
  self_host_assert_raw_null_emits(
    b"pub builtin check(value: String) -> Bool = \"ref_is_null\"\npub builtin require(value: String) -> String = \"ref_as_non_null\"\npub fn main() -> I32 {\n 42i32\n}\n",
  )
}

test "raw null instructions reject scalar operands and wrong result carriers" {
  for source in [
    b"builtin check(value: I32) -> Bool = \"ref_is_null\"\npub fn main(value: I32) -> Bool {\n check(value)\n}\n",
    b"builtin check(value: String) -> I64 = \"ref_is_null\"\npub fn main(value: String) -> I64 {\n check(value)\n}\n",
    b"builtin check(value: I32) -> I32 = \"ref_as_non_null\"\npub fn main(value: I32) -> I32 {\n check(value)\n}\n",
    b"builtin check(value: String) -> I32 = \"ref_as_non_null\"\npub fn main(value: String) -> I32 {\n check(value)\n}\n"
  ] {
    let link = self_host_raw_null_test_link(source)
    match build_self_host_linked_i32_module(link, 5100u64) {
      Ok(_) => assert(false, "raw null operation accepted a wrong carrier")
      Err(error) => assert(error.contains("raw intrinsic input or result carrier does not match its opcode"), error)
    }
  }
}

test "raw null instructions reject wrong operand counts" {
  for source in [
    b"builtin check() -> Bool = \"ref_is_null\"\npub fn main() -> Bool {\n check()\n}\n",
    b"builtin check(left: String, right: String) -> String = \"ref_as_non_null\"\npub fn main(value: String) -> String {\n check(value, value)\n}\n"
  ] {
    let link = self_host_raw_null_test_link(source)
    match build_self_host_linked_i32_module(link, 5100u64) {
      Ok(_) => assert(false, "raw null operation accepted a wrong operand count")
      Err(error) => assert(error.contains("raw intrinsic operand count does not match its opcode"), error)
    }
  }
}

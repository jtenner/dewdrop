open dew.std.bytes
open dew.std.option
open dew.std.result

fn self_host_nested_literal_test_emit(source: Bytes) -> Bytes {
  let collected = self_host_collect_program_manifest(5100u64, {
    modules: [{
      path: "app.main"
      files: [{
        path: "main.dew"
        source: source
        test_only: false
      }]
    }]
  })
  assert(collected.diagnostics.length() == 0u32, "nested literal fixture manifest parses")
  assert(collected.modules.at(0u32).diagnostic_count() == 0u32, "nested literal fixture declarations parse")
  let lowering = self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(collected))
  match self_host_validate_program_inference(lowering) {
    Some(error) => assert(false, error)
    None => {}
  }
  let link = self_host_plan_program_wasmgc_link(self_host_plan_program_wasmgc_fragments(
    self_host_plan_program_specialization(lowering, false)), false)
  let bodies = self_host_plan_program_wasm_bodies(link)
  assert(bodies.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, bodies))
  match build_self_host_linked_i32_module(link, 5100u64) {
    Ok(bytes) => bytes
    Err(error) => {
      assert(false, error)
      b""
    }
  }
}

test "nested numeric literal emission integer minima unsigned bounds and positive prefix" {
  let bytes = self_host_nested_literal_test_emit(b"enum Box<t> {\n  Value(t)\n  Empty\n}\nfn i8(value: Box<I8>) -> Bool {\n  value is Box::Value(-128i8)\n}\nfn i16(value: Box<I16>) -> Bool {\n  value is Box::Value(-32768i16)\n}\nfn i32(value: Box<I32>) -> Bool {\n  value is Box::Value(-2147483648i32)\n}\nfn i64(value: Box<I64>) -> Bool {\n  value is Box::Value(-9223372036854775808i64)\n}\nfn u8(value: Box<U8>) -> Bool {\n  value is Box::Value(255u8)\n}\nfn u16(value: Box<U16>) -> Bool {\n  value is Box::Value(65535u16)\n}\nfn u32(value: Box<U32>) -> Bool {\n  value is Box::Value(4294967295u32)\n}\nfn u64(value: Box<U64>) -> Bool {\n  value is Box::Value(18446744073709551615u64)\n}\nfn positive(value: Box<I32>) -> Bool {\n  value is Box::Value(+42i32)\n}\nfn wrap_u8(value: Box<U8>) -> Bool {\n  value is Box::Value(-1u8)\n}\nfn wrap_u16(value: Box<U16>) -> Bool {\n  value is Box::Value(-1u16)\n}\nbuiltin stop() -> Never = \"unreachable\"\ntrait Neg {\n  fn neg(self) -> Self\n}\ntrait Pos {\n  fn pos(self) -> Self\n}\nimpl Neg for I32 {\n  fn neg(self) -> I32 {\n    stop()\n  }\n}\nimpl Pos for I32 {\n  fn pos(self) -> I32 {\n    stop()\n  }\n}\npub fn main() -> I32 {\n  if wrap_u8(Box::Value(255u8)) &&\n    !wrap_u8(Box::Value(254u8)) &&\n    wrap_u16(Box::Value(65535u16)) &&\n    !wrap_u16(Box::Value(65534u16)) &&\n    i8(Box::Value(-128i8)) &&\n    !i8(Box::Value(-127i8)) &&\n    !i8(Box::Empty) &&\n    i16(Box::Value(-32768i16)) &&\n    !i16(Box::Value(-32767i16)) &&\n    !i16(Box::Empty) &&\n    i32(Box::Value(-2147483648i32)) &&\n    !i32(Box::Value(-2147483647i32)) &&\n    !i32(Box::Empty) &&\n    i64(Box::Value(-9223372036854775808i64)) &&\n    !i64(Box::Value(-9223372036854775807i64)) &&\n    !i64(Box::Empty) &&\n    u8(Box::Value(255u8)) &&\n    !u8(Box::Value(254u8)) &&\n    !u8(Box::Empty) &&\n    u16(Box::Value(65535u16)) &&\n    !u16(Box::Value(65534u16)) &&\n    !u16(Box::Empty) &&\n    u32(Box::Value(4294967295u32)) &&\n    !u32(Box::Value(4294967294u32)) &&\n    !u32(Box::Empty) &&\n    u64(Box::Value(18446744073709551615u64)) &&\n    !u64(Box::Value(18446744073709551614u64)) &&\n    !u64(Box::Empty) &&\n    positive(Box::Value(+42i32)) &&\n    !positive(Box::Value(41i32)) &&\n    !positive(Box::Empty) {\n    42i32\n  } else {\n    0i32\n  }\n}\n")
  assert(bytes.byte_length() >= 8u32, "nested literal emission returns Wasm")
}

test "nested numeric literal emission F32 and F64 constants signs and signed zero" {
  let bytes = self_host_nested_literal_test_emit(b"enum Box<t> {\n  Value(t)\n  Empty\n}\nfn f32_negative(value: Box<F32>) -> Bool {\n  value is Box::Value(-1.5f32)\n}\nfn f32_positive(value: Box<F32>) -> Bool {\n  value is Box::Value(+1.5f32)\n}\nfn f32_direct(value: Box<F32>) -> Bool {\n  value is Box::Value(2.5f32)\n}\nfn f32_zero(value: Box<F32>) -> Bool {\n  value is Box::Value(-0.0f32)\n}\nfn f64_negative(value: Box<F64>) -> Bool {\n  value is Box::Value(-1.5f64)\n}\nfn f64_positive(value: Box<F64>) -> Bool {\n  value is Box::Value(+1.5f64)\n}\nfn f64_direct(value: Box<F64>) -> Bool {\n  value is Box::Value(2.5f64)\n}\nfn f64_zero(value: Box<F64>) -> Bool {\n  value is Box::Value(-0.0f64)\n}\npub fn main() -> I32 {\n  if f32_negative(Box::Value(-1.5f32)) &&\n    !f32_negative(Box::Value(1.5f32)) &&\n    !f32_negative(Box::Empty) &&\n    f32_positive(Box::Value(+1.5f32)) &&\n    !f32_positive(Box::Value(-1.5f32)) &&\n    !f32_positive(Box::Empty) &&\n    f32_direct(Box::Value(2.5f32)) &&\n    !f32_direct(Box::Value(1.5f32)) &&\n    !f32_direct(Box::Empty) &&\n    f32_zero(Box::Value(-0.0f32)) &&\n    !f32_zero(Box::Value(1.0f32)) &&\n    !f32_zero(Box::Empty) &&\n    f32_zero(Box::Value(0.0f32)) &&\n    f64_negative(Box::Value(-1.5f64)) &&\n    !f64_negative(Box::Value(1.5f64)) &&\n    !f64_negative(Box::Empty) &&\n    f64_positive(Box::Value(+1.5f64)) &&\n    !f64_positive(Box::Value(-1.5f64)) &&\n    !f64_positive(Box::Empty) &&\n    f64_direct(Box::Value(2.5f64)) &&\n    !f64_direct(Box::Value(1.5f64)) &&\n    !f64_direct(Box::Empty) &&\n    f64_zero(Box::Value(-0.0f64)) &&\n    !f64_zero(Box::Value(1.0f64)) &&\n    !f64_zero(Box::Empty) &&\n    f64_zero(Box::Value(0.0f64)) {\n    42i32\n  } else {\n    0i32\n  }\n}\n")
  assert(bytes.byte_length() >= 8u32, "nested literal emission returns Wasm")
}

test "nested numeric literal emission struct fields below an enum guard" {
  let bytes = self_host_nested_literal_test_emit(b"enum Box<t> {\n  Value(t)\n  Empty\n}\nstruct Pair {\n  low: I32\n  high: F64\n}\nenum Outer {\n  Wrap(Pair)\n  Empty\n}\nfn nested(value: Outer) -> Bool {\n  match value {\n    Outer::Wrap(Pair {\n      low: -2147483648i32\n      high: -1.5f64\n    }) => true\n    _ => false\n  }\n}\npub fn main() -> I32 {\n  if nested(Outer::Wrap(Pair::{\n      low: -2147483648i32\n      high: -1.5f64\n    })) &&\n    !nested(Outer::Wrap(Pair::{\n      low: -2147483647i32\n      high: -1.5f64\n    })) &&\n    !nested(Outer::Wrap(Pair::{\n      low: -2147483648i32\n      high: 1.5f64\n    })) &&\n    !nested(Outer::Empty) {\n    42i32\n  } else {\n    0i32\n  }\n}\n")
  assert(bytes.byte_length() >= 8u32, "nested literal emission returns Wasm")
}

pub fn self_host_emit_nested_numeric_literal_probe() -> Bytes {
  self_host_nested_literal_test_emit(b"enum Box<t> {\n  Value(t)\n  Empty\n}\nfn i8(value: Box<I8>) -> Bool {\n  value is Box::Value(-128i8)\n}\nfn i16(value: Box<I16>) -> Bool {\n  value is Box::Value(-32768i16)\n}\nfn i32(value: Box<I32>) -> Bool {\n  value is Box::Value(-2147483648i32)\n}\nfn i64(value: Box<I64>) -> Bool {\n  value is Box::Value(-9223372036854775808i64)\n}\nfn u8(value: Box<U8>) -> Bool {\n  value is Box::Value(255u8)\n}\nfn u16(value: Box<U16>) -> Bool {\n  value is Box::Value(65535u16)\n}\nfn u32(value: Box<U32>) -> Bool {\n  value is Box::Value(4294967295u32)\n}\nfn u64(value: Box<U64>) -> Bool {\n  value is Box::Value(18446744073709551615u64)\n}\nfn positive(value: Box<I32>) -> Bool {\n  value is Box::Value(+42i32)\n}\nfn f32_negative(value: Box<F32>) -> Bool {\n  value is Box::Value(-1.5f32)\n}\nfn f32_positive(value: Box<F32>) -> Bool {\n  value is Box::Value(+1.5f32)\n}\nfn f32_direct(value: Box<F32>) -> Bool {\n  value is Box::Value(2.5f32)\n}\nfn f32_zero(value: Box<F32>) -> Bool {\n  value is Box::Value(-0.0f32)\n}\nfn f64_negative(value: Box<F64>) -> Bool {\n  value is Box::Value(-1.5f64)\n}\nfn f64_positive(value: Box<F64>) -> Bool {\n  value is Box::Value(+1.5f64)\n}\nfn f64_direct(value: Box<F64>) -> Bool {\n  value is Box::Value(2.5f64)\n}\nfn f64_zero(value: Box<F64>) -> Bool {\n  value is Box::Value(-0.0f64)\n}\nstruct Pair {\n  low: I32\n  high: F64\n}\nenum Outer {\n  Wrap(Pair)\n  Empty\n}\nfn nested(value: Outer) -> Bool {\n  match value {\n    Outer::Wrap(Pair {\n      low: -2147483648i32\n      high: -1.5f64\n    }) => true\n    _ => false\n  }\n}\nfn wrap_u8(value: Box<U8>) -> Bool {\n  value is Box::Value(-1u8)\n}\nfn wrap_u16(value: Box<U16>) -> Bool {\n  value is Box::Value(-1u16)\n}\nbuiltin stop() -> Never = \"unreachable\"\ntrait Neg {\n  fn neg(self) -> Self\n}\ntrait Pos {\n  fn pos(self) -> Self\n}\nimpl Neg for I32 {\n  fn neg(self) -> I32 {\n    stop()\n  }\n}\nimpl Pos for I32 {\n  fn pos(self) -> I32 {\n    stop()\n  }\n}\npub fn main() -> I32 {\n  if wrap_u8(Box::Value(255u8)) &&\n    !wrap_u8(Box::Value(254u8)) &&\n    wrap_u16(Box::Value(65535u16)) &&\n    !wrap_u16(Box::Value(65534u16)) &&\n    i8(Box::Value(-128i8)) &&\n    !i8(Box::Value(-127i8)) &&\n    !i8(Box::Empty) &&\n    i16(Box::Value(-32768i16)) &&\n    !i16(Box::Value(-32767i16)) &&\n    !i16(Box::Empty) &&\n    i32(Box::Value(-2147483648i32)) &&\n    !i32(Box::Value(-2147483647i32)) &&\n    !i32(Box::Empty) &&\n    i64(Box::Value(-9223372036854775808i64)) &&\n    !i64(Box::Value(-9223372036854775807i64)) &&\n    !i64(Box::Empty) &&\n    u8(Box::Value(255u8)) &&\n    !u8(Box::Value(254u8)) &&\n    !u8(Box::Empty) &&\n    u16(Box::Value(65535u16)) &&\n    !u16(Box::Value(65534u16)) &&\n    !u16(Box::Empty) &&\n    u32(Box::Value(4294967295u32)) &&\n    !u32(Box::Value(4294967294u32)) &&\n    !u32(Box::Empty) &&\n    u64(Box::Value(18446744073709551615u64)) &&\n    !u64(Box::Value(18446744073709551614u64)) &&\n    !u64(Box::Empty) &&\n    positive(Box::Value(+42i32)) &&\n    !positive(Box::Value(41i32)) &&\n    !positive(Box::Empty) &&\n    f32_negative(Box::Value(-1.5f32)) &&\n    !f32_negative(Box::Value(1.5f32)) &&\n    !f32_negative(Box::Empty) &&\n    f32_positive(Box::Value(+1.5f32)) &&\n    !f32_positive(Box::Value(-1.5f32)) &&\n    !f32_positive(Box::Empty) &&\n    f32_direct(Box::Value(2.5f32)) &&\n    !f32_direct(Box::Value(1.5f32)) &&\n    !f32_direct(Box::Empty) &&\n    f32_zero(Box::Value(-0.0f32)) &&\n    !f32_zero(Box::Value(1.0f32)) &&\n    !f32_zero(Box::Empty) &&\n    f32_zero(Box::Value(0.0f32)) &&\n    f64_negative(Box::Value(-1.5f64)) &&\n    !f64_negative(Box::Value(1.5f64)) &&\n    !f64_negative(Box::Empty) &&\n    f64_positive(Box::Value(+1.5f64)) &&\n    !f64_positive(Box::Value(-1.5f64)) &&\n    !f64_positive(Box::Empty) &&\n    f64_direct(Box::Value(2.5f64)) &&\n    !f64_direct(Box::Value(1.5f64)) &&\n    !f64_direct(Box::Empty) &&\n    f64_zero(Box::Value(-0.0f64)) &&\n    !f64_zero(Box::Value(1.0f64)) &&\n    !f64_zero(Box::Empty) &&\n    f64_zero(Box::Value(0.0f64)) &&\n    nested(Outer::Wrap(Pair::{\n      low: -2147483648i32\n      high: -1.5f64\n    })) &&\n    !nested(Outer::Wrap(Pair::{\n      low: -2147483647i32\n      high: -1.5f64\n    })) &&\n    !nested(Outer::Wrap(Pair::{\n      low: -2147483648i32\n      high: 1.5f64\n    })) &&\n    !nested(Outer::Empty) {\n    42i32\n  } else {\n    0i32\n  }\n}\n")
}

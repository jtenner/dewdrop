open dew.std.bytes
open dew.std.option
open dew.std.result
open dew.std.string

builtin self_host_request_string_equals(
  left: String,
  right: String,
) -> Bool = "dew_string_equals"

fn self_host_unit() -> Unit {
}

fn self_host_request_u8_to_u32(value: U8) -> U32 {
  value.into()
}

struct SelfHostRequestReader {
  bytes: Bytes
  mut offset: U32
  mut error: Option<String>
}

pub struct SelfHostCompileRequest {
  output_path: String
  root_module: String
  manifest: SelfHostProgramManifest
  starshine_provider: Bytes
  compiler_fingerprint: Bytes
  test_mode: Bool
  default_preamble: Bool
}

fn self_host_request_manifest_module_count(
  manifest: SelfHostProgramManifest,
) -> U32 {
  manifest.modules.length()
}

fn self_host_request_manifest_module(
  manifest: SelfHostProgramManifest,
  index: U32,
) -> SelfHostManifestModule {
  manifest.modules[index]
}

fn self_host_request_manifest_file_count(
  module_: SelfHostManifestModule,
) -> U32 {
  module_.files.length()
}

fn self_host_request_manifest_file(
  module_: SelfHostManifestModule,
  index: U32,
) -> SelfHostManifestFile {
  module_.files[index]
}

impl SelfHostCompileRequest {
  fn root_module_index(self) -> Option<U32> {
    let root = self.root_module
    let mut found = 4294967295u32
    let mut module_index = 0u32
    let module_count = self_host_request_manifest_module_count(self.manifest)
    while module_index {
      current => if current < module_count {
        let module_ = self_host_request_manifest_module(self.manifest, current)
        if self_host_request_string_equals(module_.path, root) {
          found = current
          break self_host_unit()
        }
        continue current + 1u32
      } else {
        break self_host_unit()
      }
    }
    if found < module_count {
      Option::Some(found)
    } else {
      Option::None
    }
  }

  fn root_source(self) -> Option<Bytes> {
    let root = self.root_module
    let mut module_index = 0u32
    let module_count = self_host_request_manifest_module_count(self.manifest)
    let _ = while module_index {
      current => if current < module_count {
        let module_ = self_host_request_manifest_module(self.manifest, current)
        if self_host_request_string_equals(module_.path, root) && self_host_u32_greater(
          self_host_request_manifest_file_count(module_),
          0u32,
        ) {
          return Option::Some(
            self_host_request_manifest_file(module_, 0u32).source,
          )
        }
        continue current + 1u32
      } else {
        break self_host_unit()
      }
    }
    Option::None
  }
}

fn self_host_reader_fail(reader: SelfHostRequestReader, message: String) -> Unit {
  if reader.error is Option::None {
    reader.error = Option::Some(message)
  } else {
  }
}

fn self_host_reader_remaining(reader: SelfHostRequestReader) -> U32 {
  reader.bytes.byte_length() - reader.offset
}

fn self_host_reader_u32(reader: SelfHostRequestReader) -> U32 {
  if self_host_reader_remaining(reader) < 4u32 {
    self_host_reader_fail(reader, "truncated compile request")
    0u32
  } else {
    let value = self_host_request_u8_to_u32(reader.bytes.byte_at(reader.offset)) |
      (self_host_request_u8_to_u32(reader.bytes.byte_at(reader.offset + 1u32)) << 8u32) |
      (self_host_request_u8_to_u32(reader.bytes.byte_at(reader.offset + 2u32)) << 16u32) |
      (self_host_request_u8_to_u32(reader.bytes.byte_at(reader.offset + 3u32)) << 24u32)
    reader.offset = reader.offset + 4u32
    value
  }
}

fn self_host_reader_count(
  reader: SelfHostRequestReader,
  maximum: U32,
  kind: String,
) -> U32 {
  let value = self_host_reader_u32(reader)
  if value > maximum {
    self_host_reader_fail(reader, kind.concat(" exceeds its count bound"))
    0u32
  } else {
    value
  }
}

fn self_host_reader_bool(reader: SelfHostRequestReader, kind: String) -> Bool {
  match self_host_reader_u32(reader) {
    0u32 => false
    1u32 => true
    _ => {
      self_host_reader_fail(reader, kind.concat(" is not a Boolean flag"))
      false
    }
  }
}

fn self_host_reader_bytes(
  reader: SelfHostRequestReader,
  maximum: U32,
  kind: String,
) -> Bytes {
  let length = self_host_reader_u32(reader)
  if length > maximum {
    self_host_reader_fail(reader, kind.concat(" exceeds its byte bound"))
    b""
  } else if length > self_host_reader_remaining(reader) {
    self_host_reader_fail(reader, kind.concat(" has an invalid byte range"))
    b""
  } else {
    let value = reader.bytes.slice(reader.offset, reader.offset + length)
    reader.offset = reader.offset + length
    value
  }
}

fn self_host_reader_string(
  reader: SelfHostRequestReader,
  maximum: U32,
  kind: String,
) -> String {
  let value = self_host_reader_bytes(reader, maximum, kind)
  if value.is_valid_utf8() {
    value.to_string()
  } else {
    self_host_reader_fail(reader, kind.concat(" is not UTF-8"))
    ""
  }
}

fn self_host_reader_expect(
  reader: SelfHostRequestReader,
  expected: U32,
  kind: String,
) -> Unit {
  if self_host_reader_u32(reader) != expected {
    self_host_reader_fail(reader, "unsupported ".concat(kind))
  } else {
  }
}

fn self_host_skip_dependencies(reader: SelfHostRequestReader) -> Unit {
  let count = self_host_reader_count(reader, 4096u32, "dependency count")
  while 0u32 {
    index if index < count => {
      let _module = self_host_reader_string(reader, 255u32, "dependency module")
      let _fingerprint = self_host_reader_string(reader, 64u32, "dependency fingerprint")
      continue index + 1u32
    }
    _ => break self_host_unit()
  }
}

fn self_host_read_providers(reader: SelfHostRequestReader) -> Option<Bytes> {
  let count = self_host_reader_count(reader, 64u32, "provider count")
  let mut starshine = Option::None
  while 0u32 {
    index if index < count => {
      let name = self_host_reader_string(reader, 255u32, "provider name")
      let wasm = self_host_reader_bytes(reader, 67108864u32, "provider Wasm")
      if name.equals("starshine") {
        if starshine is Option::Some(_) {
          self_host_reader_fail(reader, "duplicate starshine provider")
        } else {
          starshine = Option::Some(wasm)
        }
      } else {
      }
      continue index + 1u32
    }
    _ => break starshine
  }
}

pub fn decode_self_host_compile_request(
  bytes: Bytes,
) -> Result<SelfHostCompileRequest, String> {
  if bytes.byte_length() > 268435456u32 {
    return Result::Err("compile request exceeds 256 MiB")
  } else {
  }
  let reader = SelfHostRequestReader::{
    bytes: bytes
    offset: 0u32
    error: Option::None
  }
  self_host_reader_expect(reader, 1146569554u32, "compile request magic")
  self_host_reader_expect(reader, 1u32, "compile request version")
  self_host_reader_expect(reader, 1u32, "compile request command")
  self_host_reader_expect(reader, 0u32, "compile request output kind")
  self_host_reader_expect(reader, 1u32, "compile request response mode")
  let output_path = self_host_reader_string(reader, 4096u32, "output path")
  let root_module = self_host_reader_string(reader, 255u32, "root module")
  if output_path.byte_length() == 0u32 || root_module.byte_length() == 0u32 {
    self_host_reader_fail(reader, "compile request output and root module must not be empty")
  } else {
  }
  let module_count = self_host_reader_count(reader, 1024u32, "module count")
  if module_count == 0u32 {
    self_host_reader_fail(reader, "compile request has no modules")
  } else {
  }
  let mut total_files = 0u32
  let manifest_modules = []
  while 0u32 {
    module_index if module_index < module_count => {
      let module_name = self_host_reader_string(reader, 255u32, "module name")
      let file_count = self_host_reader_count(reader, 4096u32, "file count")
      let manifest_files = []
      if file_count == 0u32 || total_files > 65536u32 - file_count {
        self_host_reader_fail(reader, "compile request file count is outside its bound")
      } else {
        total_files = total_files + file_count
      }
      while 0u32 {
        file_index if file_index < file_count => {
          let logical_path = self_host_reader_string(reader, 4096u32, "logical path")
          let source = self_host_reader_bytes(reader, 16777216u32, "source")
          manifest_files.push(SelfHostManifestFile::{
            path: logical_path
            source: source
            test_only: false
          })
          continue file_index + 1u32
        }
        _ => break self_host_unit()
      }
      manifest_modules.push(SelfHostManifestModule::{
        path: module_name
        files: manifest_files
      })
      continue module_index + 1u32
    }
    _ => break self_host_unit()
  }
  self_host_skip_dependencies(reader)
  let starshine = self_host_read_providers(reader)
  self_host_reader_expect(reader, 0u32, "standard-library mode")
  let identity = self_host_reader_bytes(reader, 32u32, "standard-library identity")
  if identity.byte_length() != 32u32 {
    self_host_reader_fail(reader, "invalid standard-library identity")
  } else {
  }
  self_host_reader_expect(reader, 0u32, "optimization mode")
  self_host_reader_expect(reader, 0u32, "diagnostics mode")
  let test_mode = self_host_reader_bool(reader, "test mode")
  let default_preamble = self_host_reader_bool(reader, "default preamble")
  self_host_reader_expect(reader, 0u32, "cache policy")
  let _cache_report = self_host_reader_bool(reader, "cache report")
  let compiler_fingerprint = self_host_reader_bytes(
    reader,
    4096u32,
    "compiler fingerprint",
  )
  if compiler_fingerprint.byte_length() == 0u32 {
    self_host_reader_fail(reader, "compiler fingerprint must not be empty")
  } else if reader.offset != reader.bytes.byte_length() {
    self_host_reader_fail(reader, "trailing bytes in compile request")
  } else {
  }
  match reader.error {
    Option::Some(error) => Result::Err(error)
    Option::None => match starshine {
      Option::None => Result::Err("compile request has no starshine provider")
      Option::Some(provider) => {
        let request = SelfHostCompileRequest::{
          output_path: output_path
          root_module: root_module
          manifest: SelfHostProgramManifest::{
            modules: manifest_modules
          }
          starshine_provider: provider
          compiler_fingerprint: compiler_fingerprint
          test_mode: test_mode
          default_preamble: default_preamble
        }
        match request.root_module_index() {
          Option::None => Result::Err("root module is missing from manifest")
          Option::Some(module_index) => if self_host_u32_equal(
            self_host_request_manifest_file_count(
              self_host_request_manifest_module(request.manifest, module_index),
            ),
            0u32,
          ) {
            Result::Err("root module has no source file")
          } else {
            Result::Ok(request)
          }
        }
      }
    }
  }
}

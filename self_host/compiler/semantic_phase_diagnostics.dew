open dew.std.option

fn self_host_inference_diagnostic_name(diagnostic: SelfHostBodyInferenceDiagnostic) -> String {
  match diagnostic {
    AmbiguousMethod(_, _, _, _, _, _) => "ambiguous method"
    NoMatchingMethod(_, _, _) => "no matching method"
    TraitObligationFailure(_, _, message, _) => message
    UnsupportedExpressionInference(_, _) => "unsupported expression"
    BodyConstraintDiagnostic(_) => "type constraint"
    UnresolvedExpressionType(_, _) => "unresolved expression"
    ReturnOutsideCallable(_) => "return outside callable"
    UnresolvedLocalType(_, _, _) => "unresolved local"
    UnknownVariantValue(_, _, _) => "no matching enum constructor"
    UnknownVariantForType(_, _, _, _) => "enum constructor does not belong to the expected type"
    AmbiguousVariantValue(_, _, _, _, _, _) => "ambiguous enum constructor; supply its type"
    AmbiguousPatternVariant(_, _, _, _, _, _) => "ambiguous enum pattern; supply its type"
    InvalidPatternConstructor(_, _) => "invalid pattern constructor"
    InvalidAssignmentTarget(_, _) => "invalid assignment target"
    ImmutableAssignmentTarget(_, _) => "immutable assignment target"
    NoMatchingFunctionReference(_, _, _) => "no matching constructor function"
    AmbiguousFunctionReference(_, _, _, _, _, _) => "ambiguous constructor function"
    NoMatchingDirectCall(_, _, _) => "no matching direct call"
    AmbiguousDirectCall(_, _, _, _, _, _) => "ambiguous direct call"
    CallArgumentCountMismatch(_, _, _, _, _) => "call argument count"
    CallTypeArgumentCountMismatch(_, _, _, _, _) => "call type argument count"
    FieldAccessRequiresNominal(_, _) => "field requires nominal"
    UnknownFieldForType(_, _, _, _) => "unknown field"
    ObjectTypeRequired(_, _) => "struct literal requires an expected type"
    InvalidConstructionTarget(_, _) => "invalid construction target"
    MissingConstructionField(_, _, _, _) => "missing construction field"
    MissingImportedConstructionField(_, _, _, _) => "missing imported construction field"
    NoMatchingOperator(_, _) => "no matching operator"
    AmbiguousOperator(_, _, _, _, _) => "ambiguous operator"
    ParameterLocalHasErrorType(_, _, _, _, _) => "parameter has error type"
    InvalidParameterResolvedType(_, _, _, _, _, _) => "invalid parameter type"
    UnresolvedModuleValue(_, _) => "unresolved module value"
    _ => "inference error"
  }
}

fn self_host_inference_diagnostic_expression(diagnostic: SelfHostBodyInferenceDiagnostic) -> Option<U32> {
  match diagnostic {
    CallTypeArgumentCountMismatch(expression, _, _, _, _) => Some(expression)
    UnsupportedExpressionInference(expression, _) => Some(expression)
    UnresolvedExpressionType(expression, _) => Some(expression)
    InvalidAssignmentTarget(expression, _) => Some(expression)
    ImmutableAssignmentTarget(expression, _) => Some(expression)
    ObjectTypeRequired(expression, _) => Some(expression)
    InvalidConstructionTarget(expression, _) => Some(expression)
    NoMatchingMethod(_, expression, _) => Some(expression)
    TraitObligationFailure(_, expression, _, _) => Some(expression)
    NoMatchingDirectCall(expression, _, _) => Some(expression)
    NoMatchingOperator(expression, _) => Some(expression)
    AmbiguousOperator(expression, _, _, _, _) => Some(expression)
    AmbiguousMethod(_, expression, _, _, _, _) => Some(expression)
    BodyConstraintDiagnostic(constraint) => {
      let origin = match constraint {
        LocalTypeMismatch(_, _, origin) => origin
        InfiniteLocalType(_, _, origin) => origin
        InvalidLocalMemberProjection(_, _, origin) => origin
      }
      match origin.kind {
        ExpressionTypeConstraint => Some(origin.source)
        CallTypeConstraint => Some(origin.source)
        OperatorTypeConstraint => Some(origin.source)
        _ => None
      }
    }
    _ => None
  }
}

fn self_host_validate_program_inference(lowering: SelfHostPlannedProgramLowering) -> Option<String> {
  let report = StringBuilder::new()
  let mut errors = 0u32
  for raw_module in lowering.modules {
    let module_ = self_host_planned_module_lowering_identity(raw_module)
    let count = module_.inferred.diagnostics.length()
    let name_count = module_.name_diagnostics.length()
    let type_count = module_.resolved_types.diagnostics.length()
    errors = errors + count + name_count + type_count
    if count > 0u32 || name_count > 0u32 || type_count > 0u32 {
      report.append("\nmodule=")
      report.append_u64(module_.module_id)
      report.append(" names=")
      report.append_u32(name_count)
      report.append(" signatures=")
      report.append_u32(type_count)
      report.append(" inference=")
      report.append_u32(count)
      let mut signature_shown = 0u32
      for diagnostic in module_.resolved_types.diagnostics {
        if signature_shown < 4u32 {
          report.append("\n  signature rank=")
          report.append_u32(diagnostic.rank())
          report.append(" offset=")
          report.append_u32(diagnostic.offset())
          match diagnostic {
            UnknownType(name, owner, _) => {
              report.append(" name-index=")
              report.append_u32(name)
              report.append(" owner=")
              report.append_u64(owner)
            }
            TypeArityMismatch(type_, expected, actual, owner, _) => {
              report.append(" type=")
              report.append_u32(type_)
              report.append(" expected=")
              report.append_u32(expected)
              report.append(" actual=")
              report.append_u32(actual)
              report.append(" owner=")
              report.append_u64(owner)
            }
            ComputedTypeFailure(owner, message, _) => {
              report.append(" owner=")
              report.append_u64(owner)
              report.append(" message=")
              report.append(message)
            }
            _ => {}
          }
          signature_shown = signature_shown + 1u32
        }
      }
      let kinds = []
      let counts = []
      for diagnostic in module_.inferred.diagnostics {
        let kind = self_host_inference_diagnostic_name(diagnostic)
        let index = while 0u32 {
          current => if current < kinds.length() && kinds[current] != kind {
            continue current + 1u32
          } else {
            break current
          }
        }
        if index == kinds.length() {
          kinds.push(kind)
          counts.push(1u32)
        } else {
          counts[index] = counts[index] + 1u32
        }
      }
      let mut kind_index = 0u32
      for kind in kinds {
        report.append("\n  count ")
        report.append(kind)
        report.append("=")
        report.append_u32(counts[kind_index])
        kind_index = kind_index + 1u32
      }
      let shown = []
      for kind in kinds {
        let _ = kind
        shown.push(0u32)
      }
      for diagnostic in module_.inferred.diagnostics {
        let kind = self_host_inference_diagnostic_name(diagnostic)
        let kind_slot = while 0u32 {
          current => if current < kinds.length() && kinds[current] != kind {
            continue current + 1u32
          } else {
            break current
          }
        }
        if shown[kind_slot] < 32u32 {
          report.append("\n  ")
          report.append(self_host_inference_diagnostic_name(diagnostic))
          report.append(" offset=")
          report.append_u32(diagnostic.offset())
          match self_host_inference_diagnostic_expression(diagnostic) {
            Some(expression) => match lowering.index.module_index(module_.module_id) {
              Some(module_index) => {
                let collected = self_host_program_collected_module_at(lowering.collected, module_index)
                if expression < collected.expression_files.length() {
                  let file = collected.expression_files[expression]
                  let mut file_index = 0u32
                  for candidate in collected.files {
                    if self_host_u64_equal(candidate, file) {
                      report.append(" file=")
                      report.append(collected.file_paths[file_index])
                    }
                    file_index = file_index + 1u32
                  }
                }
                report.append(" expression=")
                report.append_u32(expression)
                if expression < module_.expressions.length() {
                  let planned = self_host_program_specialization_expression(module_, expression)
                  report.append(" kind=")
                  report.append(self_host_body_expression_kind_name(planned.kind))
                  match collected.expressions[expression] {
                    CallExpr(target, _, _) => match collected.expressions[target] {
                      FieldExpr(receiver, _, _) => {
                        let value = self_host_program_specialization_expression(module_, receiver)
                        report.append(" receiver=")
                        report.append_u32(receiver)
                        report.append(" receiver-type=")
                        report.append_i32(value.type_)
                        report.append(" receiver-kind=")
                        report.append(self_host_body_expression_kind_name(value.kind))
                      }
                      _ => {}
                    }
                    _ => {}
                  }
                }
              }
              None => {}
            }
            None => {}
          }
          match diagnostic {
            AmbiguousVariantValue(name, _, first, second, count, _), AmbiguousPatternVariant(name, _, first, second, count, _) => {
              report.append(" name=")
              report.append(module_.names[name])
              report.append(" candidates=")
              report.append_u32(count)
              self_host_append_variant_candidate(report, lowering.collected, first)
              self_host_append_variant_candidate(report, lowering.collected, second)
            }
            UnknownVariantForType(_, owner, _, _) => {
              report.append(" expected-owner=")
              report.append_u64(owner)
            }
            BodyConstraintDiagnostic(constraint) => match constraint {
              LocalTypeMismatch(left, right, _) => {
                report.append(" left-type=")
                report.append_i32(left)
                report.append(" left-shape=")
                report.append(self_host_linked_shape_name(self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, left)))
                report.append(" right-type=")
                report.append_i32(right)
                report.append(" right-shape=")
                report.append(self_host_linked_shape_name(self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, right)))
              }
              _ => {}
            }
            AmbiguousMethod(_, _, first, second, count, _) => {
              report.append(" first=")
              report.append_u64(first)
              report.append(" second=")
              report.append_u64(second)
              report.append(" candidates=")
              report.append_u32(count)
            }
            _ => {}
          }
          shown[kind_slot] = shown[kind_slot] + 1u32
        }
      }
    }
  }
  if errors == 0u32 {
    None
  } else {
    let message = StringBuilder::new()
    message.append("INV-002: semantic diagnostics must be resolved before specialization; count=")
    message.append_u32(errors)
    message.append(report.finish())
    Some(message.finish())
  }
}

fn self_host_append_variant_candidate(report: StringBuilder, program: SelfHostCollectedProgram, variant: U64) -> Unit {
  let _ = while 0u32 {
    index if index < program.modules.length() => {
      let module_ = program.modules.at(index)
      if module_.module_id == self_host_semantic_id_module(variant) {
        let slot = self_host_semantic_id_local(variant)
        self_host_assert_compiler_invariant(slot < module_.variants.length(), "diagnostic variant has an exact owner")
        let value = module_.variants[slot]
        match module_.declaration_reference(value.declaration) {
          Some(TopLevel(owner)) => {
            report.append(" ")
            report.append(program.module_paths[index])
            report.append(".")
            report.append(module_.name(owner.name))
            report.append("::")
            report.append(module_.name(value.name))
          }
          _ => unreachable()
        }
        return
      }
      continue index + 1u32
    }
    _ => break ()
  }
}

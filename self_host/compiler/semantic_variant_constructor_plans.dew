pub struct SelfHostPhysicalVariantConstructorPlan {
  expression: U32
  declaration: U64
  physical_type: U32
  arguments: SelfHostHirSpan
  operands: SelfHostHirSpan
}

pub struct SelfHostPhysicalVariantConstructorOperand {
  expression: U32
  declaration: U64
  source_ordinal: U32
  field_index: U32
  storage: SelfHostPlannedWasmStorageType
  box_type: Option<U32>
  unit_marker: Bool
  reference_cast: Option<U32>
}

fn self_host_variant_constructor_arguments(source: SelfHostPlannedExpression) -> Option<SelfHostHirSpan> {
  if !(source.selection is VariantConstructionBasicExpressionSelection(_, _, _)) {
    return None
  }
  match source.kind {
    PlannedDirectCall(_, _, arguments, _) => Some(arguments)
    PlannedFunctionValueCall(_, arguments, _) => Some(arguments)
    PlannedUnresolvedCall(_, arguments) => Some(arguments)
    _ => None
  }
}

fn self_host_build_variant_constructor_recipes(link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, plan: SelfHostPlannedPhysicalBodyCarrierPlan, constructors: Array<SelfHostPhysicalVariantConstructorPlan>, operands: Array<SelfHostPhysicalVariantConstructorOperand>) -> Unit {
  for value in plan.expressions {
    let expression = value.expression
    if !(self_host_checked_relative_index(expression, body.expressions, module_.expressions.length()) is Some(_)) {
      self_host_constructor_field_failure(module_, body, expression, 6u32, 102u32, u32_into_u64(body.expressions.start), u32_into_u64(expression), u32_into_u64(body.expressions.length))
    }
    let source = module_.expressions[expression]
    match self_host_variant_constructor_arguments(source) {
      Some(arguments) => self_host_plan_variant_constructor(link, module_, body, plan, value, source, arguments, constructors, operands)
      None => {}
    }
  }
}

fn self_host_plan_variant_constructor(link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, plan: SelfHostPlannedPhysicalBodyCarrierPlan, value: SelfHostPlannedPhysicalExpressionCarrier, source: SelfHostPlannedExpression, arguments: SelfHostHirSpan, constructors: Array<SelfHostPhysicalVariantConstructorPlan>, operands: Array<SelfHostPhysicalVariantConstructorOperand>) -> Unit {
  let expression = value.expression
  let declaration = match source.selection {
    VariantConstructionBasicExpressionSelection(selected, _, _) => selected
    _ => self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, 1u64, 0u64, 30u64)
  }
  let type_index = value.selected_type_index
  if type_index == 4294967295u32 {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, 1u64, 0u64, 31u64)
  }
  if type_index >= link.types.length() {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 504u32, u32_into_u64(link.types.length()), u32_into_u64(type_index), 32u64)
  }
  let linked = link.types[type_index]
  if linked.type_index != type_index {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 504u32, u32_into_u64(type_index), u32_into_u64(linked.type_index), 33u64)
  }
  if linked.module_index >= link.fragments.modules.length() {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 101u32, u32_into_u64(link.fragments.modules.length()), u32_into_u64(linked.module_index), 34u64)
  }
  let fragment = link.fragments.modules[linked.module_index]
  if linked.fragment_index >= fragment.physical_types.length() {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 101u32, u32_into_u64(fragment.physical_types.length()), u32_into_u64(linked.fragment_index), 35u64)
  }
  let physical = fragment.physical_types[linked.fragment_index]
  let actual = match physical.kind {
    PlannedWasmEnumSubtypeType(_, selected, _) => selected
    _ => self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, declaration, 0u64, 36u64)
  }
  if actual != declaration {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, declaration, actual, 37u64)
  }
  if !self_host_array_span_is_valid(arguments.start, arguments.length, module_.expression_children.length()) {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 101u32, u32_into_u64(module_.expression_children.length()), u32_into_u64(arguments.length), u32_into_u64(arguments.start))
  }
  if !self_host_array_span_is_valid(physical.fields.start, physical.fields.length, fragment.fields.length()) {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 403u32, u32_into_u64(fragment.fields.length()), u32_into_u64(physical.fields.length), u32_into_u64(physical.fields.start))
  }
  // Declared tuple payloads have one storage field for every source argument.
  // Unit still evaluates and supplies a marker; Never was lowered to a prefix.
  if arguments.length != physical.fields.length {
    self_host_constructor_field_failure(module_, body, expression, 6u32, 703u32, u32_into_u64(physical.fields.length), u32_into_u64(arguments.length), 38u64)
  }
  let start = operands.length()
  while 0u32 {
    index if index < arguments.length => {
      let child = module_.expression_children[arguments.start + index]
      if !(self_host_checked_relative_index(child, body.expressions, module_.expressions.length()) is Some(_)) {
        self_host_constructor_field_failure(module_, body, expression, 6u32, 102u32, u32_into_u64(body.expressions.start), u32_into_u64(child), u32_into_u64(body.expressions.length))
      }
      let field = fragment.fields[physical.fields.start + index]
      let position = match field.role {
        WasmVariantPayloadField(selected, ordinal) => {
          if selected != declaration {
            self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, declaration, selected, u32_into_u64(index))
          }
          ordinal
        }
        _ => self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, declaration, 0u64, u32_into_u64(index))
      }
      if field.declaration != declaration {
        self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, declaration, field.declaration, u32_into_u64(index))
      }
      if position != index || field.physical_index != index {
        self_host_constructor_field_failure(module_, body, expression, 6u32, 608u32, u32_into_u64(index), u32_into_u64(position), u32_into_u64(field.physical_index))
      }
      let carrier = match self_host_body_plan_expression(plan, child) {
        Some(operand) => operand.carrier
        None => self_host_constructor_field_failure(module_, body, expression, 6u32, 610u32, 1u64, 0u64, u32_into_u64(child))
      }
      let expected = self_host_body_carrier_from_storage(field.storage)
      let box_type = self_host_linked_variant_payload_box_type(link, field, carrier)
      let unit_marker = self_host_linked_variant_unit_storage(link, field, carrier)
      if !unit_marker && !(box_type is Some(_)) && !self_host_body_carrier_equal(carrier, expected) {
        self_host_constructor_field_failure(module_, body, expression, 6u32, 705u32, self_host_body_carrier_code(expected), self_host_body_carrier_code(carrier), u32_into_u64(index))
      }
      let mut reference_cast = None
      if !unit_marker && field.exact_nominal && field.storage is WasmNullableEqRefStorage {
        let nominal = self_host_linked_field_value_nominal_declaration(link, {
          type_index: type_index
          field_index: index
        })
        match self_host_linked_nominal_field_type_index(link, nominal, field.exact_nominal) {
          Some(payload_type) => if payload_type < type_index {
            reference_cast = Some(payload_type)
          }
          None => {}
        }
      }
      operands.push({
        expression: child
        declaration: declaration
        source_ordinal: index
        field_index: index
        storage: field.storage
        box_type: box_type
        unit_marker: unit_marker
        reference_cast: reference_cast
      })
      continue index + 1u32
    }
    _ => break ()
  }
  constructors.push({
    expression: expression
    declaration: declaration
    physical_type: type_index
    arguments: arguments
    operands: {
      start: start
      length: operands.length() - start
    }
  })
}

open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.result

// Logical identity is independent of the physical Wasm carrier.
pub enum SelfHostCompileTimeType {
  ErrorCompileTimeType
  UnknownCompileTimeType
  PrimitiveCompileTimeType(SelfHostPrimitiveType)
  ParameterCompileTimeType(U64)
  NominalCompileTimeType(U64)
  TraitCompileTimeType(U64)
  ProductCompileTimeType(Array<SelfHostCompileTimeType>)
  AppliedCompileTimeType(SelfHostCompileTimeType, Array<SelfHostCompileTimeType>)
  FunctionCompileTimeType(Array<SelfHostCompileTimeType>, SelfHostCompileTimeType)
  MemberProjectionCompileTimeType(SelfHostCompileTimeType, Bytes, String)
}

pub enum SelfHostCompileTimeConstant {
  BoolCompileTimeConstant(Bool)
  U32CompileTimeConstant(U32)
  NamesCompileTimeConstant(Array<Bytes>)
}

struct SelfHostCompileTimeTypePair {
  left: SelfHostCompileTimeType
  right: SelfHostCompileTimeType
}

fn self_host_empty_compile_time_types() -> Array<SelfHostCompileTimeType> {
  []
}

fn self_host_compile_time_type_query_arity(name: Bytes) -> Option<U32> {
  // Most calls inspect an ordinary Wasm opcode. Reject its namespace before
  // constructing any query-name literals.
  if name.byte_length() < 6u32 || name.byte_at(0u32) != 116u8 ||
    name.byte_at(1u32) != 121u8 || name.byte_at(2u32) != 112u8 ||
    name.byte_at(3u32) != 101u8 || name.byte_at(4u32) != 115u8 ||
    name.byte_at(5u32) != 46u8 {
    return None
  }
  if name == b"types.type_equal" || name == b"types.can_bitcast" || name == b"types.implements" {
    return Some(2u32)
  }
  if name == b"types.is_unit" || name == b"types.is_never" ||
    name == b"types.is_integer" || name == b"types.is_signed_integer" ||
    name == b"types.is_float" || name == b"types.bit_width" ||
    name == b"types.lane_count" || name == b"types.lane_bit_width" ||
    name == b"types.tuple_length" || name == b"types.field_names" ||
    name == b"types.variant_names" || name == b"types.size_of" ||
    name == b"types.align_of" || name == b"types.field_offset" {
    return Some(1u32)
  }
  None
}

// Iterative traversal avoids using the host call stack for nested type trees.
fn self_host_compile_time_types_concrete(types: Array<SelfHostCompileTimeType>) -> Result<Bool, String> {
  let work = types.copy()
  let mut concrete = true
  let mut steps = 0u32
  while work.length() {
    length => if length > 0u32 {
      if steps >= 65536u32 {
        return Err("CT-002 type query traversal limit exceeded")
      }
      steps = steps + 1u32
      let value = work[length - 1u32]
      work.truncate(length - 1u32)
      match value {
        ErrorCompileTimeType => return Err("CT-002 erroneous type query argument")
        UnknownCompileTimeType => {
          concrete = false
        }
        ParameterCompileTimeType(_) => {
          concrete = false
        }
        MemberProjectionCompileTimeType(owner, _, _) => {
          concrete = false
          work.push(owner)
        }
        ProductCompileTimeType(fields) => {
          for field in fields {
            work.push(field)
          }
        }
        AppliedCompileTimeType(base, arguments) => {
          work.push(base)
          for argument in arguments {
            work.push(argument)
          }
        }
        FunctionCompileTimeType(arguments, result) => {
          work.push(result)
          for argument in arguments {
            work.push(argument)
          }
        }
        _ => {}
      }
      continue work.length()
    } else {
      break Ok(concrete)
    }
  }
}

fn self_host_compile_time_types_equal(left: SelfHostCompileTimeType, right: SelfHostCompileTimeType) -> Result<Bool, String> {
  let work = [SelfHostCompileTimeTypePair::{
    left: left
    right: right
  }]
  let mut steps = 0u32
  while work.length() {
    length => if length > 0u32 {
      if steps >= 65536u32 {
        return Err("CT-002 type equality traversal limit exceeded")
      }
      steps = steps + 1u32
      let pair = work[length - 1u32]
      work.truncate(length - 1u32)
      let fields = self_host_empty_compile_time_types()
      let others = self_host_empty_compile_time_types()
      let same = match pair.left {
        MemberProjectionCompileTimeType(owner, operation, selector) => match pair.right {
          MemberProjectionCompileTimeType(other, other_operation, other_selector) => {
            work.push({
              left: owner
              right: other
            })
            operation == other_operation && selector == other_selector
          }
          _ => false
        }
        ErrorCompileTimeType => return Err("CT-002 erroneous type equality argument")
        UnknownCompileTimeType => pair.right is UnknownCompileTimeType
        ParameterCompileTimeType(id) => match pair.right {
          ParameterCompileTimeType(other) => id == other
          _ => false
        }
        NominalCompileTimeType(id) => match pair.right {
          NominalCompileTimeType(other) => id == other
          _ => false
        }
        TraitCompileTimeType(id) => match pair.right {
          TraitCompileTimeType(other) => id == other
          _ => false
        }
        PrimitiveCompileTimeType(primitive) => match pair.right {
          PrimitiveCompileTimeType(other) => primitive.rank() == other.rank()
          _ => false
        }
        ProductCompileTimeType(values) => match pair.right {
          ProductCompileTimeType(candidates) => {
            for value in values {
              fields.push(value)
            }
            for value in candidates {
              others.push(value)
            }
            true
          }
          _ => false
        }
        AppliedCompileTimeType(base, values) => match pair.right {
          AppliedCompileTimeType(other, candidates) => {
            fields.push(base)
            others.push(other)
            for value in values {
              fields.push(value)
            }
            for value in candidates {
              others.push(value)
            }
            true
          }
          _ => false
        }
        FunctionCompileTimeType(values, result) => match pair.right {
          FunctionCompileTimeType(candidates, other) => {
            fields.push(result)
            others.push(other)
            for value in values {
              fields.push(value)
            }
            for value in candidates {
              others.push(value)
            }
            true
          }
          _ => false
        }
      }
      if !same || fields.length() != others.length() {
        return Ok(false)
      }
      let _ = while 0u32 {
        index => if index < fields.length() {
          work.push({
            left: fields[index]
            right: others[index]
          })
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue work.length()
    } else {
      break Ok(true)
    }
  }
}

fn self_host_compile_time_lanes(primitive: SelfHostPrimitiveType) -> Option<(U32, U32)> {
  match primitive {
    I8x4Type => Some((4u32, 8u32))
    U8x4Type => Some((4u32, 8u32))
    I16x2Type => Some((2u32, 16u32))
    U16x2Type => Some((2u32, 16u32))
    I8x8Type => Some((8u32, 8u32))
    U8x8Type => Some((8u32, 8u32))
    I16x4Type => Some((4u32, 16u32))
    U16x4Type => Some((4u32, 16u32))
    I32x2Type => Some((2u32, 32u32))
    U32x2Type => Some((2u32, 32u32))
    I8x16Type => Some((16u32, 8u32))
    U8x16Type => Some((16u32, 8u32))
    I16x8Type => Some((8u32, 16u32))
    U16x8Type => Some((8u32, 16u32))
    I32x4Type => Some((4u32, 32u32))
    U32x4Type => Some((4u32, 32u32))
    F32x4Type => Some((4u32, 32u32))
    I64x2Type => Some((2u32, 64u32))
    U64x2Type => Some((2u32, 64u32))
    F64x2Type => Some((2u32, 64u32))
    _ => None
  }
}

fn self_host_compile_time_bits(primitive: SelfHostPrimitiveType) -> Option<U32> {
  match primitive {
    I8Type => Some(8u32)
    U8Type => Some(8u32)
    I16Type => Some(16u32)
    U16Type => Some(16u32)
    I32Type => Some(32u32)
    U32Type => Some(32u32)
    F32Type => Some(32u32)
    Swar32Type => Some(32u32)
    I64Type => Some(64u32)
    U64Type => Some(64u32)
    F64Type => Some(64u32)
    Swar64Type => Some(64u32)
    V128Type => Some(128u32)
    _ => match self_host_compile_time_lanes(primitive) {
      Some(pair) => {
        let (lanes, bits) = pair
        Some(lanes * bits)
      }
      None => None
    }
  }
}

fn self_host_compile_time_bitcast_carrier(type_: SelfHostCompileTimeType) -> Option<U32> {
  match type_ {
    PrimitiveCompileTimeType(primitive) => {
      let rank = primitive.rank()
      if rank == 1u32 || rank == 2u32 || rank == 3u32 || (rank >= 10u32 && rank <= 13u32) || rank == 16u32 || (rank >= 18u32 && rank <= 21u32) {
        return Some(0u32)
      }
      if rank == 4u32 || rank == 5u32 || rank == 17u32 || (rank >= 22u32 && rank <= 27u32) {
        return Some(1u32)
      }
      if rank == 6u32 {
        return Some(2u32)
      }
      if rank == 7u32 {
        return Some(3u32)
      }
      if rank == 15u32 || (rank >= 28u32 && rank <= 37u32) {
        return Some(4u32)
      }
      None
    }
    _ => None
  }
}

fn self_host_evaluate_compile_time_query(name: Bytes, arguments: Array<SelfHostCompileTimeType>) -> Result<Option<SelfHostCompileTimeConstant>, String> {
  let arity = match self_host_compile_time_type_query_arity(name) {
    Some(value) => value
    None => return Err("CT-002 unknown type-query builtin")
  }
  if arity != arguments.length() {
    return Err("CT-002 wrong type-query arity")
  }
  match self_host_compile_time_types_concrete(arguments) {
    Err(error) => return Err(error)
    Ok(concrete) => if !concrete {
      return Ok(None)
    }
  }
  let first = arguments[0u32]
  if name == b"types.type_equal" {
    return match self_host_compile_time_types_equal(first, arguments[1u32]) {
      Ok(value) => Ok(Some(BoolCompileTimeConstant(value)))
      Err(error) => Err(error)
    }
  }
  if name == b"types.can_bitcast" {
    let value = match self_host_compile_time_bitcast_carrier(first) {
      Some(left) => match self_host_compile_time_bitcast_carrier(arguments[1u32]) {
        Some(right) => left == right
        None => false
      }
      None => false
    }
    return Ok(Some(BoolCompileTimeConstant(value)))
  }
  let rank = match first {
    PrimitiveCompileTimeType(primitive) => primitive.rank()
    _ => 4294967295u32
  }
  let predicate = if name == b"types.is_unit" {
    Some(rank == 0u32)
  } else if name == b"types.is_never" {
    Some(rank == 9u32)
  } else if name == b"types.is_integer" {
    Some((rank >= 2u32 && rank <= 5u32) || (rank >= 10u32 && rank <= 13u32))
  } else if name == b"types.is_signed_integer" {
    Some(rank == 2u32 || rank == 4u32 || rank == 10u32 || rank == 11u32)
  } else if name == b"types.is_float" {
    Some(rank == 6u32 || rank == 7u32)
  } else {
    None
  }
  match predicate {
    Some(value) => return Ok(Some(BoolCompileTimeConstant(value)))
    None => {}
  }
  if name == b"types.implements" || name == b"types.field_names" || name == b"types.variant_names" || name == b"types.field_offset" {
    return Err("CT-010 missing type-query program context")
  }
  if name == b"types.tuple_length" {
    return match first {
      ProductCompileTimeType(fields) => Ok(Some(U32CompileTimeConstant(fields.length())))
      _ => Err("CT-002 tuple_length requires a product type")
    }
  }
  if name == b"types.size_of" || name == b"types.align_of" {
    let layout = match self_host_compile_time_raw_layout(first, 0u32) {
      Ok(value) => value
      Err(error) => return Err(error)
    }
    let value = if name == b"types.align_of" {
      layout.alignment
    } else {
      layout.size
    }
    return Ok(Some(U32CompileTimeConstant(value)))
  }
  let primitive = match first {
    PrimitiveCompileTimeType(value) => value
    _ => return Err("CT-002 unsupported type-query category")
  }
  let value = if name == b"types.bit_width" {
    match self_host_compile_time_bits(primitive) {
      Some(bits) => bits
      None => return Err("CT-002 type has no bit width")
    }
  } else {
    match self_host_compile_time_lanes(primitive) {
      Some(pair) => {
        let (lanes, bits) = pair
        if name == b"types.lane_count" {
          lanes
        } else {
          bits
        }
      }
      None => return Err("CT-002 type has no lanes")
    }
  }
  Ok(Some(U32CompileTimeConstant(value)))
}

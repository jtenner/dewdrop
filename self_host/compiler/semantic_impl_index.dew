open dew.std.array
open dew.std.option

pub enum SelfHostImplTargetHead {
  ErrorImplTargetHead
  PrimitiveImplTargetHead(SelfHostPrimitiveType)
  NominalImplTargetHead(U64)
}

pub enum SelfHostIndexedImplKind {
  InherentIndexedImpl
  TraitIndexedImpl(U64)
}

pub struct SelfHostIndexedImplMethod {
  declaration: U64
  requirement: Option<U64>
  instance: Bool
}

pub struct SelfHostIndexedMethodDispatch {
  target_head: SelfHostImplTargetHead
  name: U32
  inherent: Bool
  instance: Bool
  implementation: U32
  method_index: U32
}

pub struct SelfHostIndexedTraitMethodDispatch {
  trait_declaration: U64
  name: U32
  instance: Bool
  implementation: U32
  method_index: U32
}

fn self_host_indexed_method_dispatch_identity(
  dispatch: SelfHostIndexedMethodDispatch,
) -> SelfHostIndexedMethodDispatch {
  {
    target_head: dispatch.target_head
    name: dispatch.name
    inherent: dispatch.inherent
    instance: dispatch.instance
    implementation: dispatch.implementation
    method_index: dispatch.method_index
  }
}

fn self_host_indexed_trait_method_dispatch_identity(
  dispatch: SelfHostIndexedTraitMethodDispatch,
) -> SelfHostIndexedTraitMethodDispatch {
  {
    trait_declaration: dispatch.trait_declaration
    name: dispatch.name
    instance: dispatch.instance
    implementation: dispatch.implementation
    method_index: dispatch.method_index
  }
}

pub struct SelfHostIndexedImpl {
  declaration: U64
  kind: SelfHostIndexedImplKind
  target_head: SelfHostImplTargetHead
  trait_type: Option<U32>
  target_type: U32
  methods: SelfHostHirSpan
  valid: Bool
  coherent: Bool
  specificity: U32
}

fn self_host_indexed_impl_identity(
  implementation: SelfHostIndexedImpl,
) -> SelfHostIndexedImpl {
  {
    declaration: implementation.declaration
    kind: implementation.kind
    target_head: implementation.target_head
    trait_type: implementation.trait_type
    target_type: implementation.target_type
    methods: implementation.methods
    valid: implementation.valid
    coherent: implementation.coherent
    specificity: implementation.specificity
  }
}

pub enum SelfHostImplIndexDiagnostic {
  InvalidImplTraitHead(U64, U32)
  InvalidImplTargetHead(U64, U32)
  OrphanTraitImpl(U64, U64, SelfHostImplTargetHead, U32)
  OverlappingTraitImpl(U64, U64, U64, SelfHostImplTargetHead, U32)
  UnknownTraitImplMethod(U64, U64, U32)
  MissingTraitMethod(U64, U64, U32)
  DuplicateTraitImplMethod(U64, U64, U64, U32)
  TraitMethodReceiverMismatch(U64, U64, U32)
  TraitMethodParameterCountMismatch(U64, U64, U32, U32, U32)
  TraitMethodGenericParameterCountMismatch(U64, U64, U32, U32, U32)
  TraitMethodParameterTypeMismatch(U64, U64, U32, U32)
  TraitMethodReturnTypeMismatch(U64, U64, U32)
  DuplicateInherentMethod(U32, U64, U64, U32)
}

impl SelfHostImplIndexDiagnostic {
  fn offset(self) -> U32 {
    match self {
      InvalidImplTraitHead(_, offset) => offset
      InvalidImplTargetHead(_, offset) => offset
      OrphanTraitImpl(_, _, _, offset) => offset
      OverlappingTraitImpl(_, _, _, _, offset) => offset
      UnknownTraitImplMethod(_, _, offset) => offset
      MissingTraitMethod(_, _, offset) => offset
      DuplicateTraitImplMethod(_, _, _, offset) => offset
      TraitMethodReceiverMismatch(_, _, offset) => offset
      TraitMethodParameterCountMismatch(_, _, _, _, offset) => offset
      TraitMethodGenericParameterCountMismatch(_, _, _, _, offset) => offset
      TraitMethodParameterTypeMismatch(_, _, _, offset) => offset
      TraitMethodReturnTypeMismatch(_, _, offset) => offset
      DuplicateInherentMethod(_, _, _, offset) => offset
    }
  }
}

pub struct SelfHostModuleImplIndex {
  module_id: U64
  implementations: Array<SelfHostIndexedImpl>
  methods: Array<SelfHostIndexedImplMethod>
  method_dispatch: Array<SelfHostIndexedMethodDispatch>
  trait_method_dispatch: Array<SelfHostIndexedTraitMethodDispatch>
  diagnostics: Array<SelfHostImplIndexDiagnostic>
}

impl SelfHostModuleImplIndex {
  fn diagnostic_count(self) -> U32 {
    self.diagnostics.length()
  }

  fn diagnostic_at(self, index: U32) -> SelfHostImplIndexDiagnostic {
    self.diagnostics[index]
  }

  fn implementation(self, declaration: U64) -> Option<SelfHostIndexedImpl> {
    let mut implementation_index = 0u32
    let _ = while implementation_index {
      current => if current < self.implementations.length() {
        let implementation = self_host_indexed_impl_identity(
          self.implementations[current],
        )
        if self_host_u64_equal(implementation.declaration, declaration) {
          return Some(implementation)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    None
  }
}

fn self_host_impl_target_head(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
) -> SelfHostImplTargetHead {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      ErrorType => break ErrorImplTargetHead
      PrimitiveType(primitive) => break PrimitiveImplTargetHead(
        primitive,
      )
      NominalType(declaration) => break NominalImplTargetHead(
        declaration,
      )
      AppliedType(base, _) => continue base
      _ => break ErrorImplTargetHead
    }
  }
}

fn self_host_impl_trait_head(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
) -> Option<U64> {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      TraitType(declaration) => break Some(declaration)
      AppliedType(base, _) => continue base
      _ => break None
    }
  }
}

fn self_host_impl_primitive_key(primitive: SelfHostPrimitiveType) -> U32 {
  match primitive {
    UnitType => 0u32
    BoolType => 1u32
    I32Type => 2u32
    U32Type => 3u32
    I64Type => 4u32
    U64Type => 5u32
    F32Type => 6u32
    F64Type => 7u32
    StringType => 8u32
    NeverType => 9u32
    I8Type => 10u32
    I16Type => 11u32
    U8Type => 12u32
    U16Type => 13u32
    BytesType => 14u32
    V128Type => 15u32
    Swar32Type => 16u32
    Swar64Type => 17u32
    I8x4Type => 18u32
    U8x4Type => 19u32
    I16x2Type => 20u32
    U16x2Type => 21u32
    I8x8Type => 22u32
    U8x8Type => 23u32
    I16x4Type => 24u32
    U16x4Type => 25u32
    I32x2Type => 26u32
    U32x2Type => 27u32
    I8x16Type => 28u32
    U8x16Type => 29u32
    I16x8Type => 30u32
    U16x8Type => 31u32
    I32x4Type => 32u32
    U32x4Type => 33u32
    I64x2Type => 34u32
    U64x2Type => 35u32
    F32x4Type => 36u32
    F64x2Type => 37u32
    StringViewType => 38u32
    StringBuilderType => 39u32
    BytesBuilderType => 40u32
    CompileTimeTypeType => 41u32
  }
}

fn self_host_impl_heads_equal(
  left: SelfHostImplTargetHead,
  right: SelfHostImplTargetHead,
) -> Bool {
  match left {
    ErrorImplTargetHead => right is ErrorImplTargetHead
    PrimitiveImplTargetHead(left_primitive) => match right {
      PrimitiveImplTargetHead(right_primitive) => self_host_u32_equal(
        self_host_impl_primitive_key(left_primitive),
        self_host_impl_primitive_key(right_primitive),
      )
      _ => false
    }
    NominalImplTargetHead(left_declaration) => match right {
      NominalImplTargetHead(right_declaration) => self_host_u64_equal(
        left_declaration,
        right_declaration,
      )
      _ => false
    }
  }
}

fn self_host_impl_is_package_owned(
  owner: U64,
  trait_declaration: U64,
  target: SelfHostImplTargetHead,
) -> Bool {
  if self_host_semantic_modules_share_package(
    owner,
    self_host_semantic_id_module(trait_declaration),
  ) {
    true
  } else {
    match target {
      NominalImplTargetHead(declaration) => self_host_semantic_modules_share_package(
        owner,
        self_host_semantic_id_module(declaration),
      )
      PrimitiveImplTargetHead(_) => self_host_semantic_module_is_standard_package(
        owner,
      )
      ErrorImplTargetHead => true
    }
  }
}

enum SelfHostImplPatternTask {
  VisitImplPatternType(U32)
  FinishImplPatternProduct(U32, U32)
  FinishImplPatternApplication(U32, U32)
  FinishImplPatternFunction(U32, U32)
}

struct SelfHostImplPatternImporter {
  resolved: SelfHostResolvedModuleTypes
  solver: SelfHostLocalTypeSolver
  generic_ids: Array<U64>
  generic_types: Array<I32>
  tasks: Array<SelfHostImplPatternTask>
  results: Array<I32>
  scratch: Array<I32>
}

impl SelfHostImplPatternImporter {
  fn new(resolved: SelfHostResolvedModuleTypes) -> SelfHostImplPatternImporter {
    {
      resolved: resolved
      solver: SelfHostLocalTypeSolver::new(resolved)
      generic_ids: []
      generic_types: []
      tasks: []
      results: []
      scratch: []
    }
  }

  fn clear_generics(self) -> Unit {
    self.generic_ids.clear()
    self.generic_types.clear()
  }

  fn add_generic(self, id: U64) -> Unit {
    self.generic_ids.push(id)
    self.generic_types.push(self.solver.fresh_variable())
  }

  fn generic_type(self, id: U64) -> Option<I32> {
    let mut index = 0u32
    while index {
      current => if current < self.generic_ids.length() {
        if self_host_u64_equal(self.generic_ids[current], id) {
          break Some(self.generic_types[current])
        }
        continue current + 1u32
      } else {
        break None
      }
    }
  }

  fn finish_product(self, source: U32, start: U32) -> I32 {
    let fields = match self.resolved.types[source] {
      ProductType(value) => value
      _ => self_host_empty_hir_span(0u32)
    }
    self.scratch.clear()
    let mut index = 0u32
    let _ = while index {
      current => if current < fields.length {
        self.scratch.push(self.results[self_host_u32_add(start, current)])
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.product_type(self.scratch)
  }

  fn finish_application(self, source: U32, start: U32) -> I32 {
    let arguments = match self.resolved.types[source] {
      AppliedType(_, value) => value
      _ => self_host_empty_hir_span(0u32)
    }
    self.scratch.clear()
    let mut index = 0u32
    let _ = while index {
      current => if current < arguments.length {
        self.scratch.push(
          self.results[self_host_u32_add(start + 1u32, current)],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.applied_type(self.results[start], self.scratch)
  }

  fn finish_function(self, source: U32, start: U32) -> I32 {
    let parameters = match self.resolved.types[source] {
      FunctionType(value, _) => value
      _ => self_host_empty_hir_span(0u32)
    }
    self.scratch.clear()
    let mut index = 0u32
    let _ = while index {
      current => if current < parameters.length {
        self.scratch.push(self.results[self_host_u32_add(start, current)])
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.function_type(
      self.scratch,
      self.results[self_host_u32_add(start, parameters.length)],
    )
  }

  fn collapse(self, start: U32, value: I32) -> Unit {
    self.results.truncate(start)
    self.results.push(value)
  }

  fn import_type(self, root: U32) -> I32 {
    self.tasks.clear()
    self.results.clear()
    self.tasks.push(VisitImplPatternType(root))
    let _ = while self.tasks.length() {
      length => if self_host_u32_greater(length, 0u32) {
        let task = match self_host_array_pop(self.tasks) {
          Some(value) => value
          None => {
            return self.solver.error_type()
          }
        }
        match task {
          VisitImplPatternType(source) => match self.resolved.types[source] {
            GenericParameterType(parameter) => match self.generic_type(
              parameter,
            ) {
              Some(type_) => self.results.push(type_)
              None => self.results.push(self.solver.resolved_type(source))
            }
            ProductType(fields) => {
              let start = self.results.length()
              self.tasks.push(
                FinishImplPatternProduct(source, start),
              )
              let mut index = fields.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.tasks.push(
                    VisitImplPatternType(
                      self.resolved.type_arguments[
                        self_host_u32_add(fields.start, previous)
                      ],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            AppliedType(base, arguments) => {
              let start = self.results.length()
              self.tasks.push(
                FinishImplPatternApplication(
                  source,
                  start,
                ),
              )
              let mut index = arguments.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.tasks.push(
                    VisitImplPatternType(
                      self.resolved.type_arguments[
                        self_host_u32_add(arguments.start, previous)
                      ],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
              self.tasks.push(
                VisitImplPatternType(base),
              )
            }
            FunctionType(parameters, result) => {
              let start = self.results.length()
              self.tasks.push(
                FinishImplPatternFunction(source, start),
              )
              self.tasks.push(
                VisitImplPatternType(result),
              )
              let mut index = parameters.length
              let _ = while index {
                current => if self_host_u32_greater(current, 0u32) {
                  let previous = current - 1u32
                  self.tasks.push(
                    VisitImplPatternType(
                      self.resolved.type_arguments[
                        self_host_u32_add(parameters.start, previous)
                      ],
                    ),
                  )
                  continue previous
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            _ => self.results.push(self.solver.resolved_type(source))
          }
          FinishImplPatternProduct(source, start) => {
            self.collapse(start, self.finish_product(source, start))
          }
          FinishImplPatternApplication(source, start) => {
            self.collapse(start, self.finish_application(source, start))
          }
          FinishImplPatternFunction(source, start) => {
            self.collapse(start, self.finish_function(source, start))
          }
        }
        continue self.tasks.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    if self_host_u32_equal(self.results.length(), 1u32) {
      self.results[0u32]
    } else {
      self.solver.error_type()
    }
  }
}

fn self_host_impl_add_local_generics(
  importer: SelfHostImplPatternImporter,
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Unit {
  importer.clear_generics()
  let generics = collected.generic_parameters_of(declaration)
  let mut index = 0u32
  let _ = while index {
    current => if current < generics.length {
      importer.add_generic(
        collected.generic_parameters[
          self_host_u32_add(generics.start, current)
        ].id,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_impl_patterns_overlap(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  left: SelfHostIndexedImpl,
  right: SelfHostIndexedImpl,
) -> Bool {
  let importer = SelfHostImplPatternImporter::new(resolved)
  self_host_impl_add_local_generics(importer, collected, left.declaration)
  let left_trait = match left.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let left_target = importer.import_type(left.target_type)
  importer.clear_generics()
  let right_generics = collected.generic_parameters_of(right.declaration)
  let mut index = 0u32
  let _ = while index {
    current => if current < right_generics.length {
      importer.add_generic(
        collected.generic_parameters[
          self_host_u32_add(right_generics.start, current)
        ].id,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let right_trait = match right.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let right_target = importer.import_type(right.target_type)
  importer.solver.unify(
    left_trait,
    right_trait,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  ) && importer.solver.unify(
    left_target,
    right_target,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  )
}

fn self_host_impl_pattern_matches(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  general: SelfHostIndexedImpl,
  specific: SelfHostIndexedImpl,
) -> Bool {
  let importer = SelfHostImplPatternImporter::new(resolved)
  self_host_impl_add_local_generics(importer, collected, general.declaration)
  let general_trait = match general.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let general_target = importer.import_type(general.target_type)
  let specific_trait = match specific.trait_type {
    Some(type_) => importer.solver.resolved_type(type_)
    None => importer.solver.error_type()
  }
  let specific_target = importer.solver.resolved_type(specific.target_type)
  importer.solver.unify(
    general_trait,
    specific_trait,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  ) && importer.solver.unify(
    general_target,
    specific_target,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  )
}

fn self_host_impl_add_imported_generics(
  importer: SelfHostImplPatternImporter,
  imports: SelfHostResolvedModuleImports,
  declaration: U64,
) -> Unit {
  importer.clear_generics()
  match imports.implementation(declaration) {
    Some(implementation) => {
      let mut index = 0u32
      let _ = while index {
        current => if current < implementation.generic_parameters.length {
          importer.add_generic(
            imports.generic_parameter_ids[
              self_host_u32_add(
                implementation.generic_parameters.start,
                current,
              )
            ],
          )
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    None => {}
  }
}

fn self_host_impl_add_any_generics(
  importer: SelfHostImplPatternImporter,
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  declaration: U64,
) -> Unit {
  if self_host_u64_equal(
    self_host_semantic_id_module(declaration),
    collected.module_id,
  ) {
    self_host_impl_add_local_generics(importer, collected, declaration)
  } else {
    self_host_impl_add_imported_generics(importer, imports, declaration)
  }
}

fn self_host_impl_patterns_overlap_with_imports(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  left: SelfHostIndexedImpl,
  right: SelfHostIndexedImpl,
) -> Bool {
  let importer = SelfHostImplPatternImporter::new(imports.resolved)
  self_host_impl_add_any_generics(
    importer,
    collected,
    imports,
    left.declaration,
  )
  let left_trait = match left.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let left_target = importer.import_type(left.target_type)
  self_host_impl_add_any_generics(
    importer,
    collected,
    imports,
    right.declaration,
  )
  let right_trait = match right.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let right_target = importer.import_type(right.target_type)
  importer.solver.unify(
    left_trait,
    right_trait,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  ) && importer.solver.unify(
    left_target,
    right_target,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  )
}

fn self_host_impl_pattern_matches_with_imports(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
  general: SelfHostIndexedImpl,
  specific: SelfHostIndexedImpl,
) -> Bool {
  let importer = SelfHostImplPatternImporter::new(imports.resolved)
  self_host_impl_add_any_generics(
    importer,
    collected,
    imports,
    general.declaration,
  )
  let general_trait = match general.trait_type {
    Some(type_) => importer.import_type(type_)
    None => importer.solver.error_type()
  }
  let general_target = importer.import_type(general.target_type)
  let specific_trait = match specific.trait_type {
    Some(type_) => importer.solver.resolved_type(type_)
    None => importer.solver.error_type()
  }
  importer.solver.unify(
    general_trait,
    specific_trait,
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  ) && importer.solver.unify(
    general_target,
    importer.solver.resolved_type(specific.target_type),
    {
      kind: SyntheticTypeConstraint
      source: 0u32
      offset: 0u32
    },
  )
}

fn self_host_impl_method_duplicate(
  collected: SelfHostCollectedModule,
  left: U64,
  right: U64,
) -> Option<U32> {
  let mut left_index = 0u32
  let _ = while left_index {
    current_left => if current_left < collected.methods.length() {
      let left_method = self_host_collected_method_identity(
        collected.methods[current_left],
      )
      if self_host_u64_equal(left_method.parent, left) {
        let mut right_index = 0u32
        let _ = while right_index {
          current_right => if current_right < collected.methods.length() {
            let right_method = self_host_collected_method_identity(
              collected.methods[current_right],
            )
            if self_host_u64_equal(right_method.parent, right) {
              if self_host_u32_equal(left_method.name, right_method.name) {
                return Some(left_method.name)
              }
            }
            continue current_right + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_left + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  None
}

fn self_host_impl_declaration_offset(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> U32 {
  match collected.declaration_reference(declaration) {
    Some(reference) => match reference {
      TopLevel(value) => value.offset
      Method(value) => value.offset
    }
    None => 0u32
  }
}

fn self_host_impl_mark_incoherent(
  implementations: Array<SelfHostIndexedImpl>,
  index: U32,
) -> Unit {
  let value = implementations[index]
  implementations[index] = {
    declaration: value.declaration
    kind: value.kind
    target_head: value.target_head
    trait_type: value.trait_type
    target_type: value.target_type
    methods: value.methods
    valid: value.valid
    coherent: false
    specificity: value.specificity
  }
}

fn self_host_impl_add_specificity(
  implementations: Array<SelfHostIndexedImpl>,
  index: U32,
) -> Unit {
  let value = implementations[index]
  implementations[index] = {
    declaration: value.declaration
    kind: value.kind
    target_head: value.target_head
    trait_type: value.trait_type
    target_type: value.target_type
    methods: value.methods
    valid: value.valid
    coherent: value.coherent
    specificity: self_host_u32_add(value.specificity, 1u32)
  }
}

fn self_host_impl_method_has_receiver(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Bool {
  let parameters = collected.parameters_of(declaration)
  if self_host_u32_equal(parameters.length, 0u32) {
    false
  } else {
    collected.parameters[parameters.start].kind is ReceiverParameterDecl
  }
}

struct SelfHostImplTypeContext {
  imported_parameter_ids: Option<Array<U64>>
  owner_parameters: SelfHostHirSpan
  owner_arguments: SelfHostHirSpan
  method_parameters: SelfHostHirSpan
  method_arguments: SelfHostHirSpan
  self_owner: U64
  self_type: U32
}

fn self_host_impl_generic_relative(
  collected: SelfHostCollectedModule,
  imported_ids: Option<Array<U64>>,
  span: SelfHostHirSpan,
  parameter: U64,
) -> Option<U32> {
  let mut index = 0u32
  while index {
    current => if current < span.length {
      let candidate = match imported_ids {
        Some(ids) => ids[span.start + current]
        None => collected.generic_parameters[span.start + current].id
      }
      if self_host_u64_equal(candidate, parameter) {
        break Some(current)
      }
      continue current + 1u32
    } else {
      break None
    }
  }
}

fn self_host_impl_signature_types_equal(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  left_root: U32,
  left_context: SelfHostImplTypeContext,
  right_root: U32,
  right_context: SelfHostImplTypeContext,
) -> Bool {
  match self_host_check_impl_signature_types_equal(collected, resolved, left_root, left_context, right_root, right_context) {
    Ok(equal) => equal
    Err(failure) => {
      self_host_assert_compiler_invariant_with_failure(false, failure, "implementation type graph must be valid and acyclic")
      unreachable()
    }
  }
}

fn self_host_impl_callable_index(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Option<U32> {
  let mut index = 0u32
  while index {
    current => if current < collected.callables.length() {
      if self_host_u64_equal(
        collected.callables[current].declaration,
        declaration,
      ) {
        break Some(current)
      }
      continue current + 1u32
    } else {
      break None
    }
  }
}

fn self_host_check_trait_impl_methods(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  imports: Option<SelfHostResolvedModuleImports>,
  implementations: Array<SelfHostIndexedImpl>,
  implementation_index: U32,
  trait_declaration: U64,
  diagnostics: Array<SelfHostImplIndexDiagnostic>,
) -> Unit {
  let implementation = implementations[implementation_index]
  let view = match self_host_trait_signature_view(collected, resolved, imports, trait_declaration) {
    Some(value) => value
    None => {
      self_host_impl_mark_incoherent(implementations, implementation_index)
      diagnostics.push(InvalidImplTraitHead(
        implementation.declaration,
        self_host_impl_declaration_offset(collected, implementation.declaration),
      ))
      return
    }
  }
  let trait_type = match implementation.trait_type {
    Some(value) => value
    None => 0u32
  }
  let trait_arguments = match resolved.types[trait_type] {
    AppliedType(_, arguments) => arguments
    _ => self_host_empty_hir_span(0u32)
  }
  let seen = self_host_empty_id_lookup()
  for method in collected.methods {
    if method.parent == implementation.declaration {
      let mut selected = None
      for requirement in view.requirements {
        if requirement.name == collected.name(method.name) {
          selected = Some(requirement)
        }
      }
      match selected {
        None => {
          self_host_impl_mark_incoherent(implementations, implementation_index)
          diagnostics.push(UnknownTraitImplMethod(
            method.id, trait_declaration, method.offset,
          ))
        }
        Some(requirement) => match seen.get(method.name) {
          Some(previous) => {
            self_host_impl_mark_incoherent(implementations, implementation_index)
            diagnostics.push(DuplicateTraitImplMethod(
              method.id, previous, requirement.declaration, method.offset,
            ))
          }
          None => {
            seen.set(method.name, method.id)
            let receiver = self_host_impl_method_has_receiver(collected, method.id)
            let parameters = collected.parameters_of(method.id)
            let generics = collected.generic_parameters_of(method.id)
            if receiver != requirement.receiver {
              self_host_impl_mark_incoherent(implementations, implementation_index)
              diagnostics.push(TraitMethodReceiverMismatch(
                method.id, requirement.declaration, method.offset,
              ))
            }
            if parameters.length != requirement.parameters.length() {
              self_host_impl_mark_incoherent(implementations, implementation_index)
              diagnostics.push(TraitMethodParameterCountMismatch(
                method.id, requirement.declaration, requirement.parameters.length(), parameters.length, method.offset,
              ))
            }
            if generics.length != requirement.generics.length {
              self_host_impl_mark_incoherent(implementations, implementation_index)
              diagnostics.push(TraitMethodGenericParameterCountMismatch(
                method.id, requirement.declaration, requirement.generics.length, generics.length, method.offset,
              ))
            }
            if receiver == requirement.receiver && parameters.length == requirement.parameters.length() &&
              generics.length == requirement.generics.length {
              let trait_context = {
                imported_parameter_ids: view.imported_parameter_ids
                owner_parameters: view.generics
                owner_arguments: trait_arguments
                method_parameters: requirement.generics
                method_arguments: generics
                self_owner: trait_declaration
                self_type: implementation.target_type
              }
              let implementation_context = {
                imported_parameter_ids: None
                owner_parameters: self_host_empty_hir_span(0u32)
                owner_arguments: self_host_empty_hir_span(0u32)
                method_parameters: self_host_empty_hir_span(0u32)
                method_arguments: self_host_empty_hir_span(0u32)
                self_owner: implementation.declaration
                self_type: implementation.target_type
              }
              while 0u32 {
                parameter if parameter < parameters.length => {
                  if !self_host_impl_signature_types_equal(collected, resolved,
                    requirement.parameters[parameter], trait_context,
                    resolved.parameter_types[parameters.start + parameter], implementation_context,
                  ) {
                    self_host_impl_mark_incoherent(implementations, implementation_index)
                    diagnostics.push(TraitMethodParameterTypeMismatch(
                      method.id, requirement.declaration, parameter, method.offset,
                    ))
                  }
                  continue parameter + 1u32
                }
                _ => break self_host_semantic_unit()
              }
              match self_host_impl_callable_index(collected, method.id) {
                Some(callable) => if !self_host_impl_signature_types_equal(collected, resolved,
                  requirement.result, trait_context,
                  resolved.callable_return_types[callable], implementation_context,
                ) {
                  self_host_impl_mark_incoherent(implementations, implementation_index)
                  diagnostics.push(TraitMethodReturnTypeMismatch(
                    method.id, requirement.declaration, method.offset,
                  ))
                }
                None => {
                  let _ = self_host_assert_compiler_invariant(false, "trait implementation method is missing its callable")
                }
              }
            }
          }
        }
      }
    }
  }
  for requirement in view.requirements {
    let mut found = false
    for method in collected.methods {
      if method.parent == implementation.declaration && collected.name(method.name) == requirement.name {
        found = true
      }
    }
    if !found {
      self_host_impl_mark_incoherent(implementations, implementation_index)
      diagnostics.push(MissingTraitMethod(
        implementation.declaration, requirement.declaration,
        self_host_impl_declaration_offset(collected, implementation.declaration),
      ))
    }
  }
}

fn self_host_index_module_implementations(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
) -> SelfHostModuleImplIndex {
  self_host_index_module_implementations_context(collected, resolved, None)
}

fn self_host_index_module_implementations_context(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  imports: Option<SelfHostResolvedModuleImports>,
) -> SelfHostModuleImplIndex {
  let implementations = []
  let diagnostics = []
  let mut index = 0u32
  let _ = while index {
    current => if current < collected.impls.length() {
      let implementation = collected.impls[current]
      let target_type = resolved.impl_target_types[current]
      let target_head = self_host_impl_target_head(resolved, target_type)
      let mut valid = !(target_head is ErrorImplTargetHead)
      if !valid {
        diagnostics.push(
          InvalidImplTargetHead(
            implementation.declaration,
            self_host_impl_declaration_offset(collected, implementation.declaration),
          ),
        )
      }
      let kind = match resolved.impl_trait_types[current] {
        Some(trait_type) => match self_host_impl_trait_head(
          resolved,
          trait_type,
        ) {
          Some(trait_declaration) => {
            if !self_host_impl_is_package_owned(
              collected.module_id,
              trait_declaration,
              target_head,
            ) {
              valid = false
              diagnostics.push(
                OrphanTraitImpl(
                  implementation.declaration,
                  trait_declaration,
                  target_head,
                  self_host_impl_declaration_offset(collected, implementation.declaration),
                ),
              )
            }
            TraitIndexedImpl(trait_declaration)
          }
          None => {
            valid = false
            diagnostics.push(
              InvalidImplTraitHead(
                implementation.declaration,
                self_host_impl_declaration_offset(collected, implementation.declaration),
              ),
            )
            TraitIndexedImpl(0u64)
          }
        }
        None => InherentIndexedImpl
      }
      implementations.push({
        declaration: implementation.declaration
        kind: kind
        target_head: target_head
        trait_type: resolved.impl_trait_types[current]
        target_type: target_type
        methods: self_host_empty_hir_span(0u32)
        valid: valid
        coherent: valid
        specificity: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  index = 0u32
  let _ = while index {
    current => if current < implementations.length() {
      let implementation = implementations[current]
      if implementation.valid {
        match implementation.kind {
          TraitIndexedImpl(trait_declaration) => self_host_check_trait_impl_methods(
            collected,
            resolved,
            imports,
            implementations,
            current,
            trait_declaration,
            diagnostics,
          )
          InherentIndexedImpl => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut left = 0u32
  let _ = while left {
    left_index => if left_index < implementations.length() {
      let mut right = left_index + 1u32
      let _ = while right {
        right_index => if right_index < implementations.length() {
          let left_impl = implementations[left_index]
          let right_impl = implementations[right_index]
          if left_impl.valid && right_impl.valid && self_host_impl_heads_equal(
            left_impl.target_head,
            right_impl.target_head,
          ) {
            match left_impl.kind {
              TraitIndexedImpl(left_trait) => match right_impl.kind {
                TraitIndexedImpl(right_trait) => if self_host_u64_equal(
                  left_trait,
                  right_trait,
                ) && self_host_impl_patterns_overlap(
                  collected,
                  resolved,
                  left_impl,
                  right_impl,
                ) {
                  let left_matches_right = self_host_impl_pattern_matches(
                    collected,
                    resolved,
                    left_impl,
                    right_impl,
                  )
                  let right_matches_left = self_host_impl_pattern_matches(
                    collected,
                    resolved,
                    right_impl,
                    left_impl,
                  )
                  if left_matches_right && !right_matches_left {
                    self_host_impl_add_specificity(implementations, right_index)
                  } else if right_matches_left && !left_matches_right {
                    self_host_impl_add_specificity(implementations, left_index)
                  } else {
                    self_host_impl_mark_incoherent(implementations, left_index)
                    self_host_impl_mark_incoherent(implementations, right_index)
                    diagnostics.push(
                      OverlappingTraitImpl(
                        right_impl.declaration,
                        left_impl.declaration,
                        left_trait,
                        right_impl.target_head,
                        self_host_impl_declaration_offset(
                          collected,
                          right_impl.declaration,
                        ),
                      ),
                    )
                  }
                }
                _ => {}
              }
              InherentIndexedImpl => match right_impl.kind {
                InherentIndexedImpl => match self_host_impl_method_duplicate(
                  collected,
                  left_impl.declaration,
                  right_impl.declaration,
                ) {
                  Some(name) => {
                    self_host_impl_mark_incoherent(implementations, right_index)
                    diagnostics.push(
                      DuplicateInherentMethod(
                        name,
                        right_impl.declaration,
                        left_impl.declaration,
                        self_host_impl_declaration_offset(collected, right_impl.declaration),
                      ),
                    )
                  }
                  None => {}
                }
                _ => {}
              }
            }
          }
          continue right_index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue left_index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let methods = []
  let method_dispatch = []
  let trait_method_dispatch = []
  index = 0u32
  let _ = while index {
    current => if current < implementations.length() {
      let implementation = implementations[current]
      let method_start = methods.length()
      let mut collected_method_index = 0u32
      let _ = while collected_method_index {
        method_offset => if method_offset < collected.methods.length() {
          let method = collected.methods[method_offset]
          if self_host_u64_equal(method.parent, implementation.declaration) {
            let requirement = match implementation.kind {
              TraitIndexedImpl(trait_declaration) => {
                let mut found = None
                if self_host_semantic_id_module(trait_declaration) != collected.module_id {
                  match imports {
                    Some(imported) => {
                      found = self_host_imported_requirement_identity(imported, trait_declaration, collected.name(method.name))
                    }
                    None => {}
                  }
                }
                let mut candidate_index = 0u32
                let _ = while candidate_index {
                  current_candidate => if current_candidate < collected.methods.length() {
                    let candidate = self_host_collected_method_identity(
                      collected.methods[current_candidate],
                    )
                    if self_host_u64_equal(candidate.parent, trait_declaration) {
                      if self_host_u32_equal(candidate.name, method.name) {
                        found = Some(candidate.id)
                      }
                    }
                    continue current_candidate + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                found
              }
              InherentIndexedImpl => None
            }
            let indexed_method = {
              declaration: method.id
              requirement: requirement
              instance: self_host_impl_method_has_receiver(collected, method.id)
            }
            let indexed_method_index = methods.length()
            methods.push(indexed_method)
            if implementation.valid && implementation.coherent {
              let inherent = implementation.kind is InherentIndexedImpl
              let publish = inherent || requirement is Some(_)
              if publish {
                method_dispatch.push({
                  target_head: implementation.target_head
                  name: method.name
                  inherent: inherent
                  instance: indexed_method.instance
                  implementation: current
                  method_index: indexed_method_index
                })
                match implementation.kind {
                  TraitIndexedImpl(trait_declaration) => trait_method_dispatch.push(
                    {
                      trait_declaration: trait_declaration
                      name: method.name
                      instance: indexed_method.instance
                      implementation: current
                      method_index: indexed_method_index
                    },
                  )
                  InherentIndexedImpl => {}
                }
              }
            }
          }
          continue method_offset + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      implementations[current] = {
        declaration: implementation.declaration
        kind: implementation.kind
        target_head: implementation.target_head
        trait_type: implementation.trait_type
        target_type: implementation.target_type
        methods: {
          start: method_start
          length: methods.length() - method_start
        }
        valid: implementation.valid
        coherent: implementation.coherent
        specificity: implementation.specificity
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    module_id: collected.module_id
    implementations: implementations
    methods: methods
    method_dispatch: method_dispatch
    trait_method_dispatch: trait_method_dispatch
    diagnostics: diagnostics
  }
}

fn self_host_impl_intern_imported_name(
  collected: SelfHostCollectedModule,
  name: String,
) -> U32 {
  match collected.find_name(name) {
    Some(existing) => existing
    None => {
      let created = collected.names.length()
      collected.names.push(name)
      collected.name_lookup.set(name, created)
      created
    }
  }
}

fn self_host_imported_requirement_identity(imports: SelfHostResolvedModuleImports, trait_: U64, name: String) -> Option<U64> {
  let mut selected = None
  for callable in imports.callables {
    match callable.kind {
      FrozenTraitCallable(owner) => if owner == trait_ && callable.name == name {
        match selected {
          Some(previous) => {
            let _ = self_host_assert_compiler_invariant(previous == callable.declaration, "EVD-212 duplicate imported trait requirement identity")
          }
          None => {
            selected = Some(callable.declaration)
          }
        }
      }
      _ => {}
    }
  }
  selected
}

fn self_host_index_module_implementations_with_imports(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
) -> SelfHostModuleImplIndex {
  let index = self_host_index_module_implementations_context(
    collected,
    imports.resolved,
    Some(imports),
  )
  let local_count = index.implementations.length()
  let mut imported_index = 0u32
  let _ = while imported_index {
    current => if current < imports.implementations.length() {
      let imported = imports.implementations[current]
      let target_head = self_host_impl_target_head(
        imports.resolved,
        imported.target_type,
      )
      if !(target_head is ErrorImplTargetHead) {
        let kind = match imported.trait_type {
          Some(trait_type) => match self_host_impl_trait_head(
            imports.resolved,
            trait_type,
          ) {
            Some(trait_declaration) => TraitIndexedImpl(
              trait_declaration,
            )
            None => TraitIndexedImpl(0u64)
          }
          None => InherentIndexedImpl
        }
        let method_start = index.methods.length()
        let implementation_slot = index.implementations.length()
        let mut callable_index = 0u32
        let _ = while callable_index {
          callable_slot => if callable_slot < imports.callables.length() {
            let callable = imports.callables[callable_slot]
            let owner = match callable.kind {
              FrozenImplCallable(value) => Some(
                value,
              )
              _ => None
            }
            match owner {
              Some(value) => if self_host_u64_equal(
                value,
                imported.declaration,
              ) {
                let instance = if self_host_u32_greater(
                  callable.parameters.length,
                  0u32,
                ) {
                  imports.parameter_receivers[callable.parameters.start]
                } else {
                  false
                }
                let method_slot = index.methods.length()
                index.methods.push({
                  declaration: callable.declaration
                  requirement: match kind {
                    TraitIndexedImpl(trait_) => self_host_imported_requirement_identity(imports, trait_, callable.name)
                    InherentIndexedImpl => None
                  }
                  instance: instance
                })
                let name = self_host_impl_intern_imported_name(
                  collected,
                  callable.name,
                )
                let inherent = kind is InherentIndexedImpl
                index.method_dispatch.push({
                  target_head: target_head
                  name: name
                  inherent: inherent
                  instance: instance
                  implementation: implementation_slot
                  method_index: method_slot
                })
                match kind {
                  TraitIndexedImpl(trait_declaration) => index.trait_method_dispatch.push(
                    {
                      trait_declaration: trait_declaration
                      name: name
                      instance: instance
                      implementation: implementation_slot
                      method_index: method_slot
                    },
                  )
                  InherentIndexedImpl => {}
                }
              }
              None => {}
            }
            continue callable_slot + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        index.implementations.push({
          declaration: imported.declaration
          kind: kind
          target_head: target_head
          trait_type: imported.trait_type
          target_type: imported.target_type
          methods: {
            start: method_start
            length: index.methods.length() - method_start
          }
          valid: true
          coherent: true
          specificity: 0u32
        })
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut right_index = local_count
  let _ = while right_index {
    right_slot => if right_slot < index.implementations.length() {
      let right = index.implementations[right_slot]
      let mut left_index = 0u32
      let _ = while left_index {
        left_slot => if left_slot < right_slot {
          let left = index.implementations[left_slot]
          let same_trait = match left.kind {
            TraitIndexedImpl(left_trait) => match right.kind {
              TraitIndexedImpl(right_trait) => self_host_u64_equal(
                left_trait,
                right_trait,
              )
              _ => false
            }
            _ => false
          }
          if left.valid && left.coherent && right.valid && right.coherent && same_trait && self_host_impl_heads_equal(
            left.target_head,
            right.target_head,
          ) && self_host_impl_patterns_overlap_with_imports(
            collected,
            imports,
            left,
            right,
          ) {
            let left_matches_right = self_host_impl_pattern_matches_with_imports(
              collected,
              imports,
              left,
              right,
            )
            let right_matches_left = self_host_impl_pattern_matches_with_imports(
              collected,
              imports,
              right,
              left,
            )
            if left_matches_right && !right_matches_left {
              self_host_impl_add_specificity(
                index.implementations,
                right_slot,
              )
            } else if right_matches_left && !left_matches_right {
              self_host_impl_add_specificity(
                index.implementations,
                left_slot,
              )
            } else {
              self_host_impl_mark_incoherent(
                index.implementations,
                left_slot,
              )
              self_host_impl_mark_incoherent(
                index.implementations,
                right_slot,
              )
              let trait_declaration = match right.kind {
                TraitIndexedImpl(value) => value
                _ => 0u64
              }
              index.diagnostics.push(
                OverlappingTraitImpl(
                  right.declaration,
                  left.declaration,
                  trait_declaration,
                  right.target_head,
                  0u32,
                ),
              )
            }
          }
          continue left_slot + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue right_slot + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let retained_methods = []
  let mut dispatch_index = 0u32
  let _ = while dispatch_index {
    current => if current < index.method_dispatch.length() {
      let dispatch = self_host_indexed_method_dispatch_identity(
        index.method_dispatch[current],
      )
      if self_host_indexed_impl_identity(
        index.implementations[dispatch.implementation],
      ).coherent {
        retained_methods.push(dispatch)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  index.method_dispatch.clear()
  dispatch_index = 0u32
  let _ = while dispatch_index {
    current => if current < retained_methods.length() {
      index.method_dispatch.push(
        self_host_indexed_method_dispatch_identity(retained_methods[current]),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let retained_trait_methods = []
  let mut trait_dispatch_index = 0u32
  let _ = while trait_dispatch_index {
    current => if current < index.trait_method_dispatch.length() {
      let dispatch = self_host_indexed_trait_method_dispatch_identity(
        index.trait_method_dispatch[current],
      )
      if self_host_indexed_impl_identity(
        index.implementations[dispatch.implementation],
      ).coherent {
        retained_trait_methods.push(dispatch)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  index.trait_method_dispatch.clear()
  trait_dispatch_index = 0u32
  let _ = while trait_dispatch_index {
    current => if current < retained_trait_methods.length() {
      index.trait_method_dispatch.push(
        self_host_indexed_trait_method_dispatch_identity(
          retained_trait_methods[current],
        ),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  index
}

fn self_host_variant_recipe_fixture() -> (SelfHostPlannedProgramWasmGCLink, SelfHostPlannedPhysicalBodyCarrierPlan) {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Payload {\n  Values(I32, Unit, I64)\n}\npub fn main(left: I32, right: I64) -> I64 {\n  match Payload::Values(left, (), right) {\n    Payload::Values(_, _, value) => value\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, program))
  assert(program.bodies.length() == 1u32, "one variant constructor body")
  (link, program.bodies[0u32])
}

test "a nominal payload named Map retains its exact declared heap type" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Map {\n  value: I64\n}\nenum Payload {\n  Value(Map)\n}\npub fn main(value: I64) -> I64 {\n  match Payload::Value(Map::{\n    value: value\n  }) {\n    Payload::Value(item) => item.value\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid user-defined Map payload")
  let declaration = 5100u64 << 32u64
  match self_host_linked_nominal_field_type_index(link, declaration, true) {
    Some(type_) => assert(type_ == 0u32, "the selected struct is the first declared heap")
    None => assert(false, "a source name cannot erase nominal field evidence")
  }
  let plan = program.bodies[0u32]
  assert(plan.variant_constructor_operands.length() == 1u32, "one declared payload operand")
  match plan.variant_constructor_operands[0u32].reference_cast {
    Some(type_) => assert(type_ == 0u32, "the recipe retains the exact payload heap")
    None => assert(false, "the Map payload follows the ordinary nominal rule")
  }
}

test "tuple variant constructors retain complete source operand recipes" {
  let (_, plan) = self_host_variant_recipe_fixture()
  assert(plan.variant_constructors.length() == 1u32, "one tuple constructor recipe")
  let recipe = plan.variant_constructors[0u32]
  assert(recipe.expression == 5u32 && recipe.physical_type == 2u32, "exact source call and selected subtype")
  assert(recipe.arguments.length == 3u32 && recipe.operands.length == 3u32, "Unit retains its declared storage field")
  while 0u32 {
    index if index < recipe.operands.length => {
      let operand = plan.variant_constructor_operands[recipe.operands.start + index]
      assert(operand.expression == 2u32 + index, "each operand keeps its exact source expression")
      assert(operand.source_ordinal == index && operand.field_index == index, "declared tuple order is exact")
      assert(operand.unit_marker == (index == 1u32), "only the Unit field gets a marker")
      assert(!(operand.box_type is Some(_)), "concrete scalar fields are unboxed")
      continue index + 1u32
    }
    _ => break ()
  }
  self_host_assert_frozen_physical_body(self_host_freeze_physical_body(plan), plan)
}

test "BOD-605 frozen variant constructor targets cannot change" expect_trap "unreachable" {
  let (_, plan) = self_host_variant_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let source = plan.variant_constructors[0u32]
  plan.variant_constructors[0u32] = {
    expression: source.expression
    declaration: source.declaration
    physical_type: source.physical_type + 1u32
    arguments: source.arguments
    operands: source.operands
  }
  self_host_assert_frozen_physical_body(frozen, plan)
}

test "BOD-605 frozen variant operands cannot disappear" expect_trap "unreachable" {
  let (_, plan) = self_host_variant_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let _ = plan.variant_constructor_operands.pop()
  self_host_assert_frozen_physical_body(frozen, plan)
}
fn self_host_test_variant_constructor_change(kind: U32) -> Unit {
  let (_, plan) = self_host_variant_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let source = plan.variant_constructors[0u32]
  plan.variant_constructors[0u32] = {
    expression: if kind == 0u32 {
      source.expression + 1u32
    } else {
      source.expression
    }
    declaration: if kind == 1u32 {
      source.declaration + 1u64
    } else {
      source.declaration
    }
    physical_type: source.physical_type
    arguments: if kind == 2u32 {
      {
        start: source.arguments.start + 1u32
        length: source.arguments.length
      }
    } else {
      if kind == 3u32 {
      {
        start: source.arguments.start
        length: source.arguments.length - 1u32
      }
    } else {
      source.arguments
    }
    }
    operands: if kind == 4u32 {
      {
        start: source.operands.start + 1u32
        length: source.operands.length
      }
    } else {
      if kind == 5u32 {
      {
        start: source.operands.start
        length: source.operands.length - 1u32
      }
    } else {
      source.operands
    }
    }
  }
  self_host_assert_frozen_physical_body(frozen, plan)
}

fn self_host_test_variant_operand_change(kind: U32) -> Unit {
  let (_, plan) = self_host_variant_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let source = plan.variant_constructor_operands[0u32]
  plan.variant_constructor_operands[0u32] = {
    expression: if kind == 0u32 {
      source.expression + 1u32
    } else {
      source.expression
    }
    declaration: if kind == 1u32 {
      source.declaration + 1u64
    } else {
      source.declaration
    }
    source_ordinal: if kind == 2u32 {
      source.source_ordinal + 1u32
    } else {
      source.source_ordinal
    }
    field_index: if kind == 3u32 {
      source.field_index + 1u32
    } else {
      source.field_index
    }
    storage: if kind == 4u32 {
      WasmI64Storage
    } else {
      source.storage
    }
    box_type: if kind == 5u32 {
      Some(0u32)
    } else {
      source.box_type
    }
    unit_marker: if kind == 6u32 {
      !source.unit_marker
    } else {
      source.unit_marker
    }
    reference_cast: if kind == 7u32 {
      Some(0u32)
    } else {
      source.reference_cast
    }
  }
  self_host_assert_frozen_physical_body(frozen, plan)
}

test "BOD-605 frozen variant constructors retain expression identities" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(0u32)
}

test "BOD-605 frozen variant constructors retain declaration identities" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(1u32)
}

test "BOD-605 frozen variant constructors retain argument starts" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(2u32)
}

test "BOD-605 frozen variant constructors retain argument counts" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(3u32)
}

test "BOD-605 frozen variant constructors retain operand starts" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(4u32)
}

test "BOD-605 frozen variant constructors retain operand counts" expect_trap "unreachable" {
  self_host_test_variant_constructor_change(5u32)
}

test "BOD-605 frozen variant operands retain source expressions" expect_trap "unreachable" {
  self_host_test_variant_operand_change(0u32)
}

test "BOD-605 frozen variant operands retain declaration identities" expect_trap "unreachable" {
  self_host_test_variant_operand_change(1u32)
}

test "BOD-605 frozen variant operands retain source order" expect_trap "unreachable" {
  self_host_test_variant_operand_change(2u32)
}

test "BOD-605 frozen variant operands retain field indices" expect_trap "unreachable" {
  self_host_test_variant_operand_change(3u32)
}

test "BOD-605 frozen variant operands retain storage types" expect_trap "unreachable" {
  self_host_test_variant_operand_change(4u32)
}

test "BOD-605 frozen variant operands retain boxing choices" expect_trap "unreachable" {
  self_host_test_variant_operand_change(5u32)
}

test "BOD-605 frozen variant operands retain Unit markers" expect_trap "unreachable" {
  self_host_test_variant_operand_change(6u32)
}

test "BOD-605 frozen variant operands retain reference casts" expect_trap "unreachable" {
  self_host_test_variant_operand_change(7u32)
}

test "BOD-605 frozen variant constructors cannot disappear" expect_trap "unreachable" {
  let (_, plan) = self_host_variant_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let _ = plan.variant_constructors.pop()
  self_host_assert_frozen_physical_body(frozen, plan)
}

test "BOD-608 variant recipe targets agree before freeze" expect_trap "unreachable" {
  let (link, plan) = self_host_variant_recipe_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[0u32]
  let source = plan.variant_constructors[0u32]
  plan.variant_constructors[0u32] = {
    expression: source.expression
    declaration: source.declaration
    physical_type: source.physical_type + 1u32
    arguments: source.arguments
    operands: source.operands
  }
  self_host_verify_variant_constructors(link, module_, body, plan)
}

test "BOD-610 variant emission requires its exact recipe" expect_trap "unreachable" {
  let (link, plan) = self_host_variant_recipe_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[0u32]
  let source = plan.variant_constructors[0u32]
  let _ = plan.variant_constructors.pop()
  let _ = self_host_required_variant_constructor(plan, module_, body, source.expression, source.arguments)
}

test "BOD-610 variant emission requires a unique recipe" expect_trap "unreachable" {
  let (link, plan) = self_host_variant_recipe_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[0u32]
  let source = plan.variant_constructors[0u32]
  plan.variant_constructors.push(source)
  let _ = self_host_required_variant_constructor(plan, module_, body, source.expression, source.arguments)
}

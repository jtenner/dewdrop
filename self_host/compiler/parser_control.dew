open dew.std.array
open dew.std.option
open dew.std.string
open dew.std.string_builder

fn self_host_empty_block_items() -> Array<SelfHostBlockItem> {
  new()
}

fn self_host_empty_pattern_arms() -> Array<SelfHostPatternArm> {
  new()
}

fn self_host_empty_function_parameters() -> Array<SelfHostFnParameter> {
  new()
}

fn self_host_no_expression() -> Option<SelfHostExpr> {
  None
}

fn self_host_no_receiver() -> Option<SelfHostReceiverParameter> {
  None
}

fn self_host_empty_block(offset: U32) -> SelfHostBlock {
  {
    items: self_host_empty_block_items()
    offset: offset
  }
}

fn self_host_parse_function_parameters(
  parser: SelfHostParser,
  allow_receiver: Bool,
) -> Option<(Option<SelfHostReceiverParameter>, Array<SelfHostFnParameter>)> {
  let parameters = self_host_empty_function_parameters()
  let mut receiver = self_host_no_receiver()
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    return Some((receiver, parameters))
  } else {
  }
  let result = while 0u32 {
    _ => {
      let pair = match self_host_parser_identifier(
        parser,
        ParameterName,
      ) {
        Some(value) => value
        None => break None
      }
      let (name, offset) = pair
      if name.equals("self") && allow_receiver {
        if receiver is Some(_) || parameters.length() > 0u32 {
          self_host_parser_fail(
            parser,
            ReceiverMustBeFirst(offset),
          )
          break None
        } else {
        }
        let explicit_type = if self_host_parser_consume_symbol(
          parser,
          13u32,
        ) {
          self_host_parse_type(parser)
        } else {
          None
        }
        if parser.diagnostic is Some(_) {
          break None
        } else {
        }
        receiver = Some({
          explicit_type: explicit_type
          offset: offset
        })
      } else {
        if !self_host_parser_expect_symbol(
          parser,
          13u32,
          Colon,
        ) {
          break None
        } else {
        }
        match self_host_parse_type(parser) {
          Some(type_) => parameters.push({
            name: name
            type_: type_
            offset: offset
          })
          None => break None
        }
      }
      self_host_parser_skip_newlines(parser)
      if self_host_parser_consume_symbol(parser, 1u32) {
        break Some((receiver, parameters))
      } else if self_host_parser_consume_symbol(
        parser,
        25u32,
      ) {
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(
          parser,
          1u32,
        ) {
          break Some((receiver, parameters))
        } else {
          continue 0u32
        }
      } else {
        self_host_parser_fail_expected(
          parser,
          ParameterSeparatorOrClose,
        )
        break None
      }
    }
  }
  result
}

fn self_host_parse_lambda_expression(
  parser: SelfHostParser,
  offset: U32,
) -> Option<SelfHostExpr> {
  if !self_host_parser_expect_symbol(
    parser,
    0u32,
    LeftParen,
  ) {
    return None
  } else {
  }
  let parsed = match self_host_parse_function_parameters(parser, false) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (_, parameters) = parsed
  if !self_host_parser_expect_symbol(
    parser,
    31u32,
    Arrow,
  ) {
    return None
  } else {
  }
  let return_type = match self_host_parse_type(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  match self_host_parse_block_after_left(parser, body_offset) {
    Some(body) => Some(
      LambdaExpr(parameters, return_type, body, offset),
    )
    None => None
  }
}

struct SelfHostDeferredCleanup {
  name: String
  offset: U32
}

fn self_host_empty_cleanups() -> Array<SelfHostDeferredCleanup> {
  new()
}

fn self_host_cleanup_call(cleanup: SelfHostDeferredCleanup) -> SelfHostExpr {
  CallExpr(
    NameExpr(cleanup.name, cleanup.offset),
    self_host_empty_expressions(),
    cleanup.offset,
  )
}

fn self_host_append_cleanups(
  items: Array<SelfHostBlockItem>,
  cleanups: Array<SelfHostDeferredCleanup>,
) -> Unit {
  let _ = while cleanups.length() {
    remaining if remaining > 0u32 => {
      let cleanup = cleanups.get_unchecked(remaining - 1u32)
      items.push(
        self_host_expression_block_item(
          self_host_cleanup_call(cleanup),
          cleanup.offset,
        ),
      )
      continue remaining - 1u32
    }
    _ => break self_host_parser_unit()
  }
}

fn self_host_append_return_expression(
  items: Array<SelfHostBlockItem>,
  cleanups: Array<SelfHostDeferredCleanup>,
  value: Option<SelfHostExpr>,
  offset: U32,
) -> Unit {
  match value {
    Some(expression) => if cleanups.length() == 0u32 {
      items.push(
        self_host_expression_block_item(
          ReturnExpr(Some(expression), offset),
          offset,
        ),
      )
    } else {
      let name = self_host_product_name("$defer_result_", offset)
      items.push(
        self_host_let_block_item(false, name, offset, expression, offset),
      )
      self_host_append_cleanups(items, cleanups)
      items.push(
        self_host_expression_block_item(
          ReturnExpr(
            Some(NameExpr(name, offset)),
            offset,
          ),
          offset,
        ),
      )
    }
    None => {
      self_host_append_cleanups(items, cleanups)
      items.push(
        self_host_expression_block_item(
          ReturnExpr(None, offset),
          offset,
        ),
      )
    }
  }
}

fn self_host_register_cleanup(
  items: Array<SelfHostBlockItem>,
  cleanups: Array<SelfHostDeferredCleanup>,
  value: SelfHostExpr,
  offset: U32,
) -> Unit {
  let name = self_host_product_name("$defer_", offset)
  let body_items = self_host_empty_block_items()
  body_items.push(self_host_expression_block_item(value, offset))
  let lambda = LambdaExpr(
    self_host_empty_function_parameters(),
    NamedType("Unit", offset),
    {
      items: body_items
      offset: offset
    },
    offset,
  )
  items.push(
    self_host_let_block_item(false, name, offset, lambda, offset),
  )
  cleanups.push({
    name: name
    offset: offset
  })
}

fn self_host_finalize_deferred_block(
  items: Array<SelfHostBlockItem>,
  cleanups: Array<SelfHostDeferredCleanup>,
  offset: U32,
) -> SelfHostBlock {
  if cleanups.length() == 0u32 || items.length() == 0u32 {
    return {
      items: items
      offset: offset
    }
  } else {
  }
  let last = items.get_unchecked(items.length() - 1u32)
  if self_host_u32_equal(last.kind, 3u32) {
    match last.value {
      ReturnExpr(_, _) => {}
      BreakExpr(_, _) => {}
      ContinueExpr(_, _) => {}
      value => {
        let _ = self_host_array_pop(items)
        let name = self_host_product_name("$defer_result_", last.offset)
        items.push(
          self_host_let_block_item(
            false,
            name,
            last.offset,
            value,
            last.offset,
          ),
        )
        self_host_append_cleanups(items, cleanups)
        items.push(
          self_host_expression_block_item(
            NameExpr(name, last.offset),
            last.offset,
          ),
        )
      }
    }
  } else {
    self_host_append_cleanups(items, cleanups)
  }
  {
    items: items
    offset: offset
  }
}

enum SelfHostProductBinding {
  NamedProductBinding(String, U32)
  IgnoredProductBinding
  NestedProductBinding(Array<SelfHostProductBinding>, U32)
}

fn self_host_empty_product_bindings() -> Array<SelfHostProductBinding> {
  new()
}

fn self_host_product_name(prefix: String, offset: U32) -> String {
  let builder = StringBuilder::new()
  builder.append(prefix)
  builder.append_u32(offset)
  builder.finish()
}

fn self_host_parse_product_binding_after_left(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostProductBinding> {
  let fields = self_host_empty_product_bindings()
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      let field = match self_host_parser_peek(parser) {
        Some(token) => match token.kind {
          Identifier(name, _) => {
            parser.index = parser.index + 1u32
            // A product wildcard needs String content proof.
            if self_host_tokenizer_string_equals(name, "_") {
              IgnoredProductBinding
            } else {
              NamedProductBinding(name, token.offset)
            }
          }
          Symbol(symbol_code, _) if symbol_code == 0u32 => {
            parser.index = parser.index + 1u32
            match self_host_parse_product_binding_after_left(
              parser,
              token.offset,
            ) {
              Some(value) => value
              None => break None
            }
          }
          _ => {
            self_host_parser_fail_expected(
              parser,
              BindingName,
            )
            break None
          }
        }
        None => {
          self_host_parser_fail(
            parser,
            UnclosedExpression(
              "product binding",
              open_offset,
            ),
          )
          break None
        }
      }
      fields.push(field)
      self_host_parser_skip_newlines(parser)
      if self_host_parser_consume_symbol(parser, 1u32) {
        if fields.length() < 2u32 || fields.length() > 32u32 {
          self_host_parser_fail(
            parser,
            InvalidProductArity(
              fields.length(),
              open_offset,
            ),
          )
          break None
        } else {
          break Some(
            NestedProductBinding(
              fields,
              open_offset,
            ),
          )
        }
      } else if self_host_parser_consume_symbol(
        parser,
        25u32,
      ) {
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(
          parser,
          1u32,
        ) {
          if fields.length() < 2u32 || fields.length() > 32u32 {
            self_host_parser_fail(
              parser,
              InvalidProductArity(
                fields.length(),
                open_offset,
              ),
            )
            break None
          } else {
            break Some(
              NestedProductBinding(
                fields,
                open_offset,
              ),
            )
          }
        } else {
          continue 0u32
        }
      } else {
        self_host_parser_fail_expected(
          parser,
          Equal,
        )
        break None
      }
    }
  }
  result
}

fn self_host_append_product_bindings(
  items: Array<SelfHostBlockItem>,
  mutable_: Bool,
  binding: SelfHostProductBinding,
  target: SelfHostExpr,
  let_offset: U32,
) -> Unit {
  match binding {
    NamedProductBinding(name, offset) => items.push(
      self_host_let_block_item(
        mutable_,
        name,
        offset,
        target,
        let_offset,
      ),
    )
    IgnoredProductBinding => {}
    NestedProductBinding(fields, offset) => {
      let _ = while 0u32 {
        index if index < fields.length() => {
          self_host_append_product_bindings(
            items,
            mutable_,
            fields.get_unchecked(index),
            ProductFieldExpr(
              target,
              index,
              fields.length(),
              offset,
            ),
            let_offset,
          )
          continue index + 1u32
        }
        _ => break self_host_parser_unit()
      }
    }
  }
}

fn self_host_parse_block_let(
  parser: SelfHostParser,
  items: Array<SelfHostBlockItem>,
  let_offset: U32,
) -> Bool {
  let mutable_ = self_host_parser_consume_keyword(
    parser,
    13u32,
  )
  let binding = match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Identifier(name, _) => {
        parser.index = parser.index + 1u32
        // String patterns are not proof that this binding is a wildcard.
        if self_host_tokenizer_string_equals(name, "_") {
          IgnoredProductBinding
        } else {
          NamedProductBinding(name, token.offset)
        }
      }
      Symbol(symbol_code, _) if symbol_code == 0u32 => {
        parser.index = parser.index + 1u32
        match self_host_parse_product_binding_after_left(parser, token.offset) {
          Some(value) => value
          None => {
            return false
          }
        }
      }
      _ => {
        self_host_parser_fail_expected(
          parser,
          BindingName,
        )
        return false
      }
    }
    None => {
      self_host_parser_fail_expected(
        parser,
        BindingName,
      )
      return false
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    15u32,
    Equal,
  ) {
    return false
  } else {
  }
  let value = match self_host_parse_expression_context(parser, 0u32, false) {
    Some(value) => value
    None => {
            return false
          }
  }
  match binding {
    NamedProductBinding(name, offset) => items.push(
      self_host_let_block_item(
        mutable_,
        name,
        offset,
        value,
        let_offset,
      ),
    )
    IgnoredProductBinding => {
      items.push(self_host_expression_block_item(value, let_offset))
      items.push(
        self_host_expression_block_item(
          BlockExpr(self_host_empty_block(let_offset)),
          let_offset,
        ),
      )
    }
    NestedProductBinding(_, offset) => {
      let hidden = self_host_product_name("$product_", let_offset)
      items.push(
        self_host_let_block_item(
          false,
          hidden,
          offset,
          value,
          let_offset,
        ),
      )
      self_host_append_product_bindings(
        items,
        mutable_,
        binding,
        NameExpr(hidden, offset),
        let_offset,
      )
    }
  }
  true
}

fn self_host_parse_block_after_left(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<SelfHostBlock> {
  let items = self_host_empty_block_items()
  let cleanups = self_host_empty_cleanups()
  if self_host_parser_consume_symbol(parser, 3u32) {
    return Some({
      items: items
      offset: open_offset
    })
  } else {
  }
  if !self_host_parser_consume_newline(parser) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "block body newline",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      if self_host_parser_consume_symbol(parser, 3u32) {
        break Some(
          self_host_finalize_deferred_block(items, cleanups, open_offset),
        )
      } else {
      }
      let token = match self_host_parser_peek(parser) {
        Some(value) => value
        None => {
          self_host_parser_fail(
            parser,
            UnclosedExpression("block", open_offset),
          )
          break None
        }
      }
      if self_host_token_is_keyword(token, 12u32) {
        parser.index = parser.index + 1u32
        let pair = match self_host_parser_identifier(
          parser,
          BindingName,
        ) {
          Some(value) => value
          None => break None
        }
        let (name, name_offset) = pair
        if !self_host_parser_expect_symbol(
          parser,
          15u32,
          Equal,
        ) {
          break None
        } else {
        }
        let value = match self_host_parse_expression_context(
          parser,
          0u32,
          false,
        ) {
          Some(value) => value
          None => break None
        }
        if !self_host_parser_finish_line(parser) {
          break None
        } else {
        }
        items.push(
          self_host_let_block_item(
            false,
            name,
            name_offset,
            value,
            token.offset,
          ),
        )
        self_host_register_cleanup(
          items,
          cleanups,
          CallExpr(
            FieldExpr(
              NameExpr(name, name_offset),
              "dispose",
              token.offset,
            ),
            self_host_empty_expressions(),
            token.offset,
          ),
          token.offset,
        )
        self_host_parser_skip_newlines(parser)
        continue 0u32
      } else if self_host_token_is_keyword(token, 21u32) {
        parser.index = parser.index + 1u32
        let value = match self_host_parse_expression_context(
          parser,
          0u32,
          false,
        ) {
          Some(value) => value
          None => break None
        }
        if !self_host_parser_finish_line(parser) {
          break None
        } else {
        }
        self_host_register_cleanup(
          items,
          cleanups,
          value,
          token.offset,
        )
        self_host_parser_skip_newlines(parser)
        continue 0u32
      } else if self_host_token_is_keyword(token, 10u32) {
        parser.index = parser.index + 1u32
        let pair = match self_host_parser_identifier(parser, TypeAliasName) {
          Some(value) => value
          None => break None
        }
        let (name, _) = pair
        if !self_host_parser_expect_symbol(parser, 15u32, Equal) {
          break None
        }
        let target = match self_host_parse_type(parser) {
          Some(value) => value
          None => break None
        }
        if !self_host_parser_finish_line(parser) {
          break None
        }
        items.push(self_host_type_binding_block_item(name, target, token.offset))
        self_host_parser_skip_newlines(parser)
        continue 0u32
      } else if self_host_token_is_keyword(token, 11u32) {
        parser.index = parser.index + 1u32
        if !self_host_parse_block_let(parser, items, token.offset) {
          break None
        } else {
        }
      } else {
        let expression_starts_return = self_host_token_is_keyword(
          token,
          20u32,
        )
        let expression = match self_host_parse_expression_context(
          parser,
          0u32,
          false,
        ) {
          Some(value) => value
          None => break None
        }
        if self_host_parser_consume_symbol(parser, 15u32) {
          let equal_offset = token.offset
          let value = match self_host_parse_expression_context(
            parser,
            0u32,
            false,
          ) {
            Some(value) => value
            None => break None
          }
          match expression {
            IndexExpr(_, _, _) => items.push(
              self_host_index_set_block_item(
                expression,
                value,
                equal_offset,
              ),
            )
            NameExpr(_, _) => items.push(
              self_host_assignment_block_item(
                expression,
                value,
                equal_offset,
              ),
            )
            FieldExpr(_, _, _) => items.push(
              self_host_assignment_block_item(
                expression,
                value,
                equal_offset,
              ),
            )
            _ => {
              self_host_parser_fail(
                parser,
                ExpectedDelimiter(
                  "assignment target",
                  Some(token),
                  equal_offset,
                ),
              )
              break None
            }
          }
        } else if expression_starts_return {
          match expression {
            ReturnExpr(value, return_offset) =>
              self_host_append_return_expression(
                items,
                cleanups,
                value,
                return_offset,
              )
            _ => items.push(
              self_host_expression_block_item(expression, token.offset),
            )
          }
        } else {
          items.push(
            self_host_expression_block_item(expression, token.offset),
          )
        }
      }
      if !self_host_parser_finish_line(parser) {
        break None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      continue 0u32
    }
  }
  result
}

fn self_host_parse_if_expression(
  parser: SelfHostParser,
  offset: U32,
) -> Option<SelfHostExpr> {
  let condition = match self_host_parse_expression_context(parser, 0u32, true) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_consume_symbol(parser, 2u32) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "if body",
        self_host_parser_peek(parser),
        offset,
      ),
    )
    return None
  } else {
  }
  let body = match self_host_parse_block_after_left(parser, body_offset) {
    Some(value) => value
    None => {
      return None
    }
  }
  let alternative = if self_host_parser_consume_keyword(
    parser,
    15u32,
  ) {
    if self_host_parser_consume_keyword(parser, 14u32) {
      self_host_parse_if_expression(parser, self_host_parser_offset(parser))
    } else {
      let alternative_offset = self_host_parser_offset(parser)
      if !self_host_parser_consume_symbol(
        parser,
        2u32,
      ) {
        self_host_parser_fail(
          parser,
          ExpectedDelimiter(
            "else body",
            self_host_parser_peek(parser),
            offset,
          ),
        )
        self_host_no_expression()
      } else {
        match self_host_parse_block_after_left(parser, alternative_offset) {
          Some(value) =>
            Some(BlockExpr(value))
          None => None
        }
      }
    }
  } else {
    None
  }
  if parser.diagnostic is Some(_) {
    None
  } else {
    let original_condition = condition
    match condition {
      IsExpr(scrutinee, pattern, is_offset) => {
        let fallback = match alternative {
          Some(value) => value
          None => BlockExpr(
            self_host_empty_block(offset),
          )
        }
        let arms = self_host_empty_pattern_arms()
        arms.push({
          pattern: pattern
          guard_condition: None
          body: BlockExpr(body)
          offset: pattern.offset()
        })
        arms.push({
          pattern: WildcardPattern(is_offset)
          guard_condition: None
          body: fallback
          offset: is_offset
        })
        Some(
          MatchExpr(scrutinee, arms, is_offset),
        )
      }
      IsGuardExpr(
        scrutinee,
        pattern,
        guard,
        is_offset,
      ) => {
        let fallback = match alternative {
          Some(value) => value
          None => BlockExpr(
            self_host_empty_block(offset),
          )
        }
        let arms = self_host_empty_pattern_arms()
        arms.push({
          pattern: pattern
          guard_condition: Some(guard)
          body: BlockExpr(body)
          offset: pattern.offset()
        })
        arms.push({
          pattern: WildcardPattern(is_offset)
          guard_condition: None
          body: fallback
          offset: is_offset
        })
        Some(
          MatchExpr(scrutinee, arms, is_offset),
        )
      }
      _ => Some(
        IfExpr(
          original_condition,
          body,
          alternative,
          offset,
        ),
      )
    }
  }
}

fn self_host_parse_arm_pattern(
  parser: SelfHostParser,
) -> Option<SelfHostPattern> {
  let first = match self_host_parse_pattern_context(parser, false, false) {
    Some(value) => value
    None => {
      return None
    }
  }
  let alternatives = self_host_empty_patterns()
  let _ = while 0u32 {
    _ => if self_host_parser_consume_symbol(parser, 25u32) {
      self_host_parser_skip_newlines(parser)
      match self_host_parse_pattern_context(parser, false, false) {
        Some(value) => {
          alternatives.push(value)
          continue 0u32
        }
        None => break self_host_parser_unit()
      }
    } else {
      break self_host_parser_unit()
    }
  }
  if parser.diagnostic is Some(_) {
    None
  } else if alternatives.length() == 0u32 {
    Some(first)
  } else {
    Some(
      AlternativePattern(
        first,
        alternatives,
        first.offset(),
      ),
    )
  }
}

fn self_host_parse_pattern_arms(
  parser: SelfHostParser,
  open_offset: U32,
) -> Option<Array<SelfHostPatternArm>> {
  let arms = self_host_empty_pattern_arms()
  if !self_host_parser_consume_newline(parser) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "pattern arm body newline",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      if self_host_parser_consume_symbol(parser, 3u32) {
        break Some(arms)
      } else {
      }
      let pattern = match self_host_parse_arm_pattern(parser) {
        Some(value) => value
        None => break None
      }
      let guard_condition = if self_host_parser_consume_keyword(
        parser,
        14u32,
      ) {
        self_host_parse_expression_context(parser, 0u32, false)
      } else {
        None
      }
      if parser.diagnostic is Some(_) {
        break None
      } else if !self_host_parser_consume_symbol(
        parser,
        17u32,
      ) {
        self_host_parser_fail(
          parser,
          ExpectedDelimiter(
            "pattern arm =>",
            self_host_parser_peek(parser),
            open_offset,
          ),
        )
        break None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      let body_offset = self_host_parser_offset(parser)
      let body = if self_host_parser_consume_symbol(
        parser,
        2u32,
      ) {
        match self_host_parse_block_after_left(parser, body_offset) {
          Some(value) => BlockExpr(value)
          None => break None
        }
      } else {
        match self_host_parse_expression_context(parser, 0u32, false) {
          Some(value) => value
          None => break None
        }
      }
      arms.push({
        pattern: pattern
        guard_condition: guard_condition
        body: body
        offset: pattern.offset()
      })
      if !self_host_parser_finish_line(parser) {
        break None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      continue 0u32
    }
  }
  result
}

fn self_host_parse_match_expression(
  parser: SelfHostParser,
  offset: U32,
) -> Option<SelfHostExpr> {
  let scrutinee = match self_host_parse_expression_context(parser, 0u32, true) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_consume_symbol(parser, 2u32) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "match body",
        self_host_parser_peek(parser),
        offset,
      ),
    )
    return None
  } else {
  }
  match self_host_parse_pattern_arms(parser, body_offset) {
    Some(arms) => Some(
      MatchExpr(scrutinee, arms, offset),
    )
    None => None
  }
}

fn self_host_parse_while_expression(
  parser: SelfHostParser,
  offset: U32,
) -> Option<SelfHostExpr> {
  let scrutinee = match self_host_parse_expression_context(parser, 0u32, true) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_consume_symbol(parser, 2u32) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "while body",
        self_host_parser_peek(parser),
        offset,
      ),
    )
    return None
  } else {
  }
  match self_host_parse_pattern_arms(parser, body_offset) {
    Some(arms) => Some(
      WhileExpr(scrutinee, arms, offset),
    )
    None => None
  }
}

fn self_host_for_next_expression(name: String, offset: U32) -> SelfHostExpr {
  CallExpr(
    FieldExpr(
      NameExpr(name, offset),
      "next",
      offset,
    ),
    self_host_empty_expressions(),
    offset,
  )
}

fn self_host_parse_for_expression(
  parser: SelfHostParser,
  offset: U32,
) -> Option<SelfHostExpr> {
  let pattern = match self_host_parse_pattern_context(parser, false, false) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_expect_keyword(
    parser,
    27u32,
    ForOrLeftBrace,
  ) {
    return None
  } else {
  }
  let iterable = match self_host_parse_expression_context(parser, 0u32, true) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_consume_symbol(parser, 2u32) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "for body",
        self_host_parser_peek(parser),
        offset,
      ),
    )
    return None
  } else {
  }
  let body = match self_host_parse_block_after_left(parser, body_offset) {
    Some(value) => value
    None => {
      return None
    }
  }
  let iterator_name = "$for_iter"
  let iterator_value = CallExpr(
    FieldExpr(iterable, "iter", offset),
    self_host_empty_expressions(),
    offset,
  )
  body.items.push(
    self_host_expression_block_item(
      ContinueExpr(
        self_host_for_next_expression(iterator_name, offset),
        offset,
      ),
      offset,
    ),
  )
  let some_target = QualifiedPattern(
    BindingPattern("Option", offset),
    "Some",
    offset,
  )
  let some_pattern = TuplePattern(
    some_target,
    [pattern],
    offset,
  )
  let none_pattern = QualifiedPattern(
    BindingPattern("Option", offset),
    "None",
    offset,
  )
  let while_arms = self_host_empty_pattern_arms()
  while_arms.push({
    pattern: some_pattern
    guard_condition: None
    body: BlockExpr(body)
    offset: offset
  })
  while_arms.push({
    pattern: none_pattern
    guard_condition: None
    body: BreakExpr(
      BlockExpr(self_host_empty_block(offset)),
      offset,
    )
    offset: offset
  })
  let outer_items = self_host_empty_block_items()
  outer_items.push(
    self_host_let_block_item(
      false,
      iterator_name,
      offset,
      iterator_value,
      offset,
    ),
  )
  outer_items.push(
    self_host_expression_block_item(
      WhileExpr(
        self_host_for_next_expression(iterator_name, offset),
        while_arms,
        offset,
      ),
      offset,
    ),
  )
  Some(
    BlockExpr({
      items: outer_items
      offset: offset
    }),
  )
}

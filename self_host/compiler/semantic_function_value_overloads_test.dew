open dew.std.array
open dew.std.testing

fn self_host_function_value_test_infer(source: Bytes) -> (SelfHostCollectedModule, SelfHostBasicInferredModuleBodies) {
  let collected = self_host_collect_bytes(7351u64, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  assert(collected.diagnostics.length() == 0u32, "function value collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "function value signature diagnostics")
  assert(names.diagnostics.length() == 0u32, "function value name diagnostics")
  (collected, self_host_infer_basic_module_bodies(collected, resolved, names))
}

fn self_host_function_value_test_selected(body: SelfHostBasicInferredBody, declaration: U64) -> Bool {
  for target in body.call_targets {
    match target {
      SelectedBasicCallTarget(selected, _) if selected == declaration => return true
      _ => {}
    }
  }
  false
}

test "overloaded builtin function values use expected complete signatures" {
  let (collected, inferred) = self_host_function_value_test_infer(
    b"builtin adjust(value: I32) -> I32 = \"i32.extend8_s\"\nbuiltin adjust(value: Bool) -> Bool = \"i32.eqz\"\nfn flag() -> fn(Bool) -> Bool {\n  adjust\n}\nfn number() -> fn(I32) -> I32 {\n  adjust\n}\n",
  )
  assert(inferred.bodies.length() == 2u32, "both function value bodies inferred")
  assert(inferred.bodies[0u32].diagnostics.length() == 0u32, "Bool function value inference")
  assert(inferred.bodies[1u32].diagnostics.length() == 0u32, "I32 function value inference")
  assert(self_host_function_value_test_selected(inferred.bodies[0u32], collected.declarations[1u32].id), "Bool signature selects Bool declaration")
  assert(self_host_function_value_test_selected(inferred.bodies[1u32], collected.declarations[0u32].id), "I32 signature selects I32 declaration")
}

test "overloaded function values distinguish same-carrier result types" {
  let (collected, inferred) = self_host_function_value_test_infer(
    b"builtin pick(value: I32) -> I32 = \"i32.extend8_s\"\nbuiltin pick(value: I32) -> U32 = \"unsafe.bitcast\"\nfn number() -> fn(I32) -> U32 {\n  pick\n}\n",
  )
  assert(inferred.bodies[0u32].diagnostics.length() == 0u32, "result signature inference")
  assert(self_host_function_value_test_selected(inferred.bodies[0u32], collected.declarations[1u32].id), "logical result type selects declaration")
}

test "overloaded generic function values keep checked type arguments" {
  let (collected, inferred) = self_host_function_value_test_infer(
    b"builtin pick<t>(value: t) -> t = \"unsafe.bitcast\"\nbuiltin pick(value: Bool) -> I32 = \"i32.eqz\"\nfn flag() -> fn(Bool) -> Bool {\n  pick\n}\n",
  )
  let body = inferred.bodies[0u32]
  assert(body.diagnostics.length() == 0u32, "generic function value inference")
  assert(self_host_function_value_test_selected(body, collected.declarations[0u32].id), "generic full signature selects declaration")
  let mut found = false
  for target in body.call_targets {
    match target {
      SelectedBasicCallTarget(selected, arguments) if selected == collected.declarations[0u32].id => {
        found = arguments.length == 1u32
      }
      _ => {}
    }
  }
  assert(found, "generic function reference retains one type argument")
}

test "overloaded function values report no matching signature" {
  let (_, inferred) = self_host_function_value_test_infer(
    b"builtin adjust(value: I32) -> I32 = \"i32.extend8_s\"\nbuiltin adjust(value: Bool) -> Bool = \"i32.eqz\"\nfn number() -> fn(U64) -> U64 {\n  adjust\n}\n",
  )
  let mut found = false
  for diagnostic in inferred.bodies[0u32].diagnostics {
    if diagnostic is NoMatchingFunctionReference(_, _, _) {
      found = true
    }
  }
  assert(found, "missing function signature is diagnostic")
}

test "overloaded function values report ambiguous signatures" {
  let (_, inferred) = self_host_function_value_test_infer(
    b"builtin pick<t>(value: t) -> t = \"unsafe.bitcast\"\nbuiltin pick<u>(value: u) -> u = \"unsafe.bitcast\"\nfn flag() -> fn(Bool) -> Bool {\n  pick\n}\n",
  )
  let mut found = false
  for diagnostic in inferred.bodies[0u32].diagnostics {
    match diagnostic {
      AmbiguousFunctionReference(_, _, first, second, count, _) if first != second && count == 2u32 => {
        found = true
      }
      _ => {}
    }
  }
  assert(found, "ambiguous function signature is diagnostic")
}

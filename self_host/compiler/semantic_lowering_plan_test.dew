open dew.std.testing

fn self_host_lowering_test_plan(source: Bytes) -> SelfHostPlannedModuleLowering {
  let collected = self_host_collect_bytes(5000u64, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let module_values = self_host_infer_module_values(collected, resolved, names)
  let basic = self_host_infer_basic_module_bodies(collected, resolved, names)
  let merged = self_host_merge_module_inference(basic)
  let flows = self_host_analyze_basic_module_flows(collected, resolved, basic)
  self_host_plan_module_lowering(
    collected,
    resolved,
    self_host_plan_module_type_layouts(collected, resolved),
    self_host_plan_module_initialization(collected, module_values),
    self_host_plan_module_functions(collected, resolved),
    names,
    merged,
    flows,
  )
}

test "lowering plans core expressions, blocks, and locals" {
  let planned = self_host_lowering_test_plan(
    b"fn run(value: I32) -> I32 {\n  let next = value + 1\n  if true {\n    next\n  } else {\n    0\n  }\n}\n",
  )
  assert(planned.bodies.length() == 1u32, "one body")
  assert(planned.expressions.length() > 0u32, "expressions")
  assert(planned.blocks.length() > 0u32, "blocks")
  let mut saw_local = false
  let mut saw_binary = false
  let mut saw_if = false
  let mut saw_block = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedLocalGet(_) => {
        saw_local = true
      }
      SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, _, _) => {
        saw_binary = true
      }
      SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) => {
        saw_if = true
      }
      SelfHostPlannedExpressionKind::PlannedBlockExpression(_) => {
        saw_block = true
      }
      _ => {}
    }
  }
  assert(saw_local, "local get")
  assert(saw_binary, "binary")
  assert(saw_if, "if")
  assert(saw_block, "block")
  let mut saw_let = false
  for item in planned.block_items {
    match item.kind {
      SelfHostPlannedBlockItemKind::PlannedLetItem(_, _, _) => {
        saw_let = true
      }
      _ => {}
    }
  }
  assert(saw_let, "let item")
  assert(
    planned.bodies[0u32].root_shape is SelfHostPlannedValueShape::I32PlannedValueShape,
    "body shape",
  )
}

test "lowering plans qualified unit variants as constructors" {
  let planned = self_host_lowering_test_plan(
    b"enum State {\n  Ready\n}\nfn run() -> State {\n  State::Ready\n}\n",
  )
  let mut saw_unit_variant = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedConstruct(
        _,
        fields,
        SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
          _,
          _,
          _,
        ),
      ) => if self_host_u32_equal(fields.length, 0u32) {
        saw_unit_variant = true
      }
      _ => {}
    }
  }
  assert(saw_unit_variant, "qualified unit variant constructor")
}

test "lowering keeps tuple variants ahead of colliding builtin ids" {
  let planned = self_host_lowering_test_plan(
    b"enum Value {\n  Item(I32)\n}\nfn run() -> Value {\n  Value::Item(1)\n}\n",
  )
  let mut saw_variant_call = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => match expression.selection {
        SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
          _,
          _,
          _,
        ) => {
          saw_variant_call = true
        }
        _ => {}
      }
      SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, _, _, _) => match expression.selection {
        SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
          _,
          _,
          _,
        ) => assert(false, "variant lowered as builtin")
        _ => {}
      }
      _ => {}
    }
  }
  assert(saw_variant_call, "tuple variant direct lowering")
}

test "lowering plans direct calls" {
  let planned = self_host_lowering_test_plan(
    b"fn add(value: I32) -> I32 {\n  value + 1\n}\nfn run() -> I32 {\n  add(1)\n}\n",
  )
  let mut saw_call = false
  let mut saw_consumed = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => {
        saw_call = true
      }
      SelfHostPlannedExpressionKind::PlannedConsumedExpression => {
        saw_consumed = true
      }
      _ => {}
    }
  }
  assert(saw_call, "direct call")
  assert(saw_consumed, "consumed direct target")
}


  let planned = self_host_lowering_test_plan(
    b"fn assign() -> I32 {\n  let mut value = 1\n  value = 2\n  value\n}\n",
  )
  let mut saw_set = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedLocalSet(_, _) => {

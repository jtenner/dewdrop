test "lowering plans patterns and functional loops" {
  let planned = self_host_lowering_test_plan(
    b"fn run(value: Bool) -> I32 {\n  match value {\n    true => 1\n    false => 0\n  }\n}\n",
  )
  assert(planned.patterns.length() == 2u32, "patterns")
  assert(planned.pattern_arms.length() == 2u32, "arms")
  let mut saw_match = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedMatchExpression(_, _) => {
        saw_match = true
      }
      _ => {}
    }
  }
  assert(saw_match, "match")
}

test "lowering retains functional loop control targets" {
  let planned = self_host_lowering_test_plan(
    b"fn finish(initial: I32) -> I32 {\n  while initial {\n    value if value == 0 => break value\n    value => continue value - 1\n  }\n}\n",
  )
  let mut saw_loop = false
  let mut saw_break = false
  let mut saw_continue = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedWhileExpression(control, _, _) => {
        saw_loop = !self_host_u32_equal(control, 4294967295u32)
      }
      SelfHostPlannedExpressionKind::PlannedBreakExpression(control, _) => {
        saw_break = !self_host_u32_equal(control, 4294967295u32)
      }
      SelfHostPlannedExpressionKind::PlannedContinueExpression(control, _) => {
        saw_continue = !self_host_u32_equal(control, 4294967295u32)
      }
      _ => {}
    }
  }
  assert(saw_loop, "loop control")
  assert(saw_break, "break target")
  assert(saw_continue, "continue target")
}

test "lowering retains lambda locals and captures" {
  let planned = self_host_lowering_test_plan(
    b"fn make(seed: I32) -> fn(I32) -> I32 {\n  fn(value: I32) -> I32 {\n    seed + value\n  }\n}\n",
  )
  assert(planned.lambdas.length() == 1u32, "one lambda")
  assert(planned.captures.length() == 1u32, "one capture")
  assert(planned.locals.length() == 2u32, "body and lambda parameters")
  assert(
    self_host_u32_equal(planned.lambdas[0u32].captures.length, 1u32),
    "lambda capture span",
  )
  let mut saw_closure = false
  let mut saw_capture = false
  for expression in planned.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedLambdaClosure(_) => {
        saw_closure = true
      }
      SelfHostPlannedExpressionKind::PlannedCaptureGet(_) => {
        saw_capture = true
      }
      _ => {}
    }
  }
  assert(saw_closure, "closure")
  assert(saw_capture, "capture get")
}

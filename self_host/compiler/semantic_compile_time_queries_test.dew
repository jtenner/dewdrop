  assert(fixture.frozen.import_diagnostics.length() == 0u32, "overload fixture import scope")
  let specialization = self_host_plan_program_specialization(self_host_plan_program_lowering(fixture.frozen), false)
  for module_ in specialization.lowering.modules {
    for diagnostic in module_.inferred.diagnostics {
      assert(false, self_host_inference_diagnostic_name(diagnostic))
    }
  }
  for diagnostic in specialization.lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
}


open dew.std.testing
open dew.std.string
open dew.std.string_builder

test "dead typed query branches are distinct from invalid live values" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn main() -> Token {\n  if unit::<Unit>() {\n    Token::{\n      value: 1u32\n    }\n  } else {\n    Token::{\n      value: 2u32\n    }\n  }\n}\n",
    b"pub builtin unit<T>() -> Bool = \"types.is_unit\"\npub struct Token {\n  value: U32\n}\n",
  )
  assert(fixture.frozen.collected.modules.at(0u32).diagnostic_count() == 0u32, "typed branch source must parse")
  assert(fixture.frozen.collected.modules.at(1u32).diagnostic_count() == 0u32, "typed branch library must parse")
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "typed branch imports must resolve")
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  match self_host_validate_program_inference(lowering) {
    Option::Some(error) => assert(false, error)
    Option::None => {}
  }
  match self_host_validate_program_lowering(lowering) {
    Option::Some(error) => assert(false, error)
    Option::None => {}
  }
  let mut changed = false
  for module_ in lowering.modules {
    while 0u32 {
      index if index < module_.expressions.length() => {
        let expression = module_.expressions[index]
        if !changed && expression.kind is SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _) && expression.nominal != 0u64 {
          module_.expressions[index] = self_host_compile_time_replace_kind(expression, SelfHostPlannedExpressionKind::PlannedPoisonExpression)
          changed = true
        }
        continue index + 1u32
      }
      _ => break ()
    }
  }
  assert(changed, "the selected branch has a typed constructor to mutate")
  match self_host_validate_program_lowering(lowering) {
    Option::Some(error) => assert(error.starts_with("program lowering has a typed poison value"), "the live poison diagnostic remains exact")
    Option::None => assert(false, "live typed poison must still fail validation")
  }
}

test "runtime logical keys do not turn callers into compile-time queries" {
  let lowering = self_host_physical_test_lowering(
    b"struct Map<K, V> {}\nbuiltin raw<K, V>(values: Map<K, V>, key: K) -> V = \"dew_map_get_unchecked\"\nfn inner<K, V>(values: Map<K, V>, key: K) -> V {\n  raw(values, key)\n}\nfn outer<K, V>(values: Map<K, V>, key: K) -> V {\n  inner(values, key)\n}\npub fn run(left: Map<String, I32>, right: Map<Bytes, I32>) -> I32 {\n  outer(left, \"key\") + outer(right, b\"key\")\n}\n",
  )
  let mut inner = 0u64
  let mut outer = 0u64
  for callable in lowering.modules[0u32].functions.callables {
    if callable.name == b"inner" {
      inner = callable.declaration
    }
    if callable.name == b"outer" {
      outer = callable.declaration
    }
  }
  assert(inner != 0u64 && outer != 0u64, "runtime forwarding declarations exist")
  assert(lowering.compile_time.logical_arguments.contains_key(inner), "direct runtime caller keeps logical arguments")
  assert(lowering.compile_time.logical_arguments.contains_key(outer), "transitive runtime caller keeps logical arguments")
  assert(!lowering.compile_time.sensitive.contains_key(inner) && !lowering.compile_time.sensitive.contains_key(outer), "runtime arguments do not authorize query folding")
  let plan = self_host_plan_program_specialization(lowering, false)
  let mut count = 0u32
  for request in plan.requests {
    if request.declaration == inner {
      assert(request.evidence_types.length() == 2u32, "runtime key and value keep exact types")
      count = count + 1u32
    }
  }
  assert(count == 2u32, "String and Bytes remain distinct despite equal physical carriers")
  assert(plan.lowering.compile_time.instances.length() == 0u32, "runtime-only logical keys create no query instances")
}

test "local numeric query guards retain source dependence" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nfn read<T>(value: T) -> I64 {\n  let width = bit_width::<T>()\n  if width == 64u32 {\n    accept(value)\n  } else {\n    0i64\n  }\n}\n",
    b"pub builtin bit_width<T>() -> U32 = \"types.bit_width\"\npub fn accept(value: I64) -> I64 {\n  value\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let imports = fixture.imports
  let names = self_host_resolve_module_names_with_imports(collected, imports.scope)
  let inputs = self_host_basic_imported_inputs(collected, imports.resolved, names, imports.scope, imports.callables, imports.generic_parameter_ids, imports.parameter_types, imports.parameter_receivers, imports.implementations, imports.fields, imports.variants, imports.variant_payload_types, imports.type_declaration_types, imports.type_generic_spans, imports.module_value_types, imports)
  let inferencer = SelfHostBasicBodyInferencer::new(collected, imports.resolved, names, inputs, collected.bodies[0u32], names.bodies[0u32])
  let targets = inferencer.guard_builtin_targets()
  assert(targets.length() == 1u32, "one imported type query target")
  let mut found = false
  for expression in collected.expressions {
    match expression {
      SelfHostHirExpr::IfExpr(condition, _, _, _) => {
        found = true
        assert(inferencer.guard_condition_dependent(condition, targets), "a query in a local initializer marks its condition as dependent")
      }
      _ => {}
    }
  }
  assert(found, "fixture contains a conditional")
  let result = inferencer.run()
  for diagnostic in result.diagnostics {
    match diagnostic {
      SelfHostBodyInferenceDiagnostic::BodyConstraintDiagnostic(_) => assert(false, "the retained call equation must wait for its generic argument")
      _ => {}
    }
  }
}

test "imported overloads reject independent operand errors before selection" {
  let fixture = self_host_imported_semantics_fixture(b"open app.library\nbuiltin is_integer<T>() -> Bool = \"types.is_integer\"\nfn select<T>(value: T) -> T {\n  if is_integer::<T>() {\n    consume(value, true)\n  } else {\n    value\n  }\n}\npub fn main() -> I64 {\n  select(7i32)\n  select(())\n  select(7i64)\n}\n", b"pub builtin consume(value: I32, right: I32) -> I32 = \"i32.add\"\npub builtin consume(value: I64, right: I64) -> I64 = \"i64.add\"\n")
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "overload fixture import scope")
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  let mut found = false
  for module_ in lowering.modules {
    for diagnostic in module_.inferred.diagnostics {
      match diagnostic {
        SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(expression, _, _) => {
          found = true
          match self_host_inference_diagnostic_expression(diagnostic) {
            Option::Some(actual) => assert(actual == expression, "overload diagnostic retains the call expression")
            Option::None => assert(false, "overload diagnostic lost its call expression")
          }
        }
        _ => {}
      }
    }
  }
  assert(found, "an independent bad operand cannot be hidden in an imported overload")
}

test "imported overloads wait for exact selected types" {

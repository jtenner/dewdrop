test "unused projected bindings reject missing selected members" {
  let fragments = self_host_physical_test_fragments(b"builtin member<t>(name: String) -> Type = \"types.field_type\"\nfn check<t>() -> I32 {\n  type Item = member<t>(\"value\")\n  42i32\n}\npub fn run() -> I32 {\n  check::<I64>()\n}\n")
  let errors = fragments.specialization.lowering.compile_time.diagnostics
  assert(errors.length() > 0u32, "selected invalid binding must be checked")
  assert(errors[0u32].starts_with("CT-043"), "selected binding failure keeps its code and source context")
}


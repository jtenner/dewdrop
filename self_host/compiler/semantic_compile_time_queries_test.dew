}

test "imported method bounds reject a concrete missing witness" {
  let fixture = self_host_imported_semantics_fixture(b"open app.library\nbuiltin implements<T, U>() -> Bool = \"types.implements\"\nfn guarded<T>(value: T) -> I32 {\n  if implements::<T, Reader<Unit>>() {\n    value.apply(true)\n  } else {\n    0i32\n  }\n}\npub fn main() -> I32 {\n  guarded(7i64) + guarded(())\n}\n", b"pub trait Mark<X> {\n}\nimpl Mark<Unit> for I32 {\n}\npub trait Reader<X> {\n  fn apply<U: Mark<X>>(self, item: U) -> I32\n}\nimpl Reader<Unit> for I64 {\n  fn apply<U: Mark<Unit>>(self, item: U) -> I32 {\n    42i32\n  }\n}\n")
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "method fixture import scope")
  for module_ in fixture.frozen.collected.modules.values {
    assert(module_.diagnostics.length() == 0u32, "method fixture source syntax")
  }
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  let mut found = false
  for module_ in lowering.modules {
    for diagnostic in module_.inferred.diagnostics {
      if diagnostic is SelfHostBodyInferenceDiagnostic::TraitObligationFailure(_, _, _, _) {
        found = true
      }
    }
  }
  let report = StringBuilder::new()
  report.append("imported method bounds must reject a concrete missing witness")
  for callable in fixture.imports.callables {
    if callable.requires_evidence {
      report.append(" required=")
      report.append(callable.name)
    }
  }
  for module_ in lowering.modules {
    for diagnostic in module_.inferred.diagnostics {
      report.append(" inference=")
      report.append(self_host_inference_diagnostic_name(diagnostic))
    }
    for expression in module_.expressions {
      if expression.kind is SelfHostPlannedExpressionKind::PlannedDeferredExpression {
        report.append(" deferred=")
        report.append_u32(expression.offset)
      }
    }
  }
  for diagnostic in lowering.compile_time.diagnostics {
    report.append(" selected=")
    report.append(diagnostic)
  }
  assert(found, report.finish())
}


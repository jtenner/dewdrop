test "query branch removal preserves constructor field evaluations" {
  let module_ = self_host_test_query_flow_module(
    b"struct Box {\n  item: I64\n}\npub fn main() -> Box {\n  if true {\n    Box::{\n      item: 58i64\n    }\n  } else {\n    Box::{\n      item: 9i64\n    }\n  }\n}\n",
  )
  let _ = self_host_prune_compile_time_body(module_, module_.bodies[0u32])
  let mut live = 0u32
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedI64Const(value) => {
        assert(value == 58u64, "only the selected constructor field remains")
        live = live + 1u32
      }
      _ => {}
    }
  }
  assert(live == 1u32, "selected constructor keeps its field value")
}

test "guarded trait calls select concrete methods in exact bodies" {
  let fragments = self_host_physical_test_fragments(
    b"builtin implements<t, trait_>() -> Bool = \"types.implements\"\ntrait Read {\n  fn read(self) -> I32\n}\nimpl Read for I32 {\n  fn read(self) -> I32 {\n    self\n  }\n}\nfn read_or_zero<t>(value: t) -> I32 {\n  if implements::<t, Read>() {\n    value.read()\n  } else {\n    0i32\n  }\n}\npub fn run() -> I32 {\n  read_or_zero::<I32>(42i32)\n}\n",
  )
  let lowering = fragments.specialization.lowering
  for diagnostic in lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  self_host_physical_test_assert_clean_inference(self_host_plan_program_wasmgc_link(fragments, false))
  let mut count = 0u32
  let _ = while 0u32 {
    index => if index < fragments.specialization.requests.length() {
      match lowering.compile_time.instances.get(index) {
        Option::Some(instance) => for expression in instance.module_.expressions {
          match expression.call_target {
            SelfHostBasicCallTarget::SelectedBasicCallTarget(target, _) => match self_host_program_specialization_callable(instance.module_, target) {
              Option::Some(callable) => match callable.kind {
                SelfHostPlannedCallableKind::PlannedTraitMethodCallable(_) => assert(false, "guarded trait requirement must be replaced")
                SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, _) => {
                  count = count + 1u32
                }
                _ => {}
              }
              Option::None => {}
            }
            _ => {}
          }
        }
        Option::None => {}
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(count > 0u32, "selected instance contains the implementation")
}

fn self_host_test_query_flow_module(source: Bytes) -> SelfHostPlannedModuleLowering {
  let collected = self_host_collect_bytes(24722u64, source)
  assert(collected.diagnostics.length() == 0u32, "flow fixture syntax")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostics.length() == 0u32, "flow fixture signature types")
  let names = self_host_resolve_module_names(collected)
  let values = self_host_infer_module_values(collected, resolved, names)
  let basic = self_host_infer_basic_module_bodies(collected, resolved, names)
  let merged = self_host_merge_module_inference(basic)
  assert(merged.diagnostics.length() == 0u32, "flow fixture inferred types")
  self_host_plan_module_lowering(collected, resolved,
    self_host_plan_module_type_layouts(collected, resolved),
    self_host_plan_module_initialization(collected, values),
    self_host_plan_module_functions(collected, resolved), names, merged,
    self_host_analyze_basic_module_flows(collected, resolved, basic),
  )
}

test "compile-time dead locals retain their logical type" {
  let module_ = self_host_test_query_flow_module(
    b"pub fn main(flag: Bool) -> I32 {\n  if true {\n    let live = 7i32\n    live\n  } else {\n    let dead = 9i64\n    0i32\n  }\n}\n",
  )
  let _ = self_host_prune_compile_time_body(module_, module_.bodies[0u32])
  let mut count = 0u32
  for local in module_.locals {
    if local.shape is SelfHostPlannedValueShape::I64PlannedValueShape {
      assert(local.elided, "dead I64 keeps its type but has no physical slot")
      count = count + 1u32
    } else {
      assert(!local.elided, "live local and declared parameter remain present")
    }
  }
  assert(count == 1u32, "one dead scalar local")
}

test "compile-time flow cuts non-returning call operands and remains stable" {
  let module_ = self_host_test_query_flow_module(
    b"builtin stop() -> Never = \"unreachable\"\nfn later() -> I32 {\n  9i32\n}\nfn consume(left: I32, middle: I32, right: I32) -> I32 {\n  right\n}\npub fn main() -> I32 {\n  consume(1i32, stop(), later())\n}\n",
  )
  let body = module_.bodies[module_.bodies.length() - 1u32]
  let _ = self_host_prune_compile_time_body(module_, body)
  let mut calls = 0u32
  let mut sequences = 0u32
  for id in self_host_compile_time_owned_expressions(module_, body) {
    match module_.expressions[id].kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(_, _, _, _) => {
        calls = calls + 1u32
      }
      SelfHostPlannedExpressionKind::PlannedEvaluationSequence(_) => {
        sequences = sequences + 1u32
      }
      _ => {}
    }
  }
  assert(calls == 0u32, "later and consume calls were removed; stop is a builtin")
  assert(sequences == 1u32, "the ordered prefix is explicit")
  assert(!module_.bodies[module_.bodies.length() - 1u32].flow.falls_through, "body flow was refreshed")
  let size = module_.expression_children.length()
  let _ = self_host_prune_compile_time_body(module_, body)
  assert(module_.expression_children.length() == size, "flow rewrite is idempotent")
}

fn self_host_test_query_bool(name: Bytes, arguments: Array<SelfHostCompileTimeType>, expected: Bool) -> Unit {
  match self_host_evaluate_compile_time_query(name, arguments) {
    Result::Ok(value) => match value {
      Option::Some(constant) => match constant {
        SelfHostCompileTimeConstant::BoolCompileTimeConstant(actual) => assert(actual == expected, "query Bool result")
        _ => assert(false, "query must return Bool")
      }
      Option::None => assert(false, "concrete query cannot remain pending")
    }
    Result::Err(message) => assert(false, message)
  }
}

fn self_host_test_query_u32(name: Bytes, primitive: SelfHostPrimitiveType, expected: U32) -> Unit {
  match self_host_evaluate_compile_time_query(name, [SelfHostCompileTimeType::PrimitiveCompileTimeType(primitive)]) {
    Result::Ok(value) => match value {
      Option::Some(constant) => match constant {
        SelfHostCompileTimeConstant::U32CompileTimeConstant(actual) => assert(actual == expected, "query U32 result")
        _ => assert(false, "query must return U32")
      }
      Option::None => assert(false, "concrete query cannot remain pending")
    }
    Result::Err(message) => assert(false, message)
  }
}

test "compile-time logical predicates do not test erased carriers" {
  let unit = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::UnitType)
  let never = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::NeverType)
  let signed = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::I8Type)
  let unsigned = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::U8Type)
  self_host_test_query_bool(b"types.is_unit", [unit], true)
  self_host_test_query_bool(b"types.is_unit", [never], false)
  self_host_test_query_bool(b"types.is_never", [never], true)
  self_host_test_query_bool(b"types.is_integer", [signed], true)
  self_host_test_query_bool(b"types.is_signed_integer", [unsigned], false)
  self_host_test_query_bool(b"types.type_equal", [signed, unsigned], false)
  self_host_test_query_bool(b"types.can_bitcast", [signed, unsigned], true)
  self_host_test_query_bool(b"types.type_equal", [SelfHostCompileTimeType::NominalCompileTimeType(100u64), SelfHostCompileTimeType::NominalCompileTimeType(101u64)], false)
  self_host_test_query_bool(b"types.can_bitcast", [unit, never], false)
}

test "compile-time pending facts never hide erroneous type arguments" {
  let pending = SelfHostCompileTimeType::ParameterCompileTimeType(33u64)
  match self_host_evaluate_compile_time_query(b"types.is_unit", [pending]) {
    Result::Ok(value) => assert(value is Option::None, "generic query remains pending")
    Result::Err(message) => assert(false, message)
  }
  match self_host_evaluate_compile_time_query(b"types.type_equal", [pending, SelfHostCompileTimeType::ErrorCompileTimeType]) {
    Result::Err(message) => assert(message == "CT-002 erroneous type query argument", "stable error code")
    _ => assert(false, "error must not become pending")
  }
}

test "compile-time structural identity includes nested owner arguments" {
  let owner = SelfHostCompileTimeType::NominalCompileTimeType(70u64)
  let signed = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::I8Type)
  let unsigned = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::U8Type)
  let left = SelfHostCompileTimeType::AppliedCompileTimeType(owner, [SelfHostCompileTimeType::ProductCompileTimeType([signed])])
  let same = SelfHostCompileTimeType::AppliedCompileTimeType(owner, [SelfHostCompileTimeType::ProductCompileTimeType([signed])])
  let other = SelfHostCompileTimeType::AppliedCompileTimeType(owner, [SelfHostCompileTimeType::ProductCompileTimeType([unsigned])])
  self_host_test_query_bool(b"types.type_equal", [left, same], true)
  self_host_test_query_bool(b"types.type_equal", [left, other], false)
}

test "compile-time scalar layouts and lanes agree with native contracts" {
  self_host_test_query_u32(b"types.size_of", SelfHostPrimitiveType::UnitType, 0u32)
  self_host_test_query_u32(b"types.align_of", SelfHostPrimitiveType::UnitType, 1u32)
  self_host_test_query_u32(b"types.size_of", SelfHostPrimitiveType::I8Type, 1u32)
  self_host_test_query_u32(b"types.size_of", SelfHostPrimitiveType::U16Type, 2u32)
  self_host_test_query_u32(b"types.size_of", SelfHostPrimitiveType::BoolType, 4u32)
  self_host_test_query_u32(b"types.bit_width", SelfHostPrimitiveType::I64Type, 64u32)
  self_host_test_query_u32(b"types.lane_count", SelfHostPrimitiveType::I16x4Type, 4u32)
  self_host_test_query_u32(b"types.lane_bit_width", SelfHostPrimitiveType::I16x4Type, 16u32)
  self_host_test_query_u32(b"types.size_of", SelfHostPrimitiveType::V128Type, 16u32)
  match self_host_evaluate_compile_time_query(b"types.size_of", [SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::StringType)]) {
    Result::Err(message) => assert(message == "CT-002 type has no supported byte layout", "GC layout must not be guessed")
    _ => assert(false, "GC object has no exposed byte size")
  }
}

test "compile-time raw tuple layouts include padding and retain erased offsets" {
  let type_ = SelfHostCompileTimeType::ProductCompileTimeType([
    SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::U8Type),
    SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::UnitType),
    SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::I64Type),
    SelfHostCompileTimeType::ProductCompileTimeType([
      SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::U16Type),
      SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::U8Type),
    ]),
  ])
  match self_host_compile_time_raw_layout(type_, 0u32) {
    Result::Ok(layout) => {
      assert(layout.size == 24u32, "tail padding")
      assert(layout.alignment == 8u32, "maximum field alignment")
      assert(layout.offsets[0u32] == 0u32, "first field")
      assert(layout.offsets[1u32] == 1u32, "Unit field keeps its position")
      assert(layout.offsets[2u32] == 8u32, "interior padding")
      assert(layout.offsets[3u32] == 16u32, "nested tuple")
    }
    Result::Err(error) => assert(false, error)
  }
  match self_host_evaluate_compile_time_field_offset([type_], 2u32) {
    Result::Ok(result) => match result {
      Option::Some(value) => match value {
        SelfHostCompileTimeConstant::U32CompileTimeConstant(offset) => assert(offset == 8u32, "constant byte offset")
        _ => assert(false, "offset must be U32")
      }
      Option::None => assert(false, "concrete layout must not be pending")
    }
    Result::Err(error) => assert(false, error)
  }
  assert(self_host_evaluate_compile_time_field_offset([type_], 4u32) is Result::Err(_), "invalid field remains an error")
  assert(self_host_compile_time_raw_align(4294967295u32, 8u32) is Option::None, "layout arithmetic cannot wrap")
}

test "compile-time logical keys retain nested types through generic callers" {
  let lowering = self_host_physical_test_lowering(
    b"builtin query<t>() -> Bool = \"types.is_unit\"\nstruct Box<t> {}\nfn inner<t>() -> Bool {\n query::<t>()\n}\nfn outer<t>() -> Bool {\n inner::<Box<t>>()\n}\npub fn run() -> Bool {\n outer::<I8>() || outer::<U8>()\n}\n",
  )
  let plan = self_host_plan_program_specialization(lowering, false)
  let module_ = lowering.modules[0u32]
  let mut inner = 0u64
  let mut outer = 0u64
  for callable in module_.functions.callables {
    if callable.name == b"inner" {
      inner = callable.declaration
    }
    if callable.name == b"outer" {
      outer = callable.declaration
    }
  }
  assert(inner != 0u64 && outer != 0u64, "query caller identities")
  assert(lowering.compile_time.sensitive.contains_key(inner), "direct query caller needs a logical key")
  assert(lowering.compile_time.sensitive.contains_key(outer), "transitive query caller needs a logical key")
  let mut count = 0u32
  let identities = self_host_empty_compile_time_types()
  for request in plan.requests {
    if request.declaration == inner {
      assert(request.evidence_types.length() == 1u32, "one exact logical generic argument")
      identities.push(self_host_compile_time_evidence_type(request.evidence_types[0u32]))
      count = count + 1u32
    }
  }
  assert(count == 2u32, "same ABI must keep two nested logical instances")
  self_host_test_query_bool(b"types.type_equal", identities, false)
}

test "compile-time branches use private instances and erase dead call records" {
  let lowering = self_host_physical_test_lowering(
    b"builtin query<t>() -> Bool = \"types.is_unit\"\nfn choose<t>() -> I32 {\n if query::<t>() {\n 11i32\n } else {\n 22i32\n }\n}\npub fn run() -> I32 {\n choose::<Unit>() + choose::<I32>()\n}\n",
  )
  let plan = self_host_plan_program_specialization(lowering, false)
  for diagnostic in plan.lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  let mut original = false
  for expression in lowering.modules[0u32].expressions {
    if expression.kind is SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _) {
      original = true
    }
  }
  assert(original, "generic template must remain intact")
  let mut instances = 0u32
  let mut request_index = 0u32
  for request in plan.requests {
    match plan.lowering.compile_time.instances.get(request_index) {
      Option::Some(instance) => {
        let module_ = instance.module_
        instances = instances + 1u32
        for body in module_.bodies {
          if body.declaration == request.declaration {
            let mut values = 0u32
            let _ = while 0u32 {
              offset => if offset < body.expressions.length {
                let source = module_.expressions[body.expressions.start + offset]
                assert(!(source.kind is SelfHostPlannedExpressionKind::PlannedIfExpression(_, _, _)), "constant if must be replaced")
                assert(self_host_program_specialization_call_recipe(source) is Option::None, "folded and dead nodes must not retain call targets")
                if source.kind is SelfHostPlannedExpressionKind::PlannedI32Const(_) {
                  values = values + 1u32
                }
                continue offset + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            assert(values == 1u32, "only the selected branch value survives")
          }
        }
      }
      Option::None => {}
    }
    request_index = request_index + 1u32
  }
  assert(instances == 2u32, "Unit and I32 have separate selected bodies")
}

test "compile-time planning owns its request-indexed state" {
  let lowering = self_host_physical_test_lowering(
    b"builtin query<t>() -> Bool = \"types.is_unit\"\nfn choose<t>() -> Bool {\n query::<t>()\n}\npub fn run() -> Bool {\n choose::<Unit>()\n}\n",
  )
  let first = self_host_plan_program_specialization(lowering, false)
  assert(first.lowering.compile_time.instances.length() == 1u32, "first selected instance")
  assert(lowering.compile_time.instances.length() == 0u32, "source context is immutable")
  let second = self_host_plan_program_specialization(first.lowering, true)
  assert(second.lowering.compile_time.instances.length() == 1u32, "replanning makes its own instances")
  second.lowering.compile_time.instances.clear()
  second.lowering.compile_time.diagnostics.push("test-only context mutation")
  assert(first.lowering.compile_time.instances.length() == 1u32, "later request indices cannot invalidate an earlier plan")
  assert(first.lowering.compile_time.diagnostics.length() == 0u32, "later diagnostics cannot invalidate an earlier plan")
  assert(lowering.compile_time.diagnostics.length() == 0u32, "source diagnostics remain intact")
}

test "compile-time implements substitutes generic prerequisites" {
  let lowering = self_host_physical_test_lowering(
    b"builtin query<a, b>() -> Bool = \"types.implements\"\ntrait Mark {}\nstruct Box<t> {}\nimpl Mark for I32 {}\nimpl<t: Mark> Mark for Box<t> {}\npub fn yes() -> Bool {\n query::<Box<I32>, Mark>()\n}\npub fn no() -> Bool {\n query::<Box<I64>, Mark>()\n}\n",
  )
  for message in lowering.compile_time.diagnostics {
    assert(false, message)
  }
  let values = [false]
  values.clear()
  for expression in lowering.modules[0u32].expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedBoolConst(value) => values.push(value)
      _ => {}
    }
  }
  assert(values.length() == 2u32 && values[0u32] && !values[1u32], "a missing prerequisite must make implements false")
}

test "compile-time query errors remain source diagnostics" {
  for entry in [
    (b"builtin query<a, b>() -> Bool = \"types.implements\"\npub fn main() -> Bool {\n query::<I32, I64>()\n}\n", "CT-014 implements requires a trait as its second argument"),
    (b"builtin query<a, b>() -> Bool = \"types.implements\"\nstruct Node {}\ntrait Loop<t> {}\nimpl<t: Loop<Node>> Loop<t> for Node {}\npub fn main() -> Bool {\n query::<Node, Loop<Node>>()\n}\n", "CT-013 cyclic trait prerequisite"),
    (b"builtin ensure(condition: Bool, message: String) -> Unit = \"types.static_assert\"\npub fn main() -> Unit {\n ensure(false, \"clear failure\")\n}\n", "CT-021 static assertion failed: clear failure"),
  ] {
    let (source, expected) = entry
    let lowering = self_host_physical_test_lowering(source)
    assert(lowering.compile_time.diagnostics.length() == 1u32, "one source query diagnostic")
    assert(lowering.compile_time.diagnostics[0u32].starts_with(expected), "exact query error code and message")
    assert(self_host_validate_program_lowering(lowering) is Option::Some(_), "query errors stop the next phase")
  }
}

test "compile-time implements follows imported generic prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn main() -> Bool {\n query::<Box<I32>, Mark>() && !query::<Box<I64>, Mark>()\n}\n",
    b"pub builtin query<a, b>() -> Bool = \"types.implements\"\npub trait Mark {}\npub struct Box<t> {\n value: t\n}\nimpl Mark for I32 {}\nimpl<t: Mark> Mark for Box<t> {}\n",
  )
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  for diagnostic in lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  let mut found = false
  for expression in lowering.modules[0u32].expressions {
    if expression.kind is SelfHostPlannedExpressionKind::PlannedBoolConst(true) {
      found = true
    }
  }
  assert(found, "imported positive and absent prerequisite queries must fold")
}

fn self_host_test_associated_trait_query(source: Bytes, expected: Bool) -> Unit {
  let fixture = self_host_imported_semantics_fixture(
    source,
    b"pub builtin query<t, trait_>() -> Bool = \"types.implements\"\npub trait Mark {}\npub trait Read {}\npub fn has<t>() -> Bool {\n  query::<t, Read>()\n}\n",
  )
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "associated query imports")
  let plan = self_host_plan_program_specialization(self_host_plan_program_lowering(fixture.frozen), false)
  for diagnostic in plan.lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  let mut count = 0u32
  let _ = while 0u32 {
    index => if index < plan.requests.length() {
      match plan.lowering.compile_time.instances.get(index) {
        Option::Some(instance) => {
          for body in instance.module_.bodies {
            if body.declaration == instance.declaration {
              for expression in self_host_compile_time_owned_expressions(instance.module_, body) {
                match instance.module_.expressions[expression].kind {
                  SelfHostPlannedExpressionKind::PlannedBoolConst(value) => {
                    assert(value == expected, "associated query must preserve evidence scope")
                    count = count + 1u32
                  }
                  _ => {}
                }
              }
            }
          }
        }
        Option::None => {}
      }
      continue index + 1u32
    } else {
      break ()
    }
  }
  assert(count == 1u32, "associated query has one concrete result")
}

test "associated query finds a module-visible nominal implementation" {
  self_host_test_associated_trait_query(
    b"open app.library\nstruct Key {}\nimpl Read for Key {}\npub fn main() -> Bool {\n  has::<Key>()\n}\n", true,
  )
}

test "associated query excludes defining-module foreign implementations" {
  self_host_test_associated_trait_query(
    b"open app.library\nstruct Key {}\nforeign impl Read for Key {}\npub fn main() -> Bool {\n  has::<Key>()\n}\n", false,
  )
}

test "associated prerequisite search excludes foreign implementations" {
  self_host_test_associated_trait_query(
    b"open app.library\nstruct Box<t> {\n  value: t\n}\nforeign impl Mark for I32 {}\nimpl<t: Mark> Read for Box<t> {}\npub fn main() -> Bool {\n  has::<Box<I32>>()\n}\n", false,
  )
}

test "guarded imported trait calls reject a wrong implementation result" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\nstruct Key {}\nimpl Read for Key {\n  fn read(self) -> I64 {\n    42i64\n  }\n}\npub fn main() -> I32 {\n  invoke(Key::{})\n}\n",
    b"pub builtin query<t, trait_>() -> Bool = \"types.implements\"\npub trait Read {\n  fn read(self) -> I32\n}\npub fn invoke<t>(value: t) -> I32 {\n  if query::<t, Read>() {\n    value.read()\n  } else {\n    0i32\n  }\n}\n",
  )
  assert(fixture.frozen.import_diagnostics.length() == 0u32, "guarded signature fixture imports")
  let plan = self_host_plan_program_specialization(self_host_plan_program_lowering(fixture.frozen), false)
  let errors = plan.lowering.compile_time.diagnostics
  for error in errors {
    assert(error.starts_with("CT-015 invalid or ambiguous trait implementation"), error)
  }
  assert(errors.length() > 0u32, "invalid imported implementation must have a diagnostic")
  assert(errors[0u32].starts_with("CT-015 invalid or ambiguous trait implementation"), "invalid imported implementation fails before guarded call replacement")
}

test "Self and generic parameters have separate signature binding identities" {
  let collected = self_host_collect_bytes(28141u64, b"pub fn main() -> I32 {\n  0i32\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  let self_id = resolved.types.length()
  resolved.types.push(SelfHostResolvedType::SelfType(42u64))
  let parameter = resolved.types.length()
  resolved.types.push(SelfHostResolvedType::GenericParameterType(42u64))
  let start = resolved.type_arguments.length()
  resolved.type_arguments.push(self_id)
  resolved.type_arguments.push(parameter)
  let product = resolved.types.length()
  resolved.types.push(SelfHostResolvedType::ProductType(SelfHostHirSpan::{
    start: start
    length: 2u32
  }))
  let bindings = self_host_empty_compile_time_bindings()
  let i32_type = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::I32Type)
  let i64_type = SelfHostCompileTimeType::PrimitiveCompileTimeType(SelfHostPrimitiveType::I64Type)
  bindings.parameters.set(42u64, i32_type)
  bindings.selves.set(42u64, i64_type)
  match self_host_read_compile_time_resolved_arena(resolved, product, bindings, 0u32) {
    Result::Ok(actual) => match self_host_compile_time_types_equal(actual, SelfHostCompileTimeType::ProductCompileTimeType([i64_type, i32_type])) {
      Result::Ok(equal) => assert(equal, "Self and generic parameter IDs cannot overwrite each other")
      Result::Err(error) => assert(false, error)
    }
    Result::Err(error) => assert(false, error)
  }
}

test "compile-time implements does not treat depth 65 as absence" {
  let text = StringBuilder::new()
  text.append("builtin query<a, b>() -> Bool = \"types.implements\"\ntrait Mark {}\nstruct Box<t> {\n value: t\n}\nimpl Mark for I32 {}\nimpl<t: Mark> Mark for Box<t> {}\npub fn main() -> Bool {\n query::<")
  let _ = while 0u32 {
    depth => if depth < 65u32 {
      text.append("Box<")
      continue depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  text.append("I32")
  let _ = while 0u32 {
    depth => if depth < 65u32 {
      text.append(">")
      continue depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  text.append(", Mark>()\n}\n")
  let lowering = self_host_physical_test_lowering(text.finish().as_bytes())
  for diagnostic in lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  let mut found = false
  for expression in lowering.modules[0u32].expressions {
    if expression.kind is SelfHostPlannedExpressionKind::PlannedBoolConst(true) {
      found = true
    }
  }
  assert(found, "a valid long prerequisite chain must be proved true")
}

test "compile-time discarded lambdas create no function or capture storage" {
  let lowering = self_host_physical_test_lowering(
    b"builtin query<t>() -> Bool = \"types.is_unit\"\nbuiltin ensure(condition: Bool, message: String) -> Unit = \"types.static_assert\"\nfn choose<t>() -> I32 {\n let mut captured = 5i32\n if query::<t>() {\n 1i32\n } else {\n let read = fn() -> I32 {\n ensure(false, \"discarded lambda\")\n captured = 7i32\n captured\n }\n read()\n }\n}\npub fn main() -> I32 {\n choose::<Unit>()\n}\n",
  )
  let plan = self_host_plan_program_specialization(lowering, false)
  for diagnostic in lowering.compile_time.diagnostics {
    assert(false, diagnostic)
  }
  let fragments = self_host_plan_program_wasmgc_fragments(plan)
  for module_ in fragments.modules {
    for function_ in module_.functions {
      assert(!(function_.kind is SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(_)), "discarded lambda function must not be planned")
    }
    for type_ in module_.physical_types {
      assert(!(type_.kind is SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(_, _)), "discarded closure type must not be planned")
      assert(!(type_.kind is SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmCaptureCellType(_, _)), "discarded mutable capture must not need a cell")
    }
  }
}

open dew.std.option
open dew.std.map
open dew.std.string_builder
open dew.std.testing

fn self_host_frozen_value_dag_source(depth: U32, record: Bool, public_dag: Bool) -> Bytes {
  let source = StringBuilder::new()
  if record {
    source.append("struct Pair<a, b> {\n  left: a\n  right: b\n}\n")
  }
  source.append("let node0 = 1i32\n")
  let _ = while 1u32 {
    index if index <= depth => {
      source.append("let node")
      source.append_u32(index)
      if record {
        source.append(" = Pair::{\n  left: node")
      } else {
        source.append(" = (node")
      }
      source.append_u32(index - 1u32)
      if record {
        source.append("\n  right: node")
      } else {
        source.append(", node")
      }
      source.append_u32(index - 1u32)
      if record {
        source.append("\n}\n")
      } else {
        source.append(")\n")
      }
      continue index + 1u32
    }
    _ => break ()
  }
  if public_dag {
    source.append("pub let exported = node")
    source.append_u32(depth)
    source.append("\npub let same = node")
    source.append_u32(depth)
    source.append("\n")
  } else {
    source.append("pub let exported = 42i32\n")
  }
  source.finish().as_bytes()
}

test "frozen public value type DAGs share one conversion memo" {
  let depth = 20u32
  for record in [false, true] {
    let collected = self_host_collect_bytes(28430u64, self_host_frozen_value_dag_source(depth, record, true))
    assert(collected.diagnostics.length() == 0u32, "DAG collection diagnostics")
    let resolved = self_host_resolve_module_types(collected)
    assert(resolved.diagnostics.length() == 0u32, "DAG type diagnostics")
    let values = self_host_infer_module_values(collected, resolved, self_host_resolve_module_names(collected))
    assert(values.diagnostics.length() == 0u32, "DAG inference diagnostics")
    let importer = SelfHostInterfaceTypeImporter::new(resolved, SelfHostFrozenInterfaceList::new())
    let memo = self_host_frozen_value_type_memo()
    let first = self_host_frozen_body_type_to_resolved(importer, values, values.let_types[depth + 1u32], memo)
    let count = memo.length()
    let type_count = resolved.types.length()
    let second = self_host_frozen_body_type_to_resolved(importer, values, values.let_types[depth + 2u32], memo)
    assert(first == second, "shared public roots resolve to one type")
    assert(resolved.types.length() == type_count, "second public root adds no types")
    assert(count >= depth + 1u32, "type cache contains each DAG level")
    assert(count <= depth * 2u32 + 4u32, "type cache grows with DAG nodes")
    let total = memo.length()
    assert(total <= depth * 4u32 + 8u32, "public root cache grows with DAG nodes")
    assert(self_host_frozen_body_type_to_resolved(importer, values, values.let_types[depth + 1u32], memo) == first, "cached public root keeps its type")
    assert(memo.length() == total, "repeated public root reuses the type cache")
    assert(resolved.types[first] is ProductType(_) || resolved.types[first] is AppliedType(_, _), "DAG keeps its compound type")
  }
}

test "frozen scalar exports do not convert private value type DAGs" {
  let collected = self_host_collect_bytes(28431u64, self_host_frozen_value_dag_source(16u32, false, false))
  assert(collected.diagnostics.length() == 0u32, "private DAG collection diagnostics")
  let resolved = self_host_resolve_module_types(collected)
  let values = self_host_infer_module_values(collected, resolved, self_host_resolve_module_names(collected))
  assert(values.diagnostics.length() == 0u32, "private DAG inference diagnostics")
  let type_count = resolved.types.length()
  let argument_count = resolved.type_arguments.length()
  let interface_ = self_host_freeze_module_signature_interface_with_values("app.values", collected, resolved, Some(values))
  assert(interface_.declaration_count() == 1u32, "only the scalar is public")
  assert(interface_.declaration_named("exported", FrozenValueDeclaration) is Some(_), "scalar export is present")
  assert(resolved.types.length() == type_count, "private DAG adds no interface types")
  assert(resolved.type_arguments.length() == argument_count, "private DAG adds no interface arguments")
}

fn self_host_test_freeze_interface(
  module_id: U64,
  path: String,
  source: Bytes,
) -> SelfHostFrozenModuleInterface {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  self_host_freeze_module_signature_interface(path, collected, resolved)
}

test "module path spelling cannot publish private declarations" {
  for path in ["app.api", "dew.std.custom", "dew.std.string", "dew.std.string.custom"] {
    let interface_ = self_host_test_freeze_interface(
      28123u64,
      path,
      b"pub struct Visible {}\nstruct Hidden {}\npub fn shown(value: I32) -> I32 {\n  value\n}\nfn hidden(value: I32) -> I32 {\n  value\n}\n",
    )
    assert(interface_.declaration_count() == 2u32, "private declarations escaped by module spelling")
    assert(interface_.declaration_named("Visible", FrozenTypeDeclaration) is Some(_), "public type missing")
    assert(interface_.declaration_named("Hidden", FrozenTypeDeclaration) is None, "private type escaped")
    assert(interface_.declaration_named("shown", FrozenValueDeclaration) is Some(_), "public function missing")
    assert(interface_.declaration_named("hidden", FrozenValueDeclaration) is None, "private function escaped")
  }
}

test "signature interfaces retain only public type declarations" {
  let interface_ = self_host_test_freeze_interface(
    101u64,
    "app.library",
    b"pub struct Item<t> {}\nstruct Hidden {}\npub trait Read {\n  fn read(self) -> I32\n}\npub type Count = I32\n",
  )
  assert(interface_.declaration_count() == 3u32, "public declaration count")
  assert(
    interface_.declaration_named(
      "Item",
      FrozenTypeDeclaration,
    ) is Some(_),
    "Item missing",
  )
  assert(
    interface_.declaration_named(
      "Read",
      FrozenTraitDeclaration,
    ) is Some(_),
    "Read missing",
  )
  assert(
    interface_.declaration_named(
      "Hidden",
      FrozenTypeDeclaration,
    ) is None,
    "private type leaked",
  )
}

test "open imports expose public types and traits" {
  let consumer = self_host_collect_bytes(
    102u64,
    b"open app.library\npub fn keep(value: Item<I32>) -> Item<I32> {\n  value\n}\nimpl Read for Item<I32> {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(
      103u64,
      "app.library",
      b"pub struct Item<t> {}\npub trait Read {}\n",
    ),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  assert(scope.diagnostics.length() == 0u32, "scope diagnostics")
  assert(scope.lookup_type("Item") is Some(_), "opened type")
  assert(scope.lookup_trait("Read") is Some(_), "opened trait")
}

test "qualified imports retain aliases without opening names" {
  let consumer = self_host_collect_bytes(
    104u64,
    b"import app.library as @api\npub fn keep(value: @api.Item) -> @api.Item {\n  value\n}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(
      105u64,
      "app.library",
      b"pub struct Item {}\n",
    ),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  assert(scope.lookup_alias("api") is Some(1u32), "alias")
  assert(scope.lookup_type("Item") is None, "qualified import opened")
  assert(
    scope.lookup_module_type(1u32, "Item") is Some(_),
    "qualified type",
  )
}

test "opened import collisions are deterministic" {
  let consumer = self_host_collect_bytes(
    106u64,
    b"open app.first\nopen app.second\npub fn keep(value: Item) -> Unit {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(107u64, "app.first", b"pub struct Item {}\n"),
  )
  interfaces.push(
    self_host_test_freeze_interface(108u64, "app.second", b"pub struct Item {}\n"),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.first", "app.second"],
    interfaces,
  )
  assert(scope.type_is_ambiguous("Item"), "type ambiguity")
  assert(scope.diagnostics.length() == 1u32, "ambiguity diagnostic")
}

test "opened imported signatures resolve canonical external types and traits" {
  let consumer = self_host_collect_bytes(
    112u64,
    b"open app.library\npub struct Local {}\npub fn keep(value: Item<I32>) -> Item<I32> {\n  value\n}\nimpl Read for Local {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  let library = self_host_test_freeze_interface(
    113u64,
    "app.library",
    b"pub struct Item<t> {}\npub trait Read {}\n",
  )
  interfaces.push(library)
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 0u32, "type diagnostics")
  match resolved.types[resolved.parameter_types[0u32]] {
    AppliedType(base, arguments) => {
      assert(arguments.length == 1u32, "Item argument")
      match resolved.types[base] {
        NominalType(declaration) => assert(
          declaration == match library.declaration_named(
            "Item",
            FrozenTypeDeclaration,
          ) {
            Some(value) => value
            None => 0u64
          },
          "external Item identity",
        )
        _ => assert(false, "expected imported nominal")
      }
    }
    _ => assert(false, "expected imported application")
  }
  match resolved.impl_trait_types[0u32] {
    Some(type_) => match resolved.types[type_] {
      TraitType(_) => {}
      _ => assert(false, "expected imported trait")
    }
    None => assert(false, "missing imported trait")
  }
}

test "qualified imported signatures resolve without opening names" {
  let consumer = self_host_collect_bytes(
    114u64,
    b"import app.library as @api\npub struct Local {}\npub fn keep(value: @api.Item) -> @api.Item {\n  value\n}\nimpl @api.Read for Local {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(
      115u64,
      "app.library",
      b"pub struct Item {}\npub trait Read {}\n",
    ),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 0u32, "qualified diagnostics")
  assert(
    resolved.parameter_types[0u32] == resolved.callable_return_types[0u32],
    "qualified canonical type",
  )
  match resolved.impl_trait_types[0u32] {
    Some(type_) => match resolved.types[type_] {
      TraitType(_) => {}
      _ => assert(false, "qualified trait type")
    }
    None => assert(false, "qualified trait missing")
  }
}

test "imported transparent aliases normalize consumer signatures" {
  let consumer = self_host_collect_bytes(
    116u64,
    b"open app.library\npub fn keep(value: Count) -> Count {\n  value\n}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(
      117u64,
      "app.library",
      b"pub type Count = I32\n",
    ),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 0u32, "alias diagnostics")
  assert(
    resolved.parameter_types[0u32] == resolved.primitive(
      I32Type,
    ),
    "imported alias normalization",
  )
}

test "imported generic aliases substitute consumer arguments" {
  let consumer = self_host_collect_bytes(
    121u64,
    b"open app.library\npub fn keep(value: Wrapped<I32>) -> Wrapped<I32> {\n  value\n}\npub fn callback(value: Callback<String>) -> fn(String) -> String {\n  value\n}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  let library = self_host_test_freeze_interface(
    122u64,
    "app.library",
    b"pub struct Box<t> {}\npub type Wrapped<t> = Box<t>\npub type Callback<t> = fn(t) -> t\n",
  )
  interfaces.push(library)
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 0u32, "generic alias diagnostics")
  match resolved.types[resolved.parameter_types[0u32]] {
    AppliedType(base, arguments) => {
      assert(arguments.length == 1u32, "Box argument")
      match resolved.types[base] {
        NominalType(declaration) => assert(
          declaration == match library.declaration_named(
            "Box",
            FrozenTypeDeclaration,
          ) {
            Some(value) => value
            None => 0u64
          },
          "Box identity",
        )
        _ => assert(false, "expected imported Box")
      }
      assert(
        resolved.type_arguments[arguments.start] == resolved.primitive(
          I32Type,
        ),
        "Wrapped argument",
      )
    }
    _ => assert(false, "expected substituted Wrapped")
  }
  assert(
    resolved.parameter_types[1u32] == resolved.callable_return_types[1u32],
    "function alias",
  )
}

test "imported generic aliases diagnose missing arguments" {
  let consumer = self_host_collect_bytes(
    123u64,
    b"open app.library\npub fn bad(value: Wrapped) -> Unit {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(
      124u64,
      "app.library",
      b"pub struct Box<t> {}\npub type Wrapped<t> = Box<t>\n",
    ),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 1u32, "arity diagnostic count")
  match resolved.diagnostics[0u32] {
    TypeArityMismatch(_, 1u32, 0u32, _, _) => {}
    _ => assert(false, "expected imported alias arity")
  }
}

test "ambiguous opened imported types diagnose at use sites" {
  let consumer = self_host_collect_bytes(
    118u64,
    b"open app.first\nopen app.second\npub fn keep(value: Item) -> Unit {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(119u64, "app.first", b"pub struct Item {}\n"),
  )
  interfaces.push(
    self_host_test_freeze_interface(120u64, "app.second", b"pub struct Item {}\n"),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.first", "app.second"],
    interfaces,
  )
  let resolved = self_host_resolve_module_types_with_imports(consumer, scope)
  assert(resolved.diagnostics.length() == 1u32, "ambiguity count")
  match resolved.diagnostics[0u32] {
    AmbiguousImportedType(_, _, _) => {}
    _ => assert(false, "expected imported ambiguity")
  }
}

test "wildcard imports open matching module prefixes" {
  let consumer = self_host_collect_bytes(
    109u64,
    b"open app.library.*\npub fn keep(left: Left, right: Right) -> Unit {}\n",
  )
  let interfaces = SelfHostFrozenInterfaceList::new()
  interfaces.push(
    self_host_freeze_module_signature_interface(
      "app.consumer",
      consumer,
      self_host_resolve_module_types(consumer),
    ),
  )
  interfaces.push(
    self_host_test_freeze_interface(110u64, "app.library.left", b"pub struct Left {}\n"),
  )
  interfaces.push(
    self_host_test_freeze_interface(111u64, "app.library.right", b"pub struct Right {}\n"),
  )
  let scope = self_host_build_module_import_scope(
    consumer,
    0u32,
    ["app.consumer", "app.library.left", "app.library.right"],
    interfaces,
  )
  assert(scope.lookup_type("Left") is Some(_), "Left missing")
  assert(scope.lookup_type("Right") is Some(_), "Right missing")
}

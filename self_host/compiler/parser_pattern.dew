open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.result
open dew.std.string

fn self_host_empty_patterns() -> Array<SelfHostPattern> {
  new()
}

fn self_host_empty_pattern_fields() -> Array<SelfHostPatternField> {
  new()
}

fn self_host_no_u32() -> Option<U32> {
  None
}

fn self_host_pattern_binding(name: String, offset: U32) -> SelfHostPattern {
  if name.byte_length() > 0u32 && name.as_bytes().byte_at(0u32) == 95u8 {
    WildcardPattern(offset)
  } else {
    BindingPattern(name, offset)
  }
}

fn self_host_token_expression(token: SelfHostToken) -> Option<SelfHostExpr> {
  match token.kind {
    I8(value) =>
      Some(I8Expr(value, token.offset))
    I16(value) =>
      Some(I16Expr(value, token.offset))
    I32(value) =>
      Some(I32Expr(value, token.offset))
    I64(value) =>
      Some(I64Expr(value, token.offset))
    U8(value) =>
      Some(U8Expr(value, token.offset))
    U16(value) =>
      Some(U16Expr(value, token.offset))
    U32(value) =>
      Some(U32Expr(value, token.offset))
    U64(value) =>
      Some(U64Expr(value, token.offset))
    F32(value) =>
      Some(F32Expr(value, token.offset))
    F64(value) =>
      Some(F64Expr(value, token.offset))
    StringLiteral(value) =>
      Some(StringExpr(value, token.offset))
    MultilineString(value) =>
      Some(StringExpr(value, token.offset))
    BytesLiteral(value) =>
      Some(BytesExpr(value, token.offset))
    Identifier(name, _) =>
      Some(NameExpr(name, token.offset))
    AtIdentifier(name, _, _) =>
      Some(ImportAliasExpr(name, token.offset))
    Keyword(keyword_code, _) if keyword_code == 24u32 =>
      Some(BoolExpr(true, token.offset))
    Keyword(keyword_code, _) if keyword_code == 25u32 =>
      Some(BoolExpr(false, token.offset))
    _ => None
  }
}

fn self_host_parser_fail_pattern(parser: SelfHostParser) -> Unit {
  self_host_parser_fail(
    parser,
    ExpectedPattern(
      self_host_parser_peek(parser),
      self_host_parser_offset(parser),
    ),
  )
}

fn self_host_parse_pattern_base(
  parser: SelfHostParser,
  allow_rest: Bool,
) -> Option<SelfHostPattern> {
  let token = match self_host_parser_peek(parser) {
    Some(value) => value
    None => {
      self_host_parser_fail_pattern(parser)
      return None
    }
  }
  match token.kind {
    Symbol(symbol_code, _) if symbol_code == 2u32 => {
      parser.index = parser.index + 1u32
      self_host_parse_struct_pattern(parser, WildcardPattern(token.offset), token.offset)
    }
    Identifier(name, _) => {
      parser.index = parser.index + 1u32
      Some(self_host_pattern_binding(name, token.offset))
    }
    Symbol(symbol_code, _) if symbol_code == 0u32 => {
      parser.index = parser.index + 1u32
      match self_host_parse_tuple_pattern_arguments(parser, token.offset, true) {
        Some(parsed) => {
          let (arguments, has_comma) = parsed
          if arguments.length() == 1u32 && !has_comma {
            match arguments[0u32] {
              RestPattern(offset) => if !allow_rest {
                self_host_parser_fail(parser, RestPatternNotAllowed(offset))
                return None
              }
              _ => {}
            }
            Some(arguments[0u32])
          } else {
            let mut explicit_count = 0u32
            for argument in arguments {
              if !(argument is RestPattern(_)) {
                explicit_count = explicit_count + 1u32
              }
            }
            let has_rest = explicit_count != arguments.length()
            if (!has_rest && explicit_count == 1u32) || explicit_count > 32u32 {
              self_host_parser_fail(parser, InvalidProductArity(explicit_count, token.offset))
              return None
            }
            Some(ProductPattern(arguments, token.offset))
          }
        }
        None => None
      }
    }
    AtIdentifier(name, _, _) => {
      parser.index = parser.index + 1u32
      Some(ImportAliasPattern(name, token.offset))
    }
    Symbol(symbol_code, _) if symbol_code == 28u32 => {
      parser.index = parser.index + 1u32
      if allow_rest {
        Some(RestPattern(token.offset))
      } else {
        self_host_parser_fail(
          parser,
          RestPatternNotAllowed(token.offset),
        )
        None
      }
    }
    Symbol(symbol_code, _) if symbol_code == 7u32 => {
      parser.index = parser.index + 1u32
      match self_host_parser_peek(parser) {
        Some(value_token) => match self_host_token_expression(value_token) {
          Some(value) => {
            parser.index = parser.index + 1u32
            Some(
              LiteralPattern(
                PrefixExpr(
                  Positive,
                  value,
                  token.offset,
                ),
                token.offset,
              ),
            )
          }
          None => {
            self_host_parser_fail_pattern(parser)
            None
          }
        }
        None => {
          self_host_parser_fail_pattern(parser)
          None
        }
      }
    }
    Symbol(symbol_code, _) if symbol_code == 8u32 => {
      parser.index = parser.index + 1u32
      match self_host_parser_peek(parser) {
        Some(value_token) => match self_host_token_expression(value_token) {
          Some(value) => {
            parser.index = parser.index + 1u32
            Some(
              LiteralPattern(
                PrefixExpr(
                  Negative,
                  value,
                  token.offset,
                ),
                token.offset,
              ),
            )
          }
          None => {
            self_host_parser_fail_pattern(parser)
            None
          }
        }
        None => {
          self_host_parser_fail_pattern(parser)
          None
        }
      }
    }
    Error(error) => {
      parser.index = parser.index + 1u32
      self_host_parser_fail(
        parser,
        Lexical(error, token.offset),
      )
      None
    }
    _ => match self_host_token_expression(token) {
      Some(value) => {
        parser.index = parser.index + 1u32
        Some(
          LiteralPattern(value, token.offset),
        )
      }
      None => {
        self_host_parser_fail_pattern(parser)
        None
      }
    }
  }
}

fn self_host_parse_tuple_pattern_arguments(
  parser: SelfHostParser,
  open_offset: U32,
  allow_empty: Bool,
) -> Option<(Array<SelfHostPattern>, Bool)> {
  let arguments = self_host_empty_patterns()
  let mut has_rest = false
  let mut has_comma = false
  self_host_parser_skip_newlines(parser)
  if self_host_parser_consume_symbol(parser, 1u32) {
    if allow_empty {
      return Some((arguments, false))
    }
    self_host_parser_fail(
      parser,
      EmptyTuplePattern(open_offset),
    )
    return None
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parse_pattern_context(parser, true, false) {
      Some(pattern) => {
        match pattern {
          RestPattern(offset) => if has_rest {
            self_host_parser_fail(
              parser,
              DuplicateRestPattern(offset),
            )
            break None
          } else {
            has_rest = true
          }
          _ => {}
        }
        arguments.push(pattern)
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(parser, 1u32) {
          break Some((arguments, has_comma))
        } else if self_host_parser_consume_symbol(
          parser,
          25u32,
        ) {
          has_comma = true
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            break Some((arguments, has_comma))
          } else {
            continue 0u32
          }
        } else {
          self_host_parser_fail(
            parser,
            ExpectedDelimiter(
              "pattern separator or )",
              self_host_parser_peek(parser),
              open_offset,
            ),
          )
          break None
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_struct_pattern(
  parser: SelfHostParser,
  target: SelfHostPattern,
  open_offset: U32,
) -> Option<SelfHostPattern> {
  let fields = self_host_empty_pattern_fields()
  let mut rest_offset = self_host_no_u32()
  if self_host_parser_consume_symbol(parser, 3u32) {
    return Some(
      StructPattern(
        target,
        fields,
        rest_offset,
        open_offset,
      ),
    )
  } else {
  }
  if !self_host_parser_consume_newline(parser) {
    self_host_parser_fail(
      parser,
      ExpectedDelimiter(
        "pattern body newline",
        self_host_parser_peek(parser),
        open_offset,
      ),
    )
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      if self_host_parser_consume_symbol(parser, 3u32) {
        break Some(
          StructPattern(
            target,
            fields,
            rest_offset,
            open_offset,
          ),
        )
      } else {
      }
      let token = match self_host_parser_peek(parser) {
        Some(value) => value
        None => {
          self_host_parser_fail(
            parser,
            UnclosedExpression(
              "struct pattern",
              open_offset,
            ),
          )
          break None
        }
      }
      if self_host_token_kind_is_symbol(token.kind, 28u32) {
        parser.index = parser.index + 1u32
        if rest_offset is Some(_) {
          self_host_parser_fail(
            parser,
            DuplicateRestPattern(token.offset),
          )
          break None
        } else {
          rest_offset = Some(token.offset)
        }
        if !self_host_parser_finish_line(parser) {
          break None
        } else {
        }
        self_host_parser_skip_newlines(parser)
        continue 0u32
      } else {
      }
      let pair = match self_host_parser_identifier(
        parser,
        StructFieldName,
      ) {
        Some(value) => value
        None => break None
      }
      let (name, field_offset) = pair
      let pattern = if self_host_parser_consume_symbol(
        parser,
        13u32,
      ) {
        match self_host_parse_pattern_context(parser, false, false) {
          Some(value) => value
          None => break None
        }
      } else {
        self_host_pattern_binding(name, field_offset)
      }
      fields.push({
        name: name
        pattern: pattern
        offset: field_offset
      })
      if !self_host_parser_finish_line(parser) {
        break None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      continue 0u32
    }
  }
  result
}

fn self_host_parse_pattern_context(
  parser: SelfHostParser,
  allow_rest: Bool,
  stop_left_brace: Bool,
) -> Option<SelfHostPattern> {
  let mut pattern = match self_host_parse_pattern_base(parser, allow_rest) {
    Some(value) => value
    None => {
      return None
    }
  }
  if pattern is RestPattern(_) {
    return Some(pattern)
  } else {
  }
  let result = while 0u32 {
    _ => match self_host_parser_peek(parser) {
      Some(token) => {
        let exact_token = self_host_token_identity(token)
        let symbol_code = self_host_source_symbol_code(
          parser.source,
          exact_token.offset,
        )
        if symbol_code == 27u32 {
          match pattern {
            ImportAliasPattern(_, _) => {
              parser.index = parser.index + 1u32
              self_host_parser_skip_newlines(parser)
              match self_host_parser_identifier(
                parser,
                BindingName,
              ) {
                Some(pair) => {
                  let (property, _property_offset) = pair
                  pattern = QualifiedPattern(
                    pattern,
                    property,
                    exact_token.offset,
                  )
                  continue 0u32
                }
                None => break None
              }
            }
            _ => break Some(pattern)
          }
        } else if symbol_code == 14u32 {
          parser.index = parser.index + 1u32
          self_host_parser_skip_newlines(parser)
          match self_host_parser_identifier(
            parser,
            BindingName,
          ) {
            Some(pair) => {
              let (property, _property_offset) = pair
              pattern = QualifiedPattern(
                pattern,
                property,
                exact_token.offset,
              )
              continue 0u32
            }
            None => break None
          }
        } else if symbol_code == 0u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_tuple_pattern_arguments(
            parser,
            exact_token.offset,
            false,
          ) {
            Some(parsed) => {
              let (arguments, _) = parsed
              pattern = TuplePattern(
                pattern,
                arguments,
                exact_token.offset,
              )
              continue 0u32
            }
            None => break None
          }
        } else if symbol_code == 2u32 && stop_left_brace {
          break Some(pattern)
        } else if symbol_code == 2u32 {
          parser.index = parser.index + 1u32
          match self_host_parse_struct_pattern(
            parser,
            pattern,
            exact_token.offset,
          ) {
            Some(value) => {
              pattern = value
              continue 0u32
            }
            None => break None
          }
        } else {
          break Some(pattern)
        }
      }
      None => break Some(pattern)
    }
  }
  result
}

pub fn self_host_parse_pattern_source(
  source: Bytes,
) -> Result<SelfHostPattern, SelfHostParseError> {
  let parser = self_host_parser_new(source)
  match self_host_parse_pattern_context(parser, false, false) {
    Some(pattern) => {
      self_host_parser_skip_newlines(parser)
      if parser.index != parser.tokens.length() {
        self_host_parser_fail(
          parser,
          ExpectedDelimiter(
            "end of pattern",
            self_host_parser_peek(parser),
            self_host_parser_offset(parser),
          ),
        )
      } else {
      }
      match parser.diagnostic {
        Some(diagnostic) => Err(diagnostic.error)
        None => Ok(pattern)
      }
    }
    None => match parser.diagnostic {
      Some(diagnostic) => Err(diagnostic.error)
      None => Err(
        ExpectedPattern(None, 0u32),
      )
    }
  }
}

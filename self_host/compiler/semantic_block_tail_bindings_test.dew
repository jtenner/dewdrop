test "block tails keep discarded and named let bindings Unit" {
  let collected = self_host_collect_bytes(834u64, b"fn step() -> I32 {\n  42i32\n}\nfn discard() -> Unit {\n  let _ = step()\n}\nfn named() -> Unit {\n  let value = step()\n}\nfn branch(flag: Bool) -> Unit {\n  if flag {\n    let _ = step()\n  } else {\n  }\n}\n")
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  assert(collected.diagnostics.length() == 0u32, "tail let collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "tail let type diagnostics")
  assert(names.diagnostics.length() == 0u32, "tail let name diagnostics")
  assert(inferred.bodies.length() == 4u32, "step and three tail controls")
  let _ = while 0u32 {
    index if index < inferred.bodies.length() => {
      let body = inferred.bodies[index]
      assert(body.diagnostics.length() == 0u32, "tail let inference diagnostics")
      if index != 0u32 {
        match body.type_term(body.root_type) {
          BodyResolvedType(type_) => assert(type_ == resolved.primitive(UnitType), "let tail and nested branch return Unit")
          _ => assert(false, "Unit block has no resolved root type")
        }
      }
      continue index + 1u32
    }
    _ => break ()
  }
}

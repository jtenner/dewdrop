open dew.std.bytes
open dew.std.testing

test "function plans retain callable ABI shapes" {
  let collected = self_host_collect_bytes(
    1003u64,
    b"builtin identity<t>(value: t) -> t = \"identity\"\nfn widen(value: I32) -> I64 {\n  1i64\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let functions = self_host_plan_module_functions(collected, resolved)
  assert(functions.callables.length() == 2u32, "two callables")
  match functions.callables[0u32].kind {
    SelfHostPlannedCallableKind::PlannedBuiltinCallable(name) => assert(
      name == b"identity",
      "builtin name",
    )
    _ => assert(false, "builtin")
  }
  assert(functions.parameters[0u32].shape is SelfHostPlannedValueShape::GenericPlannedValueShape, "generic parameter")
  assert(functions.callables[0u32].result_shape is SelfHostPlannedValueShape::GenericPlannedValueShape, "generic result")
  assert(functions.parameters[1u32].shape is SelfHostPlannedValueShape::I32PlannedValueShape, "I32 parameter")
  assert(functions.callables[1u32].result_shape is SelfHostPlannedValueShape::I64PlannedValueShape, "I64 result")
}

test "function plans preserve source-derived main identity" {
  let collected = self_host_collect_bytes(
    1007u64,
    b"fn helper() -> I32 {\n  1\n}\npub fn main() -> U32 {\n  0u32\n}\nfn mainly() -> I32 {\n  2\n}\n",
  )
  assert(collected.callables.length() == 3u32, "three functions")
  assert(!collected.callables[0u32].is_main, "helper is not main")
  assert(collected.callables[1u32].is_main, "main identity")
  assert(!collected.callables[2u32].is_main, "mainly is not main")
  let resolved = self_host_resolve_module_types(collected)
  let functions = self_host_plan_module_functions(collected, resolved)
  assert(!functions.callables[0u32].is_main, "planned helper")
  assert(functions.callables[1u32].is_main, "planned main")
  assert(!functions.callables[2u32].is_main, "planned mainly")
}

test "function plans substitute impl Self shapes" {
  let collected = self_host_collect_bytes(
    1004u64,
    b"struct Item {}\nimpl Item {\n  fn read(self) -> I32 {\n    1\n  }\n}\nimpl I32 {\n  fn next(self) -> I32 {\n    self + 1\n  }\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let functions = self_host_plan_module_functions(collected, resolved)
  assert(functions.callables.length() == 2u32, "two methods")
  assert(functions.callables[0u32].self_shape is SelfHostPlannedValueShape::RefPlannedValueShape, "ref Self")
  assert(functions.callables[1u32].self_shape is SelfHostPlannedValueShape::I32PlannedValueShape, "I32 Self")
}

test "trait requirement plans retain generic Self" {
  let collected = self_host_collect_bytes(
    1005u64,
    b"trait Convert<t> {\n  fn convert(self, value: t) -> Self\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let functions = self_host_plan_module_functions(collected, resolved)
  assert(functions.callables[0u32].self_shape is SelfHostPlannedValueShape::GenericPlannedValueShape, "generic Self")
  assert(functions.callables[0u32].result_shape is SelfHostPlannedValueShape::GenericPlannedValueShape, "generic result")
}

test "function plans retain foreign and test metadata" {
  let collected = self_host_collect_bytes(
    1006u64,
    b"foreign impl \"host\" as host {\n  fn read(value: I32) -> I64 = \"read\"\n}\ntest \"works\" {\n}\n",
  )
  assert(collected.methods.length() == 1u32, "one foreign method")
  assert(collected.callables.length() == 2u32, "foreign and test callables")
  let resolved = self_host_resolve_module_types(collected)
  let functions = self_host_plan_module_functions(collected, resolved)
  let mut foreign_index = 4294967295u32
  let mut test_index = 4294967295u32
  let mut index = 0u32
  let _ = while index {
    current => if current < functions.callables.length() {
      let callable = functions.callables[current]
      match callable.kind {
        SelfHostPlannedCallableKind::PlannedForeignCallable(library, export_name) => {
          assert(self_host_bytes_equal(library, b"host"), "library")
          assert(self_host_bytes_equal(export_name, b"read"), "export")
          foreign_index = current
        }
        _ => {}
      }
      if callable.is_test_entry {
        test_index = current
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(!self_host_u32_equal(foreign_index, 4294967295u32), "foreign")
  assert(!self_host_u32_equal(test_index, 4294967295u32), "test entry")
  let test_name = functions.callables[test_index].test_name
  assert(self_host_bytes_equal(test_name, b"works"), "test name")
}

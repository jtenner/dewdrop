open dew.std.option

pub enum SelfHostPlannedValueShape {
  ErrorPlannedValueShape
  UnitPlannedValueShape
  I8PlannedValueShape
  I16PlannedValueShape
  I32PlannedValueShape
  I64PlannedValueShape
  U8PlannedValueShape
  U16PlannedValueShape
  U32PlannedValueShape
  U64PlannedValueShape
  F32PlannedValueShape
  F64PlannedValueShape
  Swar32PlannedValueShape
  Swar64PlannedValueShape
  V128PlannedValueShape
  RefPlannedValueShape
  GenericPlannedValueShape
  ProductPlannedValueShape(Array<SelfHostPlannedValueShape>)
  NeverPlannedValueShape
}

enum SelfHostShapeTask {
  VisitShapeType(U32)
  FinishProductShape(U32)
}

// These helpers keep value-shape work arrays on exact source types.
// The backend uses these types as compile-time proof for Array pop carriers.
fn self_host_shape_tasks(root: U32) -> Array<SelfHostShapeTask> {
  [VisitShapeType(root)]
}

fn self_host_shape_results() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_shape_fields() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_primitive_value_shape(
  primitive: SelfHostPrimitiveType,
) -> SelfHostPlannedValueShape {
  match primitive {
    UnitType => UnitPlannedValueShape
    BoolType => I32PlannedValueShape
    I32Type => I32PlannedValueShape
    I8Type => I8PlannedValueShape
    I16Type => I16PlannedValueShape
    I64Type => I64PlannedValueShape
    U8Type => U8PlannedValueShape
    U16Type => U16PlannedValueShape
    U32Type => U32PlannedValueShape
    U64Type => U64PlannedValueShape
    F32Type => F32PlannedValueShape
    F64Type => F64PlannedValueShape
    Swar32Type => Swar32PlannedValueShape
    I8x4Type => Swar32PlannedValueShape
    U8x4Type => Swar32PlannedValueShape
    I16x2Type => Swar32PlannedValueShape
    U16x2Type => Swar32PlannedValueShape
    Swar64Type => Swar64PlannedValueShape
    I8x8Type => Swar64PlannedValueShape
    U8x8Type => Swar64PlannedValueShape
    I16x4Type => Swar64PlannedValueShape
    U16x4Type => Swar64PlannedValueShape
    I32x2Type => Swar64PlannedValueShape
    U32x2Type => Swar64PlannedValueShape
    V128Type => V128PlannedValueShape
    I8x16Type => V128PlannedValueShape
    U8x16Type => V128PlannedValueShape
    I16x8Type => V128PlannedValueShape
    U16x8Type => V128PlannedValueShape
    I32x4Type => V128PlannedValueShape
    U32x4Type => V128PlannedValueShape
    I64x2Type => V128PlannedValueShape
    U64x2Type => V128PlannedValueShape
    F32x4Type => V128PlannedValueShape
    F64x2Type => V128PlannedValueShape
    StringType => RefPlannedValueShape
    BytesType => RefPlannedValueShape
    StringViewType => RefPlannedValueShape
    StringBuilderType => RefPlannedValueShape
    BytesBuilderType => RefPlannedValueShape
    NeverType => NeverPlannedValueShape
    CompileTimeTypeType => ErrorPlannedValueShape
  }
}

fn self_host_planned_resolved_value_shape(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
) -> SelfHostPlannedValueShape {
  let tasks = self_host_shape_tasks(root)
  let results = self_host_shape_results()
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match self_host_array_pop(tasks) {
        Some(value) => value
        None => VisitShapeType(resolved.error_type)
      }
      match task {
        VisitShapeType(type_) => match resolved.types[type_] {
          ErrorType => results.push(ErrorPlannedValueShape)
          PrimitiveType(primitive) => results.push(self_host_primitive_value_shape(primitive))
          GenericParameterType(_) => results.push(GenericPlannedValueShape)
          MemberTypeProjection(_, _, _) => results.push(GenericPlannedValueShape)
          SelfType(_) => results.push(GenericPlannedValueShape)
          NominalType(_) => results.push(RefPlannedValueShape)
          TraitType(_) => results.push(RefPlannedValueShape)
          FunctionType(_, _) => results.push(RefPlannedValueShape)
          AppliedType(base, _) => tasks.push(VisitShapeType(base))
          ProductType(fields) => {
            let start = results.length()
            tasks.push(FinishProductShape(start))
            let mut field = fields.length
            let _ = while field {
              current => if self_host_u32_greater(current, 0u32) {
                let previous = current - 1u32
                tasks.push(VisitShapeType(
                  resolved.type_arguments[self_host_u32_add(fields.start, previous)],
                ))
                continue previous
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        FinishProductShape(start) => {
          let fields = self_host_shape_fields()
          let mut index = start
          let end = results.length()
          let _ = while index {
            current => if current < end {
              fields.push(results[current])
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          results.truncate(start)
          results.push(ProductPlannedValueShape(fields))
        }
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  match self_host_array_pop(results) {
    Some(shape) => shape
    None => ErrorPlannedValueShape
  }
}

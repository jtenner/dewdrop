open dew.std.array
open dew.std.option

fn self_host_linked_append_signature_value(module_: SelfHostPlannedModuleLowering, request: Option<SelfHostProgramSpecializationRequest>, shapes: Array<SelfHostPlannedValueShape>, type_: I32, scope: SelfHostFunctionSignatureScope, expression: U32, position: U64, direct: StarshineValueTypes, entry: StarshineValueTypes) -> SelfHostPlannedValueShape {
  self_host_check_callback_type_graph(module_, request, shapes, type_, scope, expression, position)
  let shape = self_host_lambda_request_shape(module_, request, shapes, type_, self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, type_))
  let error = self_host_specialization_shape_error(shape)
  if error != 0u32 {
    self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
      expression, 301u32, 0u64, u32_into_u64(error), position)
  }
  self_host_linked_append_shape_value_types(direct, shape)
  self_host_linked_append_shape_value_types(entry, shape)
  shape
}

fn self_host_signature_resolved_encoding(module_: SelfHostPlannedModuleLowering, scope: SelfHostFunctionSignatureScope, expression: U32, type_: U32, position: U64) -> I32 {
  if type_ > 2147483646u32 {
    self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
      expression, 207u32, 2147483646u64, u32_into_u64(type_), position)
  }
  if type_ >= module_.resolved_types.types.length() {
    self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
      expression, 105u32, u32_into_u64(module_.resolved_types.types.length()), u32_into_u64(type_), position)
  }
  -self_host_u32_to_i32(type_) - 2i32
}

fn self_host_signature_parameter_span(module_: SelfHostPlannedModuleLowering, scope: SelfHostFunctionSignatureScope, expression: U32, span: SelfHostHirSpan, length: U32) -> Unit {
  if !self_host_array_span_is_valid(span.start, span.length, length) {
    self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
      expression, 101u32, u32_into_u64(length), u32_into_u64(span.length), u32_into_u64(span.start))
  }
}

struct SelfHostFunctionSignatureScope {
  module_index: U32
  specialization: U32
  declaration: U64
  body: U64
  expressions: SelfHostHirSpan
}

fn self_host_function_signature_scope_array() -> Array<SelfHostFunctionSignatureScope> {
  []
}

fn self_host_function_signature_scopes(link: SelfHostPlannedProgramWasmGCLink) -> Array<SelfHostFunctionSignatureScope> {
  let scopes = self_host_function_signature_scope_array()
  for function_ in link.functions {
    let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, function_.module_index, function_.specialization)
    let fragment = link.fragments.modules[function_.module_index].functions[function_.fragment_index]
    let body = match fragment.kind {
      PlannedWasmDefinedFunction(id) => {
        let found = self_host_linked_i32_body(module_, id)
        if found is None {
          self_host_call_read_failure(module_.module_id, fragment.declaration, id,
            4294967295u32, 610u32, 1u64, 0u64, 0u64)
        }
        found
      }
      PlannedWasmDefinedLambdaFunction(id) => {
        let found = self_host_linked_lambda_body(module_, id)
        if found is None {
          // A missing lambda cannot supply a root body. Keep that absence
          // explicit; the fragment still supplies its parent declaration.
          self_host_call_read_failure(module_.module_id, fragment.declaration,
            18446744073709551615u64, 4294967295u32, 610u32, 1u64, 0u64, u32_into_u64(id))
        }
        found
      }
      _ => None
    }
    match body {
      Some(value) => scopes.push({
        module_index: function_.module_index
        specialization: function_.specialization
        declaration: fragment.declaration
        body: value.body
        expressions: value.expressions
      })
      None => {}
    }
  }
  for initializer in link.initializers {
    let module_ = self_host_linked_lowering_module_at(link, initializer.module_index)
    match self_host_linked_i32_body(module_, initializer.body) {
      Some(value) => scopes.push({
        module_index: initializer.module_index
        specialization: 4294967295u32
        declaration: value.declaration
        body: value.body
        expressions: value.expressions
      })
      None => {
        self_host_call_read_failure(module_.module_id, initializer.declaration, initializer.body,
          4294967295u32, 610u32, 1u64, 0u64, 1u64)
      }
    }
  }
  scopes
}

fn self_host_linked_append_function_value_signatures(link: SelfHostPlannedProgramWasmGCLink, rec_types: StarshineRecTypes, signatures: Array<SelfHostLinkedFunctionValueSignature>) -> Option<String> {
  let shapes = link.fragments.specialization.shapes
  for scope in self_host_function_signature_scopes(link) {
    let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, scope.module_index, scope.specialization)
    let request = if scope.specialization < link.fragments.specialization.requests.length() {
      Some(link.fragments.specialization.requests[scope.specialization])
    } else {
      None
    }
    if !self_host_array_span_is_valid(scope.expressions.start, scope.expressions.length, module_.expressions.length()) {
      self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
        4294967295u32, 101u32, u32_into_u64(module_.expressions.length()),
        u32_into_u64(scope.expressions.length), u32_into_u64(scope.expressions.start))
    }
    let _ = while 0u32 {
      relative => if relative < scope.expressions.length {
        let expression_id = scope.expressions.start + relative
        let expression = module_.expressions[expression_id]
        match expression.kind {
          PlannedFunctionValueCall(target, _, _) => if self_host_linked_function_value_signature(signatures, module_.module_id, scope.specialization, expression_id) is None {
            if target < scope.expressions.start || target - scope.expressions.start >= scope.expressions.length {
              self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
                expression_id, 102u32, u32_into_u64(scope.expressions.length),
                u32_into_u64(target), u32_into_u64(scope.expressions.start))
            }
            let direct_parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
            let entry_parameters = StarshineFfi.ffi_ffi_bridge_val_types_new()
            let direct_results = StarshineFfi.ffi_ffi_bridge_val_types_new()
            let entry_results = StarshineFfi.ffi_ffi_bridge_val_types_new()
            StarshineFfi.ffi_ffi_bridge_val_types_push(entry_parameters, self_host_linked_eqref_value_type())
            let result_shape = match self_host_linked_append_body_function_signature(
              module_, request, shapes, module_.expressions[target].type_, scope, expression_id,
              direct_parameters, entry_parameters, direct_results, entry_results,
            ) {
              Some(value) => value
              None => self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
                expression_id, 704u32, 1u64, 0u64, u32_into_u64(target))
            }
            // A diverging evaluation never reaches this call. Otherwise its
            // logical result and the actual target signature must agree.
            if expression.flow.falls_through {
              let planned_shape = self_host_lambda_request_shape(module_, request, shapes, expression.type_, expression.shape)
              let error = self_host_specialization_shape_error(planned_shape)
              if error != 0u32 {
                self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
                  expression_id, 301u32, 0u64, u32_into_u64(error), 8589934592u64)
              }
              let expected = self_host_body_carrier_from_shape(planned_shape)
              let actual = self_host_body_carrier_from_shape(result_shape)
              if !self_host_body_carrier_equal(expected, actual) {
                self_host_call_read_failure(module_.module_id, scope.declaration, scope.body,
                  expression_id, 709u32, self_host_body_carrier_code(expected),
                  self_host_body_carrier_code(actual), u32_into_u64(target))
              }
            }
            let direct_type = self_host_linked_function_value_type_base(link) + signatures.length() * 2u32
            self_host_linked_append_function_value_type(rec_types, direct_parameters, direct_results)
            self_host_linked_append_function_value_type(rec_types, entry_parameters, entry_results)
            signatures.push({
              module_id: module_.module_id
              specialization: scope.specialization
              expression: expression_id
              direct_type_index: direct_type
              entry_type_index: direct_type + 1u32
              result_shape: result_shape
            })
          }
          _ => {}
        }
        continue relative + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  None
}

fn self_host_linked_function_value_signature(
  signatures: Array<SelfHostLinkedFunctionValueSignature>,
  module_id: U64,
  specialization: U32,
  expression: U32,
) -> Option<SelfHostLinkedFunctionValueSignature> {
  for signature in signatures {
    if self_host_u64_equal(signature.module_id, module_id) &&
      self_host_u32_equal(signature.specialization, specialization) &&
      self_host_u32_equal(signature.expression, expression) {
      return Some(signature)
    }
  }
  None
}

fn self_host_linked_append_resolved_function_signature(
  module_: SelfHostPlannedModuleLowering,
  request: Option<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  resolved_type: U32,
  scope: SelfHostFunctionSignatureScope,
  expression: U32,
  direct_parameters: StarshineValueTypes,
  entry_parameters: StarshineValueTypes,
  direct_results: StarshineValueTypes,
  entry_results: StarshineValueTypes,
) -> Option<SelfHostPlannedValueShape> {
  if resolved_type >= module_.resolved_types.types.length() {
    return None
  }
  match module_.resolved_types.types[resolved_type] {
    FunctionType(parameter_types, result_type) => {
      self_host_signature_parameter_span(module_, scope, expression, parameter_types, module_.resolved_types.type_arguments.length())
      while 0u32 {
        current if current < parameter_types.length => {
          let argument_type = module_.resolved_types.type_arguments[parameter_types.start + current]
          let encoded = self_host_signature_resolved_encoding(module_, scope, expression, argument_type, u32_into_u64(current))
          let _ = self_host_linked_append_signature_value(module_, request, shapes, encoded, scope, expression,
            u32_into_u64(current), direct_parameters, entry_parameters)
          continue current + 1u32
        }
        _ => break ()
      }
      let encoded = self_host_signature_resolved_encoding(module_, scope, expression, result_type, 4294967296u64)
      Some(self_host_linked_append_signature_value(module_, request, shapes, encoded, scope, expression,
        4294967296u64, direct_results, entry_results))
    }
    _ => None
  }
}

fn self_host_linked_append_body_function_signature(
  module_: SelfHostPlannedModuleLowering,
  request: Option<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  body_type: I32,
  scope: SelfHostFunctionSignatureScope,
  expression: U32,
  direct_parameters: StarshineValueTypes,
  entry_parameters: StarshineValueTypes,
  direct_results: StarshineValueTypes,
  entry_results: StarshineValueTypes,
) -> Option<SelfHostPlannedValueShape> {
  if body_type < -1i32 {
    return self_host_linked_append_resolved_function_signature(module_, request, shapes,
      self_host_i32_to_u32(-(body_type + 2i32)), scope, expression,
      direct_parameters, entry_parameters, direct_results, entry_results)
  }
  if body_type < 0i32 {
    return None
  }
  let type_index = self_host_i32_to_u32(body_type)
  if type_index >= module_.inferred.types.length() {
    return None
  }
  match module_.inferred.types[type_index] {
    BodyResolvedType(resolved_type) => self_host_linked_append_resolved_function_signature(
      module_, request, shapes, resolved_type, scope, expression,
      direct_parameters, entry_parameters, direct_results, entry_results)
    BodyFunctionType(parameter_types, result_type) => {
      self_host_signature_parameter_span(module_, scope, expression, parameter_types, module_.inferred.type_arguments.length())
      while 0u32 {
        current if current < parameter_types.length => {
          let argument_type = module_.inferred.type_arguments[parameter_types.start + current]
          let _ = self_host_linked_append_signature_value(module_, request, shapes, argument_type, scope, expression,
            u32_into_u64(current), direct_parameters, entry_parameters)
          continue current + 1u32
        }
        _ => break ()
      }
      Some(self_host_linked_append_signature_value(module_, request, shapes, result_type, scope, expression,
        4294967296u64, direct_results, entry_results))
    }
    _ => None
  }
}

fn self_host_linked_append_function_value_type(
  rec_types: StarshineRecTypes,
  parameters: StarshineValueTypes,
  results: StarshineValueTypes,
) -> Unit {
  StarshineFfi.ffi_ffi_bridge_rec_types_push(
    rec_types,
    StarshineFfi.ffi_lib_RecType_new(
      StarshineFfi.ffi_lib_SubType_comp_type(
        StarshineFfi.ffi_lib_CompType_func(parameters, results),
        wasm_ref_null(),
      ),
    ),
  )
}

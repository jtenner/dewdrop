open dew.std.testing
open dew.std.result
open dew.std.string_builder

fn self_host_test_evidence_tree(result: Result<SelfHostTraitEvidenceTree, String>) -> SelfHostTraitEvidenceTree {
  match result {
    Ok(tree) => tree
    Err(error) => {
      assert(false, error)
      unreachable()
    }
  }
}

test "trait evidence selects imported concrete implementation" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run(value: Box) -> I32 {\n  value.mark()\n}\n",
    b"pub trait Mark {\n  fn mark(self) -> I32\n}\npub struct Box {}\nimpl Mark for Box {\n  fn mark(self) -> I32 {\n    1\n  }\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let implementation = index.implementations[0u32]
  let trait_type = match implementation.trait_type {
    Some(value) => value
    None => 0u32
  }
  match self_host_select_trait_evidence(
    collected,
    fixture.imports,
    index,
    trait_type,
    implementation.target_type,
  ) {
    Ok(selected) => match selected {
      Some(witness) => {
        assert(
          self_host_u64_equal(witness.implementation.declaration, implementation.declaration),
          "selected implementation",
        )
        assert(self_host_u32_equal(witness.implementation.specificity, 0u32), "specificity")
      }
      None => assert(false, "expected selected evidence")
    }
    Err(error) => assert(false, error)
  }
}

test "trait evidence validates recursive implementation prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<Leaf>, v: Witness<I32>>(good: Box<Leaf>, bad: Box<I32>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Leaf {}\npub struct Box<t> {}\nimpl Base for Leaf {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let good_bound = fixture.imports.resolved.generic_bound_types[0u32]
  let bad_bound = fixture.imports.resolved.generic_bound_types[1u32]
  let good_target = fixture.imports.resolved.parameter_types[0u32]
  let bad_target = fixture.imports.resolved.parameter_types[1u32]
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      good_bound,
      good_target,
    ) is Ok(Some(_)),
    "satisfied prerequisite",
  )
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      bad_bound,
      bad_target,
    ) is Ok(None),
    "missing prerequisite",
  )
}

test "trait evidence rejects a nonmatching target" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\n",
    b"pub trait Mark {}\npub struct Box {}\nimpl Mark for Box {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let implementation = index.implementations[0u32]
  let trait_type = match implementation.trait_type {
    Some(value) => value
    None => 0u32
  }
  let i32_type = fixture.imports.resolved.primitive(
    I32Type,
  )
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      trait_type,
      i32_type,
    ) is Ok(None),
    "nonmatching target",
  )
}

test "trait evidence tree publishes recursive prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<Leaf>>(good: Box<Leaf>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Leaf {}\npub struct Box<t> {}\nimpl Base for Leaf {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let bound = fixture.imports.resolved.generic_bound_types[0u32]
  let target = fixture.imports.resolved.parameter_types[0u32]
  let tree = self_host_test_evidence_tree(self_host_select_trait_evidence_tree(
    collected,
    fixture.imports,
    index,
    bound,
    target,
  ))
  match tree.root {
    Some(root) => {
      assert(self_host_u32_equal(root, 1u32), "postorder root")
      assert(tree.nodes.length() == 2u32, "root and prerequisite")
      let root_node = tree.nodes[root]
      assert(self_host_u32_equal(root_node.prerequisites.length, 1u32), "one prerequisite")
      assert(
        self_host_u32_equal(
          tree.children[root_node.prerequisites.start],
          0u32,
        ),
        "prerequisite child",
      )
      assert(self_host_u32_equal(root_node.arguments.length, 1u32), "generic argument")
      assert(tree.arguments[root_node.arguments.start] is NominalCompileTimeType(_), "Leaf keeps logical type identity")
    }
    None => assert(false, "expected evidence tree")
  }
}

test "trait evidence depth 65 retains only direct prerequisite children" {
  let source = StringBuilder::new()
  source.append("open app.library\npub fn run<u: Mark>(value: ")
  let _ = while 0u32 {
    depth => if depth < 65u32 {
      source.append("Box<")
      continue depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  source.append("Leaf")
  let _ = while 0u32 {
    depth => if depth < 65u32 {
      source.append(">")
      continue depth + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  source.append(") -> Unit {}\n")
  let fixture = self_host_imported_semantics_fixture(source.finish().as_bytes(),
    b"pub trait Mark {}\npub struct Leaf {}\npub struct Box<t> {}\nimpl Mark for Leaf {}\nimpl<t: Mark> Mark for Box<t> {}\n")
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(collected, fixture.imports)
  assert(index.diagnostic_count() == 0u32, "valid recursive implementation index")
  let bound = fixture.imports.resolved.generic_bound_types[0u32]
  let target = fixture.imports.resolved.parameter_types[0u32]
  assert(self_host_select_trait_evidence(collected, fixture.imports, index, bound, target) is Ok(Some(_)), "depth 65 is not missing evidence")
  let tree = self_host_test_evidence_tree(self_host_select_trait_evidence_tree(collected, fixture.imports, index, bound, target))
  assert(tree.nodes.length() == 66u32, "all prerequisite nodes")
  assert(tree.children.length() == 65u32, "exact direct edges")
  assert(tree.nodes[0u32].prerequisites.length == 0u32, "leaf has no child")
  let _ = while 1u32 {
    node => if node < tree.nodes.length() {
      let span = tree.nodes[node].prerequisites
      assert(span.length == 1u32, "grandchildren do not leak into parent spans")
      assert(tree.children[span.start] == node - 1u32, "exact direct child")
      continue node + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

test "trait evidence reports cycles instead of absence" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Mark<Leaf>>(value: Leaf) -> Unit {}\n",
    b"pub trait Mark<t> {}\npub struct Leaf {}\nimpl<t: Mark<t>> Mark<t> for Leaf {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(collected, fixture.imports)
  assert(index.diagnostic_count() == 0u32, "cycle is an obligation, not malformed index")
  let bound = fixture.imports.resolved.generic_bound_types[0u32]
  let target = fixture.imports.resolved.parameter_types[0u32]
  let search = self_host_trait_evidence_search(collected, fixture.imports, index)
  match self_host_select_trait_evidence_with_search(search, bound, target) {
    Err(error) => assert(error.equals("CT-013 cyclic trait prerequisite"), "exact cycle diagnostic")
    Ok(_) => assert(false, "cycle cannot become ordinary absence")
  }
  assert(search.active.length() == 0u32, "active obligations unwind after failure")
  match self_host_select_trait_evidence_tree(collected, fixture.imports, index, bound, target) {
    Err(error) => assert(error.equals("CT-013 cyclic trait prerequisite"), "tree preserves cycle")
    Ok(_) => assert(false, "cycle cannot become an empty tree")
  }
}

test "trait evidence reports resource limits as a separate result" {
  let fixture = self_host_imported_semantics_fixture(b"open app.library\npub fn run<u: Mark>(value: Leaf) -> Unit {}\n",
    b"pub trait Mark {}\npub struct Leaf {}\nimpl Mark for Leaf {}\n")
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(collected, fixture.imports)
  let bound = fixture.imports.resolved.generic_bound_types[0u32]
  let target = fixture.imports.resolved.parameter_types[0u32]
  let search = self_host_trait_evidence_search(collected, fixture.imports, index)
  assert(self_host_select_trait_evidence_with_search(search, bound, target) is Ok(Some(_)), "valid search")
  search.budget.steps = 65536u32
  match self_host_select_trait_evidence_with_search(search, bound, target) {
    Err(error) => assert(error.equals("CT-012 trait evidence search limit exceeded"), "exact resource limit")
    Ok(_) => assert(false, "limit cannot become ordinary absence")
  }
}

test "trait evidence tree rolls back missing prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<I32>>(bad: Box<I32>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Box<t> {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let tree = self_host_test_evidence_tree(self_host_select_trait_evidence_tree(
    collected,
    fixture.imports,
    index,
    fixture.imports.resolved.generic_bound_types[0u32],
    fixture.imports.resolved.parameter_types[0u32],
  ))
  assert(tree.root is None, "missing root")
  assert(tree.nodes.length() == 0u32, "rolled back nodes")
  assert(tree.children.length() == 0u32, "rolled back children")
  assert(tree.arguments.length() == 0u32, "rolled back arguments")
}

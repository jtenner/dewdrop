open dew.std.testing

test "trait evidence selects imported concrete implementation" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run(value: Box) -> I32 {\n  value.mark()\n}\n",
    b"pub trait Mark {\n  fn mark(self) -> I32\n}\npub struct Box {}\nimpl Mark for Box {\n  fn mark(self) -> I32 {\n    1\n  }\n}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let implementation = index.implementations[0u32]
  let trait_type = match implementation.trait_type {
    Option::Some(value) => value
    Option::None => 0u32
  }
  match self_host_select_trait_evidence(
    collected,
    fixture.imports,
    index,
    trait_type,
    implementation.target_type,
  ) {
    SelfHostTraitEvidenceSelection::SelectedTraitEvidenceSelection(
      declaration,
      specificity,
    ) => {
      assert(
        self_host_u64_equal(declaration, implementation.declaration),
        "selected implementation",
      )
      assert(self_host_u32_equal(specificity, 0u32), "specificity")
    }
    _ => assert(false, "expected selected evidence")
  }
}

test "trait evidence validates recursive implementation prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<Leaf>, v: Witness<I32>>(good: Box<Leaf>, bad: Box<I32>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Leaf {}\npub struct Box<t> {}\nimpl Base for Leaf {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let good_bound = fixture.imports.resolved.generic_bound_types[0u32]
  let bad_bound = fixture.imports.resolved.generic_bound_types[1u32]
  let good_target = fixture.imports.resolved.parameter_types[0u32]
  let bad_target = fixture.imports.resolved.parameter_types[1u32]
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      good_bound,
      good_target,
    ) is SelfHostTraitEvidenceSelection::SelectedTraitEvidenceSelection(_, _),
    "satisfied prerequisite",
  )
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      bad_bound,
      bad_target,
    ) is SelfHostTraitEvidenceSelection::NoTraitEvidenceSelection,
    "missing prerequisite",
  )
}

test "trait evidence rejects a nonmatching target" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\n",
    b"pub trait Mark {}\npub struct Box {}\nimpl Mark for Box {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let implementation = index.implementations[0u32]
  let trait_type = match implementation.trait_type {
    Option::Some(value) => value
    Option::None => 0u32
  }
  let i32_type = fixture.imports.resolved.primitive(
    SelfHostPrimitiveType::I32Type,
  )
  assert(
    self_host_select_trait_evidence(
      collected,
      fixture.imports,
      index,
      trait_type,
      i32_type,
    ) is SelfHostTraitEvidenceSelection::NoTraitEvidenceSelection,
    "nonmatching target",
  )
}

test "trait evidence tree publishes recursive prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<Leaf>>(good: Box<Leaf>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Leaf {}\npub struct Box<t> {}\nimpl Base for Leaf {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let bound = fixture.imports.resolved.generic_bound_types[0u32]
  let target = fixture.imports.resolved.parameter_types[0u32]
  let tree = self_host_select_trait_evidence_tree(
    collected,
    fixture.imports,
    index,
    bound,
    target,
  )
  match tree.root {
    Option::Some(root) => {
      assert(self_host_u32_equal(root, 1u32), "postorder root")
      assert(tree.nodes.length() == 2u32, "root and prerequisite")
      let root_node = tree.nodes[root]
      assert(self_host_u32_equal(root_node.prerequisites.length, 1u32), "one prerequisite")
      assert(
        self_host_u32_equal(
          tree.children[root_node.prerequisites.start],
          0u32,
        ),
        "prerequisite child",
      )
      assert(self_host_u32_equal(root_node.arguments.length, 1u32), "generic argument")
      match tree.arguments[root_node.arguments.start] {
        SelfHostTraitEvidenceArgument::ShapeTraitEvidenceArgument(shape) => assert(
          shape is SelfHostPlannedValueShape::RefPlannedValueShape,
          "Leaf argument shape",
        )
      }
    }
    Option::None => assert(false, "expected evidence tree")
  }
}

test "trait evidence tree rolls back missing prerequisites" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run<u: Witness<I32>>(bad: Box<I32>) -> Unit {\n}\n",
    b"pub trait Base {}\npub trait Witness<t> {}\npub struct Box<t> {}\nimpl<t: Base> Witness<t> for Box<t> {}\n",
  )
  let collected = fixture.frozen.collected.modules.at(0u32)
  let index = self_host_index_module_implementations_with_imports(
    collected,
    fixture.imports,
  )
  let tree = self_host_select_trait_evidence_tree(
    collected,
    fixture.imports,
    index,
    fixture.imports.resolved.generic_bound_types[0u32],
    fixture.imports.resolved.parameter_types[0u32],
  )
  assert(tree.root is Option::None, "missing root")
  assert(tree.nodes.length() == 0u32, "rolled back nodes")
  assert(tree.children.length() == 0u32, "rolled back children")
  assert(tree.arguments.length() == 0u32, "rolled back arguments")
}

open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

fn self_host_compile_time_match(pattern: SelfHostCompileTimeType, actual: SelfHostCompileTimeType, bindings: SelfHostCompileTimeBindings) -> Result<Bool, String> {
  let work = [SelfHostCompileTimeTypePair::{
    left: pattern
    right: actual
  }]
  let mut steps = 0u32
  while work.length() {
    length => if length > 0u32 {
      if steps >= 65536u32 {
        return Err("CT-012 trait pattern traversal limit exceeded")
      }
      steps = steps + 1u32
      let pair = work[length - 1u32]
      work.truncate(length - 1u32)
      let left = self_host_empty_compile_time_types()
      let right = self_host_empty_compile_time_types()
      match pair.left {
        ParameterCompileTimeType(parameter) => match bindings.parameters.get(parameter) {
          Some(previous) => match self_host_compile_time_types_equal(previous, pair.right) {
            Ok(equal) => if !equal {
              return Ok(false)
            }
            Err(error) => return Err(error)
          }
          None => bindings.parameters.set(parameter, pair.right)
        }
        ProductCompileTimeType(fields) => match pair.right {
          ProductCompileTimeType(others) => {
            for value in fields {
              left.push(value)
            }
            for value in others {
              right.push(value)
            }
          }
          _ => return Ok(false)
        }
        AppliedCompileTimeType(base, fields) => match pair.right {
          AppliedCompileTimeType(other, others) => {
            left.push(base)
            right.push(other)
            for value in fields {
              left.push(value)
            }
            for value in others {
              right.push(value)
            }
          }
          _ => return Ok(false)
        }
        FunctionCompileTimeType(fields, result) => match pair.right {
          FunctionCompileTimeType(others, other) => {
            left.push(result)
            right.push(other)
            for value in fields {
              left.push(value)
            }
            for value in others {
              right.push(value)
            }
          }
          _ => return Ok(false)
        }
        _ => match self_host_compile_time_types_equal(pair.left, pair.right) {
          Ok(equal) => if !equal {
            return Ok(false)
          }
          Err(error) => return Err(error)
        }
      }
      if left.length() != right.length() {
        return Ok(false)
      }
      let _ = while 0u32 {
        index => if index < left.length() {
          work.push({
            left: left[index]
            right: right[index]
          })
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue work.length()
    } else {
      break Ok(true)
    }
  }
}

struct SelfHostCompileTimeEvidenceSearch {
  lowering: Option<SelfHostPlannedProgramLowering>
  collected: SelfHostCollectedModule
  resolved: SelfHostResolvedModuleTypes
  imports: SelfHostResolvedModuleImports
  index: SelfHostModuleImplIndex
  active: Array<SelfHostCompileTimeTypePair>
  budget: SelfHostCompileTimeEvidenceBudget
  associated_scopes: Map<U64, SelfHostCompileTimeEvidenceScope>
  associated_only: Bool
  include_test_impls: Bool
}

struct SelfHostCompileTimeEvidenceBudget {
  mut steps: U32
}

struct SelfHostCompileTimeEvidenceScope {
  collected: SelfHostCollectedModule
  resolved: SelfHostResolvedModuleTypes
  imports: SelfHostResolvedModuleImports
  index: SelfHostModuleImplIndex
}

struct SelfHostCompileTimePrerequisite {
  parameter: U64
  type_: U32
}

struct SelfHostCompileTimeTraitWitness {
  implementation: SelfHostIndexedImpl
  index: SelfHostModuleImplIndex
  bindings: SelfHostCompileTimeBindings
  prerequisites: Array<SelfHostCompileTimeTraitWitness>
}

fn self_host_empty_compile_time_witnesses() -> Array<SelfHostCompileTimeTraitWitness> {
  []
}

fn self_host_empty_compile_time_prerequisites() -> Array<SelfHostCompileTimePrerequisite> {
  []
}

impl SelfHostCompileTimeEvidenceSearch {
  fn read(self, type_: U32, bindings: SelfHostCompileTimeBindings) -> Result<SelfHostCompileTimeType, String> {
    self_host_read_compile_time_resolved_arena(self.resolved, type_, bindings, 0u32)
  }

  fn prerequisites(self, declaration: U64, bindings: SelfHostCompileTimeBindings) -> Result<Option<Array<SelfHostCompileTimeTraitWitness>>, String> {
    let obligations = self_host_empty_compile_time_prerequisites()
    if self_host_semantic_id_module(declaration) == self.collected.module_id {
      let generics = self.collected.generic_parameters_of(declaration)
      let _ = while 0u32 {
        offset => if offset < generics.length {
          let generic = self.collected.generic_parameters[generics.start + offset]
          let span = generic.bounds
          if !self_host_array_span_is_valid(span.start, span.length, self.imports.resolved.generic_bound_types.length()) {
            return Err("CT-010 invalid local trait prerequisite span")
          }
          let _ = while 0u32 {
            bound => if bound < span.length {
              obligations.push({
                parameter: generic.id
                type_: self.imports.resolved.generic_bound_types[span.start + bound]
              })
              continue bound + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue offset + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    } else {
      let imported = match self.imports.implementation(declaration) {
        Some(value) => value
        None => return Err("CT-010 missing imported implementation identity")
      }
      let generics = imported.generic_bounds
      if generics.length != imported.generic_parameters.length ||
        !self_host_array_span_is_valid(generics.start, generics.length, self.imports.generic_parameter_ids.length()) ||
        !self_host_array_span_is_valid(generics.start, generics.length, self.imports.generic_parameter_bounds.length()) {
        return Err("CT-010 invalid imported generic parameter spans")
      }
      let _ = while 0u32 {
        offset => if offset < generics.length {
          let parameter = self.imports.generic_parameter_ids[generics.start + offset]
          let span = self.imports.generic_parameter_bounds[generics.start + offset]
          if !self_host_array_span_is_valid(span.start, span.length, self.imports.generic_bound_types.length()) {
            return Err("CT-010 invalid imported trait prerequisite span")
          }
          let _ = while 0u32 {
            bound => if bound < span.length {
              obligations.push({
                parameter: parameter
                type_: self.imports.generic_bound_types[span.start + bound]
              })
              continue bound + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          continue offset + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    let witnesses = self_host_empty_compile_time_witnesses()
    for obligation in obligations {
      let target = match bindings.parameters.get(obligation.parameter) {
        Some(value) => value
        None => return Err("CT-011 unresolved implementation type argument")
      }
      let trait_ = match self.read(obligation.type_, bindings) {
        Ok(value) => value
        Err(error) => return Err(error)
      }
      match self.witness(target, trait_) {
        Ok(value) => match value {
          Some(witness) => witnesses.push(witness)
          None => return Ok(None)
        }
        Err(error) => return Err(error)
      }
    }
    Ok(Some(witnesses))
  }

  fn search(self, target: SelfHostCompileTimeType, trait_: SelfHostCompileTimeType) -> Result<Bool, String> {
    match self.witness(target, trait_) {
      Ok(value) => Ok(value is Some(_))
      Err(error) => Err(error)
    }
  }

  fn witness(self, target: SelfHostCompileTimeType, trait_: SelfHostCompileTimeType) -> Result<Option<SelfHostCompileTimeTraitWitness>, String> {
    if self.budget.steps >= 65536u32 || self.active.length() >= 256u32 {
      return Err("CT-012 trait evidence search limit exceeded")
    }
    self.budget.steps = self.budget.steps + 1u32
    for active in self.active {
      match self_host_compile_time_types_equal(active.left, target) {
        Ok(equal) => if equal {
          match self_host_compile_time_types_equal(active.right, trait_) {
            Ok(same) => if same {
              return Err("CT-013 cyclic trait prerequisite")
            }
            Err(error) => return Err(error)
          }
        }
        Err(error) => return Err(error)
      }
    }
    let base = match trait_ {
      AppliedCompileTimeType(base, _) => base
      value => value
    }
    let declaration = match base {
      TraitCompileTimeType(declaration) => declaration
      _ => return Err("CT-014 implements requires a trait as its second argument")
    }
    match self_host_compile_time_types_concrete([target, trait_]) {
      Ok(concrete) => if !concrete {
        return Err("CT-011 unresolved trait prerequisite")
      }
      Err(error) => return Err(error)
    }
    let depth = self.active.length()
    self.active.push({
      left: target
      right: trait_
    })
    let result = self.search_candidates(target, trait_, declaration)
    self_host_assert_compiler_invariant(self.active.length() == depth + 1u32, "INV-001 trait search active obligations must be LIFO")
    self.active.truncate(depth)
    result
  }

  fn search_candidates(self, target: SelfHostCompileTimeType, trait_: SelfHostCompileTimeType, declaration: U64) -> Result<Option<SelfHostCompileTimeTraitWitness>, String> {
    let mut selected = match self.search_scope_candidates(target, trait_, declaration) {
      Ok(value) => value
      Err(error) => return Err(error)
    }
    let lowering = match self.lowering {
      Some(lowering) => lowering
      None => return Ok(selected)
    }
    let owners = [declaration]
    let head = while target {
      AppliedCompileTimeType(base, _) => continue base
      value => break value
    }
    match head {
      NominalCompileTimeType(owner) => {
        if self_host_semantic_id_module(owner) != self_host_semantic_id_module(declaration) {
          owners.push(owner)
        }
      }
      _ => {}
    }
    for owner in owners {
      let module_id = self_host_semantic_id_module(owner)
      if module_id != self.collected.module_id {
        let scope = match self.associated_scopes.get(module_id) {
          Some(scope) => scope
          None => {
            let owner_index = match lowering.index.declaration_owner(owner) {
              Some(index) => index
              None => return Err("CT-010 associated trait owner is missing")
            }
            let collected = lowering.collected.modules.at(owner_index)
            let frozen = lowering.compile_time.frozen
            let imports = self_host_resolve_module_imports(frozen.interfaces.at(owner_index).resolved_types, frozen.import_scopes.at(owner_index))
            let scope = {
              collected: collected
              resolved: imports.resolved
              imports: imports
              index: self_host_index_module_implementations_with_imports(collected, imports)
            }
            self.associated_scopes.set(module_id, scope)
            scope
          }
        }
        let search = SelfHostCompileTimeEvidenceSearch::{
          lowering: self.lowering
          collected: scope.collected
          resolved: scope.resolved
          imports: scope.imports
          index: scope.index
          active: self.active
          budget: self.budget
          associated_scopes: self.associated_scopes
          associated_only: true
          include_test_impls: false
        }
        match search.search_scope_candidates(target, trait_, declaration) {
          Ok(value) => match value {
            Some(witness) => match selected {
              Some(previous) => {
                if previous.implementation.declaration != witness.implementation.declaration {
                  return Err("CT-015 multiple compatible trait implementations")
                }
              }
              None => {
                selected = Some(witness)
              }
            }
            None => {}
          }
          Err(error) => return Err(error)
        }
      }
    }
    Ok(selected)
  }

  fn search_scope_candidates(self, target: SelfHostCompileTimeType, trait_: SelfHostCompileTimeType, declaration: U64) -> Result<Option<SelfHostCompileTimeTraitWitness>, String> {
    let mut selected = None
    for implementation in self.index.implementations {
      let mut visible = !self.associated_only
      if self.associated_only {
        for candidate in self.collected.impls {
          let source = self_host_collected_impl_identity(candidate)
          if source.declaration == implementation.declaration && !source.foreign_ &&
            !self.collected.declaration_is_test_only(source.declaration) {
            visible = true
          }
        }
      }
      let relevant = match implementation.kind {
        TraitIndexedImpl(owner) => owner == declaration
        _ => false
      }
      if visible && relevant && (self.include_test_impls || !self.collected.declaration_is_test_only(implementation.declaration)) {
        let bindings = self_host_empty_compile_time_bindings()
        let candidate = match self.read(implementation.target_type, bindings) {
          Ok(value) => value
          Err(error) => return Err(error)
        }
        let compatible = match self_host_compile_time_match(candidate, target, bindings) {
          Ok(value) => value
          Err(error) => return Err(error)
        }
        if compatible {
          let trait_type = match implementation.trait_type {
            Some(type_) => type_
            None => return Err("CT-010 trait implementation has no trait type")
          }
          let candidate_trait = match self.read(trait_type, bindings) {
            Ok(value) => value
            Err(error) => return Err(error)
          }
          let compatible_trait = match self_host_compile_time_match(candidate_trait, trait_, bindings) {
            Ok(value) => value
            Err(error) => return Err(error)
          }
          if compatible_trait {
            if !implementation.valid || !implementation.coherent {
              return Err("CT-015 invalid or ambiguous trait implementation")
            }
            match self.prerequisites(implementation.declaration, bindings) {
              Ok(value) => match value {
                Some(prerequisites) => {
                  if selected is Some(_) {
                    return Err("CT-015 multiple compatible trait implementations")
                  }
                  selected = Some({
                    implementation: implementation
                    index: self.index
                    bindings: bindings
                    prerequisites: prerequisites
                  })
                }
                None => {}
              }
              Err(error) => return Err(error)
            }
          }
        }
      }
    }
    Ok(selected)
  }
}

fn self_host_evaluate_compile_time_implements(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, types: Array<SelfHostCompileTimeType>, declaration: U64) -> Result<Option<SelfHostCompileTimeConstant>, String> {
  if types.length() != 2u32 {
    return Err("CT-001 implements requires two type arguments")
  }
  match self_host_compile_time_types_concrete(types) {
    Ok(concrete) => if !concrete {
      return Ok(None)
    }
    Err(error) => return Err(error)
  }
  let owner = match lowering.index.declaration_owner(declaration) {
    Some(owner) => owner
    None => return Err("CT-010 trait query has no caller module")
  }
  let context = lowering.compile_time
  let collected = lowering.collected.modules.at(owner)
  let imports = self_host_resolve_module_imports(context.frozen.interfaces.at(owner).resolved_types, context.frozen.import_scopes.at(owner))
  let search = SelfHostCompileTimeEvidenceSearch::{
    lowering: Some(lowering)
    collected: collected
    resolved: module_.resolved_types
    imports: imports
    index: self_host_index_module_implementations_with_imports(collected, imports)
    active: []
    budget: {
      steps: 0u32
    }
    associated_scopes: empty()
    associated_only: false
    include_test_impls: collected.declaration_is_test_only(declaration)
  }
  match search.search(types[0u32], types[1u32]) {
    Ok(value) => Ok(Some(BoolCompileTimeConstant(value)))
    Err(error) => Err(error)
  }
}

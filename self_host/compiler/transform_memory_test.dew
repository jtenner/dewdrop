  ct_memory_boundary_case("i64.store", 8u32, Some(CtValue::Number(1234605616436508552u64, "I64")))
  ct_memory_boundary_case("f32.store", 4u32, Some(CtValue::Floating(287454020u64, "F32")))
  ct_memory_boundary_case("f64.store", 8u32, Some(CtValue::Floating(1234605616436508552u64, "F64")))
  ct_memory_boundary_case("v128.load", 16u32, None)
  ct_memory_boundary_case("v128.store", 16u32, Some(CtValue::Vector(578437695752307201u64, 1157159078456920585u64)))
  ct_memory_boundary_case("v128.load8_splat", 1u32, None)
  ct_memory_boundary_case("v128.load8_lane 0", 1u32, Some(CtValue::Vector(578437695752307201u64, 1157159078456920585u64)))
  ct_memory_boundary_case("v128.store8_lane 0", 1u32, Some(CtValue::Vector(578437695752307201u64, 1157159078456920585u64)))

open dew.std.bytes
open dew.std.map
open dew.std.option
open dew.std.string

struct SelfHostSpecializationShapeTask {
  shape: SelfHostPlannedValueShape
  finish: Bool
  start: U32
}

struct SelfHostSpecializationShapePair {
  left: SelfHostPlannedValueShape
  right: SelfHostPlannedValueShape
}

// These helpers keep specialization work arrays on exact source types.
// The backend uses these types as compile-time proof for Array pop carriers.
fn self_host_specialization_tasks(
  root: SelfHostPlannedValueShape,
) -> Array<SelfHostSpecializationShapeTask> {
  [SelfHostSpecializationShapeTask::{
    shape: root
    finish: false
    start: 0u32
  }]
}

fn self_host_specialization_results() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_specialization_fields() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_specialization_pairs(
  left: SelfHostPlannedValueShape,
  right: SelfHostPlannedValueShape,
) -> Array<SelfHostSpecializationShapePair> {
  [SelfHostSpecializationShapePair::{
    left: left
    right: right
  }]
}

pub struct SelfHostProgramSpecializationRequest {
  declaration: U64
  shapes: SelfHostHirSpan
  evidence_types: Array<SelfHostSpecializationEvidenceType>
}

pub struct SelfHostProgramSpecializedCall {
  caller_body: U64
  caller_specialization: U32
  expression: U32
  target: U64
  target_specialization: U32
}

fn self_host_program_specialized_call_identity(
  call: SelfHostProgramSpecializedCall,
) -> SelfHostProgramSpecializedCall {
  SelfHostProgramSpecializedCall::{
    caller_body: call.caller_body
    caller_specialization: call.caller_specialization
    expression: call.expression
    target: call.target
    target_specialization: call.target_specialization
  }
}

pub struct SelfHostProgramSpecializationPlan {
  lowering: SelfHostPlannedProgramLowering
  reachable_declarations: Array<U64>
  requests: Array<SelfHostProgramSpecializationRequest>
  shapes: Array<SelfHostPlannedValueShape>
  calls: Array<SelfHostProgramSpecializedCall>
}

struct SelfHostProgramCallRecipe {
  target: U64
}

fn self_host_specialization_canonical_scalar(
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  match shape {
    SelfHostPlannedValueShape::I8PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I16PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U8PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U16PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::Swar32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::U64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::Swar64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::RefPlannedValueShape => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedValueShape::GenericPlannedValueShape => SelfHostPlannedValueShape::GenericPlannedValueShape
    SelfHostPlannedValueShape::ErrorPlannedValueShape => SelfHostPlannedValueShape::ErrorPlannedValueShape
    _ => shape
  }
}

fn self_host_specialization_canonical_shape(
  root: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  let tasks = self_host_specialization_tasks(root)
  let results = self_host_specialization_results()
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match self_host_array_pop(tasks) {
        Option::Some(value) => value
        Option::None => {
          self_host_assert_compiler_invariant(false, "specialization normalization lost a work item")
          unreachable()
        }
      }
      if task.finish {
        let fields = self_host_specialization_fields()
        let end = results.length()
        let expected = match task.shape {
          SelfHostPlannedValueShape::ProductPlannedValueShape(source_fields) => source_fields.length()
          _ => {
            self_host_assert_compiler_invariant(false, "specialization finish task must describe a product")
            unreachable()
          }
        }
        self_host_assert_array_span(task.start, expected, end, "specialization product result span is invalid")
        self_host_assert_compiler_invariant(end - task.start == expected, "specialization product result count is invalid")
        let mut index = task.start
        let _ = while index {
          current => if current < end {
            fields.push(results[current])
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        results.truncate(task.start)
        results.push(SelfHostPlannedValueShape::ProductPlannedValueShape(fields))
      } else {
        match task.shape {
          SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => {
            let start = results.length()
            tasks.push(SelfHostSpecializationShapeTask::{
              shape: task.shape
              finish: true
              start: start
            })
            let mut field = fields.length()
            let _ = while field {
              current => if self_host_u32_greater(current, 0u32) {
                let previous = current - 1u32
                tasks.push(SelfHostSpecializationShapeTask::{
                  shape: fields[previous]
                  finish: false
                  start: 0u32
                })
                continue previous
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => results.push(self_host_specialization_canonical_scalar(task.shape))
        }
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_assert_compiler_invariant(results.length() == 1u32, "specialization normalization must produce one result")
  match self_host_array_pop(results) {
    Option::Some(value) => value
    Option::None => {
      self_host_assert_compiler_invariant(false, "specialization normalization lost its result")
      unreachable()
    }
  }
}

fn self_host_specialization_shapes_equal(
  left: SelfHostPlannedValueShape,
  right: SelfHostPlannedValueShape,
) -> Bool {
  let work = self_host_specialization_pairs(left, right)
  let _ = while work.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let pair = match self_host_array_pop(work) {
        Option::Some(value) => value
        Option::None => {
          self_host_assert_compiler_invariant(false, "specialization equality lost a work item")
          unreachable()
        }
      }
      let canonical_left = self_host_specialization_canonical_scalar(pair.left)
      let canonical_right = self_host_specialization_canonical_scalar(pair.right)
      match canonical_left {
        SelfHostPlannedValueShape::ProductPlannedValueShape(left_fields) => match canonical_right {
          SelfHostPlannedValueShape::ProductPlannedValueShape(right_fields) => {
            if !self_host_u32_equal(left_fields.length(), right_fields.length()) {
              return false
            }
            let mut field = 0u32
            let _ = while field {
              current => if current < left_fields.length() {
                work.push(SelfHostSpecializationShapePair::{
                  left: left_fields[current]
                  right: right_fields[current]
                })
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {
            return false
          }
        }
        SelfHostPlannedValueShape::UnitPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::UnitPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::NeverPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::NeverPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::I32PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::I32PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::I64PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::I64PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::F32PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::F32PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::F64PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::F64PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::V128PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::V128PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::RefPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::RefPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::GenericPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::GenericPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::ErrorPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::ErrorPlannedValueShape) {
          return false
        }
        _ => {
          return false
        }
      }
      continue work.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_program_specialization_callable(
  module_: SelfHostPlannedModuleLowering,
  declaration: U64,
) -> Option<SelfHostPlannedCallable> {
  if !self_host_u64_equal(
    self_host_semantic_id_module(declaration),
    module_.module_id,
  ) {
    return Option::None
  }
  let functions = self_host_planned_module_functions_identity(module_.functions)
  let local = self_host_semantic_id_local(declaration)
  if local >= functions.callable_by_declaration.length() {
    return Option::None
  }
  let index = functions.callable_by_declaration[local]
  if self_host_u32_equal(index, 4294967295u32) {
    return Option::None
  }
  if self_host_u32_greater(functions.callables.length(), index) {
    Option::Some(self_host_planned_callable_identity(functions.callables[index]))
  } else {
    Option::None
  }
}

struct SelfHostCallableGenericParameters {
  module_id: U64
  owner: SelfHostHirSpan
  method: SelfHostHirSpan
  length: U32
}

impl SelfHostCallableGenericParameters {
  fn slot(self, parameter: U64) -> Option<U32> {
    if !self_host_u64_equal(self_host_semantic_id_module(parameter), self.module_id) {
      return Option::None
    }
    let local = self_host_semantic_id_local(parameter)
    if local >= self.owner.start && local - self.owner.start < self.owner.length {
      return Option::Some(local - self.owner.start)
    }
    if local >= self.method.start && local - self.method.start < self.method.length {
      return Option::Some(self.owner.length + local - self.method.start)
    }
    Option::None
  }

  fn local(self, slot: U32) -> U32 {
    self_host_assert_array_index(slot, self.length, "SPC-301: callable generic slot is outside its parameter list")
    if slot < self.owner.length {
      self.owner.start + slot
    } else {
      self.method.start + (slot - self.owner.length)
    }
  }
}

fn self_host_program_specialization_callable_generics(
  callable: SelfHostPlannedCallable,
) -> SelfHostCallableGenericParameters {
  self_host_assert_compiler_invariant(
    callable.generic_parameters.length <= 4294967295u32 - callable.owner_generic_parameters.length,
    "SPC-301: callable generic parameter count overflows",
  )
  SelfHostCallableGenericParameters::{
    module_id: self_host_semantic_id_module(callable.declaration)
    owner: callable.owner_generic_parameters
    method: callable.generic_parameters
    length: callable.owner_generic_parameters.length + callable.generic_parameters.length
  }
}

fn self_host_program_specialization_call_arity_matches(
  callable: SelfHostPlannedCallable,
  argument_count: U32,
  method_call: Bool,
) -> Bool {
  if method_call {
    if !callable.has_receiver {
      return false
    }
    self_host_assert_compiler_invariant(
      !self_host_u32_equal(argument_count, 4294967295u32),
      "compiler method-call argument count cannot include the receiver",
    )
    self_host_u32_equal(
      callable.parameters.length,
      self_host_u32_add(argument_count, 1u32),
    )
  } else {
    self_host_u32_equal(callable.parameters.length, argument_count)
  }
}

fn self_host_program_specialization_callable_body(
  callable: SelfHostPlannedCallable,
) -> Option<U64> {
  match callable.kind {
    SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => Option::Some(body)
    SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, body) => body
    _ => Option::None
  }
}

fn self_host_program_specialization_body(
  module_: SelfHostPlannedModuleLowering,
  body: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  let mut body_index = 0u32
  let _ = while body_index {
    current => if current < module_.bodies.length() {
      let candidate = module_.bodies[current]
    if self_host_u64_equal(candidate.body, body) {
      return Option::Some(candidate)
    }
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  Option::None
}

fn self_host_program_specialization_seen() -> Map<U64, Bool> {
  Map::empty()
}

fn self_host_program_specialization_add_reachable(
  reachable: Array<U64>,
  seen: Map<U64, Bool>,
  declaration: U64,
) -> Bool {
  if self_host_u64_equal(declaration, 0u64) || seen.contains_key(declaration) {
    return false
  }
  seen.set(declaration, true)
  reachable.push(declaration)
  true
}

fn self_host_program_specialization_call_recipe(
  expression: SelfHostPlannedExpression,
) -> Option<SelfHostProgramCallRecipe> {
  // A selected name consumed by a direct call is not a separate reference.
  if expression.kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression || expression.kind is SelfHostPlannedExpressionKind::PlannedPoisonExpression || expression.kind is SelfHostPlannedExpressionKind::PlannedDeadExpression {
    return Option::None
  }
  // A variant constructor has a physical type, not a physical function.
  match expression.selection {
    SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(
      _,
      _,
      _,
    ) => return Option::None
    _ => {}
  }
  match expression.call_target {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => {
      return Option::Some(SelfHostProgramCallRecipe::{
        target: declaration
      })
    }
    _ => {}
  }
  match expression.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(target, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedOperatorCall(target, _, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, target, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, target) => match target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => Option::Some(
        SelfHostProgramCallRecipe::{
          target: declaration
        },
      )
      _ => Option::None
    }
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, target) => match target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => Option::Some(
        SelfHostProgramCallRecipe::{
          target: declaration
        },
      )
      _ => Option::None
    }
    _ => Option::None
  }
}

fn self_host_program_specialization_resolved_type(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> Option<U32> {
  if type_ < -1i32 {
    Option::Some(self_host_body_i32_to_u32(-type_ - 2i32))
  } else if type_ >= 0i32 {
    let index = self_host_body_i32_to_u32(type_)
    if index < module_.inferred.types.length() {
      match module_.inferred.types[index] {
        SelfHostBodyTypeTerm::BodyResolvedType(value) => Option::Some(value)
        _ => Option::None
      }
    } else {
      Option::None
    }
  } else {
    Option::None
  }
}

fn self_host_program_specialization_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  caller_shapes: SelfHostHirSpan,
  shapes: Array<SelfHostPlannedValueShape>,
  type_: I32,
) -> SelfHostPlannedValueShape {
  let fallback = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    type_,
  )
  match caller {
    Option::Some(callable) => {
      let generics = self_host_program_specialization_callable_generics(callable)
      match self_host_program_specialization_resolved_type(module_, type_) {
        Option::Some(resolved_type) => if resolved_type < module_.resolved_types.types.length() {
          match module_.resolved_types.types[resolved_type] {
            SelfHostResolvedType::GenericParameterType(parameter) => {
              match generics.slot(parameter) {
                Option::Some(relative) => if relative < caller_shapes.length {
                  return shapes[self_host_u32_add(caller_shapes.start, relative)]
                }
                Option::None => {}
              }
            }
            _ => {}
          }
        }
        Option::None => {}
      }
      fallback
    }
    Option::None => fallback
  }
}

fn self_host_program_specialization_record_call(
  calls: Array<SelfHostProgramSpecializedCall>,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  target: U64,
  target_specialization: U32,
) -> Unit {
  calls.push(SelfHostProgramSpecializedCall::{
    caller_body: caller_body
    caller_specialization: caller_specialization
    expression: expression
    target: target
    target_specialization: target_specialization
  })
}

fn self_host_program_specialization_mark_nominal(
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  expression: SelfHostPlannedExpression,
) -> Unit {
  if !self_host_u64_equal(expression.nominal, 0u64) {
    let _ = self_host_program_specialization_add_reachable(
      reachable,
      reachable_seen,
      expression.nominal,
    )
  }
  match expression.kind {
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, selection) => match selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(declaration, _) => {
        let _ = self_host_program_specialization_add_reachable(
          reachable,
          reachable_seen,
          declaration,
        )
      }
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(variant, _, _) => {
        let _ = self_host_program_specialization_add_reachable(
          reachable,
          reachable_seen,
          variant,
        )
      }
      _ => {}
    }
    _ => {}
  }
}

fn self_host_program_specialization_expression(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedExpression {
  module_.expressions[index]
}

fn self_host_program_specialization_call_type_argument(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> I32 {
  if index < module_.inferred.call_type_arguments.length() {
    module_.inferred.call_type_arguments[index]
  } else {
    0i32
  }
}

fn self_host_program_specialization_module_name_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.names.length()
}

fn self_host_program_specialization_module_name_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> String {
  module_.names[index]
}

fn self_host_program_specialization_callable_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  self_host_planned_module_functions_identity(
    module_.functions,
  ).callables.length()
}

fn self_host_program_specialization_callable_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedCallable {
  let functions = self_host_planned_module_functions_identity(module_.functions)
  self_host_planned_callable_identity(functions.callables[index])
}

fn self_host_program_specialization_evidence_target(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_offset: U32,
  target: U64,
) -> U64 {
  let evidence_body = match module_.evidence.evidence_body(body.declaration) {
    Option::Some(value) => value
    Option::None => {
      return target
    }
  }
  if !self_host_u32_greater(
    evidence_body.expression_evidence_count(),
    expression_offset,
  ) {
    return target
  }
  let evidence_span = evidence_body.expression_evidence_at(expression_offset)
  if self_host_u32_equal(evidence_span.length, 0u32) ||
    !self_host_u32_greater(evidence_body.evidence_count(), evidence_span.start) {
    return target
  }
  let implementation = evidence_body.evidence_at(evidence_span.start).implementation
  let target_name = match lowering.index.declaration_owner(target) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      lowering.modules[owner],
      target,
    ) {
      Option::Some(callable) => callable.name
      Option::None => {
        return target
      }
    }
    Option::None => {
      return target
    }
  }
  let mut scan_module_index = 0u32
  let _ = while scan_module_index {
    current => if current < lowering.modules.length() {
      let candidate_module = lowering.modules[current]
    let _ = while 0u32 {
      index => if index < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          index,
        )
        match callable.kind {
          SelfHostPlannedCallableKind::PlannedImplMethodCallable(
            candidate_implementation,
            _,
          ) => if self_host_u64_equal(
            candidate_implementation,
            implementation,
          ) && callable.name.equals(target_name) {
            return callable.declaration
          }
          _ => {}
        }
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  target
}

fn self_host_program_specialization_receiver_nominal_by_name(
  lowering: SelfHostPlannedProgramLowering,
  name: String,
) -> U64 {
  let mut selected = 0u64
  let mut builtin_module_index = 0u32
  let _ = while builtin_module_index {
    current => if current < lowering.modules.length() {
      let candidate_module = lowering.modules[current]
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && callable.name.equals(name.as_bytes()) {
          let nominal = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            if !self_host_u64_equal(selected, 0u64) &&
              !self_host_u64_equal(selected, nominal) {
              return 0u64
            }
            selected = nominal
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  selected
}

fn self_host_program_specialization_let_usage_nominal(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  let mut local_id = 4294967295u32
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  local_id = candidate
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(local_id, 4294967295u32) {
    return 0u64
  }
  let mut relative_expression = 0u32
  let _ = while relative_expression {
    current => if current < body.expressions.length {
      let candidate_expression = self_host_u32_add(
        body.expressions.start,
        current,
      )
      match module_.expressions[candidate_expression].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(
              base,
              name,
            ) => if base < module_.expressions.length() &&
              name < self_host_program_specialization_module_name_count(
                module_,
              ) {
              match module_.expressions[base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  let nominal = self_host_program_specialization_receiver_nominal_by_name(
                    lowering,
                    self_host_program_specialization_module_name_at(
                      module_,
                      name,
                    ),
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
                _ => {}
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_program_specialization_argument_nominal(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let parent_index = self_host_u32_add(body.expressions.start, current)
      if parent_index < module_.expressions.length() {
        match module_.expressions[parent_index].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            arguments,
            _,
          ) => {
            let mut position = 0u32
            let mut found = 4294967295u32
            let _ = while position {
              argument => if argument < arguments.length {
                let child_index = self_host_u32_add(arguments.start, argument)
                if child_index < module_.expression_children.length() &&
                  self_host_u32_equal(
                    module_.expression_children[child_index],
                    expression,
                  ) {
                  found = argument
                }
                continue argument + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            if !self_host_u32_equal(found, 4294967295u32) {
              match lowering.index.declaration_owner(declaration) {
                Option::Some(owner) => {
                  let callable_module = lowering.modules[owner]
                  match self_host_program_specialization_callable(
                    callable_module,
                    declaration,
                  ) {
                    Option::Some(callable) => if found < callable.parameters.length {
                      let parameter_index = self_host_u32_add(
                        callable.parameters.start,
                        found,
                      )
                      if parameter_index < callable_module.functions.parameters.length() {
                        let nominal = self_host_linked_resolved_nominal_declaration(
                          callable_module,
                          callable_module.functions.parameters[
                            parameter_index
                          ].type_,
                        )
                        if !self_host_u64_equal(nominal, 0u64) {
                          return nominal
                        }
                      }
                    }
                    Option::None => {}
                  }
                }
                Option::None => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target,
            arguments,
          ) => if target < module_.expressions.length() {
            let mut position = 0u32
            let mut found = 4294967295u32
            let _ = while position {
              argument => if argument < arguments.length {
                let child_index = self_host_u32_add(arguments.start, argument)
                if child_index < module_.expression_children.length() &&
                  self_host_u32_equal(
                    module_.expression_children[child_index],
                    expression,
                  ) {
                  found = argument
                }
                continue argument + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let source_name = module_.expressions[target].source_name
            if !self_host_u32_equal(found, 4294967295u32) &&
              self_host_u32_greater(
                self_host_program_specialization_module_name_count(module_),
                source_name,
              ) {
              let name = self_host_program_specialization_module_name_at(
                module_,
                source_name,
              )
              let mut name_module_index = 0u32
              let _ = while name_module_index {
                current => if current < lowering.modules.length() {
                  let candidate_module = lowering.modules[current]
                let mut callable_index = 0u32
                let _ = while callable_index {
                  current_callable => if current_callable < self_host_program_specialization_callable_count(
                    candidate_module,
                  ) {
                    let callable = self_host_program_specialization_callable_at(
                      candidate_module,
                      current_callable,
                    )
                    if callable.name.equals(name.as_bytes()) &&
                      found < callable.parameters.length {
                      let parameter_index = self_host_u32_add(
                        callable.parameters.start,
                        found,
                      )
                      if parameter_index < candidate_module.functions.parameters.length() {
                        let nominal = self_host_linked_resolved_nominal_declaration(
                          candidate_module,
                          candidate_module.functions.parameters[
                            parameter_index
                          ].type_,
                        )
                        if !self_host_u64_equal(nominal, 0u64) {
                          return nominal
                        }
                      }
                    }
                    continue current_callable + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                                continue current + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_program_specialization_program_callable(
  lowering: SelfHostPlannedProgramLowering,
  declaration: U64,
) -> Option<SelfHostPlannedCallable> {
  match lowering.index.declaration_owner(declaration) {
    Option::Some(module_index) => if module_index < lowering.modules.length() {
      self_host_program_specialization_callable(
        lowering.modules[module_index],
        declaration,
      )
    } else {
      Option::None
    }
    Option::None => Option::None
  }
}

fn self_host_program_specialization_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_program_specialization_resolved_type(module_, type_) {
    Option::Some(resolved_type) => self_host_program_specialization_resolved_type_argument_shape(
      module_,
      resolved_type,
      argument,
    )
    Option::None => Option::None
  }
}

fn self_host_program_specialization_resolved_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  resolved_type: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  if resolved_type >= module_.resolved_types.types.length() {
    return Option::None
  }
  match module_.resolved_types.types[resolved_type] {
    SelfHostResolvedType::AppliedType(_, arguments) => if argument < arguments.length {
      let index = self_host_u32_add(arguments.start, argument)
      if index < module_.resolved_types.type_arguments.length() {
        Option::Some(
          self_host_planned_resolved_value_shape(
            module_.resolved_types,
            module_.resolved_types.type_arguments[index],
          ),
        )
      } else {
        Option::None
      }
    } else {
      Option::None
    }
    _ => Option::None
  }
}

fn self_host_program_specialization_receiver_field_resolved_type(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  receiver: U32,
) -> Option<U32> {
  if receiver >= module_.expressions.length() {
    return Option::None
  }
  let name = match module_.expressions[receiver].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, value) => value
    SelfHostPlannedExpressionKind::PlannedFieldGet(field, _, _) => {
      for layout in module_.type_layouts.fields {
        if self_host_u64_equal(layout.field, field) {
          self_host_assert_array_index(
            layout.type_,
            module_.resolved_types.types.length(),
            "compiler specialization field type is outside the resolved-type arena",
          )
          return Option::Some(layout.type_)
        }
      }
      return Option::None
    }
    _ => return Option::None
  }
  if name >= module_.names.length() {
    return Option::None
  }
  let owner = match caller {
    Option::Some(value) => self_host_linked_resolved_nominal_declaration(
      module_,
      value.self_type,
    )
    Option::None => return Option::None
  }
  let field_name = module_.names[name]
  if !self_host_u64_equal(owner, 0u64) {
    for layout in module_.type_layouts.fields {
      if self_host_u64_equal(layout.declaration, owner) && self_host_tokenizer_string_equals(
        layout.name,
        field_name,
      ) {
        self_host_assert_array_index(
          layout.type_,
          module_.resolved_types.types.length(),
          "compiler specialization field type is outside the resolved-type arena",
        )
        return Option::Some(layout.type_)
      }
    }
  }
  let mut selected = 4294967295u32
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < module_.type_layouts.fields.length() {
      let layout = module_.type_layouts.fields[current]
      if self_host_tokenizer_string_equals(layout.name, field_name) {
        if !self_host_u32_equal(selected, 4294967295u32) {
          return Option::None
        }
        selected = current
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(selected, 4294967295u32) {
    Option::None
  } else {
    let type_ = module_.type_layouts.fields[selected].type_
    self_host_assert_array_index(
      type_,
      module_.resolved_types.types.length(),
      "compiler specialization field type is outside the resolved-type arena",
    )
    Option::Some(type_)
  }
}

fn self_host_program_specialization_receiver_field_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  receiver: U32,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  match self_host_program_specialization_receiver_field_resolved_type(
    module_,
    caller,
    receiver,
  ) {
    Option::Some(type_) => self_host_program_specialization_resolved_type_argument_shape(
      module_,
      type_,
      argument,
    )
    Option::None => Option::None
  }
}

fn self_host_program_specialization_receiver_field_nominal(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  receiver: U32,
) -> U64 {
  match self_host_program_specialization_receiver_field_resolved_type(
    module_,
    caller,
    receiver,
  ) {
    Option::Some(type_) => self_host_linked_resolved_nominal_declaration(
      module_,
      type_,
    )
    Option::None => 0u64
  }
}

fn self_host_program_specialization_result_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  expression: SelfHostPlannedExpression,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  self_host_program_specialization_type_argument_shape(
    module_,
    expression.type_,
    argument,
  )
}

fn self_host_program_specialization_receiver_type_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  expression: SelfHostPlannedExpression,
  argument: U32,
) -> Option<SelfHostPlannedValueShape> {
  let target = match expression.kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(value, _) => value
    _ => {
      return Option::None
    }
  }
  if target >= module_.expressions.length() {
    return Option::None
  }
  let field_target = if module_.expressions[target].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression && self_host_u32_greater(
    target,
    0u32,
  ) {
    target - 1u32
  } else {
    target
  }
  let raw_base = match module_.expressions[field_target].kind {
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => value
    _ => {
      return Option::None
    }
  }
  let base = if raw_base < module_.expressions.length() && module_.expressions[raw_base].kind is SelfHostPlannedExpressionKind::PlannedConsumedExpression && self_host_u32_greater(
    raw_base,
    0u32,
  ) {
    raw_base - 1u32
  } else {
    raw_base
  }
  if base >= module_.expressions.length() {
    return Option::None
  }
  match self_host_program_specialization_receiver_field_argument_shape(
    module_,
    caller,
    base,
    argument,
  ) {
    Option::Some(shape) => Option::Some(shape)
    Option::None => self_host_program_specialization_type_argument_shape(
      module_,
      module_.expressions[base].type_,
      argument,
    )
  }
}

fn self_host_program_specialization_scan_body(
  lowering: SelfHostPlannedProgramLowering,
  module_index: U32,
  body: SelfHostPlannedBodyLowering,
  caller: Option<SelfHostPlannedCallable>,
  caller_specialization: U32,
  caller_shapes: SelfHostHirSpan,
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  calls: Array<SelfHostProgramSpecializedCall>,
) -> Unit {
  self_host_program_specialization_scan_one_body(lowering, module_index, body, caller, caller_specialization, caller_shapes, reachable, reachable_seen, requests, shapes, request_head_by_declaration, request_next, calls)
  let module_ = self_host_program_function_lowering(lowering, module_index, caller_specialization)
  // Lambda expression spans are separate from the root function's span. Scan
  // each nested body once in the same owning specialization context.
  for lambda in module_.lambdas {
    if self_host_u64_equal(lambda.root_body, body.body) && self_host_compile_time_lambda_is_live(module_, lambda.lambda) {
      match self_host_body_lambda_lookup(module_, lambda.lambda) {
        Option::Some(lambda_body) => self_host_program_specialization_scan_one_body(lowering, module_index, lambda_body, caller, caller_specialization, caller_shapes, reachable, reachable_seen, requests, shapes, request_head_by_declaration, request_next, calls)
        Option::None => {
          let _ = self_host_assert_compiler_invariant_with_failure(false, SelfHostInvariantFailure::{
            code: 610u32
            phase: 5u32
            module_id: module_.module_id
            declaration: body.declaration
            body: body.body
            expression: lambda.expressions.start
            expected: 1u64
            actual: 0u64
            detail: u32_into_u64(lambda.lambda)
          }, "specialization lost a source lambda body")
        }
      }
    }
  }
}

fn self_host_program_specialization_scan_one_body(
  lowering: SelfHostPlannedProgramLowering,
  module_index: U32,
  body: SelfHostPlannedBodyLowering,
  caller: Option<SelfHostPlannedCallable>,
  caller_specialization: U32,
  caller_shapes: SelfHostHirSpan,
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  calls: Array<SelfHostProgramSpecializedCall>,
) -> Unit {
  let module_ = self_host_program_function_lowering(lowering, module_index, caller_specialization)
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      let expression_index = self_host_u32_add(body.expressions.start, current)
      let expression = self_host_program_specialization_expression(
        module_,
        expression_index,
      )
      self_host_program_specialization_mark_nominal(
        reachable,
        reachable_seen,
        expression,
      )
      match self_host_program_specialization_call_recipe(expression) {
        Option::Some(recipe) => {
          let evidence_target = self_host_program_specialization_evidence_target(
            lowering,
            module_,
            body,
            current,
            recipe.target,
          )
          let target = self_host_program_specialization_bound_target(lowering, module_, body, current, caller, caller_specialization, requests, evidence_target)
          if !self_host_u64_equal(target, 0u64) {
            self_host_program_specialization_add_reachable(
              reachable,
              reachable_seen,
              target,
            )
            let type_arguments = expression.call_type_arguments
            if self_host_u32_greater(type_arguments.length, 0u32) {
              let candidate_shapes = []
              let mut argument = 0u32
              let _ = while argument {
                argument_offset => if argument_offset < type_arguments.length {
                  let type_ = self_host_program_specialization_call_type_argument(
                    module_,
                    self_host_u32_add(type_arguments.start, argument_offset),
                  )
                  let candidate_shape = match self_host_program_specialization_receiver_type_argument_shape(
                    module_,
                    caller,
                    expression,
                    argument_offset,
                  ) {
                    Option::Some(shape) => shape
                    Option::None => self_host_program_specialization_argument_shape(
                      module_,
                      caller,
                      caller_shapes,
                      shapes,
                      type_,
                    )
                  }
                  candidate_shapes.push(candidate_shape)
                  continue argument_offset + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let evidence_types = self_host_program_specialization_call_evidence_types(lowering, module_, caller, caller_specialization, requests, target, type_arguments)
              let request = self_host_program_specialization_add_request_at_call(
                requests,
                shapes,
                request_head_by_declaration,
                request_next,
                target,
                candidate_shapes,
                evidence_types,
                body.body,
                expression_index,
              )
              self_host_program_specialization_record_call(
                calls,
                body.body,
                caller_specialization,
                expression_index,
                target,
                request,
              )
            } else {
              match self_host_program_specialization_program_callable(
                lowering,
                target,
              ) {
                Option::Some(callable) => {
                  let generic_parameters = self_host_program_specialization_callable_generics(
                    callable,
                  )
                  if generic_parameters.length == 0u32 && !self_host_u64_equal(target, recipe.target) {
                    self_host_program_specialization_record_call(calls, body.body, caller_specialization, expression_index, target, 4294967295u32)
                  }
                  if self_host_u32_greater(generic_parameters.length, 0u32) {
                    let candidate_shapes = []
                    let mut complete = true
                    let mut argument = 0u32
                    let _ = while argument {
                      argument_offset => if argument_offset < generic_parameters.length {
                        let candidate_shape = match self_host_program_specialization_receiver_type_argument_shape(
                          module_,
                          caller,
                          expression,
                          argument_offset,
                        ) {
                          Option::Some(shape) => Option::Some(shape)
                          Option::None => match self_host_program_specialization_result_type_argument_shape(
                            module_,
                            expression,
                            argument_offset,
                          ) {
                            Option::Some(shape) => Option::Some(shape)
                            Option::None => if self_host_bytes_equal(
                              callable.name,
                              b"with_capacity",
                            ) && callable.result_shape is SelfHostPlannedValueShape::RefPlannedValueShape {
                              // Capacity does not store an element. The Array wrapper has one reference carrier.
                              Option::Some(SelfHostPlannedValueShape::RefPlannedValueShape)
                            } else {
                              Option::None
                            }
                          }
                        }
                        match candidate_shape {
                          Option::Some(shape) => candidate_shapes.push(shape)
                          Option::None => {
                            complete = false
                          }
                        }
                        continue argument_offset + 1u32
                      } else {
                        break self_host_semantic_unit()
                      }
                    }
                    if complete && self_host_u32_equal(
                      candidate_shapes.length(),
                      generic_parameters.length,
                    ) {
                      let request = self_host_program_specialization_add_request_at_call(
                        requests,
                        shapes,
                        request_head_by_declaration,
                        request_next,
                        target,
                        candidate_shapes,
                        [], body.body, expression_index,
                      )
                      self_host_program_specialization_record_call(
                        calls,
                        body.body,
                        caller_specialization,
                        expression_index,
                        target,
                        request,
                      )
                    }
                  }
                }
                Option::None => {}
              }
            }
          }
        }
        Option::None => match expression.kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target_expression,
            arguments,
          ) => if target_expression < module_.expressions.length() {
            let target = module_.expressions[target_expression]
            let source_name = target.source_name
            let name_count = self_host_program_specialization_module_name_count(
              module_,
            )
            let unresolved_name = if self_host_u32_greater(
              name_count,
              source_name,
            ) {
              self_host_program_specialization_module_name_at(
                module_,
                source_name,
              )
            } else {
              ""
            }
            let unresolved_method_call = target.kind is SelfHostPlannedExpressionKind::PlannedUnresolvedField(_, _)
            let unresolved_nominal = match target.kind {
              SelfHostPlannedExpressionKind::PlannedPoisonExpression => {
                let base_nominal = if self_host_u32_greater(
                  target_expression,
                  0u32,
                ) {
                  let base = module_.expressions[target_expression - 1u32]
                  if !self_host_u64_equal(base.nominal, 0u64) {
                    base.nominal
                  } else {
                    self_host_linked_type_nominal_declaration(
                      module_,
                      base.type_,
                    )
                  }
                } else {
                  0u64
                }
                if !self_host_u64_equal(base_nominal, 0u64) {
                  base_nominal
                } else {
                  let usage_nominal = self_host_program_specialization_let_usage_nominal(
                    lowering,
                    module_,
                    body,
                    expression_index,
                  )
                  if !self_host_u64_equal(usage_nominal, 0u64) {
                    usage_nominal
                  } else {
                    self_host_program_specialization_argument_nominal(
                      lowering,
                      module_,
                      body,
                      expression_index,
                    )
                  }
                }
              }
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(base, _) => if base < module_.expressions.length() {
                let receiver = module_.expressions[base]
                let declared_field_nominal = self_host_program_specialization_receiver_field_nominal(
                  module_,
                  caller,
                  base,
                )
                if !self_host_u64_equal(declared_field_nominal, 0u64) {
                  declared_field_nominal
                } else if !self_host_u64_equal(receiver.nominal, 0u64) {
                  receiver.nominal
                } else {
                  self_host_linked_type_nominal_declaration(
                    module_,
                    receiver.type_,
                  )
                }
              } else {
                0u64
              }
              _ => 0u64
            }
            let mut resolved_nominal_call = false
            if !self_host_u64_equal(unresolved_nominal, 0u64) &&
              unresolved_name.byte_length() > 0u32 {
              let mut array_module_index = 0u32
              let _ = while array_module_index {
                current => if current < lowering.modules.length() {
                  let candidate_module = lowering.modules[current]
                let mut callable_index = 0u32
                let _ = while callable_index {
                  candidate => if candidate < self_host_program_specialization_callable_count(
                    candidate_module,
                  ) {
                    let callable = self_host_program_specialization_callable_at(
                      candidate_module,
                      candidate,
                    )
                    let candidate_nominal = self_host_linked_resolved_nominal_declaration(
                      candidate_module,
                      if unresolved_method_call {
                        callable.self_type
                      } else {
                        callable.result_type
                      },
                    )
                    if callable.name.equals(unresolved_name.as_bytes()) &&
                      self_host_program_specialization_call_arity_matches(
                        callable,
                        arguments.length,
                        unresolved_method_call,
                      ) && self_host_u64_equal(
                        candidate_nominal,
                        unresolved_nominal,
                      ) {
                      let generic_parameters = self_host_program_specialization_callable_generics(
                        callable,
                      )
                      let candidate_shapes = []
                      let mut generic = 0u32
                      let _ = while generic {
                        current_generic => if current_generic < generic_parameters.length {
                          match self_host_program_specialization_receiver_type_argument_shape(
                            module_,
                            caller,
                            expression,
                            current_generic,
                          ) {
                            Option::Some(shape) => candidate_shapes.push(shape)
                            Option::None => if current_generic < caller_shapes.length {
                              candidate_shapes.push(shapes[
                                self_host_u32_add(caller_shapes.start, current_generic)
                              ])
                            } else {
                              candidate_shapes.push(SelfHostPlannedValueShape::GenericPlannedValueShape)
                            }
                          }
                          continue current_generic + 1u32
                        } else {
                          break self_host_semantic_unit()
                        }
                      }
                      let request = if self_host_u32_greater(
                        generic_parameters.length,
                        0u32,
                      ) {
                        self_host_program_specialization_add_request_at_call(
                          requests,
                          shapes,
                          request_head_by_declaration,
                          request_next,
                          callable.declaration,
                          candidate_shapes,
                          [], body.body, expression_index,
                        )
                      } else {
                        4294967295u32
                      }
                      self_host_program_specialization_add_reachable(
                        reachable,
                        reachable_seen,
                        callable.declaration,
                      )
                      self_host_program_specialization_record_call(
                        calls,
                        body.body,
                        caller_specialization,
                        expression_index,
                        callable.declaration,
                        request,
                      )
                      resolved_nominal_call = true
                      break self_host_semantic_unit()
                    }
                    continue candidate + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                if resolved_nominal_call {
                  break self_host_semantic_unit()
                }
                                continue current + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
            }

          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_program_specialization_normalize_receiver_calls(
  lowering: SelfHostPlannedProgramLowering,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  calls: Array<SelfHostProgramSpecializedCall>,
  start: U32,
) -> U32 {
  self_host_assert_compiler_invariant(
    !self_host_u32_greater(start, calls.length()),
    "compiler specialization call normalization cursor is outside the arena",
  )
  let mut call_index = start
  let _ = while call_index {
    current => if current < calls.length() {
      let call = self_host_program_specialized_call_identity(calls[current])
      match self_host_program_specialization_program_callable(
        lowering,
        call.target,
      ) {
        Option::Some(target_callable) => {
          let generics = self_host_program_specialization_callable_generics(
            target_callable,
          )
          if self_host_u32_greater(generics.length, 0u32) {
            let mut module_index = 0u32
            let mut normalized = false
            let _ = while module_index {
              candidate_module => if candidate_module < lowering.modules.length() {
                let module_ = if lowering.modules[candidate_module].module_id == self_host_semantic_id_module(call.caller_body) {
                  self_host_program_function_lowering(lowering, candidate_module, call.caller_specialization)
                } else {
                  lowering.modules[candidate_module]
                }
                match self_host_program_specialization_body(
                  module_,
                  call.caller_body,
                ) {
                  Option::Some(body) => if call.expression < module_.expressions.length() {
                    let expression = module_.expressions[call.expression]
                    let caller = self_host_program_specialization_callable(
                      module_,
                      body.declaration,
                    )
                    let candidates = []
                    let mut complete = true
                    let mut argument = 0u32
                    let _ = while argument {
                      position => if position < generics.length {
                        match self_host_program_specialization_receiver_type_argument_shape(
                          module_,
                          caller,
                          expression,
                          position,
                        ) {
                          Option::Some(shape) => candidates.push(shape)
                          Option::None => {
                            complete = false
                          }
                        }
                        continue position + 1u32
                      } else {
                        break self_host_semantic_unit()
                      }
                    }
                    if complete && self_host_u32_equal(
                      candidates.length(),
                      generics.length,
                    ) {
                      let request = self_host_program_specialization_add_request_at_call(
                        requests,
                        shapes,
                        request_head_by_declaration,
                        request_next,
                        call.target,
                        candidates,
                        if call.target_specialization < requests.length() {
                          requests[call.target_specialization].evidence_types
                        } else {
                          []
                        }, call.caller_body, call.expression,
                      )
                      calls[current] = SelfHostProgramSpecializedCall::{
                        caller_body: call.caller_body
                        caller_specialization: call.caller_specialization
                        expression: call.expression
                        target: call.target
                        target_specialization: request
                      }
                    }
                    normalized = true
                  }
                  Option::None => {}
                }
                if normalized {
                  break self_host_semantic_unit()
                }
                continue candidate_module + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
        }
        Option::None => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  calls.length()
}

fn self_host_program_specialization_scan_reachable_declaration(
  lowering: SelfHostPlannedProgramLowering,
  declaration: U64,
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  calls: Array<SelfHostProgramSpecializedCall>,
  scanned_bodies: Map<U64, Bool>,
) -> Unit {
  match lowering.index.declaration_owner(declaration) {
    Option::Some(owner) => {
      self_host_assert_array_index(
        owner,
        lowering.modules.length(),
        "compiler specialization declaration owner is outside the module arena",
      )
      let module_ = lowering.modules[owner]
      match self_host_program_specialization_callable(module_, declaration) {
        Option::Some(callable) => if self_host_u32_equal(
          self_host_program_specialization_callable_generics(callable).length,
          0u32,
        ) {
          match self_host_program_specialization_callable_body(callable) {
            Option::Some(body_id) => if !scanned_bodies.contains_key(body_id) {
              match self_host_program_specialization_body(module_, body_id) {
                Option::Some(body) => {
                  self_host_program_specialization_scan_body(
                    lowering,
                    owner,
                    body,
                    Option::Some(callable),
                    4294967295u32,
                    SelfHostHirSpan::{
                      start: 0u32
                      length: 0u32
                    },
                    reachable,
                    reachable_seen,
                    requests,
                    shapes,
                    request_head_by_declaration,
                    request_next,
                    calls,
                  )
                  scanned_bodies.set(body_id, true)
                }
                Option::None => {}
              }
            }
            Option::None => {}
          }
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
}

fn self_host_program_specialization_scan_request(
  lowering: SelfHostPlannedProgramLowering,
  request_index: U32,
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  request_head_by_declaration: Map<U64, U32>,
  request_next: Array<U32>,
  calls: Array<SelfHostProgramSpecializedCall>,
) -> Unit {
  self_host_assert_array_index(
    request_index,
    requests.length(),
    "compiler specialization request is outside the request arena",
  )
  let request = requests[request_index]
  self_host_prepare_compile_time_instance(lowering, request_index, requests)
  match lowering.index.declaration_owner(request.declaration) {
    Option::Some(owner) => {
      self_host_assert_array_index(
        owner,
        lowering.modules.length(),
        "compiler specialization request owner is outside the module arena",
      )
      let module_ = self_host_program_function_lowering(lowering, owner, request_index)
      match self_host_program_specialization_callable(
        module_,
        request.declaration,
      ) {
        Option::Some(callable) => {
          match self_host_program_specialization_callable_body(callable) {
            Option::Some(body_id) => match self_host_program_specialization_body(
              module_, body_id,
            ) {
              Option::Some(body) => self_host_program_specialization_scan_body(
                lowering,
                owner,
                body,
                Option::Some(callable),
                request_index,
                request.shapes,
                reachable,
                reachable_seen,
                requests,
                shapes,
                request_head_by_declaration,
                request_next,
                calls,
              )
              Option::None => {}
            }
            Option::None => {}
          }
        }
        Option::None => {}
      }
    }
    Option::None => {}
  }
}

fn self_host_plan_program_specialization(
  lowering: SelfHostPlannedProgramLowering,
  emit_tests: Bool,
) -> SelfHostProgramSpecializationPlan {
  let lowering = self_host_compile_time_planning_lowering(lowering)
  let reachable = []
  let reachable_seen = self_host_program_specialization_seen()
  let declaration_work = []
  let declaration_queued = self_host_program_specialization_seen()
  let requests = []
  let shapes = []
  let request_head_by_declaration = self_host_empty_u64_u32_map()
  let request_next = []
  let calls = []
  let scanned_bodies = self_host_program_specialization_seen()
  let mut module_index = 0u32
  let _ = while module_index {
    current_module => if current_module < lowering.modules.length() {
      let module_ = self_host_planned_module_lowering_identity(
        lowering.modules[current_module],
      )
      let functions = self_host_planned_module_functions_identity(
        module_.functions,
      )
      let mut root_callable_index = 0u32
      let _ = while root_callable_index {
        current => if current < functions.callables.length() {
          let callable = self_host_planned_callable_identity(
            functions.callables[current],
          )
          let implementation_method = callable.kind is SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, _)
          let visible_root = if callable.visibility is SelfHostSemanticVisibility::Public {
            true
          } else {
            !callable.compiler_owned
          }
          let callable_root = if visible_root {
            true
          } else {
            implementation_method
          }
          let enabled = if callable.is_test {
            emit_tests
          } else {
            true
          }
          if callable_root {
            if enabled {
              let _ = self_host_program_specialization_add_reachable(
                reachable,
                reachable_seen,
                callable.declaration,
              )
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut initializer_step_index = 0u32
      let _ = while initializer_step_index {
        current => if current < module_.initialization.steps.length() {
          let step = module_.initialization.steps[current]
        if !step.test_only || emit_tests {
          match step.kind {
            SelfHostPlannedModuleInitializationStepKind::PlannedInitializeModuleValue(_, body_id, _) => match self_host_program_specialization_body(
              module_,
              body_id,
            ) {
              Option::Some(body) => {
                self_host_program_specialization_scan_body(
                  lowering,
                  current_module,
                  body,
                  Option::None,
                  4294967295u32,
                  SelfHostHirSpan::{
                    start: 0u32
                    length: 0u32
                  },
                  reachable,
                  reachable_seen,
                  requests,
                  shapes,
                  request_head_by_declaration,
                  request_next,
                  calls,
                )
                scanned_bodies.set(body.body, true)
              }
              Option::None => {}
            }
            _ => {}
          }
        }
                continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut reachable_queue_index = 0u32
  reachable_queue_index = self_host_program_specialization_queue_reachable(
    reachable,
    declaration_work,
    declaration_queued,
    reachable_queue_index,
  )
  let mut work_index = 0u32
  let mut normalized_call_count = self_host_program_specialization_normalize_receiver_calls(
    lowering,
    requests,
    shapes,
    request_head_by_declaration,
    request_next,
    calls,
    0u32,
  )
  let mut request_index = 0u32
  let _ = while 0u32 {
    step => {
      if self_host_array_index_is_valid(
        work_index,
        declaration_work.length(),
      ) {
        self_host_program_specialization_scan_reachable_declaration(
          lowering,
          declaration_work[work_index],
          reachable,
          reachable_seen,
          requests,
          shapes,
          request_head_by_declaration,
          request_next,
          calls,
          scanned_bodies,
        )
        work_index = self_host_u32_add(work_index, 1u32)
      } else if self_host_array_index_is_valid(
        request_index,
        requests.length(),
      ) {
        self_host_program_specialization_scan_request(
          lowering,
          request_index,
          reachable,
          reachable_seen,
          requests,
          shapes,
          request_head_by_declaration,
          request_next,
          calls,
        )
        request_index = self_host_u32_add(request_index, 1u32)
      } else {
        break self_host_semantic_unit()
      }
      reachable_queue_index = self_host_program_specialization_queue_reachable(
        reachable,
        declaration_work,
        declaration_queued,
        reachable_queue_index,
      )
      normalized_call_count = self_host_program_specialization_normalize_receiver_calls(
        lowering,
        requests,
        shapes,
        request_head_by_declaration,
        request_next,
        calls,
        normalized_call_count,
      )
      continue step + 1u32
    }
  }
  SelfHostProgramSpecializationPlan::{
    lowering: lowering
    reachable_declarations: reachable
    requests: requests
    shapes: shapes
    calls: calls
  }
}

open dew.std.bytes
open dew.std.map
open dew.std.option

struct SelfHostSpecializationShapeTask {
  shape: SelfHostPlannedValueShape
  finish: Bool
  start: U32
}

struct SelfHostSpecializationShapePair {
  left: SelfHostPlannedValueShape
  right: SelfHostPlannedValueShape
}

pub struct SelfHostProgramSpecializationRequest {
  declaration: U64
  shapes: SelfHostHirSpan
}

pub struct SelfHostProgramSpecializedCall {
  caller_body: U64
  caller_specialization: U32
  expression: U32
  target: U64
  target_specialization: U32
}

pub struct SelfHostProgramSpecializationPlan {
  lowering: SelfHostPlannedProgramLowering
  reachable_declarations: Array<U64>
  requests: Array<SelfHostProgramSpecializationRequest>
  shapes: Array<SelfHostPlannedValueShape>
  calls: Array<SelfHostProgramSpecializedCall>
}

struct SelfHostProgramCallRecipe {
  target: U64
}

fn self_host_specialization_canonical_scalar(
  shape: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  match shape {
    SelfHostPlannedValueShape::I8PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I16PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U8PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U16PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::U32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::Swar32PlannedValueShape => SelfHostPlannedValueShape::I32PlannedValueShape
    SelfHostPlannedValueShape::I64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::U64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::Swar64PlannedValueShape => SelfHostPlannedValueShape::I64PlannedValueShape
    SelfHostPlannedValueShape::RefPlannedValueShape => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedValueShape::GenericPlannedValueShape => SelfHostPlannedValueShape::RefPlannedValueShape
    SelfHostPlannedValueShape::ErrorPlannedValueShape => SelfHostPlannedValueShape::RefPlannedValueShape
    _ => shape
  }
}

fn self_host_specialization_canonical_shape(
  root: SelfHostPlannedValueShape,
) -> SelfHostPlannedValueShape {
  let tasks = [SelfHostSpecializationShapeTask::{
    shape: root
    finish: false
    start: 0u32
  }]
  let results = []
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match tasks.pop() {
        Option::Some(value) => value
        Option::None => SelfHostSpecializationShapeTask::{
          shape: SelfHostPlannedValueShape::ErrorPlannedValueShape
          finish: false
          start: 0u32
        }
      }
      if task.finish {
        let fields = []
        let end = results.length()
        let mut index = task.start
        let _ = while index {
          current => if current < end {
            fields.push(results[current])
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        results.truncate(task.start)
        results.push(SelfHostPlannedValueShape::ProductPlannedValueShape(fields))
      } else {
        match task.shape {
          SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => {
            let start = results.length()
            tasks.push(SelfHostSpecializationShapeTask::{
              shape: task.shape
              finish: true
              start: start
            })
            let mut field = fields.length()
            let _ = while field {
              current => if self_host_u32_greater(current, 0u32) {
                let previous = current - 1u32
                tasks.push(SelfHostSpecializationShapeTask::{
                  shape: fields[previous]
                  finish: false
                  start: 0u32
                })
                continue previous
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => results.push(self_host_specialization_canonical_scalar(task.shape))
        }
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  match results.pop() {
    Option::Some(value) => value
    Option::None => SelfHostPlannedValueShape::RefPlannedValueShape
  }
}

fn self_host_specialization_shapes_equal(
  left: SelfHostPlannedValueShape,
  right: SelfHostPlannedValueShape,
) -> Bool {
  let work = [SelfHostSpecializationShapePair::{
    left: left
    right: right
  }]
  let _ = while work.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let pair = match work.pop() {
        Option::Some(value) => value
        Option::None => SelfHostSpecializationShapePair::{
          left: SelfHostPlannedValueShape::ErrorPlannedValueShape
          right: SelfHostPlannedValueShape::UnitPlannedValueShape
        }
      }
      let canonical_left = self_host_specialization_canonical_scalar(pair.left)
      let canonical_right = self_host_specialization_canonical_scalar(pair.right)
      match canonical_left {
        SelfHostPlannedValueShape::ProductPlannedValueShape(left_fields) => match canonical_right {
          SelfHostPlannedValueShape::ProductPlannedValueShape(right_fields) => {
            if !self_host_u32_equal(left_fields.length(), right_fields.length()) {
              return false
            }
            let mut field = 0u32
            let _ = while field {
              current => if current < left_fields.length() {
                work.push(SelfHostSpecializationShapePair::{
                  left: left_fields[current]
                  right: right_fields[current]
                })
                continue current + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {
            return false
          }
        }
        SelfHostPlannedValueShape::UnitPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::UnitPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::NeverPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::NeverPlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::I32PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::I32PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::I64PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::I64PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::F32PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::F32PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::F64PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::F64PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::V128PlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::V128PlannedValueShape) {
          return false
        }
        SelfHostPlannedValueShape::RefPlannedValueShape => if !(canonical_right is SelfHostPlannedValueShape::RefPlannedValueShape) {
          return false
        }
        _ => {
          return false
        }
      }
      continue work.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_program_specialization_callable(
  module_: SelfHostPlannedModuleLowering,
  declaration: U64,
) -> Option<SelfHostPlannedCallable> {
  if !self_host_u64_equal(
    self_host_semantic_id_module(declaration),
    module_.module_id,
  ) {
    return Option::None
  }
  let local = self_host_semantic_id_local(declaration)
  if local >= module_.functions.callable_by_declaration.length() {
    return Option::None
  }
  let index = module_.functions.callable_by_declaration[local]
  if index < module_.functions.callables.length() {
    Option::Some(module_.functions.callables[index])
  } else {
    Option::None
  }
}

fn self_host_program_specialization_callable_generics(
  callable: SelfHostPlannedCallable,
) -> SelfHostHirSpan {
  if self_host_u32_greater(callable.owner_generic_parameters.length, 0u32) {
    callable.owner_generic_parameters
  } else {
    callable.generic_parameters
  }
}

fn self_host_program_specialization_callable_body(
  callable: SelfHostPlannedCallable,
) -> Option<U64> {
  match callable.kind {
    SelfHostPlannedCallableKind::PlannedFunctionCallable(body) => Option::Some(body)
    SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, body) => body
    _ => Option::None
  }
}

fn self_host_program_specialization_body(
  module_: SelfHostPlannedModuleLowering,
  body: U64,
) -> Option<SelfHostPlannedBodyLowering> {
  for candidate in module_.bodies {
    if self_host_u64_equal(candidate.body, body) {
      return Option::Some(candidate)
    }
  }
  Option::None
}

fn self_host_program_specialization_seen() -> Map<U64, Bool> {
  Map::empty()
}

fn self_host_program_specialization_add_reachable(
  reachable: Array<U64>,
  seen: Map<U64, Bool>,
  declaration: U64,
) -> Bool {
  if self_host_u64_equal(declaration, 0u64) || seen.contains_key(declaration) {
    return false
  }
  seen.set(declaration, true)
  reachable.push(declaration)
  true
}

fn self_host_program_specialization_call_recipe(
  kind: SelfHostPlannedExpressionKind,
) -> Option<SelfHostProgramCallRecipe> {
  match kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(target, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedOperatorCall(target, _, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, target, _, _, _) => Option::Some(
      SelfHostProgramCallRecipe::{
        target: target
      },
    )
    SelfHostPlannedExpressionKind::PlannedIndexGet(_, _, target) => match target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => Option::Some(
        SelfHostProgramCallRecipe::{
          target: declaration
        },
      )
      _ => Option::None
    }
    SelfHostPlannedExpressionKind::PlannedIndexSet(_, _, _, target) => match target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => Option::Some(
        SelfHostProgramCallRecipe::{
          target: declaration
        },
      )
      _ => Option::None
    }
    _ => Option::None
  }
}

fn self_host_program_specialization_resolved_type(
  module_: SelfHostPlannedModuleLowering,
  type_: I32,
) -> Option<U32> {
  if type_ < -1i32 {
    Option::Some(self_host_body_i32_to_u32(-type_ - 2i32))
  } else if type_ >= 0i32 {
    let index = self_host_body_i32_to_u32(type_)
    if index < module_.inferred.types.length() {
      match module_.inferred.types[index] {
        SelfHostBodyTypeTerm::BodyResolvedType(value) => Option::Some(value)
        _ => Option::None
      }
    } else {
      Option::None
    }
  } else {
    Option::None
  }
}

fn self_host_program_specialization_argument_shape(
  module_: SelfHostPlannedModuleLowering,
  caller: Option<SelfHostPlannedCallable>,
  caller_shapes: SelfHostHirSpan,
  shapes: Array<SelfHostPlannedValueShape>,
  type_: I32,
) -> SelfHostPlannedValueShape {
  let fallback = self_host_planned_merged_body_value_shape(
    module_.resolved_types,
    module_.inferred,
    type_,
  )
  match caller {
    Option::Some(callable) => {
      let generics = self_host_program_specialization_callable_generics(callable)
      match self_host_program_specialization_resolved_type(module_, type_) {
        Option::Some(resolved_type) => if resolved_type < module_.resolved_types.types.length() {
          match module_.resolved_types.types[resolved_type] {
            SelfHostResolvedType::GenericParameterType(parameter) => {
              let local = self_host_semantic_id_local(parameter)
              if local >= generics.start &&
                local < self_host_u32_add(generics.start, generics.length) {
                let relative = local - generics.start
                if relative < caller_shapes.length {
                  return shapes[self_host_u32_add(caller_shapes.start, relative)]
                }
              }
            }
            _ => {}
          }
        }
        Option::None => {}
      }
      if self_host_u32_equal(caller_shapes.length, 1u32) {
        match fallback {
          SelfHostPlannedValueShape::GenericPlannedValueShape => {
            return shapes[caller_shapes.start]
          }
          SelfHostPlannedValueShape::ErrorPlannedValueShape => {
            return shapes[caller_shapes.start]
          }
          _ => {}
        }
      }
      fallback
    }
    Option::None => fallback
  }
}

fn self_host_program_specialization_request_matches(
  request: SelfHostProgramSpecializationRequest,
  requests_shapes: Array<SelfHostPlannedValueShape>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
) -> Bool {
  if !self_host_u64_equal(request.declaration, declaration) ||
    !self_host_u32_equal(request.shapes.length, candidates.length()) {
    return false
  }
  let mut index = 0u32
  let _ = while index {
    current => if current < request.shapes.length {
      if !self_host_specialization_shapes_equal(
        requests_shapes[self_host_u32_add(request.shapes.start, current)],
        candidates[current],
      ) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_program_specialization_add_request(
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  declaration: U64,
  candidates: Array<SelfHostPlannedValueShape>,
) -> U32 {
  let mut request_index = 0u32
  while request_index {
    current => if current < requests.length() {
      if self_host_program_specialization_request_matches(
        requests[current],
        shapes,
        declaration,
        candidates,
      ) {
        break current
      }
      continue current + 1u32
    } else {
      let start = shapes.length()
      for candidate in candidates {
        shapes.push(self_host_specialization_canonical_shape(candidate))
      }
      requests.push(SelfHostProgramSpecializationRequest::{
        declaration: declaration
        shapes: SelfHostHirSpan::{
          start: start
          length: candidates.length()
        }
      })
      break requests.length() - 1u32
    }
  }
}

fn self_host_program_specialization_record_call(
  calls: Array<SelfHostProgramSpecializedCall>,
  caller_body: U64,
  caller_specialization: U32,
  expression: U32,
  target: U64,
  target_specialization: U32,
) -> Unit {
  calls.push(SelfHostProgramSpecializedCall::{
    caller_body: caller_body
    caller_specialization: caller_specialization
    expression: expression
    target: target
    target_specialization: target_specialization
  })
}

fn self_host_program_specialization_mark_nominal(
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  expression: SelfHostPlannedExpression,
) -> Unit {
  if !self_host_u64_equal(expression.nominal, 0u64) {
    let _ = self_host_program_specialization_add_reachable(
      reachable,
      reachable_seen,
      expression.nominal,
    )
  }
  match expression.kind {
    SelfHostPlannedExpressionKind::PlannedConstruct(_, _, selection) => match selection {
      SelfHostBasicExpressionSelection::StructConstructionBasicExpressionSelection(declaration, _) => {
        let _ = self_host_program_specialization_add_reachable(
          reachable,
          reachable_seen,
          declaration,
        )
      }
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(variant, _, _) => {
        let _ = self_host_program_specialization_add_reachable(
          reachable,
          reachable_seen,
          variant,
        )
      }
      _ => {}
    }
    _ => {}
  }
}

fn self_host_program_specialization_expression(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedExpression {
  module_.expressions[index]
}

fn self_host_program_specialization_call_type_argument(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> I32 {
  if index < module_.inferred.call_type_arguments.length() {
    module_.inferred.call_type_arguments[index]
  } else {
    0i32
  }
}

fn self_host_program_specialization_module_name_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.names.length()
}

fn self_host_program_specialization_module_name_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> String {
  module_.names[index]
}

fn self_host_program_specialization_callable_count(
  module_: SelfHostPlannedModuleLowering,
) -> U32 {
  module_.functions.callables.length()
}

fn self_host_program_specialization_callable_at(
  module_: SelfHostPlannedModuleLowering,
  index: U32,
) -> SelfHostPlannedCallable {
  module_.functions.callables[index]
}

fn self_host_program_specialization_evidence_target(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression_offset: U32,
  target: U64,
) -> U64 {
  let evidence_body = match module_.evidence.evidence_body(body.declaration) {
    Option::Some(value) => value
    Option::None => {
      return target
    }
  }
  if !self_host_u32_greater(
    evidence_body.expression_evidence_count(),
    expression_offset,
  ) {
    return target
  }
  let evidence_span = evidence_body.expression_evidence_at(expression_offset)
  if self_host_u32_equal(evidence_span.length, 0u32) ||
    !self_host_u32_greater(evidence_body.evidence_count(), evidence_span.start) {
    return target
  }
  let implementation = evidence_body.evidence_at(evidence_span.start).implementation
  let target_name = match lowering.index.declaration_owner(target) {
    Option::Some(owner) => match self_host_program_specialization_callable(
      lowering.modules[owner],
      target,
    ) {
      Option::Some(callable) => callable.name
      Option::None => {
        return target
      }
    }
    Option::None => {
      return target
    }
  }
  for candidate_module in lowering.modules {
    let _ = while 0u32 {
      index => if index < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          index,
        )
        match callable.kind {
          SelfHostPlannedCallableKind::PlannedImplMethodCallable(
            candidate_implementation,
            _,
          ) => if self_host_u64_equal(
            candidate_implementation,
            implementation,
          ) && callable.name.equals(target_name) {
            return callable.declaration
          }
          _ => {}
        }
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  target
}

fn self_host_program_specialization_receiver_nominal_by_name(
  lowering: SelfHostPlannedProgramLowering,
  name: String,
) -> U64 {
  let mut selected = 0u64
  for candidate_module in lowering.modules {
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self_host_program_specialization_callable_count(
        candidate_module,
      ) {
        let callable = self_host_program_specialization_callable_at(
          candidate_module,
          current,
        )
        if callable.has_receiver && bytes_to_string(callable.name) == name {
          let nominal = self_host_linked_resolved_nominal_declaration(
            candidate_module,
            callable.self_type,
          )
          if !self_host_u64_equal(nominal, 0u64) {
            if !self_host_u64_equal(selected, 0u64) &&
              !self_host_u64_equal(selected, nominal) {
              return 0u64
            }
            selected = nominal
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  selected
}

fn self_host_program_specialization_let_usage_nominal(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  let mut local_id = 4294967295u32
  let mut relative_block = 0u32
  let _ = while relative_block {
    current_block => if current_block < body.blocks.length {
      let block_index = self_host_u32_add(body.blocks.start, current_block)
      if block_index < module_.blocks.length() {
        let block = module_.blocks[block_index]
        let mut relative_item = 0u32
        let _ = while relative_item {
          current_item => if current_item < block.items.length {
            let item_index = self_host_u32_add(block.items.start, current_item)
            if item_index < module_.block_items.length() {
              match module_.block_items[item_index].kind {
                SelfHostPlannedBlockItemKind::PlannedLetItem(
                  candidate,
                  _,
                  value,
                ) => if self_host_u32_equal(value, expression) {
                  local_id = candidate
                }
                _ => {}
              }
            }
            continue current_item + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_block + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if self_host_u32_equal(local_id, 4294967295u32) {
    return 0u64
  }
  let mut relative_expression = 0u32
  let _ = while relative_expression {
    current => if current < body.expressions.length {
      let candidate_expression = self_host_u32_add(
        body.expressions.start,
        current,
      )
      match module_.expressions[candidate_expression].kind {
        SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, _) => if target < module_.expressions.length() {
          match module_.expressions[target].kind {
            SelfHostPlannedExpressionKind::PlannedUnresolvedField(
              base,
              name,
            ) => if base < module_.expressions.length() &&
              name < self_host_program_specialization_module_name_count(
                module_,
              ) {
              match module_.expressions[base].kind {
                SelfHostPlannedExpressionKind::PlannedLocalGet(candidate) => if self_host_u32_equal(
                  candidate,
                  local_id,
                ) {
                  let nominal = self_host_program_specialization_receiver_nominal_by_name(
                    lowering,
                    self_host_program_specialization_module_name_at(
                      module_,
                      name,
                    ),
                  )
                  if !self_host_u64_equal(nominal, 0u64) {
                    return nominal
                  }
                }
                _ => {}
              }
            }
            _ => {}
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_program_specialization_argument_nominal(
  lowering: SelfHostPlannedProgramLowering,
  module_: SelfHostPlannedModuleLowering,
  body: SelfHostPlannedBodyLowering,
  expression: U32,
) -> U64 {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < body.expressions.length {
      let parent_index = self_host_u32_add(body.expressions.start, current)
      if parent_index < module_.expressions.length() {
        match module_.expressions[parent_index].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(
            declaration,
            _,
            arguments,
            _,
          ) => {
            let mut position = 0u32
            let mut found = 4294967295u32
            let _ = while position {
              argument => if argument < arguments.length {
                let child_index = self_host_u32_add(arguments.start, argument)
                if child_index < module_.expression_children.length() &&
                  self_host_u32_equal(
                    module_.expression_children[child_index],
                    expression,
                  ) {
                  found = argument
                }
                continue argument + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            if !self_host_u32_equal(found, 4294967295u32) {
              match lowering.index.declaration_owner(declaration) {
                Option::Some(owner) => {
                  let callable_module = lowering.modules[owner]
                  match self_host_program_specialization_callable(
                    callable_module,
                    declaration,
                  ) {
                    Option::Some(callable) => if found < callable.parameters.length {
                      let parameter_index = self_host_u32_add(
                        callable.parameters.start,
                        found,
                      )
                      if parameter_index < callable_module.functions.parameters.length() {
                        let nominal = self_host_linked_resolved_nominal_declaration(
                          callable_module,
                          callable_module.functions.parameters[
                            parameter_index
                          ].type_,
                        )
                        if !self_host_u64_equal(nominal, 0u64) {
                          return nominal
                        }
                      }
                    }
                    Option::None => {}
                  }
                }
                Option::None => {}
              }
            }
          }
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target,
            arguments,
          ) => if target < module_.expressions.length() {
            let mut position = 0u32
            let mut found = 4294967295u32
            let _ = while position {
              argument => if argument < arguments.length {
                let child_index = self_host_u32_add(arguments.start, argument)
                if child_index < module_.expression_children.length() &&
                  self_host_u32_equal(
                    module_.expression_children[child_index],
                    expression,
                  ) {
                  found = argument
                }
                continue argument + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let source_name = module_.expressions[target].source_name
            if !self_host_u32_equal(found, 4294967295u32) &&
              self_host_u32_greater(
                self_host_program_specialization_module_name_count(module_),
                source_name,
              ) {
              let name = self_host_program_specialization_module_name_at(
                module_,
                source_name,
              )
              for candidate_module in lowering.modules {
                let mut callable_index = 0u32
                let _ = while callable_index {
                  current_callable => if current_callable < self_host_program_specialization_callable_count(
                    candidate_module,
                  ) {
                    let callable = self_host_program_specialization_callable_at(
                      candidate_module,
                      current_callable,
                    )
                    if bytes_to_string(callable.name) == name &&
                      found < callable.parameters.length {
                      let parameter_index = self_host_u32_add(
                        callable.parameters.start,
                        found,
                      )
                      if parameter_index < candidate_module.functions.parameters.length() {
                        let nominal = self_host_linked_resolved_nominal_declaration(
                          candidate_module,
                          candidate_module.functions.parameters[
                            parameter_index
                          ].type_,
                        )
                        if !self_host_u64_equal(nominal, 0u64) {
                          return nominal
                        }
                      }
                    }
                    continue current_callable + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  0u64
}

fn self_host_program_specialization_scan_body(
  lowering: SelfHostPlannedProgramLowering,
  module_index: U32,
  body: SelfHostPlannedBodyLowering,
  caller: Option<SelfHostPlannedCallable>,
  caller_specialization: U32,
  caller_shapes: SelfHostHirSpan,
  reachable: Array<U64>,
  reachable_seen: Map<U64, Bool>,
  requests: Array<SelfHostProgramSpecializationRequest>,
  shapes: Array<SelfHostPlannedValueShape>,
  calls: Array<SelfHostProgramSpecializedCall>,
) -> Unit {
  let module_ = lowering.modules[module_index]
  let mut expression_offset = 0u32
  let _ = while expression_offset {
    current => if current < body.expressions.length {
      let expression_index = self_host_u32_add(body.expressions.start, current)
      let expression = self_host_program_specialization_expression(
        module_,
        expression_index,
      )
      self_host_program_specialization_mark_nominal(
        reachable,
        reachable_seen,
        expression,
      )
      match self_host_program_specialization_call_recipe(expression.kind) {
        Option::Some(recipe) => {
          let target = self_host_program_specialization_evidence_target(
            lowering,
            module_,
            body,
            current,
            recipe.target,
          )
          if !self_host_u64_equal(target, 0u64) {
            self_host_program_specialization_add_reachable(
              reachable,
              reachable_seen,
              target,
            )
            let type_arguments = expression.call_type_arguments
            if self_host_u32_greater(type_arguments.length, 0u32) {
              let candidate_shapes = []
              let mut argument = 0u32
              let _ = while argument {
                argument_offset => if argument_offset < type_arguments.length {
                  let type_ = self_host_program_specialization_call_type_argument(
                    module_,
                    self_host_u32_add(type_arguments.start, argument_offset),
                  )
                  candidate_shapes.push(
                    self_host_program_specialization_argument_shape(
                      module_,
                      caller,
                      caller_shapes,
                      shapes,
                      type_,
                    ),
                  )
                  continue argument_offset + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let request = self_host_program_specialization_add_request(
                requests,
                shapes,
                target,
                candidate_shapes,
              )
              self_host_program_specialization_record_call(
                calls,
                body.body,
                caller_specialization,
                expression_index,
                target,
                request,
              )
            }
          }
        }
        Option::None => match expression.kind {
          SelfHostPlannedExpressionKind::PlannedUnresolvedCall(
            target_expression,
            arguments,
          ) => if target_expression < module_.expressions.length() {
            let target = module_.expressions[target_expression]
            let source_name = target.source_name
            let name_count = self_host_program_specialization_module_name_count(
              module_,
            )
            let unresolved_name = if self_host_u32_greater(
              name_count,
              source_name,
            ) {
              self_host_program_specialization_module_name_at(
                module_,
                source_name,
              )
            } else {
              ""
            }
            let unresolved_nominal = match target.kind {
              SelfHostPlannedExpressionKind::PlannedPoisonExpression => {
                let base_nominal = if self_host_u32_greater(
                  target_expression,
                  0u32,
                ) {
                  let base = module_.expressions[target_expression - 1u32]
                  if !self_host_u64_equal(base.nominal, 0u64) {
                    base.nominal
                  } else {
                    self_host_linked_type_nominal_declaration(
                      module_,
                      base.type_,
                    )
                  }
                } else {
                  0u64
                }
                if !self_host_u64_equal(base_nominal, 0u64) {
                  base_nominal
                } else {
                  let usage_nominal = self_host_program_specialization_let_usage_nominal(
                    lowering,
                    module_,
                    body,
                    expression_index,
                  )
                  if !self_host_u64_equal(usage_nominal, 0u64) {
                    usage_nominal
                  } else {
                    self_host_program_specialization_argument_nominal(
                      lowering,
                      module_,
                      body,
                      expression_index,
                    )
                  }
                }
              }
              _ => 0u64
            }
            let mut resolved_nominal_call = false
            if !self_host_u64_equal(unresolved_nominal, 0u64) &&
              unresolved_name.byte_length() > 0u32 {
              for candidate_module in lowering.modules {
                let mut callable_index = 0u32
                let _ = while callable_index {
                  candidate => if candidate < self_host_program_specialization_callable_count(
                    candidate_module,
                  ) {
                    let callable = self_host_program_specialization_callable_at(
                      candidate_module,
                      candidate,
                    )
                    if bytes_to_string(callable.name) == unresolved_name &&
                      self_host_u64_equal(
                        self_host_linked_resolved_nominal_declaration(
                          candidate_module,
                          callable.result_type,
                        ),
                        unresolved_nominal,
                      ) {
                      self_host_program_specialization_add_reachable(
                        reachable,
                        reachable_seen,
                        callable.declaration,
                      )
                      self_host_program_specialization_record_call(
                        calls,
                        body.body,
                        caller_specialization,
                        expression_index,
                        callable.declaration,
                        4294967295u32,
                      )
                      resolved_nominal_call = true
                      break self_host_semantic_unit()
                    }
                    continue candidate + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
                if resolved_nominal_call {
                  break self_host_semantic_unit()
                }
              }
            }
            let unresolved_array_call = !resolved_nominal_call && (
              unresolved_name == "make" || unresolved_name == "set_unchecked"
            ) && self_host_u32_greater(arguments.length, 1u32)
            let unresolved_array_capacity = !resolved_nominal_call &&
              unresolved_name == "with_capacity" && self_host_u32_greater(
                arguments.length,
                0u32,
              )
            if unresolved_array_call || unresolved_array_capacity {
              for candidate_module in lowering.modules {
                if self_host_u64_equal(candidate_module.module_id, 7204u64) {
                  let mut callable_index = 0u32
                  let _ = while callable_index {
                    candidate => if candidate < self_host_program_specialization_callable_count(
                      candidate_module,
                    ) {
                      let callable = self_host_program_specialization_callable_at(
                        candidate_module,
                        candidate,
                      )
                      if bytes_to_string(callable.name) == unresolved_name {
                        let candidate_shape = if unresolved_array_capacity {
                          if self_host_u32_greater(caller_shapes.length, 0u32) {
                            shapes[caller_shapes.start]
                          } else {
                            SelfHostPlannedValueShape::GenericPlannedValueShape
                          }
                        } else {
                          let argument_index = module_.expression_children[
                            self_host_u32_add(arguments.start, 1u32)
                          ]
                          module_.expressions[argument_index].shape
                        }
                        let request = self_host_program_specialization_add_request(
                          requests,
                          shapes,
                          callable.declaration,
                          [candidate_shape],
                        )
                        self_host_program_specialization_add_reachable(
                          reachable,
                          reachable_seen,
                          callable.declaration,
                        )
                        self_host_program_specialization_record_call(
                          calls,
                          body.body,
                          caller_specialization,
                          expression_index,
                          callable.declaration,
                          request,
                        )
                        break self_host_semantic_unit()
                      }
                      continue candidate + 1u32
                    } else {
                      break self_host_semantic_unit()
                    }
                  }
                }
              }
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_plan_program_specialization(
  lowering: SelfHostPlannedProgramLowering,
  emit_tests: Bool,
) -> SelfHostProgramSpecializationPlan {
  let reachable = []
  let reachable_seen = self_host_program_specialization_seen()
  let declaration_work = []
  let declaration_queued = self_host_program_specialization_seen()
  let requests = []
  let shapes = []
  let calls = []
  let scanned_bodies = self_host_program_specialization_seen()
  let mut module_index = 0u32
  let _ = while module_index {
    current_module => if current_module < lowering.modules.length() {
      let module_ = lowering.modules[current_module]
      for callable in module_.functions.callables {
        let implementation_method = callable.kind is SelfHostPlannedCallableKind::PlannedImplMethodCallable(_, _)
        let root = ((callable.visibility is SelfHostSemanticVisibility::Public || !callable.compiler_owned) ||
          implementation_method) && (!callable.is_test || emit_tests)
        if root {
          let _ = self_host_program_specialization_add_reachable(
            reachable,
            reachable_seen,
            callable.declaration,
          )
        }
      }
      for step in module_.initialization.steps {
        if !step.test_only || emit_tests {
          match step.kind {
            SelfHostPlannedModuleInitializationStepKind::PlannedInitializeModuleValue(_, body_id, _) => match self_host_program_specialization_body(
              module_,
              body_id,
            ) {
              Option::Some(body) => {
                self_host_program_specialization_scan_body(
                  lowering,
                  current_module,
                  body,
                  Option::None,
                  4294967295u32,
                  SelfHostHirSpan::{
                    start: 0u32
                    length: 0u32
                  },
                  reachable,
                  reachable_seen,
                  requests,
                  shapes,
                  calls,
                )
                scanned_bodies.set(body.body, true)
              }
              Option::None => {}
            }
            _ => {}
          }
        }
      }
      continue current_module + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut reachable_queue_index = 0u32
  let _ = while reachable_queue_index {
    current => if current < reachable.length() {
      let declaration = reachable[current]
      if !declaration_queued.contains_key(declaration) {
        declaration_queued.set(declaration, true)
        declaration_work.push(declaration)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut work_index = 0u32
  let _ = while work_index {
    current => if current < declaration_work.length() {
      let declaration = declaration_work[current]
      match lowering.index.declaration_owner(declaration) {
        Option::Some(owner) => {
          let module_ = lowering.modules[owner]
          match self_host_program_specialization_callable(module_, declaration) {
            Option::Some(callable) => if self_host_u32_equal(
              self_host_program_specialization_callable_generics(callable).length,
              0u32,
            ) {
              match self_host_program_specialization_callable_body(callable) {
                Option::Some(body_id) => {
                  if !scanned_bodies.contains_key(body_id) {
                    match self_host_program_specialization_body(module_, body_id) {
                      Option::Some(body) => {
                        self_host_program_specialization_scan_body(
                          lowering,
                          owner,
                          body,
                          Option::Some(callable),
                          4294967295u32,
                          SelfHostHirSpan::{
                            start: 0u32
                            length: 0u32
                          },
                          reachable,
                          reachable_seen,
                          requests,
                          shapes,
                          calls,
                        )
                        scanned_bodies.set(body_id, true)
                      }
                      Option::None => {}
                    }
                  }
                }
                Option::None => {}
              }
            }
            Option::None => {}
          }
        }
        Option::None => {}
      }
      let _ = while reachable_queue_index {
        next => if next < reachable.length() {
          let value = reachable[next]
          if !declaration_queued.contains_key(value) {
            declaration_queued.set(value, true)
            declaration_work.push(value)
          }
          continue next + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut request_index = 0u32
  let _ = while request_index {
    current => if current < requests.length() {
      let request = requests[current]
      match lowering.index.declaration_owner(request.declaration) {
        Option::Some(owner) => {
          let module_ = lowering.modules[owner]
          match self_host_program_specialization_callable(
            module_,
            request.declaration,
          ) {
            Option::Some(callable) => match self_host_program_specialization_callable_body(callable) {
              Option::Some(body_id) => match self_host_program_specialization_body(module_, body_id) {
                Option::Some(body) => self_host_program_specialization_scan_body(
                  lowering,
                  owner,
                  body,
                  Option::Some(callable),
                  current,
                  request.shapes,
                  reachable,
                  reachable_seen,
                  requests,
                  shapes,
                  calls,
                )
                Option::None => {}
              }
              Option::None => {}
            }
            Option::None => {}
          }
        }
        Option::None => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostProgramSpecializationPlan::{
    lowering: lowering
    reachable_declarations: reachable
    requests: requests
    shapes: shapes
    calls: calls
  }
}

test "StringView equality retains the selected imported trait method" {
  let link = self_host_physical_test_named_import_link(
    "app.comparison",
    b"pub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\nimpl Eq for StringView {\n  fn eq(self, right: StringView) -> Bool {\n    true\n  }\n}\n",
    b"open app.comparison\npub fn run(left: StringView, right: StringView) -> Bool {\n  left == right\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  let mut calls = 0u32
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedOperatorCall(_, SelfHostHirBinaryOperator::Equal, _, _, _) => {
        calls = calls + 1u32
      }
      _ => {}
    }
  }
  assert(calls == 1u32, "StringView equality must call its trait implementation")
}

test "reference primitive equality without an implementation is an error" {
  let link = self_host_physical_test_named_import_link(
    "app.comparison",
    b"pub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\n",
    b"open app.comparison\npub fn run(left: StringBuilder, right: StringBuilder) -> Bool {\n  left == right\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "one missing operator diagnostic")
  assert(module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::NoMatchingOperator(_, _), "missing value equality cannot become reference identity")
}

test "String literal patterns retain imported Eq and their String value type" {
  let link = self_host_physical_test_named_import_link(
    "app.comparison",
    b"pub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\nimpl Eq for String {\n  fn eq(self, right: String) -> Bool {\n    true\n  }\n}\n",
    b"open app.comparison\npub fn run(value: String) -> I32 {\n  match value {\n    \"ready\" => 1\n    _ => 0\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  let mut comparisons = 0u32
  for target in module_.inferred.operator_targets {
    match target {
      SelfHostBasicCallTarget::SelectedBasicCallTarget(_, arguments) => {
        assert(arguments.length == 0u32, "concrete String equality has no generic arguments")
        comparisons = comparisons + 1u32
      }
      _ => {}
    }
  }
  assert(comparisons == 1u32, "String literal pattern must retain its Eq target")
  let mut literals = 0u32
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedStringConst(_) => {
        assert(expression.call_target is SelfHostBasicCallTarget::SelectedBasicCallTarget(_, _), "lowering must retain the selected pattern equality")
        let mut linked = false
        match expression.call_target {
          SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => {
            for function_ in link.functions {
              if function_.declaration == declaration {
                linked = true
              }
            }
          }
          _ => {}
        }
        assert(linked, "pattern equality target must be linked")
        assert(expression.shape is SelfHostPlannedValueShape::RefPlannedValueShape, "pattern comparison must not change the literal to Bool")
        literals = literals + 1u32
      }
      _ => {}
    }
  }
  assert(literals == 1u32, "one String literal")
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, "String pattern physical plan must be valid")
  let mut recipes = 0u32
  for body in physical.bodies {
    if body.module_id == module_.module_id {
      for call in body.calls {
        if module_.expressions[call.expression].kind is SelfHostPlannedExpressionKind::PlannedStringConst(_) {
          assert(call.operands.length == 2u32, "pattern equality has a subject and literal operand")
          assert(call.evaluations.length == 1u32, "the cached subject must not be evaluated again")
          assert(body.call_evaluations[call.evaluations.start] == call.expression, "only the literal is evaluated at the pattern")
          let pattern_id = match body.call_operands[call.operands.start] {
            SelfHostPhysicalOperandSource::PatternSubjectPhysicalOperand(value) => value
            _ => {
              assert(false, "first operand must be the cached pattern subject")
              4294967295u32
            }
          }
          self_host_test_string_pattern_call_mutations(link, body, module_, pattern_id, call)
          recipes = recipes + 1u32
        }
      }
    }
  }
  assert(recipes == 1u32, "String pattern must have one physical call recipe")
}

fn self_host_test_string_pattern_call_error(
  link: SelfHostPlannedProgramWasmGCLink,
  body: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  pattern: U32,
  call: SelfHostPhysicalCallPlan,
  code: U32,
) -> Unit {
  match self_host_check_string_pattern_call(link, body, module_, pattern, call.expression, call) {
    Option::Some(failure) => assert(self_host_body_diagnostic_code(failure.context) == code, failure.context)
    Option::None => assert(false, "a one-field pattern recipe mutation must fail")
  }
}

fn self_host_test_string_pattern_call_mutations(
  link: SelfHostPlannedProgramWasmGCLink,
  body: SelfHostPlannedPhysicalBodyCarrierPlan,
  module_: SelfHostPlannedModuleLowering,
  pattern: U32,
  call: SelfHostPhysicalCallPlan,
) -> Unit {
  let missing = SelfHostPhysicalCallPlan::{
    expression: call.expression
    declaration: call.declaration
    specialization: call.specialization
    physical_function: 4294967295u32
    emits_call: call.emits_call
    evaluations: call.evaluations
    operands: call.operands
  }
  self_host_test_string_pattern_call_error(link, body, module_, pattern, missing, 607u32)
  let wrong_target = SelfHostPhysicalCallPlan::{
    expression: call.expression
    declaration: 0u64
    specialization: call.specialization
    physical_function: call.physical_function
    emits_call: call.emits_call
    evaluations: call.evaluations
    operands: call.operands
  }
  self_host_test_string_pattern_call_error(link, body, module_, pattern, wrong_target, 701u32)
  let short_recipe = SelfHostPhysicalCallPlan::{
    expression: call.expression
    declaration: call.declaration
    specialization: call.specialization
    physical_function: call.physical_function
    emits_call: call.emits_call
    evaluations: call.evaluations
    operands: SelfHostHirSpan::{
      start: call.operands.start
      length: 1u32
    }
  }
  self_host_test_string_pattern_call_error(link, body, module_, pattern, short_recipe, 703u32)

  let evaluation = body.call_evaluations[call.evaluations.start]
  body.call_evaluations[call.evaluations.start] = 4294967295u32
  self_host_test_string_pattern_call_error(link, body, module_, pattern, call, 702u32)
  body.call_evaluations[call.evaluations.start] = evaluation

  let subject = body.call_operands[call.operands.start]
  body.call_operands[call.operands.start] = SelfHostPhysicalOperandSource::PatternSubjectPhysicalOperand(4294967295u32)
  self_host_test_string_pattern_call_error(link, body, module_, pattern, call, 704u32)
  body.call_operands[call.operands.start] = subject

  let target = match self_host_linked_physical_function(link, call.physical_function) {
    Option::Some(value) => value
    Option::None => {
      assert(false, "valid pattern target must be present")
      return
    }
  }
  let fragment_module = self_host_body_fragment_module(link, target.module_index)
  let fragment = self_host_body_function_fragment(fragment_module, target.fragment_index)
  let parameter = fragment_module.function_value_types[fragment.parameters.start]
  fragment_module.function_value_types[fragment.parameters.start] = SelfHostPlannedWasmValueType::WasmI32Value
  self_host_test_string_pattern_call_error(link, body, module_, pattern, call, 705u32)
  fragment_module.function_value_types[fragment.parameters.start] = parameter

  let result = fragment_module.function_value_types[fragment.results.start]
  fragment_module.function_value_types[fragment.results.start] = SelfHostPlannedWasmValueType::WasmNullableEqRefValue
  self_host_test_string_pattern_call_error(link, body, module_, pattern, call, 709u32)
  fragment_module.function_value_types[fragment.results.start] = result

  assert(self_host_check_string_pattern_call(link, body, module_, pattern, call.expression, call) is Option::None, "restoring each mutation must restore the valid recipe")
  assert(self_host_emitted_string_pattern_target(link, body, module_, pattern, call.expression) == call.physical_function, "ABI-701 call emission must receive the unchanged physical target")
}

test "String literal patterns report a missing imported Eq implementation" {
  let link = self_host_physical_test_named_import_link(
    "app.comparison",
    b"pub trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\n",
    b"open app.comparison\npub fn run(value: String) -> I32 {\n  match value {\n    \"ready\" => 1\n    _ => 0\n  }\n}\n",
  )
  let module_ = self_host_planned_module_lowering_identity(link.fragments.specialization.lowering.modules[1u32])
  assert(module_.inferred.diagnostics.length() == 1u32, "one missing pattern equality diagnostic")
  assert(module_.inferred.diagnostics[0u32] is SelfHostBodyInferenceDiagnostic::NoMatchingOperator(_, _), "missing pattern equality cannot select an unrelated method")
}

test "String pattern without trait evidence has a missing target diagnostic" {
  let link = self_host_physical_test_named_import_link(
    "app.no_equality",
    b"pub fn unused() -> U32 {\n  0u32\n}\n",
    b"open app.no_equality\npub fn run(value: String) -> I32 {\n  match value {\n    \"ready\" => 1\n    _ => 0\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 1u32, "missing pattern target must be reported once")
  assert(physical.diagnostics[0u32].code == 607u32, "BOD-607: missing equality must not reach runtime lookup")
}

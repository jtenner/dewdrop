fn self_host_assert_callback_result_identity(source: Bytes, check_emits: Bool) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(source), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut calls = 0u32
  for body in module_.bodies {
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        if module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _) {
          calls = calls + 1u32
          assert(module_.expressions[expression].shape is SelfHostPlannedValueShape::I64PlannedValueShape,
            "callback inference proves an I64 result")
          if check_emits {
            assert(self_host_linked_expression_emits_value(link, module_, body, 4294967295u32, expression),
              "the callback name cannot erase its I64 result")
          } else {
            let shape = self_host_linked_backend_expression_shape(link, module_, body, 4294967295u32, expression)
            assert(shape is SelfHostPlannedValueShape::I64PlannedValueShape,
              "an unrelated function name cannot supply the callback result shape")
          }
        }
        continue relative + 1u32
      }
      _ => break ()
    }
  }
  assert(calls == 1u32, "one actual indirect callback must be tested")
}

test "callback result presence does not depend on a retired builder name" {
  self_host_assert_callback_result_identity(
    b"pub fn run(string_builder_append: fn(I64) -> I64) -> I64 {\n  string_builder_append(42i64)\n}\n",
    true,
  )
}

test "callback result shape does not come from a same-named global" {
  self_host_assert_callback_result_identity(
    b"pub fn misleading() -> Unit {\n  ()\n}\npub fn run(misleading: fn(I64) -> I64) -> I64 {\n  misleading(42i64)\n}\n",
    false,
  )
}

fn self_host_test_missing_callback_result(check_emits: Bool) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn run(value: fn(I64) -> I64) -> I64 {\n  value(42i64)\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[0u32]
  let source = module_.expressions[2u32]
  assert(source.kind is SelfHostPlannedExpressionKind::PlannedFunctionValueCall(_, _, _), "stable callback expression")
  assert(body.body == 5100u64 << 32u64 && body.declaration == 5100u64 << 32u64, "stable callback body")
  let initial_shape = self_host_linked_inferred_call_result_shape(link, module_, body, 4294967295u32, 2u32)
  assert(initial_shape is SelfHostPlannedValueShape::I64PlannedValueShape, "valid result before mutation")
  module_.expressions[2u32] = self_host_test_signature_expression(source, -1i32, source.kind, source.shape)
  if check_emits {
    let _ = self_host_linked_expression_emits_value(link, module_, body, 4294967295u32, 2u32)
  } else {
    let shape = self_host_linked_backend_expression_shape(link, module_, body, 4294967295u32, 2u32)
    assert(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape, "missing result stays missing")
  }
}

test "callback result inference preserves a missing type" {
  self_host_test_missing_callback_result(false)
}

test "SPC-301 callback result presence requires concrete type evidence" expect_trap "unreachable" {
  self_host_test_missing_callback_result(true)
}

fn self_host_test_unresolved_result_name(name: Bytes, mutation: U32) -> Unit {
  let source = BytesBuilder::new()
  source.append(b"struct Reader {\n  value: I64\n}\nimpl Reader {\n  fn ")
  source.append(name)
  source.append(b"(self) -> I64 {\n    self.value + 1i64\n  }\n}\npub fn run(value: Reader) -> I64 {\n  value.")
  source.append(name)
  source.append(b"()\n}\n")
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(source.finish()), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid named method before changing call form")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = false
  for body in module_.bodies {
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, arguments, _) => if target < module_.expressions.length() &&
            module_.expressions[target].source_name < self_host_linked_module_name_count(module_) &&
            self_host_linked_module_name_at(module_, module_.expressions[target].source_name).as_bytes().equals(name) {
            let original = module_.expressions[expression]
            let callee = module_.expressions[target]
            assert(original.shape is SelfHostPlannedValueShape::I64PlannedValueShape, "inference retains the I64 result")
            assert(self_host_linked_expression_emits_value(link, module_, body, 4294967295u32, expression), "valid resolved call has a value")
            // Lowering consumes the method-name node after selecting a call.
            // Restore its retained syntax metadata for the unresolved form.
            assert(callee.member_base < module_.expressions.length(), "method retains its receiver")
            module_.expressions[target] = self_host_test_signature_expression(callee, callee.type_,
              SelfHostPlannedExpressionKind::PlannedUnresolvedField(callee.member_base, callee.source_name), callee.shape)
            module_.expressions[expression] = self_host_test_signature_expression(original, original.type_,
              SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments), original.shape)
            if mutation != 0u32 {
              let unresolved = module_.expressions[expression]
              module_.expressions[expression] = self_host_test_signature_expression(unresolved, -1i32, unresolved.kind, unresolved.shape)
            }
            if mutation == 1u32 {
              let shape = self_host_linked_backend_expression_shape(link, module_, body, 4294967295u32, expression)
              assert(shape is SelfHostPlannedValueShape::ErrorPlannedValueShape, "missing unresolved result stays Error")
              return
            }
            assert(self_host_linked_expression_emits_value(link, module_, body, 4294967295u32, expression),
              "unresolved call spelling cannot erase known I64 evidence")
            checked = true
          }
          _ => {}
        }
        continue relative + 1u32
      }
      _ => break ()
    }
  }
  assert(checked, "fixture checks the unresolved method call form")
}

test "unresolved clear calls do not erase a typed result" {
  self_host_test_unresolved_result_name(b"clear", 0u32)
}

test "unresolved push calls do not erase a typed result" {
  self_host_test_unresolved_result_name(b"push", 0u32)
}

test "unresolved set_unchecked calls do not erase a typed result" {
  self_host_test_unresolved_result_name(b"set_unchecked", 0u32)
}

test "unresolved get_unchecked calls retain missing type evidence" {
  self_host_test_unresolved_result_name(b"get_unchecked", 1u32)
}

test "SPC-301 unresolved call result presence requires its type" expect_trap "unreachable" {
  self_host_test_unresolved_result_name(b"clear", 2u32)
}

fn self_host_test_method_lookup_contract(check_arity: Bool) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Reader {\n  value: I64\n}\nstruct Other {\n  value: I64\n}\nimpl Reader {\n  fn read(self) -> I64 {\n    self.value\n  }\n}\npub fn run(reader: Reader, other: Other) -> I64 {\n  let saved = other\n  reader.read()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "method lookup fixture links")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = false
  for body in module_.bodies {
    let mut wrong_receiver = 4294967295u32
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        if module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedLocalGet(1u32) {
          wrong_receiver = expression
        }
        continue relative + 1u32
      }
      _ => break ()
    }
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(_, target, _, _) => {
            let receiver = module_.expressions[target].member_base
            assert(receiver < module_.expressions.length(), "method retains receiver")
            let valid = self_host_linked_method_call_index_for_receiver_arity(link, module_, body, receiver, "read", 0u32)
            assert(valid is Option::Some(_), "exact receiver and arity resolve before mismatch")
            if check_arity {
              let absent = self_host_linked_method_call_index_for_receiver_arity(link, module_, body, receiver, "read", 1u32)
              assert(absent is Option::None, "wrong arity cannot retry without arity")
            } else {
              assert(wrong_receiver < module_.expressions.length(), "fixture has the Other receiver")
              let absent = self_host_linked_method_call_index_for_receiver(link, module_, body, wrong_receiver, "read")
              assert(absent is Option::None, "wrong receiver cannot select a global same-name method")
            }
            checked = true
          }
          _ => {}
        }
        continue relative + 1u32
      }
      _ => break ()
    }
  }
  assert(checked, "method lookup checks a real call")
}

test "method lookup keeps the wrong receiver absent" {
  self_host_test_method_lookup_contract(false)
}

test "method lookup keeps the wrong arity absent" {
  self_host_test_method_lookup_contract(true)
}

fn self_host_test_ambiguous_method_lookup(check_arity: Bool) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Reader<t> {\n  value: t\n}\nimpl<t> Reader<t> {\n  fn read(self) -> t {\n    self.value\n  }\n}\npub fn run(left: Reader<I64>, right: Reader<I32>) -> I64 {\n  right.read()\n  left.read()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "two-specialization fixture links")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  for body in module_.bodies {
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, target, _, _) => {
            let exact = self_host_linked_i32_call_index(link, body.body, 4294967295u32, expression, declaration)
            assert(exact is Option::Some(_), "valid call has an exact specialization")
            let mut candidates = 0u32
            for function_ in link.functions {
              if function_.declaration == declaration && function_.lambda == 4294967295u32 {
                candidates = candidates + 1u32
              }
            }
            assert(candidates >= 2u32, "fixture retains multiple physical specializations")
            let receiver = module_.expressions[target].member_base
            let fallback = if check_arity {
              self_host_linked_method_call_index_for_receiver_arity(link, module_, body, receiver, "read", 0u32)
            } else {
              self_host_linked_method_call_index_for_receiver(link, module_, body, receiver, "read")
            }
            assert(fallback is Option::None, "name-only lookup cannot choose the first specialization")
            checked = checked + 1u32
          }
          _ => {}
        }
        continue relative + 1u32
      }
      _ => break ()
    }
  }
  assert(checked == 2u32, "both distinct calls were checked")
}

test "method lookup does not pick the first specialization" {
  self_host_test_ambiguous_method_lookup(false)
}

test "method arity lookup does not pick the first specialization" {
  self_host_test_ambiguous_method_lookup(true)
}

test "one linked generic method is not evidence for another receiver argument" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Reader<t> {\n  value: t\n}\nimpl<t> Reader<t> {\n  fn read(self) -> t {\n    self.value\n  }\n}\npub fn run(reader: Reader<I32>, other: Reader<I64>) -> I32 {\n  let saved = other\n  reader.read()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "one-specialization fixture links")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = false
  for body in module_.bodies {
    let mut wrong_receiver = 4294967295u32
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        if module_.expressions[expression].kind is SelfHostPlannedExpressionKind::PlannedLocalGet(1u32) {
          wrong_receiver = expression
        }
        continue relative + 1u32
      }
      _ => break ()
    }
    while 0u32 {
      relative if relative < body.expressions.length => {
        let expression = body.expressions.start + relative
        match module_.expressions[expression].kind {
          SelfHostPlannedExpressionKind::PlannedDirectCall(declaration, _, _, _) => {
            let exact = self_host_linked_i32_call_index(link, body.body, 4294967295u32, expression, declaration)
            assert(exact is Option::Some(_), "real I32 call has an exact mapping")
            let mut candidates = 0u32
            for function_ in link.functions {
              if function_.declaration == declaration && function_.lambda == 4294967295u32 {
                candidates = candidates + 1u32
              }
            }
            assert(candidates == 1u32, "only the I32 specialization is linked")
            assert(wrong_receiver < module_.expressions.length(), "fixture retains the I64 receiver")
            let absent = self_host_linked_method_call_index_for_receiver_arity(link, module_, body, wrong_receiver, "read", 0u32)
            assert(absent is Option::None, "one I32 specialization cannot prove an I64 target")
            checked = true
          }
          _ => {}
        }
        continue relative + 1u32
      }
      _ => break ()
    }
  }
  assert(checked, "generic receiver mismatch was checked")
}

test "receiver primitive lookup follows long type-head chains" {
  let module_ = self_host_specialized_shape_fixture()
  let resolved = module_.resolved_types.types.length()
  module_.resolved_types.types.push(SelfHostResolvedType::PrimitiveType(SelfHostPrimitiveType::I64Type))
  let mut root = -self_host_body_u32_to_i32(resolved) - 2i32
  let expected = SelfHostPrimitiveType::I64Type.rank() + 1u32
  assert(self_host_linked_body_primitive_rank(module_, root) == expected, "direct primitive before wrappers")
  // This is a type-head walker fixture, not a source-language application.
  while 0u32 {
    depth if depth < 64u32 => {
      let next = self_host_body_u32_to_i32(module_.inferred.types.length())
      module_.inferred.types.push(SelfHostBodyTypeTerm::BodyAppliedType(root, self_host_empty_hir_span(0u32)))
      root = next
      continue depth + 1u32
    }
    _ => break ()
  }
  assert(self_host_linked_body_primitive_rank(module_, root) == expected, "the chain has no eight-step cutoff")
}

test "ARN-108 receiver primitive lookup reports a type-head cycle" expect_trap "unreachable" {
  let module_ = self_host_specialized_shape_fixture()
  assert(module_.inferred.types.length() == 1u32, "stable type-head arena")
  module_.inferred.types.push(SelfHostBodyTypeTerm::BodyResolvedType(module_.functions.callables[0u32].result_type))
  assert(self_host_linked_body_primitive_rank(module_, 1i32) == 0u32, "valid generic type-head before mutation")
  module_.inferred.types[1u32] = SelfHostBodyTypeTerm::BodyAppliedType(1i32, self_host_empty_hir_span(0u32))
  let _ = self_host_linked_body_primitive_rank(module_, 1i32)
}


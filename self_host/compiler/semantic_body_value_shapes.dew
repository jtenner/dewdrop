open dew.std.option

enum SelfHostBodyShapeTask {
  VisitBodyShapeType(I32)
  FinishBodyProductShape(U32)
}

// These helpers keep each work array on its exact source type.
// The backend uses these types as compile-time proof for Array pop carriers.
fn self_host_body_shape_tasks(root: I32) -> Array<SelfHostBodyShapeTask> {
  [SelfHostBodyShapeTask::VisitBodyShapeType(root)]
}

fn self_host_body_shape_results() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_body_shape_fields() -> Array<SelfHostPlannedValueShape> {
  []
}

fn self_host_planned_merged_body_value_shape(
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostMergedModuleInference,
  root: I32,
) -> SelfHostPlannedValueShape {
  let tasks = self_host_body_shape_tasks(root)
  let results = self_host_body_shape_results()
  let _ = while tasks.length() {
    length => if self_host_u32_greater(length, 0u32) {
      let task = match self_host_array_pop(tasks) {
        Option::Some(value) => value
        Option::None => SelfHostBodyShapeTask::VisitBodyShapeType(-1i32)
      }
      match task {
        SelfHostBodyShapeTask::VisitBodyShapeType(type_) => if type_ < -1i32 {
          results.push(
            self_host_planned_resolved_value_shape(
              resolved,
              self_host_body_i32_to_u32(-type_ - 2i32),
            ),
          )
        } else if type_ < 0i32 {
          results.push(SelfHostPlannedValueShape::ErrorPlannedValueShape)
        } else {
          let index = self_host_body_i32_to_u32(type_)
          if index >= inferred.types.length() {
            results.push(SelfHostPlannedValueShape::ErrorPlannedValueShape)
          } else {
            match inferred.types[index] {
              SelfHostBodyTypeTerm::BodyErrorType => results.push(
                SelfHostPlannedValueShape::ErrorPlannedValueShape,
              )
              SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => results.push(
                self_host_planned_resolved_value_shape(resolved, resolved_type),
              )
              SelfHostBodyTypeTerm::BodyVariableType(_) => results.push(
                SelfHostPlannedValueShape::ErrorPlannedValueShape,
              )
              SelfHostBodyTypeTerm::BodyFunctionType(_, _) => results.push(
                SelfHostPlannedValueShape::RefPlannedValueShape,
              )
              SelfHostBodyTypeTerm::BodyAppliedType(base, _) => tasks.push(
                SelfHostBodyShapeTask::VisitBodyShapeType(base),
              )
              SelfHostBodyTypeTerm::BodyProductType(fields) => {
                let start = results.length()
                tasks.push(SelfHostBodyShapeTask::FinishBodyProductShape(start))
                let mut field = fields.length
                let _ = while field {
                  current => if self_host_u32_greater(current, 0u32) {
                    let previous = current - 1u32
                    tasks.push(SelfHostBodyShapeTask::VisitBodyShapeType(
                      inferred.type_arguments[
                        self_host_u32_add(fields.start, previous)
                      ],
                    ))
                    continue previous
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
            }
          }
        }
        SelfHostBodyShapeTask::FinishBodyProductShape(start) => {
          let fields = self_host_body_shape_fields()
          let end = results.length()
          let mut index = start
          let _ = while index {
            current => if current < end {
              fields.push(results[current])
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          results.truncate(start)
          results.push(SelfHostPlannedValueShape::ProductPlannedValueShape(fields))
        }
      }
      continue tasks.length()
    } else {
      break self_host_semantic_unit()
    }
  }
  match self_host_array_pop(results) {
    Option::Some(shape) => shape
    Option::None => SelfHostPlannedValueShape::ErrorPlannedValueShape
  }
}

open dew.std.result
open dew.std.testing

test "self-host parser preserves binary precedence" {
  match self_host_parse_expression_source(b"1 + 2 * 3") {
    Ok(BinaryExpr(
      Add,
      _,
      BinaryExpr(Multiply, _, _, _),
      _,
    )) => {}
    _ => assert(false, "wrong precedence")
  }
}

test "self-host parser parses calls fields and indexes" {
  match self_host_parse_expression_source(b"values.get(1)[0].field") {
    Ok(FieldExpr(
      IndexExpr(CallExpr(_, arguments, _), _, _),
      "field",
      _,
    )) => assert(arguments.length() == 1u32, "wrong call arity")
    _ => assert(false, "postfix expression failed")
  }
}

test "self-host parser applies prefix operators after postfix calls" {
  match self_host_parse_expression_source(b"!function.name.equals(\"main\")") {
    Ok(PrefixExpr(
      LogicalNot,
      CallExpr(
        FieldExpr(_, "equals", _),
        arguments,
        _,
      ),
      _,
    )) => assert(arguments.length() == 1u32, "wrong prefixed call arity")
    _ => assert(false, "prefix bound before postfix call")
  }
}

test "self-host parser parses multiline indexes" {
  assert(
    self_host_parse_expression_source(b"values[\n  index\n]") is Ok(IndexExpr(_, _, _)),
    "multiline index failed",
  )
}

test "self-host parser parses arrays and products" {
  assert(
    self_host_parse_expression_source(b"[1, 2, 3]") is Ok(ArrayExpr(_, _)),
    "array failed",
  )
  assert(
    self_host_parse_expression_source(b"(1, true, value)") is Ok(ProductExpr(_, _)),
    "product failed",
  )
}

test "self-host parser parses if match and while" {
  assert(
    self_host_parse_expression_source(b"if ready {\n  1\n} else {\n  2\n}") is Ok(IfExpr(_, _, Some(_), _)),
    "if failed",
  )
  assert(
    self_host_parse_expression_source(b"match value {\n  Option::Some(item) => item\n  Option::None => 0\n}") is Ok(MatchExpr(_, _, _)),
    "match failed",
  )
  assert(
    self_host_parse_expression_source(b"while state {\n  value => break value\n}") is Ok(WhileExpr(_, _, _)),
    "while failed",
  )
}

test "self-host parser parses return expressions in match arms" {
  match self_host_parse_expression_source(
    b"match value {\n  Ok(item) => return None\n  Err(_) => ()\n}",
  ) {
    Ok(MatchExpr(_, arms, _)) => match arms[0u32].body {
      ReturnExpr(
        Some(NameExpr("None", _)),
        _,
      ) => {}
      _ => assert(false, "return expression failed")
    }
    _ => assert(false, "match return expression failed")
  }
}

test "self-host parser parses bare return expressions" {
  match self_host_parse_expression_source(b"return") {
    Ok(ReturnExpr(None, _)) => {}
    _ => assert(false, "bare return expression failed")
  }
}

test "self-host parser desugars if-is bindings" {
  assert(
    self_host_parse_expression_source(b"if value is Option::Some(bound) && bound > 0 {\n  bound\n} else {\n  0\n}") is Ok(MatchExpr(_, _, _)),
    "if-is desugaring failed",
  )
}

test "self-host parser desugars for expressions" {
  assert(
    self_host_parse_expression_source(b"for value in values {\n  consume(value)\n}") is Ok(BlockExpr(_)),
    "for failed",
  )
}

test "self-host parser parses lambdas" {
  assert(
    self_host_parse_expression_source(b"fn(value: I32) -> I32 {\n  value\n}") is Ok(LambdaExpr(_, _, _, _)),
    "lambda failed",
  )
}

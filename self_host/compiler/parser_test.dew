open dew.std.result
open dew.std.testing

test "self-host parser accepts the bootstrap main function" {
  assert(parse_self_host_i32_source(b"pub fn main() -> I32 {\n  73\n}\n") is Ok(73i32), "valid main failed")
}

test "self-host parser accepts comments and CRLF" {
  assert(parse_self_host_i32_source(b"pub fn main() -> I32 { // value\r\n42\r\n}") is Ok(42i32), "commented main failed")
}

test "self-host parser rejects missing public visibility" {
  assert(parse_self_host_i32_source(b"fn main() -> I32 { 1 }") is Err(_), "accepted private main")
}

test "self-host parser rejects parameters" {
  assert(parse_self_host_i32_source(b"pub fn main(x: I32) -> I32 { 1 }") is Err(_), "accepted parameters")
}

test "self-host parser rejects a different return type" {
  assert(parse_self_host_i32_source(b"pub fn main() -> U32 { 1 }") is Err(_), "accepted U32 return")
}

test "self-host parser rejects extra declarations" {
  assert(parse_self_host_i32_source(b"pub fn main() -> I32 { 1 } pub fn other() -> I32 { 2 }") is Err(_), "accepted trailing declaration")
}

test "self-host parser rejects lexical errors" {
  assert(parse_self_host_i32_source(b"pub fn main() -> I32 { 1__2 }") is Err(_), "accepted bad integer")
}

test "self-host parser rejects positive I32 overflow" {
  assert(parse_self_host_i32_source(b"pub fn main() -> I32 { 2147483648 }") is Err(_), "accepted positive overflow")
}

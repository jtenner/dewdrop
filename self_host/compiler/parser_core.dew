open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.result
open dew.std.string

pub struct SelfHostParser {
  source: Bytes
  tokens: Array<SelfHostToken>
  mut index: U32
  mut diagnostic: Option<SelfHostParseDiagnostic>
  mut pending_type_closers: U32
  mut pending_type_closer_offset: U32
  mut last_declaration_kind: U32
}

fn self_host_empty_type_frames() -> Array<SelfHostTypeParseFrame> {
  new()
}

fn self_host_empty_types() -> Array<SelfHostTypeExpr> {
  new()
}

fn self_host_empty_type_parameters() -> Array<SelfHostTypeParameter> {
  new()
}

fn self_host_no_type() -> Option<SelfHostTypeExpr> {
  None
}

fn self_host_parser_unit() -> Unit {
}

pub fn self_host_parser_new(source: Bytes) -> SelfHostParser {
  {
    source: source
    tokens: self_host_tokenize(source)
    index: 0u32
    diagnostic: None
    pending_type_closers: 0u32
    pending_type_closer_offset: 0u32
    last_declaration_kind: 4294967295u32
  }
}

fn self_host_parser_peek(parser: SelfHostParser) -> Option<SelfHostToken> {
  if parser.index < parser.tokens.length() {
    Some(parser.tokens.get_unchecked(parser.index))
  } else {
    None
  }
}

fn self_host_parser_take(parser: SelfHostParser) -> Option<SelfHostToken> {
  let token = self_host_parser_peek(parser)
  if token is Some(_) {
    parser.index = parser.index + 1u32
  } else {
  }
  token
}

fn self_host_parser_offset(parser: SelfHostParser) -> U32 {
  match self_host_parser_peek(parser) {
    Some(token) => token.offset
    None => if parser.tokens.length() == 0u32 {
      0u32
    } else {
      parser.tokens.get_unchecked(parser.tokens.length() - 1u32).offset
    }
  }
}

fn self_host_parser_error_token(parser: SelfHostParser) -> Option<SelfHostToken> {
  self_host_parser_peek(parser)
}

fn self_host_parser_token_text(parser: SelfHostParser) -> String {
  match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Keyword(_, name) => name
      Identifier(name, _) => name
      AtIdentifier(name, _, _) => name
      _ => ""
    }
    None => ""
  }
}

fn self_host_token_keyword_code(kind: SelfHostTokenKind) -> U32 {
  match kind {
    Keyword(actual, _) => actual
    _ => 4294967295u32
  }
}

fn self_host_token_symbol_code(kind: SelfHostTokenKind) -> U32 {
  match kind {
    Symbol(actual, _) => actual
    _ => 4294967295u32
  }
}

fn self_host_token_kind_is_keyword(
  kind: SelfHostTokenKind,
  expected: U32,
) -> Bool {
  self_host_token_keyword_code(kind) == expected
}

fn self_host_token_kind_is_symbol(
  kind: SelfHostTokenKind,
  expected: U32,
) -> Bool {
  self_host_token_symbol_code(kind) == expected
}

fn self_host_parser_token_code(parser: SelfHostParser) -> U32 {
  match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Keyword(code, _) => code
      Identifier(name, _) => {
        let keyword = self_host_keyword(name)
        if keyword < 33u32 {
          500u32 + keyword
        } else {
          100u32
        }
      }
      AtIdentifier(_, _, _) => 101u32
      Symbol(_, _) => 200u32
      Newline => 300u32
      _ => 400u32
    }
    None => 4294967295u32
  }
}

fn self_host_parser_fail(parser: SelfHostParser, error: SelfHostParseError) -> Unit {
  if parser.diagnostic is None {
    parser.diagnostic = Some({
      severity: Error
      error: error
    })
  } else {
  }
}

fn self_host_parser_fail_expected(
  parser: SelfHostParser,
  expectation: SelfHostDeclarationExpectation,
) -> Unit {
  self_host_parser_fail(
    parser,
    ExpectedDeclaration(
      expectation,
      self_host_parser_error_token(parser),
      self_host_parser_offset(parser),
    ),
  )
}

fn self_host_parser_consume_keyword(
  parser: SelfHostParser,
  expected: U32,
) -> Bool {
  match self_host_parser_peek(parser) {
    Some(token) => if self_host_token_identity(token).keyword_code == expected {
      parser.index = parser.index + 1u32
      true
    } else {
      false
    }
    None => false
  }
}

fn self_host_parser_at_symbol(
  parser: SelfHostParser,
  expected: U32,
) -> Bool {
  match self_host_parser_peek(parser) {
    Some(token) => self_host_source_symbol_code(
      parser.source,
      self_host_token_identity(token).offset,
    ) == expected
    None => false
  }
}

fn self_host_parser_consume_symbol(
  parser: SelfHostParser,
  expected: U32,
) -> Bool {
  match self_host_parser_peek(parser) {
    Some(token) => if self_host_source_symbol_code(
      parser.source,
      self_host_token_identity(token).offset,
    ) == expected {
      parser.index = parser.index + 1u32
      true
    } else {
      false
    }
    None => false
  }
}

fn self_host_parser_consume_newline(parser: SelfHostParser) -> Bool {
  match self_host_parser_peek(parser) {
    Some(token) => if token.kind is Newline {
      parser.index = parser.index + 1u32
      true
    } else {
      false
    }
    None => false
  }
}

fn self_host_parser_skip_newlines(parser: SelfHostParser) -> Unit {
  let _ = while 0u32 {
    _ if self_host_parser_consume_newline(parser) => continue 0u32
    _ => break self_host_parser_unit()
  }
}

fn self_host_parser_expect_keyword(
  parser: SelfHostParser,
  expected: U32,
  expectation: SelfHostDeclarationExpectation,
) -> Bool {
  if self_host_parser_consume_keyword(parser, expected) {
    true
  } else {
    self_host_parser_fail_expected(parser, expectation)
    false
  }
}

fn self_host_parser_expect_symbol(
  parser: SelfHostParser,
  expected: U32,
  expectation: SelfHostDeclarationExpectation,
) -> Bool {
  if self_host_parser_consume_symbol(parser, expected) {
    true
  } else {
    self_host_parser_fail_expected(parser, expectation)
    false
  }
}

fn self_host_parser_identifier(
  parser: SelfHostParser,
  expectation: SelfHostDeclarationExpectation,
) -> Option<(String, U32)> {
  match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Identifier(name, _) => {
        parser.index = parser.index + 1u32
        Some((name, token.offset))
      }
      Error(error) => {
        parser.index = parser.index + 1u32
        self_host_parser_fail(
          parser,
          Lexical(error, token.offset),
        )
        None
      }
      _ => {
        self_host_parser_fail_expected(parser, expectation)
        None
      }
    }
    None => {
      self_host_parser_fail_expected(parser, expectation)
      None
    }
  }
}

fn self_host_parser_finish_line(parser: SelfHostParser) -> Bool {
  if parser.index >= parser.tokens.length() || self_host_parser_consume_newline(parser) {
    true
  } else {
    self_host_parser_fail_expected(parser, LineEnd)
    false
  }
}

fn self_host_parser_expect_newline(
  parser: SelfHostParser,
  expectation: SelfHostDeclarationExpectation,
) -> Bool {
  if self_host_parser_consume_newline(parser) {
    true
  } else {
    self_host_parser_fail_expected(parser, expectation)
    false
  }
}

fn self_host_parser_consume_type_closer(parser: SelfHostParser) -> Bool {
  if parser.pending_type_closers > 0u32 {
    parser.pending_type_closers = parser.pending_type_closers - 1u32
    true
  } else {
    match self_host_parser_peek(parser) {
      Some(token) => {
        let exact_token = self_host_token_identity(token)
        let symbol_code = self_host_source_symbol_code(
          parser.source,
          exact_token.offset,
        )
        if symbol_code == 30u32 {
          parser.index = parser.index + 1u32
          true
        } else if symbol_code == 22u32 {
          parser.index = parser.index + 1u32
          parser.pending_type_closers = 1u32
          parser.pending_type_closer_offset = exact_token.offset
          true
        } else {
          false
        }
      }
      None => false
    }
  }
}

enum SelfHostTypeParseFrame {
  AppliedFrame(SelfHostTypeExpr, Array<SelfHostTypeExpr>, U32)
  ProductFrame(Array<SelfHostTypeExpr>, U32)
  FunctionParametersFrame(Array<SelfHostTypeExpr>, U32)
  FunctionResultFrame(Array<SelfHostTypeExpr>, U32)
}

fn self_host_parse_applied_type_arguments(
  parser: SelfHostParser,
  depth: U32,
  arguments: Array<SelfHostTypeExpr>,
) -> Bool {
  while 0u32 {
    _ => match self_host_parse_type_with_depth(parser, depth + 1u32) {
      Some(argument) => {
        array_push(arguments, argument)
        if self_host_parser_consume_type_closer(parser) {
          break true
        } else if self_host_parser_expect_symbol(
          parser,
          25u32,
          TypeArgumentSeparatorOrClose,
        ) {
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_type_closer(parser) {
            break true
          } else {
            continue 0u32
          }
        } else {
          break false
        }
      }
      None => break false
    }
  }
}

fn self_host_parse_type_with_depth(
  parser: SelfHostParser,
  depth: U32,
) -> Option<SelfHostTypeExpr> {
  // Keep malformed source bounded without rejecting the language's 1,024-level
  // parser and HIR stress contract.
  if depth >= 2048u32 {
    self_host_parser_fail_expected(
      parser,
      Type,
    )
    return None
  } else {
  }
  let token = match self_host_parser_peek(parser) {
    Some(value) => value
    None => {
      self_host_parser_fail_expected(
        parser,
        Type,
      )
      return None
    }
  }
  let mut current = match token.kind {
    Keyword(keyword_code, _) if keyword_code == 0u32 => {
      parser.index = parser.index + 1u32
      if !self_host_parser_expect_symbol(
        parser,
        0u32,
        LeftParen,
      ) {
        return None
      } else {
      }
      let parameters = self_host_empty_types()
      self_host_parser_skip_newlines(parser)
      if !self_host_parser_consume_symbol(parser, 1u32) {
        let parsed_parameters = while 0u32 {
          _ => match self_host_parse_type_with_depth(parser, depth + 1u32) {
            Some(parameter) => {
              array_push(parameters, parameter)
              self_host_parser_skip_newlines(parser)
              if self_host_parser_consume_symbol(parser, 1u32) {
                break true
              } else if self_host_parser_expect_symbol(
                parser,
                25u32,
                ParameterSeparatorOrClose,
              ) {
                self_host_parser_skip_newlines(parser)
                if self_host_parser_consume_symbol(parser, 1u32) {
                  break true
                } else {
                  continue 0u32
                }
              } else {
                break false
              }
            }
            None => break false
          }
        }
        if !parsed_parameters {
          return None
        } else {
        }
      } else {
      }
      if !self_host_parser_expect_symbol(
        parser,
        31u32,
        Arrow,
      ) {
        return None
      } else {
      }
      self_host_parser_skip_newlines(parser)
      match self_host_parse_type_with_depth(parser, depth + 1u32) {
        Some(result) => Some(
          FunctionType(parameters, result, token.offset),
        )
        None => return None
      }
    }
    Symbol(symbol_code, _) if symbol_code == 0u32 => {
      parser.index = parser.index + 1u32
      let fields = self_host_empty_types()
      self_host_parser_skip_newlines(parser)
      let parsed_fields = while 0u32 {
        _ => match self_host_parse_type_with_depth(parser, depth + 1u32) {
          Some(field) => {
            array_push(fields, field)
            self_host_parser_skip_newlines(parser)
            if self_host_parser_consume_symbol(parser, 1u32) {
              break true
            } else if self_host_parser_expect_symbol(
              parser,
              25u32,
              TypeArgumentSeparatorOrClose,
            ) {
              self_host_parser_skip_newlines(parser)
              if self_host_parser_consume_symbol(parser, 1u32) {
                break true
              } else {
                continue 0u32
              }
            } else {
              break false
            }
          }
          None => break false
        }
      }
      if !parsed_fields {
        return None
      } else if fields.length() < 2u32 || fields.length() > 32u32 {
        self_host_parser_fail(
          parser,
          InvalidProductTypeArity(
            fields.length(),
            token.offset,
          ),
        )
        return None
      } else {
        Some(ProductType(fields, token.offset))
      }
    }
    AtIdentifier(module_alias, _, _) => {
      parser.index = parser.index + 1u32
      if !self_host_parser_expect_symbol(
        parser,
        27u32,
        Type,
      ) {
        return None
      } else {
      }
      match self_host_parser_identifier(
        parser,
        Type,
      ) {
        Some(pair) => {
          let (name, name_offset) = pair
          Some(
            QualifiedType(
              module_alias,
              name,
              token.offset,
              name_offset,
            ),
          )
        }
        None => return None
      }
    }
    Identifier(name, _) => {
      parser.index = parser.index + 1u32
      Some(NamedType(name, token.offset))
    }
    _ => {
      self_host_parser_fail_expected(
        parser,
        Type,
      )
      return None
    }
  }
  let result = while 0u32 {
    _ => match current {
      Some(value) => {
        // A pending half of >> belongs to the surrounding type, not a selector.
        if parser.pending_type_closers > 0u32 {
          break Some(value)
        }
        let explicit = self_host_parser_consume_symbol(parser, 14u32)
        if self_host_parser_consume_symbol(parser, 29u32) {
          let arguments = self_host_empty_types()
          self_host_parser_skip_newlines(parser)
          let parsed_arguments = self_host_parse_applied_type_arguments(
            parser,
            depth,
            arguments,
          )
          if !parsed_arguments {
            break None
          } else {
            current = Some(
              AppliedType(value, arguments, value.offset()),
            )
            continue 0u32
          }
        } else {
          if explicit {
            self_host_parser_fail_expected(parser, Type)
            break None
          }
          if self_host_parser_consume_symbol(parser, 0u32) {
            self_host_parser_skip_newlines(parser)
            let selector = match self_host_parser_peek(parser) {
              Some(token) => match token.kind {
                StringLiteral(bytes) => {
                  parser.index = parser.index + 1u32
                  bytes
                }
                _ => {
                  self_host_parser_fail_expected(parser, Type)
                  return None
                }
              }
              None => {
                self_host_parser_fail_expected(parser, Type)
                return None
              }
            }
            self_host_parser_skip_newlines(parser)
            if !self_host_parser_expect_symbol(parser, 1u32, Type) {
              break None
            }
            break Some(ComputedType(value, selector, value.offset()))
          }
          break Some(value)
        }
      }
      None => break None
    }
  }
  result
}

fn self_host_parse_type(parser: SelfHostParser) -> Option<SelfHostTypeExpr> {
  self_host_parse_type_with_depth(parser, 0u32)
}

fn self_host_parse_type_bounds(
  parser: SelfHostParser,
) -> Option<Array<SelfHostTypeExpr>> {
  let bounds = self_host_empty_types()
  let result = while 0u32 {
    _ => match self_host_parse_type(parser) {
      Some(bound) => {
        bounds.push(bound)
        if self_host_parser_consume_symbol(parser, 7u32) {
          continue 0u32
        } else {
          break Some(bounds)
        }
      }
      None => break None
    }
  }
  result
}

pub fn self_host_parse_type_source(
  source: Bytes,
) -> Result<SelfHostTypeExpr, SelfHostParseError> {
  let parser = self_host_parser_new(source)
  match self_host_parse_type(parser) {
    Some(type_) => {
      self_host_parser_skip_newlines(parser)
      if parser.index != parser.tokens.length() {
        self_host_parser_fail_expected(
          parser,
          LineEnd,
        )
      } else {
      }
      match parser.diagnostic {
        Some(diagnostic) => Err(diagnostic.error)
        None => Ok(type_)
      }
    }
    None => match parser.diagnostic {
      Some(diagnostic) => Err(diagnostic.error)
      None => Err(
        ExpectedDeclaration(
          Type,
          None,
          0u32,
        ),
      )
    }
  }
}

fn self_host_parse_optional_type_parameters(
  parser: SelfHostParser,
) -> Option<Array<SelfHostTypeParameter>> {
  let output = self_host_empty_type_parameters()
  if !self_host_parser_consume_symbol(parser, 29u32) {
    return Some(output)
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      let pair = match self_host_parser_identifier(
        parser,
        TypeParameter,
      ) {
        Some(value) => value
        None => break None
      }
      let (name, offset) = pair
      let bounds = if self_host_parser_consume_symbol(
        parser,
        13u32,
      ) {
        match self_host_parse_type_bounds(parser) {
          Some(value) => value
          None => break None
        }
      } else {
        self_host_empty_types()
      }
      output.push({
        name: name
        bounds: bounds
        offset: offset
      })
      if self_host_parser_consume_type_closer(parser) {
        break Some(output)
      } else if self_host_parser_expect_symbol(
        parser,
        25u32,
        TypeParameterSeparatorOrClose,
      ) {
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_type_closer(parser) {
          break Some(output)
        } else {
          continue 0u32
        }
      } else {
        break None
      }
    }
  }
  result
}

open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.string

fn self_host_resolved_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

pub enum SelfHostPrimitiveType {
  UnitType
  BoolType
  I32Type
  U32Type
  I64Type
  U64Type
  F32Type
  F64Type
  StringType
  NeverType
  I8Type
  I16Type
  U8Type
  U16Type
  BytesType
  V128Type
  Swar32Type
  Swar64Type
  I8x4Type
  U8x4Type
  I16x2Type
  U16x2Type
  I8x8Type
  U8x8Type
  I16x4Type
  U16x4Type
  I32x2Type
  U32x2Type
  I8x16Type
  U8x16Type
  I16x8Type
  U16x8Type
  I32x4Type
  U32x4Type
  I64x2Type
  U64x2Type
  F32x4Type
  F64x2Type
  StringViewType
  StringBuilderType
  BytesBuilderType
  CompileTimeTypeType
}

impl SelfHostPrimitiveType {
  fn rank(self) -> U32 {
    match self {
      UnitType => 0u32
      BoolType => 1u32
      I32Type => 2u32
      U32Type => 3u32
      I64Type => 4u32
      U64Type => 5u32
      F32Type => 6u32
      F64Type => 7u32
      StringType => 8u32
      NeverType => 9u32
      I8Type => 10u32
      I16Type => 11u32
      U8Type => 12u32
      U16Type => 13u32
      BytesType => 14u32
      V128Type => 15u32
      Swar32Type => 16u32
      Swar64Type => 17u32
      I8x4Type => 18u32
      U8x4Type => 19u32
      I16x2Type => 20u32
      U16x2Type => 21u32
      I8x8Type => 22u32
      U8x8Type => 23u32
      I16x4Type => 24u32
      U16x4Type => 25u32
      I32x2Type => 26u32
      U32x2Type => 27u32
      I8x16Type => 28u32
      U8x16Type => 29u32
      I16x8Type => 30u32
      U16x8Type => 31u32
      I32x4Type => 32u32
      U32x4Type => 33u32
      I64x2Type => 34u32
      U64x2Type => 35u32
      F32x4Type => 36u32
      F64x2Type => 37u32
      StringViewType => 38u32
      StringBuilderType => 39u32
      BytesBuilderType => 40u32
      CompileTimeTypeType => 41u32
    }
  }
}

fn self_host_primitive_type_from_name(
  name: String,
) -> Option<SelfHostPrimitiveType> {
  match name {
    "Unit" => Some(UnitType)
    "Bool" => Some(BoolType)
    "I32" => Some(I32Type)
    "U32" => Some(U32Type)
    "I64" => Some(I64Type)
    "U64" => Some(U64Type)
    "F32" => Some(F32Type)
    "F64" => Some(F64Type)
    "String" => Some(StringType)
    "Never" => Some(NeverType)
    "I8" => Some(I8Type)
    "I16" => Some(I16Type)
    "U8" => Some(U8Type)
    "U16" => Some(U16Type)
    "Bytes" => Some(BytesType)
    "V128" => Some(V128Type)
    "Swar32" => Some(Swar32Type)
    "Swar64" => Some(Swar64Type)
    "I8x4" => Some(I8x4Type)
    "U8x4" => Some(U8x4Type)
    "I16x2" => Some(I16x2Type)
    "U16x2" => Some(U16x2Type)
    "I8x8" => Some(I8x8Type)
    "U8x8" => Some(U8x8Type)
    "I16x4" => Some(I16x4Type)
    "U16x4" => Some(U16x4Type)
    "I32x2" => Some(I32x2Type)
    "U32x2" => Some(U32x2Type)
    "I8x16" => Some(I8x16Type)
    "U8x16" => Some(U8x16Type)
    "I16x8" => Some(I16x8Type)
    "U16x8" => Some(U16x8Type)
    "I32x4" => Some(I32x4Type)
    "U32x4" => Some(U32x4Type)
    "I64x2" => Some(I64x2Type)
    "U64x2" => Some(U64x2Type)
    "F32x4" => Some(F32x4Type)
    "F64x2" => Some(F64x2Type)
    "StringView" => Some(StringViewType)
    "StringBuilder" => Some(StringBuilderType)
    "BytesBuilder" => Some(BytesBuilderType)
    "Type" => Some(CompileTimeTypeType)
    _ => None
  }
}

pub enum SelfHostResolvedType {
  ErrorType
  PrimitiveType(SelfHostPrimitiveType)
  GenericParameterType(U64)
  NominalType(U64)
  TraitType(U64)
  SelfType(U64)
  ProductType(SelfHostHirSpan)
  AppliedType(U32, SelfHostHirSpan)
  FunctionType(SelfHostHirSpan, U32)
  MemberTypeProjection(U32, Bytes, String)
}

pub enum SelfHostTypeDiagnostic {
  ReservedTypeName(U64, U32, U32)
  UnknownType(U32, U64, U32)
  UnknownTrait(U32, U64, U32)
  AmbiguousImportedType(U32, U64, U32)
  AmbiguousImportedTrait(U32, U64, U32)
  ExpectedTraitType(U32, U64, U32)
  TypeArityMismatch(U32, U32, U32, U64, U32)
  TypeNotApplicable(U32, U64, U32)
  SelfOutsideContext(U64, U32)
  AliasCycle(SelfHostHirSpan, U32)
  AliasExpansionLimit(U64, U32, U32)
  ComputedTypeFailure(U64, String, U32)
}

impl SelfHostTypeDiagnostic {
  fn offset(self) -> U32 {
    match self {
      ReservedTypeName(_, _, offset) => offset
      UnknownType(_, _, offset) => offset
      UnknownTrait(_, _, offset) => offset
      AmbiguousImportedType(_, _, offset) => offset
      AmbiguousImportedTrait(_, _, offset) => offset
      ExpectedTraitType(_, _, offset) => offset
      TypeArityMismatch(_, _, _, _, offset) => offset
      TypeNotApplicable(_, _, offset) => offset
      SelfOutsideContext(_, offset) => offset
      AliasCycle(_, offset) => offset
      AliasExpansionLimit(_, _, offset) => offset
      ComputedTypeFailure(_, _, offset) => offset
    }
  }

  fn rank(self) -> U32 {
    match self {
      ReservedTypeName(_, _, _) => 0u32
      UnknownType(_, _, _) => 1u32
      UnknownTrait(_, _, _) => 2u32
      AmbiguousImportedType(_, _, _) => 3u32
      AmbiguousImportedTrait(_, _, _) => 4u32
      ExpectedTraitType(_, _, _) => 5u32
      TypeArityMismatch(_, _, _, _, _) => 6u32
      TypeNotApplicable(_, _, _) => 7u32
      SelfOutsideContext(_, _) => 8u32
      AliasCycle(_, _) => 9u32
      AliasExpansionLimit(_, _, _) => 10u32
      ComputedTypeFailure(_, _, _) => 11u32
    }
  }
}

pub struct SelfHostResolvedModuleTypes {
  module_id: U64
  types: Array<SelfHostResolvedType>
  type_arguments: Array<U32>
  syntax_types: Array<U32>
  declaration_types: Array<U32>
  generic_parameter_types: Array<U32>
  generic_bound_types: Array<U32>
  parameter_types: Array<U32>
  callable_return_types: Array<U32>
  callable_function_types: Array<U32>
  lambda_parameter_types: Array<U32>
  lambda_return_types: Array<U32>
  lambda_function_types: Array<U32>
  explicit_call_type_arguments: Array<U32>
  field_types: Array<U32>
  variant_payloads: Array<SelfHostHirSpan>
  signature_type_lists: Array<U32>
  alias_target_types: Array<U32>
  impl_trait_types: Array<Option<U32>>
  impl_target_types: Array<U32>
  alias_dependencies: Array<SelfHostHirSpan>
  alias_dependency_declarations: Array<U64>
  alias_is_cyclic: Array<Bool>
  alias_cycles: Array<SelfHostHirSpan>
  alias_cycle_declarations: Array<U64>
  alias_expansion_work: U32
  alias_expansion_limit: U32
  diagnostics: Array<SelfHostTypeDiagnostic>
  error_type: U32
  primitive_types: Array<U32>
}

impl SelfHostResolvedModuleTypes {
  fn diagnostic_count(self) -> U32 {
    self.diagnostics.length()
  }

  fn parameter_type(self, index: U32) -> U32 {
    self.parameter_types[index]
  }

  fn type_at(self, index: U32) -> SelfHostResolvedType {
    self.types[index]
  }

  fn primitive(self, primitive: SelfHostPrimitiveType) -> U32 {
    self.primitive_types[primitive.rank()]
  }

  fn declaration_type(self, declaration: U64) -> U32 {
    if self_host_semantic_id_module(declaration) != self.module_id {
      self.error_type
    } else {
      let local = self_host_semantic_id_local(declaration)
      if local >= self.declaration_types.length() {
        self.error_type
      } else {
        self.declaration_types[local]
      }
    }
  }

  fn syntax_type(self, syntax: U32) -> U32 {
    self.syntax_types[syntax]
  }
}

fn self_host_resolved_module_types_identity(
  value: SelfHostResolvedModuleTypes,
) -> SelfHostResolvedModuleTypes {
  value
}

fn self_host_empty_type_buckets() -> Map<U64, U32> {
  empty()
}

struct SelfHostResolvedTypeInterner {
  types: Array<SelfHostResolvedType>
  arguments: Array<U32>
  buckets: Map<U64, U32>
  next: Array<U32>
  hashes: Array<U64>
  primitive_types: Array<U32>
  mut error_type: U32
}

fn self_host_type_hash_mix(hash: U64, value: U64) -> U64 {
  (hash ^ value) * 1099511628211u64
}

impl SelfHostResolvedTypeInterner {
  fn new() -> SelfHostResolvedTypeInterner {
    let interner = {
      types: []
      arguments: []
      buckets: self_host_empty_type_buckets()
      next: []
      hashes: []
      primitive_types: []
      error_type: 0u32
    }
    let error_type = interner.intern_simple(
      ErrorType,
      1u64,
    )
    if !self_host_u32_equal(error_type, 0u32) {
      unreachable()
    }
    let primitives = [
      UnitType,
      BoolType,
      I32Type,
      U32Type,
      I64Type,
      U64Type,
      F32Type,
      F64Type,
      StringType,
      NeverType,
      I8Type,
      I16Type,
      U8Type,
      U16Type,
      BytesType,
      V128Type,
      Swar32Type,
      Swar64Type,
      I8x4Type,
      U8x4Type,
      I16x2Type,
      U16x2Type,
      I8x8Type,
      U8x8Type,
      I16x4Type,
      U16x4Type,
      I32x2Type,
      U32x2Type,
      I8x16Type,
      U8x16Type,
      I16x8Type,
      U16x8Type,
      I32x4Type,
      U32x4Type,
      I64x2Type,
      U64x2Type,
      F32x4Type,
      F64x2Type,
      StringViewType,
      StringBuilderType,
      BytesBuilderType,
      CompileTimeTypeType,
    ]
    for primitive in primitives {
      interner.primitive_types.push(
        interner.intern_simple(
          PrimitiveType(primitive),
          self_host_type_hash_mix(2u64, u32_into_u64(primitive.rank())),
        ),
      )
    }
    interner
  }

  fn insert(
    self,
    type_: SelfHostResolvedType,
    hash: U64,
  ) -> U32 {
    let id = self.types.length()
    let previous = match self.buckets.get(hash) {
      Some(value) => value
      None => 4294967295u32
    }
    self.types.push(type_)
    self.hashes.push(hash)
    self.next.push(previous)
    self.buckets.set(hash, id)
    id
  }

  fn simple_equal(
    self,
    left: SelfHostResolvedType,
    right: SelfHostResolvedType,
  ) -> Bool {
    match left {
      ErrorType => right is ErrorType
      PrimitiveType(value) => match right {
        PrimitiveType(other) => value.rank() == other.rank()
        _ => false
      }
      GenericParameterType(value) => match right {
        GenericParameterType(other) => value == other
        _ => false
      }
      NominalType(value) => match right {
        NominalType(other) => value == other
        _ => false
      }
      TraitType(value) => match right {
        TraitType(other) => value == other
        _ => false
      }
      SelfType(value) => match right {
        SelfType(other) => value == other
        _ => false
      }
      MemberTypeProjection(owner, operation, selector) => match right {
        MemberTypeProjection(other, other_operation, other_selector) => owner == other && operation == other_operation && selector == other_selector
        _ => false
      }
      _ => false
    }
  }

  fn intern_simple(
    self,
    type_: SelfHostResolvedType,
    hash: U64,
  ) -> U32 {
    let mut candidate = match self.buckets.get(hash) {
      Some(value) => value
      None => 4294967295u32
    }
    while candidate {
      current => if current != 4294967295u32 {
        if self.simple_equal(self.types[current], type_) {
          break current
        }
        continue self.next[current]
      } else {
        break self.insert(type_, hash)
      }
    }
  }

  fn intern_primitive(self, primitive: SelfHostPrimitiveType) -> U32 {
    self.primitive_types[primitive.rank()]
  }

  fn intern_generic(self, parameter: U64) -> U32 {
    self.intern_simple(
      GenericParameterType(parameter),
      self_host_type_hash_mix(3u64, parameter),
    )
  }

  fn intern_nominal(self, declaration: U64) -> U32 {
    self.intern_simple(
      NominalType(declaration),
      self_host_type_hash_mix(4u64, declaration),
    )
  }

  fn intern_trait(self, declaration: U64) -> U32 {
    self.intern_simple(
      TraitType(declaration),
      self_host_type_hash_mix(5u64, declaration),
    )
  }

  fn intern_self(self, declaration: U64) -> U32 {
    self.intern_simple(
      SelfType(declaration),
      self_host_type_hash_mix(6u64, declaration),
    )
  }

  fn span_matches(
    self,
    span: SelfHostHirSpan,
    values: Array<U32>,
  ) -> Bool {
    if span.length != values.length() {
      false
    } else {
      let mut equal = true
      let _ = while 0u32 {
        index => if index < span.length {
          if self.arguments[span.start + index] != values[index] {
            equal = false
          }
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      equal
    }
  }

  fn intern_product(self, fields: Array<U32>) -> U32 {
    let mut hash = 7u64
    let field_count = fields.length()
    let _ = while 0u32 {
      field_index => if field_index < field_count {
        let field = self_host_resolved_u32_at(fields, field_index)
        hash = self_host_type_hash_mix(hash, self.hashes[field])
        continue field_index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    hash = self_host_type_hash_mix(hash, u32_into_u64(field_count))
    let mut candidate = match self.buckets.get(hash) {
      Some(value) => value
      None => 4294967295u32
    }
    while candidate {
      current => if current != 4294967295u32 {
        match self.types[current] {
          ProductType(span) => if self.span_matches(span, fields) {
            break current
          }
          _ => {}
        }
        continue self.next[current]
      } else {
        let start = self.arguments.length()
        let _ = while 0u32 {
          field_index => if field_index < field_count {
            self.arguments.push(
              self_host_resolved_u32_at(fields, field_index),
            )
            continue field_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        break self.insert(
          ProductType({
            start: start
            length: fields.length()
          }),
          hash,
        )
      }
    }
  }

  fn intern_applied(
    self,
    base: U32,
    arguments: Array<U32>,
  ) -> U32 {
    let mut hash = self_host_type_hash_mix(8u64, self.hashes[base])
    let argument_count = arguments.length()
    let _ = while 0u32 {
      argument_index => if argument_index < argument_count {
        let argument = self_host_resolved_u32_at(
          arguments,
          argument_index,
        )
        hash = self_host_type_hash_mix(hash, self.hashes[argument])
        continue argument_index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    hash = self_host_type_hash_mix(hash, u32_into_u64(argument_count))
    let mut candidate = match self.buckets.get(hash) {
      Some(value) => value
      None => 4294967295u32
    }
    while candidate {
      current => if current != 4294967295u32 {
        match self.types[current] {
          AppliedType(other_base, span) => if other_base == base && self.span_matches(span, arguments) {
            break current
          }
          _ => {}
        }
        continue self.next[current]
      } else {
        let start = self.arguments.length()
        let _ = while 0u32 {
          argument_index => if argument_index < argument_count {
            self.arguments.push(
              self_host_resolved_u32_at(arguments, argument_index),
            )
            continue argument_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        break self.insert(
          AppliedType(
            base,
            {
              start: start
              length: arguments.length()
            },
          ),
          hash,
        )
      }
    }
  }

  fn intern_function(
    self,
    parameters: Array<U32>,
    result: U32,
  ) -> U32 {
    let mut hash = self_host_type_hash_mix(9u64, self.hashes[result])
    let parameter_count = parameters.length()
    let _ = while 0u32 {
      parameter_index => if parameter_index < parameter_count {
        let parameter = self_host_resolved_u32_at(
          parameters,
          parameter_index,
        )
        hash = self_host_type_hash_mix(hash, self.hashes[parameter])
        continue parameter_index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    hash = self_host_type_hash_mix(hash, u32_into_u64(parameter_count))
    let mut candidate = match self.buckets.get(hash) {
      Some(value) => value
      None => 4294967295u32
    }
    while candidate {
      current => if current != 4294967295u32 {
        match self.types[current] {
          FunctionType(span, other_result) => if other_result == result && self.span_matches(span, parameters) {
            break current
          }
          _ => {}
        }
        continue self.next[current]
      } else {
        let start = self.arguments.length()
        let _ = while 0u32 {
          parameter_index => if parameter_index < parameter_count {
            self.arguments.push(
              self_host_resolved_u32_at(parameters, parameter_index),
            )
            continue parameter_index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        break self.insert(
          FunctionType(
            {
              start: start
              length: parameters.length()
            },
            result,
          ),
          hash,
        )
      }
    }
  }
}

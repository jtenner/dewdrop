open dew.std.bytes
open dew.std.option
open dew.std.string

pub enum SelfHostPlannedCallableKind {
  PlannedBuiltinCallable(Bytes)
  PlannedForeignCallable(Bytes, Bytes, Bool)
  PlannedFunctionCallable(U64)
  PlannedTraitMethodCallable(U64)
  PlannedImplMethodCallable(U64, Option<U64>)
}

pub struct SelfHostPlannedParameter {
  parameter: U64
  declaration: U64
  index: U32
  receiver: Bool
  type_: U32
  shape: SelfHostPlannedValueShape
  offset: U32
}

pub struct SelfHostPlannedCallable {
  declaration: U64
  name: Bytes
  visibility: SelfHostSemanticVisibility
  compiler_owned: Bool
  is_main: Bool
  main_code: U32
  is_test: Bool
  is_test_entry: Bool
  test_name: Bytes
  kind: SelfHostPlannedCallableKind
  owner_generic_parameters: SelfHostHirSpan
  generic_parameters: SelfHostHirSpan
  parameters: SelfHostHirSpan
  has_receiver: Bool
  self_type: U32
  self_shape: SelfHostPlannedValueShape
  result_type: U32
  result_shape: SelfHostPlannedValueShape
  offset: U32
}

fn self_host_planned_parameter_identity(
  value: SelfHostPlannedParameter,
) -> SelfHostPlannedParameter {
  value
}

fn self_host_planned_callable_identity(
  value: SelfHostPlannedCallable,
) -> SelfHostPlannedCallable {
  value
}

pub struct SelfHostPlannedModuleFunctions {
  module_id: U64
  callables: Array<SelfHostPlannedCallable>
  callable_by_declaration: Array<U32>
  parameters: Array<SelfHostPlannedParameter>
}

fn self_host_planned_module_functions_identity(
  value: SelfHostPlannedModuleFunctions,
) -> SelfHostPlannedModuleFunctions {
  {
    module_id: value.module_id
    callables: value.callables
    callable_by_declaration: value.callable_by_declaration
    parameters: value.parameters
  }
}

fn self_host_function_plan_slots(length: U32) -> Array<U32> {
  let slots = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      slots.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  slots
}

fn self_host_function_plan_body(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Option<U64> {
  let limit = array_length(collected.bodies)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let body = array_get_unchecked(collected.bodies, current)
      if self_host_u64_equal(body.declaration, declaration) {
        return Some(body.id)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  None
}

fn self_host_function_plan_builtin(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Bytes {
  let limit = array_length(collected.builtins)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let value = array_get_unchecked(collected.builtins, current)
      if self_host_u64_equal(value.declaration, declaration) {
        return value.builtin_name
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  b""
}

fn self_host_function_plan_test_name(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Bytes {
  let limit = array_length(collected.tests)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let value = array_get_unchecked(collected.tests, current)
      if self_host_u64_equal(value.declaration, declaration) {
        return value.display_name
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  b""
}

fn self_host_function_plan_is_test_entry(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> Bool {
  let limit = array_length(collected.tests)
  let mut index = 0u32
  while index {
    current => if current < limit {
      let value = array_get_unchecked(collected.tests, current)
      if self_host_u64_equal(value.declaration, declaration) {
        return true
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_function_plan_impl_target(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  declaration: U64,
) -> U32 {
  let mut index = 0u32
  while index {
    current => if current < collected.impls.length() {
      if self_host_u64_equal(collected.impls[current].declaration, declaration) {
        break resolved.impl_target_types[current]
      }
      continue current + 1u32
    } else {
      break resolved.error_type
    }
  }
}

fn self_host_function_plan_foreign_identity(
  collected: SelfHostCollectedModule,
  declaration: U64,
) -> (Bytes, Bytes, Bool) {
  let function_limit = array_length(collected.foreign_functions)
  let mut function_index = 0u32
  while function_index {
    current_function => if current_function < function_limit {
      let function_ = array_get_unchecked(
        collected.foreign_functions,
        current_function,
      )
      if self_host_u64_equal(function_.declaration, declaration) {
        let library_limit = array_length(collected.foreign_libraries)
        let mut library_index = 0u32
        while library_index {
          current_library => if current_library < library_limit {
            let library = array_get_unchecked(
              collected.foreign_libraries,
              current_library,
            )
            if self_host_u64_equal(library.declaration, function_.library) {
              return (library.logical_name, function_.export_name, library.host_import)
            }
            continue current_library + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      continue current_function + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  (b"", b"", false)
}

fn self_host_function_plan_representation_type(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
  self_owner: U64,
  self_type: U32,
) -> U32 {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      SelfType(owner) => if self_host_u64_equal(
        owner,
        self_owner,
      ) && !self_host_u32_equal(self_type, resolved.error_type) {
        break self_type
      } else {
        break type_
      }
      AppliedType(base, _) => continue base
      _ => break type_
    }
  }
}

pub struct SelfHostPlannedParameterSummary {
  span: SelfHostHirSpan
  has_receiver: Bool
  receiver_type: U32
}

fn self_host_plan_callable_parameters(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  parameters: Array<SelfHostPlannedParameter>,
  declaration: U64,
  owner: U64,
  self_type: U32,
) -> SelfHostPlannedParameterSummary {
  let exact_collected = self_host_collected_module_identity(collected)
  let exact_resolved = self_host_resolved_module_types_identity(resolved)
  let source_parameters = exact_collected.parameters_of(declaration)
  let parameter_start = parameters.length()
  let mut has_receiver = false
  let mut receiver_type = exact_resolved.error_type
  let mut parameter = 0u32
  let _ = while parameter {
    index => if index < source_parameters.length {
      let source_index = self_host_u32_add(source_parameters.start, index)
      let source = self_host_collected_parameter_identity(
        exact_collected.parameters[source_index],
      )
      let type_ = exact_resolved.parameter_types[source_index]
      let representation = self_host_function_plan_representation_type(
        exact_resolved,
        type_,
        owner,
        self_type,
      )
      let shape = self_host_planned_resolved_value_shape(
        exact_resolved,
        representation,
      )
      let receiver = source.kind is ReceiverParameterDecl
      if receiver {
        has_receiver = true
        receiver_type = representation
      }
      parameters.push({
        parameter: source.id
        declaration: declaration
        index: source.index
        receiver: receiver
        type_: type_
        shape: shape
        offset: source.offset
      })
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    span: {
      start: parameter_start
      length: parameters.length() - parameter_start
    }
    has_receiver: has_receiver
    receiver_type: receiver_type
  }
}

fn self_host_push_planned_callable(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  callables: Array<SelfHostPlannedCallable>,
  callable_by_declaration: Array<U32>,
  callable_index: U32,
  declaration: U64,
  name: String,
  visibility: SelfHostSemanticVisibility,
  kind: SelfHostPlannedCallableKind,
  owner_generics: SelfHostHirSpan,
  self_type: U32,
  parameter_summary: SelfHostPlannedParameterSummary,
  result_type: U32,
  result_shape: SelfHostPlannedValueShape,
  offset: U32,
) -> Unit {
  let exact_collected = self_host_collected_module_identity(collected)
  let source_callable = self_host_collected_callable_identity(
    exact_collected.callables[callable_index],
  )
  let self_shape = if parameter_summary.has_receiver {
    self_host_planned_resolved_value_shape(
      resolved,
      parameter_summary.receiver_type,
    )
  } else {
    ErrorPlannedValueShape
  }
  let compiler_owned = self_host_semantic_id_module(declaration) >= 4294901760u64
  let main_code = self_host_name_main_code(name)
  let is_main = source_callable.is_main || main_code == 1296124238u32
  let is_test_entry = self_host_function_plan_is_test_entry(
    exact_collected,
    declaration,
  )
  let planned_visibility = if compiler_owned {
    ModuleVisible
  } else {
    visibility
  }
  callable_by_declaration[self_host_semantic_id_local(declaration)] = callables.length()
  callables.push({
    declaration: declaration
    name: name.as_bytes()
    visibility: planned_visibility
    compiler_owned: compiler_owned
    is_main: is_main
    main_code: main_code
    is_test: exact_collected.declaration_is_test_only(declaration) || is_test_entry
    is_test_entry: is_test_entry
    test_name: self_host_function_plan_test_name(exact_collected, declaration)
    kind: kind
    owner_generic_parameters: owner_generics
    generic_parameters: exact_collected.generic_parameters_of(declaration)
    parameters: parameter_summary.span
    has_receiver: parameter_summary.has_receiver
    self_type: self_type
    self_shape: self_shape
    result_type: result_type
    result_shape: result_shape
    offset: offset
  })
}

fn self_host_append_planned_callable(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  callables: Array<SelfHostPlannedCallable>,
  parameters: Array<SelfHostPlannedParameter>,
  callable_by_declaration: Array<U32>,
  callable_index: U32,
  declaration: U64,
  name: String,
  visibility: SelfHostSemanticVisibility,
  kind: SelfHostPlannedCallableKind,
  owner: U64,
  owner_generics: SelfHostHirSpan,
  self_type: U32,
  offset: U32,
) -> Unit {
  let parameter_summary = self_host_plan_callable_parameters(
    collected,
    resolved,
    parameters,
    declaration,
    owner,
    self_type,
  )
  let result_type = resolved.callable_return_types[callable_index]
  let result_representation = self_host_function_plan_representation_type(
    resolved,
    result_type,
    owner,
    self_type,
  )
  let result_shape = self_host_planned_resolved_value_shape(
    resolved,
    result_representation,
  )
  self_host_push_planned_callable(
    collected,
    resolved,
    callables,
    callable_by_declaration,
    callable_index,
    declaration,
    name,
    visibility,
    kind,
    owner_generics,
    self_type,
    parameter_summary,
    result_type,
    result_shape,
    offset,
  )
}

fn self_host_plan_top_level_callable(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  callables: Array<SelfHostPlannedCallable>,
  parameters: Array<SelfHostPlannedParameter>,
  lookup: Array<U32>,
  callable_index: U32,
  declaration: U64,
) -> Bool {
  let mut declaration_index = 0u32
  let _ = while declaration_index {
    current => if current < collected.declarations.length() {
      let value = self_host_collected_declaration_identity(
        collected.declarations[current],
      )
      if self_host_u64_equal(value.id, declaration) {
      let kind = if value.kind is BuiltinDecl {
        PlannedBuiltinCallable(
          self_host_function_plan_builtin(collected, declaration),
        )
      } else {
        PlannedFunctionCallable(
          match self_host_function_plan_body(collected, declaration) {
            Some(body) => body
            None => 0u64
          },
        )
      }
      let owner_generics = {
        start: 0u32
        length: 0u32
      }
      self_host_append_planned_callable(
        collected, resolved, callables, parameters, lookup, callable_index,
        declaration, collected.name(value.name), value.visibility, kind,
        declaration, owner_generics, resolved.error_type, value.offset,
      )
        return true
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_plan_method_callable(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  callables: Array<SelfHostPlannedCallable>,
  parameters: Array<SelfHostPlannedParameter>,
  lookup: Array<U32>,
  callable_index: U32,
  declaration: U64,
) -> Bool {
  let mut method_index = 0u32
  let _ = while method_index {
    current => if current < collected.methods.length() {
      let value = self_host_collected_method_identity(collected.methods[current])
      if self_host_u64_equal(value.id, declaration) {
      let owner_generics = collected.generic_parameters_of(value.parent)
      match value.kind {
        ForeignLibraryMemberDecl => {
          let (library, export_name, host_import) = self_host_function_plan_foreign_identity(
            collected,
            declaration,
          )
          self_host_append_planned_callable(
            collected, resolved, callables, parameters, lookup, callable_index,
            declaration, collected.name(value.name), value.visibility,
            PlannedForeignCallable(
              library,
              export_name,
              host_import,
            ),
            value.parent, owner_generics, resolved.error_type, value.offset,
          )
        }
        TraitMethodDecl => {
          self_host_append_planned_callable(
            collected, resolved, callables, parameters, lookup, callable_index,
            declaration, collected.name(value.name), value.visibility,
            PlannedTraitMethodCallable(value.parent),
            value.parent, owner_generics, resolved.error_type, value.offset,
          )
        }
        ImplMethodDecl => {
          let target = self_host_function_plan_impl_target(
            collected,
            resolved,
            value.parent,
          )
          self_host_append_planned_callable(
            collected, resolved, callables, parameters, lookup, callable_index,
            declaration, collected.name(value.name), value.visibility,
            PlannedImplMethodCallable(
              value.parent,
              self_host_function_plan_body(collected, declaration),
            ),
            value.parent, owner_generics, target, value.offset,
          )
        }
      }
        return true
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  false
}

fn self_host_plan_module_functions(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
) -> SelfHostPlannedModuleFunctions {
  let callables = []
  let parameters = []
  let lookup = self_host_function_plan_slots(
    collected.declaration_locations.length(),
  )
  let mut index = 0u32
  let _ = while index {
    current => if current < collected.callables.length() {
      let declaration = collected.callables[current].declaration
      let top_level = self_host_plan_top_level_callable(
        collected, resolved, callables, parameters, lookup, current, declaration,
      )
      if !top_level {
        let _ = self_host_plan_method_callable(
          collected, resolved, callables, parameters, lookup, current, declaration,
        )
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    module_id: collected.module_id
    callables: callables
    callable_by_declaration: lookup
    parameters: parameters
  }
}

open dew.std.bytes_builder
open dew.std.text_runtime

fn f32_long_range_source(prefix: Bytes, suffix: Bytes, length: U32, side: I32) -> Bytes {
  let builder = BytesBuilder::with_capacity(length + 256u32)
  builder.append(prefix)
  while 0u32 {
    index if index < length => {
      builder.append_byte(if side < 0i32 {
        57u8
      } else {
        48u8
      })
      continue index + 1u32
    }
    _ => break self_host_tokenizer_unit()
  }
  if side > 0i32 {
    builder.append_byte(49u8)
  }
  builder.append(suffix)
  builder.finish()
}

test "self-host f32 long decimal range midpoint neighbors" {
  let cases = [
    (b"7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015624", b"7.00649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625", b"e-46f32", 0u32),
    (b"2.101947696487225606385594374934874196920392912814773657635602425834686624028790902229957282543182373046874", b"2.101947696487225606385594374934874196920392912814773657635602425834686624028790902229957282543182373046875", b"e-45f32", 1u32),
    (b"3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078124", b"3.503246160812042677309323958224790328200654854691289429392670709724477706714651503716595470905303955078125", b"e-45f32", 2u32),
    (b"1.1754941406275178592461758986628081843312458647327962400313859427181746759860647699724722770042717456817626953124", b"1.1754941406275178592461758986628081843312458647327962400313859427181746759860647699724722770042717456817626953125", b"e-38f32", 8388606u32),
    (b"1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984374", b"1.1754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984375", b"e-38f32", 8388607u32),
    (b"1.1754944208872107242095900834087248423144721207851846153345402941318314539442813071445925743319094181060791015624", b"1.1754944208872107242095900834087248423144721207851846153345402941318314539442813071445925743319094181060791015625", b"e-38f32", 8388608u32),
    (b"1.000000059604644775390624", b"1.000000059604644775390625", b"e0f32", 1065353216u32),
    (b"3.40282336497324057985868971510891282431", b"3.40282336497324057985868971510891282432", b"e38f32", 2139095038u32),
    (b"3.40282356779733661637539395458142568447", b"3.40282356779733661637539395458142568448", b"e38f32", 2139095039u32),
  ]
  for (below, midpoint, suffix, lower) in cases {
    for length in [1024u32, 65536u32] {
      for side in [-1i32, 0i32, 1i32] {
        let source = f32_long_range_source(if side < 0i32 {
          below
        } else {
          midpoint
        }, suffix, length, side)
        let expected = lower + if side > 0i32 || (side == 0i32 && (lower & 1u32) != 0u32) {
          1u32
        } else {
          0u32
        }
        assert_self_host_f32_decimal(source, expected)
      }
    }
  }
}

test "self-host f32 decimal exponents cancel more than ten thousand leading zeros" {
  for (count, suffix) in [(10001u32, b"1000000059604644775390625e10002f32"), (20000u32, b"1000000059604644775390625e20001f32")] {
    let builder = BytesBuilder::with_capacity(count + 64u32)
    builder.append(b"0.")
    while 0u32 {
      index if index < count => {
        builder.append_byte(48u8)
        continue index + 1u32
      }
      _ => break self_host_tokenizer_unit()
    }
    builder.append(suffix)
    assert_self_host_f32_decimal(builder.finish(), 1065353216u32)
  }
}

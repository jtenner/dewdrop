fn self_host_constructor_field_identity_link() -> SelfHostPlannedProgramWasmGCLink {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct First {\n  value: I32\n}\nstruct Second {\n  value: I32\n}\npub fn main() -> I32 {\n  let item = First::{\n    value: 42i32\n  }\n  item.value\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid constructor identity source")
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(bytes) => assert(bytes.byte_length() > 0u32, "valid constructor before mutation")
    Result::Err(error) => assert(false, error)
  }
  link
}

fn self_host_constructor_field_identity_fixture(replacement: U64) -> Unit {
  let link = self_host_constructor_field_identity_link()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.object_fields.length() == 1u32, "one source field")
  let field = self_host_planned_object_field_at(module_.object_fields, 0u32)
  assert(field.field == 5100u64 << 32u64, "exact original field identity")
  module_.object_fields[0u32] = SelfHostPlannedObjectField::{
    field: replacement
    name: field.name
    value: field.value
    offset: field.offset
  }
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(_) => {}
    Result::Err(error) => assert(false, error)
  }
}

fn self_host_constructor_propagation_identity_fixture(replacement: U64) -> Unit {
  let link = self_host_constructor_field_identity_link()
  let program = self_host_plan_program_wasm_bodies(link)
  let plan = program.bodies[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let body = module_.bodies[0u32]
  let field = module_.object_fields[0u32]
  module_.object_fields[0u32] = SelfHostPlannedObjectField::{
    field: replacement
    name: field.name
    value: field.value
    offset: field.offset
  }
  let expression = match self_host_body_plan_expression(plan, 2u32) {
    Option::Some(value) => value
    Option::None => unreachable()
  }
  let _ = self_host_body_force_constructor_field_carriers(link, module_, body,
    plan.specialization, expression, SelfHostHirSpan::{
      start: 0u32
      length: 1u32
    }, plan.expressions)
}

test "BOD-608 constructor propagation rejects a missing field identity" expect_trap "unreachable" {
  self_host_constructor_propagation_identity_fixture(0u64)
}

test "BOD-608 constructor propagation rejects another declaration's field" expect_trap "unreachable" {
  self_host_constructor_propagation_identity_fixture((5100u64 << 32u64) | 1u64)
}

test "BOD-608 constructor field names cannot replace declaration identity" expect_trap "unreachable" {
  self_host_constructor_field_identity_fixture((5100u64 << 32u64) | 1u64)
}

test "BOD-608 constructor field names cannot repair a missing identity" expect_trap "unreachable" {
  self_host_constructor_field_identity_fixture(0u64)
}

fn self_host_constructor_field_span_fixture(kind: U32) -> Unit {
  let link = self_host_constructor_field_identity_link()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let fragment = link.fragments.modules[0u32]
  let body = module_.bodies[0u32]
  let physical = fragment.physical_types[0u32]
  let source = SelfHostHirSpan::{
    start: 0u32
    length: 1u32
  }
  let valid = self_host_constructor_field_recipe(module_, body, 2u32, source, fragment, physical, 0u32)
  assert(valid.length() == 1u32 && valid[0u32] == 0u32, "valid field recipe before span mutation")
  if kind == 0u32 {
    let _ = self_host_constructor_field_recipe(module_, body, 2u32, SelfHostHirSpan::{
      start: 0u32
      length: 2u32
    }, fragment, physical, 0u32)
  } else if kind == 1u32 {
    assert(fragment.fields.length() == 2u32, "two source fields without an unused closure field")
    let changed = SelfHostPlannedWasmPhysicalType::{
      kind: physical.kind
      type_index: physical.type_index
      fields: SelfHostHirSpan::{
        start: fragment.fields.length()
        length: 1u32
      }
      offset: physical.offset
    }
    let _ = self_host_constructor_field_recipe(module_, body, 2u32, source, fragment, changed, 0u32)
  } else {
    let _ = self_host_constructor_field_recipe(module_, body, 2u32, self_host_empty_hir_span(0u32), fragment, physical, 0u32)
  }
}

test "ARN-101 constructor recipes require an owned source span" expect_trap "unreachable" {
  self_host_constructor_field_span_fixture(0u32)
}

test "ARN-101 constructor recipes require an owned physical span" expect_trap "unreachable" {
  self_host_constructor_field_span_fixture(1u32)
}

test "BOD-608 constructor recipes require complete source fields" expect_trap "unreachable" {
  self_host_constructor_field_span_fixture(2u32)
}

test "BOD-608 constructor recipes cannot use a source field twice" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Pair {\n  left: I32\n  right: I32\n}\npub fn main() -> I32 {\n  let pair = Pair::{\n    right: 2i32\n    left: 40i32\n  }\n  pair.left + pair.right\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid reversed source field order")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let fragment = link.fragments.modules[0u32]
  let body = module_.bodies[0u32]
  let physical = fragment.physical_types[0u32]
  let fields = SelfHostHirSpan::{
    start: 0u32
    length: 2u32
  }
  let valid = self_host_constructor_field_recipe(module_, body, 3u32, fields, fragment, physical, 0u32)
  assert(valid.length() == 2u32 && valid[0u32] == 1u32 && valid[1u32] == 0u32, "physical order differs from source order")
  let second = self_host_planned_object_field_at(module_.object_fields, 1u32)
  module_.object_fields[1u32] = SelfHostPlannedObjectField::{
    field: module_.object_fields[0u32].field
    name: second.name
    value: second.value
    offset: second.offset
  }
  let _ = self_host_constructor_field_recipe(module_, body, 3u32, fields, fragment, physical, 0u32)
}

test "Unit enum payload bindings do not inherit reference marker carriers" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Payload {\n  Value(I64, Unit, I32)\n}\nfn consume(value: Unit) -> Unit {}\npub fn run(value: Payload) -> I32 {\n  match value {\n    Value(left, effect, right) => {\n      consume(effect)\n      right\n    }\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  for linked_type in link.types {
    let fragment = link.fragments.modules[linked_type.module_index]
    let physical = fragment.physical_types[linked_type.fragment_index]
    for pattern in module_.patterns {
      if pattern.shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
        while 0u32 {
          index if index < physical.fields.length => {
            let slot = physical.fields.start + index
            let field = fragment.fields[slot]
            if self_host_linked_variant_unit_storage(link, field, SelfHostWasmBodyCarrier::UnitBodyCarrier) {
              assert(self_host_body_pattern_field_carrier(link, module_, linked_type.type_index, index, pattern.type_) is SelfHostWasmBodyCarrier::UnitBodyCarrier, "declared null marker is a logical Unit binding")
              fragment.fields[slot] = SelfHostPlannedWasmField::{
                role: field.role
                declaration: field.declaration
                physical_index: field.physical_index
                storage: SelfHostPlannedWasmStorageType::WasmI64Storage
                mutable_: field.mutable_
                exact_nominal: field.exact_nominal
                offset: field.offset
              }
              assert(self_host_body_pattern_field_carrier(link, module_, linked_type.type_index, index, pattern.type_) is SelfHostWasmBodyCarrier::I64BodyCarrier, "wrong scalar storage must not become a valid Unit certificate")
              fragment.fields[slot] = field
              checked = checked + 1u32
            }
            continue index + 1u32
          }
          _ => break ()
        }
      }
    }
  }
  assert(checked > 0u32, "inspect a selected Unit payload field")
}

test "variant Unit storage rejects a field with another declaration identity" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Payload {\n  Value(Unit)\n}\npub fn run(value: Payload) -> I32 {\n  match value {\n    Value(effect) => 42i32\n  }\n}\n",
  ), false)
  let mut checked = 0u32
  for fragment in link.fragments.modules {
    for field in fragment.fields {
      if self_host_linked_variant_unit_storage(link, field, SelfHostWasmBodyCarrier::UnitBodyCarrier) {
        let changed = SelfHostPlannedWasmField::{
          role: field.role
          declaration: 18446744073709551615u64
          physical_index: field.physical_index
          storage: field.storage
          mutable_: field.mutable_
          exact_nominal: field.exact_nominal
          offset: field.offset
        }
        assert(!self_host_linked_variant_unit_storage(link, changed, SelfHostWasmBodyCarrier::UnitBodyCarrier), "the role cannot hide a different stored declaration")
        checked = checked + 1u32
      }
    }
  }
  assert(checked == 1u32, "inspect exactly one declared Unit payload")
}


fn self_host_test_evaluation_sequence_module() -> SelfHostPlannedModuleLowering {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Wrapped {\n  Value(I32, I32, I32)\n}\npub fn run() -> I32 {\n  let value = Wrapped::Value(1i32, return 42i32, 3i32)\n  0i32\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, "valid evaluation prefix before mutation")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  match module_.expressions[6u32].kind {
    SelfHostPlannedExpressionKind::PlannedEvaluationSequence(children) => {
      assert(children.length == 2u32, "one value precedes the return")
      assert(module_.expression_children[children.start] == 2u32, "first value identity")
      assert(module_.expression_children[children.start + 1u32] == 4u32, "return identity")
    }
    _ => assert(false, "nonreturning call becomes an evaluation prefix")
  }
  module_
}

test "BOD-611 evaluation prefixes cannot be empty" expect_trap "unreachable" {
  let module_ = self_host_test_evaluation_sequence_module()
  let source = module_.expressions[6u32]
  let span = match source.kind {
    SelfHostPlannedExpressionKind::PlannedEvaluationSequence(children) => children
    _ => unreachable()
  }
  module_.expressions[6u32] = self_host_compile_time_replace_kind(source,
    SelfHostPlannedExpressionKind::PlannedEvaluationSequence(SelfHostHirSpan::{
      start: span.start
      length: 0u32
    }))
  self_host_verify_lowered_body_children(module_, module_.bodies[0u32], 4294967295u32)
}

test "BOD-611 evaluation prefixes cannot claim fallthrough" expect_trap "unreachable" {
  let module_ = self_host_test_evaluation_sequence_module()
  let source = module_.expressions[6u32]
  module_.expressions[6u32] = self_host_compile_time_with_flow(source,
    self_host_flow_decode(self_host_flow_encode(source.flow) | 1u32))
  self_host_verify_lowered_body_children(module_, module_.bodies[0u32], 4294967295u32)
}

test "BOD-611 evaluation prefixes stop at the first nonreturning child" expect_trap "unreachable" {
  let module_ = self_host_test_evaluation_sequence_module()
  let source = module_.expressions[2u32]
  module_.expressions[2u32] = self_host_compile_time_with_flow(source,
    self_host_flow_decode(self_host_flow_encode(source.flow) ^ 1u32))
  self_host_verify_lowered_body_children(module_, module_.bodies[0u32], 4294967295u32)
}

test "BOD-611 evaluation prefixes require a nonreturning last child" expect_trap "unreachable" {
  let module_ = self_host_test_evaluation_sequence_module()
  let source = module_.expressions[4u32]
  module_.expressions[4u32] = self_host_compile_time_with_flow(source,

test "Unit enum payload bindings do not inherit reference marker carriers" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"enum Payload {\n  Value(I64, Unit, I32)\n}\nfn consume(value: Unit) -> Unit {}\npub fn run(value: Payload) -> I32 {\n  match value {\n    Value(left, effect, right) => {\n      consume(effect)\n      right\n    }\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let plan = self_host_plan_program_wasm_bodies(link)
  assert(plan.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, plan))
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  for linked_type in link.types {
    let fragment = link.fragments.modules[linked_type.module_index]
    let physical = fragment.physical_types[linked_type.fragment_index]
    for pattern in module_.patterns {
      if pattern.shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
        while 0u32 {
          index if index < physical.fields.length => {
            let slot = physical.fields.start + index
            let field = fragment.fields[slot]
            if self_host_linked_variant_unit_storage(link, field, SelfHostWasmBodyCarrier::UnitBodyCarrier) {
              assert(self_host_body_pattern_field_carrier(link, module_, linked_type.type_index, index, pattern.type_) is SelfHostWasmBodyCarrier::UnitBodyCarrier, "declared null marker is a logical Unit binding")
              fragment.fields[slot] = SelfHostPlannedWasmField::{
                role: field.role
                declaration: field.declaration
                physical_index: field.physical_index
                storage: SelfHostPlannedWasmStorageType::WasmI64Storage
                mutable_: field.mutable_
                exact_nominal: field.exact_nominal
                offset: field.offset
              }
              assert(self_host_body_pattern_field_carrier(link, module_, linked_type.type_index, index, pattern.type_) is SelfHostWasmBodyCarrier::I64BodyCarrier, "wrong scalar storage must not become a valid Unit certificate")
              fragment.fields[slot] = field
              checked = checked + 1u32
            }
            continue index + 1u32
          }
          _ => break ()
        }
      }
    }
  }
  assert(checked > 0u32, "inspect a selected Unit payload field")
}

test "nonreturning constructor lowering owns its prefix and preserves source children" {
  let fragments = self_host_physical_test_fragments(
    b"enum Wrapped {\n  Value(I32, I32, I32)\n}\npub fn run() -> I32 {\n  let value = Wrapped::Value(1i32, return 42i32, 3i32)\n  0i32\n}\n",
  )
  let lowering = fragments.specialization.lowering
  let collected = lowering.collected.modules.at(0u32)
  let module_ = lowering.modules[0u32]
  assert(collected.expression_children.length() == 3u32, "source child arena stays unchanged")
  let mut found = 0u32
  for source in module_.expressions {
    match source.kind {
      SelfHostPlannedExpressionKind::PlannedEvaluationSequence(children) => {
        found = found + 1u32
        assert(!source.flow.falls_through, "prefix retains the flow proof")
        assert(children.length == 2u32, "later operand is excluded")
        assert(children.start >= collected.expression_children.length(), "prefix has private storage")
        let terminal = module_.expression_children[children.start + 1u32]
        assert(module_.expressions[terminal].kind is SelfHostPlannedExpressionKind::PlannedReturnExpression(_), "prefix ends at the original return")
      }
      _ => {}
    }
  }
  assert(found == 1u32, "constructor becomes one evaluation prefix")
}

test "declared Unit fields permit only a Unit marker not generic or scalar boxing" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Marker {\n  value: Unit\n}\npub fn run() -> I32 {\n  let marker = Marker::{\n    value: ()\n  }\n  marker.value\n  42i32\n}\n",
  ), false)
  let field = link.fragments.specialization.lowering.modules[0u32].type_layouts.fields[0u32].field
  let storage = SelfHostPlannedWasmStorageType::WasmNullableEqRefStorage
  assert(self_host_linked_erased_field_unit_storage(link, field, storage, SelfHostWasmBodyCarrier::UnitBodyCarrier), "declared Unit marker is explicit")
  assert(self_host_linked_erased_field_box_type(link, field, SelfHostWasmBodyCarrier::I32BodyCarrier) is Option::None, "Unit does not permit boxing")
  assert(!self_host_linked_field_storage_matches_shape(link, field, storage, SelfHostPlannedValueShape::GenericPlannedValueShape), "Unit does not permit missing generic evidence")
  assert(!self_host_linked_field_storage_matches_shape(link, 0u64, storage, SelfHostPlannedValueShape::UnitPlannedValueShape), "missing field identity does not permit Unit storage")
}
test "runtime Unit pattern storage requires the exact selected layout" {
  let link = self_host_physical_test_named_import_link("dew.std.option",
    b"pub enum Option<t> {\n  None\n  Some(t)\n}\n",
    b"open dew.std.option\npub fn run(value: Option<Unit>) -> I32 {\n  match value {\n    Some(effect) => {\n      effect\n      42i32\n    }\n    None => 0i32\n  }\n}\n",
  )
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid Unit adapter source")
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid Unit adapter body")
  let module_ = link.fragments.specialization.lowering.modules[1u32]
  let mut checked = 0u32
  for pattern in module_.patterns {
    match pattern.source {
      SelfHostHirPattern::TuplePattern(_, children, _) => if children.length == 1u32 {
        let child = module_.patterns[module_.pattern_children[children.start]]
        if child.shape is SelfHostPlannedValueShape::UnitPlannedValueShape {
          let type_index = match self_host_linked_pattern_variant_type(link, module_, pattern,
            SelfHostPlannedValueShape::UnitPlannedValueShape, 0u64) {
            Option::Some(value) => value
            Option::None => {
              assert(false, "selected Unit variant has a layout")
              4294967295u32
            }
          }
          let field_index = self_host_linked_variant_payload_field_index(link, type_index, 0u32)
          assert(self_host_unit_pattern_binding_has_storage(link, module_, 4294967295u32,
            pattern, child, type_index, field_index), "exact Unit marker layout")
          assert(!self_host_unit_pattern_binding_has_storage(link, module_, 4294967295u32,
            pattern, child, type_index + 1u32, field_index), "another heap type is not the selected Unit marker")
          assert(!self_host_unit_pattern_binding_has_storage(link, module_, 4294967295u32,
            pattern, child, type_index, field_index + 1u32), "another field is not the selected payload")
          let scalar = SelfHostPlannedPattern::{
            elided: child.elided
            type_: -self_host_body_u32_to_i32(module_.resolved_types.primitive(SelfHostPrimitiveType::I64Type)) - 2i32
            shape: child.shape
            source: child.source
            reference: child.reference
            selected_constructor: child.selected_constructor
            offset: child.offset
          }
          assert(!self_host_unit_pattern_binding_has_storage(link, module_, 4294967295u32,
            pattern, scalar, type_index, field_index), "a scalar type cannot use a Unit marker")
          checked = checked + 1u32
        }
      }
      _ => {}
    }
  }
  assert(checked == 1u32, "one selected Unit payload")
}

test "evaluation prefixes pass both planning and emission checks" {
  let module_ = self_host_test_evaluation_sequence_module()
  self_host_verify_lowered_body_children(module_, module_.bodies[0u32], 4294967295u32)
  self_host_verify_emitted_evaluation_sequence(module_, module_.bodies[0u32], 6u32)
}


open dew.std.array
open dew.std.string

fn self_host_flow_string_equal(left: String, right: String) -> Bool {
  left == right
}

pub struct SelfHostBodyFlowSummary {
  falls_through: Bool
  returns: Bool
  breaks: Bool
  continues: Bool
  diverges: Bool
}

fn self_host_body_flow_summary_identity(
  flow: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: flow.falls_through
    returns: flow.returns
    breaks: flow.breaks
    continues: flow.continues
    diverges: flow.diverges
  }
}

pub enum SelfHostMissingPatternCase {
  MissingCatchAllCase
  MissingBoolCase(Bool)
  MissingVariantCase(U64)
}

fn self_host_flow_u64_at(values: Array<U64>, index: U32) -> U64 {
  array_get_unchecked(values, index)
}

fn self_host_flow_i32_at(values: Array<I32>, index: U32) -> I32 {
  array_get_unchecked(values, index)
}

// This helper keeps flow work stacks on the U32 carrier.
// The backend uses this type as compile-time proof for Array operations.
fn self_host_flow_u32_stack(value: U32) -> Array<U32> {
  [value]
}

pub enum SelfHostBodyFlowDiagnostic {
  NonExhaustiveMatch(U32, SelfHostHirSpan, U32)
  NonExhaustiveFunctionalLoop(U32, SelfHostHirSpan, U32)
  RedundantPatternArm(U32, U32)
  FunctionalLoopArmFallsThrough(U32, U32)
  UnreachableBlockItem(U32, U32, U32)
}

fn self_host_body_flow_diagnostic_offset(
  diagnostic: SelfHostBodyFlowDiagnostic,
) -> U32 {
  match diagnostic {
    SelfHostBodyFlowDiagnostic::NonExhaustiveMatch(_, _, offset) => offset
    SelfHostBodyFlowDiagnostic::NonExhaustiveFunctionalLoop(_, _, offset) => offset
    SelfHostBodyFlowDiagnostic::RedundantPatternArm(_, offset) => offset
    SelfHostBodyFlowDiagnostic::FunctionalLoopArmFallsThrough(_, offset) => offset
    SelfHostBodyFlowDiagnostic::UnreachableBlockItem(_, _, offset) => offset
  }
}

fn self_host_body_flow_diagnostic_rank(
  diagnostic: SelfHostBodyFlowDiagnostic,
) -> U32 {
  match diagnostic {
    SelfHostBodyFlowDiagnostic::RedundantPatternArm(_, _) => 0u32
    SelfHostBodyFlowDiagnostic::NonExhaustiveMatch(_, _, _) => 1u32
    SelfHostBodyFlowDiagnostic::NonExhaustiveFunctionalLoop(_, _, _) => 2u32
    SelfHostBodyFlowDiagnostic::FunctionalLoopArmFallsThrough(_, _) => 3u32
    SelfHostBodyFlowDiagnostic::UnreachableBlockItem(_, _, _) => 4u32
  }
}

pub struct SelfHostAnalyzedBodyFlow {
  body: U64
  flow: SelfHostBodyFlowSummary
  expression_flows: Array<U32>
  block_flows: Array<U32>
  arm_flows: Array<U32>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

pub struct SelfHostAnalyzedLambdaFlow {
  lambda: U32
  flow: SelfHostBodyFlowSummary
  expression_flows: Array<U32>
  block_flows: Array<U32>
  arm_flows: Array<U32>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

pub struct SelfHostAnalyzedModuleFlows {
  module_id: U64
  bodies: Array<SelfHostAnalyzedBodyFlow>
  lambdas: Array<SelfHostAnalyzedLambdaFlow>
}

enum SelfHostFlowCoverageDomain {
  OpenFlowCoverageDomain
  BoolFlowCoverageDomain
  EnumFlowCoverageDomain(U64)
}

fn self_host_flow_empty() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: false
    returns: false
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_falls_through() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: true
    returns: false
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_returns() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: false
    returns: true
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_breaks() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: false
    returns: false
    breaks: true
    continues: false
    diverges: false
  }
}

fn self_host_flow_continues() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: false
    returns: false
    breaks: false
    continues: true
    diverges: false
  }
}

fn self_host_flow_diverges() -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: false
    returns: false
    breaks: false
    continues: false
    diverges: true
  }
}

fn self_host_flow_union(
  left: SelfHostBodyFlowSummary,
  right: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: left.falls_through || right.falls_through
    returns: left.returns || right.returns
    breaks: left.breaks || right.breaks
    continues: left.continues || right.continues
    diverges: left.diverges || right.diverges
  }
}

fn self_host_flow_sequence(
  first: SelfHostBodyFlowSummary,
  second: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: first.falls_through && second.falls_through
    returns: first.returns || (first.falls_through && second.returns)
    breaks: first.breaks || (first.falls_through && second.breaks)
    continues: first.continues || (first.falls_through && second.continues)
    diverges: first.diverges || (first.falls_through && second.diverges)
  }
}

fn self_host_flow_encode(flow: SelfHostBodyFlowSummary) -> U32 {
  let mut encoded = 0u32
  if flow.falls_through {
    encoded = encoded | 1u32
  }
  if flow.returns {
    encoded = encoded | 2u32
  }
  if flow.breaks {
    encoded = encoded | 4u32
  }
  if flow.continues {
    encoded = encoded | 8u32
  }
  if flow.diverges {
    encoded = encoded | 16u32
  }
  encoded
}

fn self_host_flow_decode(flow: U32) -> SelfHostBodyFlowSummary {
  SelfHostBodyFlowSummary::{
    falls_through: (flow & 1u32) != 0u32
    returns: (flow & 2u32) != 0u32
    breaks: (flow & 4u32) != 0u32
    continues: (flow & 8u32) != 0u32
    diverges: (flow & 16u32) != 0u32
  }
}

fn self_host_flow_slots(length: U32) -> Array<U32> {
  let values = [0u32]
  if length == 0u32 {
    values.truncate(0u32)
  } else {
    let mut index = 1u32
    let _ = while index {
      current => if current < length {
        values.push(0u32)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  values
}

fn self_host_flow_resolved_type_is_never(
  resolved: SelfHostResolvedModuleTypes,
  type_: U32,
) -> Bool {
  let mut current = type_
  while current {
    candidate => match resolved.types[candidate] {
      SelfHostResolvedType::PrimitiveType(primitive) => {
        break primitive is SelfHostPrimitiveType::NeverType
      }
      SelfHostResolvedType::AppliedType(base, _) => continue base
      _ => break false
    }
  }
}

fn self_host_flow_expression_is_never(
  inferred: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
) -> Bool {
  match inferred.type_term(type_) {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => {
      self_host_flow_resolved_type_is_never(resolved, resolved_type)
    }
    _ => false
  }
}

fn self_host_flow_terminal(
  inferred: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  body: SelfHostHirBody,
  expression: U32,
) -> SelfHostBodyFlowSummary {
  if self_host_flow_expression_is_never(
    inferred,
    resolved,
    inferred.expression_types[expression - body.expressions.start],
  ) {
    self_host_flow_diverges()
  } else {
    self_host_flow_falls_through()
  }
}

struct SelfHostBodyFlowAnalyzer {
  collected: SelfHostCollectedModule
  resolved: SelfHostResolvedModuleTypes
  body: SelfHostHirBody
  inferred: SelfHostBasicInferredBody
  imported_variants: Array<SelfHostResolvedImportedVariant>
  expression_flows: Array<U32>
  block_flows: Array<U32>
  block_done: Array<Bool>
  arm_flows: Array<U32>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

impl SelfHostBodyFlowAnalyzer {
  fn new(
    collected: SelfHostCollectedModule,
    resolved: SelfHostResolvedModuleTypes,
    body: SelfHostHirBody,
    inferred: SelfHostBasicInferredBody,
    imported_variants: Array<SelfHostResolvedImportedVariant>,
  ) -> SelfHostBodyFlowAnalyzer {
    SelfHostBodyFlowAnalyzer::{
      collected: collected
      resolved: resolved
      body: body
      inferred: inferred
      imported_variants: imported_variants
      expression_flows: self_host_flow_slots(body.expressions.length)
      block_flows: self_host_flow_slots(body.blocks.length)
      block_done: self_host_module_value_bool_slots(body.blocks.length)
      arm_flows: self_host_flow_slots(body.pattern_arms.length)
      missing_cases: []
      diagnostics: []
    }
  }

  fn expression_flow(self, expression: U32) -> SelfHostBodyFlowSummary {
    if self_host_u32_equal(expression, 4294967295u32) {
      self_host_flow_falls_through()
    } else {
      self_host_flow_decode(
        self.expression_flows[expression - self.body.expressions.start],
      )
    }
  }

  fn sequence_children(self, children: SelfHostHirSpan) -> SelfHostBodyFlowSummary {
    let mut result = self_host_flow_falls_through()
    let mut index = 0u32
    let _ = while index {
      current => if current < children.length {
        result = self_host_flow_sequence(
          result,
          self.expression_flow(
            self.collected.expression_children[
              self_host_u32_add(children.start, current)
            ],
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    result
  }

  fn block_item_offset(self, item: SelfHostHirBlockItem) -> U32 {
    item.offset
  }

  fn block_flow(self, block: U32) -> SelfHostBodyFlowSummary {
    let slot = block - self.body.blocks.start
    if self.block_done[slot] {
      return self_host_flow_decode(self.block_flows[slot])
    }
    let info = self.collected.blocks[block]
    let mut result = self_host_flow_falls_through()
    let mut index = 0u32
    let _ = while index {
      current => if current < info.items.length {
        let item = self.collected.block_items[
          self_host_u32_add(info.items.start, current)
        ]
        if !result.falls_through {
          self.diagnostics.push(SelfHostBodyFlowDiagnostic::UnreachableBlockItem(
            block,
            current,
            self.block_item_offset(item),
          ))
        } else {
          let item_flow = self.expression_flow(item.value)
          result = self_host_flow_sequence(result, item_flow)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.block_flows[slot] = self_host_flow_encode(result)
    self.block_done[slot] = true
    result
  }

  fn arm_flow(self, arm: U32) -> SelfHostBodyFlowSummary {
    let info = self.collected.pattern_arms[arm]
    let result = if self_host_u32_equal(info.guard_condition, 4294967295u32) {
      self.expression_flow(info.body)
    } else {
      self_host_flow_sequence(
        self.expression_flow(info.guard_condition),
        self.expression_flow(info.body),
      )
    }
    self.arm_flows[arm - self.body.pattern_arms.start] = self_host_flow_encode(
      result,
    )
    result
  }

  fn resolved_coverage_domain(self, type_: U32) -> SelfHostFlowCoverageDomain {
    let mut current = type_
    while current {
      candidate => match self.resolved.types[candidate] {
        SelfHostResolvedType::PrimitiveType(primitive) => {
          if primitive is SelfHostPrimitiveType::BoolType {
            break SelfHostFlowCoverageDomain::BoolFlowCoverageDomain
          } else {
            break SelfHostFlowCoverageDomain::OpenFlowCoverageDomain
          }
        }
        SelfHostResolvedType::NominalType(declaration) => {
          break SelfHostFlowCoverageDomain::EnumFlowCoverageDomain(declaration)
        }
        SelfHostResolvedType::AppliedType(base, _) => continue base
        _ => break SelfHostFlowCoverageDomain::OpenFlowCoverageDomain
      }
    }
  }

  fn coverage_domain(self, expression: U32) -> SelfHostFlowCoverageDomain {
    let tasks = [self.inferred.expression_types[expression - self.body.expressions.start]]
    while tasks.length() {
      length => if self_host_u32_greater(length, 0u32) {
        let type_ = self_host_flow_i32_at(tasks, length - 1u32)
        tasks.truncate(length - 1u32)
        match self.inferred.type_term(type_) {
          SelfHostBodyTypeTerm::BodyAppliedType(base, _) => tasks.push(base)
          SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => {
            break self.resolved_coverage_domain(resolved_type)
          }
          _ => break SelfHostFlowCoverageDomain::OpenFlowCoverageDomain
        }
        continue tasks.length()
      } else {
        break SelfHostFlowCoverageDomain::OpenFlowCoverageDomain
      }
    }
  }

  fn enum_variants(self, declaration: U64) -> Array<U64> {
    let variants = []
    let mut local_index = 0u32
    let _ = while local_index {
      current => if current < self.collected.variants.length() {
        let variant = self_host_collected_variant_identity(
          self.collected.variants[current],
        )
        if self_host_u64_equal(variant.declaration, declaration) {
          variants.push(variant.id)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut imported_index = 0u32
    let _ = while imported_index {
      current => if current < self.imported_variants.length() {
        let variant = self_host_resolved_imported_variant_at(
          self.imported_variants,
          current,
        )
        if self_host_u64_equal(variant.declaration, declaration) {
          variants.push(variant.variant)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    variants
  }

  fn pattern_variant(self, pattern: U32) -> Option<U64> {
    if pattern < self.body.patterns.start || pattern >= self_host_u32_add(
      self.body.patterns.start,
      self.body.patterns.length,
    ) {
      return Option::None
    }
    match self.inferred.pattern_constructors[pattern - self.body.patterns.start] {
      SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(
        declaration,
        _,
        _,
      ) => Option::Some(declaration)
      _ => Option::None
    }
  }

  fn pattern_catches_all(self, pattern: U32) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      SelfHostHirPattern::WildcardPattern(_) => true
      SelfHostHirPattern::BindingPattern(_, _) => true
      SelfHostHirPattern::AlternativePattern(first, alternatives, _) => {
        if self.pattern_catches_all(first) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_catches_all(self.collected.pattern_children[child]) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => false
    }
  }

  fn pattern_has_error(self, pattern: U32) -> Bool {
    let mut diagnostic_index = 0u32
    let _ = while diagnostic_index {
      current => if current < self.inferred.diagnostics.length() {
        let diagnostic = self.inferred.diagnostics[current]
        match diagnostic {
        SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        SelfHostBodyInferenceDiagnostic::PatternPayloadKindMismatch(
          candidate,
          _,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        SelfHostBodyInferenceDiagnostic::PatternPayloadArityMismatch(
          candidate,
          _,
          _,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        SelfHostBodyInferenceDiagnostic::UnknownPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        SelfHostBodyInferenceDiagnostic::MissingPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        SelfHostBodyInferenceDiagnostic::MissingImportedPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    false
  }

  fn pattern_covers_bool(self, pattern: U32, value: Bool) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      SelfHostHirPattern::LiteralPattern(expression, _) => if expression < self.collected.expressions.length() {
        match self.collected.expressions[expression] {
          SelfHostHirExpr::BoolExpr(candidate, _) => candidate == value
          _ => false
        }
      } else {
        false
      }
      SelfHostHirPattern::AlternativePattern(first, alternatives, _) => {
        if self.pattern_covers_bool(first, value) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_covers_bool(
                self.collected.pattern_children[child],
                value,
              ) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => false
    }
  }

  fn qualified_pattern_matches_variant(
    self,
    pattern: U32,
    variant: U64,
  ) -> Bool {
    let pattern_name = match self.collected.patterns[pattern] {
      SelfHostHirPattern::QualifiedPattern(_, name, _) => name
      _ => {
        return false
      }
    }
    let mut local_index = 0u32
    let _ = while local_index {
      current => if current < self.collected.variants.length() {
        let candidate = self_host_collected_variant_identity(
          self.collected.variants[current],
        )
        if self_host_u64_equal(candidate.id, variant) {
          return self_host_u32_equal(candidate.name, pattern_name)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let name = self.collected.name(pattern_name)
    let mut imported_index = 0u32
    let _ = while imported_index {
      current => if current < self.imported_variants.length() {
        let candidate = self_host_resolved_imported_variant_at(
          self.imported_variants,
          current,
        )
        if self_host_u64_equal(candidate.variant, variant) {
          let candidate_name = candidate.name
          return self_host_flow_string_equal(candidate_name, name)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    false
  }

  fn pattern_covers_variant(self, pattern: U32, variant: U64) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      SelfHostHirPattern::AlternativePattern(first, alternatives, _) => {
        if self.pattern_covers_variant(first, variant) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_covers_variant(
                self.collected.pattern_children[child],
                variant,
              ) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => match self.pattern_variant(pattern) {
        Option::Some(candidate) => self_host_u64_equal(candidate, variant)
        Option::None => self.qualified_pattern_matches_variant(pattern, variant)
      }
    }
  }

  fn arms_flow(
    self,
    expression: U32,
    expected: U32,
    arms: SelfHostHirSpan,
    loop_: Bool,
    offset: U32,
  ) -> SelfHostBodyFlowSummary {
    let domain = self.coverage_domain(expected)
    let enum_variants = match domain {
      SelfHostFlowCoverageDomain::EnumFlowCoverageDomain(declaration) => {
        self.enum_variants(declaration)
      }
      _ => []
    }
    let covered_variants = self_host_module_value_bool_slots(enum_variants.length())
    let mut covered_variant_count = 0u32
    let mut coverage_error = false
    let mut branches = self_host_flow_empty()
    let mut catch_all = false
    let mut covered_false = false
    let mut covered_true = false
    let mut index = 0u32
    let _ = while index {
      current => if current < arms.length {
        let arm = self.collected.arm_children[
          self_host_u32_add(arms.start, current)
        ]
        let info = self.collected.pattern_arms[arm]
        if self.pattern_has_error(info.pattern) {
          coverage_error = true
        }
        let catches_all = self.pattern_catches_all(info.pattern)
        let covers_false = self.pattern_covers_bool(info.pattern, false)
        let covers_true = self.pattern_covers_bool(info.pattern, true)
        let mut useful = coverage_error || (catches_all && !catch_all)
        match domain {
          SelfHostFlowCoverageDomain::BoolFlowCoverageDomain => {
            if covers_false && !covered_false {
              useful = true
            }
            if covers_true && !covered_true {
              useful = true
            }
          }
          SelfHostFlowCoverageDomain::EnumFlowCoverageDomain(_) => {
            let mut variant_index = 0u32
            let _ = while variant_index {
              candidate => if candidate < enum_variants.length() {
                if self.pattern_covers_variant(
                  info.pattern,
                  self_host_flow_u64_at(enum_variants, candidate),
                ) && !covered_variants[candidate] {
                  useful = true
                }
                continue candidate + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          SelfHostFlowCoverageDomain::OpenFlowCoverageDomain => {
            if !catches_all {
              useful = true
            }
          }
        }
        if catch_all || !useful {
          self.diagnostics.push(SelfHostBodyFlowDiagnostic::RedundantPatternArm(
            arm,
            info.offset,
          ))
        }
        if self_host_u32_equal(info.guard_condition, 4294967295u32) {
          if catches_all {
            catch_all = true
          }
          if covers_false {
            covered_false = true
          }
          if covers_true {
            covered_true = true
          }
          let mut variant_index = 0u32
          let _ = while variant_index {
            candidate => if candidate < enum_variants.length() {
              if !covered_variants[candidate] && self.pattern_covers_variant(
                info.pattern,
                self_host_flow_u64_at(enum_variants, candidate),
              ) {
                covered_variants[candidate] = true
                covered_variant_count = self_host_u32_add(
                  covered_variant_count,
                  1u32,
                )
              }
              continue candidate + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        let flow = self.arm_flow(arm)
        if loop_ && flow.falls_through {
          self.diagnostics.push(
            SelfHostBodyFlowDiagnostic::FunctionalLoopArmFallsThrough(
              arm,
              info.offset,
            ),
          )
        }
        branches = self_host_flow_union(branches, flow)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let exhaustive = coverage_error || catch_all || match domain {
      SelfHostFlowCoverageDomain::BoolFlowCoverageDomain => {
        covered_false && covered_true
      }
      SelfHostFlowCoverageDomain::EnumFlowCoverageDomain(_) => {
        self_host_u32_greater(enum_variants.length(), 0u32) && self_host_u32_equal(
          covered_variant_count,
          enum_variants.length(),
        )
      }
      SelfHostFlowCoverageDomain::OpenFlowCoverageDomain => false
    }
    if !exhaustive {
      let missing_start = self.missing_cases.length()
      match domain {
        SelfHostFlowCoverageDomain::BoolFlowCoverageDomain => {
          if !covered_false {
            self.missing_cases.push(
              SelfHostMissingPatternCase::MissingBoolCase(false),
            )
          }
          if !covered_true {
            self.missing_cases.push(
              SelfHostMissingPatternCase::MissingBoolCase(true),
            )
          }
        }
        SelfHostFlowCoverageDomain::EnumFlowCoverageDomain(_) => {
          let mut variant = 0u32
          let _ = while variant {
            current => if current < enum_variants.length() {
              if !covered_variants[current] {
                self.missing_cases.push(
                  SelfHostMissingPatternCase::MissingVariantCase(
                    self_host_flow_u64_at(enum_variants, current),
                  ),
                )
              }
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if self_host_u32_equal(enum_variants.length(), 0u32) {
            self.missing_cases.push(
              SelfHostMissingPatternCase::MissingCatchAllCase,
            )
          }
        }
        SelfHostFlowCoverageDomain::OpenFlowCoverageDomain => {
          self.missing_cases.push(
            SelfHostMissingPatternCase::MissingCatchAllCase,
          )
        }
      }
      let missing = SelfHostHirSpan::{
        start: missing_start
        length: self.missing_cases.length() - missing_start
      }
      if loop_ {
        self.diagnostics.push(
          SelfHostBodyFlowDiagnostic::NonExhaustiveFunctionalLoop(
            expression,
            missing,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(SelfHostBodyFlowDiagnostic::NonExhaustiveMatch(
          expression,
          missing,
          offset,
        ))
      }
      branches = self_host_flow_union(branches, self_host_flow_diverges())
    }
    branches
  }

  fn analyze_expressions(self) -> Unit {
    let mut expression = self.body.expressions.start
    let end = self_host_u32_add(
      self.body.expressions.start,
      self.body.expressions.length,
    )
    let _ = while expression {
      current => if current < end {
        let terminal = self_host_flow_terminal(
          self.inferred,
          self.resolved,
          self.body,
          current,
        )
        let flow = match self.collected.expressions[current] {
          SelfHostHirExpr::I8Expr(_, _) => terminal
          SelfHostHirExpr::I16Expr(_, _) => terminal
          SelfHostHirExpr::I32Expr(_, _) => terminal
          SelfHostHirExpr::I64Expr(_, _) => terminal
          SelfHostHirExpr::U8Expr(_, _) => terminal
          SelfHostHirExpr::U16Expr(_, _) => terminal
          SelfHostHirExpr::U32Expr(_, _) => terminal
          SelfHostHirExpr::U64Expr(_, _) => terminal
          SelfHostHirExpr::F32Expr(_, _) => terminal
          SelfHostHirExpr::F64Expr(_, _) => terminal
          SelfHostHirExpr::BoolExpr(_, _) => terminal
          SelfHostHirExpr::StringExpr(_, _) => terminal
          SelfHostHirExpr::BytesExpr(_, _) => terminal
          SelfHostHirExpr::NameExpr(_, _) => terminal
          SelfHostHirExpr::ImportAliasExpr(_, _) => terminal
          SelfHostHirExpr::LambdaExpr(_, _) => terminal
          SelfHostHirExpr::TypeBindingExpr(_, _) => terminal
          SelfHostHirExpr::ProductExpr(children, _) => self_host_flow_sequence(
            self.sequence_children(children),
            terminal,
          )
          SelfHostHirExpr::ArrayExpr(children, _) => self_host_flow_sequence(
            self.sequence_children(children),
            terminal,
          )
          SelfHostHirExpr::ObjectExpr(fields, _) => {
            let mut prefix = self_host_flow_falls_through()
            let mut field = 0u32
            let _ = while field {
              field_index => if field_index < fields.length {
                let object_field = self_host_hir_object_field_at(
                  self.collected.object_fields,
                  self_host_u32_add(fields.start, field_index),
                )
                let value = object_field.value
                prefix = self_host_flow_sequence(
                  prefix,
                  self.expression_flow(value),
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self_host_flow_sequence(prefix, terminal)
          }
          SelfHostHirExpr::ConstructExpr(target, fields, _) => {
            let mut prefix = self.expression_flow(target)
            let mut field = 0u32
            let _ = while field {
              field_index => if field_index < fields.length {
                let object_field = self_host_hir_object_field_at(
                  self.collected.object_fields,
                  self_host_u32_add(fields.start, field_index),
                )
                let value = object_field.value
                prefix = self_host_flow_sequence(
                  prefix,
                  self.expression_flow(value),
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self_host_flow_sequence(prefix, terminal)
          }
          SelfHostHirExpr::BlockExpr(block, _) => self.block_flow(block)
          SelfHostHirExpr::IfExpr(condition, block, alternative, _) => {
            let alternative_flow = if alternative == 4294967295u32 {
              self_host_flow_falls_through()
            } else {
              self.expression_flow(alternative)
            }
            self_host_flow_sequence(
              self.expression_flow(condition),
              self_host_flow_union(self.block_flow(block), alternative_flow),
            )
          }
          SelfHostHirExpr::MatchExpr(scrutinee, arms, offset) => {
            self_host_flow_sequence(
              self.expression_flow(scrutinee),
              self.arms_flow(current, scrutinee, arms, false, offset),
            )
          }
          SelfHostHirExpr::WhileExpr(initial, arms, offset) => {
            let branches = self.arms_flow(current, initial, arms, true, offset)
            let loop_flow = SelfHostBodyFlowSummary::{
              falls_through: branches.breaks
              returns: branches.returns
              breaks: false
              continues: false
              diverges: branches.diverges || branches.continues || branches.falls_through || (!branches.breaks && !branches.returns)
            }
            self_host_flow_sequence(self.expression_flow(initial), loop_flow)
          }
          SelfHostHirExpr::ReturnExpr(value, _) => self_host_flow_sequence(
            if self_host_u32_equal(value, 4294967295u32) {
              self_host_flow_falls_through()
            } else {
              self.expression_flow(value)
            },
            self_host_flow_returns(),
          )
          SelfHostHirExpr::BreakExpr(value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            self_host_flow_breaks(),
          )
          SelfHostHirExpr::ContinueExpr(value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            self_host_flow_continues(),
          )
          SelfHostHirExpr::PrefixExpr(_, value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            terminal,
          )
          SelfHostHirExpr::BinaryExpr(operator, left, right, _) => match operator {
            SelfHostHirBinaryOperator::LogicalAnd => self_host_flow_sequence(
              self.expression_flow(left),
              self_host_flow_union(
                terminal,
                self_host_flow_sequence(self.expression_flow(right), terminal),
              ),
            )
            SelfHostHirBinaryOperator::LogicalOr => self_host_flow_sequence(
              self.expression_flow(left),
              self_host_flow_union(
                terminal,
                self_host_flow_sequence(self.expression_flow(right), terminal),
              ),
            )
            _ => self_host_flow_sequence(
              self_host_flow_sequence(
                self.expression_flow(left),
                self.expression_flow(right),
              ),
              terminal,
            )
          }
          SelfHostHirExpr::CallExpr(target, arguments, _) => {
            let target_flow = match self.inferred.call_targets[
              current - self.body.expressions.start
            ] {
              // A selected direct target is compile-time proof, not a value.
              SelfHostBasicCallTarget::SelectedBasicCallTarget(_, _) => {
                self_host_flow_falls_through()
              }
              _ => self.expression_flow(target)
            }
            self_host_flow_sequence(
              self_host_flow_sequence(
                target_flow,
                self.sequence_children(arguments),
              ),
              terminal,
            )
          }
          SelfHostHirExpr::FieldExpr(base, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          SelfHostHirExpr::QualifiedExpr(base, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          SelfHostHirExpr::ProductFieldExpr(base, _, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          SelfHostHirExpr::IndexExpr(base, index, _) => self_host_flow_sequence(
            self_host_flow_sequence(
              self.expression_flow(base),
              self.expression_flow(index),
            ),
            terminal,
          )
          SelfHostHirExpr::AssignmentExpr(_, value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            terminal,
          )
          SelfHostHirExpr::IndexSetExpr(base, index, value, _) => {
            self_host_flow_sequence(
              self_host_flow_sequence(
                self_host_flow_sequence(
                  self.expression_flow(base),
                  self.expression_flow(index),
                ),
                self.expression_flow(value),
              ),
              terminal,
            )
          }
        }
        self.expression_flows[
          current - self.body.expressions.start
        ] = self_host_flow_encode(flow)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn sort_diagnostics(self) -> Unit {
    let mut index = 1u32
    let _ = while index {
      current => if current < self.diagnostics.length() {
        let value = self.diagnostics[current]
        let value_offset = self_host_body_flow_diagnostic_offset(value)
        let value_rank = self_host_body_flow_diagnostic_rank(value)
        let destination = while current {
          cursor => if self_host_u32_greater(cursor, 0u32) {
            let previous = cursor - 1u32
            let candidate = self.diagnostics[previous]
            let candidate_offset = self_host_body_flow_diagnostic_offset(candidate)
            let candidate_rank = self_host_body_flow_diagnostic_rank(candidate)
            let after = self_host_u32_greater(candidate_offset, value_offset) ||
              (self_host_u32_equal(candidate_offset, value_offset) && self_host_u32_greater(
                candidate_rank,
                value_rank,
              ))
            if after {
              self.diagnostics[cursor] = candidate
              continue previous
            }
            break cursor
          } else {
            break cursor
          }
        }
        self.diagnostics[destination] = value
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn finish(self) -> SelfHostAnalyzedBodyFlow {
    self.analyze_expressions()
    self.sort_diagnostics()
    let root = match self.body.root {
      SelfHostHirBodyRoot::ExpressionBodyRoot(expression) => {
        self.expression_flow(expression)
      }
      SelfHostHirBodyRoot::BlockBodyRoot(block) => self.block_flow(block)
    }
    SelfHostAnalyzedBodyFlow::{
      body: self.body.id
      flow: root
      expression_flows: self.expression_flows
      block_flows: self.block_flows
      arm_flows: self.arm_flows
      missing_cases: self.missing_cases
      diagnostics: self.diagnostics
    }
  }
}

fn self_host_flow_lambda_body(
  collected: SelfHostCollectedModule,
  lambda: SelfHostHirLambda,
) -> SelfHostHirBody {
  let root = collected.bodies[self_host_semantic_id_local(lambda.root_body)]
  SelfHostHirBody::{
    id: lambda.root_body
    declaration: root.declaration
    kind: root.kind
    root: SelfHostHirBodyRoot::BlockBodyRoot(lambda.body.root)
    expressions: lambda.body.expressions
    expression_children: lambda.body.expression_children
    blocks: lambda.body.blocks
    block_items: lambda.body.block_items
    patterns: lambda.body.patterns
    pattern_children: lambda.body.pattern_children
    pattern_arms: lambda.body.pattern_arms
    arm_children: lambda.body.arm_children
    object_fields: lambda.body.object_fields
    pattern_fields: lambda.body.pattern_fields
    offset: lambda.offset
  }
}

fn self_host_analyze_basic_module_flows_internal(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
  imported_variants: Array<SelfHostResolvedImportedVariant>,
) -> SelfHostAnalyzedModuleFlows {
  let bodies = []
  let mut index = 0u32
  let _ = while index {
    current => if current < collected.bodies.length() {
      bodies.push(
        SelfHostBodyFlowAnalyzer::new(
          collected,
          resolved,
          collected.bodies[current],
          inferred.bodies[current],
          imported_variants,
        ).finish(),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let lambdas = []
  index = 0u32
  let _ = while index {
    current => if current < collected.lambdas.length() {
      let result = SelfHostBodyFlowAnalyzer::new(
        collected,
        resolved,
        self_host_flow_lambda_body(collected, collected.lambdas[current]),
        inferred.lambdas[current].body,
        imported_variants,
      ).finish()
      lambdas.push(SelfHostAnalyzedLambdaFlow::{
        lambda: current
        flow: result.flow
        expression_flows: result.expression_flows
        block_flows: result.block_flows
        arm_flows: result.arm_flows
        missing_cases: result.missing_cases
        diagnostics: result.diagnostics
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  SelfHostAnalyzedModuleFlows::{
    module_id: collected.module_id
    bodies: bodies
    lambdas: lambdas
  }
}

fn self_host_analyze_basic_module_flows(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
) -> SelfHostAnalyzedModuleFlows {
  self_host_analyze_basic_module_flows_internal(
    collected,
    resolved,
    inferred,
    [],
  )
}

fn self_host_analyze_basic_module_flows_with_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
  imported_variants: Array<SelfHostResolvedImportedVariant>,
) -> SelfHostAnalyzedModuleFlows {
  self_host_analyze_basic_module_flows_internal(
    collected,
    resolved,
    inferred,
    imported_variants,
  )
}

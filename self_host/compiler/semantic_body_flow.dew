open dew.std.array
open dew.std.string

fn self_host_flow_string_equal(left: String, right: String) -> Bool {
  left == right
}

pub struct SelfHostBodyFlowSummary {
  falls_through: Bool
  returns: Bool
  breaks: Bool
  continues: Bool
  diverges: Bool
}

fn self_host_body_flow_summary_identity(
  flow: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  {
    falls_through: flow.falls_through
    returns: flow.returns
    breaks: flow.breaks
    continues: flow.continues
    diverges: flow.diverges
  }
}

pub enum SelfHostMissingPatternCase {
  MissingCatchAllCase
  MissingBoolCase(Bool)
  MissingVariantCase(U64)
}

fn self_host_flow_u64_at(values: Array<U64>, index: U32) -> U64 {
  array_get_unchecked(values, index)
}

fn self_host_flow_i32_at(values: Array<I32>, index: U32) -> I32 {
  array_get_unchecked(values, index)
}

// This helper keeps flow work stacks on the U32 carrier.
// The backend uses this type as compile-time proof for Array operations.
fn self_host_flow_u32_stack(value: U32) -> Array<U32> {
  [value]
}

pub enum SelfHostBodyFlowDiagnostic {
  NonExhaustiveMatch(U32, SelfHostHirSpan, U32)
  NonExhaustiveFunctionalLoop(U32, SelfHostHirSpan, U32)
  PatternCoverageBudgetExceeded(U32, U32, U32, U32)
  RedundantPatternArm(U32, U32)
  FunctionalLoopArmFallsThrough(U32, U32)
  UnreachableBlockItem(U32, U32, U32)
}

fn self_host_body_flow_diagnostic_offset(
  diagnostic: SelfHostBodyFlowDiagnostic,
) -> U32 {
  match diagnostic {
    NonExhaustiveMatch(_, _, offset) => offset
    NonExhaustiveFunctionalLoop(_, _, offset) => offset
    PatternCoverageBudgetExceeded(_, _, _, offset) => offset
    RedundantPatternArm(_, offset) => offset
    FunctionalLoopArmFallsThrough(_, offset) => offset
    UnreachableBlockItem(_, _, offset) => offset
  }
}

fn self_host_body_flow_diagnostic_rank(
  diagnostic: SelfHostBodyFlowDiagnostic,
) -> U32 {
  match diagnostic {
    RedundantPatternArm(_, _) => 0u32
    NonExhaustiveMatch(_, _, _) => 1u32
    NonExhaustiveFunctionalLoop(_, _, _) => 2u32
    PatternCoverageBudgetExceeded(_, _, _, _) => 5u32
    FunctionalLoopArmFallsThrough(_, _) => 3u32
    UnreachableBlockItem(_, _, _) => 4u32
  }
}

pub struct SelfHostAnalyzedBodyFlow {
  body: U64
  flow: SelfHostBodyFlowSummary
  expression_flows: Array<U32>
  block_flows: Array<U32>
  arm_flows: Array<U32>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

pub struct SelfHostAnalyzedLambdaFlow {
  lambda: U32
  flow: SelfHostBodyFlowSummary
  expression_flows: Array<U32>
  block_flows: Array<U32>
  arm_flows: Array<U32>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

pub struct SelfHostAnalyzedModuleFlows {
  module_id: U64
  bodies: Array<SelfHostAnalyzedBodyFlow>
  lambdas: Array<SelfHostAnalyzedLambdaFlow>
}

enum SelfHostFlowCoverageDomain {
  OpenFlowCoverageDomain
  BoolFlowCoverageDomain
  EnumFlowCoverageDomain(U64)
}

fn self_host_flow_empty() -> SelfHostBodyFlowSummary {
  {
    falls_through: false
    returns: false
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_falls_through() -> SelfHostBodyFlowSummary {
  {
    falls_through: true
    returns: false
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_returns() -> SelfHostBodyFlowSummary {
  {
    falls_through: false
    returns: true
    breaks: false
    continues: false
    diverges: false
  }
}

fn self_host_flow_breaks() -> SelfHostBodyFlowSummary {
  {
    falls_through: false
    returns: false
    breaks: true
    continues: false
    diverges: false
  }
}

fn self_host_flow_continues() -> SelfHostBodyFlowSummary {
  {
    falls_through: false
    returns: false
    breaks: false
    continues: true
    diverges: false
  }
}

fn self_host_flow_diverges() -> SelfHostBodyFlowSummary {
  {
    falls_through: false
    returns: false
    breaks: false
    continues: false
    diverges: true
  }
}

fn self_host_flow_union(
  left: SelfHostBodyFlowSummary,
  right: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  {
    falls_through: left.falls_through || right.falls_through
    returns: left.returns || right.returns
    breaks: left.breaks || right.breaks
    continues: left.continues || right.continues
    diverges: left.diverges || right.diverges
  }
}

fn self_host_flow_sequence(
  first: SelfHostBodyFlowSummary,
  second: SelfHostBodyFlowSummary,
) -> SelfHostBodyFlowSummary {
  {
    falls_through: first.falls_through && second.falls_through
    returns: first.returns || (first.falls_through && second.returns)
    breaks: first.breaks || (first.falls_through && second.breaks)
    continues: first.continues || (first.falls_through && second.continues)
    diverges: first.diverges || (first.falls_through && second.diverges)
  }
}

fn self_host_flow_encode(flow: SelfHostBodyFlowSummary) -> U32 {
  let mut encoded = 0u32
  if flow.falls_through {
    encoded = encoded | 1u32
  }
  if flow.returns {
    encoded = encoded | 2u32
  }
  if flow.breaks {
    encoded = encoded | 4u32
  }
  if flow.continues {
    encoded = encoded | 8u32
  }
  if flow.diverges {
    encoded = encoded | 16u32
  }
  encoded
}

fn self_host_flow_decode(flow: U32) -> SelfHostBodyFlowSummary {
  {
    falls_through: (flow & 1u32) != 0u32
    returns: (flow & 2u32) != 0u32
    breaks: (flow & 4u32) != 0u32
    continues: (flow & 8u32) != 0u32
    diverges: (flow & 16u32) != 0u32
  }
}

fn self_host_flow_slots(length: U32) -> Array<U32> {
  let values = [0u32]
  if length == 0u32 {
    values.truncate(0u32)
  } else {
    let mut index = 1u32
    let _ = while index {
      current => if current < length {
        values.push(0u32)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
  values
}

fn self_host_flow_resolved_type_is_never(
  resolved: SelfHostResolvedModuleTypes,
  type_: U32,
) -> Bool {
  let mut current = type_
  while current {
    candidate => match resolved.types[candidate] {
      PrimitiveType(primitive) => {
        break primitive is NeverType
      }
      AppliedType(base, _) => continue base
      _ => break false
    }
  }
}

fn self_host_flow_expression_is_never(
  inferred: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
) -> Bool {
  match inferred.type_term(type_) {
    BodyResolvedType(resolved_type) => {
      self_host_flow_resolved_type_is_never(resolved, resolved_type)
    }
    _ => false
  }
}

fn self_host_flow_terminal(
  inferred: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  body: SelfHostHirBody,
  expression: U32,
) -> SelfHostBodyFlowSummary {
  if self_host_flow_expression_is_never(
    inferred,
    resolved,
    inferred.expression_types[expression - body.expressions.start],
  ) {
    self_host_flow_diverges()
  } else {
    self_host_flow_falls_through()
  }
}

struct SelfHostBodyFlowAnalyzer {
  collected: SelfHostCollectedModule
  resolved: SelfHostResolvedModuleTypes
  body: SelfHostHirBody
  inferred: SelfHostBasicInferredBody
  imported_variants: Array<SelfHostResolvedImportedVariant>
  imported_fields: Array<SelfHostResolvedImportedField>
  imported_variant_spans: Option<Map<U64, SelfHostHirSpan>>
  expression_flows: Array<U32>
  block_flows: Array<U32>
  block_done: Array<Bool>
  arm_flows: Array<U32>
  pattern_irrefutable: Array<Bool>
  pattern_payload_irrefutable: Array<Bool>
  missing_cases: Array<SelfHostMissingPatternCase>
  diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

impl SelfHostBodyFlowAnalyzer {
  fn new(
    collected: SelfHostCollectedModule,
    resolved: SelfHostResolvedModuleTypes,
    body: SelfHostHirBody,
    inferred: SelfHostBasicInferredBody,
    imported_variants: Array<SelfHostResolvedImportedVariant>,
    imported_fields: Array<SelfHostResolvedImportedField>,
    imported_variant_spans: Option<Map<U64, SelfHostHirSpan>>,
  ) -> SelfHostBodyFlowAnalyzer {
    self_host_assert_body_owned_spans(collected, body, 3u32)
    {
      collected: collected
      resolved: resolved
      body: body
      inferred: inferred
      imported_variants: imported_variants
      imported_fields: imported_fields
      imported_variant_spans: imported_variant_spans
      expression_flows: self_host_flow_slots(body.expressions.length)
      block_flows: self_host_flow_slots(body.blocks.length)
      block_done: self_host_module_value_bool_slots(body.blocks.length)
      arm_flows: self_host_flow_slots(body.pattern_arms.length)
      pattern_irrefutable: self_host_module_value_bool_slots(body.patterns.length)
      pattern_payload_irrefutable: self_host_module_value_bool_slots(body.patterns.length)
      missing_cases: []
      diagnostics: []
    }
  }

  fn expression_index(self, expression: U32) -> U32 {
    self_host_body_relative_index(self.collected, self.body, BodyExpressions, expression, 3u32)
  }

  fn pattern_index(self, pattern: U32) -> U32 {
    self_host_body_relative_index(self.collected, self.body, BodyPatterns, pattern, 3u32)
  }

  fn block_index(self, block: U32) -> U32 {
    self_host_body_relative_index(self.collected, self.body, BodyBlocks, block, 3u32)
  }

  fn arm_index(self, arm: U32) -> U32 {
    self_host_body_relative_index(self.collected, self.body, BodyPatternArms, arm, 3u32)
  }

  fn expression_flow(self, expression: U32) -> SelfHostBodyFlowSummary {
    if self_host_u32_equal(expression, 4294967295u32) {
      self_host_flow_falls_through()
    } else {
      self_host_flow_decode(
        self.expression_flows[self.expression_index(expression)],
      )
    }
  }

  fn sequence_children(self, children: SelfHostHirSpan) -> SelfHostBodyFlowSummary {
    let mut result = self_host_flow_falls_through()
    let mut index = 0u32
    let _ = while index {
      current => if current < children.length {
        result = self_host_flow_sequence(
          result,
          self.expression_flow(
            self.collected.expression_children[
              self_host_u32_add(children.start, current)
            ],
          ),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    result
  }

  fn block_item_offset(self, item: SelfHostHirBlockItem) -> U32 {
    item.offset
  }

  fn block_flow(self, block: U32) -> SelfHostBodyFlowSummary {
    let slot = self.block_index(block)
    if self.block_done[slot] {
      return self_host_flow_decode(self.block_flows[slot])
    }
    let info = self.collected.blocks[block]
    let mut result = self_host_flow_falls_through()
    let mut index = 0u32
    let _ = while index {
      current => if current < info.items.length {
        let item = self.collected.block_items[
          self_host_u32_add(info.items.start, current)
        ]
        if !result.falls_through {
          self.diagnostics.push(UnreachableBlockItem(
            block,
            current,
            self.block_item_offset(item),
          ))
        } else {
          let item_flow = self.expression_flow(item.value)
          result = self_host_flow_sequence(result, item_flow)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.block_flows[slot] = self_host_flow_encode(result)
    self.block_done[slot] = true
    result
  }

  fn arm_flow(self, arm: U32) -> SelfHostBodyFlowSummary {
    let info = self.collected.pattern_arms[arm]
    let result = if self_host_u32_equal(info.guard_condition, 4294967295u32) {
      self.expression_flow(info.body)
    } else {
      self_host_flow_sequence(
        self.expression_flow(info.guard_condition),
        self.expression_flow(info.body),
      )
    }
    self.arm_flows[self.arm_index(arm)] = self_host_flow_encode(
      result,
    )
    result
  }

  fn resolved_coverage_domain(self, type_: U32) -> SelfHostFlowCoverageDomain {
    let mut current = type_
    while current {
      candidate => match self.resolved.types[candidate] {
        PrimitiveType(primitive) => {
          if primitive is BoolType {
            break BoolFlowCoverageDomain
          } else {
            break OpenFlowCoverageDomain
          }
        }
        NominalType(declaration) => {
          let enum_ = match self.collected.declaration_reference(declaration) {
            Some(TopLevel(info)) => info.kind is EnumDecl
            _ => !self.enum_variants(declaration).is_empty()
          }
          if enum_ {
             break EnumFlowCoverageDomain(declaration)
           }
          break OpenFlowCoverageDomain
        }
        AppliedType(base, _) => continue base
        GenericParameterType(_), TraitType(_), SelfType(_),
        MemberTypeProjection(_, _, _) => break OpenFlowCoverageDomain
        _ => break OpenFlowCoverageDomain
      }
    }
  }

  fn body_coverage_domain(self, type_: I32) -> SelfHostFlowCoverageDomain {
    while type_ {
      current => match self.inferred.type_term(current) {
        BodyAppliedType(base, _) => continue base
        BodyResolvedType(resolved_type) => break self.resolved_coverage_domain(resolved_type)
        _ => break OpenFlowCoverageDomain
      }
    }
  }

  fn coverage_domain(self, expression: U32) -> SelfHostFlowCoverageDomain {
    self.body_coverage_domain(self.inferred.expression_types[self.expression_index(expression)])
  }

  fn enum_variants(self, declaration: U64) -> Array<U64> {
    let variants = []
    let mut local_index = 0u32
    let _ = while local_index {
      current => if current < self.collected.variants.length() {
        let variant = self_host_collected_variant_identity(
          self.collected.variants[current],
        )
        if self_host_u64_equal(variant.declaration, declaration) {
          variants.push(variant.id)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut imported_index = 0u32
    let _ = while imported_index {
      current => if current < self.imported_variants.length() {
        let variant = self_host_resolved_imported_variant_at(
          self.imported_variants,
          current,
        )
        if self_host_u64_equal(variant.declaration, declaration) {
          variants.push(variant.variant)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    variants
  }

  fn pattern_variant(self, pattern: U32) -> Option<U64> {
    if pattern < self.body.patterns.start || pattern >= self_host_u32_add(
      self.body.patterns.start,
      self.body.patterns.length,
    ) {
      return None
    }
    match self.inferred.pattern_constructors[self.pattern_index(pattern)] {
      SelectedBasicPatternConstructor(
        declaration,
        _,
        _,
      ) => Some(declaration)
      _ => None
    }
  }

  fn pattern_catches_all(self, pattern: U32) -> Bool {
    pattern >= self.body.patterns.start && pattern < self.body.patterns.start + self.body.patterns.length && self.pattern_irrefutable[self.pattern_index(pattern)]
  }

  fn pattern_has_error(self, pattern: U32) -> Bool {
    let mut diagnostic_index = 0u32
    let _ = while diagnostic_index {
      current => if current < self.inferred.diagnostics.length() {
        let diagnostic = self.inferred.diagnostics[current]
        match diagnostic {
        InvalidPatternConstructor(
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        PatternPayloadKindMismatch(
          candidate,
          _,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        PatternPayloadArityMismatch(
          candidate,
          _,
          _,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        UnknownPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        MissingPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
        MissingImportedPatternField(
          _,
          candidate,
          _,
        ) => if self_host_u32_equal(candidate, pattern) {
          return true
        }
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    false
  }

  fn pattern_covers_bool(self, pattern: U32, value: Bool) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      LiteralPattern(expression, _) => if expression < self.collected.expressions.length() {
        match self.collected.expressions[expression] {
          BoolExpr(candidate, _) => candidate == value
          _ => false
        }
      } else {
        false
      }
      AlternativePattern(first, alternatives, _) => {
        if self.pattern_covers_bool(first, value) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_covers_bool(
                self.collected.pattern_children[child],
                value,
              ) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => false
    }
  }

  fn qualified_pattern_matches_variant(
    self,
    pattern: U32,
    variant: U64,
  ) -> Bool {
    let pattern_name = match self.collected.patterns[pattern] {
      QualifiedPattern(_, name, _) => name
      _ => {
        return false
      }
    }
    let mut local_index = 0u32
    let _ = while local_index {
      current => if current < self.collected.variants.length() {
        let candidate = self_host_collected_variant_identity(
          self.collected.variants[current],
        )
        if self_host_u64_equal(candidate.id, variant) {
          return self_host_u32_equal(candidate.name, pattern_name)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let name = self.collected.name(pattern_name)
    let mut imported_index = 0u32
    let _ = while imported_index {
      current => if current < self.imported_variants.length() {
        let candidate = self_host_resolved_imported_variant_at(
          self.imported_variants,
          current,
        )
        if self_host_u64_equal(candidate.variant, variant) {
          let candidate_name = candidate.name
          return self_host_flow_string_equal(candidate_name, name)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    false
  }

  fn pattern_covers_variant(self, pattern: U32, variant: U64) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      AlternativePattern(first, alternatives, _) => {
        if self.pattern_covers_variant(first, variant) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_covers_variant(
                self.collected.pattern_children[child],
                variant,
              ) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => match self.pattern_variant(pattern) {
        Some(candidate) => candidate == variant && self.pattern_payload_irrefutable[self.pattern_index(pattern)]
        None => self.qualified_pattern_matches_variant(pattern, variant) && self.pattern_payload_irrefutable[self.pattern_index(pattern)]
      }
    }
  }

  fn pattern_mentions_variant(self, pattern: U32, variant: U64) -> Bool {
    if pattern >= self.collected.patterns.length() {
      return false
    }
    match self.collected.patterns[pattern] {
      AlternativePattern(first, alternatives, _) => {
        if self.pattern_mentions_variant(first, variant) {
          return true
        }
        let mut index = 0u32
        let _ = while index {
          current => if current < alternatives.length {
            let child = self_host_u32_add(alternatives.start, current)
            if child < self.collected.pattern_children.length() &&
              self.pattern_mentions_variant(
                self.collected.pattern_children[child],
                variant,
              ) {
              return true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        false
      }
      _ => match self.pattern_variant(pattern) {
        Some(candidate) => candidate == variant
        None => self.qualified_pattern_matches_variant(pattern, variant)
      }
    }
  }

  fn arms_flow(
    self,
    expression: U32,
    expected: U32,
    arms: SelfHostHirSpan,
    loop_: Bool,
    offset: U32,
  ) -> SelfHostBodyFlowSummary {
    let domain = self.coverage_domain(expected)
    let enum_variants = match domain {
      EnumFlowCoverageDomain(declaration) => {
        self.enum_variants(declaration)
      }
      _ => []
    }
    let covered_variants = self_host_module_value_bool_slots(enum_variants.length())
    let mut covered_variant_count = 0u32
    let mut coverage_error = false
    let mut has_guard = false
    let mut branches = self_host_flow_empty()
    let mut catch_all = false
    let mut covered_false = false
    let mut covered_true = false
    let mut index = 0u32
    let _ = while index {
      current => if current < arms.length {
        let arm = self.collected.arm_children[
          self_host_u32_add(arms.start, current)
        ]
        let info = self.collected.pattern_arms[arm]
        has_guard = has_guard || info.guard_condition != 4294967295u32
        if self.pattern_has_error(info.pattern) {
          coverage_error = true
        }
        let catches_all = self.pattern_catches_all(info.pattern)
        let covers_false = self.pattern_covers_bool(info.pattern, false)
        let covers_true = self.pattern_covers_bool(info.pattern, true)
        let mut useful = coverage_error || (catches_all && !catch_all)
        match domain {
          BoolFlowCoverageDomain => {
            if covers_false && !covered_false {
              useful = true
            }
            if covers_true && !covered_true {
              useful = true
            }
          }
          EnumFlowCoverageDomain(_) => {
            let mut variant_index = 0u32
            let _ = while variant_index {
              candidate => if candidate < enum_variants.length() {
                if self.pattern_mentions_variant(
                  info.pattern,
                  self_host_flow_u64_at(enum_variants, candidate),
                ) && !covered_variants[candidate] {
                  useful = true
                }
                continue candidate + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          OpenFlowCoverageDomain => {
            if !catches_all {
              useful = true
            }
          }
        }
        if catch_all || !useful {
          self.diagnostics.push(RedundantPatternArm(
            arm,
            info.offset,
          ))
        }
        if self_host_u32_equal(info.guard_condition, 4294967295u32) {
          if catches_all {
            catch_all = true
          }
          if covers_false {
            covered_false = true
          }
          if covers_true {
            covered_true = true
          }
          let mut variant_index = 0u32
          let _ = while variant_index {
            candidate => if candidate < enum_variants.length() {
              if !covered_variants[candidate] && self.pattern_covers_variant(
                info.pattern,
                self_host_flow_u64_at(enum_variants, candidate),
              ) {
                covered_variants[candidate] = true
                covered_variant_count = self_host_u32_add(
                  covered_variant_count,
                  1u32,
                )
              }
              continue candidate + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        let flow = self.arm_flow(arm)
        if loop_ && flow.falls_through {
          self.diagnostics.push(
            FunctionalLoopArmFallsThrough(
              arm,
              info.offset,
            ),
          )
        }
        branches = self_host_flow_union(branches, flow)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut exhaustive = coverage_error || catch_all || match domain {
      BoolFlowCoverageDomain => {
        covered_false && covered_true
      }
      EnumFlowCoverageDomain(_) => {
        self_host_u32_greater(enum_variants.length(), 0u32) && self_host_u32_equal(
          covered_variant_count,
          enum_variants.length(),
        )
      }
      OpenFlowCoverageDomain => false
    }
    if !exhaustive {
      let rows = array_new::<Array<U32>>()
      let work = SelfHostPatternCoverageWork::{
        remaining: 65536u32
        exhausted: false
      }
      let _ = while 0u32 {
        index => if index < arms.length {
          if !work.spend(1u32) {
            break self_host_semantic_unit()
          }
          let arm = self.collected.pattern_arms[self.collected.arm_children[arms.start + index]]
          if arm.guard_condition == 4294967295u32 {
            if !work.spend(2u32) {
               break self_host_semantic_unit()
             }
            rows.push([arm.pattern])
          }
          continue index + 1u32
        } else {
           break self_host_semantic_unit()
         }
      }
      let (mutable_path, literal_call) = self.matrix_stability(rows, work)
      let stable = !mutable_path || (!has_guard && !literal_call)
      if stable && !work.exhausted && self.matrix_complete(rows, work, 0u32) {
         exhaustive = true
       }
      if work.exhausted {
        self.diagnostics.push(PatternCoverageBudgetExceeded(expression, 65536u32, 64u32, offset))
        return self_host_flow_union(branches, self_host_flow_diverges())
      }
    }
    if !exhaustive {
      let missing_start = self.missing_cases.length()
      match domain {
        BoolFlowCoverageDomain => {
          if !covered_false {
            self.missing_cases.push(
              MissingBoolCase(false),
            )
          }
          if !covered_true {
            self.missing_cases.push(
              MissingBoolCase(true),
            )
          }
        }
        EnumFlowCoverageDomain(_) => {
          let mut variant = 0u32
          let _ = while variant {
            current => if current < enum_variants.length() {
              if !covered_variants[current] {
                self.missing_cases.push(
                  MissingVariantCase(
                    self_host_flow_u64_at(enum_variants, current),
                  ),
                )
              }
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          if self_host_u32_equal(enum_variants.length(), 0u32) {
            self.missing_cases.push(
              MissingCatchAllCase,
            )
          }
        }
        OpenFlowCoverageDomain => {
          self.missing_cases.push(
            MissingCatchAllCase,
          )
        }
      }
      let missing = {
        start: missing_start
        length: self.missing_cases.length() - missing_start
      }
      if loop_ {
        self.diagnostics.push(
          NonExhaustiveFunctionalLoop(
            expression,
            missing,
            offset,
          ),
        )
      } else {
        self.diagnostics.push(NonExhaustiveMatch(
          expression,
          missing,
          offset,
        ))
      }
      branches = self_host_flow_union(branches, self_host_flow_diverges())
    }
    branches
  }

  fn analyze_expressions(self) -> Unit {
    let mut expression = self.body.expressions.start
    let end = self_host_u32_add(
      self.body.expressions.start,
      self.body.expressions.length,
    )
    let _ = while expression {
      current => if current < end {
        let terminal = self_host_flow_terminal(
          self.inferred,
          self.resolved,
          self.body,
          current,
        )
        let flow = match self.collected.expressions[current] {
          I8Expr(_, _) => terminal
          I16Expr(_, _) => terminal
          I32Expr(_, _) => terminal
          I64Expr(_, _) => terminal
          U8Expr(_, _) => terminal
          U16Expr(_, _) => terminal
          U32Expr(_, _) => terminal
          U64Expr(_, _) => terminal
          F32Expr(_, _) => terminal
          F64Expr(_, _) => terminal
          BoolExpr(_, _) => terminal
          StringExpr(_, _) => terminal
          BytesExpr(_, _) => terminal
          NameExpr(_, _) => terminal
          ImportAliasExpr(_, _) => terminal
          LambdaExpr(_, _) => terminal
          TypeBindingExpr(_, _) => terminal
          ProductExpr(children, _) => self_host_flow_sequence(
            self.sequence_children(children),
            terminal,
          )
          ArrayExpr(children, _) => self_host_flow_sequence(
            self.sequence_children(children),
            terminal,
          )
          ObjectExpr(fields, _) => {
            let mut prefix = self_host_flow_falls_through()
            let mut field = 0u32
            let _ = while field {
              field_index => if field_index < fields.length {
                let object_field = self_host_hir_object_field_at(
                  self.collected.object_fields,
                  self_host_u32_add(fields.start, field_index),
                )
                let value = object_field.value
                prefix = self_host_flow_sequence(
                  prefix,
                  self.expression_flow(value),
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self_host_flow_sequence(prefix, terminal)
          }
          ConstructExpr(target, fields, _) => {
            let mut prefix = self.expression_flow(target)
            let mut field = 0u32
            let _ = while field {
              field_index => if field_index < fields.length {
                let object_field = self_host_hir_object_field_at(
                  self.collected.object_fields,
                  self_host_u32_add(fields.start, field_index),
                )
                let value = object_field.value
                prefix = self_host_flow_sequence(
                  prefix,
                  self.expression_flow(value),
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            self_host_flow_sequence(prefix, terminal)
          }
          BlockExpr(block, _) => self.block_flow(block)
          IfExpr(condition, block, alternative, _) => {
            let alternative_flow = if alternative == 4294967295u32 {
              self_host_flow_falls_through()
            } else {
              self.expression_flow(alternative)
            }
            self_host_flow_sequence(
              self.expression_flow(condition),
              self_host_flow_union(self.block_flow(block), alternative_flow),
            )
          }
          MatchExpr(scrutinee, arms, offset) => {
            self_host_flow_sequence(
              self.expression_flow(scrutinee),
              self.arms_flow(current, scrutinee, arms, false, offset),
            )
          }
          WhileExpr(initial, arms, offset) => {
            let branches = self.arms_flow(current, initial, arms, true, offset)
            let loop_flow = {
              falls_through: branches.breaks
              returns: branches.returns
              breaks: false
              continues: false
              diverges: branches.diverges || branches.continues || branches.falls_through || (!branches.breaks && !branches.returns)
            }
            self_host_flow_sequence(self.expression_flow(initial), loop_flow)
          }
          ReturnExpr(value, _) => self_host_flow_sequence(
            if self_host_u32_equal(value, 4294967295u32) {
              self_host_flow_falls_through()
            } else {
              self.expression_flow(value)
            },
            self_host_flow_returns(),
          )
          BreakExpr(value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            self_host_flow_breaks(),
          )
          ContinueExpr(value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            self_host_flow_continues(),
          )
          PrefixExpr(_, value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            terminal,
          )
          BinaryExpr(operator, left, right, _) => match operator {
            LogicalAnd => self_host_flow_sequence(
              self.expression_flow(left),
              self_host_flow_union(
                terminal,
                self_host_flow_sequence(self.expression_flow(right), terminal),
              ),
            )
            LogicalOr => self_host_flow_sequence(
              self.expression_flow(left),
              self_host_flow_union(
                terminal,
                self_host_flow_sequence(self.expression_flow(right), terminal),
              ),
            )
            _ => self_host_flow_sequence(
              self_host_flow_sequence(
                self.expression_flow(left),
                self.expression_flow(right),
              ),
              terminal,
            )
          }
          CallExpr(target, arguments, _) => {
            let target_flow = match self.inferred.call_targets[
              self.expression_index(current)
            ] {
              // A selected direct target is compile-time proof, not a value.
              SelectedBasicCallTarget(_, _) => {
                self_host_flow_falls_through()
              }
              _ => self.expression_flow(target)
            }
            self_host_flow_sequence(
              self_host_flow_sequence(
                target_flow,
                self.sequence_children(arguments),
              ),
              terminal,
            )
          }
          FieldExpr(base, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          QualifiedExpr(base, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          ProductFieldExpr(base, _, _, _) => {
            self_host_flow_sequence(self.expression_flow(base), terminal)
          }
          IndexExpr(base, index, _) => self_host_flow_sequence(
            self_host_flow_sequence(
              self.expression_flow(base),
              self.expression_flow(index),
            ),
            terminal,
          )
          AssignmentExpr(_, value, _) => self_host_flow_sequence(
            self.expression_flow(value),
            terminal,
          )
          IndexSetExpr(base, index, value, _) => {
            self_host_flow_sequence(
              self_host_flow_sequence(
                self_host_flow_sequence(
                  self.expression_flow(base),
                  self.expression_flow(index),
                ),
                self.expression_flow(value),
              ),
              terminal,
            )
          }
        }
        self.expression_flows[
          self.expression_index(current)
        ] = self_host_flow_encode(flow)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn sort_diagnostics(self) -> Unit {
    let mut index = 1u32
    let _ = while index {
      current => if current < self.diagnostics.length() {
        let value = self.diagnostics[current]
        let value_offset = self_host_body_flow_diagnostic_offset(value)
        let value_rank = self_host_body_flow_diagnostic_rank(value)
        let destination = while current {
          cursor => if self_host_u32_greater(cursor, 0u32) {
            let previous = cursor - 1u32
            let candidate = self.diagnostics[previous]
            let candidate_offset = self_host_body_flow_diagnostic_offset(candidate)
            let candidate_rank = self_host_body_flow_diagnostic_rank(candidate)
            let after = self_host_u32_greater(candidate_offset, value_offset) ||
              (self_host_u32_equal(candidate_offset, value_offset) && self_host_u32_greater(
                candidate_rank,
                value_rank,
              ))
            if after {
              self.diagnostics[cursor] = candidate
              continue previous
            }
            break cursor
          } else {
            break cursor
          }
        }
        self.diagnostics[destination] = value
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn finish(self) -> SelfHostAnalyzedBodyFlow {
    self.initialize_pattern_irrefutability()
    self.analyze_expressions()
    self.sort_diagnostics()
    let root = match self.body.root {
      ExpressionBodyRoot(expression) => {
        self.expression_flow(expression)
      }
      BlockBodyRoot(block) => self.block_flow(block)
    }
    {
      body: self.body.id
      flow: root
      expression_flows: self.expression_flows
      block_flows: self.block_flows
      arm_flows: self.arm_flows
      missing_cases: self.missing_cases
      diagnostics: self.diagnostics
    }
  }
}

fn self_host_flow_lambda_body(
  collected: SelfHostCollectedModule,
  lambda: SelfHostHirLambda,
) -> SelfHostHirBody {
  let root = collected.bodies[self_host_semantic_id_local(lambda.root_body)]
  {
    id: lambda.root_body
    declaration: root.declaration
    kind: root.kind
    root: BlockBodyRoot(lambda.body.root)
    expressions: lambda.body.expressions
    expression_children: lambda.body.expression_children
    blocks: lambda.body.blocks
    block_items: lambda.body.block_items
    patterns: lambda.body.patterns
    pattern_children: lambda.body.pattern_children
    pattern_arms: lambda.body.pattern_arms
    arm_children: lambda.body.arm_children
    object_fields: lambda.body.object_fields
    pattern_fields: lambda.body.pattern_fields
    offset: lambda.offset
  }
}

fn self_host_analyze_basic_module_flows_internal(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
  imported_variants: Array<SelfHostResolvedImportedVariant>,
  imported_fields: Array<SelfHostResolvedImportedField>,
  imported_variant_spans: Option<Map<U64, SelfHostHirSpan>>,
) -> SelfHostAnalyzedModuleFlows {
  let bodies = []
  let mut index = 0u32
  let _ = while index {
    current => if current < collected.bodies.length() {
      bodies.push(
        SelfHostBodyFlowAnalyzer::new(
          collected,
          resolved,
          collected.bodies[current],
          inferred.bodies[current],
          imported_variants,
          imported_fields,
          imported_variant_spans,
        ).finish(),
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let lambdas = []
  index = 0u32
  let _ = while index {
    current => if current < collected.lambdas.length() {
      let result = SelfHostBodyFlowAnalyzer::new(
        collected,
        resolved,
        self_host_flow_lambda_body(collected, collected.lambdas[current]),
        inferred.lambdas[current].body,
        imported_variants,
        imported_fields,
        imported_variant_spans,
      ).finish()
      lambdas.push({
        lambda: current
        flow: result.flow
        expression_flows: result.expression_flows
        block_flows: result.block_flows
        arm_flows: result.arm_flows
        missing_cases: result.missing_cases
        diagnostics: result.diagnostics
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    module_id: collected.module_id
    bodies: bodies
    lambdas: lambdas
  }
}

fn self_host_analyze_basic_module_flows(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
) -> SelfHostAnalyzedModuleFlows {
  self_host_analyze_basic_module_flows_internal(
    collected,
    resolved,
    inferred,
    [],
    [],
    None,
  )
}

fn self_host_analyze_basic_module_flows_with_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
  imported_variants: Array<SelfHostResolvedImportedVariant>,
) -> SelfHostAnalyzedModuleFlows {
  self_host_analyze_basic_module_flows_internal(
    collected,
    resolved,
    inferred,
    imported_variants,
    [],
    None,
  )
}

fn self_host_analyze_basic_module_flows_with_field_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostBasicInferredModuleBodies,
  imported_variants: Array<SelfHostResolvedImportedVariant>,
  imported_fields: Array<SelfHostResolvedImportedField>,
  imported_variant_spans: Map<U64, SelfHostHirSpan>,
) -> SelfHostAnalyzedModuleFlows {
  self_host_analyze_basic_module_flows_internal(
    collected, resolved, inferred, imported_variants, imported_fields, Some(imported_variant_spans),
  )
}

struct SelfHostPatternCoverageWork {
  mut remaining: U32
  mut exhausted: Bool
}

impl SelfHostPatternCoverageWork {
  fn spend(self, cells: U32) -> Bool {
    if self.exhausted || cells > self.remaining {
      self.exhausted = true
      false
    } else {
      self.remaining = self.remaining - cells
      true
    }
  }
}

impl SelfHostBodyFlowAnalyzer {
  fn variant_is_only_constructor(self, variant: U64, pattern: U32) -> Bool {
    if self_host_semantic_id_module(variant) == self.collected.module_id {
      let index = self_host_semantic_id_local(variant)
      if index >= self.collected.variants.length() {
        return false
      }
      let owner = self.collected.variants[index].declaration
      if index > 0u32 && self.collected.variants[index - 1u32].declaration == owner {
        return false
      }
      index + 1u32 >= self.collected.variants.length() || self.collected.variants[index + 1u32].declaration != owner
    } else {
      let owner = while self.inferred.pattern_types[self.pattern_index(pattern)] {
        type_ => match self.inferred.type_term(type_) {
          BodyAppliedType(base, _) => continue base
          BodyResolvedType(resolved_type) => {
            break while resolved_type {
              current => match self.resolved.types[current] {
                AppliedType(base, _) => continue base
                NominalType(declaration) => break Some(declaration)
                _ => break None
              }
            }
          }
          _ => break None
        }
      }
      match owner {
        Some(declaration) => {
          match self.imported_variant_spans {
            Some(spans) => return match spans.get(declaration) {
              Some(span) => span.length == 1u32
              None => false
            }
            None => {}
          }
          let mut count = 0u32
          for candidate in self.imported_variants {
            if candidate.declaration == declaration {
              count = count + 1u32
              if count > 1u32 {
                return false
              }
            }
          }
          count == 1u32
        }
        None => false
      }
    }
  }

  fn initialize_pattern_irrefutability(self) -> Unit {
    let _ = while self.body.patterns.start {
      pattern => if pattern < self.body.patterns.start + self.body.patterns.length {
        let payload = match self.collected.patterns[pattern] {
          WildcardPattern(_), BindingPattern(_, _), RestPattern(_), QualifiedPattern(_, _, _) => true
          TuplePattern(_, children, _), ProductPattern(children, _) => {
            let mut complete = true
            let _ = while 0u32 {
              index => if index < children.length {
                let child = self.collected.pattern_children[children.start + index]
                if !self.pattern_catches_all(child) {
                  complete = false
                }
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            complete
          }
          StructPattern(_, fields, _, _, _) => {
            let mut complete = true
            let _ = while 0u32 {
              index => if index < fields.length {
                let child = self.collected.pattern_fields[fields.start + index].pattern
                if !self.pattern_catches_all(child) {
                  complete = false
                }
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            complete
          }
          AlternativePattern(first, alternatives, _) => {
            let mut complete = self.pattern_catches_all(first)
            let _ = while 0u32 {
              index => if index < alternatives.length {
                let child = self.collected.pattern_children[alternatives.start + index]
                if self.pattern_catches_all(child) {
                  complete = true
                }
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            complete
          }
          _ => false
        }
        let valid = payload && !self.pattern_has_error(pattern)
        let index = self.pattern_index(pattern)
        self.pattern_payload_irrefutable[index] = valid
        let complete = match self.inferred.pattern_constructors[index] {
          ErrorBasicPatternConstructor => false
          SelectedBasicPatternConstructor(constructor, variant_payload, _) => {
            if self.collected.patterns[pattern] is StructPattern(_, _, _, _, _) && !variant_payload {
              valid
            } else {
              valid && self.variant_is_only_constructor(constructor, pattern)
            }
          }
          NoBasicPatternConstructor => match self.collected.patterns[pattern] {
            WildcardPattern(_), BindingPattern(_, _), RestPattern(_) => true
            ProductPattern(_, _), AlternativePattern(_, _, _) => valid
            _ => false
          }
        }
        self.pattern_irrefutable[index] = complete
        continue pattern + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn matrix_enum_variants(
    self,
    declaration: U64,
    seed: U64,
    work: SelfHostPatternCoverageWork,
  ) -> Option<Array<U64>> {
    if !work.spend(1u32) {
      return None
    }
    if self_host_semantic_id_module(declaration) == self.collected.module_id {
      let index = self_host_semantic_id_local(seed)
      if !work.spend(1u32) {
        return None
      }
      self_host_assert_compiler_invariant(index < self.collected.variants.length() && self.collected.variants[index].declaration == declaration, "PAT-104 matrix local enum seed")
      let mut start = index
      let _ = while start {
        current => if current > 0u32 {
          if !work.spend(1u32) {
            return None
          }
          if self.collected.variants[current - 1u32].declaration != declaration {
            break self_host_semantic_unit()
          }
          start = current - 1u32
          continue start
        } else {
          break self_host_semantic_unit()
        }
      }
      let mut end = index + 1u32
      let _ = while end {
        current => if current < self.collected.variants.length() {
          if !work.spend(1u32) {
            return None
          }
          if self.collected.variants[current].declaration != declaration {
            break self_host_semantic_unit()
          }
          end = current + 1u32
          continue end
        } else {
          break self_host_semantic_unit()
        }
      }
      if !work.spend(end - start) {
        return None
      }
      let variants = array_new::<U64>()
      let _ = while start {
        current => if current < end {
          variants.push(self.collected.variants[current].id)
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      return Some(variants)
    }
    match self.imported_variant_spans {
      Some(spans) => {
        let span = match spans.get(declaration) {
          Some(span) => span
          None => self_host_empty_hir_span(0u32)
        }
        if !work.spend(span.length) {
          return None
        }
        let variants = array_new::<U64>()
        let _ = while 0u32 {
          index => if index < span.length {
            variants.push(self.imported_variants[span.start + index].variant)
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        Some(variants)
      }
      None => {
        let variants = array_new::<U64>()
        let _ = while 0u32 {
          index => if index < self.imported_variants.length() {
            if !work.spend(1u32) {
              return None
            }
            let variant = self.imported_variants[index]
            if variant.declaration == declaration {
              if !work.spend(1u32) {
                return None
              }
              variants.push(variant.variant)
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        Some(variants)
      }
    }
  }

  fn matrix_domain(
    self,
    pattern: U32,
    work: SelfHostPatternCoverageWork,
  ) -> SelfHostFlowCoverageDomain {
    if !work.spend(1u32) {
      return OpenFlowCoverageDomain
    }
    match self.inferred.pattern_constructors[self.pattern_index(pattern)] {
      SelectedBasicPatternConstructor(constructor, variant_payload, _) => {
        if self.collected.patterns[pattern] is StructPattern(_, _, _, _, _) && !variant_payload {
          return OpenFlowCoverageDomain
        }
        if self_host_semantic_id_module(constructor) == self.collected.module_id {
          if !work.spend(1u32) {
            return OpenFlowCoverageDomain
          }
          let index = self_host_semantic_id_local(constructor)
          self_host_assert_compiler_invariant(index < self.collected.variants.length(), "PAT-102 matrix variant owner")
          return EnumFlowCoverageDomain(self.collected.variants[index].declaration)
        }
        let _ = while self.inferred.pattern_types[self.pattern_index(pattern)] {
          type_ => {
            if !work.spend(1u32) {
              return OpenFlowCoverageDomain
            }
            match self.inferred.type_term(type_) {
              BodyAppliedType(base, _) => continue base
              BodyResolvedType(resolved_type) => {
                let _ = while resolved_type {
                  current => {
                    if !work.spend(1u32) {
                      return OpenFlowCoverageDomain
                    }
                    match self.resolved.types[current] {
                      AppliedType(base, _) => continue base
                      NominalType(declaration) => return EnumFlowCoverageDomain(declaration)
                      _ => break self_host_semantic_unit()
                    }
                  }
                }
                break self_host_semantic_unit()
              }
              _ => break self_host_semantic_unit()
            }
          }
        }
        OpenFlowCoverageDomain
      }
      NoBasicPatternConstructor => match self.collected.patterns[pattern] {
        LiteralPattern(expression, _) => {
          if !work.spend(1u32) {
            return OpenFlowCoverageDomain
          }
          match self.collected.expressions[expression] {
            BoolExpr(_, _) => BoolFlowCoverageDomain
            _ => OpenFlowCoverageDomain
          }
        }
        _ => OpenFlowCoverageDomain
      }
      ErrorBasicPatternConstructor => OpenFlowCoverageDomain
    }
  }

  fn matrix_wildcard(self, pattern: U32) -> Bool {
    pattern == 4294967295u32 || self.pattern_catches_all(pattern)
  }

  fn matrix_copy_row(
    self,
    row: Array<U32>,
    head: Array<U32>,
    work: SelfHostPatternCoverageWork,
  ) -> Option<Array<U32>> {
    let length = head.length() + row.length() - 1u32
    if !work.spend(length + 1u32) {
      return None
    }
    let result = array_make_raw(length, 4294967295u32)
    let _ = while 0u32 {
      index => if index < head.length() {
        result[index] = head[index]
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let _ = while 1u32 {
      index => if index < row.length() {
        result[head.length() + index - 1u32] = row[index]
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Some(result)
  }

  fn matrix_children(
    self,
    pattern: U32,
    model: U32,
    work: SelfHostPatternCoverageWork,
  ) -> Option<Array<U32>> {
    match self.collected.patterns[model] {
      TuplePattern(_, children, _), ProductPattern(children, _) => {
        if !work.spend(children.length + 1u32) {
          return None
        }
        let _ = while 0u32 {
          index => if index < children.length {
            let child = self.collected.pattern_children[children.start + index]
            if self.collected.patterns[child] is RestPattern(_) {
              return None
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        if self.matrix_wildcard(pattern) {
          return Some(array_make_raw(children.length, 4294967295u32))
        }
        let actual = match self.collected.patterns[pattern] {
          TuplePattern(_, actual, _), ProductPattern(actual, _) => actual
          _ => return None
        }
        if actual.length != children.length {
          return None
        }
        let result = array_make_raw(children.length, 4294967295u32)
        let _ = while 0u32 {
          index => if index < actual.length {
            let child = self.collected.pattern_children[actual.start + index]
            if self.collected.patterns[child] is RestPattern(_) {
              return None
            }
            result[index] = child
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        Some(result)
      }
      StructPattern(_, fields, rest, _, _) => {
        if rest || !work.spend(fields.length + 1u32) {
          return None
        }
        if self.matrix_wildcard(pattern) {
          return Some(array_make_raw(fields.length, 4294967295u32))
        }
        let actual = match self.collected.patterns[pattern] {
          StructPattern(_, actual, _, _, _) => actual
          _ => return None
        }
        let result = array_make_raw(fields.length, 4294967295u32)
        let _ = while 0u32 {
          index => if index < fields.length {
            let name = self.collected.pattern_fields[fields.start + index].name
            let _ = while 0u32 {
              candidate => if candidate < actual.length {
                if !work.spend(1u32) {
                  return None
                }
                let field = self.collected.pattern_fields[actual.start + candidate]
                if field.name == name {
                  result[index] = field.pattern
                  break self_host_semantic_unit()
                }
                continue candidate + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        Some(result)
      }
      BindingPattern(_, _), QualifiedPattern(_, _, _) => Some([])
      _ => None
    }
  }

  fn matrix_struct_field_mutable(
    self,
    declaration: U64,
    name: U32,
    work: SelfHostPatternCoverageWork,
  ) -> Bool {
    if self_host_semantic_id_module(declaration) == self.collected.module_id {
      let _ = while 0u32 {
        index => if index < self.collected.fields.length() {
          if !work.spend(1u32) {
            return true
          }
          let field = self.collected.fields[index]
          if field.declaration == declaration && field.name == name {
            return field.mutable_
          }
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    } else {
      let _ = while 0u32 {
        index => if index < self.imported_fields.length() {
          if !work.spend(1u32) {
            return true
          }
          let field = self.imported_fields[index]
          if field.declaration == declaration && field.name == self.collected.name(name) {
            return field.mutable_
          }
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    true
  }

  fn matrix_stability(
    self,
    rows: Array<Array<U32>>,
    work: SelfHostPatternCoverageWork,
  ) -> (Bool, Bool) {
    let tasks = array_new::<U32>()
    for row in rows {
      if !work.spend(1u32) {
        return (true, true)
      }
      tasks.push(row[0u32])
    }
    let mut mutable_path = false
    let mut literal_call = false
    let _ = while tasks.length() {
      length => if length > 0u32 {
        if !work.spend(1u32) {
          return (true, true)
        }
        let pattern = tasks[length - 1u32]
        tasks.truncate(length - 1u32)
        match self.collected.patterns[pattern] {
          LiteralPattern(expression, _) => {
            if self.collected.expressions[expression] is StringExpr(_, _) {
              literal_call = true
            }
          }
          TuplePattern(_, children, _), ProductPattern(children, _) => {
            if !work.spend(children.length) {
              return (true, true)
            }
            let _ = while 0u32 {
              index => if index < children.length {
                tasks.push(self.collected.pattern_children[children.start + index])
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          StructPattern(_, fields, _, _, _) => {
            let _ = while 0u32 {
              index => if index < fields.length {
                if !work.spend(1u32) {
                  return (true, true)
                }
                let field = self.collected.pattern_fields[fields.start + index]
                if !self.matrix_wildcard(field.pattern) {
                  match self.inferred.pattern_constructors[self.pattern_index(pattern)] {
                    SelectedBasicPatternConstructor(declaration, false, _) => {
                      if self.matrix_struct_field_mutable(declaration, field.name, work) {
                        mutable_path = true
                      }
                    }
                    _ => {}
                  }
                }
                tasks.push(field.pattern)
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          AlternativePattern(first, alternatives, _) => {
            if !work.spend(alternatives.length + 1u32) {
              return (true, true)
            }
            tasks.push(first)
            let _ = while 0u32 {
              index => if index < alternatives.length {
                tasks.push(self.collected.pattern_children[alternatives.start + index])
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          _ => {}
        }
        continue tasks.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    (mutable_path, literal_call)
  }

  fn matrix_complete(
    self,
    input: Array<Array<U32>>,
    work: SelfHostPatternCoverageWork,
    depth: U32,
  ) -> Bool {
    if input.is_empty() {
      return false
    }
    if input[0u32].is_empty() {
      return true
    }
    if depth >= 64u32 || !work.spend(input.length() + 1u32) {
      work.exhausted = true
      return false
    }
    let rows = array_new::<Array<U32>>()
    let pending = input.copy()
    let _ = while pending.length() {
      length => if length > 0u32 {
        let row = pending[length - 1u32]
        pending.truncate(length - 1u32)
        if !work.spend(1u32) {
          return false
        }
        let pattern = row[0u32]
        let mut expanded = false
        if pattern != 4294967295u32 && !self.matrix_wildcard(pattern) {
          match self.collected.patterns[pattern] {
            AlternativePattern(first, alternatives, _) => {
              match self.matrix_copy_row(row, [first], work) {
                Some(next) => pending.push(next)
                None => return false
              }
              let _ = while 0u32 {
                index => if index < alternatives.length {
                  let alternative = self.collected.pattern_children[alternatives.start + index]
                  match self.matrix_copy_row(row, [alternative], work) {
                    Some(next) => pending.push(next)
                    None => return false
                  }
                  continue index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              expanded = true
            }
            _ => {}
          }
        }
        if !expanded {
          rows.push(row)
        }
        continue pending.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    let defaults = array_new::<Array<U32>>()
    let mut sample = 4294967295u32
    for row in rows {
      if !work.spend(1u32) {
        return false
      }
      self_host_assert_compiler_invariant(row.length() == input[0u32].length(), "PAT-101 coverage matrix row width")
      if self.matrix_wildcard(row[0u32]) {
        match self.matrix_copy_row(row, [], work) {
          Some(next) => defaults.push(next)
          None => return false
        }
      } else {
        sample = row[0u32]
      }
    }
    if !defaults.is_empty() && self.matrix_complete(defaults, work, depth + 1u32) {
      return true
    }
    if work.exhausted || sample == 4294967295u32 {
      return false
    }
    let domain = self.matrix_domain(sample, work)
    if work.exhausted {
      return false
    }
    match domain {
      BoolFlowCoverageDomain => {
        for value in [false, true] {
          let specialized = array_new::<Array<U32>>()
          for row in rows {
            if !work.spend(1u32) {
              return false
            }
            if self.matrix_wildcard(row[0u32]) || self.pattern_covers_bool(row[0u32], value) {
              match self.matrix_copy_row(row, [], work) {
                Some(next) => specialized.push(next)
                None => return false
              }
            }
          }
          if !self.matrix_complete(specialized, work, depth + 1u32) {
            return false
          }
        }
        true
      }
      EnumFlowCoverageDomain(declaration) => {
        let seed = match self.pattern_variant(sample) {
          Some(variant) => variant
          None => return false
        }
        let variants = match self.matrix_enum_variants(declaration, seed, work) {
          Some(variants) => variants
          None => return false
        }
        for variant in variants {
          let mut model = 4294967295u32
          for row in rows {
            if !work.spend(1u32) {
              return false
            }
            if row[0u32] != 4294967295u32 {
              match self.pattern_variant(row[0u32]) {
                Some(candidate) => if candidate == variant {
                  model = row[0u32]
                }
                None => {}
              }
            }
          }
          if model == 4294967295u32 {
            return false
          }
          let specialized = array_new::<Array<U32>>()
          for row in rows {
            if !work.spend(1u32) {
              return false
            }
            let matches_ = self.matrix_wildcard(row[0u32]) || match self.pattern_variant(row[0u32]) {
              Some(candidate) => candidate == variant
              None => false
            }
            if matches_ {
              let children = match self.matrix_children(row[0u32], model, work) {
                Some(children) => children
                None => return false
              }
              match self.matrix_copy_row(row, children, work) {
                Some(next) => specialized.push(next)
                None => return false
              }
            }
          }
          if !self.matrix_complete(specialized, work, depth + 1u32) {
            return false
          }
        }
        true
      }
      OpenFlowCoverageDomain => {
        let product = match self.collected.patterns[sample] {
          ProductPattern(_, _), StructPattern(_, _, _, _, _) => true
          _ => false
        }
        if !product {
          return false
        }
        let specialized = array_new::<Array<U32>>()
        for row in rows {
          if !work.spend(1u32) {
            return false
          }
          let children = match self.matrix_children(row[0u32], sample, work) {
            Some(children) => children
            None => return false
          }
          match self.matrix_copy_row(row, children, work) {
            Some(next) => specialized.push(next)
            None => return false
          }
        }
        self.matrix_complete(specialized, work, depth + 1u32)
      }
    }
  }
}

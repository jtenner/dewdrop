pub enum SelfHostPhysicalClosureOperand {
  ErasedClosureOperand
  LocalClosureOperand(U32)
  ForwardedClosureOperand(U32)
}

pub struct SelfHostPhysicalClosureCapturePlan {
  expression: U32
  capture: U32
  source: SelfHostLambdaCaptureSource
  erased: Bool
  field_index: U32
  storage: Option<SelfHostPlannedWasmStorageType>
  cell_type: U32
  operand: SelfHostPhysicalClosureOperand
}

pub struct SelfHostPhysicalClosureConstructionPlan {
  expression: U32
  lambda: U32
  physical_type: U32
  function_index: U32
  captures: SelfHostHirSpan
}

fn self_host_closure_recipe_check(condition: Bool, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, code: U32, expected: U64, actual: U64, detail: U64) -> Unit {
  if !condition {
    self_host_physical_scratch_failure(module_, body, expression, 6u32, code, expected, actual, detail)
  }
}

fn self_host_plan_closure_operand(module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, plan: SelfHostPlannedPhysicalBodyCarrierPlan, expression: U32, capture: SelfHostPhysicalCaptureAccessPlan) -> SelfHostPhysicalClosureOperand {
  let mut selected = None
  let detail = u32_into_u64(capture.capture)
  while 0u32 {
    index if index < body.locals.length => {
      let local = module_.locals[body.locals.start + index]
      if self_host_capture_source_is_local(capture.source, local) {
        self_host_closure_recipe_check(!(selected is Some(_)), module_, body, expression, 610u32, 1u64, 2u64, detail)
        let carrier = plan.local_values[index].carrier
        let erased = carrier is UnitBodyCarrier || carrier is NeverBodyCarrier
        self_host_closure_recipe_check(erased == capture.erased, module_, body, expression, 710u32, self_host_body_freeze_bool(capture.erased), self_host_body_freeze_bool(erased), detail)
        if erased {
          selected = Some(ErasedClosureOperand)
        } else if capture.cell_type != 4294967295u32 {
          let cell = match plan.capture_cells[index] {
            Some(value) => value
            None => self_host_physical_scratch_failure(module_, body, expression, 6u32, 610u32, 1u64, 0u64, detail)
          }
          self_host_closure_recipe_check(cell.type_index == capture.cell_type, module_, body, expression, 706u32, u32_into_u64(capture.cell_type), u32_into_u64(cell.type_index), detail)
          selected = Some(LocalClosureOperand(cell.local_slot))
        } else {
          let storage = match capture.field_storage {
            Some(value) => value
            None => self_host_physical_scratch_failure(module_, body, expression, 6u32, 610u32, 1u64, 0u64, detail)
          }
          let expected = self_host_body_carrier_from_storage(storage)
          self_host_closure_recipe_check(self_host_body_carrier_equal(carrier, expected), module_, body, expression, 705u32, self_host_body_carrier_code(expected), self_host_body_carrier_code(carrier), detail)
          let slot = plan.local_slots[index]
          self_host_closure_recipe_check(slot != 4294967295u32, module_, body, expression, 710u32, 1u64, 0u64, detail)
          selected = Some(LocalClosureOperand(slot))
        }
      }
      continue index + 1u32
    }
    _ => break ()
  }
  for outer in plan.capture_accesses {
    if self_host_lambda_capture_source_equal(outer.source, capture.source) {
      self_host_closure_recipe_check(!(selected is Some(_)), module_, body, expression, 610u32, 1u64, 2u64, detail)
      self_host_closure_recipe_check(outer.erased == capture.erased, module_, body, expression, 710u32, self_host_body_freeze_bool(capture.erased), self_host_body_freeze_bool(outer.erased), detail)
      self_host_closure_recipe_check(outer.cell_type == capture.cell_type, module_, body, expression, 706u32, u32_into_u64(capture.cell_type), u32_into_u64(outer.cell_type), detail)
      self_host_closure_recipe_check(self_host_body_freeze_storage(outer.field_storage) == self_host_body_freeze_storage(capture.field_storage), module_, body, expression, 710u32, self_host_body_freeze_storage(capture.field_storage), self_host_body_freeze_storage(outer.field_storage), detail)
      selected = Some(if capture.erased {
        ErasedClosureOperand
      } else {
        ForwardedClosureOperand(outer.capture)
      })
    }
  }
  match selected {
    Some(value) => value
    None => self_host_physical_scratch_failure(module_, body, expression, 6u32, 610u32, 1u64, 0u64, detail)
  }
}

fn self_host_build_closure_construction_recipes(link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, plan: SelfHostPlannedPhysicalBodyCarrierPlan, constructors: Array<SelfHostPhysicalClosureConstructionPlan>, operands: Array<SelfHostPhysicalClosureCapturePlan>) -> Unit {
  for expression in plan.expressions {
    match module_.expressions[expression.expression].kind {
      PlannedLambdaClosure(lambda) => {
        self_host_closure_recipe_check(self_host_lambda_construction_target_matches(link, plan, expression, lambda), module_, body, expression.expression, 701u32, 1u64, 0u64, u32_into_u64(lambda))
        let captures = self_host_plan_capture_accesses(link, module_, body, plan.module_index, plan.specialization, lambda)
        let start = operands.length()
        for capture in captures {
          let operand = self_host_plan_closure_operand(module_, body, plan, expression.expression, capture)
          self_host_closure_recipe_check(capture.closure_type == expression.selected_type_index, module_, body, expression.expression, 706u32, u32_into_u64(expression.selected_type_index), u32_into_u64(capture.closure_type), u32_into_u64(capture.capture))
          operands.push({
            expression: expression.expression
            capture: capture.capture
            source: capture.source
            erased: capture.erased
            field_index: capture.field_index
            storage: capture.field_storage
            cell_type: capture.cell_type
            operand: operand
          })
        }
        constructors.push({
          expression: expression.expression
          lambda: lambda
          physical_type: expression.selected_type_index
          function_index: expression.call_function_index
          captures: {
            start: start
            length: operands.length() - start
          }
        })
      }
      _ => {}
    }
  }
}

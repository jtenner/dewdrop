open dew.std.option
open dew.std.testing

test "default preamble resolves Option and Result without self imports" {
  let manifest = {
    modules: [
      {
        path: "dew.std.preamble"
        files: [{
          path: "core.dew"
          source: b""
          test_only: false
        }]
      },
      {
        path: "dew.std.option"
        files: [{
          path: "option.dew"
          source: b"pub enum Option<t> {\n  None\n  Some(t)\n}\n"
          test_only: false
        }]
      },
      {
        path: "dew.std.result"
        files: [{
          path: "result.dew"
          source: b"pub enum Result<t, e> {\n  Ok(t)\n  Err(e)\n}\n"
          test_only: false
        }]
      },
      {
        path: "app.main"
        files: [{
          path: "main.dew"
          source: b"pub fn maybe(value: Option<I32>) -> Option<I32> {\n  value\n}\npub fn result(value: Result<I32, Bool>) -> Result<I32, Bool> {\n  value\n}\n"
          test_only: false
        }]
      },
    ]
  }
  let enabled = self_host_manifest_with_default_preamble(manifest, true)
  let frozen = self_host_freeze_program_signature_interfaces(
    self_host_collect_program_manifest(5510u64, enabled),
  )
  assert(frozen.import_diagnostics.length() == 0u32, "default imports must resolve")
  assert(frozen.interfaces.at(3u32).resolved_diagnostic_count() == 0u32, "Option and Result signatures must resolve through default imports")
  assert(self_host_manifest_module_file_count(enabled.modules[0u32]) == 1u32, "preamble must not import itself")
  for module_index in [1u32, 2u32] {
    let imported = self_host_collect_program_manifest(5510u64, enabled).modules.at(module_index)
    assert(imported.imports.length() == 1u32, "Option and Result modules must only import the preamble")
  }
  assert(self_host_manifest_module_file(enabled.modules[3u32], 0u32).path == "main.dew", "default imports must retain original file identities")
  let disabled = self_host_manifest_with_default_preamble(manifest, false)
  assert(self_host_manifest_module_file_count(disabled.modules[3u32]) == 1u32, "disabled preamble must not add imports")
  let disabled_frozen = self_host_freeze_program_signature_interfaces(
    self_host_collect_program_manifest(5510u64, disabled),
  )
  assert(disabled_frozen.interfaces.at(3u32).resolved_diagnostic_count() > 0u32, "disabled defaults must require explicit imports")
  for selected in [0u32, 1u32, 2u32] {
    let modules = [manifest.modules[0u32]]
    if selected != 0u32 {
      modules.push(manifest.modules[selected])
    }
    modules.push(manifest.modules[3u32])
    let partial = self_host_manifest_with_default_preamble(
      {
        modules: modules
      },
      true,
    )
    let partial_frozen = self_host_freeze_program_signature_interfaces(
      self_host_collect_program_manifest(5510u64, partial),
    )
    assert(partial_frozen.import_diagnostics.length() == 0u32, "defaults must not import absent modules")
    assert(partial_frozen.path_diagnostics.length() == 0u32, "minimal manifests must keep valid import paths")
    let interface_ = partial_frozen.interfaces.at(modules.length() - 1u32)
    assert(interface_.resolved_diagnostic_count() > 0u32, "absent types must still report signature errors")
    let option_type = interface_.resolved_type_at(interface_.resolved_parameter_type(0u32))
    let result_type = interface_.resolved_type_at(interface_.resolved_parameter_type(1u32))
    assert((option_type is ErrorType) == (selected != 1u32), "only a present Option module supplies its default type")
    assert((result_type is ErrorType) == (selected != 2u32), "only a present Result module supplies its default type")
  }
  assert(self_host_manifest_module_file_count(manifest.modules[3u32]) == 1u32, "default preparation must not mutate the input")
}

test "program manifests assign deterministic module and file identities" {
  let program = self_host_collect_program_manifest(
    200u64,
    {
      modules: [
        {
          path: "app.first"
          files: [
            {
              path: "a.dew"
              source: b"pub struct First {}\n"
              test_only: false
            },
            {
              path: "b.dew"
              source: b"pub fn value() -> I32 {\n  1\n}\n"
              test_only: false
            },
          ]
        },
        {
          path: "app.second"
          files: [
            {
              path: "main.dew"
              source: b"pub struct Second {}\n"
              test_only: false
            },
          ]
        },
      ]
    },
  )
  assert(program.diagnostics.length() == 0u32, "manifest diagnostics")
  assert(program.modules.length() == 2u32, "module count")
  let first = program.modules.at(0u32)
  let second = program.modules.at(1u32)
  assert(self_host_u64_equal(first.module_id, 200u64), "first module ID")
  assert(self_host_u64_equal(second.module_id, 201u64), "second module ID")
  assert(
    self_host_u64_equal(
      first.file_at(0u32),
      self_host_make_file_id(200u64, 0u32),
    ),
    "first file ID",
  )
  assert(
    self_host_u64_equal(
      first.file_at(1u32),
      self_host_make_file_id(200u64, 1u32),
    ),
    "second file ID",
  )
}

test "program signature freezing resolves imported nominal signatures" {
  let program = self_host_collect_program_manifest(
    210u64,
    {
      modules: [
        {
          path: "app.consumer"
          files: [
            {
              path: "consumer.dew"
              source: b"open app.library\npub fn keep(value: Item<I32>) -> Item<I32> {\n  value\n}\n"
              test_only: false
            },
          ]
        },
        {
          path: "app.library"
          files: [
            {
              path: "library.dew"
              source: b"pub struct Item<t> {}\n"
              test_only: false
            },
          ]
        },
      ]
    },
  )
  let frozen = self_host_freeze_program_signature_interfaces(program)
  assert(frozen.path_diagnostics.length() == 0u32, "path diagnostics")
  assert(frozen.import_diagnostics.length() == 0u32, "import diagnostics")
  let consumer_interface = frozen.interfaces.at(0u32)
  assert(
    consumer_interface.resolved_diagnostic_count() == 0u32,
    "type diagnostics",
  )
  match consumer_interface.resolved_type_at(
    consumer_interface.resolved_parameter_type(0u32),
  ) {
    AppliedType(base, _) => match consumer_interface.resolved_type_at(
      base,
    ) {
      NominalType(declaration) => assert(
        self_host_semantic_id_module(declaration) == 211u64,
        "imported module identity",
      )
      _ => assert(false, "expected imported Item")
    }
    _ => assert(false, "expected applied Item")
  }
}

test "program signature freezing resolves transitive imported aliases" {
  let program = self_host_collect_program_manifest(
    215u64,
    {
      modules: [
        {
          path: "chain.consumer"
          files: [
            {
              path: "consumer.dew"
              source: b"open chain.alias\npub fn keep(value: Alias<U32>) -> Alias<U32> {\n  value\n}\n"
              test_only: false
            },
          ]
        },
        {
          path: "chain.alias"
          files: [
            {
              path: "alias.dew"
              source: b"open chain.storage\npub type Alias<t> = Cell<t>\n"
              test_only: false
            },
          ]
        },
        {
          path: "chain.storage"
          files: [
            {
              path: "storage.dew"
              source: b"pub struct Cell<t> {}\n"
              test_only: false
            },
          ]
        },
      ]
    },
  )
  let frozen = self_host_freeze_program_signature_interfaces(program)
  let consumer = frozen.interfaces.at(0u32)
  assert(consumer.resolved_diagnostic_count() == 0u32, "type diagnostics")
  match consumer.resolved_type_at(consumer.resolved_parameter_type(0u32)) {
    AppliedType(base, _) => match consumer.resolved_type_at(
      base,
    ) {
      NominalType(declaration) => assert(
        self_host_semantic_id_module(declaration) == 217u64,
        "transitive alias target",
      )
      _ => assert(false, "expected imported Cell")
    }
    _ => assert(false, "expected applied Cell")
  }
}

test "two-stage signature freezing resolves cyclic module types" {
  let program = self_host_collect_program_manifest(
    220u64,
    {
      modules: [
        {
          path: "cycle.a"
          files: [
            {
              path: "a.dew"
              source: b"open cycle.b\npub struct A {}\npub fn from_b(value: B) -> B {\n  value\n}\n"
              test_only: false
            },
          ]
        },
        {
          path: "cycle.b"
          files: [
            {
              path: "b.dew"
              source: b"open cycle.a\npub struct B {}\npub fn from_a(value: A) -> A {\n  value\n}\n"
              test_only: false
            },
          ]
        },
      ]
    },
  )
  let frozen = self_host_freeze_program_signature_interfaces(program)
  assert(frozen.import_diagnostics.length() == 0u32, "cycle import diagnostics")
  let a = frozen.interfaces.at(0u32)
  let b = frozen.interfaces.at(1u32)
  assert(a.resolved_diagnostic_count() == 0u32, "cycle A diagnostics")
  assert(b.resolved_diagnostic_count() == 0u32, "cycle B diagnostics")
  match a.resolved_type_at(a.resolved_parameter_type(0u32)) {
    NominalType(declaration) => assert(
      self_host_semantic_id_module(declaration) == 221u64,
      "A imported B",
    )
    _ => assert(false, "expected B in A")
  }
  match b.resolved_type_at(b.resolved_parameter_type(0u32)) {
    NominalType(declaration) => assert(
      self_host_semantic_id_module(declaration) == 220u64,
      "B imported A",
    )
    _ => assert(false, "expected A in B")
  }
}

test "program import diagnostics retain missing exact and wildcard paths" {
  let program = self_host_collect_program_manifest(
    230u64,
    {
      modules: [
        {
          path: "app.main"
          files: [
            {
              path: "main.dew"
              source: b"open missing.module\nopen missing.prefix.*\npub fn value() -> I32 {\n  1\n}\n"
              test_only: false
            },
          ]
        },
      ]
    },
  )
  let frozen = self_host_freeze_program_signature_interfaces(program)
  assert(frozen.path_diagnostics.length() == 2u32, "missing import count")
}

test "program manifests diagnose duplicate paths deterministically" {
  let program = self_host_collect_program_manifest(
    240u64,
    {
      modules: [
        {
          path: "app.same"
          files: [
            {
              path: "same.dew"
              source: b"pub struct First {}\n"
              test_only: false
            },
            {
              path: "same.dew"
              source: b"pub struct Second {}\n"
              test_only: false
            },
          ]
        },
        {
          path: "app.same"
          files: []
        },
      ]
    },
  )
  assert(program.diagnostics.length() == 2u32, "duplicate path count")
}

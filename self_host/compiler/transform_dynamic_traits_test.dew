open dew.std.map
open dew.std.option

test "dynamic transform traits preserve aliases and checked generic erasure" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntrait Answer {\n\n  fn answer(self) -> I32\n\n}\nstruct Counter {\n\n  mut value: I32\n\n}\nimpl Answer for Counter {\n\n  fn answer(self) -> I32 {\n\n    self.value = self.value + 1i32\n    self.value\n  \n}\n\n}\nimpl Answer for I32 {\n\n  fn answer(self) -> I32 {\n\n    self + 2i32\n  \n}\n\n}\nfn read(value: Answer) -> I32 {\n\n  value.answer()\n\n}\nfn erase<t: Answer>(value: t) -> Answer {\n\n  value\n\n}\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n\n  let counter = Counter::{\n\n    value: 18i32\n  \n}\n  let first = read(counter)\n  let erased = erase(counter)\n  let second = read(erased)\n  let third = read(20i32)\n  node.with_body(@ast.integer(if first == 19i32 && second == 20i32 && counter.value == 20i32 && third == 22i32 {\n\n    42i32\n  \n} else {\n\n    0i32\n  \n}))\n\n}\n#calculate\npub fn main() -> I32 {\n\n  0i32\n\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      let source = ct_test_all_source(expanded.modules[0u32])
      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "dynamic transform traits preserve slot and argument order" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntrait Pair {\n\n  fn first(self, amount: I32) -> I32\n  fn second(self, amount: I32) -> I32\n\n}\nstruct Counter {\n mut value: I32 \n}\nimpl Pair for Counter {\n\n  fn first(self, amount: I32) -> I32 {\n self.value = self.value + amount\n self.value \n}\n  fn second(self, amount: I32) -> I32 {\n self.value = self.value - amount\n self.value \n}\n\n}\nfn view(counter: Counter) -> Pair {\n counter.value = counter.value + 1i32\n counter \n}\nfn amount(counter: Counter) -> I32 {\n counter.value = counter.value * 2i32\n 2i32 \n}\nfn alias(value: Pair) -> Pair {\n  value\n}\nfn calculate_value(counter: Counter) -> I32 {\n\n  let a = view(counter).first(amount(counter))\n  let b = alias(counter)\n  let c = b.second(2i32)\n  if a == 42i32 && c == 40i32 && counter.value == 40i32 {\n 42i32 \n} else {\n 0i32 \n}\n\n}\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n\n  node.with_body(@ast.integer(calculate_value(Counter::{\n value: 19i32 \n})))\n\n}\n#calculate\npub fn main() -> I32 {\n\n  0i32\n\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      let source = ct_test_all_source(expanded.modules[0u32])
      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "dynamic transform traits survive explicit return branch and closure capture" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntrait Answer {\n fn answer(self) -> I32 \n}\nimpl Answer for I32 {\n fn answer(self) -> I32 {\n self \n} \n}\nfn erase(value: I32, choose: Bool) -> Answer {\n\n  if choose {\n return value \n}\n  value + 1i32\n\n}\nfn callback(value: Answer) -> fn() -> I32 {\n fn() -> I32 {\n value.answer() \n} \n}\nfn result() -> I32 {\n\n  let first = callback(erase(20i32, true))\n  let second = callback(erase(21i32, false))\n  first() + second()\n\n}\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n\n  node.with_body(@ast.integer(result()))\n\n}\n#calculate\npub fn main() -> I32 {\n\n  0i32\n\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      let source = ct_test_all_source(expanded.modules[0u32])
      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "dynamic transform traits retain generic implementation prerequisites" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntrait Answer {\n fn answer(self) -> I32 \n}\nimpl Answer for I32 {\n fn answer(self) -> I32 {\n self \n} \n}\nstruct Box<t> {\n value: t \n}\nimpl<t: Answer> Answer for Box<t> {\n fn answer(self) -> I32 {\n self.value.answer() \n} \n}\nfn read(value: Answer) -> I32 {\n value.answer() \n}\nfn erase<t: Answer>(value: t) -> Answer {\n value \n}\nfn result() -> I32 {\n read(erase(Box::{\n value: 42i32 \n})) \n}\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n\n  node.with_body(@ast.integer(result()))\n\n}\n#calculate\npub fn main() -> I32 {\n\n  0i32\n\n}\n"
        test_only: false
      }]
    }]

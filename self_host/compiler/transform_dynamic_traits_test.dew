fn ct_trait_bytecode_fixture(enabled: Bool) -> (CtMachine, SelfHostFunctionDeclaration) {
  let (machine, compute) = ct_bc_test_machine(b"fn compute(value: I32) -> I32 {\n read(value)\n}\nfn read(value: Answer) -> I32 {\n value.answer()\n}\ntrait Answer {\n fn answer(self) -> I32\n}\nimpl Answer for I32 {\n fn answer(self) -> I32 {\n self + 2i32\n }\n}\n", enabled)
  let file = machine.plan.files[0u32]
  let mut read = None
  let mut method = None
  for declaration in file.declarations {
    match declaration {
      Function(function) if function.name == "read" => {
        read = Some(function)
      }
      Impl(impl_) => {
        method = Some(impl_.methods[0u32])
      }
      _ => {}
    }
  }
  let read = match read {
    Some(value) => value
    None => unreachable()
  }
  let method = match method {
    Some(value) => value
    None => unreachable()
  }
  match compute.body.items[0u32].value {
    CallExpr(_, arguments, offset) => {
      machine.plan.calls.set(ct_site_key(machine.plan, 0u32, file.original.path, offset), CtCallTarget::Source(0u32, file.original.path, read, "I32"))
      let methods = map_empty::<U64, CtTraitMethod>()
      methods.set(123u64, {
        key: "12:0"
        target: CtCallTarget::Source(0u32, file.original.path, method, "")
      })
      machine.plan.trait_objects.set(ct_site_key(machine.plan, 0u32, file.original.path, arguments[0u32].offset()), {
        methods: methods
      })
    }
    _ => unreachable()
  }
  match read.body.items[0u32].value {
    CallExpr(_, _, offset) => machine.plan.calls.set(ct_site_key(machine.plan, 0u32, file.original.path, offset), CtCallTarget::DynamicTrait(123u64, "12:0", "I32"))
    _ => unreachable()
  }
  (machine, compute)
}

test "dynamic transform bytecode and tree keep the same charges" {
  let (tree, tree_fn) = ct_trait_bytecode_fixture(false)
  let (vm, vm_fn) = ct_trait_bytecode_fixture(true)
  assert(ct_compile_bytecode(vm, 0u32, vm_fn) is Some(_), "the trait case must execute bytecode")
  let left = ct_source_call(tree, 0u32, tree.file_path, tree_fn, [ct_number(40u64, "I32")])
  let right = ct_source_call(vm, 0u32, vm.file_path, vm_fn, [ct_number(40u64, "I32")])
  assert(tree.error.byte_length() == 0u32, tree.error)
  assert(vm.error.byte_length() == 0u32, vm.error)
  assert(ct_raw_bits(tree, left) == 42u64, "tree result")
  assert(ct_raw_bits(vm, right) == 42u64, "bytecode result")
  assert(tree.steps == vm.steps, "same logical work")
  assert(tree.allocated == vm.allocated, "same allocation work")
  assert(tree.depth == 0u32 && vm.depth == 0u32, "both paths restore depth")
}

test "dynamic transform values keep envelope identity and reject a wrong slot" {
  let (machine, _) = ct_trait_bytecode_fixture(false)
  let methods = map_empty::<U64, CtTraitMethod>()
  methods.set(123u64, {
    key: "12:0"
    target: CtCallTarget::Unsupported
  })
  let proof = CtTraitObjectProof::{
    methods: methods
  }
  let receiver = ct_number(40u64, "I32")
  let first = ct_trait_object(machine, receiver, proof)
  let second = ct_trait_object(machine, receiver, proof)
  assert(ct_reference_equal(machine, first, first) is Boolean(true), "alias identity")
  assert(ct_reference_equal(machine, first, second) is Boolean(false), "separate envelope identity")
  assert(!ct_reference_is_null(machine, first), "non-null trait value")
  let _ = ct_dynamic_trait_call(machine, 123u64, "12:1", "I32", [first])
  assert(machine.error == "checked dynamic trait method slot mismatch", machine.error)
}


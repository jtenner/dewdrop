      path: "traits.helper"
      files: [{
        path: "helper.dew"
        source: b"pub trait Answer {\n  fn answer(self) -> I32\n}\npub struct Box<t> {\n  value: t\n}\nimpl Answer for I32 {\n  fn answer(self) -> I32 {\n    self\n  }\n}\nimpl<t: Answer> Answer for Box<t> {\n  fn answer(self) -> I32 {\n    self.value.answer()\n  }\n}\npub fn erase<t: Answer>(value: t) -> Answer {\n  value\n}\npub fn value() -> Answer {\n  erase(Box::{\n    value: 42i32\n  })\n}\n"

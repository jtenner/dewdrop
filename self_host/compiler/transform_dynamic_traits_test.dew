    Ok(expanded) => {
      let source = ct_test_all_source(expanded.modules[0u32])
      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "dynamic transform traits reject generic methods" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "main.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntrait Bad {\n fn answer<t>(self, value: t) -> I32 \n}\nimpl Bad for I32 {\n fn answer<t>(self, value: t) -> I32 {\n self \n} \n}\nfn read(value: Bad) -> I32 {\n value.answer(1i32) \n}\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n node.with_body(@ast.integer(read(42i32))) \n}\n#calculate\npub fn main() -> I32 {\n 0i32 \n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Ok(expanded) => {
      assert(false, "unsafe dynamic method must fail checking")
    }
    Err(error) => assert(error.contains("no matching method"), error)
  }
}


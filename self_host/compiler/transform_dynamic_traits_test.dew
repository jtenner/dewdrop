      assert(source.contains("pub fn main() -> I32 {\n42i32\n}"), source)
    }
    Err(error) => assert(false, error)
  }
}

test "dynamic transform runtime trait conversions cannot erase a reference silently" {
  let lowering = self_host_type_demand_test_lowering(b"trait Answer {\n fn answer(self) -> I32\n}\nstruct Box {\n value: I32\n}\nimpl Answer for Box {\n fn answer(self) -> I32 {\n self.value\n }\n}\nbuiltin same<a,b>(left: a, right: b) -> Bool = \"ref.eq\"\nfn erase(value: Box) -> Answer {\n value\n}\npub fn main() -> I32 {\n let box = Box::{\n value: 42i32\n }\n if same(erase(box), box) {\n 1i32\n } else {\n 42i32\n }\n}\n")
  let link = self_host_plan_program_wasmgc_link(self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, false)), false)
  match build_self_host_linked_i32_module(link, lowering.modules[0u32].module_id) {
    Ok(_) => assert(false, "a runtime conversion must not return the original receiver")
    Err(error) => assert(error.contains("runtime trait objects"), error)
  }
}

test "dynamic transform runtime roots omit private compile-time helpers" {
  let lowering = self_host_type_demand_test_lowering(b"trait Answer {\n fn answer(self) -> I32\n}\nfn read(value: Answer) -> I32 {\n value.answer()\n}\npub fn main() -> I32 {\n 42i32\n}\n")
  let plan = self_host_plan_program_runtime_specialization(lowering, 0u32, false)
  let fragments = self_host_plan_program_wasmgc_fragments(plan)
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let mut omitted = false
  for function in fragments.modules[0u32].functions {
    for callable in lowering.modules[0u32].functions.callables {
      if function.declaration == callable.declaration && callable.name.equals(b"read") {
        omitted = function.elided
      }
    }
  }
  assert(omitted, "unused private helper has no runtime function")
  match build_self_host_linked_i32_module(link, lowering.modules[0u32].module_id) {
    Ok(bytes) => assert(bytes.byte_length() > 8u32, "runtime output")
    Err(error) => assert(false, error)
  }
}

test "dynamic transform runtime roots retain private calls and unread initializers" {
  let lowering = self_host_type_demand_test_lowering(b"struct Payload {\n value: I32\n}\nfn make() -> Payload {\n Payload::{\n value: 1i32\n }\n}\nlet unread = make()\nfn answer() -> I32 {\n 42i32\n}\npub fn main() -> I32 {\n answer()\n}\n")
  let plan = self_host_plan_program_runtime_specialization(lowering, 0u32, false)
  let fragments = self_host_plan_program_wasmgc_fragments(plan)
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  assert(link.initializers.length() > 0u32, "unread initializer is retained")
  for name in [b"make", b"answer"] {
    let mut live = false
    for function in fragments.modules[0u32].functions {
      for callable in lowering.modules[0u32].functions.callables {
        if function.declaration == callable.declaration && callable.name.equals(name) {
          live = !function.elided
        }
      }
    }
    assert(live, "checked private call is retained")
  }
  match build_self_host_linked_i32_module(link, lowering.modules[0u32].module_id) {
    Ok(bytes) => assert(bytes.byte_length() > 8u32, "runtime output")
    Err(error) => assert(false, error)
  }
}

test "dynamic transform runtime roots retain a private main entry" {
  let lowering = self_host_type_demand_test_lowering(b"fn main() -> I32 {\n 42i32\n}\n")
  let plan = self_host_plan_program_runtime_specialization(lowering, 0u32, false)
  let link = self_host_plan_program_wasmgc_link(self_host_plan_program_wasmgc_fragments(plan), false)
  assert(self_host_linked_i32_main_function_index(link, lowering.modules[0u32].module_id) != 4294967295u32, "private main remains the checked entry point")
  match build_self_host_linked_i32_module(link, lowering.modules[0u32].module_id) {
    Ok(bytes) => assert(bytes.byte_length() > 8u32, "private entry output")
    Err(error) => assert(false, error)
  }
}

test "dynamic transform runtime roots omit unused nested lambda code and storage" {
  let lowering = self_host_type_demand_test_lowering(b"builtin add(left: I32, right: I32) -> I32 = \"i32.add\"\nfn make() -> fn(I32) -> I32 {\n let mut count = 0i32\n fn(value: I32) -> I32 {\n count = add(count, 1i32)\n add(value, count)\n }\n}\npub fn main() -> I32 {\n 42i32\n}\n")
  let plan = self_host_plan_program_runtime_specialization(lowering, 0u32, false)
  let fragments = self_host_plan_program_wasmgc_fragments(plan)
  for function in fragments.modules[0u32].functions {
    assert(!(function.kind is PlannedWasmDefinedLambdaFunction(_)), "unused lambda code is omitted")
  }
  for type_ in fragments.modules[0u32].physical_types {
    assert(!(type_.kind is PlannedWasmCaptureCellType(_, _)) && !(type_.kind is PlannedWasmLambdaClosureType(_, _)), "unused capture storage is omitted")
  }
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  match build_self_host_linked_i32_module(link, lowering.modules[0u32].module_id) {
    Ok(bytes) => assert(bytes.byte_length() > 8u32, "runtime output")
    Err(error) => assert(false, error)
  }
}

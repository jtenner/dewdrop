open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.string
open dew.std.string_builder

fn self_host_empty_strings() -> Array<String> {
  Array::new()
}

fn self_host_no_string() -> Option<String> {
  Option::None
}

fn self_host_empty_foreign_members() -> Array<SelfHostForeignLibraryMember> {
  Array::new()
}

fn self_host_empty_parse_events() -> Array<SelfHostParseEvent> {
  Array::new()
}

fn self_host_parse_import_after_keyword(
  parser: SelfHostParser,
  open_: Bool,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let path = self_host_empty_strings()
  let path_builder = StringBuilder::new()
  let mut path_count = 0u32
  let mut default_alias = ""
  let mut wildcard = false
  let path_ok = while 0u32 {
    _ => {
      match self_host_parser_peek(parser) {
        Option::Some(token) => match token.kind {
          SelfHostTokenKind::Identifier(segment, _) => {
            if path_count > 0u32 {
              path_builder.append(".")
            }
            path_builder.append(segment)
            default_alias = segment
            path_count = path_count + 1u32
            path.push(segment)
            parser.index = parser.index + 1u32
          }
          SelfHostTokenKind::Keyword(keyword_code, _) if keyword_code == 32u32 => {
            if path_count > 0u32 {
              path_builder.append(".")
            }
            path_builder.append("package")
            default_alias = "package"
            path_count = path_count + 1u32
            path.push("package")
            parser.index = parser.index + 1u32
          }
          _ => {
            self_host_parser_fail_expected(
              parser,
              SelfHostDeclarationExpectation::ImportPathSegment,
            )
            break false
          }
        }
        Option::None => {
          self_host_parser_fail_expected(
            parser,
            SelfHostDeclarationExpectation::ImportPathSegment,
          )
          break false
        }
      }
      if self_host_parser_consume_symbol(parser, 27u32) {
        if self_host_parser_consume_symbol(parser, 9u32) {
          wildcard = true
          break true
        } else {
          continue 0u32
        }
      } else {
        break true
      }
    }
  }
  if !path_ok {
    return Option::None
  } else {
  }
  let mut import_alias = self_host_no_string()
  let mut import_alias_offset = declaration_offset
  if self_host_parser_consume_keyword(parser, 26u32) {
    if wildcard || open_ {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::ImportAlias,
      )
      return Option::None
    } else {
    }
    match self_host_parser_peek(parser) {
      Option::Some(token) => match token.kind {
        SelfHostTokenKind::AtIdentifier(name, _, _) => {
          parser.index = parser.index + 1u32
          import_alias = Option::Some(name)
          import_alias_offset = token.offset
        }
        _ => {
          self_host_parser_fail_expected(
            parser,
            SelfHostDeclarationExpectation::ImportAlias,
          )
          return Option::None
        }
      }
      Option::None => {
        self_host_parser_fail_expected(
          parser,
          SelfHostDeclarationExpectation::ImportAlias,
        )
        return Option::None
      }
    }
  } else {
  }
  if wildcard && !open_ {
    self_host_parser_fail_expected(
      parser,
      SelfHostDeclarationExpectation::ImportWildcard,
    )
    return Option::None
  } else if !self_host_parser_finish_line(parser) {
    return Option::None
  } else {
  }
  Option::Some(
    SelfHostDeclaration::Import(SelfHostImportDeclaration::{
      open_: open_
      path: path
      joined_path: path_builder.finish()
      default_alias: default_alias
      segment_count: u32_into_u64(path_count)
      wildcard: wildcard
      import_alias: import_alias
      import_alias_offset: import_alias_offset
      offset: declaration_offset
    }),
  )
}

fn self_host_parse_plain_parameters(
  parser: SelfHostParser,
) -> Option<Array<SelfHostFnParameter>> {
  match self_host_parse_function_parameters(parser, false) {
    Option::Some(parsed) => {
      let (_, parameters) = parsed
      Option::Some(parameters)
    }
    Option::None => Option::None
  }
}

fn self_host_parse_builtin_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    SelfHostDeclarationExpectation::BuiltinName,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    0u32,
    SelfHostDeclarationExpectation::LeftParen,
  ) {
    return Option::None
  } else {
  }
  let parameters = match self_host_parse_plain_parameters(parser) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    31u32,
    SelfHostDeclarationExpectation::Arrow,
  ) {
    return Option::None
  } else {
  }
  let return_type = match self_host_parse_type(parser) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    15u32,
    SelfHostDeclarationExpectation::Equal,
  ) {
    return Option::None
  } else {
  }
  let builtin_name = match self_host_parser_peek(parser) {
    Option::Some(token) => match token.kind {
      SelfHostTokenKind::StringLiteral(value) => {
        parser.index = parser.index + 1u32
        value
      }
      _ => {
        self_host_parser_fail_expected(
          parser,
          SelfHostDeclarationExpectation::BuiltinString,
        )
        return Option::None
      }
    }
    Option::None => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::BuiltinString,
      )
      return Option::None
    }
  }
  if !self_host_parser_finish_line(parser) {
    Option::None
  } else {
    Option::Some(
      SelfHostDeclaration::Builtin(SelfHostBuiltinDeclaration::{
        visibility: visibility
        name: name
        name_offset: name_offset
        type_parameters: type_parameters
        parameters: parameters
        return_type: return_type
        builtin_name: builtin_name
        offset: declaration_offset
      }),
    )
  }
}

fn self_host_parse_let_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let mutable_ = self_host_parser_consume_keyword(
    parser,
    13u32,
  )
  let pair = match self_host_parser_identifier(
    parser,
    SelfHostDeclarationExpectation::BindingName,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let (name, name_offset) = pair
  if !self_host_parser_expect_symbol(
    parser,
    15u32,
    SelfHostDeclarationExpectation::Equal,
  ) {
    return Option::None
  } else {
  }
  let value = match self_host_parse_expression_context(parser, 0u32, false) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  if !self_host_parser_finish_line(parser) {
    Option::None
  } else {
    Option::Some(SelfHostDeclaration::Let(SelfHostLetDeclaration::{
      visibility: visibility
      mutable_: mutable_
      name: name
      name_offset: name_offset
      value: value
      offset: declaration_offset
    }))
  }
}

fn self_host_parse_trait_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    SelfHostDeclarationExpectation::TraitName,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    SelfHostDeclarationExpectation::LeftBrace,
  ) {
    return Option::None
  } else {
  }
  let methods = self_host_empty_trait_methods()
  if !self_host_parser_consume_symbol(parser, 3u32) {
    if !self_host_parser_expect_newline(
      parser,
      SelfHostDeclarationExpectation::TraitBodyNewline,
    ) {
      return Option::None
    } else {
    }
    self_host_parser_skip_newlines(parser)
    let parsed = while 0u32 {
      _ => {
        if self_host_parser_consume_symbol(
          parser,
          3u32,
        ) {
          break true
        } else {
        }
        let method_offset = self_host_parser_offset(parser)
        if !self_host_parser_expect_keyword(
          parser,
          0u32,
          SelfHostDeclarationExpectation::TraitMethodKeyword,
        ) {
          break false
        } else {
        }
        let method_pair = match self_host_parser_identifier(
          parser,
          SelfHostDeclarationExpectation::TraitMethodName,
        ) {
          Option::Some(value) => value
          Option::None => break false
        }
        let (method_name, method_name_offset) = method_pair
        let method_type_parameters = match self_host_parse_optional_type_parameters(
          parser,
        ) {
          Option::Some(value) => value
          Option::None => break false
        }
        if !self_host_parser_expect_symbol(
          parser,
          0u32,
          SelfHostDeclarationExpectation::LeftParen,
        ) {
          break false
        } else {
        }
        let parsed_parameters = match self_host_parse_function_parameters(
          parser,
          true,
        ) {
          Option::Some(value) => value
          Option::None => break false
        }
        let (receiver, parameters) = parsed_parameters
        if !self_host_parser_expect_symbol(
          parser,
          31u32,
          SelfHostDeclarationExpectation::Arrow,
        ) {
          break false
        } else {
        }
        let return_type = match self_host_parse_type(parser) {
          Option::Some(value) => value
          Option::None => break false
        }
        if !self_host_parser_consume_newline(parser) {
          self_host_parser_fail_expected(
            parser,
            SelfHostDeclarationExpectation::LineEnd,
          )
          break false
        } else {
        }
        methods.push(SelfHostTraitMethod::{
          name: method_name
          name_offset: method_name_offset
          type_parameters: method_type_parameters
          receiver: receiver
          parameters: parameters
          return_type: return_type
          offset: method_offset
        })
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
    }
    if !parsed {
      return Option::None
    } else {
    }
  } else {
  }
  if !self_host_parser_finish_line(parser) {
    Option::None
  } else {
    Option::Some(
      SelfHostDeclaration::Trait(SelfHostTraitDeclaration::{
        visibility: visibility
        name: name
        name_offset: name_offset
        type_parameters: type_parameters
        methods: methods
        offset: declaration_offset
      }),
    )
  }
}

fn self_host_parse_foreign_type(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    SelfHostDeclarationExpectation::ForeignTypeName,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let (name, name_offset) = pair
  if !self_host_parser_finish_line(parser) {
    Option::None
  } else {
    Option::Some(
      SelfHostDeclaration::ForeignType(SelfHostForeignTypeDeclaration::{
        visibility: visibility
        name: name
        name_offset: name_offset
        offset: declaration_offset
      }),
    )
  }
}

fn self_host_parse_foreign_library(
  parser: SelfHostParser,
  declaration_offset: U32,
) -> Option<SelfHostDeclaration> {
  let logical_token = match self_host_parser_peek(parser) {
    Option::Some(value) => value
    Option::None => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::ForeignLibraryName,
      )
      return Option::None
    }
  }
  let logical_name = match logical_token.kind {
    SelfHostTokenKind::StringLiteral(value) => {
      parser.index = parser.index + 1u32
      value
    }
    _ => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::ForeignLibraryName,
      )
      return Option::None
    }
  }
  if !self_host_parser_expect_keyword(
    parser,
    26u32,
    SelfHostDeclarationExpectation::ForeignLibraryAlias,
  ) {
    return Option::None
  } else {
  }
  let alias_pair = match self_host_parser_identifier(
    parser,
    SelfHostDeclarationExpectation::ForeignLibraryAlias,
  ) {
    Option::Some(value) => value
    Option::None => {
      return Option::None
    }
  }
  let (namespace_alias, alias_offset) = alias_pair
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    SelfHostDeclarationExpectation::LeftBrace,
  ) {
    return Option::None
  } else {
  }
  let members = self_host_empty_foreign_members()
  if !self_host_parser_consume_symbol(parser, 3u32) {
    if !self_host_parser_expect_newline(
      parser,
      SelfHostDeclarationExpectation::FunctionBodyNewline,
    ) {
      return Option::None
    } else {
    }
    self_host_parser_skip_newlines(parser)
    let parsed = while 0u32 {
      _ => {
        if self_host_parser_consume_symbol(
          parser,
          3u32,
        ) {
          break true
        } else {
        }
        let member_offset = self_host_parser_offset(parser)
        let visibility = if self_host_parser_consume_keyword(
          parser,
          2u32,
        ) {
          if !self_host_parser_expect_keyword(
            parser,
            0u32,
            SelfHostDeclarationExpectation::ForeignLibraryMemberKeyword,
          ) {
            break false
          } else {
          }
          SelfHostDeclarationVisibility::Public
        } else {
          if !self_host_parser_expect_keyword(
            parser,
            0u32,
            SelfHostDeclarationExpectation::ForeignLibraryMemberKeyword,
          ) {
            break false
          } else {
          }
          SelfHostDeclarationVisibility::ModuleVisible
        }
        let member_pair = match self_host_parser_identifier(
          parser,
          SelfHostDeclarationExpectation::FunctionName,
        ) {
          Option::Some(value) => value
          Option::None => break false
        }
        let (member_name, member_name_offset) = member_pair
        if self_host_parser_at_symbol(parser, 29u32) {
          self_host_parser_fail(
            parser,
            SelfHostParseError::GenericForeignLibraryMemberNotAllowed(
              self_host_parser_offset(parser),
            ),
          )
          break false
        } else if !self_host_parser_expect_symbol(
          parser,
          0u32,
          SelfHostDeclarationExpectation::LeftParen,
        ) {
          break false
        } else {
        }
        let parameters = match self_host_parse_plain_parameters(parser) {
          Option::Some(value) => value
          Option::None => break false
        }
        if !self_host_parser_expect_symbol(
          parser,
          31u32,
          SelfHostDeclarationExpectation::Arrow,
        ) {
          break false
        } else {
        }
        let return_type = match self_host_parse_type(parser) {
          Option::Some(value) => value
          Option::None => break false
        }
        if self_host_parser_at_symbol(parser, 2u32) {
          self_host_parser_fail(
            parser,
            SelfHostParseError::ForeignLibraryMemberBodyNotAllowed(
              self_host_parser_offset(parser),
            ),
          )
          break false
        } else if !self_host_parser_expect_symbol(
          parser,
          15u32,
          SelfHostDeclarationExpectation::Equal,
        ) {
          break false
        } else {
        }
        let export_token = match self_host_parser_peek(parser) {
          Option::Some(value) => value
          Option::None => {
            self_host_parser_fail_expected(
              parser,
              SelfHostDeclarationExpectation::ForeignLibraryExportName,
            )
            break false
          }
        }
        let export_name = match export_token.kind {
          SelfHostTokenKind::StringLiteral(value) => {
            parser.index = parser.index + 1u32
            value
          }
          _ => {
            self_host_parser_fail_expected(
              parser,
              SelfHostDeclarationExpectation::ForeignLibraryExportName,
            )
            break false
          }
        }
        if !self_host_parser_finish_line(parser) {
          break false
        } else {
        }
        members.push(SelfHostForeignLibraryMember::{
          visibility: visibility
          name: member_name
          name_offset: member_name_offset
          parameters: parameters
          return_type: return_type
          export_name: export_name
          export_name_offset: export_token.offset
          offset: member_offset
        })
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
    }
    if !parsed {
      return Option::None
    } else {
    }
  } else {
  }
  if !self_host_parser_finish_line(parser) {
    Option::None
  } else {
    Option::Some(
      SelfHostDeclaration::ForeignLibrary(
        SelfHostForeignLibraryDeclaration::{
          logical_name: logical_name
          logical_name_offset: logical_token.offset
          namespace_alias: namespace_alias
          alias_offset: alias_offset
          members: members
          offset: declaration_offset
        },
      ),
    )
  }
}

fn self_host_parse_declaration(
  parser: SelfHostParser,
) -> Option<SelfHostDeclaration> {
  self_host_parser_skip_newlines(parser)
  let mut visibility = SelfHostDeclarationVisibility::ModuleVisible
  let mut declaration_offset = self_host_parser_offset(parser)
  match self_host_parser_peek(parser) {
    Option::Some(token) => match self_host_token_keyword_code(token.kind) {
      29u32 => {
        parser.last_declaration_kind = 0u32
        parser.index = parser.index + 1u32
        return self_host_parse_import_after_keyword(
          parser,
          true,
          token.offset,
        )
      }
      30u32 => {
        parser.last_declaration_kind = 0u32
        parser.index = parser.index + 1u32
        return self_host_parse_import_after_keyword(
          parser,
          false,
          token.offset,
        )
      }
      2u32 => {
        parser.index = parser.index + 1u32
        visibility = SelfHostDeclarationVisibility::Public
        declaration_offset = token.offset
      }
      _ => {}
    }
    Option::None => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::DeclarationKeyword,
      )
      return Option::None
    }
  }
  let token = match self_host_parser_peek(parser) {
    Option::Some(value) => value
    Option::None => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::DeclarationKeyword,
      )
      return Option::None
    }
  }
  match self_host_token_keyword_code(token.kind) {
    3u32 => {
      parser.last_declaration_kind = 1u32
      parser.index = parser.index + 1u32
      self_host_parse_builtin_after_keyword(
        parser,
        visibility,
        declaration_offset,
      )
    }
    11u32 => {
      parser.last_declaration_kind = 2u32
      parser.index = parser.index + 1u32
      self_host_parse_let_after_keyword(
        parser,
        visibility,
        declaration_offset,
      )
    }
    6u32 => {
      parser.last_declaration_kind = 3u32
      parser.index = parser.index + 1u32
      self_host_parse_trait_after_keyword(
        parser,
        visibility,
        declaration_offset,
      )
    }
    9u32 => {
      parser.last_declaration_kind = 9u32
      parser.index = parser.index + 1u32
      match self_host_parse_struct_after_keyword(
        parser,
        visibility,
        declaration_offset,
      ) {
        Option::Some(value) =>
          Option::Some(SelfHostDeclaration::Struct(value))
        Option::None => Option::None
      }
    }
    8u32 => {
      parser.last_declaration_kind = 10u32
      parser.index = parser.index + 1u32
      match self_host_parse_enum_after_keyword(
        parser,
        visibility,
        declaration_offset,
      ) {
        Option::Some(value) =>
          Option::Some(SelfHostDeclaration::Enum(value))
        Option::None => Option::None
      }
    }
    10u32 => {
      parser.last_declaration_kind = 11u32
      parser.index = parser.index + 1u32
      match self_host_parse_type_alias_after_keyword(
        parser,
        visibility,
        declaration_offset,
      ) {
        Option::Some(value) =>
          Option::Some(SelfHostDeclaration::TypeAlias(value))
        Option::None => Option::None
      }
    }
    0u32 => {
      parser.last_declaration_kind = 4u32
      parser.index = parser.index + 1u32
      match self_host_parse_function_after_keyword(
        parser,
        visibility,
        declaration_offset,
      ) {
        Option::Some(value) =>
          Option::Some(SelfHostDeclaration::Function(value))
        Option::None => Option::None
      }
    }
    1u32 => {
      parser.last_declaration_kind = 5u32
      if visibility is SelfHostDeclarationVisibility::Public {
        self_host_parser_fail_expected(
          parser,
          SelfHostDeclarationExpectation::DeclarationKeyword,
        )
        Option::None
      } else {
        parser.index = parser.index + 1u32
        match self_host_parse_test_after_keyword(parser, declaration_offset) {
          Option::Some(value) =>
            Option::Some(SelfHostDeclaration::Test(value))
          Option::None => Option::None
        }
      }
    }
    5u32 => {
      parser.last_declaration_kind = 6u32
      if visibility is SelfHostDeclarationVisibility::Public {
        self_host_parser_fail(
          parser,
          SelfHostParseError::PublicImplNotAllowed(declaration_offset),
        )
        Option::None
      } else {
        parser.index = parser.index + 1u32
        match self_host_parse_impl_after_keyword(
          parser,
          false,
          declaration_offset,
        ) {
          Option::Some(value) =>
            Option::Some(SelfHostDeclaration::Impl(value))
          Option::None => Option::None
        }
      }
    }
    4u32 => {
      parser.index = parser.index + 1u32
      if self_host_parser_consume_keyword(parser, 10u32) {
        parser.last_declaration_kind = 7u32
        self_host_parse_foreign_type(
          parser,
          visibility,
          declaration_offset,
        )
      } else if self_host_parser_consume_keyword(
        parser,
        5u32,
      ) {
        match self_host_parser_peek(parser) {
          Option::Some(next) => match next.kind {
            SelfHostTokenKind::StringLiteral(_) => if visibility is SelfHostDeclarationVisibility::Public {
              self_host_parser_fail(
                parser,
                SelfHostParseError::PublicForeignLibraryNotAllowed(
                  declaration_offset,
                ),
              )
              Option::None
            } else {
              parser.last_declaration_kind = 8u32
              self_host_parse_foreign_library(parser, declaration_offset)
            }
            _ => if visibility is SelfHostDeclarationVisibility::Public {
              self_host_parser_fail(
                parser,
                SelfHostParseError::PublicImplNotAllowed(
                  declaration_offset,
                ),
              )
              Option::None
            } else {
              parser.last_declaration_kind = 6u32
              match self_host_parse_impl_after_keyword(
                parser,
                true,
                declaration_offset,
              ) {
                Option::Some(value) =>
                  Option::Some(SelfHostDeclaration::Impl(value))
                Option::None => Option::None
              }
            }
          }
          Option::None => {
            self_host_parser_fail_expected(
              parser,
              SelfHostDeclarationExpectation::DeclarationKeyword,
            )
            Option::None
          }
        }
      } else {
        self_host_parser_fail_expected(
          parser,
          SelfHostDeclarationExpectation::DeclarationKeyword,
        )
        Option::None
      }
    }
    _ => {
      self_host_parser_fail_expected(
        parser,
        SelfHostDeclarationExpectation::DeclarationKeyword,
      )
      Option::None
    }
  }
}

fn self_host_token_starts_declaration(token: SelfHostToken) -> Bool {
  let keyword = self_host_token_keyword_code(token.kind)
  keyword == 2u32 || keyword == 29u32 || keyword == 30u32 ||
    keyword == 3u32 || keyword == 11u32 || keyword == 6u32 ||
    keyword == 9u32 || keyword == 8u32 || keyword == 10u32 ||
    keyword == 0u32 || keyword == 1u32 || keyword == 5u32 ||
    keyword == 4u32
}

fn self_host_parser_recover_declaration(parser: SelfHostParser) -> Unit {
  let mut braces = 0u32
  let mut parentheses = 0u32
  let mut brackets = 0u32
  let _ = while 0u32 {
    _ => match self_host_parser_take(parser) {
      Option::Some(token) => {
        match token.kind {
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 2u32 => {
            braces = braces + 1u32
          }
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 3u32 => if braces > 0u32 {
            braces = braces - 1u32
          } else {
          }
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 0u32 => {
            parentheses = parentheses + 1u32
          }
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 1u32 => if parentheses > 0u32 {
            parentheses = parentheses - 1u32
          } else {
          }
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 4u32 => {
            brackets = brackets + 1u32
          }
          SelfHostTokenKind::Symbol(symbol_code, _) if symbol_code == 5u32 => if brackets > 0u32 {
            brackets = brackets - 1u32
          } else {
          }
          SelfHostTokenKind::Newline => if braces == 0u32 &&
            parentheses == 0u32 && brackets == 0u32 {
            break self_host_parser_unit()
          } else {
          }
          _ => {}
        }
        continue 0u32
      }
      Option::None => break self_host_parser_unit()
    }
  }
  self_host_parser_skip_newlines(parser)
  let _ = while 0u32 {
    _ => match self_host_parser_peek(parser) {
      Option::Some(token) => if self_host_token_starts_declaration(token) {
        break self_host_parser_unit()
      } else {
        let _ = while 0u32 {
          _ => match self_host_parser_take(parser) {
            Option::Some(value) => if value.kind is SelfHostTokenKind::Newline {
              break self_host_parser_unit()
            } else {
              continue 0u32
            }
            Option::None => break self_host_parser_unit()
          }
        }
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
      Option::None => break self_host_parser_unit()
    }
  }
}

fn self_host_declaration_keyword_at(
  parser: SelfHostParser,
  index: U32,
) -> U32 {
  if index < parser.tokens.length() {
    self_host_token_keyword_code(parser.tokens.get_unchecked(index).kind)
  } else {
    4294967295u32
  }
}

fn self_host_declaration_string_at(
  parser: SelfHostParser,
  index: U32,
) -> Bool {
  if index < parser.tokens.length() {
    parser.tokens.get_unchecked(index).kind is SelfHostTokenKind::StringLiteral(_)
  } else {
    false
  }
}

fn self_host_next_declaration_kind(parser: SelfHostParser) -> U32 {
  let mut keyword_index = parser.index
  if self_host_declaration_keyword_at(parser, keyword_index) == 2u32 {
    keyword_index = keyword_index + 1u32
  } else {
  }
  let keyword = self_host_declaration_keyword_at(parser, keyword_index)
  if keyword == 29u32 || keyword == 30u32 {
    0u32
  } else if keyword == 3u32 {
    1u32
  } else if keyword == 11u32 {
    2u32
  } else if keyword == 6u32 {
    3u32
  } else if keyword == 0u32 {
    4u32
  } else if keyword == 1u32 {
    5u32
  } else if keyword == 5u32 {
    6u32
  } else if keyword == 9u32 {
    9u32
  } else if keyword == 8u32 {
    10u32
  } else if keyword == 10u32 {
    11u32
  } else if keyword == 4u32 {
    let foreign_kind = self_host_declaration_keyword_at(
      parser,
      keyword_index + 1u32,
    )
    if foreign_kind == 10u32 {
      7u32
    } else if foreign_kind == 5u32 && self_host_declaration_string_at(
      parser,
      keyword_index + 2u32,
    ) {
      8u32
    } else {
      6u32
    }
  } else {
    4294967295u32
  }
}

pub fn self_host_parse_module(source: Bytes) -> SelfHostParsedModule {
  let parser = self_host_parser_new(source)
  let events = self_host_empty_parse_events()
  let mut preamble_open = true
  let _ = while 0u32 {
    _ => {
      self_host_parser_skip_newlines(parser)
      if parser.index >= parser.tokens.length() {
        break self_host_parser_unit()
      } else {
      }
      parser.diagnostic = Option::None
      let declaration_kind = self_host_next_declaration_kind(parser)
      match self_host_parse_declaration(parser) {
        Option::Some(declaration) => {
          if declaration_kind == 0u32 {
            match declaration {
              SelfHostDeclaration::Import(import_) => if preamble_open {
                events.push(
                  SelfHostParseEvent::Declaration(
                    SelfHostDeclaration::Import(import_),
                    0u32,
                  ),
                )
              } else {
                events.push(
                  SelfHostParseEvent::Diagnostic(
                    SelfHostDiagnosticSeverity::Error,
                    SelfHostParseError::ImportAfterDeclaration(import_.offset),
                    4u32,
                    import_.offset,
                    4294967295u32,
                    "",
                  ),
                )
              }
              _ => {}
            }
          } else {
            preamble_open = false
            events.push(SelfHostParseEvent::Declaration(
              declaration,
              declaration_kind,
            ))
          }
        }
        Option::None => {
          let diagnostic = match parser.diagnostic {
            Option::Some(value) => value
            Option::None => SelfHostParseDiagnostic::{
              severity: SelfHostDiagnosticSeverity::Error
              error: SelfHostParseError::ExpectedDeclaration(
                SelfHostDeclarationExpectation::DeclarationKeyword,
                self_host_parser_peek(parser),
                self_host_parser_offset(parser),
              )
            }
          }
          events.push(SelfHostParseEvent::Diagnostic(
            diagnostic.severity,
            diagnostic.error,
            self_host_parse_error_kind(diagnostic.error),
            self_host_parser_offset(parser),
            self_host_parser_token_code(parser),
            self_host_parser_token_text(parser),
          ))
          self_host_parser_recover_declaration(parser)
        }
      }
      continue 0u32
    }
  }
  SelfHostParsedModule::{
    events: events
  }
}

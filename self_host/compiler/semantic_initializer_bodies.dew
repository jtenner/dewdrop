// Initializers have no source function fragment. Give the common body planner
// their explicit zero-parameter signature and linked initializer identity.
fn self_host_plan_initializer_bodies(link: SelfHostPlannedProgramWasmGCLink, indexes: SelfHostPhysicalBodyIndexes, bodies: Array<SelfHostPlannedPhysicalBodyCarrierPlan>, diagnostics: Array<SelfHostPhysicalCarrierDiagnostic>) -> Unit {
  let mut position = 0u32
  for initializer in link.initializers {
    let module_ = self_host_linked_lowering_module_at(link, initializer.module_index)
    let identity = SelfHostPlannedProgramWasmFunction::{
      module_index: initializer.module_index
      fragment_index: 4294967295u32
      declaration: initializer.declaration
      specialization: 4294967295u32
      lambda: 4294967295u32
      function_index: link.functions.length() + position
      imported: false
    }
    let source = self_host_body_require_linked_source(self_host_body_lookup(module_, initializer.body), identity, initializer.body)
    match source {
      Option::Some(body) => {
        let plan = self_host_plan_physical_body_with_signature(link, indexes, identity, body, 4294967295u32,
          SelfHostHirSpan::{
            start: 0u32
            length: 0u32
          },
          self_host_body_carrier_from_shape(initializer.shape),
          self_host_linked_type_nominal_declaration(module_, body.root_type))
        self_host_verify_one_physical_body(link, plan, diagnostics)
        bodies.push(plan)
      }
      Option::None => unreachable()
    }
    position = position + 1u32
  }
}

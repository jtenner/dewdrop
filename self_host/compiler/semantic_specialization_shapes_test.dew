    -self_host_body_u32_to_i32(callable.result_type) - 2i32)
}

fn self_host_specialized_product_shape_fixture() -> SelfHostPlannedModuleLowering {
  let module_ = self_host_specialized_shape_fixture()
  let callable = module_.functions.callables[0u32]
  let root = module_.inferred.types.length()
  let start = module_.inferred.type_arguments.length()
  assert(root == 1u32 && start == 0u32, "stable owned product fixture indices")
  module_.inferred.type_arguments.push(-self_host_body_u32_to_i32(callable.result_type) - 2i32)
  module_.inferred.types.push(SelfHostBodyTypeTerm::BodyProductType(SelfHostHirSpan::{
    start: start
    length: 1u32
  }))
  let shape = self_host_specialized_body_value_shape(module_, callable,
    self_host_specialized_shape_test_span(), [SelfHostPlannedValueShape::I64PlannedValueShape], self_host_body_u32_to_i32(root))
  match shape {
    SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => assert(fields[0u32] is SelfHostPlannedValueShape::I64PlannedValueShape, "valid product before changing one edge")
    _ => assert(false, "valid product was lost")
  }
  module_
}


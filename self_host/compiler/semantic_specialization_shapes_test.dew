fn self_host_source_call_identity_fixture() -> Array<SelfHostProgramSpecializedCall> {
  [SelfHostProgramSpecializedCall::{
    caller_body: 330712481809u64
    caller_specialization: 3u32
    expression: 19u32
    target: 377957122059u64
    target_specialization: 7u32
  }]
}

test "source call identity allows identical replays and distinct source keys" {
  let calls = self_host_source_call_identity_fixture()
  calls.push(calls[0u32])
  self_host_program_specialization_record_call(calls, 330712481810u64, 3u32, 19u32, 23u64, 9u32)
  self_host_program_specialization_record_call(calls, 330712481809u64, 4u32, 19u32, 23u64, 9u32)
  self_host_program_specialization_record_call(calls, 330712481809u64, 3u32, 20u32, 23u64, 9u32)
  self_host_program_specialization_verify_calls(calls)
  assert(calls.length() == 5u32, "verification preserves source records")
}

test "SPC-303 source call declarations cannot disagree" expect_trap "unreachable" {
  let calls = self_host_source_call_identity_fixture()
  self_host_program_specialization_record_call(calls, 330712481809u64, 3u32, 19u32, 377957122060u64, 7u32)
  self_host_program_specialization_verify_calls(calls)
}

test "SPC-303 source call specializations cannot disagree" expect_trap "unreachable" {

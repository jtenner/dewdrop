fn self_host_specialized_shape_fixture() -> SelfHostPlannedModuleLowering {
  let lowering = self_host_physical_test_lowering(b"fn keep<t>(value: t) -> t {\n  value\n}\n")
  let module_ = lowering.modules[0u32]
  assert(module_.functions.callables.length() == 1u32, "one generic callable")
  let callable = module_.functions.callables[0u32]
  let type_ = -self_host_body_u32_to_i32(callable.result_type) - 2i32
  let shape = self_host_specialized_body_value_shape(module_, callable,
    self_host_specialized_shape_test_span(), [SelfHostPlannedValueShape::I64PlannedValueShape], type_)
  assert(shape is SelfHostPlannedValueShape::I64PlannedValueShape, "valid caller substitution before mutation")
  module_
}

fn self_host_specialized_shape_test_span() -> SelfHostHirSpan {
  SelfHostHirSpan::{
    start: 0u32
    length: 1u32
  }
}

test "specialized type work queues preserve deep shared product graphs" {
  let module_ = self_host_specialized_shape_fixture()
  let callable = module_.functions.callables[0u32]
  let mut root = -self_host_body_u32_to_i32(callable.result_type) - 2i32
  while 0u32 {
    depth if depth < 128u32 => {
      let start = module_.inferred.type_arguments.length()
      module_.inferred.type_arguments.push(root)
      module_.inferred.type_arguments.push(root)
      root = self_host_body_u32_to_i32(module_.inferred.types.length())
      module_.inferred.types.push(SelfHostBodyTypeTerm::BodyProductType(SelfHostHirSpan::{
        start: start
        length: 2u32
      }))
      continue depth + 1u32
    }
    _ => break ()
  }
  let mut shape = self_host_specialized_body_value_shape(module_, callable,
    self_host_specialized_shape_test_span(), [SelfHostPlannedValueShape::I64PlannedValueShape], root)
  while 0u32 {
    depth if depth < 128u32 => {
      match shape {
        SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => {
          assert(fields.length() == 2u32, "shared product retains both fields")
          shape = fields[0u32]
        }
        _ => assert(false, "nested product was lost")
      }
      continue depth + 1u32
    }
    _ => break ()
  }
  assert(shape is SelfHostPlannedValueShape::I64PlannedValueShape, "deep leaf uses the caller argument")
}


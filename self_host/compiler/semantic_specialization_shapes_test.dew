test "specialization normalization retains missing and erroneous evidence" {
  let generic = SelfHostPlannedValueShape::GenericPlannedValueShape
  let error = SelfHostPlannedValueShape::ErrorPlannedValueShape
  let reference = SelfHostPlannedValueShape::RefPlannedValueShape
  assert(self_host_specialization_canonical_scalar(generic) is SelfHostPlannedValueShape::GenericPlannedValueShape, "generic evidence was erased")
  assert(self_host_specialization_canonical_scalar(error) is SelfHostPlannedValueShape::ErrorPlannedValueShape, "error evidence was erased")
  assert(!self_host_specialization_shapes_equal(generic, reference), "generic is not a reference certificate")
  assert(!self_host_specialization_shapes_equal(error, reference), "error is not a reference certificate")
  let product = self_host_specialization_canonical_shape(SelfHostPlannedValueShape::ProductPlannedValueShape([
    SelfHostPlannedValueShape::U8PlannedValueShape,
    generic,
    error,
  ]))
  match product {
    SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => {
      assert(fields[0u32] is SelfHostPlannedValueShape::U8PlannedValueShape, "packed storage width and signedness survive normalization")
      assert(fields[1u32] is SelfHostPlannedValueShape::GenericPlannedValueShape, "nested generic evidence")
      assert(fields[2u32] is SelfHostPlannedValueShape::ErrorPlannedValueShape, "nested error evidence")
    }
    _ => assert(false, "product was lost")
  }
}

test "packed storage shapes remain distinct despite a shared i32 carrier" {
  let shapes = [SelfHostPlannedValueShape::I8PlannedValueShape,
    SelfHostPlannedValueShape::U8PlannedValueShape,
    SelfHostPlannedValueShape::I16PlannedValueShape,
    SelfHostPlannedValueShape::U16PlannedValueShape,
    SelfHostPlannedValueShape::I32PlannedValueShape]
  for left in shapes {
    assert(self_host_physical_scalar_shape(left) is SelfHostPlannedValueShape::I32PlannedValueShape, "function carrier still erases packed width")
    assert(self_host_linked_shape_name(self_host_specialization_canonical_scalar(left)) == self_host_linked_shape_name(left), "packed canonical shape remains exact")
    assert(self_host_specialization_shapes_equal(left, left), "packed shape equality is reflexive")
    for right in shapes {
      assert(self_host_specialization_shapes_equal(left, right) == (self_host_linked_shape_name(left) == self_host_linked_shape_name(right)), "packed shapes cannot share a storage specialization")
    }
  }
}

test "packed field storage preserves width and signedness without changing stack carriers" {
  let shapes = [SelfHostPlannedValueShape::I8PlannedValueShape,
    SelfHostPlannedValueShape::U8PlannedValueShape,
    SelfHostPlannedValueShape::I16PlannedValueShape,
    SelfHostPlannedValueShape::U16PlannedValueShape,
    SelfHostPlannedValueShape::I32PlannedValueShape]
  for shape in shapes {
    let storage = self_host_wasmgc_storage_type(shape)
    assert(self_host_linked_shape_name(self_host_program_representation_storage_shape(storage)) == self_host_linked_shape_name(shape), "field storage retains its declared shape")
    assert(self_host_body_carrier_from_storage(storage) is SelfHostWasmBodyCarrier::I32BodyCarrier, "packed fields use i32 operands")
    for other in shapes {
      assert(self_host_program_representation_storage_matches_shape(storage, other) == self_host_specialization_shapes_equal(shape, other), "a different width or signedness is not a storage certificate")
    }
  }
}

test "FRG-403 packed field reads require a present source field" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"struct Cell {\n  value: I8\n}\npub fn run(value: Cell) -> I8 {\n  value.value\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid packed field source")
  match self_host_linked_physical_field_shape(link, 0u32, 0u32) {
    Option::Some(shape) => assert(shape is SelfHostPlannedValueShape::I8PlannedValueShape, "valid field before changing the index")
    Option::None => assert(false, "missing fixture field")
  }
  let _ = self_host_linked_struct_get_instruction(link, 0u32, 1u32)
}

test "raw array storage keeps heap width separate from signed reads" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn run() -> I32 {\n  42\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "valid storage fixture")
  let shapes = [SelfHostPlannedValueShape::I8PlannedValueShape,
    SelfHostPlannedValueShape::U8PlannedValueShape,
    SelfHostPlannedValueShape::I16PlannedValueShape,
    SelfHostPlannedValueShape::U16PlannedValueShape]
  while 0u32 {
    index if index < shapes.length() => {
      let storage = match self_host_linked_raw_array_storage(link, shapes[index]) {
        Option::Some(value) => value
        Option::None => {
          assert(false, "a concrete packed shape must have storage")
          unreachable()
        }
      }
      assert(storage.type_index == self_host_linked_packed_array_type_base(link) + index / 2u32, "signed and unsigned reads share only the storage width")
      if index % 2u32 == 0u32 {
        assert(storage.read is SelfHostRawArrayRead::SignedPackedRawArrayRead, "signed packed instruction")
      } else {
        assert(storage.read is SelfHostRawArrayRead::UnsignedPackedRawArrayRead, "unsigned packed instruction")
      }
      continue index + 1u32
    }
    _ => break ()
  }
  for invalid in [SelfHostPlannedValueShape::GenericPlannedValueShape,
    SelfHostPlannedValueShape::ErrorPlannedValueShape,
    SelfHostPlannedValueShape::NeverPlannedValueShape,
    SelfHostPlannedValueShape::ProductPlannedValueShape([SelfHostPlannedValueShape::GenericPlannedValueShape])] {
    assert(self_host_linked_raw_array_storage(link, invalid) is Option::None, "missing or invalid storage has no physical recipe")
  }
}


test "ARN-103 specialization request links cannot be shorter than requests" expect_trap "unreachable" {
  let declaration = 377957122059u64
  let requests = []
  let shapes = []
  let heads = self_host_empty_u64_u32_map()
  let next = []
  let initial = self_host_program_specialization_add_request_at_call(
    requests, shapes, heads, next, declaration, [SelfHostPlannedValueShape::I32PlannedValueShape],
    [], 330712481809u64, 18u32,
  )
  assert(initial == 0u32 && requests.length() == 1u32 && next.length() == 1u32, "valid request before one mutation")
  let _ = next.pop()
  let _ = self_host_program_specialization_add_request_at_call(
    requests, shapes, heads, next, declaration, [SelfHostPlannedValueShape::I32PlannedValueShape],
    [], 330712481809u64, 19u32,
  )
}


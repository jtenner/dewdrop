open dew.std.array

// The interner appends structural parents after their children. Validate this
// order while building one flag per type; do not repeat a graph walk for every
// field and parameter. Nominal member declarations are checked separately.
fn self_host_compile_time_storage_flag(
  flags: Array<Bool>,
  type_: U32,
  module_id: U64,
) -> Bool {
  self_host_assert_compiler_invariant_with_failure(
    type_ < flags.length(),
    SelfHostInvariantFailure::{
      code: 104u32
      phase: 2u32
      module_id: module_id
      declaration: 0u64
      body: 0u64
      expression: 4294967295u32
      expected: u32_into_u64(flags.length())
      actual: u32_into_u64(type_)
      detail: 0u64
    },
    "ARN-104 compile-time storage type must precede its structural parent",
  )
  flags[type_]
}

fn self_host_compile_time_storage_span(
  span: SelfHostHirSpan,
  length: U32,
  module_id: U64,
) -> Unit {
  let _ = self_host_assert_compiler_invariant_with_failure(
    self_host_array_span_is_valid(span.start, span.length, length),
    SelfHostInvariantFailure::{
      code: 101u32
      phase: 2u32
      module_id: module_id
      declaration: 0u64
      body: 0u64
      expression: 4294967295u32
      expected: u32_into_u64(length)
      actual: u32_into_u64(span.start)
      detail: u32_into_u64(span.length)
    },
    "ARN-101 compile-time storage span",
  )
}

impl SelfHostTypeResolver {
  fn compile_time_storage_flags(self) -> Array<Bool> {
    let flags = self_host_bool_slots(0u32, false)
    for type_ in self.interner.types {
      let mut contains = false
      let mut children = self_host_empty_hir_span(0u32)
      match type_ {
        SelfHostResolvedType::PrimitiveType(SelfHostPrimitiveType::CompileTimeTypeType) => {
          contains = true
        }
        SelfHostResolvedType::ProductType(arguments) => {
          children = arguments
        }
        SelfHostResolvedType::AppliedType(base, arguments) => {
          contains = self_host_compile_time_storage_flag(
            flags, base, self.collected.module_id,
          )
          children = arguments
        }
        SelfHostResolvedType::FunctionType(arguments, result) => {
          contains = self_host_compile_time_storage_flag(
            flags, result, self.collected.module_id,
          )
          children = arguments
        }
        _ => {}
      }
      self_host_compile_time_storage_span(
        children, self.interner.arguments.length(), self.collected.module_id,
      )
      let _ = while 0u32 {
        index => if index < children.length {
          let child = self_host_compile_time_storage_flag(
            flags, self.interner.arguments[children.start + index], self.collected.module_id,
          )
          contains = contains || child
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      flags.push(contains)
    }
    flags
  }

  fn check_compile_time_storage(
    self,
    flags: Array<Bool>,
    declaration: U64,
    type_: U32,
    offset: U32,
  ) -> Unit {
    if self_host_compile_time_storage_flag(flags, type_, self.collected.module_id) {
      self.diagnose(SelfHostTypeDiagnostic::ComputedTypeFailure(
        declaration,
        "CT-037 Type is compile-time-only and has no runtime storage",
        offset,
      ))
    }
  }

  // Run after alias normalization. Only builtin metadata grants permission to
  // return Type; an ordinary function with the same name has no such permission.
  fn validate_compile_time_storage(self) -> Unit {
    let flags = self.compile_time_storage_flags()
    let mut index = 0u32
    for parameter in self.collected.parameters {
      self.check_compile_time_storage(
        flags, parameter.declaration, self.parameter_types[index], parameter.offset,
      )
      index = index + 1u32
    }
    index = 0u32
    for callable in self.collected.callables {
      let mut type_query = false
      for entry in self.collected.builtins {
        if entry.declaration == callable.declaration &&
          (entry.builtin_name == b"types.field_type" ||
            entry.builtin_name == b"types.variant_payload_types") {
          type_query = true
        }
      }
      if !type_query {
        self.check_compile_time_storage(
          flags, callable.declaration, self.callable_return_types[index],
          self.collected.type_syntax[callable.return_type].offset(),
        )
      }
      index = index + 1u32
    }
    index = 0u32
    for field in self.collected.fields {
      self.check_compile_time_storage(
        flags, field.declaration, self.field_types[index], field.offset,
      )
      index = index + 1u32
    }
    index = 0u32
    for variant in self.collected.variants {
      let payload = self.variant_payloads[index]
      self_host_compile_time_storage_span(
        payload, self.signature_type_lists.length(), self.collected.module_id,
      )
      let _ = while 0u32 {
        slot => if slot < payload.length {
          self.check_compile_time_storage(
            flags, variant.declaration, self.signature_type_lists[payload.start + slot], variant.offset,
          )
          continue slot + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      index = index + 1u32
    }
    index = 0u32
    for lambda in self.collected.lambdas {
      let declaration = self.collected.bodies[self_host_semantic_id_local(lambda.root_body)].declaration
      self.check_compile_time_storage(
        flags, declaration, self.lambda_return_types[index], lambda.offset,
      )
      self_host_compile_time_storage_span(
        lambda.parameters, self.lambda_parameter_types.length(), self.collected.module_id,
      )
      let _ = while 0u32 {
        parameter => if parameter < lambda.parameters.length {
          let slot = lambda.parameters.start + parameter
          self.check_compile_time_storage(
            flags, declaration, self.lambda_parameter_types[slot], self.collected.lambda_parameters[slot].offset,
          )
          continue parameter + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      index = index + 1u32
    }
  }
}

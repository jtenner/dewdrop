fn ct_test_plan(source: Bytes) -> CtPlan {
  let plan = ct_prepare({
    modules: [
      {
        path: "app"
        files: [{
          path: "main.dew"
          source: source
          test_only: false
        }]
      },
      {
        path: "dew.std.result"
        files: [{
          path: "result.dew"
          source: b"pub enum Result<t, e> {\n Ok(t)\n Err(e)\n}\n"
          test_only: false
        }]
      },
    ]
  })
  plan.type_names.push({
    module_index: 0u32
    name: "Result"
    key: "dew.std.result::Result"
  })
  plan
}

test "transform interpreter calls ordinary helpers" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn answer() -> I32 {\n 42i32\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(answer()))\n}\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  assert(plan.error.byte_length() == 0u32, plan.error)
  match ct_expand(plan) {
    Ok(manifest) => {
      let source = ct_test_all_source(manifest.modules[0u32])
      assert(source.contains("42i32"), "transform result")
      assert(!source.contains("fn replace"), "compile-time entry removed")
    }
    Err(error) => assert(false, error)
  }
}

test "transform interpreter resolves imported public functions" {
  let plan = ct_prepare({
      modules: [
        {
          path: "app"
          files: [{
              path: "main.dew"
              source: b"import tools as @tools\n#@tools.replace\npub fn main() -> I32 {\n 0i32\n}\n"
              test_only: false
          }]
        },
        {
          path: "tools"
          files: [{
              path: "tools.dew"
              source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn answer() -> I32 {\n 42i32\n}\npub transform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(answer()))\n}\n"
              test_only: false
          }]
        },
      ]
  })
  assert(plan.error.byte_length() == 0u32, plan.error)
  match ct_expand(plan) {
    Ok(manifest) => assert(ct_test_all_source(manifest.modules[0u32]).contains("42i32"), "imported transform result")
    Err(error) => assert(false, error)
  }
}

test "transform interpreter bounds recursive calls" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn recurse() -> I32 {\n recurse()\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(recurse()))\n}\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  match ct_expand(plan) {
    Err(error) => assert(error.contains("depth limit"), error)
    Ok(_) => assert(false, "recursive transform must fail")
  }
}

test "transform interpreter rejects source injection" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn bad(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.source(\"1i32\\n}\\nfn injected() -> I32 {\\n2i32\"))\n}\n#bad\nfn main() -> I32 {\n 0i32\n}\n")
  assert(ct_expand(plan) is Err(_), "source injection must fail")
}

fn ct_test_all_source(module_: SelfHostManifestModule) -> String {
  let out = StringBuilder::new()
  for file in module_.files {
    out.append(file.source.to_string())
  }
  out.finish()
}

test "transform patterns use checked variants and bindings" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nenum Choice {\n None\n Some(I32)\n}\nfn choose() -> I32 {\n match Choice::Some(5i32) {\n None => 0i32\n Some(x) => x\n }\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(choose()))\n}\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  for file in plan.files {
    if file.module_index == 0u32 {
      for function in file.functions {
        if function.declaration.name == "choose" {
          match function.declaration.body.items[0u32].value {
            MatchExpr(_, arms, _) => {
              ct_add_pattern_proof(plan, 0u32, "main.dew", arms[0u32].pattern.offset(), "app::Choice::None")
              ct_add_pattern_proof(plan, 0u32, "main.dew", arms[1u32].pattern.offset(), "app::Choice::Some")
              match arms[1u32].pattern {
                TuplePattern(_, patterns, _) => ct_add_pattern_proof(plan, 0u32, "main.dew", patterns[0u32].offset(), "")
                _ => assert(false, "expected Some payload")
              }
            }
            _ => assert(false, "expected a match")
          }
        }
      }
    }
  }
  match ct_expand(plan) {
    Ok(manifest) => {
      let mut found = false
      for file in manifest.modules[0u32].files {
        if file.path.starts_with("main.dew::transform[main@") {
          found = true
          assert(file.source.to_string().contains("5i32"), "Some payload must be selected")
        }
      }
      assert(found, "generated main")
    }
    Err(error) => assert(false, error)
  }
}

test "transform interpreter propagates return inside condition" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn helper() -> I32 {\n if (return 42i32) {\n 0i32\n } else {\n 0i32\n }\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(helper()))\n}\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  match ct_expand(plan) {
    Ok(manifest) => assert(ct_test_all_source(manifest.modules[0u32]).contains("42i32"), "return value")
    Err(error) => assert(false, error)
  }
}

test "transform interpreter bounds endless loops" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nfn forever() -> I32 {\n while 0u32 {\n _ => continue 0u32\n }\n}\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(forever()))\n}\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  match ct_expand(plan) {
    Err(error) => assert(error.contains("limit exceeded"), error)
    Ok(_) => assert(false, "endless loop must fail")
  }
}

test "transform interpreter reports explicit errors" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn no(node: @ast.FnNode, ctx: @transform.TransformContext) -> Result<@ast.FnNode, @transform.TransformError> {\n Result::Err(@transform.error(\"cannot transform this function\"))\n}\n#no\npub fn main() -> I32 {\n 0i32\n}\n")
  match ct_expand(plan) {
    Err(error) => assert(error.contains("cannot transform this function"), error)
    Ok(_) => assert(false, "explicit error must fail")
  }
}

test "transform context retains parameter source" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn reject(node: @ast.FnNode, ctx: @transform.TransformContext) -> Result<@ast.FnNode, @transform.TransformError> {\n Result::Err(@transform.error(ctx.parameters_source))\n}\n#reject\nfn sample(value: I32, other: Bool) -> I32 {\n value\n}\n")
  match ct_expand(plan) {
    Err(message) => assert(message.contains("value: I32, other: Bool"), message)
    Ok(_) => assert(false, "context diagnostic was not returned")
  }
}

test "transform annotation cannot follow code on the same line" {
  let plan = ct_test_plan(b"fn before() -> I32 {\n 0i32\n} #replace\nfn after() -> I32 {\n 0i32\n}\n")
  assert(plan.error.contains("must occupy its own line"), plan.error)
}


test "transform paths accept checked static and imported names" {
  assert(ct_qualified_identifier("Answer::new"), "static method path")
  assert(ct_qualified_identifier("@tools.Answer::new"), "imported static method path")
  assert(ct_qualified_identifier("answer"), "plain function path")
  assert(!ct_qualified_identifier("Answer::new()"), "calls cannot appear in a path")
  assert(!ct_qualified_identifier("@tools.Answer::"), "incomplete path must fail")
}


test "generic default scalar values keep zero at checked uses" {
  let machine = ct_machine(ct_test_plan(b""))
  assert(ct_pattern(machine, 0u32, LiteralPattern(I32Expr(0u64, 0u32), 0u32), CtValue::DefaultValue, ct_environment()), "integer zero pattern")
  assert(ct_render(machine, CtValue::Variant("dewdrop.ast::ExprNode::Integer64", [CtValue::DefaultValue]), 0u32) == "0i64", "wide zero builder")
  assert(ct_render(machine, CtValue::Variant("dewdrop.ast::ExprNode::Boolean", [CtValue::DefaultValue]), 0u32) == "false", "Bool zero builder")
  assert(machine.error.byte_length() == 0u32, machine.error)
}

test "quotes keep splice names and quote locals apart" {
  let machine = ct_machine(ct_test_plan(b""))
  let node = CtValue::Variant("dewdrop.ast::ExprNode::Quote", [
    CtValue::Sequence([CtValue::Text("let $saved = 2i32\n"), CtValue::Text(" + $saved")]),
    CtValue::Sequence([CtValue::Variant("dewdrop.ast::ExprNode::Source", [CtValue::Text("__dew_quote_0")])]),
  ])
  let source = ct_render(machine, node, 0u32)
  assert(source.contains("let __dew_quote_0_ = 2i32"), source)
  assert(source.contains("(__dew_quote_0) + __dew_quote_0_"), source)
  assert(machine.error.byte_length() == 0u32, machine.error)
}

test "quote strings and comments keep dollar text" {
  let machine = ct_machine(ct_test_plan(b""))
  let node = CtValue::Variant("dewdrop.ast::ExprNode::Quote", [
    CtValue::Sequence([CtValue::Text("// $comment\nlet $saved = \"$text\"\n$saved")]),
    CtValue::Sequence([]),
  ])
  let source = ct_render(machine, node, 0u32)
  assert(source.contains("// $comment"), source)
  assert(source.contains("\"$text\""), source)
  assert(source.contains("let __dew_quote_0 ="), source)
  assert(machine.error.byte_length() == 0u32, machine.error)
}

test "quote arity and invalid dollar names fail" {
  for node in [
    CtValue::Variant("dewdrop.ast::ExprNode::Quote", [CtValue::Sequence([]), CtValue::Sequence([])]),
    CtValue::Variant("dewdrop.ast::ExprNode::Quote", [CtValue::Sequence([CtValue::Text("$ 1i32")]), CtValue::Sequence([])]),
  ] {
    let machine = ct_machine(ct_test_plan(b""))
    let _ = ct_render(machine, node, 0u32)
    assert(machine.error.byte_length() != 0u32, "invalid quote must fail")
  }
}

test "quote splices cannot cross strings or comments" {
  for parts in [
    [CtValue::Text("\"prefix"), CtValue::Text("$text\"")],
    [CtValue::Text("//"), CtValue::Text(" $text\n42i32")],
  ] {
    let machine = ct_machine(ct_test_plan(b""))
    let node = CtValue::Variant("dewdrop.ast::ExprNode::Quote", [CtValue::Sequence(parts), CtValue::Sequence([CtValue::Variant("dewdrop.ast::ExprNode::Integer", [CtValue::Number(1u64, "I32")])])])
    let _ = ct_render(machine, node, 0u32)
    assert(machine.error.contains("quote splices must occupy expression syntax"), machine.error)
  }
}

test "original syntax tree keeps block order and operator labels" {
  let plan = ct_test_plan(b"transform fn sample() -> I32 {\n let answer = 40i32\n answer + 2i32\n}\n")
  assert(plan.error.byte_length() == 0u32, plan.error)
  let machine = ct_machine(plan)
  let tree = ct_syntax_block(machine, plan.files[0u32].functions[0u32].declaration.body, 0u32)
  assert(ct_string(machine, ct_field(machine, tree, "kind")) == "block", "body block")
  let children = ct_sequence_values(machine, ct_field(machine, tree, "children"))
  assert(children.length() == 2u32, "two source items")
  assert(ct_string(machine, ct_field(machine, children[0u32], "kind")) == "bind", "first binding")
  assert(ct_string(machine, ct_field(machine, children[1u32], "kind")) == "binary", "last binary expression")
  assert(ct_string(machine, ct_field(machine, children[1u32], "label")) == "+", "source operator")
  assert(machine.error.byte_length() == 0u32, machine.error)
}

test "syntax reflection bounds recursive source trees" {
  let machine = ct_machine(ct_test_plan(b""))
  let mut value = SelfHostExpr::I32Expr(1u64, 0u32)
  let _ = while 0u32 {
    i if i < 129u32 => {
      value = SelfHostExpr::PrefixExpr(Negative, value, 0u32)
      continue i + 1u32
    }
    _ => break ()
  }
  let _ = ct_syntax_expr(machine, value, 0u32)
  assert(machine.error.contains("syntax tree depth limit"), machine.error)
}

test "annotation arguments preserve parsed syntax and source offsets" {
  let plan = ct_test_plan(b"#replace(\"answer\", helper(1i32 + 2i32))\nfn sample() -> I32 {\n 0i32\n}\n")
  assert(plan.error.byte_length() == 0u32, plan.error)
  let annotation = plan.files[0u32].annotations[0u32]
  assert(annotation.arguments.length() == 2u32, "two arguments")
  let machine = ct_machine(plan)
  let nodes = ct_sequence_values(machine, ct_annotation_nodes(machine, annotation))
  assert(ct_string(machine, ct_field(machine, nodes[0u32], "kind")) == "String", "text argument")
  assert(ct_string(machine, ct_field(machine, nodes[0u32], "label")) == "answer", "decoded text")
  assert(ct_raw_bits(machine, ct_field(machine, nodes[0u32], "offset")) == 9u64, "original byte offset")
  assert(ct_string(machine, ct_field(machine, nodes[1u32], "kind")) == "call", "nested call syntax")
  assert(machine.error.byte_length() == 0u32, machine.error)
}

test "annotation argument brackets and source lines are checked" {
  for source in [
    b"#replace(1i32]\nfn sample() -> I32 {\n 0i32\n}\n",
    b"#replace(1i32) extra\nfn sample() -> I32 {\n 0i32\n}\n",
    b"#replace(\n1i32)\nfn sample() -> I32 {\n 0i32\n}\n",
  ] {
    let plan = ct_test_plan(source)
    assert(plan.error.byte_length() != 0u32, "invalid annotation must fail")
  }
}

test "each stacked annotation retains its own resource report" {
  let plan = ct_test_plan(b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n @ast.with_body(node, @ast.integer(42i32))\n}\n#replace\n#replace\npub fn main() -> I32 {\n 0i32\n}\n")
  match ct_expand(plan) {
    Ok(_) => {}
    Err(error) => assert(false, error)
  }
  assert(plan.reports.length() == 2u32, "one report per annotation")
  for report in plan.reports {
    assert(report.function_name == "main", "original function name")
    assert(report.work > 0u32 && report.work <= 100000u32, "bounded work count")
    assert(report.allocation_work > 0u32 && report.allocation_work <= 4194304u32, "bounded allocation work count")
  }
  assert(plan.reports[0u32].offset < plan.reports[1u32].offset, "source order")
}

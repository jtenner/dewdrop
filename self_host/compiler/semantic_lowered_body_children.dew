struct SelfHostLoweredChildContext {
  module_: SelfHostPlannedModuleLowering
  body: SelfHostPlannedBodyLowering
  phase: U32
  lambda: U32
  locals: SelfHostHirSpan
  lambdas: SelfHostHirSpan
  mut syntax_walk: Option<SelfHostLoweredSyntaxWalk>
}

fn self_host_lowered_child_failure(context: SelfHostLoweredChildContext, code: U32, parent: U32, expected: U64, actual: U64, detail: U64) -> Unit {
  let _ = self_host_assert_compiler_invariant_with_failure(false,
    SelfHostInvariantFailure::{
      code: code
      phase: context.phase
      module_id: context.module_.module_id
      declaration: context.body.declaration
      body: context.body.body
      expression: parent
      expected: expected
      actual: actual
      detail: detail
    },
    "lowered child must belong to its declared physical body arena",
  )
}

fn self_host_lowered_child_span(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan, length: U32, tag: U32) -> Unit {
  if !self_host_array_span_is_valid(span.start, span.length, length) {
    self_host_lowered_child_failure(context, 101u32, parent,
      u32_into_u64(length), u32_into_u64(span.length),
      (u32_into_u64(tag) << 32u64) | u32_into_u64(span.start),
    )
  }
}

fn self_host_lowered_child_owned(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan, child: U32, tag: U32) -> Unit {
  // The span has already passed its arena bound. Check before subtraction.
  let valid = if child < span.start {
    false
  } else {
    child - span.start < span.length
  }
  if !valid {
    self_host_lowered_child_failure(context, 104u32, parent,
      u32_into_u64(span.start), u32_into_u64(child),
      (u32_into_u64(tag) << 32u64) | u32_into_u64(span.length),
    )
  }
}

fn self_host_lowered_child_index(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan, child: U32, tag: U32) -> Unit {
  self_host_lowered_child_owned(context, parent, span, child, tag)
  self_host_lowered_syntax_child(context, parent, child, tag)
}

fn self_host_lowered_child_expression(context: SelfHostLoweredChildContext, parent: U32, child: U32) -> Unit {
  self_host_lowered_child_index(context, parent, context.body.expressions, child, 1u32)
}

fn self_host_lowered_child_optional_expression(context: SelfHostLoweredChildContext, parent: U32, child: U32) -> Unit {
  if child != 4294967295u32 {
    self_host_lowered_child_expression(context, parent, child)
  }
}

fn self_host_lowered_child_local(context: SelfHostLoweredChildContext, parent: U32, local: U32) -> Unit {
  self_host_lowered_child_index(context, parent, context.locals, local, 2u32)
}

fn self_host_lowered_child_arguments(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan) -> Unit {
  let children = context.module_.expression_children
  self_host_lowered_child_span(context, parent, span, children.length(), 10u32)
  let _ = while 0u32 {
    index if index < span.length => {
      self_host_lowered_child_expression(context, parent, children[span.start + index])
      continue index + 1u32
    }
    _ => break self_host_semantic_unit()
  }
}

fn self_host_lowered_child_fields(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan) -> Unit {
  let fields = context.module_.object_fields
  self_host_lowered_child_span(context, parent, span, fields.length(), 12u32)
  let _ = while 0u32 {
    index if index < span.length => {
      self_host_lowered_child_expression(context, parent, fields[span.start + index].value)
      continue index + 1u32
    }
    _ => break self_host_semantic_unit()
  }
}

fn self_host_lowered_child_arms(context: SelfHostLoweredChildContext, parent: U32, span: SelfHostHirSpan) -> Unit {
  let children = context.module_.arm_children
  self_host_lowered_child_span(context, parent, span, children.length(), 13u32)
  let _ = while 0u32 {
    index if index < span.length => {
      self_host_lowered_child_index(context, parent, context.body.pattern_arms, children[span.start + index], 5u32)
      continue index + 1u32
    }
    _ => break self_host_semantic_unit()
  }
}

fn self_host_lowered_child_pattern(context: SelfHostLoweredChildContext, pattern: U32) -> Unit {
  self_host_lowered_child_index(context, 4294967295u32, context.body.patterns, pattern, 4u32)
}

fn self_host_lowered_child_patterns(context: SelfHostLoweredChildContext, span: SelfHostHirSpan) -> Unit {
  let children = context.module_.pattern_children
  self_host_lowered_child_span(context, 4294967295u32, span, children.length(), 14u32)
  let _ = while 0u32 {
    index if index < span.length => {
      self_host_lowered_child_pattern(context, children[span.start + index])
      continue index + 1u32
    }
    _ => break self_host_semantic_unit()
  }
}

fn self_host_lowered_child_pair(context: SelfHostLoweredChildContext, parent: U32, first: U32, second: U32) -> Unit {
  self_host_lowered_child_expression(context, parent, first)
  self_host_lowered_child_expression(context, parent, second)
}

// Keep every lowered expression variant explicit. Declaration/type metadata is
// not an evaluation edge, but stored source expression IDs still need ownership.
fn self_host_lowered_child_expression_edges(context: SelfHostLoweredChildContext, parent: U32, kind: SelfHostPlannedExpressionKind) -> Unit {
  match kind {
    SelfHostPlannedExpressionKind::PlannedLocalGet(local) => self_host_lowered_child_local(context, parent, local)
    SelfHostPlannedExpressionKind::PlannedLocalSet(local, value) => {
      self_host_lowered_child_local(context, parent, local)
      self_host_lowered_child_expression(context, parent, value)
    }
    SelfHostPlannedExpressionKind::PlannedCaptureSet(capture, value) => {
      self_host_lowered_child_capture(context, parent, capture)
      self_host_lowered_child_expression(context, parent, value)
    }
    SelfHostPlannedExpressionKind::PlannedReturnExpression(value) => self_host_lowered_child_optional_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedBreakExpression(_, value) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedContinueExpression(_, value) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedPrefixExpression(_, value) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedFieldGet(_, value, _) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedUnresolvedField(value, _) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedProductField(value, _, _) => self_host_lowered_child_expression(context, parent, value)
    SelfHostPlannedExpressionKind::PlannedBlockExpression(block) => self_host_lowered_child_index(context, parent, context.body.blocks, block, 3u32)
    SelfHostPlannedExpressionKind::PlannedIfExpression(condition, block, alternative) => {
      self_host_lowered_child_expression(context, parent, condition)
      self_host_lowered_child_index(context, parent, context.body.blocks, block, 3u32)
      self_host_lowered_child_optional_expression(context, parent, alternative)
    }
    SelfHostPlannedExpressionKind::PlannedMatchExpression(value, arms) => {
      self_host_lowered_child_expression(context, parent, value)
      self_host_lowered_child_arms(context, parent, arms)
    }
    SelfHostPlannedExpressionKind::PlannedWhileExpression(_, value, arms) => {
      self_host_lowered_child_expression(context, parent, value)
      self_host_lowered_child_arms(context, parent, arms)
    }
    SelfHostPlannedExpressionKind::PlannedProductNew(arguments) => self_host_lowered_child_arguments(context, parent, arguments)
    SelfHostPlannedExpressionKind::PlannedEvaluationSequence(arguments) => self_host_lowered_child_arguments(context, parent, arguments)
    SelfHostPlannedExpressionKind::PlannedArrayLiteral(arguments) => self_host_lowered_child_arguments(context, parent, arguments)
    SelfHostPlannedExpressionKind::PlannedObjectNew(fields) => self_host_lowered_child_fields(context, parent, fields)
    SelfHostPlannedExpressionKind::PlannedConstruct(target, fields, _) => {
      // Constructor targets are source metadata, not evaluations. A unit
      // constructor can use its own ID. Still prove ownership when present.
      if target != 4294967295u32 {
        self_host_lowered_child_owned(context, parent, context.body.expressions, target, 1u32)
      }
      self_host_lowered_child_fields(context, parent, fields)
    }
    SelfHostPlannedExpressionKind::PlannedBinaryExpression(_, left, right) => self_host_lowered_child_pair(context, parent, left, right)
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, left, right, _) => self_host_lowered_child_pair(context, parent, left, right)
    SelfHostPlannedExpressionKind::PlannedIndexGet(left, right, _) => self_host_lowered_child_pair(context, parent, left, right)
    SelfHostPlannedExpressionKind::PlannedFieldSet(_, left, right) => self_host_lowered_child_pair(context, parent, left, right)
    SelfHostPlannedExpressionKind::PlannedIndexSet(first, second, third, _) => {
      self_host_lowered_child_pair(context, parent, first, second)
      self_host_lowered_child_expression(context, parent, third)
    }
    SelfHostPlannedExpressionKind::PlannedBuiltinCall(_, _, receiver, arguments, _) => {
      self_host_lowered_child_optional_expression(context, parent, receiver)
      self_host_lowered_child_arguments(context, parent, arguments)
    }
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, receiver, arguments, _) => {
      self_host_lowered_child_optional_expression(context, parent, receiver)
      self_host_lowered_child_arguments(context, parent, arguments)
    }
    SelfHostPlannedExpressionKind::PlannedFunctionValueCall(receiver, arguments, _) => {
      self_host_lowered_child_expression(context, parent, receiver)
      self_host_lowered_child_arguments(context, parent, arguments)
    }
    SelfHostPlannedExpressionKind::PlannedUnresolvedCall(target, arguments) => {
      self_host_lowered_child_expression(context, parent, target)
      self_host_lowered_child_arguments(context, parent, arguments)
    }
    SelfHostPlannedExpressionKind::PlannedLambdaClosure(lambda) => self_host_lowered_child_closure(context, parent, lambda)
    SelfHostPlannedExpressionKind::PlannedPoisonExpression => {}
    SelfHostPlannedExpressionKind::PlannedDeferredExpression => {}
    SelfHostPlannedExpressionKind::PlannedConsumedExpression => {}
    SelfHostPlannedExpressionKind::PlannedDeadExpression => {}
    SelfHostPlannedExpressionKind::PlannedUnitConst => {}
    SelfHostPlannedExpressionKind::PlannedI8Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedI16Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedI32Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedI64Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedU8Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedU16Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedU32Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedU64Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedF32Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedF64Const(_) => {}
    SelfHostPlannedExpressionKind::PlannedBoolConst(_) => {}
    SelfHostPlannedExpressionKind::PlannedStringConst(_) => {}
    SelfHostPlannedExpressionKind::PlannedStringArrayConst(_) => {}
    SelfHostPlannedExpressionKind::PlannedBytesConst(_) => {}
    SelfHostPlannedExpressionKind::PlannedCaptureGet(capture) => self_host_lowered_child_capture(context, parent, capture)
    SelfHostPlannedExpressionKind::PlannedModuleValueGet(_) => {}
    SelfHostPlannedExpressionKind::PlannedFunctionReference(_) => {}
  }
}

fn self_host_verify_lowered_body_children(module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, lambda: U32) -> Unit {
  self_host_assert_physical_body_span(body, body.expressions, module_.expressions.length(), 1u32)
  self_host_assert_physical_body_span(body, body.locals, module_.locals.length(), 2u32)
  self_host_assert_physical_body_span(body, body.blocks, module_.blocks.length(), 3u32)
  self_host_assert_physical_body_span(body, body.patterns, module_.patterns.length(), 4u32)
  self_host_assert_physical_body_span(body, body.pattern_arms, module_.pattern_arms.length(), 5u32)
  let context = SelfHostLoweredChildContext::{
    module_: module_
    body: body
    syntax_walk: Option::None
    phase: 6u32
    lambda: lambda
    locals: SelfHostHirSpan::{
      start: 0u32
      length: body.locals.length
    }
    lambdas: SelfHostHirSpan::{
      start: 0u32
      length: module_.lambdas.length()
    }
  }
  if lambda != 4294967295u32 {
    let _ = self_host_lowered_child_lambda(context, 4294967295u32, lambda)
  }
  let _ = while 0u32 {
    offset if offset < body.locals.length => {
      let index = body.locals.start + offset
      self_host_lowered_child_local_record(context, 4294967295u32, index, offset, lambda)
      continue offset + 1u32
    }
    _ => break self_host_semantic_unit()
  }
  self_host_verify_lowered_syntax_graph(context)
}

fn self_host_lowered_child_block_edges(context: SelfHostLoweredChildContext, index: U32) -> Unit {
  let module_ = context.module_
  let block = module_.blocks[index]
  self_host_lowered_child_span(context, 4294967295u32, block.items, module_.block_items.length(), 11u32)
  let _ = while 0u32 {
    item if item < block.items.length => {
      match module_.block_items[block.items.start + item].kind {
        SelfHostPlannedBlockItemKind::PlannedLetItem(local, _, value) => {
          self_host_lowered_child_local(context, 4294967295u32, local)
          self_host_lowered_child_expression(context, 4294967295u32, value)
        }
        SelfHostPlannedBlockItemKind::PlannedExpressionItem(value) => self_host_lowered_child_expression(context, 4294967295u32, value)
      }
      continue item + 1u32
    }
    _ => break self_host_semantic_unit()
  }
}

fn self_host_lowered_child_pattern_edges(context: SelfHostLoweredChildContext, index: U32) -> Unit {
  let module_ = context.module_
  let pattern = module_.patterns[index]
  match pattern.reference {
    SelfHostBodyPatternReference::PatternBindingReference(local) => self_host_lowered_child_local(context, 4294967295u32, local)
    _ => {}
  }
  match pattern.source {
    SelfHostHirPattern::LiteralPattern(expression, _) => self_host_lowered_child_expression(context, 4294967295u32, expression)
    SelfHostHirPattern::QualifiedPattern(base, _, _) => self_host_lowered_child_pattern(context, base)
    SelfHostHirPattern::TuplePattern(base, children, _) => {
      if base != 4294967295u32 {
        self_host_lowered_child_pattern(context, base)
      }
      self_host_lowered_child_patterns(context, children)
    }
    SelfHostHirPattern::ProductPattern(children, _) => self_host_lowered_child_patterns(context, children)
    SelfHostHirPattern::AlternativePattern(base, alternatives, _) => {
      self_host_lowered_child_pattern(context, base)
      self_host_lowered_child_patterns(context, alternatives)
    }
    SelfHostHirPattern::StructPattern(base, fields, _, _, _) => {
      if base != 4294967295u32 {
        self_host_lowered_child_pattern(context, base)
      }
      self_host_lowered_child_span(context, 4294967295u32, fields, module_.pattern_fields.length(), 15u32)
      let _ = while 0u32 {
        index if index < fields.length => {
          self_host_lowered_child_pattern(context, module_.pattern_fields[fields.start + index].pattern)
          continue index + 1u32
        }
        _ => break self_host_semantic_unit()
      }
    }
    SelfHostHirPattern::WildcardPattern(_) => {}
    SelfHostHirPattern::BindingPattern(_, _) => {}
    SelfHostHirPattern::ImportAliasPattern(_, _) => {}
    SelfHostHirPattern::RestPattern(_) => {}
  }
}

fn self_host_lowered_child_arm_edges(context: SelfHostLoweredChildContext, index: U32) -> Unit {
  let module_ = context.module_
  let arm = module_.pattern_arms[index]
  self_host_lowered_child_pattern(context, arm.pattern)
  self_host_lowered_child_optional_expression(context, 4294967295u32, arm.guard_condition)
  self_host_lowered_child_expression(context, 4294967295u32, arm.body)
}

fn self_host_test_signature_expression(source: SelfHostPlannedExpression, type_: I32, kind: SelfHostPlannedExpressionKind, shape: SelfHostPlannedValueShape) -> SelfHostPlannedExpression {
  SelfHostPlannedExpression::{
    type_: type_
    shape: shape
    nominal: source.nominal
    flow: source.flow
    kind: kind
    selection: source.selection
    reference: source.reference
    call_target: source.call_target
    call_type_arguments: source.call_type_arguments
    source_name: source.source_name
    member_base: source.member_base
    offset: source.offset
  }
}

fn self_host_test_function_value_signature(mutation: U32) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn run(value: fn(I32) -> I64) -> I64 {\n  value(7i32)\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, "valid callback plan before one mutation")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut checked = 0u32
  let mut expression_id = 0u32
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedFunctionValueCall(target, arguments, span) => {
        if mutation == 1u32 {
          let source = module_.expressions[target]
          module_.expressions[target] = self_host_test_signature_expression(source, -1i32, source.kind, source.shape)
        } else if mutation == 2u32 {
          module_.expressions[expression_id] = self_host_test_signature_expression(expression, expression.type_,
            SelfHostPlannedExpressionKind::PlannedFunctionValueCall(4294967295u32, arguments, span), expression.shape)
        } else if mutation == 4u32 {
          module_.expressions[expression_id] = self_host_test_signature_expression(expression, expression.type_, expression.kind,
            SelfHostPlannedValueShape::I32PlannedValueShape)
        }
        checked = checked + 1u32
      }
      _ => {}
    }
    expression_id = expression_id + 1u32
  }
  assert(checked == 1u32, "exactly one callback target checked")
  if mutation == 3u32 {
    let source = module_.bodies[0u32]
    module_.bodies[0u32] = SelfHostPlannedBodyLowering::{
      body: source.body
      declaration: source.declaration
      kind: source.kind
      root: source.root
      root_type: source.root_type
      root_shape: source.root_shape
      result_shape: source.result_shape
      flow: source.flow
      locals: source.locals
      local_initializers: source.local_initializers
      local_assignments: source.local_assignments
      expressions: SelfHostHirSpan::{
        start: 4294967295u32
        length: source.expressions.length
      }
      blocks: source.blocks
      patterns: source.patterns
      pattern_arms: source.pattern_arms
    }
  }
  let signatures = []
  let error = self_host_linked_append_function_value_signatures(link,
    StarshineFfi.ffi_ffi_bridge_rec_types_new(), signatures)
  assert(error is Option::None, "valid callback signature emits without a fallback")
  assert(signatures.length() == 1u32, "one exact callback signature")
}

test "function value signatures use the target function type" {
  self_host_test_function_value_signature(0u32)
}

test "lambda callback scopes retain their parent declaration" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn make(value: fn(I32) -> I64) -> fn() -> I64 {\n  fn() -> I64 {\n    value(7i32)\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let scopes = self_host_function_signature_scopes(link)
  assert(scopes.length() == 2u32, "one function scope and one lambda scope")
  for scope in scopes {
    assert(scope.declaration == module_.bodies[0u32].declaration, "scope retains the exact source declaration, not an anonymous placeholder")
    assert(scope.body == module_.bodies[0u32].body, "scope retains the root body identity")
  }
}

test "ABI-704 missing callback types cannot be rebuilt from operands" expect_trap "unreachable" {
  self_host_test_function_value_signature(1u32)
}

test "ARN-102 callback signature targets belong to their body" expect_trap "unreachable" {
  self_host_test_function_value_signature(2u32)
}

test "ARN-101 callback signature scopes require valid spans" expect_trap "unreachable" {
  self_host_test_function_value_signature(3u32)
}

test "ABI-709 callback signature results cannot disagree with the target" expect_trap "unreachable" {
  self_host_test_function_value_signature(4u32)
}

fn self_host_test_callback_signature_types(mutation: U32) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn run(value: fn() -> I64) -> I64 {\n  value()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut selected = 4294967295u32
  let mut index = 0u32
  for type_ in module_.resolved_types.types {
    match type_ {
      SelfHostResolvedType::FunctionType(parameters, _) => if parameters.length == 0u32 {
        assert(selected == 4294967295u32, "one zero-argument callback type")
        selected = index
      }
      _ => {}
    }
    index = index + 1u32
  }
  assert(selected != 4294967295u32, "fixture contains a zero-argument callback")
  let (parameters, result) = match module_.resolved_types.types[selected] {
    SelfHostResolvedType::FunctionType(parameters, result) => (parameters, result)
    _ => {
      assert(false, "selected type is a callback")
      unreachable()
    }
  }
  let mut body_type = -self_host_u32_to_i32(selected) - 2i32
  if mutation == 2u32 || mutation == 6u32 {
    body_type = self_host_u32_to_i32(module_.inferred.types.length())
    module_.inferred.types.push(SelfHostBodyTypeTerm::BodyFunctionType(self_host_empty_hir_span(0u32),
      -self_host_u32_to_i32(result) - 2i32))
  }
  let scope = self_host_function_signature_scopes(link)[0u32]
  let before = self_host_linked_append_body_function_signature(module_, Option::None, [], body_type, scope, 1u32,
    StarshineFfi.ffi_ffi_bridge_val_types_new(), StarshineFfi.ffi_ffi_bridge_val_types_new(),
    StarshineFfi.ffi_ffi_bridge_val_types_new(), StarshineFfi.ffi_ffi_bridge_val_types_new())
  assert(before is Option::Some(SelfHostPlannedValueShape::I64PlannedValueShape), "valid callback signature before one mutation")
  if mutation == 1u32 {
    module_.resolved_types.types[selected] = SelfHostResolvedType::FunctionType(
      SelfHostHirSpan::{
        start: 4294967295u32
        length: parameters.length
      }, result)
  } else if mutation == 2u32 || mutation == 6u32 {
    let start = if mutation == 2u32 {
      4294967295u32
    } else {
      0u32
    }
    let length = if mutation == 2u32 {
      0u32
    } else {
      1u32
    }
    module_.inferred.types[self_host_i32_to_u32(body_type)] = SelfHostBodyTypeTerm::BodyFunctionType(
      SelfHostHirSpan::{
        start: start
        length: length
      }, -self_host_u32_to_i32(result) - 2i32)
  } else if mutation == 3u32 {
    module_.resolved_types.types[result] = SelfHostResolvedType::ErrorType
  } else if mutation == 4u32 {
    module_.resolved_types.types[result] = SelfHostResolvedType::GenericParameterType(0u64)
  } else if mutation == 5u32 {
    module_.resolved_types.types[selected] = SelfHostResolvedType::FunctionType(parameters, 2147483647u32)
  } else if mutation == 7u32 {
    module_.resolved_types.types[result] = SelfHostResolvedType::FunctionType(parameters, module_.resolved_types.error_type)
  } else if mutation == 8u32 {
    module_.resolved_types.types[result] = SelfHostResolvedType::FunctionType(parameters, result)
  }
  let _ = self_host_linked_append_body_function_signature(module_, Option::None, [], body_type, scope, 1u32,
    StarshineFfi.ffi_ffi_bridge_val_types_new(), StarshineFfi.ffi_ffi_bridge_val_types_new(),
    StarshineFfi.ffi_ffi_bridge_val_types_new(), StarshineFfi.ffi_ffi_bridge_val_types_new())
}

test "ARN-101 empty resolved callback parameter spans remain checked" expect_trap "unreachable" {
  self_host_test_callback_signature_types(1u32)
}

test "ARN-101 empty inferred callback parameter spans remain checked" expect_trap "unreachable" {
  self_host_test_callback_signature_types(2u32)
}


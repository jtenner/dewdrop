  self_host_test_callback_signature_types(3u32)
}

test "SPC-301 callback generic results cannot become references" expect_trap "unreachable" {
  self_host_test_callback_signature_types(4u32)
}

test "SOL-207 callback resolved results cannot overflow type encoding" expect_trap "unreachable" {
  self_host_test_callback_signature_types(5u32)
}

test "ARN-101 inferred callback parameters cannot exceed their arena" expect_trap "unreachable" {
  self_host_test_callback_signature_types(6u32)

open dew.std.string_builder
open dew.std.testing

fn self_host_module_value_infer_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostResolvedModuleTypes,
  SelfHostResolvedModuleNames,
  SelfHostInferredModuleValues,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let values = self_host_infer_module_values(collected, resolved, names)
  (collected, resolved, names, values)
}

fn self_host_assert_imported_body_primitive(
  body: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
  primitive: SelfHostPrimitiveType,
  message: String,
) -> Unit {
  match body.type_term(type_) {
    BodyResolvedType(resolved_type) => assert(
      resolved_type == resolved.primitive(primitive),
      message,
    )
    _ => assert(false, message)
  }
}

fn self_host_assert_module_value_primitive(
  values: SelfHostInferredModuleValues,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
  primitive: SelfHostPrimitiveType,
  message: String,
) -> Unit {
  match values.type_term(type_) {
    BodyResolvedType(resolved_type) => assert(
      resolved_type == resolved.primitive(primitive),
      message,
    )
    _ => assert(false, message)
  }
}

test "module value inference resolves dependency-first references" {
  let (collected, resolved, names, values) = self_host_module_value_infer_source(
    960u64,
    b"let first = second + 1\nlet second = 2\nlet third = first + second\n",
  )
  assert(collected.diagnostics.length() == 0u32, "collection diagnostics")
  assert(resolved.diagnostics.length() == 0u32, "type diagnostics")
  assert(names.diagnostics.length() == 0u32, "name diagnostics")
  assert(values.diagnostics.length() == 0u32, "inference diagnostics")
  assert(values.let_types.length() == 3u32, "three values")
  for type_ in values.let_types {
    self_host_assert_module_value_primitive(
      values,
      resolved,
      type_,
      I32Type,
      "I32 value",
    )
  }
}

test "module value inference shares one solver across a cycle" {
  let (_, resolved, _, values) = self_host_module_value_infer_source(
    961u64,
    b"let first = second\nlet second = first + 1\n",
  )
  assert(values.dependencies.sccs.length() == 1u32, "one SCC")
  assert(values.diagnostics.length() == 0u32, "cycle is constrained")
  self_host_assert_module_value_primitive(
    values,
    resolved,
    values.let_types[0u32],
    I32Type,
    "first I32",
  )
  self_host_assert_module_value_primitive(
    values,
    resolved,
    values.let_types[1u32],
    I32Type,
    "second I32",
  )
}

test "unconstrained module value cycles are diagnosed" {
  let (collected, _, _, values) = self_host_module_value_infer_source(
    962u64,
    b"let first = second\nlet second = first\nlet third = third\n",
  )
  let mut unresolved = 0u32
  let found = [false, false, false]
  for diagnostic in values.diagnostics {
    match diagnostic {
      UnresolvedModuleValue(declaration, _) => {
        unresolved = self_host_u32_add(unresolved, 1u32)
        let mut index = 0u32
        let _ = while index {
          current => if current < collected.lets.length() {
            let candidate = collected.lets[current].declaration
            if self_host_u64_equal(candidate, declaration) {
              found[current] = true
            }
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      _ => {}
    }
  }
  let message = StringBuilder::new()
  message.append("unresolved values: ")
  message.append_u32(unresolved)
  message.append(" declarations ")
  for diagnostic in values.diagnostics {
    match diagnostic {
      UnresolvedModuleValue(declaration, _) => {
        message.append_u32(self_host_semantic_id_local(declaration))
        message.append(" ")
      }
      _ => {}
    }
  }
  message.append("found ")
  for value in found {
    if value {
      message.append("1")
    } else {
      message.append("0")
    }
  }
  assert(unresolved == 3u32, message.finish())
}

fn self_host_module_value_chain(length: U32) -> Bytes {
  let builder = StringBuilder::new()
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      builder.append("let value_")
      builder.append_u32(current)
      if self_host_u32_add(current, 1u32) < length {
        builder.append(" = value_")
        builder.append_u32(self_host_u32_add(current, 1u32))
      } else {
        builder.append(" = 1")
      }
      builder.append("\n")
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.finish().as_bytes()
}

test "frozen module value types import into function solvers" {
  let collected = self_host_collect_bytes(
    964u64,
    b"let value = 1\nfn read() -> I32 {\n  value\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  let body = inferred.bodies[1u32]
  assert(body.diagnostics.length() == 0u32, "function diagnostics")
  self_host_assert_imported_body_primitive(
    body,
    resolved,
    body.root_type,
    I32Type,
    "function result I32",
  )
}

fn self_host_assert_applied_imported_body(
  body: SelfHostBasicInferredBody,
) -> Unit {
  assert(body.diagnostics.length() == 0u32, "applied function diagnostics")
  match body.type_term(body.root_type) {
    BodyAppliedType(_, arguments) => assert(
      arguments.length == 1u32,
      "one applied argument",
    )
    _ => assert(false, "applied function result")
  }
}

test "applied module value types import into function solvers" {
  let collected = self_host_collect_bytes(
    965u64,
    b"struct Box<t> {\n  value: t\n}\nbuiltin box<t>(value: t) -> Box<t> = \"box\"\nlet boxed = box(1)\nfn read() -> Box<I32> {\n  boxed\n}\n",
  )
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  self_host_assert_applied_imported_body(inferred.bodies[1u32])
}

test "module value inference remains iterative for 1024 dependencies" {
  let (_, resolved, _, values) = self_host_module_value_infer_source(
    963u64,
    self_host_module_value_chain(1024u32),
  )
  assert(values.diagnostics.length() == 0u32, "chain diagnostics")
  assert(values.let_types.length() == 1024u32, "chain values")
  self_host_assert_module_value_primitive(
    values,
    resolved,
    values.let_types[0u32],
    I32Type,
    "chain head I32",
  )
}

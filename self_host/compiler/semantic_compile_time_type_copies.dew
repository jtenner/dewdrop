open dew.std.array

fn self_host_clone_query_evidence(source: SelfHostBasicModuleEvidence) -> SelfHostBasicModuleEvidence {
  let bodies = []
  for body in source.bodies {
    bodies.push(SelfHostBasicBodyEvidence::{
      body: body.body
      expression_evidence: body.expression_evidence.copy()
      evidence: body.evidence.copy()
      prerequisite_indices: body.prerequisite_indices.copy()
    })
  }
  SelfHostBasicModuleEvidence::{
    module_id: source.module_id
    bodies: bodies
  }
}

fn self_host_clone_query_inferred(source: SelfHostMergedModuleInference) -> SelfHostMergedModuleInference {
  SelfHostMergedModuleInference::{
    module_id: source.module_id
    jobs: source.jobs
    types: source.types
    type_arguments: source.type_arguments
    expression_types: source.expression_types
    local_types: source.local_types
    capture_types: source.capture_types
    block_types: source.block_types
    pattern_types: source.pattern_types
    control_state_types: source.control_state_types
    control_result_types: source.control_result_types
    call_targets: source.call_targets
    operator_targets: source.operator_targets
    expression_selections: source.expression_selections
    object_field_targets: source.object_field_targets
    pattern_constructors: source.pattern_constructors
    call_type_arguments: source.call_type_arguments.copy()
    expression_type_arguments: source.expression_type_arguments
    pattern_type_arguments: source.pattern_type_arguments
    unsupported_expressions: source.unsupported_expressions
    diagnostics: source.diagnostics
  }
}


// Private instance copies. Shared interfaces and unrelated plan fields stay intact.

fn self_host_clone_query_resolved(source: SelfHostResolvedModuleTypes) -> SelfHostResolvedModuleTypes {
  SelfHostResolvedModuleTypes::{
    module_id: source.module_id
    types: source.types.copy()
    type_arguments: source.type_arguments.copy()
    syntax_types: source.syntax_types
    declaration_types: source.declaration_types
    generic_parameter_types: source.generic_parameter_types
    generic_bound_types: source.generic_bound_types
    parameter_types: source.parameter_types
    callable_return_types: source.callable_return_types
    callable_function_types: source.callable_function_types
    lambda_parameter_types: source.lambda_parameter_types
    lambda_return_types: source.lambda_return_types
    lambda_function_types: source.lambda_function_types
    explicit_call_type_arguments: source.explicit_call_type_arguments
    field_types: source.field_types
    variant_payloads: source.variant_payloads
    signature_type_lists: source.signature_type_lists
    alias_target_types: source.alias_target_types
    impl_trait_types: source.impl_trait_types
    impl_target_types: source.impl_target_types
    alias_dependencies: source.alias_dependencies
    alias_dependency_declarations: source.alias_dependency_declarations
    alias_is_cyclic: source.alias_is_cyclic
    alias_cycles: source.alias_cycles
    alias_cycle_declarations: source.alias_cycle_declarations
    alias_expansion_work: source.alias_expansion_work
    alias_expansion_limit: source.alias_expansion_limit
    diagnostics: source.diagnostics
    error_type: source.error_type
    primitive_types: source.primitive_types
  }
}

fn self_host_clone_query_functions(source: SelfHostPlannedModuleFunctions) -> SelfHostPlannedModuleFunctions {
  SelfHostPlannedModuleFunctions::{
    module_id: source.module_id
    callables: source.callables.copy()
    callable_by_declaration: source.callable_by_declaration
    parameters: source.parameters.copy()
  }
}

fn self_host_query_expression_type(source: SelfHostPlannedExpression, module_: SelfHostPlannedModuleLowering, type_: I32) -> SelfHostPlannedExpression {
  SelfHostPlannedExpression::{
    type_: type_
    shape: self_host_planned_resolved_value_shape(module_.resolved_types, self_host_body_i32_to_u32(-(type_ + 2i32)))
    nominal: self_host_lowering_resolved_nominal(module_.resolved_types, self_host_body_i32_to_u32(-(type_ + 2i32)))
    flow: source.flow
    kind: source.kind
    selection: source.selection
    reference: source.reference
    call_target: source.call_target
    call_type_arguments: source.call_type_arguments
    source_name: source.source_name
    member_base: source.member_base
    offset: source.offset
  }
}

fn self_host_query_local_type(source: SelfHostPlannedLocal, module_: SelfHostPlannedModuleLowering, type_: I32) -> SelfHostPlannedLocal {
  SelfHostPlannedLocal::{
    body: source.body
    lambda: source.lambda
    local_id: source.local_id
    elided: source.elided
    kind: source.kind
    mutable_: source.mutable_
    type_: type_

  }
}

fn self_host_query_pattern_type(source: SelfHostPlannedPattern, module_: SelfHostPlannedModuleLowering, type_: I32) -> SelfHostPlannedPattern {
  SelfHostPlannedPattern::{
    elided: source.elided
    type_: type_
    shape: self_host_planned_resolved_value_shape(module_.resolved_types, self_host_body_i32_to_u32(-(type_ + 2i32)))
    source: source.source
    reference: source.reference
    selected_constructor: source.selected_constructor
    offset: source.offset

test "reflected expression offsets sort across all byte positions" {
  let type_ = CtReflectedType::{
    kind: "named"
    name: "I32"
    arguments: []
  }
  let values = array_new::<CtExpressionType>()
  for offset in [4294967295u32, 256u32, 0u32, 65536u32, 255u32, 16777216u32] {
    values.push(CtExpressionType::{
      offset: offset
      kind: "name"
      type_: type_
    })
  }
  let sorted = ct_sort_expression_types(values)
  assert(sorted.length() == 6u32, "sort retains every site")
  assert(sorted[0u32].offset == 0u32, "first byte")
  assert(sorted[5u32].offset == 4294967295u32, "last U32 byte")
  let _ = while 1u32 {
    index if index < sorted.length() => {
      assert(sorted[index - 1u32].offset < sorted[index].offset, "strict source order")
      continue index + 1u32
    }
    _ => break ()
  }
}

test "reflected types retain generic parameters and nominal record identity" {
  let program = self_host_collect_program_manifest(7200u64, {
    modules: [{
      path: "example.app"
      files: [{
        path: "reflection.dew"
        source: b"struct Box<t> {\n value: t\n}\nfn identity<t>(value: t) -> t {\n value\n}\nfn boxed<t>(value: t) -> Box<t> {\n Box::{\n value: value\n }\n}\n"
        test_only: false
      }]
    }]
  })
  let lowering = self_host_plan_program_lowering(self_host_freeze_program_signature_interfaces(program))
  let source = program.modules.at(0u32)
  let module_ = lowering.modules[0u32]
  let cache = map_empty::<I32, CtReflectedType>()
  let mut found_parameter = false
  let mut found_record = false
  let mut index = 0u32
  for expression in source.expressions {
    let reflected = ct_reflected_type(program, module_, module_.inferred.expression_types[index], cache, 0u32)
    match expression {
      NameExpr(name, _) if source.name(name) == "value" => match reflected {
        Some(type_) => {
          assert(type_.kind == "parameter" && type_.name == "t", "parameter keeps its declared name")
          found_parameter = true
        }
        None => assert(false, "checked value needs a reflected type")
      }
      ConstructExpr(_, _, _) => match reflected {
        Some(type_) => {
          assert(type_.kind == "applied", "generic record is an applied type")
          assert(type_.arguments[0u32].kind == "nominal" && type_.arguments[0u32].name == "example.app::Box", "record keeps its logical module and name")
          assert(type_.arguments[1u32].kind == "parameter" && type_.arguments[1u32].name == "t", "record keeps its generic argument")
          found_record = true
        }
        None => assert(false, "checked constructor needs a reflected type")
      }
      _ => {}
    }
    index = index + 1u32
  }
  assert(found_parameter && found_record, "both expression forms were checked")
}

test "shared nested type prototypes retain visible work limits" {
  let machine = ct_machine(ct_test_plan(b""))
  let mut type_ = CtReflectedType::{
    kind: "named"
    name: "I32"
    arguments: []
  }
  let _ = while 0u32 {
    index if index < 60u32 => {
      type_ = CtReflectedType::{
        kind: "function"
        name: ""
        arguments: [type_, type_]
      }
      continue index + 1u32
    }
    _ => break ()
  }
  let _ = ct_reflected_type_node(machine, type_, 0u32)
  assert(machine.error.contains("limit exceeded"), "shared type graph cannot bypass work or allocation limits")
}


test "reflected methods main expression and block keep I32 after a lambda" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "reflection-methods.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.array\nopen dew.std.string\n\nstruct Counter {\n  mut value: I32\n}\n\nimpl Counter {\n  fn new(value: I32) -> Counter {\n    Counter::{\n      value: value\n    }\n  }\n  fn add(self, amount: I32) -> Unit {\n    self.value = self.value + amount\n  }\n  fn answer(self) -> I32 {\n    self.value\n  }\n}\n\nfn twice(value: I32) -> I32 {\n  value * 2i32\n}\n\nfn apply(value: I32, callback: fn(I32) -> I32) -> I32 {\n  callback(value)\n}\n\ntransform fn replace(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  if ctx.expression_types.length() != 2u32 {\n    return node.with_body(@ast.integer(0i32))\n  }\n  let block_type = ctx.expression_types[0u32]\n  let literal_type = ctx.expression_types[1u32]\n  if block_type.kind != \"block\" || literal_type.kind != \"I32\" || block_type.type_.kind != \"named\" || block_type.type_.name != \"I32\" || literal_type.type_.kind != \"named\" || literal_type.type_.name != \"I32\" {\n    return node.with_body(@ast.integer(0i32))\n  }\n  let counter = Counter::new(apply(10i32, twice))\n  let alias = counter\n  alias.add(20i32)\n  let mut extra = 1i32\n  let callback = fn(value: I32) -> I32 {\n    extra = extra + 1i32\n    return value + extra\n  }\n  node.with_body(@ast.integer(apply(counter.answer(), callback)))\n}\n\n#replace\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Err(error) => assert(false, error)
    Ok(expanded) => {
      let mut found = false
      for file in expanded.modules[0u32].files {
        if file.path.contains("::transform[main@") {
          found = true
          assert(file.source.to_string().contains("42i32"), "methods main reflected I32 expression and block")
        }
      }
      assert(found, "methods main generated file")
    }
  }
}

test "reflected expressions and blocks follow multiple lambda and function source spans" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "reflection-order.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.array\nopen dew.std.string\n\ntype Signed = I32\n\nfn first() -> I32 {\n  let callback = fn() -> I32 {\n    return 7i32\n  }\n  callback()\n}\n\ntransform fn verify(node: @ast.FnNode, ctx: @transform.TransformContext) -> Result<@ast.FnNode, @transform.TransformError> {\n  let expected = if node.name == \"wide\" {\n    \"I64\"\n  } else {\n    \"I32\"\n  }\n  if ctx.expression_types.length() != 2u32 {\n    return Result::Err(@transform.error(\"missing reflected expression or block\"))\n  }\n  let block_type = ctx.expression_types[0u32]\n  let literal_type = ctx.expression_types[1u32]\n  if block_type.kind != \"block\" || literal_type.kind != expected || block_type.type_.kind != \"named\" || block_type.type_.name != expected || literal_type.type_.kind != \"named\" || literal_type.type_.name != expected {\n    return Result::Err(@transform.error(\"reflected source expression or block type changed after a lambda\"))\n  }\n  Result::Ok(node)\n}\n\n#verify\nfn narrow() -> Signed {\n  1i32\n}\n\nfn second() -> I64 {\n  let callback = fn() -> I64 {\n    let nested = fn() -> I64 {\n      return 8i64\n    }\n    return nested()\n  }\n  callback()\n}\n\n#verify\npub fn wide() -> I64 {\n  2i64\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_source_pool(manifest, ct_frames_test_source_pool(), true) {
    Err(error) => assert(false, error)
    Ok(expanded) => {
      let mut narrow = false
      let mut wide = false
      for file in expanded.modules[0u32].files {
        if file.path.contains("::transform[narrow@") {
          narrow = true
          assert(file.source.to_string().contains("-> Signed"), "logical alias type is retained")
        }
        if file.path.contains("::transform[wide@") {
          wide = true
          assert(file.source.to_string().contains("2i64"), "I64 source body is retained")
        }
      }
      assert(narrow && wide, "both checked source-order targets expanded")
    }
  }
}

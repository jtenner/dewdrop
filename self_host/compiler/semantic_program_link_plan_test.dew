open dew.std.testing

fn self_host_link_test_plan(
  source: Bytes,
) -> SelfHostPlannedProgramWasmGCLink {
  self_host_plan_program_wasmgc_link(
    self_host_plan_program_wasmgc_fragments(
      self_host_specialization_test_plan(source),
    ),
    false,
  )
}

test "program link assigns imports before defined functions" {
  let link = self_host_link_test_plan(
    b"foreign impl \"host\" as host {\n  fn read(value: I32) -> I32 = \"read\"\n}\npub fn run() -> I32 {\n  read(1)\n}\n",
  )
  assert(self_host_u32_equal(link.imported_function_count, 1u32), "one import")
  assert(self_host_u32_equal(link.defined_function_count, 1u32), "one definition")
  assert(self_host_u32_equal(link.functions[0u32].function_index, 0u32), "import index")
  assert(link.functions[0u32].imported, "import class")
  assert(self_host_u32_equal(link.functions[1u32].function_index, 1u32), "defined index")
  assert(!link.functions[1u32].imported, "defined class")
}

test "program link resolves specialized call targets" {
  let link = self_host_link_test_plan(
    b"fn identity<t>(value: t) -> t {\n  value\n}\npub fn run() -> I64 {\n  identity(42i64)\n}\n",
  )
  assert(self_host_u32_equal(link.diagnostics.length(), 0u32), "link diagnostics")
  assert(self_host_u32_equal(link.specialized_calls.length(), 1u32), "specialized call")
  let call = link.specialized_calls[0u32]
  let function_ = link.functions[call.function_index]
  assert(self_host_u32_equal(function_.specialization, 0u32), "specialized target")
  assert(!function_.imported, "specialized definition")
}

test "program link assigns dependency-first types and module globals" {
  let lowering = self_host_program_lowering_test_manifest([
    SelfHostManifestModule::{
      path: "app.main"
      files: [
        SelfHostManifestFile::{
          path: "main.dew"
          source: b"open app.library\nstruct Root {}\npub let answer = 42\npub fn run() -> I32 {\n  answer\n}\n"
          test_only: false
        },
      ]
    },
    SelfHostManifestModule::{
      path: "app.library"
      files: [
        SelfHostManifestFile::{
          path: "library.dew"
          source: b"pub struct Leaf {}\n"
          test_only: false
        },
      ]
    },
  ])
  let link = self_host_plan_program_wasmgc_link(
    self_host_plan_program_wasmgc_fragments(
      self_host_plan_program_specialization(lowering, false),
    ),
    false,
  )
  assert(self_host_u32_equal(link.module_type_bases[1u32], 0u32), "dependency type base")
  assert(self_host_u32_equal(link.module_type_bases[0u32], 1u32), "consumer type base")
  assert(self_host_u32_equal(link.initializers.length(), 1u32), "initializer")
  assert(self_host_u32_equal(link.global_count, 1u32), "global count")
  assert(self_host_u32_equal(link.initializers[0u32].global_index, 0u32), "global index")
}

fn self_host_required_variant_constructor(plan: SelfHostPlannedPhysicalBodyCarrierPlan, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, arguments: SelfHostHirSpan) -> SelfHostPhysicalVariantConstructorPlan {
  let mut selected = Option::None
  for recipe in plan.variant_constructors {
    if recipe.expression == expression {
      if selected is Option::Some(_) {
        self_host_constructor_field_failure(module_, body, expression, 7u32, 610u32, 1u64, 2u64, 40u64)
      }
      selected = Option::Some(recipe)
    }
  }
  let recipe = match selected {
    Option::Some(value) => value
    Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, 40u64)
  }
  if recipe.arguments.start != arguments.start {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, u32_into_u64(recipe.arguments.start), u32_into_u64(arguments.start), 41u64)
  }
  if recipe.arguments.length != arguments.length {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, u32_into_u64(recipe.arguments.length), u32_into_u64(arguments.length), 42u64)
  }
  if !self_host_array_span_is_valid(recipe.operands.start, recipe.operands.length, plan.variant_constructor_operands.length()) {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 101u32, u32_into_u64(plan.variant_constructor_operands.length()), u32_into_u64(recipe.operands.length), u32_into_u64(recipe.operands.start))
  }
  recipe
}

fn self_host_schedule_planned_variant_constructor(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, arguments: SelfHostHirSpan, tasks: Array<SelfHostLinkedI32EmitTask>, expression_depths: Array<U32>, destination: StarshineInstructions, depth: U32) -> Unit {
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, 43u64)
  }
  let recipe = self_host_required_variant_constructor(plan, module_, body, expression, arguments)
  tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(recipe.physical_type, destination))
  // Push work in reverse so each source expression executes once, left to right.
  // No target, carrier, field, boxing, or cast lookup is repeated here.
  while recipe.operands.length {
    count if count > 0u32 => {
      let index = count - 1u32
      let operand = plan.variant_constructor_operands[recipe.operands.start + index]
      match operand.box_type {
        Option::Some(type_) => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedStructNew(type_, destination))
        Option::None => {}
      }
      match operand.reference_cast {
        Option::Some(type_) => tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefCast(type_, destination))
        Option::None => {}
      }
      if operand.unit_marker {
        tasks.push(SelfHostLinkedI32EmitTask::EmitLinkedRefNull(destination))
      }
      self_host_linked_i32_schedule_expression(tasks, expression_depths, operand.expression, destination, depth)
      continue index
    }
    _ => break ()
  }
}

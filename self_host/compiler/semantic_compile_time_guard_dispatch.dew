open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

fn self_host_guard_call_expression(source: SelfHostPlannedExpression, kind: SelfHostPlannedExpressionKind, target: U64, arguments: SelfHostHirSpan) -> SelfHostPlannedExpression {
  {
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    flow: source.flow
    kind: kind
    selection: source.selection
    reference: source.reference
    call_target: SelectedBasicCallTarget(target, arguments)
    call_type_arguments: arguments
    source_name: source.source_name
    member_base: source.member_base
    offset: source.offset
  }
}

fn self_host_guard_append_argument(module_: SelfHostPlannedModuleLowering, type_: SelfHostCompileTimeType) -> Unit {
  let id = self_host_query_append_resolved(module_, type_)
  module_.inferred.call_type_arguments.push(-self_host_body_u32_to_i32(id) - 2i32)
}

fn self_host_guard_witness_node(evidence: SelfHostBasicBodyEvidence, witness: SelfHostCompileTimeTraitWitness) -> SelfHostBasicTraitEvidence {
  let roots = self_host_empty_semantic_ids()
  for child in witness.prerequisites {
    let node = self_host_guard_witness_node(evidence, child)
    roots.push(evidence.evidence.length())
    evidence.evidence.push(node)
  }
  let start = evidence.prerequisite_indices.length()
  for root in roots {
    evidence.prerequisite_indices.push(root)
  }
  {
    implementation: witness.implementation.declaration
    prerequisites: {
      start: start
      length: roots.length()
    }
  }
}

fn self_host_guard_store_evidence(lowering: SelfHostPlannedProgramLowering, specialization: U32, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, witnesses: Array<SelfHostCompileTimeTraitWitness>) -> Unit {
  match lowering.compile_time.instances.get(specialization) {
    Some(instance) => instance.guarded_evidence.set(expression, witnesses)
    None => {
      self_host_assert_compiler_invariant(false, "SPC-303 guarded proof has no selected instance")
      unreachable()
    }
  }
  if expression < body.expressions.start || expression - body.expressions.start >= body.expressions.length {
    // Lambda expression IDs belong to their own span, not the root body's
    // body-relative legacy evidence table. The selected instance owns the proof.
    for lambda in module_.lambdas {
      if lambda.root_body == body.body && expression >= lambda.expressions.start && expression - lambda.expressions.start < lambda.expressions.length {
        return
      }
    }
    self_host_assert_compiler_invariant(false, "ARN-102 guarded proof belongs to another body")
    unreachable()
  }
  match module_.evidence.evidence_body(body.declaration) {
    Some(evidence) => {
      let roots = []
      for witness in witnesses {
        roots.push(self_host_guard_witness_node(evidence, witness))
      }
      let start = evidence.evidence.length()
      for root in roots {
        evidence.evidence.push(root)
      }
      self_host_assert_compiler_invariant(expression >= body.expressions.start && expression - body.expressions.start < evidence.expression_evidence.length(), "ARN-102 guarded evidence expression ownership")
      evidence.expression_evidence[expression - body.expressions.start] = {
        start: start
        length: roots.length()
      }
    }
    None => {
      let _ = self_host_assert_compiler_invariant(witnesses.length() == 0u32, "EVD-212 guarded call has no evidence body")
    }
  }
}

fn self_host_resolve_guarded_call(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32, source: SelfHostPlannedExpression, callable: SelfHostPlannedCallable, trait_: U64, bindings: SelfHostCompileTimeBindings, search: SelfHostCompileTimeEvidenceSearch) -> Result<SelfHostPlannedExpression, String> {
  let receiver = match source.kind {
    PlannedDirectCall(_, callee, _, _) => {
      if callee >= module_.expressions.length() {
        return Err("CT-040 guarded trait call has no callee")
      }
      module_.expressions[callee].member_base
    }
    PlannedOperatorCall(_, _, receiver, _, _) => receiver
    _ => return Err("CT-040 guarded call has no direct recipe")
  }
  if receiver >= module_.expressions.length() {
    return Err("CT-040 guarded trait call has no receiver")
  }
  let target = match self_host_read_compile_time_type(module_, module_.expressions[receiver].type_, bindings, 0u32) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let arguments = match self_host_read_compile_time_arguments(module_, source.call_type_arguments, bindings) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let trait_count = callable.owner_generic_parameters.length
  if arguments.length() != trait_count + callable.generic_parameters.length {
    return Err("CT-040 guarded trait argument count mismatch")
  }
  let trait_arguments = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    index => if index < trait_count {
      trait_arguments.push(arguments[index])
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let trait_type = if trait_count == 0u32 {
    TraitCompileTimeType(trait_)
  } else {
    AppliedCompileTimeType(TraitCompileTimeType(trait_), trait_arguments)
  }
  search.budget.steps = 0u32
  let witness = match search.witness(target, trait_type) {
    Ok(value) => match value {
      Some(witness) => witness
      None => return Err("CT-040 selected branch has no trait implementation")
    }
    Err(error) => return Err(error)
  }
  let methods = witness.implementation.methods
  self_host_assert_compiler_invariant(self_host_array_span_is_valid(methods.start, methods.length, witness.index.methods.length()), "ARN-101 guarded implementation methods")
  let mut method = 18446744073709551615u64
  let _ = while 0u32 {
    index => if index < methods.length {
      let candidate = witness.index.methods[methods.start + index]
      match candidate.requirement {
        Some(requirement) => if requirement == callable.declaration {
          if method != 18446744073709551615u64 {
            return Err("CT-015 ambiguous guarded implementation method")
          }
          method = candidate.declaration
        }
        None => {}
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if method == 18446744073709551615u64 {
    return Err("CT-040 trait implementation has no required method")
  }
  let owner = match lowering.index.declaration_owner(method) {
    Some(value) => value
    None => return Err("CT-040 guarded method has no module")
  }
  let collected = lowering.collected.modules.at(owner)
  let method_module = lowering.modules[owner]
  let implementation_callable = match self_host_program_specialization_callable(method_module, method) {
    Some(value) => value
    None => return Err("CT-040 guarded method has no callable")
  }
  if implementation_callable.parameters.length != callable.parameters.length ||
    implementation_callable.has_receiver != callable.has_receiver ||
    implementation_callable.generic_parameters.length != callable.generic_parameters.length {
    return Err("CT-040 guarded implementation signature mismatch")
  }
  let required_owner = match lowering.index.declaration_owner(callable.declaration) {
    Some(value) => value
    None => return Err("CT-040 guarded requirement has no module")
  }
  let required_collected = lowering.collected.modules.at(required_owner)
  let requirement_module = lowering.modules[required_owner]
  let expected_bindings = self_host_empty_compile_time_bindings()
  let actual_bindings = self_host_empty_compile_time_bindings()
  for entry in witness.bindings.parameters {
    actual_bindings.parameters.set(entry.key(), entry.value())
  }
  while 0u32 {
    offset if offset < trait_count => {
      expected_bindings.parameters.set(required_collected.generic_parameters[callable.owner_generic_parameters.start + offset].id, arguments[offset])
      continue offset + 1u32
    }
    _ => break ()
  }
  while 0u32 {
    offset if offset < callable.generic_parameters.length => {
      expected_bindings.parameters.set(required_collected.generic_parameters[callable.generic_parameters.start + offset].id, arguments[trait_count + offset])
      actual_bindings.parameters.set(collected.generic_parameters[implementation_callable.generic_parameters.start + offset].id, arguments[trait_count + offset])
      continue offset + 1u32
    }
    _ => break ()
  }
  while 0u32 {
    offset if offset <= callable.parameters.length => {
      let expected_type = if offset == callable.parameters.length {
        callable.result_type
      } else {
        requirement_module.functions.parameters[callable.parameters.start + offset].type_
      }
      let actual_type = if offset == callable.parameters.length {
        implementation_callable.result_type
      } else {
        method_module.functions.parameters[implementation_callable.parameters.start + offset].type_
      }
      let expected = match self_host_read_compile_time_resolved_arena_with_self(requirement_module.resolved_types, expected_type, expected_bindings, 0u32, trait_, Some(target)) {
        Ok(value) => value
        Err(_) => return Err("CT-040 invalid guarded requirement signature")
      }
      let actual = match self_host_read_compile_time_resolved_arena_with_self(method_module.resolved_types, actual_type, actual_bindings, 0u32, witness.implementation.declaration, Some(target)) {
        Ok(value) => value
        Err(_) => return Err("CT-040 invalid guarded implementation signature")
      }
      match self_host_compile_time_types_equal(actual, expected) {
        Ok(equal) => if !equal {
          let detail = StringBuilder::new()
          detail.append("CT-040 guarded implementation signature mismatch slot=")
          detail.append_u32(offset)
          detail.append(" expected_type=")
          detail.append_u32(expected_type)
          detail.append(" actual_type=")
          detail.append_u32(actual_type)
          match expected {
            ParameterCompileTimeType(id) => {
              detail.append(" expected_parameter=")
              detail.append_u64(id)
            }
            _ => {}
          }
          match actual {
            ParameterCompileTimeType(id) => {
              detail.append(" actual_parameter=")
              detail.append_u64(id)
            }
            _ => {}
          }
          return Err(detail.finish())
        }
        Err(error) => return Err(error)
      }
      continue offset + 1u32
    }
    _ => break ()
  }
  let generics = collected.generic_parameters_of(witness.implementation.declaration)
  // Query and bound-call demand is closed before requests are created.
  // The selected implementation already participates in that source scan.
  // Reclassifying it here would invalidate earlier carrier-only requests.
  let start = module_.inferred.call_type_arguments.length()
  let _ = while 0u32 {
    index => if index < generics.length {
      let parameter = collected.generic_parameters[generics.start + index].id
      match witness.bindings.parameters.get(parameter) {
        Some(type_) => self_host_guard_append_argument(module_, type_)
        None => return Err("CT-011 unresolved guarded implementation parameter")
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = while trait_count {
    index => if index < arguments.length() {
      self_host_guard_append_argument(module_, arguments[index])
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let span = {
    start: start
    length: module_.inferred.call_type_arguments.length() - start
  }
  // Self-host body evidence roots describe the selected implementation itself;
  // its bound proofs are children, not alternate call-target roots.
  self_host_guard_store_evidence(lowering, specialization, module_, body, expression, [witness])
  let kind = match source.kind {
    PlannedDirectCall(_, receiver, arguments, _) => PlannedDirectCall(method, receiver, arguments, span)
    PlannedOperatorCall(_, operator, left, right, _) => PlannedOperatorCall(method, operator, left, right, span)
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 guarded call changed during resolution")
      unreachable()
    }
  }
  Ok(self_host_guard_call_expression(source, kind, method, span))
}

fn self_host_resolve_guarded_calls(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, bindings: SelfHostCompileTimeBindings, owned: Array<U32>, live: Array<Bool>) -> Unit {
  let mut search = None
  for expression in owned {
    if live[expression] {
      let source = module_.expressions[expression]
      let requirement = match source.call_target {
        SelectedBasicCallTarget(target, _) => Some(target)
        BoundTraitBasicCallTarget(target, _, _, _) => Some(target)
        _ => None
      }
      match requirement {
        Some(requirement) => match lowering.index.declaration_owner(requirement) {
          Some(owner) => match self_host_program_specialization_callable(lowering.modules[owner], requirement) {
            Some(callable) => match callable.kind {
              PlannedTraitMethodCallable(trait_) => {
                if search is None {
                  let caller_owner = match lowering.index.declaration_owner(body.declaration) {
                    Some(value) => value
                    None => {
                      self_host_assert_compiler_invariant(false, "LNK-504 guarded caller has no module")
                      unreachable()
                    }
                  }
                  let collected = lowering.collected.modules.at(caller_owner)
                  let context = lowering.compile_time
                  let imports = self_host_resolve_module_imports(context.frozen.interfaces.at(caller_owner).resolved_types, context.frozen.import_scopes.at(caller_owner))
                  search = Some({
                    lowering: Some(lowering)
                    collected: collected
                    resolved: module_.resolved_types
                    imports: imports
                    index: self_host_index_module_implementations_with_imports(collected, imports)
                    active: []
                    budget: {
                      steps: 0u32
                    }
                    associated_scopes: empty()
                    associated_only: false
                    include_test_impls: collected.declaration_is_test_only(body.declaration)
                  })
                }
                match search {
                  Some(evidence) => match self_host_resolve_guarded_call(lowering, module_, body, specialization, expression, source, callable, trait_, bindings, evidence) {
                    Ok(replacement) => {
                      module_.expressions[expression] = replacement
                    }
                    Err(message) => self_host_compile_time_diagnose(lowering, module_, body, specialization, expression, message)
                  }
                  None => unreachable()
                }
              }
              // Ordinary calls retain the target's precomputed demand. Being
              // generic alone does not require a private query instance.
              _ => {}
            }
            None => {}
          }
          None => {}
        }
        None => {}
      }
    }
  }
}

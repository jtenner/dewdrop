open dew.std.array
open dew.std.map
open dew.std.option
open dew.std.result

fn self_host_guard_call_expression(source: SelfHostPlannedExpression, kind: SelfHostPlannedExpressionKind, target: U64, arguments: SelfHostHirSpan) -> SelfHostPlannedExpression {
  SelfHostPlannedExpression::{
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    flow: source.flow
    kind: kind
    selection: source.selection
    reference: source.reference
    call_target: SelfHostBasicCallTarget::SelectedBasicCallTarget(target, arguments)
    call_type_arguments: arguments
    source_name: source.source_name
    member_base: source.member_base
    offset: source.offset
  }
}

fn self_host_guard_append_argument(module_: SelfHostPlannedModuleLowering, type_: SelfHostCompileTimeType) -> Unit {
  let id = self_host_query_append_resolved(module_, type_)
  module_.inferred.call_type_arguments.push(-self_host_body_u32_to_i32(id) - 2i32)
}

fn self_host_guard_witness_node(evidence: SelfHostBasicBodyEvidence, witness: SelfHostCompileTimeTraitWitness) -> SelfHostBasicTraitEvidence {
  let roots = self_host_empty_semantic_ids()
  for child in witness.prerequisites {
    let node = self_host_guard_witness_node(evidence, child)
    roots.push(evidence.evidence.length())
    evidence.evidence.push(node)
  }
  let start = evidence.prerequisite_indices.length()
  for root in roots {
    evidence.prerequisite_indices.push(root)
  }
  SelfHostBasicTraitEvidence::{
    implementation: witness.implementation.declaration
    prerequisites: SelfHostHirSpan::{
      start: start
      length: roots.length()
    }
  }
}

fn self_host_guard_store_evidence(lowering: SelfHostPlannedProgramLowering, specialization: U32, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, witnesses: Array<SelfHostCompileTimeTraitWitness>) -> Unit {
  match lowering.compile_time.instances.get(specialization) {
    Option::Some(instance) => instance.guarded_evidence.set(expression, witnesses)
    Option::None => {
      self_host_assert_compiler_invariant(false, "SPC-303 guarded proof has no selected instance")
      unreachable()
    }
  }
  if expression < body.expressions.start || expression - body.expressions.start >= body.expressions.length {
    // Lambda expression IDs belong to their own span, not the root body's
    // body-relative legacy evidence table. The selected instance owns the proof.
    for lambda in module_.lambdas {
      if lambda.root_body == body.body && expression >= lambda.expressions.start && expression - lambda.expressions.start < lambda.expressions.length {
        return
      }
    }
    self_host_assert_compiler_invariant(false, "ARN-102 guarded proof belongs to another body")
    unreachable()
  }
  match module_.evidence.evidence_body(body.declaration) {
    Option::Some(evidence) => {
      let roots = []
      for witness in witnesses {
        roots.push(self_host_guard_witness_node(evidence, witness))
      }
      let start = evidence.evidence.length()
      for root in roots {
        evidence.evidence.push(root)
      }
      self_host_assert_compiler_invariant(expression >= body.expressions.start && expression - body.expressions.start < evidence.expression_evidence.length(), "ARN-102 guarded evidence expression ownership")
      evidence.expression_evidence[expression - body.expressions.start] = SelfHostHirSpan::{
        start: start
        length: roots.length()
      }
    }
    Option::None => {
      let _ = self_host_assert_compiler_invariant(witnesses.length() == 0u32, "EVD-212 guarded call has no evidence body")
    }
  }
}

fn self_host_resolve_guarded_call(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32, source: SelfHostPlannedExpression, callable: SelfHostPlannedCallable, trait_: U64, bindings: Map<U64, SelfHostCompileTimeType>, search: SelfHostCompileTimeEvidenceSearch) -> Result<SelfHostPlannedExpression, String> {
  let receiver = match source.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, callee, _, _) => {
      if callee >= module_.expressions.length() {
        return Result::Err("CT-040 guarded trait call has no callee")
      }
      module_.expressions[callee].member_base
    }
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, _, receiver, _, _) => receiver
    _ => return Result::Err("CT-040 guarded call has no direct recipe")
  }
  if receiver >= module_.expressions.length() {
    return Result::Err("CT-040 guarded trait call has no receiver")
  }
  let target = match self_host_read_compile_time_type(module_, module_.expressions[receiver].type_, bindings, 0u32) {
    Result::Ok(value) => value
    Result::Err(error) => return Result::Err(error)
  }
  let arguments = match self_host_read_compile_time_arguments(module_, source.call_type_arguments, bindings) {
    Result::Ok(value) => value
    Result::Err(error) => return Result::Err(error)
  }
  let trait_count = callable.owner_generic_parameters.length
  if arguments.length() != trait_count + callable.generic_parameters.length {
    return Result::Err("CT-040 guarded trait argument count mismatch")
  }
  let trait_arguments = self_host_empty_compile_time_types()
  let _ = while 0u32 {
    index => if index < trait_count {
      trait_arguments.push(arguments[index])
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let trait_type = if trait_count == 0u32 {
    SelfHostCompileTimeType::TraitCompileTimeType(trait_)
  } else {
    SelfHostCompileTimeType::AppliedCompileTimeType(SelfHostCompileTimeType::TraitCompileTimeType(trait_), trait_arguments)
  }
  search.steps = 0u32
  let witness = match search.witness(target, trait_type) {
    Result::Ok(value) => match value {
      Option::Some(witness) => witness
      Option::None => return Result::Err("CT-040 selected branch has no trait implementation")
    }
    Result::Err(error) => return Result::Err(error)
  }
  let methods = witness.implementation.methods
  self_host_assert_compiler_invariant(self_host_array_span_is_valid(methods.start, methods.length, search.index.methods.length()), "ARN-101 guarded implementation methods")
  let mut method = 18446744073709551615u64
  let _ = while 0u32 {
    index => if index < methods.length {
      let candidate = search.index.methods[methods.start + index]
      match candidate.requirement {
        Option::Some(requirement) => if requirement == callable.declaration {
          if method != 18446744073709551615u64 {
            return Result::Err("CT-015 ambiguous guarded implementation method")
          }
          method = candidate.declaration
        }
        Option::None => {}
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  if method == 18446744073709551615u64 {
    return Result::Err("CT-040 trait implementation has no required method")
  }
  let owner = match lowering.index.declaration_owner(method) {
    Option::Some(value) => value
    Option::None => return Result::Err("CT-040 guarded method has no module")
  }
  let collected = lowering.collected.modules.at(owner)
  let generics = collected.generic_parameters_of(witness.implementation.declaration)
  // Bound calls inside this implementation need the same exact logical key.
  // Physical carrier equality cannot identify their prerequisite targets.
  if generics.length > 0u32 || callable.generic_parameters.length > 0u32 {
    lowering.compile_time.sensitive.set(method, true)
  }
  let start = module_.inferred.call_type_arguments.length()
  let _ = while 0u32 {
    index => if index < generics.length {
      let parameter = collected.generic_parameters[generics.start + index].id
      match witness.bindings.get(parameter) {
        Option::Some(type_) => self_host_guard_append_argument(module_, type_)
        Option::None => return Result::Err("CT-011 unresolved guarded implementation parameter")
      }
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = while trait_count {
    index => if index < arguments.length() {
      self_host_guard_append_argument(module_, arguments[index])
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let span = SelfHostHirSpan::{
    start: start
    length: module_.inferred.call_type_arguments.length() - start
  }
  // Self-host body evidence roots describe the selected implementation itself;
  // its bound proofs are children, not alternate call-target roots.
  self_host_guard_store_evidence(lowering, specialization, module_, body, expression, [witness])
  let kind = match source.kind {
    SelfHostPlannedExpressionKind::PlannedDirectCall(_, receiver, arguments, _) => SelfHostPlannedExpressionKind::PlannedDirectCall(method, receiver, arguments, span)
    SelfHostPlannedExpressionKind::PlannedOperatorCall(_, operator, left, right, _) => SelfHostPlannedExpressionKind::PlannedOperatorCall(method, operator, left, right, span)
    _ => {
      self_host_assert_compiler_invariant(false, "INV-001 guarded call changed during resolution")
      unreachable()
    }
  }
  Result::Ok(self_host_guard_call_expression(source, kind, method, span))
}

fn self_host_resolve_guarded_calls(lowering: SelfHostPlannedProgramLowering, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, bindings: Map<U64, SelfHostCompileTimeType>, owned: Array<U32>, live: Array<Bool>) -> Unit {
  let mut search = Option::None
  for expression in owned {
    if live[expression] {
      let source = module_.expressions[expression]
      let requirement = match source.call_target {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(target, _) => Option::Some(target)
        SelfHostBasicCallTarget::BoundTraitBasicCallTarget(target, _, _, _) => Option::Some(target)
        _ => Option::None
      }
      match requirement {
        Option::Some(requirement) => match lowering.index.declaration_owner(requirement) {
          Option::Some(owner) => match self_host_program_specialization_callable(lowering.modules[owner], requirement) {
            Option::Some(callable) => match callable.kind {
              SelfHostPlannedCallableKind::PlannedTraitMethodCallable(trait_) => {
                if search is Option::None {
                  let caller_owner = match lowering.index.declaration_owner(body.declaration) {
                    Option::Some(value) => value
                    Option::None => {
                      self_host_assert_compiler_invariant(false, "LNK-504 guarded caller has no module")
                      unreachable()
                    }
                  }
                  let collected = lowering.collected.modules.at(caller_owner)
                  let context = lowering.compile_time
                  let imports = self_host_resolve_module_imports(context.frozen.interfaces.at(caller_owner).resolved_types, context.frozen.import_scopes.at(caller_owner))
                  search = Option::Some(SelfHostCompileTimeEvidenceSearch::{
                    collected: collected
                    module_: module_
                    imports: imports
                    index: self_host_index_module_implementations_with_imports(collected, imports)
                    active: []
                    steps: 0u32
                    include_test_impls: collected.declaration_is_test_only(body.declaration)
                  })
                }
                match search {
                  Option::Some(evidence) => match self_host_resolve_guarded_call(lowering, module_, body, specialization, expression, source, callable, trait_, bindings, evidence) {
                    Result::Ok(replacement) => {
                      module_.expressions[expression] = replacement
                    }
                    Result::Err(message) => self_host_compile_time_diagnose(lowering, module_, body, specialization, expression, message)
                  }
                  Option::None => unreachable()
                }
              }
              _ => if callable.owner_generic_parameters.length > 0u32 || callable.generic_parameters.length > 0u32 {
                // A retained generic helper can contain bound calls even when
                // it has no query of its own. Keep the caller's logical types
                // through that edge so its selected body can resolve them.
                lowering.compile_time.sensitive.set(requirement, true)
              }
            }
            Option::None => {}
          }
          Option::None => {}
        }
        Option::None => {}
      }
    }
  }
}

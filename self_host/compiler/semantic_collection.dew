impl SelfHostCollectionBuilder {
  fn new(module_id: U64) -> SelfHostCollectionBuilder {
    SelfHostCollectionBuilder::{
      state: SelfHostCollectionBuilderState::{
        module_id: module_id
        current_file: self_host_make_file_id(module_id, 0u32)
        current_file_test_only: false
        current_lambda: 4294967295u32
        current_root_body: 0u64
        diagnostics: []
        name_lookup: self_host_empty_name_lookup()
        type_bindings: self_host_empty_id_lookup()
        trait_bindings: self_host_empty_id_lookup()
        value_bindings: []
        value_binding_candidates: []
        foreign_library_by_alias: self_host_empty_id_lookup()
        next_declaration_local: 0u32
        type_source_scratch: []
        type_state_scratch: []
        type_result_start_scratch: []
        type_result_scratch: []
        type_list_scratch: []
      }
      files: []
      file_paths: []
      file_sources: []
      test_files: []
      declaration_files: []
      body_files: []
      names: []
      declarations: []
      methods: []
      declaration_locations: []
      fields: []
      variants: []
      generic_parameters: []
      parameters: []
      generic_parameter_spans: []
      generic_bounds: []
      parameter_spans: []
      callables: []
      tests: []
      imports: []
      builtins: []
      lets: []
      aliases: []
      derives: []
      impls: []
      foreign_types: []
      foreign_libraries: []
      foreign_functions: []
      type_syntax: []
      type_syntax_files: []
      type_arguments: []
      lambda_parameters: []
      lambda_parameter_files: []
      lambdas: []
      pending_lambda_parameters: []
      pending_lambda_return_types: []
      pending_lambda_bodies: []
      pending_lambda_files: []
      pending_lambda_offsets: []
      pending_lambda_parents: []
      pending_lambda_root_bodies: []
      bodies: []
      body_by_declaration: []
      expressions: []
      expression_files: []
      expression_children: []
      explicit_call_type_argument_spans: []
      explicit_call_type_arguments: []
      blocks: []
      block_files: []
      block_items: []
      block_item_files: []
      object_fields: []
      object_field_files: []
      patterns: []
      pattern_files: []
      pattern_children: []
      pattern_fields: []
      pattern_field_files: []
      pattern_arms: []
      pattern_arm_files: []
      arm_children: []
    }
  }

  fn intern(self, name: String) -> U32 {
    // Name identity must use String content. The current Wasm Map runtime uses
    // reference identity for reference keys, so it cannot certify this table.
    let mut index = 0u32
    let found = while index {
      current => if current < self.names.length() {
        if self_host_semantic_string_equals(self.names[current], name) {
          break current
        }
        continue current + 1u32
      } else {
        break 4294967295u32
      }
    }
    if !self_host_u32_equal(found, 4294967295u32) {
      found
    } else {
      let id = self.names.length()
      if !self_host_u32_equal(id, self.state.value_bindings.length()) {
        // Every interned name must have one value-binding slot.
        self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::ValueBindingArenaMismatch(
            id,
            self.names.length(),
            self.state.value_bindings.length(),
          ),
        )
        return 4294967295u32
      }
      self.names.push(name)
      self.state.value_bindings.push(Option::None)
      self.state.name_lookup.set(name, id)
      id
    }
  }

  fn next_declaration_id(self) -> U64 {
    let id = self_host_make_semantic_id(
      self.state.module_id,
      self.state.next_declaration_local,
    )
    self.state.next_declaration_local = self.state.next_declaration_local + 1u32
    self.declaration_files.push(self.state.current_file)
    self.generic_parameter_spans.push(
      self_host_empty_hir_span(self.generic_parameters.length()),
    )
    self.parameter_spans.push(
      self_host_empty_hir_span(self.parameters.length()),
    )
    self.body_by_declaration.push(Option::None)
    id
  }

  fn collected_declaration_offset(self, declaration: U64) -> U32 {
    let location = self.declaration_locations[
      self_host_semantic_id_local(declaration)
    ]
    if location < 2147483648u32 {
      self.declarations[location].offset
    } else {
      self.methods[location & 2147483647u32].offset
    }
  }

  fn record_duplicate(
    self,
    space: SelfHostBindingSpace,
    name: U32,
    first: U64,
    first_file: U64,
    first_offset: U32,
    duplicate: U64,
    duplicate_offset: U32,
  ) -> Unit {
    self.state.diagnostics.push(
      SelfHostCollectionDiagnostic::DuplicateName(
        SelfHostDuplicateNameDiagnostic::{
          space: space
          name: name
          first: first
          duplicate: duplicate
          first_file: first_file
          duplicate_file: self.state.current_file
          first_offset: first_offset
          duplicate_offset: duplicate_offset
        },
      ),
    )
  }

  fn add_declaration(
    self,
    kind: SelfHostCollectedDeclKind,
    name: Option<String>,
    visibility: SelfHostSemanticVisibility,
    offset: U32,
  ) -> SelfHostCollectedDeclaration {
    let id = self.next_declaration_id()
    let name_id = match name {
      Option::Some(value) => self.intern(value)
      Option::None => 4294967295u32
    }
    let declaration = SelfHostCollectedDeclaration::{
      id: id
      kind: kind
      name: name_id
      visibility: visibility
      offset: offset
    }
    let location = self.declarations.length()
    self.declarations.push(declaration)
    self.declaration_locations.push(location)
    declaration
  }

  fn add_method(
    self,
    parent: U64,
    kind: SelfHostCollectedMethodKind,
    name: String,
    visibility: SelfHostSemanticVisibility,
    offset: U32,
  ) -> SelfHostCollectedMethod {
    let method = SelfHostCollectedMethod::{
      id: self.next_declaration_id()
      parent: parent
      kind: kind
      name: self.intern(name)
      visibility: visibility
      offset: offset
    }
    let location = self.methods.length()
    self.methods.push(method)
    self.declaration_locations.push(2147483648u32 | location)
    method
  }

  fn bind_unique_module_name(
    self,
    space: SelfHostBindingSpace,
    bindings: Map<U32, U64>,
    name: U32,
    declaration: U64,
    offset: U32,
  ) -> Unit {
    match bindings.get(name) {
      Option::Some(first) => self.record_duplicate(
        space,
        name,
        first,
        self.declaration_files[self_host_semantic_id_local(first)],
        self.collected_declaration_offset(first),
        declaration,
        offset,
      )
      Option::None => bindings.set(name, declaration)
    }
  }

  fn bind_value_name(
    self,
    kind: SelfHostCollectedDeclKind,
    name: U32,
    declaration: U64,
    offset: U32,
  ) -> Unit {
    if name >= self.state.value_bindings.length() {
      // A value binding must use an interned name slot.
      self.state.diagnostics.push(
        SelfHostCollectionDiagnostic::ValueBindingArenaMismatch(
          name,
          self.names.length(),
          self.state.value_bindings.length(),
        ),
      )
      return
    }
    match self.state.value_bindings[name] {
      Option::Some(binding) => {
        let binding = self_host_value_binding_identity(binding)
        if kind is SelfHostCollectedDeclKind::BuiltinDecl &&
          binding.kind is SelfHostCollectedDeclKind::BuiltinDecl {
          let candidate = self.state.value_binding_candidates.length()
          self.state.value_binding_candidates[binding.tail].next = Option::Some(candidate)
          self.state.value_binding_candidates.push(
            SelfHostValueBindingCandidate::{
              declaration: declaration
              next: Option::None
            },
          )
          binding.tail = candidate
        } else {
          let first = self.state.value_binding_candidates[binding.head].declaration
          self.record_duplicate(
            SelfHostBindingSpace::ModuleValue,
            name,
            first,
            self.declaration_files[self_host_semantic_id_local(first)],
            binding.offset,
            declaration,
            offset,
          )
        }
      }
      Option::None => {
        let candidate = self.state.value_binding_candidates.length()
        self.state.value_binding_candidates.push(
          SelfHostValueBindingCandidate::{
            declaration: declaration
            next: Option::None
          },
        )
        self.state.value_bindings[name] = Option::Some(
          SelfHostValueBinding::{
            head: candidate
            tail: candidate
            kind: kind
            offset: offset
          },
        )
      }
    }
  }

  fn lower_type(self, root: SelfHostTypeExpr) -> U32 {
    let sources = self.state.type_source_scratch
    let states = self.state.type_state_scratch
    let starts = self.state.type_result_start_scratch
    let results = self.state.type_result_scratch
    sources.clear()
    states.clear()
    starts.clear()
    results.clear()
    sources.push(root)
    states.push(0u32)
    starts.push(0u32)
    let _ = while 0u32 {
      _ => if sources.length() > 0u32 {
        if states.length() == 0u32 || starts.length() == 0u32 {
          return 0u32
        }
        let source_index = sources.length() - 1u32
        let source = self_host_collection_type_expr_at(
          sources,
          source_index,
        )
        sources.truncate(source_index)
        let state_index = states.length() - 1u32
        let state = array_get_unchecked(states, state_index)
        states.truncate(state_index)
        let start_index = starts.length() - 1u32
        let result_start = array_get_unchecked(starts, start_index)
        starts.truncate(start_index)
        if state == 0u32 {
          match source {
            SelfHostTypeExpr::NamedType(name, offset) => {
              let id = self.type_syntax.length()
              self.type_syntax.push(
                SelfHostHirTypeSyntax::NamedTypeSyntax(
                  self.intern(name),
                  offset,
                ),
              )
              self.type_syntax_files.push(self.state.current_file)
              results.push(id)
            }
            SelfHostTypeExpr::QualifiedType(alias, name, offset, name_offset) => {
              let id = self.type_syntax.length()
              self.type_syntax.push(
                SelfHostHirTypeSyntax::QualifiedTypeSyntax(
                  self.intern(alias),
                  self.intern(name),
                  offset,
                  name_offset,
                ),
              )
              self.type_syntax_files.push(self.state.current_file)
              results.push(id)
            }
            SelfHostTypeExpr::ProductType(fields, _) => {
              sources.push(source)
              states.push(1u32)
              starts.push(results.length())
              let _ = while fields.length() {
                0u32 => break self_host_semantic_unit()
                index => {
                  sources.push(fields[index - 1u32])
                  states.push(0u32)
                  starts.push(0u32)
                  continue index - 1u32
                }
              }
            }
            SelfHostTypeExpr::AppliedType(base, arguments, _) => {
              sources.push(source)
              states.push(1u32)
              starts.push(results.length())
              let _ = while arguments.length() {
                0u32 => break self_host_semantic_unit()
                index => {
                  sources.push(arguments[index - 1u32])
                  states.push(0u32)
                  starts.push(0u32)
                  continue index - 1u32
                }
              }
              sources.push(base)
              states.push(0u32)
              starts.push(0u32)
            }
            SelfHostTypeExpr::FunctionType(parameters, result, _) => {
              sources.push(source)
              states.push(1u32)
              starts.push(results.length())
              sources.push(result)
              states.push(0u32)
              starts.push(0u32)
              let _ = while parameters.length() {
                0u32 => break self_host_semantic_unit()
                index => {
                  sources.push(parameters[index - 1u32])
                  states.push(0u32)
                  starts.push(0u32)
                  continue index - 1u32
                }
              }
            }
          }
        } else {
          match source {
            SelfHostTypeExpr::ProductType(fields, offset) => {
              let argument_start = self.type_arguments.length()
              let _ = while 0u32 {
                index => if index < fields.length() {
                  self.type_arguments.push(results[result_start + index])
                  continue index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let id = self.type_syntax.length()
              self.type_syntax.push(
                SelfHostHirTypeSyntax::ProductTypeSyntax(
                  SelfHostHirSpan::{
                    start: argument_start
                    length: fields.length()
                  },
                  offset,
                ),
              )
              self.type_syntax_files.push(self.state.current_file)
              results.truncate(result_start)
              results.push(id)
            }
            SelfHostTypeExpr::AppliedType(_, arguments, offset) => {
              let base = results[result_start]
              let argument_start = self.type_arguments.length()
              let _ = while 0u32 {
                index => if index < arguments.length() {
                  self.type_arguments.push(results[result_start + index + 1u32])
                  continue index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let id = self.type_syntax.length()
              self.type_syntax.push(
                SelfHostHirTypeSyntax::AppliedTypeSyntax(
                  base,
                  SelfHostHirSpan::{
                    start: argument_start
                    length: arguments.length()
                  },
                  offset,
                ),
              )
              self.type_syntax_files.push(self.state.current_file)
              results.truncate(result_start)
              results.push(id)
            }
            SelfHostTypeExpr::FunctionType(parameters, _, offset) => {
              let parameter_start = self.type_arguments.length()
              let _ = while 0u32 {
                index => if index < parameters.length() {
                  self.type_arguments.push(results[result_start + index])
                  continue index + 1u32
                } else {
                  break self_host_semantic_unit()
                }
              }
              let result = results[result_start + parameters.length()]
              let id = self.type_syntax.length()
              self.type_syntax.push(
                SelfHostHirTypeSyntax::FunctionTypeSyntax(
                  SelfHostHirSpan::{
                    start: parameter_start
                    length: parameters.length()
                  },
                  result,
                  offset,
                ),
              )
              self.type_syntax_files.push(self.state.current_file)
              results.truncate(result_start)
              results.push(id)
            }
            _ => {}
          }
        }
        continue 0u32
      } else {
        break self_host_semantic_unit()
      }
    }
    results[0u32]
  }

  fn lower_type_list(self, source: Array<SelfHostTypeExpr>) -> SelfHostHirSpan {
    let lowered = self.state.type_list_scratch
    lowered.clear()
    let mut source_index = 0u32
    let _ = while source_index {
      current => if current < source.length() {
        lowered.push(
          self.lower_type(self_host_collection_type_expr_at(source, current)),
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let start = self.type_arguments.length()
    let mut lowered_index = 0u32
    let _ = while lowered_index {
      current => if current < lowered.length() {
        self.type_arguments.push(self_host_collection_u32_at(lowered, current))
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    SelfHostHirSpan::{
      start: start
      length: lowered.length()
    }
  }

  fn collect_generic_parameters(
    self,
    declaration: U64,
    parameters: Array<SelfHostTypeParameter>,
  ) -> Unit {
    let start = self.generic_parameters.length()
    let mut index = 0u32
    let _ = while index {
      current => if current < parameters.length() {
        let parameter = self_host_collection_type_parameter_at(
          parameters,
          current,
        )
        let name = self.intern(
        self_host_collection_type_parameter_name(parameter),
      )
      let id = self_host_make_semantic_id(
        self.state.module_id,
        self.generic_parameters.length(),
      )
      match self.first_generic_parameter_index(declaration, name) {
        Option::Some(previous) => {
          let candidate = self.generic_parameters[previous]
          self.record_duplicate(
            SelfHostBindingSpace::GenericParameter,
            name,
            candidate.id,
            self.state.current_file,
            candidate.offset,
            id,
            self_host_collection_type_parameter_offset(parameter),
          )
        }
        Option::None => {}
      }
      let bound_start = self.generic_bounds.length()
      let _ = while 0u32 {
        bound_index => if bound_index < self_host_collection_type_parameter_bound_count(
          parameter,
        ) {
          self.generic_bounds.push(
            self.lower_type(
              self_host_collection_type_parameter_bound_at(
                parameter,
                bound_index,
              ),
            ),
          )
          continue bound_index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let collected_parameter = SelfHostCollectedGenericParameter::{
        id: id
        declaration: declaration
        index: current
        name: name
        bounds: SelfHostHirSpan::{
          start: bound_start
          length: self.generic_bounds.length() - bound_start
        }
        offset: self_host_collection_type_parameter_offset(parameter)
      }
        self.generic_parameters.push(collected_parameter)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.generic_parameter_spans[
      self_host_semantic_id_local(declaration)
    ] = SelfHostHirSpan::{
      start: start
      length: self.generic_parameters.length() - start
    }
  }

  fn collect_parameters(
    self,
    declaration: U64,
    receiver: Option<SelfHostReceiverParameter>,
    parameters: Array<SelfHostFnParameter>,
  ) -> Unit {
    let start = self.parameters.length()
    let mut parameter_index = 0u32
    match receiver {
      Option::Some(value) => {
        let collected_receiver = SelfHostCollectedParameter::{
          id: self_host_make_semantic_id(
            self.state.module_id,
            self.parameters.length(),
          )
          declaration: declaration
          index: parameter_index
          kind: SelfHostCollectedParameterKind::ReceiverParameterDecl
          name: self.intern("self")
          type_: match value.explicit_type {
            Option::Some(type_) => self.lower_type(type_)
            Option::None => 4294967295u32
          }
          offset: value.offset
        }
        self.parameters.push(collected_receiver)
        parameter_index = parameter_index + 1u32
      }
      Option::None => {}
    }
    let mut source_parameter_index = 0u32
    let _ = while source_parameter_index {
      current => if current < parameters.length() {
        let parameter = self_host_collection_parameter_at(parameters, current)
        let name = self.intern(
          self_host_collection_parameter_name(parameter),
        )
      let id = self_host_make_semantic_id(
        self.state.module_id,
        self.parameters.length(),
      )
      match self.first_parameter_index(declaration, name) {
        Option::Some(previous) => {
          let candidate = self.parameters[previous]
          self.record_duplicate(
            SelfHostBindingSpace::Parameter,
            name,
            candidate.id,
            self.state.current_file,
            candidate.offset,
            id,
            self_host_collection_parameter_offset(parameter),
          )
        }
        Option::None => {}
      }
      let collected_parameter = SelfHostCollectedParameter::{
        id: id
        declaration: declaration
        index: parameter_index
        kind: SelfHostCollectedParameterKind::ValueParameterDecl
        name: name
        type_: self.lower_type(
          self_host_collection_parameter_type(parameter),
        )
        offset: self_host_collection_parameter_offset(parameter)
      }
        self.parameters.push(collected_parameter)
        parameter_index = parameter_index + 1u32
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.parameter_spans[
      self_host_semantic_id_local(declaration)
    ] = SelfHostHirSpan::{
      start: start
      length: self.parameters.length() - start
    }
  }

  fn collect_named_fields(
    self,
    declaration: U64,
    variant: Option<U64>,
    fields: Array<SelfHostStructField>,
    space: SelfHostBindingSpace,
  ) -> Unit {
    let start = self.fields.length()
    let mut field_index = 0u32
    let _ = while field_index {
      current => if current < fields.length() {
        let field = self_host_derived_struct_field_at(fields, current)
        let name = self.intern(
          self_host_collection_struct_field_name(field),
        )
      let id = self_host_make_semantic_id(self.state.module_id, self.fields.length())
      match self.first_field_index(start, name) {
        Option::Some(previous) => {
          let candidate = self.fields[previous]
          self.record_duplicate(
            space,
            name,
            candidate.id,
            self.state.current_file,
            candidate.offset,
            id,
            self_host_collection_struct_field_offset(field),
          )
        }
        Option::None => {}
      }
        self.fields.push(
          SelfHostCollectedField::{
            id: id
            declaration: declaration
            variant: variant
            mutable_: self_host_collection_struct_field_mutable(field)
            name: name
            type_: self.lower_type(
              self_host_collection_struct_field_type(field),
            )
            offset: self_host_collection_struct_field_offset(field)
          },
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn first_generic_parameter_index(
    self,
    declaration: U64,
    name: U32,
  ) -> Option<U32> {
    let mut index = 0u32
    let _ = while index {
      current => if current < self.generic_parameters.length() {
        let candidate = self_host_collected_generic_parameter_identity(
          self.generic_parameters[current],
        )
        if self_host_u64_equal(candidate.declaration, declaration) {
          if self_host_u32_equal(candidate.name, name) {
            return Option::Some(current)
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Option::None
  }

  fn first_parameter_index(
    self,
    declaration: U64,
    name: U32,
  ) -> Option<U32> {
    let mut index = 0u32
    let _ = while index {
      current => if current < self.parameters.length() {
        let candidate = self_host_collected_parameter_identity(
          self.parameters[current],
        )
        if self_host_u64_equal(candidate.declaration, declaration) {
          if self_host_u32_equal(candidate.name, name) {
            return Option::Some(current)
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Option::None
  }

  fn first_field_index(self, start: U32, name: U32) -> Option<U32> {
    let mut index = start
    let _ = while index {
      current => if current < self.fields.length() {
        let candidate = self_host_collected_field_identity(self.fields[current])
        if self_host_u32_equal(candidate.name, name) {
          return Option::Some(current)
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Option::None
  }

  fn first_variant_index(
    self,
    declaration: U64,
    name: U32,
  ) -> Option<U32> {
    let mut index = 0u32
    let _ = while index {
      current => if current < self.variants.length() {
        let candidate = self_host_collected_variant_identity(self.variants[current])
        if self_host_u64_equal(candidate.declaration, declaration) {
          if self_host_u32_equal(candidate.name, name) {
            return Option::Some(current)
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Option::None
  }

  fn first_method_name(
    self,
    parent: U64,
    name: U32,
    exclude: U64,
  ) -> Option<U32> {
    let mut index = 0u32
    let _ = while index {
      current => if current < self.methods.length() {
        let candidate = self_host_collected_method_identity(self.methods[current])
        if self_host_u64_equal(candidate.parent, parent) {
          if self_host_u32_equal(candidate.name, name) {
            if self_host_u64_not_equal(candidate.id, exclude) {
              return Option::Some(current)
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    Option::None
  }

  fn collect_builtin(self, value: SelfHostBuiltinDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::BuiltinDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_value_name(
      SelfHostCollectedDeclKind::BuiltinDecl,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    self.collect_parameters(declaration.id, Option::None, value.parameters)
    self.callables.push(
      SelfHostCollectedCallable::{
        declaration: declaration.id
        return_type: self.lower_type(value.return_type)
        is_main: false
      },
    )
    self.builtins.push(
      SelfHostCollectedBuiltin::{
        declaration: declaration.id
        builtin_name: value.builtin_name
      },
    )
  }

  fn collect_let(self, value: SelfHostLetDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::LetDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_value_name(
      SelfHostCollectedDeclKind::LetDecl,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.lets.push(
      SelfHostCollectedLet::{
        declaration: declaration.id
        mutable_: value.mutable_
      },
    )
    self.lower_expression_body(
      declaration.id,
      SelfHostHirBodyKind::ModuleLetBody,
      value.value,
      value.offset,
    )
  }

  fn collect_trait(self, value: SelfHostTraitDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::TraitDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_unique_module_name(
      SelfHostBindingSpace::ModuleTrait,
      self.state.trait_bindings,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    let mut trait_method_index = 0u32
    let _ = while trait_method_index {
      current => if current < value.methods.length() {
        let source_method = value.methods[current]
      let method = self.add_method(
        declaration.id,
        SelfHostCollectedMethodKind::TraitMethodDecl,
        source_method.name,
        SelfHostSemanticVisibility::ModuleVisible,
        source_method.offset,
      )
      match self.first_method_name(
        declaration.id,
        method.name,
        method.id,
      ) {
        Option::Some(first_index) => {
          let first = self.methods[first_index]
          self.record_duplicate(
            SelfHostBindingSpace::TraitMethod,
            method.name,
            first.id,
            self.state.current_file,
            first.offset,
            method.id,
            source_method.name_offset,
          )
        }
        Option::None => {}
      }
      self.collect_generic_parameters(method.id, source_method.type_parameters)
      self.collect_parameters(
        method.id,
        source_method.receiver,
        source_method.parameters,
      )
      self.callables.push(
        SelfHostCollectedCallable::{
          declaration: method.id
          return_type: self.lower_type(source_method.return_type)
          is_main: false
        },
      )
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn collect_function(
    self,
    value: SelfHostFunctionDeclaration,
    source: Bytes,
  ) -> Unit {
    let exact_value = self_host_function_declaration_identity(value)
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::FunctionDecl,
      Option::Some(exact_value.name),
      self_host_semantic_visibility(exact_value.visibility),
      exact_value.offset,
    )
    self.bind_value_name(
      SelfHostCollectedDeclKind::FunctionDecl,
      declaration.name,
      declaration.id,
      exact_value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, exact_value.type_parameters)
    self.collect_parameters(
      declaration.id,
      exact_value.receiver,
      exact_value.parameters,
    )
    self.callables.push(
      SelfHostCollectedCallable::{
        declaration: declaration.id
        return_type: self.lower_type(exact_value.return_type)
        is_main: exact_value.is_main
      },
    )
    self.lower_block_body(
      declaration.id,
      SelfHostHirBodyKind::FunctionBody,
      exact_value.body,
      exact_value.offset,
    )
  }

  fn collect_test(self, value: SelfHostTestDeclaration) -> Unit {
    if !self.state.current_file_test_only {
      self.state.diagnostics.push(
        SelfHostCollectionDiagnostic::TestDeclarationOutsideTestFile(
          self.state.current_file,
          value.offset,
        ),
      )
    }
    match value.expected_trap {
      Option::Some(expected) => if self_host_bytes_not_equal(expected, b"unreachable") &&
        self_host_bytes_not_equal(expected, b"memory-out-of-bounds") &&
        self_host_bytes_not_equal(expected, b"array-out-of-bounds") &&
        self_host_bytes_not_equal(expected, b"integer-divide-by-zero") &&
        self_host_bytes_not_equal(expected, b"integer-overflow") &&
        self_host_bytes_not_equal(expected, b"invalid-conversion-to-integer") {
        self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::InvalidExpectedTestTrap(
            self.state.current_file,
            expected,
            value.offset,
          ),
        )
      }
      Option::None => {}
    }
    let mut test_index = 0u32
    let _ = while test_index {
      current => if current < self.tests.length() {
        let test_ = self.tests[current]
      if self_host_u64_equal(test_.file, self.state.current_file) &&
        self_host_bytes_equal(test_.display_name, value.name) {
        self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::DuplicateTestIdentity(
            SelfHostDuplicateTestIdentityDiagnostic::{
              file: self.state.current_file
              display_name: value.name
              first_offset: test_.offset
              duplicate_offset: value.offset
            },
          ),
        )
      }
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::TestDecl,
      Option::Some(self_host_test_declaration_name(self.tests.length())),
      SelfHostSemanticVisibility::ModuleVisible,
      value.offset,
    )
    self.callables.push(
      SelfHostCollectedCallable::{
        declaration: declaration.id
        return_type: self.lower_type(value.return_type)
        is_main: false
      },
    )
    self.tests.push(
      SelfHostCollectedTest::{
        declaration: declaration.id
        display_name: value.name
        expected_trap: value.expected_trap
        file: self.state.current_file
        offset: value.offset
      },
    )
    self.lower_block_body(
      declaration.id,
      SelfHostHirBodyKind::FunctionBody,
      value.body,
      value.offset,
    )
  }

  fn collect_foreign_type(self, value: SelfHostForeignTypeDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::ForeignTypeDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_unique_module_name(
      SelfHostBindingSpace::ModuleType,
      self.state.type_bindings,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.foreign_types.push(
      SelfHostCollectedForeignType::{
        declaration: declaration.id
      },
    )
  }

  fn collect_foreign_library(
    self,
    value: SelfHostForeignLibraryDeclaration,
  ) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::ForeignLibraryDecl,
      Option::Some(value.namespace_alias),
      SelfHostSemanticVisibility::ModuleVisible,
      value.offset,
    )
    self.bind_value_name(
      SelfHostCollectedDeclKind::ForeignLibraryDecl,
      declaration.name,
      declaration.id,
      value.alias_offset,
    )
    match self.state.foreign_library_by_alias.get(declaration.name) {
      Option::Some(first) => self.record_duplicate(
        SelfHostBindingSpace::ModuleValue,
        declaration.name,
        first,
        self.declaration_files[self_host_semantic_id_local(first)],
        self.collected_declaration_offset(first),
        declaration.id,
        value.alias_offset,
      )
      Option::None => self.state.foreign_library_by_alias.set(
        declaration.name,
        declaration.id,
      )
    }
    if self_host_bytes_empty(value.logical_name) {
      self.state.diagnostics.push(
        SelfHostCollectionDiagnostic::EmptyForeignLogicalName(
          self.state.current_file,
          value.logical_name_offset,
        ),
      )
    }
    let member_start = self.foreign_functions.length()
    let mut member_index = 0u32
    let _ = while member_index {
      current => if current < value.members.length() {
        let source_member = value.members[current]
      let method = self.add_method(
        declaration.id,
        SelfHostCollectedMethodKind::ForeignLibraryMemberDecl,
        source_member.name,
        self_host_semantic_visibility(source_member.visibility),
        source_member.offset,
      )
      match self.first_method_name(
        declaration.id,
        method.name,
        method.id,
      ) {
        Option::Some(first_index) => {
          let first = self.methods[first_index]
          self.record_duplicate(
            SelfHostBindingSpace::ForeignLibraryMember,
            method.name,
            first.id,
            self.state.current_file,
            first.offset,
            method.id,
            source_member.name_offset,
          )
        }
        Option::None => {}
      }
      self.collect_parameters(method.id, Option::None, source_member.parameters)
      self.callables.push(
        SelfHostCollectedCallable::{
          declaration: method.id
          return_type: self.lower_type(source_member.return_type)
          is_main: false
        },
      )
      if self_host_bytes_empty(source_member.export_name) {
        self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::EmptyForeignExportName(
            self.state.current_file,
            source_member.export_name_offset,
          ),
        )
      }
      self.foreign_functions.push(
        SelfHostCollectedForeignFunction::{
          declaration: method.id
          library: declaration.id
          export_name: source_member.export_name
          export_name_offset: source_member.export_name_offset
        },
      )
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.foreign_libraries.push(
      SelfHostCollectedForeignLibrary::{
        declaration: declaration.id
        logical_name: value.logical_name
        logical_name_offset: value.logical_name_offset
        members: SelfHostHirSpan::{
          start: member_start
          length: self.foreign_functions.length() - member_start
        }
      },
    )
  }

  fn collect_impl(self, value: SelfHostImplDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::ImplDecl,
      Option::None,
      SelfHostSemanticVisibility::ModuleVisible,
      value.offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    let trait_type = match value.trait_type {
      Option::Some(type_) => Option::Some(self.lower_type(type_))
      Option::None => Option::None
    }
    let target_type = self.lower_type(value.target_type)
    let collected_impl = SelfHostCollectedImpl::{
      declaration: declaration.id
      foreign_: value.foreign_
      trait_type: trait_type
      target_type: target_type
    }
    self.impls.push(collected_impl)
    let mut impl_method_index = 0u32
    let _ = while impl_method_index {
      current => if current < value.methods.length() {
        let source_method = value.methods[current]
      let method = self.add_method(
        declaration.id,
        SelfHostCollectedMethodKind::ImplMethodDecl,
        source_method.name,
        SelfHostSemanticVisibility::ModuleVisible,
        source_method.offset,
      )
      match self.first_method_name(
        declaration.id,
        method.name,
        method.id,
      ) {
        Option::Some(first_index) => {
          let first = self.methods[first_index]
          self.record_duplicate(
            SelfHostBindingSpace::ImplMethod,
            method.name,
            first.id,
            self.state.current_file,
            first.offset,
            method.id,
            source_method.name_offset,
          )
        }
        Option::None => {}
      }
      self.collect_generic_parameters(method.id, source_method.type_parameters)
      self.collect_parameters(
        method.id,
        source_method.receiver,
        source_method.parameters,
      )
      let return_type = self.lower_type(source_method.return_type)
      let callable = SelfHostCollectedCallable::{
        declaration: method.id
        return_type: return_type
        is_main: false
      }
      self.callables.push(callable)
      self.lower_block_body(
        method.id,
        SelfHostHirBodyKind::ImplMethodBody,
        source_method.body,
        source_method.offset,
      )
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn collect_derives(
    self,
    declaration: U64,
    derives: Array<SelfHostDeriveRequest>,
  ) -> SelfHostCollectedDeriveOffsets {
    let seen = self_host_empty_derive_seen()
    let mut eq = Option::None
    let mut debug = Option::None
    let mut hash = Option::None
    let mut show = Option::None
    let mut derive_index = 0u32
    let _ = while derive_index {
      current => if current < derives.length() {
      let derive_offset = self_host_derive_request_offset_at(derives, current)
      let derive_name = self_host_derive_request_name_at(derives, current)
      match seen.get(derive_name) {
        Option::Some(first) => self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::DuplicateDerivedTrait(
            derive_name,
            self.state.current_file,
            first,
            derive_offset,
          ),
        )
        Option::None => {
          seen.set(derive_name, derive_offset)
          if self_host_string_not_equal(derive_name, "Eq") &&
            self_host_string_not_equal(derive_name, "Debug") &&
            self_host_string_not_equal(derive_name, "Hash") &&
            self_host_string_not_equal(derive_name, "Show") {
            self.state.diagnostics.push(
              SelfHostCollectionDiagnostic::UnknownDerivedTrait(
                derive_name,
                self.state.current_file,
                derive_offset,
              ),
            )
          } else {
            self.derives.push(
              SelfHostCollectedDeriveRequest::{
                declaration: declaration
                trait_name: derive_name
                offset: derive_offset
              },
            )
            if !self_host_string_not_equal(derive_name, "Eq") {
              eq = Option::Some(derive_offset)
            } else if !self_host_string_not_equal(derive_name, "Debug") {
              debug = Option::Some(derive_offset)
            } else if !self_host_string_not_equal(derive_name, "Hash") {
              hash = Option::Some(derive_offset)
            } else {
              show = Option::Some(derive_offset)
            }
          }
        }
      }
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    SelfHostCollectedDeriveOffsets::{
      eq: eq
      debug: debug
      hash: hash
      show: show
    }
  }

  fn collect_struct(self, value: SelfHostStructDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::StructDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_unique_module_name(
      SelfHostBindingSpace::ModuleType,
      self.state.type_bindings,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    self.collect_named_fields(
      declaration.id,
      Option::None,
      value.fields,
      SelfHostBindingSpace::StructField,
    )
    let derives = self.collect_derives(declaration.id, value.derives)
    match derives.eq {
      Option::Some(offset) => {
        let implementations = self_host_derived_struct_eq_impls(value, offset)
        let mut implementation_index = 0u32
        let _ = while implementation_index {
          current => if current < implementations.length() {
            self.collect_impl(implementations[current])
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
    match derives.debug {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_struct_debug_impl(value, offset),
      )
      Option::None => {}
    }
    match derives.hash {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_struct_hash_impl(value, offset),
      )
      Option::None => {}
    }
    match derives.show {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_struct_show_impl(value, offset),
      )
      Option::None => {}
    }
  }

  fn collect_enum(self, value: SelfHostEnumDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::EnumDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_unique_module_name(
      SelfHostBindingSpace::ModuleType,
      self.state.type_bindings,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    let variant_start = self.variants.length()
    let mut source_variant_index = 0u32
    let _ = while source_variant_index {
      current => if current < value.variants.length() {
        let source_variant = value.variants[current]
      let name = match source_variant {
        SelfHostEnumVariant::UnitVariant(name, _, _) => name
        SelfHostEnumVariant::TupleVariant(name, _, _, _) => name
        SelfHostEnumVariant::StructVariant(name, _, _, _) => name
      }
      let offset = match source_variant {
        SelfHostEnumVariant::UnitVariant(_, offset, _) => offset
        SelfHostEnumVariant::TupleVariant(_, _, offset, _) => offset
        SelfHostEnumVariant::StructVariant(_, _, offset, _) => offset
      }
      let variant_kind = match source_variant {
        SelfHostEnumVariant::UnitVariant(_, _, kind) => kind
        SelfHostEnumVariant::TupleVariant(_, _, _, kind) => kind
        SelfHostEnumVariant::StructVariant(_, _, _, kind) => kind
      }
      let kind = if variant_kind == 0u32 {
        SelfHostCollectedVariantKind::UnitVariantDecl
      } else if variant_kind == 1u32 {
        SelfHostCollectedVariantKind::TupleVariantDecl
      } else {
        SelfHostCollectedVariantKind::StructVariantDecl
      }
      let name_id = self.intern(name)
      let id = self_host_make_semantic_id(self.state.module_id, self.variants.length())
      match self.first_variant_index(declaration.id, name_id) {
        Option::Some(previous) => {
          let candidate = self.variants[previous]
          self.record_duplicate(
            SelfHostBindingSpace::EnumVariant,
            name_id,
            candidate.id,
            self.state.current_file,
            candidate.offset,
            id,
            offset,
          )
        }
        Option::None => {}
      }
      let mut payload = self_host_empty_hir_span(
        self.type_arguments.length(),
      )
      if variant_kind == 1u32 {
        match source_variant {
          SelfHostEnumVariant::TupleVariant(_, types, _, _) => {
            payload = self.lower_type_list(types)
          }
          _ => {}
        }
      }
      self.variants.push(
        SelfHostCollectedVariant::{
          id: id
          declaration: declaration.id
          kind: kind
          name: name_id
          payload_types: payload
          offset: offset
        },
      )
      if variant_kind == 2u32 {
        match source_variant {
          SelfHostEnumVariant::StructVariant(_, fields, _, _) => self.collect_named_fields(
            declaration.id,
            Option::Some(id),
            fields,
            SelfHostBindingSpace::VariantField,
          )
          _ => {}
        }
      }
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let derives = self.collect_derives(declaration.id, value.derives)
    match derives.eq {
      Option::Some(offset) => {
        let implementations = self_host_derived_enum_eq_impls(value, offset)
        let mut implementation_index = 0u32
        let _ = while implementation_index {
          current => if current < implementations.length() {
            self.collect_impl(implementations[current])
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
    match derives.debug {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_enum_debug_impl(value, offset),
      )
      Option::None => {}
    }
    match derives.hash {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_enum_hash_impl(value, offset),
      )
      Option::None => {}
    }
    match derives.show {
      Option::Some(offset) => self.collect_impl(
        self_host_derived_enum_show_impl(value, offset),
      )
      Option::None => {}
    }
  }

  fn collect_type_alias(self, value: SelfHostTypeAliasDeclaration) -> Unit {
    let declaration = self.add_declaration(
      SelfHostCollectedDeclKind::TypeAliasDecl,
      Option::Some(value.name),
      self_host_semantic_visibility(value.visibility),
      value.offset,
    )
    self.bind_unique_module_name(
      SelfHostBindingSpace::ModuleType,
      self.state.type_bindings,
      declaration.name,
      declaration.id,
      value.name_offset,
    )
    self.collect_generic_parameters(declaration.id, value.type_parameters)
    self.aliases.push(
      SelfHostCollectedAlias::{
        declaration: declaration.id
        target: self.lower_type(value.target)
      },
    )
  }

  fn collect_import(self, value: SelfHostImportDeclaration) -> Unit {
    let alias = if value.wildcard || value.open_ {
      Option::None
    } else {
      match value.import_alias {
        Option::Some(name) => Option::Some(name)
        Option::None => Option::Some(value.default_alias)
      }
    }
    self.imports.push(
      SelfHostCollectedImport::{
        path: value.joined_path
        path_segments: value.path
        open_: value.open_
        wildcard: value.wildcard
        import_alias: alias
        import_alias_offset: value.import_alias_offset
        file: self.state.current_file
        offset: value.offset
      },
    )
  }

  fn collect_declaration(
    self,
    declaration: SelfHostDeclaration,
    kind: U32,
    source: Bytes,
  ) -> Unit {
    if kind == 0u32 {
      match declaration {
        SelfHostDeclaration::Import(value) => self.collect_import(value)
        _ => {}
      }
    } else if kind == 1u32 {
      match declaration {
        SelfHostDeclaration::Builtin(value) => self.collect_builtin(value)
        _ => {}
      }
    } else if kind == 2u32 {
      match declaration {
        SelfHostDeclaration::Let(value) => self.collect_let(value)
        _ => {}
      }
    } else if kind == 3u32 {
      match declaration {
        SelfHostDeclaration::Trait(value) => self.collect_trait(value)
        _ => {}
      }
    } else if kind == 4u32 {
      match declaration {
        SelfHostDeclaration::Function(value) => self.collect_function(value, source)
        _ => {}
      }
    } else if kind == 5u32 {
      match declaration {
        SelfHostDeclaration::Test(value) => self.collect_test(value)
        _ => {}
      }
    } else if kind == 6u32 {
      match declaration {
        SelfHostDeclaration::Impl(value) => self.collect_impl(value)
        _ => {}
      }
    } else if kind == 7u32 {
      match declaration {
        SelfHostDeclaration::ForeignType(value) => self.collect_foreign_type(value)
        _ => {}
      }
    } else if kind == 8u32 {
      match declaration {
        SelfHostDeclaration::ForeignLibrary(value) => self.collect_foreign_library(value)
        _ => {}
      }
    } else if kind == 9u32 {
      match declaration {
        SelfHostDeclaration::Struct(value) => self.collect_struct(value)
        _ => {}
      }
    } else if kind == 10u32 {
      match declaration {
        SelfHostDeclaration::Enum(value) => self.collect_enum(value)
        _ => {}
      }
    } else if kind == 11u32 {
      match declaration {
        SelfHostDeclaration::TypeAlias(value) => self.collect_type_alias(value)
        _ => {}
      }
    }
  }

  fn collect_file(self, file: SelfHostProgramFile) -> Unit {
    if self_host_u64_not_equal(self_host_file_id_module(file.id), self.state.module_id) {
      return
    }
    self.state.current_file = file.id
    self.state.current_file_test_only = file.test_only
    self.files.push(file.id)
    self.file_paths.push(file.path)
    self.file_sources.push(file.source)
    if file.test_only {
      self.test_files.push(file.id)
    }
    let parsed = self_host_parse_module(file.source)
    let mut event_index = 0u32
    let _ = while event_index {
      current => if current < parsed.events.length() {
        let event = parsed.events[current]
      match event {
        SelfHostParseEvent::Declaration(declaration, kind) => self.collect_declaration(
          declaration,
          kind,
          file.source,
        )
        SelfHostParseEvent::Diagnostic(severity, error, kind, offset, token_code, token_text) => self.state.diagnostics.push(
          SelfHostCollectionDiagnostic::ParseDiagnostic(
            self.state.current_file,
            SelfHostParseDiagnostic::{
              severity: severity
              error: error
            },
            kind,
            offset,
            token_code,
            token_text,
          ),
        )
      }
            continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn finish(self) -> SelfHostCollectedModule {
    SelfHostCollectedModule::{
      module_id: self.state.module_id
      files: self.files
      file_paths: self.file_paths
      file_sources: self.file_sources
      test_files: self.test_files
      declaration_files: self.declaration_files
      body_files: self.body_files
      names: self.names
      declarations: self.declarations
      methods: self.methods
      declaration_locations: self.declaration_locations
      fields: self.fields
      variants: self.variants
      generic_parameters: self.generic_parameters
      parameters: self.parameters
      generic_parameter_spans: self.generic_parameter_spans
      generic_bounds: self.generic_bounds
      parameter_spans: self.parameter_spans
      callables: self.callables
      tests: self.tests
      imports: self.imports
      builtins: self.builtins
      lets: self.lets
      aliases: self.aliases
      derives: self.derives
      impls: self.impls
      foreign_types: self.foreign_types
      foreign_libraries: self.foreign_libraries
      foreign_functions: self.foreign_functions
      type_syntax: self.type_syntax
      type_syntax_files: self.type_syntax_files
      type_arguments: self.type_arguments
      lambda_parameters: self.lambda_parameters
      lambda_parameter_files: self.lambda_parameter_files
      lambdas: self.lambdas
      bodies: self.bodies
      body_by_declaration: self.body_by_declaration
      expressions: self.expressions
      expression_files: self.expression_files
      expression_children: self.expression_children
      explicit_call_type_argument_spans: self.explicit_call_type_argument_spans
      explicit_call_type_arguments: self.explicit_call_type_arguments
      blocks: self.blocks
      block_files: self.block_files
      block_items: self.block_items
      block_item_files: self.block_item_files
      object_fields: self.object_fields
      object_field_files: self.object_field_files
      patterns: self.patterns
      pattern_files: self.pattern_files
      pattern_children: self.pattern_children
      pattern_fields: self.pattern_fields
      pattern_field_files: self.pattern_field_files
      pattern_arms: self.pattern_arms
      pattern_arm_files: self.pattern_arm_files
      arm_children: self.arm_children
      diagnostics: self.state.diagnostics
      name_lookup: self.state.name_lookup
      type_bindings: self.state.type_bindings
      trait_bindings: self.state.trait_bindings
      value_bindings: self.state.value_bindings
      value_binding_candidates: self.state.value_binding_candidates
      foreign_library_by_alias: self.state.foreign_library_by_alias
    }
  }
}

fn self_host_collect_files(
  module_id: U64,
  files: Array<SelfHostProgramFile>,
) -> SelfHostCollectedModule {
  let builder = SelfHostCollectionBuilder::new(module_id)
  let mut file_index = 0u32
  let _ = while file_index {
    current => if current < files.length() {
      let file = files[current]
    builder.collect_file(file)
        continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  builder.finish()
}

fn self_host_collect_bytes(
  module_id: U64,
  source: Bytes,
) -> SelfHostCollectedModule {
  self_host_collect_files(module_id, [
    SelfHostProgramFile::{
      id: self_host_make_file_id(module_id, 0u32)
      path: ""
      source: source
      test_only: false
    },
  ])
}

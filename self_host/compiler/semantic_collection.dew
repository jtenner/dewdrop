pub struct SelfHostProgramFile {
  id: U64
  path: String
  source: Bytes
  test_only: Bool
}

fn self_host_collection_type_expr_at(
  values: Array<SelfHostTypeExpr>,
  index: U32,
) -> SelfHostTypeExpr {
  array_get_unchecked(values, index)
}

fn self_host_collection_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_collection_string_value(value: String) -> String {
  value
}

fn self_host_collection_type_expr_value(
  value: SelfHostTypeExpr,
) -> SelfHostTypeExpr {
  value
}

fn self_host_collection_type_parameter_at(
  parameters: Array<SelfHostTypeParameter>,
  index: U32,
) -> SelfHostTypeParameter {
  if index >= parameters.length() {
    unreachable()
  }
  let parameter = parameters[index]
  SelfHostTypeParameter::{
    name: parameter.name
    bounds: parameter.bounds
    offset: parameter.offset
  }
}

fn self_host_collection_parameter_at(
  parameters: Array<SelfHostFnParameter>,
  index: U32,
) -> SelfHostFnParameter {
  if index >= parameters.length() {
    unreachable()
  }
  let parameter = parameters[index]
  SelfHostFnParameter::{
    name: parameter.name
    type_: parameter.type_
    offset: parameter.offset
  }
}

fn self_host_collection_type_parameter_name(
  parameter: SelfHostTypeParameter,
) -> String {
  self_host_collection_string_value(parameter.name)
}

fn self_host_collection_type_parameter_offset(
  parameter: SelfHostTypeParameter,
) -> U32 {
  parameter.offset
}

fn self_host_collection_type_parameter_bound_count(
  parameter: SelfHostTypeParameter,
) -> U32 {
  parameter.bound_count()
}

fn self_host_collection_type_parameter_bound_at(
  parameter: SelfHostTypeParameter,
  index: U32,
) -> SelfHostTypeExpr {
  parameter.bound_at(index)
}

fn self_host_collection_struct_field_name(
  field: SelfHostStructField,
) -> String {
  self_host_collection_string_value(field.name)
}

fn self_host_collection_struct_field_type(
  field: SelfHostStructField,
) -> SelfHostTypeExpr {
  self_host_collection_type_expr_value(field.type_)
}

fn self_host_collection_struct_field_mutable(
  field: SelfHostStructField,
) -> Bool {
  field.mutable_
}

fn self_host_collection_struct_field_offset(
  field: SelfHostStructField,
) -> U32 {
  field.offset
}

fn self_host_collection_parameter_name(
  parameter: SelfHostFnParameter,
) -> String {
  self_host_collection_string_value(parameter.name)
}

fn self_host_collection_parameter_type(
  parameter: SelfHostFnParameter,
) -> SelfHostTypeExpr {
  self_host_collection_type_expr_value(parameter.type_)
}

fn self_host_collection_parameter_offset(
  parameter: SelfHostFnParameter,
) -> U32 {
  parameter.offset
}

fn self_host_collection_string_at(
  values: Array<String>,

) -> String {
  array_get_unchecked(values, index)
}

fn self_host_empty_name_lookup() -> Map<String, U32> {
  Map::empty()
}

fn self_host_empty_id_lookup() -> Map<U32, U64> {
  Map::empty()
}

struct SelfHostCollectedDeriveSeen {
  names: Array<String>
  offsets: Array<U32>
}

fn self_host_empty_derive_seen() -> SelfHostCollectedDeriveSeen {
  SelfHostCollectedDeriveSeen::{
    names: []
    offsets: []
  }
}

impl SelfHostCollectedDeriveSeen {
  fn get(self, name: String) -> Option<U32> {
    self_host_assert_parallel_array_lengths(
      self.names.length(),
      self.offsets.length(),
      "compiler derive names and offsets must have equal lengths",
    )
    let mut index = 0u32
    while index {
      current => if current < self.names.length() {
        if self.names[current] == name {
          break Option::Some(self.offsets[current])
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn set(self, name: String, offset: U32) -> Unit {
    self_host_assert_parallel_array_lengths(
      self.names.length(),
      self.offsets.length(),
      "compiler derive names and offsets must have equal lengths",
    )
    self.names.push(name)
    self.offsets.push(offset)
  }
}

struct SelfHostCollectedDeriveOffsets {
  eq: Option<U32>
  debug: Option<U32>
  hash: Option<U32>
  show: Option<U32>
}

fn self_host_test_declaration_name(index: U32) -> String {
  let builder = StringBuilder::new()
  builder.append("__dew_test_")
  builder.append_u32(index)
  builder.finish()
}

fn self_host_string_not_equal(left: String, right: String) -> Bool {
  !self_host_tokenizer_string_equals(left, right)
}

fn self_host_bytes_equal(left: Bytes, right: Bytes) -> Bool {
  left == right
}

fn self_host_bytes_not_equal(left: Bytes, right: Bytes) -> Bool {
  left != right
}

fn self_host_bytes_equal_string(left: Bytes, right: String) -> Bool {
  if left.byte_length() != right.byte_length() {
    return false
  }
  let mut index = 0u32
  let _ = while index {
    current => if current < left.byte_length() {
      if left.byte_at(current) != right.byte_at(current) {
        return false
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  true
}

fn self_host_bytes_empty(value: Bytes) -> Bool {
  value.byte_length() == 0u32
}

fn self_host_name_main_code(name: String) -> U32 {
  let bytes = name.as_bytes()
  if name.byte_length() == 4u32 && bytes.byte_at(0u32) == 109u8 &&
    bytes.byte_at(1u32) == 97u8 && bytes.byte_at(2u32) == 105u8 &&
    bytes.byte_at(3u32) == 110u8 {
    1296124238u32
  } else {
    0u32
  }
}

fn self_host_name_is_main(name: String) -> Bool {
  self_host_name_main_code(name) == 1296124238u32
}

struct SelfHostCollectionBuilderState {
  module_id: U64
  mut current_file: U64
  mut current_file_test_only: Bool
  mut current_lambda: U32
  mut current_root_body: U64
  diagnostics: Array<SelfHostCollectionDiagnostic>
  name_lookup: Map<String, U32>
  type_bindings: Map<U32, U64>
  trait_bindings: Map<U32, U64>
  value_bindings: Array<Option<SelfHostValueBinding>>
  value_binding_candidates: Array<SelfHostValueBindingCandidate>
  foreign_library_by_alias: Map<U32, U64>
  mut next_declaration_local: U32
  type_source_scratch: Array<SelfHostTypeExpr>
  type_state_scratch: Array<U32>
  type_result_start_scratch: Array<U32>
  type_result_scratch: Array<U32>
  type_list_scratch: Array<U32>
}


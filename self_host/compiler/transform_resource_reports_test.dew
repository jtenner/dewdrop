test "shared transform resource counts memory" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "examples/transforms/memory.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\nbuiltin store_word(address: U32, value: U32) -> Unit = \"i32.store\"\nbuiltin read_byte(address: U32) -> U32 = \"i32.load8_u\"\nbuiltin read_signed_byte(address: U32) -> I32 = \"i32.load8_s\"\nbuiltin load_vector(address: U32) -> V128 = \"v128.load\"\nbuiltin load_splat(address: U32) -> V128 = \"v128.load8_splat\"\nbuiltin load_extended(address: U32) -> V128 = \"v128.load8x8_s\"\nbuiltin store_lane(address: U32, value: V128) -> Unit = \"v128.store32_lane 1\"\nbuiltin extract_word(value: V128) -> U32 = \"i32x4.extract_lane 0\"\nbuiltin extract_second_word(value: V128) -> U32 = \"i32x4.extract_lane 1\"\nbuiltin extract_half(value: V128) -> I32 = \"i16x8.extract_lane_s 0\"\n\nfn compute() -> I32 {\n  store_word(7u32, 4294967168u32)\n  let repeated = load_splat(7u32)\n  store_lane(100u32, repeated)\n  let vector = load_vector(96u32)\n  let packed32 = swar32_add_i8(swar32_splat_i8(20i8), swar32_splat_i8(1i8))\n  let packed64 = swar64_add_i16(swar64_splat_i16(20i16), swar64_splat_i16(1i16))\n  if read_byte(7u32) == 128u32 && read_signed_byte(7u32) == -128i32 && extract_word(repeated) == 2155905152u32 && extract_second_word(vector) == 2155905152u32 && extract_half(load_extended(7u32)) == -128i32 && swar32_extract_i8_s(packed32, 3u8) == 21i8 && swar64_extract_i16_s(packed64, 3u8) == 21i16 {\n    42i32\n  } else {\n    0i32\n  }\n}\n\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(compute()))\n}\n\n#calculate\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_reports(manifest, ct_frames_test_source_pool(), true) {
    Err(error) => assert(false, error)
    Ok(expanded) => {
      let reports = expanded.reports
      assert(reports.length() == 1u32, "report count")
      assert(reports[0u32].module_name == "example.app", "module_name")
      assert(reports[0u32].file_name == "examples/transforms/memory.dew", "file_name")
      assert(reports[0u32].function_name == "main", "function_name")
      assert(reports[0u32].transform_name == "example.app::calculate", "transform_name")
      if reports[0u32].offset != 1508u32 || reports[0u32].work != 661u32 || reports[0u32].allocation_work != 78609u32 {
        let message = StringBuilder::new()
        message.append("memory: expected offset/work/allocation 1508/661/78609, got ")
        message.append_u32(reports[0u32].offset)
        message.append("/")
        message.append_u32(reports[0u32].work)
        message.append("/")
        message.append_u32(reports[0u32].allocation_work)
        assert(false, message.finish())
      }
    }
  }
}

test "shared transform resource counts packed_storage" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "examples/transforms/packed_storage.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.wasm.intrinsics\n\nstruct Packed {\n  low: Swar32\n  high: Swar64\n}\nbuiltin read_low(value: Packed) -> Swar32 = \"struct.get 0\"\nbuiltin read_high(value: Packed) -> Swar64 = \"struct.get 1\"\n\nfn default_value<t>() -> t {\n  wasm_array_get(wasm_array_new_default::<t>(1u32), 0u32)\n}\n\nfn compute() -> Bool {\n  let values = wasm_array_new_default::<Swar32>(2u32)\n  let zero = wasm_array_get(values, 0u32)\n  wasm_array_set(values, 1u32, swar32_from_bits(42u32))\n  let record = Packed::{\n    low: wasm_array_get(values, 1u32)\n    high: swar64_from_bits(42u64)\n  }\n  let array = [record.low, zero]\n  swar32_to_bits(read_low(record)) == 42u32 && swar64_to_bits(read_high(record)) == 42u64 && swar32_to_bits(array[0u32]) == 42u32 && swar32_to_bits(array[1u32]) == 0u32 && swar32_to_bits(default_value::<Swar32>()) == 0u32 && swar64_to_bits(default_value::<Swar64>()) == 0u64\n}\n\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(if compute() {\n    42i32\n  } else {\n    0i32\n  }))\n}\n\n#calculate\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_reports(manifest, ct_frames_test_source_pool(), true) {
    Err(error) => assert(false, error)
    Ok(expanded) => {
      let reports = expanded.reports

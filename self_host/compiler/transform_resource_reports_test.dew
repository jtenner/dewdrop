        assert(false, message.finish())
      }
    }
  }
}

test "shared transform resource counts typed_reflection" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "examples/transforms/typed_reflection.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\nopen dew.std.array\nopen dew.std.string\n\nfn identity(value: I32) -> I32 {\n  value\n}\n\ntransform fn check_types(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let sum = ctx.syntax.children[0u32]\n  let call = sum.children[0u32]\n  let callee = call.children[0u32]\n  let valid = match (ctx.type_of(call), ctx.type_of(callee), ctx.type_of(sum)) {\n    (Some(call_type), Some(callee_type), Some(sum_type)) => {\n      call_type.name == \"I32\" && callee_type.kind == \"function\" && sum_type.name == \"I32\"\n    }\n    _ => false\n  }\n  let answer = if valid && ctx.type_errors.length() == 0u32 {\n    42i32\n  } else {\n    0i32\n  }\n  node.with_body(@ast.integer(answer))\n}\n\n#check_types\npub fn main() -> I32 {\n  identity(20i32) + identity(22i32)\n}\n"
        test_only: false
      }]
    }]

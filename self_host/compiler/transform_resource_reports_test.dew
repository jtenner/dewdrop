      files: [{
        path: "examples/transforms/bytecode.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\nfn add(value: I32, increment: I32) -> I32 {\n  value + increment\n}\n\nfn compute(limit: I32) -> I32 {\n  let mut total = 0i32\n  let _ = while 0i32 {\n    index if index < limit => {\n      total = add(total, 3i32)\n      continue index + 1i32\n    }\n    _ => break ()\n  }\n  total\n}\n\ntransform fn calculate(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  node.with_body(@ast.integer(compute(14i32)))\n}\n\n#calculate\npub fn main() -> I32 {\n  0i32\n}\n"
        test_only: false

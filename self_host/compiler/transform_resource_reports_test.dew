      assert(reports[0u32].transform_name == "example.app::calculate", "transform_name")
      if reports[0u32].offset != 1117u32 || reports[0u32].work != 466u32 || reports[0u32].allocation_work != 9233u32 {
        let message = StringBuilder::new()
        message.append("packed_storage: expected offset/work/allocation 1117/466/9233, got ")
        message.append_u32(reports[0u32].offset)
        message.append("/")
        message.append_u32(reports[0u32].work)
        message.append("/")
        message.append_u32(reports[0u32].allocation_work)
        assert(false, message.finish())
      }
    }
  }
}

test "shared transform resource counts signatures" {
  let manifest = SelfHostProgramManifest::{
    modules: [{
      path: "example.app"
      files: [{
        path: "examples/transforms/signatures.dew"
        source: b"import dewdrop.ast as @ast\nimport dewdrop.transform as @transform\n\n// Add a parameter. Existing calls get an explicit default through the adapter.\ntransform fn add_bonus(node: @ast.FnNode, ctx: @transform.TransformContext) -> @ast.FnNode {\n  let parameters = [@ast.parameter(\"value\", @ast.named_type(\"I32\")), @ast.parameter(\"bonus\", @ast.named_type(\"I32\"))]\n  let changed = node.with_signature(parameters, @ast.named_type(\"I32\"))\n  let body = changed.with_body(@ast.name(\"value\").binary(\"+\", @ast.name(\"bonus\")))\n  body.repair_calls_with(@ast.name(node.name).call([@ast.name(\"value\"), @ast.integer(2i32)]))\n}\n\n#add_bonus\nfn answer(value: I32) -> I32 {\n  value\n}\n\npub fn main() -> I32 {\n  let callback = answer\n  callback(20i32) + answer(18i32, 2i32)\n}\n"
        test_only: false
      }]
    }]
  }
  match ct_expand_checked_with_reports(manifest, ct_frames_test_source_pool(), true) {
    Err(error) => assert(false, error)
    Ok(expanded) => {
      let reports = expanded.reports

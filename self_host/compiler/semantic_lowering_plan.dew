open dew.std.option

fn self_host_lowering_u32_at(values: Array<U32>, index: U32) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_lowering_u32_set(
  values: Array<U32>,
  index: U32,
  value: U32,
) -> Unit {
  array_set_unchecked(values, index, value)
}

pub enum SelfHostPlannedExpressionKind {
  PlannedPoisonExpression
  PlannedDeferredExpression
  PlannedConsumedExpression
  PlannedUnitConst
  PlannedI8Const(U64)
  PlannedI16Const(U64)
  PlannedI32Const(U64)
  PlannedI64Const(U64)
  PlannedU8Const(U64)
  PlannedU16Const(U64)
  PlannedU32Const(U64)
  PlannedU64Const(U64)
  PlannedF32Const(F32)
  PlannedF64Const(F64)
  PlannedBoolConst(Bool)
  PlannedStringConst(Bytes)
  PlannedStringArrayConst(Array<Bytes>)
  PlannedBytesConst(Bytes)
  PlannedLocalGet(U32)
  PlannedCaptureGet(U32)
  PlannedModuleValueGet(U64)
  PlannedFunctionReference(U64)
  PlannedProductNew(SelfHostHirSpan)
  // Ordered evaluations whose final expression cannot fall through.
  PlannedEvaluationSequence(SelfHostHirSpan)
  PlannedArrayLiteral(SelfHostHirSpan)
  PlannedLambdaClosure(U32)
  PlannedObjectNew(SelfHostHirSpan)
  PlannedConstruct(U32, SelfHostHirSpan, SelfHostBasicExpressionSelection)
  PlannedBlockExpression(U32)
  PlannedIfExpression(U32, U32, U32)
  PlannedMatchExpression(U32, SelfHostHirSpan)
  PlannedWhileExpression(U32, U32, SelfHostHirSpan)
  PlannedReturnExpression(U32)
  PlannedBreakExpression(U32, U32)
  PlannedContinueExpression(U32, U32)
  PlannedPrefixExpression(SelfHostHirPrefixOperator, U32)
  PlannedBinaryExpression(SelfHostHirBinaryOperator, U32, U32)
  PlannedOperatorCall(U64, SelfHostHirBinaryOperator, U32, U32, SelfHostHirSpan)
  PlannedBuiltinCall(Bytes, U64, U32, SelfHostHirSpan, SelfHostHirSpan)
  PlannedDirectCall(U64, U32, SelfHostHirSpan, SelfHostHirSpan)
  PlannedFunctionValueCall(U32, SelfHostHirSpan, I32)
  PlannedUnresolvedCall(U32, SelfHostHirSpan)
  PlannedFieldGet(U64, U32, Bool)
  PlannedUnresolvedField(U32, U32)
  PlannedProductField(U32, U32, U32)
  PlannedIndexGet(U32, U32, SelfHostBasicCallTarget)
  PlannedLocalSet(U32, U32)
  PlannedCaptureSet(U32, U32)
  PlannedFieldSet(U64, U32, U32)
  PlannedIndexSet(U32, U32, U32, SelfHostBasicCallTarget)
  // Proven unreachable by branch/flow pruning; never a missing value.
  PlannedDeadExpression
}

pub struct SelfHostLoweringBuiltinRecipe {
  declaration: U64
  builtin_name: Bytes
}

pub struct SelfHostPlannedExpression {
  type_: I32
  shape: SelfHostPlannedValueShape
  nominal: U64
  flow: SelfHostBodyFlowSummary
  kind: SelfHostPlannedExpressionKind
  selection: SelfHostBasicExpressionSelection
  reference: SelfHostBodyNameReference
  call_target: SelfHostBasicCallTarget
  call_type_arguments: SelfHostHirSpan
  source_name: U32
  member_base: U32
  offset: U32
}

fn self_host_planned_expression_identity(
  expression: SelfHostPlannedExpression,
) -> SelfHostPlannedExpression {
  {
    type_: expression.type_
    shape: expression.shape
    nominal: expression.nominal
    flow: self_host_body_flow_summary_identity(expression.flow)
    kind: expression.kind
    selection: expression.selection
    reference: expression.reference
    call_target: expression.call_target
    call_type_arguments: expression.call_type_arguments
    source_name: expression.source_name
    member_base: expression.member_base
    offset: expression.offset
  }
}

fn self_host_planned_expression_at(
  expressions: Array<SelfHostPlannedExpression>,
  index: U32,
) -> SelfHostPlannedExpression {
  self_host_assert_array_index(
    index,
    expressions.length(),
    "compiler planned-expression index is outside the expression arena",
  )
  self_host_planned_expression_identity(expressions[index])
}

pub enum SelfHostPlannedBlockItemKind {
  PlannedLetItem(U32, Bool, U32)
  PlannedExpressionItem(U32)
}

pub struct SelfHostPlannedBlockItem {
  kind: SelfHostPlannedBlockItemKind
  offset: U32
}

pub struct SelfHostPlannedBlock {
  items: SelfHostHirSpan
  flow: SelfHostBodyFlowSummary
  offset: U32
}

pub struct SelfHostPlannedObjectField {
  field: U64
  name: U32
  value: U32
  offset: U32
}

pub struct SelfHostPlannedNamedField {
  declaration: U64
  name: String
}

pub struct SelfHostPlannedNamedVariant {
  declaration: U64
  name: String
}

pub struct SelfHostPlannedPattern {
  elided: Bool
  type_: I32
  shape: SelfHostPlannedValueShape
  source: SelfHostHirPattern
  reference: SelfHostBodyPatternReference
  selected_constructor: SelfHostBasicPatternConstructor
  offset: U32
}

fn self_host_planned_pattern_identity(
  pattern: SelfHostPlannedPattern,
) -> SelfHostPlannedPattern {
  {
    elided: pattern.elided
    type_: pattern.type_
    shape: pattern.shape
    source: pattern.source
    reference: pattern.reference
    selected_constructor: pattern.selected_constructor
    offset: pattern.offset
  }
}

fn self_host_planned_pattern_at(
  patterns: Array<SelfHostPlannedPattern>,
  index: U32,
) -> SelfHostPlannedPattern {
  // Stop before an invalid physical Array access.
  if index >= patterns.length() {
    unreachable()
  }
  self_host_planned_pattern_identity(patterns[index])
}

pub struct SelfHostPlannedPatternField {
  name: String
  pattern: U32
  offset: U32
}

pub struct SelfHostPlannedPatternArm {
  pattern: U32
  guard_condition: U32
  body: U32
  flow: SelfHostBodyFlowSummary
  offset: U32
}

fn self_host_planned_pattern_arm_identity(
  arm: SelfHostPlannedPatternArm,
) -> SelfHostPlannedPatternArm {
  {
    pattern: arm.pattern
    guard_condition: arm.guard_condition
    body: arm.body
    flow: arm.flow
    offset: arm.offset
  }
}

fn self_host_planned_pattern_arm_at(
  arms: Array<SelfHostPlannedPatternArm>,
  index: U32,
) -> SelfHostPlannedPatternArm {
  // Stop before an invalid physical Array access.
  if index >= arms.length() {
    unreachable()
  }
  self_host_planned_pattern_arm_identity(arms[index])
}

pub struct SelfHostPlannedLocal {
  body: U64
  lambda: U32
  local_id: U32
  elided: Bool
  kind: SelfHostBodyLocalKind
  mutable_: Bool
  type_: I32
  shape: SelfHostPlannedValueShape
  nominal: U64
  offset: U32
}

pub struct SelfHostPlannedCapture {

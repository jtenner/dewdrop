pub struct SelfHostPlannedLambdaLowering {
  lambda: U32
  root_body: U64
  parameter_count: U32
  root: SelfHostHirBodyRoot
  root_type: I32
  root_shape: SelfHostPlannedValueShape
  result_shape: SelfHostPlannedValueShape
  flow: SelfHostBodyFlowSummary
  locals: SelfHostHirSpan
  local_initializers: Array<U32>
  local_assignments: Array<U32>
  captures: SelfHostHirSpan
  expressions: SelfHostHirSpan
  blocks: SelfHostHirSpan
  patterns: SelfHostHirSpan
  pattern_arms: SelfHostHirSpan
}

pub struct SelfHostPlannedModuleLowering {
  local_initializer_sources: Map<U32, U32>
  module_id: U64
  names: Array<String>
  name_diagnostics: Array<SelfHostBodyResolutionDiagnostic>
  resolved_types: SelfHostResolvedModuleTypes
  type_layouts: SelfHostPlannedModuleTypeLayouts
  initialization: SelfHostPlannedModuleInitialization
  functions: SelfHostPlannedModuleFunctions
  bodies: Array<SelfHostPlannedBodyLowering>
  lambdas: Array<SelfHostPlannedLambdaLowering>
  locals: Array<SelfHostPlannedLocal>
  captures: Array<SelfHostPlannedCapture>
  expressions: Array<SelfHostPlannedExpression>
  blocks: Array<SelfHostPlannedBlock>
  block_items: Array<SelfHostPlannedBlockItem>
  object_fields: Array<SelfHostPlannedObjectField>
  named_fields: Array<SelfHostPlannedNamedField>
  named_variants: Array<SelfHostPlannedNamedVariant>
  patterns: Array<SelfHostPlannedPattern>
  pattern_fields: Array<SelfHostPlannedPatternField>
  pattern_arms: Array<SelfHostPlannedPatternArm>
  expression_children: Array<U32>
  pattern_children: Array<U32>
  arm_children: Array<U32>
  inferred: SelfHostMergedModuleInference
  evidence: SelfHostBasicModuleEvidence
  flow_diagnostics: Array<SelfHostBodyFlowDiagnostic>
}

fn self_host_planned_object_field_identity(
  field: SelfHostPlannedObjectField,
) -> SelfHostPlannedObjectField {
  {
    field: field.field
    name: field.name
    value: field.value
    offset: field.offset
  }
}

fn self_host_planned_object_field_at(
  fields: Array<SelfHostPlannedObjectField>,
  index: U32,
) -> SelfHostPlannedObjectField {
  // Stop before an invalid physical Array access.
  if index >= fields.length() {
    unreachable()
  }
  self_host_planned_object_field_identity(fields[index])
}

fn self_host_planned_body_lowering_identity(
  value: SelfHostPlannedBodyLowering,
) -> SelfHostPlannedBodyLowering {
  value
}

fn self_host_planned_module_lowering_identity(
  value: SelfHostPlannedModuleLowering,
) -> SelfHostPlannedModuleLowering {
  value
}

fn self_host_lowering_flow_at(
  flows: Array<U32>,
  index: U32,
) -> SelfHostBodyFlowSummary {
  if index < flows.length() {
    self_host_flow_decode(flows[index])
  } else {
    self_host_flow_empty()
  }
}

fn self_host_lowering_module_value_declaration(
  collected: SelfHostCollectedModule,
  name: U32,
) -> U64 {
  match collected.value_binding(name) {
    Some(binding) => if binding.kind is LetDecl {
      collected.value_binding_candidates[binding.head].declaration
    } else {
      0u64
    }
    None => 0u64
  }
}

fn self_host_lowering_builtin_name(
  recipes: Array<SelfHostLoweringBuiltinRecipe>,
  declaration: U64,
) -> Option<Bytes> {
  let mut index = 0u32
  while index {
    current => if current < recipes.length() {
      let recipe = recipes[current]
      if self_host_u64_equal(recipe.declaration, declaration) {
        break Some(self_host_raw_array_canonical_opcode(recipe.builtin_name))
      }
      continue current + 1u32
    } else {
      break None
    }
  }
}

fn self_host_lowering_function_value_type(
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  source_expression_start: U32,
  target: U32,
) -> I32 {
  if target < source_expression_start {
    return 0i32
  }
  let relative = target - source_expression_start
  if relative >= job.expression_types.length {
    return 0i32
  }
  let index = self_host_u32_add(job.expression_types.start, relative)
  if index >= inferred.expression_types.length() {
    0i32
  } else {
    inferred.expression_types[index]
  }
}

fn self_host_lowering_unique_mutable_field(
  collected: SelfHostCollectedModule,
  name: U32,
) -> Option<U64> {
  let mut selected = 0u64
  let mut found = false
  let mut index = 0u32
  while index {
    current => if current < collected.fields.length() {
      let field = self_host_collected_field_identity(
        collected.fields[current],
      )
      if self_host_u32_equal(field.name, name) && field.mutable_ {
        match field.variant {
          None => if found {
            break None
          } else {
            selected = field.id
            found = true
          }
          Some(_) => {}
        }
      }
      continue current + 1u32
    } else if found {
      break Some(selected)
    } else {
      break None
    }
  }
}

fn self_host_lowering_expression_kind(
  collected: SelfHostCollectedModule,
  names: SelfHostResolvedModuleNames,
  builtin_recipes: Array<SelfHostLoweringBuiltinRecipe>,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  source_expression_start: U32,
  expression: U32,
  relative: U32,
) -> SelfHostPlannedExpressionKind {
  let call_target = inferred.call_targets[
    self_host_u32_add(job.call_targets.start, relative)
  ]
  let selection = inferred.expression_selections[
    self_host_u32_add(job.expression_selections.start, relative)
  ]
  if selection is DeferredBasicExpressionSelection {
    if !(collected.expressions[expression] is IfExpr(_, _, _, _)) {
      return PlannedDeferredExpression
    }
  }
  let operator_target = inferred.operator_targets[
    self_host_u32_add(job.operator_targets.start, relative)
  ]
  if collected.expressions[expression] is NameExpr(_, _) {
    match selection {
      VariantConstructionBasicExpressionSelection(_, 2u32, _) => return PlannedConstruct(
        expression,
        {
          start: 0u32
          length: 0u32
        },
        selection,
      )
      _ => {}
    }
    match call_target {
      SelectedBasicCallTarget(declaration, _) => return PlannedFunctionReference(declaration)
      _ => {}
    }
  }
  match collected.expressions[expression] {
    I8Expr(value, _) => PlannedI8Const(value)
    I16Expr(value, _) => PlannedI16Const(value)
    I32Expr(value, _) => PlannedI32Const(value)
    I64Expr(value, _) => PlannedI64Const(value)
    U8Expr(value, _) => PlannedU8Const(value)
    U16Expr(value, _) => PlannedU16Const(value)
    U32Expr(value, _) => PlannedU32Const(value)
    U64Expr(value, _) => PlannedU64Const(value)
    F32Expr(value, _) => PlannedF32Const(value)
    F64Expr(value, _) => PlannedF64Const(value)
    BoolExpr(value, _) => PlannedBoolConst(value)
    StringExpr(value, _) => PlannedStringConst(value)
    BytesExpr(value, _) => PlannedBytesConst(value)
    NameExpr(_, _) => match names.expression_references[expression] {
      LocalNameReference(local) => PlannedLocalGet(local)
      LambdaCaptureNameReference(capture) => PlannedCaptureGet(capture)
      ModuleValueNameReference(name) => PlannedModuleValueGet(
        self_host_lowering_module_value_declaration(collected, name),
      )
      ImportedModuleValueNameReference(declaration) => PlannedModuleValueGet(declaration)
      _ => PlannedPoisonExpression
    }
    ImportAliasExpr(_, _) => PlannedPoisonExpression
    ProductExpr(children, _) => PlannedProductNew(children)
    TypeBindingExpr(_, _) => PlannedUnitConst
    ArrayExpr(children, _) => PlannedArrayLiteral(children)
    LambdaExpr(lambda, _) => PlannedLambdaClosure(lambda)
    ObjectExpr(fields, _) => PlannedObjectNew(fields)
    ConstructExpr(target, fields, _) => PlannedConstruct(target, fields, selection)
    BlockExpr(block, _) => PlannedBlockExpression(block)
    IfExpr(condition, then_block, else_expression, _) => PlannedIfExpression(condition, then_block, else_expression)
    MatchExpr(value, arms, _) => PlannedMatchExpression(value, arms)
    WhileExpr(initial, arms, _) => PlannedWhileExpression(
      names.expression_controls[expression],
      initial,
      arms,
    )
    ReturnExpr(value, _) => PlannedReturnExpression(value)
    BreakExpr(value, _) => PlannedBreakExpression(
      names.transfer_targets[expression],
      value,
    )
    ContinueExpr(value, _) => PlannedContinueExpression(
      names.transfer_targets[expression],
      value,
    )
    PrefixExpr(operator, operand, _) => PlannedPrefixExpression(operator, operand)
    BinaryExpr(operator, left, right, _) => match operator_target {
      SelectedBasicCallTarget(declaration, arguments) => {
        PlannedOperatorCall(
          declaration,
          operator,
          left,
          right,
          arguments,
        )
      }
      _ => PlannedBinaryExpression(operator, left, right)
    }
    CallExpr(target, arguments, _) => match call_target {
      // Keep the requirement identity. It has no physical body: a live call
      // still needs implementation evidence before physical target lookup.
      BoundTraitBasicCallTarget(requirement, _, _, type_arguments) => PlannedDirectCall(requirement, target, arguments, type_arguments)
      SelectedBasicCallTarget(declaration, type_arguments) => match selection {
        VariantConstructionBasicExpressionSelection(
          _,
          _,
          _,
        ) => PlannedDirectCall(
          declaration,
          target,
          arguments,
          type_arguments,
        )
        _ => match self_host_lowering_builtin_name(
          builtin_recipes,
          declaration,
        ) {
          Some(builtin_name) => PlannedBuiltinCall(
            builtin_name,
            declaration,
            target,
            arguments,
            type_arguments,
          )
          None => PlannedDirectCall(
            declaration,
            target,
            arguments,
            type_arguments,
          )
        }
      }
      FunctionValueBasicCallTarget(_) => PlannedFunctionValueCall(
        target,
        arguments,
        self_host_lowering_function_value_type(
          inferred,
          job,
          source_expression_start,
          target,
        ),
      )
      _ => PlannedUnresolvedCall(target, arguments)
    }
    FieldExpr(base, name, _) => match selection {
      FieldBasicExpressionSelection(field, mutable_, _) => PlannedFieldGet(field, base, mutable_)
      _ => PlannedUnresolvedField(base, name)
    }
    QualifiedExpr(base, _, _) => match selection {
      VariantConstructionBasicExpressionSelection(
        _,
        _,
        _,
      ) => PlannedConstruct(
        base,
        {
          start: 0u32
          length: 0u32
        },
        selection,
      )
      _ => PlannedPoisonExpression
    }
    ProductFieldExpr(base, index, count, _) => PlannedProductField(base, index, count)
    IndexExpr(base, index, _) => PlannedIndexGet(base, index, operator_target)
    AssignmentExpr(target, value, _) => match collected.expressions[target] {
      NameExpr(_, _) => match names.expression_references[target] {
        LocalNameReference(local) => PlannedLocalSet(local, value)
        LambdaCaptureNameReference(capture) => PlannedCaptureSet(capture, value)
        _ => PlannedPoisonExpression
      }
      FieldExpr(base, name, _) => match inferred.expression_selections[
        self_host_u32_add(
          job.expression_selections.start,
          target - source_expression_start,
        )
      ] {
        FieldBasicExpressionSelection(field, _, _) => PlannedFieldSet(field, base, value)
        _ => match self_host_lowering_unique_mutable_field(collected, name) {
          Some(field) => PlannedFieldSet(
            field,
            base,
            value,
          )
          None => PlannedPoisonExpression
        }
      }
      _ => PlannedPoisonExpression
    }
    IndexSetExpr(base, index, value, _) => PlannedIndexSet(base, index, value, operator_target)
  }
}

fn self_host_lowering_target_type_arguments(
  target: SelfHostBasicCallTarget,
) -> SelfHostHirSpan {
  match target {
    SelectedBasicCallTarget(_, arguments) => arguments
    BoundTraitBasicCallTarget(_, _, _, arguments) => arguments
    _ => ({
      start: 0u32
      length: 0u32
    })
  }
}

fn self_host_lowering_error_expression() -> SelfHostPlannedExpression {
  {
    type_: -1i32
    shape: ErrorPlannedValueShape
    nominal: 0u64
    flow: self_host_flow_empty()
    kind: PlannedPoisonExpression
    selection: NoBasicExpressionSelection
    reference: NoNameReference
    call_target: NoBasicCallTarget
    call_type_arguments: {
      start: 0u32
      length: 0u32
    }
    source_name: 4294967295u32
    member_base: 4294967295u32
    offset: 0u32
  }
}

fn self_host_lowering_expression_slots(length: U32) -> Array<SelfHostPlannedExpression> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push(self_host_lowering_error_expression())
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_plan_expressions(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  builtin_recipes: Array<SelfHostLoweringBuiltinRecipe>,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  source: SelfHostHirSpan,
  flows: Array<U32>,
  output: Array<SelfHostPlannedExpression>,
  reachability: Option<SelfHostInferenceReachability>,
) -> Unit {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < source.length {
      let expression = self_host_u32_add(source.start, current)
      match reachability {
        Some(live) => if !live.expressions[expression] {
          continue current + 1u32
        }
        None => {}
      }
      let type_ = inferred.expression_types[
        self_host_u32_add(job.expression_types.start, current)
      ]
      let source_expression = collected.expressions[expression]
      let call_target = inferred.call_targets[
        self_host_u32_add(job.call_targets.start, current)
      ]
      let operator_target = inferred.operator_targets[
        self_host_u32_add(job.operator_targets.start, current)
      ]
      let selected_target = match source_expression {
        // An implicit pattern comparison owns call evidence, not a Bool value.
        StringExpr(_, _) => operator_target
        BinaryExpr(_, _, _, _) => operator_target
        IndexExpr(_, _, _) => operator_target
        IndexSetExpr(_, _, _, _) => operator_target
        _ => call_target
      }
      output[expression] = {
        type_: type_
        shape: self_host_planned_merged_body_value_shape(
          resolved,
          inferred,
          type_,
        )
        nominal: self_host_lowering_body_nominal(
          resolved,
          inferred,
          type_,
        )
        flow: self_host_lowering_flow_at(flows, current)
        kind: self_host_lowering_expression_kind(
          collected,
          names,
          builtin_recipes,
          inferred,
          job,
          source.start,
          expression,
          current,
        )
        selection: inferred.expression_selections[
          self_host_u32_add(job.expression_selections.start, current)
        ]
        reference: names.expression_references[expression]
        call_target: selected_target
        call_type_arguments: self_host_lowering_target_type_arguments(
          selected_target,
        )
        source_name: match source_expression {
          NameExpr(name, _) => name
          FieldExpr(_, name, _) => name
          QualifiedExpr(_, name, _) => name
          _ => 4294967295u32
        }
        member_base: match source_expression {
          FieldExpr(base, _, _) => base
          QualifiedExpr(base, _, _) => base
          _ => 4294967295u32
        }
        offset: self_host_basic_expression_offset(source_expression)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_lowering_plan_block_item(
  source: SelfHostHirBlockItem,
  local: U32,
) -> SelfHostPlannedBlockItem {
  if self_host_hir_block_item_is_let(source) {
    {
      kind: PlannedLetItem(
        local,
        source.mutable_,
        source.value,
      )
      offset: source.offset
    }
  } else {
    {
      kind: PlannedExpressionItem(source.value)
      offset: source.offset
    }
  }
}

fn self_host_lowering_plan_job_structures(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  names: SelfHostResolvedModuleNames,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  source_blocks: SelfHostHirSpan,
  source_block_items: SelfHostHirSpan,
  source_patterns: SelfHostHirSpan,
  source_pattern_arms: SelfHostHirSpan,
  block_flows: Array<U32>,
  arm_flows: Array<U32>,
  blocks: Array<SelfHostPlannedBlock>,
  block_items: Array<SelfHostPlannedBlockItem>,
  patterns: Array<SelfHostPlannedPattern>,
  pattern_arms: Array<SelfHostPlannedPatternArm>,
) -> Unit {
  let mut block = 0u32
  let _ = while block {
    current => if current < source_blocks.length {
      let index = self_host_u32_add(source_blocks.start, current)
      let source = collected.blocks[index]
      blocks[index] = {
        items: source.items
        flow: self_host_lowering_flow_at(block_flows, current)
        offset: source.offset
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut item = 0u32
  let _ = while item {
    current => if current < source_block_items.length {
      let index = self_host_u32_add(source_block_items.start, current)
      block_items[index] = self_host_lowering_plan_block_item(
        collected.block_items[index],
        names.block_item_locals[index],
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut pattern = 0u32
  let _ = while pattern {
    current => if current < source_patterns.length {
      let index = self_host_u32_add(source_patterns.start, current)
      let type_ = inferred.pattern_types[
        self_host_u32_add(job.pattern_types.start, current)
      ]
      let source_pattern = collected.patterns[index]
      patterns[index] = {
        elided: false
        type_: type_
        shape: self_host_planned_merged_body_value_shape(
          resolved,
          inferred,
          type_,
        )
        source: source_pattern
        reference: names.pattern_references[index]
        selected_constructor: inferred.pattern_constructors[
          self_host_u32_add(job.pattern_constructors.start, current)
        ]
        offset: self_host_hir_pattern_offset(source_pattern)
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut arm = 0u32
  let _ = while arm {
    current => if current < source_pattern_arms.length {
      let index = self_host_u32_add(source_pattern_arms.start, current)
      let source = collected.pattern_arms[index]
      pattern_arms[index] = {
        pattern: source.pattern
        guard_condition: source.guard_condition
        body: source.body
        flow: self_host_lowering_flow_at(arm_flows, current)
        offset: source.offset
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_lowering_block_slots(length: U32) -> Array<SelfHostPlannedBlock> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push({
        items: {
          start: 0u32
          length: 0u32
        }
        flow: self_host_flow_empty()
        offset: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_block_item_slots(length: U32) -> Array<SelfHostPlannedBlockItem> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push({
        kind: PlannedExpressionItem(0u32)
        offset: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_pattern_slots(length: U32) -> Array<SelfHostPlannedPattern> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push({
        elided: false
        type_: -1i32
        shape: ErrorPlannedValueShape
        source: WildcardPattern(0u32)
        reference: NoPatternReference
        selected_constructor: NoBasicPatternConstructor
        offset: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_arm_slots(length: U32) -> Array<SelfHostPlannedPatternArm> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push({
        pattern: 0u32
        guard_condition: 0u32
        body: 0u32
        flow: self_host_flow_empty()
        offset: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_object_field_slots(length: U32) -> Array<SelfHostPlannedObjectField> {
  let values = []
  let mut index = 0u32
  let _ = while index {
    current => if current < length {
      values.push({
        field: 0u64
        name: 4294967295u32
        value: 0u32
        offset: 0u32
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  values
}

fn self_host_lowering_plan_object_fields(
  collected: SelfHostCollectedModule,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  source: SelfHostHirSpan,
  output: Array<SelfHostPlannedObjectField>,
) -> Unit {
  let mut relative = 0u32
  let _ = while relative {
    current => if current < source.length {
      let index = self_host_u32_add(source.start, current)
      let field = match inferred.object_field_targets[
        self_host_u32_add(job.object_field_targets.start, current)
      ] {
        SelectedBasicObjectFieldTarget(value) => value
        _ => 0u64
      }
      let source_field = collected.object_fields[index]
      output[index] = {
        field: field
        name: source_field.name
        value: source_field.value
        offset: source_field.offset
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_lowering_append_flow_diagnostics(
  output: Array<SelfHostBodyFlowDiagnostic>,
  source: Array<SelfHostBodyFlowDiagnostic>,
) -> Unit {
  let mut diagnostic_index = 0u32
  let _ = while diagnostic_index {
    current => if current < source.length() {
      output.push(source[current])
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_lowering_consume_expression_target(
  expressions: Array<SelfHostPlannedExpression>,
  target: U32,
) -> Unit {
  if target < expressions.length() {
    let source = expressions[target]
    expressions[target] = {
      type_: source.type_
      shape: source.shape
      nominal: source.nominal
      flow: source.flow
      kind: PlannedConsumedExpression
      selection: source.selection
      reference: source.reference
      call_target: source.call_target
      call_type_arguments: source.call_type_arguments
      source_name: source.source_name
      member_base: source.member_base
      offset: source.offset
    }
  }
}

fn self_host_lowering_directize_targets(
  expressions: Array<SelfHostPlannedExpression>,
) -> Unit {
  let mut index = 0u32
  let _ = while index {
    current => if current < expressions.length() {
      match expressions[current].kind {
        PlannedDirectCall(_, target, _, _) => {
          self_host_lowering_consume_expression_target(expressions, target)
        }
        PlannedConstruct(target, _, _) => {
          if target != current {
            self_host_lowering_consume_expression_target(expressions, target)
          }
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_plan_module_lowering_with_builtin_recipes(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  type_layouts: SelfHostPlannedModuleTypeLayouts,
  initialization: SelfHostPlannedModuleInitialization,
  functions: SelfHostPlannedModuleFunctions,
  names: SelfHostResolvedModuleNames,
  builtin_recipes: Array<SelfHostLoweringBuiltinRecipe>,
  inferred: SelfHostMergedModuleInference,
  evidence: SelfHostBasicModuleEvidence,
  flows: SelfHostAnalyzedModuleFlows,
) -> SelfHostPlannedModuleLowering {
  self_host_plan_module_lowering_with_reachability(collected, resolved, type_layouts, initialization, functions, names, builtin_recipes, inferred, evidence, flows, None)
}

fn self_host_plan_module_lowering_with_reachability(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  type_layouts: SelfHostPlannedModuleTypeLayouts,
  initialization: SelfHostPlannedModuleInitialization,
  functions: SelfHostPlannedModuleFunctions,
  names: SelfHostResolvedModuleNames,
  builtin_recipes: Array<SelfHostLoweringBuiltinRecipe>,
  inferred: SelfHostMergedModuleInference,
  evidence: SelfHostBasicModuleEvidence,
  flows: SelfHostAnalyzedModuleFlows,
  reachability: Option<SelfHostInferenceReachability>,
) -> SelfHostPlannedModuleLowering {
  let expressions = self_host_lowering_expression_slots(
    collected.expressions.length(),
  )
  let blocks = self_host_lowering_block_slots(collected.blocks.length())
  let block_items = self_host_lowering_block_item_slots(
    collected.block_items.length(),
  )
  let object_fields = self_host_lowering_object_field_slots(
    collected.object_fields.length(),
  )
  let patterns = self_host_lowering_pattern_slots(collected.patterns.length())
  let pattern_arms = self_host_lowering_arm_slots(
    collected.pattern_arms.length(),
  )
  let bodies = []
  let lambdas = []
  let locals = []
  let captures = []
  let flow_diagnostics = []
  let mut body_index = 0u32
  let _ = while body_index {
    current => if current < collected.bodies.length() {
      let source = collected.bodies[current]
      let job = inferred.jobs[current]
      let flow = flows.bodies[current]
      self_host_lowering_plan_expressions(
        collected,
        resolved,
        names,
        builtin_recipes,
        inferred,
        job,
        source.expressions,
        flow.expression_flows,
        expressions,
        reachability,
      )
      self_host_lowering_plan_job_structures(
        collected,
        resolved,
        names,
        inferred,
        job,
        source.blocks,
        source.block_items,
        source.patterns,
        source.pattern_arms,
        flow.block_flows,
        flow.arm_flows,
        blocks,
        block_items,
        patterns,
        pattern_arms,
      )
      self_host_lowering_plan_object_fields(
        collected,
        inferred,
        job,
        source.object_fields,
        object_fields,
      )
      let planned_locals = self_host_lowering_plan_locals(
        resolved,
        inferred,
        job,
        names,
        names.bodies[current].locals,
        source.id,
        4294967295u32,
        locals,
      )
      let (local_initializers, local_assignments) = self_host_lowering_local_sources(
        planned_locals.length,
        source.block_items,
        source.expressions,
        block_items,
        expressions,
      )
      let root_shape = self_host_planned_merged_body_value_shape(
        resolved,
        inferred,
        job.root_type,
      )
      bodies.push({
        body: source.id
        declaration: source.declaration
        kind: source.kind
        root: source.root
        root_type: job.root_type
        root_shape: root_shape
        result_shape: root_shape
        flow: flow.flow
        locals: planned_locals
        local_initializers: local_initializers
        local_assignments: local_assignments
        expressions: source.expressions
        blocks: source.blocks
        patterns: source.patterns
        pattern_arms: source.pattern_arms
      })
      self_host_lowering_append_flow_diagnostics(
        flow_diagnostics,
        flow.diagnostics,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let body_job_count = collected.bodies.length()
  let mut lambda_index = 0u32
  let _ = while lambda_index {
    current => if current < collected.lambdas.length() {
      let source = collected.lambdas[current]
      let job = inferred.jobs[self_host_u32_add(body_job_count, current)]
      let flow = flows.lambdas[current]
      self_host_lowering_plan_expressions(
        collected,
        resolved,
        names,
        builtin_recipes,
        inferred,
        job,
        source.body.expressions,
        flow.expression_flows,
        expressions,
        reachability,
      )
      self_host_lowering_plan_job_structures(
        collected,
        resolved,
        names,
        inferred,
        job,
        source.body.blocks,
        source.body.block_items,
        source.body.patterns,
        source.body.pattern_arms,
        flow.block_flows,
        flow.arm_flows,
        blocks,
        block_items,
        patterns,
        pattern_arms,
      )
      self_host_lowering_plan_object_fields(
        collected,
        inferred,
        job,
        source.body.object_fields,
        object_fields,
      )
      let planned_locals = self_host_lowering_plan_locals(
        resolved,
        inferred,
        job,
        names,
        names.lambdas[current].locals,
        source.root_body,
        source.id,
        locals,
      )
      let (local_initializers, local_assignments) = self_host_lowering_local_sources(
        planned_locals.length,
        source.body.block_items,
        source.body.expressions,
        block_items,
        expressions,
      )
      let planned_captures = self_host_lowering_plan_captures(
        resolved,
        inferred,
        job,
        names,
        names.lambdas[current].captures,
        source.id,
        captures,
      )
      let root_shape = self_host_planned_merged_body_value_shape(
        resolved,
        inferred,
        job.root_type,
      )
      lambdas.push({
        lambda: source.id
        root_body: source.root_body
        parameter_count: source.parameters.length
        root: BlockBodyRoot(source.body.root)
        root_type: job.root_type
        root_shape: root_shape
        result_shape: root_shape
        flow: flow.flow
        locals: planned_locals
        local_initializers: local_initializers
        local_assignments: local_assignments
        captures: planned_captures
        expressions: source.body.expressions
        blocks: source.body.blocks
        patterns: source.body.patterns
        pattern_arms: source.body.pattern_arms
      })
      self_host_lowering_append_flow_diagnostics(
        flow_diagnostics,
        flow.diagnostics,
      )
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let named_fields = []
  let mut named_field_index = 0u32
  let _ = while named_field_index {
    current => if current < collected.fields.length() {
      let field = self_host_collected_field_identity(collected.fields[current])
      named_fields.push({
        declaration: field.id
        name: collected.name(field.name)
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let named_variants = []
  let mut named_variant_index = 0u32
  let _ = while named_variant_index {
    current => if current < collected.variants.length() {
      let variant = self_host_collected_variant_identity(collected.variants[current])
      named_variants.push({
        declaration: variant.id
        name: collected.name(variant.name)
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let pattern_fields = []
  let mut pattern_field_index = 0u32
  let _ = while pattern_field_index {
    current => if current < collected.pattern_fields.length() {
      let field = self_host_hir_pattern_field_identity(
        collected.pattern_fields[current],
      )
      pattern_fields.push({
        name: collected.name(field.name)
        pattern: field.pattern
        offset: field.offset
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  self_host_lowering_directize_targets(expressions)
  let module_ = {
    local_initializer_sources: self_host_query_local_sources(collected, names)
    module_id: collected.module_id
    names: collected.names
    name_diagnostics: names.diagnostics
    resolved_types: resolved
    type_layouts: type_layouts
    initialization: initialization
    functions: functions
    bodies: bodies
    lambdas: lambdas
    locals: locals
    captures: captures
    expressions: expressions
    blocks: blocks
    block_items: block_items
    object_fields: object_fields
    named_fields: named_fields
    named_variants: named_variants
    patterns: patterns
    pattern_fields: pattern_fields
    pattern_arms: pattern_arms
    expression_children: collected.expression_children.copy()
    pattern_children: collected.pattern_children
    arm_children: collected.arm_children
    inferred: inferred
    evidence: evidence
    flow_diagnostics: flow_diagnostics
  }
  self_host_lower_nonreturning_constructions(module_)
  module_
}

fn self_host_lowering_local_sources(
  local_count: U32,
  block_item_span: SelfHostHirSpan,
  expression_span: SelfHostHirSpan,
  block_items: Array<SelfHostPlannedBlockItem>,
  expressions: Array<SelfHostPlannedExpression>,
) -> (Array<U32>, Array<U32>) {
  let initializers = []
  let assignments = []
  let mut local = 0u32
  let _ = while local {
    current => if current < local_count {
      initializers.push(4294967295u32)
      assignments.push(4294967295u32)
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut item_offset = 0u32
  let _ = while item_offset {
    current => if current < block_item_span.length {
      let item_index = self_host_u32_add(block_item_span.start, current)
      if item_index < block_items.length() {
        match block_items[item_index].kind {
          PlannedLetItem(
            local_id,
            _,
            initializer,
          ) => if local_id < local_count {
            self_host_lowering_u32_set(initializers, local_id, initializer)
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let expression_end = self_host_u32_add(
    expression_span.start,
    expression_span.length,
  )
  let mut expression = expression_span.start
  let _ = while expression {
    current => if current < expression_end {
      if current < expressions.length() {
        match self_host_planned_expression_at(expressions, current).kind {
          PlannedLocalSet(local_id, value) => if local_id < local_count {
            if self_host_u32_equal(
              self_host_lowering_u32_at(assignments, local_id),
              4294967295u32,
            ) {
              self_host_lowering_u32_set(assignments, local_id, value)
            }
          }
          _ => {}
        }
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  (initializers, assignments)
}

fn self_host_lowering_plan_locals(
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  names: SelfHostResolvedModuleNames,
  source: SelfHostHirSpan,
  body: U64,
  lambda: U32,
  output: Array<SelfHostPlannedLocal>,
) -> SelfHostHirSpan {
  let exact_inferred = self_host_merged_module_inference_identity(inferred)
  let start = output.length()
  let mut relative = 0u32
  let _ = while relative {
    current => if current < source.length {
      let source_local = self_host_body_local_identity(
        names.locals[self_host_u32_add(source.start, current)],
      )
      let type_ = exact_inferred.local_types[
        self_host_u32_add(job.local_types.start, current)
      ]
      output.push({
        body: body
        lambda: lambda
        local_id: source_local.id
        elided: false
        kind: source_local.kind
        mutable_: source_local.mutable_
        type_: type_
        shape: self_host_planned_merged_body_value_shape(
          resolved,
          inferred,
          type_,
        )
        nominal: self_host_lowering_body_nominal(
          resolved,
          inferred,
          type_,
        )
        offset: source_local.offset
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    start: start
    length: output.length() - start
  }
}

fn self_host_lowering_plan_captures(
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostMergedModuleInference,
  job: SelfHostMergedInferenceJob,
  names: SelfHostResolvedModuleNames,
  source: SelfHostHirSpan,
  lambda: U32,
  output: Array<SelfHostPlannedCapture>,
) -> SelfHostHirSpan {
  let start = output.length()
  let mut relative = 0u32
  let _ = while relative {
    current => if current < source.length {
      let source_capture = names.captures[
        self_host_u32_add(source.start, current)
      ]
      let type_ = inferred.capture_types[
        self_host_u32_add(job.capture_types.start, current)
      ]
      output.push({
        lambda: lambda
        capture: current
        source: source_capture.source
        mutable_: source_capture.mutable_
        type_: type_
        shape: self_host_planned_merged_body_value_shape(
          resolved,
          inferred,
          type_,
        )
        nominal: self_host_lowering_body_nominal(
          resolved,
          inferred,
          type_,
        )
        offset: source_capture.offset
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  {
    start: start
    length: output.length() - start
  }
}

fn self_host_lowering_resolved_nominal(
  resolved: SelfHostResolvedModuleTypes,
  root: U32,
) -> U64 {
  let mut current = root
  while current {
    type_ => match resolved.types[type_] {
      NominalType(declaration) => break declaration
      AppliedType(base, _) => continue base
      _ => break 0u64
    }
  }
}

fn self_host_lowering_body_nominal(
  resolved: SelfHostResolvedModuleTypes,
  inferred: SelfHostMergedModuleInference,
  root: I32,
) -> U64 {
  let exact_inferred = self_host_merged_module_inference_identity(inferred)
  let mut current = root
  while current {
    type_ => if type_ < -1i32 {
      break self_host_lowering_resolved_nominal(
        resolved,
        self_host_body_i32_to_u32(-type_ - 2i32),
      )
    } else if type_ < 0i32 {
      break 0u64
    } else {
      let index = self_host_body_i32_to_u32(type_)
      if index >= exact_inferred.types.length() {
        break 0u64
      }
      match exact_inferred.types[index] {
        BodyAppliedType(base, _) => continue base
        BodyResolvedType(resolved_type) => break self_host_lowering_resolved_nominal(
          resolved,
          resolved_type,
        )
        _ => break 0u64
      }
    }
  }
}

fn self_host_lowering_local_builtin_recipes(
  collected: SelfHostCollectedModule,
) -> Array<SelfHostLoweringBuiltinRecipe> {
  let recipes = []
  let mut builtin_index = 0u32
  let _ = while builtin_index {
    current => if current < collected.builtins.length() {
      let value = self_host_collected_builtin_identity(collected.builtins[current])
      recipes.push({
        declaration: value.declaration
        builtin_name: value.builtin_name
      })
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  recipes
}

fn self_host_lowering_imported_builtin_recipes(
  collected: SelfHostCollectedModule,
  imports: SelfHostResolvedModuleImports,
) -> Array<SelfHostLoweringBuiltinRecipe> {
  let recipes = self_host_lowering_local_builtin_recipes(collected)
  let mut callable_index = 0u32
  let _ = while callable_index {
    current => if current < imports.callables.length() {
      let callable = self_host_resolved_imported_callable_at(
        imports.callables,
        current,
      )
      match callable.kind {
        FrozenBuiltinCallable(name) => {
          recipes.push({
            declaration: callable.declaration
            builtin_name: name
          })
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  recipes
}

fn self_host_plan_module_lowering(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  type_layouts: SelfHostPlannedModuleTypeLayouts,
  initialization: SelfHostPlannedModuleInitialization,
  functions: SelfHostPlannedModuleFunctions,
  names: SelfHostResolvedModuleNames,
  inferred: SelfHostMergedModuleInference,
  flows: SelfHostAnalyzedModuleFlows,
) -> SelfHostPlannedModuleLowering {
  self_host_plan_module_lowering_with_builtin_recipes(
    collected,
    resolved,
    type_layouts,
    initialization,
    functions,
    names,
    self_host_lowering_local_builtin_recipes(collected),
    inferred,
    self_host_publish_merged_module_evidence(
      collected,
      inferred,
      self_host_index_module_implementations(collected, resolved),
    ),
    flows,
  )
}

fn self_host_plan_module_lowering_with_imports(
  collected: SelfHostCollectedModule,
  resolved: SelfHostResolvedModuleTypes,
  type_layouts: SelfHostPlannedModuleTypeLayouts,
  initialization: SelfHostPlannedModuleInitialization,
  functions: SelfHostPlannedModuleFunctions,
  names: SelfHostResolvedModuleNames,
  imports: SelfHostResolvedModuleImports,
  inferred: SelfHostMergedModuleInference,
  flows: SelfHostAnalyzedModuleFlows,
) -> SelfHostPlannedModuleLowering {
  self_host_plan_module_lowering_with_builtin_recipes(
    collected,
    resolved,
    type_layouts,
    initialization,
    functions,
    names,
    self_host_lowering_imported_builtin_recipes(collected, imports),
    inferred,
    self_host_publish_merged_module_evidence(
      collected,
      inferred,
      self_host_index_module_implementations_with_imports(collected, imports),
    ),
    flows,
  )
}

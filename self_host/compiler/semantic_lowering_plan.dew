  kind: SelfHostHirBodyKind
  root: SelfHostHirBodyRoot
  root_type: I32
  root_shape: SelfHostPlannedValueShape
  result_shape: SelfHostPlannedValueShape
  flow: SelfHostBodyFlowSummary
  locals: SelfHostHirSpan
  local_initializers: Array<U32>
  local_assignments: Array<U32>
  expressions: SelfHostHirSpan
  blocks: SelfHostHirSpan
  patterns: SelfHostHirSpan
  pattern_arms: SelfHostHirSpan

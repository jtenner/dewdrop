open dew.std.array
open dew.std.option
open dew.std.string
open dew.std.string_builder

fn self_host_derive_unit() -> Unit {
}

fn self_host_derived_struct_field_at(
  fields: Array<SelfHostStructField>,
  index: U32,
) -> SelfHostStructField {
  // Stop before an invalid physical Array access.
  if index >= fields.length() {
    unreachable()
  }
  let field = fields[index]
  SelfHostStructField::{
    mutable_: field.mutable_
    name: field.name
    type_: field.type_
    offset: field.offset
  }
}

fn self_host_derived_type_parameter_at(
  parameters: Array<SelfHostTypeParameter>,
  index: U32,
) -> SelfHostTypeParameter {
  // Stop before an invalid physical Array access.
  if index >= parameters.length() {
    unreachable()
  }
  let parameter = parameters[index]
  SelfHostTypeParameter::{
    name: parameter.name
    bounds: parameter.bounds
    offset: parameter.offset
  }
}

fn self_host_derived_enum_variant_at(
  variants: Array<SelfHostEnumVariant>,
  index: U32,
) -> SelfHostEnumVariant {
  // Stop before an invalid physical Array access.
  if index >= variants.length() {
    unreachable()
  }
  match variants[index] {
    SelfHostEnumVariant::UnitVariant(name, name_offset, offset) =>
      SelfHostEnumVariant::UnitVariant(name, name_offset, offset)
    SelfHostEnumVariant::TupleVariant(name, types, name_offset, offset) =>
      SelfHostEnumVariant::TupleVariant(name, types, name_offset, offset)
    SelfHostEnumVariant::StructVariant(name, fields, name_offset, offset) =>
      SelfHostEnumVariant::StructVariant(name, fields, name_offset, offset)
  }
}

fn self_host_derived_indexed_name(
  prefix: String,
  first: U32,
  middle: String,
  second: U32,
) -> String {
  let builder = StringBuilder::new()
  builder.append(prefix)
  builder.append_u32(first)
  builder.append(middle)
  builder.append_u32(second)
  builder.finish()
}

fn self_host_derived_single_index_name(
  prefix: String,
  index: U32,
) -> String {
  let builder = StringBuilder::new()
  builder.append(prefix)
  builder.append_u32(index)
  builder.finish()
}

fn self_host_derived_enum_variant_name(
  variant: SelfHostEnumVariant,
) -> String {
  match variant {
    SelfHostEnumVariant::UnitVariant(name, _, _) => name
    SelfHostEnumVariant::TupleVariant(name, _, _, _) => name
    SelfHostEnumVariant::StructVariant(name, _, _, _) => name
  }
}

fn self_host_derived_eq_expression(
  left_names: Array<String>,
  right_names: Array<String>,
  offset: U32,
) -> SelfHostExpr {
  // Both generated pattern sides must have one name at each position.
  if left_names.length() != right_names.length() {
    unreachable()
  }
  let mut result = SelfHostExpr::BoolExpr(true, offset)
  let mut index = 0u32
  let _ = while index {
    current => if current < left_names.length() {
      let equal = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::Equal,
        SelfHostExpr::NameExpr(left_names[current], offset),
        SelfHostExpr::NameExpr(right_names[current], offset),
        offset,
      )
      result = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::LogicalAnd,
        result,
        equal,
        offset,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_struct_eq_expression(
  fields: Array<SelfHostStructField>,
  offset: U32,
) -> SelfHostExpr {
  let mut result = SelfHostExpr::BoolExpr(true, offset)
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < fields.length() {
      let field = self_host_derived_struct_field_at(fields, current)
      let equal = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::Equal,
        SelfHostExpr::FieldExpr(
          SelfHostExpr::NameExpr("self", offset),
          field.name,
          offset,
        ),
        SelfHostExpr::FieldExpr(
          SelfHostExpr::NameExpr("right", offset),
          field.name,
          offset,
        ),
        offset,
      )
      result = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::LogicalAnd,
        result,
        equal,
        offset,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_variant_pattern(
  enum_name: String,
  variant: SelfHostEnumVariant,
  prefix: String,
  offset: U32,
) -> (SelfHostPattern, Array<String>) {
  let base = SelfHostPattern::QualifiedPattern(
    SelfHostPattern::BindingPattern(enum_name, offset),
    self_host_derived_enum_variant_name(variant),
    offset,
  )
  let names = []
  match variant {
    SelfHostEnumVariant::UnitVariant(_, _, _) => (base, names)
    SelfHostEnumVariant::TupleVariant(_, types, _, _) => {
      let patterns = []
      let mut index = 0u32
      let _ = while index {
        current => if current < types.length() {
          let name = self_host_derived_single_index_name(prefix, current)
          names.push(name)
          patterns.push(SelfHostPattern::BindingPattern(name, offset))
          continue current + 1u32
        } else {
          break self_host_derive_unit()
        }
      }
      (SelfHostPattern::TuplePattern(base, patterns, offset), names)
    }
    SelfHostEnumVariant::StructVariant(_, fields, _, _) => {
      let patterns = []
      let mut index = 0u32
      let _ = while index {
        current => if current < fields.length() {
          let field = self_host_derived_struct_field_at(fields, current)
          let name = self_host_derived_single_index_name(prefix, current)
          names.push(name)
          let pattern = SelfHostPatternField::{
            name: field.name
            pattern: SelfHostPattern::BindingPattern(name, offset)
            offset: offset
          }
          patterns.push(pattern)
          continue current + 1u32
        } else {
          break self_host_derive_unit()
        }
      }
      (
        SelfHostPattern::StructPattern(base, patterns, Option::None, offset),
        names,
      )
    }
  }
}

fn self_host_derived_enum_eq_expression(
  enum_name: String,
  variants: Array<SelfHostEnumVariant>,
  offset: U32,
) -> SelfHostExpr {
  let outer_arms = []
  let mut index = 0u32
  let _ = while index {
    current => if current < variants.length() {
      let variant = self_host_derived_enum_variant_at(variants, current)
      let left_prefix = self_host_derived_single_index_name(
        "derive_left_",
        current,
      ).concat("_")
      let right_prefix = self_host_derived_single_index_name(
        "derive_right_",
        current,
      ).concat("_")
      let (left_pattern, left_names) = self_host_derived_variant_pattern(
        enum_name,
        variant,
        left_prefix,
        offset,
      )
      let (right_pattern, right_names) = self_host_derived_variant_pattern(
        enum_name,
        variant,
        right_prefix,
        offset,
      )
      let inner_arms = []
      inner_arms.push(
        SelfHostPatternArm::{
          pattern: right_pattern
          guard_condition: Option::None
          body: self_host_derived_eq_expression(
            left_names,
            right_names,
            offset,
          )
          offset: offset
        },
      )
      inner_arms.push(
        SelfHostPatternArm::{
          pattern: SelfHostPattern::WildcardPattern(offset)
          guard_condition: Option::None
          body: SelfHostExpr::BoolExpr(false, offset)
          offset: offset
        },
      )
      outer_arms.push(
        SelfHostPatternArm::{
          pattern: left_pattern
          guard_condition: Option::None
          body: SelfHostExpr::MatchExpr(
            SelfHostExpr::NameExpr("right", offset),
            inner_arms,
            offset,
          )
          offset: offset
        },
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  SelfHostExpr::MatchExpr(
    SelfHostExpr::NameExpr("self", offset),
    outer_arms,
    offset,
  )
}

// This helper keeps the derive traversal stack on its exact AST type.
// The backend uses this type as compile-time proof for Array pop carriers.
fn self_host_derived_type_stack(
  root: SelfHostTypeExpr,
) -> Array<SelfHostTypeExpr> {
  [root]
}

fn self_host_derived_type_mentions_parameter(
  root: SelfHostTypeExpr,
  parameter: String,
) -> Bool {
  let stack = self_host_derived_type_stack(root)
  while stack.length() {
    length => if length > 0u32 {
      let type_ = match self_host_array_pop(stack) {
        Option::Some(value) => value
        Option::None => root
      }
      match type_ {
        SelfHostTypeExpr::NamedType(name, _) => if name == parameter {
          break true
        }
        SelfHostTypeExpr::QualifiedType(_, _, _, _) => {}
        SelfHostTypeExpr::ComputedType(target, _, _) => {
          stack.push(target)
        }
        SelfHostTypeExpr::ProductType(fields, _) => {
          let mut field_index = 0u32
          let _ = while field_index {
            current => if current < fields.length() {
              stack.push(fields[current])
              continue current + 1u32
            } else {
              break self_host_derive_unit()
            }
          }
        }
        SelfHostTypeExpr::AppliedType(base, arguments, _) => {
          stack.push(base)
          let mut argument_index = 0u32
          let _ = while argument_index {
            current => if current < arguments.length() {
              stack.push(arguments[current])
              continue current + 1u32
            } else {
              break self_host_derive_unit()
            }
          }
        }
        SelfHostTypeExpr::FunctionType(parameters, result, _) => {
          stack.push(result)
          let mut parameter_index = 0u32
          let _ = while parameter_index {
            current => if current < parameters.length() {
              stack.push(parameters[current])
              continue current + 1u32
            } else {
              break self_host_derive_unit()
            }
          }
        }
      }
      continue stack.length()
    } else {
      break false
    }
  }
}

fn self_host_derived_parameter_has_bound(
  bounds: Array<SelfHostTypeExpr>,
  trait_name: String,
) -> Bool {
  let mut bound_index = 0u32
  let _ = while bound_index {
    current => if current < bounds.length() {
      match bounds[current] {
        SelfHostTypeExpr::NamedType(name, _) => if name == trait_name {
          return true
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  false
}

fn self_host_derived_trait_type_parameters(
  parameters: Array<SelfHostTypeParameter>,
  field_types: Array<SelfHostTypeExpr>,
  trait_name: String,
  offset: U32,
) -> Array<SelfHostTypeParameter> {
  let result = []
  let mut parameter_index = 0u32
  let _ = while parameter_index {
    current_parameter => if current_parameter < parameters.length() {
      let parameter = self_host_derived_type_parameter_at(
        parameters,
        current_parameter,
      )
      let mut required = false
      let mut type_index = 0u32
      let _ = while type_index {
        current_type => if current_type < field_types.length() {
          if self_host_derived_type_mentions_parameter(
            field_types[current_type],
            parameter.name,
          ) {
            required = true
          }
          continue current_type + 1u32
        } else {
          break self_host_derive_unit()
        }
      }
      let bounds = []
      let mut bound_index = 0u32
      let _ = while bound_index {
        current => if current < parameter.bound_count() {
          bounds.push(parameter.bound_at(current))
          continue current + 1u32
        } else {
          break self_host_derive_unit()
        }
      }
      if required && !self_host_derived_parameter_has_bound(
        bounds,
        trait_name,
      ) {
        bounds.push(SelfHostTypeExpr::NamedType(trait_name, offset))
      }
      let derived = SelfHostTypeParameter::{
        name: parameter.name
        bounds: bounds
        offset: parameter.offset
      }
      result.push(derived)
      continue current_parameter + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_nominal_type(
  name: String,
  parameters: Array<SelfHostTypeParameter>,
  offset: U32,
) -> SelfHostTypeExpr {
  let base = SelfHostTypeExpr::NamedType(name, offset)
  if parameters.length() == 0u32 {
    return base
  }
  let arguments = []
  let mut parameter_index = 0u32
  let _ = while parameter_index {
    current => if current < parameters.length() {
      let parameter = self_host_derived_type_parameter_at(parameters, current)
      arguments.push(
        SelfHostTypeExpr::NamedType(parameter.name, parameter.offset),
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  SelfHostTypeExpr::AppliedType(base, arguments, offset)
}

fn self_host_derived_expression_block(
  expression: SelfHostExpr,
  offset: U32,
) -> SelfHostBlock {
  SelfHostBlock::{
    items: [self_host_expression_block_item(expression, offset)]
    offset: offset
  }
}

fn self_host_derived_comparison_impl(
  name: String,
  parameters: Array<SelfHostTypeParameter>,
  field_types: Array<SelfHostTypeExpr>,
  trait_name: String,
  method_name: String,
  expression: SelfHostExpr,
  offset: U32,
) -> SelfHostImplDeclaration {
  let target = self_host_derived_nominal_type(name, parameters, offset)
  let method = SelfHostFunctionDeclaration::{
    visibility: SelfHostDeclarationVisibility::ModuleVisible
    name: method_name
    name_offset: offset
    is_main: false
    type_parameters: []
    receiver: Option::Some(
      SelfHostReceiverParameter::{
        explicit_type: Option::None
        offset: offset
      },
    )
    parameters: [
      SelfHostFnParameter::{
        name: "right"
        type_: target
        offset: offset
      },
    ]
    return_type: SelfHostTypeExpr::NamedType("Bool", offset)
    body: self_host_derived_expression_block(expression, offset)
    offset: offset
  }
  SelfHostImplDeclaration::{
    foreign_: false
    type_parameters: self_host_derived_trait_type_parameters(
      parameters,
      field_types,
      "Eq",
      offset,
    )
    trait_type: Option::Some(
      SelfHostTypeExpr::NamedType(trait_name, offset),
    )
    target_type: target
    methods: [method]
    offset: offset
  }
}

fn self_host_derived_eq_impls(
  name: String,
  parameters: Array<SelfHostTypeParameter>,
  field_types: Array<SelfHostTypeExpr>,
  expression: SelfHostExpr,
  offset: U32,
) -> Array<SelfHostImplDeclaration> {
  let eq_impl = self_host_derived_comparison_impl(
    name,
    parameters,
    field_types,
    "Eq",
    "eq",
    expression,
    offset,
  )
  let ne_expression = SelfHostExpr::PrefixExpr(
    SelfHostPrefixOperator::LogicalNot,
    SelfHostExpr::BinaryExpr(
      SelfHostBinaryOperator::Equal,
      SelfHostExpr::NameExpr("self", offset),
      SelfHostExpr::NameExpr("right", offset),
      offset,
    ),
    offset,
  )
  let ne_impl = self_host_derived_comparison_impl(
    name,
    parameters,
    field_types,
    "Ne",
    "ne",
    ne_expression,
    offset,
  )
  [eq_impl, ne_impl]
}

fn self_host_derived_hash_call(
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostExpr {
  SelfHostExpr::CallExpr(
    SelfHostExpr::FieldExpr(value, "hash", offset),
    [],
    offset,
  )
}

fn self_host_derived_hash_eq_call(
  left: SelfHostExpr,
  right: SelfHostExpr,
  offset: U32,
) -> SelfHostExpr {
  SelfHostExpr::CallExpr(
    SelfHostExpr::FieldExpr(left, "hash_eq", offset),
    [right],
    offset,
  )
}

fn self_host_derived_hash_mix(
  state: SelfHostExpr,
  value: SelfHostExpr,
  offset: U32,
) -> SelfHostExpr {
  SelfHostExpr::BinaryExpr(
    SelfHostBinaryOperator::Multiply,
    SelfHostExpr::BinaryExpr(
      SelfHostBinaryOperator::BitXor,
      state,
      value,
      offset,
    ),
    SelfHostExpr::U64Expr(1099511628211u64, offset),
    offset,
  )
}

fn self_host_derived_struct_hash_expression(
  fields: Array<SelfHostStructField>,
  offset: U32,
) -> SelfHostExpr {
  let mut result = SelfHostExpr::U64Expr(14695981039346656037u64, offset)
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < fields.length() {
      let field = self_host_derived_struct_field_at(fields, current)
      result = self_host_derived_hash_mix(
        result,
        self_host_derived_hash_call(
          SelfHostExpr::FieldExpr(
            SelfHostExpr::NameExpr("self", offset),
            field.name,
            offset,
          ),
          offset,
        ),
        offset,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_struct_hash_eq_expression(
  fields: Array<SelfHostStructField>,
  offset: U32,
) -> SelfHostExpr {
  let mut result = SelfHostExpr::BoolExpr(true, offset)
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < fields.length() {
      let field = self_host_derived_struct_field_at(fields, current)
      let equal = self_host_derived_hash_eq_call(
        SelfHostExpr::FieldExpr(
          SelfHostExpr::NameExpr("self", offset),
          field.name,
          offset,
        ),
        SelfHostExpr::FieldExpr(
          SelfHostExpr::NameExpr("right", offset),
          field.name,
          offset,
        ),
        offset,
      )
      result = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::LogicalAnd,
        result,
        equal,
        offset,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_hash_eq_expression(
  left_names: Array<String>,
  right_names: Array<String>,
  offset: U32,
) -> SelfHostExpr {
  // Both generated pattern sides must have one name at each position.
  if left_names.length() != right_names.length() {
    unreachable()
  }
  let mut result = SelfHostExpr::BoolExpr(true, offset)
  let mut index = 0u32
  let _ = while index {
    current => if current < left_names.length() {
      result = SelfHostExpr::BinaryExpr(
        SelfHostBinaryOperator::LogicalAnd,
        result,
        self_host_derived_hash_eq_call(
          SelfHostExpr::NameExpr(left_names[current], offset),
          SelfHostExpr::NameExpr(right_names[current], offset),
          offset,
        ),
        offset,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  result
}

fn self_host_derived_enum_hash_expression(
  enum_name: String,
  variants: Array<SelfHostEnumVariant>,
  offset: U32,
) -> SelfHostExpr {
  let arms = []
  let mut index = 0u32
  let _ = while index {
    current => if current < variants.length() {
      let variant = self_host_derived_enum_variant_at(variants, current)
      let prefix = self_host_derived_single_index_name(
        "derive_hash_",
        current,
      ).concat("_")
      let (pattern, names) = self_host_derived_variant_pattern(
        enum_name,
        variant,
        prefix,
        offset,
      )
      let mut result = self_host_derived_hash_mix(
        SelfHostExpr::U64Expr(14695981039346656037u64, offset),
        SelfHostExpr::U64Expr(u32_into_u64(current), offset),
        offset,
      )
      let mut name_index = 0u32
      let _ = while name_index {
        current_name => if current_name < names.length() {
          result = self_host_derived_hash_mix(
            result,
            self_host_derived_hash_call(
              SelfHostExpr::NameExpr(names[current_name], offset),
              offset,
            ),
            offset,
          )
          continue current_name + 1u32
        } else {
          break self_host_derive_unit()
        }
      }
      arms.push(
        SelfHostPatternArm::{
          pattern: pattern
          guard_condition: Option::None
          body: result
          offset: offset
        },
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  SelfHostExpr::MatchExpr(
    SelfHostExpr::NameExpr("self", offset),
    arms,
    offset,
  )
}

fn self_host_derived_enum_hash_eq_expression(
  enum_name: String,
  variants: Array<SelfHostEnumVariant>,
  offset: U32,
) -> SelfHostExpr {
  let outer_arms = []
  let mut index = 0u32
  let _ = while index {
    current => if current < variants.length() {
      let variant = self_host_derived_enum_variant_at(variants, current)
      let left_prefix = self_host_derived_single_index_name(
        "derive_hash_eq_left_",
        current,
      ).concat("_")
      let right_prefix = self_host_derived_single_index_name(
        "derive_hash_eq_right_",
        current,
      ).concat("_")
      let (left_pattern, left_names) = self_host_derived_variant_pattern(
        enum_name,
        variant,
        left_prefix,
        offset,
      )
      let (right_pattern, right_names) = self_host_derived_variant_pattern(
        enum_name,
        variant,
        right_prefix,
        offset,
      )
      let inner_arms = []
      inner_arms.push(
        SelfHostPatternArm::{
          pattern: right_pattern
          guard_condition: Option::None
          body: self_host_derived_hash_eq_expression(
            left_names,
            right_names,
            offset,
          )
          offset: offset
        },
      )
      inner_arms.push(
        SelfHostPatternArm::{
          pattern: SelfHostPattern::WildcardPattern(offset)
          guard_condition: Option::None
          body: SelfHostExpr::BoolExpr(false, offset)
          offset: offset
        },
      )
      outer_arms.push(
        SelfHostPatternArm::{
          pattern: left_pattern
          guard_condition: Option::None
          body: SelfHostExpr::MatchExpr(
            SelfHostExpr::NameExpr("right", offset),
            inner_arms,
            offset,
          )
          offset: offset
        },
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  SelfHostExpr::MatchExpr(
    SelfHostExpr::NameExpr("self", offset),
    outer_arms,
    offset,
  )
}

fn self_host_derived_hash_impl(
  name: String,
  parameters: Array<SelfHostTypeParameter>,
  field_types: Array<SelfHostTypeExpr>,
  hash_expression: SelfHostExpr,
  hash_eq_expression: SelfHostExpr,
  offset: U32,
) -> SelfHostImplDeclaration {
  let target = self_host_derived_nominal_type(name, parameters, offset)
  let hash_method = SelfHostFunctionDeclaration::{
    visibility: SelfHostDeclarationVisibility::ModuleVisible
    name: "hash"
    name_offset: offset
    is_main: false
    type_parameters: []
    receiver: Option::Some(
      SelfHostReceiverParameter::{
        explicit_type: Option::None
        offset: offset
      },
    )
    parameters: []
    return_type: SelfHostTypeExpr::NamedType("U64", offset)
    body: self_host_derived_expression_block(hash_expression, offset)
    offset: offset
  }
  let hash_eq_method = SelfHostFunctionDeclaration::{
    visibility: SelfHostDeclarationVisibility::ModuleVisible
    name: "hash_eq"
    name_offset: offset
    is_main: false
    type_parameters: []
    receiver: Option::Some(
      SelfHostReceiverParameter::{
        explicit_type: Option::None
        offset: offset
      },
    )
    parameters: [
      SelfHostFnParameter::{
        name: "right"
        type_: target
        offset: offset
      },
    ]
    return_type: SelfHostTypeExpr::NamedType("Bool", offset)
    body: self_host_derived_expression_block(hash_eq_expression, offset)
    offset: offset
  }
  SelfHostImplDeclaration::{
    foreign_: false
    type_parameters: self_host_derived_trait_type_parameters(
      parameters,
      field_types,
      "Hash",
      offset,
    )
    trait_type: Option::Some(SelfHostTypeExpr::NamedType("Hash", offset))
    target_type: target
    methods: [hash_method, hash_eq_method]
    offset: offset
  }
}

fn self_host_derived_struct_field_types(
  value: SelfHostStructDeclaration,
) -> Array<SelfHostTypeExpr> {
  let types = []
  let mut field_index = 0u32
  let _ = while field_index {
    current => if current < value.fields.length() {
      types.push(
        self_host_derived_struct_field_at(value.fields, current).type_,
      )
      continue current + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  types
}

fn self_host_derived_enum_field_types(
  value: SelfHostEnumDeclaration,
) -> Array<SelfHostTypeExpr> {
  let types = []
  let mut variant_index = 0u32
  let _ = while variant_index {
    current_variant => if current_variant < value.variants.length() {
      match self_host_derived_enum_variant_at(value.variants, current_variant) {
        SelfHostEnumVariant::UnitVariant(_, _, _) => {}
        SelfHostEnumVariant::TupleVariant(_, payload, _, _) => {
          let mut payload_index = 0u32
          let _ = while payload_index {
            current_payload => if current_payload < payload.length() {
              types.push(payload[current_payload])
              continue current_payload + 1u32
            } else {
              break self_host_derive_unit()
            }
          }
        }
        SelfHostEnumVariant::StructVariant(_, fields, _, _) => {
          let mut field_index = 0u32
          let _ = while field_index {
            current_field => if current_field < fields.length() {
              types.push(
                self_host_derived_struct_field_at(fields, current_field).type_,
              )
              continue current_field + 1u32
            } else {
              break self_host_derive_unit()
            }
          }
        }
      }
      continue current_variant + 1u32
    } else {
      break self_host_derive_unit()
    }
  }
  types
}

fn self_host_derived_struct_eq_impls(
  value: SelfHostStructDeclaration,
  offset: U32,
) -> Array<SelfHostImplDeclaration> {
  self_host_derived_eq_impls(
    value.name,
    value.type_parameters,
    self_host_derived_struct_field_types(value),
    self_host_derived_struct_eq_expression(value.fields, offset),
    offset,
  )
}

fn self_host_derived_enum_eq_impls(
  value: SelfHostEnumDeclaration,
  offset: U32,
) -> Array<SelfHostImplDeclaration> {
  self_host_derived_eq_impls(
    value.name,
    value.type_parameters,
    self_host_derived_enum_field_types(value),
    self_host_derived_enum_eq_expression(value.name, value.variants, offset),
    offset,
  )
}

fn self_host_derived_struct_hash_impl(
  value: SelfHostStructDeclaration,
  offset: U32,
) -> SelfHostImplDeclaration {
  self_host_derived_hash_impl(
    value.name,
    value.type_parameters,
    self_host_derived_struct_field_types(value),
    self_host_derived_struct_hash_expression(value.fields, offset),
    self_host_derived_struct_hash_eq_expression(value.fields, offset),
    offset,
  )
}

fn self_host_derived_enum_hash_impl(
  value: SelfHostEnumDeclaration,
  offset: U32,
) -> SelfHostImplDeclaration {
  self_host_derived_hash_impl(
    value.name,
    value.type_parameters,
    self_host_derived_enum_field_types(value),
    self_host_derived_enum_hash_expression(value.name, value.variants, offset),
    self_host_derived_enum_hash_eq_expression(
      value.name,
      value.variants,
      offset,
    ),
    offset,
  )
}

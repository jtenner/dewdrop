fn self_host_product_pattern_test_inference(source: Bytes) -> SelfHostBasicInferredBody {
  let collected = self_host_collect_bytes(140u64, source)
  assert(collected.diagnostics.length() == 0u32, "product pattern source must collect")
  let resolved = self_host_resolve_module_types(collected)
  assert(resolved.diagnostics.length() == 0u32, "product pattern types must resolve")
  let names = self_host_resolve_module_names(collected)
  assert(names.diagnostics.length() == 0u32, "product pattern names must resolve")
  self_host_infer_basic_module_bodies(collected, resolved, names).bodies[0u32]
}

test "short unit constructors retain exact selection during lowering" {
  let lowering = self_host_physical_test_lowering(b"enum Choice {\n Missing\n}\npub fn run() -> Choice {\n Missing\n}\n")
  let module_ = lowering.modules[0u32]
  let mut found = 0u32
  for expression in module_.expressions {
    match expression.selection {
      SelfHostBasicExpressionSelection::VariantConstructionBasicExpressionSelection(variant, 2u32, _) => {
        assert(expression.kind is SelfHostPlannedExpressionKind::PlannedConstruct(_, _, _), "short unit constructor must not become poison")
        assert(variant == lowering.collected.modules.at(0u32).variants[0u32].id, "short constructor keeps its declaration")
        found = found + 1u32
      }
      _ => {}
    }
  }
  assert(found == 1u32, "one exact short unit constructor")
}

test "product pattern inference carries outer payload types into nested bindings" {
  let body = self_host_product_pattern_test_inference(b"enum Maybe<t> {\n None\n Some(t)\n}\nfn read(value: Maybe<(I32, I64)>) -> I64 {\n match value {\n Some((left, right)) => right\n None => 0i64\n }\n}\n")
  assert(body.diagnostics.length() == 0u32, "nested product has no inference diagnostics")
  assert(body.local_types.length() == 3u32, "nested product owns both binding locals")
}

test "product pattern arity errors retain expected and actual field counts" {
  let body = self_host_product_pattern_test_inference(b"fn read(value: (I32, I64)) -> I32 {\n match value {\n (left, middle, right) => left\n }\n}\n")
  let mut found = false
  for diagnostic in body.diagnostics {
    if diagnostic is SelfHostBodyInferenceDiagnostic::PatternPayloadArityMismatch(_, 2u32, 3u32, _) {
      found = true
    }
  }
  assert(found, "product arity error must retain expected 2 and actual 3")
}

test "product pattern cannot destructure a scalar" {
  let body = self_host_product_pattern_test_inference(b"fn read(value: I32) -> I32 {\n match value {\n (left, right) => left\n }\n}\n")
  let mut found = false
  for diagnostic in body.diagnostics {
    if diagnostic is SelfHostBodyInferenceDiagnostic::InvalidPatternConstructor(_, _) {
      found = true
    }
  }
  assert(found, "scalar product pattern must report InvalidPatternConstructor")
}

test "imported short constructors carry nested product payload types" {
  let fixture = self_host_imported_semantics_fixture(
    b"open app.library\npub fn run(value: Choice) -> I64 {\n match value {\n Present((left, right)) => right\n Missing => 0i64\n }\n}\n",
    b"pub enum Choice {\n Present((I32, I64))\n Missing\n}\n",
  )
  let lowering = self_host_plan_program_lowering(fixture.frozen)
  assert(self_host_validate_program_lowering(lowering) is Option::None, "imported nested product lowering")
  let module_ = lowering.modules[0u32]
  let mut products = 0u32
  let mut constructors = 0u32
  for pattern in module_.patterns {
    if pattern.source is SelfHostHirPattern::ProductPattern(_, _) {
      products = products + 1u32
      match pattern.shape {
        SelfHostPlannedValueShape::ProductPlannedValueShape(fields) => {
          assert(fields.length() == 2u32, "imported product field count")
          assert(fields[0u32] is SelfHostPlannedValueShape::I32PlannedValueShape, "imported first field I32")
          assert(fields[1u32] is SelfHostPlannedValueShape::I64PlannedValueShape, "imported second field I64")
        }
        _ => assert(false, "imported payload must retain product shape")
      }
    }
    match pattern.selected_constructor {
      SelfHostBasicPatternConstructor::SelectedBasicPatternConstructor(declaration, _, _) => {
        assert(self_host_semantic_id_module(declaration) == 2601u64, "constructor belongs to imported library")
        constructors = constructors + 1u32
      }
      _ => {}
    }
  }
  assert(products == 1u32 && constructors == 2u32, "one product and two exact imported constructors")
}

// Emission reads one frozen carrier certificate. It cannot reconstruct missing
// or contradictory evidence from source spelling, neighboring nodes, or types.
fn self_host_linked_planned_expression_carrier(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32) -> SelfHostWasmBodyCarrier {
  let plan = self_host_physical_scratch_body(canonical, module_, body, expression, 0u32)
  if plan.specialization != specialization {
    self_host_expression_read_failure(plan, expression, 106u32,
      u32_into_u64(specialization), u32_into_u64(plan.specialization), 4u64)
  }
  let value = match self_host_body_plan_expression(plan, expression) {
    Some(value) => value
    None => self_host_expression_read_failure(plan, expression, 610u32, 1u64, 0u64, 1u64)
  }
  match value.carrier {
    UnresolvedBodyCarrier,
    ConflictingBodyCarrier => self_host_expression_read_failure(plan,
      expression, 610u32, 1u64, self_host_body_carrier_code(value.carrier), 2u64)
    _ => {}
  }
  if !self_host_body_carrier_equal(value.value.carrier, value.carrier) {
    self_host_expression_read_failure(plan, expression, 712u32,
      self_host_body_carrier_code(value.value.carrier), self_host_body_carrier_code(value.carrier), 3u64)
  }
  if value.carrier is NeverBodyCarrier {
    if module_.expressions[expression].flow.falls_through {
      self_host_expression_read_failure(plan, expression, 611u32, 0u64, 1u64, 5u64)
    }
  }
  value.carrier
}

fn self_host_linked_planned_expression_shape(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32) -> SelfHostPlannedValueShape {
  self_host_body_carrier_shape(self_host_linked_planned_expression_carrier(canonical, link, module_, body, specialization, expression))
}

fn self_host_linked_planned_expression_emits_value(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32) -> Bool {
  let carrier = self_host_linked_planned_expression_carrier(canonical, link, module_, body, specialization, expression)
  !(carrier is UnitBodyCarrier) && !(carrier is NeverBodyCarrier)
}

fn self_host_expression_read_failure(plan: SelfHostPlannedPhysicalBodyCarrierPlan, expression: U32, code: U32, expected: U64, actual: U64, detail: U64) -> Never {
  self_host_assert_compiler_invariant_with_failure(false, {
    code: code
    phase: 7u32
    module_id: plan.module_id
    declaration: plan.declaration
    body: plan.body
    expression: expression
    expected: expected
    actual: actual
    detail: detail
  }, "emission requires complete frozen expression evidence")
  unreachable()
}

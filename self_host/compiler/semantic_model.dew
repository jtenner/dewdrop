pub enum SelfHostBindingSpace {
  ModuleType
  ModuleTrait
  ModuleValue
  TraitMethod
  ImplMethod
  ForeignLibraryMember
  StructField
  EnumVariant
  VariantField
  GenericParameter
  Parameter
}

pub struct SelfHostDuplicateNameDiagnostic {
  space: SelfHostBindingSpace
  name: U32
  first: U64
  duplicate: U64
  first_file: U64
  duplicate_file: U64
  first_offset: U32
  duplicate_offset: U32
}

pub struct SelfHostDuplicateTestIdentityDiagnostic {
  file: U64
  display_name: Bytes
  first_offset: U32
  duplicate_offset: U32
}

pub enum SelfHostCollectionDiagnostic {
  ParseDiagnostic(U64, SelfHostParseDiagnostic, U32, U32, U32, String)
  DuplicateName(SelfHostDuplicateNameDiagnostic)
  DuplicateTestIdentity(SelfHostDuplicateTestIdentityDiagnostic)
  InvalidExpectedTestTrap(U64, Bytes, U32)
  TestDeclarationOutsideTestFile(U64, U32)
  ValueBindingArenaMismatch(U32, U32, U32)
  UnknownDerivedTrait(String, U64, U32)
  DuplicateDerivedTrait(String, U64, U32, U32)
  EmptyForeignLogicalName(U64, U32)
  EmptyForeignExportName(U64, U32)
}

pub struct SelfHostValueBindingCandidate {
  declaration: U64

open dew.std.array
open dew.std.bytes
open dew.std.map
open dew.std.option
open dew.std.string

fn self_host_semantic_string_equals(
  left: String,
  right: String,
) -> Bool {
  left.equals(right)
}

fn self_host_semantic_u64_at(values: Array<U64>, index: U32) -> U64 {
  array_get_unchecked(values, index)
}

pub enum SelfHostCollectedDeclKind {
  BuiltinDecl
  LetDecl
  TraitDecl
  FunctionDecl
  TestDecl
  ImplDecl
  ForeignTypeDecl
  ForeignLibraryDecl
  StructDecl
  EnumDecl
  TypeAliasDecl
}

pub enum SelfHostCollectedMethodKind {
  TraitMethodDecl
  ImplMethodDecl
  ForeignLibraryMemberDecl
}

pub enum SelfHostCollectedVariantKind {
  UnitVariantDecl
  TupleVariantDecl
  StructVariantDecl
}

pub enum SelfHostCollectedParameterKind {
  ReceiverParameterDecl
  ValueParameterDecl
}

pub enum SelfHostSemanticVisibility {
  ModuleVisible
  Public
}

fn self_host_semantic_visibility(
  visibility: SelfHostDeclarationVisibility,
) -> SelfHostSemanticVisibility {
  match visibility {
    SelfHostDeclarationVisibility::ModuleVisible => SelfHostSemanticVisibility::ModuleVisible
    SelfHostDeclarationVisibility::Public => SelfHostSemanticVisibility::Public
  }
}

pub struct SelfHostCollectedDeclaration {
  id: U64
  kind: SelfHostCollectedDeclKind
  name: U32
  visibility: SelfHostSemanticVisibility
  offset: U32
}

fn self_host_collected_declaration_identity(
  declaration: SelfHostCollectedDeclaration,
) -> SelfHostCollectedDeclaration {
  SelfHostCollectedDeclaration::{
    id: declaration.id
    kind: declaration.kind
    name: declaration.name
    visibility: declaration.visibility
    offset: declaration.offset
  }
}

pub struct SelfHostCollectedMethod {
  id: U64
  parent: U64
  kind: SelfHostCollectedMethodKind
  name: U32
  visibility: SelfHostSemanticVisibility
  offset: U32
}

fn self_host_collected_method_identity(
  method: SelfHostCollectedMethod,
) -> SelfHostCollectedMethod {
  SelfHostCollectedMethod::{
    id: method.id
    parent: method.parent
    kind: method.kind
    name: method.name
    visibility: method.visibility
    offset: method.offset
  }
}

pub enum SelfHostCollectedDeclarationReference {
  TopLevel(SelfHostCollectedDeclaration)
  Method(SelfHostCollectedMethod)
}

pub struct SelfHostCollectedField {
  id: U64
  declaration: U64
  variant: Option<U64>
  mutable_: Bool
  name: U32
  type_: U32
  offset: U32

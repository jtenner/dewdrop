test "raw array getter function values retain their specialized element" {
  self_host_test_raw_struct_module(
    b"pub struct Slots<t> {}\nbuiltin create<t>(length: U32, value: t) -> Slots<t> = \"array.new\"\nbuiltin read<t>(value: Slots<t>, index: U32) -> t = \"array.get\"\nfn reader() -> fn(Slots<I64>, U32) -> I64 {\n  read\n}\npub fn run() -> I64 {\n  let values = create(1u32, 42i64)\n  let operation = reader()\n  operation(values, 0u32)\n}\n",
  )
}

fn self_host_raw_array_reference_mutation(mutation: U32) -> Unit {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub struct Slots<t> {}\nbuiltin read<t>(values: Slots<t>, index: U32) -> t = \"array.get\"\npub fn factory() -> fn(Slots<I64>, U32) -> I64 {\n  read\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  assert(link.diagnostics.length() == 0u32, "getter fixture links before mutation")
  let module_ = link.fragments.modules[0u32]
  let mut checked = false
  for function_ in module_.functions {
    match function_.kind {
      SelfHostPlannedWasmFunctionKind::PlannedWasmOutlinedHeapFunction(SelfHostRawHeapInstruction::RawArrayGetInstruction(recipe)) => if !function_.elided {
        let _ = self_host_verify_outlined_raw_array_get(link, module_, function_, recipe)
        if mutation == 0u32 {
          module_.function_value_types[function_.parameters.start + 1u32] = SelfHostPlannedWasmValueType::WasmI64Value
        } else if mutation == 1u32 {
          module_.function_value_types[function_.results.start] = SelfHostPlannedWasmValueType::WasmI32Value
        }
        let changed = SelfHostRawArrayGetRecipe::{
          opcode: recipe.opcode
          element_shape: if mutation == 2u32 {
            SelfHostPlannedValueShape::ErrorPlannedValueShape
          } else {
            recipe.element_shape
          }
        }
        let _ = self_host_verify_outlined_raw_array_get(link, module_, function_, changed)
        checked = true
      }
      _ => {}
    }
  }
  assert(checked, "fixture has an emitted typed getter wrapper")
}

test "raw array getter signature is valid before mutation" {
  self_host_raw_array_reference_mutation(3u32)
}

test "ABI-705 raw array getter index retains I32" expect_trap "unreachable" {
  self_host_raw_array_reference_mutation(0u32)
}

test "ABI-709 raw array getter result retains I64" expect_trap "unreachable" {
  self_host_raw_array_reference_mutation(1u32)
}

test "SPC-301 raw array getter shape cannot become Error" expect_trap "unreachable" {
  self_host_raw_array_reference_mutation(2u32)
}

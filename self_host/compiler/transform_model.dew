// Compile-time execution is local to the compiler. No host calls are exposed.
open dew.std.map
open dew.std.array
open dew.std.string
open dew.std.bytes
open dew.std.bytes_builder
open dew.std.string_builder

pub enum CtValue {
  Empty
  NullValue
  DefaultValue
  TraitObject(CtTraitObjectValue)
  RawArray(CtRawStorage)
  Vector(U64, U64)
  TextChunks(CtValue, Bytes)
  TextReference(CtValue)
  ReferenceView(CtValue, CtFieldNames)
  Floating(U64, String)
  Number(U64, String)
  Boolean(Bool)
  Text(String)
  ByteText(Bytes)
  Sequence(Array<CtValue>)
  Record(String, CtRecordFields)
  Variant(String, Array<CtValue>)
  Function(CtCallTarget, Array<CtValue>, CtFunctionIdentity)
  Closure(U32, String, Array<SelfHostFnParameter>, SelfHostBlock, CtEnvironment, String)
}

pub struct CtBinding {
  name: String
  mut value: CtValue
  mutable_: Bool
}

pub struct CtAnnotation {
  arguments: Array<SelfHostExpr>
  arguments_source: String
  arguments_offset: U32
  name: String
  offset: U32
  target: U32
  line_no: U64
  col_no: U64
}

pub struct CtFunction {
  declaration: SelfHostFunctionDeclaration
  transform_: Bool
  annotation_start: U32
  annotation_count: U32
  start: U32
  end: U32
}

pub struct CtFile {
  module_index: U32
  original: SelfHostManifestFile
  clean: Bytes
  annotations: Array<CtAnnotation>
  functions: Array<CtFunction>
  declarations: Array<SelfHostDeclaration>
}

pub struct CtPlan {
  manifest: SelfHostProgramManifest
  files: Array<CtFile>
  site_files: Map<U32, Map<String, U32>>
  mut next_site_file: U32
  active: Bool
  mut worker_ready: Bool
  mut worker_preamble: Bool
  mut error: String
  mut validation_stop: String
  mut raw_array_declarations: Map<U64, Bool>
  scalar_proofs: Map<U64, Bytes>
  pattern_proofs: Map<U64, String>
  references: Map<U64, CtFunctionReferenceProof>
  frames: Map<String, CtExecutionFrame>
  trait_objects: Map<U64, CtTraitObjectProof>
  trait_dictionaries: Map<String, CtTraitObjectProof>
  adapter_names: Map<U32, Map<String, Bool>>
  validation_targets: Map<String, CtSignatureTarget>
  body_errors: Map<U64, String>
  signature_calls: Map<U32, Map<U32, CtSignatureTarget>>
  calls: Map<U64, CtCallTarget>
  scalar_types: Map<U64, String>
  array_literals: Map<U64, CtArrayLayout>
  array_layouts: Map<String, CtArrayLayout>
  raw_layouts: Map<String, CtRawLayout>
  reports: Array<CtTransformReport>
  expression_types: Map<String, Array<CtExpressionType>>
  reflection_errors: Array<String>
  annotated_functions: Map<U64, Bool>
  type_names: Array<CtTypeName>
  mut source_lookup: Option<CtSourceIndex>
}

pub struct CtMachine {
  plan: CtPlan
  mut error: String
  mut steps: U32
  mut depth: U32
  mut allocated: U32
  mut flow: U32
  mut result: CtValue
  functions: Map<String, CtCallTarget>
  imports: Map<String, String>
  globals: Map<String, CtValue>
  initializing: Map<String, Bool>
  mut file_path: String
  mut frame: String
  mut render_source: CtValue
  mut render_replacement: String
  mut memory: Option<WasmArray<U8>>
  bytecode_enabled: Bool
  bytecode: Map<String, Map<U64, Option<CtBytecodeFunction>>>
  mut bytecode_compile_work: U32
  mut bytecode_bytes_left: U32
}

fn ct_empty() -> CtValue {
  CtValue::Empty
}

fn ct_machine(plan: CtPlan) -> CtMachine {
  ct_machine_with_bytecode(plan, true)
}

fn ct_machine_with_bytecode(plan: CtPlan, enabled: Bool) -> CtMachine {
  {
    plan: plan
    error: ""
    steps: 100000u32
    depth: 0u32
    allocated: 0u32
    flow: 0u32
    result: CtValue::Empty
    functions: map_empty::<String, CtCallTarget>()
    imports: map_empty::<String, String>()
    globals: map_empty::<String, CtValue>()
    initializing: map_empty::<String, Bool>()
    file_path: ""
    frame: ""
    render_source: CtValue::Empty
    render_replacement: ""
    memory: None
    bytecode_enabled: enabled
    bytecode: map_empty::<String, Map<U64, Option<CtBytecodeFunction>>>()
    bytecode_compile_work: 1048576u32
    bytecode_bytes_left: 8388608u32
  }
}

fn ct_fail(machine: CtMachine, message: String) -> CtValue {
  if machine.error.byte_length() == 0u32 {
    machine.error = message
  }
  CtValue::Empty
}

fn ct_charge(machine: CtMachine, amount: U32) -> Bool {
  if machine.error.byte_length() != 0u32 {
    return false
  }
  if machine.steps == 0u32 {
    let _ = ct_fail(machine, "transform work limit exceeded")
    return false
  }
  machine.steps = machine.steps - 1u32
  if amount > 4194304u32 - machine.allocated {
    let _ = ct_fail(machine, "transform allocation limit exceeded")
    return false
  }
  machine.allocated = machine.allocated + amount
  true
}

fn ct_string(machine: CtMachine, value: CtValue) -> String {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return ""
  }
  match value {
    Text(value) => value
    TextReference(value) => ct_reference_string(machine, value)
    _ => {
      let _ = ct_fail(machine, "expected String in transform")
      ""
    }
  }
}

fn ct_truth(machine: CtMachine, value: CtValue) -> Bool {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return false
  }
  match value {
    Boolean(value) => value
    Number(bits, "Bool") => bits != 0u64
    DefaultValue => false
    _ => {
      let _ = ct_fail(machine, "expected Bool in transform")
      false
    }
  }
}

fn ct_binding(name: String, value: CtValue) -> CtBinding {
  {
    name: name
    value: value
    mutable_: false
  }
}

fn ct_lookup(machine: CtMachine, fields: CtRecordFields, name: String) -> Option<CtBinding> {
  match fields.index {
    Some(index) => return index.get(name)
    None => {
    }
  }
  let values = fields.values
  let mut i = values.length()
  let _ = while 0u32 {
    _ => {
      if i == 0u32 {
        break ()
      }
      i = i - 1u32
      let item = values[i]
      if item.name == name {
        return Some(item)
      }
      continue 0u32
    }
  }
  None
}

fn ct_field(machine: CtMachine, value: CtValue, name: String) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  match value {
    ReferenceView(base, names) => {
      match ct_field_position(names, name) {
        Some(index) => return ct_raw_struct_get(machine, base, index)
        None => {
        }
      }
      ct_fail(machine, "unknown checked raw reference field: ".concat(name))
    }
    Record(key, values) => match ct_lookup(machine, values, name) {
      Some(binding) => binding.value
      None => ct_fail(machine, "unknown transform field ".concat(name).concat(" in ").concat(key))
    }
    _ => ct_fail(machine, "expected record in transform")
  }
}

fn ct_part(source: Bytes, start: U32, end: U32) -> String {
  source.slice(start, end).to_string()
}

fn ct_blank(source: Bytes, start: U32, end: U32) -> Bytes {
  let builder = BytesBuilder::new()
  let _ = while start {
    i if i < end => {
      let byte = source.byte_at(i)
      builder.append_byte(if byte == 10u8 || byte == 13u8 {
        byte
      } else {
        32u8
      })
      continue i + 1u32
    }
    _ => break ()
  }
  builder.finish()
}

fn ct_number(value: U64, kind: String) -> CtValue {
  let bits = if kind == "I8" || kind == "U8" {
    value & 255u64
  } else if kind == "I16" || kind == "U16" {
    value & 65535u64
  } else if kind == "I32" || kind == "U32" {
    value & 4294967295u64
  } else {
    value
  }
  CtValue::Number(bits, kind)
}

fn ct_signed(value: U64, kind: String) -> I64 {
  let result = ct_u64_to_i64(value)
  if kind == "I8" {
    (result << 56i64) >> 56i64
  } else if kind == "I16" {
    (result << 48i64) >> 48i64
  } else if kind == "I32" {
    (result << 32i64) >> 32i64
  } else {
    result
  }
}

fn ct_u64_to_i64(value: U64) -> I64 {
  unsafe_bitcast(value)
}

fn ct_i64_to_u64(value: I64) -> U64 {
  unsafe_bitcast(value)
}

pub struct CtRawStorage {
  values: Array<CtValue>
  mut default_kind: String
}

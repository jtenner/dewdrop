pub struct SelfHostRawRefCastRecipe {
  opcode: Bytes
  target: SelfHostRawHeapOwner
}

pub struct SelfHostRawArrayGetRecipe {
  opcode: Bytes
  element_shape: SelfHostPlannedValueShape
}

pub enum SelfHostRawHeapInstruction {
  RawStructGetInstruction(SelfHostRawStructGetRecipe)
  RawRefCastInstruction(SelfHostRawRefCastRecipe)
  RawArrayGetInstruction(SelfHostRawArrayGetRecipe)
}

impl SelfHostRawHeapInstruction {
  fn opcode(self) -> Bytes {
    match self {
      RawStructGetInstruction(recipe) => recipe.opcode
      RawRefCastInstruction(recipe) => recipe.opcode
      RawArrayGetInstruction(recipe) => recipe.opcode
    }
  }
}

enum SelfHostRawStructHeap {
  PrimitiveStructHeap(U32)
  DeclaredStructHeap(U32, U64, SelfHostPlannedModuleWasmGCFragments, SelfHostPlannedWasmPhysicalType)
}

struct SelfHostRawRefCastLayout {
  type_index: U32
  nominal_owner: U64
}

fn self_host_raw_struct_heap(link: SelfHostPlannedProgramWasmGCLink, owner: SelfHostRawHeapOwner) -> Result<SelfHostRawStructHeap, U32> {
  match owner {
    PrimitiveRawHeapOwner(primitive) => {
      let offset = match primitive {
        StringType => 1u32
        BytesType => 2u32
        StringViewType => 3u32
        StringBuilderType => 4u32
        BytesBuilderType => 5u32
        _ => return Err(2u32)
      }
      Ok(PrimitiveStructHeap(self_host_linked_text_runtime_base(link) + offset))
    }
    DeclaredRawHeapOwner(declaration) => {
      let mut selected = None
      for linked in link.types {
        if linked.module_index >= link.fragments.modules.length() {
          return Err(5u32)
        }
        let module_ = link.fragments.modules[linked.module_index]
        if linked.fragment_index >= module_.physical_types.length() {
          return Err(5u32)
        }
        let type_ = module_.physical_types[linked.fragment_index]
        match type_.kind {
          PlannedWasmStructType(candidate) => if candidate == declaration {
            if selected is Some(_) {
              return Err(6u32)
            }
            selected = Some(DeclaredStructHeap(linked.type_index, declaration, module_, type_))
          }
          _ => {}
        }
      }
      match selected {
        Some(value) => Ok(value)
        None => Err(10u32)
      }
    }
    InvalidRawHeapOwner(reason) => Err(20u32 + reason)
  }
}

fn self_host_raw_ref_cast_opcode(name: Bytes) -> Bool {
  name.starts_with(b"ref.cast")
}

fn self_host_raw_ref_cast_recipe(module_: SelfHostPlannedModuleLowering, callable: SelfHostPlannedCallable, opcode: Bytes) -> SelfHostRawRefCastRecipe {
  {
    opcode: opcode
    target: if callable.has_receiver || callable.parameters.length != 1u32 {
      InvalidRawHeapOwner(1u32)
    } else if callable.result_type < module_.resolved_types.types.length() &&
      module_.resolved_types.types[callable.result_type] is AppliedType(_, _) {
      // A declaration ID alone cannot certify a specialized generic heap.
      InvalidRawHeapOwner(3u32)
    } else {
      self_host_raw_heap_owner(module_, callable.result_type)
    }
  }
}

fn self_host_linked_raw_heap_instruction(link: SelfHostPlannedProgramWasmGCLink, declaration: U64) -> Option<SelfHostRawHeapInstruction> {
  let owner = match link.fragments.specialization.lowering.index.declaration_owner(declaration) {
    Some(value) => value
    None => return None
  }
  if owner >= link.fragments.modules.length() {
    return None
  }
  let module_ = link.fragments.modules[owner]
  let index = self_host_fragment_function_index(module_, declaration)
  if index >= module_.functions.length() {
    return None
  }
  let function_ = module_.functions[index]
  if function_.declaration != declaration {
    return None
  }
  match function_.kind {
    PlannedWasmInlineHeapFunction(instruction),
    PlannedWasmOutlinedHeapFunction(instruction) => Some(instruction)
    _ => None
  }
}

fn self_host_linked_raw_ref_cast_recipe(link: SelfHostPlannedProgramWasmGCLink, declaration: U64) -> Option<SelfHostRawRefCastRecipe> {
  match self_host_linked_raw_heap_instruction(link, declaration) {
    Some(RawRefCastInstruction(recipe)) => Some(recipe)
    _ => None
  }
}

fn self_host_raw_ref_cast_layout(link: SelfHostPlannedProgramWasmGCLink, recipe: SelfHostRawRefCastRecipe) -> Result<SelfHostRawRefCastLayout, U32> {
  if !recipe.opcode.equals(b"ref.cast") {
    return Err(40u32)
  }
  let heap = match self_host_raw_struct_heap(link, recipe.target) {
    Ok(value) => value
    Err(reason) => return Err(50u32 + reason)
  }
  match heap {
    PrimitiveStructHeap(index) => Ok({
      type_index: index
      nominal_owner: 0u64
    })
    DeclaredStructHeap(index, declaration, _, _) => Ok({
      type_index: index
      nominal_owner: declaration
    })
  }
}

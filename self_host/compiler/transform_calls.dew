open dew.std.map

pub enum CtCallTarget {
  Constant(CtCheckedConstant)
  Framed(CtCallTarget, String)
  Source(U32, String, SelfHostFunctionDeclaration, String)
  Global(U32, String, SelfHostLetDeclaration)
  Intrinsic(SelfHostBuiltinDeclaration, String)
  FunctionValue(String)
  Unsupported
  Constructor(String)
  UnitConstructor(String)
  ScalarResult(String)
}

fn ct_call_key(mi: U32, path: String, offset: U32) -> String {
  let out = StringBuilder::new()
  out.append_u32(mi)
  out.append(":")
  out.append_u32(offset)
  out.append(":")
  out.append(path)
  out.finish()
}

fn ct_lookup_call(machine: CtMachine, mi: U32, offset: U32) -> Option<CtCallTarget> {
  if machine.error.byte_length() != 0u32 || machine.flow != 0u32 {
    return None
  }
  let key = ct_site_key(machine.plan, mi, machine.file_path, offset)
  match machine.plan.frames.get(machine.frame) {
    Some(frame) => match frame.calls.get(key) {
      Some(value) => return Some(value)
      None => {}
    }
    None => {}
  }
  machine.plan.calls.get(key)
}

fn ct_lookup_scalar_type(machine: CtMachine, mi: U32, offset: U32) -> Option<String> {
  if machine.error.byte_length() != 0u32 || machine.flow != 0u32 {
    return None
  }
  let key = ct_site_key(machine.plan, mi, machine.file_path, offset)
  match machine.plan.frames.get(machine.frame) {
    Some(frame) => match frame.scalar_types.get(key) {
      Some(value) => return Some(value)
      None => {}
    }
    None => {}
  }
  machine.plan.scalar_types.get(key)
}

fn ct_source_call_frame(machine: CtMachine, mi: U32, path: String, function: SelfHostFunctionDeclaration, args: Array<CtValue>, frame: String) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  if !ct_charge(machine, 32u32 + args.length() * 16u32) {
    return CtValue::Empty
  }
  let receivers = if function.receiver is Some(_) {
    1u32
  } else {
    0u32
  }
  if args.length() != function.parameters.length() + receivers {
    return ct_fail(machine, "checked compile-time argument count mismatch")
  }
  let annotation_key = ct_site_key(machine.plan, mi, path, function.offset)
  if machine.plan.annotated_functions.get(annotation_key) is Some(_) {
    return ct_fail(machine, "annotated functions cannot execute at compile time")
  }
  let previous = machine.file_path
  let previous_frame = machine.frame
  machine.frame = frame
  machine.file_path = path
  let value = ct_source_body(machine, mi, function, args)
  machine.file_path = previous
  machine.frame = previous_frame
  if machine.flow == 1u32 {
    machine.flow = 0u32
    return machine.result
  }
  if machine.flow != 0u32 {
    return ct_fail(machine, "loop control escaped a compile-time function")
  }
  value
}

fn ct_checked_call(machine: CtMachine, mi: U32, offset: U32, callee: SelfHostExpr, args: Array<SelfHostExpr>, env: CtEnvironment, types: Array<SelfHostTypeExpr>) -> CtValue {
  let _ = types
  let selected = ct_unframe_option(ct_lookup_call(machine, mi, offset))
  match selected.target {
    Some(Constant(value)) => ct_checked_constant(machine, value)
    Some(Source(target_mi, path, function, kind)) => {
      let values = array_new::<CtValue>()
      if function.receiver is Some(_) {
        match callee {
          FieldExpr(owner, _, _) => values.push(ct_eval(machine, mi, owner, env))
          _ => return ct_fail(machine, "checked receiver call requires a receiver expression")
        }
      }
      for argument in args {
        if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
          return CtValue::Empty
        }
        values.push(ct_eval(machine, mi, argument, env))
      }
      ct_intrinsic_result(machine, ct_source_call_frame(machine, target_mi, path, function, values, selected.frame), kind)
    }
    Some(Intrinsic(builtin_, kind)) => {
      let result = ct_typed_intrinsic(machine, builtin_, ct_eval_values(machine, mi, args, env), kind)
      ct_intrinsic_result(machine, result, kind)
    }
    Some(Constructor(key)) => CtValue::Variant(key, ct_eval_values(machine, mi, args, env))
    Some(FunctionValue(kind)) => {
      let closure = ct_eval(machine, mi, callee, env)
      let values = ct_eval_values(machine, mi, args, env)
      ct_intrinsic_result(machine, ct_closure_call(machine, closure, values), kind)
    }
    Some(_) => ct_fail(machine, "checked call requires unsupported compile-time dispatch")
    None => ct_call(machine, ct_path(machine, mi, callee), ct_eval_values(machine, mi, args, env))
  }
}

fn ct_selected_operator(machine: CtMachine, mi: U32, offset: U32, values: Array<CtValue>) -> CtValue {
  let selected = ct_unframe_option(ct_lookup_call(machine, mi, offset))
  match selected.target {
    Some(Source(target_mi, path, function, kind)) => ct_intrinsic_result(machine, ct_source_call_frame(machine, target_mi, path, function, values, selected.frame), kind)
    _ => ct_fail(machine, "selected operator has no supported compile-time source body")
  }
}

fn ct_source_call_targets(source: SelfHostCollectedModule, module_: SelfHostPlannedModuleLowering) -> Array<SelfHostBasicCallTarget> {
  let targets = array_new::<SelfHostBasicCallTarget>()
  for expression in source.expressions {
    let _ = expression
    targets.push(ErrorBasicCallTarget)
  }
  for job in module_.inferred.jobs {
    let span = match job.kind {
      MergedBodyInferenceJob(body) => source.bodies[self_host_semantic_id_local(body)].expressions
      MergedLambdaInferenceJob(lambda) => source.lambdas[lambda].body.expressions
    }
    let _ = while 0u32 {
      i if i < span.length && i < job.call_targets.length => {
        targets[span.start + i] = module_.inferred.call_targets[job.call_targets.start + i]
        continue i + 1u32
      }
      _ => break ()
    }
  }
  targets
}

fn ct_checked_source_target(plan: CtPlan, collected: SelfHostCollectedProgram, selected: U64, kind: String) -> CtCallTarget {
  let mut mi = 0u32
  for source in collected.modules.values {
    if source.module_id == self_host_semantic_id_module(selected) {
      let offset = match source.declaration_reference(selected) {
        Some(TopLevel(value)) => value.offset
        Some(Method(value)) => value.offset
        None => return Unsupported
      }
      let file_id = source.declaration_files[self_host_semantic_id_local(selected)]
      let mut fi = 0u32
      for id in source.files {
        if id == file_id {
          for file in plan.files {
            if file.module_index == mi && file.original.path == source.file_paths[fi] {
              for declaration in file.declarations {
                match declaration {
                  Function(f) if f.offset == offset => return Source(mi, file.original.path, f, kind)
                  Impl(impl_) => {
                    for f in impl_.methods {
                      if f.offset == offset {
                        return Source(mi, file.original.path, f, kind)
                      }
                    }
                  }
                  Let(value) if value.offset == offset => return Global(mi, file.original.path, value)
                  Builtin(b) if b.offset == offset => return Intrinsic(b, kind)
                  _ => {
                  }
                }
              }
            }
          }
        }
        fi = fi + 1u32
      }
    }
    mi = mi + 1u32
  }
  Unsupported
}

fn ct_collect_calls(plan: CtPlan, collected: SelfHostCollectedProgram, lowering: SelfHostPlannedProgramLowering) -> Unit {
  plan.raw_array_declarations = lowering.raw_arrays.declarations
  let mut mi = 0u32
  for source in collected.modules.values {
    let expressions = array_new::<U32>()
    let _ = while 0u32 {
      ei if ei < source.expressions.length() => {
        expressions.push(ei)
        continue ei + 1u32
      }
      _ => break ()
    }
    ct_collect_module_calls(plan, collected, lowering, mi, lowering.modules[mi], expressions, ct_base_frame(plan), 4294967295u32)
    mi = mi + 1u32
  }
}

fn ct_collect_module_calls(plan: CtPlan, collected: SelfHostCollectedProgram, lowering: SelfHostPlannedProgramLowering, mi: U32, module_: SelfHostPlannedModuleLowering, expressions: Array<U32>, proofs: CtExecutionFrame, specialization: U32) -> Unit {
  let source = collected.modules.at(mi)
    let calls = ct_source_call_targets(source, module_)
    let operators = ct_scalar_source_targets(source, module_)
    for ei in expressions {
      let expression = source.expressions[ei]
      if ei < module_.expressions.length() {
        let reference = match module_.expressions[ei].kind {
          PlannedModuleValueGet(selected) => Some(ct_checked_source_target(plan, collected, selected, ""))
          PlannedFunctionReference(selected) => Some(ct_checked_source_target(plan, collected, selected, ct_checked_scalar_kind(plan, module_, module_.expressions[ei].type_, true)))
          _ => match module_.expressions[ei].selection {
            VariantConstructionBasicExpressionSelection(selected, 2u32, _) => match ct_pattern_variant_key(collected, selected) {
              Some(key) => Some(UnitConstructor(key))
              None => None
            }
            _ => None
          }
        }
        match reference {
          Some(target) => {
            let mut fi = 0u32
            for file_id in source.files {
              if file_id == source.expression_files[ei] {
                for file in plan.files {
                  if file.module_index == mi && file.original.path == source.file_paths[fi] {
                    match ct_scalar_original_offset(file, expression.offset(), 0u32) {
                      Some(offset) => {
                        let identity = match module_.expressions[ei].kind {
                          PlannedModuleValueGet(selected), PlannedFunctionReference(selected) => ct_checked_function_identity(lowering, selected)
                          _ => CtFunctionIdentity::FunctionInstance
                        }
                        proofs.references.set(ct_site_key(plan, mi, file.original.path, offset), CtFunctionReferenceProof::{
                          target: target
                          identity: identity
                        })
                      }
                      None => {
                      }
                    }
                  }
                }
              }
              fi = fi + 1u32
            }
          }
          _ => {
          }
        }
      }
      let scalar_read = match expression {
        NameExpr(_, _) => true
        FieldExpr(_, _, _) => true
        _ => false
      }
      let selected = if scalar_read {
        Some(NoBasicCallTarget)
      } else {
        match expression {
          CallExpr(_, _, _) => Some(match module_.expressions[ei].call_target {
            SelectedBasicCallTarget(target, arguments) => SelectedBasicCallTarget(target, arguments)
            _ => calls[ei]
          })
          PrefixExpr(_, _, _) => Some(NoBasicCallTarget)
          BinaryExpr(_, _, _, _) => Some(match module_.expressions[ei].call_target {
            SelectedBasicCallTarget(target, arguments) => SelectedBasicCallTarget(target, arguments)
            _ => operators[ei]
          })
          IndexExpr(_, _, _) => Some(match module_.expressions[ei].call_target {
            SelectedBasicCallTarget(target, arguments) => SelectedBasicCallTarget(target, arguments)
            _ => operators[ei]
          })
          _ => None
        }
      }
      match selected {
        Some(value) => {
          let target = if scalar_read || (expression is PrefixExpr(_, _, _)) {
            let kind = ct_checked_scalar_kind(plan, module_, module_.expressions[ei].type_, false)
            if scalar_read && (kind.byte_length() == 0u32 || kind.starts_with("array:")) {
              None
            } else {
              Some(ScalarResult(kind))
            }
          } else {
            match value {
              SelectedBasicCallTarget(declaration, _) => match module_.expressions[ei].selection {
                VariantConstructionBasicExpressionSelection(selected, _, _) => match ct_pattern_variant_key(collected, selected) {
                  Some(key) => Some(Constructor(key))
                  None => Some(Unsupported)
                }
                _ => Some(ct_checked_source_target(plan, collected, declaration, ct_checked_scalar_kind(plan, module_, module_.expressions[ei].type_, false)))
              }
              FunctionValueBasicCallTarget(_) => Some(FunctionValue(ct_checked_scalar_kind(plan, module_, module_.expressions[ei].type_, false)))
              NoBasicCallTarget => None
              _ => Some(Unsupported)
            }
          }
          let target = if expression is CallExpr(_, _, _) {
            match ct_frame_query_proof(lowering, source.module_id, ei, module_.expressions[ei].kind, specialization) {
              Some(value) => Some(Constant(value))
              None => target
            }
          } else {
            target
          }
          match target {
            Some(target) => {
              let mut fi = 0u32
              for file_id in source.files {
                if file_id == source.expression_files[ei] {
                  for file in plan.files {
                    if file.module_index == mi && file.original.path == source.file_paths[fi] {
                      match ct_scalar_original_offset(file, expression.offset(), 0u32) {
                        Some(offset) => match target {
                          ScalarResult(kind) => proofs.scalar_types.set(ct_site_key(plan, mi, file.original.path, offset), kind)
                          _ => proofs.calls.set(ct_site_key(plan, mi, file.original.path, offset), target)
                        }
                        None => {
                        }
                      }
                    }
                  }
                }
                fi = fi + 1u32
              }
            }
            None => {
            }
          }
        }
        None => {
        }
      }
    }
}

fn ct_closure_call(machine: CtMachine, closure: CtValue, args: Array<CtValue>) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  match closure {
    Function(target, bound, _) => {
      let values = array_new::<CtValue>()
      for value in bound {
        values.push(value)
      }
      for value in args {
        values.push(value)
      }
      let selected = ct_unframe_call(target)
      match selected.target {
        Some(Source(mi, path, function, kind)) => ct_intrinsic_result(machine, ct_source_call_frame(machine, mi, path, function, values, selected.frame), kind)
        Some(Intrinsic(builtin_, kind)) => ct_intrinsic_result(machine, ct_typed_intrinsic(machine, builtin_, values, kind), kind)
        Some(Constructor(key)) => CtValue::Variant(key, values)
        _ => ct_fail(machine, "unsupported checked function reference")
      }
    }
    Closure(mi, path, parameters, body, captured, frame) => {
      if parameters.length() != args.length() {
        return ct_fail(machine, "compile-time closure argument count mismatch")
      }
      let env = ct_scope(machine, captured)
      let mut i = 0u32
      for parameter in parameters {
        env.set(parameter.name, ct_binding(parameter.name, args[i]))
        i = i + 1u32
      }
      let previous = machine.file_path
      let previous_frame = machine.frame
      machine.frame = frame
      machine.file_path = path
      let value = ct_block(machine, mi, body, env)
      machine.file_path = previous
      machine.frame = previous_frame
      if machine.flow == 1u32 {
        machine.flow = 0u32
        return machine.result
      }
      if machine.flow != 0u32 {
        return ct_fail(machine, "loop control escaped a compile-time closure")
      }
      value
    }
    _ => ct_fail(machine, "compile-time function value is not an interpreted closure")
  }
}

fn ct_unit_variant(machine: CtMachine, key: String) -> CtValue {
  for file in machine.plan.files {
    let prefix = machine.plan.manifest.modules[file.module_index].path
    for declaration in file.declarations {
      if !ct_charge(machine, 0u32) {
        return CtValue::Empty
      }
      match declaration {
        Enum(enum_) => {
          for variant in enum_.variants {
            match variant {
              UnitVariant(name, _, _) if key == prefix.concat("::").concat(enum_.name).concat("::").concat(name) => return CtValue::Variant(key, [])
              _ => {
              }
            }
          }
        }
        _ => {
        }
      }
    }
  }
  ct_fail(machine, "expression does not name a checked unit enum variant")
}

fn ct_function_reference(machine: CtMachine, mi: U32, expression: SelfHostExpr, env: CtEnvironment) -> CtValue {
  match ct_lookup_reference(machine, mi, expression.offset()) {
    Some(proof) => {
      let target = proof.target
      match target {
        Global(mi, path, declaration) => return ct_global_value(machine, mi, path, declaration)
        _ => {
        }
      }
      if target is UnitConstructor(key) {
        return CtValue::Variant(key, [])
      }
      let bound = array_new::<CtValue>()
      let selected = ct_unframe_call(target)
      match (selected.target, expression) {
        (Some(Source(_, _, function, _)), FieldExpr(owner, _, _)) => if function.receiver is Some(_) {
          bound.push(ct_eval(machine, mi, owner, env))
        }
        _ => {
        }
      }
      CtValue::Function(target, bound, if bound.length() == 0u32 {
        proof.identity
      } else {
        CtFunctionIdentity::FunctionInstance
      })
    }
    None => ct_fail(machine, "global value has no checked function reference")
  }
}

struct CtKindBudget {
  mut remaining: U32
}

fn ct_product_kind(kinds: Array<String>) -> String {
  let out = StringBuilder::new()
  out.append("(")
  for kind in kinds {
    if kind.starts_with("unsupported:") {
      return kind
    }
  }
  for kind in kinds {
    if kind == "Unit" {
      out.append("u")
    } else if kind.starts_with("unit-product:") {
      out.append(kind.slice(13u32, kind.byte_length()))
    } else {
      return "product"
    }
  }
  out.append(")")
  "unit-product:".concat(out.finish())
}

fn ct_nominal_kind(plan: CtPlan, module_: SelfHostPlannedModuleLowering, declaration: U64, arguments: Array<I32>, budget: CtKindBudget, depth: U32) -> String {
  if declaration == self_host_standard_nullable_ref_type_declaration() && arguments.length() == 1u32 {
    return "nullable"
  }
  if plan.raw_array_declarations.contains_key(declaration) && arguments.length() == 1u32 {
    return "array:".concat(ct_checked_kind_depth(plan, module_, arguments[0u32], false, budget, depth + 1u32))
  }
  "record:".concat(ct_raw_declaration_key(declaration))
}

fn ct_checked_scalar_kind(plan: CtPlan, module_: SelfHostPlannedModuleLowering, root: I32, reference: Bool) -> String {
  ct_checked_kind_depth(plan, module_, root, reference, CtKindBudget::{
    remaining: 65536u32
  }, 0u32)
}

fn ct_checked_kind_depth(plan: CtPlan, module_: SelfHostPlannedModuleLowering, root: I32, reference: Bool, budget: CtKindBudget, depth: U32) -> String {
  if budget.remaining == 0u32 || depth >= 128u32 {
    return "unsupported:type metadata limit exceeded"
  }
  budget.remaining = budget.remaining - 1u32
  let mut current = root
  let mut unwrap_function = reference
  let mut resolved_type = -1i32
  let _ = while current {
    type_ => if type_ < -1i32 {
      resolved_type = -type_ - 2i32
      break ()
    } else if type_ < 0i32 {
      return ""
    } else {
      match module_.inferred.types[self_host_body_i32_to_u32(type_)] {
        BodyFunctionType(_, result) if unwrap_function => {
          unwrap_function = false
          continue result
        }
        BodyFunctionType(_, _) => return "function"
        BodyProductType(arguments) => {
          let kinds = array_new::<String>()
          let _ = while 0u32 {
            i if i < arguments.length => {
              kinds.push(ct_checked_kind_depth(plan, module_, module_.inferred.type_arguments[arguments.start + i], false, budget, depth + 1u32))
              continue i + 1u32
            }
            _ => break ()
          }
          return ct_product_kind(kinds)
        }
        BodyAppliedType(base, arguments) if !unwrap_function => {
          let resolved_base = if base < -1i32 {
            self_host_body_i32_to_u32(-base - 2i32)
          } else if base >= 0i32 {
            match module_.inferred.types[self_host_body_i32_to_u32(base)] {
              BodyResolvedType(id) => id
              _ => return ""
            }
          } else {
            return ""
          }
          let args = array_new::<I32>()
          let _ = while 0u32 {
            i if i < arguments.length => {
              args.push(module_.inferred.type_arguments[arguments.start + i])
              continue i + 1u32
            }
            _ => break ()
          }
          return match module_.resolved_types.types[resolved_base] {
            NominalType(declaration) => ct_nominal_kind(plan, module_, declaration, args, budget, depth)
            TraitType(declaration) => "trait:".concat(ct_raw_declaration_key(declaration))
            _ => ""
          }
        }
        BodyResolvedType(id) => {
          resolved_type = self_host_body_u32_to_i32(id)
          break ()
        }
        _ => return ""
      }
    }
  }
  if resolved_type < 0i32 {
    return ""
  }
  let _ = while self_host_body_i32_to_u32(resolved_type) {
    type_ => match module_.resolved_types.types[type_] {
      FunctionType(_, result) if unwrap_function => {
        unwrap_function = false
        continue result
      }
      FunctionType(_, _) => return "function"
      ProductType(arguments) => {
        let kinds = array_new::<String>()
        let _ = while 0u32 {
          i if i < arguments.length => {
            kinds.push(ct_checked_kind_depth(plan, module_, -self_host_body_u32_to_i32(module_.resolved_types.type_arguments[arguments.start + i]) - 2i32, false, budget, depth + 1u32))
            continue i + 1u32
          }
          _ => break ()
        }
        return ct_product_kind(kinds)
      }
      AppliedType(base, arguments) if !unwrap_function => {
        let args = array_new::<I32>()
        let _ = while 0u32 {
          i if i < arguments.length => {
            args.push(-self_host_body_u32_to_i32(module_.resolved_types.type_arguments[arguments.start + i]) - 2i32)
            continue i + 1u32
          }
          _ => break ()
        }
        return match module_.resolved_types.types[base] {
          NominalType(declaration) => ct_nominal_kind(plan, module_, declaration, args, budget, depth)
          TraitType(declaration) => "trait:".concat(ct_raw_declaration_key(declaration))
          _ => ""
        }
      }
      PrimitiveType(primitive) => return match primitive {
        UnitType => "Unit"
        NeverType => "Never"
        F32Type => "F32"
        F64Type => "F64"
        BoolType => "Bool"
        I8Type => "I8"
        U8Type => "U8"
        I16Type => "I16"
        U16Type => "U16"
        Swar32Type => "U32"
        Swar64Type => "U64"
        I32Type => "I32"
        U32Type => "U32"
        I64Type => "I64"
        U64Type => "U64"
        StringType => "String"
        BytesType => "Bytes"
        StringViewType => "StringView"
        StringBuilderType => "StringBuilder"
        BytesBuilderType => "BytesBuilder"
        V128Type, I8x16Type, U8x16Type, I16x8Type, U16x8Type, I32x4Type, U32x4Type, I64x2Type, U64x2Type, F32x4Type, F64x2Type => "V128"
        _ => ""
      }
      NominalType(declaration) => return ct_nominal_kind(plan, module_, declaration, [], budget, depth)
      TraitType(declaration) => return "trait:".concat(ct_raw_declaration_key(declaration))
      _ => return ""
    }
  }
  ""
}

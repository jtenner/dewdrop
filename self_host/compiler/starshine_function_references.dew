open dew.std.option

fn self_host_emit_planned_function_reference(
  link: SelfHostPlannedProgramWasmGCLink,
  singletons: SelfHostFunctionReferenceSingletonPlan,
  plan: Option<SelfHostPlannedPhysicalBodyCarrierPlan>,
  expression: U32,
  declaration: U64,
  destination: StarshineInstructions,
) -> Option<String> {
  let body_plan = match plan {
    Some(value) => value
    None => return Some("function reference has no frozen body plan")
  }
  let reference = match self_host_body_plan_expression(body_plan, expression) {
    Some(value) => value
    None => return Some("function reference has no expression plan")
  }
  let selected = reference.call_function_index
  if selected == 4294967295u32 || !self_host_linked_function_declaration_module_matches(link, selected, declaration) {
    return Some("function reference has no exact physical target")
  }
  let slot = match singletons.by_function.get(selected) {
    Some(value) => value
    None => return Some("function reference has no planned singleton global")
  }
  let singleton = singletons.values[slot]
  if singleton.function_index != selected || singleton.declaration != declaration {
    return Some("function reference singleton changed its exact target")
  }
  StarshineFfi.ffi_ffi_bridge_instructions_push(destination,
    StarshineFfi.ffi_lib_Instruction_global_get(
      StarshineFfi.ffi_lib_GlobalIdx_new(self_host_u32_to_i32(singleton.global_index))),
  )
  None
}

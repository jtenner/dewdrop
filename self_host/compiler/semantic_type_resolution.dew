open dew.std.array
open dew.std.map
open dew.std.option

fn self_host_u32_subtract(left: U32, right: U32) -> U32 {
  left - right
}

fn self_host_u32_slots(length: U32, value: U32) -> Array<U32> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(value)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_bool_slots(length: U32, value: Bool) -> Array<Bool> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(value)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_span_slots(length: U32) -> Array<SelfHostHirSpan> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(self_host_empty_hir_span(0u32))
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_optional_u32_slots(length: U32) -> Array<Option<U32>> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(Option::None)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_empty_alias_indices() -> Map<U64, U32> {
  Map::empty()
}

struct SelfHostTypeResolver {
  collected: SelfHostCollectedModule
  interner: SelfHostResolvedTypeInterner
  syntax_types: Array<U32>
  declaration_types: Array<U32>
  generic_parameter_types: Array<U32>
  generic_bound_types: Array<U32>
  parameter_types: Array<U32>
  callable_return_types: Array<U32>
  callable_function_types: Array<U32>
  lambda_parameter_types: Array<U32>
  lambda_return_types: Array<U32>
  lambda_function_types: Array<U32>
  explicit_call_type_arguments: Array<U32>
  field_types: Array<U32>
  variant_payloads: Array<SelfHostHirSpan>
  signature_type_lists: Array<U32>
  alias_target_types: Array<U32>
  impl_trait_types: Array<Option<U32>>
  impl_target_types: Array<U32>
  alias_dependencies: Array<SelfHostHirSpan>
  alias_dependency_declarations: Array<U64>
  alias_is_cyclic: Array<Bool>
  alias_cycles: Array<SelfHostHirSpan>
  alias_cycle_declarations: Array<U64>
  diagnostics: Array<SelfHostTypeDiagnostic>
  alias_indices: Map<U64, U32>
  syntax_tasks: Array<U32>
  state_tasks: Array<U32>
  expectation_tasks: Array<Bool>
  constructor_tasks: Array<Bool>
  application_scratch: Array<U32>
  visit_stack: Array<U32>
  mut visit_marks: Array<U32>
  alias_visit_marks: Array<U32>
  dependency_scratch: Array<U32>
  normalization_types: Array<U32>
  normalization_states: Array<U32>
  normalization_starts: Array<U32>
  normalization_results: Array<U32>
  normalizations: Array<U32>
  substitution_types: Array<U32>
  substitution_states: Array<U32>
  substitution_starts: Array<U32>
  substitution_results: Array<U32>
  substitution_marks: Array<U32>
  substitution_values: Array<U32>
  alias_expansion_limited: Array<Bool>
  mut visit_generation: U32
  mut substitution_generation: U32
  mut alias_expansion_work: U32
  mut alias_expansion_limit: U32
}

impl SelfHostTypeResolver {
  fn new(collected: SelfHostCollectedModule) -> SelfHostTypeResolver {
    let interner = SelfHostResolvedTypeInterner::new()
    let generic_parameter_types = []
    for parameter in collected.generic_parameters {
      generic_parameter_types.push(interner.intern_generic(parameter.id))
    }
    let alias_indices = self_host_empty_alias_indices()
    let mut alias_index = 0u32
    for alias in collected.aliases {
      alias_indices.set(alias.declaration, alias_index)
      alias_index = alias_index + 1u32
    }
    let declaration_types = self_host_u32_slots(
      collected.declaration_locations.length(),
      interner.error_type,
    )
    for declaration in collected.declarations {
      let resolved = match declaration.kind {
        SelfHostCollectedDeclKind::StructDecl => interner.intern_nominal(declaration.id)
        SelfHostCollectedDeclKind::EnumDecl => interner.intern_nominal(declaration.id)
        SelfHostCollectedDeclKind::TypeAliasDecl => interner.intern_nominal(declaration.id)
        SelfHostCollectedDeclKind::ForeignTypeDecl => interner.intern_nominal(declaration.id)
        SelfHostCollectedDeclKind::TraitDecl => interner.intern_trait(declaration.id)
        _ => interner.error_type
      }
      declaration_types[self_host_semantic_id_local(declaration.id)] = resolved
    }
    SelfHostTypeResolver::{
      collected: collected
      interner: interner
      syntax_types: self_host_u32_slots(collected.type_syntax.length(), 4294967295u32)
      declaration_types: declaration_types
      generic_parameter_types: generic_parameter_types
      generic_bound_types: self_host_u32_slots(collected.generic_bounds.length(), 4294967295u32)
      parameter_types: self_host_u32_slots(collected.parameters.length(), 4294967295u32)
      callable_return_types: self_host_u32_slots(collected.callables.length(), 4294967295u32)
      callable_function_types: self_host_u32_slots(collected.callables.length(), 4294967295u32)
      lambda_parameter_types: self_host_u32_slots(collected.lambda_parameters.length(), 4294967295u32)
      lambda_return_types: self_host_u32_slots(collected.lambdas.length(), 4294967295u32)
      lambda_function_types: self_host_u32_slots(collected.lambdas.length(), 4294967295u32)
      explicit_call_type_arguments: self_host_u32_slots(collected.explicit_call_type_arguments.length(), 4294967295u32)
      field_types: self_host_u32_slots(collected.fields.length(), 4294967295u32)
      variant_payloads: self_host_span_slots(collected.variants.length())
      signature_type_lists: []
      alias_target_types: self_host_u32_slots(collected.aliases.length(), 4294967295u32)
      impl_trait_types: self_host_optional_u32_slots(collected.impls.length())
      impl_target_types: self_host_u32_slots(collected.impls.length(), 4294967295u32)
      alias_dependencies: self_host_span_slots(collected.aliases.length())
      alias_dependency_declarations: []
      alias_is_cyclic: self_host_bool_slots(collected.aliases.length(), false)
      alias_cycles: []
      alias_cycle_declarations: []
      diagnostics: []
      alias_indices: alias_indices
      syntax_tasks: []
      state_tasks: []
      expectation_tasks: []
      constructor_tasks: []
      application_scratch: []
      visit_stack: []
      visit_marks: []
      alias_visit_marks: self_host_u32_slots(collected.aliases.length(), 0u32)
      dependency_scratch: []
      normalization_types: []
      normalization_states: []
      normalization_starts: []
      normalization_results: []
      normalizations: []
      substitution_types: []
      substitution_states: []
      substitution_starts: []
      substitution_results: []
      substitution_marks: []
      substitution_values: []
      alias_expansion_limited: self_host_bool_slots(collected.aliases.length(), false)
      visit_generation: 0u32
      substitution_generation: 0u32
      alias_expansion_work: 0u32
      alias_expansion_limit: 4294967295u32
    }
  }

  fn diagnose(self, diagnostic: SelfHostTypeDiagnostic) -> Unit {
    self.diagnostics.push(diagnostic)
  }

  fn generic_in_span(
    self,
    span: SelfHostHirSpan,
    name: U32,
  ) -> Option<U64> {
    let mut index = span.start
    let end = self_host_u32_add(span.start, span.length)
    while index {
      current => if current < end {
        let parameter = self.collected.generic_parameters[current]
        if self_host_u32_equal(parameter.name, name) {
          break Option::Some(parameter.id)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn generic_parameter(self, owner: U64, name: U32) -> Option<U64> {
    match self.generic_in_span(
      self.collected.generic_parameters_of(owner),
      name,
    ) {
      Option::Some(value) => Option::Some(value)
      Option::None => match self.collected.declaration_reference(owner) {
        Option::Some(reference) => match reference {
          SelfHostCollectedDeclarationReference::Method(method) => self.generic_in_span(
            self.collected.generic_parameters_of(method.parent),
            name,
          )
          SelfHostCollectedDeclarationReference::TopLevel(_) => Option::None
        }
        Option::None => Option::None
      }
    }
  }

  fn self_context(self, owner: U64) -> Option<U64> {
    match self.collected.declaration_reference(owner) {
      Option::Some(reference) => match reference {
        SelfHostCollectedDeclarationReference::Method(method) => Option::Some(
          method.parent,
        )
        SelfHostCollectedDeclarationReference::TopLevel(_) => Option::None
      }
      Option::None => Option::None
    }
  }

  fn declaration_visible(self, owner: U64, declaration: U64) -> Bool {
    self.collected.declaration_is_test_only(owner) ||
      !self.collected.declaration_is_test_only(declaration)
  }

  fn declaration_arity(self, declaration: U64) -> U32 {
    if self_host_semantic_id_module(declaration) == self.collected.module_id {
      self.collected.generic_parameters_of(declaration).length
    } else {
      0u32
    }
  }

  fn constructor_arity(self, type_: U32) -> Option<U32> {
    match self.interner.types[type_] {
      SelfHostResolvedType::ErrorType => Option::None
      SelfHostResolvedType::PrimitiveType(_) => Option::Some(0u32)
      SelfHostResolvedType::NominalType(declaration) => Option::Some(
        self.declaration_arity(declaration),
      )
      SelfHostResolvedType::TraitType(declaration) => Option::Some(
        self.declaration_arity(declaration),
      )
      _ => Option::None
    }
  }

  fn resolve_any_named_type(
    self,
    owner: U64,
    self_owner: Option<U64>,
    name: U32,
    offset: U32,
  ) -> U32 {
    match self.generic_parameter(owner, name) {
      Option::Some(parameter) => {
        return self.interner.intern_generic(parameter)
      }
      Option::None => {}
    }
    let spelling = self.collected.name(name)
    if spelling == "Self" {
      return match self_owner {
        Option::Some(declaration) => self.interner.intern_self(declaration)
        Option::None => {
          self.diagnose(SelfHostTypeDiagnostic::SelfOutsideContext(owner, offset))
          self.interner.error_type
        }
      }
    }
    match self_host_primitive_type_from_name(spelling) {
      Option::Some(primitive) => {
        return self.interner.intern_primitive(primitive)
      }
      Option::None => {}
    }
    match self.collected.type_bindings.get(name) {
      Option::Some(declaration) => if self.declaration_visible(owner, declaration) {
        return self.interner.intern_nominal(declaration)
      }
      Option::None => {}
    }
    match self.collected.trait_bindings.get(name) {
      Option::Some(declaration) => if self.declaration_visible(owner, declaration) {
        return self.interner.intern_trait(declaration)
      }
      Option::None => {}
    }
    self.diagnose(SelfHostTypeDiagnostic::UnknownType(name, owner, offset))
    self.interner.error_type
  }

  fn resolve_trait_named_type(
    self,
    owner: U64,
    name: U32,
    offset: U32,
  ) -> U32 {
    match self.collected.trait_bindings.get(name) {
      Option::Some(declaration) => {
        return self.interner.intern_trait(declaration)
      }
      Option::None => {}
    }
    let spelling = self.collected.name(name)
    let non_trait = self.collected.type_bindings.contains_key(name) ||
      self_host_primitive_type_from_name(spelling) is Option::Some(_) ||
      self.generic_parameter(owner, name) is Option::Some(_) ||
      spelling == "Self"
    if non_trait {
      self.diagnose(SelfHostTypeDiagnostic::ExpectedTraitType(name, owner, offset))
    } else {
      self.diagnose(SelfHostTypeDiagnostic::UnknownTrait(name, owner, offset))
    }
    self.interner.error_type
  }

  fn resolve_named_type(
    self,
    owner: U64,
    self_owner: Option<U64>,
    name: U32,
    offset: U32,
    expect_trait: Bool,
    constructor_position: Bool,
  ) -> U32 {
    let type_ = if expect_trait {
      self.resolve_trait_named_type(owner, name, offset)
    } else {
      self.resolve_any_named_type(owner, self_owner, name, offset)
    }
    if constructor_position || expect_trait || type_ == self.interner.error_type {
      type_
    } else {
      match self.constructor_arity(type_) {
        Option::Some(expected) => if expected == 0u32 {
          type_
        } else {
          self.diagnose(
            SelfHostTypeDiagnostic::TypeArityMismatch(
              type_,
              expected,
              0u32,
              owner,
              offset,
            ),
          )
          self.interner.error_type
        }
        Option::None => type_
      }
    }
  }

  fn push_syntax_task(
    self,
    syntax: U32,
    state: U32,
    expect_trait: Bool,
    constructor_position: Bool,
  ) -> Unit {
    self.syntax_tasks.push(syntax)
    self.state_tasks.push(state)
    self.expectation_tasks.push(expect_trait)
    self.constructor_tasks.push(constructor_position)
  }

  fn finish_applied_type(
    self,
    owner: U64,
    syntax: U32,
    base_syntax: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
  ) -> Unit {
    let base = self.syntax_types[base_syntax]
    if base == self.interner.error_type {
      self.syntax_types[syntax] = base
      return
    }
    let expected = match self.constructor_arity(base) {
      Option::Some(value) => value
      Option::None => {
        self.diagnose(SelfHostTypeDiagnostic::TypeNotApplicable(base, owner, offset))
        self.syntax_types[syntax] = self.interner.error_type
        return
      }
    }
    if expected != arguments.length {
      self.diagnose(
        SelfHostTypeDiagnostic::TypeArityMismatch(
          base,
          expected,
          arguments.length,
          owner,
          offset,
        ),
      )
      self.syntax_types[syntax] = self.interner.error_type
      return
    }
    self.application_scratch.clear()
    let mut index = arguments.start
    let _ = while index {
      current => if current < arguments.start + arguments.length {
        self.application_scratch.push(
          self.syntax_types[self.collected.type_arguments[current]],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let resolved = self.interner.intern_applied(
      base,
      self.application_scratch,
    )
    self.syntax_types[syntax] = resolved
  }

  fn resolve_syntax(
    self,
    owner: U64,
    syntax: U32,
    expect_trait: Bool,
  ) -> U32 {
    let self_owner = self.self_context(owner)
    self.syntax_tasks.clear()
    self.state_tasks.clear()
    self.expectation_tasks.clear()
    self.constructor_tasks.clear()
    self.push_syntax_task(syntax, 0u32, expect_trait, false)
    let _ = while self.syntax_tasks.length() {
      length => if length > 0u32 {
        let current = match self.syntax_tasks.pop() {
          Option::Some(value) => value
          Option::None => 4294967295u32
        }
        let state = match self.state_tasks.pop() {
          Option::Some(value) => value
          Option::None => 4294967295u32
        }
        let current_expectation = match self.expectation_tasks.pop() {
          Option::Some(value) => value
          Option::None => false
        }
        let constructor_position = match self.constructor_tasks.pop() {
          Option::Some(value) => value
          Option::None => false
        }
        match self.collected.type_syntax[current] {
          SelfHostHirTypeSyntax::NamedTypeSyntax(name, offset) => {
            self.syntax_types[current] = self.resolve_named_type(
              owner,
              self_owner,
              name,
              offset,
              current_expectation,
              constructor_position,
            )
          }
          SelfHostHirTypeSyntax::QualifiedTypeSyntax(_, name, _, name_offset) => {
            if current_expectation {
              self.diagnose(
                SelfHostTypeDiagnostic::UnknownTrait(name, owner, name_offset),
              )
            } else {
              self.diagnose(
                SelfHostTypeDiagnostic::UnknownType(name, owner, name_offset),
              )
            }
            self.syntax_types[current] = self.interner.error_type
          }
          SelfHostHirTypeSyntax::ProductTypeSyntax(fields, _) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            let mut index = fields.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[fields.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
          } else {
            self.application_scratch.clear()
            let mut index = 0u32
            let _ = while index {
              field_index => if field_index < fields.length {
                self.application_scratch.push(
                  self.syntax_types[
                    self.collected.type_arguments[fields.start + field_index]
                  ],
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let resolved = self.interner.intern_product(
              self.application_scratch,
            )
            self.syntax_types[current] = resolved
          }
          SelfHostHirTypeSyntax::AppliedTypeSyntax(base, arguments, offset) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            let mut index = arguments.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[arguments.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
            self.push_syntax_task(base, 0u32, current_expectation, true)
          } else {
            self.finish_applied_type(owner, current, base, arguments, offset)
          }
          SelfHostHirTypeSyntax::FunctionTypeSyntax(parameters, result, _) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            self.push_syntax_task(result, 0u32, false, false)
            let mut index = parameters.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[parameters.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
          } else {
            self.application_scratch.clear()
            let mut index = 0u32
            let _ = while index {
              parameter_index => if parameter_index < parameters.length {
                self.application_scratch.push(
                  self.syntax_types[
                    self.collected.type_arguments[
                      parameters.start + parameter_index
                    ]
                  ],
                )
                continue parameter_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let resolved = self.interner.intern_function(
              self.application_scratch,
              self.syntax_types[result],
            )
            self.syntax_types[current] = resolved
          }
        }
        continue self.syntax_tasks.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    self.syntax_types[syntax]
  }

  fn resolve_reserved_names(self) -> Unit {
    for declaration in self.collected.declarations {
      match declaration.kind {
        SelfHostCollectedDeclKind::StructDecl => self.check_reserved_name(declaration)
        SelfHostCollectedDeclKind::EnumDecl => self.check_reserved_name(declaration)
        SelfHostCollectedDeclKind::TypeAliasDecl => self.check_reserved_name(declaration)
        SelfHostCollectedDeclKind::ForeignTypeDecl => self.check_reserved_name(declaration)
        _ => {}
      }
    }
  }

  fn check_reserved_name(
    self,
    declaration: SelfHostCollectedDeclaration,
  ) -> Unit {
    let spelling = self.collected.name(declaration.name)
    if self_host_primitive_type_from_name(spelling) is Option::Some(_) ||
      spelling == "Self" {
      self.diagnose(
        SelfHostTypeDiagnostic::ReservedTypeName(
          declaration.id,
          declaration.name,
          declaration.offset,
        ),
      )
    }
  }

  fn resolve_parameters(self) -> Unit {
    let mut index = 0u32
    for parameter in self.collected.parameters {
      if !self_host_u32_equal(parameter.type_, 4294967295u32) {
        let resolved = self.resolve_syntax(
          parameter.declaration,
          parameter.type_,
          false,
        )
        self.parameter_types[index] = resolved
      } else {
        match parameter.kind {
          SelfHostCollectedParameterKind::ReceiverParameterDecl => match self.self_context(
            parameter.declaration,
          ) {
            Option::Some(declaration) => {
              self.parameter_types[index] = self.interner.intern_self(
                declaration,
              )
            }
            Option::None => {
              self.diagnose(
                SelfHostTypeDiagnostic::SelfOutsideContext(
                  parameter.declaration,
                  parameter.offset,
                ),
              )
              self.parameter_types[index] = self.interner.error_type
            }
          }
          SelfHostCollectedParameterKind::ValueParameterDecl => {
            self.diagnose(
              SelfHostTypeDiagnostic::UnknownType(
                parameter.name,
                parameter.declaration,
                parameter.offset,
              ),
            )
            self.parameter_types[index] = self.interner.error_type
          }
        }
      }
      index = index + 1u32
    }
  }

  fn resolve_signatures(self) -> Unit {
    self.resolve_reserved_names()
    for parameter in self.collected.generic_parameters {
      let mut index = parameter.bounds.start
      let _ = while index {
        current => if current < self_host_u32_add(
          parameter.bounds.start,
          parameter.bounds.length,
        ) {
          let resolved = self.resolve_syntax(
            parameter.declaration,
            self.collected.generic_bounds[current],
            true,
          )
          self.generic_bound_types[current] = resolved
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    self.resolve_parameters()
    let mut callable_index = 0u32
    for callable in self.collected.callables {
      let resolved = self.resolve_syntax(
        callable.declaration,
        callable.return_type,
        false,
      )
      self.callable_return_types[callable_index] = resolved
      callable_index = callable_index + 1u32
    }
    let mut lambda_index = 0u32
    for lambda in self.collected.lambdas {
      let body = self.collected.bodies[self_host_semantic_id_local(lambda.root_body)]
      let mut parameter_index = lambda.parameters.start
      let _ = while parameter_index {
        current => if current < self_host_u32_add(
          lambda.parameters.start,
          lambda.parameters.length,
        ) {
          let resolved = self.resolve_syntax(
            body.declaration,
            self.collected.lambda_parameters[current].type_,
            false,
          )
          self.lambda_parameter_types[current] = resolved
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let resolved_return = self.resolve_syntax(
        body.declaration,
        lambda.return_type,
        false,
      )
      self.lambda_return_types[lambda_index] = resolved_return
      lambda_index = lambda_index + 1u32
    }
    for body in self.collected.bodies {
      let mut expression = body.expressions.start
      let _ = while expression {
        current => if current < self_host_u32_add(
          body.expressions.start,
          body.expressions.length,
        ) {
          if current < self.collected.explicit_call_type_argument_spans.length() {
            let span = self.collected.explicit_call_type_argument_spans[current]
            let mut argument = span.start
            let _ = while argument {
              argument_index => if argument_index < self_host_u32_add(
                span.start,
                span.length,
              ) {
                let resolved = self.resolve_syntax(
                  body.declaration,
                  self.collected.explicit_call_type_arguments[argument_index],
                  false,
                )
                self.explicit_call_type_arguments[argument_index] = resolved
                continue argument_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
    let mut field_index = 0u32
    for field in self.collected.fields {
      let resolved = self.resolve_syntax(
        field.declaration,
        field.type_,
        false,
      )
      self.field_types[field_index] = resolved
      field_index = field_index + 1u32
    }
    let mut variant_index = 0u32
    for variant in self.collected.variants {
      let start = self.signature_type_lists.length()
      let mut payload = variant.payload_types.start
      let _ = while payload {
        current => if current < self_host_u32_add(
          variant.payload_types.start,
          variant.payload_types.length,
        ) {
          let resolved = self.resolve_syntax(
            variant.declaration,
            self.collected.type_arguments[current],
            false,
          )
          self.signature_type_lists.push(resolved)
          continue current + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
      let payload_span = SelfHostHirSpan::{
        start: start
        length: self.signature_type_lists.length() - start
      }
      self.variant_payloads[variant_index] = payload_span
      variant_index = variant_index + 1u32
    }
    let mut alias_index = 0u32
    for alias in self.collected.aliases {
      let resolved = self.resolve_syntax(
        alias.declaration,
        alias.target,
        false,
      )
      self.alias_target_types[alias_index] = resolved
      alias_index = alias_index + 1u32
    }
    let mut impl_index = 0u32
    for implementation in self.collected.impls {
      let resolved_trait = match implementation.trait_type {
        Option::Some(type_) => Option::Some(
          self.resolve_syntax(implementation.declaration, type_, true),
        )
        Option::None => Option::None
      }
      self.impl_trait_types[impl_index] = resolved_trait
      let resolved_target = self.resolve_syntax(
        implementation.declaration,
        implementation.target_type,
        false,
      )
      self.impl_target_types[impl_index] = resolved_target
      impl_index = impl_index + 1u32
    }
  }
}

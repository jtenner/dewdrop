open dew.std.array
open dew.std.map
open dew.std.option

fn self_host_u32_subtract(left: U32, right: U32) -> U32 {
  left - right
}

fn self_host_type_resolution_u32_at(
  values: Array<U32>,
  index: U32,
) -> U32 {
  array_get_unchecked(values, index)
}

fn self_host_type_resolution_bool_at(
  values: Array<Bool>,
  index: U32,
) -> Bool {
  array_get_unchecked(values, index)
}

fn self_host_u32_slots(length: U32, value: U32) -> Array<U32> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(value)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_bool_slots(length: U32, value: Bool) -> Array<Bool> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(value)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_span_slots(length: U32) -> Array<SelfHostHirSpan> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(self_host_empty_hir_span(0u32))
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_optional_u32_slots(length: U32) -> Array<Option<U32>> {
  let result = []
  let _ = while 0u32 {
    index => if index < length {
      result.push(Option::None)
      continue index + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  result
}

fn self_host_empty_alias_indices() -> Map<U64, U32> {
  Map::empty()
}

struct SelfHostImportedTypeMemo {
  values: Array<U32>
}

impl SelfHostImportedTypeMemo {
  fn new() -> SelfHostImportedTypeMemo {
    SelfHostImportedTypeMemo::{
      values: []
    }
  }

  fn initialize(self, length: U32) -> Unit {
    if self.values.length() == 0u32 {
      while 0u32 {
        index => if index < length {
          self.values.push(4294967295u32)
          continue index + 1u32
        } else {
          break self_host_semantic_unit()
        }
      }
    }
  }

  fn get(self, index: U32) -> U32 {
    self.values[index]
  }

  fn set(self, index: U32, value: U32) -> Unit {
    self.values[index] = value
  }
}

struct SelfHostImportedTypeMemoList {
  values: Array<SelfHostImportedTypeMemo>
}

impl SelfHostImportedTypeMemoList {
  fn new() -> SelfHostImportedTypeMemoList {
    SelfHostImportedTypeMemoList::{
      values: []
    }
  }

  fn push(self, memo: SelfHostImportedTypeMemo) -> Unit {
    self.values.push(memo)
  }

  fn at(self, index: U32) -> SelfHostImportedTypeMemo {
    self.values[index]
  }
}

struct SelfHostTypeResolver {
  collected: SelfHostCollectedModule
  imports: Option<SelfHostModuleImportScope>
  interner: SelfHostResolvedTypeInterner
  syntax_types: Array<U32>
  declaration_types: Array<U32>
  generic_parameter_types: Array<U32>
  generic_bound_types: Array<U32>
  parameter_types: Array<U32>
  callable_return_types: Array<U32>
  callable_function_types: Array<U32>
  lambda_parameter_types: Array<U32>
  lambda_return_types: Array<U32>
  lambda_function_types: Array<U32>
  explicit_call_type_arguments: Array<U32>
  field_types: Array<U32>
  variant_payloads: Array<SelfHostHirSpan>
  signature_type_lists: Array<U32>
  alias_target_types: Array<U32>
  impl_trait_types: Array<Option<U32>>
  impl_target_types: Array<U32>
  alias_dependencies: Array<SelfHostHirSpan>
  alias_dependency_declarations: Array<U64>
  alias_is_cyclic: Array<Bool>
  alias_cycles: Array<SelfHostHirSpan>
  alias_cycle_declarations: Array<U64>
  diagnostics: Array<SelfHostTypeDiagnostic>
  alias_indices: Map<U64, U32>
  syntax_tasks: Array<U32>
  state_tasks: Array<U32>
  expectation_tasks: Array<Bool>
  constructor_tasks: Array<Bool>
  application_scratch: Array<U32>
  computed_active: Array<Bool>
  mut computed_depth: U32
  import_memos: SelfHostImportedTypeMemoList
  import_task_interfaces: Array<U32>
  import_task_types: Array<U32>
  import_task_states: Array<U32>
  import_task_starts: Array<U32>
  import_results: Array<U32>
  import_scratch: Array<U32>
  visit_stack: Array<U32>
  mut visit_marks: Array<U32>
  alias_visit_marks: Array<U32>
  dependency_scratch: Array<U32>
  normalization_types: Array<U32>
  normalization_states: Array<U32>
  normalization_starts: Array<U32>
  normalization_results: Array<U32>
  normalizations: Array<U32>
  substitution_types: Array<U32>
  substitution_states: Array<U32>
  substitution_starts: Array<U32>
  substitution_results: Array<U32>
  substitution_marks: Array<U32>
  substitution_values: Array<U32>
  alias_expansion_limited: Array<Bool>
  mut visit_generation: U32
  mut substitution_generation: U32
  mut alias_expansion_work: U32
  mut alias_expansion_limit: U32
}

impl SelfHostTypeResolver {
  fn new(collected: SelfHostCollectedModule) -> SelfHostTypeResolver {
    SelfHostTypeResolver::new_with_imports(collected, Option::None)
  }

  fn new_with_imports(
    collected: SelfHostCollectedModule,
    imports: Option<SelfHostModuleImportScope>,
  ) -> SelfHostTypeResolver {
    let interner = SelfHostResolvedTypeInterner::new()
    let generic_parameter_types = []
    let mut generic_parameter_index = 0u32
    let _ = while generic_parameter_index {
      current => if current < collected.generic_parameters.length() {
        let parameter = self_host_collected_generic_parameter_identity(
          collected.generic_parameters[current],
        )
        generic_parameter_types.push(interner.intern_generic(parameter.id))
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let alias_indices = self_host_empty_alias_indices()
    let mut alias_index = 0u32
    let _ = while alias_index {
      current => if current < collected.aliases.length() {
        let alias = self_host_collected_alias_identity(collected.aliases[current])
        alias_indices.set(alias.declaration, current)
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let declaration_types = self_host_u32_slots(
      collected.declaration_locations.length(),
      interner.error_type,
    )
    let mut declaration_index = 0u32
    let _ = while declaration_index {
      current => if current < collected.declarations.length() {
        let declaration = self_host_collected_declaration_identity(
          collected.declarations[current],
        )
        let resolved = match declaration.kind {
          SelfHostCollectedDeclKind::StructDecl => interner.intern_nominal(declaration.id)
          SelfHostCollectedDeclKind::EnumDecl => interner.intern_nominal(declaration.id)
          SelfHostCollectedDeclKind::TypeAliasDecl => interner.intern_nominal(declaration.id)
          SelfHostCollectedDeclKind::ForeignTypeDecl => interner.intern_nominal(declaration.id)
          SelfHostCollectedDeclKind::TraitDecl => interner.intern_trait(declaration.id)
          _ => interner.error_type
        }
        declaration_types[self_host_semantic_id_local(declaration.id)] = resolved
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let import_memos = SelfHostImportedTypeMemoList::new()
    match imports {
      Option::Some(scope) => {
        let mut index = 0u32
        let _ = while index {
          current => if current < scope.interfaces.length() {
            import_memos.push(SelfHostImportedTypeMemo::new())
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
      Option::None => {}
    }
    SelfHostTypeResolver::{
      collected: collected
      imports: imports
      interner: interner
      syntax_types: self_host_u32_slots(collected.type_syntax.length(), 4294967295u32)
      declaration_types: declaration_types
      generic_parameter_types: generic_parameter_types
      generic_bound_types: self_host_u32_slots(collected.generic_bounds.length(), 4294967295u32)
      parameter_types: self_host_u32_slots(collected.parameters.length(), 4294967295u32)
      callable_return_types: self_host_u32_slots(collected.callables.length(), 4294967295u32)
      callable_function_types: self_host_u32_slots(collected.callables.length(), 4294967295u32)
      lambda_parameter_types: self_host_u32_slots(collected.lambda_parameters.length(), 4294967295u32)
      lambda_return_types: self_host_u32_slots(collected.lambdas.length(), 4294967295u32)
      lambda_function_types: self_host_u32_slots(collected.lambdas.length(), 4294967295u32)
      explicit_call_type_arguments: self_host_u32_slots(collected.explicit_call_type_arguments.length(), 4294967295u32)
      field_types: self_host_u32_slots(collected.fields.length(), 4294967295u32)
      variant_payloads: self_host_span_slots(collected.variants.length())
      signature_type_lists: []
      alias_target_types: self_host_u32_slots(collected.aliases.length(), 4294967295u32)
      impl_trait_types: self_host_optional_u32_slots(collected.impls.length())
      impl_target_types: self_host_u32_slots(collected.impls.length(), 4294967295u32)
      alias_dependencies: self_host_span_slots(collected.aliases.length())
      alias_dependency_declarations: []
      alias_is_cyclic: self_host_bool_slots(collected.aliases.length(), false)
      alias_cycles: []
      alias_cycle_declarations: []
      diagnostics: []
      alias_indices: alias_indices
      syntax_tasks: []
      state_tasks: []
      expectation_tasks: []
      constructor_tasks: []
      application_scratch: []
      computed_active: self_host_bool_slots(collected.type_syntax.length(), false)
      computed_depth: 0u32
      import_memos: import_memos
      import_task_interfaces: []
      import_task_types: []
      import_task_states: []
      import_task_starts: []
      import_results: []
      import_scratch: []
      visit_stack: []
      visit_marks: []
      alias_visit_marks: self_host_u32_slots(collected.aliases.length(), 0u32)
      dependency_scratch: []
      normalization_types: []
      normalization_states: []
      normalization_starts: []
      normalization_results: []
      normalizations: []
      substitution_types: []
      substitution_states: []
      substitution_starts: []
      substitution_results: []
      substitution_marks: []
      substitution_values: []
      alias_expansion_limited: self_host_bool_slots(collected.aliases.length(), false)
      visit_generation: 0u32
      substitution_generation: 0u32
      alias_expansion_work: 0u32
      alias_expansion_limit: 4294967295u32
    }
  }

  fn diagnose(self, diagnostic: SelfHostTypeDiagnostic) -> Unit {
    self.diagnostics.push(diagnostic)
  }

  fn generic_in_span(
    self,
    span: SelfHostHirSpan,
    name: U32,
  ) -> Option<U64> {
    let mut index = span.start
    let end = self_host_u32_add(span.start, span.length)
    while index {
      current => if current < end {
        let parameter = self.collected.generic_parameters[current]
        if self_host_u32_equal(parameter.name, name) {
          break Option::Some(parameter.id)
        }
        continue current + 1u32
      } else {
        break Option::None
      }
    }
  }

  fn generic_parameter(self, owner: U64, name: U32) -> Option<U64> {
    match self.generic_in_span(
      self.collected.generic_parameters_of(owner),
      name,
    ) {
      Option::Some(value) => Option::Some(value)
      Option::None => match self.collected.declaration_reference(owner) {
        Option::Some(reference) => match reference {
          SelfHostCollectedDeclarationReference::Method(method) => self.generic_in_span(
            self.collected.generic_parameters_of(method.parent),
            name,
          )
          SelfHostCollectedDeclarationReference::TopLevel(_) => Option::None
        }
        Option::None => Option::None
      }
    }
  }

  fn self_context(self, owner: U64) -> Option<U64> {
    match self.collected.declaration_reference(owner) {
      Option::Some(reference) => match reference {
        SelfHostCollectedDeclarationReference::Method(method) => Option::Some(
          method.parent,
        )
        SelfHostCollectedDeclarationReference::TopLevel(_) => Option::None
      }
      Option::None => Option::None
    }
  }

  fn declaration_visible(self, owner: U64, declaration: U64) -> Bool {
    self.collected.declaration_is_test_only(owner) ||
      !self.collected.declaration_is_test_only(declaration)
  }

  fn declaration_arity(self, declaration: U64) -> U32 {
    if self_host_semantic_id_module(declaration) == self.collected.module_id {
      self.collected.generic_parameters_of(declaration).length
    } else {
      match self.imports {
        Option::Some(scope) => match scope.binding_for_declaration(declaration) {
          Option::Some(binding) => binding.generic_parameter_count
          Option::None => 0u32
        }
        Option::None => 0u32
      }
    }
  }

  fn push_import_task(
    self,
    interface_index: U32,
    type_: U32,
    state: U32,
    result_start: U32,
  ) -> Unit {
    self.import_task_interfaces.push(interface_index)
    self.import_task_types.push(type_)
    self.import_task_states.push(state)
    self.import_task_starts.push(result_start)
  }

  fn import_interface_type(
    self,
    interface_index: U32,
    root: U32,
  ) -> U32 {
    let scope = match self.imports {
      Option::Some(value) => value
      Option::None => {
        return self.interner.error_type
      }
    }
    let source_root = self_host_interface_resolved_types(
      scope.interfaces,
      interface_index,
    )
    let memo = self.import_memos.at(interface_index)
    memo.initialize(source_root.types.length())
    let cached = memo.get(root)
    if cached != 4294967295u32 {
      return cached
    }
    self.import_task_interfaces.clear()
    self.import_task_types.clear()
    self.import_task_states.clear()
    self.import_task_starts.clear()
    self.import_results.clear()
    self.push_import_task(interface_index, root, 0u32, 0u32)
    let _ = while self.import_task_types.length() {
      length => if length > 0u32 {
        if self.import_task_interfaces.length() == 0u32 ||
          self.import_task_states.length() == 0u32 ||
          self.import_task_starts.length() == 0u32 {
          return self.interner.error_type
        }
        let interface_task = self.import_task_interfaces.length() - 1u32
        let source_interface = self_host_type_resolution_u32_at(
          self.import_task_interfaces,
          interface_task,
        )
        self.import_task_interfaces.truncate(interface_task)
        let type_task = length - 1u32
        let source_type = self_host_type_resolution_u32_at(
          self.import_task_types,
          type_task,
        )
        self.import_task_types.truncate(type_task)
        let state_task = self.import_task_states.length() - 1u32
        let state = self_host_type_resolution_u32_at(
          self.import_task_states,
          state_task,
        )
        self.import_task_states.truncate(state_task)
        let start_task = self.import_task_starts.length() - 1u32
        let result_start = self_host_type_resolution_u32_at(
          self.import_task_starts,
          start_task,
        )
        self.import_task_starts.truncate(start_task)
        let source = self_host_interface_resolved_types(
          scope.interfaces,
          source_interface,
        )
        let source_memo = self.import_memos.at(source_interface)
        source_memo.initialize(source.types.length())
        let existing = source_memo.get(source_type)
        if state == 0u32 && existing != 4294967295u32 {
          self.import_results.push(existing)
          continue self.import_task_types.length()
        }
        if state == 0u32 {
          match source.types[source_type] {
            SelfHostResolvedType::MemberTypeProjection(owner, _, _) => {
              self.push_import_task(source_interface, source_type, 4u32, self.import_results.length())
              self.push_import_task(source_interface, owner, 0u32, 0u32)
            }
            SelfHostResolvedType::ErrorType => {
              source_memo.set(source_type, self.interner.error_type)
              self.import_results.push(self.interner.error_type)
            }
            SelfHostResolvedType::PrimitiveType(primitive) => {
              let imported = self.interner.intern_primitive(primitive)
              source_memo.set(source_type, imported)
              self.import_results.push(imported)
            }
            SelfHostResolvedType::GenericParameterType(parameter) => {
              let imported = self.interner.intern_generic(parameter)
              source_memo.set(source_type, imported)
              self.import_results.push(imported)
            }
            SelfHostResolvedType::NominalType(declaration) => {
              let imported = self.interner.intern_nominal(declaration)
              source_memo.set(source_type, imported)
              self.import_results.push(imported)
            }
            SelfHostResolvedType::TraitType(declaration) => {
              let imported = self.interner.intern_trait(declaration)
              source_memo.set(source_type, imported)
              self.import_results.push(imported)
            }
            SelfHostResolvedType::SelfType(declaration) => {
              let imported = self.interner.intern_self(declaration)
              source_memo.set(source_type, imported)
              self.import_results.push(imported)
            }
            SelfHostResolvedType::ProductType(fields) => {
              self.push_import_task(
                source_interface,
                source_type,
                3u32,
                self.import_results.length(),
              )
              let mut index = fields.length
              let _ = while index {
                remaining => if remaining > 0u32 {
                  let next = remaining - 1u32
                  self.push_import_task(
                    source_interface,
                    source.type_arguments[fields.start + next],
                    0u32,
                    0u32,
                  )
                  continue next
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
            SelfHostResolvedType::AppliedType(base, arguments) => {
              self.push_import_task(
                source_interface,
                source_type,
                1u32,
                self.import_results.length(),
              )
              let mut index = arguments.length
              let _ = while index {
                remaining => if remaining > 0u32 {
                  let next = remaining - 1u32
                  self.push_import_task(
                    source_interface,
                    source.type_arguments[arguments.start + next],
                    0u32,
                    0u32,
                  )
                  continue next
                } else {
                  break self_host_semantic_unit()
                }
              }
              self.push_import_task(source_interface, base, 0u32, 0u32)
            }
            SelfHostResolvedType::FunctionType(parameters, result) => {
              self.push_import_task(
                source_interface,
                source_type,
                2u32,
                self.import_results.length(),
              )
              self.push_import_task(source_interface, result, 0u32, 0u32)
              let mut index = parameters.length
              let _ = while index {
                remaining => if remaining > 0u32 {
                  let next = remaining - 1u32
                  self.push_import_task(
                    source_interface,
                    source.type_arguments[parameters.start + next],
                    0u32,
                    0u32,
                  )
                  continue next
                } else {
                  break self_host_semantic_unit()
                }
              }
            }
          }
          continue self.import_task_types.length()
        }
        if state == 4u32 {
          let (operation, selector) = match source.types[source_type] {
            SelfHostResolvedType::MemberTypeProjection(_, operation, selector) => (operation, selector)
            _ => {
              let _ = self_host_assert_compiler_invariant(false, "INV-001 import task requires a projection")
              unreachable()
            }
          }
          let imported = self.interner.intern_member_projection(self.import_results[result_start], operation, selector)
          source_memo.set(source_type, imported)
          self.import_results.truncate(result_start)
          self.import_results.push(imported)
        }
        if state == 1u32 {
          let base = self.import_results[result_start]
          self.import_scratch.clear()
          let mut arguments = self_host_empty_hir_span(0u32)
          match source.types[source_type] {
            SelfHostResolvedType::AppliedType(_, span) => {
              arguments = span
            }
            _ => {}
          }
          let mut index = 0u32
          let _ = while index {
            current => if current < arguments.length {
              self.import_scratch.push(
                self.import_results[result_start + current + 1u32],
              )
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          let imported = self.interner.intern_applied(base, self.import_scratch)
          source_memo.set(source_type, imported)
          self.import_results.truncate(result_start)
          self.import_results.push(imported)
          continue self.import_task_types.length()
        }
        if state == 2u32 {
          let mut parameters = self_host_empty_hir_span(0u32)
          match source.types[source_type] {
            SelfHostResolvedType::FunctionType(span, _) => {
              parameters = span
            }
            _ => {}
          }
          self.import_scratch.clear()
          let mut index = 0u32
          let _ = while index {
            current => if current < parameters.length {
              self.import_scratch.push(
                self.import_results[result_start + current],
              )
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          let imported = self.interner.intern_function(
            self.import_scratch,
            self.import_results[result_start + parameters.length],
          )
          source_memo.set(source_type, imported)
          self.import_results.truncate(result_start)
          self.import_results.push(imported)
          continue self.import_task_types.length()
        }
        let mut fields = self_host_empty_hir_span(0u32)
        match source.types[source_type] {
          SelfHostResolvedType::ProductType(span) => {
            fields = span
          }
          _ => {}
        }
          self.import_scratch.clear()
          let mut index = 0u32
          let _ = while index {
            current => if current < fields.length {
              self.import_scratch.push(
                self.import_results[result_start + current],
              )
              continue current + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
          let imported = self.interner.intern_product(self.import_scratch)
          source_memo.set(source_type, imported)
        self.import_results.truncate(result_start)
        self.import_results.push(imported)
        continue self.import_task_types.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    self.import_results[0u32]
  }

  fn constructor_arity(self, type_: U32) -> Option<U32> {
    match self.interner.types[type_] {
      SelfHostResolvedType::ErrorType => Option::None
      SelfHostResolvedType::PrimitiveType(_) => Option::Some(0u32)
      SelfHostResolvedType::NominalType(declaration) => Option::Some(
        self.declaration_arity(declaration),
      )
      SelfHostResolvedType::TraitType(declaration) => Option::Some(
        self.declaration_arity(declaration),
      )
      _ => Option::None
    }
  }

  fn resolve_any_named_type(
    self,
    owner: U64,
    self_owner: Option<U64>,
    name: U32,
    offset: U32,
  ) -> U32 {
    match self.generic_parameter(owner, name) {
      Option::Some(parameter) => {
        return self.interner.intern_generic(parameter)
      }
      Option::None => {}
    }
    let spelling = self.collected.name(name)
    if spelling == "Self" {
      return match self_owner {
        Option::Some(declaration) => self.interner.intern_self(declaration)
        Option::None => {
          self.diagnose(SelfHostTypeDiagnostic::SelfOutsideContext(owner, offset))
          self.interner.error_type
        }
      }
    }
    match self_host_primitive_type_from_name(spelling) {
      Option::Some(primitive) => {
        return self.interner.intern_primitive(primitive)
      }
      Option::None => {}
    }
    match self.collected.type_bindings.get(name) {
      Option::Some(declaration) => if self.declaration_visible(owner, declaration) {
        return self.interner.intern_nominal(declaration)
      }
      Option::None => {}
    }
    match self.collected.trait_bindings.get(name) {
      Option::Some(declaration) => if self.declaration_visible(owner, declaration) {
        return self.interner.intern_trait(declaration)
      }
      Option::None => {}
    }
    match self.imports {
      Option::Some(scope) => {
        match scope.lookup_type(spelling) {
          Option::Some(binding) => {
            return self.import_interface_type(
              binding.interface_index,
              binding.semantic_type,
            )
          }
          Option::None => {}
        }
        match scope.lookup_trait(spelling) {
          Option::Some(binding) => {
            return self.import_interface_type(
              binding.interface_index,
              binding.semantic_type,
            )
          }
          Option::None => {}
        }
        if scope.type_is_ambiguous(spelling) || scope.trait_is_ambiguous(spelling) {
          self.diagnose(
            SelfHostTypeDiagnostic::AmbiguousImportedType(name, owner, offset),
          )
          return self.interner.error_type
        }
      }
      Option::None => {}
    }
    self.diagnose(SelfHostTypeDiagnostic::UnknownType(name, owner, offset))
    self.interner.error_type
  }

  fn resolve_trait_named_type(
    self,
    owner: U64,
    name: U32,
    offset: U32,
  ) -> U32 {
    match self.collected.trait_bindings.get(name) {
      Option::Some(declaration) => {
        return self.interner.intern_trait(declaration)
      }
      Option::None => {}
    }
    let spelling = self.collected.name(name)
    match self.imports {
      Option::Some(scope) => {
        match scope.lookup_trait(spelling) {
          Option::Some(binding) => {
            return self.import_interface_type(
              binding.interface_index,
              binding.semantic_type,
            )
          }
          Option::None => {}
        }
        if scope.trait_is_ambiguous(spelling) {
          self.diagnose(
            SelfHostTypeDiagnostic::AmbiguousImportedTrait(name, owner, offset),
          )
          return self.interner.error_type
        }
      }
      Option::None => {}
    }
    let imported_type = match self.imports {
      Option::Some(scope) => scope.lookup_type(spelling) is Option::Some(_)
      Option::None => false
    }
    let non_trait = self.collected.type_bindings.contains_key(name) ||
      imported_type ||
      self_host_primitive_type_from_name(spelling) is Option::Some(_) ||
      self.generic_parameter(owner, name) is Option::Some(_) ||
      spelling == "Self"
    if non_trait {
      self.diagnose(SelfHostTypeDiagnostic::ExpectedTraitType(name, owner, offset))
    } else {
      self.diagnose(SelfHostTypeDiagnostic::UnknownTrait(name, owner, offset))
    }
    self.interner.error_type
  }

  fn qualified_import_binding(
    self,
    module_alias: U32,
    name: U32,
    expect_trait: Bool,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    let scope = match self.imports {
      Option::Some(value) => value
      Option::None => {
        return Option::None
      }
    }
    let interface_index = match scope.lookup_alias(
      self.collected.name(module_alias),
    ) {
      Option::Some(value) => value
      Option::None => {
        return Option::None
      }
    }
    if expect_trait {
      scope.lookup_module_trait(interface_index, self.collected.name(name))
    } else {
      match scope.lookup_module_type(interface_index, self.collected.name(name)) {
        Option::Some(binding) => Option::Some(binding)
        Option::None => scope.lookup_module_trait(
          interface_index,
          self.collected.name(name),
        )
      }
    }
  }

  fn resolve_qualified_type(
    self,
    owner: U64,
    module_alias: U32,
    name: U32,
    offset: U32,
    name_offset: U32,
    expect_trait: Bool,
    constructor_position: Bool,
  ) -> U32 {
    let binding = match self.qualified_import_binding(
      module_alias,
      name,
      expect_trait,
    ) {
      Option::Some(value) => value
      Option::None => {
        if expect_trait {
          self.diagnose(
            SelfHostTypeDiagnostic::UnknownTrait(name, owner, name_offset),
          )
        } else {
          self.diagnose(
            SelfHostTypeDiagnostic::UnknownType(name, owner, name_offset),
          )
        }
        return self.interner.error_type
      }
    }
    let type_ = self.import_interface_type(
      binding.interface_index,
      binding.semantic_type,
    )
    if constructor_position || expect_trait || type_ == self.interner.error_type {
      type_
    } else if binding.source_kind is SelfHostCollectedDeclKind::TypeAliasDecl &&
      self_host_u32_greater(binding.generic_parameter_count, 0u32) {
      self.diagnose(
        SelfHostTypeDiagnostic::TypeArityMismatch(
          type_,
          binding.generic_parameter_count,
          0u32,
          owner,
          offset,
        ),
      )
      self.interner.error_type
    } else {
      match self.constructor_arity(type_) {
        Option::Some(expected) => if expected == 0u32 {
          type_
        } else {
          self.diagnose(
            SelfHostTypeDiagnostic::TypeArityMismatch(
              type_,
              expected,
              0u32,
              owner,
              offset,
            ),
          )
          self.interner.error_type
        }
        Option::None => type_
      }
    }
  }

  fn resolve_named_type(
    self,
    owner: U64,
    self_owner: Option<U64>,
    name: U32,
    offset: U32,
    expect_trait: Bool,
    constructor_position: Bool,
  ) -> U32 {
    let type_ = if expect_trait {
      self.resolve_trait_named_type(owner, name, offset)
    } else {
      self.resolve_any_named_type(owner, self_owner, name, offset)
    }
    if !constructor_position && !expect_trait {
      match self.imports {
        Option::Some(scope) => match scope.lookup_type(
          self.collected.name(name),
        ) {
          Option::Some(binding) => if binding.source_kind is SelfHostCollectedDeclKind::TypeAliasDecl &&
            self_host_u32_greater(binding.generic_parameter_count, 0u32) {
            self.diagnose(
              SelfHostTypeDiagnostic::TypeArityMismatch(
                type_,
                binding.generic_parameter_count,
                0u32,
                owner,
                offset,
              ),
            )
            return self.interner.error_type
          }
          Option::None => {}
        }
        Option::None => {}
      }
    }
    if constructor_position || expect_trait || type_ == self.interner.error_type {
      type_
    } else {
      match self.constructor_arity(type_) {
        Option::Some(expected) => if expected == 0u32 {
          type_
        } else {
          self.diagnose(
            SelfHostTypeDiagnostic::TypeArityMismatch(
              type_,
              expected,
              0u32,
              owner,
              offset,
            ),
          )
          self.interner.error_type
        }
        Option::None => type_
      }
    }
  }

  fn push_syntax_task(
    self,
    syntax: U32,
    state: U32,
    expect_trait: Bool,
    constructor_position: Bool,
  ) -> Unit {
    self.syntax_tasks.push(syntax)
    self.state_tasks.push(state)
    self.expectation_tasks.push(expect_trait)
    self.constructor_tasks.push(constructor_position)
  }

  fn imported_alias_binding(
    self,
    syntax: U32,
  ) -> Option<SelfHostImportedDeclarationBinding> {
    let binding = match self.collected.type_syntax[syntax] {
      SelfHostHirTypeSyntax::NamedTypeSyntax(name, _) => match self.imports {
        Option::Some(scope) => scope.lookup_type(self.collected.name(name))
        Option::None => Option::None
      }
      SelfHostHirTypeSyntax::QualifiedTypeSyntax(module_alias, name, _, _) => self.qualified_import_binding(
        module_alias,
        name,
        false,
      )
      _ => Option::None
    }
    match binding {
      Option::Some(value) => if value.source_kind is SelfHostCollectedDeclKind::TypeAliasDecl {
        Option::Some(value)
      } else {
        Option::None
      }
      Option::None => Option::None
    }
  }

  fn finish_applied_type(
    self,
    owner: U64,
    syntax: U32,
    base_syntax: U32,
    arguments: SelfHostHirSpan,
    offset: U32,
  ) -> Unit {
    let base = self.syntax_types[base_syntax]
    if base == self.interner.error_type {
      self.syntax_types[syntax] = base
      return
    }
    match self.imported_alias_binding(base_syntax) {
      Option::Some(binding) => {
        if !self_host_u32_equal(
          binding.generic_parameter_count,
          arguments.length,
        ) {
          self.diagnose(
            SelfHostTypeDiagnostic::TypeArityMismatch(
              base,
              binding.generic_parameter_count,
              arguments.length,
              owner,
              offset,
            ),
          )
          self.syntax_types[syntax] = self.interner.error_type
          return
        }
        self.application_scratch.clear()
        let mut index = arguments.start
        let end = self_host_u32_add(arguments.start, arguments.length)
        let _ = while index {
          current => if current < end {
            self.application_scratch.push(
              self.syntax_types[self.collected.type_arguments[current]],
            )
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let target = self.import_interface_type(
          binding.interface_index,
          binding.semantic_type,
        )
        let resolved = self.substitute_imported_alias_target(
          binding,
          target,
          self.application_scratch,
        )
        self.syntax_types[syntax] = resolved
        return
      }
      Option::None => {}
    }
    let expected = match self.constructor_arity(base) {
      Option::Some(value) => value
      Option::None => {
        self.diagnose(SelfHostTypeDiagnostic::TypeNotApplicable(base, owner, offset))
        self.syntax_types[syntax] = self.interner.error_type
        return
      }
    }
    if expected != arguments.length {
      self.diagnose(
        SelfHostTypeDiagnostic::TypeArityMismatch(
          base,
          expected,
          arguments.length,
          owner,
          offset,
        ),
      )
      self.syntax_types[syntax] = self.interner.error_type
      return
    }
    self.application_scratch.clear()
    let mut index = arguments.start
    let _ = while index {
      current => if current < arguments.start + arguments.length {
        self.application_scratch.push(
          self.syntax_types[self.collected.type_arguments[current]],
        )
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let resolved = self.interner.intern_applied(
      base,
      self.application_scratch,
    )
    self.syntax_types[syntax] = resolved
  }

  fn resolve_syntax(
    self,
    owner: U64,
    syntax: U32,
    expect_trait: Bool,
  ) -> U32 {
    self_host_assert_array_index(syntax, self.syntax_types.length(), "ARN-104 computed type syntax")
    if self.computed_active[syntax] || self.computed_depth >= 256u32 {
      self.diagnose(SelfHostTypeDiagnostic::ComputedTypeFailure(
        owner,
        if self.computed_active[syntax] {
          "CT-033 cyclic computed type"
        } else {
          "CT-034 computed type nesting limit exceeded"
        },
        self.collected.type_syntax[syntax].offset(),
      ))
      return self.interner.error_type
    }
    self.computed_active[syntax] = true
    let self_owner = self.self_context(owner)
    self.syntax_tasks.clear()
    self.state_tasks.clear()
    self.expectation_tasks.clear()
    self.constructor_tasks.clear()
    self.push_syntax_task(syntax, 0u32, expect_trait, false)
    let _ = while self.syntax_tasks.length() {
      length => if length > 0u32 {
        if self.state_tasks.length() == 0u32 ||
          self.expectation_tasks.length() == 0u32 ||
          self.constructor_tasks.length() == 0u32 {
          self_host_assert_compiler_invariant(false, "ARN-103 type resolution work arrays are not parallel")
          unreachable()
        }
        let current_index = length - 1u32
        let current = self_host_type_resolution_u32_at(
          self.syntax_tasks,
          current_index,
        )
        self.syntax_tasks.truncate(current_index)
        let state_index = self.state_tasks.length() - 1u32
        let state = self_host_type_resolution_u32_at(
          self.state_tasks,
          state_index,
        )
        self.state_tasks.truncate(state_index)
        let expectation_index = self.expectation_tasks.length() - 1u32
        let current_expectation = self_host_type_resolution_bool_at(
          self.expectation_tasks,
          expectation_index,
        )
        self.expectation_tasks.truncate(expectation_index)
        let constructor_index = self.constructor_tasks.length() - 1u32
        let constructor_position = self_host_type_resolution_bool_at(
          self.constructor_tasks,
          constructor_index,
        )
        self.constructor_tasks.truncate(constructor_index)
        match self.collected.type_syntax[current] {
          SelfHostHirTypeSyntax::ComputedTypeSyntax(target, selector, offset) => {
            self.syntax_types[current] = self.resolve_computed_type(owner, target, selector, offset)
          }
          SelfHostHirTypeSyntax::NamedTypeSyntax(name, offset) => {
            self.syntax_types[current] = self.resolve_named_type(
              owner,
              self_owner,
              name,
              offset,
              current_expectation,
              constructor_position,
            )
          }
          SelfHostHirTypeSyntax::QualifiedTypeSyntax(
            module_alias,
            name,
            offset,
            name_offset,
          ) => {
            let resolved = self.resolve_qualified_type(
              owner,
              module_alias,
              name,
              offset,
              name_offset,
              current_expectation,
              constructor_position,
            )
            self.syntax_types[current] = resolved
          }
          SelfHostHirTypeSyntax::ProductTypeSyntax(fields, _) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            let mut index = fields.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[fields.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
          } else {
            self.application_scratch.clear()
            let mut index = 0u32
            let _ = while index {
              field_index => if field_index < fields.length {
                self.application_scratch.push(
                  self.syntax_types[
                    self.collected.type_arguments[fields.start + field_index]
                  ],
                )
                continue field_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let resolved = self.interner.intern_product(
              self.application_scratch,
            )
            self.syntax_types[current] = resolved
          }
          SelfHostHirTypeSyntax::AppliedTypeSyntax(base, arguments, offset) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            let mut index = arguments.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[arguments.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
            self.push_syntax_task(base, 0u32, current_expectation, true)
          } else {
            self.finish_applied_type(owner, current, base, arguments, offset)
          }
          SelfHostHirTypeSyntax::FunctionTypeSyntax(parameters, result, _) => if state == 0u32 {
            self.push_syntax_task(
              current,
              1u32,
              current_expectation,
              constructor_position,
            )
            self.push_syntax_task(result, 0u32, false, false)
            let mut index = parameters.length
            let _ = while index {
              remaining => if remaining > 0u32 {
                let next = remaining - 1u32
                self.push_syntax_task(
                  self.collected.type_arguments[parameters.start + next],
                  0u32,
                  false,
                  false,
                )
                continue next
              } else {
                break self_host_semantic_unit()
              }
            }
          } else {
            self.application_scratch.clear()
            let mut index = 0u32
            let _ = while index {
              parameter_index => if parameter_index < parameters.length {
                self.application_scratch.push(
                  self.syntax_types[
                    self.collected.type_arguments[
                      parameters.start + parameter_index
                    ]
                  ],
                )
                continue parameter_index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
            let resolved = self.interner.intern_function(
              self.application_scratch,
              self.syntax_types[result],
            )
            self.syntax_types[current] = resolved
          }
        }
        continue self.syntax_tasks.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    self.computed_active[syntax] = false
    self.syntax_types[syntax]
  }

  fn resolve_reserved_names(self) -> Unit {
    let mut declaration_index = 0u32
    let _ = while declaration_index {
      current => if current < self.collected.declarations.length() {
        let declaration = self_host_collected_declaration_identity(
          self.collected.declarations[current],
        )
        match declaration.kind {
          SelfHostCollectedDeclKind::StructDecl => self.check_reserved_name(declaration)
          SelfHostCollectedDeclKind::EnumDecl => self.check_reserved_name(declaration)
          SelfHostCollectedDeclKind::TypeAliasDecl => self.check_reserved_name(declaration)
          SelfHostCollectedDeclKind::ForeignTypeDecl => self.check_reserved_name(declaration)
          _ => {}
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn check_reserved_name(
    self,
    declaration: SelfHostCollectedDeclaration,
  ) -> Unit {
    let spelling = self.collected.name(declaration.name)
    if self_host_primitive_type_from_name(spelling) is Option::Some(_) ||
      spelling == "Self" {
      self.diagnose(
        SelfHostTypeDiagnostic::ReservedTypeName(
          declaration.id,
          declaration.name,
          declaration.offset,
        ),
      )
    }
  }

  fn resolve_parameters(self) -> Unit {
    let mut index = 0u32
    let _ = while index {
      current => if current < self.collected.parameters.length() {
        let parameter = self_host_collected_parameter_identity(
          self.collected.parameters[current],
        )
        if !self_host_u32_equal(parameter.type_, 4294967295u32) {
          let resolved = self.resolve_syntax(
            parameter.declaration,
            parameter.type_,
            false,
          )
          self.parameter_types[current] = resolved
        } else {
          match parameter.kind {
            SelfHostCollectedParameterKind::ReceiverParameterDecl => match self.self_context(
              parameter.declaration,
            ) {
              Option::Some(declaration) => {
                self.parameter_types[current] = self.interner.intern_self(
                  declaration,
                )
              }
              Option::None => {
                self.diagnose(
                  SelfHostTypeDiagnostic::SelfOutsideContext(
                    parameter.declaration,
                    parameter.offset,
                  ),
                )
                self.parameter_types[current] = self.interner.error_type
              }
            }
            SelfHostCollectedParameterKind::ValueParameterDecl => {
              self.diagnose(
                SelfHostTypeDiagnostic::UnknownType(
                  parameter.name,
                  parameter.declaration,
                  parameter.offset,
                ),
              )
              self.parameter_types[current] = self.interner.error_type
            }
          }
        }
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn resolve_expression_type_arguments(self, owner: U64, expressions: SelfHostHirSpan) -> Unit {
    self_host_assert_array_span(expressions.start, expressions.length, self.collected.expressions.length(), "ARN-104 explicit type argument expressions")
    let _ = while 0u32 {
      offset => if offset < expressions.length {
        let expression = expressions.start + offset
        if self.collected.expressions[expression] is SelfHostHirExpr::TypeBindingExpr(syntax, _) {
          let _ = self.resolve_syntax(owner, syntax, false)
        }
        if expression < self.collected.explicit_call_type_argument_spans.length() {
          let span = self.collected.explicit_call_type_argument_spans[expression]
          self_host_assert_array_span(span.start, span.length, self.collected.explicit_call_type_arguments.length(), "ARN-104 explicit type arguments")
          let _ = while 0u32 {
            argument => if argument < span.length {
              let index = span.start + argument
              self.explicit_call_type_arguments[index] = self.resolve_syntax(owner, self.collected.explicit_call_type_arguments[index], false)
              continue argument + 1u32
            } else {
              break self_host_semantic_unit()
            }
          }
        }
        continue offset + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn resolve_signatures(self) -> Unit {
    self.resolve_reserved_names()
    let mut generic_parameter_index = 0u32
    let _ = while generic_parameter_index {
      current_parameter => if current_parameter < self.collected.generic_parameters.length() {
        let parameter = self_host_collected_generic_parameter_identity(
          self.collected.generic_parameters[current_parameter],
        )
        let mut index = parameter.bounds.start
        let _ = while index {
          current => if current < self_host_u32_add(
            parameter.bounds.start,
            parameter.bounds.length,
          ) {
            let resolved = self.resolve_syntax(
              parameter.declaration,
              self.collected.generic_bounds[current],
              true,
            )
            self.generic_bound_types[current] = resolved
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        continue current_parameter + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.resolve_parameters()
    let mut callable_index = 0u32
    let _ = while callable_index {
      current => if current < self.collected.callables.length() {
        let callable = self_host_collected_callable_identity(
          self.collected.callables[current],
        )
        let resolved = self.resolve_syntax(
          callable.declaration,
          callable.return_type,
          false,
        )
        self.callable_return_types[current] = resolved
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut lambda_index = 0u32
    let _ = while lambda_index {
      current_lambda => if current_lambda < self.collected.lambdas.length() {
        let lambda = self.collected.lambdas[current_lambda]
        let body = self.collected.bodies[self_host_semantic_id_local(lambda.root_body)]
        let mut parameter_index = lambda.parameters.start
        let _ = while parameter_index {
          current => if current < self_host_u32_add(
            lambda.parameters.start,
            lambda.parameters.length,
          ) {
            let resolved = self.resolve_syntax(
              body.declaration,
              self.collected.lambda_parameters[current].type_,
              false,
            )
            self.lambda_parameter_types[current] = resolved
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        let resolved_return = self.resolve_syntax(
          body.declaration,
          lambda.return_type,
          false,
        )
        self.lambda_return_types[current_lambda] = resolved_return
        self.resolve_expression_type_arguments(body.declaration, lambda.body.expressions)
        continue current_lambda + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut body_index = 0u32
    let _ = while body_index {
      current_body => if current_body < self.collected.bodies.length() {
        let body = self.collected.bodies[current_body]
        self.resolve_expression_type_arguments(body.declaration, body.expressions)
        continue current_body + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut field_index = 0u32
    let _ = while field_index {
      current => if current < self.collected.fields.length() {
        let field = self_host_collected_field_identity(self.collected.fields[current])
        let resolved = self.resolve_syntax(
          field.declaration,
          field.type_,
          false,
        )
        self.field_types[current] = resolved
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut variant_index = 0u32
    let _ = while variant_index {
      current_variant => if current_variant < self.collected.variants.length() {
        let variant = self_host_collected_variant_identity(
          self.collected.variants[current_variant],
        )
        let start = self.signature_type_lists.length()
        let mut payload = variant.payload_types.start
        let _ = while payload {
          current => if current < self_host_u32_add(
            variant.payload_types.start,
            variant.payload_types.length,
          ) {
            let resolved = self.resolve_syntax(
              variant.declaration,
              self.collected.type_arguments[current],
              false,
            )
            self.signature_type_lists.push(resolved)
            continue current + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        self.variant_payloads[current_variant] = SelfHostHirSpan::{
          start: start
          length: self.signature_type_lists.length() - start
        }
        continue current_variant + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut alias_index = 0u32
    let _ = while alias_index {
      current => if current < self.collected.aliases.length() {
        let alias = self_host_collected_alias_identity(self.collected.aliases[current])
        let resolved = self.resolve_syntax(
          alias.declaration,
          alias.target,
          false,
        )
        self.alias_target_types[current] = resolved
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let mut impl_index = 0u32
    let _ = while impl_index {
      current => if current < self.collected.impls.length() {
        let implementation = self_host_collected_impl_identity(
          self.collected.impls[current],
        )
        let resolved_trait = match implementation.trait_type {
          Option::Some(type_) => Option::Some(
            self.resolve_syntax(implementation.declaration, type_, true),
          )
          Option::None => Option::None
        }
        self.impl_trait_types[current] = resolved_trait
        let resolved_target = self.resolve_syntax(
          implementation.declaration,
          implementation.target_type,
          false,
        )
        self.impl_target_types[current] = resolved_target
        continue current + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }
}

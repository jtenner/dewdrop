fn self_host_required_field_write(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, link: SelfHostPlannedProgramWasmGCLink, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, specialization: U32, expression: U32, field: U64, base: U32) -> SelfHostPlannedPhysicalExpressionCarrier {
  let _ = self_host_linked_exact_emitted_expression_carrier(canonical, link, module_, body, specialization, expression)
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, 228u64)
  }
  let saved = match self_host_body_plan_expression(plan, expression) {
    Option::Some(value) => value
    Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, 228u64)
  }
  if saved.selected_field != field || saved.receiver_expression != base {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, field, saved.selected_field, u32_into_u64(base))
  }
  if saved.selected_type_index >= link.types.length() || saved.selected_field_index == 4294967295u32 {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, u32_into_u64(link.types.length()), u32_into_u64(saved.selected_type_index), 228u64)
  }
  let linked = link.types[saved.selected_type_index]
  if linked.type_index != saved.selected_type_index || linked.module_index >= link.fragments.modules.length() {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 504u32, u32_into_u64(saved.selected_type_index), u32_into_u64(linked.type_index), 229u64)
  }
  let fragment = link.fragments.modules[linked.module_index]
  if linked.fragment_index >= fragment.physical_types.length() {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 101u32, u32_into_u64(fragment.physical_types.length()), u32_into_u64(linked.fragment_index), 229u64)
  }
  let physical = fragment.physical_types[linked.fragment_index]
  if !self_host_array_span_is_valid(physical.fields.start, physical.fields.length, fragment.fields.length()) || saved.selected_field_index >= physical.fields.length {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 101u32, u32_into_u64(physical.fields.length), u32_into_u64(saved.selected_field_index), 229u64)
  }
  let target = fragment.fields[physical.fields.start + saved.selected_field_index]
  if target.declaration != field || target.physical_index != saved.selected_field_index || !target.mutable_ {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, field, target.declaration, 229u64)
  }
  let expected_storage = self_host_body_freeze_storage(Option::Some(target.storage))
  let actual_storage = self_host_body_freeze_storage(saved.selected_storage)
  if expected_storage != actual_storage {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, expected_storage, actual_storage, 229u64)
  }
  let expected_cast = match saved.selected_storage {
    Option::Some(SelfHostPlannedWasmStorageType::WasmRawArrayRefStorage(fragment)) => {
      let owner = link.types[saved.selected_type_index].module_index
      match self_host_linked_raw_array_field_type(link, owner, fragment, saved.selected_type_index) {
        Option::Some(index) => Option::Some(index)
        Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, 1u64, 0u64, 228u64)
      }
    }
    Option::Some(_) => Option::None
    Option::None => self_host_constructor_field_failure(module_, body, expression, 7u32, 608u32, 1u64, 0u64, 228u64)
  }
  let expected = self_host_constructor_box_identity(expected_cast)
  let actual = self_host_constructor_box_identity(saved.selected_reference_cast)
  if expected != actual {
    self_host_constructor_field_failure(module_, body, expression, 7u32, 605u32, expected, actual, 228u64)
  }
  saved
}

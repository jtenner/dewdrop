open dew.std.option
open dew.std.testing

fn self_host_program_lowering_test_manifest(
  modules: Array<SelfHostManifestModule>,
) -> SelfHostPlannedProgramLowering {
  self_host_plan_program_lowering(
    self_host_freeze_program_signature_interfaces(
      self_host_collect_program_manifest(
        5100u64,
        SelfHostProgramManifest::{
          modules: modules
        },
      ),
    ),
  )
}

test "program lowering schedules dependency SCCs before consumers" {
  let planned = self_host_program_lowering_test_manifest([
    SelfHostManifestModule::{
      path: "app.main"
      files: [
        SelfHostManifestFile::{
          path: "main.dew"
          source: b"open app.middle\npub fn run() -> I32 {\n  middle()\n}\n"
          test_only: false
        },
      ]
    },
    SelfHostManifestModule::{
      path: "app.middle"
      files: [
        SelfHostManifestFile::{
          path: "middle.dew"
          source: b"open app.leaf\npub fn middle() -> I32 {\n  leaf()\n}\n"
          test_only: false
        },
      ]
    },
    SelfHostManifestModule::{
      path: "app.leaf"
      files: [
        SelfHostManifestFile::{
          path: "leaf.dew"
          source: b"pub fn leaf() -> I32 {\n  7\n}\n"
          test_only: false
        },
      ]
    },
  ])
  assert(planned.modules.length() == 3u32, "module count")
  assert(planned.graph.sccs.length() == 3u32, "scc count")
  assert(planned.graph.scc_modules[0u32] == 2u32, "leaf first")
  assert(planned.graph.scc_modules[1u32] == 1u32, "middle second")
  assert(planned.graph.scc_modules[2u32] == 0u32, "root last")
  match planned.index.module_index(5101u64) {
    Option::Some(index) => assert(index == 1u32, "manifest index")
    Option::None => assert(false, "module lookup")
  }
}

test "program lowering groups cyclic module dependencies" {
  let planned = self_host_program_lowering_test_manifest([
    SelfHostManifestModule::{
      path: "app.a"
      files: [
        SelfHostManifestFile::{
          path: "a.dew"
          source: b"open app.b\npub fn a() -> I32 {\n  b()\n}\n"
          test_only: false
        },
      ]
    },
    SelfHostManifestModule::{
      path: "app.b"
      files: [
        SelfHostManifestFile::{
          path: "b.dew"
          source: b"open app.a\npub fn b() -> I32 {\n  1\n}\n"
          test_only: false
        },
      ]
    },
  ])
  assert(planned.graph.sccs.length() == 1u32, "one cyclic SCC")
  let cycle = planned.graph.sccs[0u32]
  assert(self_host_u32_equal(cycle.length, 2u32), "two cycle members")
  assert(planned.graph.scc_modules[0u32] == 0u32, "source order a")
  assert(planned.graph.scc_modules[1u32] == 1u32, "source order b")
}

fn self_host_program_lowering_has_imported_call(
  module_: SelfHostPlannedModuleLowering,
  owner: U64,
) -> Bool {
  for expression in module_.expressions {
    match expression.kind {
      SelfHostPlannedExpressionKind::PlannedDirectCall(target, _, _, _) => if self_host_u64_equal(
        self_host_semantic_id_module(target),
        owner,
      ) {
        return true
      }
      _ => {}
    }
  }
  false
}

test "program lowering preserves imported direct call identity" {
  let planned = self_host_program_lowering_test_manifest([
    SelfHostManifestModule::{
      path: "app.main"
      files: [
        SelfHostManifestFile::{
          path: "main.dew"
          source: b"open app.library\npub fn run() -> I32 {\n  answer()\n}\n"
          test_only: false
        },
      ]
    },
    SelfHostManifestModule::{
      path: "app.library"
      files: [
        SelfHostManifestFile::{
          path: "library.dew"
          source: b"pub fn answer() -> I32 {\n  42\n}\n"
          test_only: false
        },
      ]
    },
  ])
  assert(
    self_host_program_lowering_has_imported_call(
      planned.modules[0u32],
      5101u64,
    ),
    "imported direct call",
  )
}

open dew.std.array
open dew.std.bytes
open dew.std.option
open dew.std.string

fn self_host_empty_derives() -> Array<SelfHostDeriveRequest> {
  new()
}

fn self_host_empty_struct_fields() -> Array<SelfHostStructField> {
  new()
}

fn self_host_empty_enum_variants() -> Array<SelfHostEnumVariant> {
  new()
}

fn self_host_empty_functions() -> Array<SelfHostFunctionDeclaration> {
  new()
}

fn self_host_empty_trait_methods() -> Array<SelfHostTraitMethod> {
  new()
}

fn self_host_parse_optional_derives(
  parser: SelfHostParser,
) -> Option<Array<SelfHostDeriveRequest>> {
  let requests = self_host_empty_derives()
  match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Identifier(name, _) if name.equals("derive") => {
        parser.index = parser.index + 1u32
      }
      _ => {
        return Some(requests)
      }
    }
    None => {
      return Some(requests)
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    0u32,
    LeftParen,
  ) {
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let result = while 0u32 {
    _ => {
      let pair = match self_host_parser_identifier(
        parser,
        DeriveName,
      ) {
        Some(value) => value
        None => break None
      }
      let (name, offset) = pair
      requests.push({
        name: name
        offset: offset
      })
      self_host_parser_skip_newlines(parser)
      if self_host_parser_consume_symbol(parser, 1u32) {
        break Some(requests)
      } else if self_host_parser_consume_symbol(
        parser,
        25u32,
      ) {
        self_host_parser_skip_newlines(parser)
        if self_host_parser_consume_symbol(
          parser,
          1u32,
        ) {
          break Some(requests)
        } else {
          continue 0u32
        }
      } else {
        self_host_parser_fail_expected(
          parser,
          DeriveSeparatorOrClose,
        )
        break None
      }
    }
  }
  result
}

fn self_host_parse_function_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostFunctionDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    FunctionName,
  ) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    0u32,
    LeftParen,
  ) {
    return None
  } else {
  }
  let parsed_parameters = match self_host_parse_function_parameters(
    parser,
    true,
  ) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (receiver, parameters) = parsed_parameters
  if !self_host_parser_expect_symbol(
    parser,
    31u32,
    Arrow,
  ) {
    return None
  } else {
  }
  let return_type = match self_host_parse_type(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  let body = match self_host_parse_block_after_left(parser, body_offset) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      visibility: visibility
      name: name
      name_offset: name_offset
      is_main: self_host_name_main_code(name) == 1296124238u32
      type_parameters: type_parameters
      receiver: receiver
      parameters: parameters
      return_type: return_type
      body: body
      offset: declaration_offset
    })
  }
}

fn self_host_parse_test_after_keyword(
  parser: SelfHostParser,
  declaration_offset: U32,
) -> Option<SelfHostTestDeclaration> {
  let name_token = match self_host_parser_peek(parser) {
    Some(value) => value
    None => {
      self_host_parser_fail_expected(
        parser,
        TestName,
      )
      return None
    }
  }
  let name = match name_token.kind {
    StringLiteral(value) => {
      parser.index = parser.index + 1u32
      value
    }
    _ => {
      self_host_parser_fail_expected(
        parser,
        TestName,
      )
      return None
    }
  }
  let expected_trap = match self_host_parser_peek(parser) {
    Some(token) => match token.kind {
      Identifier(identifier, _) if identifier.equals("expect_trap") => {
        parser.index = parser.index + 1u32
        match self_host_parser_peek(parser) {
          Some(value_token) => match value_token.kind {
            StringLiteral(value) => {
              parser.index = parser.index + 1u32
              Some(value)
            }
            _ => {
              self_host_parser_fail_expected(
                parser,
                TestExpectedTrap,
              )
              return None
            }
          }
          None => {
            self_host_parser_fail_expected(
              parser,
              TestExpectedTrap,
            )
            return None
          }
        }
      }
      _ => None
    }
    None => None
  }
  let body_offset = self_host_parser_offset(parser)
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  let body = match self_host_parse_block_after_left(parser, body_offset) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      name: name
      name_offset: name_token.offset
      expected_trap: expected_trap
      return_type: NamedType("Unit", declaration_offset)
      body: body
      offset: declaration_offset
    })
  }
}

fn self_host_parse_impl_after_keyword(
  parser: SelfHostParser,
  foreign_: Bool,
  declaration_offset: U32,
) -> Option<SelfHostImplDeclaration> {
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  let first_type = match self_host_parse_type(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  let mut trait_type = self_host_no_type()
  let target_type = if self_host_parser_consume_keyword(
    parser,
    7u32,
  ) {
    trait_type = Some(first_type)
    match self_host_parse_type(parser) {
      Some(value) => value
      None => {
      return None
    }
    }
  } else if self_host_parser_at_symbol(
    parser,
    2u32,
  ) {
    if foreign_ {
      self_host_parser_fail(
        parser,
        ForeignImplRequiresTrait(declaration_offset),
      )
      return None
    } else {
      first_type
    }
  } else {
    self_host_parser_fail_expected(
      parser,
      ForOrLeftBrace,
    )
    return None
  }
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  let methods = self_host_empty_functions()
  if !self_host_parser_consume_symbol(parser, 3u32) {
    if !self_host_parser_expect_newline(
      parser,
      FunctionBodyNewline,
    ) {
      return None
    } else {
    }
    self_host_parser_skip_newlines(parser)
    let parsed = while 0u32 {
      _ => {
        if self_host_parser_consume_symbol(
          parser,
          3u32,
        ) {
          break true
        } else {
        }
        let method_offset = self_host_parser_offset(parser)
        if !self_host_parser_expect_keyword(
          parser,
          0u32,
          ImplMemberKeyword,
        ) {
          break false
        } else {
        }
        match self_host_parse_function_after_keyword(
          parser,
          ModuleVisible,
          method_offset,
        ) {
          Some(value) => methods.push(value)
          None => break false
        }
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
    }
    if !parsed {
      return None
    } else {
    }
  } else {
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      foreign_: foreign_
      type_parameters: type_parameters
      trait_type: trait_type
      target_type: target_type
      methods: methods
      offset: declaration_offset
    })
  }
}

fn self_host_parse_struct_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostStructDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    StructName,
  ) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  let fields = self_host_empty_struct_fields()
  if !self_host_parser_consume_symbol(parser, 3u32) {
    if !self_host_parser_expect_newline(
      parser,
      StructBodyNewline,
    ) {
      return None
    } else {
    }
    self_host_parser_skip_newlines(parser)
    let parsed = while 0u32 {
      _ => {
        if self_host_parser_consume_symbol(
          parser,
          3u32,
        ) {
          break true
        } else {
        }
        let mutable_ = self_host_parser_consume_keyword(
          parser,
          13u32,
        )
        let field_pair = match self_host_parser_identifier(
          parser,
          StructFieldName,
        ) {
          Some(value) => value
          None => break false
        }
        let (field_name, field_offset) = field_pair
        if !self_host_parser_expect_symbol(
          parser,
          13u32,
          Colon,
        ) {
          break false
        } else {
        }
        match self_host_parse_type(parser) {
          Some(type_) => fields.push({
            mutable_: mutable_
            name: field_name
            type_: type_
            offset: field_offset
          })
          None => break false
        }
        if !self_host_parser_finish_line(parser) {
          break false
        } else {
        }
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
    }
    if !parsed {
      return None
    } else {
    }
  } else {
  }
  let derives = match self_host_parse_optional_derives(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      visibility: visibility
      name: name
      name_offset: name_offset
      type_parameters: type_parameters
      fields: fields
      derives: derives
      offset: declaration_offset
    })
  }
}

fn self_host_parse_enum_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostEnumDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    EnumName,
  ) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    2u32,
    LeftBrace,
  ) {
    return None
  } else {
  }
  let variants = self_host_empty_enum_variants()
  if !self_host_parser_consume_symbol(parser, 3u32) {
    if !self_host_parser_expect_newline(
      parser,
      EnumBodyNewline,
    ) {
      return None
    } else {
    }
    self_host_parser_skip_newlines(parser)
    let parsed = while 0u32 {
      _ => {
        if self_host_parser_consume_symbol(
          parser,
          3u32,
        ) {
          break true
        } else {
        }
        let variant_pair = match self_host_parser_identifier(
          parser,
          EnumVariantName,
        ) {
          Some(value) => value
          None => break false
        }
        let (variant_name, variant_offset) = variant_pair
        if self_host_parser_consume_symbol(
          parser,
          0u32,
        ) {
          let types = self_host_empty_types()
          self_host_parser_skip_newlines(parser)
          if self_host_parser_consume_symbol(
            parser,
            1u32,
          ) {
            self_host_parser_fail(
              parser,
              EmptyTupleVariant(variant_offset),
            )
            break false
          } else {
          }
          let tuple_ok = while 0u32 {
            _ => match self_host_parse_type(parser) {
              Some(type_) => {
                types.push(type_)
                self_host_parser_skip_newlines(parser)
                if self_host_parser_consume_symbol(
                  parser,
                  1u32,
                ) {
                  break true
                } else if self_host_parser_consume_symbol(
                  parser,
                  25u32,
                ) {
                  self_host_parser_skip_newlines(parser)
                  if self_host_parser_consume_symbol(
                    parser,
                    1u32,
                  ) {
                    break true
                  } else {
                    continue 0u32
                  }
                } else {
                  self_host_parser_fail_expected(
                    parser,
                    VariantTypeSeparatorOrClose,
                  )
                  break false
                }
              }
              None => break false
            }
          }
          if !tuple_ok {
            break false
          } else {
            variants.push(
              TupleVariant(
                variant_name,
                types,
                variant_offset,
                1u32,
              ),
            )
          }
        } else if self_host_parser_consume_symbol(
          parser,
          2u32,
        ) {
          let fields = self_host_empty_struct_fields()
          if !self_host_parser_consume_symbol(
            parser,
            3u32,
          ) {
            if !self_host_parser_expect_newline(
              parser,
              EnumVariantBodyNewline,
            ) {
              break false
            } else {
            }
            self_host_parser_skip_newlines(parser)
            let fields_ok = while 0u32 {
              _ => {
                if self_host_parser_consume_symbol(
                  parser,
                  3u32,
                ) {
                  break true
                } else {
                }
                let field_pair = match self_host_parser_identifier(
                  parser,
                  EnumVariantFieldName,
                ) {
                  Some(value) => value
                  None => break false
                }
                let (field_name, field_offset) = field_pair
                if !self_host_parser_expect_symbol(
                  parser,
                  13u32,
                  Colon,
                ) {
                  break false
                } else {
                }
                match self_host_parse_type(parser) {
                  Some(type_) => fields.push({
                    mutable_: false
                    name: field_name
                    type_: type_
                    offset: field_offset
                  })
                  None => break false
                }
                if !self_host_parser_finish_line(parser) {
                  break false
                } else {
                }
                self_host_parser_skip_newlines(parser)
                continue 0u32
              }
            }
            if !fields_ok {
              break false
            } else {
            }
          } else {
          }
          variants.push(
            StructVariant(
              variant_name,
              fields,
              variant_offset,
              2u32,
            ),
          )
        } else if self_host_parser_consume_newline(parser) {
          variants.push(
            UnitVariant(
              variant_name,
              variant_offset,
              0u32,
            ),
          )
          self_host_parser_skip_newlines(parser)
          continue 0u32
        } else {
          self_host_parser_fail_expected(
            parser,
            EnumVariantPayloadOrLineEnd,
          )
          break false
        }
        if !self_host_parser_finish_line(parser) {
          break false
        } else {
        }
        self_host_parser_skip_newlines(parser)
        continue 0u32
      }
    }
    if !parsed {
      return None
    } else {
    }
  } else {
  }
  let derives = match self_host_parse_optional_derives(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      visibility: visibility
      name: name
      name_offset: name_offset
      type_parameters: type_parameters
      variants: variants
      derives: derives
      offset: declaration_offset
    })
  }
}

fn self_host_parse_type_alias_after_keyword(
  parser: SelfHostParser,
  visibility: SelfHostDeclarationVisibility,
  declaration_offset: U32,
) -> Option<SelfHostTypeAliasDeclaration> {
  let pair = match self_host_parser_identifier(
    parser,
    TypeAliasName,
  ) {
    Some(value) => value
    None => {
      return None
    }
  }
  let (name, name_offset) = pair
  let type_parameters = match self_host_parse_optional_type_parameters(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_expect_symbol(
    parser,
    15u32,
    Equal,
  ) {
    return None
  } else {
  }
  self_host_parser_skip_newlines(parser)
  let target = match self_host_parse_type(parser) {
    Some(value) => value
    None => {
      return None
    }
  }
  if !self_host_parser_finish_line(parser) {
    None
  } else {
    Some({
      visibility: visibility
      name: name
      name_offset: name_offset
      type_parameters: type_parameters
      target: target
      offset: declaration_offset
    })
  }
}

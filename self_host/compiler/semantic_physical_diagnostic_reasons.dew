// Codes are stable. Text is for display, never for selecting a failure code.
enum SelfHostPhysicalDiagnosticReason {
  CarrierConflict
  CarrierAnalysisDidNotConverge
  MissingCallTarget
  CallTargetMismatch
  CallEvaluationScheduleMismatch
  CallOperandCountMismatch
  MissingCallOperandPlan
  CallOperandCarrierMismatch
  CallReceiverCountMismatch
  ErasedCallOperand
  CallResultMismatch
  MissingConcreteBodyRoot
  MissingPhysicalBody
  MissingPhysicalFieldIdentity
  FieldSelectionMismatch
  FieldOwnerMismatch
  FieldReceiverOwnerMismatch
  FieldReceiverHeapMismatch
  MissingConstructorType
  ConstructorTypeMismatch
  MissingConstructorFieldIdentity
  ConstructorArgumentCarrierMismatch
  ConstructorArgumentOwnerMismatch
  MissingConstructorArgumentPlan
  PatternPayloadCarrierMismatch
  PatternPayloadOwnerMismatch
  LoopBindingOwnerMismatch
  IncorrectCallDivergence
  LocalAssignmentCarrierMismatch
  ReturnOperandMismatch
  FieldLoadCarrierMismatch
  MissingFieldLoadIdentity
  LocalInitializerCarrierMismatch
  BodyResultMismatch
  RawIntrinsicOperandCountMismatch
  MissingRawIntrinsicBodyPlan
  MissingRawIntrinsicResultPlan
  MissingRawIntrinsicOperandPlan
  RawIntrinsicCarrierMismatch
  MissingRawIntrinsicSourcePlan
  InvalidBitcastCarriers
  RawHeapInstructionContract(U32)
}

impl SelfHostPhysicalDiagnosticReason {
  fn code(self) -> U32 {
    match self {
      CarrierConflict => 601u32
      CarrierAnalysisDidNotConverge => 604u32
      MissingCallTarget => 607u32
      CallTargetMismatch => 701u32
      CallEvaluationScheduleMismatch => 702u32
      CallOperandCountMismatch => 703u32
      MissingCallOperandPlan => 704u32
      CallOperandCarrierMismatch => 705u32
      CallReceiverCountMismatch => 707u32
      ErasedCallOperand => 708u32
      CallResultMismatch => 709u32
      MissingConcreteBodyRoot => 612u32
      MissingPhysicalBody => 610u32
      MissingPhysicalFieldIdentity => 608u32
      FieldSelectionMismatch => 608u32
      FieldOwnerMismatch => 608u32
      FieldReceiverOwnerMismatch => 608u32
      FieldReceiverHeapMismatch => 608u32
      MissingConstructorType => 608u32
      ConstructorTypeMismatch => 608u32
      MissingConstructorFieldIdentity => 608u32
      ConstructorArgumentCarrierMismatch => 608u32
      ConstructorArgumentOwnerMismatch => 608u32
      MissingConstructorArgumentPlan => 608u32
      PatternPayloadCarrierMismatch => 608u32
      PatternPayloadOwnerMismatch => 608u32
      LoopBindingOwnerMismatch => 609u32
      IncorrectCallDivergence => 611u32
      LocalAssignmentCarrierMismatch => 710u32
      ReturnOperandMismatch => 711u32
      FieldLoadCarrierMismatch => 608u32
      MissingFieldLoadIdentity => 608u32
      LocalInitializerCarrierMismatch => 710u32
      BodyResultMismatch => 612u32
      RawIntrinsicOperandCountMismatch => 714u32
      MissingRawIntrinsicBodyPlan => 610u32
      MissingRawIntrinsicResultPlan => 610u32
      MissingRawIntrinsicOperandPlan => 704u32
      RawIntrinsicCarrierMismatch => 714u32
      MissingRawIntrinsicSourcePlan => 704u32
      InvalidBitcastCarriers => 714u32
      RawHeapInstructionContract(_) => 714u32
    }
  }

  fn description(self) -> String {
    match self {
      RawHeapInstructionContract(reason) => {
        let message = StringBuilder::new()
        message.append("raw heap instruction contract failure ")
        message.append_u32(reason)
        message.finish()
      }
      CarrierConflict => "body carrier conflict"
      CarrierAnalysisDidNotConverge => "physical body carrier analysis did not converge"
      MissingCallTarget => "call target is missing"
      CallTargetMismatch => "planned and emitted call target differ"
      CallEvaluationScheduleMismatch => "call evaluation schedule mismatch"
      CallOperandCountMismatch => "call argument count mismatch"
      MissingCallOperandPlan => "call argument has no physical value plan"
      CallOperandCarrierMismatch => "call argument carrier mismatch"
      CallReceiverCountMismatch => "call receiver count mismatch"
      ErasedCallOperand => "erased call value became an operand"
      CallResultMismatch => "call result"
      MissingConcreteBodyRoot => "body root has no concrete physical value"
      MissingPhysicalBody => "physical source body is missing"
      MissingPhysicalFieldIdentity => "field access has no exact physical field identity"
      FieldSelectionMismatch => "field physical identity differs from inference selection"
      FieldOwnerMismatch => "field physical owner differs from declared field owner"
      FieldReceiverOwnerMismatch => "field target owner does not match receiver type"
      FieldReceiverHeapMismatch => "field receiver nominal owner or physical heap type mismatch"
      MissingConstructorType => "constructor has no exact physical destination type"
      ConstructorTypeMismatch => "constructor selected physical type mismatch"
      MissingConstructorFieldIdentity => "constructor destination field has no exact source FieldId"
      ConstructorArgumentCarrierMismatch => "constructor argument carrier mismatch"
      ConstructorArgumentOwnerMismatch => "constructor argument nominal provenance mismatch"
      MissingConstructorArgumentPlan => "constructor argument has no physical value plan"
      PatternPayloadCarrierMismatch => "pattern payload carrier mismatch"
      PatternPayloadOwnerMismatch => "pattern payload nominal provenance mismatch"
      LoopBindingOwnerMismatch => "loop binding nominal provenance mismatch"
      IncorrectCallDivergence => "direct call result is incorrectly marked as diverging"
      LocalAssignmentCarrierMismatch => "local assignment carrier mismatch"
      ReturnOperandMismatch => "return operand"
      FieldLoadCarrierMismatch => "field load"
      MissingFieldLoadIdentity => "field load has no selected physical field"
      LocalInitializerCarrierMismatch => "local initializer carrier mismatch"
      BodyResultMismatch => "function result"
      RawIntrinsicOperandCountMismatch => "raw intrinsic operand count does not match its opcode"
      MissingRawIntrinsicBodyPlan => "raw intrinsic requires a physical body plan"
      MissingRawIntrinsicResultPlan => "raw intrinsic result plan is missing"
      MissingRawIntrinsicOperandPlan => "raw intrinsic operand plan is missing"
      RawIntrinsicCarrierMismatch => "raw intrinsic input or result carrier does not match its opcode"
      MissingRawIntrinsicSourcePlan => "raw intrinsic source plan is missing"
      InvalidBitcastCarriers => "unsafe.bitcast requires equal concrete non-reference carriers"
    }
  }
}

fn ct_validation_body(plan: CtPlan) -> String {
  "{\n ".concat(plan.validation_stop).concat("()\n}")
}

fn ct_validation_manifest(plan: CtPlan) -> SelfHostProgramManifest {
  let modules = array_new::<SelfHostManifestModule>()
  let mut mi = 0u32
  for module_ in plan.manifest.modules {
    let files = array_new::<SelfHostManifestFile>()
    let generated = array_new::<SelfHostManifestFile>()
    for file in plan.files {
      if file.module_index == mi {
        let out = BytesBuilder::new()
        let mut cursor = 0u32
        for function in file.functions {
          if ct_is_annotated(file, function) {
            out.append(file.clean.slice(cursor, function.start))
            out.append(ct_blank(file.clean, function.start, function.end))
            let path_builder = StringBuilder::new()
            path_builder.append(file.original.path)
            path_builder.append("::transform-check[")
            path_builder.append(function.declaration.name)
            path_builder.append("@")
            path_builder.append_u32(function.start)
            path_builder.append("]")
            let path = path_builder.finish()
            for original in module_.files {
              if original.path == path {
                plan.error = "generated transform check file path collision"
              }
            }
            plan.validation_targets.set(ct_call_key(mi, path, 0u32), CtSignatureTarget::{
              key: ct_site_key(plan, mi, file.original.path, function.declaration.offset)
              name: function.declaration.name
            })
            generated.push({
                path: path
                source: ct_part(file.clean, function.start, function.declaration.body.offset).concat(ct_validation_body(plan)).as_bytes()
                test_only: file.original.test_only
            })
            cursor = function.end
          }
        }
        out.append(file.clean.slice(cursor, file.clean.byte_length()))
        // Keep original declaration identities stable when the first file only
        // supplies imports. Canonical type identities precede this helper.
        if files.length() + 1u32 == module_.files.length() {
          out.append("\nbuiltin ".concat(plan.validation_stop).concat("() -> Never = \"unreachable\"\n").as_bytes())
        }
        files.push({
            path: file.original.path
            source: out.finish()
            test_only: file.original.test_only
        })
      }
    }
    for file in generated {
      files.push(file)
    }
    modules.push({
        path: module_.path
        files: files
    })
    mi = mi + 1u32
  }
  {
    modules: modules
  }
}

fn ct_expand_checked(manifest: SelfHostProgramManifest, default_preamble: Bool) -> Result<SelfHostProgramManifest, String> {
  ct_expand_checked_plan(ct_prepare(manifest), default_preamble)
}

fn ct_expand_checked_plan(plan: CtPlan, default_preamble: Bool) -> Result<SelfHostProgramManifest, String> {
  ct_expand_checked_plan_retaining_declarations(plan, default_preamble, false)
}

fn ct_expand_checked_plan_retaining_declarations(plan: CtPlan, default_preamble: Bool, retain_transform_declarations: Bool) -> Result<SelfHostProgramManifest, String> {
  match ct_check_plan(plan, default_preamble) {
    Err(error) => Err(error)
    Ok(_) => ct_expand_retaining_declarations(plan, retain_transform_declarations)
  }
}

fn ct_check_plan(plan: CtPlan, default_preamble: Bool) -> Result<Unit, String> {
  if plan.error.byte_length() != 0u32 {
    return Err(plan.error)
  }
  if !plan.active {
    return Ok(())
  }
  let validation_manifest = ct_validation_manifest(plan)
  if plan.error.byte_length() != 0u32 {
    return Err(plan.error)
  }
  let validation = self_host_manifest_with_default_preamble(validation_manifest, default_preamble)
  let collected = self_host_collect_program_manifest(7200u64, validation)
  if collected.diagnostics.length() != 0u32 {
    return Err("invalid compile-time transform manifest")
  }
  for module_ in collected.modules.values {
    if module_.diagnostic_count() != 0u32 {
      return Err("invalid compile-time transform source")
    }
  }
  match self_host_validate_collected_program_storage(collected) {
    Some(error) => return Err(error)
    None => {
    }
  }
  let frozen = self_host_freeze_program_signature_interfaces(collected)
  if frozen.import_diagnostics.length() != 0u32 || frozen.path_diagnostics.length() != 0u32 {
    return Err("invalid compile-time transform imports")
  }
  match self_host_validate_collected_program_bodies(frozen) {
    Some(error) => return Err(error)
    None => {
    }
  }
  let lowering = self_host_plan_program_lowering(frozen)
  let inference = if ct_defer_inference_errors(plan, lowering) {
    ct_inference_validation_view(lowering)
  } else {
    lowering
  }
  match self_host_validate_program_inference(inference) {
    Some(error) => return Err(error)
    None => {
    }
  }
  match self_host_validate_program_lowering(lowering) {
    Some(error) => return Err(error)
    None => {
    }
  }
  if !ct_check_transform_signatures(plan, collected, lowering) {
    return Err(plan.error)
  }
  match ct_intrinsic_declaration_contract_error(lowering) {
    Some(error) => return Err(error)
    None => {}
  }
  ct_collect_type_names(plan, frozen)
  ct_collect_scalar_proofs(plan, collected, lowering, ct_validation_body(plan))
  ct_collect_pattern_proofs(plan, collected, lowering)
  ct_collect_calls(plan, collected, lowering)
  ct_collect_signature_calls(plan, collected, lowering)
  ct_collect_frames(plan, collected, lowering)
  if plan.error.byte_length() != 0u32 {
    return Err(plan.error)
  }
  ct_collect_arrays(plan, collected, lowering)
  ct_collect_raw_layouts(plan, collected, lowering)
  ct_collect_expression_types(plan, default_preamble)
  if plan.error.byte_length() != 0u32 {
    return Err(plan.error)
  }
  plan.worker_ready = true
  plan.worker_preamble = default_preamble
  Ok(())
}

// A request carries source bytes; import selection never asks interpreted code
// or the host to load another payload or source file.
fn ct_expand_checked_with_source_pool(manifest: SelfHostProgramManifest, source_pool: SelfHostProgramManifest, default_preamble: Bool) -> Result<SelfHostProgramManifest, String> {
  ct_expand_checked_with_source_pool_reports(manifest, source_pool, default_preamble, [])
}

fn ct_expand_checked_with_source_pool_reports(manifest: SelfHostProgramManifest, source_pool: SelfHostProgramManifest, default_preamble: Bool, reports: Array<CtTransformReport>) -> Result<SelfHostProgramManifest, String> {
  if source_pool.modules.length() == 0u32 {
    let plan = ct_prepare(manifest)
    let result = ct_expand_checked_plan(plan, default_preamble)
    for report in plan.reports {
 reports.push(report)
 }
    return result
  }
  for module_ in source_pool.modules {
    if module_.path == "dewdrop.ast" || module_.path == "dewdrop.transform" {
      return Err("dewdrop.ast and dewdrop.transform are supplied by the compiler")
    }
  }
  let mut current = match self_host_manifest_import_closure_deferred(manifest, source_pool, ["dewdrop.ast", "dewdrop.transform"]) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  let trusted_library_indices = array_new::<U32>()
  while 0u32 {
    round if round <= source_pool.modules.length() => {
      let previous_count = current.modules.length()
      let plan = ct_prepare_with_trusted_libraries(current, trusted_library_indices)
      if plan.error.byte_length() != 0u32 {
        return Err(plan.error)
      }
      // API trust comes from the exact positions added by this preparation.
      if trusted_library_indices.length() == 0u32 && plan.manifest.modules.length() > previous_count {
        if plan.manifest.modules.length() != previous_count + 2u32 {
          return Err("transform API module count mismatch")
        }
        trusted_library_indices.push(previous_count)
        trusted_library_indices.push(previous_count + 1u32)
      }
      let complete = match self_host_manifest_import_closure(plan.manifest, source_pool) {
        Ok(value) => value
        Err(error) => return Err(error)
      }
      if !plan.active {
        return Ok(complete)
      }
      if plan.active {
        let _ = while plan.manifest.modules.length() {
          mi if mi < complete.modules.length() => {
            let module_ = complete.modules[mi]
            plan.manifest.modules.push(module_)
            for file in module_.files {
              if !file.source.is_valid_utf8() {
                return Err(file.path.concat(": error: compile-time transform sources must be valid UTF-8"))
              }
              plan.files.push(ct_scan(plan, mi, file))
              if plan.error.byte_length() != 0u32 {
                return Err(file.path.concat(": error: ").concat(plan.error))
              }
            }
            continue mi + 1u32
          }
          _ => break ()
        }
        // Newly selected sources can contain the previous placeholder name.
        let _ = while 0u32 {
          _ => {
            let mut collision = false
            for module_ in plan.manifest.modules {
              for file in module_.files {
                if file.source.to_string().contains(plan.validation_stop) {
                  collision = true
                }
              }
            }
            if !collision {
              break ()
            }
            plan.validation_stop = plan.validation_stop.concat("_")
            continue 0u32
          }
        }
      }
      let expanded = match ct_expand_checked_plan_retaining_declarations(plan, default_preamble, true) {
        Ok(value) => value
        Err(error) => return Err(error)
      }
      for report in plan.reports {
        reports.push(report)
      }
      let selected = match self_host_manifest_import_closure(expanded, source_pool) {
        Ok(value) => value
        Err(error) => return Err(error)
      }
      if selected.modules.length() == expanded.modules.length() {
        // All target annotations are gone. This pass only strips retained
        // compile-time declarations; it does not execute earlier targets.
        let final_plan = ct_prepare_with_trusted_libraries(selected, trusted_library_indices)
        return ct_expand(final_plan)
      }
      current = selected
      continue round + 1u32
    }
    _ => break Err("transform import expansion exceeded its source pool bound")
  }
}

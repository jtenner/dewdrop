open dew.std.array
open dew.std.option
open dew.std.testing

fn self_host_operator_infer_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostResolvedModuleTypes,
  SelfHostResolvedModuleNames,
  SelfHostBasicInferredModuleBodies,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  (collected, resolved, names, inferred)
}

fn self_host_operator_find_binary(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
) -> U32 {
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  while expression {
    current => if current < end {
      match collected.expressions[current] {
        SelfHostHirExpr::BinaryExpr(_, _, _, _) => {
          return current
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break 4294967295u32
    }
  }
}

fn self_host_operator_find_index(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
  set_: Bool,
) -> U32 {
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  while expression {
    current => if current < end {
      match collected.expressions[current] {
        SelfHostHirExpr::IndexExpr(_, _, _) => if !set_ {
          return current
        }
        SelfHostHirExpr::IndexSetExpr(_, _, _, _) => if set_ {
          return current
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break 4294967295u32
    }
  }
}

fn self_host_operator_assert_primitive(
  body: SelfHostBasicInferredBody,
  resolved: SelfHostResolvedModuleTypes,
  type_: I32,
  primitive: SelfHostPrimitiveType,
  message: String,
) -> Unit {
  match body.type_term(type_) {
    SelfHostBodyTypeTerm::BodyResolvedType(resolved_type) => assert(
      resolved_type == resolved.primitive(primitive),
      message,
    )
    _ => assert(false, message)
  }
}

test "operator selection resolves trait implementations" {
  let (collected, resolved, names, inferred) = self_host_operator_infer_source(
    880u64,
    b"trait Add {\n  fn add(self, right: Self) -> Self\n}\nstruct Box {\n  value: I32\n}\nimpl Add for Box {\n  fn add(self, right: Self) -> Self {\n    self\n  }\n}\nfn combine(left: Box, right: Box) -> Box {\n  left + right\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let hir_body = collected.bodies[1u32]
  let body = match inferred.body(hir_body.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let operator = self_host_operator_find_binary(collected, hir_body)
  assert(body.diagnostic_count() == 0u32, "operator diagnostics")
  match body.operator_target(hir_body, operator) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, arguments) => {
      assert(declaration == collected.methods[1u32].id, "selected Add::add")
      assert(arguments.length == 0u32, "operator arguments")
    }
    _ => assert(false, "operator target")
  }
}

test "operator selection instantiates generic implementations" {
  let (collected, resolved, names, inferred) = self_host_operator_infer_source(
    881u64,
    b"trait Eq {\n  fn eq(self, right: Self) -> Bool\n}\nstruct Box<t> {\n  value: t\n}\nimpl<t> Eq for Box<t> {\n  fn eq(self, right: Self) -> Bool {\n    true\n  }\n}\nfn same(left: Box<I32>, right: Box<I32>) -> Bool {\n  left == right\n}\n",
  )
  let _ = names.module_id
  let hir_body = collected.bodies[1u32]
  let body = match inferred.body(hir_body.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let operator = self_host_operator_find_binary(collected, hir_body)
  assert(body.diagnostic_count() == 0u32, "generic operator diagnostics")
  match body.operator_target(hir_body, operator) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(_, arguments) => {
      assert(arguments.length == 1u32, "generic operator arguments")
      self_host_operator_assert_primitive(
        body,
        resolved,
        body.call_type_arguments[arguments.start],
        SelfHostPrimitiveType::I32Type,
        "generic operator I32",
      )
    }
    _ => assert(false, "generic operator target")
  }
}

test "operator selection resolves index get and set traits" {
  let (collected, resolved, names, inferred) = self_host_operator_infer_source(
    883u64,
    b"trait IndexedGet<k, v> {\n  fn indexed_get(self, key: k) -> v\n}\ntrait IndexedSet<k, v> {\n  fn indexed_set(self, key: k, value: v) -> Unit\n}\nstruct Box {\n  value: I32\n}\nimpl IndexedGet<U32, I32> for Box {\n  fn indexed_get(self, key: U32) -> I32 {\n    self.value\n  }\n}\nimpl IndexedSet<U32, I32> for Box {\n  fn indexed_set(self, key: U32, value: I32) -> Unit {}\n}\nfn read(boxed: Box, key: U32) -> I32 {\n  boxed[key]\n}\nfn write(boxed: Box, key: U32, value: I32) -> Unit {\n  boxed[key] = value\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let read_hir = collected.bodies[2u32]
  let write_hir = collected.bodies[3u32]
  let read_body = match inferred.body(read_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let write_body = match inferred.body(write_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let read_index = self_host_operator_find_index(collected, read_hir, false)
  let write_index = self_host_operator_find_index(collected, write_hir, true)
  assert(read_body.diagnostic_count() == 0u32, "index get diagnostics")
  assert(write_body.diagnostic_count() == 0u32, "index set diagnostics")
  match read_body.operator_target(read_hir, read_index) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => assert(
      declaration == collected.methods[2u32].id,
      "indexed_get target",
    )
    _ => assert(false, "index get target")
  }
  match write_body.operator_target(write_hir, write_index) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => assert(
      declaration == collected.methods[3u32].id,
      "indexed_set target",
    )
    _ => assert(false, "index set target")
  }
}

test "operator selection diagnoses missing implementations" {
  let (collected, resolved, names, inferred) = self_host_operator_infer_source(
    882u64,
    b"trait Add {\n  fn add(self, right: Self) -> Self\n}\nfn combine(left: Bool, right: Bool) -> Bool {\n  left + right\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let hir_body = collected.bodies[0u32]
  let body = match inferred.body(hir_body.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let mut count = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < body.diagnostic_count() {
      match body.diagnostic_at(current) {
        SelfHostBodyInferenceDiagnostic::NoMatchingOperator(_, _) => {
          count = count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(count == 1u32, "missing operator diagnostic")
}

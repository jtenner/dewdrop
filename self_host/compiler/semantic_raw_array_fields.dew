// Raw array identity comes from checked instruction declarations, never names.
// Concrete field heaps precede their dependent nominal fragments. A generic
// element keeps the declared generic field's explicit reference erasure.
fn self_host_wasmgc_plan_raw_array_fields(
  module_: SelfHostPlannedModuleLowering,
  required: Map<U64, Bool>,
  raw_arrays: Map<U64, Bool>,
  physical: Array<SelfHostPlannedWasmPhysicalType>,
  field_start: U32,
) -> Map<U64, U32> {
  let result = Map::empty()
  let heaps = Map::empty()
  for field in module_.type_layouts.fields {
    if required.contains_key(field.declaration) {
      self_host_assert_declared_storage_type(module_.resolved_types, field.field, field.type_)
      let resolved = module_.resolved_types
      match resolved.types[field.type_] {
        AppliedType(base, arguments) => match resolved.types[base] {
          NominalType(owner) => if raw_arrays.contains_key(owner) && arguments.length == 1u32 {
            let element = resolved.type_arguments[arguments.start]
            let shape = self_host_planned_resolved_value_shape(resolved, element)
            if !(shape is GenericPlannedValueShape) {
              let _ = self_host_assert_compiler_invariant_with_failure(
                self_host_raw_array_storage_carrier(shape) is Some(_),
                self_host_declared_storage_failure(resolved, field.field, field.type_, element, 301u32, 0u32, 4u32),
                "raw array field requires a concrete element storage type",
              )
              let storage = match self_host_wasmgc_storage_type(shape) {
                WasmI8SignedStorage => WasmI8UnsignedStorage
                WasmI16SignedStorage => WasmI16UnsignedStorage
                value => value
              }
              let code = self_host_program_representation_storage_code(storage)
              let index = match heaps.get(code) {
                Some(value) => value
                None => {
                  let index = physical.length()
                  physical.push({
                    kind: PlannedWasmRawArrayType(storage)
                    type_index: index
                    fields: {
                      start: field_start
                      length: 0u32
                    }
                    offset: field.offset
                  })
                  heaps.set(code, index)
                  index
                }
              }
              result.set(field.field, index)
            }
          }
          _ => {}
        }
        _ => {}
      }
    }
  }
  result
}

fn self_host_wasmgc_exact_field_storage(module_: SelfHostPlannedModuleLowering, field: SelfHostPlannedFieldLayout, arrays: Map<U64, U32>) -> SelfHostPlannedWasmStorageType {
  match arrays.get(field.field) {
    Some(index) => WasmRawArrayRefStorage(index)
    None => self_host_wasmgc_field_storage_type(module_, field)
  }
}

// Resolve only the saved fragment identity. Missing, duplicate, forward, or
// wrong-kind targets cannot become an ordinary eqref field.
fn self_host_linked_raw_array_field_type(link: SelfHostPlannedProgramWasmGCLink, owner: U32, fragment: U32, before: U32) -> Option<U32> {
  if owner >= link.fragments.modules.length() {
    return None
  }
  let module_ = link.fragments.modules[owner]
  if fragment >= module_.physical_types.length() {
    return None
  }
  let physical = module_.physical_types[fragment]
  if physical.type_index != fragment || physical.fields.length != 0u32 ||
    !(physical.kind is PlannedWasmRawArrayType(_)) {
    return None
  }
  let mut selected = None
  for linked in link.types {
    if linked.module_index == owner && linked.fragment_index == fragment {
      if selected is Some(_) || linked.type_index >= before || linked.type_index >= link.types.length() {
        return None
      }
      selected = Some(linked.type_index)
    }
  }
  selected
}

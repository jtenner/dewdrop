fn self_host_physical_scratch_failure(module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, phase: U32, code: U32, expected: U64, actual: U64, detail: U64) -> Never {
  let _ = self_host_assert_compiler_invariant_with_failure(false, SelfHostInvariantFailure::{
    code: code
    phase: phase
    module_id: module_.module_id
    declaration: body.declaration
    body: body.body
    expression: expression
    expected: expected
    actual: actual
    detail: detail
  }, "physical temporary values require unique frozen carrier evidence")
  unreachable()
}

fn self_host_physical_scratch_body(canonical: Option<SelfHostPlannedPhysicalBodyCarrierPlan>, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, ordinal: U32) -> SelfHostPlannedPhysicalBodyCarrierPlan {
  if !self_host_array_span_is_valid(body.expressions.start, body.expressions.length, module_.expressions.length()) {
    self_host_physical_scratch_failure(module_, body, expression, 7u32, 101u32,
      u32_into_u64(module_.expressions.length()), u32_into_u64(body.expressions.length), u32_into_u64(body.expressions.start))
  }
  let _ = self_host_body_expression_slot(body, expression)
  let plan = match canonical {
    Option::Some(value) => value
    Option::None => self_host_physical_scratch_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, u32_into_u64(ordinal))
  }
  plan
}

fn self_host_require_physical_scratch(plan: SelfHostPlannedPhysicalBodyCarrierPlan, module_: SelfHostPlannedModuleLowering, body: SelfHostPlannedBodyLowering, expression: U32, ordinal: U32, expected: SelfHostWasmBodyCarrier) -> SelfHostPlannedPhysicalValueInfo {
  if expected is SelfHostWasmBodyCarrier::UnresolvedBodyCarrier || expected is SelfHostWasmBodyCarrier::ConflictingBodyCarrier || expected is SelfHostWasmBodyCarrier::UnitBodyCarrier || expected is SelfHostWasmBodyCarrier::NeverBodyCarrier {
    self_host_physical_scratch_failure(module_, body, expression, 7u32, 610u32, 1u64, self_host_body_carrier_code(expected), u32_into_u64(ordinal))
  }
  let mut selected = Option::None
  for scratch in plan.scratches {
    if scratch.expression == expression && scratch.ordinal == ordinal {
      if selected is Option::Some(_) {
        self_host_physical_scratch_failure(module_, body, expression, 7u32, 610u32, 1u64, 2u64, u32_into_u64(ordinal))
      }
      if !self_host_body_carrier_equal(expected, scratch.value.carrier) {
        self_host_physical_scratch_failure(module_, body, expression, 7u32, 710u32,
          self_host_body_carrier_code(expected), self_host_body_carrier_code(scratch.value.carrier), u32_into_u64(ordinal))
      }
      if !self_host_body_carrier_equal(scratch.value.carrier, scratch.carrier) {
        self_host_physical_scratch_failure(module_, body, expression, 7u32, 710u32,
          self_host_body_carrier_code(scratch.value.carrier), self_host_body_carrier_code(scratch.carrier), u32_into_u64(ordinal))
      }
      selected = Option::Some(scratch.value)
    }
  }
  match selected {
    Option::Some(value) => value
    Option::None => self_host_physical_scratch_failure(module_, body, expression, 7u32, 610u32, 1u64, 0u64, u32_into_u64(ordinal))
  }
}

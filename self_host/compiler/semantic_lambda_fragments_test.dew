open dew.std.testing
open dew.std.option

fn self_host_lambda_fragment_fixture() -> SelfHostPlannedModuleLowering {
  let lowering = self_host_physical_test_lowering(
    b"struct Item {\n  value: I64\n}\npub fn maker() -> fn(I32, Unit, I64) -> I64 {\n  fn(left: I32, effect: Unit, right: I64) -> I64 {\n    right\n  }\n}\n",
  )
  lowering.modules[0u32]
}

fn self_host_lambda_test_parameter_count(lambda: SelfHostPlannedLambdaLowering, count: U32) -> SelfHostPlannedLambdaLowering {
  SelfHostPlannedLambdaLowering::{
    lambda: lambda.lambda
    root_body: lambda.root_body
    parameter_count: count
    root: lambda.root
    root_type: lambda.root_type
    root_shape: lambda.root_shape
    result_shape: lambda.result_shape
    flow: lambda.flow
    locals: lambda.locals
    local_initializers: lambda.local_initializers
    local_assignments: lambda.local_assignments
    captures: lambda.captures
    expressions: lambda.expressions
    blocks: lambda.blocks
    patterns: lambda.patterns
    pattern_arms: lambda.pattern_arms
  }
}

test "lambda fragments preserve declaration identity and erase Unit parameters in order" {
  let module_ = self_host_lambda_fragment_fixture()
  assert(module_.inferred.diagnostics.length() == 0u32, "valid lambda source")
  let lambda = module_.lambdas[0u32]
  let functions = []
  let values = []
  self_host_wasmgc_append_lambda_function(module_, lambda, functions, values)
  assert(values.length() == 4u32, "environment, two scalar parameters, one result")
  assert(values[0u32] is SelfHostPlannedWasmValueType::WasmNullableEqRefValue, "environment first")
  assert(values[1u32] is SelfHostPlannedWasmValueType::WasmI32Value, "first logical parameter")
  assert(values[2u32] is SelfHostPlannedWasmValueType::WasmI64Value, "third logical parameter")
  assert(values[3u32] is SelfHostPlannedWasmValueType::WasmI64Value, "result")
  match self_host_program_specialization_body(module_, lambda.root_body) {
    Option::Some(owner) => {
      assert(self_host_u64_equal(functions[0u32].declaration, owner.declaration), "stored identity is the owning declaration")
      assert(!self_host_u64_equal(owner.declaration, lambda.root_body), "fixture distinguishes body and declaration IDs")
    }
    Option::None => assert(false, "lambda owner is required")
  }
}

test "FRG-401 lambda parameters cannot exceed their local span" expect_trap "unreachable" {
  let module_ = self_host_lambda_fragment_fixture()
  let lambda = self_host_lambda_test_parameter_count(module_.lambdas[0u32], 4u32)
  self_host_wasmgc_append_lambda_function(module_, lambda, [], [])
}

test "FRG-401 lambda parameters require parameter locals" expect_trap "unreachable" {
  let module_ = self_host_lambda_fragment_fixture()
  let lambda = module_.lambdas[0u32]
  let local = self_host_body_planned_local_identity(module_.locals[lambda.locals.start])
  module_.locals[lambda.locals.start] = SelfHostPlannedLocal::{
    body: local.body
    lambda: local.lambda
    local_id: local.local_id
    kind: SelfHostBodyLocalKind::LetLocal
    mutable_: local.mutable_
    type_: local.type_
    shape: local.shape
    nominal: local.nominal
    offset: local.offset
  }
  self_host_wasmgc_append_lambda_function(module_, lambda, [], [])
}

fn self_host_assert_erased_parameter_slots(plan: SelfHostPlannedPhysicalBodyCarrierPlan) -> Unit {
  assert(plan.local_slots.length() == 3u32, "three logical parameters")
  assert(self_host_u32_equal(plan.physical_local_count, 1u32), "one physical parameter")
  assert(self_host_u32_equal(plan.local_slots[0u32], 4294967295u32), "first Unit is erased")
  assert(self_host_u32_equal(plan.local_slots[1u32], 0u32), "I64 uses the first physical slot")
  assert(self_host_u32_equal(plan.local_slots[2u32], 4294967295u32), "last Unit is erased")
  assert(plan.local_values[0u32].carrier is SelfHostWasmBodyCarrier::UnitBodyCarrier, "Unit does not borrow the next parameter's carrier")
  assert(plan.local_values[1u32].carrier is SelfHostWasmBodyCarrier::I64BodyCarrier, "scalar retains its own carrier")
}

test "frozen parameter slots omit Unit without shifting scalar carriers" {
  let fragments = self_host_physical_test_fragments(b"pub fn select(left: Unit, value: I64, right: Unit) -> I64 {\n  value\n}\n")
  let plan = self_host_plan_program_wasm_bodies(self_host_plan_program_wasmgc_link(fragments, false))
  assert(plan.diagnostics.length() == 0u32, "valid erased signature")
  self_host_assert_erased_parameter_slots(plan.bodies[0u32])
}

test "ARN-103 frozen physical local slots remain parallel" expect_trap "unreachable" {
  let fragments = self_host_physical_test_fragments(b"pub fn select(left: Unit, value: I64, right: Unit) -> I64 {\n  value\n}\n")
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let plan = self_host_plan_program_wasm_bodies(link)
  let body = plan.bodies[0u32]
  let _ = body.local_slots.pop()
  self_host_verify_one_physical_body(link, body, [])
}

fn self_host_assert_generic_lambda_fragments(module_: SelfHostPlannedModuleWasmGCFragments) -> Unit {
  let mut closure_count = 0u32
  let mut entry_count = 0u32
  let mut unit_entries = 0u32
  for type_ in module_.physical_types {
    match type_.kind {
      SelfHostPlannedWasmPhysicalTypeKind::PlannedWasmLambdaClosureType(lambda, request) => {
        assert(self_host_u32_equal(lambda, 0u32), "one source lambda")
        assert(!self_host_u32_equal(request, 4294967295u32), "no unspecialized generic environment")
        closure_count = closure_count + 1u32
      }
      _ => {}
    }
  }
  for function_ in module_.functions {
    match function_.kind {
      SelfHostPlannedWasmFunctionKind::PlannedWasmDefinedLambdaFunction(_) => {
        assert(!self_host_u32_equal(function_.specialization, 4294967295u32), "entry carries its owning request")
        assert(self_host_u32_equal(function_.parameters.length, 1u32), "only the environment parameter")
        if self_host_u32_equal(function_.results.length, 0u32) {
          unit_entries = unit_entries + 1u32
        }
        entry_count = entry_count + 1u32
      }
      _ => {}
    }
  }
  assert(closure_count == 3u32 && entry_count == 3u32 && unit_entries == 1u32, "I32, I64, and Unit require three exact closure entries")
}

test "generic lambdas retain separate scalar and Unit specialization identities" {
  let fragments = self_host_physical_test_fragments(b"fn maker<t>(held: t) -> fn() -> t {\n  fn() -> t {\n    held\n  }\n}\npub fn run(value: I64) -> I64 {\n  let first = maker::<I32>(7i32)\n  let second = maker::<I64>(value)\n  let third = maker::<Unit>(())\n  first()\n  third()\n  second()\n}\n")
  self_host_assert_generic_lambda_fragments(fragments.modules[0u32])
}

fn self_host_test_closure_target_mutation(link: SelfHostPlannedProgramWasmGCLink, plan: SelfHostPlannedPhysicalBodyCarrierPlan) -> Unit {
  let module_ = self_host_linked_lowering_module_at(link, plan.module_index)
  let mut index = 0u32
  let mut checked = false
  while index {
    _ => if index < plan.expressions.length() {
      let source = self_host_body_physical_expression_at(plan.expressions, index)
      match module_.expressions[source.expression].kind {
        SelfHostPlannedExpressionKind::PlannedLambdaClosure(lambda) => {
          assert(self_host_lambda_construction_target_matches(link, plan, source, lambda), "valid construction target")
          plan.expressions[index] = SelfHostPlannedPhysicalExpressionCarrier::{
            expression: source.expression
            value: source.value
            carrier: source.carrier
            conflict_expected: source.conflict_expected
            conflict_actual: source.conflict_actual
            receiver_expression: source.receiver_expression
            receiver_logical_type: source.receiver_logical_type
            receiver_nominal_owner: source.receiver_nominal_owner
            receiver_physical_heap_type: source.receiver_physical_heap_type
            selected_field: source.selected_field
            selected_type_index: source.selected_type_index
            selected_field_index: source.selected_field_index
            selected_storage: source.selected_storage
            call_function_index: plan.physical_function_index - 2u32
          }
          assert(!self_host_lambda_construction_target_matches(link, plan, plan.expressions[index], lambda), "a parent function cannot replace the lambda entry")
          checked = true
        }
        _ => {}
      }
      index = index + 1u32
      continue index
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(checked, "fixture has a closure construction")
  let diagnostics = []
  self_host_verify_one_physical_body(link, plan, diagnostics)
  assert(diagnostics.length() == 1u32, "one target mutation has one diagnostic")
  assert(self_host_u32_equal(diagnostics[0u32].code, 607u32), "BOD-607 identifies the wrong closure target")
}

test "frozen closure construction rejects a different entry function" {
  let fragments = self_host_physical_test_fragments(b"pub fn maker() -> fn() -> I64 {\n  fn() -> I64 {\n    42i64\n  }\n}\n")
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let plan = self_host_plan_program_wasm_bodies(link)
  self_host_test_closure_target_mutation(link, plan.bodies[0u32])
}

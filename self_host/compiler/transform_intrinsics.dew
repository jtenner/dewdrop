fn ct_raw_bits(machine: CtMachine, value: CtValue) -> U64 {
  match value {
    Number(bits, kind) if kind == "I8" || kind == "I16" => unsafe_bitcast::<I64, U64>(ct_signed(bits, kind))
    Number(bits, _) => bits
    Boolean(value) => if value {
      1u64
    } else {
      0u64
    }
    DefaultValue => 0u64
    _ => {
      let _ = ct_fail(machine, "Wasm integer intrinsic requires an integer")
      0u64
    }
  }
}

fn ct_intrinsic_result(machine: CtMachine, value: CtValue, kind: String) -> CtValue {
  if machine.flow != 0u32 || machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  if kind.starts_with("unsupported:") {
    return ct_fail(machine, "unsupported scalar type at compile time: ".concat(kind.slice(12u32, kind.byte_length())))
  }
  if kind == "Never" {
    return ct_fail(machine, "uninhabited type has no compile-time value")
  }
  if value is DefaultValue && kind == "Unit" {
    return CtValue::Empty
  }
  if value is DefaultValue && kind.starts_with("unit-product:") {
    return ct_unit_product_default(machine, kind.slice(13u32, kind.byte_length()))
  }
  if kind == "nullable" || kind == "function" || kind.starts_with("trait:") || kind.starts_with("array:") {
    if value is DefaultValue {
      return CtValue::NullValue
    }
    let _ = ct_reference_is_null(machine, value)
  }
  if (value is DefaultValue || value is NullValue) && (kind.starts_with("record:") || kind == "product" || kind == "String" || kind == "Bytes" || kind == "StringView" || kind == "StringBuilder" || kind == "BytesBuilder") {
    return ct_fail(machine, "null reference read requires a non-null value at compile time")
  }
  match value {
    RawArray(storage) if kind.starts_with("array:") => {
      storage.default_kind = kind.slice(6u32, kind.byte_length())
      return value
    }
    _ => {
    }
  }
  if kind == "product" || kind.starts_with("unit-product:") {
    match value {
      Sequence(_) => return value
      _ => return ct_fail(machine, "product value has an incompatible checked carrier")
    }
  }
  if kind == "F32" || kind == "F64" {
    match value {
      DefaultValue => return CtValue::Floating(0u64, kind)
      Floating(_, actual) if kind == actual => return value
      _ => return ct_fail(machine, "floating-point value has an incompatible checked carrier")
    }
  }
  if kind == "V128" && value is DefaultValue {
    return CtValue::Vector(0u64, 0u64)
  }
  if !ct_check_intrinsic_result_carrier(machine, value, kind) {
    return CtValue::Empty
  }
  if kind == "Bool" {
    // Bool has a full i32 carrier; only canonical 0/1 use Boolean.
    let bits = ct_raw_bits(machine, value) & 4294967295u64
    return if bits <= 1u64 {
      CtValue::Boolean(bits == 1u64)
    } else {
      CtValue::Number(bits, "Bool")
    }
  }
  for candidate in ["I8", "U8", "I16", "U16", "I32", "U32", "I64", "U64"] {
    if kind == candidate {
      return ct_number(ct_raw_bits(machine, value), kind)
    }
  }
  value
}

fn ct_typed_intrinsic(machine: CtMachine, builtin_: SelfHostBuiltinDeclaration, args: Array<CtValue>, kind: String) -> CtValue {
  if machine.error.byte_length() != 0u32 || machine.flow != 0u32 {
    return CtValue::Empty
  }
  let args = ct_intrinsic_arguments(machine, builtin_, args)
  if machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  if !ct_check_intrinsic_contract(machine, builtin_.builtin_name.to_string(), args, kind) {
    return CtValue::Empty
  }
  if builtin_.builtin_name.equals(b"ref_is_null") {
    let mut valid = false
    for carrier in ["Bool", "I8", "U8", "I16", "U16", "I32", "U32"] {
      if kind == carrier {
        valid = true
      }
    }
    if !valid {
      return ct_fail(machine, "Wasm null test requires an i32 result carrier")
    }
  }
  if builtin_.builtin_name.to_string() == "ref.cast" && args.length() == 1u32 {
    let _ = ct_charge(machine, 16u32)
    return ct_reference_cast(machine, args[0u32], kind)
  }
  if builtin_.builtin_name.to_string() == "unsafe.bitcast" && args.length() == 1u32 {
    match args[0u32] {
      Floating(_, actual) if kind == actual => {
        let _ = ct_charge(machine, 16u32)
        return args[0u32]
      }
      _ => {}
    }
  }
  if builtin_.builtin_name.to_string() == "unsafe.bitcast" && args.length() == 1u32 && args[0u32] is Vector(_, _) && kind == "V128" {
    let _ = ct_charge(machine, 16u32)
    return args[0u32]
  }
  ct_intrinsic_values(machine, builtin_, args)
}

fn ct_intrinsic(machine: CtMachine, builtin_: SelfHostBuiltinDeclaration, args: Array<CtValue>) -> CtValue {
  let args = ct_intrinsic_arguments(machine, builtin_, args)
  if machine.error.byte_length() != 0u32 {
    return CtValue::Empty
  }
  ct_intrinsic_values(machine, builtin_, args)
}

fn ct_intrinsic_values(machine: CtMachine, builtin_: SelfHostBuiltinDeclaration, args: Array<CtValue>) -> CtValue {
  if !ct_charge(machine, 16u32) || machine.flow != 0u32 {
    return CtValue::Empty
  }
  let opcode = builtin_.builtin_name.to_string()
  if ct_memory_opcode(opcode) is Some(code) {
    return ct_memory_instruction(machine, code, args)
  }
  if ct_float_opcode(opcode) {
    return ct_float_intrinsic(machine, opcode, args)
  }
  if opcode == "ref_null" && args.length() == 0u32 {
 return CtValue::NullValue
 }
  if opcode == "ref_is_null" && args.length() == 1u32 {
 return CtValue::Boolean(ct_reference_null_test(machine, args[0u32]))
 }
  if opcode == "ref_as_non_null" && args.length() == 1u32 {
    if ct_reference_is_null(machine, args[0u32]) {
 return ct_fail(machine, "null reference assertion trap at compile time")
 }
    return args[0u32]
  }
  if opcode == "ref.eq" && args.length() == 2u32 {
    return ct_reference_equal(machine, args[0u32], args[1u32])
  }
  if ct_scalar_bit_opcode(opcode) {
    return ct_scalar_bit_intrinsic(machine, opcode, args)
  }
  if ct_vector_opcode(opcode) {
    return ct_vector_intrinsic(machine, opcode, args)
  }
  match ct_raw_immediate(opcode, "struct.get ") {
    Some(index) if args.length() == 1u32 => return ct_raw_struct_get(machine, args[0u32], index)
    _ => {}
  }
  if opcode == "array.len" && args.length() == 1u32 {
    return ct_number(ct_raw_array_length(machine, args[0u32]), "U32")
  }
  if opcode == "array.get" && args.length() == 2u32 {
    return ct_raw_array_get(machine, args[0u32], ct_raw_bits(machine, args[1u32]))
  }
  if opcode == "array.copy" && args.length() == 5u32 {
    return ct_raw_array_copy(machine, args[0u32], ct_raw_bits(machine, args[1u32]), args[2u32], ct_raw_bits(machine, args[3u32]), ct_raw_bits(machine, args[4u32]))
  }
  if opcode == "unreachable" {
    return ct_fail(machine, "unreachable executed at compile time")
  }
  if (opcode == "array.new_default" || opcode == "array.new") && args.length() > 0u32 {
    let count = ct_raw_bits(machine, args[0u32])
    if count > u32_into_u64((4194304u32 - machine.allocated) / 16u32) {
      return ct_fail(machine, "transform allocation limit exceeded")
    }
    if !ct_charge(machine, u64_into_u32(count) * 16u32) {
      return CtValue::Empty
    }
    let value = if args.length() == 2u32 {
      args[1u32]
    } else {
      CtValue::DefaultValue
    }
    let result = array_new::<CtValue>()
    let _ = while 0u32 {
      i if u32_into_u64(i) < count => {
        result.push(value)
        continue i + 1u32
      }
      _ => break ()
    }
    return CtValue::RawArray(CtRawStorage::{
      values: result
      default_kind: ""
    })
  }
  if opcode == "array.set" && args.length() == 3u32 {
    match args[0u32] {
      RawArray(storage) => {
        let index = ct_raw_bits(machine, args[1u32])
        if index >= u32_into_u64(storage.values.length()) {
          return ct_fail(machine, "Wasm array index out of bounds at compile time")
        }
        storage.values[u64_into_u32(index)] = args[2u32]
        return CtValue::Empty
      }
      _ => return ct_fail(machine, "Wasm array write requires mutable array storage")
    }
  }
  let result = if args.length() == 1u32 {
    let bits = ct_raw_bits(machine, args[0u32])
    if opcode == "unsafe.bitcast" {
      args[0u32]
    } else if opcode == "i32.extend8_s" {
      ct_number(unsafe_bitcast::<I64, U64>(unsafe_bitcast::<U64, I64>(bits) << 56i64 >> 56i64) & 4294967295u64, "I32")
    } else if opcode == "i32.extend16_s" {
      ct_number(unsafe_bitcast::<I64, U64>(unsafe_bitcast::<U64, I64>(bits) << 48i64 >> 48i64) & 4294967295u64, "I32")
    } else if opcode == "i32.wrap_i64" {
      ct_number(bits & 4294967295u64, "I32")
    } else if opcode == "i64.extend_i32_u" {
      ct_number(bits & 4294967295u64, "U64")
    } else if opcode == "i64.extend_i32_s" {
      ct_number(unsafe_bitcast::<I64, U64>(unsafe_bitcast::<U64, I64>(bits) << 32i64 >> 32i64), "I64")
    } else if opcode == "i32.eqz" || opcode == "i64.eqz" {
      CtValue::Boolean(bits == 0u64)
    } else {
      return ct_fail(machine, "unsupported Wasm intrinsic at compile time: ".concat(opcode))
    }
  } else if args.length() == 2u32 && (opcode.starts_with("i32.") || opcode.starts_with("i64.")) {
    let kind = if opcode.starts_with("i64.") {
      if opcode.ends_with("_u") {
        "U64"
      } else {
        "I64"
      }
    } else {
      if opcode.ends_with("_u") {
        "U32"
      } else {
        "I32"
      }
    }
    let left = ct_number(ct_raw_bits(machine, args[0u32]), kind)
    let right = ct_number(ct_raw_bits(machine, args[1u32]), kind)
    let op = if opcode.ends_with(".add") {
      Add
    } else if opcode.ends_with(".sub") {
      Subtract
    } else if opcode.ends_with(".mul") {
      Multiply
    } else if opcode.ends_with(".and") {
      BitAnd
    } else if opcode.ends_with(".or") {
      BitOr
    } else if opcode.ends_with(".shl") {
      ShiftLeft
    } else if opcode.ends_with(".shr_s") || opcode.ends_with(".shr_u") {
      ShiftRight
    } else if opcode.ends_with(".xor") {
      BitXor
    } else if opcode.ends_with(".eq") {
      Equal
    } else if opcode.ends_with(".ne") {
      NotEqual
    } else if opcode.ends_with(".lt_s") || opcode.ends_with(".lt_u") {
      Less
    } else if opcode.ends_with(".le_s") || opcode.ends_with(".le_u") {
      LessEqual
    } else if opcode.ends_with(".gt_s") || opcode.ends_with(".gt_u") {
      Greater
    } else if opcode.ends_with(".ge_s") || opcode.ends_with(".ge_u") {
      GreaterEqual
    } else if opcode.ends_with(".div_s") || opcode.ends_with(".div_u") {
      Divide
    } else if opcode.ends_with(".rem_s") || opcode.ends_with(".rem_u") {
      Remainder
    } else {
      return ct_fail(machine, "unsupported Wasm integer intrinsic: ".concat(opcode))
    }
    ct_binary(machine, op, left, right)
  } else {
    return ct_fail(machine, "unsupported Wasm intrinsic at compile time: ".concat(opcode))
  }
  result
}

// Work queue state is explicit: propagate, audit every rule, then complete.
// The audit uses the same transfer code as propagation. A changing audit rule
// is a missing dependency or a non-idempotent transfer, never a late repair.
struct SelfHostBodyWorkQueue {
  graph: SelfHostBodyWorkGraph
  queue: Array<U32>
  pending: Array<Bool>
  module_id: U64
  declaration: U64
  body: U64
  expressions: SelfHostHirSpan
  mut head: U32
  mut active: U32
  mut auditing: Bool
  mut complete: Bool
  mut audited_items: U32
  mut successful_changes: U64
  maximum_changes: U64
}

fn self_host_body_work_queue_check(
  work: SelfHostBodyWorkQueue,
  condition: Bool,
  code: U32,
  role: U32,
  item: U32,
  expected: U64,
  actual: U64,
) -> Unit {
  if !condition {
    let expression = if item <= work.expressions.length && work.expressions.length > 0u32 {
      if item == 0u32 {
        work.expressions.start
      } else {
        work.expressions.start + (item - 1u32)
      }
    } else {
      4294967295u32
    }
    let _ = self_host_assert_compiler_invariant_with_failure(false,
      SelfHostInvariantFailure::{
        code: code
        phase: 6u32
        module_id: work.module_id
        declaration: work.declaration
        body: work.body
        expression: expression
        expected: expected
        actual: actual
        detail: (u32_into_u64(role) << 32u64) | u32_into_u64(item)
      }, "physical carrier work queue contract")
  }
}

fn self_host_body_verify_work_graph(work: SelfHostBodyWorkQueue) -> Unit {
  let graph = work.graph
  self_host_body_work_queue_check(work, graph.targets.length() == graph.next.length(),
    103u32, 10u32, 4294967295u32,
    u32_into_u64(graph.targets.length()), u32_into_u64(graph.next.length()))
  self_host_body_work_queue_check(work,
    u32_into_u64(work.expressions.length) + 1u64 <= u32_into_u64(graph.heads.length()),
    103u32, 14u32, 4294967295u32,
    u32_into_u64(work.expressions.length) + 1u64, u32_into_u64(graph.heads.length()))
  let _ = while 0u32 {
    item => if item < graph.heads.length() {
      let edge = graph.heads[item]
      self_host_body_work_queue_check(work, edge == 4294967295u32 || edge < graph.targets.length(),
        101u32, 11u32, item, u32_into_u64(graph.targets.length()), u32_into_u64(edge))
      continue item + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let _ = while 0u32 {
    edge => if edge < graph.targets.length() {
      self_host_body_work_queue_check(work, graph.targets[edge] < graph.heads.length(),
        101u32, 12u32, edge, u32_into_u64(graph.heads.length()), u32_into_u64(graph.targets[edge]))
      // Edges are appended with a link to the previous head. A next index must
      // strictly decrease. This proves that every adjacency walk terminates.
      self_host_body_work_queue_check(work,
        graph.next[edge] == 4294967295u32 || graph.next[edge] < edge,
        104u32, 13u32, edge, u32_into_u64(edge), u32_into_u64(graph.next[edge]))
      continue edge + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
}

fn self_host_body_work_queue_new(
  graph: SelfHostBodyWorkGraph,
  module_id: U64,
  declaration: U64,
  body: U64,
  expressions: SelfHostHirSpan,
) -> SelfHostBodyWorkQueue {
  let pending = []
  let _ = while 0u32 {
    item => if item < graph.heads.length() {
      pending.push(false)
      continue item + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let work = SelfHostBodyWorkQueue::{
    graph: graph
    queue: []
    pending: pending
    module_id: module_id
    declaration: declaration
    body: body
    expressions: expressions
    head: 0u32
    active: 4294967295u32
    auditing: false
    complete: false
    audited_items: 0u32
    successful_changes: 0u64
    // A resource guard, not a fixed-pass convergence claim. The U64 product
    // cannot wrap for a U32 node count. Reaching it is always diagnostic.
    maximum_changes: u32_into_u64(graph.heads.length()) * 64u64
  }
  self_host_body_verify_work_graph(work)
  self_host_body_schedule_work_item(work.queue, work.pending, 0u32)
  let _ = while expressions.length {
    remaining => if remaining > 0u32 {
      self_host_body_schedule_work_item(work.queue, work.pending, remaining)
      continue remaining - 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  work
}

fn self_host_body_work_queue_next(work: SelfHostBodyWorkQueue) -> Option<U32> {
  self_host_body_work_queue_check(work, work.active == 4294967295u32,
    604u32, 1u32, work.active, 4294967295u64, u32_into_u64(work.active))
  if work.complete {
    self_host_body_work_queue_check(work,
      work.auditing && work.audited_items == work.graph.heads.length() && work.head == work.queue.length(),
      604u32, 8u32, 4294967295u32,
      u32_into_u64(work.graph.heads.length()), u32_into_u64(work.audited_items))
    return Option::None
  }
  self_host_body_work_queue_check(work, work.head <= work.queue.length(),
    101u32, 6u32, 4294967295u32, u32_into_u64(work.queue.length()), u32_into_u64(work.head))
  if work.head == work.queue.length() && !work.auditing {
    let _ = while 0u32 {
      item => if item < work.pending.length() {
        self_host_body_work_queue_check(work, !work.pending[item],
          604u32, 5u32, item, 0u64, 1u64)
        continue item + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    work.auditing = true
    self_host_body_schedule_all_work_items(work.queue, work.pending)
  }
  if work.head == work.queue.length() {
    self_host_body_work_queue_check(work, work.auditing && work.audited_items == work.graph.heads.length(),
      604u32, 8u32, 4294967295u32,
      u32_into_u64(work.graph.heads.length()), u32_into_u64(work.audited_items))
    work.complete = true
    return Option::None
  }
  let item = work.queue[work.head]
  self_host_body_work_queue_check(work, item < work.pending.length(),
    101u32, 7u32, item, u32_into_u64(work.pending.length()), u32_into_u64(item))
  self_host_body_work_queue_check(work, work.pending[item],
    604u32, 5u32, item, 1u64, 0u64)
  work.pending[item] = false
  work.head = work.head + 1u32
  work.active = item
  Option::Some(item)
}

fn self_host_body_work_queue_finish(work: SelfHostBodyWorkQueue, item: U32, changed: Bool) -> Unit {
  self_host_body_work_queue_check(work, work.active == item && item != 4294967295u32,
    604u32, 2u32, item, u32_into_u64(work.active), u32_into_u64(item))
  if work.auditing {
    self_host_body_work_queue_check(work, !changed,
      604u32, 0u32, item, 0u64, 1u64)
    work.audited_items = work.audited_items + 1u32
  } else {
    if changed {
      work.successful_changes = work.successful_changes + 1u64
      self_host_body_work_queue_check(work, work.successful_changes <= work.maximum_changes,
        604u32, 4u32, item, work.maximum_changes, work.successful_changes)
    }
    if changed || item > work.expressions.length {
      self_host_body_schedule_work_dependents(work.graph, work.queue, work.pending, item)
    }
    if changed {
      // A transfer may read its own output. Its self-dependency is required
      // even when no other node changes and wakes it again.
      self_host_body_schedule_work_item(work.queue, work.pending, item)
    }
  }
  work.active = 4294967295u32
}

test "function handle decoding uses the actual linked index" {
  for logical in [0u32, 1u32, 15u32, 16u32, 17u32, 4294967292u32] {
    let handle = self_host_linked_physical_function_index(logical)
    assert(handle == logical + 2u32, "internal handles retain their two reserved slots")
    assert(self_host_linked_emitted_function_index(handle) == logical, "emitted indices cannot include hidden imports")
  }
}

test "ARN-105 emitted function rejects zero handle" expect_trap "unreachable" {
  assert(self_host_linked_emitted_function_index(2u32) == 0u32, "valid handle before mutation")
  let _ = self_host_linked_emitted_function_index(0u32)
}

test "ARN-105 emitted function rejects reserved handle" expect_trap "unreachable" {
  assert(self_host_linked_emitted_function_index(3u32) == 1u32, "valid handle before mutation")
  let _ = self_host_linked_emitted_function_index(1u32)
}

test "ARN-105 emitted function rejects missing handle" expect_trap "unreachable" {
  assert(self_host_linked_emitted_function_index(3u32) == 1u32, "valid handle before mutation")
  let _ = self_host_linked_emitted_function_index(4294967295u32)
}

test "LNK-502 function handle encoding preserves the missing sentinel" expect_trap "unreachable" {
  assert(self_host_linked_physical_function_index(4294967292u32) == 4294967294u32, "valid handle before mutation")
  let _ = self_host_linked_physical_function_index(4294967293u32)
}

test "invariant record keeps numeric context" {
  self_host_record_invariant_failure(
    SelfHostInvariantFailure::{
      code: 701u32
      phase: 7u32
      module_id: 11u64
      declaration: 13u64
      body: 17u64
      expression: 19u32
      expected: 23u64
      actual: 29u64
      detail: 31u64
    },
  )
  assert(
    self_host_u32_equal(self_host_invariant_failure_code(), 701u32),
    "failure code",
  )
  assert(
    self_host_u32_equal(self_host_invariant_failure_phase(), 7u32),
    "failure phase",
  )
  assert(self_host_invariant_failure_module_id() == 11u64, "failure module")
  assert(self_host_invariant_failure_declaration() == 13u64, "failure declaration")
  assert(self_host_invariant_failure_body() == 17u64, "failure body")
  assert(
    self_host_u32_equal(self_host_invariant_failure_expression(), 19u32),
    "failure expression",
  )
  assert(self_host_invariant_failure_expected() == 23u64, "failure expected")
  assert(self_host_invariant_failure_actual() == 29u64, "failure actual")
  assert(self_host_invariant_failure_detail() == 31u64, "failure detail")
  self_host_clear_invariant_failure()
}

test "INV-001 trap preserves complete numeric context" expect_trap "unreachable" {
  self_host_assert_compiler_invariant_with_failure(
    false,
    SelfHostInvariantFailure::{
      code: 701u32
      phase: 7u32
      module_id: 11u64
      declaration: 13u64
      body: 17u64
      expression: 19u32
      expected: 23u64
      actual: 29u64
      detail: 31u64
    },
    "numeric context must survive the trap",
  )
}

test "specialized call index retains exact caller keys" {
  let calls = [
    SelfHostPlannedProgramSpecializedCallLink::{
      caller_body: 17u64
      caller_specialization: 3u32
      expression: 19u32
      function_index: 23u32
    },
    SelfHostPlannedProgramSpecializedCallLink::{
      caller_body: 17u64
      caller_specialization: 4u32
      expression: 19u32
      function_index: 29u32
    },
  ]
  calls.push(calls[0u32])
  let index = self_host_build_linked_call_index([], calls)
  assert(self_host_linked_call_index_get(index, 17u64, 3u32, 19u32) is Option::Some(23u32), "first exact key")
  assert(self_host_linked_call_index_get(index, 17u64, 4u32, 19u32) is Option::Some(29u32), "different caller specialization")
  assert(self_host_linked_call_index_get(index, 18u64, 3u32, 19u32) is Option::None, "different caller body")
  assert(self_host_linked_call_index_get(index, 17u64, 3u32, 20u32) is Option::None, "different expression")
  assert(index.keys.length() == 2u32, "an identical duplicate adds no entry")
}

test "checked relative indices reject overflow and foreign ownership" {
  let span = SelfHostHirSpan::{
    start: 5u32
    length: 3u32
  }
  assert(self_host_checked_relative_index(5u32, span, 8u32) is Option::Some(0u32), "first slot")
  assert(self_host_checked_relative_index(7u32, span, 8u32) is Option::Some(2u32), "last slot")
  assert(self_host_checked_relative_index(4u32, span, 8u32) is Option::None, "below span")
  assert(self_host_checked_relative_index(8u32, span, 8u32) is Option::None, "past span")
  assert(self_host_checked_relative_index(5u32, span, 7u32) is Option::None, "span exceeds arena")
  assert(self_host_checked_relative_index(4294967294u32, SelfHostHirSpan::{
    start: 4294967294u32
    length: 2u32
  }, 4294967295u32) is Option::None, "span end must not overflow")
  assert(self_host_checked_relative_index(4294967294u32, SelfHostHirSpan::{
    start: 4294967294u32
    length: 1u32
  }, 4294967295u32) is Option::Some(0u32), "last representable arena slot")
  assert(self_host_checked_relative_index(5u32, SelfHostHirSpan::{
    start: 5u32
    length: 0u32
  }, 8u32) is Option::None, "empty span has no members")
}

fn self_host_relative_body_fixture() -> SelfHostPlannedBodyLowering {
  let fragments = self_host_physical_test_fragments(
    b"pub fn first() -> I32 {\n  1i32\n}\npub fn second() -> I32 {\n  2i32\n}\n",
  )
  let body = fragments.specialization.lowering.modules[0u32].bodies[1u32]
  assert(body.expressions.start == 1u32 && body.expressions.length == 1u32, "owned body span")
  assert(self_host_body_expression_slot(body, 1u32) == 0u32, "valid relative slot")
  body
}

test "ARN-102 physical expression cannot precede its body" expect_trap "unreachable" {
  let _ = self_host_body_expression_slot(self_host_relative_body_fixture(), 0u32)
}

test "ARN-102 physical expression cannot follow its body" expect_trap "unreachable" {
  let _ = self_host_body_expression_slot(self_host_relative_body_fixture(), 2u32)
}

test "ARN-102 missing expression cannot become a body slot" expect_trap "unreachable" {
  let _ = self_host_body_expression_slot(self_host_relative_body_fixture(), 4294967295u32)
}

test "ARN-101 physical body span must fit its arena" expect_trap "unreachable" {
  self_host_assert_physical_body_span(self_host_relative_body_fixture(), SelfHostHirSpan::{
    start: 2u32
    length: 1u32
  }, 2u32, 1u32)
}

test "SPC-303 one call key cannot select two targets" expect_trap "unreachable" {
  let _ = self_host_build_linked_call_index([], [
    SelfHostPlannedProgramSpecializedCallLink::{
      caller_body: 17u64
      caller_specialization: 3u32
      expression: 19u32
      function_index: 23u32
    },
    SelfHostPlannedProgramSpecializedCallLink::{
      caller_body: 17u64
      caller_specialization: 3u32
      expression: 19u32
      function_index: 29u32
    },
  ])
}

fn self_host_call_index_test_function(index: U32, lambda: U32) -> SelfHostPlannedProgramWasmFunction {
  SelfHostPlannedProgramWasmFunction::{
    module_index: 0u32
    fragment_index: index
    declaration: self_host_make_semantic_id(77u64, 11u32)
    specialization: 4294967295u32
    lambda: lambda
    function_index: index
    imported: false
  }
}

test "linked lambdas do not enter the named function index" {
  let functions = [
    self_host_call_index_test_function(3u32, 0u32),
    self_host_call_index_test_function(4u32, 4294967295u32),
    self_host_call_index_test_function(5u32, 1u32),
  ]
  let index = self_host_build_linked_call_index(functions, [])
  let declaration = self_host_make_semantic_id(77u64, 11u32)
  assert(index.plain_functions.get(declaration) is Option::Some(4u32), "only the named callable owns the declaration key")
  assert(self_host_program_link_function(functions, declaration, 4294967295u32) is Option::Some(4u32), "linear lookup also excludes lambda bodies")
}

test "LNK-504 two named physical functions cannot own one declaration" expect_trap "unreachable" {
  let _ = self_host_build_linked_call_index([
    self_host_call_index_test_function(4u32, 4294967295u32),
    self_host_call_index_test_function(5u32, 4294967295u32),
  ], [])
}

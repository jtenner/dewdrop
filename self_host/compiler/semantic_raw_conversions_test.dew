fn self_host_assert_invalid_raw_conversion(source: Bytes) -> Unit {
  let fragments = self_host_physical_test_fragments(source)
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  self_host_physical_test_assert_clean_inference(link)
  match build_self_host_linked_i32_module(link, 5100u64) {
    Result::Ok(_) => assert(false, "raw conversion accepted a wrong input")
    Result::Err(error) => assert(error.contains("raw intrinsic input or result carrier does not match its opcode"), error)
  }
}

test "raw conversion opcodes reject wrong physical inputs" {
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> I32 = \"i32.extend8_s\"\npub fn main(value: I64) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> I32 = \"i32.extend16_s\"\npub fn main(value: I64) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I32 = \"i32.wrap_i64\"\npub fn main(value: I32) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> I64 = \"i64.extend_i32_s\"\npub fn main(value: I64) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> I64 = \"i64.extend_i32_u\"\npub fn main(value: I64) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> F32 = \"f32.convert_i32_s\"\npub fn main(value: I64) -> F32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I32 = \"i32.trunc_f32_s\"\npub fn main(value: I32) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> F32 = \"f32.convert_i32_u\"\npub fn main(value: I64) -> F32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I32 = \"i32.trunc_f32_u\"\npub fn main(value: I32) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F32 = \"f32.convert_i64_s\"\npub fn main(value: I32) -> F32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I64 = \"i64.trunc_f32_s\"\npub fn main(value: I32) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F32 = \"f32.convert_i64_u\"\npub fn main(value: I32) -> F32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I64 = \"i64.trunc_f32_u\"\npub fn main(value: I32) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> F64 = \"f64.convert_i32_s\"\npub fn main(value: I64) -> F64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I32 = \"i32.trunc_f64_s\"\npub fn main(value: I32) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I64) -> F64 = \"f64.convert_i32_u\"\npub fn main(value: I64) -> F64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I32 = \"i32.trunc_f64_u\"\npub fn main(value: I32) -> I32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F64 = \"f64.convert_i64_s\"\npub fn main(value: I32) -> F64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I64 = \"i64.trunc_f64_s\"\npub fn main(value: I32) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F64 = \"f64.convert_i64_u\"\npub fn main(value: I32) -> F64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> I64 = \"i64.trunc_f64_u\"\npub fn main(value: I32) -> I64 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F32 = \"f32.demote_f64\"\npub fn main(value: I32) -> F32 {\n  convert(value)\n}\n",
  )
  self_host_assert_invalid_raw_conversion(
    b"builtin convert(value: I32) -> F64 = \"f64.promote_f32\"\npub fn main(value: I32) -> F64 {\n  convert(value)\n}\n",
  )
}

test "physical block carriers keep nonreturning let tails Never" {
  let collected = self_host_collect_program_manifest(5100u64, {
    modules: [{
      path: "app.main"
      files: [{
        path: "discard-flow.dew"
        source: b"pub fn diverging() -> String {\n  let _ = while 0u32 {\n    _ => return \"ok\"\n  }\n  \"dead\"\n}\npub fn unit() -> Unit {\n  let _ = 7i32\n}\npub fn value() -> String {\n  \"ok\"\n}\n"
        test_only: false
      }]
    }]
  })
  assert(collected.diagnostics.length() == 0u32, "discard-flow manifest parses")
  assert(collected.modules.at(0u32).diagnostic_count() == 0u32, "discard-flow source parses")
  let frozen = self_host_freeze_program_signature_interfaces(collected)
  assert(frozen.import_diagnostics.length() == 0u32 && frozen.path_diagnostics.length() == 0u32, "discard-flow imports resolve")
  let lowering = self_host_plan_program_lowering(frozen)
  match self_host_validate_program_inference(lowering) {
    Some(error) => assert(false, error)
    None => {}
  }
  let fragments = self_host_plan_program_wasmgc_fragments(self_host_plan_program_specialization(lowering, false))
  let link = self_host_plan_program_wasmgc_link(fragments, false)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, self_host_program_wasm_body_failure_report(link, program))
  let mut found_never = false
  let mut found_unit = false
  let mut found_value = false
  for plan in program.bodies {
    let module_ = self_host_program_function_lowering(link.fragments.specialization.lowering, plan.module_index, plan.specialization)
    let body = match self_host_body_lookup_for_plan(module_, plan) {
      Some(value) => value
      None => {
        assert(false, "physical source body is present")
        unreachable()
      }
    }
    match body.root {
      BlockBodyRoot(block) => {
        let carrier = self_host_body_block_carrier(module_, body, plan.expressions, block)
        if !module_.blocks[block].flow.falls_through {
          found_never = true
          assert(carrier is NeverBodyCarrier, "nonreturning let initializer cannot produce Unit at the function root")
        } else if plan.result_carrier is UnitBodyCarrier {
          found_unit = true
          assert(carrier is UnitBodyCarrier, "fallthrough discard remains Unit")
        } else {
          found_value = true
          assert(self_host_body_carrier_equal(carrier, plan.result_carrier), "ordinary string result retains its physical carrier")
        }
      }
      _ => assert(false, "fixture functions have block roots")
    }
  }
  assert(found_never && found_unit && found_value, "all three block-flow controls were checked")
}

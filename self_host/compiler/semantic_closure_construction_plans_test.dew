test "BOD-605 closure recipe tables cannot lose entries" expect_trap "unreachable" {
  let (_, plan) = self_host_simple_closure_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let _ = plan.closure_constructions.pop()
  self_host_assert_frozen_physical_body(frozen, plan)
}

test "BOD-605 closure capture tables cannot lose entries" expect_trap "unreachable" {
  let (_, plan) = self_host_simple_closure_recipe_fixture()
  let frozen = self_host_freeze_physical_body(plan)
  let _ = plan.closure_construction_captures.pop()
  self_host_assert_frozen_physical_body(frozen, plan)
}

test "ABI-701 closure recipe entry agrees before freeze" expect_trap "unreachable" {
  let (link, plan) = self_host_simple_closure_recipe_fixture()
  let (module_, body) = self_host_test_raw_array_temporary_source(link, plan)
  self_host_change_closure_recipe(plan, 3u32)
  self_host_verify_closure_recipes(link, module_, body, plan)
}

test "BOD-610 closure emission requires its recipe" expect_trap "unreachable" {
  let (link, plan) = self_host_simple_closure_recipe_fixture()
  let (module_, body) = self_host_test_raw_array_temporary_source(link, plan)
  let _ = plan.closure_constructions.pop()
  let _ = self_host_required_closure_construction(plan, module_, body, 0u32, 0u32)
}

test "BOD-610 closure emission requires a unique recipe" expect_trap "unreachable" {
  let (link, plan) = self_host_simple_closure_recipe_fixture()
  let (module_, body) = self_host_test_raw_array_temporary_source(link, plan)
  plan.closure_constructions.push(plan.closure_constructions[0u32])
  let _ = self_host_required_closure_construction(plan, module_, body, 0u32, 0u32)
}

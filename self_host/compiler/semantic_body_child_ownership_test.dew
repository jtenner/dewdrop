fn self_host_child_test_link() -> SelfHostPlannedProgramWasmGCLink {
  self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn first(value: I64) -> I64 {\n  value\n}\npub fn second(value: I64) -> I64 {\n  value\n}\n"),
    false,
  )
}

fn self_host_child_test_replace(source: SelfHostPlannedExpression, kind: SelfHostPlannedExpressionKind) -> SelfHostPlannedExpression {
  {
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    flow: source.flow
    kind: kind
    selection: source.selection
    reference: source.reference
    call_target: source.call_target
    call_type_arguments: source.call_type_arguments
    source_name: source.source_name
    member_base: source.member_base
    offset: source.offset
  }
}

fn self_host_child_test_verify(kind: SelfHostPlannedExpressionKind) -> Unit {
  let link = self_host_child_test_link()
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "the source plan must be valid before mutation")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let plan = program.bodies[1u32]
  assert(module_.expressions.length() == 2u32 && plan.expressions[0u32].expression == 1u32, "second body owns only expression one")
  assert(plan.local_values.length() == 1u32, "one logical parameter")
  module_.expressions[1u32] = self_host_child_test_replace(module_.expressions[1u32], kind)
  self_host_verify_one_physical_body(link, plan, [])
}

test "ARN-104 lowered unary children cannot cross physical bodies" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedPrefixExpression(
    Negative,
    0u32,
  ))
}

test "ARN-104 required lowered children cannot be missing" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedPrefixExpression(
    Negative,
    4294967295u32,
  ))
}

test "ARN-104 only the exact lowered return sentinel can be erased" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedReturnExpression(4294967294u32))
}

test "ARN-104 lowered local reads require an owned logical slot" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedLocalGet(1u32))
}

test "ARN-104 lowered block references cannot cross physical bodies" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedBlockExpression(0u32))
}

test "ARN-101 lowered argument spans are checked before reading" expect_trap "unreachable" {
  self_host_child_test_verify(PlannedProductNew({
    start: 4294967295u32
    length: 1u32
  }))
}

test "ARN-104 an owned argument list cannot borrow another body value" expect_trap "unreachable" {
  let link = self_host_child_test_link()
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid unmodified body")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let start = module_.expression_children.length()
  module_.expression_children.push(0u32)
  module_.expressions[1u32] = self_host_child_test_replace(module_.expressions[1u32],
    PlannedProductNew({
      start: start
      length: 1u32
    }),
  )
  self_host_verify_one_physical_body(link, program.bodies[1u32], [])
}

test "ARN-101 lowered block item spans are checked before reading" expect_trap "unreachable" {
  let link = self_host_child_test_link()
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid unmodified body")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.blocks.length() == 2u32 && module_.block_items.length() == 2u32, "two single-expression blocks")
  let block = module_.blocks[1u32]
  module_.blocks[1u32] = {
    items: {
      start: 4294967295u32
      length: 1u32
    }
    flow: block.flow
    offset: block.offset
  }
  self_host_verify_one_physical_body(link, program.bodies[1u32], [])
}

test "ARN-104 physical work graphs require owned source operands" expect_trap "unreachable" {
  let link = self_host_child_test_link()
  let valid = self_host_plan_program_wasm_bodies(link)
  assert(valid.diagnostics.length() == 0u32, "valid unmodified body")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  module_.expressions[1u32] = self_host_child_test_replace(module_.expressions[1u32],
    PlannedPrefixExpression(Negative, 0u32),
  )
  let _ = self_host_plan_program_wasm_bodies(link)
}

fn self_host_child_test_reowned_local(source: SelfHostPlannedLocal, local_id: U32, body_id: U64, lambda: U32) -> SelfHostPlannedLocal {
  {
    body: body_id
    lambda: lambda
    local_id: local_id
    elided: source.elided
    kind: source.kind
    mutable_: source.mutable_
    type_: source.type_
    shape: source.shape
    nominal: source.nominal
    offset: source.offset
  }
}

fn self_host_child_test_local_identity(local_id: U32, body_id: U64, lambda: U32) -> Unit {
  let link = self_host_child_test_link()
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid unmodified body")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  assert(module_.locals.length() == 2u32, "two logical parameter entries")
  module_.locals[1u32] = self_host_child_test_reowned_local(module_.locals[1u32], local_id, body_id, lambda)
  self_host_verify_one_physical_body(link, program.bodies[1u32], [])
}

test "ARN-106 lowered locals preserve their relative identity" expect_trap "unreachable" {
  self_host_child_test_local_identity(1u32, (5100u64 << 32u64) + 1u64, 4294967295u32)
}

test "ARN-106 lowered locals preserve their source body" expect_trap "unreachable" {
  self_host_child_test_local_identity(0u32, 5100u64 << 32u64, 4294967295u32)
}

test "ARN-106 named body locals cannot belong to a lambda" expect_trap "unreachable" {
  self_host_child_test_local_identity(0u32, (5100u64 << 32u64) + 1u64, 0u32)
}

test "ARN-106 lambda locals retain their exact owner" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(
    self_host_physical_test_fragments(b"pub fn maker() -> fn(I64) -> I64 {\n  fn(value: I64) -> I64 {\n    value\n  }\n}\n"),
    false,
  )
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid unmodified closure")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut found = false
  for plan in program.bodies {
    if plan.lambda != 4294967295u32 {
      let body = match self_host_body_lookup_for_plan(module_, plan) {
        Some(value) => value
        None => unreachable()
      }
      assert(body.locals.start == 0u32 && body.locals.length == 1u32 && plan.lambda == 0u32, "one lambda parameter with no parent locals")
      let source = module_.locals[0u32]
      module_.locals[0u32] = self_host_child_test_reowned_local(source, source.local_id, source.body, 1u32)
      found = true
      self_host_verify_one_physical_body(link, plan, [])
    }
  }
  assert(found, "the fixture must verify its lambda")
}

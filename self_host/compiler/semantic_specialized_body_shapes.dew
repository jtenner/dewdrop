open dew.std.map
open dew.std.option

enum SelfHostSpecializedBodyShapeTask {
  VisitSpecializedBodyShape(I32)
  FinishSpecializedBodyShape(I32, U32, U32, Bool)
}

fn self_host_specialized_shape_active() -> Map<I32, Bool> {
  Map::empty()
}

fn self_host_specialized_shape_cache() -> Map<I32, SelfHostPlannedValueShape> {
  Map::empty()
}

// One substitution environment per walk. Cache shared nodes and keep active
// nodes separate so a cycle cannot look like a completed shape.
fn self_host_specialized_body_value_shape(
  module_: SelfHostPlannedModuleLowering,
  callable: SelfHostPlannedCallable,
  caller_shapes: SelfHostHirSpan,
  shapes: Array<SelfHostPlannedValueShape>,
  root: I32,
) -> SelfHostPlannedValueShape {
  if !self_host_array_span_is_valid(caller_shapes.start, caller_shapes.length, shapes.length()) {
    self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 101u32,
      u32_into_u64(shapes.length()), u32_into_u64(caller_shapes.length), u32_into_u64(caller_shapes.start))
  }
  let generics = self_host_program_specialization_callable_generics(callable)
  let tasks = [SelfHostSpecializedBodyShapeTask::VisitSpecializedBodyShape(root)]
  let results = self_host_specialization_results()
  let active = self_host_specialized_shape_active()
  let completed = self_host_specialized_shape_cache()
  while tasks.length() {
    length if length > 0u32 => {
      let task = match tasks.pop() {
        Option::Some(value) => value
        Option::None => {
          self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 103u32, 1u64, 0u64, 0u64)
          unreachable()
        }
      }
      match task {
        SelfHostSpecializedBodyShapeTask::FinishSpecializedBodyShape(type_, start, count, product) => {
          if start > results.length() || count != results.length() - start {
            self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 103u32,
              u32_into_u64(count), u32_into_u64(results.length()), u32_into_u64(start))
          }
          let shape = if product {
            let fields = self_host_specialization_fields()
            while 0u32 {
              index if index < count => {
                fields.push(results[start + index])
                continue index + 1u32
              }
              _ => break ()
            }
            SelfHostPlannedValueShape::ProductPlannedValueShape(fields)
          } else {
            results[start]
          }
          results.truncate(start)
          results.push(shape)
          let _ = active.remove(type_)
          completed.set(type_, shape)
        }
        SelfHostSpecializedBodyShapeTask::VisitSpecializedBodyShape(type_) => {
          match completed.get(type_) {
            Option::Some(shape) => {
              results.push(shape)
              continue tasks.length()
            }
            Option::None => {}
          }
          if active.contains_key(type_) {
            self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 108u32,
              0u64, 1u64, u32_into_u64(self_host_body_i32_to_u32(type_)))
          }
          active.set(type_, true)
          let children = self_host_local_empty_i32()
          let mut product = false
          let mut shape = SelfHostPlannedValueShape::ErrorPlannedValueShape
          if type_ < -1i32 {
            let resolved = self_host_body_i32_to_u32(-(type_ + 2i32))
            if resolved >= module_.resolved_types.types.length() {
              self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 101u32,
                u32_into_u64(module_.resolved_types.types.length()), u32_into_u64(resolved), 0u64)
            }
            match module_.resolved_types.types[resolved] {
              SelfHostResolvedType::GenericParameterType(parameter) => {
                shape = SelfHostPlannedValueShape::GenericPlannedValueShape
                match generics.slot(parameter) {
                  Option::Some(slot) => if slot < caller_shapes.length {
                    shape = shapes[caller_shapes.start + slot]
                  }
                  Option::None => {}
                }
              }
              SelfHostResolvedType::ProductType(fields) => {
                product = true
                if !self_host_array_span_is_valid(fields.start, fields.length, module_.resolved_types.type_arguments.length()) {
                  self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 101u32,
                    u32_into_u64(module_.resolved_types.type_arguments.length()), u32_into_u64(fields.length), u32_into_u64(fields.start))
                }
                while 0u32 {
                  index if index < fields.length => {
                    let child = module_.resolved_types.type_arguments[fields.start + index]
                    if child > 2147483646u32 {
                      self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 207u32,
                        2147483646u64, u32_into_u64(child), u32_into_u64(resolved))
                    }
                    children.push(-self_host_body_u32_to_i32(child) - 2i32)
                    continue index + 1u32
                  }
                  _ => break ()
                }
              }
              SelfHostResolvedType::AppliedType(base, _) => {
                if base > 2147483646u32 {
                  self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 207u32,
                    2147483646u64, u32_into_u64(base), u32_into_u64(resolved))
                }
                children.push(-self_host_body_u32_to_i32(base) - 2i32)
              }
              _ => {
                shape = self_host_planned_resolved_value_shape(module_.resolved_types, resolved)
              }
            }
          } else if type_ >= 0i32 {
            let index = self_host_body_i32_to_u32(type_)
            if index >= module_.inferred.types.length() {
              self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 101u32,
                u32_into_u64(module_.inferred.types.length()), u32_into_u64(index), 1u64)
            }
            match module_.inferred.types[index] {
              SelfHostBodyTypeTerm::BodyResolvedType(resolved) => {
                if resolved > 2147483646u32 {
                  self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 207u32,
                    2147483646u64, u32_into_u64(resolved), u32_into_u64(index))
                }
                children.push(-self_host_body_u32_to_i32(resolved) - 2i32)
              }
              SelfHostBodyTypeTerm::BodyAppliedType(base, _) => children.push(base)
              SelfHostBodyTypeTerm::BodyProductType(fields) => {
                product = true
                if !self_host_array_span_is_valid(fields.start, fields.length, module_.inferred.type_arguments.length()) {
                  self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 101u32,
                    u32_into_u64(module_.inferred.type_arguments.length()), u32_into_u64(fields.length), u32_into_u64(fields.start))
                }
                while 0u32 {
                  child if child < fields.length => {
                    children.push(module_.inferred.type_arguments[fields.start + child])
                    continue child + 1u32
                  }
                  _ => break ()
                }
              }
              _ => {
                shape = self_host_planned_merged_body_value_shape(module_.resolved_types, module_.inferred, type_)
              }
            }
          }
          if product || children.length() > 0u32 {
            tasks.push(SelfHostSpecializedBodyShapeTask::FinishSpecializedBodyShape(type_, results.length(), children.length(), product))
            while children.length() {
              count if count > 0u32 => {
                tasks.push(SelfHostSpecializedBodyShapeTask::VisitSpecializedBodyShape(children[count - 1u32]))
                continue count - 1u32
              }
              _ => break ()
            }
          } else {
            results.push(shape)
            let _ = active.remove(type_)
            completed.set(type_, shape)
          }
        }
      }
      continue tasks.length()
    }
    _ => break ()
  }
  if results.length() != 1u32 {
    self_host_specialization_index_failure(callable.declaration, 0u64, 4294967295u32, 103u32,
      1u64, u32_into_u64(results.length()), 0u64)
  }
  results[0u32]
}

fn self_host_constructor_box_identity(value: Option<U32>) -> U64 {
  match value {
    None => 0u64
    Some(index) => 1u64 + u32_into_u64(index)
  }
}

fn self_host_compare_object_constructors(frozen: SelfHostPlannedPhysicalBodyCarrierPlan, constructors: Array<SelfHostPhysicalObjectConstructorPlan>, operands: Array<SelfHostPhysicalObjectConstructorOperand>, live: SelfHostPlannedPhysicalBodyCarrierPlan, phase: U32) -> Unit {
  self_host_object_constructor_check(frozen, phase, 4294967295u32, 210u32, 4294967295u32,
    u32_into_u64(constructors.length()), u32_into_u64(live.object_constructors.length()))
  let mut index = 0u32
  for expected in constructors {
    let actual = live.object_constructors[index]
    self_host_object_constructor_check(frozen, phase, expected.expression, 211u32, index,
      u32_into_u64(expected.expression), u32_into_u64(actual.expression))
    self_host_object_constructor_check(frozen, phase, expected.expression, 212u32, index,
      expected.declaration, actual.declaration)
    self_host_object_constructor_check(frozen, phase, expected.expression, 213u32, index,
      u32_into_u64(expected.physical_type), u32_into_u64(actual.physical_type))
    self_host_object_constructor_check(frozen, phase, expected.expression, 214u32, index,
      u32_into_u64(expected.source_fields.start), u32_into_u64(actual.source_fields.start))
    self_host_object_constructor_check(frozen, phase, expected.expression, 215u32, index,
      u32_into_u64(expected.source_fields.length), u32_into_u64(actual.source_fields.length))
    self_host_object_constructor_check(frozen, phase, expected.expression, 216u32, index,
      u32_into_u64(expected.operands.start), u32_into_u64(actual.operands.start))
    self_host_object_constructor_check(frozen, phase, expected.expression, 217u32, index,
      u32_into_u64(expected.operands.length), u32_into_u64(actual.operands.length))
    index = index + 1u32
  }
  self_host_object_constructor_check(frozen, phase, 4294967295u32, 218u32, 4294967295u32,
    u32_into_u64(operands.length()), u32_into_u64(live.object_constructor_operands.length()))
  index = 0u32
  for expected in operands {
    let actual = live.object_constructor_operands[index]
    self_host_object_constructor_check(frozen, phase, expected.expression, 219u32, index,
      u32_into_u64(expected.expression), u32_into_u64(actual.expression))
    self_host_object_constructor_check(frozen, phase, expected.expression, 220u32, index,
      expected.declaration, actual.declaration)
    self_host_object_constructor_check(frozen, phase, expected.expression, 221u32, index,
      u32_into_u64(expected.source_ordinal), u32_into_u64(actual.source_ordinal))
    self_host_object_constructor_check(frozen, phase, expected.expression, 222u32, index,
      u32_into_u64(expected.field_index), u32_into_u64(actual.field_index))
    self_host_object_constructor_check(frozen, phase, expected.expression, 223u32, index,
      self_host_body_freeze_storage(Some(expected.storage)), self_host_body_freeze_storage(Some(actual.storage)))
    self_host_object_constructor_check(frozen, phase, expected.expression, 224u32, index,
      self_host_constructor_box_identity(expected.box_type), self_host_constructor_box_identity(actual.box_type))
    self_host_object_constructor_check(frozen, phase, expected.expression, 225u32, index,
      self_host_body_freeze_bool(expected.unit_marker), self_host_body_freeze_bool(actual.unit_marker))
    self_host_object_constructor_check(frozen, phase, expected.expression, 226u32, index,
      self_host_constructor_box_identity(expected.reference_cast), self_host_constructor_box_identity(actual.reference_cast))
    index = index + 1u32
  }
}

fn self_host_object_constructor_check(plan: SelfHostPlannedPhysicalBodyCarrierPlan, phase: U32, expression: U32, role: U32, index: U32, expected: U64, actual: U64) -> Unit {
  if expected != actual {
    let _ = self_host_assert_compiler_invariant_with_failure(false, {
      code: if phase == 7u32 {
        605u32
      } else {
        608u32
      }
      phase: phase
      module_id: plan.module_id
      declaration: plan.declaration
      body: plan.body
      expression: expression
      expected: expected
      actual: actual
      detail: (u32_into_u64(role) << 32u64) | u32_into_u64(index)
    }, "physical object constructor recipe must agree with its verified source")
  }
}

fn self_host_assert_frozen_object_constructors(frozen: SelfHostPlannedPhysicalBodyCarrierPlan, live: SelfHostPlannedPhysicalBodyCarrierPlan) -> Unit {
  self_host_compare_object_constructors(frozen, frozen.object_constructors, frozen.object_constructor_operands, live, 7u32)
}

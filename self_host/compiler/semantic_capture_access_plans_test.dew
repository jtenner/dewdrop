test "ARN-103 capture access tables cover every lambda capture" expect_trap "unreachable" {
  let (link, plan) = self_host_capture_access_fixture()
  let (module_, body) = self_host_test_raw_array_temporary_source(link, plan)
  let _ = plan.capture_accesses.pop()
  self_host_verify_capture_accesses(link, module_, body, plan)
}


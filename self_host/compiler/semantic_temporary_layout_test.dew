test "non-returning initializers do not allocate unresolved local slots" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"builtin unreachable() -> Never = \"unreachable\"\nstruct Storage<t> {}\nbuiltin allocate<t>(length: U32, value: t) -> Storage<t> = \"array_new\"\nfn unexpected() -> I64 {\n  unreachable()\n}\npub fn main() -> I64 {\n  let storage = allocate::<I64>(return 42i64, unexpected())\n  unexpected()\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let physical = self_host_plan_program_wasm_bodies(link)
  assert(physical.diagnostics.length() == 0u32, "valid non-returning initializer")
  let mut checked = 0u32
  for plan in physical.bodies {
    if plan.local_values.length() == 1u32 {
      assert(plan.local_values[0u32].carrier is SelfHostWasmBodyCarrier::NeverBodyCarrier, "source flow proves that the binding receives no value")
      assert(plan.local_slots[0u32] == 4294967295u32, "there is no local slot after divergence")
      assert(plan.physical_local_count == 0u32, "no fabricated reference local")
      checked = checked + 1u32
    }
  }
  assert(checked == 1u32, "one non-returning binding checked")
}


fn ct_quote(value: String) -> String {
  let out = BytesBuilder::new()
  out.append_byte(34u8)
  let _ = while 0u32 {
    i if i < value.byte_length() => {
      let byte = value.byte_at(i)
      if byte == 10u8 {
        out.append(b"\\n")
      } else if byte == 13u8 {
        out.append(b"\\r")
      } else if byte == 9u8 {
        out.append(b"\\t")
      } else if byte == 34u8 {
        out.append(b"\\\"")
      } else if byte == 92u8 {
        out.append(b"\\\\")
      } else {
        out.append_byte(byte)
      }
      continue i + 1u32
    }
    _ => break ()
  }
  out.append_byte(34u8)
  out.finish().to_string()
}

fn ct_identifier(name: String) -> Bool {
  let tokens = self_host_tokenize(name.as_bytes())
  if tokens.length() != 1u32 {
    return false
  }
  match tokens[0u32].kind {
    Identifier(value, _) => value == name
    _ => false
  }
}

fn ct_render(machine: CtMachine, value: CtValue, depth: U32) -> String {
  if !ct_charge(machine, 32u32) {
    return ""
  }
  if depth >= 128u32 {
    let _ = ct_fail(machine, "generated syntax depth limit exceeded")
    return ""
  }
  let result = ct_render_inner(machine, value, depth)
  let _ = ct_charge(machine, result.byte_length())
  if result.byte_length() > 1048576u32 {
    let _ = ct_fail(machine, "generated source size limit exceeded")
    return ""
  }
  result
}

fn ct_render_list(machine: CtMachine, values: Array<CtValue>, separator: String, depth: U32) -> String {
  let out = StringBuilder::new()
  let mut first = true
  for value in values {
    if !first {
      out.append(separator)
    }
    first = false
    out.append(ct_render(machine, value, depth))
    if machine.error.byte_length() != 0u32 {
      return ""
    }
  }
  out.finish()
}

fn ct_render_inner(machine: CtMachine, value: CtValue, depth: U32) -> String {
  match value {
    Variant(key, args) => {
      if key == "dewdrop.ast::ExprNode::Bytes" && args.length() == 1u32 {
        return ct_render_bytes(machine, args[0u32])
      }
      if key == "dewdrop.ast::ExprNode::Unit" && args.length() == 0u32 {
        return "()"
      }
      if args.length() == 1u32 && args[0u32] is DefaultValue {
        if key == "dewdrop.ast::ExprNode::Integer" {
          return "0i32"
        }
        if key == "dewdrop.ast::ExprNode::Integer64" {
          return "0i64"
        }
        if key == "dewdrop.ast::ExprNode::Unsigned64" {
          return "0u64"
        }
        if key == "dewdrop.ast::ExprNode::Boolean" {
          return "false"
        }
      }
      if (key == "dewdrop.ast::ExprNode::Integer64" || key == "dewdrop.ast::ExprNode::Unsigned64") && args.length() == 1u32 {
        match args[0u32] {
          Number(number, kind) if (kind == "I64" && key == "dewdrop.ast::ExprNode::Integer64") || (kind == "U64" && key == "dewdrop.ast::ExprNode::Unsigned64") => {
            let out = StringBuilder::new()
            if kind == "I64" {
              out.append_i64(ct_signed(number, kind))
            } else {
              out.append_u64(number)
            }
            out.append(if kind == "I64" {
              "i64"
            } else {
              "u64"
            })
            return out.finish()
          }
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::Path" && args.length() == 1u32 {
        let path = ct_string(machine, args[0u32])
        if !ct_qualified_identifier(path) {
          let _ = ct_fail(machine, "invalid generated qualified path")
          return ""
        }
        return path
      }
      if key == "dewdrop.ast::ExprNode::Field" && args.length() == 2u32 {
        let name = ct_string(machine, args[1u32])
        if !ct_identifier(name) {
          let _ = ct_fail(machine, "invalid generated field name")
          return ""
        }
        return "(".concat(ct_render(machine, args[0u32], depth + 1u32)).concat(").").concat(name)
      }
      if key == "dewdrop.ast::ExprNode::Index" && args.length() == 2u32 {
        return "(".concat(ct_render(machine, args[0u32], depth + 1u32)).concat(")[").concat(ct_render(machine, args[1u32], depth + 1u32)).concat("]")
      }
      if key == "dewdrop.ast::ExprNode::MethodCall" && args.length() == 3u32 {
        let name = ct_string(machine, args[1u32])
        if !ct_identifier(name) {
          let _ = ct_fail(machine, "invalid generated method name")
          return ""
        }
        match ct_sequence_values(machine, args[2u32]) {
          values if machine.error.byte_length() == 0u32 => return "(".concat(ct_render(machine, args[0u32], depth + 1u32)).concat(").").concat(name).concat("(").concat(ct_render_list(machine, values, ", ", depth + 1u32)).concat(")")
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::Prefix" && args.length() == 2u32 {
        let op = ct_string(machine, args[0u32])
        if op != "!" && op != "-" && op != "+" {
          let _ = ct_fail(machine, "invalid generated prefix operator")
          return ""
        }
        return op.concat("(").concat(ct_render(machine, args[1u32], depth + 1u32)).concat(")")
      }
      if (key == "dewdrop.ast::ExprNode::Array" || key == "dewdrop.ast::ExprNode::Tuple") && args.length() == 1u32 {
        match ct_sequence_values(machine, args[0u32]) {
          values if machine.error.byte_length() == 0u32 => {
            if key == "dewdrop.ast::ExprNode::Tuple" && values.length() == 1u32 {
              let _ = ct_fail(machine, "Dew has no one-element tuple syntax")
              return ""
            }
            return (if key == "dewdrop.ast::ExprNode::Array" {
              "["
            } else {
              "("
            }).concat(ct_render_list(machine, values, ", ", depth + 1u32)).concat(if key == "dewdrop.ast::ExprNode::Array" {
              "]"
            } else {
              ")"
            })
          }
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::MutableBind" && args.length() == 2u32 {
        let name = ct_string(machine, args[0u32])
        if !ct_identifier(name) {
          let _ = ct_fail(machine, "invalid generated binding name")
          return ""
        }
        return "let mut ".concat(name).concat(" = ").concat(ct_render(machine, args[1u32], depth + 1u32))
      }
      if key == "dewdrop.ast::ExprNode::Assign" && args.length() == 2u32 {
        return ct_render(machine, args[0u32], depth + 1u32).concat(" = ").concat(ct_render(machine, args[1u32], depth + 1u32))
      }
      if key == "dewdrop.ast::ExprNode::Quote" && args.length() == 2u32 {
    return ct_render_quote(machine, args[0u32], args[1u32], depth)
  }
  if key == "dewdrop.ast::ExprNode::Source" && args.length() == 1u32 {
        if ct_truth(machine, ct_reference_equal(machine, value, machine.render_source)) {
          return machine.render_replacement
        }
        return ct_string(machine, args[0u32])
      }
      if key == "dewdrop.ast::ExprNode::Integer" && args.length() == 1u32 {
        match args[0u32] {
          Number(number, kind) if kind == "I32" => {
            let out = StringBuilder::new()
            out.append_i64(ct_signed(number, kind))
            out.append("i32")
            return out.finish()
          }
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::Boolean" && args.length() == 1u32 {
        return if ct_truth(machine, args[0u32]) {
          "true"
        } else {
          "false"
        }
      }
      if key == "dewdrop.ast::ExprNode::Text" && args.length() == 1u32 {
        return ct_quote(ct_string(machine, args[0u32]))
      }
      if key == "dewdrop.ast::ExprNode::Name" && args.length() == 1u32 {
        let name = ct_string(machine, args[0u32])
        if !ct_identifier(name) {
          let _ = ct_fail(machine, "invalid generated identifier")
          return ""
        }
        return name
      }
      if key == "dewdrop.ast::ExprNode::Call" && args.length() == 2u32 {
        match ct_sequence_values(machine, args[1u32]) {
          values if machine.error.byte_length() == 0u32 => return "(".concat(ct_render(machine, args[0u32], depth + 1u32)).concat(")(").concat(ct_render_list(machine, values, ", ", depth + 1u32)).concat(")")
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::Block" && args.length() == 1u32 {
        match ct_sequence_values(machine, args[0u32]) {
          values if machine.error.byte_length() == 0u32 => return "match () {\n_ => {\n".concat(ct_render_list(machine, values, "\n", depth + 1u32)).concat("\n}\n}")
          _ => {
          }
        }
      }
      if key == "dewdrop.ast::ExprNode::Bind" && args.length() == 2u32 {
        let name = ct_string(machine, args[0u32])
        if !ct_identifier(name) {
          let _ = ct_fail(machine, "invalid generated binding name")
          return ""
        }
        return "let ".concat(name).concat(" = ").concat(ct_render(machine, args[1u32], depth + 1u32))
      }
      if key == "dewdrop.ast::ExprNode::Return" && args.length() == 1u32 {
        return "return ".concat(ct_render(machine, args[0u32], depth + 1u32))
      }
      if key == "dewdrop.ast::ExprNode::If" && args.length() == 3u32 {
        return "if ".concat(ct_render(machine, args[0u32], depth + 1u32)).concat(" {\n").concat(ct_render(machine, args[1u32], depth + 1u32)).concat("\n} else {\n").concat(ct_render(machine, args[2u32], depth + 1u32)).concat("\n}")
      }
      if key == "dewdrop.ast::ExprNode::Binary" && args.length() == 3u32 {
        let op = ct_string(machine, args[0u32])
        let mut allowed = false
        for candidate in ["+", "-", "*", "/", "%", "==", "!=", "<", "<=", ">", ">=", "&&", "||", "&", "|", "^", "<<", ">>"] {
          if op == candidate {
            allowed = true
          }
        }
        if !allowed {
          let _ = ct_fail(machine, "invalid generated binary operator")
          return ""
        }
        return "(".concat(ct_render(machine, args[1u32], depth + 1u32)).concat(") ").concat(op).concat(" (").concat(ct_render(machine, args[2u32], depth + 1u32)).concat(")")
      }
    }
    _ => {
    }
  }
  let _ = ct_fail(machine, "invalid generated syntax node payload")
  ""
}

fn ct_annotation_key(machine: CtMachine, mi: U32, name: String) -> String {
  if name.starts_with("@") {
    let mut dot = 0u32
    let _ = while 1u32 {
      i if i < name.byte_length() => {
        if name.byte_at(i) == 46u8 {
          dot = i
          break ()
        }
        continue i + 1u32
      }
      _ => break ()
    }
    if dot == 0u32 {
      let _ = ct_fail(machine, "expected #@alias.transform_name")
      return ""
    }
    return ct_resolve(machine, mi, name.slice(dot + 1u32, name.byte_length()), Some(name.slice(1u32, dot)))
  }
  ct_resolve(machine, mi, name, None)
}

fn ct_is_annotated(file: CtFile, function: CtFunction) -> Bool {
  function.annotation_count != 0u32
}

fn ct_apply(machine: CtMachine, file: CtFile, function: CtFunction) -> CtAppliedFunction {
  machine.steps = 100000u32
  machine.allocated = 0u32
  let fn_ = function.declaration
  let generated_imports = StringBuilder::new()
  let generated_declarations = StringBuilder::new()
  let mut generated_bytes = 0u32
  let mut first_generated_declaration = true
  let mut node = ct_record("dewdrop.ast::FnNode", [
  ct_binding("name", CtValue::Text(fn_.name)),
  ct_binding("signature", ct_signature_node(machine, fn_)),
  ct_binding("call_adapter", CtValue::Variant("dew.std.option::Option::None", [])),
  ct_binding("body", CtValue::Variant("dewdrop.ast::ExprNode::Source", [CtValue::Text("match () {\n_ => ".concat(ct_part(file.clean, fn_.body.offset, function.end)).concat("\n}"))])),
  ])
  let original_source = ct_field(machine, node, "body")
  let original_signature = ct_render_signature(machine, ct_field(machine, node, "signature"))
  let _ = while function.annotation_start {
    index if index - function.annotation_start < function.annotation_count => {
      let annotation = file.annotations[index]
      machine.globals.clear()
      machine.initializing.clear()
      machine.steps = 100000u32
      machine.allocated = 0u32
      machine.memory = None
      let key = ct_annotation_key(machine, file.module_index, annotation.name)
      if !ct_source_index(machine.plan).transforms.contains_key(key) {
        let _ = ct_fail(machine, "annotation must name a transform fn")
        return ct_failed_applied(file, function)
      }
      let line = annotation.line_no
      let column = annotation.col_no
      let fresh = ct_fresh_name(machine, file.module_index, annotation.offset)
      if machine.error.byte_length() != 0u32 {
        return ct_failed_applied(file, function)
      }
      let context = ct_record("dewdrop.transform::TransformContext", [
      ct_binding("location", ct_record("dewdrop.transform::SourceLocation", [
      ct_binding("file_name", CtValue::Text(file.original.path)),
      ct_binding("line_no", CtValue::Number(line, "U32")),
      ct_binding("col_no", CtValue::Number(column, "U32")),
      ])),
      ct_binding("fn_name", CtValue::Text(fn_.name)),
      ct_binding("module_name", CtValue::Text(machine.plan.manifest.modules[file.module_index].path)),
      ct_binding("syntax", ct_syntax_block(machine, fn_.body, 0u32)),
      ct_binding("expression_types", ct_expression_type_nodes(machine, file, function)),
      ct_binding("type_errors", ct_reflection_error_nodes(machine)),
      ct_binding("arguments", ct_annotation_nodes(machine, annotation)),
      ct_binding("arguments_source", CtValue::Text(annotation.arguments_source)),
      ct_binding("parameters", ct_parameter_nodes(machine, fn_.parameters)),
      ct_binding("type_parameters", ct_type_parameter_nodes(machine, fn_.type_parameters)),
      ct_binding("return_type", ct_type_node(machine, fn_.return_type)),
      ct_binding("parameters_source", CtValue::Text(ct_parameter_source(file.clean, fn_))),
      ct_binding("return_type_source", CtValue::Text(ct_part(file.clean, fn_.return_type.offset(), fn_.body.offset))),
      ct_binding("fresh_name", CtValue::Text(fresh)),
      ct_binding("declarations", ct_syntax_values(machine, [])),
      ct_binding("imports", ct_syntax_values(machine, [])),
      ])
      let value = ct_call(machine, key, [node, context])
      node = match value {
        Variant(result_key, args) if result_key == "dew.std.result::Result::Ok" && args.length() == 1u32 => args[0u32]
        Variant(result_key, args) if result_key == "dew.std.result::Result::Err" && args.length() == 1u32 => ct_fail(machine, ct_string(machine, ct_field(machine, args[0u32], "message")))
        _ => value
      }
      if machine.error.byte_length() != 0u32 {
        return ct_failed_applied(file, function)
      }
      match node {
        Record(type_, _) if type_ == "dewdrop.ast::FnNode" || type_ == "" => {
        }
        _ => {
          let _ = ct_fail(machine, "transform must return FnNode or Result<FnNode, TransformError>")
          return ct_failed_applied(file, function)
        }
      }
      if ct_string(machine, ct_field(machine, node, "name")) != fn_.name {
        let _ = ct_fail(machine, "body transforms must preserve the function name")
        return ct_failed_applied(file, function)
      }
      for item in ct_sequence_values(machine, ct_field(machine, context, "imports")) {
        let rendered = ct_register_import(machine, file.module_index, item)
        if rendered.byte_length() > 1048576u32 - generated_bytes {
          let _ = ct_fail(machine, "generated source size limit exceeded")
          return ct_failed_applied(file, function)
        }
        generated_bytes = generated_bytes + rendered.byte_length()
        generated_imports.append(rendered)
      }
      for item in ct_sequence_values(machine, ct_field(machine, context, "declarations")) {
        let rendered = ct_render_declaration(machine, item)
        if rendered.byte_length() >= 1048576u32 - generated_bytes {
          let _ = ct_fail(machine, "generated source size limit exceeded")
          return ct_failed_applied(file, function)
        }
        generated_bytes = generated_bytes + rendered.byte_length() + 1u32
        if !first_generated_declaration {
          generated_declarations.append("\n")
        }
        first_generated_declaration = false
        generated_declarations.append(rendered)
      }
      machine.plan.reports.push(CtTransformReport::{
        module_name: machine.plan.manifest.modules[file.module_index].path
        file_name: file.original.path
        function_name: fn_.name
        transform_name: key
        offset: annotation.offset
        work: 100000u32 - machine.steps
        allocation_work: machine.allocated
      })
      continue index + 1u32
    }
    _ => break ()
  }
  let signature = ct_render_signature(machine, ct_field(machine, node, "signature"))
  let changed = signature != original_signature
  let bridge = match ct_field(machine, node, "call_adapter") {
    Variant(key, values) if key == "dew.std.option::Option::None" && values.length() == 0u32 => None
    Variant(key, values) if key == "dew.std.option::Option::Some" && values.length() == 1u32 => {
      if !changed {
        let _ = ct_fail(machine, "call adapter requires a changed function signature")
        return ct_failed_applied(file, function)
      }
      Some(ct_adapter_name(machine, file, function))
    }
    _ => {
      let _ = ct_fail(machine, "invalid function call adapter")
      return ct_failed_applied(file, function)
    }
  }
  CtAppliedFunction::{
    file: file
    function: function
    node: node
    original_source: original_source
    rendered: None
    signature: signature
    changed: changed
    bridge: bridge
    imports: generated_imports.finish()
    declarations: generated_declarations.finish()
    steps: machine.steps
    allocated: machine.allocated
  }
}

fn ct_failed_applied(file: CtFile, function: CtFunction) -> CtAppliedFunction {
  CtAppliedFunction::{
    file: file
    function: function
    node: CtValue::Empty
    original_source: CtValue::Empty
    rendered: None
    signature: ""
    changed: false
    bridge: None
    imports: ""
    declarations: ""
    steps: 0u32
    allocated: 0u32
  }
}

fn ct_render_applied(machine: CtMachine, applied: CtAppliedFunction, repairs: Array<CtSourceRepair>) -> String {
  match applied.rendered {
    Some(source) => {
      assert(repairs.length() == 0u32, "worker result cannot contain signature repairs")
      return source
    }
    None => {}
  }
  let file = applied.file
  let function = applied.function
  let fn_ = function.declaration
  let node = applied.node
  machine.steps = applied.steps
  machine.allocated = applied.allocated
  machine.render_source = applied.original_source
  machine.render_replacement = "match () {\n_ => ".concat(ct_repaired_part(file.clean, fn_.body.offset, function.end, repairs)).concat("\n}")
  let body = ct_render(machine, ct_field(machine, node, "body"), 0u32)
  if machine.error.byte_length() != 0u32 {
    return ""
  }
  let header = if applied.changed {
    ct_part(file.clean, function.start, ct_signature_parameters_start(machine, file.clean, fn_)).concat(applied.signature).concat(" ")
  } else {
    ct_part(file.clean, function.start, fn_.body.offset)
  }
  let source = header.concat("{\n").concat(body).concat("\n}")
  let mut declarations = applied.declarations
  match applied.bridge {
    Some(bridge) => {
      machine.render_source = CtValue::Empty
      let adapter = match ct_field(machine, node, "call_adapter") {
        Variant(_, values) if values.length() == 1u32 => ct_render(machine, values[0u32], 0u32)
        _ => {
          let _ = ct_fail(machine, "checked call adapter lost its body")
          return ""
        }
      }
      let bridge_header = ct_part(file.clean, function.start, fn_.name_offset).concat(bridge).concat(ct_part(file.clean, fn_.name_offset + fn_.name.byte_length(), fn_.body.offset))
      let declaration = bridge_header.concat("{\n").concat(adapter).concat("\n}")
      let checked = ct_render_declaration(machine, CtValue::Variant("dewdrop.ast::DeclarationNode::Function", [CtValue::Text(declaration)]))
      if machine.error.byte_length() != 0u32 {
  return ""
}
      declarations = declarations.concat("\n").concat(checked)
    }
    None => {}
  }
  if !ct_validate_function_source(machine, source.as_bytes()) {
    return ""
  }
  let imports = applied.imports
  if imports.byte_length() == 0u32 && declarations.byte_length() == 0u32 {
    return source
  }
  let output = imports.concat(source).concat("\n").concat(declarations)
  if output.byte_length() > 1048576u32 {
    let _ = ct_fail(machine, "generated source size limit exceeded")
    return ""
  }
  output
}

fn ct_expand(plan: CtPlan) -> Result<SelfHostProgramManifest, String> {
  ct_expand_retaining_declarations(plan, false)
}

fn ct_expand_retaining_declarations(plan: CtPlan, retain_transform_declarations: Bool) -> Result<SelfHostProgramManifest, String> {
  if plan.error.byte_length() != 0u32 {
    return Err(plan.error)
  }
  if !plan.active {
    return Ok(plan.manifest)
  }
  let parallel = match ct_parallel_apply(plan) {
    Ok(value) => value
    Err(error) => return Err(error)
  }
  ct_expand_applied(plan, retain_transform_declarations, parallel)
}

fn ct_expand_applied(plan: CtPlan, retain_transform_declarations: Bool, parallel: Option<Map<U64, CtAppliedFunction>>) -> Result<SelfHostProgramManifest, String> {
  let machine = ct_machine(plan)
  let applied = match parallel {
    Some(value) => value
    None => map_empty::<U64, CtAppliedFunction>()
  }
  let bridges = map_empty::<U64, String>()
  for file in plan.files {
    ct_seed_imports(machine, file.module_index)
    for function in file.functions {
      if !function.transform_ && ct_is_annotated(file, function) {
        let value = match parallel {
          Some(_) => match applied.get(ct_site_key(plan, file.module_index, file.original.path, function.declaration.offset)) {
            Some(value) => value
            None => return Err("worker result lost its original function site")
          }
          None => ct_apply(machine, file, function)
        }
        if machine.error.byte_length() != 0u32 {
          return Err(file.original.path.concat(": error: transform on ").concat(function.declaration.name).concat(": ").concat(machine.error))
        }
        let key = ct_site_key(plan, file.module_index, file.original.path, function.declaration.offset)
        applied.set(key, value)
        match value.bridge {
          Some(name) => bridges.set(key, name)
          None => {}
        }
      }
    }
  }
  let modules = array_new::<SelfHostManifestModule>()
  let mut mi = 0u32
  for module_ in plan.manifest.modules {
    ct_seed_imports(machine, mi)
    let files = array_new::<SelfHostManifestFile>()
    let generated = array_new::<SelfHostManifestFile>()
    for file in plan.files {
      if file.module_index == mi {
        let file_repairs = ct_source_repairs(machine, file, bridges)
        if machine.error.byte_length() != 0u32 {
  return Err(machine.error)
}
        let out = BytesBuilder::new()
        let mut cursor = 0u32
        for function in file.functions {
          if function.transform_ && retain_transform_declarations {
            out.append(file.original.source.slice(cursor, function.end))
            cursor = function.end
          } else if function.transform_ {
            out.append(ct_repaired_part(file.clean, cursor, function.start, file_repairs).as_bytes())
            out.append(ct_blank(file.clean, function.start, function.end))
            cursor = function.end
          } else if ct_is_annotated(file, function) {
            out.append(ct_repaired_part(file.clean, cursor, function.start, file_repairs).as_bytes())
            let value = match applied.get(ct_site_key(plan, file.module_index, file.original.path, function.declaration.offset)) {
              Some(value) => value
              None => return Err("transform result lost its original function site")
            }
            let replacement = ct_render_applied(machine, value, file_repairs)
            out.append(ct_blank(file.clean, function.start, function.end))
            let path_builder = StringBuilder::new()
            path_builder.append(file.original.path)
            path_builder.append("::transform[")
            path_builder.append(function.declaration.name)
            path_builder.append("@")
            path_builder.append_u32(function.start)
            path_builder.append("]")
            let path = path_builder.finish()
            for original in module_.files {
              if original.path == path {
                return Err("generated transform file path collision")
              }
            }
            generated.push({
              path: path
              source: replacement.as_bytes()
              test_only: file.original.test_only
            })
            if machine.error.byte_length() != 0u32 {
              return Err(file.original.path.concat(": error: transform on ").concat(function.declaration.name).concat(": ").concat(machine.error))
            }
            cursor = function.end
          }
        }
        out.append(ct_repaired_part(file.clean, cursor, file.clean.byte_length(), file_repairs).as_bytes())
        files.push({
          path: file.original.path
          source: out.finish()
          test_only: file.original.test_only
        })
      }
    }
    for file in generated {
      files.push(file)
    }
    modules.push({
      path: module_.path
      files: files
    })
    mi = mi + 1u32
  }
  Ok({
    modules: modules
  })
}

fn ct_parameter_source(source: Bytes, function: SelfHostFunctionDeclaration) -> String {
  let start = function.name_offset + function.name.byte_length()
  let end = function.return_type.offset()
  let mut angles = 0u32
  let mut parentheses = 0u32
  let mut begin = 4294967295u32
  for token in self_host_tokenize(source.slice(start, end)) {
    let symbol = token.symbol_code
    if symbol == 29u32 && begin == 4294967295u32 {
      angles = angles + 1u32
    } else if symbol == 30u32 && begin == 4294967295u32 && angles > 0u32 {
      angles = angles - 1u32
    } else if symbol == 22u32 && begin == 4294967295u32 && angles > 1u32 {
      angles = angles - 2u32
    } else if symbol == 0u32 && angles == 0u32 {
      if begin == 4294967295u32 {
        begin = start + token.offset
      }
      parentheses = parentheses + 1u32
    } else if symbol == 1u32 && begin != 4294967295u32 && parentheses > 0u32 {
      parentheses = parentheses - 1u32
      if parentheses == 0u32 {
        return ct_part(source, begin, start + token.offset + 1u32)
      }
    }
  }
  ""
}

fn ct_qualified_identifier(name: String) -> Bool {
  let tokens = self_host_tokenize(name.as_bytes())
  if tokens.length() == 0u32 {
    return false
  }
  let mut i = 0u32
  match tokens[0u32].kind {
    AtIdentifier(_, _, _) => {
      if tokens.length() < 3u32 || tokens[1u32].symbol_code != 27u32 || !(tokens[2u32].kind is Identifier(_, _)) {
        return false
      }
      i = 3u32
    }
    Identifier(_, _) => {
      i = 1u32
    }
    _ => return false
  }
  let _ = while i {
    at if at < tokens.length() => {
      if at + 1u32 >= tokens.length() || tokens[at].symbol_code != 14u32 || !(tokens[at + 1u32].kind is Identifier(_, _)) {
        return false
      }
      continue at + 2u32
    }
    _ => break ()
  }
  true
}

// Used for local rendering and for copied worker output before admission.
fn ct_validate_function_source(machine: CtMachine, source: Bytes) -> Bool {
  if !source.is_valid_utf8() {
    let _ = ct_fail(machine, "generated function source must be valid UTF-8")
    return false
  }
  if source.byte_length() > 1048576u32 {
    let _ = ct_fail(machine, "generated source size limit exceeded")
    return false
  }
  let mut depth = 0u32
  for token in self_host_tokenize(source) {
    let symbol = token.symbol_code
    if symbol == 0u32 || symbol == 2u32 || symbol == 4u32 {
      depth = depth + 1u32
    } else if symbol == 1u32 || symbol == 3u32 || symbol == 5u32 {
      if depth == 0u32 {
        let _ = ct_fail(machine, "generated syntax nesting limit exceeded")
        return false
      }
      depth = depth - 1u32
    }
    if depth > 128u32 {
      let _ = ct_fail(machine, "generated syntax nesting limit exceeded")
      return false
    }
  }
  let events = self_host_parse_module(source).events
  let valid = if events.length() == 1u32 {
    events[0u32] is Declaration(Function(_), _)
  } else {
    false
  }
  if !valid {
    let _ = ct_fail(machine, "transform must produce one valid function body")
    return false
  }
  true
}

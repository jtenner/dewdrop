open dew.std.array
open dew.std.map
open dew.std.option

fn self_host_guard_builtin(name: Bytes) -> Bool {
  self_host_compile_time_type_query_arity(name) is Some(_)
}

struct SelfHostCompileTimeGuardFact {
  is_trait: Bool
  target: U32
  bound: U32
}

enum SelfHostCompileTimeGuardWalk {
  GuardExpression(U32)
  GuardBlock(U32)
  GuardPattern(U32)
}

struct SelfHostCompileTimeGuardCondition {
  expression: U32
  truth: Bool
}

fn self_host_empty_guard_scopes() -> Map<U32, Array<SelfHostCompileTimeGuardFact>> {
  empty()
}

fn self_host_empty_guard_facts() -> Array<SelfHostCompileTimeGuardFact> {
  []
}

fn self_host_guard_add_fact(facts: Array<SelfHostCompileTimeGuardFact>, fact: SelfHostCompileTimeGuardFact) -> Unit {
  for previous in facts {
    if previous.is_trait == fact.is_trait && previous.target == fact.target && previous.bound == fact.bound {
      return
    }
  }
  facts.push(fact)
}

// The query declarations are fixed for all bodies in one imported input set.
fn self_host_guard_builtin_target_map(
  collected: SelfHostCollectedModule,
  callables: Array<SelfHostResolvedImportedCallable>,
) -> Map<U64, Bytes> {
  let targets = self_host_compile_time_target_map()
  for entry in collected.builtins {
    if self_host_guard_builtin(entry.builtin_name) {
      targets.set(entry.declaration, entry.builtin_name)
    }
  }
  for callable in callables {
    match callable.kind {
      FrozenBuiltinCallable(name) => if self_host_guard_builtin(name) {
        targets.set(callable.declaration, name)
      }
      _ => {}
    }
  }
  targets
}

impl SelfHostBasicBodyInferencer {
  fn guard_builtin_targets(self) -> Map<U64, Bytes> {
    self.imported.guard_targets
  }

  fn guard_condition_facts(self, expression: U32, truth: Bool, targets: Map<U64, Bytes>) -> Array<SelfHostCompileTimeGuardFact> {
    let facts = self_host_empty_guard_facts()
    let work = [SelfHostCompileTimeGuardCondition::{
      expression: expression
      truth: truth
    }]
    let _ = while work.length() {
      count => if count > 0u32 {
        let item = work[count - 1u32]
        work.truncate(count - 1u32)
        if item.expression != 4294967295u32 {
          self_host_assert_array_index(item.expression, self.collected.expressions.length(), "ARN-104 guarded condition")
          match self.collected.expressions[item.expression] {
            PrefixExpr(LogicalNot, value, _) => work.push({
              expression: value
              truth: !item.truth
            })
            BinaryExpr(operator, left, right, _) => if (operator is LogicalAnd && item.truth) || (operator is LogicalOr && !item.truth) {
              work.push({
                expression: left
                truth: item.truth
              })
              work.push({
                expression: right
                truth: item.truth
              })
            }
            CallExpr(target, arguments, _) => if item.truth && arguments.length == 0u32 {
              let declaration = match self.names.expression_references[target] {
                ModuleValueNameReference(name) => match self.unique_local_callable_index(name) {
                  Some(index) => self.collected.callables[index].declaration
                  None => 18446744073709551615u64
                }
                ImportedModuleValueNameReference(declaration) => declaration
                _ => 18446744073709551615u64
              }
              if targets.contains_key(declaration) {
                let name = match targets.get(declaration) {
                  Some(value) => value
                  None => unreachable()
                }
                if name != b"types.implements" && name != b"types.type_equal" && name != b"types.is_unit" && name != b"types.is_never" {
                  continue work.length()
                }
                let arity = if name == b"types.is_unit" || name == b"types.is_never" {
                  1u32
                } else {
                  2u32
                }
                let span = self_host_hir_span_at(self.collected.explicit_call_type_argument_spans, item.expression)
                if span.length == arity {
                  self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.resolved.explicit_call_type_arguments.length()), "ARN-101 guarded type arguments")
                  let other = if arity == 2u32 {
                    self.resolved.explicit_call_type_arguments[span.start + 1u32]
                  } else if name == b"types.is_unit" {
                    self.resolved.primitive(UnitType)
                  } else {
                    self.resolved.primitive(NeverType)
                  }
                  self_host_guard_add_fact(facts, {
                    is_trait: name == b"types.implements"
                    target: self.resolved.explicit_call_type_arguments[span.start]
                    bound: other
                  })
                }
              }
            }
            _ => {}
          }
        }
        continue work.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    facts
  }

  fn guard_expression_children(self, span: SelfHostHirSpan, work: Array<SelfHostCompileTimeGuardWalk>) -> Unit {
    self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.expression_children.length()), "ARN-101 guarded expression children")
    let _ = while 0u32 {
      index => if index < span.length {
        work.push(GuardExpression(self.collected.expression_children[span.start + index]))
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn guard_object_fields(self, span: SelfHostHirSpan, work: Array<SelfHostCompileTimeGuardWalk>) -> Unit {
    self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.object_fields.length()), "ARN-101 guarded object fields")
    let _ = while 0u32 {
      index => if index < span.length {
        work.push(GuardExpression(self.collected.object_fields[span.start + index].value))
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn mark_guard_scope(self, root: SelfHostCompileTimeGuardWalk, facts: Array<SelfHostCompileTimeGuardFact>, dependent: Bool) -> Unit {
    if facts.length() == 0u32 && !dependent {
      return
    }
    let work = [root]
    let seen = self_host_empty_u32_bool_map()
    let _ = while work.length() {
      count => if count > 0u32 {
        let item = work[count - 1u32]
        work.truncate(count - 1u32)
        match item {
          GuardBlock(block) => {
            self_host_assert_array_index(block, self.collected.blocks.length(), "ARN-104 guarded block")
            let span = self.collected.blocks[block].items
            self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.block_items.length()), "ARN-101 guarded block items")
            let _ = while 0u32 {
              index => if index < span.length {
                work.push(GuardExpression(self.collected.block_items[span.start + index].value))
                continue index + 1u32
              } else {
                break self_host_semantic_unit()
              }
            }
          }
          GuardPattern(pattern) => if pattern != 4294967295u32 {
            self_host_assert_array_index(pattern, self.collected.patterns.length(), "ARN-104 guarded pattern")
            match self.collected.patterns[pattern] {
              LiteralPattern(value, _) => work.push(GuardExpression(value))
              QualifiedPattern(root, _, _) => work.push(GuardPattern(root))
              TuplePattern(root, span, _) => {
                work.push(GuardPattern(root))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_children.length()), "ARN-101 guarded pattern children")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(GuardPattern(self.collected.pattern_children[span.start + index]))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              AlternativePattern(root, span, _) => {
                work.push(GuardPattern(root))
                self_host_assert_array_span(span.start, span.length, self.collected.pattern_children.length(), "ARN-101 guarded pattern children")
                let _ = while 0u32 {
                  child => if child < span.length {
                    work.push(GuardPattern(self.collected.pattern_children[span.start + child]))
                    continue child + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              ProductPattern(span, _) => {
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_children.length()), "ARN-101 guarded pattern children")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(GuardPattern(self.collected.pattern_children[span.start + index]))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              StructPattern(root, span, _, _, _) => {
                work.push(GuardPattern(root))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(span.start, span.length, self.collected.pattern_fields.length()), "ARN-101 guarded pattern fields")
                let _ = while 0u32 {
                  index => if index < span.length {
                    work.push(GuardPattern(self.collected.pattern_fields[span.start + index].pattern))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              _ => {}
            }
          }
          GuardExpression(expression) => if expression != 4294967295u32 && !seen.contains_key(expression) {
            seen.set(expression, true)
            if dependent {
              self.deferred_guard_scopes.set(expression, true)
            }
            self_host_assert_array_index(expression, self.collected.expressions.length(), "ARN-104 guarded expression")
            let existing = match self.guarded_trait_scopes.get(expression) {
              Some(value) => value
              None => {
                let value = self_host_empty_guard_facts()
                self.guarded_trait_scopes.set(expression, value)
                value
              }
            }
            for fact in facts {
              self_host_guard_add_fact(existing, fact)
            }
            match self.collected.expressions[expression] {
              ProductExpr(span, _) => self.guard_expression_children(span, work)
              ArrayExpr(span, _) => self.guard_expression_children(span, work)
              ObjectExpr(span, _) => self.guard_object_fields(span, work)
              ConstructExpr(target, span, _) => {
                self.guard_object_fields(span, work)
                work.push(GuardExpression(target))
              }
              BlockExpr(block, _) => work.push(GuardBlock(block))
              IfExpr(condition, block, alternative, _) => {
                work.push(GuardExpression(condition))
                work.push(GuardBlock(block))
                work.push(GuardExpression(alternative))
              }
              MatchExpr(value, arms, _) => {
                work.push(GuardExpression(value))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(arms.start, arms.length, self.collected.arm_children.length()), "ARN-101 guarded arms")
                let _ = while 0u32 {
                  index => if index < arms.length {
                    let id = self.collected.arm_children[arms.start + index]
                    self_host_assert_array_index(id, self.collected.pattern_arms.length(), "ARN-104 guarded arm")
                    let arm = self.collected.pattern_arms[id]
                    work.push(GuardPattern(arm.pattern))
                    work.push(GuardExpression(arm.guard_condition))
                    work.push(GuardExpression(arm.body))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              WhileExpr(value, arms, _) => {
                work.push(GuardExpression(value))
                self_host_assert_compiler_invariant(self_host_array_span_is_valid(arms.start, arms.length, self.collected.arm_children.length()), "ARN-101 guarded arms")
                let _ = while 0u32 {
                  index => if index < arms.length {
                    let id = self.collected.arm_children[arms.start + index]
                    self_host_assert_array_index(id, self.collected.pattern_arms.length(), "ARN-104 guarded arm")
                    let arm = self.collected.pattern_arms[id]
                    work.push(GuardPattern(arm.pattern))
                    work.push(GuardExpression(arm.guard_condition))
                    work.push(GuardExpression(arm.body))
                    continue index + 1u32
                  } else {
                    break self_host_semantic_unit()
                  }
                }
              }
              LambdaExpr(lambda, _) => work.push(GuardBlock(self.collected.lambdas[lambda].body.root))
              ReturnExpr(value, _) => work.push(GuardExpression(value))
              BreakExpr(value, _) => work.push(GuardExpression(value))
              ContinueExpr(value, _) => work.push(GuardExpression(value))
              PrefixExpr(_, value, _) => work.push(GuardExpression(value))
              FieldExpr(value, _, _) => work.push(GuardExpression(value))
              QualifiedExpr(value, _, _) => work.push(GuardExpression(value))
              ProductFieldExpr(value, _, _, _) => work.push(GuardExpression(value))
              BinaryExpr(_, left, right, _) => {
                work.push(GuardExpression(left))
                work.push(GuardExpression(right))
              }
              IndexExpr(left, right, _) => {
                work.push(GuardExpression(left))
                work.push(GuardExpression(right))
              }
              AssignmentExpr(left, right, _) => {
                work.push(GuardExpression(left))
                work.push(GuardExpression(right))
              }
              CallExpr(target, arguments, _) => {
                work.push(GuardExpression(target))
                self.guard_expression_children(arguments, work)
              }
              IndexSetExpr(target, index, value, _) => {
                work.push(GuardExpression(target))
                work.push(GuardExpression(index))
                work.push(GuardExpression(value))
              }
              _ => {}
            }
          }
        }
        continue work.length()
      } else {
        break self_host_semantic_unit()
      }
    }
  }

  fn prepare_guard_scopes(self) -> Unit {
    if !self.guarded_trait_scopes_ready {
      self.guarded_trait_scopes_ready = true
      let targets = self.guard_builtin_targets()
      if targets.length() > 0u32 {
        let root = self.collected.bodies[self_host_semantic_id_local(self.body.id)]
        let spans = [root.expressions]
        for lambda in self.collected.lambdas {
          if lambda.root_body == root.id {
            spans.push(lambda.body.expressions)
          }
        }
        for span in spans {
          self_host_assert_array_span(span.start, span.length, self.collected.expressions.length(), "ARN-101 guard source scope")
          let _ = while 0u32 {
            index if index < span.length => {
              let source = self.collected.expressions[span.start + index]
              match source {
                IfExpr(condition, block, alternative, _) => {
                  let dependent = self.guard_condition_dependent(condition, targets)
                  self.mark_guard_scope(GuardBlock(block), self.guard_condition_facts(condition, true, targets), dependent)
                  self.mark_guard_scope(GuardExpression(alternative), self.guard_condition_facts(condition, false, targets), dependent)
                }
                BinaryExpr(LogicalAnd, left, right, _) => self.mark_guard_scope(GuardExpression(right), self.guard_condition_facts(left, true, targets), self.guard_condition_dependent(left, targets))
                BinaryExpr(LogicalOr, left, right, _) => self.mark_guard_scope(GuardExpression(right), self.guard_condition_facts(left, false, targets), self.guard_condition_dependent(left, targets))
                _ => {}
              }
              continue index + 1u32
            }
            _ => break self_host_semantic_unit()
          }
        }
      }
    }
  }

  fn guard_type_has_generic(self, root: U32) -> Bool {
    let work = [root]
    let seen = self_host_empty_u32_bool_map()
    let _ = while work.length() {
      length => if length > 0u32 {
        let id = work[length - 1u32]
        work.truncate(length - 1u32)
        if seen.contains_key(id) {
          continue work.length()
        }
        seen.set(id, true)
        self_host_assert_array_index(id, self.resolved.types.length(), "ARN-104 guarded target type")
        let span = match self.resolved.types[id] {
          GenericParameterType(_) => return true
          ProductType(span) => span
          AppliedType(base, span) => {
            work.push(base)
            span
          }
          FunctionType(span, result) => {
            work.push(result)
            span
          }
          MemberTypeProjection(owner, _, _) => {
            work.push(owner)
            continue work.length()
          }
          _ => continue work.length()
        }
        self_host_assert_array_span(span.start, span.length, self.resolved.type_arguments.length(), "ARN-101 guarded target type arguments")
        let _ = while 0u32 {
          index => if index < span.length {
            work.push(self.resolved.type_arguments[span.start + index])
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
        continue work.length()
      } else {
        break self_host_semantic_unit()
      }
    }
    false
  }

  fn guarded_trait_bounds(self, expression: U32, target_type: I32) -> Array<U32> {
    self.prepare_guard_scopes()
    let result = self_host_empty_semantic_ids()
    match self.guarded_trait_scopes.get(expression) {
      Some(facts) => for fact in facts {
        if fact.is_trait && self.guard_type_has_generic(fact.target) {
          let snapshot = self.solver.snapshot()
          let matches = self.solver.unify(target_type, self.solver.resolved_type(fact.target), self_host_expression_type_origin(expression, self.collected.expressions[expression].offset()))
          self.solver.rollback(snapshot)
          if matches {
            result.push(fact.bound)
          }
        }
      }
      None => {}
    }
    result
  }
}

open dew.std.option
open dew.std.testing

fn self_host_private_fields_library() -> Bytes {
  b"pub struct Checked<t> {\n  private mut secret: t\n  visible: t\n}\n"
}

fn self_host_private_fields_body(source: Bytes) -> SelfHostBasicInferredBody {
  let fixture = self_host_imported_semantics_fixture(source, self_host_private_fields_library())
  let collected = fixture.frozen.collected.modules.at(0u32)
  let imports = fixture.imports
  assert(collected.diagnostics.length() == 0u32, "private field consumer parses")
  assert(imports.fields.length() == 2u32, "all fields retained for physical layout")
  assert(imports.fields[0u32].module_private, "private field survives frozen import")
  assert(!imports.fields[1u32].module_private, "public field remains public")
  let names = self_host_resolve_module_names_with_imports(collected, imports.scope)
  let inferred = self_host_infer_program_module_bodies(collected, imports, names)
  assert(inferred.bodies.length() == 1u32, "one test body")
  inferred.bodies[0u32]
}

test "private fields preserve source names and mutable flags" {
  let collected = self_host_collect_bytes(
    2610u64,
    b"struct Fields {\n  private: I32\n  private secret: I64\n  private mut writable: U32\n  mut public_value: Bool\n}\nenum Value {\n  Named {\n    private: I32\n  }\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "contextual private parses")
  assert(collected.fields.length() == 5u32, "all fields collected")
  assert(!collected.fields[0u32].module_private, "private can remain a public field name")
  assert(collected.fields[1u32].module_private && !collected.fields[1u32].mutable_, "immutable private field")
  assert(collected.fields[2u32].module_private && collected.fields[2u32].mutable_, "mutable private field")
  assert(!collected.fields[3u32].module_private && collected.fields[3u32].mutable_, "existing mut field stays public")
  assert(!collected.fields[4u32].module_private, "enum field named private stays public")
}

test "private fields deny imported reads and writes" {
  let sources = [
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  value.secret\n}\n",
    b"open app.library\npub fn run(value: Checked<I32>) -> Unit {\n  value.secret = 1i32\n}\n",
  ]
  for source in sources {
    let body = self_host_private_fields_body(source)
    let mut denied = 0u32
    for diagnostic in body.diagnostics {
      match diagnostic {
        UnknownFieldForType(_, _, _, _) => {
          denied = denied + 1u32
        }
        _ => {}
      }
    }
    assert(denied == 1u32, "one private field access denied")
  }
}

test "private fields deny explicit and inferred imported construction" {
  let sources = [
    b"open app.library\npub fn run() -> Checked<I32> {\n  Checked::{\n    secret: 1i32\n    visible: 2i32\n  }\n}\n",
    b"open app.library\npub fn run() -> Checked<I32> {\n  {\n    secret: 1i32\n    visible: 2i32\n  }\n}\n",
    b"open app.library\npub fn run() -> Checked<I32> {\n  {\n    visible: 2i32\n  }\n}\n",
  ]
  for source in sources {
    let body = self_host_private_fields_body(source)
    let mut missing = 0u32
    for diagnostic in body.diagnostics {
      match diagnostic {
        MissingImportedConstructionField(_, _, _, _) => {
          missing = missing + 1u32
        }
        _ => {}
      }
    }
    assert(missing == 1u32, "private field prevents external construction")
  }
}

test "private fields deny named imported patterns and require rest" {
  let body = self_host_private_fields_body(
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  match value {\n    Checked {\n      secret: result\n      ...\n    } => result\n  }\n}\n",
  )
  let mut denied = 0u32
  for diagnostic in body.diagnostics {
    match diagnostic {
      UnknownPatternField(_, _, _) => {
        denied = denied + 1u32
      }
      _ => {}
    }
  }
  assert(denied == 1u32, "private pattern binding denied")
  let incomplete = self_host_private_fields_body(
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  match value {\n    Checked {\n      visible: result\n    } => result\n  }\n}\n",
  )
  let mut missing = 0u32
  for diagnostic in incomplete.diagnostics {
    match diagnostic {
      MissingImportedPatternField(_, _, _) => {
        missing = missing + 1u32
      }
      _ => {}
    }
  }
  assert(missing == 1u32, "private field requires rest in imported pattern")
}

test "private fields allow imported public fields and rest patterns" {
  let sources = [
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  value.visible\n}\n",
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  match value {\n    Checked {\n      visible: result\n      ...\n    } => result\n  }\n}\n",
    b"open app.library\npub fn run(value: Checked<I32>) -> I32 {\n  match value {\n    Checked {\n      ...\n    } => 1i32\n  }\n}\n",
  ]
  for source in sources {
    let body = self_host_private_fields_body(source)
    assert(body.diagnostics.length() == 0u32, "public access and rest patterns allowed")
  }
}

test "private fields allow construction access assignment and patterns within their module" {
  let collected = self_host_collect_bytes(
    2611u64,
    b"struct Checked {\n  private mut secret: I32\n}\nfn make() -> Checked {\n  {\n    secret: 1i32\n  }\n}\nfn read(value: Checked) -> I32 {\n  value.secret\n}\nfn write(value: Checked) -> Unit {\n  value.secret = 2i32\n}\nfn unpack(value: Checked) -> I32 {\n  match value {\n    Checked {\n      secret: result\n    } => result\n  }\n}\n",
  )
  assert(collected.diagnostics.length() == 0u32, "local private fields parse")
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  assert(inferred.bodies.length() == 4u32, "four local field uses")
  for body in inferred.bodies {
    assert(body.diagnostics.length() == 0u32, "same module private access allowed")
  }
}

test "private fields remain accessible from another file in the same module" {
  let program = self_host_collect_program_manifest(
    2612u64,
    {
      modules: [{
        path: "app.checked"
        files: [
          {
            path: "type.dew"
            source: b"pub struct Checked {\n  private secret: I32\n}\n"
            test_only: false
          },
          {
            path: "read.dew"
            source: b"pub fn read(value: Checked) -> I32 {\n  value.secret\n}\n"
            test_only: false
          },
        ]
      }]
    },
  )
  let collected = program.modules.at(0u32)
  assert(collected.diagnostics.length() == 0u32, "same module files collected")
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  assert(inferred.bodies.length() == 1u32, "one body from second file")
  assert(inferred.bodies[0u32].diagnostics.length() == 0u32, "private fields use module scope")
}

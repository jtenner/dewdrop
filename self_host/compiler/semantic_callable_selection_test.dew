open dew.std.array
open dew.std.testing

fn self_host_callable_infer_source(
  module_id: U64,
  source: Bytes,
) -> (
  SelfHostCollectedModule,
  SelfHostResolvedModuleTypes,
  SelfHostResolvedModuleNames,
  SelfHostBasicInferredModuleBodies,
) {
  let collected = self_host_collect_bytes(module_id, source)
  let resolved = self_host_resolve_module_types(collected)
  let names = self_host_resolve_module_names(collected)
  let inferred = self_host_infer_basic_module_bodies(collected, resolved, names)
  (collected, resolved, names, inferred)
}

fn self_host_callable_body_calls(
  collected: SelfHostCollectedModule,
  body: SelfHostHirBody,
) -> Array<U32> {
  let calls = []
  let mut expression = body.expressions.start
  let end = self_host_u32_add(body.expressions.start, body.expressions.length)
  let _ = while expression {
    current => if current < end {
      match collected.expressions[current] {
        SelfHostHirExpr::CallExpr(_, _, _) => calls.push(current)
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  calls
}

test "callable selection uses arguments and expected results" {
  let (collected, resolved, names, inferred) = self_host_callable_infer_source(
    838u64,
    b"builtin convert(value: I32) -> I64 = \"i32_to_i64\"\nbuiltin convert(value: F32) -> F64 = \"f32_to_f64\"\nbuiltin make() -> I32 = \"make_i32\"\nbuiltin make() -> F32 = \"make_f32\"\nfn use_convert() -> I64 {\n  convert(1)\n}\nfn use_make() -> F32 {\n  make()\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let convert_hir = collected.bodies[0u32]
  let make_hir = collected.bodies[1u32]
  let convert_calls = self_host_callable_body_calls(collected, convert_hir)
  let make_calls = self_host_callable_body_calls(collected, make_hir)
  let convert_body = match inferred.body(convert_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let make_body = match inferred.body(make_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  assert(convert_body.diagnostic_count() == 0u32, "convert diagnostics")
  assert(make_body.diagnostic_count() == 0u32, "make diagnostics")
  match convert_body.call_target(convert_hir, convert_calls[0u32]) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => assert(
      declaration == collected.declarations[0u32].id,
      "I32 convert overload",
    )
    _ => assert(false, "selected convert overload")
  }
  match make_body.call_target(make_hir, make_calls[0u32]) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, _) => assert(
      declaration == collected.declarations[3u32].id,
      "F32 make overload",
    )
    _ => assert(false, "selected make overload")
  }
}

test "callable selection prefers concrete overloads" {
  let (collected, resolved, names, inferred) = self_host_callable_infer_source(
    839u64,
    b"builtin choose<t>(value: t) -> t = \"generic_choose\"\nbuiltin choose(value: I32) -> I32 = \"i32_choose\"\nfn use() -> I32 {\n  choose(1)\n}\n",
  )
  let _ = resolved.module_id
  let _ = names.module_id
  let hir_body = collected.bodies[0u32]
  let calls = self_host_callable_body_calls(collected, hir_body)
  let body = match inferred.body(hir_body.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  assert(body.diagnostic_count() == 0u32, "concrete overload diagnostics")
  match body.call_target(hir_body, calls[0u32]) {
    SelfHostBasicCallTarget::SelectedBasicCallTarget(declaration, arguments) => {
      assert(declaration == collected.declarations[1u32].id, "concrete overload")
      assert(arguments.length == 0u32, "concrete type arguments")
    }
    _ => assert(false, "selected concrete overload")
  }
}

test "callable selection diagnoses ambiguous and missing overloads" {
  let (ambiguous_collected, ambiguous_resolved, ambiguous_names, ambiguous) = self_host_callable_infer_source(
    840u64,
    b"builtin choose(value: I32) -> I32 = \"first\"\nbuiltin choose(value: I32) -> I32 = \"second\"\nfn use() -> I32 {\n  choose(1)\n}\n",
  )
  let (missing_collected, missing_resolved, missing_names, missing) = self_host_callable_infer_source(
    841u64,
    b"builtin choose(value: I32) -> I32 = \"only\"\nbuiltin choose(value: Bool) -> Bool = \"bool\"\nfn use() -> I32 {\n  choose(1.0f32)\n}\n",
  )
  let _ = ambiguous_resolved.module_id
  let _ = ambiguous_names.module_id
  let _ = missing_resolved.module_id
  let _ = missing_names.module_id
  let ambiguous_hir = ambiguous_collected.bodies[0u32]
  let missing_hir = missing_collected.bodies[0u32]
  let ambiguous_body = match ambiguous.body(ambiguous_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let missing_body = match missing.body(missing_hir.id) {
    Option::Some(value) => value
    Option::None => {
      return
    }
  }
  let mut ambiguous_count = 0u32
  let mut index = 0u32
  let _ = while index {
    current => if current < ambiguous_body.diagnostic_count() {
      match ambiguous_body.diagnostic_at(current) {
        SelfHostBodyInferenceDiagnostic::AmbiguousDirectCall(_, _, _, _, _, _) => {
          ambiguous_count = ambiguous_count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  let mut missing_count = 0u32
  index = 0u32
  let _ = while index {
    current => if current < missing_body.diagnostic_count() {
      match missing_body.diagnostic_at(current) {
        SelfHostBodyInferenceDiagnostic::NoMatchingDirectCall(_, _, _) => {
          missing_count = missing_count + 1u32
        }
        _ => {}
      }
      continue current + 1u32
    } else {
      break self_host_semantic_unit()
    }
  }
  assert(ambiguous_count == 1u32, "one ambiguous overload")
  assert(missing_count == 1u32, "one missing overload")
}

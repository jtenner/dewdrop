pub enum SelfHostBodyTypeTerm {
  BodyErrorType
  BodyResolvedType(U32)
  BodyVariableType(U32)
  BodyProductType(SelfHostHirSpan)
  BodyAppliedType(I32, SelfHostHirSpan)
  BodyFunctionType(SelfHostHirSpan, I32)
  BodyMemberTypeProjection(I32, Bytes, String)
}

pub enum SelfHostTypeConstraintOriginKind {
  ExpressionTypeConstraint
  PatternTypeConstraint
  LocalTypeConstraint
  ReturnTypeConstraint
  CallTypeConstraint
  OperatorTypeConstraint
  SyntheticTypeConstraint
}

pub struct SelfHostTypeConstraintOrigin {
  kind: SelfHostTypeConstraintOriginKind
  source: U32
  offset: U32
}

pub enum SelfHostLocalInferenceDiagnostic {
  LocalTypeMismatch(I32, I32, SelfHostTypeConstraintOrigin)
  InfiniteLocalType(U32, I32, SelfHostTypeConstraintOrigin)
  InvalidLocalMemberProjection(I32, String, SelfHostTypeConstraintOrigin)
}

impl SelfHostLocalInferenceDiagnostic {
  fn offset(self) -> U32 {
    match self {
      LocalTypeMismatch(_, _, origin) => origin.offset
      InfiniteLocalType(_, _, origin) => origin.offset
      InvalidLocalMemberProjection(_, _, origin) => origin.offset
    }
  }
}

fn self_host_expression_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: ExpressionTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_pattern_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: PatternTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_local_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: LocalTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_return_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: ReturnTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_call_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: CallTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_operator_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: OperatorTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_synthetic_type_origin(
  source: U32,
  offset: U32,
) -> SelfHostTypeConstraintOrigin {
  {
    kind: SyntheticTypeConstraint
    source: source
    offset: offset
  }
}

fn self_host_type_origin_equal(
  left: SelfHostTypeConstraintOrigin,
  right: SelfHostTypeConstraintOrigin,
) -> Bool {
  let kind_equal = match left.kind {
    ExpressionTypeConstraint => right.kind is ExpressionTypeConstraint
    PatternTypeConstraint => right.kind is PatternTypeConstraint
    LocalTypeConstraint => right.kind is LocalTypeConstraint
    ReturnTypeConstraint => right.kind is ReturnTypeConstraint
    CallTypeConstraint => right.kind is CallTypeConstraint
    OperatorTypeConstraint => right.kind is OperatorTypeConstraint
    SyntheticTypeConstraint => right.kind is SyntheticTypeConstraint
  }
  kind_equal && left.source == right.source && left.offset == right.offset
}

// Emitter readers must consume the frozen plan, not recover from source.
fn self_host_test_frozen_shape_read(mutation: U32) -> Unit {
  let (link, plan) = self_host_test_discard_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut canonical = Some(plan)
  let mut specialization = plan.specialization
  if mutation == 1u32 {
    canonical = None
  } else if mutation == 2u32 {
    let _ = plan.expressions.pop()
  } else if mutation == 3u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], UnresolvedBodyCarrier)
  } else if mutation == 4u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], ConflictingBodyCarrier)
  } else if mutation == 5u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], I32BodyCarrier)
  } else if mutation == 6u32 {
    specialization = 0u32
  }
  let shape = self_host_linked_planned_expression_shape(canonical, link, module_, module_.bodies[0u32], specialization, 0u32)
  if mutation == 0u32 {
    assert(shape is I64PlannedValueShape, "read the stored physical shape")
  }
}

test "physical shape reads use frozen scalar evidence" {
  self_host_test_frozen_shape_read(0u32)
}

test "BOD-610 physical shape reads require a body plan" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(1u32)
}

test "BOD-610 physical shape reads require expression evidence" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(2u32)
}

test "BOD-610 physical shape reads reject unknown carriers" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(3u32)
}

test "BOD-610 physical shape reads reject conflicting carriers" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(4u32)
}

test "ABI-712 physical shape reads require matching carrier copies" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(5u32)
}

test "ARN-106 physical shape reads require the selected specialization" expect_trap "unreachable" {
  self_host_test_frozen_shape_read(6u32)
}

fn self_host_test_shape_read_source(source: Bytes, expression: U32) -> SelfHostPlannedValueShape {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(source), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid shape-read source")
  let plan = program.bodies[0u32]
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  self_host_linked_planned_expression_shape(Some(plan), link, module_, module_.bodies[0u32], plan.specialization, expression)
}

test "physical shape reads preserve Unit erasure" {
  let shape = self_host_test_shape_read_source(b"pub fn run() -> Unit {\n  ()\n}\n", 0u32)
  assert(shape is UnitPlannedValueShape, "Unit has no physical result")
}

test "physical shape reads preserve proven divergence" {
  let shape = self_host_test_shape_read_source(b"builtin stop() -> Never = \"unreachable\"\npub fn run() -> Never {\n  stop()\n}\n", 1u32)
  assert(shape is NeverPlannedValueShape, "a nonreturning call cannot become Unit or a scalar")
}

test "physical shape reads preserve reference carriers" {
  let shape = self_host_test_shape_read_source(b"pub fn run(value: Bytes) -> Bytes {\n  value\n}\n", 0u32)
  assert(shape is RefPlannedValueShape, "a reference cannot become a scalar")
}

fn self_host_test_frozen_expression_read(mutation: U32, logical: Bool) -> Unit {
  let (link, plan) = self_host_test_discard_fixture()
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  let mut canonical = Some(plan)
  let mut specialization = plan.specialization
  if mutation == 1u32 {
    canonical = None
  } else if mutation == 2u32 {
    let _ = plan.expressions.pop()
  } else if mutation == 3u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], UnresolvedBodyCarrier)
  } else if mutation == 4u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], ConflictingBodyCarrier)
  } else if mutation == 5u32 {
    plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], I32BodyCarrier)
  } else if mutation == 6u32 {
    specialization = 0u32
  }
  let carrier = if logical {
    self_host_linked_logical_operand_carrier(canonical, link, module_, module_.bodies[0u32], specialization, 0u32)
  } else {
    self_host_linked_exact_emitted_expression_carrier(canonical, link, module_, module_.bodies[0u32], specialization, 0u32)
  }
  assert(carrier is I64BodyCarrier, "read the stored scalar carrier")
}

test "emitted expression reads use frozen scalar evidence" {
  self_host_test_frozen_expression_read(0u32, false)
  self_host_test_frozen_expression_read(0u32, true)
}

test "ABI-712 emitted lambda reads retain the parent declaration" expect_trap "unreachable" {
  let link = self_host_plan_program_wasmgc_link(self_host_physical_test_fragments(
    b"pub fn make() -> fn() -> I64 {\n  fn() -> I64 {\n    42i64\n  }\n}\n",
  ), false)
  self_host_physical_test_assert_clean_inference(link)
  let program = self_host_plan_program_wasm_bodies(link)
  assert(program.diagnostics.length() == 0u32, "valid lambda plan before one mutation")
  let module_ = link.fragments.specialization.lowering.modules[0u32]
  for plan in program.bodies {
    if plan.lambda != 4294967295u32 {
      let body = match self_host_linked_lambda_body(module_, plan.lambda) {
        Some(value) => value
        None => {
          assert(false, "fixture requires a lambda source body")
          unreachable()
        }
      }
      assert(plan.expressions.length() == 1u32, "one literal in the lambda")
      let expression = plan.expressions[0u32].expression
      assert(plan.expressions[0u32].carrier is I64BodyCarrier, "known lambda scalar before mutation")
      plan.expressions[0u32] = self_host_test_discard_carrier(plan.expressions[0u32], I32BodyCarrier)
      let _ = self_host_linked_exact_emitted_expression_carrier(Some(plan), link, module_, body, plan.specialization, expression)
    }
  }
}

test "BOD-610 emitted expression reads require a body plan" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(1u32, false)
}

test "BOD-610 emitted expression reads require expression evidence" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(2u32, false)
}

test "BOD-610 emitted expression reads reject unknown carriers" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(3u32, false)
}

test "BOD-610 emitted expression reads reject conflicting carriers" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(4u32, false)
}

test "ABI-712 emitted expression reads require matching carrier copies" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(5u32, false)
}

test "ARN-106 emitted expression reads require the selected specialization" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(6u32, false)
}

test "BOD-610 logical operand reads require a body plan" expect_trap "unreachable" {
  self_host_test_frozen_expression_read(1u32, true)
}

test "BOD-610 logical operand reads require expression evidence" expect_trap "unreachable" {

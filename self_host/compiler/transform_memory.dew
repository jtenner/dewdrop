      kind: "V128"
    })
    "v128.load16_lane 3" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 3u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 3" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 2u32
      lane: 3u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_lane 4" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 4u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 4" => Some(CtMemoryOpcode::{
      mode: 8u32

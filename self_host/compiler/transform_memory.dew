open dew.std.wasm.intrinsics

struct CtMemoryOpcode {
  mode: U32
  size: U32
  lane: U32
  signed_: Bool
  kind: String
}

fn ct_memory_opcode(opcode: String) -> Option<CtMemoryOpcode> {
  match opcode {
    "i32.load" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i32.load8_s" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 1u32
      lane: 0u32
      signed_: true
      kind: "I32"
    })
    "i32.load8_u" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i32.load16_s" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 2u32
      lane: 0u32
      signed_: true
      kind: "I32"
    })
    "i32.load16_u" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 2u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i64.load" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 8u32
      lane: 0u32
      signed_: false
      kind: "I64"
    })
    "f32.load" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "F32"
    })
    "f64.load" => Some(CtMemoryOpcode::{
      mode: 0u32
      size: 8u32
      lane: 0u32
      signed_: false
      kind: "F64"
    })
    "i32.store" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i32.store8" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i32.store16" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 2u32
      lane: 0u32
      signed_: false
      kind: "I32"
    })
    "i64.store" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 8u32
      lane: 0u32
      signed_: false
      kind: "I64"
    })
    "f32.store" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "F32"
    })
    "f64.store" => Some(CtMemoryOpcode::{
      mode: 1u32
      size: 8u32
      lane: 0u32
      signed_: false
      kind: "F64"
    })
    "v128.load" => Some(CtMemoryOpcode::{
      mode: 2u32
      size: 16u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.store" => Some(CtMemoryOpcode::{
      mode: 3u32
      size: 16u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_splat" => Some(CtMemoryOpcode::{
      mode: 4u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 0" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 0" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 1" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 1" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 2" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 2u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 2" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 2u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 3" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 3u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 3" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 3u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 4" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 4u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 4" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 4u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 5" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 5u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 5" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 5u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 6" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 6u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 6" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 6u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 7" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 7u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 7" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 7u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 8" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 8u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 8" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 8u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 9" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 9u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 9" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 9u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 10" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 10u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 10" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 10u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 11" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 11u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 11" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 11u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 12" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 12u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 12" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 12u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 13" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 13u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 13" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 13u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 14" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 14u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 14" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 14u32
      signed_: false
      kind: "V128"
    })
    "v128.load8_lane 15" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 1u32
      lane: 15u32
      signed_: false
      kind: "V128"
    })
    "v128.store8_lane 15" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 1u32
      lane: 15u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_splat" => Some(CtMemoryOpcode::{
      mode: 4u32
      size: 2u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_lane 0" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 0" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 2u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_lane 1" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 1" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 2u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_lane 2" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32

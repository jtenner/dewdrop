      kind: "V128"
    })
    "v128.load16_lane 6" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 6u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 6" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 2u32
      lane: 6u32
      signed_: false
      kind: "V128"
    })
    "v128.load16_lane 7" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 2u32
      lane: 7u32
      signed_: false
      kind: "V128"
    })
    "v128.store16_lane 7" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 2u32
      lane: 7u32
      signed_: false
      kind: "V128"
    })
    "v128.load32_splat" => Some(CtMemoryOpcode::{
      mode: 4u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load32_lane 0" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.store32_lane 0" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 4u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load32_lane 1" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 4u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.store32_lane 1" => Some(CtMemoryOpcode::{
      mode: 8u32
      size: 4u32
      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.load32_lane 2" => Some(CtMemoryOpcode::{
      mode: 7u32

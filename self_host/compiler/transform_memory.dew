    })
    "v128.load64_splat" => Some(CtMemoryOpcode::{
      mode: 4u32
      size: 8u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load64_lane 0" => Some(CtMemoryOpcode::{
      mode: 7u32
      size: 8u32
      lane: 0u32
      signed_: false

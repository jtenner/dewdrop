      lane: 1u32
      signed_: false
      kind: "V128"
    })
    "v128.load8x8_s" => Some(CtMemoryOpcode::{
      mode: 5u32
      size: 1u32
      lane: 0u32
      signed_: true
      kind: "V128"
    })
    "v128.load8x8_u" => Some(CtMemoryOpcode::{
      mode: 5u32
      size: 1u32
      lane: 0u32
      signed_: false
      kind: "V128"
    })
    "v128.load16x4_s" => Some(CtMemoryOpcode::{

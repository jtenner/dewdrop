open dew.std.option

impl SelfHostBasicBodyInferencer {
  fn begin_bound_method(self, trait_: U64, bound: U32, method: U64, receiver: I32) -> Unit {
    self.imported_instantiation_generics.clear()
    let local = self_host_semantic_id_module(trait_) == self.collected.module_id
    if local {
      self.instantiation_generics = self.collected.generic_parameters_of(trait_)
      self.instantiation_method_generics = self.collected.generic_parameters_of(method)
    } else {
      self.instantiation_generics = self_host_empty_hir_span(0u32)
      self.instantiation_method_generics = self_host_empty_hir_span(0u32)
    }
    let owner_generics = if local {
      self.instantiation_generics
    } else {
      match self.imported.type_generic_spans.get(trait_) {
        Option::Some(span) => span
        Option::None => self_host_empty_hir_span(0u32)
      }
    }
    let method_generics = if local {
      self.instantiation_method_generics
    } else {
      match self.imported_callable(method) {
        Option::Some(callable) => callable.generic_parameters
        Option::None => {
          self_host_assert_compiler_invariant(false, "LNK-504 imported bound requirement is missing")
          unreachable()
        }
      }
    }
    if !local {
      for span in [owner_generics, method_generics] {
        self_host_assert_array_span(span.start, span.length, self.imported.generic_parameter_ids.length(), "ARN-101 imported bound generic parameters")
        let _ = while 0u32 {
          index => if index < span.length {
            self.imported_instantiation_generics.push(self.imported.generic_parameter_ids[span.start + index])
            continue index + 1u32
          } else {
            break self_host_semantic_unit()
          }
        }
      }
    }
    self.candidate_type_arguments.clear()
    let arguments = match self.resolved.types[bound] {
      SelfHostResolvedType::AppliedType(_, arguments) => arguments
      _ => self_host_empty_hir_span(0u32)
    }
    let _ = self_host_assert_compiler_invariant(arguments.length == owner_generics.length, "declared trait bound argument count")
    let _ = while 0u32 {
      index => if index < arguments.length {
        self.candidate_type_arguments.push(self.solver.resolved_type(self.resolved.type_arguments[arguments.start + index]))
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    let _ = while 0u32 {
      index => if index < method_generics.length {
        self.candidate_type_arguments.push(self.solver.fresh_variable())
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.instantiation_self_owner = trait_
    self.instantiation_self_type = receiver
  }

  fn bound_parameter_type(self, local: Bool, index: U32) -> U32 {
    if local {
      self.resolved.parameter_types[index]
    } else {
      self.imported.parameter_types[index]
    }
  }

  fn bound_method_signature(self, expression: U32, receiver: U32, arguments: SelfHostHirSpan, offset: U32, trait_: U64, bound: U32, declaration: U64) -> Bool {
    let local = self_host_semantic_id_module(declaration) == self.collected.module_id
    let imported = self.imported_callable(declaration)
    let parameters = if local {
      self.collected.parameters_of(declaration)
    } else {
      match imported {
        Option::Some(callable) => callable.parameters
        Option::None => return false
      }
    }
    if parameters.length == 0u32 || parameters.length - 1u32 != arguments.length {
      return false
    }
    let is_receiver = if local {
      self.collected.parameters[parameters.start].kind is SelfHostCollectedParameterKind::ReceiverParameterDecl
    } else {
      self.imported.parameter_receivers[parameters.start]
    }
    if !is_receiver {
      return false
    }
    let method_count = if local {
      self.collected.generic_parameters_of(declaration).length
    } else {
      match imported {
        Option::Some(callable) => callable.generic_parameters.length
        Option::None => return false
      }
    }
    let result_type = if local {
      match self.local_callable_index_of_declaration(declaration) {
        Option::Some(callable) => self.resolved.callable_return_types[callable]
        Option::None => return false
      }
    } else {
      match imported {
        Option::Some(callable) => callable.result_type
        Option::None => return false
      }
    }
    self.begin_bound_method(trait_, bound, declaration, self.expression_type(receiver))
    if !self.apply_explicit_call_types(expression, self.candidate_type_arguments.length() - method_count, method_count, offset) {
      return false
    }
    let origin = self_host_call_type_origin(expression, offset)
    if !self.solver.unify(self.expression_type(receiver), self.instantiate_signature_type(self.bound_parameter_type(local, parameters.start)), origin) {
      return false
    }
    let _ = while 0u32 {
      index => if index < arguments.length {
        let actual = self.expression_type(self.collected.expression_children[arguments.start + index])
        let expected = self.instantiate_signature_type(self.bound_parameter_type(local, parameters.start + index + 1u32))
        if !self.is_primitive(actual, SelfHostPrimitiveType::NeverType) && !self.solver.unify(actual, expected, origin) {
          return false
        }
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    self.solver.unify(self.expression_type(expression), self.instantiate_signature_type(result_type), origin)
  }

  fn constrain_declared_bound_method(self, expression: U32, target: U32, receiver: U32, name: U32, arguments: SelfHostHirSpan, offset: U32) -> Bool {
    let parameter_id = match self.solver.type_term(self.solver.representative_type(self.expression_type(receiver))) {
      SelfHostBodyTypeTerm::BodyResolvedType(type_) => match self.resolved.types[type_] {
        SelfHostResolvedType::GenericParameterType(parameter) => parameter
        _ => 18446744073709551615u64
      }
      _ => 18446744073709551615u64
    }
    let bounds = if self_host_u64_equal(self_host_semantic_id_module(parameter_id), self.collected.module_id) {
      self.collected.generic_parameter_at(self_host_semantic_id_local(parameter_id)).bounds
    } else {
      self_host_empty_hir_span(0u32)
    }
    let candidates = self_host_empty_semantic_ids()
    let _ = while 0u32 {
      index => if index < bounds.length {
        candidates.push(self.resolved.generic_bound_types[bounds.start + index])
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    for bound in self.guarded_trait_bounds(expression, self.expression_type(receiver)) {
      let mut present = false
      for previous in candidates {
        if previous == bound {
          present = true
        }
      }
      if !present {
        candidates.push(bound)
      }
    }
    let mut selected_trait = 0u64
    let mut selected_bound = 0u32
    let mut first = 0u64
    let mut second = 0u64
    let mut count = 0u32
    let mut needs_evidence = false
    let mut guarded = false
    let _ = while 0u32 {
      index => if index < candidates.length() {
        let bound = candidates[index]
        let trait_type = match self.resolved.types[bound] {
          SelfHostResolvedType::AppliedType(base, _) => base
          _ => bound
        }
        match self.resolved.types[trait_type] {
          SelfHostResolvedType::TraitType(trait_) => if self_host_u64_equal(self_host_semantic_id_module(trait_), self.collected.module_id) {
            for raw_method in self.collected.methods {
              let method = self_host_collected_method_identity(raw_method)
              if self_host_u64_equal(method.parent, trait_) && self_host_u32_equal(method.name, name) && method.kind is SelfHostCollectedMethodKind::TraitMethodDecl {
                match self.local_callable_index_of_declaration(method.id) {
                  Option::Some(callable) => {
                    let snapshot = self.solver.snapshot()
                    let viable = self.bound_method_signature(expression, receiver, arguments, offset, trait_, bound, method.id)
                    self.solver.rollback(snapshot)
                    if viable && self.local_generics_require_evidence(method.id) {
                      needs_evidence = true
                    } else if viable {
                      if count == 0u32 {
                        first = method.id
                        selected_trait = trait_
                        selected_bound = bound
                        guarded = index >= bounds.length
                      } else if count == 1u32 {
                        second = method.id
                      }
                      count = count + 1u32
                    }
                  }
                  Option::None => {}
                }
              }
            }
          } else {
            for method in self.imported.callables {
              let belongs = match method.kind {
                SelfHostFrozenInterfaceCallableKind::FrozenTraitCallable(owner) => owner == trait_
                _ => false
              }
              if belongs && method.name == self.collected.name(name) {
                let snapshot = self.solver.snapshot()
                let viable = self.bound_method_signature(expression, receiver, arguments, offset, trait_, bound, method.declaration)
                self.solver.rollback(snapshot)
                if viable && method.requires_evidence {
                  needs_evidence = true
                } else if viable {
                  if count == 0u32 {
                    first = method.declaration
                    selected_trait = trait_
                    selected_bound = bound
                    guarded = index >= bounds.length
                  } else if count == 1u32 {
                    second = method.declaration
                  }
                  count = count + 1u32
                }
              }
            }
          }
          _ => {}
        }
        continue index + 1u32
      } else {
        break self_host_semantic_unit()
      }
    }
    if needs_evidence {
      self.store_call_target(expression, SelfHostBasicCallTarget::ErrorBasicCallTarget, 1u32)
      self.mark_unsupported(expression)
      self.solver.poison_type(self.expression_type(target))
      return true
    }
    if count == 0u32 {
      return false
    }
    if count == 1u32 {
      let valid = self.bound_method_signature(expression, receiver, arguments, offset, selected_trait, selected_bound, first)
      let _ = self_host_assert_compiler_invariant(valid, "selected declared bound signature changed after rollback")
      let start = self.call_type_arguments.length()
      self_host_basic_copy_i32_values(self.candidate_type_arguments, self.call_type_arguments)
      let arguments = SelfHostHirSpan::{
        start: start
        length: self.candidate_type_arguments.length()
      }
      let target = if guarded {
        SelfHostBasicCallTarget::SelectedBasicCallTarget(first, arguments)
      } else {
        SelfHostBasicCallTarget::BoundTraitBasicCallTarget(first, parameter_id, selected_bound, arguments)
      }
      self.store_call_target(expression, target, 2u32)
    } else {
      self.store_call_target(expression, SelfHostBasicCallTarget::ErrorBasicCallTarget, 1u32)
      self.solver.poison_type(self.expression_type(expression))
      self.diagnostics.push(SelfHostBodyInferenceDiagnostic::AmbiguousMethod(name, expression, first, second, count, offset))
    }
    self.consumed_member_roots[self.expression_index(target)] = true
    self.solver.poison_type(self.expression_type(target))
    true
  }
}
